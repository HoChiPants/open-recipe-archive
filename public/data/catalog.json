          "quantity": 1,
          "unit": "teaspoon"
        },
        {
          "ingredient_id": "black-pepper",
          "item": "black pepper",
          "quantity": "1/2",
          "unit": "teaspoon"
        },
        {
          "ingredient_id": "lemon",
          "item": "lemon juice",
          "quantity": 2,
          "unit": "tablespoons"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "Warm the olive oil in a heavy pot. Cook the onion with a pinch of salt until soft."
        },
        {
          "step": 2,
          "text": "Add the garlic and black pepper; stir until fragrant."
        },
        {
          "step": 3,
          "text": "Add the lentils and broth. Bring to a boil, then simmer until the lentils are tender.",
          "timer_minutes": 30
        },
        {
