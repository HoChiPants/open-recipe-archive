      "$schema": "../../schemas/recipe.schema.json",
      "schema_version": "1.0.0",
      "id": "everyday-lentil-soup",
      "name": "Everyday lentil soup",
      "subtitle": "A simple pantry soup finished with lemon",
      "description": "Brown lentils, onion, and garlic simmer into an economical one-pot meal.",
      "meal_type": "soup",
      "cuisine": "Mediterranean",
      "yield": {
        "quantity": 6,
        "unit": "servings"
      },
      "times": {
        "prep_minutes": 12,
        "cook_minutes": 38
      },
      "ingredients": [
        {
          "ingredient_id": "olive-oil",
          "item": "olive oil",
          "quantity": 2,
          "unit": "tablespoons"
        },
        {
          "ingredient_id": "onion",
          "item": "yellow onion",
          "quantity": 1,
          "unit": "large",
          "preparation": "diced"
        },
        {
          "ingredient_id": "garlic",
          "item": "garlic",
          "quantity": 3,
          "unit": "cloves",
          "preparation": "minced"
        },
        {
