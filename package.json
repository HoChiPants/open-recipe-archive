{
  "name": "open-recipe-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run data:prepare",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run data:prepare",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "npm run dev",
    "preview": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run data:validate && npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "data:validate": "node scripts/validate.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "dailydine:feed": "node scripts/build-dailydine-feed.mjs",
    "ingredients:backfill": "node scripts/backfill-canonical-ingredients.mjs",
    "data:prepare": "npm run data:validate && npm run catalog:build",
    "recipe:new": "node scripts/new-recipe.mjs",
    "candidate:auto": "node scripts/auto-promote-candidates.mjs",
    "candidate:auto:all": "node scripts/auto-promote-candidates.mjs --all",
    "candidate:batch": "node scripts/process-recipe-batch.mjs",
    "candidate:staged:promote": "node scripts/promote-staged-normalizations.mjs",
    "candidate:rights": "node scripts/publication-rights.mjs",
    "candidate:promote": "node scripts/promote-candidate.mjs",
    "scrape": "node scraping/src/cli.mjs",
    "scrape:sites": "node scraping/src/orchestrate.mjs",
    "scrape:discover": "node scraping/src/discover.mjs",
    "scrape:test": "node --test scraping/tests/*.test.mjs",
    "meals:import": "node scripts/import-meals.mjs",
    "meals:promote": "node scripts/promote-meals.mjs"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.4",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "type": "module"
}
