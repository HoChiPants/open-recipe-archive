  "instructions": [
    {
      "step": 1,
      "text": "Toss the tomatoes with 2 tablespoons olive oil, basil, onion, garlic, red wine vinegar, balsamic vinegar, and black pepper. Let the mixture stand for 60 minutes so the flavors develop.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Preheat a grill or grill pan. Brush both sides of the baguette slices with the remaining olive oil."
    },
    {
      "step": 3,
      "text": "Grill the bread until golden brown, about 2 minutes per side.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Arrange the grilled slices on a serving plate, top with the tomato mixture, and serve."
    }
