  "id": "bacon-and-tomato-cups",
  "name": "Bacon and Tomato Cups",
  "subtitle": "Warm biscuit cups filled with savory bacon, tomato, and Swiss cheese",
  "description": "Small biscuit cups hold a creamy mixture of tomato, onion, Swiss cheese, basil, and bacon, then bake until golden.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 32,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 8
    },
    {
      "ingredient_id": "tomato",
      "item": "tomato",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "swiss-cheese",
      "item": "Swiss cheese",
      "quantity": 3,
      "unit": "ounces",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "refrigerated-buttermilk-biscuit-dough",
      "item": "refrigerated buttermilk biscuit dough",
      "quantity": 1,
      "unit": "can",
      "preparation": "16 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Coat mini muffin cups with cooking spray."
    },
    {
      "step": 2,
      "text": "Cook the bacon until crisp, then drain and crumble it."
    },
    {
      "step": 3,
      "text": "Stir together the tomato, onion, Swiss cheese, mayonnaise, and dried basil."
    },
    {
      "step": 4,
      "text": "Cut each biscuit into quarters and shape the pieces into small cups in the prepared muffin pan."
    },
    {
      "step": 5,
      "text": "Add the bacon to the filling mixture and spoon it into the biscuit cups."
    },
    {
      "step": 6,
      "text": "Bake until the biscuit edges are golden brown, about 12 minutes.",
      "timer_minutes": 12
    }
  ],
