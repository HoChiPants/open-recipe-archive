{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cinnamon-crusted-walnuts",
  "name": "Cinnamon-Crusted Walnuts",
  "subtitle": "A crisp, warmly spiced nut snack",
  "description": "Walnut halves are coated in a cinnamon-vanilla egg-white mixture and slowly baked until dry and crisp.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 75,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": 1
    },
    {
      "ingredient_id": "sugar",
      "item": "granulated sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "walnut-halves",
      "item": "walnut halves",
      "quantity": 4,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 200°F. Lightly coat a baking sheet with cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk the egg white and sugar until combined. Stir in the cinnamon, vanilla extract, and salt."
    },
    {
      "step": 3,
      "text": "Fold in the walnut halves until evenly coated, then spread them in a single layer on the prepared baking sheet."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, stirring or turning the walnuts occasionally, until the coating is dry and set. For food safety, confirm the egg coating reaches 160°F with a thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Let the walnuts cool on the baking sheet for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
