{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "bacon-wrapped-scallops",
  "name": "Bacon-Wrapped Scallops",
  "subtitle": "Tender scallops with crisp bacon",
  "description": "Wrap lemon-finished sea scallops in bacon and bake until the scallops are opaque and the bacon is cooked.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 6
    },
    {
      "ingredient_id": "sea-scallops",
      "item": "sea scallops",
      "quantity": 12,
      "preparation": "rinsed and drained"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cut each bacon slice in half. Toss the rinsed, drained scallops with the lemon juice, then wrap each scallop with a bacon piece and arrange them on a baking sheet."
    },
    {
      "step": 3,
      "text": "Bake until the bacon is cooked and the scallops are opaque, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Serve warm."
    }
  ],
