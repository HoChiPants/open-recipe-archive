{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "air-fryer-croutons",
  "name": "Air-Fryer Croutons",
  "subtitle": "Crisp, buttery seasoned bread cubes",
  "description": "Bread cubes are coated with seasoned butter and crisped in the air fryer for a quick savory topping or snack.",
  "meal_type": "snack",
  "cuisine": "French",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "slices-white-bread",
      "item": "slices white bread",
      "quantity": 4,
      "preparation": "cubed"
    },
    {
      "ingredient_id": "parsley-flakes",
      "item": "parsley flakes",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "seasoned-salt",
      "item": "seasoned salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 400°F."
    },
    {
      "step": 2,
      "text": "Whisk the parsley, garlic powder, seasoned salt, and melted butter together. Add the cubed bread and toss until evenly coated."
    },
    {
      "step": 3,
      "text": "Arrange the coated bread in the air-fryer basket in an even layer."
    },
    {
      "step": 4,
      "text": "Air-fry for 4 minutes, then shake the basket.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Cook for 2 minutes more, or until crisp and browned.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Transfer the croutons to a plate and let them cool for 5 minutes.",
      "timer_minutes": 5
    }
  ],
