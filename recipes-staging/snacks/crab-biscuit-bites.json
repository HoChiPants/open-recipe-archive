  "id": "crab-biscuit-bites",
  "name": "Crab Biscuit Bites",
  "subtitle": "Cheesy crab filling baked in biscuit cups",
  "description": "Tender biscuit cups hold a creamy crab, cheese, and green onion filling for an easy savory snack.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "refrigerated-biscuit-dough",
      "item": "refrigerated biscuit dough",
      "quantity": 2,
      "unit": "package",
      "preparation": "12 ounce"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "crab-meat",
      "item": "crab meat",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce, drained"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "thinly-sliced-green-onion",
      "item": "thinly sliced green onion",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Separate the biscuit dough into 12 portions and press each into a muffin-tin cup, covering the bottom and sides."
    },
    {
      "step": 2,
      "text": "Stir together the softened cream cheese, crab meat, mayonnaise, Parmesan, Cheddar, green onion, and Worcestershire sauce until evenly combined."
    },
    {
      "step": 3,
      "text": "Divide the filling among the biscuit cups and sprinkle with paprika."
    },
    {
      "step": 4,
      "text": "Bake for 20 minutes, until the biscuits are golden and the crab filling is hot and opaque, reaching 145°F in the center.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Cool briefly before serving. For make-ahead storage, freeze the assembled, unbaked bites, then thaw in the refrigerator before baking."
    }
  ],
