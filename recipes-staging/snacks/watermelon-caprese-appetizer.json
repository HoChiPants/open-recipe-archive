    "prep_minutes": 30,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "sprigs-fresh-basil",
      "item": "sprigs fresh basil",
      "quantity": 3,
      "preparation": "stems removed"
    },
    {
      "ingredient_id": "watermelon",
      "item": "watermelon",
      "quantity": 1,
      "unit": "small",
      "preparation": "fruit removed with a melon baller"
    },
    {
      "ingredient_id": "fresh-mozzarella-cheese",
      "item": "fresh mozzarella cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, cut into small pieces"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Remove the basil leaves from the stems and cut or tear them into small pieces."
    },
    {
      "step": 2,
      "text": "Combine the melon-balled watermelon, mozzarella, and basil in a serving bowl."
    },
    {
      "step": 3,
      "text": "Drizzle with the olive oil and balsamic vinegar, then season with salt and ground black pepper to taste."
    },
    {
      "step": 4,
      "text": "Toss gently and serve."
    }
  ],
