  "id": "watermelon-caprese-appetizer",
  "name": "Watermelon Caprese Appetizer",
  "subtitle": "A fresh melon, mozzarella, and basil salad",
  "description": "Juicy watermelon and creamy mozzarella are paired with basil, olive oil, and balsamic vinegar for a simple Italian-style appetizer.",
  "meal_type": "snack",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
