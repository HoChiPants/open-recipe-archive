  "id": "artichoke-spread",
  "name": "Artichoke Spread",
  "subtitle": "Warm, creamy artichoke dip for sharing",
  "description": "A savory baked spread combining artichokes, cream cheese, Parmesan, mayonnaise, garlic, and dill.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
