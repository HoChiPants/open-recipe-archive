      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "dried-dill-weed",
      "item": "dried dill weed",
      "quantity": 0.75,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Process the drained artichoke hearts until smooth."
    },
    {
      "step": 3,
      "text": "Whisk the artichokes with the cream cheese, Parmesan, mayonnaise, garlic, and dill until smooth."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until hot and lightly set.",
      "timer_minutes": 15
    }
