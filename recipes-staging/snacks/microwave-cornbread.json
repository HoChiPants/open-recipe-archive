  "id": "microwave-cornbread",
  "name": "Microwave Cornbread",
  "subtitle": "A small, quick cornbread made in the microwave.",
  "description": "Stir together a simple cornmeal batter and microwave until the center is fully set.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornmeal",
      "item": "cornmeal",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "In a microwave-safe dish, whisk together the flour, cornmeal, sugar, baking powder, and salt. Stir in the milk, egg, and oil until the batter is smooth."
    },
    {
      "step": 2,
      "text": "Microwave on high until the cornbread is puffed and the center is firm and fully set; add short intervals as needed if it is still wet in the middle.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Let stand briefly, then cut into 6 portions and serve."
    }
  ],
