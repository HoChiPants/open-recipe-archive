  "id": "salt-and-garlic-bagel-chips",
  "name": "Salt and Garlic Bagel Chips",
  "subtitle": "Crisp, savory slices with garlic and Parmesan",
  "description": "Turn day-old bagels into crunchy seasoned chips for snacking or serving with dips.",
  "meal_type": "snack",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "day-old-bagels",
      "item": "day old bagels",
      "quantity": 3
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "italian-seasoning",
      "item": "Italian seasoning",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "freshly-grated-parmesan-cheese",
      "item": "freshly grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Lightly prepare a baking sheet with some of the olive oil."
    },
    {
      "step": 2,
      "text": "Cut the bagels into thick slices and arrange them in a single layer on the sheet."
    },
    {
      "step": 3,
      "text": "Stir together the remaining olive oil, garlic, Italian seasoning, and Parmesan. Add salt and pepper to taste."
    },
    {
      "step": 4,
      "text": "Spoon or brush the seasoned mixture over the bagel slices."
    },
    {
      "step": 5,
      "text": "Bake until lightly browned and crisp, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Cool the chips on the baking sheet before serving."
    }
  ],
