  "name": "Classic Guacamole",
  "subtitle": "Fresh avocado dip with lime, tomato, herbs, and jalapeño",
  "description": "A chunky avocado dip combining bright lime, fresh vegetables, herbs, and chile, served with tortilla chips.",
  "meal_type": "snack",
  "cuisine": "Mexican",
