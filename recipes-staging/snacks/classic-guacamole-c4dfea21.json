  "instructions": [
    {
      "step": 1,
      "text": "Finely cut the red onion, tomatoes, coriander, and jalapeños. Set the jalapeños aside separately."
    },
    {
      "step": 2,
      "text": "Scoop the avocado flesh into a bowl and mash it to your preferred texture."
    },
    {
      "step": 3,
      "text": "Stir the onion, lime juice, tomatoes, and coriander into the avocado, then fold in the jalapeños."
    },
    {
      "step": 4,
      "text": "Serve immediately with tortilla chips."
    }
  ],
