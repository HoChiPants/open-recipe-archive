  "id": "creamy-pimento-cheese",
  "name": "Creamy Pimento Cheese",
  "subtitle": "A chilled cheddar-and-pimento spread",
  "description": "A creamy, tangy cheese spread with sharp Cheddar, diced pimentos, and a light garlic note.",
  "meal_type": "snack",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "extra-sharp-cheddar-cheese",
      "item": "extra-sharp Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "4-ounce-jar-diced-pimentos",
      "item": "(4 ounce) jar diced pimentos",
      "quantity": 1,
      "preparation": "drained"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened cream cheese and shredded Cheddar together until evenly combined."
    },
    {
      "step": 2,
      "text": "In a separate bowl, whisk the mayonnaise with the garlic powder, then fold it into the cheese mixture."
    },
    {
      "step": 3,
      "text": "Stir in the drained diced pimentos until distributed throughout."
    },
    {
      "step": 4,
      "text": "Cover and chill for at least 60 minutes before serving.",
      "timer_minutes": 60
    }
  ],
