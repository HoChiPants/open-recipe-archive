  "instructions": [
    {
      "step": 1,
      "text": "Combine the sun-dried tomatoes, crushed tomatoes, and tomato paste; let stand for 5 minutes, until the sun-dried tomatoes are tender.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Transfer the tomato mixture to a food processor with the pine nuts, onion, basil, parsley, and garlic."
    },
    {
      "step": 3,
      "text": "Add the balsamic vinegar and red wine, then blend until the mixture reaches a coarse or smooth pesto-like texture."
    },
    {
      "step": 4,
      "text": "Stir in the olive oil and grated Parmesan cheese until combined."
    },
    {
      "step": 5,
      "text": "Season with salt to taste."
    }
