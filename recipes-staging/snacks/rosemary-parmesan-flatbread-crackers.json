  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "rosemary-parmesan-flatbread-crackers",
  "name": "Rosemary Parmesan Flatbread Crackers",
  "subtitle": "Thin, savory crackers with rosemary and olive oil",
  "description": "A crisp baked snack made from a simple rosemary-and-cheese dough, rolled thin and finished with a light sprinkle of salt.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 60,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 12
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "freshly-grated-parmigiano-reggiano-cheese",
      "item": "freshly grated Parmigiano-Reggiano cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-rosemary",
      "item": "fresh rosemary",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Combine the flour, kosher salt, sugar, and Parmigiano-Reggiano in a bowl. Stir in the rosemary, olive oil, and cold water until a dough forms.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Turn the dough onto a lightly floured surface and knead until smooth, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Roll the dough very thin on a floured surface. Lightly moisten the surface with cold water, sprinkle with kosher salt, and cut into small crackers."
    },
    {
      "step": 5,
      "text": "Arrange the crackers on a floured baking sheet and bake at 400°F until crisp and lightly browned, about 12 minutes; continue checking up to 15 minutes if needed.",
      "timer_minutes": 12
    }
  ],
