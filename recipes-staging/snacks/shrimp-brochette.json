{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "shrimp-brochette",
  "name": "Shrimp Brochette",
  "subtitle": "Grilled shrimp wrapped with bacon, jalapeño, and melted cheese",
  "description": "Butterflied shrimp are filled with jalapeño, seasoned, wrapped in bacon, and grilled on skewers before being topped with melted Monterey Jack.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "large-shrimp",
      "item": "large shrimp",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "peeled, deveined and butterflied"
    },
    {
      "ingredient_id": "monterey-jack-cheese",
      "item": "Monterey Jack cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, sliced"
    },
    {
      "ingredient_id": "fresh-jalapeno-peppers",
      "item": "fresh jalapeno peppers",
      "quantity": 3,
      "preparation": "seeded and julienned"
    },
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into thirds"
    },
    {
      "ingredient_id": "cajun-seasoning",
      "item": "Cajun seasoning",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "skewers",
      "item": "skewers"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill and prepare the skewers."
    },
    {
      "step": 2,
      "text": "Place a strip of jalapeño in each butterflied shrimp. Wrap each shrimp with a third of a bacon slice and secure it with a skewer."
    },
    {
      "step": 3,
      "text": "Season the wrapped shrimp with Cajun seasoning."
    },
    {
      "step": 4,
      "text": "Grill the skewers, turning as needed, until the bacon is cooked and the shrimp are opaque and easily flaked."
    },
    {
      "step": 5,
      "text": "Top the shrimp with sliced Monterey Jack cheese and cook until the cheese is melted.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Transfer the skewers to a serving dish and let them rest briefly before serving.",
      "timer_minutes": 3
    }
  ],
