  "instructions": [
    {
      "step": 1,
      "text": "Combine the mashed cooked butternut squash with salt, freshly ground black pepper, and cayenne pepper. Stir in the mascarpone, egg yolk, and 0.33333334326744 cup grated Parmesan until combined."
    },
    {
      "step": 2,
      "text": "Place a portion of filling in the center of each round wonton wrapper. Moisten the edges, cover with another wrapper, and press firmly to seal, removing excess air."
    },
    {
      "step": 3,
      "text": "Bring salted water to a boil. Cook the ravioli in batches until the wrappers are tender and the filling reaches 160°F with a firm, fully set center, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Meanwhile, warm the butter with the unpeeled garlic and simmer until fragrant. Remove the garlic if desired, then stir in the chopped sage."
    },
    {
      "step": 5,
      "text": "Transfer the cooked ravioli to the butter mixture and serve with freshly ground black pepper, cayenne pepper, mascarpone cheese, and grated Parmesan cheese."
    }
  ],
