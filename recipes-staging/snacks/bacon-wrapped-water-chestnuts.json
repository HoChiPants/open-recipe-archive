  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cut the bacon into pieces and wrap each water chestnut with bacon."
    },
    {
      "step": 3,
      "text": "Arrange the wrapped chestnuts in a baking dish."
    },
    {
      "step": 4,
      "text": "Bake for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Combine the brown sugar, mayonnaise, and chili sauce."
    },
    {
      "step": 6,
      "text": "Pour the sauce over the bacon-wrapped chestnuts, then bake for 15 minutes more, until the bacon is cooked through and crisp.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Serve warm."
    }
  ],
