  "id": "pickled-garlic",
  "name": "Pickled Garlic",
  "subtitle": "Tangy garlic with sweet pepper",
  "description": "Garlic and red bell pepper steep in a sweet, vinegar-based pickling liquid for a sharp, snackable condiment.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
