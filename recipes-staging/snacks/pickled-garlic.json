    "inactive_minutes": 30240
  },
  "ingredients": [
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "red-bell-pepper",
      "item": "red bell pepper",
      "quantity": 1,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.66000002622604,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-dry-mustard",
      "item": "ground dry mustard",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "celery-seed",
      "item": "celery seed",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the peeled garlic and chopped red bell pepper in a clean heatproof container."
    },
    {
      "step": 2,
      "text": "Combine the vinegar and sugar in a saucepan over medium heat. Stir in the dry mustard and celery seed."
    },
    {
      "step": 3,
      "text": "Bring the vinegar mixture to a simmer and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Pour the hot liquid over the garlic and pepper, then let the mixture cool."
    },
    {
      "step": 5,
      "text": "Cover and refrigerate for 21 days before serving.",
      "timer_minutes": 30240
    }
  ],
