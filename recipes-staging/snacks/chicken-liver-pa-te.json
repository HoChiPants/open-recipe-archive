  "id": "chicken-liver-pa-te",
  "name": "Chicken Liver Pâté",
  "subtitle": "A smooth savory spread with sherry and cream cheese",
  "description": "Cooked chicken livers are blended with aromatics, sherry, cream cheese, and seasonings, then chilled until spreadable.",
  "meal_type": "snack",
  "cuisine": "French",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "peeled and chopped"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "chicken-livers",
      "item": "chicken livers",
      "quantity": 0.25,
      "unit": "pound",
      "preparation": "trimmed and chopped"
    },
    {
      "ingredient_id": "dry-sherry",
      "item": "dry sherry",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 0.33000001311302,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "hot-sauce-to-taste",
      "item": "hot sauce to taste"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the butter in a skillet over medium heat. Add the garlic, onion, and chicken livers; stir to coat."
    },
    {
      "step": 2,
      "text": "Cook the livers for about 10 minutes, stirring occasionally, until tender and a thermometer inserted into the thickest piece reads 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Transfer the cooked livers to a blender or food processor. Whisk together the sherry, softened cream cheese, hot sauce, and salt and pepper, then add the mixture to the livers."
    },
    {
      "step": 4,
      "text": "Blend until smooth, scraping down the sides as needed. Transfer to a serving container and chill for 2 hours.",
      "timer_minutes": 120
    }
  ],
