  },
  "ingredients": [
    {
      "ingredient_id": "roma-tomatoes",
      "item": "Roma tomatoes",
      "quantity": 4,
      "preparation": "halved lengthwise"
    },
    {
      "ingredient_id": "jalapeno-pepper",
      "item": "jalapeno pepper",
      "quantity": 1,
      "preparation": "halved and seeded"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 0.5,
      "preparation": "cut into 2 wedges"
    },
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
