      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 390°F."
    },
    {
      "step": 2,
      "text": "Arrange the tomatoes, jalapeño, and onion in the basket. Spray lightly with cooking spray."
    },
    {
      "step": 3,
      "text": "Air-fry until the vegetables are softened and browned at the edges, adding the garlic halfway through and spraying lightly again if needed.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Let the vegetables cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer the vegetables and garlic to a blender or food processor. Add the cilantro, lime juice, and salt, then pulse to your preferred texture."
    },
    {
      "step": 6,
      "text": "Chill before serving."
    }
  ],
