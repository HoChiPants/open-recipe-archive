  "id": "air-fryer-roasted-salsa",
  "name": "Air Fryer Roasted Salsa",
  "subtitle": "Charred tomato salsa with jalapeño, garlic, and lime",
  "description": "A fresh, blended salsa made by air-frying tomatoes, jalapeño, and onion until softened and lightly browned.",
  "meal_type": "snack",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
