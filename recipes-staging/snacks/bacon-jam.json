  "id": "bacon-jam",
  "name": "Bacon Jam",
  "subtitle": "A sweet, smoky spread with bourbon and coffee",
  "description": "Slow-cooked bacon, onions, spices, and tangy-sweet additions reduce into a rich savory jam for serving with bread, sandwiches, or appetizers.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
