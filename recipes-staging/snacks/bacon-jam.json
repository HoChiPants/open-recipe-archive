  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a large skillet or Dutch oven until browned and rendered. Drain, reserving 0.5 cup of the drippings.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Return the reserved drippings and bacon to the pan. Add the onions and cook until softened, stirring occasionally.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the brown sugar, cayenne, cinnamon, nutmeg, and garlic. Cook until the garlic is fragrant.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the bourbon, coffee, sherry vinegar, and maple syrup. Stir in the ketchup and simmer until the mixture is thick and jam-like.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Let the bacon jam cool for 15 minutes, then prepare it for serving as a chunky or finely textured spread.",
      "timer_minutes": 15
    }
  ],
