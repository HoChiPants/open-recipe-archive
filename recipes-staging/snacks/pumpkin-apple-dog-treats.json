      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "canned-pumpkin",
      "item": "canned pumpkin",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F and prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Combine the oats, grated apple, egg, and pumpkin. Stir until a thick dough forms."
    },
    {
      "step": 3,
      "text": "Use the additional oats as needed to prevent sticking while shaping the dough. Flatten it and cut into 24 pieces."
    },
    {
      "step": 4,
      "text": "Transfer the pieces to the baking sheet and bake for 15 minutes, until firm and the center is fully set and reaches 160°F.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Cool completely before serving."
    }
  ],
