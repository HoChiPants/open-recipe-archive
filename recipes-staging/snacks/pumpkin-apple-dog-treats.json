  "id": "pumpkin-apple-dog-treats",
  "name": "Pumpkin Apple Dog Treats",
  "subtitle": "Tender baked treats with pumpkin, apple, and oats",
  "description": "Simple oven-baked dog treats combining grated apple, pumpkin, egg, and oats into a sliceable dough.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 4,
      "unit": "cups",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "apple",
      "item": "apple",
      "quantity": 1,
      "unit": "medium",
      "preparation": "cored and grated"
    },
    {
