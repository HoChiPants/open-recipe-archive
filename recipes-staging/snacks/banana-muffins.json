    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ripe-bananas",
      "item": "ripe bananas",
      "quantity": 3,
      "preparation": "mashed"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "chocolate-chips",
      "item": "chocolate chips",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F and prepare a 12-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, white sugar, baking soda, and baking powder."
    },
    {
      "step": 3,
      "text": "Stir in the mashed bananas, mayonnaise, and chocolate chips until combined."
    },
    {
      "step": 4,
      "text": "Divide the batter among the muffin cups."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, until the muffins are set and a tester inserted in the center comes out clean.",
      "timer_minutes": 20
    }
  ],
