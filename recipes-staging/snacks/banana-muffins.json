  "id": "banana-muffins",
  "name": "Banana Muffins",
  "subtitle": "Tender muffins with ripe banana and chocolate chips",
  "description": "Quickly mix a banana batter with chocolate chips, portion it into a muffin pan, and bake until set.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
