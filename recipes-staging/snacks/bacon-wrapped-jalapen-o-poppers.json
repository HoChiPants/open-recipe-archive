  "id": "bacon-wrapped-jalapen-o-poppers",
  "name": "Bacon-Wrapped Jalapeño Poppers",
  "subtitle": "Creamy cheese-filled peppers baked until crisp",
  "description": "Jalapeño halves filled with a cheddar cream cheese mixture, wrapped in bacon, and baked for an easy savory snack.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sharp-cheddar-cheese",
      "item": "sharp Cheddar cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "jalapeno-peppers",
      "item": "jalapeno peppers",
      "quantity": 12,
      "preparation": "halved lengthwise, seeds and membranes removed"
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 12
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Stir the cream cheese and shredded Cheddar together until evenly combined."
    },
    {
      "step": 3,
      "text": "Cut each bacon slice in half."
    },
    {
      "step": 4,
      "text": "Fill the jalapeño halves with the cheese mixture, then wrap each with bacon."
    },
    {
      "step": 5,
      "text": "Arrange the poppers on a baking sheet and bake until the bacon is crisp and the filling is hot, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Serve warm."
    }
  ],
