      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "oil-for-frying",
      "item": "oil for frying",
      "quantity": 1,
      "unit": "quart"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Boil the plantain chunks until tender, then drain well and mash until smooth.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Warm the refried black beans. Season the mashed plantains with the sugar and salt, mixing thoroughly."
    },
    {
      "step": 3,
      "text": "Form portions of mashed plantain into thin rounds, place a spoonful of beans in the center, and enclose the filling. Shape into compact oval cakes."
    },
    {
      "step": 4,
      "text": "Heat the frying oil to 375°F in a deep, heavy pot."
    },
    {
      "step": 5,
      "text": "Fry the rellენitos in batches until crisp and golden on all sides. Drain on a lined tray and serve warm."
    }
  ],
