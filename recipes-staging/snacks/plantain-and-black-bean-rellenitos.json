  "id": "plantain-and-black-bean-rellenitos",
  "name": "Plantain and Black Bean Rellenitos",
  "subtitle": "Crisp plantain pockets with a savory bean filling",
  "description": "Tender mashed plantains surround seasoned refried black beans, then fry until golden for a satisfying snack.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "plantains",
      "item": "plantains",
      "quantity": 6,
      "preparation": "peeled and broken into chunks"
    },
    {
      "ingredient_id": "refried-black-beans",
      "item": "refried black beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
