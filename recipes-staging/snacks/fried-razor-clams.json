  "id": "fried-razor-clams",
  "name": "Fried Razor Clams",
  "subtitle": "Crisp cracker-coated clams with gentle heat",
  "description": "Razor clams are dipped in beaten egg, coated with seasoned cracker crumbs, and fried until golden and opaque.",
  "meal_type": "snack",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "oil-for-frying",
      "item": "oil for frying",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "saltine-crackers",
      "item": "saltine crackers",
      "quantity": 1,
      "unit": "packet",
      "preparation": "4 ounce, finely crushed"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cayenne-pepper",
      "item": "ground cayenne pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "razor-clams",
      "item": "razor clams",
      "quantity": 4,
      "unit": "large",
      "preparation": "cleaned and dried"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the frying oil in a skillet over medium-high heat until shimmering."
    },
    {
      "step": 2,
      "text": "Combine the crushed crackers, black pepper, cayenne, paprika, and garlic powder in a shallow dish."
    },
    {
      "step": 3,
      "text": "Place the beaten eggs in a second shallow dish. Dip each clam in the egg, then coat it thoroughly with the seasoned crumbs."
    },
    {
      "step": 4,
      "text": "Fry the coated clams until golden brown, turning as needed, about 5 minutes total. Cook until the clams are opaque and easily flaked.",
      "timer_minutes": 5
    }
  ],
