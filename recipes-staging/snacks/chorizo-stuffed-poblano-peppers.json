  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet over medium heat. Add the chorizo and cook, stirring and breaking it up, for 10 minutes, until it reaches 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the rice, onion, 0.25 cup taco sauce, Cheddar, and cumin."
    },
    {
      "step": 4,
      "text": "Spread the remaining taco sauce in a baking dish. Arrange the poblano halves in the dish and fill them with the chorizo mixture."
    },
    {
      "step": 5,
      "text": "Pour the water around the peppers."
    },
    {
      "step": 6,
      "text": "Bake for 60 minutes, until the peppers are tender and the filling reaches 165°F in the center.",
      "timer_minutes": 60
    }
  ],
