  "id": "chorizo-stuffed-poblano-peppers",
  "name": "Chorizo-Stuffed Poblano Peppers",
  "subtitle": "Savory peppers filled with chorizo, rice, and cheddar",
  "description": "Poblano halves hold a warmly spiced chorizo-and-rice filling and bake until tender.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
