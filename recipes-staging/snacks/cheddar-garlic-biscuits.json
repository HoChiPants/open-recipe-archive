  "id": "cheddar-garlic-biscuits",
  "name": "Cheddar Garlic Biscuits",
  "subtitle": "Tender, cheese-filled biscuits with a buttery garlic finish",
  "description": "Quick drop biscuits made with Cheddar cheese and milk, baked until lightly browned, then finished with warm garlic butter.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "biscuit-mix",
      "item": "biscuit mix",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "mild-cheddar-cheese",
      "item": "mild Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Combine the biscuit mix, shredded Cheddar, and milk until a soft dough forms."
    },
    {
      "step": 3,
      "text": "Portion the dough onto a baking sheet."
    },
    {
      "step": 4,
      "text": "Bake for 10 minutes, or until lightly browned.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "While the biscuits bake, warm the butter and garlic powder together for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Brush the warm garlic butter over the baked biscuits before serving."
    }
  ],
