  "id": "baked-kale-chips",
  "name": "Baked Kale Chips",
  "subtitle": "Crisp, lightly salted greens from the oven",
  "description": "Tender kale leaves are coated with olive oil, seasoned with sea salt, and baked until crisp.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "bunch-kale",
      "item": "bunch kale",
      "quantity": 1
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flaked-sea-salt",
      "item": "flaked sea salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Remove the kale stems and tear the leaves into thick, bite-size pieces. Wash and dry the leaves thoroughly."
    },
    {
      "step": 3,
      "text": "Toss the kale with the olive oil until evenly coated."
    },
    {
      "step": 4,
      "text": "Arrange the leaves in a single layer on a baking sheet and sprinkle with the sea salt."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, or until crisp.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Cool briefly before serving."
    }
  ],
