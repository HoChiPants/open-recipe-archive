  "id": "savory-pumpkin-hummus",
  "name": "Savory Pumpkin Hummus",
  "subtitle": "A creamy pumpkin dip with warm spices and toasted seeds.",
  "description": "Blend chickpeas, pumpkin, tahini, lemon, garlic, and spices into a smooth dip, then chill and finish with pumpkin seeds and paprika.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "tahini",
      "item": "tahini",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "chickpea",
      "item": "garbanzo beans",
      "quantity": 2,
      "unit": "can",
      "preparation": "15 ounce, drained"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "pumpkin-puree",
      "item": "pumpkin puree",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "pumpkin-seed-kernels",
      "item": "pumpkin seed kernels",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "toasted, or more to taste"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Process the lemon juice, tahini, garlic, and salt until smooth."
    },
    {
      "step": 2,
      "text": "Add the drained garbanzo beans and olive oil; process until smooth."
    },
    {
      "step": 3,
      "text": "Add the pumpkin puree, cumin, cayenne, and pumpkin seed kernels, and process until combined."
    },
    {
      "step": 4,
      "text": "Transfer the hummus to a serving bowl and refrigerate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Fold in the pumpkin puree and pumpkin seed kernels, then dust with paprika before serving."
    }
  ],
