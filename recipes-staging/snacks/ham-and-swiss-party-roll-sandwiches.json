  "id": "ham-and-swiss-party-roll-sandwiches",
  "name": "Ham and Swiss Party Roll Sandwiches",
  "subtitle": "Warm, savory sandwiches for sharing",
  "description": "Soft rolls filled with chopped ham and Swiss cheese, layered with a buttery mustard-poppy seed spread, and baked until lightly browned.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "grated"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "poppy-seeds",
      "item": "poppy seeds",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "prepared-dijon-style-mustard",
      "item": "prepared Dijon-style mustard",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "white-party-rolls",
      "item": "white party rolls",
      "quantity": 2,
      "unit": "package",
      "preparation": "12 ounce"
    },
    {
      "ingredient_id": "ham",
      "item": "ham",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "chopped cooked"
    },
    {
      "ingredient_id": "swiss-cheese",
      "item": "Swiss cheese",
      "quantity": 5,
      "unit": "ounces",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir together the onion, softened butter, poppy seeds, mustard, and Worcestershire sauce until combined."
    },
    {
      "step": 3,
      "text": "Cut the party rolls horizontally, keeping each package together as a top and bottom portion."
    },
    {
      "step": 4,
      "text": "Spread the butter mixture over the cut sides of the rolls. Layer in the ham and shredded Swiss cheese, then replace the tops."
    },
    {
      "step": 5,
      "text": "Bake the assembled rolls at 350°F until lightly browned.",
      "timer_minutes": 12
    }
  ],
