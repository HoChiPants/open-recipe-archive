{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "sausage-filled-wonton-bites",
  "name": "Sausage-Filled Wonton Bites",
  "subtitle": "Crisp wonton cups with savory sausage and cheese",
  "description": "Baked wonton cups filled with sage sausage, Colby cheese, peppers, green onions, and ranch dressing.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "square-wonton-wrappers",
      "item": "square wonton wrappers",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "sage-flavored-bulk-sausage",
      "item": "sage-flavored bulk sausage",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "colby-cheese",
      "item": "Colby cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "bunch-green-onions",
      "item": "bunch green onions",
      "quantity": 1,
      "preparation": "chopped fine"
    },
    {
      "ingredient_id": "red-bell-pepper",
      "item": "red bell pepper",
      "quantity": 0.5,
      "preparation": "chopped fine"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 0.5,
      "preparation": "chopped fine"
    },
    {
      "ingredient_id": "ranch-salad-dressing",
      "item": "ranch salad dressing",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Press square wonton wrappers into the cups of a muffin tin to form shallow cups."
    },
    {
      "step": 2,
      "text": "Bake the wrappers until golden brown, about 10 minutes. Transfer the cups to a work surface and let them cool.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Cook the sausage in a skillet over medium heat, stirring and breaking it up, until it reaches 160°F, about 7 minutes. Drain and cool until set.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Stir the cooled sausage with the Colby cheese, green onions, red and green bell peppers, and ranch salad dressing."
    },
    {
      "step": 5,
      "text": "Fill the baked wonton cups with the sausage mixture and return them to the muffin tin."
    },
    {
      "step": 6,
      "text": "Bake until the cheese is melted, about 20 minutes.",
      "timer_minutes": 20
    }
  ],
  "tags": [
