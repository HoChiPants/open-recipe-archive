  "id": "spinach-stuffed-mushrooms",
  "name": "Spinach-Stuffed Mushrooms",
  "subtitle": "Tender mushrooms with a savory spinach and cheese filling",
  "description": "Mushroom caps are lightly oiled, pre-baked, filled with spinach, cheese, egg, and breadcrumbs, then baked until golden and set.",
  "meal_type": "snack",
  "cuisine": "American",
