  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Brush a baking dish and the mushroom caps with the olive oil; arrange the caps with the openings facing up."
    },
    {
      "step": 2,
      "text": "Bake the mushrooms for 12 minutes, until tender. Drain any liquid from the dish and blot excess moisture from the caps if needed.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Whisk the egg with the minced garlic, salt, and ground black pepper. Stir in the drained spinach, Parmesan, Gouda, mozzarella, and bread crumbs until combined."
    },
    {
      "step": 4,
      "text": "Spoon the filling into the mushroom caps and return them to the baking dish. Sprinkle with the remaining grated or shredded cheeses."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, until golden brown and the filling is firm and reaches 160°F in the center.",
      "timer_minutes": 10
    }
  ],
