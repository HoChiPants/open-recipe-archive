  "id": "bacon-cheddar-jalapen-o-poppers",
  "name": "Bacon Cheddar Jalapeño Poppers",
  "subtitle": "Grilled peppers filled with cheddar and wrapped in bacon",
  "description": "Jalapeño halves are filled with cheddar, wrapped in bacon, and grilled until the bacon is crisp and the cheese is melted.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "jalapeno-peppers",
      "item": "jalapeno peppers",
      "quantity": 6,
      "preparation": "seeded and halved"
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 12
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill to medium heat."
    },
    {
      "step": 2,
      "text": "Cut the cheddar into pieces that fit inside the jalapeño halves. Cut the bacon as needed for wrapping."
    },
    {
      "step": 3,
      "text": "Place cheddar in each pepper half, then wrap each popper with bacon and secure if needed."
    },
    {
      "step": 4,
      "text": "Transfer the poppers to the grill and cook until the bacon is crisp and the cheese is melted, about 10 minutes, turning as needed for even cooking.",
      "timer_minutes": 10
    }
  ],
