  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the sugar and water in a saucepan. Bring to a simmer, stirring until the sugar dissolves."
    },
    {
      "step": 3,
      "text": "Add the peanuts and stir until they are evenly coated."
    },
    {
      "step": 4,
      "text": "Transfer the coated peanuts to a baking sheet and bake at 350°F until crisp.",
