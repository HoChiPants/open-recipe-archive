  "id": "oat-flapjacks",
  "name": "Oat Flapjacks",
  "subtitle": "Chewy oat bars with buttery caramel notes",
  "description": "A simple baked oat treat made with butter, brown sugar, and golden syrup.",
  "meal_type": "snack",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-sugar",
      "item": "light brown sugar",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-syrup",
      "item": "golden syrup",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "porridge-oats",
      "item": "porridge oats",
      "quantity": 250,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking tin."
    },
    {
      "step": 2,
      "text": "Melt the butter, light brown sugar, and golden syrup together in a saucepan, stirring until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the porridge oats until evenly coated, then transfer the mixture to the prepared tin and press it into an even layer."
    },
    {
      "step": 4,
      "text": "Bake for 25 minutes, until set and lightly golden.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Cool in the tin for 3 minutes, then cut into 12 portions.",
      "timer_minutes": 3
    }
  ],
