  "schema_version": "1.0.0",
  "id": "crab-cakes",
  "name": "Crab Cakes",
  "subtitle": "Tender crab cakes with parsley and a lightly spicy finish",
  "description": "Shape seasoned crab mixture into cakes, grill until golden, and serve with a quick mustard-mayonnaise sauce.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "crabmeat",
      "item": "crabmeat",
      "quantity": 1,
      "unit": "pound",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-dry-mustard",
      "item": "ground dry mustard",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "hot-pepper-sauce",
      "item": "hot pepper sauce",
      "quantity": 1,
      "unit": "dash"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Lightly coat the grate with cooking spray."
    },
    {
      "step": 2,
      "text": "Mix the crabmeat, bread crumbs, parsley, salt and pepper, egg, and hot pepper sauce until evenly combined."
    },
    {
      "step": 3,
      "text": "Shape the mixture into four cakes."
    },
    {
      "step": 4,
      "text": "Stir the mayonnaise, dry mustard, and hot pepper sauce together in a small bowl."
    },
    {
      "step": 5,
      "text": "Grill the crab cakes until golden brown and the center is firm and reaches 160°F, about 7 minutes, turning as needed.",
      "timer_minutes": 7
    },
    {
      "step": 6,
      "text": "Serve the crab cakes with the mustard-mayonnaise sauce."
    }
  ],
