{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "flax-seed-crackers",
  "name": "Flax Seed Crackers",
  "subtitle": "Crisp, savory crackers with a gentle cayenne heat",
  "description": "Flax seeds are soaked until gelled, seasoned, spread thinly, and baked low and slow for a crisp snack.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 180,
    "inactive_minutes": 480
  },
  "ingredients": [
    {
      "ingredient_id": "raw-flax-seeds",
      "item": "raw flax seeds",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "onion-powder",
      "item": "onion powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flax seeds, salt, garlic powder, onion powder, and cayenne pepper in a bowl. Stir in the cold water until evenly mixed."
    },
    {
      "step": 2,
      "text": "Cover and chill for 8 hours, or until the seeds form a thick, gel-like mixture.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Preheat the oven to 200°F."
    },
    {
      "step": 4,
      "text": "Spread the mixture in a thin, even layer on a prepared baking sheet."
    },
    {
      "step": 5,
      "text": "Bake for 3 hours, or until dry and crisp.",
      "timer_minutes": 180
    },
    {
      "step": 6,
      "text": "Cool completely, then break into crackers."
    }
  ],
