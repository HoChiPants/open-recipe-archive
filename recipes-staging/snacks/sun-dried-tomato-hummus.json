  "id": "sun-dried-tomato-hummus",
  "name": "Sun-Dried Tomato Hummus",
  "subtitle": "Creamy chickpea dip with basil and tangy tomatoes",
  "description": "Blend chickpeas with tahini, lemon, garlic, and sun-dried tomatoes, then chill and finish with seasoned oil.",
  "meal_type": "snack",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "tahini-paste",
      "item": "tahini paste",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "chickpea",
      "item": "garbanzo beans",
      "quantity": 2,
      "unit": "can",
      "preparation": "15.5 ounce, drained"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "oil-packed-sun-dried-tomatoes",
      "item": "oil-packed sun-dried tomatoes",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "drained"
    },
    {
      "ingredient_id": "finely-shredded-fresh-basil",
      "item": "finely shredded fresh basil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 0.125,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine lemon juice, tahini, garlic, and salt in a food processor; process until smooth."
    },
    {
      "step": 2,
      "text": "Add the drained garbanzo beans and 0.5 cup olive oil, then blend until smooth."
    },
    {
      "step": 3,
      "text": "Add the sun-dried tomatoes and process briefly to incorporate. Pulse in the shredded basil until evenly distributed."
    },
    {
      "step": 4,
      "text": "Transfer the hummus to a serving bowl and refrigerate for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Stir the 2 tablespoons olive oil with the paprika and spoon it over the chilled hummus."
    }
  ],
