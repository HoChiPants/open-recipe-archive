  "id": "chewy-flapjacks",
  "name": "Chewy Flapjacks",
  "subtitle": "Oat squares with a soft, chewy center",
  "description": "A simple baked oat treat sweetened with golden syrup and brown sugar.",
  "meal_type": "snack",
  "yield": {
    "quantity": 12,
    "unit": "squares"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-or-baking-margarine",
      "item": "unsalted butter or baking margarine",
      "quantity": 375,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-syrup",
      "item": "golden syrup",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "soft-brown-sugar",
      "item": "soft brown sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "porridge-oats",
      "item": "porridge oats",
      "quantity": 500,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F (180°C) and line a baking pan with parchment."
    },
    {
      "step": 2,
      "text": "Melt the butter or baking margarine with the golden syrup and brown sugar in a saucepan, stirring until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the porridge oats until evenly coated, then press the mixture firmly into the prepared pan."
    },
    {
      "step": 4,
      "text": "Bake until set and lightly golden at the edges.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Cool in the pan until firm enough to handle, then cut into 12 squares.",
      "timer_minutes": 15
    }
  ],
