  "id": "brown-sugar-cinnamon-glazed-popcorn",
  "name": "Brown Sugar Cinnamon Glazed Popcorn",
  "subtitle": "Warm, buttery popcorn with a cinnamon-sugar coating",
  "description": "Popcorn kernels are coated in a quick brown sugar, butter, cream, and cinnamon glaze for a sweet sharing snack.",
  "meal_type": "snack",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "light-brown-sugar",
      "item": "light brown sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 10,
      "unit": "g"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "a-sprinkle-of-ground-cinnamon",
      "item": "a sprinkle of ground cinnamon"
    },
    {
      "ingredient_id": "popcorn-kernels",
      "item": "popcorn kernels",
      "quantity": 100,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pop the popcorn kernels in a large covered pan over medium heat, then transfer the popped corn to a large bowl."
    },
    {
      "step": 2,
      "text": "Warm the light brown sugar in a saucepan, stirring until it begins to loosen. Whisk in the butter."
    },
    {
      "step": 3,
      "text": "Heat the double cream with the ground cinnamon until warm, then stir it into the sugar mixture."
    },
    {
      "step": 4,
      "text": "Pour the glaze over the popcorn and toss continuously over low heat for 4 minutes, until evenly coated.",
      "timer_minutes": 4
    }
  ],
