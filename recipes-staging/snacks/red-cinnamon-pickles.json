  "instructions": [
    {
      "step": 1,
      "text": "Prepare the cucumbers and cut them into pickle-sized pieces."
    },
    {
      "step": 2,
      "text": "Dissolve the pickling lime in water, add the cucumbers, and soak for 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 3,
      "text": "Drain the cucumbers, transfer them to fresh water, and soak for 3 hours. Drain thoroughly.",
      "timer_minutes": 180
    },
    {
      "step": 4,
      "text": "Combine the vinegar, red food coloring, powdered alum, and water with the cucumbers. Simmer, then let cool for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Heat the vinegar, sugar, water, cinnamon red hot candies, and cinnamon sticks to make a syrup."
    },
    {
      "step": 6,
      "text": "Transfer the cucumbers to the syrup and let them stand for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 7,
      "text": "Drain the cucumbers and reserve the liquid. Bring the liquid to a boil, return it to the cucumbers, and simmer for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "Let the pickles stand for 24 hours, then cool and chill before serving.",
      "timer_minutes": 1440
    }
  ],
