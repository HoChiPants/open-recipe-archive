  "id": "red-cinnamon-pickles",
  "name": "Red Cinnamon Pickles",
  "subtitle": "Bright, sweet cucumber pickles with cinnamon heat",
  "description": "Cucumber pieces are lime-treated for texture, then simmered in a red cinnamon syrup and chilled until infused.",
  "meal_type": "snack",
