  "instructions": [
    {
      "step": 1,
      "text": "Stir 2 tablespoons warm water with 0.125 teaspoon yeast. Let stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mix the starter with 1 cup bread flour, 1/3 cup warm water, and 2 tablespoons warm milk. Stir in 0.5 teaspoon yeast and let stand for 12 hours.",
      "timer_minutes": 720
    },
    {
      "step": 3,
      "text": "Add the remaining 2/3 cup warm water, olive oil, and 2 cups bread flour. Blend until combined, then work in the salt and knead or mix for 8 minutes, until smooth.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Cover and let the dough rise for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Turn the dough onto a floured surface, cut it into portions, and shape each gently. Dust with bread flour, cover, and let rise for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Place the dough on a baking surface and let it rest for 45 minutes while the oven heats to 425°F.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Bake for 20 minutes, until deeply golden and set. Cool before serving.",
      "timer_minutes": 20
    }
  ],
