    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "minced"
    },
    {
      "ingredient_id": "anchovy-fillets-packed-in-olive-oil",
      "item": "anchovy fillets packed in olive oil",
      "quantity": 4,
      "unit": "can",
      "preparation": "2 ounce, drained"
    },
    {
      "ingredient_id": "sardines-packed-in-olive-oil",
      "item": "sardines packed in olive oil",
      "quantity": 3,
      "unit": "can",
      "preparation": "4 ounce, drained"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm a heavy saucepan over low heat and add the vegetable oil."
    },
    {
      "step": 2,
      "text": "Stir in the minced garlic and cook for 5 minutes, until golden brown.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the drained anchovies, sardines, and butter. Stir continuously for 15 minutes, until the fish reaches 145°F and the mixture is smooth.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Transfer to a serving vessel and serve warm."
    }
  ],
