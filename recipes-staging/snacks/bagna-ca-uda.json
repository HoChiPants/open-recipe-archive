  "id": "bagna-ca-uda",
  "name": "Bagna Càuda",
  "subtitle": "Warm garlic, anchovy, and sardine dip",
  "description": "A savory Italian dip made by gently cooking minced garlic with oil, preserved fish, and butter. Serve warm for dipping.",
  "meal_type": "snack",
  "cuisine": "Italian",
  "yield": {
    "quantity": 32,
    "unit": "servings"
  },
