  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Separate the chicken wings at the joints if needed, and discard or reserve the tips for another use."
    },
    {
      "step": 3,
      "text": "Melt the butter with the minced garlic over low heat for about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Mix the Parmesan, parsley, oregano, paprika, salt, and black pepper in a bowl."
    },
    {
      "step": 5,
      "text": "Toss the wings with the garlic butter, then coat them with the Parmesan seasoning. Arrange them in a baking dish or on a baking sheet."
    },
    {
      "step": 6,
      "text": "Bake for 60 minutes, until browned and the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 60
    }
  ],
