  "id": "crispy-baked-chicken-wings",
  "name": "Crispy Baked Chicken Wings",
  "subtitle": "Garlic, herb, and Parmesan wings from the oven",
  "description": "Chicken wings are coated in garlic butter and a savory Parmesan-herb seasoning, then baked until crisp and safely cooked.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
