  "id": "chilli-maple-chicken-wings",
  "name": "Chilli-Maple Chicken Wings",
  "subtitle": "Sticky, spicy wings with cool dipping sauce",
  "description": "Oven-cooked chicken wings coated in a thick chilli-maple glaze and served with celery and soured cream.",
  "meal_type": "snack",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-wings",
      "item": "chicken wings",
      "quantity": 1,
      "unit": "kg"
    },
    {
      "ingredient_id": "oil-for-drizzling",
      "item": "oil for drizzling"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "hot-chilli-sauce",
      "item": "hot chilli sauce",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "celery-sticks-to-serve",
      "item": "celery sticks to serve"
    },
    {
      "ingredient_id": "soured-cream-for-dunking",
      "item": "soured cream for dunking"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Arrange the chicken wings on a baking tray and drizzle with oil."
    },
    {
      "step": 2,
      "text": "Bake the wings for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Meanwhile, combine the butter, hot chilli sauce, brown sugar, and maple syrup in a pan. Heat until the mixture is thick."
    },
    {
      "step": 4,
      "text": "Coat the wings with the sauce and return them to the oven for 20 minutes, until cooked through and the thickest pieces reach 165°F internally.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Whisk the soured cream until smooth and serve with the wings and celery sticks."
    }
  ],
