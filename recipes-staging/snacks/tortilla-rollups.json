  "id": "tortilla-rollups",
  "name": "Tortilla Rollups",
  "subtitle": "A chilled, creamy taco-seasoned tortilla snack",
  "description": "Soft tortillas spread with a savory cream cheese mixture, rolled, chilled, and sliced into bite-size portions.",
  "meal_type": "snack",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 4,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "taco-seasoning-mix",
      "item": "taco seasoning mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1 ounce"
    },
    {
      "ingredient_id": "10-inch-flour-tortillas",
      "item": "(10 inch) flour tortillas",
      "quantity": 14
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened cream cheese and sour cream until smooth. Stir in the green onions and taco seasoning mix until evenly combined."
    },
    {
      "step": 2,
      "text": "Spread the mixture evenly over the tortillas, leaving a narrow border. Roll each tortilla tightly and arrange the rolls seam-side down."
    },
    {
      "step": 3,
      "text": "Cover and freeze the rolls for 20 minutes to firm them.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Slice the chilled rolls into bite-size pieces and serve."
    }
  ],
