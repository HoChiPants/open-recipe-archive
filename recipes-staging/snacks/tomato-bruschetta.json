  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Stir together the tomatoes, sweet onion, olive oil, oregano, basil, and parsley."
    },
    {
      "step": 3,
      "text": "Arrange the bread slices on a baking sheet, spoon the tomato mixture over them, and finish with the Parmesan."
    },
    {
      "step": 4,
      "text": "Bake until the bread is crisp and the cheese is melted.",
