  "ingredients": [
    {
      "ingredient_id": "raw-peanuts",
      "item": "raw peanuts",
      "quantity": 5,
      "unit": "pounds",
      "preparation": "in shells"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "water-to-cover",
      "item": "water to cover"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the raw peanuts in a large stockpot. Add the salt and enough water to cover the peanuts."
    },
    {
      "step": 2,
      "text": "Bring the water to a boil, then reduce the heat and simmer the peanuts, keeping them covered with water, for 3 hours or until tender.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Serve warm or drain and cool before serving."
    }
  ],
