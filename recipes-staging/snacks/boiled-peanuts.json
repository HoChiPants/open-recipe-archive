  "id": "boiled-peanuts",
  "name": "Boiled Peanuts",
  "subtitle": "Tender peanuts simmered in seasoned water",
  "description": "Raw peanuts cook slowly in salted water until soft and flavorful, making a simple Southern-style snack.",
  "meal_type": "snack",
  "yield": {
    "quantity": 40,
    "unit": "servings"
  },
