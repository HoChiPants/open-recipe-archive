  "id": "apple-doughnuts",
  "name": "Apple Doughnuts",
  "subtitle": "Crisp apple rings with honeyed soft cheese",
  "description": "Turn crunchy apple slices into a simple no-cook snack with a creamy honey topping, optional nut butter, and colorful sprinkles.",
  "meal_type": "snack",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "soft-cheese",
      "item": "soft cheese",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "apples-use-a-crunchy-eating-variety",
      "item": "apples (use a crunchy eating variety)",
      "quantity": 3
    },
    {
      "ingredient_id": "almond-or-peanut-butter-optional",
      "item": "almond or peanut butter (optional)",
      "quantity": "3-4",
      "unit": "tbsp",
      "optional": true
    },
    {
      "ingredient_id": "coloured-sprinkles-to-decorate",
      "item": "coloured sprinkles to decorate"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the soft cheese and honey together until smooth."
    },
    {
      "step": 2,
      "text": "Cut the apples into thick rounds, then remove the cores to make rings."
    },
    {
      "step": 3,
      "text": "Spread the honeyed cheese over the apple rings. Add small spoonfuls of the optional almond or peanut butter."
    },
    {
      "step": 4,
      "text": "Finish with colored sprinkles and serve immediately."
    }
  ],
