  "id": "swedish-chocolate-oat-balls",
  "name": "Swedish Chocolate Oat Balls",
  "subtitle": "Cocoa oat bites finished with grated coconut",
  "description": "Chewy chocolate oat balls with coffee, vanilla, a subtle cayenne warmth, and a coconut coating.",
  "meal_type": "snack",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "quick-cooking-rolled-oats",
      "item": "quick-cooking rolled oats",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 3.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
