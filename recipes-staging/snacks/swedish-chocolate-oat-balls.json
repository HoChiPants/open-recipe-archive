      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "coconut-oil",
      "item": "coconut oil",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "at room temperature"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "strong-brewed-coffee",
      "item": "strong brewed coffee",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "unsweetened-grated-coconut",
      "item": "unsweetened grated coconut",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven, then toast the oats for 7 minutes. Let them cool slightly.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Mix the sugar, cocoa, salt, cayenne, butter, coconut oil, vanilla, coffee, and grated coconut until cohesive."
    },
    {
      "step": 3,
      "text": "Add the toasted oats and stir until evenly combined."
    },
    {
      "step": 4,
      "text": "Shape the mixture into 16 balls, using a little coconut oil on your hands if needed, then roll them in additional grated coconut."
    },
    {
      "step": 5,
      "text": "Chill the balls until firm before serving."
    }
  ],
