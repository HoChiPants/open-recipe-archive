  "id": "chinese-scallion-pancakes",
  "name": "Chinese Scallion Pancakes",
  "subtitle": "Crisp, flaky pan-fried flatbreads with fresh green onion",
  "description": "A savory Chinese snack made from hot-water dough, layered with a simple flour-and-oil paste and sliced green onions, then pan-fried until crisp.",
  "meal_type": "snack",
  "cuisine": "Chinese",
