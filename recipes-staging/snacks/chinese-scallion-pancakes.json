  "instructions": [
    {
      "step": 1,
      "text": "Mix the bread flour and salt in a bowl. Pour in the very hot water and stir until a shaggy dough forms."
    },
    {
      "step": 2,
      "text": "Transfer the dough to a work surface and knead until smooth. Cover and let rest for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Warm 3 tablespoons vegetable oil and the sesame oil. Stir in 1 tablespoon all-purpose flour and cook for 1 minute to make a smooth paste. Set aside.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Divide the dough into 8 portions. Roll one portion into a thin round, spread with some paste, and scatter with green onions."
    },
    {
      "step": 5,
      "text": "Roll the round into a cylinder, coil it into a spiral, and press or roll it into a thick disk. Repeat with the remaining dough and filling."
    },
    {
      "step": 6,
      "text": "Heat a skillet over medium heat and add enough of the remaining vegetable oil to coat the surface."
    },
    {
      "step": 7,
      "text": "Pan-fry the pancakes in batches until browned and crisp on both sides, about 4 minutes per batch or pancake as needed.",
      "timer_minutes": 4
    },
    {
      "step": 8,
      "text": "Cut into wedges and serve hot."
    }
  ],
