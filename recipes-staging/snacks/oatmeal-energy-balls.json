  "ingredients": [
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "natural-peanut-butter",
      "item": "natural peanut butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the oats, peanut butter, raisins, and honey together in a bowl until evenly combined."
    },
    {
      "step": 2,
      "text": "Knead the mixture briefly until it holds together, then divide and roll into 12 balls."
    },
    {
      "step": 3,
      "text": "Refrigerate the balls until firm.",
