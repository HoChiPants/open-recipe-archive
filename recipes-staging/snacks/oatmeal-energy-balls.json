  "id": "oatmeal-energy-balls",
  "name": "Oatmeal Energy Balls",
  "subtitle": "A simple no-bake oat and peanut butter snack",
  "description": "Mix four pantry ingredients, shape the mixture, and chill until firm.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
