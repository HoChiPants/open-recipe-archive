  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cut the baguette into thick slices and arrange them on a baking sheet. Brush or drizzle with the olive oil."
    },
    {
      "step": 3,
      "text": "Combine the sliced tomatoes, basil, oregano, garlic powder, and white pepper."
    },
    {
      "step": 4,
      "text": "Spoon the tomato mixture onto the baguette slices and top with the mozzarella and provolone. Sprinkle with the remaining herbs."
    },
    {
      "step": 5,
      "text": "Bake until the bread is toasted and the cheese is melted and hot, about 10 minutes.",
      "timer_minutes": 10
    }
  ],
