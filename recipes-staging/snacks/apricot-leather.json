  "id": "apricot-leather",
  "name": "Apricot Leather",
  "subtitle": "A simple, chewy fruit snack made from fresh apricots.",
  "description": "Sweetened apricots are smoothed into a thin layer and slowly baked until pliable, then cut into portions.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 360
  },
  "ingredients": [
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "and-diced-fresh-apricots",
      "item": "and diced fresh apricots",
      "quantity": 2,
      "unit": "cups",
      "preparation": "pitted"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 150°F."
    },
    {
      "step": 2,
      "text": "Combine the lemon juice, pitted diced apricots, and white sugar, then process or blend until smooth."
    },
    {
      "step": 3,
      "text": "Transfer the smooth mixture to a lined baking sheet and spread it into an even, thin layer."
    },
    {
      "step": 4,
      "text": "Bake for 6 hours, or until the surface is set and the leather is pliable.",
      "timer_minutes": 360
    },
    {
      "step": 5,
      "text": "Cut the cooled leather into portions and prepare for serving or storage."
    }
  ],
