  "id": "sausage-balls",
  "name": "Sausage Balls",
  "subtitle": "A simple baked sausage-and-cheese snack",
  "description": "Combine sausage, shredded cheddar, and buttermilk baking mix into one mixture, form balls, and bake until golden and fully safe.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
