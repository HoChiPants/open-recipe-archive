  },
  "ingredients": [
    {
      "ingredient_id": "breakfast-sausage",
      "item": "breakfast sausage",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "buttermilk-baking-mix",
      "item": "buttermilk baking mix",
      "quantity": 3,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "In a large bowl, combine breakfast sausage, shredded Cheddar cheese, and buttermilk baking mix until the mixture is evenly blended."
    },
    {
      "step": 3,
      "text": "With lightly greased hands, form the mixture into equal-sized balls."
    },
    {
      "step": 4,
      "text": "Transfer the balls to a baking sheet and bake at 400°F until golden brown, then verify the center temperature with a food thermometer reaches 160°F, about 20 minutes total.",
      "timer_minutes": 20
    }
  ],
