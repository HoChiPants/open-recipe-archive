  "id": "grilled-shrimp-scampi",
  "name": "Grilled Shrimp Scampi",
  "subtitle": "Garlic-lemon shrimp from the grill",
  "description": "Shrimp coated in a bright garlic, lemon, parsley, and pepper marinade, then grilled until opaque.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
