      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    },
    {
