      "item": "ground black pepper to taste"
    },
    {
      "ingredient_id": "red-pepper-flakes-to-taste",
      "item": "red pepper flakes to taste",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "medium-shrimp",
      "item": "medium shrimp",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "peeled and deveined"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the olive oil, lemon juice, parsley, garlic, black pepper, and red pepper flakes in a bowl."
    },
    {
      "step": 2,
      "text": "Add the shrimp and toss until evenly coated. Let stand for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat a grill to medium-high heat."
    },
    {
      "step": 4,
      "text": "Grill the shrimp for about 3 minutes per side, turning once, until opaque and cooked through.",
      "timer_minutes": 3
    }
  ],
