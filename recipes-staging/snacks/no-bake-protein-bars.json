  "id": "no-bake-protein-bars",
  "name": "No-Bake Protein Bars",
  "subtitle": "Chewy oat bars with dried fruit and peanut butter",
  "description": "A quick snack bar made by binding oats, seeds, fruit, protein powder, and chocolate with honey and peanut butter.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "rolled-oats",
      "item": "old-fashioned oats",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flaxseed-meal",
      "item": "flaxseed meal",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "dried-cranberries",
      "item": "dried cranberries",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-whey-protein-powder",
      "item": "vanilla whey protein powder",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-chocolate-chips",
      "item": "white chocolate chips",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 0.33333334326744,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Line a square baking pan with parchment paper."
    },
    {
      "step": 2,
      "text": "Combine the oats, flaxseed meal, raisins, dried cranberries, and protein powder in a bowl."
    },
    {
      "step": 3,
      "text": "Place the white chocolate chips in a microwave-safe bowl and microwave for 3 minutes, or until melted.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Stir the honey and peanut butter into the melted chocolate, then mix the coating with the dry ingredients."
    },
    {
      "step": 5,
      "text": "Press the mixture firmly into the prepared pan and chill until set, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Lift out the chilled mixture, cut into 12 bars, and serve."
    }
  ],
