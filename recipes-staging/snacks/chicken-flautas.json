  "id": "chicken-flautas",
  "name": "Chicken Flautas",
  "subtitle": "Crisp rolled tortillas with saucy chicken and melted cheese",
  "description": "Seasoned shredded chicken is rolled with two cheeses in corn tortillas, lightly coated with oil, and baked until golden.",
  "meal_type": "snack",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
