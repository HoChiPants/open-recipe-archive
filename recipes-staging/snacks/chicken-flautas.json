    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves - cooked and shredded"
    },
    {
      "ingredient_id": "8-ounce-jar-picante-sauce",
      "item": "(8 ounce) jar picante sauce",
      "quantity": 1
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "monterey-jack-cheese",
      "item": "Monterey Jack cheese",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "6-inch-corn-tortillas",
      "item": "(6 inch) corn tortillas",
      "quantity": 36
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the picante sauce and cumin together, then combine the mixture with the shredded chicken."
    },
    {
      "step": 3,
      "text": "Warm the vegetable oil in a skillet and briefly heat the tortillas until pliable."
    },
    {
      "step": 4,
      "text": "Place chicken filling and a portion of the Monterey Jack and Cheddar cheeses along each tortilla. Roll tightly and arrange seam-side down in a baking dish."
    },
    {
      "step": 5,
      "text": "Top the rolled tortillas with the remaining cheeses and bake for 25 minutes, until golden brown and the chicken filling reaches 165°F.",
      "timer_minutes": 25
    }
  ],
