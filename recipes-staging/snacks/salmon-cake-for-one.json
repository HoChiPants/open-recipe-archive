      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the onion, salmon, crushed crackers, beaten egg, softened butter, lemon juice, and black pepper in a bowl."
    },
    {
      "step": 2,
      "text": "Shape the mixture into one compact cake."
    },
    {
      "step": 3,
      "text": "Preheat a skillet and add the vegetable oil."
    },
    {
      "step": 4,
      "text": "Sauté the salmon cake for 5 minutes, turning as needed, until golden brown and the center is fully set; confirm the fish reaches 145°F.",
      "timer_minutes": 5
    }
  ],
