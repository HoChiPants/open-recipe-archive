  "id": "salmon-cake-for-one",
  "name": "Salmon Cake for One",
  "subtitle": "A crisp, lemony salmon patty for a quick single serving",
  "description": "A simple salmon cake bound with egg and crushed crackers, then sautéed until golden and cooked through.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "diced"
    },
    {
      "ingredient_id": "salmon",
      "item": "salmon",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce, drained and flaked"
    },
    {
      "ingredient_id": "crackers",
      "item": "crackers",
      "quantity": 8,
      "preparation": "crushed, or more to taste"
    },
    {
      "ingredient_id": "egg",
