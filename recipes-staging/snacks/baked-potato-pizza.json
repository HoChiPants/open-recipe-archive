  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F. Prepare the potatoes and bake until tender, about 50 minutes. Cool briefly, then cut into pieces.",
      "timer_minutes": 50
    },
    {
      "step": 2,
      "text": "Reduce the oven temperature to 400°F. Cook the bacon for about 10 minutes, then drain and crumble.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Mix the pizza crust mix with the water. Knead for 8 minutes, until smooth, then rest for 5 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Shape the dough and transfer it to a baking surface. Bake for 6 minutes, until firm.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Combine the potatoes with the melted butter, garlic powder, and Italian seasoning. Stir together the sour cream and Ranch dressing."
    },
    {
      "step": 6,
      "text": "Spread the sauce mixture over the crust. Add the seasoned potatoes, bacon, green onions, mozzarella, and Cheddar."
    },
    {
      "step": 7,
      "text": "Bake for about 20 minutes, until the cheeses are melted. Rest for 5 minutes before serving.",
      "timer_minutes": 20
    }
  ],
