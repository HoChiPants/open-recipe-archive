{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "fig-and-onion-spread",
  "name": "Fig and Onion Spread",
  "subtitle": "A sweet-tangy spread for snacks and appetizers",
  "description": "Slow-cooked onion and fresh figs combine with balsamic vinegar and sugar for a rich, spoonable spread.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fresh-black-mission-figs",
      "item": "fresh Black Mission figs",
      "quantity": 2,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "aged-balsamic-vinegar",
      "item": "aged balsamic vinegar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the chopped onion and cook for 25 minutes, stirring occasionally, until softened.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Stir in the chopped figs and cook for 15 minutes, stirring occasionally.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a saucepan with the balsamic vinegar and cook for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir in the sugar, adjusting to taste, and serve warm or cooled."
    }
  ],
