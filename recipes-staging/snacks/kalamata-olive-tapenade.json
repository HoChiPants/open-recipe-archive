  "id": "kalamata-olive-tapenade",
  "name": "Kalamata Olive Tapenade",
  "subtitle": "A savory olive spread with bright lemon and herbs",
  "description": "Chop the ingredients together for a briny, herb-flecked spread suitable for serving with bread, crackers, or vegetables.",
  "meal_type": "snack",
  "cuisine": "Italian",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "kalamata-olives",
      "item": "kalamata olives",
      "quantity": 1,
      "unit": "cup",
      "preparation": "pitted"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "capers",
      "item": "capers",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Finely mince the peeled garlic. Chop the olives and capers, then combine them with the parsley in a bowl."
    },
    {
      "step": 2,
      "text": "Stir in the lemon juice and olive oil. Season with salt and pepper to taste."
    },
    {
      "step": 3,
      "text": "Transfer the tapenade to a serving bowl and chill until ready to serve."
    }
  ],
