  "instructions": [
    {
      "step": 1,
      "text": "Combine the mangos, peaches, tomatoes, onion, bell peppers, pineapple, cilantro, and jalapeño in a large bowl."
    },
    {
      "step": 2,
      "text": "Stir together the water, sugar, lime juice, garlic, and salt until combined."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the fruit and vegetables and toss gently to coat."
    },
    {
