{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "sweet-hot-mustard-chicken-wings",
  "name": "Sweet Hot Mustard Chicken Wings",
  "subtitle": "Oven-baked wings with a honey-mustard glaze",
  "description": "Crisp chicken wings are baked, then coated in a tangy, sweet, spicy mustard sauce.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-wings",
      "item": "chicken wings",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "separated at joints, tips discarded"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "prepared-yellow-mustard",
      "item": "prepared yellow mustard",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cider-vinegar",
      "item": "cider vinegar",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "hot-pepper-sauce",
      "item": "hot pepper sauce",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F. Toss the wings with the prepared yellow mustard and salt to taste, then arrange them in a single layer in a baking dish or on a sheet pan."
    },
    {
      "step": 2,
      "text": "Bake for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Stir together the salt to taste, Dijon mustard, prepared yellow mustard, honey, cider vinegar, salt and ground black pepper, and hot pepper sauce."
    },
    {
      "step": 4,
      "text": "Coat the wings with the mustard mixture and return them to the oven. Bake for 20 minutes, until the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Transfer the wings to a serving dish and serve hot."
    }
  ],
