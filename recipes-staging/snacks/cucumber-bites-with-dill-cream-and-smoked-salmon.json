  "instructions": [
    {
      "step": 1,
      "text": "Arrange the cucumber slices on a tray and let them stand for 15 minutes, then pat dry if moisture collects.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Stir the softened cream cheese with chopped dill, lemon zest, lemon juice, and black pepper until smooth and combined."
    },
    {
      "step": 3,
      "text": "Spread the dill cream over the cucumber slices. Top each with a strip of smoked salmon and a small dill sprig."
    },
    {
      "step": 4,
      "text": "Keep the assembled bites chilled until serving; smoked salmon requires no cooking endpoint in this no-cook preparation."
    }
  ],
