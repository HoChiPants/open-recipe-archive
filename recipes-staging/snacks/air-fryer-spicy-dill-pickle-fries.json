  "id": "air-fryer-spicy-dill-pickle-fries",
  "name": "Air Fryer Spicy Dill Pickle Fries",
  "subtitle": "Crisp panko-coated pickle spears from the air fryer.",
  "description": "Spicy dill pickle spears are breaded with seasoned flour, egg, and panko, then air-fried until crisp and golden.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "panko-bread-crumbs",
      "item": "panko bread crumbs",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "16-ounce-jars-spicy-dill-pickle-spears",
      "item": "(16 ounce) jars spicy dill pickle spears",
      "quantity": 1.5
    },
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the flour and paprika together in a shallow bowl. Whisk the milk and beaten egg in a second bowl, and place the panko in a third bowl."
    },
    {
      "step": 2,
      "text": "Preheat the air fryer to 400°F."
    },
    {
      "step": 3,
      "text": "Working with one pickle spear at a time, coat it in the seasoned flour, dip it in the egg mixture, then press it into the panko. Arrange the coated spears in a single layer in the air-fryer basket and spray lightly with cooking spray."
    },
    {
      "step": 4,
      "text": "Air-fry until golden brown and crisp, turning as needed. Ensure the egg-based coating reaches 160°F or is firm and fully set.",
      "timer_minutes": 14
    }
  ],
