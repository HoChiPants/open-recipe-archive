      "item": "mesquite flavored liquid smoke concentrate",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Lightly coat the tomatoes and peppers with the vegetable oil."
    },
    {
      "step": 2,
      "text": "Grill the tomatoes for 10 minutes, turning as needed, until softened and lightly charred.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Transfer the tomatoes to a bowl, then grill the poblano peppers, bell pepper, Anaheim peppers, and jalapeno for 7 minutes, turning until blistered and tender.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Transfer the peppers to the bowl with the tomatoes and let the vegetables cool for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Drain the tomatoes. Remove the stems from the peppers and discard the seeds if desired, then chop the vegetables."
    },
    {
      "step": 6,
      "text": "Combine the tomatoes and peppers with the onion, cilantro, vinegar, salt, and garlic. Stir in the liquid smoke concentrate and mix well."
    },
    {
      "step": 7,
      "text": "Serve the salsa once combined."
    }
  ],
