  "id": "smoky-pepper-salsa",
  "name": "Smoky Pepper Salsa",
  "subtitle": "Grilled peppers and tomatoes blended with fresh, tangy accents",
  "description": "Grilled peppers and ripe tomatoes make a smoky salsa with bright vinegar, cilantro, and garlic.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "ripe-plum-tomatoes",
      "item": "ripe plum tomatoes",
      "quantity": 8
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "poblano-peppers",
      "item": "poblano peppers",
      "quantity": 4
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "anaheim-chile-peppers",
      "item": "Anaheim chile peppers",
      "quantity": 4
    },
    {
      "ingredient_id": "jalapeno-chile-pepper",
      "item": "jalapeno chile pepper",
      "quantity": 1,
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.25
    },
    {
      "ingredient_id": "cilantro-leaves",
      "item": "cilantro leaves",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "white-vinegar",
      "item": "white vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves"
    },
    {
