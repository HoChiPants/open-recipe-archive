  "id": "jalapeno-popper-mushrooms",
  "name": "Jalapeno Popper Mushrooms",
  "subtitle": "Cheesy mushroom caps with bacon and jalapeno",
  "description": "Mushroom caps are filled with a creamy, savory mixture of bacon, jalapeno, garlic, and Cheddar, then baked until hot and lightly browned.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 2
    },
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "mushrooms",
      "item": "mushrooms",
      "quantity": 8,
      "preparation": "stems removed and chopped and caps reserved"
    },
    {
      "ingredient_id": "jalapeno-pepper",
      "item": "jalapeno pepper",
      "quantity": 1,
      "preparation": "ribs and seeds removed, finely chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "3 ounce, softened"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "sea-salt-to-taste",
      "item": "sea salt to taste"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon for about 10 minutes, drain it, and chop it finely.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the oven to 350°F and coat a baking dish with cooking spray."
    },
    {
      "step": 3,
      "text": "Warm the olive oil in a skillet. Add the garlic and chopped mushroom stems, and cook for 10 minutes, stirring, until softened. Transfer the mixture to a bowl.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Mix in the bacon, softened cream cheese, Cheddar, jalapeno, sea salt, and black pepper until evenly combined."
    },
    {
      "step": 5,
      "text": "Arrange the reserved mushroom caps in the prepared dish and fill them with the cheese mixture."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, until the filling is hot and the mushrooms are tender.",
      "timer_minutes": 20
    }
  ],
