  "id": "meyer-lemon-avocado-toast",
  "name": "Meyer Lemon Avocado Toast",
  "subtitle": "Bright, creamy toast with cilantro and chia",
  "description": "Mashed avocado is seasoned with Meyer lemon, cilantro, cayenne, and sea salt, then spread over crisp whole grain toast and finished with chia seeds.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
