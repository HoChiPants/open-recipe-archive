      "ingredient_id": "slices-whole-grain-bread",
      "item": "slices whole grain bread",
      "quantity": 2
    },
    {
      "ingredient_id": "avocado",
      "item": "avocado",
      "quantity": 0.5
    },
    {
      "ingredient_id": "fresh-cilantro",
