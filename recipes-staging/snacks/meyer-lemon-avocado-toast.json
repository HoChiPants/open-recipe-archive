      "item": "chia seeds",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Toast the bread until crisp, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mash the avocado in a small bowl."
    },
    {
      "step": 3,
      "text": "Stir together the cilantro, lemon zest, lemon juice, cayenne, and sea salt. Fold the mixture into the mashed avocado."
    },
    {
      "step": 4,
      "text": "Spread the seasoned avocado over the toast and sprinkle with chia seeds."
    }
  ],
