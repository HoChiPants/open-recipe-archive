      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped, or more to taste"
    },
    {
      "ingredient_id": "meyer-lemon-zest",
      "item": "Meyer lemon zest",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
