{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "sugar-glazed-walnuts",
  "name": "Sugar-Glazed Walnuts",
  "subtitle": "A quick crunchy snack with a glossy sugar coating",
  "description": "Walnut halves are coated in a simple sugar syrup, microwaved, and cooled until crisp.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 2,
    "cook_minutes": 8
  },
  "ingredients": [
    {
      "ingredient_id": "walnut-halves",
      "item": "walnut halves",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the walnut halves, white sugar, and water in a microwave-safe dish."
    },
    {
      "step": 2,
      "text": "Microwave for 2 minutes, then stir thoroughly. Continue microwaving in short intervals, stirring between intervals, until the sugar mixture forms a glaze and the walnuts are evenly coated.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Transfer the coated walnuts to a parchment-lined surface and separate them."
    },
    {
      "step": 4,
      "text": "Let cool completely until the glaze sets and the walnuts become crisp."
    }
  ],
  "tags": [
    "snack",
    "nuts",
    "sweet",
