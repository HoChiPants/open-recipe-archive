  "instructions": [
    {
      "step": 1,
      "text": "Prepare the jalapeños, onion, garlic, cilantro, lime juice, diced green chile, tomatoes, and seeded habanero."
    },
    {
      "step": 2,
      "text": "Roast the black pepper in a dry pan until fragrant."
    },
    {
      "step": 3,
      "text": "Cook the jalapeños, onions, garlic, sugar, salt, and roasted pepper until the aromatics soften, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Let the cooked mixture cool completely.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Transfer the cooled mixture to a blender or food processor. Add the green chile, cilantro, lime juice, tomatoes, and habanero."
    },
    {
      "step": 6,
      "text": "Blend or pulse until the salsa reaches the desired texture. Chill before serving."
    }
  ],
