  "ingredients": [
    {
      "ingredient_id": "buttery-round-crackers",
      "item": "buttery round crackers",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "pound",
      "preparation": "sliced, cut into thirds"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "pound"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 250°F."
    },
    {
      "step": 2,
      "text": "Arrange the buttery round crackers in a single layer on a baking sheet."
    },
    {
      "step": 3,
      "text": "Top each cracker with a piece of bacon and sprinkle with brown sugar."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, until the bacon is crisp and the sugar is melted and caramelized.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Cool briefly, then serve."
    }
  ],
