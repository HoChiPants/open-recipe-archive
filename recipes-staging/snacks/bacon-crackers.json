  "id": "bacon-crackers",
  "name": "Bacon Crackers",
  "subtitle": "Sweet, crisp bacon-topped crackers",
  "description": "Buttery round crackers are layered with bacon and brown sugar, then baked slowly until crisp and caramelized.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
