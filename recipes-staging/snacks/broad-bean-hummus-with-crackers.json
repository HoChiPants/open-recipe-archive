  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "broad-bean-hummus-with-crackers",
  "name": "Broad Bean Hummus with Crackers",
  "subtitle": "A bright bean dip with crisp za’atar crackers",
  "description": "Blend tender broad beans with tahini, garlic, lemon, and olive oil, then serve with homemade za’atar-sesame crackers.",
  "meal_type": "snack",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-or-frozen-broad-beans",
      "item": "fresh or frozen broad beans",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "garlic-clove-finely-grated",
      "item": "garlic clove finely grated",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "tahini",
      "item": "tahini",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "extra-virgin-olive-oil-plus-extra-for-drizzling",
      "item": "extra virgin olive oil plus extra for drizzling",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "plain-flour-plus-extra-for-dusting",
      "item": "plain flour plus extra for dusting",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "za-atar",
      "item": "za’atar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "mixed-sesame-seeds-plus-extra-to-serve",
      "item": "mixed sesame seeds plus extra to serve",
      "quantity": 2,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Boil the broad beans for 3 minutes, then drain well.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Blend the beans with the garlic, tahini, lemon juice, and both measured olive oils until smooth. Transfer to a serving bowl."
    },
    {
      "step": 3,
      "text": "Preheat the oven. Mix the flour and sugar in a bowl, then stir in both measured olive oils and enough mixture to form a dough."
    },
    {
      "step": 4,
      "text": "Knead the dough for 5 minutes, until smooth. Shape it, dusting with extra flour as needed.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Prepare the dough for baking, then cut it into crackers and sprinkle with the za’atar and sesame seeds."
    },
    {
      "step": 6,
      "text": "Bake for 15 minutes, then cool completely.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Drizzle the hummus with extra olive oil and finish with extra flour and sesame seeds before serving with the crackers."
    }
  ],
