  "id": "roasted-red-pepper-hummus",
  "name": "Roasted Red Pepper Hummus",
  "subtitle": "A smooth chickpea dip with tahini, lemon, garlic, and roasted peppers.",
  "description": "Blend chickpeas with tahini, lemon juice, and garlic, then add roasted peppers and basil for a savory dip.",
  "meal_type": "snack",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
