    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "chickpea",
      "item": "chickpeas",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, drained"
    },
    {
      "ingredient_id": "tahini",
      "item": "tahini",
      "quantity": 0.33300000429153,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.33300000429153,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
