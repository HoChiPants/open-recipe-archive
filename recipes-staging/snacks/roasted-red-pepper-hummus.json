      "item": "roasted red peppers",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the drained chickpeas, tahini, lemon juice, and minced garlic to a food processor. Blend until mostly smooth."
    },
    {
      "step": 2,
      "text": "Add the roasted red peppers, dried basil, and salt and pepper. Process until smooth and evenly combined."
    },
    {
      "step": 3,
      "text": "Transfer the hummus to a serving bowl and adjust the seasoning to taste."
    }
  ],
