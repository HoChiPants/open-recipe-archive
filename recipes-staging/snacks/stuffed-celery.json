      "item": "bunch celery",
      "quantity": 1,
      "preparation": "large stalks washed, trimmed, and cut into 3 sections"
    },
    {
      "ingredient_id": "cream-cheese-at-room-temperature",
      "item": "cream cheese at room temperature",
      "quantity": 2,
