  "id": "stuffed-celery",
  "name": "Stuffed Celery",
  "subtitle": "Creamy olive-and-garlic celery bites",
  "description": "Crisp celery sections filled with a savory cream cheese, olive, and garlic mixture for an easy chilled snack.",
  "meal_type": "snack",
