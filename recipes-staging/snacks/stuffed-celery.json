  ],
  "instructions": [
    {
      "step": 1,
      "text": "Wash, trim, and cut the celery stalks into three sections each."
    },
    {
      "step": 2,
      "text": "Stir the room-temperature cream cheese, chopped olives, minced garlic, salt, and pepper until evenly combined."
    },
    {
      "step": 3,
      "text": "Fill each celery section with the cream cheese mixture, distributing it evenly."
    },
    {
      "step": 4,
      "text": "Chill the stuffed celery until ready to serve."
    }
