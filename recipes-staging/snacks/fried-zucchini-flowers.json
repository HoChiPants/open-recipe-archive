      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare the zucchini flowers."
    },
    {
      "step": 2,
      "text": "Combine the flour, baking powder, and salt in a bowl."
    },
    {
      "step": 3,
      "text": "Whisk the milk, eggs, and olive oil together, then stir the mixture into the dry ingredients until smooth."
    },
    {
      "step": 4,
      "text": "Preheat the vegetable oil for frying in a skillet."
    },
    {
      "step": 5,
      "text": "Transfer the zucchini flowers to the batter, coating them evenly, then place them in the hot oil."
    },
    {
      "step": 6,
      "text": "Sauté for 5 minutes, turning as needed, until crisp and golden.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Transfer the fried flowers to a serving plate and season with salt."
    }
  ],
