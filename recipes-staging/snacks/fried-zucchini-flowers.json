  "id": "fried-zucchini-flowers",
  "name": "Fried Zucchini Flowers",
  "subtitle": "Crisp battered zucchini flowers",
  "description": "Zucchini flowers are coated in a light batter and sautéed in oil until crisp and golden.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
