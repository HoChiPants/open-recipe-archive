  "instructions": [
    {
      "step": 1,
      "text": "Combine the rice flour, gram flour, cornflour, chillies, chilli powder, curry powder, ground coriander, cumin, onions, and chopped coriander in a bowl."
    },
    {
      "step": 2,
      "text": "Add the chicken and toss thoroughly until every piece is coated with the seasoned flour mixture."
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil for deep-frying in a deep fryer or heavy, deep-sided pan until hot."
    },
    {
      "step": 4,
      "text": "Fry the coated chicken in batches for about 10 minutes, turning as needed, until crisp and the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Drain briefly and serve hot with the sweet chilli sauce or green chutney."
    }
  ],
