  "id": "chicken-pakoras",
  "name": "Chicken Pakoras",
  "subtitle": "Crisp spiced chicken bites for sharing",
  "description": "Bite-sized chicken is coated with seasoned chickpea, rice, and corn flours, then deep-fried until crisp and fully cooked.",
  "meal_type": "snack",
  "cuisine": "Indian",
  "yield": {
    "quantity": 6,
    "unit": "(makes around 30 pakoras)"
  },
  "times": {
