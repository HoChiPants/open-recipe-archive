  "id": "parmesan-spinach-balls",
  "name": "Parmesan Spinach Balls",
  "subtitle": "Savory spinach bites with Parmesan and herbs",
  "description": "Thawed spinach, seasoned crumbs, Parmesan, and eggs form tender baked bites for snacking or serving as an appetizer.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 2,
      "unit": "package",
      "preparation": "10 ounce, thawed and drained"
    },
    {
      "ingredient_id": "italian-style-seasoned-bread-crumbs",
      "item": "Italian-style seasoned bread crumbs",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "green-onion",
      "item": "green onion",
      "quantity": 4,
      "unit": "small",
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "preparation": "lightly beaten"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the spinach, bread crumbs, Parmesan, melted butter, green onion, beaten eggs, salt, and pepper until evenly mixed."
    },
    {
      "step": 3,
      "text": "Shape the mixture into balls and arrange them in a single layer on a baking sheet."
    },
    {
      "step": 4,
      "text": "Bake for 15 minutes, or until lightly browned and the center is firm and fully set.",
      "timer_minutes": 15
    }
  ],
