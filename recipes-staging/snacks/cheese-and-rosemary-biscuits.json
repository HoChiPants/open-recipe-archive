  "id": "cheese-and-rosemary-biscuits",
  "name": "Cheese and Rosemary Biscuits",
  "subtitle": "Savory biscuits with cheddar and fresh rosemary",
  "description": "Tender, cheesy biscuits with a fragrant rosemary finish, suitable for snacking or sharing.",
  "meal_type": "snack",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 14
  },
  "ingredients": [
    {
      "ingredient_id": "wholemeal-flour",
      "item": "wholemeal flour",
      "quantity": 80,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 80,
      "unit": "g"
    },
    {
      "ingredient_id": "cold-butter-chopped",
      "item": "cold butter chopped",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "cheddar-finely-grated",
      "item": "cheddar finely grated",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "rosemary-sprig-leaves-finely-chopped",
      "item": "rosemary sprig leaves finely chopped",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "egg-yolk",
      "item": "egg yolk",
      "quantity": 1,
      "unit": "large"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a baking sheet with parchment."
    },
    {
      "step": 2,
      "text": "Rub the wholemeal flour, plain flour, and cold butter together until the mixture resembles coarse crumbs."
    },
    {
      "step": 3,
      "text": "Stir in the cheddar, chopped rosemary, and egg yolk. Mix until a smooth dough forms."
    },
    {
      "step": 4,
      "text": "Roll or press the dough out on a lightly floured surface and shape into biscuits."
    },
    {
      "step": 5,
      "text": "Arrange the biscuits on the prepared sheet and bake for 14 minutes, until lightly golden and fully set; the center should reach 160°F if checked with a thermometer.",
      "timer_minutes": 14
    },
    {
      "step": 6,
      "text": "Cut or separate the biscuits as needed, then cool before serving."
    }
  ],
