  "id": "jalapen-o-poppers",
  "name": "Jalapeño Poppers",
  "subtitle": "Creamy stuffed peppers wrapped for baking",
  "description": "Jalapeño halves are filled with softened cream cheese, wrapped in vegetarian bacon, and baked until hot.",
  "meal_type": "snack",
