  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the softened cream cheese until smooth, then fill the prepared jalapeño halves."
    },
    {
      "step": 3,
      "text": "Wrap each filled pepper with a thawed vegetarian bacon strip and secure it with a toothpick."
    },
    {
      "step": 4,
