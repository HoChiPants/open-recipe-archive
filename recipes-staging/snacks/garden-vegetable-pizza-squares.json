  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Press the crescent rolls into a single layer in a baking pan, sealing the seams and shaping the dough to cover the bottom."
    },
    {
      "step": 3,
      "text": "Bake until golden brown, about 13 minutes. Cool completely.",
      "timer_minutes": 13
    },
    {
      "step": 4,
      "text": "Mix the softened cream cheese with the Ranch-style dressing mix until smooth."
    },
    {
      "step": 5,
      "text": "Spread the cream cheese mixture over the cooled crust and scatter the carrots, red bell peppers, green bell pepper, broccoli, and green onions evenly over the top."
    },
    {
      "step": 6,
      "text": "Chill for 60 minutes, then cut into squares and serve.",
      "timer_minutes": 60
    }
  ],
