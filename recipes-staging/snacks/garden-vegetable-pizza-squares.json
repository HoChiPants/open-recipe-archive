  "id": "garden-vegetable-pizza-squares",
  "name": "Garden Vegetable Pizza Squares",
  "subtitle": "A chilled crescent-crust appetizer with creamy ranch spread and crisp vegetables.",
  "description": "Bake a crescent-roll crust, top it with seasoned cream cheese, add chopped vegetables, chill, and slice into squares.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
