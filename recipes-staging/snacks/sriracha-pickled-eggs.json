  "instructions": [
    {
      "step": 1,
      "text": "Combine the vinegar, water, sliced onion, sriracha, and sea salt in a saucepan. Warm the sriracha with the mixture as it heats."
    },
    {
      "step": 2,
      "text": "Bring the brine to a simmer, then remove it from the heat.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Place the peeled hard-boiled eggs in a clean heatproof container and pour the warm brine over them."
    },
    {
      "step": 4,
      "text": "Cool, cover, and refrigerate the eggs until fully chilled and flavored, about 48 hours 15 minutes.",
      "timer_minutes": 2895
    }
  ],
