  "id": "sriracha-pickled-eggs",
  "name": "Sriracha Pickled Eggs",
  "subtitle": "Spicy refrigerator-pickled eggs with onion",
  "description": "Hard-boiled eggs chilled in a tangy vinegar and sriracha brine with sliced onion.",
