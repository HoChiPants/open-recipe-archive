  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the grated courgettes, grated onion, gram flour, chilli, ground coriander, cumin, ginger, and chopped coriander in a bowl to form a thick mixture."
    },
    {
      "step": 2,
      "text": "Heat the sunflower oil in a deep, heavy pan until ready for frying."
    },
    {
      "step": 3,
      "text": "Fry spoonfuls of the mixture in batches until golden brown, turning as needed for even cooking."
    },
    {
      "step": 4,
      "text": "Transfer the pakoras to a draining rack or paper-lined plate, then let them rest briefly."
    },
    {
      "step": 5,
      "text": "Serve warm with the optional chutney."
    }
  ],
