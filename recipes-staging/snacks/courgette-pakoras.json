  "id": "courgette-pakoras",
  "name": "Courgette Pakoras",
  "subtitle": "Crisp chickpea fritters with warming spices",
  "description": "Grated courgettes, onion, herbs, and spices are bound with gram flour and deep-fried until golden for a savory Indian snack.",
  "meal_type": "snack",
  "cuisine": "Indian",
  "yield": {
    "quantity": 12,
