  "id": "fresh-blended-salsa",
  "name": "Fresh Blended Salsa",
  "subtitle": "A bright, spicy salsa with lime and cilantro",
  "description": "Blend tomato sauce with fresh peppers, aromatics, and lime, then chill before serving.",
  "meal_type": "snack",
  "cuisine": "Mexican Inspired",
