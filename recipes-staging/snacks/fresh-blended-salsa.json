  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the chopped onion in a blender and set aside."
    },
    {
      "step": 2,
      "text": "Add the tomato sauce, jalapeños, serrano, garlic, lime juice, salt, and pepper. Blend until combined."
    },
    {
      "step": 3,
      "text": "Cut the cilantro into smaller pieces, add it to the blender, and blend until incorporated."
    },
    {
      "step": 4,
      "text": "Combine the onion with the blended mixture and blend briefly to reach the desired texture."
    },
    {
      "step": 5,
      "text": "Cover and refrigerate for 60 minutes before serving.",
      "timer_minutes": 60
    }
  ],
