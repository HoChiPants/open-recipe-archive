{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "rumaki",
  "name": "Rumaki",
  "subtitle": "Teriyaki-marinated chicken livers wrapped in bacon",
  "description": "Chicken livers and water chestnuts are marinated with garlic and ginger, wrapped in bacon, and fried until crisp and safely cooked.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "teriyaki-sauce",
      "item": "teriyaki sauce",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "fresh-ginger-root",
      "item": "fresh ginger root",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "fresh-chicken-livers",
      "item": "fresh chicken livers",
      "quantity": 12,
      "unit": "ounces",
      "preparation": "halved"
    },
    {
      "ingredient_id": "water-chestnuts",
      "item": "water chestnuts",
      "quantity": 1,
      "unit": "can",
      "preparation": "4 ounce, drained and sliced"
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 12,
      "preparation": "cut in half"
    },
    {
      "ingredient_id": "oil-for-frying",
      "item": "oil for frying",
      "quantity": 1,
      "unit": "quart"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the teriyaki sauce, garlic, and ginger together in a bowl. Add the chicken livers and water chestnuts, cover, and marinate for 2 hours in the refrigerator.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Drain the livers and water chestnuts. Wrap each liver half and a water chestnut slice with a half-slice of bacon, securing each bundle with a toothpick if needed."
    },
    {
      "step": 3,
      "text": "Heat the frying oil to 375°F in a suitable heavy pot or deep fryer. Fry the bundles in batches until the bacon is browned and the thickest chicken liver reaches 165°F.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Transfer the cooked rumaki to a lined plate and serve hot."
    }
  ],
