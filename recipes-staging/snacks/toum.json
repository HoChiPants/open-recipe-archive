  "id": "toum",
  "name": "Toum",
  "subtitle": "Creamy Lebanese garlic dip",
  "description": "A bold, airy garlic dip made by blending garlic with oil and lemon juice.",
  "meal_type": "snack",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1,
      "preparation": "juiced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Process the peeled garlic and salt until smooth."
    },
    {
      "step": 2,
      "text": "With the processor running, add the vegetable oil gradually until the mixture is thick and creamy."
    },
    {
      "step": 3,
      "text": "Stir in the lemon juice until evenly combined, then serve."
    }
  ],
