  "id": "corn-fritters",
  "name": "Corn Fritters",
  "subtitle": "Crisp, golden fritters with sweet corn throughout",
  "description": "A simple American snack made from corn folded into a lightly seasoned batter and fried until crisp outside and set inside.",
  "meal_type": "snack",
  "cuisine": "American",
