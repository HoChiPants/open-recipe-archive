  "instructions": [
    {
      "step": 1,
      "text": "Heat the frying oil to 365°F."
    },
    {
      "step": 2,
      "text": "Mix the sifted flour with baking powder, salt, and sugar. In a separate bowl, whisk the milk with melted shortening and beaten egg."
    },
    {
      "step": 3,
      "text": "Add the wet mixture to the dry ingredients and stir just until combined. Fold in the drained corn."
    },
    {
      "step": 4,
      "text": "Fry spoonfuls of batter in batches, turning as needed, until browned, crisp, and fully set in the center; verify the center reaches 160°F.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Drain the fritters well and serve hot."
    }
  ],
