  "id": "white-chocolate-cereal-party-mix",
  "name": "White Chocolate Cereal Party Mix",
  "subtitle": "A crisp, sweet-and-salty snack for sharing",
  "description": "Cereal squares, pretzels, peanuts, and candy pieces coated in melted white chocolate and chilled until set.",
