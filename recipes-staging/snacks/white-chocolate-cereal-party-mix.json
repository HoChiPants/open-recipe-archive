  "instructions": [
    {
      "step": 1,
      "text": "Melt the white chocolate gently in a heatproof bowl over simmering water, stirring until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Combine the cereal squares, toasted oat cereal, pretzel sticks, peanuts, and mini candy-coated chocolate pieces in a large bowl."
    },
    {
      "step": 3,
      "text": "Pour the melted white chocolate over the mixture and fold carefully until the pieces are evenly coated."
    },
    {
      "step": 4,
      "text": "Spread the mixture on a lined tray and chill until the coating is firm.",
      "timer_minutes": 60
    }
