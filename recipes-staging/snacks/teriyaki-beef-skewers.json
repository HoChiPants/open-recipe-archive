      "item": "garlic cloves",
      "quantity": 3,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "boneless-round-steak",
      "item": "boneless round steak",
      "quantity": 4,
      "unit": "pounds",
      "preparation": "cut into 1/4-inch slices"
    },
    {
      "ingredient_id": "bamboo-skewers",
      "item": "bamboo skewers",
      "preparation": "soaked in water"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the brown sugar, soy sauce, pineapple juice, water, oil, and garlic until combined."
    },
    {
      "step": 2,
      "text": "Add the sliced steak and stir to coat evenly."
    },
    {
      "step": 3,
      "text": "Cover and refrigerate for 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 4,
      "text": "Preheat a grill to medium-high heat."
    },
    {
      "step": 5,
      "text": "Thread the marinated beef onto the soaked bamboo skewers."
    },
    {
      "step": 6,
      "text": "Grill for 3 minutes per side, or until the beef reaches 145°F; rest for 3 minutes before serving.",
      "timer_minutes": 6
    }
  ],
