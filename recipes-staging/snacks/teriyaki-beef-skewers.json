  "id": "teriyaki-beef-skewers",
  "name": "Teriyaki Beef Skewers",
  "subtitle": "Sweet-savory grilled beef bites",
  "description": "Thin slices of beef marinated in a sweet soy-based mixture, threaded onto skewers, and quickly grilled.",
  "meal_type": "snack",
  "cuisine": "Japanese",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
