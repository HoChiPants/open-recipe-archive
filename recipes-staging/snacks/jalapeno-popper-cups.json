  "id": "jalapeno-popper-cups",
  "name": "Jalapeno Popper Cups",
  "subtitle": "Cheesy jalapeño filling in crisp pastry shells",
  "description": "Mini phyllo shells filled with cream cheese, Cheddar, jalapeño, hot pepper sauce, and bacon bits, then baked until golden.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "mini-phyllo-tart-shells",
      "item": "mini phyllo tart shells",
      "quantity": 12
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "softened"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "jalapeno-peppers",
      "item": "jalapeno peppers",
      "quantity": 2,
      "preparation": "seeded and chopped"
    },
    {
      "ingredient_id": "hot-pepper-sauce",
      "item": "hot pepper sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "bacon-bits",
      "item": "bacon bits"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Arrange the phyllo tart shells on a baking sheet."
    },
    {
      "step": 3,
      "text": "Whisk together the softened cream cheese, Cheddar, jalapeño peppers, and hot pepper sauce."
    },
    {
      "step": 4,
      "text": "Fill each tart shell with the cheese mixture and sprinkle with bacon bits."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, until the cups are golden brown.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Serve warm."
    }
  ],
