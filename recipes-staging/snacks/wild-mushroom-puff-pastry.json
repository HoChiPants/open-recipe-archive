  "schema_version": "1.0.0",
  "id": "wild-mushroom-puff-pastry",
  "name": "Wild Mushroom Puff Pastry",
  "subtitle": "Savory mushroom-filled pastry bites",
  "description": "Sautéed wild mushrooms, shallot, garlic, Parmesan, and thyme are wrapped in thawed puff pastry and baked until golden.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "shallot",
      "item": "shallot",
      "quantity": 1,
      "preparation": "minced"
    },
    {
      "ingredient_id": "assorted-wild-mushrooms",
      "item": "assorted wild mushrooms",
      "quantity": 1,
      "unit": "pound",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "roasted-garlic",
      "item": "roasted garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "bunch-fresh-thyme",
      "item": "bunch fresh thyme",
      "quantity": 1,
      "preparation": "leaves stripped and chopped"
    },
    {
      "ingredient_id": "salt-and-black-pepper-to-taste",
      "item": "salt and black pepper to taste"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "frozen-puff-pastry",
      "item": "frozen puff pastry",
      "quantity": 1,
      "unit": "package",
      "preparation": "17.25 ounce, thawed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet. Add the shallot and cook, stirring, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the mushrooms and cook, stirring occasionally, until softened and their moisture has cooked off.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Stir in the roasted garlic, Parmesan, and thyme. Season with salt and black pepper. Whisk in the heavy cream, then remove the filling from the heat."
    },
    {
      "step": 5,
      "text": "Unfold the thawed puff pastry on a lightly prepared work surface. Cut it into eight portions, place filling on each, and fold the pastry over to enclose it. Transfer the pastries to a baking sheet and prepare the edges as needed to seal."
    },
    {
      "step": 6,
      "text": "Bake until golden brown. Serve warm.",
      "timer_minutes": 16
    }
  ],
