  "id": "salt-cod-cakes",
  "name": "Salt Cod Cakes",
  "subtitle": "Crisp fish cakes with potato, parsley, and onion",
  "description": "Soaked salt cod is combined with tender potato, herbs, onion, egg, and flour, then shaped and fried until crisp and fully set.",
  "meal_type": "snack",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45,
    "inactive_minutes": 480
  },
  "ingredients": [
    {
      "ingredient_id": "salted-cod-fish",
      "item": "salted cod fish",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 2,
      "unit": "large",
      "preparation": "peeled and cubed"
    },
    {
      "ingredient_id": "seafood-seasoning",
      "item": "seafood seasoning",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    },
    {
      "ingredient_id": "fresh-parsley",
