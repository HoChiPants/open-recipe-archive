      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil-for-frying",
      "item": "olive oil for frying",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Soak the salted cod in cold water for 8 hours, then drain well.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Place the cod in a saucepan, cover with fresh water, and simmer until opaque and easily flaked. Drain, flake, and remove any bones or skin."
    },
    {
      "step": 3,
      "text": "Boil the peeled, cubed potatoes until tender, about 20 minutes. Drain and cool for 10 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Mash the potatoes and combine them with the cod, seafood seasoning, pepper, parsley, beaten eggs, onion, and flour."
    },
    {
      "step": 5,
      "text": "Shape the mixture into six cakes and lightly coat them with flour."
    },
    {
      "step": 6,
      "text": "Heat the olive oil in a skillet over medium heat. Fry the cakes for about 3 minutes, turning as needed, until browned and the centers reach 160°F; the fish should be opaque and easily flaked.",
      "timer_minutes": 3
    },
    {
      "step": 7,
      "text": "Drain the cakes briefly on paper towels and serve."
    }
  ],
