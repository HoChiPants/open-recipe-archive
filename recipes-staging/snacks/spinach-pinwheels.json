{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "spinach-pinwheels",
  "name": "Spinach Pinwheels",
  "subtitle": "Crisp spirals filled with creamy spinach",
  "description": "A simple baked snack made by rolling spinach and herb cheese in crescent dough, then slicing and baking until lightly browned.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 12
  },
  "ingredients": [
    {
      "ingredient_id": "refrigerated-crescent-rolls",
      "item": "refrigerated crescent rolls",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "garlic-herb-cheese-spread",
      "item": "garlic herb cheese spread",
      "quantity": 1,
      "unit": "package",
      "preparation": "7 ounce"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed and drained"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Unroll the crescent rolls and press the seams together to form sheets of dough."
    },
    {
      "step": 3,
      "text": "Stir the garlic herb cheese spread and drained spinach together, then spread the mixture evenly over the dough."
    },
    {
      "step": 4,
      "text": "Roll the dough tightly into logs and cut into 30 slices."
    },
    {
      "step": 5,
      "text": "Transfer the slices to a baking sheet with the cut sides facing up, adjusting their shape as needed."
    },
    {
      "step": 6,
      "text": "Bake until lightly browned.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Serve warm."
    }
  ],
