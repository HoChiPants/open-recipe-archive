      "unit": "pinch",
      "preparation": "for garnish"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Cut the eggplant and place it on a baking sheet."
    },
    {
      "step": 3,
      "text": "Roast until tender, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "Let the eggplant cool until easy to handle, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Scoop the eggplant flesh into a bowl and combine it with the garlic, tahini sauce, lemon juice, red pepper flakes, salt, and dried parsley flakes."
    },
    {
      "step": 6,
      "text": "Stir in the olive oil, adjust to taste, and garnish with the remaining dried parsley flakes."
    }
  ],
