  "id": "baba-ghanoush",
  "name": "Baba Ghanoush",
  "subtitle": "Smoky eggplant dip with tahini and lemon",
  "description": "Roasted eggplant is blended with tahini, lemon, garlic, and chili for a creamy dip finished with olive oil and parsley.",
  "meal_type": "snack",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "eggplant",
      "item": "eggplant",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "garlic",
