  "id": "baked-jalapen-o-poppers",
  "name": "Baked Jalapeño Poppers",
  "subtitle": "Cheese-filled peppers with a crisp crumb topping",
  "description": "Jalapeño halves are filled with a creamy Cheddar mixture, topped with panko, and baked until tender.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "jalapeno-peppers",
      "item": "jalapeno peppers",
      "quantity": 12,
      "preparation": "halved lengthwise and seeded"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "ounces",
      "preparation": "softened"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 2,
      "unit": "ounces",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "panko-bread-crumbs",
      "item": "panko bread crumbs",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Lightly coat a baking sheet with cooking spray."
    },
    {
      "step": 3,
      "text": "Whisk the softened cream cheese, Cheddar, and panko until evenly combined."
    },
    {
      "step": 4,
      "text": "Fill each jalapeño half with the cheese mixture and arrange on the prepared baking sheet."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, until the peppers are tender.",
      "timer_minutes": 20
    }
  ],
