    "inactive_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "lemon-juice-concentrate",
      "item": "lemon juice concentrate",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, shredded"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "green-olives",
      "item": "green olives",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened cream cheese, mayonnaise, and lemon juice concentrate until smooth, then mix in the shredded Cheddar."
    },
    {
      "step": 2,
      "text": "Fold in the chopped onion and green olives until evenly distributed."
    },
    {
      "step": 3,
      "text": "Shape the mixture into a ball."
    },
    {
      "step": 4,
      "text": "Cover and chill for 180 minutes, or until firm.",
      "timer_minutes": 180
    }
  ],
