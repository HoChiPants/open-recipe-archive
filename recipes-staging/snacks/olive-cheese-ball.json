  "id": "olive-cheese-ball",
  "name": "Olive Cheese Ball",
  "subtitle": "A chilled cheddar spread with green olives and onion",
  "description": "Cream cheese, cheddar, olives, and onion are combined into a savory ball and chilled until firm.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
