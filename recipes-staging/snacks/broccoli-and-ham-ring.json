  "id": "broccoli-and-ham-ring",
  "name": "Broccoli and Ham Ring",
  "subtitle": "A warm crescent-wrapped appetizer with broccoli, ham, and Swiss cheese.",
  "description": "Chopped broccoli, ham, herbs, and cheese are seasoned with mustard and lemon, then baked in a golden crescent-roll ring.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "ham",
      "item": "ham",
      "quantity": 0.25,
      "unit": "pound",
      "preparation": "cooked, coarsely chopped"
    },
    {
      "ingredient_id": "fresh-broccoli",
      "item": "fresh broccoli",
      "quantity": 0.25,
      "unit": "pound",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "bunch-fresh-green-onions",
      "item": "bunch fresh green onions",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "swiss-cheese",
      "item": "Swiss cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "dijon-style-prepared-mustard",
      "item": "Dijon-style prepared mustard",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "refrigerated-crescent-rolls",
      "item": "refrigerated crescent rolls",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the ham, broccoli, green onions, parsley, and Swiss cheese in a bowl."
    },
    {
      "step": 3,
      "text": "Stir together the mustard and lemon juice, then mix into the filling."
    },
    {
      "step": 4,
      "text": "Separate the crescent rolls and arrange the triangles in an overlapping ring on a baking sheet, with the wide ends toward the center."
    },
    {
      "step": 5,
      "text": "Spoon the filling onto the wide ends of the dough."
    },
    {
      "step": 6,
      "text": "Fold the pointed ends over the filling and tuck them under the inner edge to enclose the ring."
    },
    {
      "step": 7,
      "text": "Bake until the crescent dough is golden brown, about 25–30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Cool briefly, then slice and serve."
    }
  ],
