{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "deep-fried-stuffing",
  "name": "Deep-Fried Stuffing",
  "subtitle": "Crisp breaded bites with a savory center",
  "description": "Shape prepared stuffing into small portions, coat them in seasoned flour, egg wash, and Parmesan breadcrumbs, then fry until crisp and safely heated through.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "poultry-seasoning",
      "item": "poultry seasoning",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "seasoned-bread-crumbs",
      "item": "seasoned bread crumbs",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "prepared-stuffing",
      "item": "prepared stuffing",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "oil-for-frying",
      "item": "oil for frying",
      "quantity": 1,
      "unit": "quart",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the flour, poultry seasoning, and salt and pepper in one shallow dish."
    },
    {
      "step": 2,
      "text": "Whisk the eggs and milk in a second dish until smooth."
    },
    {
      "step": 3,
      "text": "Combine the seasoned bread crumbs, Parmesan, and ground black pepper in a third dish."
    },
    {
      "step": 4,
      "text": "Shape the prepared stuffing into small portions. Coat each portion in flour, dip it in the egg mixture, then roll it evenly in the breadcrumb mixture. Let the coated pieces rest for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Heat the oil to 350°F in a deep, heavy pot or fryer."
    },
    {
      "step": 6,
      "text": "Fry the stuffing pieces in batches for about 4 minutes, turning as needed, until golden brown and the centers reach 165°F.",
      "timer_minutes": 4
    },
    {
      "step": 7,
      "text": "Transfer to a lined plate or rack and serve once set."
    }
  ],
