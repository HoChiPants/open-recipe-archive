{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "peanut-butter-and-banana-dog-biscuits",
  "name": "Peanut Butter and Banana Dog Biscuits",
  "subtitle": "Homemade treats with banana and wheat",
  "description": "Shape a simple peanut butter and banana dough into biscuits, brush with egg white, and bake until golden and firm.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "mashed-banana",
      "item": "mashed banana",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "whole-wheat-flour",
      "item": "whole wheat flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "wheat-germ",
      "item": "wheat germ",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": 1,
      "preparation": "lightly beaten, for brushing"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Stir the peanut butter, mashed banana, and honey together. Blend in the egg until smooth."
    },
    {
      "step": 3,
      "text": "Combine the whole wheat flour and wheat germ, then mix them into the wet ingredients to form a dough."
    },
    {
      "step": 4,
      "text": "On a surface lightly dusted with whole wheat flour, roll or pat the dough to a thick layer and cut out 10 biscuits."
    },
    {
      "step": 5,
      "text": "Brush the tops with the lightly beaten egg white."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until golden brown and the centers are firm; if checked with a thermometer, the egg-containing biscuits should reach 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Cool completely before serving."
    }
  ],
