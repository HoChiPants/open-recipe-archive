  "id": "blue-cheese-ball",
  "name": "Blue Cheese Ball",
  "subtitle": "A savory cheese spread with a walnut coating",
  "description": "Cream cheese, blue cheese, Cheddar, onion, and Worcestershire sauce form a rich party snack finished with chopped walnuts.",
  "meal_type": "snack",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0,
    "inactive_minutes": 480
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "crumbled-blue-cheese",
      "item": "crumbled blue cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sharp-cheddar-cheese",
      "item": "sharp Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "minced"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cream cheese, blue cheese, Cheddar, onion, and Worcestershire sauce until evenly combined."
    },
    {
      "step": 2,
      "text": "Transfer the mixture to a bowl or container and chill until firm."
    },
    {
      "step": 3,
      "text": "Whisk the chilled cheese mixture again until smooth enough to shape."
    },
    {
      "step": 4,
      "text": "Transfer the chopped walnuts to a shallow dish."
    },
    {
      "step": 5,
      "text": "Shape the cheese mixture into a ball, then roll it in the walnuts to coat."
    },
    {
      "step": 6,
      "text": "Chill the coated cheese ball until firm before serving.",
      "timer_minutes": 480
    }
  ],
