  "id": "air-fryer-cheese-and-ham-toastie",
  "name": "Air-Fryer Cheese and Ham Toastie",
  "subtitle": "A crisp, melty toasted sandwich for one",
  "description": "Butter-brushed bread filled with mustard, melted cheese, ham, and chives, finished in the air fryer.",
  "meal_type": "snack",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 20,
      "unit": "g"
    },
    {
      "ingredient_id": "slices-sourdough-or-other-bread",
      "item": "slices sourdough or other bread",
      "quantity": 2
    },
    {
      "ingredient_id": "english-mustard",
      "item": "English mustard",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "grated-mature-cheddar-or-gruye-re",
      "item": "grated mature cheddar or gruyère",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "chives",
      "item": "chives (optional)",
      "quantity": 1,
      "unit": "tbsp",
      "preparation": "chopped",
      "optional": true
    },
    {
      "ingredient_id": "thick-slice-of-ham",
      "item": "thick slice of ham",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to its instructions."
    },
    {
      "step": 2,
      "text": "Spread the mustard over one slice of bread. Add the cheese, ham, and chives, then top with the second slice."
    },
    {
      "step": 3,
      "text": "Spread the softened butter over the outside of both bread slices and place the sandwich in the air-fryer basket."
    },
    {
      "step": 4,
      "text": "Air-fry for 10 minutes, turning if needed, until the bread is crisp and the cheese is melted. If the ham is an uncooked whole cut of pork, verify that it reaches 145°F, then rest it for 3 minutes before eating.",
      "timer_minutes": 10
    }
  ],
