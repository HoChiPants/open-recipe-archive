  "instructions": [
    {
      "step": 1,
      "text": "Place the eggs in a saucepan, cover with water, and bring to a simmer. Cook until hard-set, about 15 minutes, then cool completely in cold water.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Peel the eggs, cut them in half lengthwise, and transfer the yolks to a bowl. Arrange the whites on a serving platter."
    },
    {
      "step": 3,
      "text": "Mash the yolks until smooth. Stir in the mayonnaise, Worcestershire sauce, cream-style horseradish sauce, hot pepper sauce, and salt and pepper until creamy."
    },
    {
      "step": 4,
      "text": "Spoon or pipe the filling into the egg-white halves. Chill for 30 minutes, then garnish with parsley flakes and paprika.",
      "timer_minutes": 30
    }
  ],
