  "id": "deviled-eggs",
  "name": "Deviled Eggs",
  "subtitle": "Creamy, tangy egg halves with a gentle peppery kick",
  "description": "Hard-cooked eggs are filled with a smooth mayonnaise-based mixture flavored with Worcestershire, horseradish, and hot pepper sauce, then finished with parsley and paprika.",
  "meal_type": "snack",
  "cuisine": "American",
