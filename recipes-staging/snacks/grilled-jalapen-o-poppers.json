{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "grilled-jalapen-o-poppers",
  "name": "Grilled Jalapeño Poppers",
  "subtitle": "Creamy cheese-filled peppers wrapped in bacon",
  "description": "Jalapeño peppers are filled with a seasoned cheese mixture, wrapped with bacon, and grilled until tender.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 8,
      "unit": "ounces"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "jalapeno-peppers-with-stems",
      "item": "jalapeno peppers with stems",
      "quantity": 16,
      "unit": "whole"
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 8,
      "preparation": "cut in half crosswise"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill and lightly coat the grates with cooking spray."
    },
    {
      "step": 2,
      "text": "Stir the cream cheese, Cheddar cheese, Parmesan cheese, and garlic powder together until evenly combined."
    },
    {
      "step": 3,
      "text": "Cut each jalapeno pepper lengthwise and remove the seeds and membranes, keeping the stem attached."
    },
    {
      "step": 4,
      "text": "Fill the pepper halves with the cheese mixture, then wrap each popper with a half slice of bacon."
    },
    {
      "step": 5,
      "text": "Grill the poppers, turning as needed, until the peppers are tender and the bacon is cooked, about 30 minutes and up to 40 minutes.",
      "timer_minutes": 40
    }
  ],
  "tags": [
    "appetizer",
    "grilled",
    "jalapen-o",
    "bacon",
    "cheese-filled"
  ],
