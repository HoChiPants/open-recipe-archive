  "id": "cheesy-oatcakes-with-soft-cheese-and-grapes",
  "name": "Cheesy Oatcakes with Soft Cheese and Grapes",
  "subtitle": "Crisp savory oatcakes for serving with creamy cheese and fruit",
  "description": "Bake a simple oat-and-cheese dough into crisp rounds, then serve with soft cheese and grapes.",
  "meal_type": "snack",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "medium-oatmeal",
      "item": "medium oatmeal",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "plain-flour-plus-extra-for-dusting",
      "item": "plain flour plus extra for dusting",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "grated-parmesan-or-vegetarian-alternative",
      "item": "grated parmesan or vegetarian alternative",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "sesame-seeds",
      "item": "sesame seeds (optional)",
      "quantity": 2,
      "unit": "tbsp",
      "optional": true
    },
    {
      "ingredient_id": "soft-cheese-and-grapes",
      "item": "soft cheese and grapes",
      "preparation": "to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a baking sheet."
    },
    {
      "step": 2,
      "text": "Melt the butter and let it cool slightly."
    },
    {
      "step": 3,
      "text": "Combine the oatmeal, flour, baking powder, cheese, and sesame seeds if using. Stir in the melted butter, then add enough boiling water to make a workable dough."
    },
    {
      "step": 4,
      "text": "Dust the work surface with flour. Roll out the dough, cut into rounds, and arrange them on the baking sheet."
    },
    {
      "step": 5,
      "text": "Bake until crisp and lightly golden, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Transfer the oatcakes to a rack to cool, then serve with the soft cheese and grapes."
    }
  ],
