  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a 12-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Combine 1 cup rolled oats, flour, the ½ cup chopped walnuts, baking soda, baking powder, ¼ teaspoon cinnamon, and salt."
    },
    {
      "step": 3,
      "text": "Beat the softened butter and white sugar until smooth. Whisk in the eggs, mashed banana, vanilla, and sour cream."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the wet mixture and stir just until combined."
    },
    {
      "step": 5,
      "text": "For the topping, combine the remaining rolled oats, brown sugar, remaining cinnamon, chilled butter, and ¼ cup chopped walnuts until crumbly. Stir in the 1 tablespoon rolled oats."
    },
    {
      "step": 6,
      "text": "Divide the batter among the muffin cups and sprinkle with the topping."
    },
    {
      "step": 7,
      "text": "Bake for 25 minutes, or until golden brown and a tester comes out clean.",
      "timer_minutes": 25
    }
  ],
