  "id": "banana-bran-muffins",
  "name": "Banana Bran Muffins",
  "subtitle": "Tender muffins with mashed banana and wheat bran",
  "description": "A simple batch of banana muffins with wheat bran and chopped walnuts, ready for breakfast or snacking.",
  "meal_type": "snack",
