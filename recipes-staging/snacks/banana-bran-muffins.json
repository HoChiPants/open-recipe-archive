  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F and prepare a 12-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter and brown sugar until blended. Add the mashed bananas, eggs, milk, and vanilla, then mix until combined."
    },
    {
      "step": 3,
      "text": "Stir together the flour, wheat bran, baking powder, baking soda, and salt. Add to the banana mixture and blend just until no dry streaks remain."
    },
    {
      "step": 4,
      "text": "Fold in the chopped walnuts and transfer the batter to the prepared muffin pan."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, until the muffins are set and a tester inserted in the center comes out clean.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Let the muffins rest in the pan for 5 minutes before transferring them to a rack.",
      "timer_minutes": 5
    }
  ],
