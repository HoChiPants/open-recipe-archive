  "instructions": [
    {
      "step": 1,
      "text": "Place the eggs in a saucepan and add enough water to cover them. Bring the water to a boil, then cook the eggs for 17 minutes.",
      "timer_minutes": 17
    },
    {
      "step": 2,
      "text": "While the eggs cook, combine the white sugar and water in a small saucepan. Add the red jalapeno pepper and salt and ground black pepper to taste, and stir until the mixture is set."
    },
    {
      "step": 3,
      "text": "Drain the eggs and cool them for 15 minutes. Peel them, cut them in half lengthwise, and remove the yolks.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Prepare the cooked sugar mixture as needed, then whisk the cream cheese, mayonnaise, Sriracha or to taste, and Dijon mustard until combined. Stir in the rice vinegar until smooth."
    },
    {
      "step": 5,
      "text": "Prepare the red jalapeno pepper, Sriracha or to taste, and salt and ground black pepper to taste. Prepare the white sugar, then add the pepper mixture, seasoning, and chives to the filling."
    },
    {
      "step": 6,
      "text": "Spoon or pipe the filling into the egg whites. Chill for 20 minutes before serving.",
      "timer_minutes": 20
    }
  ],
