  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the ground sausage in a skillet for 7 minutes, breaking it up as it cooks. Transfer it to a bowl and let it cool for 5 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Whisk the softened cream cheese, bread crumbs, Romano, olive oil, garlic salt, oregano, and basil until evenly blended."
    },
    {
      "step": 4,
      "text": "Stir the cooled sausage into the cheese mixture."
    },
    {
      "step": 5,
      "text": "Arrange the pepper halves in a baking dish and divide the filling among them."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until golden brown and the sausage filling reaches 160°F at the center.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Serve warm."
    }
  ],
