  "id": "stuffed-hot-peppers",
  "name": "Stuffed Hot Peppers",
  "subtitle": "Creamy sausage-filled peppers with Italian herbs",
  "description": "Hot peppers are filled with a seasoned sausage, cheese, and breadcrumb mixture, then baked until golden and safely cooked.",
  "meal_type": "snack",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
