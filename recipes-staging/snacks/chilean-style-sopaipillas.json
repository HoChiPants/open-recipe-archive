{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chilean-style-sopaipillas",
  "name": "Chilean-Style Sopaipillas",
  "subtitle": "Crisp squash rounds with a tender center",
  "description": "A simple Chilean-inspired snack made from cooked squash, buttery dough, and a quick pan-fry.",
  "meal_type": "snack",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "zapallo-squash",
      "item": "zapallo squash",
      "quantity": 9,
      "unit": "ounces"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 10,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "canola-oil-for-pan-frying",
      "item": "canola oil for pan-frying",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the squash into chunks and cook until tender, about 20 minutes. Cool until easy to handle, then mash smoothly.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Combine the flour, baking soda, and salt in a bowl."
    },
    {
      "step": 3,
      "text": "Stir the squash and melted butter together, then mix in the dry ingredients. Knead until a soft dough forms."
    },
    {
      "step": 4,
      "text": "Cover the dough and let it rest for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Roll the dough out thickly and cut it into 12 rounds. Prepare a pan for frying."
    },
    {
      "step": 6,
      "text": "Preheat the canola oil to 385°F, checking the temperature with a thermometer."
    },
    {
      "step": 7,
      "text": "Fry the rounds in batches, turning once, until lightly browned, about 4 minutes total. Drain on a rack or paper towels.",
      "timer_minutes": 4
    },
    {
      "step": 8,
      "text": "Continue frying the remaining rounds, maintaining the oil near 385°F."
    }
  ],
  "tags": [
    "snack",
    "appetizer",
    "chilean"
  ],
