  "instructions": [
    {
      "step": 1,
      "text": "Preheat the smoker to 225°F."
    },
    {
      "step": 2,
      "text": "Place the eggs in their shells in the smoker."
    },
    {
      "step": 3,
      "text": "Smoke for 120 minutes, until the eggs are fully set and reach 160°F internally.",
