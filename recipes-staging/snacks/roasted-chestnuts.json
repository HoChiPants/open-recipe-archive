  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Prepare the chestnuts and arrange them in a single layer on a baking sheet."
    },
    {
      "step": 2,
      "text": "Bake for 30 minutes, or until the shells open and the chestnuts are tender. Cool briefly, then peel.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Melt the butter, then stir in the cinnamon and salt. Toss the peeled chestnuts with the seasoned butter and serve warm."
    }
  ],
