  "id": "roasted-chestnuts",
  "name": "Roasted Chestnuts",
  "subtitle": "Warm chestnuts with cinnamon butter",
  "description": "Oven-roasted chestnuts finished with melted cinnamon butter and salt.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
