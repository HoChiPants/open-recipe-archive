  "instructions": [
    {
      "step": 1,
      "text": "Combine the tomatoes, feta, finely chopped shallot, chilli, garlic, parsley, coriander, 2 tbsp sherry vinegar, and extra virgin olive oil. Set aside for the flavors to blend."
    },
    {
      "step": 2,
      "text": "Heat the grill. Cook the sausages for about 15 minutes, turning as needed, until browned and they reach 160°F in the center.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Meanwhile, heat 1 tbsp olive oil in a pan and cook the sliced shallots until softened and golden. Stir in 3 tbsp sherry vinegar and the honey, then cook briefly until glossy."
    },
    {
      "step": 4,
      "text": "Warm the split buns under the grill or in the pan. Fill each with a sausage and the cooked shallots, then spoon over the tomato mixture."
    },
    {
      "step": 5,
      "text": "Finish with the reserved chilli slices and extra coriander leaves, and serve hot."
    }
  ],
