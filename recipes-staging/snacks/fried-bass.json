  "id": "fried-bass",
  "name": "Fried Bass",
  "subtitle": "Crisp chip-coated striped bass with lemon",
  "description": "Striped bass fillets are seasoned, coated in flour, egg, and crushed salt-and-vinegar chips, then fried until golden and flaky.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "peanut-oil-for-frying",
      "item": "peanut oil for frying",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "6-ounce-fillets-striped-bass-fillets",
      "item": "(6 ounce) fillets striped bass fillets",
      "quantity": 3,
      "preparation": "skinned"
    },
    {
      "ingredient_id": "cajun-seasoning",
      "item": "Cajun seasoning",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lemon-pepper",
      "item": "lemon pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-vinegar-potato-chips",
      "item": "salt-and-vinegar potato chips",
      "quantity": 1,
      "unit": "package",
      "preparation": "1 ounce, crushed"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1,
      "preparation": "cut into wedges"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the peanut oil to 350°F in a deep skillet or fryer."
    },
    {
      "step": 2,
      "text": "Whisk the eggs and water in a shallow bowl until blended. In separate shallow dishes, place the flour and crushed potato chips."
    },
    {
      "step": 3,
      "text": "Season the skinned bass fillets with Cajun seasoning and lemon pepper. Dredge each fillet in flour, dip in the egg mixture, and press into the crushed chips to coat."
    },
    {
      "step": 4,
      "text": "Fry the coated fillets in batches for about 4 minutes per side, or until lightly browned and the fish reaches 145°F and flakes easily.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Serve hot with the lemon wedges."
    }
  ],
