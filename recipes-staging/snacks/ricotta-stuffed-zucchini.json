  "id": "ricotta-stuffed-zucchini",
  "name": "Ricotta-Stuffed Zucchini",
  "subtitle": "Tender zucchini filled with seasoned cheeses",
  "description": "Zucchini halves are seasoned, filled with a basil-lemon ricotta mixture, and baked until tender.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 2,
      "preparation": "halved lengthwise"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "part-skim-ricotta-cheese",
      "item": "part-skim ricotta cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "part-skim-mozzarella-cheese",
      "item": "part-skim mozzarella cheese",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F. Coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Arrange the zucchini halves cut-side up and season with the salt and black pepper."
    },
    {
      "step": 3,
      "text": "Stir together the ricotta, mozzarella, Parmesan, dried basil, lemon juice, and any remaining seasoning."
    },
    {
      "step": 4,
      "text": "Spoon the cheese mixture evenly over the zucchini halves."
    },
    {
      "step": 5,
      "text": "Bake until the zucchini is tender, about 20 minutes.",
      "timer_minutes": 20
    }
  ],
