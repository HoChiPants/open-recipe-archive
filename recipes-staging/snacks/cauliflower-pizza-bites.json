  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F and prepare a baking pan for the bites."
    },
    {
      "step": 2,
      "text": "Place the cauliflower in a microwave-safe bowl and microwave for 6 minutes, or until tender. Let it stand for 20 minutes, then chop or process it into small pieces and press out excess moisture.",
      "timer_minutes": 26
    },
    {
      "step": 3,
      "text": "Combine the cauliflower, egg, 1½ cups mozzarella, Parmesan, salt, pepper, garlic powder, and onion powder. Form the mixture into 12 portions on the prepared pan."
    },
    {
      "step": 4,
      "text": "Bake for 15 minutes, until golden brown and the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Top each bite with pizza sauce and the remaining mozzarella and Parmesan. Bake for 15 minutes, until the cheese is melted.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Cool for 5 minutes, then transfer and serve.",
      "timer_minutes": 5
    }
  ],
