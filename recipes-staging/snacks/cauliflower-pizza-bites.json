  "id": "cauliflower-pizza-bites",
  "name": "Cauliflower Pizza Bites",
  "subtitle": "Cheesy cauliflower bites with pizza sauce",
  "description": "Tender cauliflower is bound with cheese and egg, baked into bite-sized portions, then topped with sauce and more cheese.",
  "meal_type": "snack",
