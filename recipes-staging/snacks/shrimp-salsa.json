  "id": "shrimp-salsa",
  "name": "Shrimp Salsa",
  "subtitle": "A bright, chilled seafood dip with lime and cilantro",
  "description": "Combine cooked shrimp with diced tomatoes, onion, cilantro, lime juice, garlic, salt, and pepper, then chill before serving.",
  "meal_type": "snack",
  "cuisine": "Mexican Inspired",
