  "instructions": [
    {
      "step": 1,
      "text": "In a bowl, mix the shrimp, tomatoes, red onion, cilantro, lime juice, garlic, salt, and black pepper until evenly combined."
    },
    {
      "step": 2,
      "text": "Cover and refrigerate for 60 minutes so the flavors meld. Use shrimp that are fully cooked and opaque.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Stir briefly and serve chilled."
    }
