  "instructions": [
    {
      "step": 1,
      "text": "Whisk the olive oil, lemon juice, cider vinegar, garlic, oregano, salt, and black pepper in a small bowl."
    },
    {
      "step": 2,
      "text": "In a large bowl, combine the thawed corn, sliced olives, bell pepper, and onion. Pour in the dressing and toss until evenly coated."
    },
    {
      "step": 3,
      "text": "Cover and refrigerate the mixture for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 4,
      "text": "Fold in the diced avocados just before serving."
    }
