      "item": "Worcestershire sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "taco-seasoning-mix",
      "item": "taco seasoning mix",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "1.25 ounce"
    },
    {
      "ingredient_id": "slice-american-cheese",
      "item": "slice American cheese",
      "quantity": 0.5,
      "preparation": "sliced into strips"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the softened cream cheese, Cheddar, green onions, Worcestershire sauce, taco seasoning mix, and sliced American cheese until evenly mixed."
    },
    {
      "step": 2,
      "text": "Transfer the mixture to a work surface and shape it into a football form."
    },
    {
      "step": 3,
      "text": "Arrange the American cheese strips on top to create football-style lacing."
    },
    {
      "step": 4,
      "text": "Chill for 2 hours, then let the cheese ball stand for 30 minutes before serving.",
      "timer_minutes": 120
    }
