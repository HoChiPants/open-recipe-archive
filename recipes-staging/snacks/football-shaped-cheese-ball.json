  "id": "football-shaped-cheese-ball",
  "name": "Football-Shaped Cheese Ball",
  "subtitle": "A creamy, savory cheese spread shaped for game-day serving",
  "description": "Combine seasoned cheeses and green onions, shape the mixture into a football, and finish it with cheese-strip details before chilling.",
  "meal_type": "snack",
  "cuisine": "American",
