      "item": "fresh parsley",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened cream cheese, Havarti, and Parmesan until smooth."
    },
    {
      "step": 2,
      "text": "Mix in the 2 tablespoons chopped basil, lemon peel, and garlic until evenly combined."
    },
    {
      "step": 3,
      "text": "Shape the cheese mixture into a tree form."
    },
    {
      "step": 4,
      "text": "Combine the remaining chopped basil and parsley, then press the herbs over the shaped cheese."
    },
    {
      "step": 5,
      "text": "Cover and chill until firm.",
      "timer_minutes": 120
    }
