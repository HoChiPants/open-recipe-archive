  "id": "herbed-cheese-tree",
  "name": "Herbed Cheese Tree",
  "subtitle": "A chilled savory cheese spread with fresh herbs and lemon.",
  "description": "Shape a creamy blend of cheeses, basil, lemon, and garlic into a festive tree, then coat it with fresh herbs.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
