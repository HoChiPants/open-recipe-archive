  "id": "crab-and-lobster-stuffed-mushrooms",
  "name": "Crab and Lobster Stuffed Mushrooms",
  "subtitle": "Baked mushrooms filled with a buttery seafood mixture",
  "description": "Mushroom caps are filled with chopped lobster, crabmeat, garlic, mozzarella, and crushed croutons, then baked until lightly browned and the seafood is fully cooked.",
  "meal_type": "snack",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "melted, divided"
    },
    {
      "ingredient_id": "fresh-mushrooms",
      "item": "fresh mushrooms",
      "quantity": 1,
      "unit": "pound",
      "preparation": "stems removed"
    },
    {
      "ingredient_id": "lobster-tail",
      "item": "lobster tail",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cleaned and chopped"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "seasoned-croutons",
      "item": "seasoned croutons",
      "quantity": 1,
      "unit": "cup",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "crabmeat",
      "item": "crabmeat",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce, drained"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "minced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Brush or coat the mushroom caps with some of the melted butter and arrange them in a baking dish."
    },
    {
      "step": 2,
      "text": "Combine the remaining melted butter with the chopped lobster, mozzarella, crushed croutons, drained crabmeat, and garlic."
    },
    {
      "step": 3,
      "text": "Spoon the seafood mixture into the mushroom caps."
    },
    {
      "step": 4,
      "text": "Bake until lightly browned and the lobster is opaque and easily flaked, about 12 minutes. Confirm the center reaches 145°F.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Top with the remaining mozzarella and serve hot."
    }
  ],
