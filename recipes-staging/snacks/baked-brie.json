{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "baked-brie",
  "name": "Baked Brie",
  "subtitle": "Warm Brie wrapped in flaky pastry with apricot preserves",
  "description": "A simple French-inspired appetizer pairing creamy Brie, sweet apricot preserves, and crisp puff pastry.",
  "meal_type": "snack",
  "cuisine": "French",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "8-ounce-wheel-brie-cheese",
      "item": "(8 ounce) wheel Brie cheese",
      "quantity": 1
    },
    {
      "ingredient_id": "apricot-preserves",
      "item": "apricot preserves",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "frozen-puff-pastry",
      "item": "frozen puff pastry",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "17.5 ounce, thawed"
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Slice the Brie wheel in half horizontally. Spread the apricot preserves over the cut surface, replace the top half, and set the assembled cheese aside."
    },
    {
      "step": 3,
      "text": "Wrap the Brie completely in the thawed puff pastry, sealing the edges. Transfer it to a baking sheet."
    },
    {
      "step": 4,
      "text": "Brush the pastry with the egg white."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until the pastry is golden brown and the egg-white coating is fully set.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Serve warm."
    }
  ],
