  "id": "spicy-fried-pickles",
  "name": "Spicy Fried Pickles",
  "subtitle": "Crisp dill pickle slices with a peppery crumb coating",
  "description": "Dill pickle slices are dipped in beaten egg, coated in seasoned crumbs, fried until golden, and served with ranch dressing.",
  "meal_type": "snack",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "peanut-oil-for-frying",
      "item": "peanut oil for frying",
      "quantity": 2,
      "unit": "cups",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "32-ounce-jar-dill-pickle-slices",
      "item": "(32 ounce) jar dill pickle slices",
      "quantity": 1,
      "preparation": "drained"
    },
    {
      "ingredient_id": "italian-seasoned-bread-crumbs",
      "item": "Italian seasoned bread crumbs",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "ranch-dressing",
      "item": "Ranch dressing",
      "quantity": 1,
      "unit": "bottle",
      "preparation": "8 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the peanut oil in a deep skillet over medium-high heat until hot and shimmering."
    },
    {
      "step": 2,
      "text": "Pat the drained pickle slices dry. Combine the bread crumbs, cayenne, black pepper, and garlic powder in a shallow dish."
    },
    {
      "step": 3,
      "text": "Dip each pickle slice into the beaten eggs, then press it into the seasoned crumbs until coated."
    },
    {
      "step": 4,
      "text": "Fry the coated pickles in batches until crisp and golden brown, turning once as needed. Transfer to a paper towel-lined plate."
    },
    {
      "step": 5,
      "text": "Serve the fried pickles warm with the ranch dressing."
    }
  ],
