{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "bacon-stuffed-mushrooms",
  "name": "Bacon-Stuffed Mushrooms",
  "subtitle": "Tender mushroom caps with a savory cream-cheese filling",
  "description": "Mushroom caps are filled with seasoned cream cheese, Parmesan, and bacon, then baked until tender.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 3
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 3,
      "unit": "drops"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 2,
      "unit": "dashes"
    },
    {
      "ingredient_id": "mushrooms",
      "item": "mushrooms",
      "quantity": 1,
      "unit": "pound",
      "preparation": "stems removed"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the bacon in a skillet until crisp, about 10 minutes. Drain, cool slightly, and crumble.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the softened cream cheese with 2 tablespoons Parmesan, Worcestershire sauce, and black pepper."
    },
    {
      "step": 4,
      "text": "Arrange the mushroom caps in a baking dish and fill each with the cream-cheese mixture. Top with the crumbled bacon and remaining Parmesan."
    },
    {
      "step": 5,
      "text": "Bake until the mushrooms are tender, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
