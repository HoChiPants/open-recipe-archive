  "id": "sweet-potato-hummus",
  "name": "Sweet Potato Hummus",
  "subtitle": "A smooth roasted sweet potato and chickpea dip",
  "description": "Roasted sweet potatoes add mellow sweetness to this creamy, lemon-spiced hummus.",
  "meal_type": "snack",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
