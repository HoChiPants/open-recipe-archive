  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Prepare the sweet potatoes for roasting and cook until tender, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 2,
      "text": "Let the sweet potatoes cool for 15 minutes, then cut them into chunks.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Add the garbanzo beans and olive oil to a food processor. Add the sweet potato, tahini, lemon juice, zest, cumin, coriander, white pepper, and salt."
    },
    {
      "step": 4,
      "text": "Blend until smooth, adding a little reserved bean liquid if needed to reach a creamy consistency."
    }
  ],
