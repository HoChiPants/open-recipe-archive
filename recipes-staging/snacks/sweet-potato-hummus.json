    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-potatoes",
      "item": "sweet potatoes",
      "quantity": 3
    },
    {
      "ingredient_id": "chickpea",
      "item": "garbanzo beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, drained (reserve liquid) and rinsed"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 2,
