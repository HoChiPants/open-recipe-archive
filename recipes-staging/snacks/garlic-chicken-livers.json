  "id": "garlic-chicken-livers",
  "name": "Garlic Chicken Livers",
  "subtitle": "Quick skillet chicken livers with lemon and garlic",
  "description": "Tender chicken livers cooked quickly in olive oil and finished with lemon, salt, and garlic.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-livers",
      "item": "chicken livers",
      "quantity": 1,
      "unit": "pound",
      "preparation": "rinsed, trimmed, and patted dry"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 6,
      "unit": "cloves",
      "preparation": "minced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet over medium-high heat."
    },
    {
      "step": 2,
      "text": "Add the chicken livers and cook, turning as needed, until cooked through and the thickest pieces reach 165°F.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the lemon juice and salt, then add the garlic and cook just until fragrant. Serve warm."
    }
  ],
