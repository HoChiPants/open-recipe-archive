  "id": "tomatillo-avocado-salsa",
  "name": "Tomatillo-Avocado Salsa",
  "subtitle": "A smooth, bright green dip with fresh tomatillos and avocado",
  "description": "Simmered tomatillos and jalapeños are blended with cilantro and avocado, then seasoned with garlic powder and salt for a thick Mexican-style salsa.",
  "meal_type": "snack",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-tomatillos",
      "item": "fresh tomatillos",
      "quantity": 10,
      "preparation": "husks removed"
    },
    {
      "ingredient_id": "fresh-jalapeno-peppers",
      "item": "fresh jalapeno peppers",
      "quantity": 2,
      "preparation": "stems removed"
    },
    {
      "ingredient_id": "bunch-fresh-cilantro",
      "item": "bunch fresh cilantro",
      "quantity": 1,
      "preparation": "stems trimmed"
    },
    {
      "ingredient_id": "avocados",
      "item": "avocados",
      "quantity": 3,
      "preparation": "peeled and pitted"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the tomatillos and jalapeños in a saucepan and stir to coat evenly."
    },
    {
      "step": 2,
      "text": "Simmer the tomatillos and jalapeños for 10 minutes, until the tomatillos are tender.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Transfer the cooked tomatillos and jalapeños to a blender with the cilantro and avocados."
    },
    {
      "step": 4,
      "text": "Blend for 2 minutes, until smooth and thick.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Add the garlic powder and salt to taste, then combine thoroughly."
    },
    {
      "step": 6,
      "text": "Transfer the salsa to a serving bowl."
    }
  ],
