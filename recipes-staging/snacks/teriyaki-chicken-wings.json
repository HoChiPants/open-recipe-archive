      "item": "chicken wings or drumettes",
      "quantity": 3,
      "unit": "pounds"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the water, soy sauce, sugar, pineapple juice, oil, garlic, and ginger into a smooth sauce."
    },
    {
      "step": 2,
      "text": "Coat the chicken wings or drumettes evenly with the sauce and arrange them for baking."
    },
    {
      "step": 3,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 4,
      "text": "Bake the coated chicken for 60 minutes, until cooked through and the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 60
    }
  ],
