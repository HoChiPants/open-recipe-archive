  "id": "teriyaki-chicken-wings",
  "name": "Teriyaki Chicken Wings",
  "subtitle": "Sweet-savory baked wings with garlic and ginger",
  "description": "Chicken wings are coated in a soy, pineapple, garlic, and ginger sauce, then baked until tender and safely cooked.",
  "meal_type": "snack",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 12,
