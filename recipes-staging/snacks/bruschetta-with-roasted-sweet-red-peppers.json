  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill to medium-high heat."
    },
    {
      "step": 2,
      "text": "Cut the Italian bread into thick slices and brush both sides with the olive oil."
    },
    {
      "step": 3,
      "text": "Grill the bread until lightly charred and crisp on both sides."
    },
    {
      "step": 4,
      "text": "Let the grilled bread cool for about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Combine the roasted sweet peppers, garlic, tomato, basil, and onion. Add the balsamic vinegar and stir to distribute."
    },
    {
      "step": 6,
      "text": "Spoon the pepper mixture over the grilled bread and serve."
    }
  ],
