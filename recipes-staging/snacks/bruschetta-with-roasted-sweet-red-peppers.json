  "id": "bruschetta-with-roasted-sweet-red-peppers",
  "name": "Bruschetta with Roasted Sweet Red Peppers",
  "subtitle": "Grilled bread with peppers, tomato, basil, and balsamic",
  "description": "Crisp grilled bread is topped with marinated roasted sweet peppers, fresh vegetables, basil, and balsamic vinegar.",
