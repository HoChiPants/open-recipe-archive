  "id": "caramel-peanut-popcorn",
  "name": "Caramel Peanut Popcorn",
  "subtitle": "Crunchy popcorn coated in buttery brown-sugar caramel",
  "description": "A crisp, sweet-and-salty popcorn snack with roasted peanut crunch.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 11,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 50,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "popped-popcorn",
      "item": "popped popcorn",
      "quantity": 11,
      "unit": "cups"
    },
    {
      "ingredient_id": "spanish-peanuts",
      "item": "Spanish peanuts",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "dark-brown-sugar",
      "item": "dark brown sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 10,
      "unit": "tablespoons",
      "preparation": "cut into pieces"
    },
    {
      "ingredient_id": "dark-corn-syrup",
      "item": "dark corn syrup",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 250°F."
    },
    {
      "step": 2,
      "text": "Combine the popcorn, peanuts, and corn syrup in a large bowl."
    },
    {
      "step": 3,
      "text": "In a saucepan, combine the brown sugar, butter, corn syrup, and salt. Cook for 3 minutes, stirring, until the butter and sugar are melted.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Pour the warm sugar mixture over the popcorn mixture and stir until evenly coated."
    },
    {
      "step": 5,
      "text": "Spread the coated popcorn in an even layer and bake at 250°F for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Let cool for 30 minutes, then break into pieces and serve.",
      "timer_minutes": 30
    }
  ],
