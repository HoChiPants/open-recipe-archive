      "ingredient_id": "london-broil",
      "item": "London broil",
      "quantity": 4,
      "unit": "pounds",
      "preparation": "thinly sliced and fat removed"
    },
    {
      "ingredient_id": "jerky-seasoning",
      "item": "jerky seasoning",
      "quantity": 2,
