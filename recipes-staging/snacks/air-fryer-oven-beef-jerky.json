  "instructions": [
    {
      "step": 1,
      "text": "Combine the jerky seasoning and both amounts of cure. Coat the sliced London broil evenly with the mixture."
    },
    {
      "step": 2,
      "text": "Cover and refrigerate the seasoned beef.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Preheat the air fryer oven to 160°F and arrange the beef strips in a single layer with space between them."
    },
    {
      "step": 4,
      "text": "Dry the beef until firm, dry to the touch, and pliable. Check that the thickest pieces reach at least 145°F, then let them rest for 3 minutes.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Cool the jerky completely before serving or storing.",
      "timer_minutes": 60
    }
