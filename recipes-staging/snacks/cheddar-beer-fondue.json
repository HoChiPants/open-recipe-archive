  "id": "cheddar-beer-fondue",
  "name": "Cheddar Beer Fondue",
  "subtitle": "Warm cheese dip with lager and mustard",
  "description": "A smooth, savory cheese fondue flavored with lager, garlic, Worcestershire sauce, and mustard powder.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "sharp-cheddar-cheese",
      "item": "sharp Cheddar cheese",
      "quantity": 1,
      "unit": "pound",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "lager-beer",
      "item": "lager beer",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "mustard-powder",
      "item": "mustard powder",
      "quantity": 1.5,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a fondue pot or serving vessel."
    },
    {
      "step": 2,
      "text": "Toss the shredded Cheddar with the flour."
    },
    {
      "step": 3,
      "text": "Bring the lager beer to a simmer in a suitable pot."
    },
    {
      "step": 4,
      "text": "Stir in the garlic, Worcestershire sauce, and mustard powder."
    },
    {
      "step": 5,
      "text": "Add the cheese mixture gradually, stirring until incorporated."
    },
    {
      "step": 6,
      "text": "Continue stirring until the cheese is fully melted and smooth, about 5 minutes.",
      "timer_minutes": 5
    }
  ],
