  "id": "bacon-wrapped-barbecue-shrimp",
  "name": "Bacon-Wrapped Barbecue Shrimp",
  "subtitle": "Seasoned shrimp wrapped in crisp bacon",
  "description": "Large shrimp are seasoned, wrapped with bacon, chilled briefly to set, and baked until the shrimp are opaque and tender.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "shrimp",
      "item": "shrimp",
      "quantity": 16,
      "unit": "large",
      "preparation": "peeled and deveined"
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 8
    },
    {
      "ingredient_id": "barbeque-seasoning",
      "item": "barbeque seasoning",
      "preparation": "to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Cut each bacon slice in half. Season the shrimp with barbeque seasoning, then wrap each shrimp with a half slice of bacon and arrange on a baking sheet."
    },
    {
      "step": 3,
      "text": "Chill the wrapped shrimp for 15 minutes so the bacon holds its shape.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Bake until the bacon is cooked and the shrimp are opaque and tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Sprinkle with additional barbeque seasoning to taste and serve immediately."
    }
  ],
