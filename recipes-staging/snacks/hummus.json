{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "hummus",
  "name": "Hummus",
  "subtitle": "A smooth chickpea dip with tahini and lemon",
  "description": "Blend chickpeas, tahini, lemon, and garlic into a creamy dip, then finish with olive oil and pepper.",
  "meal_type": "snack",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves"
    },
    {
      "ingredient_id": "chickpea",
      "item": "garbanzo beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "19 ounce, half the liquid reserved"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "tahini",
      "item": "tahini",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "black-pepper-to-taste",
      "item": "black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Finely chop the garlic."
    },
    {
      "step": 2,
      "text": "Place the garlic in a food processor with the lemon juice, tahini, salt, and black pepper."
    },
    {
      "step": 3,
      "text": "Add the garbanzo beans and blend until smooth, adding the reserved liquid as needed for the desired consistency."
    },
    {
      "step": 4,
      "text": "Transfer the hummus to a serving bowl and stir in the olive oil and additional black pepper."
    },
    {
      "step": 5,
      "text": "Garnish as desired and serve."
    }
  ],
