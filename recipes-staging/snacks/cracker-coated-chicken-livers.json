  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the crushed buttery round crackers with the Italian-style seasoning."
    },
    {
      "step": 3,
      "text": "Coat the fresh chicken livers with the melted butter, then roll them in the cracker mixture."
    },
    {
      "step": 4,
      "text": "Transfer the coated livers to a baking dish and bake for 45 minutes, until the centers reach 165°F on a food thermometer.",
      "timer_minutes": 45
    }
