  "id": "cracker-coated-chicken-livers",
  "name": "Cracker-Coated Chicken Livers",
  "subtitle": "Seasoned chicken livers baked in a crisp cracker coating",
  "description": "Butter-coated chicken livers are seasoned, coated with crushed crackers, and baked until fully cooked.",
  "meal_type": "snack",
