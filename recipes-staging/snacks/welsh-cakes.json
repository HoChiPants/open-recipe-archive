  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, baking powder, salt, white sugar, and granulated sugar for decoration. Cut in the butter and shortening until the mixture is crumbly, then stir in the currants."
    },
    {
      "step": 2,
      "text": "Whisk the egg and milk together, then stir them into the flour mixture to form a soft dough."
    },
    {
      "step": 3,
      "text": "Turn the dough onto a lightly floured surface, shape it into an even round, and cut it into eight portions."
    },
    {
      "step": 4,
      "text": "Preheat a lightly greased griddle or skillet over medium heat."
    },
    {
      "step": 5,
      "text": "Cook the cakes in batches for about 3 minutes per side, until golden brown and the centers are firm and fully set, reaching 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Transfer the cooked cakes to a plate and sprinkle with the granulated sugar for decoration."
    }
  ],
