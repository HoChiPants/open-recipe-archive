{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "deep-fried-onion-rings",
  "name": "Deep-Fried Onion Rings",
  "subtitle": "Crisp battered onion rings",
  "description": "Thick onion rings are coated in a seasoned buttermilk batter and fried until crisp, golden, and fully set.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "bermuda-onions",
      "item": "Bermuda onions",
      "quantity": 3,
      "unit": "large",
      "preparation": "sliced into 1/3-inch rings"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "corn-oil",
      "item": "corn oil",
      "quantity": 2,
      "unit": "cups",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Separate the onion rings and let them rest for 60 minutes. Drain well.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Whisk the flour, buttermilk, beaten egg, baking soda, and salt until smooth."
    },
    {
      "step": 3,
      "text": "Heat the corn oil to 375°F in a deep, heavy pot or fryer."
    },
    {
      "step": 4,
      "text": "Coat the onion rings in the batter, then fry in batches for about 5 minutes, turning as needed, until crisp and golden. Confirm the coating is fully set and reaches 160°F.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Drain the onion rings thoroughly before serving."
    }
  ],
