  "id": "jalapen-o-bacon-cheddar-deviled-eggs",
  "name": "Jalapeño Bacon Cheddar Deviled Eggs",
  "subtitle": "Classic deviled eggs with smoky bacon, cheddar, and jalapeño",
  "description": "Hard-cooked eggs are filled with a creamy cheddar-mustard mixture, then finished with bacon, jalapeño, onion, and paprika.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
