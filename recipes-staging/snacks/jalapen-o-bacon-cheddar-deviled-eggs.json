      "preparation": "or as desired"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the eggs in a saucepan, cover with water, and bring to a boil. Cook for 15 minutes, then cool completely and peel.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Cook the bacon in a skillet over medium heat until crisp, about 10 minutes. Drain and cool, then crumble.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Remove the stems and seeds from the jalapeño peppers and finely chop them."
    },
    {
      "step": 4,
      "text": "Halve the eggs lengthwise and transfer the yolks to a bowl."
    },
    {
      "step": 5,
      "text": "Mash the yolks with the cheddar, mayonnaise, minced red onion, mustard, and chopped jalapeño until combined."
    },
    {
      "step": 6,
      "text": "Spoon or pipe the filling into the egg-white halves. Top with crumbled bacon and paprika."
    }
  ],
