  "id": "pretzel-crust",
  "name": "Pretzel Crust",
  "subtitle": "A crisp, buttery-sweet base with pretzel flavor",
  "description": "Mix softened margarine, brown sugar, and crushed pretzels, then bake until set for a simple snack crust.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
