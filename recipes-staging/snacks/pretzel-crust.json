  "ingredients": [
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "pretzels",
      "item": "pretzels",
      "quantity": 2.5,
      "unit": "cups",
      "preparation": "crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the softened margarine, brown sugar, and crushed pretzels until evenly mixed."
    },
    {
      "step": 3,
      "text": "Press the mixture into the prepared baking pan in an even layer."
    },
    {
      "step": 4,
      "text": "Bake for 10 minutes, until the crust is set.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Let the crust cool before portioning or using."
    }
  ],
