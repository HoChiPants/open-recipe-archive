  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill or broiler."
    },
    {
      "step": 2,
      "text": "Coat the tomatoes, onion, garlic, and jalapeños with the olive oil, then arrange them for roasting and season with the cayenne, salt, and black pepper."
    },
    {
      "step": 3,
      "text": "Roast until the vegetables begin to char, about 5 minutes. Turn or stir them and roast for 5 minutes more.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Let the roasted vegetables cool. Remove and discard the garlic skins."
    },
    {
      "step": 5,
      "text": "Transfer the vegetables to a blender with the cilantro, lime juice, cumin, cayenne, oregano, salt, and black pepper. Blend until smooth."
    },
    {
      "step": 6,
      "text": "Chill the salsa for 2 hours, then adjust the cayenne, salt, and black pepper to taste.",
      "timer_minutes": 120
    }
  ],
