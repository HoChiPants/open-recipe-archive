  "id": "fire-roasted-cherry-tomato-salsa",
  "name": "Fire-Roasted Cherry Tomato Salsa",
  "subtitle": "Smoky, bright salsa with fresh lime and cilantro",
  "description": "Roasted cherry tomatoes, onion, garlic, and jalapeños are blended with herbs and lime, then chilled for a fresh, smoky dip.",
  "meal_type": "snack",
  "cuisine": "Mexican",
