  "id": "crab-spread",
  "name": "Crab Spread",
  "subtitle": "A creamy crab dip with bright lemon and cocktail sauce",
  "description": "A quick chilled spread combining softened cream cheese, crab, cocktail sauce, and lemon.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "crab-meat",
      "item": "crab meat",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce, drained"
    },
    {
      "ingredient_id": "12-ounce-jar-cocktail-sauce",
      "item": "(12 ounce) jar cocktail sauce",
      "quantity": 1
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1,
      "preparation": "juiced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened cream cheese until smooth."
    },
    {
      "step": 2,
      "text": "Add the crab meat and lemon juice, then whisk until combined."
    },
    {
      "step": 3,
      "text": "Whisk in the cocktail sauce. If using raw crab, cook it first until opaque and easily flakes, then cool before mixing."
    },
    {
      "step": 4,
      "text": "Serve the spread chilled or at once."
    }
  ],
