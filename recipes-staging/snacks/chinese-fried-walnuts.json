  "id": "chinese-fried-walnuts",
  "name": "Chinese Fried Walnuts",
  "subtitle": "Crisp sugar-glazed walnuts with a light savory finish",
  "description": "Walnuts are briefly simmered, coated with sugar, fried until crisp, and finished with salt for a crunchy snack.",
  "meal_type": "snack",
  "cuisine": "Chinese",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "shelled-walnuts",
      "item": "shelled walnuts",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "sugar",
      "item": "granulated sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Transfer the walnuts to a pot, cover with water, and simmer for 2 minutes. Drain well and let them dry briefly.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Prepare the sugar in a shallow dish and roll the drained walnuts in it until evenly coated."
    },
    {
      "step": 3,
      "text": "Preheat the oil for frying in a suitable pan over medium heat."
    },
    {
      "step": 4,
      "text": "Fry the coated walnuts in batches, turning as needed, until crisp and golden, about 5 minutes per batch.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Transfer the walnuts to a clean surface or rack, sprinkle with salt to taste, and cool completely before serving."
    }
  ],
