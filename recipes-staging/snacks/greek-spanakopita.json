{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "greek-spanakopita",
  "name": "Greek Spanakopita",
  "subtitle": "Layered phyllo pastry with spinach, feta, and dill",
  "description": "A savory Greek pastry filled with seasoned spinach, feta, eggs, and dill, layered with buttered phyllo and baked until crisp and golden.",
  "meal_type": "snack",
  "cuisine": "Greek",
  "yield": {
    "quantity": 27,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 2,
      "unit": "package",
      "preparation": "10 ounce, thawed, drained and squeezed dry"
    },
    {
      "ingredient_id": "fresh-dill",
      "item": "fresh dill",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "feta-cheese",
      "item": "feta cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "4 ounce, crumbled"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "preparation": "lightly beaten"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "phyllo-dough",
      "item": "phyllo dough",
      "quantity": 1.5,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "pound",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a skillet. Add the onions and stir until softened."
    },
    {
      "step": 3,
      "text": "Stir in the spinach, dill, and flour. Cook for 10 minutes, stirring occasionally.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Combine the feta, beaten eggs, and salt and pepper with the spinach mixture. Set aside."
    },
    {
      "step": 5,
      "text": "Prepare the phyllo dough according to its package directions and transfer it to the work surface."
    },
    {
      "step": 6,
      "text": "Layer phyllo sheets in a baking dish, brushing each with melted butter before adding the next sheet."
    },
    {
      "step": 7,
      "text": "Spread the spinach filling over the phyllo and fold the pastry edges over the filling."
    },
    {
      "step": 8,
      "text": "Cover with additional phyllo sheets, brushing each layer with melted butter. Tuck or fold the edges neatly."
    },
    {
      "step": 9,
      "text": "Cut the assembled pastry into portions before baking."
    },
    {
      "step": 10,
      "text": "Bake for 60 minutes, until golden brown and the center is fully set; verify the egg-containing filling reaches 160°F with a food thermometer.",
      "timer_minutes": 60
    }
  ],
