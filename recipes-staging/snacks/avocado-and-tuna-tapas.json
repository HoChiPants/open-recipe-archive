  "id": "avocado-and-tuna-tapas",
  "name": "Avocado and Tuna Tapas",
  "subtitle": "Creamy tuna filling in fresh avocado halves",
  "description": "A quick Spanish-inspired snack combining seasoned tuna salad, crisp vegetables, and ripe avocado.",
  "meal_type": "snack",
  "cuisine": "Spanish",
  "yield": {
