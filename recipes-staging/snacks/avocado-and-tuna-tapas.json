  "instructions": [
    {
      "step": 1,
      "text": "In a bowl, stir together the drained tuna, mayonnaise, sliced green onions, chopped red pepper, balsamic vinegar, and black pepper."
    },
    {
      "step": 2,
      "text": "Season the mixture with garlic salt and additional black pepper to taste. Canned tuna is ready to serve; if uncooked fish is used, cook it to 145°F, or until opaque and easily flaked."
    },
    {
      "step": 3,
      "text": "Spoon the tuna mixture into the avocado halves."
    },
    {
      "step": 4,
      "text": "Garnish with additional green onion, red pepper, and black pepper, then serve."
    }
  ],
