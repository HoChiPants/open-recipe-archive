  "id": "pesto-puff-pastry-pinwheels",
  "name": "Pesto Puff Pastry Pinwheels",
  "subtitle": "Flaky pastry spirals with ricotta and pesto",
  "description": "A simple savory snack made by layering ricotta and pesto between puff pastry, then slicing and baking until golden.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "sheets-puff-pastry",
      "item": "sheets puff pastry",
      "quantity": 2
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "ricotta-cheese",
      "item": "ricotta cheese",
      "quantity": 8.5,
      "unit": "ounces"
    },
    {
      "ingredient_id": "pesto",
      "item": "pesto",
      "quantity": 8.5,
      "unit": "ounces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Lightly flour the work surface with the all-purpose flour."
    },
    {
      "step": 2,
      "text": "Lay out the puff pastry sheets and spread ricotta over the surface. Layer the pesto, then place the second pastry sheet on top."
    },
    {
      "step": 3,
      "text": "Chill or otherwise firm the layered pastry until it is set enough to cut cleanly."
    },
    {
      "step": 4,
      "text": "Cut the pastry into strips, then cut the strips into pieces and shape each piece into a pinwheel."
    },
    {
      "step": 5,
      "text": "Transfer the pinwheels to a baking sheet, spacing them apart."
    },
    {
      "step": 6,
      "text": "Bake until puffed and golden, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
