{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "crab-rangoon",
  "name": "Crab Rangoon",
  "subtitle": "Crisp baked wontons with creamy crab filling",
  "description": "Cream cheese, crab, aromatics, and savory sauces tucked into wonton wrappers and baked until golden.",
  "meal_type": "snack",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 35,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "crabmeat",
      "item": "crabmeat",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce, drained and flaked"
    },
    {
      "ingredient_id": "green-onions-with-tops",
      "item": "green onions with tops",
      "quantity": 2,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "light-soy-sauce",
      "item": "light soy sauce",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "wonton-wrappers",
      "item": "wonton wrappers",
      "quantity": 48
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Lightly coat a baking sheet with cooking spray."
    },
    {
      "step": 2,
      "text": "Stir the cream cheese, crabmeat, sliced green onions, garlic, Worcestershire sauce, and light soy sauce until evenly combined."
    },
    {
      "step": 3,
      "text": "Arrange the wonton wrappers on a clean work surface. Place a small portion of filling in the center of each wrapper, fold the wrappers over the filling, and firmly seal the edges."
    },
    {
      "step": 4,
      "text": "Place the filled wontons on the prepared baking sheet and lightly coat their tops with cooking spray."
    },
    {
      "step": 5,
      "text": "Bake until golden brown and crisp, about 15 minutes.",
      "timer_minutes": 15
    }
  ],
