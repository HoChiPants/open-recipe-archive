  "id": "toasted-pecans",
  "name": "Toasted Pecans",
  "subtitle": "Buttery, lightly salted pecans toasted until crisp",
  "description": "Pecans coated in melted butter and salt, then slowly toasted for a rich, crunchy snack.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "shelled-pecans",
      "item": "shelled pecans",
      "quantity": 6,
      "unit": "cups"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 275°F."
    },
    {
      "step": 2,
      "text": "Combine the melted butter and pecans in a bowl, stirring until the nuts are evenly coated."
    },
    {
      "step": 3,
      "text": "Spread the pecans in a single layer on a baking sheet and sprinkle with salt to taste."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, stirring occasionally, until toasted and crisp.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Let cool briefly before serving."
    }
  ],
