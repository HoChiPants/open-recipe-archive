  "id": "creamy-guacamole-dip",
  "name": "Creamy Guacamole Dip",
  "subtitle": "A smooth avocado dip with salsa and mild savory seasoning.",
  "description": "Blend ripe avocado with creamy dairy ingredients and salsa, season to taste, and chill before serving.",
  "meal_type": "snack",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "avocados",
      "item": "avocados",
      "quantity": 3,
      "preparation": "peeled, pitted and diced"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "3 ounce, softened"
    },
    {
      "ingredient_id": "salsa",
      "item": "salsa",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
