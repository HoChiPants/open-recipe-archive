      "item": "ground black pepper",
      "quantity": 1,
      "unit": "dash"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 1,
      "unit": "dash"
    },
    {
      "ingredient_id": "onion-powder",
      "item": "onion powder",
      "quantity": 1,
      "unit": "dash"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the avocados, sour cream, softened cream cheese, and salsa in a bowl."
    },
    {
      "step": 2,
      "text": "Blend until smooth and creamy."
    },
    {
      "step": 3,
      "text": "Add the salt, black pepper, garlic salt, and onion powder, then stir until evenly incorporated."
    },
    {
      "step": 4,
      "text": "Cover and chill before serving.",
      "timer_minutes": 120
    }
