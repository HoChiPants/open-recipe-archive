{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "apple-flapjacks",
  "name": "Apple Flapjacks",
  "subtitle": "Chewy oat bars with apple and cinnamon",
  "description": "A simple baked oat treat combining softened apple, dried fruit, golden syrup, and warm cinnamon.",
  "meal_type": "snack",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "butter-plus-extra-for-the-tin",
      "item": "butter plus extra for the tin",
      "quantity": 175,
      "unit": "g"
    },
    {
      "ingredient_id": "apples-about-350g",
      "item": "apples (about 350g)",
      "quantity": "2-3",
      "preparation": "peeled, cored and chopped into small pieces"
    },
    {
      "ingredient_id": "golden-syrup",
      "item": "golden syrup",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "porridge-oats",
      "item": "porridge oats",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "dried-apples-chopped",
      "item": "dried apples chopped",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon (optional)",
      "quantity": "1/2",
      "unit": "tsp",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease a baking tin with some of the butter."
    },
    {
      "step": 2,
      "text": "Cook the chopped apples, light brown soft sugar, and dried apples together for 4 minutes, until the apples are softened and the mixture is set.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Melt the remaining butter with the golden syrup and light brown soft sugar."
    },
    {
      "step": 4,
      "text": "Combine the porridge oats, dried apples, and optional cinnamon in a bowl."
    },
    {
      "step": 5,
      "text": "Stir the melted mixture and cooked apple mixture into the oats until evenly coated. Press the mixture firmly into the prepared tin."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until set and lightly browned.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Cool in the tin, then cut into 16 servings."
    }
  ],
