  "id": "buffalo-chicken-wings-18e05fff",
  "name": "Buffalo Chicken Wings",
  "subtitle": "Crisp baked wings with a spicy butter sauce",
  "description": "Seasoned wings are baked until fully cooked, then coated in a buttery hot sauce mixture.",
  "meal_type": "snack",
  "cuisine": "American",
