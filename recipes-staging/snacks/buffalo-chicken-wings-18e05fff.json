  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, paprika, cayenne pepper, salt, and black pepper in a bowl. Add the chicken wings and toss until evenly coated. Let them rest for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Heat the oven to 400°F. Arrange the coated wings in a single layer on a baking sheet."
    },
    {
      "step": 3,
      "text": "Bake the wings for 15 minutes, turn them, and bake for 15 minutes more, or until a thermometer inserted into the thickest part reads 165°F.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Meanwhile, warm the butter, hot sauce, minced garlic, cayenne pepper, and black pepper in a saucepan. Stir for about 3 minutes, until the butter has melted.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the baked wings to the sauce and toss to coat before serving."
    }
  ],
