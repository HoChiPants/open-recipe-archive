  "schema_version": "1.0.0",
  "id": "spiced-pecans",
  "name": "Spiced Pecans",
  "subtitle": "Sweet, warmly seasoned roasted pecans",
  "description": "Pecan halves are coated with sweet spices and baked until crisp for an easy snack.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": 1,
      "preparation": "lightly beaten"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "pecan-halves",
      "item": "pecan halves",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cloves",
      "item": "ground cloves",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Whisk the egg white, water, and white sugar together. Stir in the pecan halves until evenly coated."
    },
    {
      "step": 3,
      "text": "Combine the white sugar, cinnamon, salt, cloves, and nutmeg, then add the mixture to the coated pecans and toss to distribute."
    },
    {
      "step": 4,
      "text": "Spread the pecans in a single layer on the baking sheet."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until the coating is dry and the egg white is fully set.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool completely before serving."
    }
  ],
