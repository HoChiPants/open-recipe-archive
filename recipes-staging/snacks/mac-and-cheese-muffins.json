  "id": "mac-and-cheese-muffins",
  "name": "Mac and Cheese Muffins",
  "subtitle": "Cheesy baked macaroni cups with a crisp crumb topping",
  "description": "Portion creamy, cheese-coated macaroni into muffin cups, finish with seasoned crumbs, and bake until set.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "seasoned-dry-bread-crumbs",
      "item": "seasoned dry bread crumbs",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "uncooked-elbow-macaroni",
      "item": "uncooked elbow macaroni",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "sharp-cheddar-cheese",
      "item": "sharp Cheddar cheese",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Coat 12 muffin cups with cooking spray."
    },
    {
      "step": 2,
      "text": "Stir the seasoned bread crumbs, olive oil, and salt together; set aside."
    },
    {
      "step": 3,
      "text": "Bring a pot of salted water to a simmer. Add the macaroni and cook for 8 minutes, until boiling and tender. Drain well.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "While the pasta is hot, stir in the butter until evenly coated. Mix in the mozzarella, Cheddar, and milk, then stir in the beaten egg until combined."
    },
    {
      "step": 5,
      "text": "Divide the macaroni mixture among the prepared muffin cups. Top with the remaining shredded cheeses and the seasoned bread crumb mixture."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until the centers are fully set and reach 160°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
