  "id": "salsa-verde",
  "name": "Salsa Verde",
  "subtitle": "Bright, tangy green tomato salsa",
  "description": "A fresh Mexican-inspired salsa made with simmered green tomatoes, jalapeños, lime, onion, and cilantro.",
  "meal_type": "snack",
