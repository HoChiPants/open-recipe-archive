  "instructions": [
    {
      "step": 1,
      "text": "Place the green tomatoes and red tomato in a saucepan, cover with water, and bring to a simmer."
    },
    {
      "step": 2,
      "text": "Cook until the tomatoes are softened, about 15 minutes. Drain well and transfer to a blender or food processor.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Add the jalapeños, chopped onion, lime juice, salt and pepper, and chopped cilantro. Pulse until the salsa reaches the desired texture."
    },
    {
      "step": 4,
      "text": "Chill before serving."
    }
  ],
