  "id": "cheesy-crackers",
  "name": "Cheesy Crackers",
  "subtitle": "Crisp, savory crackers with sharp cheese and Parmesan",
  "description": "A simple rolled cracker dough seasoned with paprika and cayenne, then baked until crisp.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
