    "inactive_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "unsalted-butter-at-room-temperature",
      "item": "unsalted butter at room temperature",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lightly-packed-shredded-sharp-cheddar-cheese",
      "item": "lightly packed shredded sharp Cheddar cheese",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "lightly-packed-freshly-shredded-parmesan-cheese",
      "item": "lightly packed freshly shredded Parmesan cheese",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly oil a baking sheet with the vegetable oil. Combine the butter, Cheddar, Parmesan, paprika, cayenne, and salt until smooth."
    },
    {
      "step": 2,
      "text": "Mix in the flour, then add the cold water and stir until a thick dough forms. Shape the dough into a compact disk, wrap, and chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 4,
      "text": "Roll the chilled dough into a thick sheet on a lightly floured surface. Cut into small cracker shapes, rerolling scraps as needed, and arrange on the prepared baking sheet."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until lightly browned and crisp at the edges.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Cool on the baking sheet for 3 minutes, then transfer to a rack to cool completely.",
      "timer_minutes": 3
    }
  ],
