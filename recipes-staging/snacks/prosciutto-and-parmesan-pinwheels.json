  "id": "prosciutto-and-parmesan-pinwheels",
  "name": "Prosciutto and Parmesan Pinwheels",
  "subtitle": "Crisp puff pastry spirals with savory ham and cheese",
  "description": "Thawed puff pastry is layered with Dijon mustard, prosciutto, and Parmesan, then rolled, sliced, and baked until puffed and golden.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-puff-pastry-sheets",
      "item": "frozen puff pastry sheets",
      "quantity": 1,
      "unit": "package",
      "preparation": "17.5 ounce, thawed"
    },
    {
      "ingredient_id": "prosciutto",
      "item": "prosciutto",
      "quantity": 5,
      "unit": "ounces",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "parmesan-cheese",
      "item": "Parmesan cheese",
      "quantity": 5,
      "unit": "ounces",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "prepared-dijon-mustard",
      "item": "prepared Dijon mustard",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Unfold the thawed puff pastry sheets and arrange them flat."
    },
    {
      "step": 3,
      "text": "Spread the Dijon mustard over the pastry, leaving a narrow edge clear."
    },
    {
      "step": 4,
      "text": "Cover with the prosciutto and thinly sliced Parmesan."
    },
    {
      "step": 5,
      "text": "Roll the pastry into a log, then cut it into thick rounds."
    },
    {
      "step": 6,
      "text": "Arrange the rounds with space between them and bake for 12 minutes, until puffed and golden.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Serve warm."
    }
  ],
