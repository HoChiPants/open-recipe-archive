  "id": "shrimp-stuffed-mushrooms",
  "name": "Shrimp-Stuffed Mushrooms",
  "subtitle": "Creamy shrimp filling in baked mushroom caps",
  "description": "Large mushroom caps are filled with cooked shrimp, crushed crackers, and a two-cheese mixture, then baked until the topping is melted.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "large-mushrooms",
      "item": "large mushrooms",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "baby-shrimp",
      "item": "baby shrimp",
      "quantity": 0.75,
      "unit": "pound",
      "preparation": "cooked"
    },
    {
      "ingredient_id": "bacon-flavored-crackers",
      "item": "bacon flavored crackers",
      "quantity": 1,
      "unit": "cup",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sharp-cheddar-cheese",
      "item": "sharp Cheddar cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Clean the mushrooms, remove the stems, and arrange the caps in a baking dish."
    },
    {
      "step": 3,
      "text": "Combine the cooked shrimp, crushed crackers, softened cream cheese, and shredded Cheddar cheese."
    },
    {
      "step": 4,
      "text": "Fill each mushroom cap with the shrimp mixture and transfer the dish to the oven."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, until the cheese is melted and the filling is hot. Ensure the shrimp is opaque throughout.",
      "timer_minutes": 10
    }
  ],
