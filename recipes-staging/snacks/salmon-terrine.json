  "id": "salmon-terrine",
  "name": "Salmon Terrine",
  "subtitle": "A chilled salmon spread with herbs and lemon",
  "description": "Fresh and smoked salmon are combined with herbs and a smooth mustard-mayonnaise mixture, then chilled until firm enough to slice or spread.",
  "meal_type": "snack",
  "cuisine": "French",
