  "instructions": [
    {
      "step": 1,
      "text": "Bring the water and salt to a simmer. Add the fresh and smoked salmon and cook for about 8 minutes, until the fresh salmon reaches 145°F and flakes easily.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Transfer the salmon to a bowl and let it cool for 10 minutes. Flake the fresh salmon and combine both salmons with the green onion, parsley, and tarragon.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the softened butter, mayonnaise, Dijon mustard, lemon juice, and black pepper until smooth."
    },
    {
      "step": 4,
      "text": "Stir the sauce into the salmon mixture until evenly combined, then pack it into a suitable terrine or serving dish."
    },
    {
      "step": 5,
      "text": "Cover and chill for 3 hours, then serve cold.",
      "timer_minutes": 180
    }
  ],
