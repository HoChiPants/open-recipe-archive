{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "air-fryer-eggplant-dip",
  "name": "Air-Fryer Eggplant Dip",
  "subtitle": "Smoky tahini eggplant dip with feta and parsley",
  "description": "Tender air-fried eggplant and garlic are blended with tahini, lemon, and warm spices, then finished with feta and fresh parsley.",
  "meal_type": "snack",
  "cuisine": "Mediterranean Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "eggplant",
      "item": "eggplant",
      "quantity": 1,
      "unit": "medium",
      "preparation": "halved lengthwise"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 5.5,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "bulb-garlic",
      "item": "bulb garlic",
      "quantity": 1
    },
    {
      "ingredient_id": "tahini-sesame-seed-paste",
      "item": "tahini (sesame seed paste)",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "smoked-paprika",
      "item": "smoked paprika",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "crumbled-feta-cheese",
      "item": "crumbled feta cheese",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Sprinkle the cut sides of the eggplant with kosher salt. Set aside for 30 minutes, then blot away released moisture.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Preheat the air fryer to 400°F. Lightly brush the eggplant with some of the olive oil."
    },
    {
      "step": 3,
      "text": "Trim the top from the garlic bulb, drizzle it with some olive oil, and wrap it securely."
    },
    {
      "step": 4,
      "text": "Arrange the eggplant and wrapped garlic in the air-fryer basket. Cook until the eggplant is very tender, checking early because air-fryer timing varies.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Let the eggplant and garlic cool enough to handle. Scoop the eggplant flesh into a food processor and squeeze in the softened garlic.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Add the remaining olive oil, tahini, lemon juice, cumin, smoked paprika, and lemon zest. Process until smooth."
    },
    {
      "step": 7,
      "text": "Taste and add more lemon juice if desired. Transfer to a serving bowl and top with feta, parsley, and lemon zest."
    }
  ],
