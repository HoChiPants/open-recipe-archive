  "id": "lighter-banana-muffins",
  "name": "Lighter Banana Muffins",
  "subtitle": "Tender muffins made with very ripe bananas",
  "description": "A simple batch of banana muffins with a lightly sweet crumb and straightforward mixing method.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "very-ripe-bananas",
      "item": "very ripe bananas",
      "quantity": 3,
      "preparation": "mashed"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a 10-cup muffin tin."
    },
    {
      "step": 2,
      "text": "Combine the beaten eggs with the mashed bananas."
    },
    {
      "step": 3,
      "text": "In a separate bowl, mix the flour, salt, sugar, and baking soda."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the banana mixture and stir just until combined; fold gently to finish."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared muffin tin."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until the muffins are set in the center and reach 160°F if checked with a thermometer.",
      "timer_minutes": 25
    }
  ],
