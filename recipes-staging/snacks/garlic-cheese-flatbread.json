  "id": "garlic-cheese-flatbread",
  "name": "Garlic Cheese Flatbread",
  "subtitle": "A crisp, buttery flatbread with garlic, basil, and three cheeses.",
  "description": "Spread garlic-basil butter over pizza crust, top with a blend of cheeses, and bake until golden and bubbling. Cut into portions for a savory snack.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "refrigerated-pizza-crust",
      "item": "refrigerated pizza crust",
      "quantity": 1,
      "unit": "package",
      "preparation": "13.8 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 6,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "basil",
      "item": "fresh basil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "grated-romano-cheese",
      "item": "grated Romano cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Unroll the refrigerated pizza crust onto a baking sheet and shape it into an even flatbread."
    },
    {
      "step": 3,
      "text": "Stir together the melted butter, minced garlic, and minced basil."
    },
    {
      "step": 4,
      "text": "Brush the garlic-basil butter over the crust, then sprinkle evenly with the Cheddar, Romano, and Parmesan cheeses."
    },
    {
      "step": 5,
      "text": "Bake for 12 minutes, until the crust is golden and the cheese is melted and lightly browned.",
      "timer_minutes": 12
    },
    {
      "step": 6,
      "text": "Cut into 12 portions and serve warm."
    }
  ],
