  "id": "comte-gouge-res",
  "name": "Comté Gougères",
  "subtitle": "Savory cheese puffs with a creamy Comté finish",
  "description": "Light French cheese puffs made with choux pastry and served with a warm Comté cream sauce.",
  "meal_type": "snack",
  "cuisine": "French",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 50
  },
  "ingredients": [
