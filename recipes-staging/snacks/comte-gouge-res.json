      "ingredient_id": "comte-grated",
      "item": "comté grated",
      "quantity": 200,
      "unit": "g",
      "preparation": "plus extra finely grated comté to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Warm the milk, 50 g butter, and whole milk together until the butter melts."
    },
    {
      "step": 3,
      "text": "Stir in 125 g plain flour until a smooth dough forms."
    },
    {
      "step": 4,
      "text": "Whisk in the eggs gradually until fully incorporated, then mix in 150 g grated Comté."
    },
    {
      "step": 5,
      "text": "Prepare a baking sheet and portion the dough into about 20 small mounds."
    },
    {
      "step": 6,
      "text": "Bake until puffed and golden, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Cool the gougères briefly."
    },
    {
      "step": 8,
      "text": "Melt the remaining 35 g butter in a saucepan."
    },
    {
      "step": 9,
      "text": "Whisk in 20 g plain flour to form a smooth roux."
    },
    {
      "step": 10,
      "text": "Gradually whisk in the milk, whole milk, and double cream until smooth and thickened."
    },
    {
      "step": 11,
      "text": "Preheat the sauce gently without boiling it."
    },
    {
      "step": 12,
      "text": "Transfer the sauce to a serving vessel."
    },
    {
      "step": 13,
      "text": "Prepare the gougères for serving."
    },
    {
      "step": 14,
      "text": "Prepare the remaining grated Comté for garnish."
    },
    {
      "step": 15,
      "text": "Transfer the gougères to the serving dish, spoon over the sauce, and finish with the extra finely grated Comté."
    }
  ],
