  "id": "luncheon-meat-musubi",
  "name": "Luncheon Meat Musubi",
  "subtitle": "Seasoned rice and browned luncheon meat wrapped in nori",
  "description": "Compact rice snacks layered with savory glazed luncheon meat and wrapped in dry seaweed.",
  "meal_type": "snack",
