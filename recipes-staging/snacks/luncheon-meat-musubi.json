  "instructions": [
    {
      "step": 1,
      "text": "Cook the rice with the water until tender. Stir in the rice vinegar and let the rice cool until it is set enough to shape.",
      "timer_minutes": 240
    },
    {
      "step": 2,
      "text": "Combine the remaining water, soy sauce, oyster sauce, and white sugar in a small saucepan. Simmer, stirring, until the sugar dissolves and the mixture is combined."
    },
    {
      "step": 3,
      "text": "Slice the luncheon meat into 10 pieces. Heat the vegetable oil in a skillet, add the slices, and cook until lightly browned, turning once.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Cut each nori sheet into two strips. Transfer the browned meat to a plate and let it cool briefly."
    },
    {
      "step": 5,
      "text": "Shape the rice into 10 thick portions. Top each portion with a slice of luncheon meat, brush or spoon on the sauce, and wrap with a nori strip."
    },
    {
      "step": 6,
      "text": "Serve immediately or after the nori has softened slightly around the rice."
    }
  ],
