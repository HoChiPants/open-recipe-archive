  "id": "cheese-and-pickle-pinwheels",
  "name": "Cheese and Pickle Pinwheels",
  "subtitle": "Savory puff pastry spirals with tangy pickle and mustard",
  "description": "Cheesy puff pastry rolls baked until crisp and golden for an easy snack or buffet bite.",
  "meal_type": "snack",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "strong-cheddar-grated",
      "item": "strong cheddar grated",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "lancashire-cheese-grated",
      "item": "Lancashire cheese grated",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "heaped-tbsp-pickle",
      "item": "heaped tbsp pickle",
      "quantity": 2
    },
    {
      "ingredient_id": "english-mustard-powder",
      "item": "English mustard powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "sheet-all-butter-puff-pastry",
      "item": "sheet all-butter puff pastry",
      "quantity": 320,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Combine the grated cheeses. Stir the pickle and mustard powder together, then spread this mixture over the pastry and distribute the cheese on top."
    },
    {
      "step": 3,
      "text": "Roll the pastry into a log and cut it into 12 even slices. Arrange the slices on the baking sheet and brush with the beaten egg."
    },
    {
      "step": 4,
      "text": "Bake for 20 minutes, until golden brown with a fully set center; if checked with a thermometer, the egg-containing center should reach 160°F.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Cool briefly before serving."
    }
  ],
