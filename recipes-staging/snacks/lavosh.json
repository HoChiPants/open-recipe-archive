{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "lavosh",
  "name": "Lavosh",
  "subtitle": "Thin sesame-crusted baked flatbread",
  "description": "A crisp, lightly sweet flatbread finished with beaten egg white and sesame seeds.",
  "meal_type": "snack",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.67,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": 1
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "sesame-seeds",
      "item": "sesame seeds",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Stir together the flour, sugar, and salt. Add the water, one egg white, and melted butter, then combine into a dough."
    },
    {
      "step": 3,
      "text": "Knead the dough for 5 minutes, until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Prepare the work surface with flour. Shape the dough into thin pieces and transfer them to a baking sheet."
    },
    {
      "step": 5,
      "text": "Brush the pieces with the beaten egg whites and sprinkle with sesame seeds."
    },
    {
      "step": 6,
      "text": "Bake for 12 minutes, or until crisp and the egg-white coating is fully set; verify any thick portion reaches 160°F.",
      "timer_minutes": 12
    }
  ],
