{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "refrigerator-pickles",
  "name": "Refrigerator Pickles",
  "subtitle": "Sweet-tart cucumber slices with crisp vegetables",
  "description": "Cucumbers, onions, and green bell peppers soak in a warm vinegar brine, then chill until tangy and crisp.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 64,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 15,
    "inactive_minutes": 1440
  },
  "ingredients": [
    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "cucumber",
      "item": "cucumbers",
      "quantity": 6,
      "unit": "cups",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 1,
      "unit": "cup",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "green-bell-peppers",
      "item": "green bell peppers",
      "quantity": 1,
      "unit": "cup",
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the sliced cucumbers, onions, and green bell peppers in a large heatproof container."
    },
    {
      "step": 2,
      "text": "Combine the distilled white vinegar, white sugar, and salt in a saucepan over medium heat."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer and cook for 10 minutes, stirring until the sugar dissolves.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Pour the hot brine over the vegetables and stir gently to coat."
    },
    {
      "step": 5,
      "text": "Cool briefly, cover, and refrigerate for at least 24 hours before serving. Keep refrigerated; this is not a shelf-stable preserve."
    }
  ],
