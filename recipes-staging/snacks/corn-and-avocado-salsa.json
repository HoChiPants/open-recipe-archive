  "instructions": [
    {
      "step": 1,
      "text": "Cook the husked corn for about 5 minutes, until tender. Let it cool enough to handle, then cut the kernels from the cobs.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Combine the corn kernels, avocados, red onion, red bell pepper, cilantro, vinegar, lime juice, olive oil, garlic, cumin, and red pepper flakes in a bowl."
    },
    {
      "step": 3,
      "text": "Stir gently until evenly mixed, season with salt and black pepper, and serve."
    }
