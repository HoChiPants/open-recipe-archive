  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "tuna-ball",
  "name": "Tuna Ball",
  "subtitle": "A chilled, savory tuna-and-cream-cheese snack",
  "description": "Combine flaked tuna with softened cream cheese, pecans, and onion, then shape and chill for serving.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "3 ounce, softened"
    },
    {
      "ingredient_id": "tuna",
      "item": "tuna",
      "quantity": 1,
      "unit": "can",
      "preparation": "5 ounce, drained and flaked"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Confirm the tuna is fully cooked, opaque, and easily flaked; fish should reach 145°F internally before use."
    },
    {
      "step": 2,
      "text": "Whisk the softened cream cheese, tuna, pecans, and onion together until evenly combined."
    },
    {
      "step": 3,
      "text": "Shape the mixture into balls, using the pecans as the coating or garnish."
    },
    {
      "step": 4,
      "text": "Chill until firm, then serve."
    }
  ],
