{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "air-fryer-cinnamon-sugar-pecans",
  "name": "Air-Fryer Cinnamon Sugar Pecans",
  "subtitle": "Quick crisp pecans with a cinnamon-sugar coating",
  "description": "Pecan halves are coated in a cinnamon-sugar egg-white mixture, then air-fried with melted butter until crisp and dry.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 12
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "salted butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": 1
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "pecan-halves",
      "item": "pecan halves",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 300°F. Line the basket with a perforated liner or a small piece of parchment secured beneath the pecans."
    },
    {
      "step": 2,
      "text": "Whisk the white sugar, egg white, and ground cinnamon until combined. Fold in the pecan halves until evenly coated."
    },
    {
      "step": 3,
      "text": "Arrange the coated pecans in the basket in a single layer and drizzle with the melted salted butter."
    },
    {
      "step": 4,
      "text": "Air-fry, stirring once or twice, until the coating is dry, the egg white is fully set, and the pecans are crisp.",
      "timer_minutes": 12
    }
  ],
