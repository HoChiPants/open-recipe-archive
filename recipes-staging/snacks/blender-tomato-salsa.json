  "id": "blender-tomato-salsa",
  "name": "Blender Tomato Salsa",
  "subtitle": "A bright, smooth salsa made in minutes",
  "description": "Blend canned tomatoes with fresh chile, onion, cilantro, lemon juice, and salt, then chill before serving.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 28,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 2,
      "unit": "can",
      "preparation": "14.4 ounce, diced"
    },
    {
      "ingredient_id": "jalapeno-chile",
      "item": "jalapeno chile",
      "quantity": 1,
      "preparation": "seeds and ribs removed"
    },
    {
      "ingredient_id": "onion",
      "item": "yellow onion",
      "quantity": 0.5,
      "preparation": "quartered"
    },
    {
      "ingredient_id": "bunch-cilantro-leaves",
      "item": "bunch cilantro leaves",
      "quantity": 0.5
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the tomatoes, jalapeno, onion, cilantro, lemon juice, and salt to a blender."
    },
    {
      "step": 2,
      "text": "Blend until smooth, pausing to scrape down the sides if needed. Adjust the lemon juice and salt to taste."
    },
    {
      "step": 3,
      "text": "Refrigerate the salsa for at least 30 minutes before serving.",
      "timer_minutes": 30
    }
  ],
