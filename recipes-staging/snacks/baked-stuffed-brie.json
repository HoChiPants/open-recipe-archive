  "id": "baked-stuffed-brie",
  "name": "Baked Stuffed Brie",
  "subtitle": "Cranberries and walnuts wrapped in golden puff pastry",
  "description": "A warm, pastry-wrapped Brie filled with dried cranberries and chopped walnuts, suitable for sharing.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
