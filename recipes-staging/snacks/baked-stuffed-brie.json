  "instructions": [
    {
      "step": 1,
      "text": "Slice the chilled Brie horizontally into two rounds. Set the top aside and distribute the dried cranberries and chopped walnuts over the cut surface of the bottom round."
    },
    {
      "step": 2,
      "text": "Replace the top round. Roll or shape the thawed puff pastry large enough to enclose the Brie, place the cheese in the center, and fold the pastry over it. Press the seams closed and trim excess pastry; use extra pastry for an optional design."
    },
    {
      "step": 3,
      "text": "Whisk the egg with the water. Brush the pastry all over with the egg wash, then chill the wrapped Brie for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Preheat the oven to 425°F. Place the chilled Brie on a baking sheet and bake until the pastry is golden and the center reaches 160°F, about 20 to 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Rest briefly, then serve warm."
    }
  ],
