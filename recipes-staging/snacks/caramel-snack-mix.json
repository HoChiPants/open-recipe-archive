{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "caramel-snack-mix",
  "name": "Caramel Snack Mix",
  "subtitle": "A crisp, nutty snack coated in buttery caramel",
  "description": "Cereal and nuts are baked with a simple brown-sugar caramel coating for a crunchy snack mix.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-corn-syrup",
      "item": "white corn syrup",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "almonds",
      "item": "almonds",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "crispy-corn-and-rice-cereal",
      "item": "crispy corn and rice cereal",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 275°F."
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan over medium heat. Stir in the white corn syrup and packed brown sugar until combined and smooth.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Place the crispy corn and rice cereal, pecans, and almonds in a large bowl. Pour the butter mixture over them and toss gently to coat."
    },
    {
      "step": 4,
      "text": "Spread the mixture evenly in a large baking pan. Bake at 275°F for 60 minutes, stirring occasionally, until crisp and coated.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Cool the snack mix before serving."
    }
  ],
