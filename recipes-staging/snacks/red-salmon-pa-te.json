{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "red-salmon-pa-te",
  "name": "Red Salmon Pâté",
  "subtitle": "A chilled salmon spread with horseradish and pecans",
  "description": "Blend canned salmon with cream cheese, bright lemon, horseradish, onion, parsley, and pecans for a cool, savory spread.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 0,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "salmon",
      "item": "salmon",
      "quantity": 1,
      "unit": "can",
      "preparation": "7 ounce, drained, flaked and bones removed"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "prepared-horseradish",
      "item": "prepared horseradish",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "grated-onion",
      "item": "grated onion",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "For food-safety verification, ensure the salmon has reached 145°F and is opaque and easily flaked before using."
    },
    {
      "step": 2,
      "text": "Mix the salmon, cream cheese, horseradish, lemon juice, and grated onion until evenly combined."
    },
    {
      "step": 3,
      "text": "Shape the mixture into a firm mound or log, then coat it with the chopped parsley and pecans."
    },
    {
      "step": 4,
      "text": "Cover and chill until firm.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Serve chilled."
    }
  ],
