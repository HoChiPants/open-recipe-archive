  "id": "apple-pear-fruit-leather",
  "name": "Apple-Pear Fruit Leather",
  "subtitle": "A smooth, tangy fruit snack dried until pliable",
  "description": "Blend apples and pears with sugar and lemon, then bake the puree low and slow until flexible enough to roll and cut.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
