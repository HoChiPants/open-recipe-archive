      "preparation": "cored and chopped pears"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 150°F. Line a rimmed baking sheet with parchment paper."
    },
    {
      "step": 2,
      "text": "Combine the sugar, lemon juice, peeled apples, and peeled pears. Puree until completely smooth."
    },
    {
      "step": 3,
      "text": "Spread the puree in an even layer on the prepared baking sheet."
    },
    {
      "step": 4,
      "text": "Bake for 5 to 6 hours, until the surface is dry and the fruit sheet is flexible.",
      "timer_minutes": 360
    },
    {
      "step": 5,
      "text": "Cool, then cut into strips or pieces and shape as desired."
    }
  ],
