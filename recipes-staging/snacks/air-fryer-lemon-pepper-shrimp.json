  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 400°F."
    },
    {
      "step": 2,
      "text": "In a bowl, combine the olive oil, juiced lemon, lemon pepper, paprika, and garlic powder. Add the shrimp and toss until coated."
    },
    {
      "step": 3,
      "text": "Arrange the shrimp in a single layer in the air-fryer basket. Cook at 400°F until opaque and cooked through, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Serve with the sliced lemon."
    }
  ],
