  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-covered-bacon",
  "name": "Chocolate-Covered Bacon",
  "subtitle": "Crisp bacon finished with a smooth chocolate coating",
  "description": "Bake bacon until crisp, coat it in melted semisweet chocolate, and chill until firm for a sweet-and-savory snack.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "slices-thick-cut-bacon",
      "item": "slices thick-cut bacon",
      "quantity": 12
    },
    {
      "ingredient_id": "wooden-skewers",
      "item": "wooden skewers",
      "quantity": 12
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-shortening",
      "item": "vegetable shortening",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Thread the bacon onto the wooden skewers and arrange the skewers on a baking sheet."
    },
    {
      "step": 2,
      "text": "Bake the bacon until crisp, about 20 minutes. Set it aside to cool for 25 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Combine the chocolate chips and shortening in a heatproof bowl. Heat gently, stirring, until melted and smooth."
    },
    {
      "step": 4,
      "text": "Coat the cooled bacon with the melted chocolate, then place the skewers on a lined surface."
    },
    {
      "step": 5,
      "text": "Chill until the coating is firm, about 30 minutes, then serve.",
      "timer_minutes": 30
    }
  ],
