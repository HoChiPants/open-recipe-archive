  "id": "horseradish-dill-pickles",
  "name": "Horseradish Dill Pickles",
  "subtitle": "Crisp cucumber pickles with dill, garlic, and fresh horseradish",
  "description": "Small cucumbers are soaked, briefly simmered in a sweet-sour spiced brine, packed with aromatics, and chilled until seasoned.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 50,
    "unit": "servings"
  },
