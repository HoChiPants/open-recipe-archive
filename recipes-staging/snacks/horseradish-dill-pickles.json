      "item": "(1/4 inch x 3 inch) strips peeled fresh horseradish root",
      "quantity": 10
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cover the cucumbers with water and let them stand for 3 hours. Drain well.",
      "timer_minutes": 180
    },
    {
      "step": 2,
      "text": "Combine the water, vinegar, sugar, pickling spices, and pickling salt in a pot. Bring the brine to a full boil, then reduce to a simmer.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Trim and cut the cucumbers as desired. Arrange them in clean containers with the dill, garlic, and horseradish strips."
    },
    {
      "step": 4,
      "text": "Pour the hot brine over the cucumbers and aromatics, ensuring they are covered. Cool briefly, then refrigerate until chilled and seasoned.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Serve cold. No federal meat, poultry, egg, fish, or shellfish temperature endpoint applies to this vegetable pickle."
    }
  ],
