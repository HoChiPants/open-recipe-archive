  "id": "baked-caprese-crostini",
  "name": "Baked Caprese Crostini",
  "subtitle": "Toasted baguette with tomatoes, mozzarella, and basil",
  "description": "Crisp baguette slices are layered with tomatoes and fresh mozzarella, then baked until golden and melty and finished with basil and seasoned olive oil.",
  "meal_type": "snack",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "french-baguette",
      "item": "French baguette",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "sea-salt-to-taste",
      "item": "sea salt to taste"
    },
    {
      "ingredient_id": "roma-tomatoes",
      "item": "Roma tomatoes",
      "quantity": 5,
      "unit": "large"
    },
    {
      "ingredient_id": "slices-fresh-mozzarella-cheese",
      "item": "slices fresh mozzarella cheese",
      "quantity": 30,
      "unit": "small"
    },
    {
      "ingredient_id": "bunch-fresh-basil",
      "item": "bunch fresh basil",
      "quantity": 1,
      "preparation": "leaves removed and coarsely chopped"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F. Slice the baguette and arrange the pieces on a baking sheet. Brush with half of the olive oil and season with sea salt."
    },
    {
      "step": 2,
      "text": "Bake the bread for 5 minutes, until golden brown.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Slice the tomatoes and mozzarella. Top each toasted baguette slice with tomato and mozzarella, then season with sea salt."
    },
    {
      "step": 4,
      "text": "Bake for 5 minutes, until the mozzarella is melted.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Transfer the crostini to a serving platter. Top with chopped basil and drizzle with the remaining olive oil. Season with sea salt and black pepper to taste."
    }
  ],
