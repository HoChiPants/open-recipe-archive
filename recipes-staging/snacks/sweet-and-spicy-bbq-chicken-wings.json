      "item": "red pepper flakes",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Arrange the frozen chicken wings in a single layer on a baking sheet and cook for 18 minutes, until the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 18
    },
    {
      "step": 2,
      "text": "Meanwhile, combine the ketchup, red wine vinegar, dark brown sugar, smoked paprika, salt, black pepper, and red pepper flakes in a saucepan."
    },
    {
      "step": 3,
      "text": "Bring the sauce to a simmer and cook for 5 minutes, stirring until combined.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Transfer the cooked wings to a bowl, pour over the sauce, and toss to coat."
    }
  ],
