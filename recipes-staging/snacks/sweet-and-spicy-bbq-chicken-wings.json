  "id": "sweet-and-spicy-bbq-chicken-wings",
  "name": "Sweet and Spicy BBQ Chicken Wings",
  "subtitle": "Oven-baked wings with a tangy, smoky glaze",
  "description": "Frozen chicken wings are baked until safely cooked, then coated in a quick sweet-and-spicy barbecue sauce.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 23
  },
  "ingredients": [
    {
      "ingredient_id": "frozen",
      "item": "frozen",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "ready-to-cook chicken wings"
    },
    {
