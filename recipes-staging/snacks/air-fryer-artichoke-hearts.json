  "id": "air-fryer-artichoke-hearts",
  "name": "Air Fryer Artichoke Hearts",
  "subtitle": "Crisp, seasoned artichoke hearts with Parmesan",
  "description": "Drained artichoke hearts are coated with olive oil, Parmesan, and Italian-style seasonings, then air-fried until hot and lightly crisp.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "artichoke-hearts-in-water",
      "item": "artichoke hearts in water",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce, quartered, drained"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "italian-seasoning",
      "item": "Italian seasoning",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
