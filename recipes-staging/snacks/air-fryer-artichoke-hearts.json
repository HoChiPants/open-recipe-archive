      "item": "garlic powder",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 390°F."
    },
    {
      "step": 2,
      "text": "Pat the drained artichoke hearts dry. Toss with the Parmesan cheese, Italian seasoning, salt, black pepper, garlic powder, and olive oil."
    },
    {
      "step": 3,
      "text": "Arrange the artichokes in a single layer in the air-fryer basket. Cook until hot and lightly crisp, shaking the basket halfway through.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Serve warm."
    }
  ],
