  "id": "cheese-marmite-and-spinach-pinwheels",
  "name": "Cheese, Marmite and Spinach Pinwheels",
  "subtitle": "Savory puff pastry spirals with cheddar and spinach",
  "description": "Puff pastry is spread with Marmite, layered with spinach and cheddar, then rolled, sliced, and baked until golden.",
  "meal_type": "snack",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "sheet-ready-rolled-light-puff-pastry",
      "item": "sheet ready-rolled light puff pastry",
      "quantity": 320,
      "unit": "g"
    },
    {
      "ingredient_id": "marmite",
      "item": "Marmite",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "handfuls-of-spinach",
      "item": "handfuls of spinach",
      "quantity": "2-3",
      "unit": "large"
    },
    {
      "ingredient_id": "cheddar",
      "item": "cheddar",
      "quantity": 80,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F and line a baking sheet with parchment."
    },
    {
      "step": 2,
      "text": "Unroll the puff pastry on a clean work surface. Spread the Marmite evenly over the pastry, then scatter the spinach and cheddar across the top."
    },
    {
      "step": 3,
      "text": "Roll the pastry tightly into a log from one long side. Slice it into 12 even rounds and place them cut-side up on the baking sheet."
    },
    {
      "step": 4,
      "text": "Bake until puffed and golden brown.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Cool briefly before serving."
    }
  ],
