  "id": "artichoke-chicken",
  "name": "Artichoke Chicken",
  "subtitle": "Chicken breasts baked with a creamy artichoke-Parmesan topping",
  "description": "A simple oven-baked chicken dish finished with a savory artichoke, Parmesan, and mayonnaise topping.",
