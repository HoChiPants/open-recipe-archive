  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Stir together the artichoke hearts, Parmesan, mayonnaise, and garlic pepper."
    },
    {
      "step": 3,
      "text": "Arrange the chicken in the prepared dish and spread the artichoke mixture over the top."
    },
    {
      "step": 4,
      "text": "Bake for 30 minutes, or until the thickest part of the chicken reaches 165°F.",
