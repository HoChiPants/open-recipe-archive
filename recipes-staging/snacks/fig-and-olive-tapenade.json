  "id": "fig-and-olive-tapenade",
  "name": "Fig and Olive Tapenade",
  "subtitle": "A sweet-savory spread with herbs and toasted walnuts",
  "description": "Simmered figs and seasoned olives are blended into a bold spread, then paired with softened cream cheese and walnuts.",
  "meal_type": "snack",
  "cuisine": "French Inspired",
