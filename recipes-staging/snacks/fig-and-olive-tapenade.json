  "instructions": [
    {
      "step": 1,
      "text": "Place the figs and water in a saucepan. Bring to a simmer and cook until the figs are tender.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Warm the olive oil with the balsamic vinegar, rosemary, thyme, and cayenne. Stir in the olives and garlic, then season with salt and pepper."
    },
    {
      "step": 3,
      "text": "Blend the fig mixture and olive mixture until combined. Cover and refrigerate for 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 4,
      "text": "Whisk the cream cheese until smooth, then spread or spoon it onto a serving plate and top with the chilled tapenade and toasted walnuts."
    },
    {
      "step": 5,
      "text": "Serve chilled or cool."
    }
  ],
