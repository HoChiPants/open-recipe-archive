  "id": "spinach-feta-phyllo-cups",
  "name": "Spinach-Feta Phyllo Cups",
  "subtitle": "Crisp layered pastry filled with savory spinach and cheese",
  "description": "Layer buttered whole-wheat phyllo with a seasoned spinach-and-cheese filling, then bake until golden and crisp.",
  "meal_type": "snack",
  "cuisine": "Greek",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 2,
      "unit": "package",
      "preparation": "10 ounce, thawed and well drained"
    },
    {
      "ingredient_id": "crumbled-feta-cheese",
      "item": "crumbled feta cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "whole-wheat-phyllo-dough",
      "item": "whole wheat phyllo dough",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine the well-drained spinach, feta, mozzarella, Parmesan, garlic, and salt."
    },
    {
      "step": 3,
      "text": "Cut the phyllo into squares. Brush each piece with melted butter, layer the pieces, and press them into 15 muffin-cup wells to form pastry cups."
    },
    {
      "step": 4,
      "text": "Divide the spinach mixture among the phyllo cups, then fold the pastry edges over the filling. Brush the tops with the remaining melted butter."
    },
    {
      "step": 5,
      "text": "Bake until the pastry is golden brown and crisp, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Cool briefly before serving."
    }
  ],
