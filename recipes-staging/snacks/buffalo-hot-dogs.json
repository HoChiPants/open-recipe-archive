  "id": "buffalo-hot-dogs",
  "name": "Buffalo Hot Dogs",
  "subtitle": "Sausages with blue cheese sauce and crisp onions",
  "description": "Serve browned sausages in brioche buns with a tangy blue cheese and celery topping, buffalo hot sauce, and fried onions.",
  "meal_type": "snack",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "blue-cheese",
      "item": "blue cheese",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "soured-cream",
      "item": "soured cream",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "celery-stick",
      "item": "celery stick",
      "quantity": 1,
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "sausages",
      "item": "sausages",
      "quantity": 4
    },
    {
      "ingredient_id": "brioche-hot-dog-buns",
      "item": "brioche hot dog buns",
      "quantity": 4
    },
    {
      "ingredient_id": "a-drizzle-of-buffalo-hot-sauce",
      "item": "a drizzle of buffalo hot sauce"
    },
    {
      "ingredient_id": "crispy-fried-onions",
      "item": "crispy fried onions",
      "quantity": 2,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the blue cheese, soured cream, and mayonnaise until smooth, then fold in the finely chopped celery."
    },
    {
      "step": 2,
      "text": "Cook the sausages until browned and heated through; verify that the center reaches 160°F with a food thermometer."
    },
    {
      "step": 3,
      "text": "Place the sausages in the brioche buns and spoon over the blue cheese mixture."
    },
    {
      "step": 4,
      "text": "Finish each hot dog with a drizzle of buffalo hot sauce and the crispy fried onions."
    }
  ],
