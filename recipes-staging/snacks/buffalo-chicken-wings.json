  "id": "buffalo-chicken-wings",
  "name": "Buffalo Chicken Wings",
  "subtitle": "Crisp fried wings with a tangy hot sauce glaze",
  "description": "Chicken wings are fried until crisp, then coated in a buttery vinegar-and-hot-pepper sauce.",
  "meal_type": "snack",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil-for-deep-frying",
      "item": "vegetable oil for deep frying",
      "quantity": 1,
      "unit": "quart"
    },
    {
      "ingredient_id": "chicken-wings",
      "item": "chicken wings",
      "quantity": 24,
      "preparation": "tips removed and wings cut in half at joint"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "hot-pepper-sauce",
      "item": "hot pepper sauce",
      "quantity": 5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil to 375°F in a deep, heavy pot. Fry the chicken wings in batches for about 10 minutes, until browned and the thickest pieces reach 165°F internally.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Transfer the wings to a rack or paper towels to drain."
    },
    {
      "step": 3,
      "text": "Melt the butter in a saucepan. Stir in the vinegar, hot pepper sauce, and salt and pepper; bring the sauce to a brief simmer."
    },
    {
      "step": 4,
      "text": "Add the fried wings and toss until evenly coated. Serve hot."
    }
  ],
