  "id": "buffalo-chicken-wontons",
  "name": "Buffalo Chicken Wontons",
  "subtitle": "Crisp wonton parcels with spicy chicken and cheddar",
  "description": "Shredded chicken, cheddar, ranch, butter, and hot pepper sauce fill wonton wrappers for a crisp, savory snack.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying"
    },
    {
      "ingredient_id": "chicken",
      "item": "chicken",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded cooked"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "ranch-dressing",
      "item": "ranch dressing",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "melted"
    },
    {
      "ingredient_id": "hot-pepper-sauce",
      "item": "hot pepper sauce",
      "quantity": 1.5,
      "unit": "teaspoons",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "wonton-wrappers",
      "item": "wonton wrappers",
      "quantity": 20
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil to 350°F in a deep skillet or fryer."
    },
    {
      "step": 2,
      "text": "Mix the chicken, cheddar, ranch dressing, melted butter, and hot pepper sauce until evenly combined."
    },
    {
      "step": 3,
      "text": "Place a portion of filling in each wonton wrapper. Moisten the edges, fold the wrappers over the filling, and press to seal."
    },
    {
      "step": 4,
      "text": "Fry the wontons in batches for about 3 minutes per batch, turning as needed, until golden brown and crisp.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Transfer the cooked wontons to a lined plate or rack to drain. Serve hot."
    }
  ],
