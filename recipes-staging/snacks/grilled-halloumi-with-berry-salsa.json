  "instructions": [
    {
      "step": 1,
      "text": "Combine the blueberries and red currants with the marjoram, habanero, olive oil, agave syrup, the juice of one lime, and half of the mint and cilantro. Stir until evenly mixed."
    },
    {
      "step": 2,
      "text": "Preheat the cooking surface. Toast the cashews for about 10 minutes, then transfer them to a board or plate to cool.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Place the halloumi slices on the hot surface and cook for about 3 minutes, turning as needed, until golden brown.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Roughly chop the cooled cashews and arrange them with the grilled halloumi. Spoon over the berry salsa, then finish with the remaining mint, cilantro, and lime wedges from the divided limes."
    },
    {
      "step": 5,
      "text": "Serve immediately."
    }
  ],
