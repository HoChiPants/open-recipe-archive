      "item": "fresh blueberries",
      "quantity": 4,
      "unit": "ounces"
    },
    {
      "ingredient_id": "red-currants",
      "item": "red currants",
      "quantity": 3,
      "unit": "ounces"
    },
    {
      "ingredient_id": "fresh-mint",
      "item": "fresh mint",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "chopped, divided"
    },
    {
