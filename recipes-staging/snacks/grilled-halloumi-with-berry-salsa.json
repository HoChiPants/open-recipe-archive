  "id": "grilled-halloumi-with-berry-salsa",
  "name": "Grilled Halloumi with Berry Salsa",
  "subtitle": "Salty grilled cheese with bright berries and herbs",
  "description": "A quick vegetarian snack pairing browned halloumi with a fresh, spicy berry salsa and toasted cashews.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
