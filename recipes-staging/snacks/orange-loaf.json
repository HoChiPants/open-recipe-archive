  "id": "orange-loaf",
  "name": "Orange Loaf",
  "subtitle": "Tender citrus loaf with a simple orange glaze",
  "description": "A lightly nutty loaf flavored with fresh orange juice and zest, finished with a sweet citrus glaze.",
  "meal_type": "snack",
  "cuisine": "American",
