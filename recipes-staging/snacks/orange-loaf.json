  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a loaf pan for baking."
    },
    {
      "step": 2,
      "text": "Stir together the flour, baking powder, salt, and chopped walnuts."
    },
    {
      "step": 3,
      "text": "Whisk the margarine and 1 cup sugar until blended, then whisk in the eggs one at a time."
    },
    {
      "step": 4,
      "text": "Stir in the fresh orange juice and grated orange zest. Add the flour mixture and mix just until combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 60 minutes, until the loaf is set and a tester comes out clean.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Combine the orange juice, ¼ cup sugar, and grated orange zest in a small saucepan. Warm until the sugar dissolves, then set aside."
    },
    {
      "step": 7,
      "text": "Pour the orange mixture over the warm loaf and let it cool for 10 minutes before slicing.",
      "timer_minutes": 10
    }
  ],
