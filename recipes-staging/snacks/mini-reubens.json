  "id": "mini-reubens",
  "name": "Mini Reubens",
  "subtitle": "Open-faced rye bites with corned beef, sauerkraut, and melted Swiss",
  "description": "Assemble cocktail rye with dressing, corned beef, sauerkraut, and Swiss cheese, then grill until the cheese is melted.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
