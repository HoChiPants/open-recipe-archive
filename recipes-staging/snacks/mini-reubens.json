    "prep_minutes": 15,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "1-pound-loaf-cocktail-rye-bread",
      "item": "(1 pound) loaf cocktail rye bread",
      "quantity": 1
    },
    {
      "ingredient_id": "thousand-island-dressing",
      "item": "thousand island dressing",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "deli-sliced-corned-beef",
      "item": "deli sliced corned beef",
      "quantity": 1.5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "16-ounce-jar-sauerkraut",
      "item": "(16 ounce) jar sauerkraut",
      "quantity": 1,
      "preparation": "rinsed and well drained"
    },
    {
      "ingredient_id": "swiss-cheese",
      "item": "Swiss cheese",
      "quantity": 1,
      "unit": "pound",
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Arrange the cocktail rye bread on a grill-safe tray or work surface."
    },
    {
      "step": 2,
      "text": "Spread the dressing over the bread and top with corned beef. Add the rinsed, drained sauerkraut and sliced Swiss cheese, then fold or arrange the bread into small sandwiches."
    },
    {
      "step": 3,
      "text": "Grill for 5 minutes, or until the Swiss cheese is melted.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Serve warm."
    }
  ],
