  "instructions": [
    {
      "step": 1,
      "text": "Wash the cucumbers and trim them as desired. Place them in a clean refrigerator-safe container with the chopped dill, garlic, pickling spice, dill seed, red pepper flakes, and fresh dill sprigs."
    },
    {
      "step": 2,
      "text": "Whisk the water, vinegar, sugar, and coarse salt in a separate bowl until the sugar and salt dissolve. Let the mixture stand for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Pour the seasoned liquid over the cucumbers, ensuring they are covered. Seal the container and refrigerate for about 10 days before serving.",
      "timer_minutes": 14400
    },
    {
      "step": 4,
      "text": "Keep the pickles refrigerated."
    }
  ],
