  "id": "chilli-fennel-frosted-nuts",
  "name": "Chilli-Fennel Frosted Nuts",
  "subtitle": "Sweet, spicy, and crisp",
  "description": "A crunchy nut snack coated with caramelized sugar, fennel, chilli, and flaky sea salt.",
  "meal_type": "snack",
  "yield": {
    "quantity": 6,
    "unit": "(3 gift bags)"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 600,
      "unit": "g"
    },
    {
      "ingredient_id": "fennel-seeds",
      "item": "fennel seeds",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "dried-chilli-flakes-optional",
      "item": "dried chilli flakes",
      "quantity": "1 1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "mixed-nuts-we-used-a-mix-of-brazils",
      "item": "mixed nuts (we used a mix of brazils",
      "quantity": 350,
      "unit": "g",
      "preparation": "macadamias, pecans, pistachios and walnuts)"
    },
    {
      "ingredient_id": "flaky-sea-salt",
      "item": "flaky sea salt",
      "quantity": "1 1/2",
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm a large heavy saucepan over medium heat. Add the caster sugar and let it melt, watching closely so it does not scorch."
    },
    {
      "step": 2,
      "text": "Stir in the fennel seeds and dried chilli flakes, then add the mixed nuts and flaky sea salt. Toss until the nuts are evenly coated.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Spread the coated nuts in a single layer on a lined tray and leave them to cool completely before breaking apart."
    }
  ],
