  "id": "popcorn-chicken",
  "name": "Popcorn Chicken",
  "subtitle": "Crispy bite-size chicken with a lemon-seasoned coating",
  "description": "Small pieces of chicken are coated in seasoned flour, dipped in lemony egg, coated again, and sautéed until crisp and fully cooked.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
