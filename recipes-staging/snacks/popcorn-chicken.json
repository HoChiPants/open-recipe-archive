      "item": "lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "oil",
      "item": "oil",
      "quantity": 2,
      "unit": "cups",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 3,
      "preparation": "boneless chicken breasts, cubed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, garlic powder, salt, and black pepper in a shallow bowl."
    },
    {
      "step": 2,
      "text": "Whisk the eggs and lemon juice together in a second shallow bowl."
    },
    {
      "step": 3,
      "text": "Preheat a large skillet and add the oil."
    },
    {
      "step": 4,
      "text": "Coat each chicken cube in the seasoned flour, dip it in the egg mixture, then coat it again with flour."
    },
    {
      "step": 5,
      "text": "Place the coated chicken in the hot oil without crowding the skillet."
    },
    {
      "step": 6,
      "text": "Sauté, turning as needed, for about 8 minutes, until golden brown and the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 8
    },
    {
      "step": 7,
      "text": "Transfer the chicken to a serving plate and prepare the remaining pieces in batches if needed."
    }
  ],
