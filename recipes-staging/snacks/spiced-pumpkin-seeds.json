{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "spiced-pumpkin-seeds",
  "name": "Spiced Pumpkin Seeds",
  "subtitle": "Crisp, savory roasted seeds",
  "description": "Pumpkin seeds coated with buttery margarine, savory seasonings, and Worcestershire sauce, then slowly baked until crisp.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 1.5,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "raw-whole-pumpkin-seeds",
      "item": "raw whole pumpkin seeds",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 275°F."
    },
    {
      "step": 2,
      "text": "In a bowl, stir together the melted margarine, salt, garlic salt, and Worcestershire sauce. Add the pumpkin seeds and toss until evenly coated."
    },
    {
      "step": 3,
      "text": "Spread the seasoned seeds in an even layer on a baking sheet."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, stirring once or twice, until crisp and lightly browned.",
      "timer_minutes": 60
    }
  ],
