{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "creamed-salmon-on-toast",
  "name": "Creamed Salmon on Toast",
  "subtitle": "A warm salmon and pea cream sauce for serving over toast.",
  "description": "Make a simple white sauce with peas, fold in flaked salmon, and heat until safely hot before serving on toast.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cold-milk",
      "item": "cold milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "canned-green-peas",
      "item": "canned green peas",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce, drained, liquid reserved"
    },
    {
      "ingredient_id": "salmon",
      "item": "salmon",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.75 ounce"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Whisk in the flour and cook until smooth."
    },
    {
      "step": 3,
      "text": "Gradually whisk in the cold milk and reserved pea liquid until smooth, then add the peas."
    },
    {
      "step": 4,
      "text": "Drain and flake the salmon, removing any skin or bones as desired."
    },
    {
      "step": 5,
      "text": "Stir the salmon into the sauce and cook until heated through, opaque, and easily flaked, reaching 145°F on a food thermometer."
    },
    {
      "step": 6,
      "text": "Season with salt and pepper, then spoon over toast and serve."
    }
  ],
