{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "thai-chicken-balls",
  "name": "Thai Chicken Balls",
  "subtitle": "Cilantro and sweet chili chicken bites",
  "description": "Seasoned chicken balls with cilantro, green onion, coriander, lemon, and sweet chili sauce, fried until fully cooked.",
  "meal_type": "snack",
  "cuisine": "Thai",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "ground-chicken",
      "item": "ground chicken",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 4,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "ground-coriander-seed",
      "item": "ground coriander seed",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "fresh-cilantro",
      "item": "fresh cilantro",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "sweet-chili-sauce",
      "item": "sweet chili sauce",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "oil-for-frying",
      "item": "oil for frying"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the ground chicken and bread crumbs in a large bowl. Add the green onions, coriander, cilantro, sweet chili sauce, and lemon juice; combine thoroughly."
    },
    {
      "step": 2,
      "text": "Shape the mixture into evenly sized balls."
    },
    {
      "step": 3,
      "text": "Preheat a skillet over medium heat and add enough oil for frying."
    },
    {
      "step": 4,
      "text": "Fry the chicken balls in batches, turning as needed, until browned and the centers reach 165°F on a food thermometer."
    }
  ],
