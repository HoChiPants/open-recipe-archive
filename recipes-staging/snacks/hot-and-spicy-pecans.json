      "item": "chili powder",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Stir together the melted butter, Worcestershire sauce, ground red pepper, salt, garlic powder, and chili powder."
    },
    {
      "step": 3,
      "text": "Add the pecan halves and stir until evenly coated."
    },
    {
      "step": 4,
      "text": "Spread the seasoned pecans on a baking sheet."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes.",
      "timer_minutes": 10
    }
