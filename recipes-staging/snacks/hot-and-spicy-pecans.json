  "id": "hot-and-spicy-pecans",
  "name": "Hot and Spicy Pecans",
  "subtitle": "Crisp roasted pecans with savory heat",
  "description": "Pecan halves are coated in buttery Worcestershire seasoning and baked until crisp for a spicy snack.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
