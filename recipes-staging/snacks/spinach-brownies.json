  "id": "spinach-brownies",
  "name": "Spinach Brownies",
  "subtitle": "Savory spinach squares with mozzarella",
  "description": "A tender, cheesy spinach bake cut into easy-to-serve squares for snacks or appetizers.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
