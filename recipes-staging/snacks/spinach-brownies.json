  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Prepare the baking powder as directed in the recipe workflow, and set it aside with the dry ingredients."
    },
    {
      "step": 2,
      "text": "Transfer the chopped spinach to a pan and simmer briefly, then let it cook for 3 minutes as needed to soften. Drain any excess liquid.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Combine the flour, salt, and baking powder in a bowl. In a separate bowl, stir together the eggs, milk, and melted butter."
    },
    {
      "step": 4,
      "text": "Mix the spinach, onion, and mozzarella into the egg mixture, then fold in the dry ingredients until evenly combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a prepared baking pan and bake for 35 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Cool before cutting into squares and serving."
    }
  ],
