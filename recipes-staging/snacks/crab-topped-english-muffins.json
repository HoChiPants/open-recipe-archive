  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill or broiler."
    },
    {
      "step": 2,
      "text": "Blend the softened margarine with the cheese spread until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the crabmeat, mayonnaise, garlic powder, and dried parsley."
    },
    {
      "step": 4,
      "text": "Spread the crab mixture over the split English muffins and arrange them on a grill-safe pan."
    },
    {
      "step": 5,
      "text": "Grill until the topping is hot and lightly browned, about 10 minutes.",
      "timer_minutes": 10
    }
