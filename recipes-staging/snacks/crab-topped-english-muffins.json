  "id": "crab-topped-english-muffins",
  "name": "Crab-Topped English Muffins",
  "subtitle": "Creamy crab spread on crisp muffin halves",
  "description": "A savory crab and cheese spread is mixed with herbs, portioned onto English muffin halves, and grilled until hot and lightly browned.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
