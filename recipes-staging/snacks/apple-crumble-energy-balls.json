{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "apple-crumble-energy-balls",
  "name": "Apple Crumble Energy Balls",
  "subtitle": "No-bake bites with apple, dates, and cinnamon",
  "description": "Blend a handful of simple ingredients into chewy apple-flavored snack balls, then chill until firm.",
  "meal_type": "snack",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "rolled-oats",
      "item": "oats",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "dates-about-3",
      "item": "dates (about 3)",
      "quantity": 50,
      "unit": "g",
      "preparation": "pitted"
    },
    {
      "ingredient_id": "ground-almonds",
      "item": "ground almonds",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "almond-butter",
      "item": "almond butter",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "cinnamon-plus-extra-for-dusting",
      "item": "cinnamon plus extra for dusting",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "dried-apple-slices",
      "item": "dried apple slices",
      "quantity": 30,
      "unit": "g"
    },
    {
      "ingredient_id": "apple",
      "item": "apple",
      "quantity": "1/2"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Process the dates, ground almonds, almond butter, cinnamon, and apple until the mixture is cohesive."
    },
    {
      "step": 2,
      "text": "Add the oats and dried apple slices, then pulse or stir until evenly combined."
    },
    {
      "step": 3,
      "text": "Roll the mixture into 10 balls and dust them with the extra cinnamon."
    },
    {
      "step": 4,
      "text": "Chill until firm.",
      "timer_minutes": 30
    }
  ],
