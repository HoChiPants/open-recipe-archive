{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "air-fried-kale-chips",
  "name": "Air-Fried Kale Chips",
  "subtitle": "Crisp, seasoned kale made in the air fryer.",
  "description": "A simple savory snack of kale leaves cooked in batches until crisp.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "kale-leaves",
      "item": "kale leaves",
      "quantity": 6,
      "unit": "ounces"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 360°F. Place the kale leaves in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the olive oil, kosher salt, paprika, garlic powder, ground black pepper, and cayenne pepper; toss until the leaves are evenly coated."
    },
    {
      "step": 3,
      "text": "Arrange the kale in a single, loose layer in the air-fryer basket, working in batches as needed."
    },
    {
      "step": 4,
      "text": "Air-fry until the leaves are crisp, about 3 minutes per batch. Transfer to a bowl and repeat with the remaining kale.",
      "timer_minutes": 3
    }
  ],
