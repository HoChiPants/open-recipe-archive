  "id": "rosemary-roasted-cashews",
  "name": "Rosemary Roasted Cashews",
  "subtitle": "Savory, lightly sweet, and warmly spiced",
  "description": "Roasted cashews tossed with fresh rosemary, brown sugar, salt, and cayenne for a crisp, flavorful snack.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-cashews",
      "item": "unsalted cashews",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "coarsely-chopped-fresh-rosemary",
      "item": "coarsely chopped fresh rosemary",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "melted"
    },
    {
      "ingredient_id": "dark-brown-sugar",
      "item": "dark brown sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-cayenne-pepper",
      "item": "ground cayenne pepper",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Spread the cashews in a single layer on a baking sheet."
    },
    {
      "step": 2,
      "text": "Bake the cashews for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir together the rosemary, melted margarine, brown sugar, kosher salt, and cayenne pepper."
    },
    {
      "step": 4,
      "text": "Toss the hot cashews with the rosemary mixture until evenly coated, then let cool before serving."
    }
  ],
