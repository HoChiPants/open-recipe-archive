  "id": "bite-sized-salmon-tikka",
  "name": "Bite-Sized Salmon Tikka",
  "subtitle": "Spiced salmon cubes with a crisp coating",
  "description": "Small salmon pieces seasoned with cayenne and turmeric, lightly coated in cornstarch, and fried until crisp and safely cooked.",
  "meal_type": "snack",
  "cuisine": "Indian",
  "yield": {
    "quantity": 2,
