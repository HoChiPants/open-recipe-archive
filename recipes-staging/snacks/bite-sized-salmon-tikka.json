  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the cayenne, turmeric, and salt together, then toss the salmon cubes in the seasoning until evenly coated."
    },
    {
      "step": 2,
      "text": "Let the seasoned salmon stand for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Heat the frying oil in a suitable pan over medium-high heat."
    },
    {
      "step": 4,
      "text": "Dust the salmon with cornstarch and turn the pieces until lightly coated."
    },
    {
      "step": 5,
      "text": "Fry the salmon, turning as needed, until golden brown and the thickest piece reaches 145°F, or is opaque and flakes easily.",
      "timer_minutes": 1
    }
  ],
