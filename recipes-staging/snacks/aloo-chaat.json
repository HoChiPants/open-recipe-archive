  "instructions": [
    {
      "step": 1,
      "text": "Cut the potatoes into bite-size pieces. Add them to a pot of water, bring to a boil, and cook until tender. Drain well and chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Mix the onion, ginger, green chillies, cumin, chaat masala, Kashmiri chilli powder, and black peppercorns. Stir in the lemon juice and let the mixture stand while the potatoes chill."
    },
    {
      "step": 3,
      "text": "Preheat the sunflower oil for deep frying. Fry the chilled potatoes until crisp and golden, then drain thoroughly."
    },
    {
      "step": 4,
      "text": "Toss the fried potatoes with the onion mixture and Kashmiri chilli powder. Add the coriander relish, date and tamarind sauce, chopped coriander, and pomegranate seeds."
    },
    {
      "step": 5,
      "text": "Serve immediately."
    }
  ],
