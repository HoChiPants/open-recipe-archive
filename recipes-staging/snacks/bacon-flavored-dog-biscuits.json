  "id": "bacon-flavored-dog-biscuits",
  "name": "Bacon-Flavored Dog Biscuits",
  "subtitle": "Crisp homemade treats with whole wheat and bacon fat",
  "description": "A simple baked dog treat made from whole wheat flour, eggs, milk, and melted bacon fat.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "bacon-fat",
      "item": "bacon fat",
      "quantity": 10,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "whole-wheat-flour",
      "item": "whole wheat flour",
      "quantity": 5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking sheet for the biscuits."
    },
    {
      "step": 2,
      "text": "Whisk the eggs in a mixing bowl. Stir in the milk, water, salt, and melted bacon fat."
    },
    {
      "step": 3,
      "text": "Add the whole wheat flour and stir until a firm dough forms."
    },
    {
      "step": 4,
      "text": "Shape the dough into about 25 biscuits and transfer them to the prepared baking sheet."
    },
    {
      "step": 5,
      "text": "Bake for 40 minutes, until the biscuits are firm and lightly browned.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Cool the biscuits completely before serving."
    },
    {
      "step": 7,
      "text": "Prepare the cooled biscuits for storage or serving."
    }
  ],
