  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Transfer the refrigerated pizza crust dough to a baking surface and spread or shape it as needed."
    },
    {
      "step": 3,
      "text": "Layer the provolone and Gorgonzola over the dough, then arrange the pear slices and sprinkle with the walnuts."
    },
    {
      "step": 4,
      "text": "Bake for 10 minutes, or until the cheeses are melted and the crust is cooked through.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Remove the pizza from the oven and let it rest briefly while preparing to serve."
    },
    {
      "step": 6,
      "text": "Cut into portions and finish with the chopped fresh chives."
    }
