  "id": "pear-and-gorgonzola-pizza",
  "name": "Pear and Gorgonzola Pizza",
  "subtitle": "A crisp, cheesy pizza topped with pear and walnuts",
  "description": "Pizza crust layered with provolone, pear, Gorgonzola, walnuts, and chives for a savory-sweet Italian-inspired snack.",
  "meal_type": "snack",
