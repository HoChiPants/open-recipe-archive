  "id": "air-fryer-potato-crisps",
  "name": "Air Fryer Potato Crisps",
  "subtitle": "Thin, crisp potatoes with spiced seasoning and dip",
  "description": "Slice potatoes thinly, coat them with oil and seasoning, and air-fry in a single layer until crisp. Serve with dip.",
  "meal_type": "snack",
  "cuisine": "French",
  "yield": {
    "quantity": 4,
    "unit": "as a snack"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 12
  },
  "ingredients": [
    {
      "ingredient_id": "potatoes-about-450g-in-total",
      "item": "potatoes (about 450g in total)",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "cajun-style-spice-mix-or-seasoning-of-your-choice",
      "item": "Cajun-style spice mix or seasoning of your choice",
      "quantity": "1-2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "soured-cream-onion-dip-or-dip-of-your-choice",
      "item": "soured cream & onion dip or dip of your choice",
      "preparation": "to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the potatoes into very thin slices. Rinse or soak them briefly, then drain and dry thoroughly."
    },
    {
      "step": 2,
      "text": "Preheat the air fryer according to the appliance instructions."
    },
    {
      "step": 3,
      "text": "Toss the potato slices with the oil and seasoning."
    },
    {
      "step": 4,
      "text": "Arrange the potatoes in a single layer in the air-fryer basket, working in batches if needed."
    },
    {
      "step": 5,
      "text": "Air-fry for 12 minutes, shaking or turning as needed, until crisp.",
      "timer_minutes": 12
    },
    {
      "step": 6,
      "text": "Serve the crisps with the dip."
    }
  ],
