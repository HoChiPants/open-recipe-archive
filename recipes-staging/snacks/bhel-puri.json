  "instructions": [
    {
      "step": 1,
      "text": "Boil the cubed potato and both portions of salted peanuts for 9 minutes, until the potato is tender. Drain well.",
      "timer_minutes": 9
    },
    {
      "step": 2,
      "text": "Blend the roughly chopped coriander, mint, garlic, ginger, lemon juice, caster sugar, green chillies, and salted peanuts until smooth."
    },
    {
      "step": 3,
      "text": "Place the crisped rice cereal, bombay mix, chopped onion, cucumber, chopped green chilli, chopped peanuts, small handful of coriander, and chaat masala in a bowl."
    },
    {
      "step": 4,
      "text": "Add the boiled potato, smooth chutney, tamarind chutney plus 1 tsp, lime juice, and mustard oil if using. Toss gently until evenly coated."
    },
    {
      "step": 5,
      "text": "Fold in the large handful of roughly chopped coriander and serve immediately while crisp."
    }
  ],
