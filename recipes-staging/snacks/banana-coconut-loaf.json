  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a loaf pan."
    },
    {
      "step": 2,
      "text": "Whisk the eggs in a mixing bowl. Add the sugar and melted butter, then whisk until combined."
    },
    {
      "step": 3,
      "text": "Stir in the mashed bananas and almond extract."
    },
    {
      "step": 4,
      "text": "In a separate bowl, combine the flour, coconut, baking powder, baking soda, salt, walnuts, and cherries."
    },
    {
      "step": 5,
      "text": "Add the dry mixture to the banana mixture and stir just until combined."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and bake for 60 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Let the loaf rest for 10 minutes, then cool before slicing.",
      "timer_minutes": 10
    }
  ],
