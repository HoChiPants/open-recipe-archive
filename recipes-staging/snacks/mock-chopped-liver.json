      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, lentils, and bouillon cubes in a saucepan. Bring to a simmer and cook for 30 minutes, until the lentils are tender. If the bouillon contains uncooked poultry, verify the mixture reaches 165°F.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Drain the lentils thoroughly."
    },
    {
      "step": 3,
      "text": "Warm the olive oil in a skillet and cook the chopped onion until softened and lightly browned."
    },
    {
      "step": 4,
      "text": "Blend the lentils, onion, and walnuts until nearly smooth. Season with salt and pepper to taste."
    },
    {
      "step": 5,
      "text": "Cover and chill for at least 2 hours before serving.",
      "timer_minutes": 120
    }
  ],
