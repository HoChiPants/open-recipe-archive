  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "lentil",
      "item": "lentils",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cubes-chicken-bouillon",
      "item": "cubes chicken bouillon",
      "quantity": 2
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra virgin olive oil",
      "quantity": 1,
      "unit": "teaspoon"
