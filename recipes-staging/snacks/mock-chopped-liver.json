  "id": "mock-chopped-liver",
  "name": "Mock Chopped Liver",
  "subtitle": "A chilled lentil and walnut spread",
  "description": "Tender lentils, browned onion, and walnuts blend into a savory spread for serving chilled.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
