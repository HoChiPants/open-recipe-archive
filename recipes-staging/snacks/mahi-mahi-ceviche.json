  "instructions": [
    {
      "step": 1,
      "text": "Stir the diced mahi mahi with the lime juice, lemon juice, minced jalapeno, salt, oregano, and cayenne pepper."
    },
    {
      "step": 2,
      "text": "Cover and refrigerate for 60 minutes. Citrus marination does not make raw fish fully safe; use properly handled fish, or cook it to 145°F before serving if required.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Stir in the cucumber, orange segments, chives, cilantro, and olive oil."
    },
    {
      "step": 4,
      "text": "Taste and adjust the salt as needed, then serve chilled."
    }
