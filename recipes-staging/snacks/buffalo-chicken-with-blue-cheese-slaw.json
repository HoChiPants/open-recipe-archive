  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and arrange the chicken thighs in a roasting pan. Roast until browned and nearly cooked through, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 2,
      "text": "While the chicken roasts, combine the hot sauce, smoked paprika, brown sugar, vinegar, garlic powder, and cubed butter in a saucepan. Heat gently for 1 minute, until the butter melts.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Transfer the roasted chicken to the saucepan and coat it with the sauce. Cook for 20 minutes, turning occasionally, until the thickest part reaches 165°F.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Add the remaining hot sauce mixture as directed and cook for 5 minutes, allowing it to coat the chicken.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Mix the blue cheese, soured cream, mayonnaise, chives, and lemon juice. Fold in the apple, celery, white cabbage, and pointed spring cabbage."
    },
    {
      "step": 6,
      "text": "Serve the buffalo chicken with the blue cheese slaw."
    }
  ],
