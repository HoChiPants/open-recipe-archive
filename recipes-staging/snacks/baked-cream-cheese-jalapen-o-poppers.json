{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "baked-cream-cheese-jalapen-o-poppers",
  "name": "Baked Cream Cheese Jalapeño Poppers",
  "subtitle": "Cheesy stuffed peppers with a crisp breadcrumb topping",
  "description": "Halved jalapeños are filled with seasoned cream cheese and Cheddar, topped with breadcrumbs, and baked until tender.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "softened"
    },
    {
      "ingredient_id": "finely-shredded-cheddar-cheese",
      "item": "finely shredded Cheddar cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "taco-seasoning-mix",
      "item": "taco seasoning mix",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "jalapeno-peppers",
      "item": "jalapeno peppers",
      "quantity": 12,
      "unit": "medium",
      "preparation": "halved lengthwise and seeded"
    },
    {
      "ingredient_id": "fine-bread-crumbs",
      "item": "fine bread crumbs",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Stir the softened cream cheese, Cheddar, and taco seasoning together until evenly combined."
    },
    {
      "step": 3,
      "text": "Arrange the seeded jalapeño halves on a baking sheet and fill each with the cheese mixture."
    },
    {
      "step": 4,
      "text": "Sprinkle the filled peppers with fine breadcrumbs."
    },
    {
      "step": 5,
      "text": "Bake for about 20 minutes, or up to 30 minutes as needed, until the peppers are tender.",
      "timer_minutes": 20
    }
  ],
