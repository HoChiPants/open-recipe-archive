  "instructions": [
    {
      "step": 1,
      "text": "Place the shrimp and scallops in a nonreactive bowl and cover with the lime and lemon juices. Refrigerate until the seafood is opaque, about 60 minutes; citrus does not eliminate all raw-seafood risks, so use seafood handled for raw consumption.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Fold in the onion, cucumber, tomato, jalapeno, serrano, and cilantro. Add the olive oil, kosher salt, and black pepper, then mix gently."
    },
    {
      "step": 3,
      "text": "Keep chilled and serve promptly."
    }
