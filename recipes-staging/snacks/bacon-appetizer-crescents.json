  "id": "bacon-appetizer-crescents",
  "name": "Bacon Appetizer Crescents",
  "subtitle": "Crisp crescent rolls with a savory bacon-cheese filling",
  "description": "Softened cream cheese, bacon, Parmesan, onion, parsley, and milk fill refrigerated crescent dough for a warm, golden snack.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "philadelphia-cream-cheese",
      "item": "PHILADELPHIA Cream Cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "slices-oscar-mayer-bacon",
      "item": "slices OSCAR MAYER Bacon",
      "quantity": 8,
      "preparation": "cooked, crumbled"
    },
    {
      "ingredient_id": "kraft-grated-parmesan-cheese",
      "item": "KRAFT Grated Parmesan Cheese",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "finely-chopped-onions",
      "item": "finely chopped onions",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "refrigerated-crescent-dinner-rolls",
      "item": "refrigerated crescent dinner rolls",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the softened cream cheese, Parmesan, and milk until smooth. Stir in the crumbled bacon, onions, and parsley."
    },
    {
      "step": 3,
      "text": "Unroll the crescent dough and separate it into triangles. Spread the filling over the triangles, then roll each one from the wide end to the point."
    },
    {
      "step": 4,
      "text": "Chill the shaped crescents for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Arrange the crescents on a baking sheet and bake until golden brown, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Serve warm."
    }
  ],
