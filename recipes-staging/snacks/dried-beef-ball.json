  "ingredients": [
    {
      "ingredient_id": "dried-beef",
      "item": "dried beef",
      "quantity": 5,
      "unit": "ounces",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
