  "id": "dried-beef-ball",
  "name": "Dried Beef Ball",
  "subtitle": "A savory, shareable cheese snack",
  "description": "Cream cheese, chopped dried beef, green onions, and savory seasonings formed into a simple party snack.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
