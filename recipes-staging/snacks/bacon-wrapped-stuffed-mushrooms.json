  "id": "bacon-wrapped-stuffed-mushrooms",
  "name": "Bacon-Wrapped Stuffed Mushrooms",
  "subtitle": "Creamy mushroom bites with crisp bacon",
  "description": "Mushrooms are filled with seasoned cream cheese and green onions, wrapped in bacon, and baked until cooked through.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "fresh-mushrooms",
      "item": "fresh mushrooms",
      "quantity": 20,
      "preparation": "stems removed"
    },
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "pound",
      "preparation": "sliced, cut in half"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the chopped green onions into the softened cream cheese."
    },
    {
      "step": 3,
      "text": "Fill each mushroom cap with the cream cheese mixture."
    },
    {
      "step": 4,
      "text": "Wrap each filled mushroom with half a bacon slice and arrange the mushrooms in a baking dish."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, until the bacon is cooked through.",
      "timer_minutes": 20
    }
  ],
