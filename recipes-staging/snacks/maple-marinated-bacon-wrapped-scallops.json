{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "maple-marinated-bacon-wrapped-scallops",
  "name": "Maple-Marinated Bacon-Wrapped Scallops",
  "subtitle": "Sweet, savory scallop bites for serving",
  "description": "Scallops are marinated in maple-soy dressing, wrapped with bacon, and baked until opaque and safely cooked.",
  "meal_type": "snack",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "low-sodium-soy-sauce",
      "item": "low sodium soy sauce",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sea-scallops",
      "item": "sea scallops",
      "quantity": 12,
      "unit": "large",
      "preparation": "halved"
    },
    {
      "ingredient_id": "slices-smoked-bacon",
      "item": "slices smoked bacon",
      "quantity": 12,
      "preparation": "halved"
    },
    {
      "ingredient_id": "toothpicks",
      "item": "toothpicks",
      "quantity": 24
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the maple syrup, soy sauce, and Dijon mustard in a bowl. Add the scallops and coat evenly. Cover and marinate for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 3,
      "text": "Arrange the halved bacon slices in a single layer and bake for 8 minutes. Drain, then let them cool enough to handle.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Wrap each scallop half with a piece of bacon and secure it with a toothpick. Transfer the wrapped scallops to a baking sheet."
    },
    {
      "step": 5,
      "text": "Sprinkle with the brown sugar and bake for 15 minutes, until the scallops are opaque and reach 145°F internally.",
      "timer_minutes": 15
    }
  ],
