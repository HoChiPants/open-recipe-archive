  "id": "white-chocolate-snack-mix",
  "name": "White Chocolate Snack Mix",
  "subtitle": "A crisp, sweet-and-salty party snack",
  "description": "Pretzels, cereals, peanuts, and candy pieces are coated in smooth white chocolate for an easy batch snack.",
  "meal_type": "snack",
