  "id": "finnish-nissua",
  "name": "Finnish Nissua",
  "subtitle": "Soft cardamom bread with sweet vanilla icing",
  "description": "A tender, lightly spiced yeast bread shaped for sharing and finished with a simple vanilla icing.",
