  "instructions": [
    {
      "step": 1,
      "text": "Heat the 2 cups milk until hot. Stir in the margarine, white sugar, salt, and confectioners' sugar until the margarine melts. Cool until lukewarm."
    },
    {
      "step": 2,
      "text": "Stir the yeast into the warm water and let it stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Transfer the cooled milk mixture to a large bowl. Whisk in the yeast mixture, eggs, cardamom, and enough bread flour to form a soft dough."
    },
    {
      "step": 4,
      "text": "Let the dough rest for 30 minutes, then stir in the remaining flour. Knead for 8 minutes, until smooth.",
      "timer_minutes": 38
    },
    {
      "step": 5,
      "text": "Coat the dough lightly, cover it, and let it rise for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Prepare the dough, divide it as desired, and shape it into loaves or rolls. Let the shaped dough rest before baking."
    },
    {
      "step": 7,
      "text": "Let the shaped dough rise for 40 minutes. Meanwhile, preheat the oven to 350°F.",
      "timer_minutes": 40
    },
    {
      "step": 8,
      "text": "Bake for 30 minutes, until golden brown. Cool completely.",
      "timer_minutes": 30
    },
    {
      "step": 9,
      "text": "Combine the softened butter and confectioners' sugar. Stir in the 2 teaspoons milk and vanilla extract, then spread or drizzle the icing over the cooled bread."
    }
  ],
