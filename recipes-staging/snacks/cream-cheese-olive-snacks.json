  "instructions": [
    {
      "step": 1,
      "text": "Cut an opening lengthwise in each jumbo black olive, keeping the olive intact enough to hold its shape."
    },
    {
      "step": 2,
      "text": "Fill the opened olives with softened cream cheese."
    },
    {
      "step": 3,
      "text": "Cut the carrot into thick slices. Cut additional carrot pieces into small shapes for the beaks and feet."
    },
    {
      "step": 4,
      "text": "Arrange the stuffed olives with the small black olives and carrot pieces to form the penguin shapes."
    },
    {
      "step": 5,
      "text": "Chill briefly before serving.",
      "timer_minutes": 5
    }
