  "instructions": [
    {
      "step": 1,
      "text": "Heat the frying oil to 365°F in a deep, heavy pot. Preheat the oven to 200°F."
    },
    {
      "step": 2,
      "text": "Whisk the buttermilk, eggs, and 0.25 cup vegetable oil together in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the cornmeal, flour, sugar, baking soda, and salt."
    },
    {
      "step": 4,
      "text": "Fold the wet mixture and both minced onions into the dry ingredients just until combined."
    },
    {
      "step": 5,
      "text": "Drop spoonfuls of batter into the hot oil in batches, leaving room for them to move. Fry until golden brown, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Transfer the hush puppies to a lined rack or plate to drain, then place them in the warm oven while finishing the batches."
    },
    {
      "step": 7,
      "text": "Serve warm."
    }
  ],
