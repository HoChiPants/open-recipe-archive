  "id": "buttermilk-hush-puppies",
  "name": "Buttermilk Hush Puppies",
  "subtitle": "Crisp cornmeal bites with tender onion",
  "description": "Savory cornmeal fritters mixed with buttermilk, eggs, and minced onions, then fried until golden and kept warm for serving.",
  "meal_type": "snack",
  "cuisine": "Southern",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
