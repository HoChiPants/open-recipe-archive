  "instructions": [
    {
      "step": 1,
      "text": "Chop the tomatoes and peeled red onion. Stir them with the olive oil, lime juice, and optional chilli powder; set aside."
    },
    {
      "step": 2,
      "text": "Mix the drained black beans with the Cajun-style or fajita seasoning, lime juice, and optional coriander. Let the mixture stand while preparing the chips."
    },
    {
      "step": 3,
      "text": "Arrange the tortilla chips in an air-fryer-safe dish or basket. Spoon the seasoned beans over them, then scatter the grated cheddar and torn mozzarella on top."
    },
    {
      "step": 4,
      "text": "Air-fry at 350°F until the cheese is fully melted and lightly browned, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Top with the tomato and onion mixture and serve with the reserved lime juice."
    }
  ],
