  "id": "air-fryer-nachos",
  "name": "Air Fryer Nachos",
  "subtitle": "Crisp tortilla chips with beans, salsa, and melted cheese",
  "description": "Layer seasoned black beans and fresh tomato salsa over tortilla chips, then air-fry until the cheese is melted and bubbling.",
  "meal_type": "snack",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
