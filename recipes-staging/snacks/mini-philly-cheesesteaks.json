      "ingredient_id": "provolone-cheese",
      "item": "provolone cheese",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "shredded, or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Melt the butter in a saucepan, whisk in the flour, and season with salt and pepper. Gradually whisk in the cold milk; cook, whisking, until thickened, about 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 2,
      "text": "Stir in the 2 ounces of provolone, nutmeg, cayenne, and additional salt and pepper as needed. Continue stirring until the cheese melts, then set the sauce aside."
    },
    {
      "step": 3,
      "text": "Season the skirt steak with salt and pepper. Heat some of the olive oil in a skillet and cook the steak for about 7 minutes, turning as needed, until browned and a thermometer registers 145°F. Transfer it to a plate and rest for 3 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Add the water to the skillet and bring it to a simmer, scraping up any browned bits. Return the steak briefly to warm it, then let it cool enough to handle and cut it into small pieces."
    },
    {
      "step": 5,
      "text": "Heat the remaining olive oil in the skillet. Cook the onion and sweet peppers for about 5 minutes, stirring, until tender; season with salt and pepper.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Arrange the baguette slices on a baking sheet. Top them with steak, vegetables, the cheese sauce, and the remaining shredded provolone."
    },
    {
      "step": 7,
      "text": "Bake until the cheese is melted and the sandwiches are hot, about 15 minutes.",
      "timer_minutes": 15
    }
  ],
