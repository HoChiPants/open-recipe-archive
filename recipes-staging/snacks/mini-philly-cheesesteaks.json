  "id": "mini-philly-cheesesteaks",
  "name": "Mini Philly Cheesesteaks",
  "subtitle": "Skillet-seared steak and peppers on crisp baguette slices",
  "description": "Small open-faced steak sandwiches layered with sautéed vegetables, creamy provolone sauce, and melted cheese.",
  "meal_type": "snack",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
