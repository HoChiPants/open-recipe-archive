  "instructions": [
    {
      "step": 1,
      "text": "Spread the softened cream cheese evenly over one side of each bread slice."
    },
    {
      "step": 2,
      "text": "Toss the alfalfa sprouts with the olive oil and red wine vinegar."
    },
    {
      "step": 3,
      "text": "Layer the cucumber, tomato, lettuce, pepperoncini, and dressed sprouts on one slice of bread."
    },
    {
      "step": 4,
      "text": "Spread the mashed avocado over the other slice, place it avocado-side down, and cut the sandwich in half."
    },
    {
      "step": 5,
      "text": "Serve immediately."
    }
  ],
