  "id": "jalapen-o-popper-grilled-cheese-sandwich",
  "name": "Jalapeño Popper Grilled Cheese Sandwich",
  "subtitle": "Creamy, spicy grilled sandwiches with a crisp tortilla-chip layer",
  "description": "Softened cream cheese, sour cream, jalapeños, and shredded cheese fill buttery ciabatta rolls, with crushed tortilla chips adding crunch.",
  "meal_type": "sandwich",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "ounces",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "pickled-jalapeno-pepper-slices",
      "item": "pickled jalapeno pepper slices",
      "quantity": 10,
      "preparation": "or to taste - chopped"
    },
    {
      "ingredient_id": "ciabatta-sandwich-rolls",
      "item": "ciabatta sandwich rolls",
      "quantity": 2
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 4,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "tortilla-chips",
      "item": "tortilla chips",
      "quantity": 8,
      "preparation": "crushed"
    },
    {
      "ingredient_id": "colby-monterey-jack-cheese",
      "item": "Colby-Monterey Jack cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a skillet or griddle over medium heat."
    },
    {
      "step": 2,
      "text": "Stir the softened cream cheese, sour cream, chopped jalapeños, and shredded Colby-Monterey Jack cheese until evenly combined."
    },
    {
      "step": 3,
      "text": "Split the ciabatta rolls. Spread the filling over the cut sides, then sprinkle the crushed tortilla chips over the filling."
    },
    {
      "step": 4,
      "text": "Butter the outsides of the rolls with the butter and close the sandwiches."
    },
    {
      "step": 5,
      "text": "Grill the sandwiches until the bread is lightly browned and the filling is melted, about 5 minutes total, turning as needed.",
      "timer_minutes": 5
    }
  ],
