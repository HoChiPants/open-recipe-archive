  "instructions": [
    {
      "step": 1,
      "text": "Break the bread into pieces and pulse it with the walnuts until crumbly. Microwave the sweet potato for 10 minutes, or until tender; cool briefly and scoop out the flesh.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Blend the sweet potato, drained black beans, smoked paprika, cumin, onion granules, tomato purée, and bread-walnut mixture until mostly smooth. Shape into four patties."
    },
    {
      "step": 3,
      "text": "Toss the carrot ribbons with the cucumber, coriander, lime juice, and 1 tablespoon rapeseed oil. Set aside for 20 minutes to soften slightly.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Heat the frying oil in a large skillet over medium heat. Cook the patties for about 5 minutes per side, turning carefully, until browned and hot throughout.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Split and toast the buns if desired. Spread with coconut yogurt or burger sauce, then layer in rocket, tomato, avocado, a burger, and the carrot-cucumber mixture."
    },
    {
      "step": 6,
      "text": "Serve with any remaining cucumber-carrot salad."
    }
  ],
