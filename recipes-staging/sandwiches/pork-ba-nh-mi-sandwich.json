  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Toss the daikon and carrots with the seasoned rice vinegar. Chill for 20 minutes, until set.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Stir together the mayonnaise, hoisin sauce, and sriracha."
    },
    {
      "step": 4,
      "text": "Split the roll lengthwise and spread the seasoned mayonnaise inside."
    },
    {
      "step": 5,
      "text": "Place the open roll on a baking sheet and bake for 7 minutes, until lightly toasted.",
      "timer_minutes": 7
    },
    {
      "step": 6,
      "text": "Layer the pork, pâté, cucumber, jalapeño, pickled vegetables, and cilantro in the toasted roll."
    },
    {
      "step": 7,
      "text": "Close the sandwich and cut to serve."
    }
  ],
