      "item": "mozzarella grated",
      "quantity": 30,
      "unit": "g"
    },
    {
      "ingredient_id": "chilli-sauce-to-serve",
      "item": "chilli sauce to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a skillet over medium heat. Add the onion and cook for 10 minutes, stirring occasionally, until softened.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the red chilli and ground coriander, then cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the drained sweetcorn, spring onions, and lime zest. Stir until evenly combined and heated through."
    },
    {
      "step": 4,
      "text": "Divide the filling between the tortillas. Add the cheddar and mozzarella, then fold each tortilla in half."
    },
    {
      "step": 5,
      "text": "Cook the quesadillas in a clean skillet over medium heat for about 2 minutes per side, until the tortillas are crisp and the cheese has melted.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Cut into wedges and serve with the optional chilli sauce."
    }
  ],
