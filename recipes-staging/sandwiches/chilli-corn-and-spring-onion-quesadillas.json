  "id": "chilli-corn-and-spring-onion-quesadillas",
  "name": "Chilli, Corn and Spring Onion Quesadillas",
  "subtitle": "Crisp tortillas filled with spiced sweetcorn and melted cheese",
  "description": "A quick vegetarian quesadilla with sweetcorn, spring onions, lime, chilli, and two melted cheeses.",
  "meal_type": "sandwich",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "finely-chopped-onion",
      "item": "finely chopped onion",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "finely-chopped-red-chilli",
      "item": "finely chopped red chilli",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "ground-coriander",
      "item": "ground coriander",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
