  "id": "croque-monsieur-sandwiches",
  "name": "Croque Monsieur Sandwiches",
  "subtitle": "Ham and Swiss sandwiches with a crisp savory coating",
  "description": "Layer ham, Swiss cheese, mustard, and mayonnaise between buttered bread, then coat the sandwiches in a light egg batter and pan-cook until crisp and hot.",
  "meal_type": "sandwich",
  "cuisine": "French Inspired",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "butter-or-margarine",
      "item": "butter or margarine",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "slices-white-bread",
      "item": "slices white bread",
      "quantity": 6
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "slices-thinly-sliced-deli-ham",
      "item": "slices thinly sliced deli ham",
      "quantity": 12
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "slices-swiss-cheese",
      "item": "slices Swiss cheese",
      "quantity": 6
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Spread the softened butter or margarine over one side of each bread slice. Spread mustard on three slices and mayonnaise on the other three."
    },
    {
      "step": 2,
      "text": "Layer four ham slices and two Swiss cheese slices on each mustard-coated slice. Top with the remaining bread, spread-side up, and press gently to compact the sandwiches."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, flour, water, baking powder, and salt in a shallow bowl until smooth. Coat each sandwich on all sides with the batter."
    },
    {
      "step": 4,
      "text": "Heat the vegetable oil in a skillet over medium heat. Cook the sandwiches until golden and crisp on both sides and the cheese is melted, about 5 minutes total.",
      "timer_minutes": 5
    }
  ],
