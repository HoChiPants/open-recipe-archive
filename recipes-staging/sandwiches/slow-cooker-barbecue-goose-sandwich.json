  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "slow-cooker-barbecue-goose-sandwich",
  "name": "Slow Cooker Barbecue Goose Sandwich",
  "subtitle": "Tender goose with savory barbecue-style cooking juices",
  "description": "Goose breast cooks slowly with butter, aromatics, Worcestershire sauce, and broth, then is shredded for sandwiches.",
  "meal_type": "sandwich",
  "cuisine": "American",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 360
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "onion",
      "item": "yellow onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "goose-breast",
      "item": "goose breast",
      "quantity": 1
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a slow cooker set to its cooking setting, then stir in the Worcestershire sauce."
    },
    {
      "step": 2,
      "text": "Add the garlic and onion, followed by the goose breast. Pour in the remaining Worcestershire sauce and the chicken broth."
    },
    {
      "step": 3,
      "text": "Cover and cook until the goose is tender, about 6 hours. Check the thickest part with a food thermometer; poultry should reach 165°F.",
      "timer_minutes": 360
    },
    {
      "step": 4,
      "text": "Shred the goose in its cooking juices and serve in sandwiches."
    }
  ],
