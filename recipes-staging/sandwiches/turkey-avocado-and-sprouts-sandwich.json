  "instructions": [
    {
      "step": 1,
      "text": "Stir the mayonnaise and mustard together in a small bowl."
    },
    {
      "step": 2,
      "text": "Spread the mixture over the toasted bread slices."
    },
    {
      "step": 3,
      "text": "Layer the turkey and guacamole on one slice of bread."
    },
    {
      "step": 4,
      "text": "Add the greens, sprouts, avocado, cheese, and tomato."
    },
    {
      "step": 5,
      "text": "Top with the second bread slice, cut the sandwich, and serve."
    },
    {
      "step": 6,
      "text": "If using turkey that is not ready to eat, cook it to 165°F before assembling."
    }
  ],
