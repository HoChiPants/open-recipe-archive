  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven according to the fries package instructions. Toss the frozen fries with the sunflower oil, spread them on a baking tray, and bake for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Toss the partially cooked fries with Cajun spice mix, return them to the oven, and cook for 20 minutes more, until crisp.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Blend or finely process the shallot, red chilli, garlic, vinegar, parsley, coriander, and extra virgin olive oil until a coarse, smooth chimichurri forms."
    },
    {
      "step": 4,
      "text": "Mix the mayonnaise with the chipotle chilli paste and the lime zest and juice until smooth."
    },
    {
      "step": 5,
      "text": "Heat a grill pan or heavy frying pan. Cook the steaks for 3 minutes, turning as needed, until a thermometer reads 145°F at the center. Rest for 10 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Split the ciabatta rolls and spread them with the chipotle mayonnaise. Add the rocket, slice the rested steak, and fill the rolls with it."
    },
    {
      "step": 7,
      "text": "Serve the steak sandwiches with the seasoned fries and chimichurri."
    }
  ],
