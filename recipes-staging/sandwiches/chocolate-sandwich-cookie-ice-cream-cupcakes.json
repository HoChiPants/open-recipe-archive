  "id": "chocolate-sandwich-cookie-ice-cream-cupcakes",
  "name": "Chocolate Sandwich Cookie Ice Cream Cupcakes",
  "subtitle": "A chilled cookie-and-cream dessert in individual portions",
  "description": "Crushed chocolate sandwich cookies form a buttery base for creamy frozen cupcakes, finished with sweetened cream and whole cookies.",
  "meal_type": "sandwich",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "cre-me-filled-chocolate-sandwich-cookies-plus-8-whole-cookies-for-decorating",
      "item": "crème-filled chocolate sandwich cookies plus 8 whole cookies for decorating",
      "quantity": 280,
      "unit": "g"
    },
    {
      "ingredient_id": "unsalted-butter-melted",
      "item": "unsalted butter melted",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "condensed-milk",
      "item": "condensed milk",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Set aside the 8 whole cookies for decoration and crush the remaining cookies into fine crumbs."
    },
    {
      "step": 2,
      "text": "Mix the melted butter with the cookie crumbs. Divide the mixture among 8 cupcake wells and press it into an even base."
    },
    {
      "step": 3,
      "text": "Whisk the 300 ml double cream until thickened, then fold in the condensed milk and crushed-cookie mixture.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Spoon the mixture over the cookie bases and freeze until firm, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Whisk the 100 ml double cream with the icing sugar until it holds soft peaks."
    },
    {
      "step": 6,
      "text": "Top the frozen cupcakes with the sweetened cream and decorate each with a whole cookie. Serve chilled."
    }
  ],
