  "id": "peanut-butter-banana-bacon-sandwich",
  "name": "Peanut Butter Banana Bacon Sandwich",
  "subtitle": "A warm, crisp sandwich with creamy peanut butter and sweet banana",
  "description": "Layer peanut butter, banana, and cooked bacon between buttered bread, then skillet-toast until golden brown.",
  "meal_type": "sandwich",
  "cuisine": "American",
