  "instructions": [
    {
      "step": 1,
      "text": "Spread peanut butter on one side of each bread slice. Butter the outer sides."
    },
    {
      "step": 2,
      "text": "Place the banana slices and cooked bacon on one slice, then top with the other slice and cut the sandwich in half."
    },
    {
      "step": 3,
      "text": "Preheat a skillet over medium heat."
    },
    {
      "step": 4,
      "text": "Cook the sandwich for about 2 minutes per side, or until the bread is golden brown and the filling is warm.",
