  "id": "ham-quesadillas-with-sweet-pickled-onions",
  "name": "Ham Quesadillas with Sweet Pickled Onions",
  "subtitle": "Crisp tortillas with melted cheese, ham, and tangy onions",
  "description": "Quick quesadillas layered with shredded ham, melted hard cheese, and sweet-spiced pickled red onion, finished with torn mint.",
  "meal_type": "sandwich",
  "yield": {
    "quantity": 2,
    "unit": "(easily doubled)"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "handful-leftover-ham-or-two-slices-ham",
      "item": "handful leftover ham or two slices ham",
      "quantity": 1,
      "preparation": "shredded"
    },
    {
      "ingredient_id": "flour-tortillas",
      "item": "flour tortillas",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "handful-cheddar-or-other-hard-cheese-like-comte-or-gruye-re",
      "item": "handful cheddar or other hard cheese like comté or gruyère",
      "quantity": 1,
      "preparation": "grated small knob of butter"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "star-anise",
      "item": "star anise",
      "quantity": 1
    },
    {
      "ingredient_id": "of-chilli-flakes",
      "item": "of chilli flakes",
      "unit": "pinch"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "red-onion-finely-sliced",
      "item": "red onion finely sliced",
      "quantity": 1,
      "unit": "small"
    },
