  "instructions": [
    {
      "step": 1,
      "text": "Warm the vinegar, sugar, star anise, and chilli flakes in a small saucepan until the sugar dissolves. Add the sliced onion, remove from the heat, and leave for 20 minutes. Drain before using.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Heat a large skillet over medium heat. Place one tortilla in the pan and cover with half the cheese, ham, and pickled onion. Top with the remaining cheese and the second tortilla."
    },
    {
      "step": 3,
      "text": "Cook until the underside is golden and the cheese begins to melt, about 3 minutes. Turn carefully and cook until the second side is crisp and the filling is hot. If using uncooked pork instead of leftover cooked ham, verify it reaches 145°F and rest it for 3 minutes before serving.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Cut into wedges and serve with the torn mint leaves."
    }
  ],
