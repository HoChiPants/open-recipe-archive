  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a skillet over medium heat until crisp, about 10 minutes. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Preheat the grill to medium-high heat."
    },
    {
      "step": 3,
      "text": "Brush the salmon portions with the olive oil. Grill for about 5 minutes per side, until the thickest part reaches 145°F or the fish is opaque and flakes easily.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Whisk the mayonnaise, dill weed, and lemon zest together."
    },
    {
      "step": 5,
      "text": "Spread the dill sauce over the toasted bread. Layer the lettuce, tomato, grilled salmon, and bacon between the slices."
    },
    {
      "step": 6,
      "text": "Cut the sandwiches and serve."
    }
  ],
