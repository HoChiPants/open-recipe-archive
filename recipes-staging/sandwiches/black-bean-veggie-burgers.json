  "instructions": [
    {
      "step": 1,
      "text": "Heat a skillet over medium heat. Add the olive oil, leek, mushrooms, thyme, tofu, and kale; cook until the vegetables soften, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir the mustard and tamari into the drained black beans, then blend until mostly smooth."
    },
    {
      "step": 3,
      "text": "Combine the bean mixture with the cooked vegetables, oat bran, brown rice, and chopped nuts. Mix until cohesive."
    },
    {
      "step": 4,
      "text": "Shape the mixture into 4 patties. If loose, work in the gram flour before shaping."
    },
    {
      "step": 5,
      "text": "Heat the skillet with the remaining oil as needed and sauté the patties until browned and heated through, about 5 minutes per side.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir together the vegan mayo, ketchup, chopped cornichons, and cayenne. Serve the patties in the buns with the sauce, sliced tomatoes and red onion, and lettuce."
    }
  ],
