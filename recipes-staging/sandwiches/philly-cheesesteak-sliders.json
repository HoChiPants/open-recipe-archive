  "id": "philly-cheesesteak-sliders",
  "name": "Philly Cheesesteak Sliders",
  "subtitle": "Tender steak, sautéed vegetables, mushrooms, and provolone on soft rolls",
  "description": "Cook seasoned steak with onions, peppers, and mushrooms, then layer the filling with melted provolone in dinner rolls for a shareable sandwich.",
  "meal_type": "sandwich",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "sirloin-steak",
      "item": "sirloin steak",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into 1/8-inch strips"
    },
    {
      "ingredient_id": "meat-tenderizer",
      "item": "meat tenderizer",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "splash-olive-oil",
      "item": "splash olive oil",
      "quantity": 1
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "bell-pepper",
      "item": "bell pepper",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "minced"
    },
    {
      "ingredient_id": "italian-seasoning",
      "item": "Italian seasoning",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    },
    {
      "ingredient_id": "canned-sliced-mushrooms",
      "item": "canned sliced mushrooms",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "hawaiian-style-dinner-rolls",
      "item": "Hawaiian-style dinner rolls",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 count, sliced in half"
    },
    {
      "ingredient_id": "slices-provolone-cheese",
      "item": "slices provolone cheese",
      "quantity": 8
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Toss the steak with the meat tenderizer. Heat the olive oil in a large skillet over medium-high heat."
    },
    {
      "step": 2,
      "text": "Add the onion, bell pepper, and black pepper. Cook, stirring, for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the steak and cook until browned and the beef reaches 145°F, then rest it for 3 minutes. Stir in the Italian seasoning, additional pepper, and mushrooms; cook until hot, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Arrange the roll bottoms in a baking dish and spoon the steak mixture over them. Cover with the provolone and add the roll tops."
    },
    {
      "step": 5,
      "text": "Grill or broil until the cheese melts, about 3 minutes, then serve warm.",
      "timer_minutes": 3
    }
  ],
