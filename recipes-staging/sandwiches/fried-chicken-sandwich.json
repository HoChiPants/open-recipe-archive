  "instructions": [
    {
      "step": 1,
      "text": "Transfer the chicken to a work surface and smooth or flatten the thick portions for even cooking."
    },
    {
      "step": 2,
      "text": "Cut the chicken into six sandwich portions. Add the pickle slices and brine, cover, and refrigerate for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Combine the flour, powdered sugar, salt, paprika, black pepper, celery salt, and basil in a shallow dish."
    },
    {
      "step": 4,
      "text": "Whisk the eggs and milk in a second shallow dish. Drain the chicken and prepare a coating station."
    },
    {
      "step": 5,
      "text": "Preheat the peanut oil to 350°F in a heavy skillet or fryer."
    },
    {
      "step": 6,
      "text": "Dip each chicken portion in the egg mixture, then coat thoroughly with the seasoned flour. Prepare all portions before frying."
    },
    {
      "step": 7,
      "text": "Fry the chicken in batches for about 3 minutes per side, or until golden brown and the thickest part reaches 165°F.",
      "timer_minutes": 3
    },
    {
      "step": 8,
      "text": "Transfer the chicken to a rack and rest for 5 minutes so the coating sets.",
      "timer_minutes": 5
    },
    {
      "step": 9,
      "text": "Butter the cut sides of the buns. Place a fried chicken portion on each bun and add the pickle slices."
    },
    {
      "step": 10,
      "text": "Close the sandwiches and serve."
    }
  ],
