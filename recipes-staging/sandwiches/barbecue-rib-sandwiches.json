  "id": "barbecue-rib-sandwiches",
  "name": "Barbecue Rib Sandwiches",
  "subtitle": "Tender shredded ribs with sauce and crisp coleslaw",
  "description": "Seasoned baby back ribs are baked until tender, chilled for easy shaping, grilled with barbecue sauce, and served on toasted rolls with coleslaw.",
  "meal_type": "sandwich",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
