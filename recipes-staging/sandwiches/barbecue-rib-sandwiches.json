  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Combine the kosher salt, brown sugar, chili powder, black pepper, cumin, and cayenne. Remove the membrane from the ribs if present, then coat the ribs evenly with the seasoning mixture."
    },
    {
      "step": 3,
      "text": "Place the ribs in a baking dish and bake until tender and they reach at least 145°F internally, followed by a 3-minute rest.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Let the ribs cool enough to handle, remove the bones, and shred the meat. Chill the shredded meat for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 5,
      "text": "Shape the chilled meat into four portions. Preheat a grill, brush the portions with some of the divided barbecue sauce, and grill for about 4 minutes, turning as needed, until heated through and lightly marked.",
      "timer_minutes": 4
    },
    {
      "step": 6,
      "text": "Spread the remaining barbecue sauce on the toasted rolls. Fill with the grilled rib portions and top with coleslaw."
    }
  ],
