  "instructions": [
    {
      "step": 1,
      "text": "Heat a skillet over medium-high heat. Add the defrosted corn and cook until hot and lightly browned, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mix the sliced spring onions, lime juice, mayonnaise, and chilli powder. Stir in the warm corn."
    },
    {
      "step": 3,
      "text": "Combine the rice, chopped tomato, and parsley in a bowl."
    },
    {
      "step": 4,
      "text": "Toss the sliced chicken with the taco or fajita seasoning. Heat the olive oil in the skillet, add the chicken, and cook until no longer pink and the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Warm the tortillas. Divide the rice, chicken, and corn mixture among them, fold in the sides, and roll tightly."
    },
    {
      "step": 6,
      "text": "Toast the wraps in the skillet until lightly golden on both sides, then serve.",
      "timer_minutes": 5
    }
  ],
