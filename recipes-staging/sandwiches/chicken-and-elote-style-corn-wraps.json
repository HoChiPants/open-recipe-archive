  "id": "chicken-and-elote-style-corn-wraps",
  "name": "Chicken and Elote-Style Corn Wraps",
  "subtitle": "Seasoned chicken, chile-lime corn, and herbed rice in warm tortillas.",
  "description": "A filling wrap combining spiced chicken with creamy chile-lime corn, tomato, parsley, and basmati-wild rice.",
  "meal_type": "sandwich",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
