  "instructions": [
    {
      "step": 1,
      "text": "Combine malt vinegar, yogurt, vegetable oil, mixed spice, cardamom, and salt and pepper. Coat the chicken thoroughly and chill for 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 2,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 3,
      "text": "Combine tahini, yogurt, garlic, lemon juice, olive oil, parsley, and salt and pepper. Chill until serving."
    },
    {
      "step": 4,
      "text": "Bake the marinated chicken for 30 minutes, then continue cooking for 10 minutes, or until the thickest pieces reach 165°F.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Cut the cooked chicken into slices."
    },
    {
      "step": 6,
      "text": "Fill the pita rounds with chicken, tomatoes, onion, and lettuce. Add tahini sauce and serve."
    }
