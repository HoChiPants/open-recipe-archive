  "id": "air-fryer-ice-cream-cookie-sandwich",
  "name": "Air Fryer Ice Cream Cookie Sandwich",
  "subtitle": "Warm chocolate-chip cookies with a cool vanilla center",
  "description": "Bake soft chocolate-chip cookies in the air fryer, cool them, and sandwich them around scoops of vanilla ice cream.",
  "meal_type": "sandwich",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "bicarbonate-of-soda",
      "item": "bicarbonate of soda",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "plain-chocolate-chips",
      "item": "plain chocolate chips",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "scoops-vanilla-ice-cream",
      "item": "scoops vanilla ice cream",
      "quantity": 4
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to the appliance instructions."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter with both sugars until smooth. Beat in the egg and vanilla extract."
    },
    {
      "step": 3,
      "text": "Mix in the flour and bicarbonate of soda until a dough forms, then fold in the chocolate chips."
    },
    {
      "step": 4,
      "text": "Divide the dough into portions and arrange them in the air fryer basket with space between each. Cook until golden and fully set; the center should reach 160°F if checked with a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Transfer the cookies to a rack and cool completely."
    },
    {
      "step": 6,
      "text": "Place one scoop of vanilla ice cream between two cookies and gently press to form each sandwich. Serve immediately."
    }
  ],
