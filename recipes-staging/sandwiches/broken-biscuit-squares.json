  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease the baking tin with some of the butter."
    },
    {
      "step": 2,
      "text": "Beat the softened butter with both sugars until light. Mix in the vanilla, almond extract, and orange zest."
    },
    {
      "step": 3,
      "text": "Add the eggs and whisk until combined. Whisk in the flour and baking powder for 2 minutes, then fold in the milk until smooth.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Spread the batter in the prepared tin and bake until set and lightly golden.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Transfer the bake to a rack and let it cool in the tin for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Prepare the topping by combining the chopped white chocolate and cream with the chocolate sandwich biscuits. Warm gently, stirring, until melted and smooth.",
      "timer_minutes": 1
    },
    {
      "step": 7,
      "text": "Fold in the jammy ring biscuits, then spread the topping over the cooled bake and leave it to set."
    },
    {
      "step": 8,
      "text": "Arrange the jammy ring, chocolate sandwich, and custard sandwich biscuits over the top, then cut into 12 squares."
    }
  ],
