      "item": "red chilli finely chopped (optional)",
      "quantity": 1,
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the sunflower oil in a saucepan over medium heat for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the onion, tomatoes, garlic, smoked paprika, tomato purée, vinegar, and chilli if using."
    },
    {
      "step": 3,
      "text": "Simmer for 20 minutes, stirring occasionally, until the mixture has thickened.",
      "timer_minutes": 20
    }
