      "ingredient_id": "sunflower-oil",
      "item": "sunflower oil",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "red-onion-finely-chopped",
      "item": "red onion finely chopped",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "tomatoes-roughly-chopped",
      "item": "tomatoes roughly chopped",
      "quantity": 200,
      "unit": "g"
    },
    {
