  "id": "barbecue-burger-relish",
  "name": "Barbecue Burger Relish",
  "subtitle": "Smoky tomato relish for burgers and sandwiches",
  "description": "A quick cooked relish combining tomatoes, onion, garlic, paprika, and vinegar into a thick, tangy topping.",
  "meal_type": "sandwich",
  "yield": {
    "quantity": 175,
    "unit": "g"
  },
