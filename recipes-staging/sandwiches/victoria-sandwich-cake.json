  "id": "victoria-sandwich-cake",
  "name": "Victoria Sandwich Cake",
  "subtitle": "A light sponge layered with jam and vanilla buttercream",
  "description": "Two tender sponge layers filled with strawberry jam and buttercream, finished with a dusting of icing sugar.",
  "meal_type": "sandwich",
  "cuisine": "British",
  "yield": {
    "quantity": 10,
    "unit": "slices"
  },
  "times": {
