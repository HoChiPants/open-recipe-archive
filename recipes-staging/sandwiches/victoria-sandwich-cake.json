      "item": "icing sugar to decorate"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare the cake tins."
    },
    {
      "step": 2,
      "text": "Beat the caster sugar and softened 200 g butter until light. Add the beaten eggs, self-raising flour, baking powder, and milk, then mix to a smooth batter."
    },
    {
      "step": 3,
      "text": "Divide the batter between the prepared tins and bake for 20 minutes, until risen and cooked through.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Cool the cakes completely before assembling."
    },
    {
      "step": 5,
      "text": "Beat the 100 g softened butter until smooth. Gradually mix in the sifted icing sugar and optional vanilla extract until creamy."
    },
    {
      "step": 6,
      "text": "Spread the strawberry jam over one cooled cake and the buttercream over the other. Sandwich the layers together and dust with icing sugar to decorate."
    }
  ],
