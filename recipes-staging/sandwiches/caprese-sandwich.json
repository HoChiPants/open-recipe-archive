  "instructions": [
    {
      "step": 1,
      "text": "Arrange the bread or focaccia slices on a work surface. Spread the pesto over the cut sides and drizzle with olive oil."
    },
    {
      "step": 2,
      "text": "Layer the rocket, mozzarella, tomatoes, basil, and optional red onion over four slices of bread."
    },
    {
      "step": 3,
      "text": "Drizzle the fillings with balsamic vinegar, then close the sandwiches with the remaining bread."
    },
    {
      "step": 4,
      "text": "Serve immediately."
    }
