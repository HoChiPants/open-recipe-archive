  "id": "mushroom-veggie-burgers",
  "name": "Mushroom Veggie Burgers",
  "subtitle": "Savory mushroom patties with oats and cheese",
  "description": "Cooked mushrooms, aromatics, oats, breadcrumbs, cheese, and eggs form tender vegetarian patties for a simple meal.",
  "meal_type": "sandwich",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "fresh-mushrooms",
      "item": "fresh mushrooms",
      "quantity": 3,
      "unit": "package",
      "preparation": "8 ounce, sliced"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "unit": "medium",
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "freshly-shredded-parmigiano-reggiano-cheese",
      "item": "freshly shredded Parmigiano-Reggiano cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large",
      "preparation": "beaten"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm 2 tablespoons of the olive oil in a skillet over medium heat. Add the mushrooms, onion, garlic, salt, pepper, and oregano, then cook, stirring often, until the mushrooms are tender and their moisture has cooked away, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Transfer the mushroom mixture to a work surface and chop it finely. Stir in the breadcrumbs and oats, then mix in the cheese and beaten eggs until evenly combined."
    },
    {
      "step": 3,
      "text": "Cover and refrigerate the mixture for 15 minutes so it firms up.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Shape the mixture into six even patties."
    },
    {
      "step": 5,
      "text": "Heat the remaining olive oil in the skillet. Cook the patties until golden brown, about 3 minutes per side, and confirm the centers reach 160°F and are fully set.",
      "timer_minutes": 3
    }
  ],
