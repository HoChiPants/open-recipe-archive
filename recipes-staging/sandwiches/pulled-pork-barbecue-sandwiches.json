{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pulled-pork-barbecue-sandwiches",
  "name": "Pulled Pork Barbecue Sandwiches",
  "subtitle": "Slow-roasted pork with barbecue sauce on soft buns",
  "description": "Seasoned pork shoulder is slow-roasted until tender, shredded, and mixed with barbecue sauce for sandwich serving.",
  "meal_type": "sandwich",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 720
  },
  "ingredients": [
    {
      "ingredient_id": "dry-barbeque-rub",
      "item": "dry barbeque rub",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "3-1-2-pound-bone-in-pork-shoulder-blade-roast",
      "item": "(3 1/2) pound bone-in pork shoulder blade roast",
      "quantity": 1
    },
    {
      "ingredient_id": "liquid-smoke-flavoring",
      "item": "liquid smoke flavoring",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "divided"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "barbeque-sauce",
      "item": "barbeque sauce",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "soft-white-hamburger-buns",
      "item": "soft white hamburger buns",
      "quantity": 12
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 210°F."
    },
    {
      "step": 2,
      "text": "Rub the pork shoulder evenly with the dry barbeque rub and place it in a roasting pan."
    },
    {
      "step": 3,
      "text": "Combine the divided liquid smoke flavoring and water, then add the mixture to the roasting pan."
    },
    {
      "step": 4,
      "text": "Cover the pan tightly and roast for 720 minutes, or until the pork is very tender and reaches at least 145°F in the thickest part.",
      "timer_minutes": 720
    },
    {
      "step": 5,
      "text": "Transfer the roast to a work surface and rest for at least 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Remove the bone and any excess fat, then pull or cut the pork into bite-size pieces."
    },
    {
      "step": 7,
      "text": "Season with salt and freshly ground black pepper, toss with the barbeque sauce, and return the pork to the pan if needed to keep it warm."
    },
    {
      "step": 8,
      "text": "Serve the pulled pork on the soft white hamburger buns."
    }
  ],
