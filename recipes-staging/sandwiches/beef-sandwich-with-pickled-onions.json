  "id": "beef-sandwich-with-pickled-onions",
  "name": "Beef Sandwich with Pickled Onions",
  "subtitle": "A hearty baguette sandwich with tangy onions and crisp green beans.",
  "description": "Layer leftover beef, avocado sauce, spicy greens, green beans, and quick-pickled onion in a split baguette.",
  "meal_type": "sandwich",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "red-onion-finely-sliced",
      "item": "red onion finely sliced",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "rice-vinegar",
      "item": "rice vinegar",
      "quantity": 60,
      "unit": "ml"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "green-beans",
      "item": "green beans",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "demi-baguette-halved",
      "item": "demi baguette halved",
      "quantity": 1
    },
    {
      "ingredient_id": "70g-leftover-avocado-sauce-see-recipe-below",
      "item": "70g leftover avocado sauce (see recipe below)",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "leftover-beef-see-recipe-below",
      "item": "leftover beef (see recipe below)",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "handful-of-leftover-spicy-greens-see-recipe-below",
      "item": "handful of leftover spicy greens (see recipe below)"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sliced onion, rice vinegar, and sugar. Let stand for 20 minutes to pickle.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Cook the green beans for 4 minutes, or until tender, then drain.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "If using raw beef instead of cooked leftovers, cook it to the applicable safe endpoint: 145°F for whole cuts followed by a 3-minute rest, or 160°F for ground beef."
    },
    {
      "step": 4,
      "text": "Spread the avocado sauce over the baguette halves. Fill with the pickled onion, green beans, beef, and spicy greens, then serve."
    }
  ],
