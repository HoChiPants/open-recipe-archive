      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "onion-thinly-sliced",
      "item": "onion thinly sliced",
      "quantity": 1
    },
    {
      "ingredient_id": "skinless-and-boneless-chicken-thighs-halved",
      "item": "skinless and boneless chicken thighs halved",
      "quantity": 8
    },
    {
      "ingredient_id": "garlic-cloves-crushed",
      "item": "garlic cloves crushed",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "1-2-tsp-chilli-flakes",
      "item": "1/2 tsp chilli flakes",
      "quantity": "1-1"
    },
    {
