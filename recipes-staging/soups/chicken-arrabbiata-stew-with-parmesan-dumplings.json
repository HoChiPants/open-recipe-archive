      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large ovenproof pot. Cook the onion for 7 minutes until softened. Add the chicken and chicken stock; cook for 5 minutes, turning the chicken occasionally.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Stir in the garlic and 1/2 tsp chilli flakes and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the sun-dried tomato pesto, chopped tomatoes, tied thyme sprigs, and sugar. Bring to a simmer."
    },
    {
      "step": 4,
      "text": "Simmer uncovered for 40 minutes, stirring occasionally, until the chicken reaches 165°F in the thickest piece. Remove the thyme sprigs.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Heat the oven to a suitable baking temperature. Rub the cold butter into the self-raising flour, then mix in the grated Parmesan and enough milk to form a soft dough. Fold in the finely chopped parsley."
    },
    {
      "step": 6,
      "text": "Spoon the dumpling dough over the stew, leaving small gaps between portions. Transfer the pot to the oven and bake for 25 minutes, until the dumplings are golden brown and cooked through.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Serve the stew hot with the Parmesan dumplings."
    }
  ],
