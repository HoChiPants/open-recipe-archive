  "id": "chicken-arrabbiata-stew-with-parmesan-dumplings",
  "name": "Chicken Arrabbiata Stew with Parmesan Dumplings",
  "subtitle": "A tomato-rich chicken stew finished with tender cheese dumplings.",
  "description": "Chicken thighs simmer with tomatoes, pesto, garlic, and herbs, then bake beneath Parmesan dumplings until golden and cooked through.",
  "meal_type": "soup",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
