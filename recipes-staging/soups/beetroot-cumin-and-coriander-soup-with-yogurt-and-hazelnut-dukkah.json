  "schema_version": "1.0.0",
  "id": "beetroot-cumin-and-coriander-soup-with-yogurt-and-hazelnut-dukkah",
  "name": "Beetroot, Cumin and Coriander Soup with Yogurt and Hazelnut Dukkah",
  "subtitle": "Roasted beetroot soup with spiced nut-and-seed topping",
  "description": "Beetroot and onions are roasted with warm spices, simmered with stock, and blended smooth. Finish each bowl with yogurt and crunchy hazelnut dukkah.",
  "meal_type": "soup",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "red-onions-cut-into-wedges",
      "item": "red onions cut into wedges",
      "quantity": 2
    },
    {
      "ingredient_id": "raw-beetroot-peeled-and-cut-into-wedges",
      "item": "raw beetroot peeled and cut into wedges",
      "quantity": 1,
      "unit": "kg"
    },
    {
      "ingredient_id": "chilli-flakes-optional",
      "item": "chilli flakes",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "cumin-seeds-plus-1-tsp",
      "item": "cumin seeds plus 1 tsp",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "coriander-seeds",
      "item": "coriander seeds",
      "quantity": "1 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "red-wine-vinegar",
      "item": "red wine vinegar",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "l-vegetable-stock-we-used-bouillon",
      "item": "l vegetable stock (we used Bouillon)",
      "quantity": 1.2
    },
    {
      "ingredient_id": "hazelnuts",
      "item": "hazelnuts",
      "quantity": 30,
      "unit": "g"
    },
    {
      "ingredient_id": "sesame-seeds",
      "item": "sesame seeds",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "natural-yogurt",
      "item": "natural yogurt",
      "quantity": 4,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Toss the onions, beetroot, chilli flakes, cumin seeds, coriander seeds, sesame seeds, and olive oil together on a roasting tray."
    },
    {
      "step": 2,
      "text": "Roast until the vegetables begin to soften and the spices are fragrant.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir the red wine vinegar through the roasted vegetables, then transfer them to a large saucepan with the vegetable stock."
    },
    {
      "step": 4,
      "text": "Bring to a simmer and cook until the beetroot is completely tender.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Meanwhile, toast the hazelnuts with the remaining spice mixture until fragrant. Cool briefly, then crush or pulse into a coarse dukkah."
    },
    {
      "step": 6,
      "text": "Blend the soup until smooth, then divide among bowls."
    },
    {
      "step": 7,
      "text": "Top each serving with natural yogurt and the hazelnut dukkah."
    }
  ],
