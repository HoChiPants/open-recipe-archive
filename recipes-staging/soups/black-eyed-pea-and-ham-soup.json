    "inactive_minutes": 375
  },
  "ingredients": [
    {
      "ingredient_id": "dry-black-eyed-peas",
      "item": "dry black-eyed peas",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "ham",
      "item": "ham",
      "quantity": 1,
      "unit": "can",
      "preparation": "5 ounce"
    },
    {
      "ingredient_id": "carrot",
      "item": "carrot",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Soak the black-eyed peas in enough water to cover for 6 hours and 15 minutes.",
      "timer_minutes": 375
    },
    {
      "step": 2,
      "text": "Drain the peas."
    },
    {
      "step": 3,
      "text": "Combine the peas, ham, carrot, onion, and salt and pepper in a large pot. Add enough water to cover."
    },
    {
      "step": 4,
      "text": "Bring to a boil, then reduce the heat and simmer until the peas are tender, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Check the ham with a food thermometer; if it is not fully cooked, heat it to 145°F and let it rest for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Stir the soup and serve hot."
    }
  ],
