  "id": "black-eyed-pea-and-ham-soup",
  "name": "Black-Eyed Pea and Ham Soup",
  "subtitle": "A hearty, slow-simmered bean soup",
  "description": "Tender black-eyed peas, ham, carrot, and onion come together in a simple, warming soup.",
  "meal_type": "soup",
  "cuisine": "Southern",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
