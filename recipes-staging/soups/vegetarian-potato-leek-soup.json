{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "vegetarian-potato-leek-soup",
  "name": "Vegetarian Potato-Leek Soup",
  "subtitle": "A smooth, savory soup with tender potatoes and leeks.",
  "description": "Leeks, potatoes, and vegetable broth simmer together, then blend into a warming soup seasoned with cayenne and salt.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "leeks",
      "item": "leeks",
      "quantity": 2,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "32-fluid-ounce-container-vegetable-broth",
      "item": "(32 fluid ounce) container vegetable broth",
      "quantity": 1
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "cut into cubes"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 0.375,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the divided olive oil in a large pot over medium heat. Add the leeks and cook, stirring occasionally, for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Pour in the vegetable broth and water, then add the cubed potatoes."
    },
    {
      "step": 3,
      "text": "Bring the soup to a simmer and cook for 25 minutes, or until the potatoes are tender.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Remove the pot from the heat. Blend the soup carefully with an immersion blender, or in batches with a countertop blender, until smooth."
    },
    {
      "step": 5,
      "text": "Stir in the cayenne pepper and salt, then serve."
    }
  ],
