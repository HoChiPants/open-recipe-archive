  "id": "sweet-potato-and-black-bean-stew-with-cheddar-dumplings",
  "name": "Sweet Potato and Black Bean Stew with Cheddar Dumplings",
  "subtitle": "A hearty vegetable stew finished with tender cheese dumplings.",
  "description": "Simmered squash, sweet potato, beans, tomatoes, and chipotle paste beneath golden cheddar dumplings.",
  "meal_type": "soup",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying"
    },
    {
      "ingredient_id": "red-onion-finely-sliced",
      "item": "red onion finely sliced",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "bag-diced-butternut-squash-and-sweet-potato",
      "item": "bag diced butternut squash and sweet potato",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "can-chopped-tomatoes",
      "item": "can chopped tomatoes",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "x-400g-cans-chilli-black-beans-or-chilli-kidney-beans",
      "item": "x 400g cans chilli black beans or chilli kidney beans",
      "quantity": 2
    },
    {
      "ingredient_id": "chipotle-chilli-paste",
      "item": "chipotle chilli paste",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "unsalted-butter-cubed",
      "item": "unsalted butter cubed",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "mature-cheddar-grated",
      "item": "mature cheddar grated",
      "quantity": 70,
      "unit": "g"
    },
    {
      "ingredient_id": "green-jalapen-o-finely-sliced-optional",
      "item": "green jalapeño finely sliced (optional)",
      "quantity": 1,
      "unit": "large",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large ovenproof pot over medium heat. Add the red onion, reserving a little for garnish, and cook for 7 minutes until softened.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Stir in the butternut squash and sweet potato, chopped tomatoes, black beans or kidney beans, and chipotle chilli paste. Bring to a steady simmer and cook for 25 minutes, until the vegetables are tender.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Meanwhile, heat the oven to 400°F. Combine the self-raising flour and cubed butter, rubbing the butter into the flour until crumbly. Stir in the cheddar, then shape the mixture into small dumplings."
    },
    {
      "step": 4,
      "text": "Arrange the dumplings over the simmering stew. Transfer the pot to the oven and bake for 20 minutes, until the dumplings are golden brown.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Scatter the reserved red onion and sliced jalapeño over the stew, then serve hot."
    }
  ],
