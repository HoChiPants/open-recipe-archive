  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large pot over medium heat. Add the onions, leeks, tomatoes, and garlic, and cook until softened.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the fennel leaf, thyme, bay leaf, and orange zest."
    },
    {
      "step": 3,
      "text": "Add the mussels, boiling water, and shrimp. Bring the broth to a boil, then season with salt and pepper."
    },
    {
      "step": 4,
      "text": "Reduce to a steady simmer and cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the sea bass and cook until the fish is opaque and flakes easily, or reaches 145°F internally. Mussels should open and shrimp should be opaque.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Discard any mussels that remain closed. Stir in the saffron, adjust the seasoning, and serve hot."
    }
  ],
