  "instructions": [
    {
      "step": 1,
      "text": "Heat a large pot over medium heat and melt the butter. Add the onion, celery, and garlic; cook for 7 minutes, until softened.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Stir in the flour until the vegetables are evenly coated. Gradually add the clam juice and water, whisking until smooth."
    },
    {
      "step": 3,
      "text": "Add the potatoes, bay leaf, and thyme. Bring the broth to a simmer and cook for 15 minutes, until the potatoes are tender.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Stir in the cod and cook for 8 minutes, until opaque and easily flaked or it reaches 145°F.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Add the milk and cook gently for 2 minutes. Season with salt and ground black pepper, remove the bay leaf, and serve.",
      "timer_minutes": 2
    }
  ],
