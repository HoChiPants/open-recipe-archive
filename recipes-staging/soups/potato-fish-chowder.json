      "item": "bay leaf",
      "quantity": 1
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cod-fillets",
      "item": "cod fillets",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into chunks"
    },
