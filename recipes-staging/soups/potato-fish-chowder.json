  "id": "potato-fish-chowder",
  "name": "Potato Fish Chowder",
  "subtitle": "A creamy cod chowder with tender potatoes and vegetables.",
  "description": "Build a light butter-thickened broth with aromatics, potatoes, herbs, and cod, then finish with milk and seasoning.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35
  },
  "ingredients": [
