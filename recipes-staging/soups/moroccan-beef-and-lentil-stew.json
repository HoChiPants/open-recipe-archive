  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large pot over medium heat. Add the carrots, celery, onion, and onion powder; cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Add the garlic and garlic powder, and stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the beef, salt, turmeric, pepper, cinnamon, ginger, cumin, coriander, and allspice. Cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the tomato paste and cook for 1 minute, until evenly combined.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Add the beef broth, molasses, and bay leaves. Bring to a simmer, then cook for 50 minutes, until the beef is tender and reaches 145°F; remove from heat and rest for 3 minutes.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Stir in the red lentils and apricots. Simmer for 15 minutes, until the lentils are tender.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Remove the bay leaves. Adjust the salt and black pepper, stir in the lemon juice, and serve."
    }
  ],
