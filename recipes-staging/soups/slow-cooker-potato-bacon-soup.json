    "prep_minutes": 15,
    "cook_minutes": 375
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 9
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "finely diced"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 7,
      "preparation": "peeled and cubed"
    },
    {
