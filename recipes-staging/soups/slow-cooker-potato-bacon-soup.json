  "id": "slow-cooker-potato-bacon-soup",
  "name": "Slow Cooker Potato-Bacon Soup",
  "subtitle": "A creamy slow-cooked soup with crisp bacon and melted cheese",
  "description": "Potatoes and onion simmer with broth until tender, then finish with a creamy flour mixture, cheese, bacon, and chives.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
