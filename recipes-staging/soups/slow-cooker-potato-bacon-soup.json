      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "half-and-half",
      "item": "half-and-half",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cheddar-monterey-jack-cheese-blend",
      "item": "Cheddar-Monterey Jack cheese blend",
      "quantity": 3.25,
      "unit": "cups",
      "preparation": "shredded, divided"
    },
    {
      "ingredient_id": "finely-chopped-fresh-chives",
      "item": "finely chopped fresh chives",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a skillet over medium heat until crisp, about 10 minutes. Drain, crumble, and reserve for serving.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Cook the onion in the skillet for 5 minutes, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Transfer the onion, potatoes, garlic powder, and vegetable broth to a slow cooker. Cover and cook until the potatoes are tender, about 6 hours.",
      "timer_minutes": 360
    },
    {
      "step": 4,
      "text": "Whisk the half-and-half and flour together until smooth. Stir the mixture into the slow cooker, then whisk or mash some of the potatoes to thicken the soup."
    },
    {
      "step": 5,
      "text": "Stir in the divided cheese blend, reserving some for topping, until melted and combined."
    },
    {
      "step": 6,
      "text": "Ladle the soup into bowls and top with the reserved bacon, cheese, and chives."
    }
  ],
