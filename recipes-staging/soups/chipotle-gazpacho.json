  "instructions": [
    {
      "step": 1,
      "text": "Add the tomatoes, red pepper, cucumber, spring onions, garlic, almonds, lime juice, olive oil, and chipotle paste to a blender. Blend until smooth."
    },
    {
      "step": 2,
      "text": "Transfer the soup to a container and chill for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Top with the avocado, red chilli, coriander, and remaining spring onions. Scatter with the almonds and serve chilled."
    }
