  "instructions": [
    {
      "step": 1,
      "text": "Mix the flour, salt, pepper, and thyme. Toss the cubed beef in the mixture until coated."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large pot. Add the beef and cook until browned on all sides."
    },
    {
      "step": 3,
      "text": "Add the cider, water, vinegar, sliced apple, and bay leaf. Bring the mixture to a simmer."
    },
    {
      "step": 4,
      "text": "Cover and simmer for 60 minutes. Check that the beef reaches at least 145°F internally, then allow it to rest for 3 minutes before continuing.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Stir in the carrots, potatoes, onions, and celery. Continue simmering until the vegetables are tender and the beef remains at or above 145°F.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Remove the bay leaf and serve hot."
    }
  ],
