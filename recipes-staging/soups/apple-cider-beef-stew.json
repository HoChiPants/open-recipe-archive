  "id": "apple-cider-beef-stew",
  "name": "Apple Cider Beef Stew",
  "subtitle": "A savory stew with cider, tender beef, and root vegetables",
  "description": "Beef and vegetables simmer gently with apple cider, vinegar, and herbs for a hearty, lightly sweet stew.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 135
  },
  "ingredients": [
