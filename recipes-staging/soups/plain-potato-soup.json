  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes in a pot and add enough water to cover. Bring to a simmer and cook until tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Drain the potatoes, then mash or prepare them to the desired texture for the soup."
    },
    {
      "step": 3,
      "text": "Warm the evaporated milk and butter together in the pot over low heat, without boiling."
    },
    {
      "step": 4,
      "text": "Return the potatoes to the pot and stir with the warm milk mixture until combined. Season with salt and pepper to taste."
    }
