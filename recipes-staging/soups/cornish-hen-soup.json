      "ingredient_id": "rock-cornish-hens",
      "item": "Rock Cornish hens",
      "quantity": 1
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "stalks-celery",
      "item": "stalks celery",
      "quantity": 5,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 3,
      "unit": "large",
      "preparation": "diced"
    },
    {
      "ingredient_id": "onion",
