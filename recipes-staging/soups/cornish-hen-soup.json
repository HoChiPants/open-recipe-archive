      "item": "potatoes",
      "quantity": 3,
      "preparation": "peeled and cubed"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 1,
      "unit": "can",
      "preparation": "48 fluid ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large pot over medium heat. Add the celery, carrots, onion, garlic, and potatoes; cook, stirring occasionally, until the onion is tender."
    },
    {
      "step": 2,
      "text": "Add the chicken broth and the Cornish hen. Bring to a gentle boil, then reduce the heat and simmer until the vegetables are tender and the thickest part of the hen reaches 165°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Transfer the hen to a plate, remove the meat from the bones, and return the meat to the soup. Serve hot."
    }
  ],
