  "id": "cornish-hen-soup",
  "name": "Cornish Hen Soup",
  "subtitle": "A hearty vegetable soup with tender Cornish hen",
  "description": "Cornish hen simmers with celery, carrots, onion, garlic, potatoes, and chicken broth for a simple, hearty soup.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 60
  },
  "ingredients": [
