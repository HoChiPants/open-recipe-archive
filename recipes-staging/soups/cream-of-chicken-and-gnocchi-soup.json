  "instructions": [
    {
      "step": 1,
      "text": "Melt the margarine in a large pot over medium heat."
    },
    {
      "step": 2,
      "text": "Add the onion, celery, carrot, and garlic. Cook, stirring occasionally, for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the flour and cook until the vegetables are evenly coated, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Add the chicken broth, half-and-half, milk, and chicken. Stir and simmer for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the gnocchi, spinach, rosemary, salt, black pepper, and nutmeg. Simmer until the gnocchi are tender and the chicken reaches 165°F.",
      "timer_minutes": 10
    }
