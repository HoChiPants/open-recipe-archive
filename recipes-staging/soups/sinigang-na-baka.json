  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large pot over medium heat. Sauté the onion and garlic until tender."
    },
    {
      "step": 2,
      "text": "Add the beef and cook briefly, stirring to coat. Pour in the water and bring the soup to a boil."
    },
    {
      "step": 3,
      "text": "Reduce the heat, cover, and simmer until the beef is tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Add the tomatoes and green beans, then cook until the beans begin to soften.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir in the bok choy, broccoli, and tamarind soup base. Simmer until the vegetables are tender and the beef reaches 145°F internally; rest the beef for 3 minutes before serving.",
      "timer_minutes": 10
    }
  ],
