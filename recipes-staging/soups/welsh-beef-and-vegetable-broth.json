  "instructions": [
    {
      "step": 1,
      "text": "Bring the water to a simmer in a large pot. Add the beef shank and simmer for 120 minutes, until tender and at least 145°F internally; rest the meat for 3 minutes.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Cool the beef and broth, then refrigerate overnight."
    },
    {
      "step": 3,
      "text": "Remove the beef, cut it into pieces, and return it to the pot. Prepare the remaining vegetables as listed."
    },
    {
      "step": 4,
      "text": "Bring the broth back to a simmer. Add the onions, carrots, and rutabaga, then season with salt and pepper."
    },
    {
      "step": 5,
      "text": "Simmer until the vegetables begin to soften.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Add the potatoes and cook until tender.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Stir in the cabbage, leeks, and parsley. Simmer until the cabbage is tender, then serve hot.",
      "timer_minutes": 10
    }
  ],
