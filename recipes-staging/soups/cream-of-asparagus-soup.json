  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large pot over medium heat. Add the asparagus, onion, and salt; cook, stirring, for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the chicken broth and water. Bring to a simmer, then cook until the asparagus is tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Remove from the heat and let the soup cool for 10 minutes before blending.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Blend the soup in batches until smooth, using care with the hot liquid. If the broth contains poultry pieces or raw poultry ingredients, verify the soup reaches 165°F.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Season with cayenne, black pepper, nutmeg, and additional salt as needed."
    },
    {
      "step": 6,
      "text": "Whisk the cream, Parmigiano-Reggiano, and lemon zest together until slightly thickened, about 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 7,
      "text": "Whisk the cream mixture into the blended soup, then stir in the remaining cayenne, black pepper, and lemon zest. Serve warm."
    }
  ],
