  "id": "cream-of-asparagus-soup",
  "name": "Cream of Asparagus Soup",
  "subtitle": "A smooth asparagus soup finished with cream, lemon, and cheese.",
  "description": "Cook asparagus with onion and broth, blend until smooth, then finish with seasoned cream and a lemony cheese mixture.",
  "meal_type": "soup",
