  "instructions": [
    {
      "step": 1,
      "text": "Melt half the butter in a large pot over medium heat. Add the ham and cook until lightly browned, about 4 minutes, turning as needed. Transfer the ham to a plate.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Add the remaining butter to the pot. Stir in the onion, carrots, and garlic; cook until the onion softens, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the undrained beans, ham, water, bay leaves, salt, and pepper. Add enough water to keep the ingredients covered as needed."
    },
    {
      "step": 4,
      "text": "Bring the soup to a boil, then reduce the heat and simmer for 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Remove the ham and bay leaves. Cut the ham from the bone, return the meat to the pot, and serve hot."
    }
  ],
