  "id": "ham-and-great-northern-bean-soup",
  "name": "Ham and Great Northern Bean Soup",
  "subtitle": "A hearty bean soup with browned ham and tender vegetables",
  "description": "Fully cooked ham, beans, onion, and carrots simmer together for a comforting soup with savory depth.",
  "meal_type": "soup",
  "cuisine": "American",
