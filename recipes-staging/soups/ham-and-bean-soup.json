  "instructions": [
    {
      "step": 1,
      "text": "Place the beans in a bowl, cover with the water, and let them soak for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Drain the beans and transfer them to a large pot. Add the ham hocks, celery, onion, carrot, garlic, thyme, black pepper, bay leaf, and the measured water."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer, then cook gently until the beans are tender and the ham is fully cooked; check the ham hocks with a thermometer and ensure they reach at least 145°F, then rest them for 3 minutes.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Remove the ham hocks and bay leaf. Pull the meat from the bones, cut it into bite-size pieces, and return the meat to the pot."
    },
    {
      "step": 5,
      "text": "Adjust the soup’s consistency by simmering briefly if needed, then serve hot."
    }
  ],
