  "id": "zucchini-potato-soup",
  "name": "Zucchini Potato Soup",
  "subtitle": "A smooth herb-seasoned soup with zucchini and potatoes",
  "description": "Sautéed onions, zucchini, and potatoes simmer with herbs and broth, then blend with milk for a smooth, comforting soup.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
