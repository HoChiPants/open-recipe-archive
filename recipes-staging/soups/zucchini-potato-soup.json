  "instructions": [
    {
      "step": 1,
      "text": "Melt the margarine in a large pot over medium heat. Add the onions and cook until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the potatoes, zucchinis, basil, thyme, rosemary, white pepper, and dry potato flakes. Stir to coat, then pour in the chicken broth."
    },
    {
      "step": 3,
      "text": "Bring to a simmer and cook until the potatoes and zucchini are tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Blend the soup until smooth using an immersion blender or countertop blender."
    },
    {
      "step": 5,
      "text": "Stir in the milk and heat until boiling. Verify the soup reaches 165°F with a food thermometer before serving."
    },
    {
      "step": 6,
      "text": "Stir in the soy sauce, ladle into bowls, and garnish with the chopped dill."
    }
  ],
