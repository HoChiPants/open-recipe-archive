  "id": "chicken-paprikash-8be11a2c",
  "name": "Chicken Paprikash",
  "subtitle": "Paprika-braised chicken with peppers and cream",
  "description": "Chicken thighs simmer with onions, peppers, tomatoes, and paprika until tender, then finish with soured cream and a choice of starch.",
  "meal_type": "soup",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "skin-on",
      "item": "skin-on",
      "quantity": 8,
      "preparation": "bone-in chicken thighs"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "onions-finely-chopped",
      "item": "onions finely chopped",
      "quantity": 2
    },
    {
      "ingredient_id": "red-or-green-peppers-or-a-mixture-chopped",
      "item": "red or green peppers (or a mixture) chopped",
      "quantity": 2
    },
    {
      "ingredient_id": "garlic-cloves-crushed-or-finely-grated",
      "item": "garlic cloves crushed or finely grated",
      "quantity": 2
    },
    {
      "ingredient_id": "ripe-tomatoes-around-400g",
      "item": "ripe tomatoes (around 400g)",
      "quantity": 3,
      "unit": "large",
      "preparation": "deseeded and chopped, or a 400g can chopped tomatoes"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": "1 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "sweet-smoked-paprika",
      "item": "sweet smoked paprika",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "hot-paprika",
      "item": "hot paprika (optional)",
      "quantity": 1,
      "unit": "tbsp",
      "optional": true
    },
    {
      "ingredient_id": "chicken-stock",
      "item": "chicken stock",
      "quantity": 350,
      "unit": "ml"
    },
    {
      "ingredient_id": "soured-cream",
      "item": "soured cream",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "boiled-potatoes-noodles-or-rice",
      "item": "boiled potatoes noodles or rice",
      "preparation": "to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the chicken stock in a saucepan over low heat while preparing the sauce.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large heavy pot over medium heat for 8 minutes. Add the chicken thighs and onions, and sauté until the onions soften and the chicken is lightly browned.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the peppers, garlic, and tomatoes. Stir and cook until the vegetables begin to soften.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Cook the tomato mixture until slightly reduced, then stir in the flour, sweet smoked paprika, and hot paprika, if using.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Pour in the warm chicken stock and bring the mixture to a gentle simmer."
    },
    {
      "step": 6,
      "text": "Cover partially and simmer until the sauce thickens and the chicken is cooked through. Check that the thickest thigh reaches 165°F on a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Whisk in the soured cream and cook until the sauce is thick and smooth.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Serve with boiled potatoes, noodles, or rice."
    }
  ],
