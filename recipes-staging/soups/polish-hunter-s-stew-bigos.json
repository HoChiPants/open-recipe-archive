  "id": "polish-hunter-s-stew-bigos",
  "name": "Polish Hunter's Stew (Bigos)",
  "subtitle": "A hearty cabbage stew with mushrooms, smoked meats, prunes, and wine",
  "description": "Slow-cooked cabbage combines with mushrooms, sausages, bacon, meat, fruit, and warming spices for a rich, savory stew.",
  "meal_type": "soup",
  "cuisine": "Polish",
  "yield": {
