  "instructions": [
    {
      "step": 1,
      "text": "Place the cabbage and beef stock in a large pot. Cover and cook over medium-low heat until the cabbage is tender.",
      "timer_minutes": 50
    },
    {
      "step": 2,
      "text": "Drain the soaked mushrooms and slice them."
    },
    {
      "step": 3,
      "text": "Heat the lard in the pot. Add the sliced sausages and bacon, and sauté until lightly browned.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Stir in the mushrooms, onions, diced cooked meat, prunes, bay leaf, cloves, peppercorns, juniper berries, and allspice berries. Cook until the onions soften.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Add the red wine and tomato purée. Stir well, cover, and simmer until the stew is deeply flavored and cohesive.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Let the stew cool briefly, then reheat until steaming before serving. If any meat was not fully cooked, verify a safe internal temperature with a thermometer: 160°F for sausage or ground meat, or 145°F for whole-cut beef, pork, or game followed by a 3-minute rest."
    }
  ],
