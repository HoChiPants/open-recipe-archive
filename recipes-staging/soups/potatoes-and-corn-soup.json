  "id": "potatoes-and-corn-soup",
  "name": "Potatoes and Corn Soup",
  "subtitle": "A simple vegetable soup with tender potatoes, corn, and fresh chives.",
  "description": "Potatoes, celery, onion, and corn simmer together for a comforting soup finished with chives.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 6,
      "unit": "medium",
      "preparation": "peeled and cubed"
    },
    {
      "ingredient_id": "stalks-celery",
      "item": "stalks celery",
      "quantity": 6,
      "preparation": "chopped, leaves reserved"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "medium",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cubes-chicken-bouillon",
      "item": "cubes chicken bouillon",
      "quantity": 2
    },
    {
      "ingredient_id": "whole-kernel-corn",
      "item": "whole kernel corn",
      "quantity": 2,
      "unit": "can",
      "preparation": "15.25 ounce, drained"
    },
    {
      "ingredient_id": "fresh-chives",
      "item": "fresh chives",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes, celery, and onion in a large pot. Add the cooking liquid needed to cover the vegetables and stir in the bouillon cubes."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a simmer, then cook until the potatoes are tender, about 20 minutes. For safety, ensure the soup reaches at least 165°F if any raw animal protein or egg is present.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Stir in the drained corn and reserved celery leaves, then warm through for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Remove from the heat, fold in the chives, and serve hot."
    }
  ],
