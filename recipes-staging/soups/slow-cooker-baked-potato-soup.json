  "id": "slow-cooker-baked-potato-soup",
  "name": "Slow Cooker Baked Potato Soup",
  "subtitle": "A hearty potato soup with bacon, cheddar, and green onion",
  "description": "Cubed red potatoes simmer with savory seasonings, bacon, onion, and garlic before being finished with half-and-half and cheddar.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
