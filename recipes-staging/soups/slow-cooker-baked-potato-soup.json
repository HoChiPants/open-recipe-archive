  "instructions": [
    {
      "step": 1,
      "text": "Place the cubed potatoes in the slow cooker and toss them with the flour until coated."
    },
    {
      "step": 2,
      "text": "Add the bacon bits, red onion, garlic, bouillon, dressing mix, parsley, seasoned salt, pepper, and green onion. Pour in the water and stir."
    },
    {
      "step": 3,
      "text": "Cover and cook until the potatoes are tender, about 7 hours 15 minutes.",
      "timer_minutes": 435
    },
    {
      "step": 4,
      "text": "Stir in the half-and-half, cover, and cook for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Check the soup with a food thermometer and confirm it reaches 165°F before serving. Top with cheddar cheese and additional green onion as desired."
    }
  ],
