      "item": "bay leaf",
      "quantity": 1
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Toss the cauliflower florets, shallots, and garlic with the olive oil, then spread them in a roasting pan."
    },
    {
      "step": 2,
      "text": "Roast until the vegetables are tender and lightly browned, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Transfer the roasted cauliflower mixture to a large pot. Add the chicken broth, water, dried thyme, and bay leaf."
    },
    {
      "step": 4,
      "text": "Bring to a simmer and cook for 30 minutes, or until the soup reaches at least 165°F.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Remove and discard the bay leaf. Blend the soup until smooth."
    },
    {
      "step": 6,
      "text": "Whisk in the heavy cream and season with salt and pepper to taste. Warm gently before serving."
    }
  ],
