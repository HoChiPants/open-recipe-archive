      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
