  "id": "creamy-roasted-cauliflower-soup",
  "name": "Creamy Roasted Cauliflower Soup",
  "subtitle": "Roasted cauliflower blended into a smooth, comforting soup.",
  "description": "Cauliflower, shallots, and garlic are roasted, simmered with broth and herbs, then finished with cream for a rich blended soup.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "heads-cauliflower",
      "item": "heads cauliflower",
      "quantity": 2,
      "preparation": "separated into florets"
    },
    {
      "ingredient_id": "shallots",
      "item": "shallots",
      "quantity": 2,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "chopped"
    },
    {
