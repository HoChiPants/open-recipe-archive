  "instructions": [
    {
      "step": 1,
      "text": "Heat the rapeseed oil in a large pot over medium heat. Add the onions and cook until softened.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the garlic, carrots, smoked paprika, ground coriander, thyme, and red lentils."
    },
    {
      "step": 3,
      "text": "Pour in the boiling vegetable stock. Bring to a simmer, cover, and cook until the carrots and lentils are tender.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Blend the soup until smooth, then stir in the chickpeas and heat through."
    },
    {
      "step": 5,
      "text": "Ladle into bowls and top with the crumbled feta."
    }
  ],
