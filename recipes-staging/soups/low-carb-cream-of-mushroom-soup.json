      "item": "dried thyme",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "32-ounce-carton-chicken-broth",
      "item": "(32 ounce) carton chicken broth",
      "quantity": 1
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "4 ounce"
