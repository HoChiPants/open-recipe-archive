  "id": "low-carb-cream-of-mushroom-soup",
  "name": "Low-Carb Cream of Mushroom Soup",
  "subtitle": "A rich mushroom soup with thyme and sherry",
  "description": "Mushrooms, onion, garlic, cream, and cream cheese create a smooth, savory soup finished with a touch of sherry.",
  "meal_type": "soup",
  "cuisine": "French",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
