  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large pot over medium heat."
    },
    {
      "step": 2,
      "text": "Add the mushrooms, onion, and garlic. Cook for 10 minutes, stirring occasionally, until tender.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the salt, pepper, and thyme."
    },
    {
      "step": 4,
      "text": "Whisk in the chicken broth, heavy whipping cream, and cream cheese until smooth."
    },
    {
      "step": 5,
      "text": "Bring the soup to a gentle simmer and heat to at least 165°F throughout."
    },
    {
      "step": 6,
      "text": "Whisk in the remaining heavy whipping cream, cream cheese, and sherry, then cook gently for 45 minutes.",
      "timer_minutes": 45
    }
  ],
