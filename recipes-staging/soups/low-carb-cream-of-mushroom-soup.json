  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "coarsely-chopped-fresh-mushrooms",
      "item": "coarsely chopped fresh mushrooms",
      "quantity": 5,
      "unit": "cups"
    },
    {
      "ingredient_id": "finely-chopped-onion",
      "item": "finely chopped onion",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
