  "instructions": [
    {
      "step": 1,
      "text": "Heat the coconut oil in a large pot over medium heat. Add the onions and garlic; cook, stirring, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the vegetable broth, curry powder, salt, ground coriander, and red pepper flakes. Cook for 10 minutes, stirring occasionally.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the pumpkin and coconut milk, whisking until smooth. Bring the soup to a gentle simmer and cook for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Blend the soup until smooth, then return it to the pot and cook for 5 minutes. Serve hot.",
      "timer_minutes": 5
    }
  ],
