  "id": "roasted-garlic-soup",
  "name": "Roasted Garlic Soup",
  "subtitle": "A smooth, savory soup with roasted garlic and herbs",
  "description": "Roasted garlic, leeks, and onion form the base of this creamy soup, finished with sherry, lemon, white pepper, and chives.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
