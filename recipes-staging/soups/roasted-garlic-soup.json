  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Trim the tops from the garlic bulbs, place them in a baking dish, and coat with the olive oil."
    },
    {
      "step": 2,
      "text": "Bake the garlic for 60 minutes, until soft and lightly browned. Cool, then squeeze the cloves from their skins.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Melt the butter in a large pot. Add the roasted garlic, leeks, and onion; sauté for 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Stir in the flour and cook for 10 minutes, stirring frequently.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Add the chicken broth and sherry. Bring to a simmer and cook for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Cool the soup briefly, then blend until smooth. Whisk in the heavy cream and return the soup to a simmer for 10 minutes, until thickened. If using broth containing uncooked poultry, verify the soup reaches 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Season with lemon juice, salt to taste, and white pepper. Serve garnished with the chives."
    }
  ],
