  "id": "chicken-squash-and-chickpea-stew",
  "name": "Chicken, Squash and Chickpea Stew",
  "subtitle": "A hearty one-pot stew with a spicy yogurt finish",
  "description": "Chicken, squash, and chickpeas simmer together with rosemary and tomato, then are finished with harissa yogurt, toasted almonds, and coriander.",
  "meal_type": "soup",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
