  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large heavy pot. Brown the chicken skin-side down and on the other sides until golden, about 10 minutes. Transfer it to a plate.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Cook the onion in the same pot for 5 minutes. Add the garlic, rosemary, and tomato purée, then stir for 8 minutes.",
      "timer_minutes": 13
    },
    {
      "step": 3,
      "text": "Add the squash, bay leaves, chickpeas, and browned chicken. Cover and cook gently for 45 minutes, until the squash is tender and the chicken reaches 165°F at the thickest point.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "Remove the bay leaves. Blend part of the squash and chickpeas into the cooking juices until the stew is thick, keeping the chicken pieces intact. Cook for 10 minutes more.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir the yogurt and harissa together. Serve the stew with the harissa yogurt, toasted almonds, and coriander leaves."
    }
  ],
