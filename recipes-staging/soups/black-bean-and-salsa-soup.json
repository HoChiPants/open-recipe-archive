  "id": "black-bean-and-salsa-soup",
  "name": "Black Bean and Salsa Soup",
  "subtitle": "A smooth, savory bean soup with a cool onion cream topping.",
  "description": "Blend black beans, broth, salsa, and cumin into a smooth soup, warm it through, and finish each serving with sour cream and green onion.",
  "meal_type": "soup",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "black-beans",
      "item": "black beans",
      "quantity": 2,
      "unit": "can",
      "preparation": "15 ounce, drained and rinsed"
    },
    {
      "ingredient_id": "vegetable-broth",
      "item": "vegetable broth",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "chunky-salsa",
      "item": "chunky salsa",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "thinly-sliced-green-onion",
      "item": "thinly sliced green onion",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a saucepan over medium heat. Combine the black beans, vegetable broth, chunky salsa, and ground cumin in the pan."
    },
    {
      "step": 2,
      "text": "Blend the mixture until smooth, using an immersion blender or working carefully in batches with a countertop blender."
    },
    {
      "step": 3,
      "text": "Warm the soup over medium heat until heated through, stirring occasionally, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Whisk the sour cream and green onion together. Divide the soup among bowls and top with the sour-cream mixture."
    }
  ],
