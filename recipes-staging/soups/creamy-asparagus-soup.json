  "id": "creamy-asparagus-soup",
  "name": "Creamy Asparagus Soup",
  "subtitle": "A quick, smooth soup with a buttery finish",
  "description": "Blend canned asparagus, broth, and milk into a warm, simple soup seasoned with butter, salt, and pepper.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "asparagus-spears",
      "item": "asparagus spears",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, undrained"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.5 ounce"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Blend the undrained asparagus until smooth, then transfer it to a saucepan."
    },
    {
      "step": 2,
      "text": "Add the chicken broth and milk. Heat gently, stirring occasionally, until the soup reaches 165°F."
    },
    {
      "step": 3,
      "text": "Stir in the butter, then season with salt and pepper to taste. Serve hot."
    }
  ],
