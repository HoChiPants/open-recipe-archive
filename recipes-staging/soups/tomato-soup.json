  "id": "tomato-soup",
  "name": "Tomato Soup",
  "subtitle": "A smooth, savory tomato soup with a lightly creamy finish.",
  "description": "Tomatoes, vegetables, broth, and herbs simmer together before being finished with a simple milk thickener.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
