  "instructions": [
    {
      "step": 1,
      "text": "Place the carrots and onion in a large pot. Add the tomatoes, chicken broth, white sugar, sea salt, dried basil, celery salt, ground black pepper, and garlic powder."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a simmer, then cook gently for 60 minutes, stirring occasionally, until the vegetables are tender.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Melt the butter in a separate saucepan over medium heat. Whisk in the flour and cook until smooth and thick."
    },
    {
      "step": 4,
      "text": "Gradually add the milk, whisking constantly. Cook for 5 minutes, until thickened.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir the milk mixture into the soup and continue heating until a thermometer registers 165°F throughout."
    },
    {
      "step": 6,
      "text": "Taste and adjust seasoning only if needed, then serve hot."
    }
  ],
