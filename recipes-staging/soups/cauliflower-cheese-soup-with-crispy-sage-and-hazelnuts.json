  "instructions": [
    {
      "step": 1,
      "text": "Heat the 2 tablespoons of rapeseed oil in a large pot. Add the onion and cook until softened."
    },
    {
      "step": 2,
      "text": "Add the stock cube, cauliflower, butter beans, milk, water, and a little grated nutmeg. Bring to a simmer and cook until the cauliflower is tender.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Blend the soup until smooth. Stir in the Dijon mustard, cheddar, and cream until combined and warmed through."
    },
    {
      "step": 4,
      "text": "Heat the extra rapeseed oil in a small pan. Add the sage leaves and cook until crisp, then stir in the toasted hazelnuts."
    },
    {
      "step": 5,
      "text": "Ladle the soup into bowls and spoon the crispy sage and hazelnuts over the top."
    }
  ],
