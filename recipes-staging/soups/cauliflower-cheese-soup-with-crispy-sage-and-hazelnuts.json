  "id": "cauliflower-cheese-soup-with-crispy-sage-and-hazelnuts",
  "name": "Cauliflower Cheese Soup with Crispy Sage and Hazelnuts",
  "subtitle": "A creamy cauliflower soup finished with cheddar, sage, and toasted hazelnuts.",
  "description": "Blend cauliflower and butter beans into a smooth, cheesy soup, then top each serving with crisp sage and toasted hazelnuts.",
  "meal_type": "soup",
