  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large saucepan. Add the onions and celery, and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the garlic and thyme; cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the carrots, parsnips, and vegetable stock. Bring to a simmer and cook until the vegetables are tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Blend the soup until smooth, then whisk in the double cream until combined."
    },
    {
      "step": 5,
      "text": "Ladle into bowls and garnish with the chopped parsley, if using."
    }
  ],
