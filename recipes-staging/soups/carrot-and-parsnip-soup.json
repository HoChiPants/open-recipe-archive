  "id": "carrot-and-parsnip-soup",
  "name": "Carrot and Parsnip Soup",
  "subtitle": "A smooth, creamy root-vegetable soup",
  "description": "Sautéed aromatics, carrots, and parsnips are simmered in vegetable stock, blended smooth, and finished with cream and parsley.",
  "meal_type": "soup",
  "yield": {
    "quantity": 6,
    "unit": "servings"
