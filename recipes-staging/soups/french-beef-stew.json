{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "french-beef-stew",
  "name": "French Beef Stew",
  "subtitle": "A hearty stew with tender beef, vegetables, and thyme",
  "description": "Flour-coated beef simmers with tomatoes, broth, carrots, potatoes, and thyme, then gets a savory mustard finish.",
  "meal_type": "soup",
  "cuisine": "French",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "beef-stew-meat",
      "item": "beef stew meat",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "italian-style-diced-tomatoes",
      "item": "Italian-style diced tomatoes",
      "quantity": 2,
      "unit": "can",
      "preparation": "14.5 ounce"
    },
    {
      "ingredient_id": "beef-broth",
      "item": "beef broth",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 4,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 2,
      "preparation": "peeled and chopped"
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dijon-style-prepared-mustard",
      "item": "Dijon-style prepared mustard",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Toss the cubed beef with the flour until evenly coated."
    },
    {
      "step": 2,
      "text": "Heat the oil in a large pot over medium-high heat. Add the beef and brown briefly, then pour in the beef broth and season with salt and pepper.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the tomatoes, carrots, potatoes, and thyme."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a simmer, cover, and cook until the vegetables are tender and the beef is tender and reaches at least 145°F; rest the beef for 3 minutes before serving.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Stir in the mustard just before serving."
    }
  ],
