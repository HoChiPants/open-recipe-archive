  "id": "chicken-enchiladas-ee231d4f",
  "name": "Chicken Enchiladas",
  "subtitle": "Creamy chicken enchiladas with green chiles",
  "description": "Soft flour tortillas are filled with seasoned chicken and green chiles, covered in a creamy sauce, and baked with Cheddar until lightly browned.",
  "meal_type": "soup",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
