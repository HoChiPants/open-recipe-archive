      "item": "green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "4 ounce, chopped, drained"
    },
    {
      "ingredient_id": "8-inch-flour-tortillas",
      "item": "(8 inch) flour tortillas",
      "quantity": 8
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Stir the condensed soup and sour cream together in a bowl."
    },
    {
      "step": 2,
      "text": "Melt the margarine in a skillet over medium heat. Add the onion and chili powder, and cook until the onion is tender."
    },
    {
      "step": 3,
      "text": "Stir in the chicken, green chiles, and enough of the soup mixture to coat the filling; heat until combined."
    },
    {
      "step": 4,
      "text": "Spread some remaining soup mixture in a baking dish. Spoon the chicken mixture into the tortillas, roll them up, and arrange them seam-side down in the dish."
    },
    {
      "step": 5,
      "text": "Cover the enchiladas with the remaining soup mixture and sprinkle with the Cheddar cheese."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until lightly browned and the center reaches 165°F.",
      "timer_minutes": 25
    }
  ],
