      "item": "chili powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "chicken-breast",
      "item": "chicken breast",
      "quantity": 2,
      "unit": "cups",
      "preparation": "chopped cooked"
    },
    {
