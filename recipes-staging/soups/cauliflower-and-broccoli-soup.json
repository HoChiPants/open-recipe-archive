  "instructions": [
    {
      "step": 1,
      "text": "Separate the cauliflower and broccoli into bite-size pieces. Keep the chopped onion, celery, carrots, and garlic ready."
    },
    {
      "step": 2,
      "text": "Heat 2 tbsp oil in a large pot. Add the onion, celery, carrots, garlic, cumin, and coriander; cook gently for 10 minutes until softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Pour in the vegetable stock, then add the cauliflower and broccoli. Bring to a simmer and cook for 10 minutes, until the vegetables are tender.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Blend the soup carefully in batches until smooth and thick, allowing it to cool slightly first if using a sealed blender. Return it to the pot and warm gently if needed."
    },
    {
      "step": 5,
      "text": "Heat 2 tsp oil in a small pan. Add the breadcrumbs, mixed seeds, and chilli flakes; stir for 5 minutes until crisp and lightly browned.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Ladle the soup into bowls and top with the toasted crumb mixture and grated parmesan or vegetarian alternative."
    }
  ],
