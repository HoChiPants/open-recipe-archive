  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken with salt and pepper. Set the red bell pepper and chicken broth nearby."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large pot over medium heat. Add the onion and garlic; stir and cook until the onion begins to soften.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the chicken broth and chicken. Bring to a simmer and cook briefly.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the serrano chile, cilantro, green peas, corn, and red bell pepper; cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Add the potatoes and uncooked rice. Simmer until the potatoes and rice are tender and the chicken reaches 165°F in the thickest part.",
      "timer_minutes": 40
    }
  ],
