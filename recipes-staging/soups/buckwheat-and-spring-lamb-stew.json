  "id": "buckwheat-and-spring-lamb-stew",
  "name": "Buckwheat and Spring Lamb Stew",
  "subtitle": "A slow-simmered lamb stew with buckwheat and spring vegetables.",
  "description": "Browned lamb, leeks, carrots, and buckwheat cook in a herb-scented wine and vegetable-stock base until tender, then finish with lemon and parsley.",
  "meal_type": "soup",
