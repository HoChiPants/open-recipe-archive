  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large heavy pot over medium-high heat. Add the lamb and brown, turning occasionally, for 5 minutes. Transfer the lamb to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Lower the heat to medium. Add the onion and leeks and cook until softened, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Add the carrots and half of the garlic; cook for 1 minute. Stir in the flour and cook for 2 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Return the lamb to the pot. Add the thyme sprigs, bay leaf, wine, and stock, then stir to combine."
    },
    {
      "step": 5,
      "text": "Bring to a gentle simmer, cover, and cook until the lamb is tender and reaches at least 145°F, followed by a 3-minute rest, about 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 6,
      "text": "Stir in the buckwheat and cook until tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Combine the remaining garlic, thyme leaves, lemon zest, and parsley. Remove the bay leaf and thyme stems, then stir in the lemon-parsley mixture and serve."
    }
  ],
