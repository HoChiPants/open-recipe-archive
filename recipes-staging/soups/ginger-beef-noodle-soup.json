  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a pot over medium-high heat for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Season the round steak with the onion powder and garlic powder. Add the steak and chopped onion to the pot and cook, stirring, for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Pour in the beef broth. Stir in the brown sugar, soy sauce, ground ginger, and sriracha, then bring the broth to a simmer."
    },
    {
      "step": 4,
      "text": "Add the rice noodles, carrots, cabbage, bell peppers, and celery."
    },
    {
      "step": 5,
      "text": "Simmer until the noodles are tender and the beef reaches 145°F in the thickest pieces. Remove from the heat and rest the beef for 3 minutes before serving.",
      "timer_minutes": 8
    }
  ],
