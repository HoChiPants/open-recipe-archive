  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, salt, ground black pepper, garlic powder, dried parsley, onion powder, chicken bouillon cubes, onion, garlic, and chili powder in a large pot. Bring to a boil, add the chicken, then reduce the heat and cook until the thickest piece reaches 165°F, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Transfer the chicken to a plate, shred it when cool enough to handle, and reserve the cooking liquid."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a large pot over medium heat. Add the garlic powder, onion powder, chopped onion, and chopped garlic; cook until the aromatics soften."
    },
    {
      "step": 4,
      "text": "Stir in the salsa, diced tomatoes, whole peeled tomatoes, condensed tomato soup, chili powder, corn, chili beans, shredded chicken, and reserved cooking liquid. Bring to a gentle simmer and cook for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Stir in the sour cream until combined, then serve hot."
    }
  ],
