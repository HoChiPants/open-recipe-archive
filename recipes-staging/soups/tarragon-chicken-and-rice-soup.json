  "instructions": [
    {
      "step": 1,
      "text": "Bring the water to a boil in a large pot. Stir in the chicken soup base, tarragon, basil, and black pepper."
    },
    {
      "step": 2,
      "text": "Add the chicken and rice. Return to a boil, then reduce the heat and simmer for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Remove the chicken while the soup continues simmering. Cut it into bite-size pieces."
    },
    {
      "step": 4,
      "text": "Return the chicken to the pot and add the onion, carrots, celery, and garlic. Simmer until the rice and vegetables are tender and the chicken reaches 165°F internally, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Add water as needed to reach the desired soup consistency, then adjust the seasoning to taste."
    }
  ],
