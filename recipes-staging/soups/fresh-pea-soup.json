  "id": "fresh-pea-soup",
  "name": "Fresh Pea Soup",
  "subtitle": "A smooth, lightly seasoned soup with sweet green peas and cream.",
  "description": "Sautéed shallots and tender peas are blended into a simple soup finished with cream.",
  "meal_type": "soup",
  "cuisine": "French",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 12
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "shallots",
      "item": "shallots",
      "quantity": 2,
      "unit": "medium",
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "fresh-shelled-green-peas",
      "item": "fresh shelled green peas",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "whipping-cream",
      "item": "whipping cream",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Add the shallots and cook for 3 minutes, stirring, until softened.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the water, peas, and salt and pepper. Bring to a simmer and cook until the peas are tender, about 18 minutes.",
      "timer_minutes": 18
    },
    {
      "step": 4,
      "text": "Blend the soup until smooth, then return it to the saucepan if needed."
    },
    {
      "step": 5,
      "text": "Warm the whipping cream gently, stir it into the soup, and adjust the seasoning before serving."
    }
  ],
