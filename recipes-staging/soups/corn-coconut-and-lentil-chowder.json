  "instructions": [
    {
      "step": 1,
      "text": "Heat the rapeseed oil in a large pot. Add the onions and half the curry powder, then cook until softened.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Stir in the garlic, chillies, cumin seeds, turmeric, red lentils, stock, sweetcorn, potatoes, and remaining curry powder."
    },
    {
      "step": 3,
      "text": "Bring to a simmer and cook until the lentils are tender and the potatoes can be easily pierced.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Blend part or all of the soup until it reaches the desired smoothness."
    },
    {
      "step": 5,
      "text": "Stir in the coconut yogurt and chopped coriander. Warm gently without boiling, then serve."
    }
  ],
