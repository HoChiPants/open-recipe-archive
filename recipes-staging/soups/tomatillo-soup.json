  "id": "tomatillo-soup",
  "name": "Tomatillo Soup",
  "subtitle": "Bright Mexican-style soup with shredded chicken",
  "description": "Chicken, tomatillos, jalapeños, and cilantro simmer together in a savory broth, finished with sour cream for a creamy tang.",
  "meal_type": "soup",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
