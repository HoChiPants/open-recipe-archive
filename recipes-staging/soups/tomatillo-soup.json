    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. Add the onion and garlic and cook until softened, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Add the tomatillos, jalapeños, chicken stock, hot pepper sauce, cayenne, salt, and black pepper. Bring to a simmer.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the chicken, cover, and simmer until cooked through and the thickest part reaches 165°F, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Transfer the chicken to a plate and shred it when cool enough to handle. Return the shredded chicken to the pot and stir to combine."
    },
    {
      "step": 5,
      "text": "Stir in the cilantro and adjust the salt, black pepper, hot pepper sauce, and cayenne to taste."
    },
    {
      "step": 6,
      "text": "Whisk the sour cream with a small amount of hot soup until smooth, then stir the mixture into the pot and serve."
    }
  ],
