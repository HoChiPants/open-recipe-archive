  "id": "cheesy-potato-soup",
  "name": "Cheesy Potato Soup",
  "subtitle": "A creamy potato soup with tender vegetables and melted cheese.",
  "description": "Potatoes, onions, and celery simmer in a buttery broth, then finish with cheese, milk, flour, and parsley for a hearty soup.",
  "meal_type": "soup",
  "cuisine": "American",
