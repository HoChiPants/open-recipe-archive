  "instructions": [
    {
      "step": 1,
      "text": "Heat the butter in a large soup pot. Add the onions and celery, and cook until tender.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Pour in the water and add the potatoes. Bring to a simmer and cook until the potatoes are tender."
    },
    {
      "step": 3,
      "text": "Stir in the broken cheese pieces until melted."
    },
    {
      "step": 4,
      "text": "Whisk the milk and flour together, then transfer the mixture to the pot and stir to combine."
    },
    {
      "step": 5,
      "text": "Cook the soup until thickened, stirring occasionally. Ladle into bowls and garnish with parsley.",
      "timer_minutes": 5
    }
  ],
