  "instructions": [
    {
      "step": 1,
      "text": "Rinse and drain the bean mix; discard the seasoning packet."
    },
    {
      "step": 2,
      "text": "Add the broth, beans, tomatoes, onion, carrots, celery, garlic, salt, smoked paprika, and pepper to the pressure cooker. Stir to combine."
    },
    {
      "step": 3,
      "text": "Lock the lid and cook at high pressure for 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "Let the pressure release naturally for 15 minutes, then release any remaining pressure according to the cooker’s instructions.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Open the cooker carefully and stir the soup. Serve hot."
    }
  ],
