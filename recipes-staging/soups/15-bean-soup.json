  "id": "15-bean-soup",
  "name": "15-Bean Soup",
  "subtitle": "A hearty pressure-cooked bean soup with vegetables and smoky spice.",
  "description": "Tender mixed beans simmer with tomatoes, aromatics, and vegetables for a filling, savory soup.",
  "meal_type": "soup",
