  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Toss the parsnips and carrots with the olive oil, salt, pepper, and cayenne, and arrange them on a baking sheet."
    },
    {
      "step": 2,
      "text": "Roast the vegetables until tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Melt the butter in a large pot over medium heat. Add the onion, celery, and brown sugar; cook until golden brown, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the roasted vegetables and garlic, then cook for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Add the ginger, cardamom, allspice, nutmeg, cayenne, salt, and pepper. Stir for 1 minute, then pour in the chicken stock.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Bring the mixture to a simmer and cook for 10 minutes, or until it reaches 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Blend the soup until smooth. Whisk in the milk and heavy cream, warm through, and adjust the seasoning before serving."
    }
  ],
