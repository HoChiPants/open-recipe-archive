  "id": "chicken-corn-soup",
  "name": "Chicken Corn Soup",
  "subtitle": "A simple chicken and corn soup with a light, silky finish.",
  "description": "Combine broth, corn, cooked chicken, seasoning, and a cornstarch slurry, then finish the hot soup with sesame oil and egg white.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 2,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "cream-style-corn",
      "item": "cream-style corn",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.75 ounce"
    },
    {
      "ingredient_id": "shredded",
      "item": "shredded",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "cooked chicken meat"
    },
    {
      "ingredient_id": "ground-white-pepper",
      "item": "ground white pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the chicken broth and cream-style corn in a pot. Add the ground white pepper and salt to taste."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a simmer, then stir in the shredded cooked chicken meat."
    },
    {
      "step": 3,
      "text": "Whisk the cornstarch and water together in a separate bowl. Stir the slurry into the simmering soup and continue stirring until the soup reaches a boil and thickens."
    },
    {
      "step": 4,
      "text": "Stir in the sesame oil."
    },
    {
      "step": 5,
      "text": "Beat the egg white lightly, then add it gradually to the boiling soup while stirring. Cook until the egg white is fully set and the soup reaches at least 160°F."
    },
    {
      "step": 6,
      "text": "If using uncooked chicken by substitution, cook the soup until the chicken reaches 165°F; otherwise, serve once hot and thickened."
    }
  ],
