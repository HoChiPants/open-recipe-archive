  "instructions": [
    {
      "step": 1,
      "text": "Combine the water and rice in a saucepan. Bring to a simmer, cover, and cook until the rice is tender, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Meanwhile, heat the olive oil in a large pot over medium heat. Add the onion, teaspoon of salt, and half of the green onion; cook for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Stir in the tomato paste, garlic, paprika, cumin, cayenne, and bell pepper. Cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the coconut milk and soy sauce. Bring to a gentle simmer and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the jalapeños and remaining green onion. Add the sea bass and simmer gently until opaque, easily flaked, and 145°F in the thickest piece."
    },
    {
      "step": 6,
      "text": "Remove from the heat. Stir in the pinch of salt, cilantro, and lime juice."
    },
    {
      "step": 7,
      "text": "Serve the stew over the cooked rice."
    }
  ],
