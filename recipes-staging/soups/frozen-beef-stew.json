  "instructions": [
    {
      "step": 1,
      "text": "Set an electric pressure cooker to sauté and heat the avocado oil. Add the onion and garlic; cook, stirring, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Pour in the red wine and simmer for 3 minutes, scraping up any browned bits.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the broth, thyme, parsley, oregano, bay leaf, salt, pepper, and tomato paste. Stir in the frozen beef, potatoes, carrots, and celery."
    },
    {
      "step": 4,
      "text": "Seal the cooker and pressure-cook until the cycle reaches its set endpoint, about 45 minutes. Allow the cooker to release pressure for 15 minutes, then continue with the remaining 10-minute release period.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Open the cooker safely and verify that the beef reaches 145°F in the center; rest it for 3 minutes before serving.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Whisk the water and cornstarch together. Stir the slurry into the stew, return to sauté, and cook until thickened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Remove the bay leaf and serve hot."
    }
  ],
