  "instructions": [
    {
      "step": 1,
      "text": "Bring 4 cups water to a simmer. Add the lima beans and cook for 3 minutes. Remove from the heat, cover, and let stand for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Drain the beans. Heat the olive oil in a large pot, then sauté the carrots, leek, shallots, celery, and bouillon cubes until the vegetables begin to soften."
    },
    {
      "step": 3,
      "text": "Add the drained beans and cook with the vegetables for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add 8 cups water and bring the soup to a boil, stirring until the bouillon dissolves."
    },
    {
      "step": 5,
      "text": "Reduce the heat and simmer until the beans and vegetables are tender, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
