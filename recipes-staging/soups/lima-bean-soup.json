  "id": "lima-bean-soup",
  "name": "Lima Bean Soup",
  "subtitle": "A hearty vegetable soup with tender lima beans",
  "description": "Dry lima beans are soaked, then simmered with sautéed vegetables and vegetable bouillon for a warming soup.",
  "meal_type": "soup",
