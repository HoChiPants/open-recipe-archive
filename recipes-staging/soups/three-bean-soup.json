      "item": "tomatoes with green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce, diced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large pot over medium heat. Add the onion, green bell pepper, yellow bell pepper, and tomatoes with green chile peppers."
    },
    {
      "step": 2,
      "text": "Stir and cook until the vegetables begin to soften.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the chicken broth, black beans, kidney beans, and pinto beans. Stir to combine."
    },
    {
      "step": 4,
      "text": "Cook until the soup is hot and steaming. If the broth contains poultry, use a food thermometer to verify the soup reaches 165°F.",
      "timer_minutes": 15
    }
  ],
