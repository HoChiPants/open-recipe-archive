  "id": "three-bean-soup",
  "name": "Three Bean Soup",
  "subtitle": "A hearty soup of beans, peppers, and tomatoes",
  "description": "A simple American soup that combines three types of beans with sautéed peppers, onion, tomatoes, and broth.",
  "meal_type": "soup",
