  "id": "beef-stew-with-cheese-scone-dumplings",
  "name": "Beef Stew with Cheese Scone Dumplings",
  "subtitle": "A hearty stew topped with tender cheddar dumplings",
  "description": "Warm prepared beef stew with mustard, then finish it with savory cheese scone dumplings and cooked green vegetables.",
  "meal_type": "soup",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
