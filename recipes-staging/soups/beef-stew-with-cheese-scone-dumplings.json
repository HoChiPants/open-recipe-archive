  "instructions": [
    {
      "step": 1,
      "text": "Prepare the beef stew and stir in the Dijon mustard. If the beef is not already fully cooked, use a thermometer: whole cuts should reach 145°F followed by a 3-minute rest; ground beef should reach 160°F."
    },
    {
      "step": 2,
      "text": "Preheat the oven according to the stew recipe. Combine the flour, cayenne, baking powder, and butter, rubbing the butter in until the mixture resembles coarse crumbs."
    },
    {
      "step": 3,
      "text": "Stir in the cheddar and parsley, then add the milk and mix to form a soft dough. Dust the work surface with extra flour, shape the dough into thick dumplings, and top with extra cheddar."
    },
    {
      "step": 4,
      "text": "Transfer the hot stew to an ovenproof dish and arrange the dumplings over the surface."
    },
    {
      "step": 5,
      "text": "Bake until the dumplings are risen, firm, and cooked through, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Let stand for 15 minutes, then serve with the cooked green vegetables.",
      "timer_minutes": 15
    }
  ],
