  "id": "bean-and-halloumi-stew",
  "name": "Bean and Halloumi Stew",
  "subtitle": "A quick, hearty tomato stew for two",
  "description": "Mixed beans and vegetables simmer with tomatoes and pesto, then are finished with golden pan-seared halloumi and fresh coriander.",
  "meal_type": "soup",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
