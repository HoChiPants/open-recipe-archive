  "instructions": [
    {
      "step": 1,
      "text": "Heat 2 tablespoons of the olive oil in a pot over medium heat. Add the onion and red pepper and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the crushed garlic, pesto, and ground coriander; cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the drained beans and chopped tomatoes. Bring to a simmer and cook until hot and slightly thickened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Meanwhile, heat the remaining olive oil in a skillet. Sauté the halloumi slices until golden brown, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Spoon the stew into bowls, top with the halloumi and chopped coriander, and serve with optional garlic bread."
    }
  ],
