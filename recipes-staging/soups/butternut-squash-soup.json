  "instructions": [
    {
      "step": 1,
      "text": "Set the pressure cooker to its sauté setting and heat the olive oil. Add the onion and cook until softened, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Add the garlic and cook for 1 minute, stirring frequently.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Stir in the squash, broth, brown sugar, salt, pepper, ginger, and curry powder."
    },
    {
      "step": 4,
      "text": "Secure the lid and cook at high pressure for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Allow a natural release for 15 minutes, then carefully release any remaining pressure.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Blend the soup until smooth. Stir in the cream and whisk until evenly combined."
    }
  ],
