  "id": "butternut-squash-and-red-pepper-soup",
  "name": "Butternut Squash and Red Pepper Soup",
  "subtitle": "A warmly spiced roasted vegetable soup",
  "description": "Roasted squash, peppers, onion, and garlic are blended with spiced stock and finished with harissa and cream.",
  "meal_type": "soup",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butternut-squash-about-600-700g",
      "item": "butternut squash (about 600-700g)",
      "quantity": 1,
      "unit": "small",
      "preparation": "peeled and cut into chunks"
    },
    {
      "ingredient_id": "red-pepper-roughly-chopped",
      "item": "red pepper roughly chopped",
      "quantity": 2
    },
    {
      "ingredient_id": "red-onion-roughly-chopped",
      "item": "red onion roughly chopped",
      "quantity": 2
    },
    {
      "ingredient_id": "rapeseed-oil",
      "item": "rapeseed oil",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-cloves-in-their-skins",
      "item": "garlic cloves in their skins",
      "quantity": 3
    },
    {
      "ingredient_id": "ground-coriander",
      "item": "ground coriander",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "l-chicken-or-vegetable-stock",
      "item": "l chicken or vegetable stock",
      "quantity": 1.2
    },
    {
      "ingredient_id": "harissa-paste",
      "item": "harissa paste",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 50,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Arrange the squash, peppers, onion, and garlic on a roasting tray. Toss with the oil, coriander, and cumin."
    },
    {
      "step": 3,
      "text": "Roast until the vegetables are tender and lightly browned and the garlic is soft.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "Squeeze the roasted garlic from its skins and discard the skins."
    },
    {
      "step": 5,
      "text": "Transfer the roasted vegetables and garlic to a blender or saucepan. Add the stock and blend until smooth."
    },
    {
      "step": 6,
      "text": "Pour into a saucepan, whisk in the harissa and cream, and bring to a gentle simmer. If using stock containing raw poultry, heat the soup to 165°F throughout before serving."
    },
    {
      "step": 7,
      "text": "Serve hot."
    }
  ],
