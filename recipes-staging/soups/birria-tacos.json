  "instructions": [
    {
      "step": 1,
      "text": "Toast the guajillo, ancho, and optional arbol chillies in a dry pan over medium heat for about 2 minutes, turning often. Add the spicy salsa, then transfer the chillies to a blender with the tomatoes, quartered onion, and garlic.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Heat the pan again and toast the oregano, cumin, cinnamon, ginger, cloves, and peppercorns briefly. Add them to the blender with the white wine vinegar and blend until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Heat the sunflower oil in a large ovenproof pot. Add the beef, bone marrow, sea salt, bay leaves, and blended chile sauce; stir to coat."
    },
    {
      "step": 4,
      "text": "Cover and braise gently for 3 hours, until the beef is tender and reaches at least 145°F internally. Remove from the heat and rest for 3 minutes.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Uncover and cook for about 1 hour, or until the sauce thickens. Remove the bay leaves and adjust the seasoning if needed.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Serve the birria with chopped coriander, finely chopped white onion, spicy salsa, and lime wedges. For tacos, fill the warmed corn tortillas with the beef and sauce, adding grated mozzarella if desired."
    }
  ],
