  "id": "mexican-salt-cod-stew",
  "name": "Mexican Salt Cod Stew",
  "subtitle": "A tomato-rich stew with potatoes, olives, capers, and pickled chillies",
  "description": "Desalt the cod, then simmer it with tomatoes, onions, potatoes, chillies, capers, olives, parsley, and toasted almonds for a hearty six-serving stew.",
  "meal_type": "soup",
