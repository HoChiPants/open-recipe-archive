  "instructions": [
    {
      "step": 1,
      "text": "Soak the salt cod in plenty of cold water for 48 hours, changing the water several times. Drain, remove any bones or skin, and break the fish into large pieces.",
      "timer_minutes": 2880
    },
    {
      "step": 2,
      "text": "Cut the tomatoes. Heat the olive oil in a large heavy pot and cook the onions and garlic until softened, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Add the tomatoes and simmer until they break down into a thick sauce, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "Stir in the cod and half of the parsley. Cook gently until the fish reaches 145°F and flakes easily, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Fold in the potatoes, chillies with a little reserved pickling brine, capers, olives, and almonds. Simmer until hot and well combined, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Serve hot with the remaining parsley and olives."
    }
  ],
