  "instructions": [
    {
      "step": 1,
      "text": "Preheat a skillet or sauté setting over medium-high heat. Add the beef stew meat and cook for 5 minutes, turning to brown the pieces.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Season the beef with salt and ground black pepper to taste, then transfer it to a slow cooker."
    },
    {
      "step": 3,
      "text": "Preheat the skillet or sauté setting over medium heat. Add the Spanish onion and garlic and cook for 5 minutes, stirring, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the red potatoes, tomatoes, (12 ounce) jar sofrito, and halved green olives. Stir in the beef until evenly combined."
    },
    {
      "step": 5,
      "text": "Cover and cook until the beef and potatoes are tender, about 5 hours. Check that the beef reaches 145°F, then let it rest for 3 minutes before serving.",
      "timer_minutes": 300
    }
  ],
