  "instructions": [
    {
      "step": 1,
      "text": "Bring the water to a gentle simmer in a large pot. Add the chicken and cook for 20 minutes, until the thickest piece reaches 165°F on a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Transfer the chicken to a plate and let it cool briefly, then shred or chop it into bite-size pieces."
    },
    {
      "step": 3,
      "text": "Return the broth to the pot. Add the butter, salt, and pepper, and simmer for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Combine the baking mix and milk in a bowl to form a soft dumpling dough."
    },
    {
      "step": 5,
      "text": "Whisk the flour, cold water, and a little reserved broth until smooth. Stir the mixture into the pot and cook until thickened."
    },
    {
      "step": 6,
      "text": "Bring the soup to a boil, then drop spoonfuls of dough into it. Cover and cook for 10 minutes, until the dumplings are set.",
      "timer_minutes": 10
    }
  ],
