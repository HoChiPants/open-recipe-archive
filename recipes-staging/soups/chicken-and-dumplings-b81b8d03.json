  "name": "Chicken and Dumplings",
  "subtitle": "Tender chicken in a savory broth with soft dumplings",
  "description": "Poached chicken, a seasoned broth, and simple milk-based dumplings make a comforting American soup.",
  "meal_type": "soup",
  "cuisine": "American",
