  "id": "slow-cooker-cream-of-broccoli-soup",
  "name": "Slow Cooker Cream of Broccoli Soup",
  "subtitle": "A creamy, comforting soup with tender broccoli and melted cheese.",
  "description": "Sautéed onion, broccoli, creamy soups, milk, and shredded American cheese come together in the slow cooker for an easy blended-texture soup.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
