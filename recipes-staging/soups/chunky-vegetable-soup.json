      "item": "egg beaten",
      "quantity": 1
    },
    {
      "ingredient_id": "basil-stems-and-leaves-taken-from-the-30g-in-the-soup-ingredients-above",
      "item": "basil stems and leaves (taken from the 30g in the soup ingredients above)",
      "quantity": 3,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Blend the asparagus stems with the cottage cheese until smooth. Stir in the beaten egg, gram flour, and 3 tablespoons of the reserved basil; let the mixture stand until set.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a large pot. Add the leeks, garlic, and potatoes, and cook until the leeks soften.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Pour in the vegetable stock. Add the asparagus tips, broad or soya beans, borlotti beans, tomatoes, and most of the remaining basil. Bring to a simmer."
    },
    {
      "step": 4,
      "text": "Cook the soup until the potatoes and asparagus are tender.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Drop spoonfuls of the dumpling mixture into the simmering soup. Cover and cook until the dumplings are firm and the egg mixture reaches 160°F, or is fully set in the center.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir in the remaining basil and serve hot."
    }
  ],
