  "id": "chunky-vegetable-soup",
  "name": "Chunky Vegetable Soup",
  "subtitle": "With basil cottage-cheese dumplings",
  "description": "A hearty vegetable soup with beans, tomatoes, asparagus, and tender basil cottage-cheese dumplings.",
  "meal_type": "soup",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 40
  },
  "ingredients": [
