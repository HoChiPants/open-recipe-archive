  "id": "cream-of-chicken-soup",
  "name": "Cream of Chicken Soup",
  "subtitle": "A smooth, warming soup made with leftover chicken and vegetables.",
  "description": "Soften the vegetables, simmer them with stock and chicken, then blend with cream and serve with crusty bread.",
  "meal_type": "soup",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "sunflower-oil-or-vegetable-oil",
      "item": "sunflower oil or vegetable oil",
      "quantity": 1,
      "unit": "tbsp"
    },
