  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large pot. Add the onions, celery, leeks, and chopped parsley leaves, and cook until softened, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Add the garlic and stir for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Pour in the wine and simmer for 6 minutes to reduce slightly.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Add the parsley stems, bay leaves, chicken stock, and cooked chicken. Bring to a simmer and cook until the vegetables are tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Remove from the heat, discard the parsley stems and bay leaves, and let the soup cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Blend the soup until smooth. Whisk in the cream, then reheat gently until the chicken reaches 165°F on a food thermometer."
    },
    {
      "step": 7,
      "text": "Serve hot with crusty bread."
    }
  ],
