  "id": "beef-and-vegetable-stew-599becb4",
  "name": "Beef and Vegetable Stew",
  "subtitle": "A hearty one-pot stew with beef, potatoes, and frozen vegetables",
  "description": "Tender beef simmers with tomatoes, okra, lima beans, corn, and potatoes for a filling vegetable stew.",
  "meal_type": "soup",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "beef-stew-meat",
      "item": "beef stew meat",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "cut into 1/2 inch pieces"
    },
    {
      "ingredient_id": "stewed",
      "item": "stewed",
      "quantity": 3,
      "unit": "can",
      "preparation": "14.5 ounce, diced tomatoes"
    },
    {
      "ingredient_id": "tomatoes-and-green-chiles",
      "item": "tomatoes and green chiles",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce, diced"
    },
    {
      "ingredient_id": "frozen-cut-okra",
      "item": "frozen cut okra",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "frozen-baby-lima-beans",
      "item": "frozen baby lima beans",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce"
    },
    {
