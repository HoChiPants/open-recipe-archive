      "item": "frozen corn kernels",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 4,
      "unit": "medium",
      "preparation": "peeled and diced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large pot over medium heat. Add the beef and cook until browned."
    },
    {
      "step": 2,
      "text": "Stir in the stewed tomatoes, tomatoes and green chiles, okra, lima beans, and corn."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer, then cover and cook for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Add the potatoes and continue simmering for 30 minutes, until the potatoes are tender and the beef is tender and reaches 145°F internally. Let the beef rest for 3 minutes before serving.",
      "timer_minutes": 30
    }
  ],
