  "id": "mexican-chicken-soup",
  "name": "Mexican Chicken Soup",
  "subtitle": "A warming broth-based soup with seasoned chicken and fresh toppings",
  "description": "Bake seasoned chicken until fully cooked, then combine it with sautéed vegetables, broth, tomatoes, and spices. Finish each serving with cheese, crushed tortilla chips, and avocado.",
  "meal_type": "soup",
  "cuisine": "Mexican Inspired",
  "yield": {
