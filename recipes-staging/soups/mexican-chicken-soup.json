  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Place the chicken in a baking dish with enough chicken broth to cover the bottom, and coat the chicken with half of the taco seasoning mix."
    },
    {
      "step": 2,
      "text": "Bake until the chicken reaches 165°F in the thickest part, about 35 minutes. Rest briefly, then cut or shred the chicken.",
      "timer_minutes": 35
    },
    {
      "step": 3,
      "text": "Heat the oil in a large pot over medium heat. Add the onions and celery and cook until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the remaining chicken broth, water, remaining taco seasoning, cumin, and black pepper. Add the tomatoes, cilantro, and cooked chicken."
    },
    {
      "step": 5,
      "text": "Bring the soup to a gentle simmer and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Ladle into bowls and top with Cheddar, crushed tortilla chips, and diced avocado."
    }
  ],
