  "id": "roasted-red-pepper-and-tomato-soup",
  "name": "Roasted Red Pepper and Tomato Soup",
  "subtitle": "A smooth, gently spiced soup with a creamy finish",
  "description": "Roast the peppers, simmer them with tomatoes and herbs, then blend and thicken the soup before finishing each serving with sour cream.",
  "meal_type": "soup",
  "cuisine": "American",
