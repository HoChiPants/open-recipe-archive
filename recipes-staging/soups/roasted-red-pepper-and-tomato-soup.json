  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Coat the bell peppers with the olive oil and roast until softened and blistered, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Place the roasted peppers in a covered bowl and let them rest for 15 minutes. Peel, seed, and chop them.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Warm a large saucepan over medium heat. Add the onion and garlic, and cook until the onion softens, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the peppers, tomatoes, paprika, thyme, sugar, cayenne, hot pepper sauce, and salt and pepper."
    },
    {
      "step": 5,
      "text": "Add 4 cups of the chicken broth and bring the mixture to a simmer. Cook until the vegetables are tender, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Blend the soup in batches until smooth, then return it to the saucepan."
    },
    {
      "step": 7,
      "text": "Melt the butter in a small pan. Whisk in the flour and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 8,
      "text": "Whisk in the remaining 2 cups of chicken broth, then stir this mixture into the soup."
    },
    {
      "step": 9,
      "text": "Simmer the soup for 10 minutes, stirring occasionally. Heat the finished soup to at least 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 10,
      "text": "Whisk the sour cream until smooth. Ladle the soup into bowls and top each serving with 1 tablespoon of sour cream."
    }
  ],
