  "id": "borsch",
  "name": "Borsch",
  "subtitle": "Beef, beetroot, cabbage, and bean soup",
  "description": "A hearty beetroot soup with tender beef, potatoes, cabbage, beans, and dill, served with soured cream and bread.",
