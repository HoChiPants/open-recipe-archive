  "instructions": [
    {
      "step": 1,
      "text": "Place the beef shin, whole onion, and bay leaf in a large pot. Add water to cover, bring to a boil, then reduce to a gentle simmer for 60 minutes, skimming as needed.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Heat the sunflower oil in a separate large pan. Cook the diced onion and grated carrot until softened, then add the beetroot and cook briefly.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the optional pepper, chopped tomatoes, and prunes; cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the potatoes to the beef pot and simmer until nearly tender.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir in the sautéed vegetables, cabbage, and kidney beans. Simmer until the cabbage and potatoes are tender.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Check the beef reaches 145°F in the thickest part, then rest it for 3 minutes before serving. Remove the bay leaf and whole onion, then serve the soup with soured cream, dill, and crusty bread."
    }
  ],
