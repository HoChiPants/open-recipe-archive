  "instructions": [
    {
      "step": 1,
      "text": "Place the dry white beans in a large pot, cover with water, and soak for 8 hours. Drain and rinse.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Return the beans to the pot with the smoked turkey legs, onion, and bay leaves. Add fresh water to cover, bring to a boil, then reduce to a gentle simmer."
    },
    {
      "step": 3,
      "text": "Simmer for 3 hours, checking that the turkey reaches 165°F in the thickest part. Remove the bay leaves and turkey legs; pull the meat from the bones and return the meat to the pot.",
      "timer_minutes": 180
    },
    {
      "step": 4,
      "text": "Stir in the celery, carrots, tomatoes with their liquid, Italian seasoning, salt, and pepper. Simmer until the vegetables are tender.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Ladle into bowls and top with the divided Parmesan cheese."
    }
  ],
