  "id": "smoked-turkey-and-white-bean-soup",
  "name": "Smoked Turkey and White Bean Soup",
  "subtitle": "A hearty bean soup with vegetables, tomatoes, and Parmesan",
  "description": "Soaked white beans simmer with smoked turkey, vegetables, tomatoes, and Italian seasoning until tender, then finish with Parmesan.",
  "meal_type": "soup",
