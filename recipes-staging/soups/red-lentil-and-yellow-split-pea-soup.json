  "instructions": [
    {
      "step": 1,
      "text": "Add the red lentils, yellow split peas, onion, carrots, garlic, cumin, and chicken broth to the pressure cooker; stir to combine."
    },
    {
      "step": 2,
      "text": "Preheat the pressure cooker according to the manufacturer's instructions."
    },
    {
      "step": 3,
      "text": "Cook under pressure for 30 minutes. If the broth contains raw poultry, verify that the poultry reaches 165°F with a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Allow the pressure to release naturally for 15 minutes, then release any remaining pressure according to the cooker instructions.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir in salt, pepper, and lemon juice. Adjust the seasoning to taste and serve hot."
    }
  ],
