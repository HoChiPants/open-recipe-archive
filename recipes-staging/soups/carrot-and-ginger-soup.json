  "id": "carrot-and-ginger-soup",
  "name": "Carrot and Ginger Soup",
  "subtitle": "A smooth, warmly spiced vegetable soup",
  "description": "Roasted squash, carrots, ginger, and garlic simmer together, then finish with cream for a silky soup.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
