  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Cut the butternut squash into baking pieces and bake until tender, about 40 minutes. Let it cool enough to handle, then remove the flesh from the skin.",
      "timer_minutes": 40
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large pot. Add the onion and garlic and cook until the onion softens."
    },
    {
      "step": 3,
      "text": "Add the squash, carrots, ginger, and water. Bring to a simmer and cook until the carrots are tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Blend the soup until smooth, then return it to the pot. Add the heavy cream and enough of the soup liquid as needed for a smooth consistency; heat until just boiling."
    },
    {
      "step": 5,
      "text": "Season with salt, pepper, and cinnamon. Whisk briefly and serve hot."
    }
  ],
