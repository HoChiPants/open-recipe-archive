  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot. Add the chopped chicken and cook for 8 minutes, stirring, until a thermometer inserted into the thickest piece reads 165°F. Transfer the chicken to a plate.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Cook the diced onion in the pot for 4 minutes, stirring occasionally, until softened.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Add the sliced pepper, crushed garlic, sliced chorizo, and Cajun seasoning. Cook for 5 minutes, stirring, until fragrant and the chorizo is heated through.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the chicken, rice, plum tomatoes, and chicken stock."
    },
    {
      "step": 5,
      "text": "Bring to a gentle simmer, cover, and cook for 25 minutes, or until the rice is tender and the chicken is hot throughout.",
      "timer_minutes": 25
    }
  ],
