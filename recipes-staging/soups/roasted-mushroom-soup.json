  "id": "roasted-mushroom-soup",
  "name": "Roasted Mushroom Soup",
  "subtitle": "A creamy soup with deeply browned mushrooms and herbs",
  "description": "Mushrooms roast with garlic and rosemary, then join thyme-scented onions and a creamy broth for a smooth, savory soup.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
