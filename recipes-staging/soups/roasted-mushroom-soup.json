  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Toss the mushrooms with garlic, rosemary, salt, and olive oil, then spread them on a baking sheet."
    },
    {
      "step": 2,
      "text": "Roast until the mushrooms are golden brown, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Melt the butter in a pot over medium heat. Add the roasted garlic and mushrooms, onions, and thyme; cook until the butter melts and the onions soften, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in half the cream. Blend the mixture carefully until smooth."
    },
    {
      "step": 5,
      "text": "Whisk in the remaining cream, chicken broth, milk, and black pepper. Bring to a simmer and heat to 165°F throughout, checking with a food thermometer.",
      "timer_minutes": 15
    }
  ],
