  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Pierce the sweet potato and place it on a baking sheet."
    },
    {
      "step": 2,
      "text": "Bake the sweet potato for 45 minutes, or until tender.",
      "timer_minutes": 45
    },
    {
      "step": 3,
      "text": "Add the squash, carrots, and onions to the baking sheet. Coat with the olive oil and season with the salt, allspice, white pepper, and black pepper."
    },
    {
      "step": 4,
      "text": "Bake the vegetables for 40 minutes, until tender and lightly browned.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Cool the roasted vegetables enough to handle. Peel the sweet potato and transfer all the roasted vegetables to a large pot."
    },
    {
      "step": 6,
      "text": "Add the remaining salt, white pepper, nutmeg, cumin, coriander, ginger, and black pepper. Stir in the chicken stock and coconut milk."
    },
    {
      "step": 7,
      "text": "Bring to a simmer and cook for 20 minutes. If the stock was made from raw poultry, verify the soup reaches 165°F with a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "Blend until smooth and adjust the seasoning to taste."
    }
  ],
