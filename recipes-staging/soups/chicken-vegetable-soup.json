  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken, onions, and bouillon granules in a large pot. Add enough water to cover, then stir in the dill, parsley, salt, and pepper."
    },
    {
      "step": 2,
      "text": "Bring the pot to a gentle simmer and cook until the thickest part of the chicken reaches 165°F.",
      "timer_minutes": 45
    },
    {
      "step": 3,
      "text": "Transfer the chicken to a plate. When cool enough to handle, remove the meat from the bones and cut it into bite-size pieces."
    },
    {
      "step": 4,
      "text": "Add the carrots, potatoes, leeks, celery, kohlrabi, and parsnips to the broth. Simmer until the vegetables are tender.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Return the chicken to the pot, stir well, and adjust the salt and pepper."
    },
    {
      "step": 6,
      "text": "Simmer for 5 minutes, then serve hot.",
      "timer_minutes": 5
    }
  ],
