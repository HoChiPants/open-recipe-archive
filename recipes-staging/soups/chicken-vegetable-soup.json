  "id": "chicken-vegetable-soup",
  "name": "Chicken Vegetable Soup",
  "subtitle": "A hearty broth with chicken and tender root vegetables",
  "description": "Chicken, herbs, and a generous mix of vegetables simmer together for a comforting, flavorful soup.",
  "meal_type": "soup",
