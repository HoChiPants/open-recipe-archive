  "id": "lobster-chowder",
  "name": "Lobster Chowder",
  "subtitle": "A creamy soup with tender potatoes and lobster",
  "description": "A rich American-style chowder combining potatoes, onion, milk, cream, and bite-sized cooked lobster.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 4,
      "preparation": "cut into 1/2-inch cubes"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "cut into 1/2-inch pieces"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "lobster-meat",
      "item": "lobster meat",
      "quantity": 6,
      "unit": "cups",
      "preparation": "cooked, cut into bite-sized pieces"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 6,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes and onion in a pot, season with salt and pepper, and cover with water. Bring to a boil and cook until tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Drain the vegetables. Return them to the pot with the divided butter and bring the mixture to a gentle simmer."
    },
    {
      "step": 3,
      "text": "Add the cooked lobster and warm for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Whisk in the heavy cream, milk, and sugar. Heat gently until steaming, without boiling."
    },
    {
      "step": 5,
      "text": "Adjust the salt and pepper, then serve hot."
    }
  ],
