  "id": "roasted-cauliflower-soup",
  "name": "Roasted Cauliflower Soup",
  "subtitle": "A smooth, thyme-scented soup with roasted cauliflower and cumin.",
  "description": "Roast cauliflower with cumin and thyme, then blend it with sautéed aromatics, stock, and cream for a smooth soup finished with parsley and olive oil.",
  "meal_type": "soup",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
