  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Toss the cauliflower with the cumin, olive oil, and thyme, then roast until tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Remove the thyme sprigs. Warm a pot over medium heat, add the onion and celery, and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the garlic and cook for 1 minute. Stir in the roasted cauliflower and stock, then simmer for 10 minutes. If using chicken stock, verify that the soup reaches 165°F with a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Blend the soup until smooth. Whisk in the cream and enough additional stock to reach the desired consistency."
    },
    {
      "step": 5,
      "text": "Serve drizzled with olive oil and topped with chopped parsley."
    }
  ],
