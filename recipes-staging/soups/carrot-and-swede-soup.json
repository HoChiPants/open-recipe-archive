  "id": "carrot-and-swede-soup",
  "name": "Carrot and Swede Soup",
  "subtitle": "A smooth vegetable soup with sweet carrots and earthy swede.",
  "description": "Cook the vegetables in oil, simmer them in stock until tender, then blend until thick and smooth.",
  "meal_type": "soup",
