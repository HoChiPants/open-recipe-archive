  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large pot over medium heat."
    },
    {
      "step": 2,
      "text": "Add the swede, carrots, onion, and garlic. Cook for 2 minutes, stirring occasionally.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Pour in the vegetable stock and bring to a boil."
    },
    {
      "step": 4,
      "text": "Reduce the heat and simmer for 30 minutes, or until the vegetables are tender.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Blend the soup until thick and smooth."
    }
  ],
