  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 250°F."
    },
    {
      "step": 2,
      "text": "Place the beef, tomatoes with their juice, celery, carrots, potatoes, onions, tapioca, bouillon, thyme, rosemary, marjoram, and red wine in a covered ovenproof pot. Stir to combine."
    },
    {
      "step": 3,
      "text": "Bake until the beef and vegetables are tender, about 6 hours. Check the beef with a food thermometer; it should reach at least 145°F, followed by a 3-minute rest.",
      "timer_minutes": 360
    },
    {
      "step": 4,
      "text": "Stir in the thawed peas, cover, and return the stew to the oven for 30 minutes.",
      "timer_minutes": 30
    }
  ],
