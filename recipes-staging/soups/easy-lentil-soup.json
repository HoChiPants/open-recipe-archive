  "instructions": [
    {
      "step": 1,
      "text": "Combine the chicken broth, lentils, diced onion, tomato paste, minced garlic, and cumin in a large pot."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a boil over medium-high heat."
    },
    {
      "step": 3,
      "text": "Reduce the heat and simmer until the lentils are tender, about 35 minutes. Verify the soup reaches at least 165°F with a food thermometer before serving.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "Taste and serve hot."
    }
  ],
