  "id": "chickpea-coconut-and-broccoli-stew",
  "name": "Chickpea, Coconut and Broccoli Stew",
  "subtitle": "A creamy vegetable stew with spiced chickpeas and rice",
  "description": "A warmly spiced chickpea stew with broccoli, green beans, coconut yogurt, and rice.",
  "meal_type": "soup",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
