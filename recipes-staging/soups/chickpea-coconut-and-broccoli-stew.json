  "instructions": [
    {
      "step": 1,
      "text": "Cook the rice according to its package directions, allowing about 25 minutes, then keep it warm.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Heat the oil in a saucepan. Add the ginger, garlic, turmeric, and cumin seeds; cook briefly until fragrant."
    },
    {
      "step": 3,
      "text": "Add the stock, chickpeas, and some of the reserved chickpea liquid. Simmer for 5 minutes, then blend part of the mixture until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the chilli, broccoli, and green beans. Cover and cook for about 8 minutes, until the vegetables are tender.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Remove from the heat and fold in the coconut yogurt and coriander. Serve with the rice."
    }
  ],
