  "id": "creamy-kohlrabi-soup",
  "name": "Creamy Kohlrabi Soup",
  "subtitle": "A smooth vegetable soup with tender orzo",
  "description": "Kohlrabi, onion, and broth simmer with milk, then blend into a creamy soup finished with tender orzo.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "medium",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "kohlrabi",
      "item": "kohlrabi",
      "quantity": 1,
      "unit": "pound",
      "preparation": "peeled and cut into 1/2-inch dice"
    },
    {
      "ingredient_id": "vegetable-broth",
      "item": "vegetable broth",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "bay-leaf",
      "item": "bay leaf",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "uncooked-orzo-pasta",
      "item": "uncooked orzo pasta",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large pot over medium heat. Add the chopped onion and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the diced kohlrabi and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Pour in the vegetable broth and milk, add the bay leaf, and bring the mixture to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Cook until the kohlrabi is tender, about 25 minutes. Remove the bay leaf.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Blend the soup until smooth, working in batches if needed and handling the hot liquid carefully."
    },
    {
      "step": 6,
      "text": "Season with salt and ground black pepper to taste. Return the soup to the pot, add the uncooked orzo pasta, and simmer until the pasta is tender, about 10 minutes.",
      "timer_minutes": 10
    }
  ],
