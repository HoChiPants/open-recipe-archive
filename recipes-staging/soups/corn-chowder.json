  "id": "corn-chowder",
  "name": "Corn Chowder",
  "subtitle": "A creamy potato and corn soup with crisp bacon.",
  "description": "A simple stovetop chowder made with tender potatoes, two kinds of corn, milk, and bacon.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 6
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 2,
      "preparation": "peeled and cubed"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "cream-style-corn",
      "item": "cream-style corn",
      "quantity": 2,
      "unit": "can",
      "preparation": "14.75 ounce"
    },
    {
      "ingredient_id": "whole-kernel-corn",
      "item": "whole kernel corn",
      "quantity": 1,
      "unit": "can",
      "preparation": "15.25 ounce"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a large pot over medium heat until crisp. Transfer it to a plate, leaving the drippings in the pot."
    },
    {
      "step": 2,
      "text": "Cook the onion in the drippings until tender. Add the potatoes and water; cover and simmer until the potatoes are tender.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Stir in the milk, cream-style corn, whole kernel corn, salt, and pepper. Cook over medium-low heat, stirring occasionally, until hot; do not let the milk boil."
    },
    {
      "step": 4,
      "text": "Crumble the bacon and stir it into the chowder before serving."
    }
  ],
