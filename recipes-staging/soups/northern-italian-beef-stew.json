  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large heavy pot over medium-high heat. Brown the beef in batches, then set it aside."
    },
    {
      "step": 2,
      "text": "Cook the onions and celery until softened. Add the carrots and cook briefly, then stir in the mushrooms and garlic.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Return the beef to the pot and pour in the red wine. Bring to a simmer and cook until the wine reduces slightly.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the tomatoes, tomato sauce, potatoes, basil, thyme, marjoram, sage, and beef stock. Stir to combine."
    },
    {
      "step": 5,
      "text": "Bring the stew to a gentle simmer, cover, and cook until the beef and vegetables are tender, about 4 hours 20 minutes. Check the beef with a thermometer; whole cuts should reach at least 145°F, followed by a 3-minute rest.",
      "timer_minutes": 260
    },
    {
      "step": 6,
      "text": "Adjust the seasoning if needed and serve hot."
    }
  ],
