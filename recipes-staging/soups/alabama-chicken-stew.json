  "instructions": [
    {
      "step": 1,
      "text": "Place the whole chicken, bay leaves, salt, pepper, and water in a large stockpot. Bring to a simmer, cover, and cook until the chicken reaches 165°F and is tender, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Transfer the chicken to a platter and let cool until safe to handle, about 15 minutes. Remove and discard the skin and bones, then shred the meat.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Crush the tomatoes with their juices and add them to the pot with the shredded chicken, potatoes, carrots, celery, onions, and corn."
    },
    {
      "step": 4,
      "text": "Simmer, stirring occasionally, until the potatoes are tender and the stew has thickened, about 45 minutes. Adjust salt and pepper to taste before serving.",
      "timer_minutes": 45
    }
  ],
