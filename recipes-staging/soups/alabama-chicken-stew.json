  "id": "alabama-chicken-stew",
  "name": "Alabama Chicken Stew",
  "subtitle": "A hearty chicken and vegetable stew with tomatoes and corn.",
  "description": "Whole chicken is simmered until tender, then returned to a tomato-based broth with vegetables for a thick, filling stew.",
  "meal_type": "soup",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
