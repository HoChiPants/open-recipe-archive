      "item": "Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the broth, onion, cauliflower, broccoli, curry powder, bouillon, salt, and pepper in a large pot. If the broth contains raw poultry, cook until the poultry reaches 165°F on a food thermometer."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a boil, reduce the heat, and simmer until the vegetables are tender, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 3,
      "text": "Whisk the flour and milk together in a bowl until smooth."
    },
    {
      "step": 4,
      "text": "Stir the flour mixture into the soup and cook until slightly thickened."
    },
    {
      "step": 5,
      "text": "Add the cheddar and stir until melted. Serve hot."
    }
  ],
