      "item": "curry powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "chicken-bouillon-granules",
      "item": "chicken bouillon granules",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
