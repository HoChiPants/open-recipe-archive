  "id": "creamy-curry-cauliflower-and-broccoli-soup",
  "name": "Creamy Curry Cauliflower and Broccoli Soup",
  "subtitle": "A smooth, savory vegetable soup with curry and cheddar",
  "description": "Cauliflower and broccoli simmer with curry-seasoned broth, then are thickened with milk and flour and finished with melted cheddar.",
  "meal_type": "soup",
  "cuisine": "Indian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 1,
      "unit": "quart"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "head-cauliflower",
      "item": "head cauliflower",
      "quantity": 1,
      "preparation": "finely chopped"
    },
    {
