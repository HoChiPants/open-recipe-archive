{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cream-of-garlic-soup",
  "name": "Cream of Garlic Soup",
  "subtitle": "A smooth, savory soup with mellow garlic and cream.",
  "description": "Garlic, broth, wine, potatoes, milk, and cream are gently simmered into a comforting soup.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "garlic",
      "item": "garlic cloves",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "and-cubed-potatoes",
      "item": "and cubed potatoes",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a large saucepan over medium heat. Cut the peeled garlic cloves, then add them with the olive oil and cook gently until softened."
    },
    {
      "step": 2,
      "text": "Stir in the chicken broth and white wine. Bring the mixture to a gentle simmer, then cook until the garlic is tender and the flavors have combined.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Whisk together the milk and heavy whipping cream, add the mixture to the saucepan, and continue simmering until the soup reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Add salt and pepper to taste, then serve hot."
    }
  ],
