  "instructions": [
    {
      "step": 1,
      "text": "Prepare the gammon for cooking and set it aside."
    },
    {
      "step": 2,
      "text": "Warm the vegetable oil in a large pot. Add the onions, carrots, and celery, then cook for 10 minutes until softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the peppers, garlic, tomato purée, smoked paprika, and chilli powder if using. Stir briefly to coat the vegetables."
    },
    {
      "step": 4,
      "text": "Pour in the chopped tomatoes, then mix in the Worcestershire sauce and bay leaves.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Place the gammon in the pot and bring the mixture to a gentle simmer."
    },
    {
      "step": 6,
      "text": "Cover and simmer for 3 hours, or until the gammon is tender and reaches 145°F in the thickest piece. Rest for 3 minutes.",
      "timer_minutes": 180
    },
    {
      "step": 7,
      "text": "Stir in the drained beans and simmer for 10 minutes until heated through.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Remove the bay leaves and serve hot."
    }
  ],
