  "id": "gammon-and-haricot-bean-stew",
  "name": "Gammon and Haricot Bean Stew",
  "subtitle": "A smoky tomato stew with tender gammon and beans",
  "description": "A hearty one-pot soup combining gammon, vegetables, smoky spices, tomatoes, and haricot beans.",
  "meal_type": "soup",
