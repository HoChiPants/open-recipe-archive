      "item": "handful of pitted green olives"
    },
    {
      "ingredient_id": "orzo-rinsed-to-keep-it-from-getting-too-sticky-when-baked",
      "item": "orzo rinsed (to keep it from getting too sticky when baked)",
      "quantity": 300,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large ovenproof pot. Add the onion and garlic and cook until tender, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Pour in the wine, then add the tomatoes, bay leaves, thyme, rosemary, parsley stalks, stock cube, balsamic vinegar, capers, and olives. Bring to a boil."
    },
    {
      "step": 4,
      "text": "Stir in the rinsed orzo and nestle the chicken thighs into the mixture, skin side up."
    },
    {
      "step": 5,
      "text": "Bake uncovered until the orzo is thickened and the chicken reaches 165°F at the thickest part, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Stir the orzo, then let the pot stand for 10 minutes. Remove the bay leaves and herb sprigs, scatter over the parsley leaves, and serve.",
      "timer_minutes": 10
    }
  ],
