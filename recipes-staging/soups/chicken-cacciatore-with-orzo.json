  "id": "chicken-cacciatore-with-orzo",
  "name": "Chicken Cacciatore with Orzo",
  "subtitle": "A tomato-braised chicken and orzo one-pot",
  "description": "Chicken thighs simmer with tomatoes, wine, herbs, olives, and orzo for a hearty single-pot meal.",
  "meal_type": "soup",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
