  "id": "cold-cucumber-soup",
  "name": "Cold Cucumber Soup",
  "subtitle": "A chilled, creamy cucumber soup with fresh herbs",
  "description": "Blend cucumber, broth, dairy, and garlic until smooth, then fold in mint and dill before chilling. Serve cold as a light soup or lunch course.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "cucumber",
      "item": "cucumbers",
      "quantity": 2,
      "unit": "large",
      "preparation": "peeled, seeded, and diced"
    },
    {
      "ingredient_id": "vegetable-broth",
      "item": "vegetable broth",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1.3333333730698,
      "unit": "cups"
    },
    {
      "ingredient_id": "plain-yogurt",
      "item": "plain yogurt",
      "quantity": 1.3333333730698,
      "unit": "cups"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "fresh-mint",
      "item": "fresh mint",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fresh-dill",
      "item": "fresh dill",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the cucumbers, vegetable broth, sour cream, plain yogurt, and garlic in a blender."
    },
    {
      "step": 2,
      "text": "Blend until smooth."
    },
    {
      "step": 3,
      "text": "Add the mint and dill, then stir until evenly distributed."
    },
    {
      "step": 4,
      "text": "Cover and refrigerate for 60 minutes before serving chilled.",
      "timer_minutes": 60
    }
  ],
