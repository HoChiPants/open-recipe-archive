  "instructions": [
    {
      "step": 1,
      "text": "Add the tomatoes and green chiles, chili beans, black beans, corn, beer, tomato sauce, onion, carrot, and taco seasoning to a slow cooker; stir to combine."
    },
    {
      "step": 2,
      "text": "Nestle the chicken breasts into the mixture, cover, and cook until the chicken reaches 165°F in the thickest part and is tender, about 7 hours.",
      "timer_minutes": 420
    },
    {
      "step": 3,
      "text": "Transfer the chicken to a plate and let the soup stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Shred the chicken, return it to the slow cooker, and stir."
    },
    {
      "step": 5,
      "text": "Ladle the soup into bowls and top with Cheddar, cilantro, sour cream, and crushed tortilla chips."
    }
  ],
