  "instructions": [
    {
      "step": 1,
      "text": "Place the turkey carcass, halved onion, roughly chopped carrot and celery, halved garlic head, dried rosemary, dried thyme, bay leaves, and the first portion of salt and pepper in a large pot."
    },
    {
      "step": 2,
      "text": "Add the water, using enough to cover the carcass, and bring to a gentle simmer."
    },
    {
      "step": 3,
      "text": "Simmer until the broth is flavorful, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Remove the carcass and bay leaves. Pick any usable turkey meat from the bones, discard the bones and spent vegetables, and return the meat to the pot."
    },
    {
      "step": 5,
      "text": "Stir in the diced onions, diced carrots, diced celery, minced garlic, poultry seasoning, dried rosemary, and onion powder. Simmer until the vegetables are tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Add the cooked rice and the remaining salt and pepper. Cook for 5 minutes; if turkey meat is included, heat it to 165°F as measured with a food thermometer.",
      "timer_minutes": 5
    }
  ],
