  "id": "beef-and-cabbage-stew",
  "name": "Beef and Cabbage Stew",
  "subtitle": "A hearty pot of tender beef and vegetables",
  "description": "Beef, cabbage, potatoes, and other vegetables simmer in a savory broth with tomato sauce for a warming six-serving meal.",
  "meal_type": "soup",
