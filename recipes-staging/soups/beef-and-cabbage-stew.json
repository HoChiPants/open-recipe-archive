  "instructions": [
    {
      "step": 1,
      "text": "Preheat a large pot or Dutch oven for 15 minutes. Drain the beef if needed.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Stir together the beef, bouillon, and broth in the pot. Transfer the beef mixture to the cooking vessel, then add the onion, pepper, and bay leaf."
    },
    {
      "step": 3,
      "text": "Cover and simmer gently for 2 hours, until the beef is tender and reaches at least 145°F; rest it for 3 minutes before serving.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Add the cabbage, potatoes, celery, and carrot. Continue simmering until the potatoes are tender."
    },
    {
      "step": 5,
      "text": "Mix in the tomato sauce and salt, then simmer for 20 minutes before removing the bay leaf and serving.",
      "timer_minutes": 20
    }
  ],
