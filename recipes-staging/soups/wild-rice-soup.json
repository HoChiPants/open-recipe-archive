  "instructions": [
    {
      "step": 1,
      "text": "Simmer the wild rice in the water until tender, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan. Add the onion and cook until tender."
    },
    {
      "step": 3,
      "text": "Stir in the flour, then gradually add the chicken broth, mixing until smooth."
    },
    {
      "step": 4,
      "text": "Bring the broth mixture to a simmer."
    },
    {
      "step": 5,
      "text": "Add the cooked wild rice, carrots, and almonds. Simmer for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir in the half-and-half and warm the soup gently. Heat the ham-containing soup to 165°F, then serve."
    }
  ],
