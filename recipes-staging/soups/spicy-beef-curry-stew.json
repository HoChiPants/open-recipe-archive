  "id": "spicy-beef-curry-stew",
  "name": "Spicy Beef Curry Stew",
  "subtitle": "Tender beef simmered with curry, ginger, jalapeño, and tomatoes",
  "description": "A warmly spiced beef stew assembled in the slow cooker for a hearty dinner.",
