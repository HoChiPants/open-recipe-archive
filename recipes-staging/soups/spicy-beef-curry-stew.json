  "instructions": [
    {
      "step": 1,
      "text": "Preheat the slow cooker according to its instructions. Add the olive oil and beef stew meat, and season with salt and pepper."
    },
    {
      "step": 2,
      "text": "Stir the garlic, ginger, jalapeño, curry powder, and tomatoes with their juice together for 2 minutes, until tender.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Layer the beef, tomato mixture, onion, and beef broth in the slow cooker. Stir gently to combine."
    },
    {
      "step": 4,
      "text": "Cover and cook for 8 hours, until the beef is tender and reaches at least 145°F on a food thermometer; rest for 3 minutes before serving.",
      "timer_minutes": 480
    }
  ],
