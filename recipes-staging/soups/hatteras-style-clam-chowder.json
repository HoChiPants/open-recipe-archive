  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the vegetable oil in a large pot over medium heat. Add the onion, celery, and carrots; cook until the vegetables begin to soften."
    },
    {
      "step": 2,
      "text": "Add the potatoes, clam juice, clams with their juice, thyme, pepper, and bacon. Stir to combine."
    },
    {
      "step": 3,
      "text": "Bring the chowder to a gentle simmer and cook until the potatoes are tender and the clams are opaque.",
      "timer_minutes": 20
    }
  ],
