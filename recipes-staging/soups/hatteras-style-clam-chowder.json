  "id": "hatteras-style-clam-chowder",
  "name": "Hatteras-Style Clam Chowder",
  "subtitle": "A light, savory chowder with vegetables, clams, and bacon",
  "description": "A broth-based clam chowder filled with tender potatoes and vegetables, finished with thyme, pepper, and crumbled bacon.",
  "meal_type": "soup",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
