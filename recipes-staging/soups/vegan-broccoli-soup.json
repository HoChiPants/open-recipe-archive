{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "vegan-broccoli-soup",
  "name": "Vegan Broccoli Soup",
  "subtitle": "A smooth, cashew-enriched soup with tender vegetables",
  "description": "Potatoes, onion, and broccoli simmer in seasoned broth, then blend with cashews for a creamy texture.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "raw-cashews",
      "item": "raw cashews",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-broth",
      "item": "vegetable broth",
      "quantity": 5,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "yukon-gold-potatoes",
      "item": "Yukon Gold potatoes",
      "quantity": 2,
      "preparation": "cut into 1/2-inch cubes"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "coarsely-chopped-broccoli",
      "item": "coarsely chopped broccoli",
      "quantity": 4.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fine-sea-salt",
      "item": "fine sea salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Blend the raw cashews with the divided vegetable broth until smooth, about 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Preheat a large pot over medium heat, then pour in the blended mixture. Add the potatoes and onion."
    },
    {
      "step": 3,
      "text": "Bring to a simmer and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the broccoli and dried basil. Continue simmering until the potatoes are tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir in the sea salt and black pepper."
    },
    {
      "step": 6,
      "text": "Transfer the soup to a blender, or use an immersion blender in the pot, and blend until smooth. Stir and serve hot."
    }
  ],
