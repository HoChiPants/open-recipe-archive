  "instructions": [
    {
      "step": 1,
      "text": "Brown the bratwurst links, then cut them into 1/2-inch slices. Verify the sausage reaches 160°F with a food thermometer."
    },
    {
      "step": 2,
      "text": "Add the sliced bratwurst, potatoes, dried minced onion, green beans, bell pepper, Cheddar cheese, cream of mushroom soup, and water to a slow cooker. Stir to combine."
    },
    {
      "step": 3,
      "text": "Cover and cook on the slow-cooker setting that maintains a steady simmer for 3 hours, or until the potatoes are tender.",
      "timer_minutes": 180
    },
    {
      "step": 4,
      "text": "Stir well and serve hot."
    }
  ],
