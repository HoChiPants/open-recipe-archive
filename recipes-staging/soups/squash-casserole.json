  "id": "squash-casserole",
  "name": "Squash Casserole",
  "subtitle": "Tender squash layered with a creamy chicken-soup sauce and herbed stuffing",
  "description": "A simple baked casserole combining boiled squash and onion with a creamy vegetable mixture and a crisp stuffing topping.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "yellow-crookneck-squash",
      "item": "yellow crookneck squash",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "peeled, seeded, and sliced"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "carrot",
      "item": "carrot",
      "quantity": 1,
      "preparation": "grated"
    },
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "8-ounce-container-sour-cream",
      "item": "(8 ounce) container sour cream",
      "quantity": 1
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "herbed-dry-bread-stuffing-mix",
      "item": "herbed dry bread stuffing mix",
      "quantity": 7.5,
      "unit": "ounces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a casserole dish."
    },
    {
      "step": 2,
      "text": "Boil the squash and onion until tender, then drain thoroughly."
    },
    {
      "step": 3,
      "text": "Whisk the grated carrot, condensed soup, and sour cream together until smooth."
    },
    {
      "step": 4,
      "text": "Combine the stuffing mix with the butter. Fold the squash and onion into the sauce, then combine with part of the stuffing mixture."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to the dish, cover with the remaining stuffing, and bake until golden brown and hot throughout, reaching 165°F in the center.",
      "timer_minutes": 30
    }
  ],
