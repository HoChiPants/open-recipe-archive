{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "creamy-delicata-squash-soup",
  "name": "Creamy Delicata Squash Soup",
  "subtitle": "Roasted squash blended into a smooth, savory soup",
  "description": "Tender roasted delicata squash, onion, broth, and cream make a rich, warming soup for five servings.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "delicata-squash",
      "item": "delicata squash",
      "quantity": 3,
      "preparation": "halved lengthwise and seeded"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "vegetable-broth",
      "item": "vegetable broth",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Arrange the halved, seeded squash on a baking sheet and roast until tender, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 2,
      "text": "Let the squash cool enough to handle, then scoop the flesh from the skins."
    },
    {
      "step": 3,
      "text": "Melt the butter in a large pot over medium heat. Add the onion and cook until softened."
    },
    {
      "step": 4,
      "text": "Add the squash and vegetable broth. Bring to a simmer and blend or process until smooth."
    },
    {
      "step": 5,
      "text": "Whisk in the heavy whipping cream and simmer gently for 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Season with salt and ground black pepper, then serve hot."
    }
  ],
