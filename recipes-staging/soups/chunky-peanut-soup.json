  "instructions": [
    {
      "step": 1,
      "text": "Heat the rapeseed oil in a large pot. Add the onions and ginger and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the garlic, chilli, curry powder, and cumin seeds, then cook briefly until fragrant."
    },
    {
      "step": 3,
      "text": "Add the tomatoes, vegetable stock, peanut butter, and tomato purée, stirring until combined."
    },
    {
      "step": 4,
      "text": "Add the potatoes, squash, chickpeas, and cabbage. Simmer until the vegetables are tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir in the chopped coriander and serve hot."
    }
