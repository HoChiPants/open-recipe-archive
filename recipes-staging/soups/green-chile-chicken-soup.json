  "id": "green-chile-chicken-soup",
  "name": "Green Chile Chicken Soup",
  "subtitle": "A creamy, gently spicy soup with tender chicken and green chiles.",
  "description": "Build a quick butter-and-flour base, loosen it with milk and broth, then simmer with chicken, green chiles, and simple seasoning.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "cooked",
      "item": "cooked",
      "quantity": 2,
      "unit": "cups",
      "preparation": "boneless and skinless chicken, cut into bite-sized pieces"
    },
    {
      "ingredient_id": "green-chile-peppers",
      "item": "green chile peppers",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large pot over medium heat. Whisk in the flour and cook briefly to form a smooth base."
    },
    {
      "step": 2,
      "text": "Gradually whisk in the milk and chicken broth until smooth. Bring the mixture to a gentle boil, stirring often."
    },
    {
      "step": 3,
      "text": "Stir in the chicken, green chile peppers, salt and pepper, and garlic powder."
    },
    {
      "step": 4,
      "text": "Reduce the heat and simmer gently for 30 minutes, stirring occasionally. Before serving, verify that the soup and chicken reach 165°F in the center.",
      "timer_minutes": 30
    }
  ],
