  "id": "chicken-stock",
  "name": "Chicken Stock",
  "subtitle": "A clear, savory base for soups, sauces, and grains",
  "description": "Simmer chicken with vegetables, herbs, and spices, then strain the concentrated broth for later cooking.",
  "meal_type": "soup",
