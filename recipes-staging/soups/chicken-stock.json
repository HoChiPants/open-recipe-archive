  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken, carrot, onion, leek, celery, garlic, bouquet garni, peppercorns, and clove in a large pot. Cover with cold water."
    },
    {
      "step": 2,
      "text": "Bring just to a boil, skim any foam from the surface, then reduce the heat and simmer gently for 3 hours. Ensure the poultry reaches at least 165°F.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Strain the stock through a fine sieve, discarding the solids."
    },
    {
      "step": 4,
      "text": "Cool promptly, then refrigerate or use as needed."
    }
  ],
