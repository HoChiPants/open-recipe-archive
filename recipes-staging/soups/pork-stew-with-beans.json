  "instructions": [
    {
      "step": 1,
      "text": "Season the pork with salt and black pepper. Set aside the tomatoes with green chile peppers."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large heavy pot over medium-high heat. Add the pork and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the onions, red bell peppers, garlic, tomatoes with green chile peppers, and green chile peppers. Cook, stirring occasionally, until the vegetables are tender.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the kidney beans, beef broth, chili powder, dried basil, and cumin. Cover and simmer until the pork is tender and reaches 145°F in the center. Remove from the heat and rest the pork for 3 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir in the edamame, corn, and sliced carrots. Cook until heated through.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Check the seasoning and serve hot."
    }
  ],
