  "instructions": [
    {
      "step": 1,
      "text": "Heat the grill. Cut the red peppers into large pieces and grill for 15 minutes, turning as needed, until softened and charred in spots. Cool briefly, then cut into smaller pieces.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a large saucepan. Add the sliced red onion and sauté for 10 minutes until softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the crushed garlic, ground coriander, ground cumin, and rose harissa paste. Cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the chickpeas and vegetable stock. Bring to a simmer and cook for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir in the peppers, kale, lemon zest and juice, and chopped apricots. Cook for 5 minutes, until the kale is tender.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Ladle into bowls and finish with the chopped parsley. Serve with fat-free natural yogurt if desired."
    }
  ],
