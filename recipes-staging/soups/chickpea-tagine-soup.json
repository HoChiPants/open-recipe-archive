  "id": "chickpea-tagine-soup",
  "name": "Chickpea Tagine Soup",
  "subtitle": "A warmly spiced chickpea soup with peppers, greens, and apricots",
  "description": "A hearty vegetable soup combining roasted red peppers, chickpeas, aromatic spices, kale, lemon, apricots, and parsley.",
  "meal_type": "soup",
  "yield": {
