  "id": "brazilian-fish-stew",
  "name": "Brazilian Fish Stew",
  "subtitle": "Tilapia simmered with peppers, tomatoes, and coconut milk",
  "description": "A bright, gently spiced fish stew with lime-marinated tilapia, tender vegetables, and a creamy coconut broth.",
  "meal_type": "soup",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
