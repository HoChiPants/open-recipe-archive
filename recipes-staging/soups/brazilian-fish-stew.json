  "instructions": [
    {
      "step": 1,
      "text": "Whisk the lime juice, cumin, paprika, garlic, salt, and black pepper. Add the tilapia and turn to coat. Cover and refrigerate for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large pot over medium heat. Add the onions and cook, stirring, for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the marinated tilapia, bell peppers, and drained tomatoes. Pour in the coconut milk and bring the stew to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Simmer gently for 15 minutes, stirring carefully once or twice, until the fish is opaque and flakes easily or reaches 145°F.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir in the cilantro and serve hot."
    }
  ],
