  "instructions": [
    {
      "step": 1,
      "text": "Toast the cumin seeds in a large saucepan over medium heat until fragrant. Add the smoked paprika, ground coriander, black beans, chopped tomatoes, tomato purée, bouillon powder, and grated garlic."
    },
    {
      "step": 2,
      "text": "Bring the soup to a simmer and cook for 15 minutes, stirring occasionally.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Blend about one-third of the soup until smooth, then stir it back into the pan."
    },
    {
      "step": 4,
      "text": "Mix the avocados, cherry tomatoes, spring onions, lemon juice, yogurt, and chopped coriander in a bowl to make the chunky raita."
    },
    {
      "step": 5,
      "text": "Ladle the soup into bowls, top with the raita, and finish with the extra coriander."
    }
  ],
