  "instructions": [
    {
      "step": 1,
      "text": "Set the pressure cooker to its sauté function and heat the olive oil for 3 minutes. Add the onion, carrot, celery, and garlic; cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Add the cumin, coriander, turmeric, salt, white pepper, fennel seeds, and chile powder. Cook briefly, then stir in the tomato paste."
    },
    {
      "step": 3,
      "text": "Pour in the vegetable broth and water. Stir in the lentils, yellow squash, and vegetable bouillon cube."
    },
    {
      "step": 4,
      "text": "Secure the lid and cook at high pressure for 8 minutes. Let the pressure release naturally for 15 minutes, then release any remaining pressure and wait 10 minutes before opening.",
      "timer_minutes": 33
    },
    {
      "step": 5,
      "text": "Use the sauté function to simmer the soup for 5 minutes. Stir in the lemon juice and kale, then cook until the kale is tender, about 5 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
