  "instructions": [
    {
      "step": 1,
      "text": "Heat enough vegetable oil in a skillet to cover the bottom. Fry the tortilla strips until crisp, about 3 minutes. Drain them well.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Toast the seeded pasilla chiles in the skillet with 1 teaspoon vegetable oil for 2 minutes, turning once. Drain, then transfer the chiles to a blender.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the tomatoes, onion, garlic, and oregano to the blender. Blend until smooth."
    },
    {
      "step": 4,
      "text": "Heat the blended mixture in a saucepan for 2 minutes, then stir in the water, bouillon granules, and parsley.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Bring the soup to a boil, reduce the heat, and simmer for 15 minutes. Use a food thermometer to confirm the soup reaches 165°F before serving.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Remove the parsley sprig. Cut the toasted chiles into pieces and prepare the toppings."
    },
    {
      "step": 7,
      "text": "Ladle the soup into bowls and garnish with tortilla strips, avocado, cotija, chile pieces, and crema fresca."
    }
  ],
