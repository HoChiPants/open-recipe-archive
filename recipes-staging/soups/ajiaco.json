  "id": "ajiaco",
  "name": "Ajiaco",
  "subtitle": "Colombian-style chicken, corn, and potato soup",
  "description": "A hearty soup built from chicken, corn, several kinds of potatoes, guascas, and a cool caper-avocado garnish.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
