  "instructions": [
    {
      "step": 1,
      "text": "Combine the chicken, corn cobs, garlic, onion, yellow pepper, diced potatoes, spring onions, and coriander in a large pot. Add enough water to cover, bring to a boil, then simmer until the chicken reaches 165°F internally and the potatoes are tender.",
      "timer_minutes": 45
    },
    {
      "step": 2,
      "text": "Transfer the chicken and corn to a plate. Blend the cream into the soup until smooth, then return the soup to the pot."
    },
    {
      "step": 3,
      "text": "Add the halved papas criollas and guascas. Simmer until the small potatoes are tender.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Cut the chicken and corn into thick pieces. Return them to the soup and heat through."
    },
    {
      "step": 5,
      "text": "Whisk together the chopped spring onions, coriander, cream, capers, and avocado to make the garnish."
    },
    {
      "step": 6,
      "text": "Ladle the soup into bowls and serve with the garnish and extra chopped coriander."
    }
  ],
