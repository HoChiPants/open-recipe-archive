      "item": "skinless chicken breasts",
      "quantity": 2
    },
    {
      "ingredient_id": "cobs-choclo-corn-a-variety-of-large-kernel-yellow-corn-or-regular-corn-cobs",
      "item": "cobs choclo corn (a variety of large-kernel yellow corn) or regular corn cobs",
      "quantity": 2
    },
    {
