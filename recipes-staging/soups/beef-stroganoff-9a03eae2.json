  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet over medium heat. Cook the onion and mushrooms until softened and lightly browned, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Add the garlic and butter; cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Sprinkle in the flour and stir to coat the vegetables. Add the sliced steak and cook for 4 minutes, or until a thermometer registers 145°F. Remove from the heat and rest the beef for 3 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Whisk the crème fraîche, mustard, and beef stock together. Stir the mixture into the skillet and simmer gently for 5 minutes, until the sauce is hot and slightly thickened.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Serve hot, scattered with the chopped parsley."
    }
  ],
