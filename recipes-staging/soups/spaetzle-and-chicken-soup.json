  "id": "spaetzle-and-chicken-soup",
  "name": "Spaetzle and Chicken Soup",
  "subtitle": "Tender chicken, vegetables, and simple egg dumplings in savory broth",
  "description": "A comforting chicken soup finished with homemade spaetzle and parsley.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 80
  },
  "ingredients": [
