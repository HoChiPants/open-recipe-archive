  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken, broth, and water in a large pot. Add the onions, celery, salt and pepper, and garlic salt."
    },
    {
      "step": 2,
      "text": "Bring to a gentle simmer and cook for 60 minutes, or until the thickest part of the chicken reaches 165°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Transfer the chicken to a plate to cool enough to handle. Remove the meat from the bones and cut it into bite-size pieces; return it to the pot."
    },
    {
      "step": 4,
      "text": "Bring the broth to a boil and add the carrots. Cook until tender."
    },
    {
      "step": 5,
      "text": "While the soup heats, beat the eggs with the water and 1 teaspoon salt. Stir in the flour until a firm dough forms."
    },
    {
      "step": 6,
      "text": "Cut or pinch small pieces of dough directly into the boiling broth. Cook until the spaetzle are firm and fully set, with the egg mixture reaching at least 160°F."
    },
    {
      "step": 7,
      "text": "Stir in the parsley flakes, adjust seasoning, and serve hot."
    }
  ],
