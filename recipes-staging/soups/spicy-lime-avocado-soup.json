  "instructions": [
    {
      "step": 1,
      "text": "Bring the water to a simmer, stir in the bouillon powder, and add the chicken. Simmer until the thickest part reaches 165°F, about 7 minutes. Remove the chicken, reserving the broth; cool briefly, then cut or shred the chicken.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a pot. Add the larger portion of onion, cilantro, jalapeños, and garlic; cook until the onion softens, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the reserved broth and cook for 5 minutes. Transfer the broth mixture to a blender, add the avocado and lime juice, and blend until smooth. Return the soup to the pot and stir in the chicken.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Serve topped with the remaining onion and cilantro and the queso fresco."
    }
  ],
