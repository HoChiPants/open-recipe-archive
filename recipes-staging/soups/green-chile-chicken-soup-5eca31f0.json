  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Add the onion and garlic; cook for 4 minutes, stirring, until softened.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Stir in the chicken, green chiles, cumin, and condensed soup. Cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Stir in the half-and-half and cook gently for 5 minutes. Heat until the soup reaches 165°F on a food thermometer.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Remove from the heat. Whisk in the cheddar and sour cream until combined, then serve."
    }
  ],
