  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "finely-diced-onion",
      "item": "finely diced onion",
      "quantity": 0.5,
