  "id": "green-chile-chicken-soup-5eca31f0",
  "name": "Green Chile Chicken Soup",
  "subtitle": "A creamy soup with green chiles, chicken, and cheddar",
  "description": "Sautéed aromatics, green chiles, chicken, and cumin are folded into a creamy base, then finished with cheddar and sour cream.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
