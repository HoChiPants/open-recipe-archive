  "instructions": [
    {
      "step": 1,
      "text": "Combine the chicken, green and red bell peppers, onion, and ground cayenne pepper in a large pot. Cook over medium heat, stirring, until the vegetables are tender and the chicken reaches 165°F in the thickest pieces."
    },
    {
      "step": 2,
      "text": "Stir in the corn, kidney beans with liquid, tomatoes, tomato sauce, water, chili powder, parsley, garlic powder, and cumin."
    },
    {
      "step": 3,
      "text": "Bring the soup to a boil, then reduce the heat and simmer for 30 minutes, stirring occasionally. Confirm the chicken remains at least 165°F before serving.",
      "timer_minutes": 30
    }
  ],
