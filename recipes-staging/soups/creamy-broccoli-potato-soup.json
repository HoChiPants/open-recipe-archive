  "instructions": [
    {
      "step": 1,
      "text": "Melt 2 tablespoons butter in a pot over medium heat. Add onion and garlic; cook for 10 minutes, until softened and the butter is melted.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the potato and broccoli, season with salt and pepper, and pour in the chicken broth. Cook for 10 minutes, until the vegetables begin to soften.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the broccoli and continue cooking for 5 minutes, until tender. Blend the soup carefully until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "In a separate saucepan, melt 3 tablespoons butter. Whisk in the flour, then gradually whisk in the milk and cream until smooth."
    },
    {
      "step": 5,
      "text": "Season with salt and pepper. Whisk over medium heat for 5 minutes, until thickened.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir the thickened sauce into the blended soup. If verifying a poultry-based broth preparation with a thermometer, heat the soup to 165°F before serving."
    }
  ],
