  "id": "creamy-broccoli-potato-soup",
  "name": "Creamy Broccoli Potato Soup",
  "subtitle": "A smooth, comforting soup with tender vegetables and a rich cream finish.",
  "description": "Cook broccoli and potato in seasoned broth, blend until smooth, then finish with a thickened milk-and-cream sauce.",
  "meal_type": "soup",
  "cuisine": "American",
