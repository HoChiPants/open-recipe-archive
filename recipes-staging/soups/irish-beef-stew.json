{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "irish-beef-stew",
  "name": "Irish Beef Stew",
  "subtitle": "Slow-cooked beef with stout and root vegetables",
  "description": "Tender beef chuck, potatoes, carrots, onion, and garlic simmer with broth, tomato paste, and Irish stout for a hearty stew.",
  "meal_type": "soup",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 360
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "beef-chuck",
      "item": "beef chuck",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "cut into 1 1/2-inch cubes"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 1,
      "unit": "pound",
      "preparation": "peeled and cut into 1-inch chunks"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 6,
      "unit": "large",
      "preparation": "peeled and cut into large chunks"
    },
    {
      "ingredient_id": "white-onion",
      "item": "white onion",
      "quantity": 1,
      "preparation": "cut into large chunks"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "beef-broth",
      "item": "beef broth",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "tomato-paste",
      "item": "tomato paste",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce"
    },
    {
      "ingredient_id": "or-bottle-irish-stout-beer-e-g-guinness-r",
      "item": "or bottle Irish stout beer (e.g. Guinness(r))",
      "quantity": 1,
      "unit": "can",
      "preparation": "12 fluid ounce"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and place a large oven-safe pot over medium heat. Add the olive oil."
    },
    {
      "step": 2,
      "text": "Toss the beef with the flour, then brown it in the oil in batches. Transfer the browned beef to a plate."
    },
    {
      "step": 3,
      "text": "Add the carrots, potatoes, onion, and garlic to the pot and cook briefly, stirring to coat."
    },
    {
      "step": 4,
      "text": "Return the beef to the pot. Stir in the beef broth and tomato paste, then pour in the Irish stout beer."
    },
    {
      "step": 5,
      "text": "Cover the pot and cook for 6 hours, until the beef is tender and reaches at least 145°F on a food thermometer; rest for 3 minutes before serving.",
      "timer_minutes": 360
    },
    {
      "step": 6,
      "text": "Mix the cold water and cornstarch until smooth. Stir the mixture into the stew, bring it to a simmer, and cook until thickened."
    },
    {
      "step": 7,
      "text": "Serve hot."
    }
  ],
  "tags": [
    "dinner",
    "stew",
    "irish"
  ],
