  "id": "chicken-bone-broth",
  "name": "Chicken Bone Broth",
  "subtitle": "A deeply flavored stock made from roasted chicken bones and vegetables.",
  "description": "Roast the bones and aromatics, then simmer them with vinegar and water to make a rich, versatile broth.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
