  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Arrange the chicken bones, carrots, celery, onion, and garlic in a roasting pan. Toss with the olive oil and spread into an even layer."
    },
    {
      "step": 2,
      "text": "Roast until the bones and vegetables are well browned, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Transfer the roasted ingredients to a large stockpot. Add the apple cider vinegar, bay leaves, sea salt, and black peppercorns, then pour in enough water to cover."
    },
    {
      "step": 4,
      "text": "Bring the liquid to at least 165°F, then reduce the heat and maintain a gentle simmer for 24 hours and 30 minutes, adding water as needed to keep the ingredients covered.",
      "timer_minutes": 1470
    },
    {
      "step": 5,
      "text": "Strain the broth through a fine-mesh strainer and discard the solids. Use hot or cool promptly for storage."
    }
  ],
