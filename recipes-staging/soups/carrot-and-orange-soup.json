      "item": "a small handful coriander leaves chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large pot over medium heat. Add the sliced onions and cook until softened.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Add the diced carrots and cook, stirring, for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir in the vegetable stock, orange juice, ground coriander, cinnamon, salt, and black pepper."
    },
    {
      "step": 4,
      "text": "Bring to a simmer and cook until the carrots are tender.",
      "timer_minutes": 50
    },
    {
      "step": 5,
      "text": "Blend the soup until smooth, then taste and adjust the seasoning if needed."
    },
    {
      "step": 6,
      "text": "Ladle into bowls and garnish with the chopped coriander leaves and a light sprinkling of ground coriander."
    }
  ],
