  "id": "carrot-and-orange-soup",
  "name": "Carrot and Orange Soup",
  "subtitle": "A bright, warmly spiced vegetable soup",
  "description": "Carrots, orange juice, coriander, and cinnamon simmer with onions and stock for a smooth, aromatic soup.",
  "meal_type": "soup",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
