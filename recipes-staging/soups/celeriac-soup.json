  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large saucepan. Add the sliced onion, diced celery, and garlic, and cook until softened, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Add the celeriac and vegetable stock. Bring to a simmer and cook until the celeriac is tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Blend the soup until smooth, then stir in the ground nutmeg and crème fraîche."
    },
    {
      "step": 4,
      "text": "While the soup cooks, sauté the chopped hazelnuts and panko breadcrumbs until lightly crisp."
    },
    {
      "step": 5,
      "text": "Stir the chopped chives into the soup, ladle into bowls, and scatter with the hazelnut topping."
    }
  ],
