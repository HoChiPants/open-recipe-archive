  "id": "celeriac-soup",
  "name": "Celeriac Soup",
  "subtitle": "Smooth celeriac soup with crunchy hazelnut topping",
  "description": "A creamy vegetable soup finished with crème fraîche, chives, and a crisp hazelnut-panko topping.",
