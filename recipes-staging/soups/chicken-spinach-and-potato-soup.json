  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken thighs, water, and chicken stock in a large pot. Bring to a gentle simmer and cook for 20 minutes, or until the chicken reaches 165°F on a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Transfer the chicken to a plate and let it cool briefly, reserving the cooking liquid. Shred or cut the chicken into bite-size pieces."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in the pot over medium heat. Add the onion and garlic and cook, stirring, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the potatoes and reserved cooking liquid. Simmer for about 25 minutes, until the potatoes are tender.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Return the chicken to the pot and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir in the garbanzo beans, fresh spinach, roasted red peppers, and salt and pepper. Simmer until the spinach wilts and the soup is hot."
    },
    {
      "step": 7,
      "text": "Adjust the seasoning, add the grated Parmesan cheese, and serve."
    }
  ],
