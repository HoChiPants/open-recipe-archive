  "id": "chicken-spinach-and-potato-soup",
  "name": "Chicken, Spinach, and Potato Soup",
  "subtitle": "A hearty soup with tender chicken, vegetables, beans, and greens",
  "description": "Chicken, potatoes, garbanzo beans, spinach, and roasted peppers simmer together in a savory broth, finished with Parmesan.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 1,
      "unit": "pound",
      "preparation": "boneless chicken thighs"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "chicken-stock",
      "item": "chicken stock",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
