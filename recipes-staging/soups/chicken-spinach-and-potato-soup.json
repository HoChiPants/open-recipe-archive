      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 6,
      "unit": "cloves",
      "preparation": "chopped"
    },
    {
