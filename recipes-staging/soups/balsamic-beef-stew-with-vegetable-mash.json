  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large heavy pot. Cook the onions for 8 minutes, stirring occasionally, until softened.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Add the diced beef and chopped garlic. Cook until the beef is browned on the outside."
    },
    {
      "step": 3,
      "text": "Stir in the porcini mushrooms, balsamic vinegar, tomato purée, bouillon powder, mustard powder, carrots, quartered mushrooms, and thyme."
    },
    {
      "step": 4,
      "text": "Bring the stew to a boil, then reduce the heat, cover, and cook gently for about 3 hours, until the beef is tender. Check that the beef reaches at least 145°F, then let it rest for 3 minutes before serving.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Meanwhile, cook the swede and potatoes in simmering water for about 15 minutes, until tender. Drain well and mash together.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Steam or simmer the broccoli for about 5 minutes, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Serve the beef stew with the swede-potato mash and broccoli."
    }
  ],
