    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a large pot over medium heat for 5 minutes. Melt the butter, then add the chicken, onion, garlic, and bouillon cubes. Cook, stirring, until the chicken is no longer pink outside."
    },
    {
      "step": 2,
      "text": "Stir the hot water and cumin into the pot. Bring the mixture to a gentle simmer and cook until the chicken reaches 165°F at the thickest piece."
    },
    {
      "step": 3,
      "text": "Whisk in the half-and-half, Monterey Jack cheese, cream-style corn, green chiles, and hot pepper sauce. Cook gently, stirring, until the cheese melts and the chowder is hot; do not boil."
    },
    {
      "step": 4,
      "text": "Stir in the chopped tomato. Ladle into bowls and garnish with the cilantro sprigs."
    }
  ],
