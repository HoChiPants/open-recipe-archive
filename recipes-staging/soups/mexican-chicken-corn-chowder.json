  "id": "mexican-chicken-corn-chowder",
  "name": "Mexican Chicken Corn Chowder",
  "subtitle": "Creamy chicken chowder with corn, chiles, and cilantro",
  "description": "A rich, gently spicy chowder combining tender chicken, sweet corn, green chiles, cheese, and fresh cilantro.",
  "meal_type": "soup",
