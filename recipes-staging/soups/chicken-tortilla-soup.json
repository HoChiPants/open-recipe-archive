  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken, tomatoes, enchilada sauce, onion, banana peppers, garlic, water, broth, cumin, chili powder, salt, pepper, and bay leaf in a slow cooker. Stir to combine."
    },
    {
      "step": 2,
      "text": "Cover and cook for 3 hours, or until the chicken reaches 165°F at the thickest pieces. Stir in the corn and cilantro.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Heat the oven to 400°F. Lightly coat the tortillas with cooking spray and cut them into strips."
    },
    {
      "step": 4,
      "text": "Arrange the tortilla strips in a single layer and bake until crisp, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Remove the bay leaf, ladle the soup into bowls, and top with the baked tortilla strips."
    }
  ],
