  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large pot over medium heat. Add the onion and garlic; cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Stir in the turmeric, curry powder, and coriander. Add the sweet potatoes and sauté for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Pour in the vegetable broth and bring to a simmer. Cook until the sweet potatoes are tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the kale and simmer for 5 minutes, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the salt and coconut milk, then heat through and serve."
    }
  ],
