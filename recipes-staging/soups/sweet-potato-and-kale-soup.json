  "id": "sweet-potato-and-kale-soup",
  "name": "Sweet Potato and Kale Soup",
  "subtitle": "A warming vegetable soup with chickpeas and coconut milk",
  "description": "Sweet potatoes, kale, and chickpeas simmer with aromatic spices in a creamy coconut broth.",
