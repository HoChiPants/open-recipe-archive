  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan. Add the onions and spring onion, and cook gently for 10 minutes until softened.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the garlic and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Pour in the cider, then add the potato, thyme sprigs, and half the cheese. Cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the chicken stock and cream. Simmer until the potato is tender and the soup reaches 165°F on a food thermometer, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Remove the thyme sprigs and blend the soup until smooth. Keep warm."
    },
    {
      "step": 6,
      "text": "Heat the grill. Combine the apple matchsticks, remaining cheese, dried apple, and spring onion."
    },
    {
      "step": 7,
      "text": "Top the bread slices with the apple mixture and grill until the cheese is melted."
    },
    {
      "step": 8,
      "text": "Serve the soup with the toasts and finish with the reserved thyme leaves, apple, and dried apple."
    }
  ],
