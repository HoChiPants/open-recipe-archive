  "id": "cider-and-onion-soup-with-cheese-apple-toasts",
  "name": "Cider and Onion Soup with Cheese-Apple Toasts",
  "subtitle": "A savory onion soup with cider, cream, and crisp cheese toasts",
  "description": "Slow-cooked onions, cider, potato, and thyme are blended with stock and cream, then served with apple-and-cheese-topped toast.",
  "meal_type": "soup",
  "cuisine": "French",
