  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "condensed-cream-of-chicken-soup",
  "name": "Condensed Cream of Chicken Soup",
  "subtitle": "A quick, silky soup base for two",
  "description": "Make a smooth, creamy soup base by thickening butter and flour with stock and milk, then simmering until velvety.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "salted butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "chicken-stock",
      "item": "chicken stock",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the salted butter in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Whisk in the flour and cook for 2 minutes, until the mixture is thick.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Gradually whisk in the chicken stock until smooth, then whisk in the milk."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a gentle simmer and cook for 5 minutes, stirring, until thickened.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Check with a food thermometer and heat to 165°F, then season with salt and ground black pepper to taste."
    }
  ],
