  "instructions": [
    {
      "step": 1,
      "text": "Melt the margarine in a large pot over medium heat. Add the onion, celery, carrots, garlic, parsley, and celery seed; sauté until the vegetables begin to soften."
    },
    {
      "step": 2,
      "text": "Stir in the flour and cook for 2 minutes, stirring constantly.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Gradually whisk in the chicken broth, then add the milk, potatoes, Worcestershire sauce, mustard powder, allspice, thyme, seasoning salt, wine, cayenne, and bouillon powder."
    },
    {
      "step": 4,
      "text": "Bring to a gentle simmer and cook for 25 minutes, stirring occasionally, until the potatoes are cooked through. For a soup made with poultry-based broth, verify it reaches 165°F with a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Prepare the soup to the desired texture and serve hot."
    }
  ],
