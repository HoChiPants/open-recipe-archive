  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large heavy pot over medium heat. Cook the onion and garlic until softened."
    },
    {
      "step": 2,
      "text": "Add the bell pepper, cumin, oregano, and salt and pepper; cook for 3 minutes, stirring occasionally.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir in the sherry, tomato sauce, vinegar, olives, raisins, capers, and bay leaves. Add the beef and bring the mixture to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Cover and simmer until the beef is tender and the sauce has thickened, about 120 minutes. Check that the beef reaches at least 145°F, then rest it for 3 minutes.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Add the potatoes and cook until tender. Adjust the seasoning before serving."
    }
  ],
