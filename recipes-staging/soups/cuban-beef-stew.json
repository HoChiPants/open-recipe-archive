  "id": "cuban-beef-stew",
  "name": "Cuban Beef Stew",
  "subtitle": "A savory braise with peppers, olives, and potatoes",
  "description": "Beef sirloin simmers with aromatic vegetables, tomato sauce, sherry, olives, raisins, and capers until tender, then finishes with potatoes.",
  "meal_type": "soup",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
