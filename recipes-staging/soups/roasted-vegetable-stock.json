  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Cut the garlic head as directed and arrange it with the carrots, celery, onions, green pepper, tomato, and seasoning in a roasting pan."
    },
    {
      "step": 2,
      "text": "Toss the green pepper with the olive oil and seasoning, then roast the vegetables until tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Transfer the roasted vegetables to a stockpot. Add the water, bay leaves, thyme, and parsley, and prepare the roasted garlic for the pot."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a simmer, then cook gently for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Cool the stock, then strain it before using or storing."
    }
  ],
