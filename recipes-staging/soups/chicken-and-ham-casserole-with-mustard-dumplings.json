  "instructions": [
    {
      "step": 1,
      "text": "Heat the sunflower oil and butter in a large ovenproof casserole. Add the onion, leeks, and carrots; cook for 10 minutes until softened.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the chicken, cider, hot chicken stock, and tied thyme. Bring to a simmer, then cook for 30 minutes, until the chicken reaches 165°F at the thickest point.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Remove the thyme. Stir in the ham, peas, and English or Dijon mustard."
    },
    {
      "step": 4,
      "text": "Mix the self-raising flour, baking powder, mustard powder, grated suet or cold butter, cornflour, and half the parsley. Work in enough casserole liquid to make a firm dough, then shape into dumplings."
    },
    {
      "step": 5,
      "text": "Place the dumplings over the casserole, cover, and cook for 30 minutes. Uncover and cook for 10 minutes more, until the dumplings are golden brown and firm.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Scatter with the remaining parsley and serve hot."
    }
  ],
