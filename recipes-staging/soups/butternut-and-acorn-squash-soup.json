  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Place the halved, seeded squash cut-side down on a baking pan and bake for about 45 minutes, until tender.",
      "timer_minutes": 45
    },
    {
      "step": 2,
      "text": "Scoop the squash flesh from the skins. Melt the butter in a large pot, add the onion, and cook until tender."
    },
    {
      "step": 3,
      "text": "Add the squash, broth, brown sugar, softened cream cheese, pepper, and cinnamon. Whisk or blend until smooth."
    },
    {
      "step": 4,
      "text": "Heat the soup until steaming throughout. If the broth contains poultry pieces or other raw animal ingredients, verify that the soup reaches 165°F with a food thermometer."
    },
    {
      "step": 5,
      "text": "Ladle into bowls and garnish with fresh parsley."
    }
  ],
