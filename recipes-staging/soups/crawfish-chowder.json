  "id": "crawfish-chowder",
  "name": "Crawfish Chowder",
  "subtitle": "A creamy crawfish soup with corn and green onions",
  "description": "A rich, gently spiced chowder combining crawfish, vegetables, creamy soups, and half-and-half.",
  "meal_type": "soup",
