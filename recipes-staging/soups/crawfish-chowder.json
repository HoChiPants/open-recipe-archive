  "instructions": [
    {
      "step": 1,
      "text": "Melt 0.25 cup butter in a large pot over medium heat. Add the chopped green onions and cook until tender."
    },
    {
      "step": 2,
      "text": "In a separate skillet, melt 0.5 cup butter. Add the cleaned crawfish and sauté for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Warm the potato soup, mushroom soup, drained corn, softened cream cheese, and half-and-half in the pot, stirring until combined."
    },
    {
      "step": 4,
      "text": "Add the green onions and crawfish to the soup mixture. Stir in the cayenne pepper."
    },
    {
      "step": 5,
      "text": "Blend the chowder for 5 minutes, keeping it hot and stirring as needed.",
      "timer_minutes": 5
    }
  ],
