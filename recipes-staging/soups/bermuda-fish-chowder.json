      "item": "jalapeno pepper",
      "quantity": 1,
      "preparation": "seeded and minced"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
