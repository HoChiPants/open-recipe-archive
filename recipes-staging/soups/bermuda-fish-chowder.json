  "id": "bermuda-fish-chowder",
  "name": "Bermuda Fish Chowder",
  "subtitle": "A hearty fish chowder with vegetables, potatoes, and tomato broth",
  "description": "A savory tomato-based chowder simmered with vegetables and potatoes, then finished with tender red snapper.",
  "meal_type": "soup",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 50
  },
  "ingredients": [
