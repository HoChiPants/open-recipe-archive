      "item": "bay leaf",
      "quantity": 1
    },
    {
      "ingredient_id": "red-snapper-fillets",
      "item": "red snapper fillets",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into 1 inch pieces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large pot over medium heat. Add the celery, carrots, onion, green bell pepper, garlic, jalapeno, and black pepper; cook for 8 minutes, stirring occasionally.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Mix in the tomato paste and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Pour in the clam juice, then add the potatoes, diced tomatoes, Worcestershire sauce, and bay leaf. Bring to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Cook until the potatoes are tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Add the red snapper pieces and simmer until opaque, easily flaked, and at least 145°F in the center, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Remove the bay leaf and serve hot."
    }
  ],
