  "instructions": [
    {
      "step": 1,
      "text": "Arrange the beef with the bay leaves, thyme, red wine, carrots, and peeled pearl onions. Set aside while preparing the remaining ingredients."
    },
    {
      "step": 2,
      "text": "Heat the oil in a large ovenproof pot. Brown the beef in batches, then transfer it to a plate."
    },
    {
      "step": 3,
      "text": "Cook the roughly chopped onions in the pot until softened. Stir in the plain flour and tomato purée for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Pour in the red wine, return the beef and carrots to the pot, and bring the liquid to a simmer."
    },
    {
      "step": 5,
      "text": "Cover and cook until the beef is tender, about 2 hours. Check that whole beef pieces reach at least 145°F, then rest for 3 minutes before serving.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Cool the stew promptly if preparing it ahead, then freeze it in suitable portions."
    },
    {
      "step": 7,
      "text": "Thaw the stew safely before reheating. Heat the butter in a skillet, add the bacon lardons and peeled pearl onions, and cook until browned and tender.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Add the halved mushrooms and cook until softened, about 5 minutes. Stir the mixture into the stew, warm through, and finish with chopped parsley.",
      "timer_minutes": 5
    },
    {
      "step": 9,
      "text": "Serve hot."
    }
  ],
