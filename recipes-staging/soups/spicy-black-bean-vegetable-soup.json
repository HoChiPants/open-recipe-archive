  "instructions": [
    {
      "step": 1,
      "text": "Heat a large pot over medium heat and add the vegetable oil."
    },
    {
      "step": 2,
      "text": "Add the onion, garlic, and carrots. Cook, stirring occasionally, until the vegetables begin to soften.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the chili powder and ground cumin. Cook until fragrant.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the vegetable stock, black beans, corn, black pepper, and stewed tomatoes. Stir to combine."
    },
    {
      "step": 5,
      "text": "Bring the soup to a simmer, then cook until the carrots are tender.",
      "timer_minutes": 15
    }
  ],
