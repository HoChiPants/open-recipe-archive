  "instructions": [
    {
      "step": 1,
      "text": "Combine the feta, olive oil, crushed coriander seeds, chopped chili, and lemon zest and juice in a bowl. Set aside."
    },
    {
      "step": 2,
      "text": "Blend the spinach, avocados, cucumber, garlic, yogurt, and basil until smooth. Add a little water only if needed to reach a spoonable soup consistency."
    },
    {
      "step": 3,
      "text": "Cover and chill the soup for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Ladle into bowls and top with the seasoned feta mixture and toasted mixed seeds."
    }
