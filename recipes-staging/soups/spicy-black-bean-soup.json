  "instructions": [
    {
      "step": 1,
      "text": "Set an electric pressure cooker to its sauté setting and heat the olive oil. Cook the white onion and yellow bell pepper for 5 minutes, stirring occasionally, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the garlic, chili powder, ground cumin, dried oregano, salt, freshly ground black pepper, chipotle pepper powder, and garlic salt. Stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the vegetable broth, dry black beans, Hatch chile peppers, and red bell pepper. Stir to combine."
    },
    {
      "step": 4,
      "text": "Secure the lid and cook at high pressure for 40 minutes. Let the pressure release naturally for 15 minutes, then release any remaining pressure according to the cooker’s instructions.",
      "timer_minutes": 55
    },
    {
      "step": 5,
      "text": "Blend part or all of the soup until thick, using an immersion blender or working carefully in batches with a standard blender."
    },
    {
      "step": 6,
      "text": "Taste and adjust with garlic salt if needed. Serve with pico de gallo and lime wedges."
    }
  ],
