  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Place the halved, seeded squash cut-side down on a baking pan and bake until tender, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 2,
      "text": "While the squash bakes, melt the butter in a large pot over medium heat. Add the onion and cook until tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the broth, basil, marjoram, black pepper, and cayenne to the pot. Scoop the tender squash from its skin and add it with the softened cream cheese."
    },
    {
      "step": 4,
      "text": "Blend the mixture carefully until smooth, then return it to the pot if needed. Bring to a boil and cook for 5 minutes; verify the soup reaches 165°F with a food thermometer before serving.",
      "timer_minutes": 5
    }
  ],
