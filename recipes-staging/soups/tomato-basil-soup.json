{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "tomato-basil-soup",
  "name": "Tomato Basil Soup",
  "subtitle": "A smooth tomato soup finished with basil and cream",
  "description": "Simmer canned tomatoes with broth and tomato-vegetable juice, blend with basil, then finish with warm cream and butter.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 1,
      "unit": "can",
      "preparation": "28 ounce, crushed"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.5 ounce"
    },
    {
      "ingredient_id": "tomato-vegetable-juice-cocktail",
      "item": "tomato-vegetable juice cocktail",
      "quantity": 1,
      "unit": "can",
      "preparation": "11.5 ounce"
    },
    {
      "ingredient_id": "fresh-basil-leaves",
      "item": "fresh basil leaves",
      "quantity": 20,
      "preparation": "cut into thin strips"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter-or-margarine",
      "item": "butter or margarine",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the tomatoes, chicken broth, and tomato-vegetable juice cocktail in a large saucepan."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a simmer and cook for 30 minutes. Use a thermometer to confirm the soup reaches at least 165°F.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Add the basil and blend the soup until smooth."
    },
    {
      "step": 4,
      "text": "Warm the heavy cream and butter or margarine in a separate saucepan until the butter melts."
    },
    {
      "step": 5,
      "text": "Stir the warm cream mixture into the soup and serve."
    }
  ],
