      "item": "dry navy beans",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce, picked over, rinsed, and drained"
    },
    {
      "ingredient_id": "sprigs-fresh-parsley",
      "item": "sprigs fresh parsley",
      "quantity": 10
    },
    {
