      "item": "cold water",
      "quantity": 8,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt-and-freshly-ground-black-pepper",
      "item": "kosher salt and freshly ground black pepper",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the beans in a large pot with the cold water and let them soak for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Drain the beans. Bundle the parsley, thyme, and bay leaf."
    },
    {
      "step": 3,
      "text": "Return the beans to the pot with the ham hocks, carrot, onion, garlic, and herb bundle."
    },
    {
      "step": 4,
      "text": "Bring to a boil, then reduce to a steady simmer and cook until the beans are tender and the ham is very soft, about 90 minutes.",
      "timer_minutes": 90
    },
    {
      "step": 5,
      "text": "Remove the ham hocks and herb bundle. Let the hocks cool until easy to handle, then pull the meat from the bones and discard the bones and skin."
    },
    {
      "step": 6,
      "text": "Return the ham meat to the soup and season with the salt and pepper. If checking the pork with a thermometer, it should reach 145°F, followed by a 3-minute rest."
    },
    {
      "step": 7,
      "text": "Serve hot."
    }
  ],
