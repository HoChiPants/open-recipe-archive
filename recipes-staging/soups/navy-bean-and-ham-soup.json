  "id": "navy-bean-and-ham-soup",
  "name": "Navy Bean and Ham Soup",
  "subtitle": "Slow-simmered beans with smoky ham and herbs",
  "description": "A hearty soup of tender navy beans, smoked ham hocks, and simple vegetables simmered with fresh herbs.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
