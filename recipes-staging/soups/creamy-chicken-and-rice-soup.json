      "item": "water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "chicken-bouillon-powder",
      "item": "chicken bouillon powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter-or-margarine",
      "item": "butter or margarine",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 6,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "chopped",
      "item": "chopped",
      "quantity": 3,
      "unit": "cups",
      "preparation": "cooked chicken meat"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the broth, rice, celery, onion, water, and bouillon powder in a large pot. Bring to a simmer and cook until the rice is tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Melt the butter or margarine in a separate saucepan. Stir in the flour and cook until thickened."
    },
    {
      "step": 3,
      "text": "Gradually whisk in 4 cups of the milk until smooth. Add this mixture to the soup and stir in the cooked chicken."
    },
    {
      "step": 4,
      "text": "Stir in the remaining 2 cups milk. Season with salt and pepper, then heat gently for 15 minutes. If the chicken was not fully cooked beforehand, verify it reaches 165°F.",
      "timer_minutes": 15
    }
  ],
