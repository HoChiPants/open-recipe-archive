  "id": "creamy-chicken-and-rice-soup",
  "name": "Creamy Chicken and Rice Soup",
  "subtitle": "A hearty soup with tender brown rice and a smooth milk-based broth.",
  "description": "Brown rice, vegetables, and cooked chicken are simmered in seasoned broth, then finished with a buttery flour-thickened milk mixture.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 105
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 2,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "uncooked-brown-rice",
      "item": "uncooked brown rice",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "celery",
      "item": "celery",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
