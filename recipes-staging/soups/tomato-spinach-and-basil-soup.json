  "id": "tomato-spinach-and-basil-soup",
  "name": "Tomato Spinach and Basil Soup",
  "subtitle": "A quick, creamy tomato soup with leafy greens and basil",
  "description": "Sautéed onion and garlic enrich a creamy tomato base, finished with spinach, basil, and Parmesan.",
  "meal_type": "soup",
  "cuisine": "American",
