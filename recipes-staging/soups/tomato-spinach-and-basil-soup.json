  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a pot over medium heat. Add the onion and garlic; sauté for 3 minutes, until softened and fragrant.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Stir in the milk and heat gently for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the tomato puree and sugar. Heat the soup for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the spinach, basil, salt, and pepper. Cook for 2 minutes, until the spinach wilts.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Stir in the Parmesan and serve hot."
    }
  ],
