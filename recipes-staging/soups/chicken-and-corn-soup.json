  "instructions": [
    {
      "step": 1,
      "text": "Place the water, chicken pieces, onions, celery, salt, nutmeg, and pepper in a large pot. Bring to a boil, then reduce the heat and simmer until the chicken is tender and reaches 165°F at the thickest part, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Transfer the chicken and broth to separate containers. Chill the broth for 6 hours, then remove the solidified fat. Pick the meat from the bones and set it aside.",
      "timer_minutes": 360
    },
    {
      "step": 3,
      "text": "Return the broth and chicken to the pot and bring to a simmer. Stir in the corn and cook until tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Hard-boil the designated portion of the divided eggs in water for 12 minutes. Cool, peel, and chop them.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Whisk the remaining egg portion with the sifted flour and milk until smooth. Shape small dumplings from the mixture and let them stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Drop the dumplings into the simmering soup and cook until firm and cooked through. Stir in the chopped eggs and serve hot."
    }
  ],
