  "id": "chicken-and-corn-soup",
  "name": "Chicken and Corn Soup",
  "subtitle": "A hearty soup with tender chicken, fresh corn, and egg dumplings",
  "description": "Chicken, vegetables, and corn simmer in a warmly spiced broth, then finish with chopped eggs and soft flour-based dumplings.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
