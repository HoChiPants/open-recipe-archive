      "item": "thick slices sourdough",
      "quantity": 2
    },
    {
      "ingredient_id": "mixed-seeds",
      "item": "mixed seeds",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "parsley",
      "item": "parsley",
      "quantity": 1,
      "unit": "tbsp",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "double-cream-plus-extra-to-serve-optional",
      "item": "double cream plus extra to serve (optional)",
      "quantity": "1 1/2",
