      "item": "onion sliced",
      "quantity": 1
    },
    {
      "ingredient_id": "celery-stick-sliced",
      "item": "celery stick sliced",
      "quantity": 1
    },
    {
      "ingredient_id": "garlic-cloves-2-crushed-and-1-left-whole",
      "item": "garlic cloves 2 crushed and 1 left whole",
      "quantity": 3
    },
    {
