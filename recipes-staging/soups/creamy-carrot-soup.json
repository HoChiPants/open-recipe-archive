  "id": "creamy-carrot-soup",
  "name": "Creamy Carrot Soup",
  "subtitle": "Smooth carrot soup with toasted sourdough and seeds",
  "description": "A simple blended carrot soup finished with cream, parsley, and crunchy seeded toast.",
  "meal_type": "soup",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "oil",
      "item": "oil",
      "quantity": "1 1/2",
      "unit": "tbsp"
    },
    {
