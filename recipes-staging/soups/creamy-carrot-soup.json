      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven and set aside a baking tray for the sourdough and seeds."
    },
    {
      "step": 2,
      "text": "Warm the oil in a large pot. Cook the onion and celery for 5 minutes, stirring, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the two crushed garlic cloves and cook for 1 minute. Add the carrots, hot stock, and thyme, then bring the soup to at least 165°F."
    },
    {
      "step": 4,
      "text": "Lower the heat and simmer for 25 minutes, or until the carrots are tender.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Meanwhile, toast the sourdough with the whole garlic clove and scatter the mixed seeds over the tray until crisp."
    },
    {
      "step": 6,
      "text": "Remove the thyme. Blend the soup until smooth, then stir in the parsley and cream. Serve with the toast and extra cream if desired."
    }
  ],
