  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "potato-bacon-and-corn-chowder",
  "name": "Potato, Bacon, and Corn Chowder",
  "subtitle": "A creamy vegetable chowder with crisp bacon and sweet corn",
  "description": "Bacon, potatoes, corn, and vegetables combine in a creamy, paprika-finished soup for a hearty meal.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "thick-sliced-bacon",
      "item": "thick sliced bacon",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "cut into 1/2-inch pieces"
    },
    {
      "ingredient_id": "stalks-celery",
      "item": "stalks celery",
      "quantity": 4,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 2,
      "preparation": "diced"
    },
    {
      "ingredient_id": "bay-leaf",
      "item": "bay leaf",
      "quantity": 1
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 2,
      "unit": "large",
      "preparation": "peeled and diced"
    },
    {
      "ingredient_id": "whole-kernel-corn",
      "item": "whole kernel corn",
      "quantity": 1,
      "unit": "can",
      "preparation": "15.25 ounce, drained"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a large pot over medium heat until browned and crisp, about 8 minutes. Transfer it to a plate, leaving the rendered fat in the pot.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Add the celery and carrots to the pot with the bay leaf. Cook until the vegetables begin to soften, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the butter. Once melted, whisk in the flour and cook for 5 minutes, stirring frequently.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Gradually whisk in the milk until smooth. Bring the mixture to a gentle simmer and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the bacon, potatoes, and corn. Cook until the potatoes are tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Stir in the milk and remove the bay leaf. Serve the chowder sprinkled with paprika."
    }
  ],
