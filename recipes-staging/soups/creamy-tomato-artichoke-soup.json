  "id": "creamy-tomato-artichoke-soup",
  "name": "Creamy Tomato Artichoke Soup",
  "subtitle": "A smooth, savory soup with tomatoes, artichokes, and Parmesan",
  "description": "Blend tender vegetables and herbs into a creamy tomato soup, then finish it with half-and-half and Parmesan.",
  "meal_type": "soup",
