  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large pot over medium heat. Add the onion and garlic, and cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the artichoke hearts, diced tomatoes, vegetable broth, roasted red peppers, basil, herbes de Provence, salt, and pepper. Bring the mixture to a simmer and cook for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Transfer the soup to a blender in batches and blend until smooth, or blend carefully in the pot with an immersion blender."
    },
    {
      "step": 4,
      "text": "Return the soup to the pot if needed. Stir in the half-and-half and Parmesan, combining until heated through. Do not boil."
    }
  ],
