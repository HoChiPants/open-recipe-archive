      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-broth",
      "item": "vegetable broth",
      "quantity": 3,
      "unit": "cups",
      "preparation": "or more if needed"
    },
    {
      "ingredient_id": "curry-powder",
      "item": "curry powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
