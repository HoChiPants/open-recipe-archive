  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Arrange the carrots and cauliflower on a baking sheet."
    },
    {
      "step": 2,
      "text": "Toss the garlic with the olive oil, salt, and pepper, then coat the vegetables with the mixture."
    },
    {
      "step": 3,
      "text": "Roast until the vegetables are tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Transfer the roasted vegetables to a pot. Add the broth and curry powder, bring to a simmer, and cook for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Blend the soup carefully until smooth, adding more broth if needed for the desired consistency."
    },
    {
      "step": 6,
      "text": "Stir in the coconut milk and lime juice. Simmer for 10 minutes, then serve.",
      "timer_minutes": 10
    }
  ],
