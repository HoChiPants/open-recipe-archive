  "id": "roasted-carrot-and-cauliflower-curried-soup",
  "name": "Roasted Carrot and Cauliflower Curried Soup",
  "subtitle": "A smooth roasted vegetable soup with curry and lime",
  "description": "Carrots and cauliflower are roasted with garlic, blended with broth and curry powder, then finished with coconut milk and lime.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 6,
      "preparation": "peeled and chopped"
    },
    {
      "ingredient_id": "head-cauliflower",
      "item": "head cauliflower",
      "quantity": 0.5,
      "preparation": "trimmed and chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "chopped"
    },
