  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Brush the squash with the melted butter, then season with half the salt, half the pumpkin pie spice, and the cayenne."
    },
    {
      "step": 2,
      "text": "Place the squash cut-side down on a baking sheet and roast until tender, about 60 minutes. Cool for 15 minutes, then scoop out the flesh.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Warm the vegetable stock in a saucepan. In a separate large pot, melt the remaining butter over medium heat. Add the onion and cook, stirring, for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the curry powder and cook for 1 minute. Add the coconut milk and bring the mixture to a simmer.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Add the squash, warmed stock, remaining salt and pumpkin pie spice, and the nutmeg. Blend until smooth, using an immersion blender or working in batches with a countertop blender."
    },
    {
      "step": 6,
      "text": "Simmer the soup for 20 minutes, adding more stock if needed to reach the desired consistency. Taste and adjust the seasoning as needed.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Serve hot, topped with the pepitas."
    }
  ],
