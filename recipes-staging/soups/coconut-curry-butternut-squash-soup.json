  "id": "coconut-curry-butternut-squash-soup",
  "name": "Coconut Curry Butternut Squash Soup",
  "subtitle": "Roasted squash blended with coconut milk and warm curry spices",
  "description": "A smooth, gently spiced soup made from roasted butternut squash, coconut milk, and vegetable stock, finished with toasted pepitas.",
