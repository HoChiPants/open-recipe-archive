  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Bake the potatoes until tender, about 60 minutes, then cool enough to handle.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Melt the margarine in a large pot over medium heat. Add the white onion and green onions; sauté until tender."
    },
    {
      "step": 3,
      "text": "Stir in the flour and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the chicken stock and water. Whisk in the cornstarch and instant mashed potato flakes, then add the salt, pepper, basil, and thyme."
    },
    {
      "step": 5,
      "text": "Peel and chop the cooled potatoes and stir them into the pot with the half-and-half."
    },
    {
      "step": 6,
      "text": "Simmer for about 20 minutes, stirring occasionally, until thick and the soup reaches 165°F on a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Serve topped with the Cheddar cheese, bacon, and remaining green onions."
    }
  ],
