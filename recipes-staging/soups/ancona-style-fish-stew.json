      "item": "(3/4 inch thick) slices Italian bread",
      "quantity": 6,
      "preparation": "toasted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the fish stock in a separate saucepan over low heat while preparing the stew.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large pot over medium heat. Add the onion, celery, carrot, parsley, garlic, bay leaves, red pepper flakes, and salt and pepper. Cook, stirring, until the onion softens.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the mashed tomatoes and simmer to develop the broth.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Add the vinegar and warm fish stock. Simmer gently.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Add the snapper pieces and clams. Cook until the fish is opaque and flakes easily, the clams open, and the fish reaches 145°F. Discard any clams that remain closed.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Stir in the shrimp and cook until opaque and cooked through.",
      "timer_minutes": 3
    },
    {
      "step": 7,
      "text": "Taste and adjust with red pepper flakes and salt and ground black pepper."
    },
    {
      "step": 8,
      "text": "Place one toasted Italian bread slice in each serving bowl."
    },
    {
      "step": 9,
      "text": "Ladle the stew over the toast and serve hot."
    }
  ],
