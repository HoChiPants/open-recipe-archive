  "id": "ancona-style-fish-stew",
  "name": "Ancona-Style Fish Stew",
  "subtitle": "A tomato broth with snapper, clams, shrimp, and toasted bread",
  "description": "Build a savory tomato and herb broth, then gently cook the seafood until tender and safely done. Serve over toasted bread.",
  "meal_type": "soup",
  "cuisine": "Italian",
  "yield": {
    "quantity": 6,
