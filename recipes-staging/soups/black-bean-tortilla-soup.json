  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large pot over medium heat. Add the onion, peppers, crushed garlic, and garlic granules; cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the cumin, chilli powder, and tomato purée. Cook for 5 minutes, stirring often.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the vegetable stock, chopped tomatoes, cornmeal or polenta, pickled jalapeños, black beans, jalapeño brine, and corn tortillas. Bring to a simmer."
    },
    {
      "step": 4,
      "text": "Cook gently until the soup thickens, about 45 minutes. Cut the tortillas into smaller pieces if needed as they soften.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Ladle into bowls and top with the chopped coriander-avocado mixture, crumbled feta, and pumpkin seeds, if using."
    }
  ],
