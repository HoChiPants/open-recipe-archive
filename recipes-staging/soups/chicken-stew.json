  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. Add the onion, carrots, and celery; sauté for 10 minutes, until tender.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the garlic and cook for 1 minute. Season with the salt and ground black pepper to taste.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Stir in the butter until melted, then add the flour and stir to form a smooth roux."
    },
    {
      "step": 4,
      "text": "Gradually transfer in the chicken broth and milk, stirring until combined and smooth."
    },
    {
      "step": 5,
      "text": "Stir in the thyme, salt, pepper, and turmeric. Bring the stew to a gentle simmer."
    },
    {
      "step": 6,
      "text": "Add the peas, corn, and diced cooked chicken. Simmer for 15 minutes, stirring occasionally, then adjust the salt and ground black pepper to taste. If using uncooked chicken, cook until it reaches 165°F internally.",
      "timer_minutes": 15
    }
  ],
