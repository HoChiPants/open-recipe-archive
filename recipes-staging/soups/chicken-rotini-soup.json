  "instructions": [
    {
      "step": 1,
      "text": "Bring the water to a boil in a pot and add the chicken bouillon cubes. Add the rotini and cook until tender, about 8 minutes. Drain and set aside.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "In a large pot, combine the chicken broth, water, chicken, celery, carrots, onion, and onion powder. Bring to a boil, then reduce the heat and simmer until the vegetables and chicken are tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Check the thickest chicken pieces with a food thermometer; continue cooking until they reach 165°F. Stir in the garlic powder, salt, and pepper."
    },
    {
      "step": 4,
      "text": "Add the cooked rotini to the soup, or divide it among bowls and ladle the soup over it. Serve hot."
    }
  ],
