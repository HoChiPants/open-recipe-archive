  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, onions, carrots, potatoes, bell peppers, mashed tomatoes with their liquid, bouillon powder, black pepper, and curry powder in a large pot."
    },
    {
      "step": 2,
      "text": "Bring to a boil, then reduce the heat and simmer for 20 minutes, until the carrots are tender.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Stir in the cabbage, celery, cauliflower, and dill. Continue simmering for 15 minutes, until the vegetables are cooked through.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Check the soup with a food thermometer and continue heating until it reaches 165°F. Add the remaining water as needed to reach a thick consistency."
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
  ],
