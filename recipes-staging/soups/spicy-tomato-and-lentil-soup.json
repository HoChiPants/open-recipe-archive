  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a pot over medium heat. Add the onion and cook until softened."
    },
    {
      "step": 2,
      "text": "Stir in the chile pepper, red lentils, tomatoes, water, salt and pepper, cumin, and dried basil."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer and cook until the lentils are tender.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Whisk the sour cream until smooth."
    },
    {
      "step": 5,
      "text": "Ladle the soup into bowls, top with sour cream, and garnish with fresh basil leaves."
    }
  ],
