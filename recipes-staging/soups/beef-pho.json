  "id": "beef-pho",
  "name": "Beef Pho",
  "subtitle": "Aromatic beef broth with rice noodles and fresh herbs",
  "description": "Build a fragrant spiced broth, add sliced steak and rice noodles, then finish with herbs, chile, spring onion, and lime.",
