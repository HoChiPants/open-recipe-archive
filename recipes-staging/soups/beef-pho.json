  "instructions": [
    {
      "step": 1,
      "text": "Char the quartered onion and peeled ginger in a dry pot over medium-high heat for 5 minutes, turning until lightly browned.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the beef stock, cinnamon, star anise, coriander seeds, and cloves. Bring to a boil, then simmer for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "While the broth simmers, slice the sirloin thinly and prepare the spring onions, chile, herbs, and lime wedges.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Strain the broth if desired, return it to the pot, and season with palm sugar, fish sauce, and soy sauce."
    },
    {
      "step": 5,
      "text": "Cook the rice noodles according to their package directions, then divide them between two bowls."
    },
    {
      "step": 6,
      "text": "Arrange the sliced steak over the noodles and pour over the hot broth. Confirm the beef reaches 145°F, then rest it for 3 minutes before eating."
    },
    {
      "step": 7,
      "text": "Top with spring onions, chile, Thai basil, and coriander. Serve with lime wedges."
    }
  ],
