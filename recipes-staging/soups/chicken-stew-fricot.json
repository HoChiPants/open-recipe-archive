  "id": "chicken-stew-fricot",
  "name": "Chicken Stew Fricot",
  "subtitle": "A hearty chicken and vegetable stew",
  "description": "Chicken, onion, carrots, and potatoes simmer with savory until tender for a comforting one-pot meal.",
  "meal_type": "soup",
  "cuisine": "French",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "2-to-3-pound-whole-chicken",
      "item": "(2 to 3 pound) whole chicken",
      "quantity": 1,
      "preparation": "cut into pieces"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 5,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 6,
      "preparation": "cubed"
    },
    {
      "ingredient_id": "dried-savory",
      "item": "dried savory",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large pot over medium heat. Add the chicken pieces and chopped onion, and cook until the chicken is lightly browned and the onion softens."
    },
    {
      "step": 2,
      "text": "Cover the pot and simmer for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Add the carrots, potatoes, and dried savory. Continue simmering until the vegetables are tender and the chicken reaches 165°F in the thickest pieces."
    },
    {
      "step": 4,
      "text": "Season with salt and ground black pepper to taste, then serve hot."
    }
  ],
