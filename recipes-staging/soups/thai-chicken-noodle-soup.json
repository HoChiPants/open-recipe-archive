  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. Add the carrots, onion, red bell pepper, and black pepper; cook until the vegetables begin to soften.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Add the chicken, broth, and garlic. Cook gently until the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the coconut milk, curry paste, and salt. Bring the soup to a gentle simmer.",
      "timer_minutes": 5
