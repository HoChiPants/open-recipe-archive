  "id": "chayote-soup",
  "name": "Chayote Soup",
  "subtitle": "A smooth, savory soup with chayote and cilantro",
  "description": "Chayote simmers with aromatics and broth, then blends into a smooth soup finished with fresh cilantro.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "cubes-chicken-bouillon",
      "item": "cubes chicken bouillon",
      "quantity": 2,
      "preparation": "crumbled"
    },
    {
      "ingredient_id": "hot-water",
      "item": "hot water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "onion",
      "item": "yellow onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "minced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "chayote-squashes",
      "item": "chayote squashes",
      "quantity": 2,
      "preparation": "peeled and cut into 1/2-inch pieces"
    },
    {
      "ingredient_id": "fresh-cilantro",
      "item": "fresh cilantro",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the crumbled chicken bouillon cubes into the hot water until dissolved."
    },
    {
      "step": 2,
      "text": "Melt the butter in a pot over medium heat. Add the onion, garlic, red pepper flakes, and a little salt and pepper; cook until the onion softens, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the chayote and bouillon mixture. Bring to a simmer, cover, and cook until the chayote is tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Blend the soup carefully until smooth, then return it to the pot if needed. Stir in the cilantro and adjust the seasoning."
    },
    {
      "step": 5,
      "text": "Using a food thermometer, heat the soup to 165°F before serving."
    }
  ],
