  "instructions": [
    {
      "step": 1,
      "text": "Heat the butter and olive oil in a large pot over medium heat. Add the garlic and cook until tender."
    },
    {
      "step": 2,
      "text": "Add the diced chicken, carrot, celery, and chicken broth. Cook until the chicken reaches 165°F in the thickest pieces."
    },
    {
      "step": 3,
      "text": "Add the mushrooms and cook until tender."
    },
    {
      "step": 4,
      "text": "Stir in the flour, then add the dried thyme. Bring the soup to a simmer."
    },
    {
      "step": 5,
      "text": "Cook gently for 16 minutes, stirring occasionally, until the vegetables are tender and the soup thickens.",
      "timer_minutes": 16
    },
    {
      "step": 6,
      "text": "Season with salt and black pepper. Stir in the sliced green onions."
    },
    {
      "step": 7,
      "text": "Warm the heavy cream separately, add it to the soup, and heat gently without boiling."
    }
  ],
