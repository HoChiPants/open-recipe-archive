  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. Add the minced onion and cook for 4 minutes, stirring occasionally.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Add the garlic, chili powder, cumin, and oregano. Cook for 1 minute, stirring constantly.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Stir in the water, cooked shredded turkey, tomatoes, condensed tomato soup, salsa, bouillon cubes, and dried parsley. Bring the soup to a boil and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the frozen corn, black beans, 0.5 cup sour cream, and 0.25 cup chopped cilantro. Stir in the tortilla chips, then reduce the heat and simmer for 30 minutes. Reheat until the soup reaches 165°F.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Ladle into bowls and top with the cheese blend, green onion, remaining cilantro, remaining sour cream, and tortilla chips."
    }
  ],
