  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken, chopped onion, celery, carrot, bay leaves, 1 teaspoon salt, oregano, and cold water in a large pot. Bring to a simmer and cook until the chicken is fully cooked, about 90 minutes; verify the thickest part reaches 165°F.",
      "timer_minutes": 90
    },
    {
      "step": 2,
      "text": "Transfer the chicken to a plate and let it cool briefly. Strain or reserve the broth, discard the spent aromatics, and remove the meat from the bones."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in the pot over medium heat. Add the finely diced onion and the remaining salt, and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the rice and enough reserved broth to make a soup. Simmer until the rice is tender, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Whisk the eggs with the black pepper and cayenne, then whisk in the lemon juice. Gradually whisk in several ladles of hot broth to temper the mixture."
    },
    {
      "step": 6,
      "text": "Stir the tempered egg mixture into the soup. Cook gently, without boiling, until the soup reaches 160°F and thickens slightly."
    },
    {
      "step": 7,
      "text": "Return the chicken meat to the pot and heat for 5 minutes. Taste and adjust the seasoning, then serve hot.",
      "timer_minutes": 5
    }
  ],
