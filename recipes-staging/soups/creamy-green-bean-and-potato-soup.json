  "id": "creamy-green-bean-and-potato-soup",
  "name": "Creamy Green Bean and Potato Soup",
  "subtitle": "A hearty vegetable soup with creamy broth and savory bacon",
  "description": "Blanch green beans, simmer potatoes until tender, then combine them with a creamy soup base, onion, and bacon for a warm six-serving meal.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-green-beans",
      "item": "fresh green beans",
      "quantity": 3,
      "unit": "cups",
      "preparation": "trimmed and cut into 1-inch pieces"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "and-diced-potatoes",
      "item": "and diced potatoes",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "cups",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "bacon-bits",
      "item": "bacon bits",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "cream-of-chicken-soup",
      "item": "cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the fresh green beans and water in a pot. Add the baking soda and cook for 10 minutes, until tender. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "In the same or a separate pot, combine the and diced potatoes with water as needed. Cook for 20 minutes, until tender.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Cook the melted butter, diced onion, and bacon bits together for 7 minutes, until the onion is softened and the butter is fully melted.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Whisk the and diced potatoes, cream of chicken soup, and milk into the butter mixture until smooth. Add the green beans and season with salt and ground black pepper."
    },
    {
      "step": 5,
      "text": "Heat the soup for 30 minutes, stirring occasionally, until it reaches 165°F throughout. Serve hot.",
      "timer_minutes": 30
    }
  ],
