  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Cut the bell peppers into large pieces. Arrange them with the garlic and lemon in a baking dish, then season with garlic salt, black pepper, and fennel seed."
    },
    {
      "step": 3,
      "text": "Roast until the peppers are tender and lightly charred.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Transfer the roasted peppers, garlic, and lemon to a pot. Add the vegetable broth and fennel seed, and bring to a simmer."
    },
    {
      "step": 5,
      "text": "Stir in the dried thyme and simmer for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Let the soup cool briefly, then puree until smooth. Return it to the pot and reheat gently before serving."
    },
    {
      "step": 7,
      "text": "Adjust the black pepper to taste and garnish with the shredded roasted peppers, if desired."
    }
  ],
