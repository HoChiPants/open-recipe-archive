  "id": "roasted-pepper-soup",
  "name": "Roasted Pepper Soup",
  "subtitle": "A smooth, savory soup of roasted peppers and herbs",
  "description": "Roast assorted bell peppers with garlic and lemon, then simmer them with broth and herbs before blending into a warm, flavorful soup.",
  "meal_type": "soup",
  "cuisine": "American",
