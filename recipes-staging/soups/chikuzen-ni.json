  "id": "chikuzen-ni",
  "name": "Chikuzen-ni",
  "subtitle": "Japanese chicken and root-vegetable stew",
  "description": "Chicken thighs, shiitake, and assorted Japanese vegetables simmer together in a lightly sweet soy-based broth, with snow peas added at the end for freshness.",
  "meal_type": "soup",
  "cuisine": "Japanese",
