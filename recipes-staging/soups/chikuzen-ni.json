  "instructions": [
    {
      "step": 1,
      "text": "Soak the dried shiitake mushrooms in water until softened, then drain. Prepare the burdock, carrot, lotus root, bamboo shoots, and konnyaku as specified.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Blanch the snow peas in boiling water, cool them immediately, and set aside."
    },
    {
      "step": 3,
      "text": "Blanch the bamboo shoots briefly, drain, and set aside.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Boil the burdock, rice vinegar, lotus root, and konnyaku briefly, then drain.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Combine the softened shiitake, burdock, bamboo shoots, konnyaku, caster sugar, and light soy sauce. Set aside."
    },
    {
      "step": 6,
      "text": "Warm the sesame oil in a pot over medium heat. Sauté the chicken thighs until cooked through; verify the thickest part reaches 165°F.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Add the chicken to the simmering pot with the Japanese sake, light soy sauce, and mirin. Cook briefly to combine.",
      "timer_minutes": 3
    },
    {
      "step": 8,
      "text": "Add the burdock, carrot, and lotus root. Simmer until the vegetables are tender.",
      "timer_minutes": 5
    },
    {
      "step": 9,
      "text": "Stir in the prepared shiitake mixture and continue cooking until heated through and the flavors meld."
    },
    {
      "step": 10,
      "text": "Add the snow peas and rice vinegar. Serve the stew with cooked Japanese rice and miso soup."
    }
  ],
