  "id": "pasta-fagioli",
  "name": "Pasta Fagioli",
  "subtitle": "A simple Italian soup with beans, pasta, and vegetables.",
  "description": "A tomato-based soup combining tender vegetables, herbs, ditalini, and cannellini beans.",
  "meal_type": "soup",
