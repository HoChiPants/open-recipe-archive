  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large pot over medium heat. Add the carrot, celery, and onion; cook, stirring, until the vegetables begin to soften."
    },
    {
      "step": 2,
      "text": "Add the garlic and stir briefly. Pour in the tomato sauce and chicken broth, then add the parsley, basil, and black pepper."
    },
    {
      "step": 3,
      "text": "Bring the soup to a simmer and cook until the vegetables are tender.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Meanwhile, cook the ditalini pasta until tender, then drain.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Stir the drained pasta and cannellini beans into the soup. Simmer until heated through. If the broth was prepared with raw poultry, verify the soup reaches 165°F with a food thermometer before serving.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
