  "instructions": [
    {
      "step": 1,
      "text": "Place the beef soup bones in a slow cooker. Add the salt, celery, quartered onion, black pepper, spice balls, carrots, parsley, and peeled garlic."
    },
    {
      "step": 2,
      "text": "Cover and cook on low for 8 hours, or until the meat is tender and reaches at least 145°F on a food thermometer. Let whole-cut beef rest for 3 minutes before serving.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Add the barley during the cooking period as directed by the cooker’s capacity, then continue cooking until tender."
    },
    {
      "step": 4,
      "text": "Remove the bones and spice balls. Separate any meat from the bones, return the meat to the soup, and stir before serving."
    }
  ],
