  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken, onion, lemon slices, salt and pepper, 3 cups water, bay leaf, and thyme in a large pot. Bring to a simmer, cover, and cook for about 60 minutes, until tender and the thickest part reaches 165°F.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Transfer the chicken to a plate and let it cool enough to handle. Remove and discard the onion, lemon slices, and bay leaf."
    },
    {
      "step": 3,
      "text": "Remove the chicken meat from the bones and return the meat to the simmering broth."
    },
    {
      "step": 4,
      "text": "Combine the flour, shortening, and 1 teaspoon salt until crumbly. Stir in ¼ cup water to form a dough."
    },
    {
      "step": 5,
      "text": "Roll the dough out on a lightly floured surface and cut it into dumplings."
    },
    {
      "step": 6,
      "text": "Drop the dumplings into the simmering broth and cook for 10 minutes, until tender.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Serve the chicken and dumplings hot."
    }
  ],
