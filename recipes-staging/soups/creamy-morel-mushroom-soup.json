  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large saucepan over medium heat. Add the garlic, onion, and morels; cook, stirring occasionally, until the onion softens.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the soup base and flour, then cook until the flour is lightly incorporated.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Whisk in the water and heavy cream until smooth. Bring the mixture to a gentle simmer.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Continue cooking until the soup is hot and reaches 165°F, verified with a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir in the thyme, salt, and black pepper, then serve."
    }
  ],
