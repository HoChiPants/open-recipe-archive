  "id": "creamy-morel-mushroom-soup",
  "name": "Creamy Morel Mushroom Soup",
  "subtitle": "A rich mushroom soup with thyme and cream",
  "description": "Sliced morels, aromatics, and cream form a smooth, savory soup for four.",
  "meal_type": "soup",
