  "instructions": [
    {
      "step": 1,
      "text": "Cut the chicken into serving pieces. Combine it with the onion, ginger, allspice, soy sauce, red pepper, all-purpose seasoning, scotch bonnet, and chicken stock."
    },
    {
      "step": 2,
      "text": "Heat a heavy pot over medium heat. Add the caster sugar and let it melt until amber, watching closely so it does not burn."
    },
    {
      "step": 3,
      "text": "Carefully add the chicken mixture and stir to coat. Add the garlic, thyme, and spring onions, then bring to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Cover and cook until the chicken is nearly tender, adding the tomato ketchup and scotch bonnet as the sauce develops.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Simmer until the gravy thickens and the chicken reaches 165°F at the thickest part, about 20 to 25 minutes more. Serve hot.",
      "timer_minutes": 25
    }
  ],
