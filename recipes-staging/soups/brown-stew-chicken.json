  "id": "brown-stew-chicken",
  "name": "Brown Stew Chicken",
  "subtitle": "Tender chicken in a rich, spiced gravy",
  "description": "Chicken is seasoned with aromatics and spices, browned with caramelized sugar, then simmered until tender in a thick, savory sauce.",
  "meal_type": "soup",
