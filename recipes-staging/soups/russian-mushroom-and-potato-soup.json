  "id": "russian-mushroom-and-potato-soup",
  "name": "Russian Mushroom and Potato Soup",
  "subtitle": "A creamy soup with tender potatoes, vegetables, and browned mushrooms.",
  "description": "Leeks, carrots, potatoes, and dill simmer in broth before being finished with a smooth half-and-half thickener and sautéed mushrooms.",
  "meal_type": "soup",
