  "instructions": [
    {
      "step": 1,
      "text": "Melt 3 tablespoons of the butter in a large pot over medium heat. Add the leeks and carrots and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Pour in the chicken broth. Add the dried dill, salt, pepper, bay leaf, and potatoes. Simmer until the potatoes are tender, about 20 minutes. If the broth contains poultry pieces, confirm the soup reaches 165°F with a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Melt the remaining 2 tablespoons butter in a skillet. Add the mushrooms and cook until lightly browned, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Whisk the half-and-half and flour together until smooth. Stir the mixture into the soup, then remove the bay leaf."
    },
    {
      "step": 5,
      "text": "Ladle into bowls and garnish with the mushrooms and fresh dill sprig."
    }
  ],
