  "id": "corn-and-split-pea-chowder",
  "name": "Corn and Split Pea Chowder",
  "subtitle": "A hearty vegetable chowder with sweetcorn and coconut yogurt",
  "description": "Split peas, aromatics, potato, and sweetcorn simmer together until tender, then finish with coconut yogurt for a creamy vegan soup.",
  "meal_type": "soup",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "dried-yellow-split-peas",
      "item": "dried yellow split peas",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "celery-sticks-about-160g",
      "item": "celery sticks (about 160g)",
      "quantity": 3,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "thyme-sprig",
      "item": "thyme sprig",
      "quantity": 1,
      "preparation": "plus 1 tbsp thyme leaves"
    },
    {
      "ingredient_id": "onions-350g",
      "item": "onions (350g)",
      "quantity": 2,
      "preparation": "halved and sliced"
    },
    {
      "ingredient_id": "rapeseed-oil",
      "item": "rapeseed oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "ginger-finely-grated",
      "item": "ginger finely grated",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "red-chillies-deseeded-and-sliced",
      "item": "red chillies deseeded and sliced",
      "quantity": 2
    },
    {
      "ingredient_id": "garlic-cloves-chopped",
      "item": "garlic cloves chopped",
      "quantity": 3
    },
    {
      "ingredient_id": "green-pepper-chopped-into-small-pieces",
      "item": "green pepper chopped into small pieces",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "potato-about-215g",
      "item": "potato (about 215g)",
      "quantity": 1,
      "preparation": "unpeeled, cut into 1-2cm pieces"
    },
    {
      "ingredient_id": "vegetable-bouillon-powder",
      "item": "vegetable bouillon powder",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "frozen-sweetcorn",
      "item": "frozen sweetcorn",
      "quantity": 320,
      "unit": "g"
    },
    {
      "ingredient_id": "coconut-yogurt",
      "item": "coconut yogurt",
      "quantity": 150,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Simmer the split peas, celery, thyme sprig, and green pepper in a large pot until boiling, then cook for 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Meanwhile, heat the rapeseed oil in a pan and sauté the onions and red chillies for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the ginger and garlic and cook briefly until fragrant."
    },
    {
      "step": 4,
      "text": "Transfer the onion mixture to the pot. Add the potato and bouillon powder, bring back to a boil, and simmer until the split peas and potato are tender, about 35 minutes. Add the sweetcorn during the final minutes to heat through.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Remove the thyme sprig and stir in the thyme leaves. Let the soup rest briefly, then stir in the coconut yogurt."
    },
    {
      "step": 6,
      "text": "Chill before serving."
    }
  ],
