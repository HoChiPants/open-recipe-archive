  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chicken-tinga-tacos",
  "name": "Chicken Tinga Tacos",
  "subtitle": "Smoky chicken tacos with tomato-chipotle sauce",
  "description": "Tender shredded chicken is paired with a smooth tomato-chipotle sauce, warm tortillas, pickled onions, cheese, herbs, and lime.",
  "meal_type": "soup",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 4,
    "unit": "(makes 12 tacos)"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "boneless",
      "item": "boneless",
      "quantity": 3,
      "preparation": "skinless chicken breasts (about 650g)"
    },
    {
      "ingredient_id": "plum-tomatoes-halved-about-300g",
      "item": "plum tomatoes halved (about 300g)",
      "quantity": 3
    },
    {
      "ingredient_id": "onion-cut-in-half",
      "item": "onion cut in half",
      "quantity": 1
    },
    {
      "ingredient_id": "garlic-cloves-crushed",
      "item": "garlic cloves crushed",
      "quantity": 3
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "chipotle-peppers-in-adobo-sauce",
      "item": "chipotle peppers in adobo sauce",
      "quantity": "2-3",
      "preparation": "minced"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "x-12cm-corn-tortillas-or-tostadas",
      "item": "x 12cm corn tortillas or tostadas",
      "quantity": 12
    },
    {
      "ingredient_id": "pickled-red-onions-see-recipe",
      "item": "pickled red onions (see recipe",
      "preparation": "below)"
    },
    {
      "ingredient_id": "queso-fresco-or-feta-cheese",
      "item": "queso fresco or feta cheese",
      "quantity": 200,
      "unit": "g",
      "preparation": "crumbled"
    },
    {
      "ingredient_id": "handful-of-coriander-leaves",
      "item": "handful of coriander leaves"
    },
    {
      "ingredient_id": "limes-cut-into-wedges",
      "item": "limes cut into wedges",
      "quantity": 4
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the chicken in a covered pan until cooked through and the center reaches 165°F, about 20 minutes. Transfer to a plate and shred when cool enough to handle.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Heat the oil in the pan. Add the tomatoes, onion, garlic, and chipotle peppers, and cook until softened and lightly charred, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Blend the cooked tomatoes, onion, garlic, and chipotle with the oregano until smooth."
    },
    {
      "step": 4,
      "text": "Return the sauce to the pan and simmer until thickened, about 15 minutes. Stir in the shredded chicken and heat through.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Warm the tortillas or tostadas for about 2 minutes, then fill with the chicken mixture.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Top with pickled red onions, crumbled queso fresco or feta, and coriander leaves. Serve with lime wedges."
    }
  ],
