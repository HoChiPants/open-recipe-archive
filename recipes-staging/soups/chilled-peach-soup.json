    "cook_minutes": 15,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "dry-white-wine",
      "item": "dry white wine",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "peach-schnapps",
      "item": "peach schnapps",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-mint-leaves",
      "item": "fresh mint leaves",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "half-and-half-cream",
      "item": "half-and-half cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "fresh-peaches",
      "item": "fresh peaches",
      "quantity": 10,
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the wine, peach schnapps, sugar, mint, cinnamon, nutmeg, and half-and-half in a saucepan. Stir until the sugar is incorporated."
    },
    {
      "step": 2,
      "text": "Add the sliced peaches and cook over medium heat until tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Let the mixture cool, then transfer it to a blender and process until smooth."
    },
    {
      "step": 4,
      "text": "Chill thoroughly for at least 30 minutes before serving.",
      "timer_minutes": 30
    }
  ],
