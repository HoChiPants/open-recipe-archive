  "id": "chilled-peach-soup",
  "name": "Chilled Peach Soup",
  "subtitle": "A cool, lightly spiced peach soup with mint",
  "description": "Peaches simmer with wine, schnapps, warm spices, and cream, then are blended smooth and chilled for serving.",
  "meal_type": "soup",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
