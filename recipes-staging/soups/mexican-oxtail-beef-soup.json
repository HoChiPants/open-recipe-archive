  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large heavy pot over medium-high heat. Brown the beef oxtail and beef stew meat in batches, about 30 minutes total.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Add the bouillon, onion, celery, chili powder, cumin, salt and pepper, and corn. Add enough water to cover the meat, then bring to a boil."
    },
    {
      "step": 3,
      "text": "Reduce the heat, cover, and simmer for 2 hours, or until the beef is tender.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Stir in the carrots, potatoes, lentils, rice, mixed vegetables, and cabbage. Continue simmering until the lentils, rice, cabbage, and vegetables are tender and the beef reaches at least 145°F internally.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Let the beef rest for 3 minutes, then serve the soup hot with the corn tortillas."
    }
  ],
