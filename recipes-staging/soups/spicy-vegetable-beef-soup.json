  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large pot over medium-high heat. Cut the rump roast into bite-size pieces and brown them in the pot. Transfer the beef to a bowl."
    },
    {
      "step": 2,
      "text": "Add the onion and garlic to the pot. Cook, stirring, until the onion is tender.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Return the beef to the pot. Add the water, beef broth, stewed tomatoes, frozen mixed vegetables, celery, mushrooms, oregano, thyme, basil, parsley, and cayenne pepper."
    },
    {
      "step": 4,
      "text": "Bring the soup to a gentle simmer. Cover and cook until the beef is tender and reaches at least 145°F on a food thermometer; for whole-cut beef, allow a 3-minute rest.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Stir in the rotelle pasta and cook until tender.",
      "timer_minutes": 10
    }
  ],
