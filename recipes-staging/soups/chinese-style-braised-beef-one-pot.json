  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 300°F. Warm the olive oil in a large ovenproof pot over medium heat. Sauté the garlic, ginger, spring onions, and chili for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Toss the beef with the seasoned flour. Add it to the pot and brown briefly, turning to coat it in the aromatics.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the five-spice, star anise, sugar, cooking wine, soy sauce, and stock. Bring the liquid to a simmer."
    },
    {
      "step": 4,
      "text": "Cover the pot and transfer it to the oven. Braise for 4 hours, then continue cooking as needed, up to 6 hours total, until the beef is very tender.",
      "timer_minutes": 360
    },
    {
      "step": 5,
      "text": "Check the thickest pieces with a food thermometer; beef should reach at least 145°F, then rest for 3 minutes. Adjust with additional soy sauce if needed.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Serve the beef and sauce with steamed bok choi and basmati rice."
    }
  ],
