  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a heavy pot over medium heat. Toss the beef with the flour, then add it to the pot with the garlic, bay leaves, pepper, and green bell pepper."
    },
    {
      "step": 2,
      "text": "Cook the beef, turning as needed, until browned. Add the salt and continue cooking until the beef is tender, about 5 minutes more.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the onion, remaining green bell pepper, carrot, paprika, and green beans. Cook until the onion begins to soften, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the tomato, white wine, water, and parsley. Bring the mixture to a gentle simmer."
    },
    {
      "step": 5,
      "text": "Add the red potatoes and sweet potato. Cover and simmer until the vegetables are tender and the beef reaches at least 145°F in the thickest pieces.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Remove from the heat and let the beef rest for 3 minutes before serving. Remove the bay leaves and parsley sprigs.",
      "timer_minutes": 3
    }
  ],
