      "item": "mature cheddar grated",
      "quantity": 175,
      "unit": "g"
    },
    {
      "ingredient_id": "sea-salt-and-crackled-black-pepper",
      "item": "sea salt and crackled black pepper"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large pot. Add the onion and cook until softened."
    },
    {
      "step": 2,
      "text": "Stir in the potatoes, add the chicken stock, and bring to a simmer. Add the broccoli and simmer until the vegetables are tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Whisk in the single cream until smooth, then add the grated cheddar. Heat gently for 10 minutes, stirring until the cheese melts. Use a food thermometer to confirm the soup reaches 165°F before serving.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Season with sea salt and crackled black pepper, then serve hot."
    }
  ],
