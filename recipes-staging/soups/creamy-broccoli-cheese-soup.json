  "id": "creamy-broccoli-cheese-soup",
  "name": "Creamy Broccoli Cheese Soup",
  "subtitle": "A smooth, hearty soup with broccoli, potatoes, and cheddar.",
  "description": "Onion, potato, and broccoli simmer in chicken stock before cream and cheddar are added for a rich, comforting soup.",
  "meal_type": "soup",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
