      "item": "Oyster crackers",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm a pot over medium heat. Add the chopped bacon and cook, stirring occasionally, until browned and crisp.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Drain off excess bacon fat, leaving the bacon in the pot."
    },
    {
      "step": 3,
      "text": "Add the celery and onion. Cook, stirring, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the flour and cook briefly to remove its raw taste.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Add the potatoes, clam juice, milk, and clams. Bring the chowder to a gentle simmer, then cook until heated through.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Season with salt and ground white pepper to taste."
    },
    {
      "step": 7,
      "text": "Serve topped with the bacon and oyster crackers."
    }
  ],
