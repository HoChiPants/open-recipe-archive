  "id": "new-england-clam-chowder-for-two",
  "name": "New England Clam Chowder for Two",
  "subtitle": "A creamy clam and potato soup",
  "description": "Bacon, celery, onion, potatoes, clams, and milk come together in a small batch of comforting chowder.",
  "meal_type": "soup",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "strips-bacon-strips",
      "item": "strips bacon strips",
      "quantity": 2,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "stalks-celery",
      "item": "stalks celery",
      "quantity": 2,
      "preparation": "diced"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "diced"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.5 ounce, diced, drained"
    },
    {
      "ingredient_id": "clam-juice",
      "item": "clam juice",
