      "quantity": 1,
      "unit": "can",
      "preparation": "6.5 ounce, chopped"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "Salt to taste",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "ground-white-pepper-to-taste",
      "item": "Ground white pepper to taste",
      "quantity": 1,
      "unit": "pinch"
    },
    {
