  "instructions": [
    {
      "step": 1,
      "text": "Heat the sunflower oil in a large pan over medium heat. Add the onion and onion granules; cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the garlic and cook for 3 minutes, stirring.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Arrange the potatoes, sweet potato, parsnips, carrots, butter beans, chickpeas, pearl barley, brisket, date syrup or honey, paprikas, tomato purée, and the onion mixture in a slow cooker. Stir to combine."
    },
    {
      "step": 4,
      "text": "Cover and cook on the slow-cook setting for 10 hours, until the vegetables and barley are tender and the beef reaches 145°F in the center. Rest the beef for 3 minutes before serving.",
      "timer_minutes": 600
    },
    {
      "step": 5,
      "text": "Stir gently and serve hot."
    }
  ],
