  "instructions": [
    {
      "step": 1,
      "text": "Boil the potatoes until tender, about 15 minutes. Drain, then cook briefly to remove excess moisture and mash until smooth.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Combine the mashed potatoes with the bread flour, yeast, and chopped herbs. Knead until smooth, about 8 minutes, then transfer the dough to a bowl and leave it to rise.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Heat 2 tbsp olive oil in a large pot. Cook the onions and finely chopped root vegetables until softened, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Add the garlic, tomato purée, and smoked paprika. Stir and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the bulgur, rinsed lentils, and vegetable stock. Bring to a simmer and cook until the lentils are tender, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Blend the soup until smooth, then set it aside to cool slightly."
    },
    {
      "step": 7,
      "text": "Divide the dough and shape each portion into a thick flatbread, dusting with flour as needed."
    },
    {
      "step": 8,
      "text": "Heat a pan and cook the flatbreads for about 2 minutes per side, brushing with the remaining olive oil as needed.",
      "timer_minutes": 4
    },
    {
      "step": 9,
      "text": "Warm olive oil with the smoked paprika and cumin seeds for 2 minutes. Add the mint leaves and remove from the heat.",
      "timer_minutes": 2
    },
    {
      "step": 10,
      "text": "Serve the soup with yogurt, the mint oil, and the potato flatbreads."
    }
  ],
