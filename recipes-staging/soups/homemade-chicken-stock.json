  "id": "homemade-chicken-stock",
  "name": "Homemade Chicken Stock",
  "subtitle": "A clear, savory stock with chicken and vegetables",
  "description": "Simmer chicken with aromatic vegetables and spices, then clarify the finished stock with egg for a clean, light broth.",
  "meal_type": "soup",
  "cuisine": "American",
