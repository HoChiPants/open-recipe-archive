  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken, onion, celery, carrot, salt, cloves, and water in a large pot. Bring to a simmer over medium heat, then lower the heat and cook gently for 60 minutes. Check the thickest chicken piece with a thermometer; it must reach 165°F.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Remove the chicken and vegetables, then strain the liquid into a clean pot. Reserve or discard the solids as desired."
    },
    {
      "step": 3,
      "text": "Whisk the egg with the cold water. Stir this mixture into the hot stock and cook gently for 5 minutes, checking that the liquid reaches 160°F. Strain again and serve hot.",
      "timer_minutes": 5
    }
  ],
