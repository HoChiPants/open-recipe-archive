  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Mix the softened butter, brown sugar, and cinnamon. Cut the bread into cubes and toss with the melted butter and cinnamon mixture."
    },
    {
      "step": 3,
      "text": "Spread the bread cubes on a baking sheet and bake until crisp, about 10 minutes. Cut or break into smaller croutons if needed.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Melt the remaining butter in a large pot. Add the onion and cook until tender."
    },
    {
      "step": 5,
      "text": "Stir in the broth, bring to a simmer, and cook for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Blend the broth mixture until smooth, then return it to the pot."
    },
    {
      "step": 7,
      "text": "Stir in the pumpkin, salt, cinnamon, ginger, and pepper. Simmer for 10 minutes, then stir in the cream and heat gently without boiling.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "If using broth that is not commercially prepared and fully cooked, verify that the soup reaches 165°F with a food thermometer. Serve with the cinnamon croutons."
    }
  ],
