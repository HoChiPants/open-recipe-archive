  "id": "cream-of-pumpkin-soup",
  "name": "Cream of Pumpkin Soup",
  "subtitle": "Smooth pumpkin soup with cinnamon toast cubes",
  "description": "A savory pumpkin soup simmered with onion, warm spices, and cream, served with crisp cinnamon-sugar bread cubes.",
