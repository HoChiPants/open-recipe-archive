  "id": "chicken-sweet-potato-and-peanut-stew",
  "name": "Chicken, Sweet Potato, and Peanut Stew",
  "subtitle": "A hearty one-pot stew with warming spices and tender vegetables.",
  "description": "Chicken, sweet potatoes, tomatoes, peppers, and peanut butter simmer together for a rich, satisfying stew finished with coriander and chopped peanuts.",
  "meal_type": "soup",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
