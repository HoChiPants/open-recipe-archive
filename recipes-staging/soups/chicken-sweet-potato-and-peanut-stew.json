  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large pot. Add the chicken thighs and cook for 5 minutes, turning as needed. Transfer the chicken to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the onions to the pot and cook until softened, about 12 minutes. Stir in the ginger, garlic, and cumin, then cook briefly until fragrant.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Add the sweet potatoes, peanut butter, chicken stock, and chopped tomatoes. Return the chicken to the pot and stir to combine."
    },
    {
      "step": 4,
      "text": "Add the frozen peppers, cover, and simmer until the sweet potatoes are tender and the chicken is cooked through, about 35 minutes. Check that the thickest chicken pieces reach 165°F.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Stir the stew, then serve topped with the chopped coriander and peanuts."
    }
  ],
