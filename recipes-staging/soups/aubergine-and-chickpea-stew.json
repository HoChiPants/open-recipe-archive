  "instructions": [
    {
      "step": 1,
      "text": "Simmer the soaked chickpeas in water until tender, then drain."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large pan and cook the sliced onions for 10 minutes until softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the garlic, baharat, and cinnamon; stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Transfer the chickpeas, parsley stalks, aubergines, and tomatoes to a slow cooker or suitable covered cooking vessel. Stir in the onion mixture."
    },
    {
      "step": 5,
      "text": "Cook until the chickpeas and aubergines are tender, following the stated 10-hour cooking time.",
      "timer_minutes": 600
    },
    {
      "step": 6,
      "text": "Stir in the lemon juice and chopped parsley leaves. Top with toasted pine nuts."
    },
    {
      "step": 7,
      "text": "Serve with optional olive oil and pitta breads or flatbreads."
    }
  ],
