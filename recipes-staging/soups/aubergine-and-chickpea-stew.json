  "id": "aubergine-and-chickpea-stew",
  "name": "Aubergine and Chickpea Stew",
  "subtitle": "A warming slow-cooked stew with fragrant spices and toasted pine nuts.",
  "description": "Tender chickpeas and aubergines simmer with tomatoes, onion, garlic, and warm spices, then finish with lemon, parsley, and pine nuts.",
  "meal_type": "soup",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
