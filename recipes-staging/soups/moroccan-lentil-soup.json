  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. Add the onions, garlic, and ginger; sauté for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the water, lentils, garbanzo beans, cannellini beans, tomatoes, carrots, celery, garam masala, cardamom, cayenne, and cumin."
    },
    {
      "step": 3,
      "text": "Bring the soup to a simmer, then cook until the lentils and vegetables are tender, stirring occasionally."
    },
    {
      "step": 4,
      "text": "Stir well and serve hot."
    }
