  "id": "thai-sweet-potato-soup",
  "name": "Thai Sweet Potato Soup",
  "subtitle": "A smooth, gently spicy soup with coconut milk",
  "description": "Sweet potatoes and carrots simmer with curry paste, ginger, garlic, and coconut milk, then blend into a warming soup.",
  "meal_type": "soup",
  "cuisine": "Asian Inspired",
