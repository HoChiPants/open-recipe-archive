  "instructions": [
    {
      "step": 1,
      "text": "Combine the beef shank and water in a large stockpot. Bring to a simmer, skimming the surface as needed."
    },
    {
      "step": 2,
      "text": "Add the carrots, three peeled onions, celery, bay leaf, peppercorns, and salt and pepper. Simmer gently for 4 hours, until the beef is tender and reaches at least 145°F; rest it for 3 minutes before cutting.",
      "timer_minutes": 240
    },
    {
      "step": 3,
      "text": "Transfer the beef to a plate and cool it until easy to handle. Remove the meat from the bone, cut it into pieces, and chill it. Strain and reserve the broth."
    },
    {
      "step": 4,
      "text": "Heat the vegetable oil in a large pot. Add the diced onion and garlic; cook, stirring, for 5 minutes. Stir in the paprika.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the cabbage and cook, stirring occasionally, for 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Return the beef to the pot and add the celery and tomatoes with juice. Add the reserved broth and cook for 60 minutes, until the cabbage is tender.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Stir in the lemon juice, sugar, dill, and additional salt and pepper to taste. Cook for 5 minutes, then adjust the seasoning and serve hot.",
      "timer_minutes": 5
    }
  ],
