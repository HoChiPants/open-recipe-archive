  "id": "chicken-fajita-soup",
  "name": "Chicken Fajita Soup",
  "subtitle": "A colorful, pepper-packed chicken soup with fajita seasoning.",
  "description": "Chicken, peppers, onion, beans, and fire-roasted tomatoes simmer together in a warmly seasoned broth for a hearty soup.",
  "meal_type": "soup",
