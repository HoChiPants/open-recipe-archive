  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large pot over medium heat. Add the chicken and cook until lightly browned, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the peppers and onion. Season with salt and pepper, then cook until the vegetables begin to soften, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the fajita seasoning, then add the black beans, tomatoes, and chicken broth."
    },
    {
      "step": 4,
      "text": "Bring the soup to a gentle boil, reduce the heat, and simmer for 30 minutes. Check that the chicken reaches 165°F in the thickest piece.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Stir in the hot sauce, adjust the salt and pepper, and serve hot."
    }
  ],
