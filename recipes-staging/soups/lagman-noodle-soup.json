  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. Add the onion and cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the beef, cumin, black pepper, and green bell pepper. Cook the beef for 5 minutes, stirring to brown it evenly; verify that it reaches at least 145°F, then allow a 3-minute rest before serving.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the tomato paste and carrot. Cook for 3 minutes, add the remaining pepper, and cook for 1 minute more.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Add the potatoes and celery, then cook for 5 minutes. Pour in the water and bring the mixture to a simmer.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Cover and simmer until the potatoes are tender, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Stir in the parsley and garlic. Continue simmering for 15 minutes, then season with the salt.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Cook the noodles in boiling salted water for 5 minutes, or until tender. Drain well.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Divide the noodles among bowls and ladle the hot soup over them."
    }
  ],
