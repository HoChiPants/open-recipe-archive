  "id": "pressure-cooker-creamy-mushroom-soup",
  "name": "Pressure-Cooker Creamy Mushroom Soup",
  "subtitle": "A rich mushroom soup finished with thyme and cream.",
  "description": "Sautéed mushrooms, aromatics, broth, and sherry cook under pressure, then receive a creamy flour thickener before serving.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
