      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Set the pressure cooker to sauté. Melt the butter, then cook the onion for 3 minutes. Add the garlic and cook for 2 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the mushrooms and cook until they begin to soften, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Pour in the chicken broth and sherry. Stir in the thyme, Worcestershire sauce, salt, and pepper."
    },
    {
      "step": 4,
      "text": "Secure the lid and cook at high pressure for 5 minutes. Allow a 15-minute natural release, then vent any remaining pressure.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Set the cooker to sauté or simmer. Whisk the flour and heavy cream together until smooth."
    },
    {
      "step": 6,
      "text": "Stir the cream mixture into the simmering soup and cook until thickened, about 3 minutes. Verify the soup reaches 165°F with a food thermometer.",
      "timer_minutes": 3
    },
    {
      "step": 7,
      "text": "Taste and adjust with the reserved salt and pepper amounts as desired. Serve hot."
    }
  ],
