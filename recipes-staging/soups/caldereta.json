  "instructions": [
    {
      "step": 1,
      "text": "Combine the beef, chorizo, garlic, vinegar, soy sauce, and tomato sauce in a large pot. Bring the mixture to a gentle simmer and cook the beef for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a separate large pot or skillet. Cook the onion, green bell pepper, and ground black pepper for 10 minutes, until softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the soy sauce and tomato sauce, then stir in the beef and chorizo mixture.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Bring the stew to a simmer, cover, and cook for 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Stir in the peeled potatoes, drained peas, salt, and ground black pepper. Simmer for 30 minutes, until the potatoes are tender and the beef is tender. Check with a food thermometer: chorizo sausage must reach 160°F, and beef cubes must reach 145°F followed by a 3-minute rest.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Adjust the seasoning if needed and serve hot."
    }
  ],
