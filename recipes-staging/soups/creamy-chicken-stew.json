  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven grill. Warm the olive oil and butter in a large ovenproof skillet or casserole, then cook the leeks for 10 minutes until softened.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the chicken thighs and chicken stock. Bring to a simmer, cover, and cook for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Stir in the Dijon mustard, crème fraîche, and frozen peas. Cook until the peas are hot and the chicken reaches 165°F at the thickest point."
    },
    {
      "step": 4,
      "text": "Mix the breadcrumbs with the chopped parsley and scatter over the stew. Add extra olive oil if needed, then grill until the topping is golden and the stew is bubbling."
    }
  ],
