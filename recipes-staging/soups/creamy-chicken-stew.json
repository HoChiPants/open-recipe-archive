  "id": "creamy-chicken-stew",
  "name": "Creamy Chicken Stew",
  "subtitle": "Chicken, leeks, peas, and mustard in a creamy broth",
  "description": "A comforting chicken stew finished with peas, crème fraîche, parsley, and crisp breadcrumbs.",
  "meal_type": "soup",
