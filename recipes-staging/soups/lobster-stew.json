  "id": "lobster-stew",
  "name": "Lobster Stew",
  "subtitle": "Creamy lobster stew for six",
  "description": "Cooked lobster warmed in butter and gently simmered with half-and-half for a rich, simple soup.",
  "meal_type": "soup",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "lobster-meat",
      "item": "lobster meat",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cooked"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "half-and-half-cream",
      "item": "half-and-half cream",
      "quantity": 2,
      "unit": "quarts"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a large pot over medium heat and melt the butter."
    },
    {
      "step": 2,
      "text": "Add the cooked lobster meat and sauté briefly until heated through."
    },
    {
      "step": 3,
      "text": "Pour in the half-and-half cream and bring the stew to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Simmer gently for 25 minutes, keeping the mixture below a boil. Confirm the lobster is opaque and steaming hot throughout.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
  ],
