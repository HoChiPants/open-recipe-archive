  "id": "fresh-tomato-soup-with-cheese-toast",
  "name": "Fresh Tomato Soup with Cheese Toast",
  "subtitle": "A bright tomato soup paired with crisp, cheddar-topped bread.",
  "description": "Tomatoes simmer with garlic, anchovy, and seasonings, then pair with basil and crunchy cheese toast.",
  "meal_type": "soup",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "vine-ripened-tomatoes",
      "item": "vine-ripened tomatoes",
      "quantity": 3.5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "anchovy-fillet",
      "item": "anchovy fillet",
      "quantity": 1
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "slices-italian-bread",
      "item": "slices Italian bread",
      "quantity": 8
    },
    {
      "ingredient_id": "thinly-sliced-basil-leaves",
      "item": "thinly sliced basil leaves",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sharp-white-cheddar-cheese",
      "item": "sharp white Cheddar cheese",
      "quantity": 6,
      "unit": "ounces",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the tomatoes into chunks."
    },
    {
      "step": 2,
      "text": "Melt the butter with 2 tablespoons olive oil in a large pot over medium heat. Add the garlic and anchovy and cook for 1 minute, until the anchovy is fully opaque and flakes easily or reaches 145°F.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the tomatoes, salt, and red pepper flakes. Simmer uncovered for 45 minutes, stirring occasionally, until the tomatoes are very soft.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "Blend the soup until smooth, then stir in the basil and adjust the salt to taste."
    },
    {
      "step": 5,
      "text": "Heat the oven to 450°F. Brush the bread with the remaining olive oil and arrange it on a baking sheet. Cover with the shredded Cheddar."
    },
    {
      "step": 6,
      "text": "Bake until the bread is crisp and the cheese is browned, about 20 minutes. Cool briefly and serve with the soup.",
      "timer_minutes": 20
    }
  ],
