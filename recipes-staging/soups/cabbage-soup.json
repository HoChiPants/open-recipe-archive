  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. If using, add the smoked pancetta and cook until golden brown."
    },
    {
      "step": 2,
      "text": "Add the onion, celery, and carrot. Cook, stirring occasionally, for 15 minutes, until softened.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Stir in the cabbage, garlic, sweet smoked paprika, and rosemary. Cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the chopped tomatoes and hot vegetable stock, then bring the soup to a gentle simmer."
    },
    {
      "step": 5,
      "text": "Stir in the chickpeas and simmer for 30 minutes, until the vegetables are tender and the flavors have melded.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Ladle into bowls and serve with shaved parmesan or a vegetarian alternative and crusty bread, if desired."
    }
  ],
