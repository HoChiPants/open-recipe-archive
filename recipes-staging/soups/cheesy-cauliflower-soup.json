  "id": "cheesy-cauliflower-soup",
  "name": "Cheesy Cauliflower Soup",
  "subtitle": "A creamy vegetable soup topped with crisp herb-cheese croutons.",
  "description": "Cauliflower, potato, aromatics, milk, and stock form a smooth soup finished with cheddar and served with savory baked croutons.",
  "meal_type": "soup",
