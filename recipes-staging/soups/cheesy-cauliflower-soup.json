  "instructions": [
    {
      "step": 1,
      "text": "Cut the cauliflower into florets."
    },
    {
      "step": 2,
      "text": "Warm 1 tablespoon olive oil in a large pot. Add the onion, celery, crushed garlic, cauliflower, and thyme. Cook gently until the vegetables begin to soften.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Add the potato, milk, and vegetable stock. Bring to a simmer, then cook until the potato and cauliflower are tender.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Remove the thyme. Blend the soup until smooth, then return it to low heat and stir in the grated cheddar until melted and thickened."
    },
    {
      "step": 5,
      "text": "Preheat the oven. Toss the bread with the dried mixed herbs, garlic granules, finely grated parmesan or vegetarian alternative, and 2 tablespoons olive oil."
    },
    {
      "step": 6,
      "text": "Spread the bread mixture on a baking tray and bake until crisp and golden.",
      "timer_minutes": 17
    },
    {
      "step": 7,
      "text": "Let the croutons cool briefly, then serve the soup topped with them and the remaining thyme."
    }
  ],
