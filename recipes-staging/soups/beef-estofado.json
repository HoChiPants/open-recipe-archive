  "instructions": [
    {
      "step": 1,
      "text": "Combine the beef, ají panca, dark beer or stock, beef stock, and ají amarillo paste in a large heavy pot. Bring to a simmer, then set aside briefly."
    },
    {
      "step": 2,
      "text": "Heat the oil in a separate large pot. Add the onions and garlic and cook for 10 minutes, stirring, until softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Transfer the beef mixture to the pot with the onions. Stir in the bay leaves, coriander, parsley, dried mint, and mixed chopped herbs."
    },
    {
      "step": 4,
      "text": "Add the toasted fennel, coriander, and cumin seeds and the pink peppercorns. Pour in the remaining beef stock and bring to a gentle simmer."
    },
    {
      "step": 5,
      "text": "Cover and cook gently for 60 minutes. Continue cooking for another 60 minutes, or until the beef is tender and reaches at least 145°F internally; rest the beef for 3 minutes before serving.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Add the quartered potatoes and simmer for about 20 minutes, until tender.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Prepare the cherry tomatoes in boiling water, then cool them and add them to the stew with the cannellini beans and broad beans."
    },
    {
      "step": 8,
      "text": "Stir in the ají amarillo paste and remaining chopped herbs, adjust the consistency with the cooking liquid, and serve hot."
    }
  ],
