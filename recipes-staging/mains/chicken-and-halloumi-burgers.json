  "id": "chicken-and-halloumi-burgers",
  "name": "Chicken and Halloumi Burgers",
  "subtitle": "Chilli-lemon chicken with crisp slaw and grilled cheese",
  "description": "Build warm burger buns with juicy chilli-lemon chicken, seared halloumi, cabbage slaw, dip, greens, and roasted peppers.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-breast-fillets",
      "item": "chicken breast fillets",
      "quantity": 2
    },
    {
      "ingredient_id": "oil-plus-extra-for-frying-the-halloumi",
      "item": "oil plus extra for frying the halloumi",
      "quantity": 1,
      "unit": "tbsp",
      "preparation": "if needed"
    },
    {
      "ingredient_id": "piri-piri-sauce-or-other-mild-chilli-sauce",
      "item": "piri-piri sauce or other mild chilli sauce",
      "quantity": 4,
      "unit": "tbsp",
      "preparation": "plus extra for drizzling"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "burger-buns-split-in-half",
      "item": "burger buns split in half"
    },
    {
      "ingredient_id": "block-lighter-halloumi-sliced-into-8-pieces",
      "item": "block lighter halloumi sliced into 8 pieces",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "white-cabbage-finely-sliced",
      "item": "white cabbage finely sliced",
      "quantity": "1/4",
      "unit": "small"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "hummus-tzatziki-or-soured-cream-chive-dip",
      "item": "hummus tzatziki or soured cream & chive dip",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "handful-of-rocket-or-4-8-soft-lettuce-leaves",
      "item": "handful of rocket or 4-8 soft lettuce leaves"
    },
    {
      "ingredient_id": "roasted-red-peppers-from-a-jar",
      "item": "roasted red peppers from a jar",
      "quantity": 2,
      "unit": "large",
      "preparation": "drained and sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Flatten the chicken breasts to an even thickness. Toss them with the piri-piri sauce and lemon juice, reserving some sauce for drizzling."
    },
    {
      "step": 2,
      "text": "Heat the oil in a large frying pan over medium-high heat. Cook the chicken for about 4 minutes per side, then continue cooking until the thickest part reaches 165°F.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Meanwhile, heat a grill or broiler. Toast the split buns for 2 minutes, and warm the roasted peppers briefly.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Mix the sliced cabbage with the mayonnaise and a little lemon juice to make a slaw."
    },
    {
      "step": 5,
      "text": "Heat a little extra oil if needed and fry the halloumi slices until golden on both sides, about 10 minutes total.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Spread the dip over the buns. Fill with the greens, slaw, chicken, halloumi, and peppers. Drizzle with the remaining chilli sauce and serve."
    }
  ],
