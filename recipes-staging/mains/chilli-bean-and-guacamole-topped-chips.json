      "preparation": "plus a few leaves to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven according to the oven-chip package directions."
    },
    {
      "step": 2,
      "text": "Toss the frozen oven chips with the Cajun-style spice mix, then cook until crisp and golden, following the package timing."
    },
    {
      "step": 3,
      "text": "Combine the sliced red onion, juiced lime, and caster sugar. Set aside to lightly pickle."
    },
    {
      "step": 4,
      "text": "Mash the chopped avocado with the lime zest and juice, chilli flakes, and chopped coriander. Set aside."
    },
    {
      "step": 5,
      "text": "Warm the baked beans with the grated garlic and a little of the Cajun-style spice mix in a saucepan."
    },
    {
      "step": 6,
      "text": "Transfer the cooked chips to an ovenproof dish, spoon over the beans, and scatter with grated cheddar."
    },
    {
      "step": 7,
      "text": "Return the dish to the oven for about 4 minutes, until the cheese has melted.",
      "timer_minutes": 4
    },
    {
      "step": 8,
      "text": "Top with the pickled onion and guacamole. Finish with extra chilli flakes, if using, and the reserved coriander leaves."
    }
  ],
