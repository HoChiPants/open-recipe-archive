  "id": "chilli-bean-and-guacamole-topped-chips",
  "name": "Chilli Bean and Guacamole-Topped Chips",
  "subtitle": "Crisp oven chips layered with spiced beans, cheddar, and fresh guacamole",
  "description": "A hearty vegetarian tray of seasoned chips topped with warm beans, melted cheddar, tangy onion, and bright guacamole.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
