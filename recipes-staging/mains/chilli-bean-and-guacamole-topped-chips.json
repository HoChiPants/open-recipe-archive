      "item": "frozen oven chips",
      "quantity": 450,
      "unit": "g"
    },
    {
      "ingredient_id": "plus-1-tsp-cajun-style-spice-mix",
      "item": "plus 1 tsp Cajun-style spice mix",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "can-baked-beans",
      "item": "can baked beans",
