      "ingredient_id": "8-ounce-fillets-beef-tenderloin-filet",
      "item": "(8 ounce) fillets beef tenderloin filet",
      "quantity": 2,
      "preparation": "1 1/2 inch thick"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
