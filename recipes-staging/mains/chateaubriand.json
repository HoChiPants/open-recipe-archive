  "instructions": [
    {
      "step": 1,
      "text": "Let the beef stand at room temperature for 60 minutes. Pat dry, coat with the oil, and season with pepper.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Preheat the oven and heat an oven-safe skillet over high heat."
    },
    {
      "step": 3,
      "text": "Add the butter to the hot skillet. Sear the fillets for 5 minutes, turning as needed for even browning.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Transfer the skillet to the preheated oven and cook for 5 minutes, or until the centers reach 145°F. Remove from the oven and rest for at least 3 minutes before serving.",
      "timer_minutes": 5
    }
