  "id": "cottage-cheese-chicken-enchiladas",
  "name": "Cottage Cheese Chicken Enchiladas",
  "subtitle": "Chicken enchiladas with a creamy cheese filling",
  "description": "Shredded chicken, chiles, and seasoned vegetables are rolled in corn tortillas, covered with enchilada sauce, and baked under melted Monterey Jack.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 2,
      "preparation": "boneless chicken breast halves - boiled and shredded"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "green-chile-peppers",
      "item": "green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "7 ounce, chopped"
    },
    {
      "ingredient_id": "taco-seasoning-mix",
      "item": "taco seasoning mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1 ounce"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cottage-cheese",
      "item": "cottage cheese",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "6-inch-corn-tortillas",
      "item": "(6 inch) corn tortillas",
      "quantity": 12
    },
    {
      "ingredient_id": "monterey-jack-cheese",
      "item": "Monterey Jack cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "red-enchilada-sauce",
      "item": "red enchilada sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and lightly oil a baking dish with the vegetable oil."
    },
    {
      "step": 2,
      "text": "Cook the onion, green chile peppers, and ground black pepper in the remaining oil until lightly browned. Stir in the taco seasoning mix."
    },
    {
      "step": 3,
      "text": "Combine the sour cream, cottage cheese, salt, and half of the Monterey Jack cheese. Fold in the seasoned vegetables and shredded chicken."
    },
    {
      "step": 4,
      "text": "Spread a little red enchilada sauce in the baking dish. Fill each corn tortilla with the chicken mixture, roll it up, and place it seam-side down."
    },
    {
      "step": 5,
      "text": "Cover the enchiladas with the remaining red enchilada sauce and Monterey Jack cheese."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until the cheese is melted and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
