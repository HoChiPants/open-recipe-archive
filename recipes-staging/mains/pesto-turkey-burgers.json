      "item": "seasoned salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "bread-crumbs",
      "item": "bread crumbs",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "seasoned-salt",
      "item": "seasoned salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill to medium heat."
    },
    {
      "step": 2,
      "text": "Combine the turkey, pesto, garlic, feta, 1½ teaspoons seasoned salt, and breadcrumbs until just mixed."
    },
    {
      "step": 3,
      "text": "Shape the mixture into four evenly sized patties."
    },
    {
      "step": 4,
      "text": "Grill the patties for about 5 minutes per side, turning once, until the centers reach 165°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Sprinkle with the remaining ½ teaspoon seasoned salt and serve."
    }
  ],
