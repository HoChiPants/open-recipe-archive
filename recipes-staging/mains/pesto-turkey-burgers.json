  "id": "pesto-turkey-burgers",
  "name": "Pesto Turkey Burgers",
  "subtitle": "Juicy turkey patties with basil pesto and feta",
  "description": "Mix seasoned turkey with pesto, garlic, feta, and breadcrumbs, then grill until safely cooked for a quick dinner.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "lean-ground-turkey",
      "item": "lean ground turkey",
      "quantity": 1.25,
      "unit": "pounds"
    },
    {
      "ingredient_id": "basil-pesto",
      "item": "basil pesto",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "crumbled-feta-cheese",
      "item": "crumbled feta cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
