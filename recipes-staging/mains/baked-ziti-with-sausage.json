  "instructions": [
    {
      "step": 1,
      "text": "Cut the sausages into small pieces. Heat the olive oil in a large pot over medium heat, then add the sausage and diced onion. Cook for 7 minutes, stirring, until the sausage is browned and reaches 160°F.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Stir in the oregano, thyme, and rosemary for 1 minute. Add the marinara sauce and water, stir to combine, and bring to a simmer.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the ziti and cook for 2 minutes, stirring occasionally. Remove from the heat and let stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Heat the oven to 375°F. Lightly oil a baking dish with the drizzle olive oil."
    },
    {
      "step": 5,
      "text": "Combine the ricotta, mozzarella cubes, and Pecorino Romano. Layer the sauced pasta and cheese mixture in the prepared dish, finishing with the remaining sauce and cheese."
    },
    {
      "step": 6,
      "text": "Bake for 35 minutes, until melted and bubbling and the center reaches 165°F.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Cool for 15 minutes, sprinkle with parsley, and serve.",
      "timer_minutes": 15
    }
  ],
