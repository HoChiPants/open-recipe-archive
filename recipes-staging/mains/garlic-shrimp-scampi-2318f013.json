{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "garlic-shrimp-scampi-2318f013",
  "name": "Garlic Shrimp Scampi",
  "subtitle": "Crisp, paprika-seasoned shrimp finished with browned garlic butter",
  "description": "Shell-on shrimp are lightly coated with seasoned rice flour, pan-cooked in olive oil, and finished with golden garlic and butter.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "head-garlic",
      "item": "head garlic",
      "quantity": 1
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "frozen-large-deveined",
      "item": "frozen large deveined",
      "quantity": 1,
      "unit": "pound",
      "preparation": "shell-on shrimp, thawed"
    },
    {
      "ingredient_id": "rice-flour",
      "item": "rice flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Separate and peel the garlic cloves, then cut them into thin slices."
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium heat. Add the garlic and cook for 3 minutes, stirring, until golden brown. Transfer the garlic and butter to a bowl and set aside.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Combine the rice flour, paprika, kosher salt, and cayenne pepper. Add the thawed shrimp and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Heat the olive oil in the skillet over medium-high heat. Arrange the shrimp in a single layer and cook for 3 minutes, turning as needed, until opaque and cooked through.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Return the garlic and butter to the skillet and cook briefly until the shrimp are coated and hot."
    },
    {
      "step": 6,
      "text": "Serve immediately."
    }
  ],
