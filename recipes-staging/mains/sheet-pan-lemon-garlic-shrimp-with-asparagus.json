  "id": "sheet-pan-lemon-garlic-shrimp-with-asparagus",
  "name": "Sheet-Pan Lemon Garlic Shrimp with Asparagus",
  "subtitle": "A quick one-pan dinner with tender asparagus and bright lemon.",
  "description": "Asparagus roasts first, then finishes with seasoned shrimp, butter, garlic, and lemon juice for a simple weeknight main.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 12
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "fresh-asparagus",
      "item": "fresh asparagus",
      "quantity": 1,
      "unit": "pound",
      "preparation": "trimmed"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "preparation": "divided"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "divided"
    },
    {
      "ingredient_id": "uncooked-medium-shrimp",
      "item": "uncooked medium shrimp",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "peeled and deveined"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Coat a sheet pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Toss the asparagus with half the olive oil, the garlic, and half the salt and pepper. Spread it in a single layer on the pan."
    },
    {
      "step": 3,
      "text": "Roast the asparagus until beginning to turn tender.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Toss the shrimp with the remaining olive oil, salt, and pepper, plus the paprika."
    },
    {
      "step": 5,
      "text": "Arrange the shrimp over and around the asparagus, then scatter the cubed butter across the pan."
    },
    {
      "step": 6,
      "text": "Roast until the shrimp are opaque throughout and reach 145°F.",
      "timer_minutes": 6
    },
    {
      "step": 7,
      "text": "Drizzle the lemon juice over the shrimp and asparagus before serving."
    }
  ],
