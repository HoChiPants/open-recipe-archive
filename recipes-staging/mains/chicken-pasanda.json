  "instructions": [
    {
      "step": 1,
      "text": "Mix the yogurt, turmeric, chilli powder, grated garlic, and grated ginger. Coat the chicken in the mixture and marinate for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Blend or finely process the blanched almonds with the milk. Heat the mixture in the microwave for 1 minute, until set.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Heat the oil in a large pan. Add the cardamom, cinnamon, and onions; cook until the onions soften and color lightly.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Add the sliced chilli, remaining grated garlic and ginger, turmeric, ground coriander, and garam masala. Stir and cook briefly.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Add the marinated chicken and almond mixture. Bring to a gentle simmer, cover, and cook until the chicken is cooked through and reaches 165°F in the thickest pieces.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Stir in the cream and chopped coriander. Serve with rice or naan, topped with flaked roasted almonds and extra sliced chilli if desired."
    }
  ],
