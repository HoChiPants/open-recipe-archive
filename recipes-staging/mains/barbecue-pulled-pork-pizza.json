  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Prepare the dough according to its package directions, then shape it into a pizza crust."
    },
    {
      "step": 3,
      "text": "Spread the barbequed pulled pork over the dough. Arrange the red onion and dill pickle slices on top, then cover with the mozzarella."
    },
    {
      "step": 4,
      "text": "Bake for 18 minutes, until the cheese is melted and the pork reaches 145°F. Rest for 3 minutes before slicing.",
      "timer_minutes": 18
    }
