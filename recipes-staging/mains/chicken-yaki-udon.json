  "id": "chicken-yaki-udon",
  "name": "Chicken Yaki Udon",
  "subtitle": "Stir-fried udon with chicken and crisp vegetables",
  "description": "Chewy udon noodles are tossed with sliced chicken, vegetables, and a savory-spicy sauce for a quick skillet meal.",
  "meal_type": "main",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
