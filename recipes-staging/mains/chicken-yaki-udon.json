  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of salted water to a boil. Add the frozen udon and cook for 12 minutes, or until boiling and tender. Drain.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Add the chicken and cook for 4 minutes, stirring, until cooked through and the thickest pieces reach 165°F.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Add the onion, bell pepper, cabbage, carrot, garlic, and salt and pepper. Cook for 4 minutes, stirring, until the vegetables are crisp-tender.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Transfer the chicken and vegetables to a bowl. Stir the soy sauce, gochujang, and ketchup into the skillet and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Return the chicken and vegetables to the skillet, add the drained udon, and toss until evenly coated and hot. Adjust the seasoning with additional soy sauce, salt, and pepper if needed."
    }
  ],
