      "ingredient_id": "frozen-udon-noodles",
      "item": "frozen udon noodles",
      "quantity": 6,
      "unit": "ounces"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "boneless-chicken-breasts",
      "item": "boneless chicken breasts",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "cut into thin strips"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "red-bell-pepper",
      "item": "red bell pepper",
      "quantity": 0.5,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "cabbage",
      "item": "cabbage",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
