  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Arrange the halved, seeded peppers in a baking dish and roast until tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Meanwhile, bring the water to a simmer, stir in the rice, and cook until tender and the liquid is absorbed, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Warm the olive oil in a skillet. Cook the green onions, basil, Italian seasoning, salt, and black pepper for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the diced tomato and cook for 5 minutes, then stir in the cooked rice.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Fold in the feta, fill the roasted pepper halves, and serve hot."
    }
  ],
