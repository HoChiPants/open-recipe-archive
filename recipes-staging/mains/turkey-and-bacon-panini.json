  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a preheated skillet for 10 minutes, or until crisp. Drain, then cut into pieces.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Melt the butter in the skillet. Add the onion and garlic; cook for 10 minutes until softened. Stir in the spinach and cook for 3 minutes until wilted.",
      "timer_minutes": 13
    },
    {
      "step": 3,
      "text": "Stir together the mayonnaise, minced chipotle peppers, and adobo sauce."
    },
    {
      "step": 4,
      "text": "Spread the sauce on the focaccia. Fill with turkey, provolone, bacon, and the spinach mixture, then close the sandwiches."
    },
    {
      "step": 5,
      "text": "Cook the sandwiches in a preheated panini press for 5 minutes, until golden brown and the cheese is melted.",
      "timer_minutes": 5
    }
  ],
