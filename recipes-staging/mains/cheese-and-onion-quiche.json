      "item": "bunch of chives finely chopped",
      "unit": "small"
    },
    {
      "ingredient_id": "cheddar-cheese-grated",
      "item": "cheddar cheese grated",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "green-salad-optional",
      "item": "green salad (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly oil a quiche tin. Dust the work surface with plain flour, unroll the pastry, and use it to line the tin. Trim the edges, prick the base, and chill the shell.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Preheat the oven according to the pastry package directions."
    },
    {
      "step": 3,
      "text": "Warm the olive oil in a pan. Stir in the white onion and cook until softened, about 15 minutes. Add the spring onions and cook briefly, then transfer the mixture to a bowl.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Line the chilled pastry with baking paper and baking weights. Bake for 20 minutes, then remove the paper and weights and bake for 10 minutes more.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Whisk the eggs, egg yolk, milk, and chives together. Scatter the onion mixture and cheddar over the pastry shell, then pour in the egg mixture."
    },
    {
      "step": 6,
      "text": "Bake until the center is firm and reaches 160°F, about 30 minutes. Cool for 15 minutes before slicing.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Serve with green salad, if desired."
    }
  ],
