  "id": "cheese-and-onion-quiche",
  "name": "Cheese and Onion Quiche",
  "subtitle": "A savory quiche with tender onions, chives, and cheddar.",
  "description": "A crisp shortcrust pastry shell filled with softened onions, herbs, milk, eggs, and grated cheddar. Serve warm or cooled with green salad.",
  "meal_type": "main",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil-plus-extra-for-the-tin",
      "item": "olive oil plus extra for the tin",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "plain-flour-for-dusting",
      "item": "plain flour for dusting"
    },
    {
      "ingredient_id": "pack-ready-rolled-shortcrust-pastry",
      "item": "pack ready rolled shortcrust pastry",
      "quantity": 320,
      "unit": "g"
    },
    {
      "ingredient_id": "white-onion-finely-chopped",
      "item": "white onion finely chopped",
      "quantity": 1
    },
    {
