  "instructions": [
    {
      "step": 1,
      "text": "Combine the cabbage, apple, lemon juice, water, and part of the salt in a saucepan. Simmer until the cabbage begins to soften."
    },
    {
      "step": 2,
      "text": "Preheat a large skillet for 15 minutes. Add the butter and cook the onion until softened.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Add the cabbage mixture, remaining salt, pepper, vinegar, and sausage to the skillet. Cook until the cabbage is tender and the sausage reaches 160°F internally.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Toss the sausage through the cabbage and serve hot."
    }
