  "id": "spaghetti-with-bacon",
  "name": "Spaghetti with Bacon",
  "subtitle": "A quick pasta dinner with crisp bacon and fresh parsley",
  "description": "Tender spaghetti is tossed with olive oil, bacon, garlic, and parsley for a savory, uncomplicated meal.",
  "meal_type": "main",
