  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of water to a boil. Add the spaghetti and cook until tender, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Drain the spaghetti and set it aside."
    },
    {
      "step": 3,
      "text": "Preheat a large skillet over medium heat and warm the olive oil. Add the bacon and cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the garlic and continue cooking the bacon mixture for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Toss the spaghetti with the bacon mixture and chopped parsley until evenly coated."
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
