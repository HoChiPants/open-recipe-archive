  "instructions": [
    {
      "step": 1,
      "text": "Whisk 2 tablespoons olive oil, 2 tablespoons lime juice, minced garlic, and garlic powder. Add the tuna, turn to coat, cover, and refrigerate for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 2,
      "text": "Mix mango, red bell pepper, Spanish onion, green onion, cilantro, jalapeño, cayenne pepper, onion powder, and ground black pepper. Stir in the remaining 2 tablespoons lime juice and 1½ teaspoons olive oil; chill for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Combine paprika, the remaining cayenne pepper, onion powder, salt, ground black pepper, dried thyme, dried basil, and dried oregano. Remove the tuna from the marinade and press the seasoning over all sides."
    },
    {
      "step": 4,
      "text": "Heat 4 tablespoons olive oil in a heavy skillet over medium-high heat. Sear the tuna for about 3 minutes per side, turning once, until the center reaches 145°F or the fish is opaque and flakes easily.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Rest briefly, then serve the tuna with the chilled mango salsa."
    }
  ],
