  "id": "southern-style-pig-tails",
  "name": "Southern-Style Pig Tails",
  "subtitle": "Tender braised pork finished in the oven",
  "description": "Pig tails are simmered with onion, garlic, red pepper flakes, and salt, then roasted until browned and tender.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 170
  },
  "ingredients": [
    {
      "ingredient_id": "pig-tails",
      "item": "pig tails",
      "quantity": 8,
      "preparation": "rinsed"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "medium",
      "preparation": "coarsely chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 6,
      "unit": "cloves",
      "preparation": "halved"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the rinsed pig tails in a large pot and cover with water. Bring to a simmer and cook for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Drain the pig tails, then return them to the pot. Add the onion, garlic, red pepper flakes, and salt, and cover with fresh water."
    },
    {
      "step": 3,
      "text": "Bring to a gentle simmer and cook until the pig tails are tender, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 5,
      "text": "Transfer the pig tails to a roasting pan and roast until browned and tender, about 40 minutes. Confirm the meat reaches 145°F with a food thermometer, then rest for 3 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Let cool briefly before serving."
    }
  ],
