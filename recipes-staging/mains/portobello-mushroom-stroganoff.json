  "id": "portobello-mushroom-stroganoff",
  "name": "Portobello Mushroom Stroganoff",
  "subtitle": "Creamy mushrooms and noodles for a simple savory dinner",
  "description": "Tender portobello mushrooms simmer in a creamy broth-based sauce and are served over egg noodles with parsley.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "portobello-mushrooms",
      "item": "portobello mushrooms",
      "quantity": 0.75,
      "unit": "pound",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "vegetable-broth",
      "item": "vegetable broth",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "dried-egg-noodles",
      "item": "dried egg noodles",
      "quantity": 8,
      "unit": "ounces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the egg noodles in simmering water until tender, about 7 minutes; drain.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat. Add the onion and cook until softened."
    },
    {
      "step": 3,
      "text": "Add the mushrooms and cook until tender and lightly browned."
    },
    {
      "step": 4,
      "text": "Sprinkle in the flour and stir to coat the vegetables. Gradually stir in the broth and bring to a simmer."
    },
    {
      "step": 5,
      "text": "Stir in the sour cream and heat the sauce gently until it reaches 160°F on a food thermometer."
    },
    {
      "step": 6,
      "text": "Fold in the parsley, spoon the stroganoff over the noodles, and serve."
    }
  ],
