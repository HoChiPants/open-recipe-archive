  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the reserved pineapple juice with the soy sauce, vinegar, brown sugar, and flour until smooth and thickened."
    },
    {
      "step": 3,
      "text": "Stir in the peppers, celery, water chestnuts, chicken, and pineapple chunks until evenly coated."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish and cook until hot and bubbling, about 20 minutes.",
