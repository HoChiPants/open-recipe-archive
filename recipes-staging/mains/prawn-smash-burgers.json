  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Toss the potatoes with the olive oil and arrange them in a single layer on a roasting tray."
    },
    {
      "step": 2,
      "text": "Roast the potatoes for 25 minutes, stirring once, until golden brown.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Toast the coriander seeds, cumin seeds, black peppercorns, urucum seeds, fenugreek seeds, and cinnamon stick in a dry pan for 3 minutes. Transfer them to a blender and process with the spice blend, sumac, garlic powder, and paprika.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Finely chop or blend the peeled prawns. Cook the pancetta in a pan for 2 minutes, then transfer it to a bowl. Combine it with the prawns, spice blend, toasted sesame oil, and neutral oil.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Mix the coriander, chilli, onion, and lime juice for the topping. Stir the mayo with the mango chutney for the bun sauce."
    },
    {
      "step": 6,
      "text": "Shape the prawn mixture into patties. Heat a lightly oiled pan, add the patties, and press them firmly with an oiled spatula. Cook until browned and the prawns are opaque and fully cooked."
    },
    {
      "step": 7,
      "text": "Toast the halved brioche buns with the cinnamon stick until golden brown. Spread with the mayo mixture and fill with the prawn patties and coriander-onion topping."
    },
    {
      "step": 8,
      "text": "Serve the burgers with the roasted chips and lime wedges."
    }
  ],
