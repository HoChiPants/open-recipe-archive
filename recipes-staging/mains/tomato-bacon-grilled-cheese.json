  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a skillet until crisp and fully cooked. Transfer it to a paper towel-lined plate to drain."
    },
    {
      "step": 2,
      "text": "Preheat a skillet or griddle over medium heat."
    },
    {
      "step": 3,
      "text": "Butter one side of each bread slice. Place four slices butter-side down and layer each with cheese, tomato, bacon, and another cheese slice. Top with the remaining bread, butter-side up."
    },
    {
      "step": 4,
      "text": "Grill the sandwiches until the bread is golden and the cheese is melted, turning once. Cut and serve hot."
    }
  ],
