  "id": "tomato-bacon-grilled-cheese",
  "name": "Tomato Bacon Grilled Cheese",
  "subtitle": "Crisp bacon, tomato, and melted cheese between buttery toast",
  "description": "A simple skillet sandwich layered with bacon, tomato, and American cheese.",
