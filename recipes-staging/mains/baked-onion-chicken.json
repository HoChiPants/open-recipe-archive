  "id": "baked-onion-chicken",
  "name": "Baked Onion Chicken",
  "subtitle": "Tender chicken baked with buttery onion seasoning",
  "description": "Chicken tenderloins are coated with melted margarine and onion soup seasoning, then baked until fully cooked.",
