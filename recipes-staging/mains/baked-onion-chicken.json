  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Arrange the chicken in a baking dish and coat it with the melted margarine."
    },
    {
      "step": 3,
      "text": "Season with salt and pepper, then sprinkle the dry onion soup mix evenly over the chicken."
    },
    {
      "step": 4,
      "text": "Bake for 40 minutes, or until the thickest piece reaches 165°F on a food thermometer.",
      "timer_minutes": 40
