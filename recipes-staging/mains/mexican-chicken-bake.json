{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "mexican-chicken-bake",
  "name": "Mexican Chicken Bake",
  "subtitle": "Seasoned chicken with salsa and melted cheese",
  "description": "Chicken breasts are browned with cumin and garlic, then baked with salsa and shredded cheese until fully cooked.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "boneless",
      "item": "boneless",
      "quantity": 4,
      "preparation": "skinless chicken breasts"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "mexican-cheese-blend",
      "item": "Mexican cheese blend",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "salsa",
      "item": "salsa",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Combine the cumin, garlic powder, salt, and pepper."
    },
    {
      "step": 2,
      "text": "Heat the oil in an oven-safe skillet over medium-high heat. Add the chicken and cook until lightly browned, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Sprinkle the seasoning mixture over the chicken and cook until lightly browned on the remaining sides, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Transfer the chicken to a baking dish. Spread the salsa around and over the chicken, then cover with the shredded cheese."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, until the cheese is melted and the thickest part of each chicken breast reaches 165°F on a food thermometer.",
      "timer_minutes": 25
    }
  ],
