  "id": "roasted-zucchini-casserole",
  "name": "Roasted Zucchini Casserole",
  "subtitle": "Roasted vegetables, penne, and marinara baked with Parmesan",
  "description": "A warm vegetarian pasta casserole combining roasted zucchini and onions with marinara, penne, and a Parmesan topping.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 65
  },
  "ingredients": [
    {
      "ingredient_id": "zucchinis",
      "item": "zucchinis",
      "quantity": 3,
      "unit": "medium",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "unit": "medium",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "penne-pasta",
      "item": "penne pasta",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "28-ounce-jar-marinara-sauce",
      "item": "(28 ounce) jar marinara sauce",
      "quantity": 1
    },
    {
