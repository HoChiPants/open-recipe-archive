      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Toss the sliced zucchini and onions with the olive oil, then spread them evenly in a baking dish or roasting pan."
    },
    {
      "step": 2,
      "text": "Roast the vegetables for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Season the roasted vegetables with salt and ground black pepper to taste."
    },
    {
      "step": 4,
      "text": "Cook the penne in salted water until tender, about 11 minutes. Drain.",
      "timer_minutes": 11
    },
    {
      "step": 5,
      "text": "Reduce the oven temperature to 350°F. Warm the marinara sauce, then combine it with the roasted vegetables and drained penne in a baking dish."
    },
    {
      "step": 6,
      "text": "Sprinkle the grated Parmesan evenly over the top and bake for 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Rest briefly before serving."
    }
  ],
