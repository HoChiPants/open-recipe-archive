  "id": "barley-and-broad-bean-risotto",
  "name": "Barley and Broad Bean Risotto",
  "subtitle": "A creamy, herb-flecked barley supper with lemon and beans",
  "description": "Pearl barley is simmered in vegetable stock until tender, then finished with broad beans, lemon, herbs, ricotta, and parmesan for a fresh, creamy main dish.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "onion-finely-chopped",
      "item": "onion finely chopped",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "garlic-cloves-crushed",
      "item": "garlic cloves crushed",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "pearl-barley",
      "item": "pearl barley",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "hot-vegetable-stock",
      "item": "hot vegetable stock",
      "quantity": "700-800",
      "unit": "ml"
    },
    {
      "ingredient_id": "frozen-broad-beans-podded",
      "item": "frozen broad beans podded",
      "quantity": 250,
      "unit": "g",
      "preparation": "defrosted"
    },
    {
      "ingredient_id": "lemon-zested",
      "item": "lemon zested",
      "quantity": 1
    },
    {
      "ingredient_id": "finely-chopped-mint-plus-extra-to-serve",
      "item": "finely chopped mint plus extra to serve",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "ricotta",
      "item": "ricotta",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "finely-chopped-basil",
      "item": "finely chopped basil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "parmesan-or-vegetarian-alternative",
      "item": "parmesan or vegetarian alternative",
      "quantity": 2,
      "unit": "tbsp",
      "preparation": "grated, plus extra to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large saucepan over medium heat. Add the onion and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the crushed garlic and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the barley and enough hot vegetable stock to cover it. Bring to a gentle simmer, then cook for about 35 minutes, stirring occasionally and adding more stock as needed, until the barley is tender and the mixture is thick.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "Stir in the defrosted broad beans, lemon zest, mint, ricotta, basil, and grated parmesan or vegetarian alternative. Warm through and adjust the consistency with any remaining stock."
    },
    {
      "step": 5,
      "text": "Spoon into bowls and finish with the extra mint and parmesan or vegetarian alternative."
    }
  ],
