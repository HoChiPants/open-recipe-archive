  "id": "chicken-and-mushroom-pancake-topping",
  "name": "Chicken and Mushroom Pancake Topping",
  "subtitle": "Creamy mushroom sauce with chicken and parsley",
  "description": "A quick savory topping combining tender chicken and mushrooms in a creamy mustard sauce, suitable for serving over pancakes.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "a-large-knob-of-butter",
      "item": "a large knob of butter"
    },
    {
      "ingredient_id": "chestnut-mushrooms",
      "item": "chestnut mushrooms",
      "quantity": 250,
      "unit": "g",
      "preparation": "chopped"
    },
