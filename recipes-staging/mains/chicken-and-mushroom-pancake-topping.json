      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "mushroom-ketchup",
      "item": "mushroom ketchup",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
