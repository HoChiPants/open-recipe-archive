      "item": "a handful chopped parsley"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a skillet over medium heat. Add the mushrooms and mushroom ketchup, then cook until the mushrooms soften, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Stir in the garlic and flour. Gradually add the milk, then mix in the Dijon mustard and remaining mushroom ketchup.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Cook, stirring, until the sauce thickens."
    },
    {
      "step": 4,
      "text": "Add the cooked chicken and parsley, and stir until evenly coated and hot. If the chicken was not already fully reheated, warm it to 165°F."
    },
    {
      "step": 5,
      "text": "Serve the chicken and mushroom mixture over pancakes."
    }
  ],
