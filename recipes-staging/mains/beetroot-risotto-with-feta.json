  "id": "beetroot-risotto-with-feta",
  "name": "Beetroot Risotto with Feta",
  "subtitle": "A creamy beetroot rice dish finished with lemon, feta, and dill.",
  "description": "Grated beetroot gives this risotto its vibrant color and earthy flavor, balanced by lemon and salty feta.",
  "meal_type": "main",
  "yield": {
