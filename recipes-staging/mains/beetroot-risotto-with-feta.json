  "instructions": [
    {
      "step": 1,
      "text": "Warm the vegetable stock in a separate saucepan and keep it hot over low heat."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a wide saucepan. Add the onion and beetroot, then cook until softened, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Stir in the garlic and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the risotto rice and white wine. Stir until the wine is mostly absorbed."
    },
    {
      "step": 5,
      "text": "Add the hot stock a ladleful at a time, stirring regularly and waiting for each addition to absorb before adding more."
    },
    {
      "step": 6,
      "text": "Continue until the rice is tender and the risotto is thick and creamy. Stir in the parmesan or vegetarian alternative, lemon zest, and lemon juice."
    },
    {
      "step": 7,
      "text": "Spoon into bowls and top with feta, dill if using, and a drizzle of extra olive oil."
    }
  ],
