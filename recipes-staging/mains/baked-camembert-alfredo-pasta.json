  "id": "baked-camembert-alfredo-pasta",
  "name": "Baked Camembert Alfredo Pasta",
  "subtitle": "Creamy baked pasta with rosemary, spinach, and prosciutto",
  "description": "Camembert melts into a rich cream sauce for tagliatelle, finished with spinach, rosemary, parmesan, and crisp prosciutto.",
  "meal_type": "main",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
