  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Cut through the top of the camembert to expose the center, then place it in a small baking dish."
    },
    {
      "step": 2,
      "text": "Arrange the garlic, rosemary, olive oil, spinach, and torn prosciutto around the cheese. Bake for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Meanwhile, cook the tagliatelle in boiling water until tender, then drain."
    },
    {
      "step": 4,
      "text": "Cut into the baked camembert and whisk it with the cream, spinach, and parmesan until smooth. Toss with the drained pasta."
    },
    {
      "step": 5,
      "text": "Top with the melted cheese mixture and prosciutto, then bake for 10 minutes until melted and hot.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Serve immediately."
    }
  ],
