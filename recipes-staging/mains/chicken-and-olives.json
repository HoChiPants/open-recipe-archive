  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken with salt, pepper, cayenne, and herbes de Provence. Let it stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Add the chicken skin-side down and cook for 5 minutes. Turn and cook for 2 minutes, then transfer the chicken to a plate.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Add the shallots to the skillet and stir for 2 minutes, until golden brown.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the green olives, brine-cured olives, reserved brine, chicken broth, lemon zest and juice, and cumin."
    },
    {
      "step": 5,
      "text": "Return the chicken to the skillet and simmer until cooked through, about 5 minutes. Check that the thickest part reaches 165°F.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Transfer the chicken to serving plates. Stir the parsley and cold butter into the skillet until the butter melts, then spoon the sauce over the chicken."
    }
  ],
