  "id": "chicken-and-olives",
  "name": "Chicken and Olives",
  "subtitle": "Skillet chicken with lemon, herbs, and briny olives",
  "description": "Seasoned chicken breasts simmer with shallots, olives, broth, lemon, and herbs, then finish with parsley and butter for a glossy pan sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
