  "id": "cheese-flan",
  "name": "Cheese Flan",
  "subtitle": "A savory pastry tart with cheddar, onion, and egg custard",
  "description": "A simple cheese flan made with buttery shortcrust pastry, softened onion, mature cheddar, and a baked egg-and-milk filling.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
