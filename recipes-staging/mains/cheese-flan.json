  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Melt the salted butter in a pan, add the onion, and cook for 15 minutes until softened.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Grease the dish with extra butter and fit the shortcrust pastry into it, trimming any excess."
    },
    {
      "step": 4,
      "text": "Whisk the beaten eggs with the whole milk, then mix in the cooked onion and cheddar."
    },
    {
      "step": 5,
      "text": "Pour the filling into the pastry case and bake for 40 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 40
    }
  ],
