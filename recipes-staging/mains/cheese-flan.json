  },
  "ingredients": [
    {
      "ingredient_id": "salted-butter-plus-extra-for-the-dish",
      "item": "salted butter plus extra for the dish",
      "quantity": 15,
      "unit": "g"
    },
    {
      "ingredient_id": "onion-finely-chopped",
      "item": "onion finely chopped",
      "quantity": 1
