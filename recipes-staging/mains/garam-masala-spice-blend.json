      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-red-chile-peppers",
      "item": "dried red chile peppers",
      "quantity": 2,
      "preparation": "seeds discarded"
    },
    {
      "ingredient_id": "ground-turmeric",
      "item": "ground turmeric",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm a dry skillet over medium heat. Add the coriander, cumin, cardamom, peppercorns, fennel, mustard seed, cloves, and dried chiles."
    },
    {
      "step": 2,
      "text": "Toast the spices for 2 minutes, stirring frequently, until fragrant. Remove from the heat and let them cool briefly.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Grind the toasted spices to a fine powder using a spice grinder or mortar and pestle."
    },
    {
      "step": 4,
      "text": "Combine the ground spice mixture with the turmeric and mix thoroughly."
    },
    {
      "step": 5,
      "text": "Transfer the blend to an airtight container and use as needed."
    }
  ],
