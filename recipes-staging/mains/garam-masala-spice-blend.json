  "id": "garam-masala-spice-blend",
  "name": "Garam Masala Spice Blend",
  "subtitle": "Aromatic toasted spice mix for Indian-inspired cooking",
  "description": "Toast whole spices briefly, grind them finely, and blend with turmeric for a fragrant homemade seasoning.",
  "meal_type": "main",
  "cuisine": "Indian Inspired",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 2
  },
  "ingredients": [
    {
      "ingredient_id": "coriander-seeds",
      "item": "coriander seeds",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cumin-seeds",
      "item": "cumin seeds",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
