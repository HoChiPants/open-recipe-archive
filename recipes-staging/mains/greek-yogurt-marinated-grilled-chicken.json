  "instructions": [
    {
      "step": 1,
      "text": "Whisk 0.5 cup yogurt with the crushed garlic, juiced lemon, lemon zest, olive oil, paprika, herbes de Provence, 1 teaspoon salt, ground black pepper, and lemon juice."
    },
    {
      "step": 2,
      "text": "Add the chicken pieces and turn to coat evenly. Cover and refrigerate for 180 minutes.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Stir the remaining 0.5 cup yogurt with the lemon juice and harissa until combined; refrigerate until serving."
    },
    {
      "step": 4,
      "text": "Preheat the grill. Remove excess marinade from the chicken and season with the pinch of salt."
    },
    {
      "step": 5,
      "text": "Grill the chicken for 2 minutes, then continue grilling and turning as needed until the thickest pieces reach 165°F, about 35 minutes total.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Serve the grilled chicken with the yogurt sauce."
    }
  ],
