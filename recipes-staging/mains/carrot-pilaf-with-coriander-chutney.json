  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a wide lidded pan. Cook the onion over medium heat for 15 minutes, stirring occasionally, until soft and golden. Drain off any excess oil if needed.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Add the ginger, garlic, coriander seeds, cardamom, cinnamon, garam masala, and both carrot preparations. Cook for 8 minutes, stirring, until fragrant and the carrots begin to soften.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Stir in the rinsed rice, then pour in the hot vegetable stock. Bring to a simmer, cover, and cook for 15 minutes, or until the rice is tender and the liquid is absorbed.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "For the chutney, blend the ginger, green chilies, coriander seeds, chopped coriander, and cashews with a small splash of hot stock until smooth."
    },
    {
      "step": 5,
      "text": "Rest the covered rice for 5 minutes, then fluff it and fold through the onion, chopped coriander, and cashews. Serve with the chutney.",
      "timer_minutes": 5
    }
  ],
