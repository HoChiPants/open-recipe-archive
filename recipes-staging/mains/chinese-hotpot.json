  "instructions": [
    {
      "step": 1,
      "text": "Heat the rapeseed oil in a large hotpot or heavy pot. Add the dried chillies, Sichuan peppercorns, chilli bean sauce, and chilli oil; stir briefly until fragrant."
    },
    {
      "step": 2,
      "text": "Pour in the hot stock. Add the dried mushrooms, star anise, ginger, tangerine peel if using, and sliced cabbage. Bring to a simmer and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the bean curd skin, noodles, and remaining broth-seasoning ingredients as directed by the ingredient list. Return the pot to a steady simmer."
    },
    {
      "step": 4,
      "text": "Arrange the meats, prawns, seafood, tofu, vegetables, mushrooms, and noodles for cooking in batches. Add firm vegetables and mushrooms first, followed by tofu, noodles, seafood, and meats."
    },
    {
      "step": 5,
      "text": "Cook beef and pork slices until they reach 145°F, then rest them for 3 minutes; cook chicken strips to 165°F. Cook prawns and other seafood until opaque, or until shellfish shells open."
    },
    {
      "step": 6,
      "text": "Combine the dipping-sauce ingredients in serving bowls. If using the egg yolk, heat the completed sauce to 160°F and hold it there before serving."
    },
    {
      "step": 7,
      "text": "Serve the simmering hotpot with the dipping sauces, adding ingredients in batches as needed."
    }
  ],
