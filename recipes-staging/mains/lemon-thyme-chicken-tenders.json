  "id": "lemon-thyme-chicken-tenders",
  "name": "Lemon Thyme Chicken Tenders",
  "subtitle": "Bright lemon, garlic, and fresh thyme flavor",
  "description": "Chicken breast tenders are seasoned, coated in a lemon-thyme mixture, rested briefly, and cooked until browned and safely done.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sprigs-fresh-thyme",
      "item": "sprigs fresh thyme",
      "quantity": 6,
      "preparation": "leaves stripped and chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "chicken-breast-tenders",
      "item": "chicken breast tenders",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "olive-oil-flavored-cooking-spray",
      "item": "olive oil-flavored cooking spray"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the lemon zest, lemon juice, olive oil, chopped thyme, and garlic."
    },
    {
      "step": 2,
      "text": "Season the chicken tenders with salt and pepper, then coat them with the lemon mixture."
    },
    {
      "step": 3,
      "text": "Let the coated chicken rest for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Coat a skillet or cooking surface with the olive oil-flavored cooking spray and preheat it."
    },
    {
      "step": 5,
      "text": "Add the chicken and cook, turning as needed, until lightly browned and the thickest pieces reach 165°F.",
      "timer_minutes": 4
    },
    {
      "step": 6,
      "text": "Remove the chicken when it reaches the safe internal temperature and serve."
    }
  ],
