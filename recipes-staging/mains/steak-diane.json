      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the steaks with salt and pepper, then coat them with the Worcestershire sauce. Stir the demi-glace, mustard, tomato paste, cayenne, and a pinch of the seasoned salt and pepper together in a bowl."
    },
    {
      "step": 2,
      "text": "Heat the oil in a large skillet over medium-high heat. Add the steaks and cook until browned and nearly at the desired doneness, about 3 minutes per side. Transfer them to a plate and rest until the sauce is ready.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Lower the heat to medium and add the butter. When it foams, add the shallot and cook until softened, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Remove the skillet from the heat and add the Cognac or brandy. Return it to the heat and carefully cook until the alcohol scent subsides."
    },
    {
      "step": 5,
      "text": "Stir in the demi-glace mixture and heavy cream. Simmer until the sauce is smooth and slightly thickened, then whisk in any juices from the resting steaks.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Return the steaks briefly to the skillet and coat with the sauce. For food safety, verify that whole-cut beef reaches 145°F internally, then allow a 3-minute rest. Finish with the chives."
    }
  ],
