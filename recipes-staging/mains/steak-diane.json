  "id": "steak-diane",
  "name": "Steak Diane",
  "subtitle": "Tender beef with a creamy cognac pan sauce",
  "description": "Sear pounded tenderloin steaks, then finish a mustardy pan sauce with shallot, cognac, cream, and chives.",
  "meal_type": "main",
  "cuisine": "French",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
