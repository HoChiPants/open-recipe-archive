  "id": "chicken-and-broccoli-casserole",
  "name": "Chicken and Broccoli Casserole",
  "subtitle": "A creamy baked noodle casserole with chicken, broccoli, and two cheeses.",
  "description": "Tender egg noodles, shredded chicken, and broccoli are coated in a savory onion sauce, baked, and finished with melted Cheddar and provolone.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
