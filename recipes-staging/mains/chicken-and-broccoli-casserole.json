      "ingredient_id": "egg-noodles",
      "item": "egg noodles",
      "quantity": 6,
      "unit": "ounces"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
