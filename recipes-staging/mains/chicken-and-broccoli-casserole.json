      "quantity": 5,
      "unit": "cups",
      "preparation": "shredded chicken breast meat"
    },
    {
      "ingredient_id": "frozen-broccoli",
      "item": "frozen broccoli",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, chopped, thawed"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "provolone-cheese",
      "item": "provolone cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the egg noodles in salted simmering water for 8 minutes, then drain.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet. Sauté the onion for 3 minutes, until tender.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Stir in the flour, then gradually add the chicken broth and milk. Season with salt and pepper and simmer until thickened."
    },
    {
      "step": 5,
      "text": "Combine the noodles, sauce, shredded chicken, and broccoli in a baking dish."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, then top with the Cheddar and provolone.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Return the casserole to the oven for 5 minutes, until the cheese is set and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 5
    }
  ],
