{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cheese-sambousek",
  "name": "Cheese Sambousek",
  "subtitle": "Crisp pastries with a savory cheese filling",
  "description": "Fold pastry strips around feta or stretchy Kashkawan cheese, season with nigella seeds, and fry until golden and crisp.",
  "meal_type": "main",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "feta-crumbled",
      "item": "feta crumbled",
      "quantity": 200,
      "unit": "g",
      "preparation": "or Kashkawan stretchy cheese, grated"
    },
    {
      "ingredient_id": "nigella-seeds",
      "item": "nigella seeds",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "plain-flour-plus-extra-for-dusting",
      "item": "plain flour plus extra for dusting",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "sambousek-or-filo-pastry-sheets-cut-into-8-10cm-wide-strips",
      "item": "sambousek or filo pastry sheets cut into 8-10cm wide strips",
      "quantity": "300-400",
      "unit": "g"
    },
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying",
      "quantity": 500,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the feta or grated Kashkawan cheese with the nigella seeds."
    },
    {
      "step": 2,
      "text": "Lay out the pastry strips. Place a small portion of the cheese mixture near one end, then fold the pastry over repeatedly to form sealed triangular parcels. Dust with flour as needed and press the edges firmly."
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil in a deep, heavy pan over medium-high heat until hot.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Fry the parcels in batches until crisp and golden on all sides, turning as needed. Drain on paper towels and serve warm.",
      "timer_minutes": 15
    }
  ],
