  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken, garlic, and bouillon in a pot and bring to a boil. Reduce the heat and simmer for 25 minutes, or until the chicken reaches 165°F at the thickest part.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Transfer the chicken to a plate to cool slightly. Reserve the cooking liquid, then remove the bones and shred the meat."
    },
    {
      "step": 3,
      "text": "Boil the tomatoes until softened, then blend them with the chipotle peppers, some reserved cooking liquid, and salt and pepper until smooth."
    },
    {
      "step": 4,
      "text": "Heat the oil in a large skillet and cook the sliced onions until softened and lightly browned."
    },
    {
      "step": 5,
      "text": "Add the tomato mixture and shredded chicken to the onions. Simmer until hot and well combined, adjusting the seasoning with salt and pepper."
    },
    {
      "step": 6,
      "text": "Spoon the chicken mixture onto the tostada shells and top with sour cream."
    }
  ],
