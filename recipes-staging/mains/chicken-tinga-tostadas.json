  "id": "chicken-tinga-tostadas",
  "name": "Chicken Tinga Tostadas",
  "subtitle": "Chipotle chicken layered onto crisp tostada shells",
  "description": "Tender shredded chicken simmered with a smoky tomato-chipotle sauce and onions, then served over tostadas with sour cream.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 8,
