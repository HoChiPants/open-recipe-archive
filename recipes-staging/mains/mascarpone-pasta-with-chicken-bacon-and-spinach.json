  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon until crisp, about 10 minutes. Drain, chop, and set aside.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet. Stir in the onion and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Season the cubed chicken with garlic powder, salt, and black pepper. Add it to the skillet and cook until lightly browned and the thickest pieces reach 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the drained sun-dried tomatoes and pesto; cook briefly. Add the spinach and stir until wilted.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "In a saucepan, combine the mascarpone, minced garlic, Dijon mustard, lemon juice, milk, white pepper, and 1/2 cup Parmesan. Cook, stirring, until smooth, then continue until the cheese is melted.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir the bacon and pesto mixture into the sauce, then season with salt and black pepper."
    },
    {
      "step": 7,
      "text": "Cook the farfalle in boiling water until cooked through, about 12 minutes. Drain.",
      "timer_minutes": 12
    },
    {
      "step": 8,
      "text": "Fold the pasta into the sauce and chicken mixture. Add the spinach and finish with the remaining Parmesan."
    }
  ],
