  "id": "coconut-and-kale-fish-curry",
  "name": "Coconut and Kale Fish Curry",
  "subtitle": "A bright coconut curry with cod, prawns, greens, and lime",
  "description": "Simmer kale, tomatoes, aromatics, and curry paste in coconut milk and stock, then finish with cod, prawns, lime, and coriander. Serve with brown rice.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
