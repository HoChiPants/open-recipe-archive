  "instructions": [
    {
      "step": 1,
      "text": "Cook the brown rice according to the package directions."
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a large pot over medium heat. Cook the sliced onion for 10 minutes until softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the ginger, turmeric, and curry paste. Stir for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the tomatoes, kale, halved chilli, coconut milk, stock, and optional coconut flakes. Bring to a simmer and cook for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir in the cod chunks and frozen prawns. Cook for 5 minutes, or until the fish reaches 145°F and flakes easily and the prawns are opaque.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir in the lime juice and chopped coriander. Serve the curry with the brown rice and any remaining coconut flakes."
    }
  ],
