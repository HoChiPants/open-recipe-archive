  "instructions": [
    {
      "step": 1,
      "text": "Pierce the top round evenly with a meat tenderizer, then place it in a shallow dish or resealable bag."
    },
    {
      "step": 2,
      "text": "Whisk together the vegetable oil, lemon juice, seasoning salt, lemon pepper, garlic, parsley, tarragon vinegar, and meat tenderizer. Pour the mixture over the beef, turn to coat, cover, and refrigerate for 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 3,
      "text": "Preheat a grill to medium-high heat and remove the beef from the marinade."
    },
    {
      "step": 4,
      "text": "Grill the beef for 5 minutes per side, or until the thickest part reaches 145°F.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Rest the meat for 3 minutes, then slice thinly across the grain and serve.",
      "timer_minutes": 3
    }
  ],
