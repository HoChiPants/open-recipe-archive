  "id": "beetroot-tabbouleh",
  "name": "Beetroot Tabbouleh",
  "subtitle": "A fresh grain salad with beetroot, herbs, and lemon",
  "description": "Combine cooked grains with finely chopped vegetables, beetroot, fresh herbs, and a bright lemon dressing for a quick tabbouleh-style meal.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "pouch-cooked-grains",
      "item": "pouch cooked grains",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "beetroots-peeled-and-quartered",
      "item": "beetroots peeled and quartered",
      "quantity": 2,
      "unit": "small"
    },
    {
      "ingredient_id": "bunch-of-mint-leaves-picked",
      "item": "bunch of mint leaves picked",
      "unit": "small",
      "preparation": "plus extra to serve"
    },
    {
      "ingredient_id": "bunch-of-parsley-roughly-chopped",
      "item": "bunch of parsley roughly chopped",
      "unit": "small",
      "preparation": "plus extra to serve"
    },
    {
      "ingredient_id": "olive-oil-plus-extra-to-serve-optional",
      "item": "olive oil plus extra to serve",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "lemon-zested-and-juiced",
      "item": "lemon zested and juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "tomatoes-finely-chopped",
      "item": "tomatoes finely chopped",
      "quantity": 2
    },
    {
      "ingredient_id": "red-onion-finely-chopped",
      "item": "red onion finely chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "2-cucumber-finely-chopped",
      "item": "⁄2 cucumber finely chopped",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Simmer the pouch of cooked grains in boiling water according to its package directions, then transfer the grains to a bowl and let them cool briefly."
    },
    {
      "step": 2,
      "text": "Whisk the olive oil with the lemon zest and juice until smooth."
    },
    {
      "step": 3,
      "text": "Add the beetroot, mint, parsley, tomatoes, red onion, and cucumber to the grains."
    },
    {
      "step": 4,
      "text": "Pour over the lemon dressing and toss until evenly combined. Drizzle with extra olive oil and scatter with extra herbs to serve."
    }
  ],
