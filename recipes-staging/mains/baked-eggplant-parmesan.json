    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "eggplant",
      "item": "eggplant",
      "quantity": 2,
      "preparation": "peeled and cut into 1/2-inch slices"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "italian-style-bread-crumbs",
      "item": "Italian-style bread crumbs",
      "quantity": 1,
      "unit": "cup"
    },
    {
