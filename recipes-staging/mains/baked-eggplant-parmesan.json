  "id": "baked-eggplant-parmesan",
  "name": "Baked Eggplant Parmesan",
  "subtitle": "Layered eggplant with tomato sauce and melted cheese",
  "description": "Salted eggplant is breaded, layered with tomato sauce and cheese, then baked until golden and fully set.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
