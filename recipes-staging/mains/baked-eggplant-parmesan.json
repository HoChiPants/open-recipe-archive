      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "28-ounce-jar-garlic-and-tomato-pasta-sauce",
      "item": "(28 ounce) jar garlic-and-tomato pasta sauce",
      "quantity": 1
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce, shredded, or as needed"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Arrange the eggplant slices in a colander or on a tray, sprinkle with salt, and let stand for 30 minutes. Rinse and pat dry.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Heat the oven to 350°F. Combine the bread crumbs, one 1/4-cup portion of Parmesan, and some of the shredded mozzarella; reserve the remaining cheese for layering."
    },
    {
      "step": 3,
      "text": "Dip each eggplant slice in the beaten eggs, then coat it with the bread-crumb mixture."
    },
    {
      "step": 4,
      "text": "Spread a layer of pasta sauce in a baking dish. Add a layer of coated eggplant, then repeat the sauce and eggplant layers."
    },
    {
      "step": 5,
      "text": "Top with the remaining Parmesan and mozzarella, then sprinkle with dried basil."
    },
    {
      "step": 6,
      "text": "Bake for 5 minutes, until the coating is lightly browned. Continue baking for 35 minutes, until the cheese is golden brown and the center is fully set and reaches 160°F.",
      "timer_minutes": 35
    }
  ],
