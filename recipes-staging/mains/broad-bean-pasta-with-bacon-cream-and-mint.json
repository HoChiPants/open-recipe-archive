  "id": "broad-bean-pasta-with-bacon-cream-and-mint",
  "name": "Broad Bean Pasta with Bacon, Cream, and Mint",
  "subtitle": "Flat pasta tossed with tender beans, smoky bacon, lemon, and mint",
  "description": "A creamy pasta dish combining blanched broad beans, crisp bacon, Parmesan, fresh mint, and lemon zest.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "podded-broad-beans-about-600g-whole-broad-beans",
      "item": "podded broad beans (about 600g whole broad beans)",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "smoked-diced-pancetta-or-bacon-lardons",
      "item": "smoked diced pancetta or bacon lardons",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "garlic-clove-lightly-bashed-but-left-whole",
      "item": "garlic clove lightly bashed but left whole",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "parmesan-finely-grated",
      "item": "parmesan finely grated",
      "quantity": 50,
      "unit": "g",
      "preparation": "plus the rind, if available"
    },
    {
      "ingredient_id": "pappardelle-or-other-flat-pasta",
      "item": "pappardelle or other flat pasta",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "handful-of-mint-leaves-picked-and-finely-shredded",
      "item": "handful of mint leaves picked and finely shredded",
      "unit": "small"
    },
    {
      "ingredient_id": "lemon-zested",
      "item": "lemon zested",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "crusty-bread-to-serve",
      "item": "crusty bread to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Boil the broad beans for 3 minutes. Cool them, then slip off the outer skins and set the beans aside.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Cook the bacon lardons with the olive oil for about 5 minutes, until browned. Add the whole bashed garlic clove and stir for 1 minute.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the cream with the grated Parmesan and add the mixture to the pan. Add the Parmesan rind if available, bring to a gentle simmer, then stir until smooth.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Cook the pasta in boiling water until al dente, then drain."
    },
    {
      "step": 5,
      "text": "Remove the Parmesan rind and garlic. Toss the pasta with the sauce, broad beans, shredded mint, and lemon zest. Serve with the remaining Parmesan and crusty bread."
    }
  ],
