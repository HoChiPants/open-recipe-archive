  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Bake the frozen crusts for 10 minutes, then let them cool until set.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Combine the onion, mushrooms, green bell pepper, and salt and pepper. Set aside."
    },
    {
      "step": 3,
      "text": "Whisk the heavy cream and eggs until combined. Stir in both cheeses, ham, vinegar, tarragon, garlic powder, nutmeg, parsley, and the seasoned vegetables."
    },
    {
      "step": 4,
      "text": "Divide the filling between the cooled crusts."
    },
    {
      "step": 5,
      "text": "Bake at 350°F for 60 minutes, until the centers are firm and reach 160°F on a food thermometer.",
      "timer_minutes": 60
    }
  ],
