  "instructions": [
    {
      "step": 1,
      "text": "Combine the teriyaki sauce, soy sauce, and Worcestershire sauce. Add the chicken, cover, and refrigerate for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Stir together the melted butter, brown sugar, pineapple juice, and the remaining marinade mixture. Simmer until slightly thickened, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Preheat an outdoor grill to medium heat and oil the grates."
    },
    {
      "step": 4,
      "text": "Remove the chicken from the marinade and discard the used marinade. Grill the chicken and pineapple rings, turning and brushing with the glaze, until the chicken reaches 165°F in the thickest part, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Serve the chicken with the grilled pineapple and remaining glaze."
    }
  ],
