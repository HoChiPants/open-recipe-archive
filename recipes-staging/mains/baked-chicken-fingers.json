  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Dip each chicken piece in the melted butter, then coat it evenly with the Italian seasoned bread crumbs."
    },
    {
      "step": 3,
      "text": "Arrange the coated chicken on a baking sheet and bake for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Turn the pieces and continue cooking for 10 minutes, or until the thickest piece reaches 165°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
