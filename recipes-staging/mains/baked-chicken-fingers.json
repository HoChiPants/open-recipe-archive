  "id": "baked-chicken-fingers",
  "name": "Baked Chicken Fingers",
  "subtitle": "Crisp, buttery chicken pieces with seasoned crumbs",
  "description": "Bite-size chicken breast pieces coated in melted butter and Italian-seasoned bread crumbs, then baked until fully cooked.",
  "meal_type": "main",
