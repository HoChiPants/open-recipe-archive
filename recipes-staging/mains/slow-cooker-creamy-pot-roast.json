  "ingredients": [
    {
      "ingredient_id": "5-pound-boneless-beef-chuck-roast",
      "item": "(5 pound) boneless beef chuck roast",
      "quantity": 1
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "condensed-golden-mushroom-soup",
      "item": "condensed golden mushroom soup",
      "quantity": 2,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "mushrooms",
      "item": "mushrooms",
      "quantity": 2,
      "unit": "can",
      "preparation": "8 ounce, sliced, drained"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "dry-onion-soup-mix",
      "item": "dry onion soup mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1 ounce"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1.5,
      "unit": "teaspoons",
      "preparation": "minced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the roast on all sides with salt and black pepper, then place it in a slow cooker."
    },
    {
      "step": 2,
      "text": "Stir together both soups, the drained mushrooms, onion soup mix, and garlic. Pour the mixture over the roast."
    },
    {
      "step": 3,
      "text": "Cover and cook until the beef is tender and reaches at least 145°F in the thickest part. Let it rest for 3 minutes before serving.",
      "timer_minutes": 480
    }
  ],
