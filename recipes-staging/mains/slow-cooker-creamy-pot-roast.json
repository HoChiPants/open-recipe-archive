  "id": "slow-cooker-creamy-pot-roast",
  "name": "Slow Cooker Creamy Pot Roast",
  "subtitle": "Tender beef roast with mushroom-onion sauce",
  "description": "A boneless chuck roast cooks slowly in a savory mushroom sauce until tender and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
