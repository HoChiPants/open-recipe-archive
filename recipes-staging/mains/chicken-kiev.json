  "instructions": [
    {
      "step": 1,
      "text": "Mix the butter with 0.5 teaspoon pepper and 1 teaspoon garlic powder. Transfer it to a sheet of plastic wrap, chill until firm, then cut it into six portions."
    },
    {
      "step": 2,
      "text": "Prepare the chicken breasts by slicing each horizontally to open a pocket without cutting through. Lightly flatten the pieces if needed."
    },
    {
      "step": 3,
      "text": "Place one portion of seasoned butter in each chicken pocket. Fold the chicken around the butter and shape each piece into a sealed, compact bundle."
    },
    {
      "step": 4,
      "text": "Whisk the eggs with the water in a shallow bowl. In a second bowl, combine the remaining pepper and garlic powder with the dill and flour. Place the bread crumbs in a third bowl."
    },
    {
      "step": 5,
      "text": "Coat each chicken bundle in the seasoned flour, dip it in the egg mixture, then roll it in the bread crumbs. Chill the breaded chicken for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Heat the oil for frying. Fry the chicken, turning as needed, until golden brown and cooked through, about 5 minutes; verify the center reaches 165°F with a food thermometer.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Serve with the lemon slices and chopped parsley."
    }
  ],
