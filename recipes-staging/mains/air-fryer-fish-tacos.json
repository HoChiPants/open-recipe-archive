  "instructions": [
    {
      "step": 1,
      "text": "Combine the cabbage, carrot, and the juice of 1 lime. Set aside to soften slightly."
    },
    {
      "step": 2,
      "text": "Mash the avocado with the juice of 1/2 lime. In a separate bowl, combine the tomatoes, cucumber, coriander, and the remaining 1/2 lime juice."
    },
    {
      "step": 3,
      "text": "Mix the chilli powder, cumin, ground coriander, smoked paprika, and oregano. Coat the fish evenly with the spice mixture."
    },
    {
      "step": 4,
      "text": "Preheat the air fryer. Arrange the fish in the basket and cook for 10 minutes, or until it reaches 145°F and flakes easily.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Warm the tortilla wraps. Fill them with the fish, slaw, avocado, and salsa, then serve with chilli sauce and extra lime wedges."
    }
  ],
