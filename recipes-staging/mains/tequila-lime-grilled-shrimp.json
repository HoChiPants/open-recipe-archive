  "instructions": [
    {
      "step": 1,
      "text": "Combine the shrimp, cilantro, lime juice, garlic, tequila, cayenne, and salt in a bowl. Add the olive oil and toss to coat."
    },
    {
      "step": 2,
      "text": "Cover and chill the shrimp for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat a grill to medium-high heat. Thread the shrimp onto the soaked skewers."
    },
    {
      "step": 4,
      "text": "Grill the skewers, turning once, until the shrimp are opaque, firm, and reach 145°F internally, about 3 minutes total.",
      "timer_minutes": 3
    }
  ],
