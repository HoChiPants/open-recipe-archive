  "id": "slow-cooker-pineapple-pulled-pork",
  "name": "Slow Cooker Pineapple Pulled Pork",
  "subtitle": "Tender pork with pineapple and warm spices",
  "description": "A simple slow-cooked pork roast finished with pineapple, garlic, cumin, and mild heat.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 480
  },
  "ingredients": [
    {
      "ingredient_id": "unsweetened-crushed-pineapple-in-100-pineapple-juice",
      "item": "unsweetened crushed pineapple in 100% pineapple juice",
      "quantity": 1,
      "unit": "can",
      "preparation": "20 ounce"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "minced"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper-to-taste",
      "item": "freshly ground black pepper to taste",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "3-pound-boneless-pork-butt-roast",
      "item": "(3 pound) boneless pork butt roast",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir together the pineapple and juice, garlic, cumin, salt, red pepper flakes, and black pepper in the slow cooker."
    },
    {
      "step": 2,
      "text": "Set the pork roast in the cooker and turn it to coat with the pineapple mixture."
    },
    {
      "step": 3,
      "text": "Cover and cook on low for 8 hours, until the pork is cooked through.",
      "timer_minutes": 480
    },
    {
      "step": 4,
      "text": "Check the thickest part with a food thermometer; the roast should reach 145°F. Let it rest for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Cut or pull the pork into serving pieces and mix it with the pineapple cooking juices before serving."
    }
  ],
