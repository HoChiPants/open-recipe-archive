  "id": "puff-pastry-pizza-tart",
  "name": "Puff Pastry Pizza Tart",
  "subtitle": "A festive tree-shaped tart with tomato sauce, cheese, toppings, and pesto.",
  "description": "Shape puff pastry into a tree, layer it with pizza sauce, mozzarella, and toppings, then bake until puffed and melted. Finish with pesto before serving.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "sheet-ready-rolled-puff-pastry",
      "item": "sheet ready-rolled puff pastry",
      "quantity": 320,
      "unit": "g"
    },
    {
      "ingredient_id": "tomato-based-pizza-or-pasta-sauce",
      "item": "tomato-based pizza or pasta sauce",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "grated-mozzarella",
      "item": "grated mozzarella",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "toppings-of-your-choice-we-used-pancetta",
      "item": "toppings of your choice (we used pancetta",
      "preparation": "chopped chipolatas and finely chopped red onion)"
    },
    {
      "ingredient_id": "pesto-vegetarian-if-needed",
      "item": "pesto vegetarian if needed",
      "quantity": 3,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a baking tray with parchment."
    },
    {
      "step": 2,
      "text": "Unroll the puff pastry and cut it into a tree shape, reserving any excess pastry for decoration if desired."
    },
    {
      "step": 3,
      "text": "Spread the tomato-based sauce over the pastry, leaving a small border. Add the mozzarella and chosen toppings."
    },
    {
      "step": 4,
      "text": "Cut the pastry around the filled tree as needed to define the shape, then transfer it to the prepared tray."
    },
    {
      "step": 5,
      "text": "Bake for about 25–30 minutes, until the pastry is puffed and golden and the cheese has melted.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Drizzle or dot with pesto, then serve warm."
    }
  ],
