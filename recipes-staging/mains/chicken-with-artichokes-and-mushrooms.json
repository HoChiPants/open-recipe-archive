  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Coat a baking dish with serving cooking spray."
    },
    {
      "step": 2,
      "text": "Combine the salt, paprika, and ground black pepper. Season the chicken cubes evenly with the mixture."
    },
    {
      "step": 3,
      "text": "Melt part of the butter in a skillet over medium heat. Add the mushrooms and cook until lightly browned, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Stir in the flour and dried thyme. Add the chicken broth, dry sherry, and Dijon mustard, then cook until the sauce thickens, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Arrange the chicken and artichoke hearts in the prepared baking dish. Pour the mushroom sauce over them and dot with the remaining butter."
    },
    {
      "step": 6,
      "text": "Bake until the chicken reaches 165°F in the center, about 18 minutes.",
      "timer_minutes": 18
    },
    {
      "step": 7,
      "text": "Season with salt and ground black pepper to taste, garnish with the parsley, and serve."
    }
  ],
