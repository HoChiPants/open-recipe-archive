  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a large pan. Add the onion, peppers, and garlic; cook until softened, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Stir in the chipotle paste and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the chicken strips and cook for 10 minutes, stirring, until cooked through and the thickest pieces reach 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Mix the passata with the ketchup or sugar. Stir the beans and chopped coriander into the chicken mixture."
    },
    {
      "step": 6,
      "text": "Spoon the filling into the tortillas, roll them up, and arrange them seam-side down in a baking dish. Pour over the passata mixture and sprinkle with cheddar."
    },
    {
      "step": 7,
      "text": "Bake until bubbling and golden brown, about 30 minutes. Serve with the green salad.",
      "timer_minutes": 30
    }
  ],
