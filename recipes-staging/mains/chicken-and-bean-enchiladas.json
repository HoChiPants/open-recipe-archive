  "id": "chicken-and-bean-enchiladas",
  "name": "Chicken and Bean Enchiladas",
  "subtitle": "Chipotle chicken, beans, peppers, and cheddar baked in tortillas",
  "description": "A hearty Mexican-style main dish with a smoky chicken-and-bean filling, tomato sauce, and a melted cheddar topping.",
  "meal_type": "main",
  "cuisine": "Mexican",
  "yield": {
