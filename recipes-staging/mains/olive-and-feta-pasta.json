  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water seasoned with the salt and pepper to a simmer. Add the spaghetti and cook for 10 minutes, or until tender. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet with the minced garlic for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the mushrooms and zucchini. Season with oregano and additional salt and pepper to taste, then cook until the vegetables are tender."
    },
    {
      "step": 4,
      "text": "Stir in the sliced olives and drained spaghetti. Toss until the pasta is coated and heated through.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Divide among servings and top with the crumbled feta cheese."
    }
  ],
