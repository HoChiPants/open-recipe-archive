  "instructions": [
    {
      "step": 1,
      "text": "Cook the brown basmati rice with the vegetable bouillon powder and bay leaf until tender, then remove the bay leaf.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Meanwhile, heat the rapeseed oil in a large pan. Add the chicken, leek, and courgettes, and cook until the vegetables soften and the chicken reaches 165°F at the thickest pieces.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the frozen peas and cook until hot. Fold in the cooked rice and walnuts, then scatter over the chopped gorgonzola and serve.",
      "timer_minutes": 5
    }
  ],
