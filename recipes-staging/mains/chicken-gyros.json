  "instructions": [
    {
      "step": 1,
      "text": "Whisk the yogurt, lemon juice and zest, olive oil, garlic, coriander, cumin, paprika, oregano, thyme, cayenne, crushed black pepper, and cinnamon in a large bowl."
    },
    {
      "step": 2,
      "text": "Cut the chicken thighs into evenly sized pieces and combine them with the marinade. Cover and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Prepare the cooking setup and line up two skewers or supports so the chicken can be stacked securely."
    },
    {
      "step": 4,
      "text": "Layer the marinated chicken pieces tightly onto the skewers, keeping the stack stable."
    },
    {
      "step": 5,
      "text": "Prepare the cooking surface and cook the chicken stack for 45 minutes, until cooked through and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Remove the stack briefly and slice the browned outer chicken into thin strips."
    },
    {
      "step": 7,
      "text": "Return the stack to the heat and cook the sliced surface for 10 minutes, until browned and fully cooked.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Prepare the sliced onions and tomatoes, then serve them with the hot chicken."
    }
  ],
