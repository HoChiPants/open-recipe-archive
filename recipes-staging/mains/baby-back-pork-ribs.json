  "id": "baby-back-pork-ribs",
  "name": "Baby Back Pork Ribs",
  "subtitle": "Spice-rubbed ribs finished with barbecue sauce",
  "description": "Tender pork ribs are coated with a smoky spice blend, cooked until safe, and finished on the grill with barbecue sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 65
  },
  "ingredients": [
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "chili-powder",
      "item": "chili powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "baby-back-pork-ribs",
      "item": "baby back pork ribs",
      "quantity": 3,
      "unit": "pounds"
    },
    {
      "ingredient_id": "barbeque-sauce",
      "item": "barbeque sauce",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Warm the barbeque sauce gently and set it aside."
    },
    {
      "step": 2,
      "text": "Combine the cumin, chili powder, paprika, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Cut the ribs into manageable portions and coat them evenly with the spice mixture."
    },
    {
      "step": 4,
      "text": "Arrange the ribs in a baking pan and cook for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Finish the ribs on a preheated grill for 5 minutes, brushing with the barbeque sauce. Check that the thickest portion reaches 145°F, then rest for 3 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Cut the ribs into serving portions and serve with the remaining sauce."
    }
  ],
