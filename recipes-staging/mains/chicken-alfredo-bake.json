{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chicken-alfredo-bake",
  "name": "Chicken Alfredo Bake",
  "subtitle": "Creamy baked pasta with chicken and Parmesan",
  "description": "Penne and cubed chicken are folded into a creamy garlic-Parmesan sauce, then baked until bubbling and safely heated through.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "penne-pasta",
      "item": "penne pasta",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "1-milk",
      "item": "1% milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "freshly-grated-parmigiano-reggiano-cheese",
      "item": "freshly grated Parmigiano-Reggiano cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "rotisserie-chicken",
      "item": "rotisserie chicken",
      "quantity": 1,
      "unit": "cup",
      "preparation": "cubed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Bring a pot of water to a simmer, add the penne, and cook for 11 minutes, or until tender. Drain.",
      "timer_minutes": 11
    },
    {
      "step": 3,
      "text": "Melt the butter in a saucepan with the minced garlic and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Whisk in the flour, then gradually whisk in the milk and heavy cream until smooth."
    },
    {
      "step": 5,
      "text": "Stir in the Parmigiano-Reggiano and nutmeg until combined."
    },
    {
      "step": 6,
      "text": "Combine the sauce with the drained pasta and cubed chicken, then transfer to a baking dish."
    },
    {
      "step": 7,
      "text": "Top with the remaining Parmigiano-Reggiano and bake for 12 minutes, until melted and the center reaches 165°F.",
      "timer_minutes": 12
    }
  ],
