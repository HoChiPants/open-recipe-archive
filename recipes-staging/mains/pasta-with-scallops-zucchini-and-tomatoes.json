  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of salted water to a simmer. Add the fettuccine and cook for 10 minutes, or until tender. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Meanwhile, heat the olive oil in a large skillet over medium heat. Stir in the garlic and cook until tender."
    },
    {
      "step": 3,
      "text": "Add the diced zucchini, salt, and crushed red pepper flakes. Cook for 10 minutes, stirring occasionally.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the basil, tomatoes, and bay scallops. Simmer for 5 minutes, until the scallops are opaque and cooked through.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Transfer the drained pasta to the skillet, toss with the scallop mixture, and sprinkle with Parmesan."
    }
  ],
