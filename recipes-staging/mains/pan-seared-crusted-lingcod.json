    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lingcod",
      "item": "lingcod",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "cleaned and boned"
    },
