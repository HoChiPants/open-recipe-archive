  "id": "pan-seared-crusted-lingcod",
  "name": "Pan-Seared Crusted Lingcod",
  "subtitle": "Tender lingcod with a crisp Parmesan breadcrumb topping",
  "description": "Lingcod is briefly seasoned, pan-seared in butter, coated with a savory breadcrumb mixture, and baked until crisp and fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
