  "instructions": [
    {
      "step": 1,
      "text": "Dissolve the salt in enough water to cover the lingcod. Add the fish and refrigerate for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Drain, rinse, and pat the lingcod dry. Season it with salt and ground black pepper to taste."
    },
    {
      "step": 3,
      "text": "Preheat the oven to 400°F. Cut the lemon into wedges; reserve some for serving."
    },
    {
      "step": 4,
      "text": "Combine the bread crumbs, Parmesan, lemon-pepper seasoning, and enough lemon juice to lightly moisten the mixture. Set aside."
    },
    {
      "step": 5,
      "text": "Melt the butter in an ovenproof skillet over medium heat. Add the lingcod and cook for about 5 minutes, turning as needed, until golden brown.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Top the fish with the breadcrumb mixture and dot with the butter pieces."
    },
    {
      "step": 7,
      "text": "Bake for about 20 minutes, until the topping is golden brown and the thickest part of the fish reaches 145°F or flakes easily.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "Serve hot with the lemon wedges."
    }
  ],
