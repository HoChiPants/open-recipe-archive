  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a skillet over medium heat. Add the cinnamon sticks, cloves, and cardamom seeds; stir for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Add the onion and garlic, then cook, stirring occasionally, for 7 minutes until golden brown.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Season the chicken with the salt, red pepper flakes, coriander, and cumin, then add it to the skillet."
    },
    {
      "step": 4,
      "text": "Stir in the tomato sauce and warm water. Cover and cook for 10 minutes, turning the chicken once, until nearly cooked through.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir in the buttermilk and cook for 8 minutes until the sauce is combined and the chicken reaches 165°F in the thickest part.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Stir in the chopped parsley and serve hot."
    }
  ],
