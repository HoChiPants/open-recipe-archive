    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat 3 tablespoons of the oil in a large pan over medium heat. Cook the onion for 10 minutes, stirring occasionally, until softened.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the garlic, cinnamon, cumin, and chilli flakes if using. Cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Cook the rice in boiling water until just tender, about 20 minutes. Drain well and transfer to a bowl.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Meanwhile, heat the remaining oil in a wide pan. Cook the courgette slices for 4 minutes, turning once, until lightly browned.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Stir the chickpeas into the courgettes and cook for 2 minutes to heat through.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Add the cooked rice, onion mixture, lemon zest, lemon juice, and herbs to the pan. Toss gently until combined."
    },
    {
      "step": 7,
      "text": "Taste and adjust with the reserved chilli flakes if desired. Serve with a drizzle of oil."
    }
  ],
