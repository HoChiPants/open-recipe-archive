  "id": "chickpea-courgette-pilaf",
  "name": "Chickpea & Courgette Pilaf",
  "subtitle": "Lemony rice with chickpeas, courgettes, and herbs",
  "description": "A bright, vegetable-forward rice pilaf combining spiced chickpeas, tender courgettes, lemon, and fresh herbs.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
