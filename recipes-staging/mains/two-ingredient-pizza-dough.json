  },
  "ingredients": [
    {
      "ingredient_id": "greek-yogurt",
      "item": "Greek yogurt",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the Greek yogurt and self-raising flour in a bowl until a dough forms."
    },
    {
      "step": 2,
      "text": "Turn the dough onto a lightly floured surface and knead briefly until smooth."
    },
    {
      "step": 3,
      "text": "Shape the dough into two medium pizza bases or one large base."
    },
    {
      "step": 4,
      "text": "Prepare the bases with desired toppings and place them on a baking sheet."
    },
    {
      "step": 5,
      "text": "Bake until the crust is cooked through and lightly browned.",
