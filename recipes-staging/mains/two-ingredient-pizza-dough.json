  "id": "two-ingredient-pizza-dough",
  "name": "Two-Ingredient Pizza Dough",
  "subtitle": "A simple dough for homemade pizza bases",
  "description": "Combine Greek yogurt and self-raising flour to make a quick dough, then shape and bake into pizza bases.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 2,
    "unit": "medium pizza bases or 1 large pizza base"
  },
  "times": {
