  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken with salt and pepper, then coat lightly with flour."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet over medium heat. Add the chicken and cook until browned on both sides, about 10 minutes total.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the mushrooms and cook until they begin to soften. Stir in the garlic and cook briefly.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the balsamic vinegar, chicken broth, bay leaf, and thyme. Bring to a simmer, return the chicken to the skillet, and cook until the thickest part reaches 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Remove the bay leaf, stir in the butter, and serve with the pan sauce."
    }
  ],
