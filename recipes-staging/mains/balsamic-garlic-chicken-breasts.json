  "id": "balsamic-garlic-chicken-breasts",
  "name": "Balsamic Garlic Chicken Breasts",
  "subtitle": "Tender chicken with mushrooms in a savory balsamic pan sauce",
  "description": "Flour-coated chicken breasts are browned with mushrooms and garlic, then finished in a thyme-scented balsamic broth sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
