  "id": "stuffed-pork-chops",
  "name": "Stuffed Pork Chops",
  "subtitle": "Tender pork chops with a savory crumb filling",
  "description": "Thick pork chops are filled with seasoned bread crumbs, browned in butter, and finished with broth until tender.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "thick-cut-pork-chops",
      "item": "thick cut pork chops",
      "quantity": 4
    },
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 5,
      "unit": "tablespoons",
      "preparation": "melted, divided"
    },
    {
      "ingredient_id": "onion",
      "item": "yellow onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "dried-parsley",
      "item": "dried parsley",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "beef-broth",
      "item": "beef broth",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Mix the bread crumbs, sugar, pepper, salt, onion, parsley, and 2 tablespoons of the melted butter."
    },
    {
      "step": 3,
      "text": "Cut a deep pocket into the side of each pork chop and fill each pocket with the crumb mixture."
    },
    {
      "step": 4,
      "text": "Heat the remaining melted butter in an oven-safe skillet over medium heat. Brown the stuffed chops for 5 minutes, turning once.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Pour the beef broth into the skillet, then bake for 30 minutes, or until the thickest part of each chop reaches 145°F.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Remove the chops from the oven and let them rest for at least 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
