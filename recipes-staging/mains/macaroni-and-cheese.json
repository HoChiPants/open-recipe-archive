  "id": "macaroni-and-cheese",
  "name": "Macaroni and Cheese",
  "subtitle": "Creamy cheddar macaroni for an easy main dish",
  "description": "Tender macaroni coated in a smooth cheese-and-cream sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "macaroni",
      "item": "macaroni",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "processed-cheese",
      "item": "processed cheese",
      "quantity": 6,
      "unit": "ounces",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water seasoned with salt to a simmer."
    },
    {
      "step": 2,
      "text": "Add the macaroni and cook until tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Drain the macaroni well and return it to the warm pot."
    },
    {
      "step": 4,
      "text": "Combine the processed cheese, Cheddar cheese, and heavy cream with the macaroni over low heat."
    },
    {
      "step": 5,
      "text": "Stir until the cheeses are melted and the sauce is smooth. Season with salt to taste and serve hot."
    }
  ],
