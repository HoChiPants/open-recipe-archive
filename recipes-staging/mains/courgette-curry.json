  "id": "courgette-curry",
  "name": "Courgette Curry",
  "subtitle": "A creamy chickpea curry with tender courgettes and warming spices.",
  "description": "Courgettes, chickpeas, tomatoes, coconut milk, and aromatic spices come together in a hearty curry served with basmati rice.",
  "meal_type": "main",
