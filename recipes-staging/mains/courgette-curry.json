  "instructions": [
    {
      "step": 1,
      "text": "Cut the courgettes into bite-size pieces."
    },
    {
      "step": 2,
      "text": "Heat the sunflower oil in a large saucepan over medium heat. Add the courgettes and sliced onion, then cook until the vegetables begin to soften.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the chopped chillies, ginger, and garlic. Cook, stirring frequently, until aromatic.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Stir in the garam masala, cumin, and turmeric until the vegetables are evenly coated."
    },
    {
      "step": 5,
      "text": "Add the chickpeas, chopped tomatoes, and coconut milk. Bring to a gentle simmer and cook until the courgettes are tender and the sauce has thickened.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Spoon the curry over the cooked basmati rice and serve hot."
    }
  ],
