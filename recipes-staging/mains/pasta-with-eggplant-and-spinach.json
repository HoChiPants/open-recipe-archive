  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water seasoned with salt and pepper to a simmer. Add the farfalle and cook for 10 minutes, or until tender. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "While the pasta cooks, heat the olive oil and butter in a skillet. Add the garlic and stir briefly until fragrant."
    },
    {
      "step": 3,
      "text": "Add the eggplant and cook for 5 minutes, stirring, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the spinach, salt and pepper, and cracked black pepper. Cook for 3 minutes, stirring, until wilted.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the drained pasta, lemon juice, and half of the Parmesan. Toss to combine, then season with salt and pepper."
    },
    {
      "step": 6,
      "text": "Serve with the remaining Parmesan and additional cracked black pepper to taste."
    }
  ],
