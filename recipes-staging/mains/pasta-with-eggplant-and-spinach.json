  "id": "pasta-with-eggplant-and-spinach",
  "name": "Pasta with Eggplant and Spinach",
  "subtitle": "Farfalle with tender eggplant, greens, lemon, and Parmesan",
  "description": "A simple Italian-inspired pasta tossed with garlicky eggplant, wilted spinach, lemon juice, and Parmesan.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
