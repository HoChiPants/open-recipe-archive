  "id": "spinach-artichoke-chicken",
  "name": "Spinach-Artichoke Chicken",
  "subtitle": "Creamy spinach and artichokes over oven-finished chicken",
  "description": "Chicken breasts are browned, topped with a creamy spinach-artichoke mixture, and baked until safely cooked through.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-spinach",
      "item": "frozen spinach",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "4 ounce, softened"
    },
    {
      "ingredient_id": "artichoke-hearts",
      "item": "artichoke hearts",
      "quantity": 0.5,
      "unit": "can",
      "preparation": "14 ounce, quartered, drained and chopped"
    },
    {
      "ingredient_id": "parmesan-cheese",
      "item": "Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "8-ounce-boneless",
      "item": "(8 ounce) boneless",
      "quantity": 4,
      "preparation": "skinless chicken breasts"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Microwave the frozen spinach for 3 minutes. Let it cool, then squeeze out excess moisture.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Mix the spinach, cream cheese, artichoke hearts, Parmesan, mayonnaise, garlic powder, salt, and pepper until thick and evenly combined."
    },
    {
      "step": 3,
      "text": "Heat the oven to 375°F. Season the chicken breasts with salt and pepper."
    },
    {
      "step": 4,
      "text": "Heat the olive oil in an oven-safe skillet over medium-high heat. Brown the chicken for 3 minutes, then transfer the skillet to the oven.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Top the chicken with the spinach-artichoke mixture and bake for 22 minutes, or until a thermometer inserted into the thickest part reads 165°F.",
      "timer_minutes": 22
    },
    {
      "step": 6,
      "text": "Add the mozzarella and bake briefly until the cheese is melted."
    }
  ],
