  "instructions": [
    {
      "step": 1,
      "text": "Combine the crushed star anise, cloves, nutmeg, ginger, black pepper, and 2 tsp light muscovado sugar."
    },
    {
      "step": 2,
      "text": "Rub the spice mixture and softened butter over the turkey. Place the thyme and bay leaves around and inside the turkey, reserving extra herbs for serving. Let the turkey stand for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Warm the 50 g light muscovado sugar, maple syrup, melted butter, and cider vinegar, stirring until smooth. Set the glaze aside."
    },
    {
      "step": 4,
      "text": "Heat the oven to 350°F. Arrange the carrots in the roasting pan with the turkey."
    },
    {
      "step": 5,
      "text": "Roast the turkey for about 4 hours, glazing it during the final 45 minutes. Cook until the thickest part reaches 165°F.",
      "timer_minutes": 240
    },
    {
      "step": 6,
      "text": "Transfer the turkey to a board and rest for 1 hour. Stir the carrots in the roasting pan and continue cooking until tender.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Carve the turkey and serve with the carrots and reserved thyme and bay leaves."
    }
  ],
