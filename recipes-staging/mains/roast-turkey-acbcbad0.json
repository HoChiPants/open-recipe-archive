  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Spread the onion, celery, and carrot in a roasting pan."
    },
    {
      "step": 2,
      "text": "Pat the turkey dry and place it over the vegetables. Combine the kosher salt, black pepper, and cayenne, then season the turkey inside and out."
    },
    {
      "step": 3,
      "text": "Fold or tuck the turkey’s wing tips and arrange the reserved neck and giblets in the pan."
    },
    {
      "step": 4,
      "text": "Warm the butter in a small pan for 2 minutes. Add the rosemary and sage and stir for 1 minute.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Brush the herb butter over the turkey and transfer the pan to the oven."
    },
    {
      "step": 6,
      "text": "Bake for 3 hours, or until a thermometer in the thickest part of the breast and thigh registers 165°F.",
      "timer_minutes": 180
    },
    {
      "step": 7,
      "text": "Remove the turkey from the oven and let it rest for 15 minutes before carving.",
      "timer_minutes": 15
    }
  ],
