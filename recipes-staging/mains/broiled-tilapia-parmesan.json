  "id": "broiled-tilapia-parmesan",
  "name": "Broiled Tilapia Parmesan",
  "subtitle": "Tender tilapia with a lemony Parmesan topping",
  "description": "Tilapia fillets are broiled, topped with a savory Parmesan mixture, and finished until browned and flaky.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
