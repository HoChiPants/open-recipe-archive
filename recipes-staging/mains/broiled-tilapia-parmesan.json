      "ingredient_id": "tilapia-fillets",
      "item": "tilapia fillets",
      "quantity": 2,
      "unit": "pounds"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the broiler and position an oven rack close to the heat source."
    },
    {
      "step": 2,
      "text": "Stir the Parmesan, softened butter, mayonnaise, lemon juice, basil, black pepper, onion powder, and celery salt into a smooth topping."
    },
    {
      "step": 3,
      "text": "Arrange the tilapia fillets in a broiler-safe pan and broil for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Spread the Parmesan mixture over the fillets, then return the pan to the broiler."
    },
    {
      "step": 5,
      "text": "Broil until the topping is browned and the fish reaches 145°F internally and flakes easily."
    }
  ],
