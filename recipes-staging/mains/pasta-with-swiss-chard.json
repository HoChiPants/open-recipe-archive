  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of salted water to a simmer. Add the spaghetti and cook for 8 minutes, or until tender; drain well.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet over medium heat. Add the garlic and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the chopped Swiss chard and stir until tender."
    },
    {
      "step": 4,
      "text": "Toss the drained spaghetti with the chard and capers. Stir in the lemon juice and season with salt and pepper."
    },
    {
      "step": 5,
      "text": "Add the Parmesan and serve warm."
    }
