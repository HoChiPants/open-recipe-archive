  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "enchilada-style-baked-chicken-thighs",
  "name": "Enchilada-Style Baked Chicken Thighs",
  "subtitle": "Tender chicken thighs baked with enchilada sauce, cheese, and olives.",
  "description": "Chicken thighs are baked in red enchilada sauce, finished with melted Cheddar and olives, and served with a cool herb topping.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "boneless chicken thighs"
    },
    {
      "ingredient_id": "red-enchilada-sauce",
      "item": "red enchilada sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce, divided"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "black-olives",
      "item": "black olives",
      "quantity": 1,
      "unit": "can",
      "preparation": "2.25 ounce, sliced"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 2,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sprigs-chopped-fresh-cilantro",
      "item": "sprigs chopped fresh cilantro",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Pour half of the enchilada sauce into a baking dish."
    },
    {
      "step": 2,
      "text": "Arrange the chicken thighs over the sauce and bake for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Drain excess liquid from the dish, then pour the remaining enchilada sauce over the chicken."
    },
    {
      "step": 4,
      "text": "Top with the Cheddar and black olives. Broil until the cheese is melted, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Whisk together the green onions, sour cream, and cilantro. Serve with the chicken, ensuring the poultry reaches 165°F internally."
    }
  ],
