  "id": "braised-beef-short-ribs",
  "name": "Braised Beef Short Ribs",
  "subtitle": "Slow-cooked ribs with vegetables in a savory tomato broth",
  "description": "Coated beef short ribs are browned, then gently cooked with tomatoes, garlic, potatoes, onions, and carrots until tender. A flour slurry finishes the cooking liquid as a thick sauce.",
  "meal_type": "main",
  "cuisine": "American",
