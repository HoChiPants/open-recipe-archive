  "instructions": [
    {
      "step": 1,
      "text": "Combine the coating flour, salt, pepper, and the measured all-purpose flour. Coat the short ribs evenly."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large heavy pot over medium-high heat. Brown the coated ribs on all sides."
    },
    {
      "step": 3,
      "text": "Add 1 cup water, the stewed tomatoes, and garlic. Bring the liquid to a boil."
    },
    {
      "step": 4,
      "text": "Reduce the heat, cover, and simmer for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Add the potatoes, onions, and carrots. Continue simmering until the vegetables and ribs are tender, about 30 minutes. Verify the beef reaches 145°F, then rest it for 3 minutes before serving.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Stir 1.5 tablespoons all-purpose flour with 4 tablespoons water to make a smooth slurry. Add it to the pot and stir until the cooking liquid thickens."
    },
    {
      "step": 7,
      "text": "Transfer the ribs and vegetables with the thickened sauce to a serving dish."
    }
  ],
