  "id": "slow-cooker-teriyaki-ribs",
  "name": "Slow-Cooker Teriyaki Ribs",
  "subtitle": "Tender pork ribs with a glossy, tangy teriyaki finish",
  "description": "Baby back ribs cook gently in teriyaki sauce, then are portioned and served with a warm balsamic-garlic sauce.",
  "meal_type": "main",
  "cuisine": "Asian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 245
  },
  "ingredients": [
    {
      "ingredient_id": "baby-back-ribs",
      "item": "baby back ribs",
      "quantity": 2.5,
      "unit": "pounds",
      "preparation": "cut into 2-rib portions"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "teriyaki-sauce",
      "item": "teriyaki sauce",
      "quantity": 0.66666668653488,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "pressed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the rib portions with the black pepper and place them in a slow cooker. Add the portion of teriyaki sauce intended for cooking."
    },
    {
      "step": 2,
      "text": "Cover and cook on low for 240 minutes, or until the ribs are tender and reach at least 145°F internally. Rest for 3 minutes.",
      "timer_minutes": 240
    },
    {
      "step": 3,
      "text": "Transfer the ribs to a cutting board and separate or portion them as needed."
    },
    {
      "step": 4,
      "text": "Warm the remaining teriyaki sauce with the balsamic vinegar and pressed garlic in a saucepan."
    },
    {
      "step": 5,
      "text": "Simmer the sauce for 5 minutes, then spoon it over the ribs and serve.",
      "timer_minutes": 5
    }
  ],
