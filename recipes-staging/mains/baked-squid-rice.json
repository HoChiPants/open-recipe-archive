      "item": "lemon wedges to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in an ovenproof skillet or shallow casserole. Cook the onion, carrot, and parsley stalks for 15 minutes, stirring occasionally, until softened.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Add the garlic and rice, stir to coat, and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir the fish stock and squid ink together, then add the mixture and the squid to the pan. Bring the liquid to a simmer."
    },
    {
      "step": 5,
      "text": "Stir in the vermouth and roughly chopped artichokes. Transfer the pan to the oven and bake until the rice is tender and the squid is opaque and cooked through, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Top with the reserved whole artichokes and chopped parsley. Serve with lemon wedges."
    }
  ],
