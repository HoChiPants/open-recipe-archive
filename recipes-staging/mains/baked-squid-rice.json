  "id": "baked-squid-rice",
  "name": "Baked Squid Rice",
  "subtitle": "Black rice baked with squid and artichokes",
  "description": "A savory Spanish-style baked rice combining squid, artichokes, aromatic vegetables, squid ink, and vermouth, finished with parsley and lemon.",
  "meal_type": "main",
  "cuisine": "Spanish",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
