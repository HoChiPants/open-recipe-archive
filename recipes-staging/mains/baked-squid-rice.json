      "item": "jar chargrilled artichokes in oil",
      "quantity": 280,
      "unit": "g",
      "preparation": "drained, a few reserved whole and the rest roughly chopped"
    },
    {
      "ingredient_id": "cleaned-squid-ask-your-fishmonger-to-do-this-for-you",
      "item": "cleaned squid (ask your fishmonger to do this for you)",
      "quantity": 400,
      "unit": "g",
