  "id": "curried-honey-mustard-chicken",
  "name": "Curried Honey Mustard Chicken",
  "subtitle": "Tender chicken with a sweet, savory curry glaze",
  "description": "Chicken breasts are coated in a buttery honey-mustard curry mixture, chilled to infuse flavor, then baked until fully cooked.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
