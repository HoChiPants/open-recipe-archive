    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breasts"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the melted butter, honey, Dijon-style prepared mustard, curry powder, and cayenne together until smooth."
    },
    {
      "step": 2,
      "text": "Coat the chicken breasts thoroughly with the sauce, cover, and refrigerate for 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 3,
      "text": "Heat the oven to 375°F. Arrange the chicken in a baking dish and spoon the remaining sauce over it."
    },
    {
      "step": 4,
      "text": "Bake for 10 minutes, turn or baste the chicken, and continue baking for about 10 minutes, until the thickest part reaches 165°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Let the chicken rest briefly, then serve with the pan sauce."
    }
  ],
