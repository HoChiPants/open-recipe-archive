  "id": "butter-beef",
  "name": "Butter Beef",
  "subtitle": "Tender beef with a savory onion-seasoned sauce",
  "description": "Beef stew meat cooks slowly with butter and dry onion soup mix until tender, creating a rich, savory main dish.",
  "meal_type": "main",
