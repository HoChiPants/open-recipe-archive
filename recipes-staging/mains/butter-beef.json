  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the cubed beef and butter in a covered cooking vessel."
    },
    {
      "step": 2,
      "text": "Sprinkle the dry onion soup mix evenly over the beef."
    },
    {
      "step": 3,
      "text": "Cover and cook for 4 hours, until the beef is tender and reaches at least 145°F internally.",
      "timer_minutes": 240
    },
    {
      "step": 4,
      "text": "Let the beef rest for 3 minutes, then stir the sauce and serve.",
