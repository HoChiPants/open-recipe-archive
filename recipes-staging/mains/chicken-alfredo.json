  "id": "chicken-alfredo",
  "name": "Chicken Alfredo",
  "subtitle": "Creamy pasta with chicken and vegetables",
  "description": "Fettuccine is coated in a smooth cream cheese Alfredo sauce, then combined with cooked chicken, broccoli, zucchini, and bell pepper.",
  "meal_type": "main",
