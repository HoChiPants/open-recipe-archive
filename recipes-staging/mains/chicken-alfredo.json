  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of salted water to a boil. Add the fettuccine and cook for 10 minutes, or until tender. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium heat. Add the cream cheese and stir until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the milk, garlic powder, and salt and pepper to taste. Add the chopped red bell pepper and simmer for 3 minutes, until thickened.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the broccoli and zucchini to the skillet and cook for about 3 minutes, until tender.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Stir in the drained pasta and cooked, cubed chicken. Serve topped with grated Parmesan cheese."
    }
  ],
