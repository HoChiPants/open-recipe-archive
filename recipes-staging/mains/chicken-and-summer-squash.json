  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "yellow-squash",
      "item": "yellow squash",
      "quantity": 0.75,
      "unit": "pound",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "zucchinis",
      "item": "zucchinis",
      "quantity": 0.75,
      "unit": "pound",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomato",
      "quantity": 1,
      "unit": "medium",
      "preparation": "peeled, seeded and chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken with the salt and pepper."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium-high heat. Add the chicken and cook until lightly browned, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Transfer the chicken to a plate. Add the vegetable oil to the skillet, then add the yellow squash, zucchini, and tomato. Season with any remaining salt and pepper."
    },
    {
      "step": 4,
      "text": "Stir the vegetables for 3 minutes, then continue cooking until tender, about 5 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Return the chicken to the skillet and cook until a thermometer inserted into the thickest part reads 165°F."
    },
    {
      "step": 6,
      "text": "Serve the chicken with the vegetables."
    }
  ],
