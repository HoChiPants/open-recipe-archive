  "id": "chicken-and-summer-squash",
  "name": "Chicken and Summer Squash",
  "subtitle": "A quick skillet dinner with tender chicken and fresh summer vegetables.",
  "description": "Seasoned chicken is browned, then finished with yellow squash, zucchini, and tomato for a simple weeknight main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
