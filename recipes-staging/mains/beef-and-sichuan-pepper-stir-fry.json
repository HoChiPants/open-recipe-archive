  "id": "beef-and-sichuan-pepper-stir-fry",
  "name": "Beef and Sichuan Pepper Stir-Fry",
  "subtitle": "Tender beef with crisp vegetables and aromatic heat",
  "description": "A quick stir-fry of sliced steak, peppers, baby corn, and onions served over brown basmati rice.",
  "meal_type": "main",
