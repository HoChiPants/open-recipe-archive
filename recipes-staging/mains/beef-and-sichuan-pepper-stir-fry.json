  "instructions": [
    {
      "step": 1,
      "text": "Heat the rapeseed oil in a large wok or skillet over high heat. Toss the steak and baby corn with the cornflour, then stir-fry for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Add the peppers, remaining baby corn, and red onions. Cook, stirring often, until the vegetables are crisp-tender, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Return the steak to the pan with the chilli flakes, ground Sichuan peppercorns, and chilli oil. Sauté for 1 minute, then stir in the soy sauce.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Check that the beef reaches 145°F in the thickest pieces, then let it rest for 3 minutes. Serve with the cooked brown basmati rice, adding extra chilli flakes or chilli oil if desired."
    }
  ],
