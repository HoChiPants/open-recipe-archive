      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large skillet over medium heat. Add the shallots and cook until softened."
    },
    {
      "step": 2,
      "text": "Add the bacon and onion, stirring occasionally, until the bacon is browned and the onion is tender. Stir in the garlic and cook briefly."
    },
    {
      "step": 3,
      "text": "Bring a large pot of salted water to a boil. Add the fettuccine and cook until tender, about 10 minutes; drain.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Whisk the Parmesan, heavy cream, and egg yolks together in a bowl."
    },
    {
      "step": 5,
      "text": "Toss the hot pasta with the bacon mixture, then stir in the egg mixture. Warm gently, stirring constantly, until the sauce reaches 160°F; do not boil."
    },
    {
      "step": 6,
      "text": "Season with salt and pepper to taste, and serve immediately."
    }
  ],
