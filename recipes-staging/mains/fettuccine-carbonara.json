  "id": "fettuccine-carbonara",
  "name": "Fettuccine Carbonara",
  "subtitle": "Creamy pasta with bacon, Parmesan, and egg yolks",
  "description": "Fettuccine tossed with crisp bacon, sautéed aromatics, Parmesan, cream, and egg yolks for a rich, savory main dish.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
