      "item": "Parmesan cheese",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
