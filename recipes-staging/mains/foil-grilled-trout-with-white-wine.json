  "id": "foil-grilled-trout-with-white-wine",
  "name": "Foil-Grilled Trout with White Wine",
  "subtitle": "Whole trout cooked in a lemon-butter wine foil packet",
  "description": "Trout cooks gently on the grill in foil with white wine, lemon, butter, and parsley for a simple, savory main dish.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "trout",
      "item": "trout",
      "quantity": 2,
      "preparation": "cleaned and head removed"
    },
    {
      "ingredient_id": "dry-white-wine",
      "item": "dry white wine",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the barbecue grill to medium heat."
    },
    {
      "step": 2,
      "text": "Place each cleaned trout on a large sheet of foil and season with salt and pepper."
    },
    {
      "step": 3,
      "text": "Combine the white wine, melted butter, and lemon juice, then spoon the mixture over the trout. Sprinkle with parsley."
    },
    {
      "step": 4,
      "text": "Fold the foil tightly around the fish to seal the packets and transfer them to the grill."
    },
    {
      "step": 5,
      "text": "Cook for 20 minutes, until the thickest part reaches 145°F or the flesh is opaque and flakes easily.",
      "timer_minutes": 20
    }
  ],
