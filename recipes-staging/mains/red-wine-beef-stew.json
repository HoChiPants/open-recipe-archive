      "item": "bay leaf",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven for covered braising."
    },
    {
      "step": 2,
      "text": "Season the beef with salt and pepper. Heat the vegetable oil in a heavy ovenproof pot, then brown the beef in batches for about 15 minutes total. Transfer the beef to a plate.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Add the onion, butter, and a pinch of the seasoned salt and pepper to the pot. Cook until the onion softens, then stir in the flour."
    },
    {
      "step": 4,
      "text": "Return the onion mixture to an even layer and cook for about 4 minutes. Pour in the Merlot and simmer for 10 minutes, stirring to loosen browned bits.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Return the beef and any juices to the pot. Add the beef broth, carrots, celery, thyme, and bay leaf; season with salt and pepper."
    },
    {
      "step": 6,
      "text": "Cover and braise in the preheated oven for about 60 minutes, until the beef is tender and reaches 145°F internally. Remove from the oven and let the beef rest for 3 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Simmer the stew gently on the stovetop for about 30 minutes, until the beef and vegetables are tender.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Remove the thyme sprigs and bay leaf, then adjust the salt and pepper before serving."
    }
  ],
