{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "red-wine-beef-stew",
  "name": "Red Wine Beef Stew",
  "subtitle": "Slow-braised beef with vegetables and herbs",
  "description": "Beef chuck is browned, then gently braised with red wine, broth, vegetables, and herbs until tender.",
  "meal_type": "main",
  "cuisine": "French Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 145
  },
  "ingredients": [
    {
      "ingredient_id": "2-1-2-pound-boneless-beef-chuck-roast",
      "item": "(2 1/2 pound) boneless beef chuck roast",
      "quantity": 1,
      "preparation": "cut into 2-inch cubes"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flour",
      "item": "flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "merlot-wine",
      "item": "Merlot wine",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "beef-broth",
      "item": "beef broth",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 2,
      "preparation": "cut into 1-inch pieces"
    },
    {
      "ingredient_id": "stalks-celery",
      "item": "stalks celery",
      "quantity": 2,
      "preparation": "cut into 1/2-inch pieces"
    },
    {
      "ingredient_id": "sprigs-fresh-thyme",
      "item": "sprigs fresh thyme",
      "quantity": 4
    },
