  "id": "black-bean-stuffed-peppers",
  "name": "Black Bean Stuffed Peppers",
  "subtitle": "Vegetable-filled peppers with creamy rice and beans",
  "description": "Bell peppers are filled with a creamy mixture of brown rice, spinach, black beans, tomatoes, and warm spices, then baked until tender.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "reduced-fat-cream-cheese",
      "item": "reduced-fat cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "3 ounce, softened"
    },
    {
      "ingredient_id": "brown-rice",
      "item": "brown rice",
      "quantity": 2,
      "unit": "cups",
      "preparation": "cooked"
    },
    {
      "ingredient_id": "fresh-spinach",
      "item": "fresh spinach",
      "quantity": 2,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "no-salt-added-black-beans",
      "item": "no-salt-added black beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, drained and rinsed"
    },
    {
      "ingredient_id": "tomatoes-with-green-chile-peppers",
      "item": "tomatoes with green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce, diced"
    },
    {
      "ingredient_id": "dried-minced-onion",
      "item": "dried minced onion",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "bell-peppers",
      "item": "bell peppers",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Pour the water into a baking dish large enough to hold the peppers."
    },
    {
      "step": 3,
      "text": "Whisk the softened cream cheese with the Cheddar cheese until smooth. Stir in the brown rice, spinach, black beans, diced tomatoes, dried onion, cumin, and oregano."
    },
    {
      "step": 4,
      "text": "Cut the bell peppers in half lengthwise and remove the stems, seeds, and membranes."
    },
    {
      "step": 5,
      "text": "Fill the pepper halves with the rice mixture and arrange them in the prepared dish. Spoon any remaining tomatoes around the peppers and top the peppers with the remaining cheese mixture."
    },
    {
      "step": 6,
      "text": "Bake until the peppers are tender and the filling is hot.",
      "timer_minutes": 45
    }
  ],
