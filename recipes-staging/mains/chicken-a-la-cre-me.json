  "id": "chicken-a-la-cre-me",
  "name": "Chicken à la Crème",
  "subtitle": "Tender chicken in a simple cream sauce",
  "description": "A quick French-style skillet dish of seasoned chicken finished in a thickened cream sauce.",
  "meal_type": "main",
  "cuisine": "French",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "chicken-breast-tenderloins-or-strips",
      "item": "chicken breast tenderloins or strips",
      "quantity": 1.5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "pint"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Season the chicken with salt and pepper, add it to the skillet, and cook for 10 minutes, turning as needed.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the heavy cream until smooth, then add it to the skillet with the chicken."
    },
    {
      "step": 4,
      "text": "Simmer until the cream thickens and the chicken reaches 165°F at the thickest point.",
      "timer_minutes": 5
    }
  ],
