{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "broad-bean-pasta",
  "name": "Broad Bean Pasta",
  "subtitle": "Trofie with pancetta, ricotta, lemon, and mint",
  "description": "Tender broad beans, crisp pancetta, ricotta, lemon, and mint make a bright, creamy pasta for two.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 22
  },
  "ingredients": [
    {
      "ingredient_id": "podded-broad-beans-about-600g-unpodded",
      "item": "podded broad beans (about 600g unpodded)",
      "quantity": 200,
      "unit": "g",
      "preparation": "defrosted if frozen"
    },
    {
      "ingredient_id": "trofie-pasta-see-tip",
      "item": "trofie pasta (see tip",
      "quantity": 200,
      "unit": "g",
      "preparation": "below)"
    },
    {
      "ingredient_id": "pancetta",
      "item": "pancetta",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-zested-and-halved",
      "item": "lemon zested and halved",
      "quantity": 1
    },
    {
      "ingredient_id": "mint-sprigs-leaves-picked-and-finely-chopped",
      "item": "mint sprigs leaves picked and finely chopped",
      "quantity": 5
    },
    {
      "ingredient_id": "ricotta",
      "item": "ricotta",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "parmesan-to-serve-optional",
      "item": "parmesan to serve (optional)",
      "quantity": 15,
      "unit": "g",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Simmer the broad beans for 3 minutes, until tender, then drain. If their skins are tough, slip the beans from the skins.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Cook the trofie in a large pan of boiling water until al dente, following the package timing. Drain."
    },
    {
      "step": 3,
      "text": "Heat a large frying pan over medium heat and cook the pancetta for 7 minutes, until browned and crisp.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Add the broad beans, lemon zest, the juice from one lemon half, and the chopped mint to the pancetta. Toss briefly to combine."
    },
    {
      "step": 5,
      "text": "Warm the ricotta in the pan for 2 minutes, then add the drained pasta and toss until coated.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Divide between two bowls and serve with the remaining lemon half and optional parmesan."
    }
  ],
