  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of salted water to a boil. Add the bucatini, stir, and cook until tender, about 11 minutes. Drain.",
      "timer_minutes": 11
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet over medium heat. Add the crushed garlic and cook until golden brown.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the sliced guanciale and cook, stirring, until browned and cooked through; if needed, verify it reaches 145°F and rest it for 3 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Add the red onion, red pepper flakes, and salt and pepper. Cook, stirring, until the onion softens.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Stir in the crushed tomatoes and additional salt and pepper as needed. Simmer until the sauce thickens slightly.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Add the drained bucatini and Pecorino Romano. Toss until evenly coated and serve."
    }
  ],
