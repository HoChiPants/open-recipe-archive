  "instructions": [
    {
      "step": 1,
      "text": "Halve the lemon; reserve it for serving."
    },
    {
      "step": 2,
      "text": "Combine the garlic, rosemary, thyme, parsley, olive oil, salt, pepper, and onion powder."
    },
    {
      "step": 3,
      "text": "Pat the lamb dry and coat it evenly with the herb mixture."
    },
    {
      "step": 4,
      "text": "Place the lamb in a slow cooker and add the vegetable broth."
    },
    {
      "step": 5,
      "text": "Cover and cook on the slow-cooker setting for 6 hours, until the thickest part reaches 145°F.",
      "timer_minutes": 360
    },
    {
      "step": 6,
      "text": "Let the lamb rest for 3 minutes, then slice and serve with the reserved lemon.",
      "timer_minutes": 3
    }
  ],
