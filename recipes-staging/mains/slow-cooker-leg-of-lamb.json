  "id": "slow-cooker-leg-of-lamb",
  "name": "Slow Cooker Leg of Lamb",
  "subtitle": "Herb-seasoned lamb with lemon and broth",
  "description": "A tender leg of lamb slowly cooked with fresh herbs, garlic, lemon, and vegetable broth for an easy main course.",
