    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 6,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Prepare a baking pan for 12 biscuits."
    },
    {
      "step": 2,
      "text": "Stir the flour, milk, and mayonnaise together just until a soft dough forms."
    },
    {
      "step": 3,
      "text": "Portion the dough into 12 biscuits and arrange them in the prepared pan."
    },
    {
      "step": 4,
      "text": "Bake for 12 minutes, or until golden brown.",
      "timer_minutes": 12
    }
