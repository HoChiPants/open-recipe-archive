  "id": "mayonnaise-biscuits",
  "name": "Mayonnaise Biscuits",
  "subtitle": "Tender three-ingredient biscuits with crisp golden tops",
  "description": "A simple biscuit dough made with self-rising flour, milk, and mayonnaise, baked until golden brown.",
  "meal_type": "main",
  "cuisine": "Southern",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
