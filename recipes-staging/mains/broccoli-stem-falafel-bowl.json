  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Toss the pita triangles with the olive or rapeseed oil, pumpkin or sunflower seeds, cumin seeds, and chilli flakes. Spread on a baking tray."
    },
    {
      "step": 2,
      "text": "Pulse the drained falafel chickpeas, broccoli stalk, baking powder, ground cumin, coriander, garlic cloves, lemon zest, and chopped parsley until a coarse mixture forms. Lightly oil your hands and the tray, then shape the mixture into small patties."
    },
    {
      "step": 3,
      "text": "Bake the falafel and pita triangles until the falafel is firm and browned and the pita is crisp, turning the pita once if needed.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Blend the second can of chickpeas, beetroot, garlic clove, 2 tablespoons tahini, 2 tablespoons oil, and lemon juice until smooth."
    },
    {
      "step": 5,
      "text": "Whisk 1 tablespoon tahini, honey or maple syrup, the juiced lemon, and 3 tablespoons oil into a dressing."
    },
    {
      "step": 6,
      "text": "Combine the spinach, cooked grains, carrots, and cucumbers. Divide among bowls and top with the falafel, beet hummus, toasted pita, seeds, and reserved parsley leaves. Drizzle with the dressing."
    }
  ],
