  "instructions": [
    {
      "step": 1,
      "text": "Heat a large skillet over medium-high heat. Add the chorizo and cook until browned and cooked through, reaching 160°F on a food thermometer, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the spring onion whites and grated carrot. Cook until the carrot softens, about 5 minutes. Add the garlic and stir briefly.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the peas and cook until hot, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the cooked rice and toss until evenly mixed and heated through. Add the beaten eggs and stir until fully set, reaching 160°F."
    },
    {
      "step": 5,
      "text": "Stir in the spring onion greens and serve with soy sauce or crispy chilli oil, if desired."
    }
  ],
