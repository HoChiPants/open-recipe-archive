  "instructions": [
    {
      "step": 1,
      "text": "Put the potatoes and chicken stock or water in a saucepan. Bring to a boil and cook for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the green beans and spring greens, then cook for 3 minutes more. Drain well.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Cut the chicken breasts into thinner portions. Heat the olive oil in a large skillet and cook the chicken for 4 minutes, turning as needed, until the thickest part reaches 165°F.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Transfer the chicken to serving plates. Add the stock or water, capers, lemon zest, and lemon juice to the skillet; scrape up any browned bits and warm briefly."
    },
    {
      "step": 5,
      "text": "Toss the potatoes with the lemon-caper pan juices."
    },
    {
      "step": 6,
      "text": "Warm the garlic in the remaining skillet oil for 1 minute, then add the drained beans and spring greens and toss to coat.",
      "timer_minutes": 1
    },
    {
      "step": 7,
      "text": "Serve the chicken with the potatoes and garlicky greens, topped with the grated parmesan."
    }
  ],
