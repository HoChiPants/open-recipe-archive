  "id": "chicken-piccata-with-greens-and-new-potatoes",
  "name": "Chicken Piccata with Greens and New Potatoes",
  "subtitle": "Lemony chicken with capers, greens, and tender potatoes",
  "description": "A quick skillet meal pairing chicken and capers with lemony potatoes, garlicky greens, and a light pan sauce.",
  "meal_type": "main",
