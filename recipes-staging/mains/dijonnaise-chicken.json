  "id": "dijonnaise-chicken",
  "name": "Dijonnaise Chicken",
  "subtitle": "Baked chicken with a tangy Dijon-lemon coating",
  "description": "Chicken breasts are coated in a savory mustard mayonnaise mixture and baked until tender and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "prepared-dijon-mustard-mayonnaise-blend",
      "item": "prepared Dijon mustard mayonnaise blend",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "lemon-pepper",
      "item": "lemon pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "chicken-bouillon-granules",
      "item": "chicken bouillon granules",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the prepared Dijon mustard mayonnaise blend, olive oil, fresh lemon juice, lemon pepper, salt, and chicken bouillon granules together until smooth."
    },
    {
      "step": 3,
      "text": "Arrange the chicken in a baking dish and spread the mixture evenly over the pieces."
    },
    {
      "step": 4,
      "text": "Bake for 30 minutes, or until the thickest part of each breast reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
