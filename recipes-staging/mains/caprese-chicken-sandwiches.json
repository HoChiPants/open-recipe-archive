  "id": "caprese-chicken-sandwiches",
  "name": "Caprese Chicken Sandwiches",
  "subtitle": "Pesto, tomato, mozzarella, and basil on ciabatta",
  "description": "Layer sliced chicken, mozzarella, tomatoes, basil, and rocket into garlic-rubbed ciabatta, then finish with pesto and balsamic glaze.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
