      "item": "balsamic glaze",
      "quantity": 2,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "If preparing the chicken from raw, cook it to an internal temperature of 165°F, then remove the skin and slice; otherwise use the specified cooked chicken."
    },
    {
      "step": 2,
      "text": "Split the ciabatta rolls and rub the cut sides with the garlic clove."
    },
    {
      "step": 3,
      "text": "Spread the pesto over the rolls, then layer in the chicken, mozzarella, tomatoes, basil leaves, and rocket."
    },
    {
      "step": 4,
      "text": "Drizzle with balsamic glaze, close the sandwiches, and serve."
    }
  ],
