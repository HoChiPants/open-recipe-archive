  "id": "seared-sea-scallops",
  "name": "Seared Sea Scallops",
  "subtitle": "Golden-seared scallops with lemon and herbs",
  "description": "Tender sea scallops are lightly coated, quickly seared in olive oil, and finished with lemon juice and parsley.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
