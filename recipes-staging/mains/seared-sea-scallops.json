      "quantity": 16,
      "preparation": "rinsed and drained"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "chopped, divided"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 4,
      "unit": "teaspoons",
      "preparation": "divided"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, seasoning salt, oregano, thyme, lemon pepper, and part of the lemon juice. Coat the rinsed, drained scallops with the mixture."
    },
    {
      "step": 2,
      "text": "Preheat the olive oil in a skillet over medium-high heat."
    },
    {
      "step": 3,
      "text": "Add the scallops and sear for 2 minutes, turning as needed, until opaque and easily flaked or they reach 145°F.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Transfer the scallops to a serving dish and finish with the remaining lemon juice and divided parsley."
    }
  ],
