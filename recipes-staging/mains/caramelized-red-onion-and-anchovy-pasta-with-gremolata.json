  "id": "caramelized-red-onion-and-anchovy-pasta-with-gremolata",
  "name": "Caramelized Red Onion and Anchovy Pasta with Gremolata",
  "subtitle": "Slow-cooked onions, savory anchovies, and fresh lemon-parsley topping",
  "description": "Pappardelle is tossed with sweet browned onions, anchovies, and tomato purée, then finished with a bright lemon, parsley, and garlic gremolata.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
