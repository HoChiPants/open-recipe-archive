      "item": "garlic cloves finely chopped",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large skillet over low heat. Add the sliced onions and cook slowly for about 35 minutes, stirring occasionally, until deeply softened and caramelized.",
      "timer_minutes": 35
    },
    {
      "step": 2,
      "text": "Mix the lemon zest and juice with the parsley and garlic to make the gremolata; set aside."
    },
    {
      "step": 3,
      "text": "Cook the pasta according to the package directions until al dente, then drain, reserving a little cooking water."
    },
    {
      "step": 4,
      "text": "Add the anchovies and tomato purée to the onions. Cook for 5 minutes, stirring until the anchovies dissolve and the mixture is hot throughout, reaching 145°F.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Toss the pasta with the onion mixture, loosening with reserved pasta water as needed."
    },
    {
      "step": 6,
      "text": "Top with the gremolata and serve hot."
    }
  ],
