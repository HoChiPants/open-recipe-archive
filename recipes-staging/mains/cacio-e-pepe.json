  "id": "cacio-e-pepe",
  "name": "Cacio e Pepe",
  "subtitle": "Peppery pasta with a silky cheese finish",
  "description": "A quick Italian pasta made by coating hot noodles in butter, black pepper, and finely grated cheese.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "bucatini-or-spaghetti",
      "item": "bucatini or spaghetti",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 25,
      "unit": "g"
    },
    {
      "ingredient_id": "whole-black-peppercorns-ground",
      "item": "whole black peppercorns ground",
      "quantity": 2,
      "unit": "tsp",
      "preparation": "or 1 tsp freshly ground black pepper"
    },
    {
      "ingredient_id": "pecorino-or-parmesan",
      "item": "pecorino or parmesan",
      "quantity": 50,
      "unit": "g",
      "preparation": "finely grated"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a boil and cook the bucatini or spaghetti for 2 minutes. Reserve a little cooking water, then drain.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "While the pasta cooks, melt the butter in a large skillet and warm the ground black pepper until fragrant."
    },
    {
      "step": 3,
      "text": "Add the drained pasta to the skillet. Stir in the finely grated pecorino or parmesan, adding a small splash of reserved cooking water as needed, until the sauce is smooth."
    },
    {
      "step": 4,
      "text": "Toss until the pasta is evenly coated, then serve with the remaining black pepper."
    }
  ],
