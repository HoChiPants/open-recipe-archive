  "id": "grilled-mexican-style-steak",
  "name": "Grilled Mexican-Style Steak",
  "subtitle": "Cumin-lime marinade with jalapeño and cilantro",
  "description": "A boldly seasoned skirt or flank steak marinated with toasted cumin, lime, jalapeño, garlic, and cilantro, then grilled and rested before slicing.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
