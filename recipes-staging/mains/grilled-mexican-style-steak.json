  "instructions": [
    {
      "step": 1,
      "text": "Toast the cumin seeds in a dry skillet over medium heat for 5 minutes, until fragrant. Let them cool.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Blend the toasted cumin, jalapeños, garlic, black pepper, lime juice, and salt. Add the cilantro and olive oil; process until smooth."
    },
    {
      "step": 3,
      "text": "Place the steak in a shallow dish and coat it thoroughly with the marinade. Cover and refrigerate for 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 4,
      "text": "Heat a grill to high. Remove excess marinade from the steak and grill until browned and the thickest part reaches 145°F.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Transfer the steak to a board and rest for 3 minutes. Slice across the grain and serve.",
      "timer_minutes": 3
    }
  ],
