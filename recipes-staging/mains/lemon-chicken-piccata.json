  "id": "lemon-chicken-piccata",
  "name": "Lemon Chicken Piccata",
  "subtitle": "Pan-seared chicken with a bright lemon-caper sauce",
  "description": "Floured chicken medallions are browned, then finished in a savory lemon, caper, butter, and parsley sauce.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 3,
      "unit": "large",
      "preparation": "boneless chicken breast halves - cut into 1/2-inch medallions"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "low-sodium-chicken-broth",
      "item": "low sodium chicken broth",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 0.5,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "capers",
      "item": "capers",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "drained and rinsed"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "italian-flat-leaf-parsley",
      "item": "Italian (flat-leaf) parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "minced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 200°F. Season the chicken medallions with salt and pepper, then coat them lightly with flour; shake off the excess."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large skillet over medium-high heat. Sauté the chicken in batches until golden brown and the thickest pieces reach 165°F, about 3 minutes per side.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Transfer the cooked chicken to a baking dish and keep it warm in the oven."
    },
    {
      "step": 4,
      "text": "Pour off excess oil, leaving the browned bits in the skillet. Stir in the garlic and cook briefly."
    },
    {
      "step": 5,
      "text": "Add the chicken broth, lemon slices, lemon juice, and capers. Stir and cook for 8 minutes, then simmer for 5 minutes until slightly thickened.",
      "timer_minutes": 13
    },
    {
      "step": 6,
      "text": "Stir in the butter until melted, then add the parsley. Return the chicken to the skillet and warm it through before serving."
    }
  ],
