  "instructions": [
    {
      "step": 1,
      "text": "Combine the TVP and water; let stand for 30 minutes, then drain.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large pot. Add the onion and garlic and cook until tender."
    },
    {
      "step": 3,
      "text": "Stir in the salt, black pepper, chili powder, cumin, cayenne, and cinnamon. Add the beans with their liquid, tomatoes with juice, bell pepper, carrots, green onions, honey, and drained TVP."
    },
    {
      "step": 4,
      "text": "Bring the chili to a simmer and cook for 45 minutes, stirring occasionally.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Continue cooking for 15 minutes, adjusting the seasoning as needed.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Stir in the cilantro and serve with sour cream."
    }
  ],
