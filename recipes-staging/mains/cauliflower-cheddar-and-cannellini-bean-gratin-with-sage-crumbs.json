  "instructions": [
    {
      "step": 1,
      "text": "Cut the cauliflower into thick steaks, reserving any smaller florets. Simmer in salted water with the bay leaves for 6 minutes, until just tender. Drain, remove the bay leaves, and set aside.",
      "timer_minutes": 6
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan. Stir in the flour and cook briefly, then gradually whisk in the milk. Add the mustard powder and cook, stirring, until the sauce is thickened. Stir in the cheddar and half of the chopped sage.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Heat the oven to 200°C/180°C fan. Combine the beans and remaining cauliflower florets with the cheese sauce, then fold in the cooked cauliflower."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish and scatter over the mozzarella. Bake for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Mix the olive oil, garlic, breadcrumbs, lemon zest, and remaining sage. Sprinkle over the gratin and bake for a further 15 minutes, until browned and bubbling.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Rest for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
