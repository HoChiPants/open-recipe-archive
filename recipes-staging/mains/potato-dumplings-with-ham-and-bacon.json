  "id": "potato-dumplings-with-ham-and-bacon",
  "name": "Potato Dumplings with Ham and Bacon",
  "subtitle": "Norwegian-style potato dumplings simmered with ham",
  "description": "Shredded potatoes and flour form hearty dumplings cooked in a savory ham pot with bacon.",
  "meal_type": "main",
  "cuisine": "Norwegian",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 60,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "5-pound-unsmoked-bone-in-ham",
      "item": "(5 pound) unsmoked bone-in ham",
      "quantity": 1
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "russet-potatoes",
      "item": "russet potatoes",
      "quantity": 5,
      "unit": "pounds",
      "preparation": "peeled and shredded"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "stone-ground-whole-wheat-flour",
      "item": "stone ground whole wheat flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 3,
      "preparation": "cut into 1-inch square pieces"
    },
    {
      "ingredient_id": "salt-and-black-pepper-to-taste",
      "item": "salt and black pepper to taste",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the ham in a large pot, cover with water, and bring to a simmer. Cook until a thermometer inserted into the thickest part away from the bone reads 145°F; remove and rest for 3 minutes."
    },
    {
      "step": 2,
      "text": "Combine the shredded potatoes, both flours, baking powder, 1 teaspoon salt, and the pinch of salt and pepper. Mix until a cohesive dough forms."
    },
    {
      "step": 3,
      "text": "Prepare the bacon pieces for filling. Shape the potato mixture into dumplings, enclosing bacon in each one."
    },
    {
      "step": 4,
      "text": "Return the ham broth to a gentle boil and carefully add the dumplings. Simmer for 60 minutes, keeping them covered by the liquid.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Serve the dumplings with the ham and season the cooking liquid with the remaining salt and pepper mixture to taste."
    }
  ],
