  "id": "zucchini-noodle-shrimp-scampi",
  "name": "Zucchini Noodle Shrimp Scampi",
  "subtitle": "Tender zucchini noodles with lemon-garlic shrimp",
  "description": "Zucchini noodles are tossed with buttery lemon-white-wine sauce, shrimp, parsley, and Parmesan for a quick main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 1.5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "shallot",
      "item": "shallot",
      "quantity": 1,
      "preparation": "minced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 0.5,
      "preparation": "juiced"
    },
    {
      "ingredient_id": "large-shrimp",
      "item": "large shrimp",
      "quantity": 1,
      "unit": "pound",
      "preparation": "peeled and deveined"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped, or to taste"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the zucchini into noodle-like strands and set aside."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat. Add the olive oil and shallot; cook, stirring, for 5 minutes, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the garlic and cook for 2 minutes. Stir in the white wine and lemon juice, then simmer for 3 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the shrimp and season with salt and pepper. Cook for 3 minutes, turning as needed, until opaque and fully cooked. Transfer the shrimp to a plate.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Stir the zucchini noodles into the skillet and cook for 6 minutes, until tender.",
      "timer_minutes": 6
    },
    {
      "step": 6,
      "text": "Return the shrimp to the skillet, then toss with the parsley and Parmesan. Serve immediately."
    }
  ],
