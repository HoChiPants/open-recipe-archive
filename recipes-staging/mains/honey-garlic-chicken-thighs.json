  "id": "honey-garlic-chicken-thighs",
  "name": "Honey Garlic Chicken Thighs",
  "subtitle": "Skillet chicken with a sweet-savory garlic sauce",
  "description": "Boneless chicken thighs are browned, simmered with honey, soy sauce, onion, and garlic, then finished with cilantro.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "5-ounce-boneless-chicken-thighs",
      "item": "(5 ounce) boneless chicken thighs",
      "quantity": 8
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "unit": "medium",
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 7,
      "unit": "cloves",
      "preparation": "chopped, or to taste"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion-powder",
      "item": "onion powder",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "fresh-cilantro",
      "item": "fresh cilantro",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken with salt and ground black pepper."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Add the chicken and brown for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the onion, garlic, onion powder, and garlic powder. Cook for 7 minutes, stirring the aromatics as they soften.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Stir in the honey and soy sauce, coating the chicken and aromatics. Continue cooking until the thickest pieces reach 165°F on a food thermometer."
    },
    {
      "step": 5,
      "text": "Scatter the cilantro over the chicken and serve hot."
    }
  ],
