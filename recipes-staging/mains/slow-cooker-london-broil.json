  "instructions": [
    {
      "step": 1,
      "text": "Arrange the onion, carrots, and potatoes in the bottom of a slow cooker."
    },
    {
      "step": 2,
      "text": "Heat the oil in a large skillet. Season the beef with Creole seasoning and brown it briefly on all sides."
    },
    {
      "step": 3,
      "text": "Warm the beef broth for 5 minutes, then whisk it with the condensed soup and red wine until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Place the browned beef over the vegetables and pour the broth mixture over everything."
    },
    {
      "step": 5,
      "text": "Cover and cook on low until the beef is tender and reaches 145°F in the thickest part. Transfer the beef to a plate and let it rest for 3 minutes before serving with the vegetables and sauce.",
      "timer_minutes": 490
    }
  ],
