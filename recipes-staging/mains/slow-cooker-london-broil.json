  "id": "slow-cooker-london-broil",
  "name": "Slow Cooker London Broil",
  "subtitle": "Tender beef with vegetables in a savory wine sauce",
  "description": "Seasoned London broil cooks slowly with potatoes, carrots, onion, and a creamy mushroom broth for a complete meal.",
  "meal_type": "main",
  "cuisine": "American",
