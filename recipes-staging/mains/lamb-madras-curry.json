  "instructions": [
    {
      "step": 1,
      "text": "Toast the coriander, cumin, and fennel seeds in a dry skillet over medium heat until fragrant. Transfer them to a spice grinder with the dried chiles and salt; grind to a powder."
    },
    {
      "step": 2,
      "text": "Mix the ground spice blend with the garlic paste, ginger paste, curry leaves, and tamarind paste until thick. Stir in the turmeric and lamb to coat."
    },
    {
      "step": 3,
      "text": "Heat the melted ghee and oil in a large heavy pot over medium heat. Add the onion and cook for 10 minutes, stirring occasionally, until golden brown.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the coated lamb mixture and cook for 1 minute, stirring to release its aroma.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Pour in the divided water, coconut milk, and warm water. Add the cardamom pods and cinnamon stick, then bring the curry to a simmer.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Cover, reduce the heat to low, and simmer for about 2 hours, stirring occasionally, until the lamb is tender and reaches 145°F in the thickest pieces. Remove from the heat and rest for 3 minutes.",
      "timer_minutes": 120
    },
    {
      "step": 7,
      "text": "Stir in the garam masala and sugar. Adjust the consistency with the remaining water and warm water mixed with tamarind paste, then cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Remove the cardamom pods and cinnamon stick before serving."
    }
  ],
