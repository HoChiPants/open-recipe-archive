  "instructions": [
    {
      "step": 1,
      "text": "Stir the water, ketchup, onion, soy sauce, Worcestershire sauce, oil, honey, flour, garlic powder, pepper, and poultry seasoning together in a saucepan. Heat for 5 minutes, then let the sauce cool for 10 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 3,
      "text": "Coat the whole chicken with the sauce and place it in a roasting pan with the sliced onion arranged around it."
    },
    {
      "step": 4,
      "text": "Roast for 45 minutes. Increase the oven temperature to 400°F and continue baking until the thickest part of the chicken reaches 165°F on a food thermometer, about 20 minutes.",
      "timer_minutes": 65
    },
    {
      "step": 5,
      "text": "Let the chicken rest for 10 minutes before carving.",
      "timer_minutes": 10
    }
  ],
