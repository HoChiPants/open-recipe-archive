  "id": "slow-cooker-pot-roast",
  "name": "Slow Cooker Pot Roast",
  "subtitle": "Tender beef with carrots and savory gravy",
  "description": "A simple slow-cooked beef roast layered with onion and carrots, then finished with a seasoned gravy.",
