      "preparation": "peeled"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Coat the slow cooker with cooking spray and arrange the sliced onion across the bottom."
    },
    {
      "step": 2,
      "text": "Season the roast with salt and pepper, then coat it evenly with flour."
    },
    {
      "step": 3,
      "text": "Set the roast over the onion and arrange the peeled carrots around it."
    },
    {
      "step": 4,
      "text": "Whisk the beef gravy mix, ranch dressing mix, Italian-style dressing mix, and water until smooth. Pour the mixture over the roast."
    },
    {
      "step": 5,
      "text": "Cover and cook on low for 8 hours, until the beef reaches 145°F in the thickest part. Rest the roast for 3 minutes before slicing.",
      "timer_minutes": 480
    }
  ],
