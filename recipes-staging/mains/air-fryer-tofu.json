  "id": "air-fryer-tofu",
  "name": "Air-Fryer Tofu",
  "subtitle": "Crisp, seasoned tofu with a savory finish",
  "description": "Pressed tofu is seasoned, lightly dusted with cornstarch, and air-fried until crisp.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 12,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "extra-firm-tofu",
      "item": "extra-firm tofu",
      "quantity": 1,
      "unit": "package",
      "preparation": "18 ounce"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "onion-powder",
      "item": "onion powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sweet-paprika",
      "item": "sweet paprika",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-white-pepper",
      "item": "ground white pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the tofu into thick slices. Arrange the slices between clean towels or paper towels, weight them, and let them drain for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Cut the pressed tofu into bite-size pieces and toss with the soy sauce."
    },
    {
      "step": 3,
      "text": "Combine the cornstarch, onion powder, sweet paprika, and white pepper. Add the mixture to the tofu and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Toss the tofu with the sesame oil, then arrange the pieces in a single layer in the air fryer basket."
    },
    {
      "step": 5,
      "text": "Air-fry at 390°F for 6 minutes. Turn the pieces and cook for 6 minutes more, until crisp.",
      "timer_minutes": 6
    }
  ],
