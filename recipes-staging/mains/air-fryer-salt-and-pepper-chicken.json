  "id": "air-fryer-salt-and-pepper-chicken",
  "name": "Air-Fryer Salt-and-Pepper Chicken",
  "subtitle": "Crisp chicken with spiced peppers and greens",
  "description": "Seasoned chicken thighs are air-fried, then served with stir-fried peppers, pak choi, and a honey-rice-wine finish over rice.",
  "meal_type": "main",
  "cuisine": "Asian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
