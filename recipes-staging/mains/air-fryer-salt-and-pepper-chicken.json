  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to its instructions."
    },
    {
      "step": 2,
      "text": "Mix the cornflour, crushed pepper, and five-spice powder. Toss the chopped chicken in the mixture."
    },
    {
      "step": 3,
      "text": "Air-fry the chicken until cooked through and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Cook the crushed pepper, chilli, peppers, four roughly chopped spring onions, and oil until the vegetables begin to soften.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Add the pak choi and cook until just tender.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Mix the honey and rice wine. Stir it into the vegetables and chicken, then cook briefly to combine.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Serve with the sliced spring onions, rice, and soy sauce."
    }
  ],
