  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the cornstarch in a bowl or sealable bag. Add the flank steak and toss until evenly coated."
    },
    {
      "step": 2,
      "text": "Stir together the water, soy sauce, brown sugar, shredded carrots, chopped green onions, olive oil, garlic, and ginger."
    },
    {
      "step": 3,
      "text": "Put the coated steak in a slow cooker and pour the sauce mixture over it, turning the pieces to coat."
    },
    {
      "step": 4,
      "text": "Cover and cook until the beef is tender, about 5 hours.",
      "timer_minutes": 300
    },
    {
      "step": 5,
      "text": "Check the thickest piece with a food thermometer; whole-cut beef should reach at least 145°F, then rest for 3 minutes before serving."
    }
  ],
