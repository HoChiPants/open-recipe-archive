  "id": "slow-cooker-mongolian-beef",
  "name": "Slow Cooker Mongolian Beef",
  "subtitle": "Tender flank steak in a sweet-savory sauce",
  "description": "Coated flank steak cooks slowly with soy sauce, brown sugar, aromatics, and vegetables for a flavorful beef dinner.",
  "meal_type": "main",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 6,
