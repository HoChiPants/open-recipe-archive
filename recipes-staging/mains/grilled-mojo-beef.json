  "id": "grilled-mojo-beef",
  "name": "Grilled Mojo Beef",
  "subtitle": "Citrus-marinated skirt steak with garlic and herbs",
  "description": "Skirt steak is marinated with citrus, garlic, and warm spices, then grilled and finished with cilantro, onion, and lime.",
  "meal_type": "main",
  "cuisine": "Cuban",
