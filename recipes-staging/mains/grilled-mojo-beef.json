  "instructions": [
    {
      "step": 1,
      "text": "Cut the skirt steak into pieces that fit the grill. Whisk the orange juice, lime juice, olive oil, garlic, kosher salt, cumin, black pepper, oregano, and cayenne in a bowl."
    },
    {
      "step": 2,
      "text": "Coat the steak with the marinade and add the sliced onion. Transfer to a covered container and refrigerate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Heat a grill to high. Remove the steak from the marinade and cook for about 4 minutes per side, or until the thickest piece reaches 145°F on a food thermometer.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Transfer the steak to a cutting board and rest for 3 minutes. Slice against the grain.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Toss the onion and cilantro with a drizzle of olive oil and the finishing salt. Spoon over the sliced steak and serve with lime wedges."
    }
  ],
