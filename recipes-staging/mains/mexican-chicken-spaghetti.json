  "id": "mexican-chicken-spaghetti",
  "name": "Mexican Chicken Spaghetti",
  "subtitle": "Creamy baked spaghetti with chicken and green chiles",
  "description": "Tender chicken, tomatoes with green chiles, and creamy mushroom sauce are combined with spaghetti and baked under melted cheese.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
