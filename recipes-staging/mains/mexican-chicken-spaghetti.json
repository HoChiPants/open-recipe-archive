      "item": "spaghetti",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "onion",
      "item": "yellow onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "diced"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 3,
      "preparation": "boneless chicken breast halves, cut into bite-size pieces, or more to taste"
    },
    {
      "ingredient_id": "cream-of-mushroom-soup",
      "item": "cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "tomatoes-with-green-chile-peppers",
      "item": "tomatoes with green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce, diced"
    },
    {
      "ingredient_id": "colby-monterey-jack-cheese",
      "item": "Colby-Monterey Jack cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the spaghetti in boiling water for 12 minutes, then drain.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a large skillet. Stir in the garlic for 1 minute, then add the onion and cook for 2 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the chicken and cook, stirring, for 5 minutes, until the thickest pieces reach 165°F.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the cream of mushroom soup and tomatoes with green chile peppers. Bring the mixture to a gentle simmer."
    },
    {
      "step": 6,
      "text": "Combine the drained spaghetti with the chicken mixture and half of the cheese."
    },
    {
      "step": 7,
      "text": "Transfer to a baking dish, top with the remaining cheese, and bake for 20 minutes, until the cheese is melted.",
      "timer_minutes": 20
    }
  ],
