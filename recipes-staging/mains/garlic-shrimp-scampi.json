  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer. Add the angel hair pasta and cook until tender, then drain.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium heat. Add the sliced garlic and sauté until tender.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the shrimp and cook until opaque and fully cooked. Stir in the white wine and dry bread crumbs, and heat through.",
      "timer_minutes": 9
    },
    {
      "step": 4,
      "text": "Serve the shrimp and sauce over the drained pasta, topped with grated Parmesan cheese."
    }
