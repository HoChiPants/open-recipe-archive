  "id": "garlic-shrimp-scampi",
  "name": "Garlic Shrimp Scampi",
  "subtitle": "Buttery shrimp with angel hair pasta",
  "description": "Tender garlic shrimp and wine sauce are tossed with angel hair pasta, crisp bread crumbs, and Parmesan.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
