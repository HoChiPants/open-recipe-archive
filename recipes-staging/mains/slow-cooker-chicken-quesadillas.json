  "id": "slow-cooker-chicken-quesadillas",
  "name": "Slow Cooker Chicken Quesadillas",
  "subtitle": "Tender seasoned chicken folded with melted cheese in crisp tortillas.",
  "description": "Chicken cooks in enchilada sauce and taco seasoning, then fills flour tortillas with cheese for easy skillet quesadillas.",
  "meal_type": "main",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 255
  },
  "ingredients": [
    {
      "ingredient_id": "red-enchilada-sauce",
      "item": "red enchilada sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "reduced-sodium-taco-seasoning-mix",
      "item": "reduced-sodium taco seasoning mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1.25 ounce"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 2,
      "preparation": "boneless chicken breasts"
    },
    {
      "ingredient_id": "8-to-10-inch-flour-tortillas",
      "item": "8- to 10-inch flour tortillas",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "mexican-cheese-blend",
      "item": "Mexican cheese blend",
      "quantity": 1,
      "unit": "bag",
      "preparation": "12 ounce, shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the enchilada sauce, water, and taco seasoning together in a slow cooker. Add the chicken and coat it with the sauce."
    },
    {
      "step": 2,
      "text": "Cover and cook until the chicken is tender, about 4 hours 15 minutes. Verify that the thickest part reaches 165°F.",
      "timer_minutes": 255
    },
    {
      "step": 3,
      "text": "Transfer the chicken to a bowl and shred it. Return it to the slow cooker and stir it into the sauce."
    },
    {
      "step": 4,
      "text": "Preheat a skillet over medium heat. Place chicken and cheese on one half of each tortilla, fold the tortillas over, and cook in batches for 4 minutes total, turning once, until crisp and the cheese is melted.",
      "timer_minutes": 4
    }
  ],
