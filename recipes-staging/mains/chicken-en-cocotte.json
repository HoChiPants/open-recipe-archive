  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Heat the olive oil in a large oven-safe covered pot over medium heat."
    },
    {
      "step": 2,
      "text": "Season the chicken with salt and pepper, then brown the pieces in the hot oil for 10 minutes, turning as needed.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the potatoes, carrots, celery, onion, garlic, bouillon cubes, and water. Stir to combine."
    },
    {
      "step": 4,
      "text": "Cover the pot and bake for 45 minutes, or until the vegetables are tender and the chicken is cooked through.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Check the thickest chicken piece with a food thermometer; serve when it reaches 165°F."
    }
  ],
