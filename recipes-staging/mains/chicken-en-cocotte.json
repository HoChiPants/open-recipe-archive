  "id": "chicken-en-cocotte",
  "name": "Chicken en Cocotte",
  "subtitle": "One-pot chicken with tender vegetables",
  "description": "Chicken pieces and hearty vegetables cook together in a covered pot with a light bouillon broth.",
  "meal_type": "main",
  "cuisine": "French Inspired",
