  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir together the garlic salt, onion salt, paprika, ground black pepper, and salt."
    },
    {
      "step": 3,
      "text": "Coat the salmon steaks with the olive oil and place them in a baking dish. Sprinkle with the seasoning mixture, then add the chives, fresh thyme, and spinach leaves."
    },
    {
      "step": 4,
      "text": "Top with the Parmesan cheese and bake for 45 minutes, until the salmon reaches 145°F internally or is opaque and flakes easily.",
      "timer_minutes": 45
    }
