{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chicken-adobo",
  "name": "Chicken Adobo",
  "subtitle": "Tender chicken thighs in a savory vinegar-soy sauce",
  "description": "Chicken thighs simmer gently with garlic, soy sauce, vinegar, water, and pickling spice until tender and fully cooked.",
  "meal_type": "main",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "boneless",
      "item": "boneless",
      "quantity": 3,
      "unit": "pounds",
      "preparation": "skinless chicken thighs, rinsed and patted dry"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 6,
      "unit": "cloves",
      "preparation": "peeled and thinly sliced"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "apple-cider-vinegar",
      "item": "apple cider vinegar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "pickling-spice",
      "item": "pickling spice",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "wrapped in cheesecloth"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat a large heavy skillet or Dutch oven over medium heat. Add the vegetable oil and sliced garlic; cook until the garlic is fragrant and lightly golden."
    },
    {
      "step": 2,
      "text": "Add the chicken thighs and cook briefly, turning as needed, until lightly browned."
    },
    {
      "step": 3,
      "text": "Add the soy sauce, apple cider vinegar, water, and wrapped pickling spice. Bring the liquid to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Cover and simmer until the chicken is tender, about 60 minutes. Check the thickest pieces with a food thermometer; chicken is ready at 165°F.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Remove the pickling-spice bundle and serve the chicken with the sauce."
    }
  ],
  "tags": [
