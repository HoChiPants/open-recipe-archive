  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Combine the green beans, potatoes, onion, and sausage with the salt, pepper, and butter."
    },
    {
      "step": 2,
      "text": "Place the mixture in a grill-safe cooking vessel, add the water, and cover."
    },
    {
      "step": 3,
      "text": "Grill until the vegetables are tender and the sausage reaches 160°F internally, about 20 minutes.",
