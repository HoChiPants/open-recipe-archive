  "id": "portuguese-cod-fish-casserole",
  "name": "Portuguese Cod Fish Casserole",
  "subtitle": "Layered cod, potatoes, and onions with a spiced tomato sauce",
  "description": "Salted cod is softened, layered with potatoes and onions, coated in a garlicky tomato sauce, and baked until tender.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
