      "item": "tomato sauce",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Soak the salted cod fish for 24 hours, then drain well."
    },
    {
      "step": 2,
      "text": "Bring a pot of water to a boil, add the cod, and cook for 5 minutes. Drain, cool, and flake the fish.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 4,
      "text": "Arrange the onions in a baking dish and add the sliced potatoes and flaked cod in layers."
    },
    {
      "step": 5,
      "text": "Combine the olive oil, garlic, fresh parsley, red pepper flakes, paprika, and tomato sauce. Pour the mixture over the casserole."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, until the potatoes are tender and the fish reaches 145°F or is opaque and flakes easily.",
      "timer_minutes": 45
    }
  ],
