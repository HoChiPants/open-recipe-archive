  },
  "ingredients": [
    {
      "ingredient_id": "salted-cod-fish",
      "item": "salted cod fish",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 5,
      "unit": "large",
      "preparation": "peeled and sliced"
    },
    {
