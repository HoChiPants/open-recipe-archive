{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "mexican-chile-rellenos",
  "name": "Mexican Chile Rellenos",
  "subtitle": "Roasted Anaheim peppers filled with queso asadero and fried in a light egg batter.",
  "description": "Char the peppers, stuff them with cheese, coat them in seasoned egg batter, and fry until crisp and golden.",
  "meal_type": "main",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 20,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-anaheim-chile-peppers",
      "item": "fresh Anaheim chile peppers",
      "quantity": 6
    },
    {
      "ingredient_id": "queso-asadero-white-mexican-cheese",
      "item": "queso asadero (white Mexican cheese)",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, cut into 3/4-inch thick strips"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large",
      "preparation": "separated"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-shortening-for-frying",
      "item": "vegetable shortening for frying",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare the Anaheim peppers and preheat a broiler, grill, or dry skillet."
    },
    {
      "step": 2,
      "text": "Cook the peppers for about 15 minutes, turning until blistered and charred. Transfer them to a covered bowl with the baking powder and rest for 10 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Peel the peppers carefully, make a lengthwise slit, and remove the seeds while keeping the peppers mostly intact."
    },
    {
      "step": 4,
      "text": "Whisk the egg yolks with the baking powder until combined. Beat the egg whites to stiff peaks, then fold them into the yolk mixture."
    },
    {
      "step": 5,
      "text": "Spread the flour in a shallow dish. Fill each pepper with a cheese strip, close the slit, and coat the pepper lightly with flour."
    },
    {
      "step": 6,
      "text": "Preheat the shortening in a skillet. Dip the floured peppers into the egg batter and fry in batches until golden brown, turning once.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Drain briefly and serve hot."
    }
  ],
