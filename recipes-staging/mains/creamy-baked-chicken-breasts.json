  "id": "creamy-baked-chicken-breasts",
  "name": "Creamy Baked Chicken Breasts",
  "subtitle": "Tender chicken in a simple savory cream sauce",
  "description": "Boneless chicken breasts bake in seasoned cream of chicken soup and milk for an easy American main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
