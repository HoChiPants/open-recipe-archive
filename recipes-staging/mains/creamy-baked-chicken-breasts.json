  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Arrange the chicken breast halves in a baking dish and season with the poultry seasoning."
    },
    {
      "step": 2,
      "text": "Stir the condensed soup and milk together, then pour the mixture evenly over the chicken."
    },
    {
      "step": 3,
      "text": "Bake until the chicken reaches 165°F at the thickest point and the sauce is hot, about 40 minutes.",
