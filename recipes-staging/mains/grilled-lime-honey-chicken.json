    "prep_minutes": 15,
    "cook_minutes": 15,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "lime-juice",
      "item": "lime juice",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the soy sauce, honey, oil, lime juice, and chopped garlic in a bowl."
    },
    {
      "step": 2,
      "text": "Add the chicken and turn to coat evenly. Cover and refrigerate for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat the grill to medium-high heat and lightly oil the grates if needed."
    },
    {
      "step": 4,
      "text": "Grill the chicken, turning as needed, for about 8 minutes, or until the thickest part reaches 165°F on a food thermometer.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Let the chicken rest briefly before serving."
    }
  ],
