  "id": "grilled-lime-honey-chicken",
  "name": "Grilled Lime-Honey Chicken",
  "subtitle": "Savory-sweet chicken with bright lime flavor",
  "description": "Chicken breasts are coated in a soy, honey, lime, and garlic mixture, rested, then grilled until fully cooked.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
