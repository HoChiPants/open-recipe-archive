  "instructions": [
    {
      "step": 1,
      "text": "Bring salted water to a boil. Add the penne and cook for 11 minutes, or until tender. Drain.",
      "timer_minutes": 11
    },
    {
      "step": 2,
      "text": "Preheat the oven to 350°F. Heat the olive oil in a large skillet over medium heat. Cook the onion for 5 minutes, then stir in the bell pepper and garlic and cook for 5 minutes more.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the chicken, green and red enchilada sauces, green chiles, chili powder, cumin, and salt. Remove from the heat and mix in the sour cream."
    },
    {
      "step": 4,
      "text": "Combine the drained pasta with enough of the enchilada sauce mixture to coat it. Transfer to a baking dish and top with the cheese."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, or until the cheese melts and the casserole is hot throughout. Verify the center reaches 165°F with a food thermometer.",
      "timer_minutes": 10
    }
  ],
