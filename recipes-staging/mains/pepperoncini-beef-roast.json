  "id": "pepperoncini-beef-roast",
  "name": "Pepperoncini Beef Roast",
  "subtitle": "Tender pressure-cooked beef with tangy peppers",
  "description": "A savory chuck roast cooked with pepperoncini, butter, broth, and seasoned soup mixes until tender.",
  "meal_type": "main",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 110,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "beef-broth",
      "item": "beef broth",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "beef-chuck-roast",
      "item": "beef chuck roast",
      "quantity": 3.5,
      "unit": "pounds",
      "preparation": "cut into 3 or 4 chunks"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "stick"
    },
    {
      "ingredient_id": "16-ounce-jar-pepperoncini-peppers-and-juice",
      "item": "(16 ounce) jar pepperoncini peppers and juice",
      "quantity": 0.5
    },
    {
      "ingredient_id": "ranch-dressing-mix",
      "item": "ranch dressing mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1 ounce"
    },
    {
      "ingredient_id": "dry-onion-soup-mix",
      "item": "dry onion soup mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour the beef broth into the pressure cooker. Add the roast chunks, ranch dressing mix, and dry onion soup mix."
    },
    {
      "step": 2,
      "text": "Top with the butter, then add the pepperoncini peppers and their juice."
    },
    {
      "step": 3,
      "text": "Secure the lid and cook under high pressure for 110 minutes.",
      "timer_minutes": 110
    },
    {
      "step": 4,
      "text": "Allow a natural pressure release for 15 minutes, then release any remaining pressure safely.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Check that the thickest piece reaches at least 145°F, then rest the meat for 3 minutes before serving. Keep it in the cooking liquid for up to 40 minutes if needed.",
      "timer_minutes": 40
    }
  ],
