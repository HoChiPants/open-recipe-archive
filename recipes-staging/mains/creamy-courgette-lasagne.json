  "id": "creamy-courgette-lasagne",
  "name": "Creamy Courgette Lasagne",
  "subtitle": "A layered pasta bake with grated courgette, ricotta, and tomato sauce.",
  "description": "Tender lasagne sheets are layered with garlicky courgette, ricotta, cheddar, and tomato sauce for a creamy vegetable main course.",
  "meal_type": "main",
  "cuisine": "Italian",
