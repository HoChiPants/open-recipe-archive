  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and bring a large pan of water to a simmer. Cook the lasagne sheets for 5 minutes, or until cooked through, then drain.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Warm the sunflower oil in a large pan. Add the onion and cook until softened."
    },
    {
      "step": 3,
      "text": "Add the courgette and crushed garlic. Cook, stirring, for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Stir the ricotta and cheddar together in a bowl."
    },
    {
      "step": 5,
      "text": "Warm the tomato sauce in a saucepan for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Layer the lasagne sheets, courgette mixture, and tomato sauce in a baking dish. Finish with the ricotta mixture and add the remaining tomato sauce."
    },
    {
      "step": 7,
      "text": "Bake for 10 minutes, until tender. Rest for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
