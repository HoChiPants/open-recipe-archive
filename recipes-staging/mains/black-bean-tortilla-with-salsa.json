  "instructions": [
    {
      "step": 1,
      "text": "Mix the tomatoes, onion, chopped chilli, and smoked paprika to make the salsa. Stir in half the coriander, the olives, lemon or lime juice, and half the ground coriander. Chill until needed."
    },
    {
      "step": 2,
      "text": "Preheat the oven for 10 minutes and prepare an ovenproof frying pan.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Combine the drained black beans with the remaining chopped chilli and coriander, garlic, cumin, and remaining ground coriander."
    },
    {
      "step": 4,
      "text": "Whisk the eggs with the remaining chopped coriander and ground coriander, then stir in the bean mixture."
    },
    {
      "step": 5,
      "text": "Heat the rapeseed oil in the ovenproof pan and add the egg-and-bean mixture. Cook until the base begins to set, then transfer the pan to the oven."
    },
    {
      "step": 6,
      "text": "Bake until the tortilla is set in the center and reaches 160°F on a food thermometer, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 7,
      "text": "Cut into portions and serve with the chilled salsa and rocket."
    }
  ],
