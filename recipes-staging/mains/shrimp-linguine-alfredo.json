  "instructions": [
    {
      "step": 1,
      "text": "Cook the linguine in boiling water until tender. Drain and set aside."
    },
    {
      "step": 2,
      "text": "Warm the melted butter in a large skillet. Add the diced onion and minced garlic; cook until the onion is tender."
    },
    {
      "step": 3,
      "text": "Add the shrimp and cook until opaque and fully cooked, about 1 minute per side.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Stir in the half-and-half and ground black pepper. Simmer gently, then add the Parmesan and stir until the sauce is smooth."
    },
    {
      "step": 5,
      "text": "Add the drained linguine and shrimp to the skillet and toss to coat. Garnish with parsley and lemon slices before serving."
    }
  ],
