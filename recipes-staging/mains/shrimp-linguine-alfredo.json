  "id": "shrimp-linguine-alfredo",
  "name": "Shrimp Linguine Alfredo",
  "subtitle": "Creamy pasta with tender shrimp and Parmesan",
  "description": "Linguine is tossed with sautéed onion, garlic, shrimp, and a peppered Parmesan cream sauce, then finished with parsley and lemon.",
  "meal_type": "main",
  "cuisine": "Italian",
