  "instructions": [
    {
      "step": 1,
      "text": "Season the salmon with salt, pepper, onion powder, and red pepper flakes."
    },
    {
      "step": 2,
      "text": "Whisk the olive oil, lemon juice, garlic, vinegar, sugar, green onions, cilantro, and onion powder in a shallow dish."
    },
    {
      "step": 3,
      "text": "Add the salmon and turn to coat. Cover and chill for 6 hours.",
      "timer_minutes": 360
    },
    {
      "step": 4,
      "text": "Heat the oven to 450°F and arrange the salmon in a baking dish."
    },
    {
      "step": 5,
      "text": "Roast for 5 minutes, then increase the oven to 500°F and continue cooking until the salmon reaches 145°F or is opaque and flakes easily, about 5 to 10 minutes.",
      "timer_minutes": 10
    }
  ],
