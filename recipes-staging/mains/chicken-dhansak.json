  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large pot over medium heat. Add the onion and cinnamon stick and cook until the onion softens. Stir in the cumin seeds."
    },
    {
      "step": 2,
      "text": "Add the squash and garlic; cook for 1 minute, stirring.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the chicken, turmeric, coriander, chilli powder, and tomato purée. Stir until the chicken is coated."
    },
    {
      "step": 4,
      "text": "Stir in the lentils and chopped tomatoes. Bring to a simmer, then cook until the lentils and squash are tender and the chicken reaches 165°F at the thickest pieces.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Stir in the tamarind paste and fenugreek leaves. Simmer briefly, then adjust the tamarind to taste."
    },
    {
      "step": 6,
      "text": "Serve with lemon juice and chopped coriander."
    }
  ],
