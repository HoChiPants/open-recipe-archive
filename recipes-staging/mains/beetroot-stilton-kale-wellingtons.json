  "id": "beetroot-stilton-kale-wellingtons",
  "name": "Beetroot, Stilton & Kale Wellingtons",
  "subtitle": "Crisp pastry parcels with savory vegetable filling",
  "description": "Cooked beetroot, kale, toasted pine nuts, thyme, and Stilton are enclosed in puff pastry and baked until golden.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
