  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven as directed for the pastry and allow about 10 minutes for it to heat.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the olive oil and cook the onion until softened. Add the garlic, kale, and vegetable stock; cook until the kale is tender and the liquid has evaporated.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the toasted pine nuts and thyme, then cool the mixture completely."
    },
    {
      "step": 4,
      "text": "Lightly dust the work surface with flour. Divide and shape the pastry into four portions, keeping the pieces chilled while working."
    },
    {
      "step": 5,
      "text": "Combine the kale mixture, beetroot, and Stilton. Place the filling on the pastry, fold the pastry around it, and seal the edges."
    },
    {
      "step": 6,
      "text": "Arrange the parcels on a baking tray, brush with beaten egg, and cut small vents in the tops."
    },
    {
      "step": 7,
      "text": "Bake until the pastry is deeply golden and the center reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 8,
      "text": "Rest briefly, then serve warm."
    }
  ],
