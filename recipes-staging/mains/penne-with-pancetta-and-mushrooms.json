  "id": "penne-with-pancetta-and-mushrooms",
  "name": "Penne with Pancetta and Mushrooms",
  "subtitle": "Creamy pasta with mushrooms, pancetta, and Parmesan",
  "description": "Penne is tossed with sautéed mushrooms, crisp pancetta, garlic, and a lightly seasoned cream sauce.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "penne-pasta",
      "item": "penne pasta",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 ounce"
    },
    {
      "ingredient_id": "pancetta-bacon",
      "item": "pancetta bacon",
      "quantity": 1,
      "unit": "package",
      "preparation": "3 ounce, diced"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "mushrooms",
      "item": "mushrooms",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, sliced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "italian-seasoning",
      "item": "Italian seasoning",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer, add the penne, and cook until tender, about 10 minutes. Drain and set aside.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Cook the diced pancetta in a skillet for about 5 minutes, until browned. Drain excess fat and set the pancetta aside.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Melt the butter in the skillet. Add the mushrooms and sauté until softened and lightly browned."
    },
    {
      "step": 4,
      "text": "Add the garlic and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Stir in the heavy cream and Italian seasoning. Simmer until the sauce thickens."
    },
    {
      "step": 6,
      "text": "Add the penne and pancetta to the skillet and toss to coat. Stir in the Parmesan, then serve."
    }
  ],
