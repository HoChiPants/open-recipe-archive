  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. Add the celery, chili, onion, lemon zest, celery salt, Worcestershire sauce, and hot sauce. Cook for 10 minutes, stirring occasionally, until softened.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the vodka, tomato juice, dashi powder, and sherry vinegar. Simmer until the mixture thickens slightly, then season with white pepper and adjust the Worcestershire sauce and hot sauce."
    },
    {
      "step": 3,
      "text": "Add the cleaned mussels, cover, and cook for 4 minutes, shaking the pot once or twice, until the shells open and the mussels are opaque. Discard any shells that remain closed.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Scatter over the parsley and serve immediately with garlic bread or fries."
    }
