  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large skillet over medium-high heat."
    },
    {
      "step": 2,
      "text": "Add the pork chops and cook until browned on both sides."
    },
    {
      "step": 3,
      "text": "Add the white wine, salt, pepper, rosemary, and garlic to the skillet."
    },
    {
      "step": 4,
      "text": "Return the chops to the skillet, cover, and simmer until tender, about 20 minutes. Check that the thickest part reaches 145°F, then rest the chops for 3 minutes before serving.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Transfer the pork chops to plates and spoon the pan sauce over them."
    }
  ],
