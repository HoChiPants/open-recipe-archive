      "item": "butter",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "1-inch-thick-pork-chops",
      "item": "(1 inch thick) pork chops",
      "quantity": 4
    },
    {
      "ingredient_id": "dry-white-wine",
      "item": "dry white wine",
      "quantity": 0.5,
      "unit": "cup"
