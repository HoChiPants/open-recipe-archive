  "id": "italian-pork-chops",
  "name": "Italian Pork Chops",
  "subtitle": "Pan-braised pork chops with rosemary, garlic, and white wine",
  "description": "Brown thick pork chops in butter, then simmer them in a seasoned white-wine sauce until tender and safely cooked.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
