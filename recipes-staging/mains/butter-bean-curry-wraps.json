  "name": "Butter Bean Curry Wraps",
  "subtitle": "Warm curry, crisp leaves, and raita in wholemeal wraps",
  "description": "Fill wholemeal tortilla wraps with warm butter bean curry, salad leaves, and cool raita for a quick vegetarian meal.",
  "meal_type": "main",
