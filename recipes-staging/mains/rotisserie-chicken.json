  "instructions": [
    {
      "step": 1,
      "text": "Prepare and preheat the grill with its rotisserie setup."
    },
    {
      "step": 2,
      "text": "Season the chicken inside and out with the pinch of salt."
    },
    {
      "step": 3,
      "text": "Stir the melted butter, tablespoon of salt, paprika, and black pepper together."
    },
    {
      "step": 4,
      "text": "Secure the chicken on the rotisserie and coat it with the seasoned butter."
    },
    {
      "step": 5,
      "text": "Grill until the thickest part of the breast or thigh reaches 165°F on a food thermometer and the chicken is cooked through.",
      "timer_minutes": 70
    },
    {
      "step": 6,
      "text": "Transfer the chicken to a board and let it rest before carving.",
      "timer_minutes": 10
    }
