  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large heavy pot over medium-high heat. Season the chicken with salt and pepper, add it with the chicken broth, and cook for 7 minutes, turning as needed. Transfer the chicken to a plate and reserve the broth in the pot.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Add the onion to the pot and cook until softened, about 5 minutes. Stir in the garlic and cook for 1 minute, then add the sofrito and cook for 3 minutes.",
      "timer_minutes": 9
    },
    {
      "step": 3,
      "text": "Return the chicken and reserved broth to the pot. Add the potatoes, tomato sauce, sazon seasoning, cumin, and bay leaf. Bring to a simmer."
    },
    {
      "step": 4,
      "text": "Cover and simmer until the chicken and potatoes are tender, about 60 minutes. Check that the thickest chicken pieces reach 165°F.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Whisk the cold water and cornstarch together. Stir the slurry into the simmering stew and cook until the broth thickens, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Remove the bay leaf and serve the stew hot."
    }
  ],
