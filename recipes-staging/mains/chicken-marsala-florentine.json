  "id": "chicken-marsala-florentine",
  "name": "Chicken Marsala Florentine",
  "subtitle": "Skillet chicken with mushrooms, spinach, and Marsala",
  "description": "Flour-coated chicken breasts are cooked until done, then served with a buttery Marsala sauce filled with mushrooms, sun-dried tomatoes, and spinach.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "boneless",
      "item": "boneless",
      "quantity": 4,
      "preparation": "skinless chicken breast halves"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "portobello-mushrooms",
      "item": "portobello mushrooms",
      "quantity": 3,
      "unit": "cups",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "sun-dried-tomatoes",
      "item": "sun-dried tomatoes",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "packed-fresh-spinach",
      "item": "packed fresh spinach",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "marsala-wine",
      "item": "Marsala wine",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pound the chicken breast halves to an even thickness. Mix the flour, salt and pepper, and oregano in a shallow dish, then dredge the chicken and shake off the excess."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Cook the chicken until browned and the thickest pieces reach 165°F, turning as needed. Transfer the chicken to a plate."
    },
    {
      "step": 3,
      "text": "Melt the butter in the skillet. Add the oregano, mushrooms, sun-dried tomatoes, and Marsala wine, and cook until the mushrooms are tender and the sauce thickens.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the spinach and cook until wilted, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Return the chicken to the skillet briefly to coat with the sauce, then serve hot."
    }
  ],
