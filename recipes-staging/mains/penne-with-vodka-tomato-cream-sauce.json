  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of salted water to a boil. Add the penne and cook for 11 minutes, or until boiling-tender. Drain and set aside.",
      "timer_minutes": 11
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet. Add the prosciutto, garlic, and red pepper flakes; cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Stir in the tomatoes and cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Whisk together the heavy cream and vodka, then add the mixture to the skillet. Simmer until the sauce thickens, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir in the Parmesan and basil. Season with salt to taste."
    },
    {
      "step": 6,
      "text": "Add the drained penne and toss until evenly coated."
    }
  ],
