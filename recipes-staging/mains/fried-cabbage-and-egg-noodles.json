  "id": "fried-cabbage-and-egg-noodles",
  "name": "Fried Cabbage and Egg Noodles",
  "subtitle": "Tender noodles tossed with buttery sautéed cabbage",
  "description": "A simple skillet meal combining tender egg noodles with lightly fried green cabbage, butter, salt, and pepper.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "egg-noodles",
      "item": "egg noodles",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "stick"
    },
    {
      "ingredient_id": "head-green-cabbage",
      "item": "head green cabbage",
      "quantity": 1,
      "unit": "medium",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water seasoned with salt to a boil. Add the egg noodles and cook until tender and they reach at least 160°F.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Drain the noodles."
    },
    {
      "step": 3,
      "text": "Melt the butter in the pot over medium heat. Add the chopped cabbage and season with salt and pepper."
    },
    {
      "step": 4,
      "text": "Cook the cabbage until softened and lightly browned.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Return the noodles to the pot and stir with the cabbage until evenly combined and heated through.",
      "timer_minutes": 5
    }
  ],
