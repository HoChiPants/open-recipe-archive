  "instructions": [
    {
      "step": 1,
      "text": "Finely crumble the bay leaves and combine them with the breadcrumbs, lemon zest, and lemon juice."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large ovenproof skillet or baking dish. Add the spinach and cook until wilted, then let it cool briefly.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir the cream, wine, and porcini mushrooms into the spinach. Set the salmon fillet on top and spoon some of the mixture around it."
    },
    {
      "step": 4,
      "text": "Press the bay-lemon crumbs evenly over the salmon."
    },
    {
      "step": 5,
      "text": "Bake in a preheated 400°F oven until the salmon is opaque and flakes easily, reaching 145°F at the thickest point.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Rest the salmon briefly, then serve with the creamed spinach and mushrooms."
    }
  ],
