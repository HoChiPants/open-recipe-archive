  "id": "bay-crumbed-salmon-with-creamed-spinach-and-wild-mushrooms",
  "name": "Bay-Crumbed Salmon with Creamed Spinach and Wild Mushrooms",
  "subtitle": "Tender salmon with lemony bay crumbs over a creamy mushroom-spinach base.",
  "description": "A whole salmon fillet is baked over creamy spinach and porcini mushrooms, then finished with crisp breadcrumbs flavored with bay and lemon.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35
  },
