  "name": "Roast Beef",
  "subtitle": "Seasoned eye of round with a simple oven roast",
  "description": "A straightforward roast beef seasoned with salt, garlic powder, and black pepper, then sliced after resting.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
