    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "beef-eye-of-round-roast",
      "item": "beef eye of round roast",
      "quantity": 3,
      "unit": "pounds",
      "preparation": "at room temperature"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine the salt, garlic powder, and black pepper. Rub the seasoning evenly over the room-temperature roast."
    },
    {
      "step": 3,
      "text": "Place the roast in a roasting pan and roast for 60 minutes, or until a food thermometer inserted into the thickest part reads 145°F.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Transfer the roast to a cutting board and let it rest for at least 3 minutes before slicing.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Slice thinly across the grain and serve."
    }
  ],
