  "id": "roast-chicken-with-gravy",
  "name": "Roast Chicken with Gravy",
  "subtitle": "A simple roast chicken served with pan gravy",
  "description": "Roast chicken over chopped vegetables with lemon and thyme, then turn the pan juices into a smooth gravy.",
  "meal_type": "main",
  "cuisine": "British",
  "yield": {
    "quantity": 4,
