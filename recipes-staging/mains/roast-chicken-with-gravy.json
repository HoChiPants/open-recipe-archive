    },
    {
      "ingredient_id": "chicken-stock-a-cube-is-fine",
      "item": "chicken stock (a cube is fine)",
      "quantity": 250,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven for roasting. Arrange the onion and carrots in a roasting pan, place the chicken on top, and pour in the chicken stock."
    },
    {
      "step": 2,
      "text": "Put the lemon halves and optional thyme inside the chicken. Rub the softened butter over the skin."
    },
    {
      "step": 3,
      "text": "Roast until the thickest part of the chicken reaches 165°F and the juices run clear.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Transfer the chicken to a board and let it rest before carving. Reserve the roasting pan and juices.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Set the roasting pan over medium heat if suitable for the stovetop. Stir in the flour, then gradually add the stock and pan juices."
    },
    {
      "step": 6,
      "text": "Stir for 2 minutes, then simmer until the gravy is thickened. Carve the chicken and serve with the gravy.",
      "timer_minutes": 2
    }
  ],
