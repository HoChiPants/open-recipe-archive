      "item": "sprigs parsley",
      "quantity": 8
    },
    {
      "ingredient_id": "lemon-wedges",
      "item": "lemon wedges",
      "quantity": 8
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs with the lemon pepper and garlic pepper in a shallow dish."
    },
    {
      "step": 2,
      "text": "Combine the ground almonds and Parmesan cheese in a second shallow dish."
    },
    {
      "step": 3,
      "text": "Dust each tilapia fillet with flour, dip it in the egg mixture, then press it into the almond mixture to coat."
    },
    {
      "step": 4,
      "text": "Melt the butter in a large skillet over medium heat."
    },
    {
      "step": 5,
      "text": "Cook the coated fillets in batches until golden and the fish reaches 145°F or is opaque and easily flaked, about 3 to 5 minutes per side.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Season with salt and serve with a parsley sprig and lemon wedge for each portion."
    }
  ],
