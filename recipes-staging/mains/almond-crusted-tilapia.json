  "id": "almond-crusted-tilapia",
  "name": "Almond-Crusted Tilapia",
  "subtitle": "Pan-cooked tilapia with a crisp almond-Parmesan coating",
  "description": "Tender tilapia fillets are lightly floured, coated in a seasoned almond and Parmesan crust, and cooked in butter. Serve with parsley and lemon wedges.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
