      "item": "(6 ounce) tilapia fillets",
      "quantity": 8
    },
    {
      "ingredient_id": "all-purpose-flour-for-dusting",
      "item": "all-purpose flour for dusting",
      "quantity": 0.25,
      "unit": "cup"
    },
