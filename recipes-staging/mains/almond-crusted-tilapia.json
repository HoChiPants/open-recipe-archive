    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "lemon-pepper",
      "item": "lemon pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
