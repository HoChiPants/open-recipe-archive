  },
  "ingredients": [
    {
      "ingredient_id": "cucumber",
      "item": "cucumber",
      "quantity": 1,
      "unit": "large",
      "preparation": "peeled and sliced"
    },
    {
      "ingredient_id": "ripe-fresh-tomatoes",
      "item": "ripe fresh tomatoes",
      "quantity": 2,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the cucumber and tomatoes in a serving bowl."
    },
    {
      "step": 2,
      "text": "Whisk the olive oil and balsamic vinegar together, then season with salt and pepper."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the vegetables and toss gently to coat."
    },
    {
      "step": 4,
      "text": "Chill until ready to serve."
    }
  ],
