  "id": "cucumber-and-tomato-toss",
  "name": "Cucumber and Tomato Toss",
  "subtitle": "A crisp, tangy no-cook vegetable salad",
  "description": "Sliced cucumber and ripe tomatoes are coated in a simple balsamic dressing and chilled before serving.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
