  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Cut the roast into thick portions as needed for serving."
    },
    {
      "step": 2,
      "text": "Combine the concentrated beef base, minced garlic, and garlic powder. In a separate bowl, mix the fresh thyme, dried oregano, peppercorns, salt, and finely chopped fresh thyme."
    },
    {
      "step": 3,
      "text": "Coat the roast with the beef-base mixture, then press on the herb and pepper mixture. Transfer the roast to a roasting pan."
    },
    {
      "step": 4,
      "text": "Roast for 180 minutes. Check the thickest part with a food thermometer and continue roasting as needed until it reaches at least 145°F.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Remove the roast and let it rest for at least 3 minutes before slicing.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "While the roast rests, prepare the jus by heating the concentrated beef base and water. Whisk in the garlic, fresh thyme, dried oregano, red wine, finely chopped fresh thyme, garlic powder, onion, carrot, and celery."
    },
    {
      "step": 7,
      "text": "Preheat the jus mixture for 30 minutes, then prepare it for serving and serve warm with the sliced roast.",
      "timer_minutes": 30
    }
  ],
