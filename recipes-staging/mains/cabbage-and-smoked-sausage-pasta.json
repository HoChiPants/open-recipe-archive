  "id": "cabbage-and-smoked-sausage-pasta",
  "name": "Cabbage and Smoked Sausage Pasta",
  "subtitle": "A hearty pasta skillet with tender cabbage and savory sausage",
  "description": "Farfalle is tossed with buttery garlic cabbage, sliced smoked sausage, and Parmesan for a simple one-pan-style main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
