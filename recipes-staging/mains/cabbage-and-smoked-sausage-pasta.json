  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of salted water to a boil. Add the farfalle, stir, and cook until cooked through, about 12 minutes. Drain and set aside.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Meanwhile, melt the butter with the olive oil in a large skillet over medium heat. Add the garlic and cabbage, season with salt and pepper, and cook until the cabbage is tender.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Fold the drained pasta and sliced smoked sausage into the cabbage mixture. Continue cooking until the sausage is heated through; if it is uncooked, verify that it reaches 160°F with a food thermometer.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the Parmesan and serve hot."
    }
  ],
