  "id": "air-fryer-baked-sweet-potatoes",
  "name": "Air Fryer Baked Sweet Potatoes",
  "subtitle": "Roasted sweet potatoes with garlic-tahini yogurt",
  "description": "Tender air-fried sweet potatoes are paired with roasted garlic yogurt, tahini, lemon, and crisp curry leaves.",
  "meal_type": "main",
