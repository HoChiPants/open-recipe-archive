  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to its standard baking setting. Rub the sweet potatoes with the olive oil and add the curry leaves and garlic bulb."
    },
    {
      "step": 2,
      "text": "Air-fry the sweet potatoes and garlic for 35 minutes, or until the potatoes are tender when pierced.",
      "timer_minutes": 35
    },
    {
      "step": 3,
      "text": "Let the potatoes and garlic cool for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Combine the Greek yogurt, tahini, lemon zest and juice, and maple syrup. Squeeze the roasted garlic from its bulb into the mixture and stir until smooth."
    },
    {
      "step": 5,
      "text": "Heat the remaining olive oil with the curry leaves until the leaves are crisp, about 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 6,
      "text": "Split the sweet potatoes and top with the garlic-tahini yogurt, curry leaves, chopped coriander, and chilli flakes. Serve warm."
    }
  ],
