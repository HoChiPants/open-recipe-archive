  "instructions": [
    {
      "step": 1,
      "text": "Combine the olive oil, soy sauce, red wine, Worcestershire sauce, mustard, lemon juice, minced garlic, Italian seasoning, and black pepper in a shallow dish. Add the flank steak and turn to coat. Cover and refrigerate for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 3,
      "text": "Remove the steak from the marinade and pat it lightly dry. Spread the crushed garlic over the steak and season with salt."
    },
    {
      "step": 4,
      "text": "Layer the onion, breadcrumbs, spinach, and feta over the steak, leaving a narrow border around the edges."
    },
    {
      "step": 5,
      "text": "Roll the steak tightly from one long side and secure the roll. Place it in a baking dish and add the red wine."
    },
    {
      "step": 6,
      "text": "Bake for about 60 minutes, until the center reaches 145°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Rest the steak for 3 minutes, then cut it into pinwheels and serve.",
      "timer_minutes": 3
    }
  ],
