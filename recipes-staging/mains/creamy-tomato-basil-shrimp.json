  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large skillet over medium heat. Add the shrimp, green onions, and garlic; stir to coat."
    },
    {
      "step": 2,
      "text": "Cook for 5 minutes, stirring occasionally, until the shrimp are opaque and reach 145°F internally. Transfer the shrimp to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the tomatoes, heavy cream, white wine, basil, cayenne, and salt and pepper into the skillet."
    },
    {
      "step": 4,
      "text": "Return the shrimp to the skillet and warm the mixture for 10 minutes, stirring occasionally.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Serve hot once the sauce is heated through and the shrimp remain opaque and easily firm."
    }
  ],
