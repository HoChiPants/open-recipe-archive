  "id": "creamy-tomato-basil-shrimp",
  "name": "Creamy Tomato-Basil Shrimp",
  "subtitle": "Shrimp in a creamy tomato and basil sauce",
  "description": "Shrimp, tomatoes, garlic, wine, and basil come together in a rich skillet sauce for a straightforward dinner.",
  "meal_type": "main",
  "cuisine": "American",
