  "instructions": [
    {
      "step": 1,
      "text": "Combine the coriander, parsley, garlic, red onion, green chilli, vinegar, and softened 200 g butter. Shape into a thick log, wrap, and chill for 60 minutes until firm.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Heat the oven to 250°F. Place the room-temperature steak in a roasting pan and cook for 120 minutes, or until a thermometer reads 145°F in the center.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Remove the steak from the oven and rest for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Heat a heavy skillet until very hot. Add the sunflower oil and sear the steak for about 4 minutes, turning as needed for an evenly browned crust.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Add the 25 g butter and baste the steak briefly. Slice and serve with the chimichurri butter, fries, and rocket salad."
    }
  ],
