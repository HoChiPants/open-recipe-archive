  "id": "rosemary-pork-roast",
  "name": "Rosemary Pork Roast",
  "subtitle": "A simple herb-seasoned roast for dinner",
  "description": "Pork tenderloin is coated with olive oil, garlic, and rosemary, then baked until tender and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "pork-tenderloin",
      "item": "pork tenderloin",
      "quantity": 3,
      "unit": "pounds"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "dried-rosemary",
      "item": "dried rosemary",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Place the pork tenderloin in a roasting pan and coat it with the olive oil and minced garlic. Sprinkle the dried rosemary over the pork."
    },
    {
      "step": 3,
      "text": "Bake at 375°F for 120 minutes, or until the center reaches 145°F on a food thermometer.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Rest the roast for 3 minutes before slicing and serving.",
      "timer_minutes": 3
    }
  ],
