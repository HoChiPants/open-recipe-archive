  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium heat. Add the onion, apple, and celery; cook until softened, about 5 minutes. Let cool for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Combine the cooled vegetables with the ground pork, sausage, bread crumbs, parsley, salt, pepper, and sage."
    },
    {
      "step": 4,
      "text": "Place the crown roast in a roasting pan and fill the center with the stuffing mixture."
    },
    {
      "step": 5,
      "text": "Roast for 180 minutes, until the stuffing reaches 160°F and the thickest part of the whole-cut pork reaches 145°F.",
      "timer_minutes": 180
    },
    {
      "step": 6,
      "text": "Remove the roast and let it rest for 10 minutes; the whole-cut pork should receive at least a 3-minute rest after reaching 145°F.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Cut between the ribs and serve with the stuffing."
    }
  ],
