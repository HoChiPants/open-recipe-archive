  "id": "pepper-steak",
  "name": "Pepper Steak",
  "subtitle": "Tender steak with sweet peppers and a tangy glaze",
  "description": "Thin-sliced flank steak is cooked with sautéed peppers and onions, then coated in a savory-sweet vinegar sauce.",
  "meal_type": "main",
  "cuisine": "American",
