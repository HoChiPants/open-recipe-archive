  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Add the bell peppers, onion, and garlic; cook until tender.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Transfer the vegetables to a plate. Add the soy sauce, honey, and red wine vinegar to the skillet and heat until combined."
    },
    {
      "step": 3,
      "text": "Add the flank steak and cook, stirring occasionally, until browned and cooked to an internal temperature of 145°F. Remove from the heat and rest for 3 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Return the vegetables to the skillet and toss with the steak and sauce before serving."
    }
  ],
