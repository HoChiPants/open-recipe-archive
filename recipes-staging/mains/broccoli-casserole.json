{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "broccoli-casserole",
  "name": "Broccoli Casserole",
  "subtitle": "Tender broccoli with creamy cheese sauce and a crisp crumb topping",
  "description": "A simple baked casserole combining microwave-tender broccoli, creamy mushroom soup, Cheddar, and a buttery breadcrumb topping.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-broccoli",
      "item": "fresh broccoli",
      "quantity": 4,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cream-of-mushroom-soup",
      "item": "cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the chopped broccoli in a microwave-safe dish, cover, and microwave for 5 minutes, or until tender.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Drain the broccoli, then stir it with the mushroom soup, Cheddar, and mayonnaise."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish."
    },
    {
      "step": 5,
      "text": "Combine the bread crumbs with the melted butter and spread the mixture over the casserole."
    },
    {
      "step": 6,
      "text": "Bake until heated through and the topping is crisp, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
