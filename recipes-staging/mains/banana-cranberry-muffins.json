  "id": "banana-cranberry-muffins",
  "name": "Banana Cranberry Muffins",
  "subtitle": "Tender whole-wheat muffins with tart cranberry bursts",
  "description": "Mashed ripe bananas add moisture and sweetness to these simple whole-wheat muffins, while frozen cranberries provide bright contrast.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "ripe-bananas",
      "item": "ripe bananas",
      "quantity": 3,
      "preparation": "mashed"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large",
      "preparation": "beaten"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "whole-wheat-flour",
      "item": "whole wheat flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "frozen-cranberries",
      "item": "frozen cranberries",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Line or lightly grease a 12-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Stir the mashed bananas and sugar together. Mix in the beaten egg, vanilla extract, and vegetable oil."
    },
    {
      "step": 3,
      "text": "Whisk the whole wheat flour, baking powder, baking soda, and salt in a separate bowl. Add the dry mixture to the banana mixture and stir just until combined."
    },
    {
      "step": 4,
      "text": "Fold in the frozen cranberries, then divide the batter among the muffin cups."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, or until the centers are fully set and reach 160°F on a food thermometer.",
      "timer_minutes": 25
    }
  ],
