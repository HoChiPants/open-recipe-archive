    "prep_minutes": 15,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "prepared-mustard",
      "item": "prepared mustard",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-pepper-to-taste",
      "item": "lemon pepper to taste"
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 4,
      "preparation": "cut in half"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Place the chicken breasts in a baking dish."
    },
    {
      "step": 2,
      "text": "Stir together the honey, prepared mustard, and lemon pepper. Pour the mixture over the chicken and turn to coat."
    },
    {
      "step": 3,
      "text": "Bake for 25 minutes, then arrange the bacon over the chicken and sprinkle with mozzarella."
    },
    {
      "step": 4,
      "text": "Bake for 10 minutes more, until the cheese is melted and the chicken reaches 165°F in the thickest part.",
      "timer_minutes": 10
    }
  ],
