  "id": "honey-mustard-mozzarella-chicken",
  "name": "Honey Mustard Mozzarella Chicken",
  "subtitle": "Baked chicken with a tangy honey-mustard glaze and melted cheese",
  "description": "Chicken breasts are coated in honey mustard, baked until nearly done, then finished with bacon and mozzarella.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
