  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken in a saucepan, add the chicken broth, and simmer for 20 minutes, or until the thickest piece reaches 165°F. Transfer the chicken to a plate to cool, then slice or shred it.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Bring the broth back to a simmer. Add the pasta and cook for 10 minutes, or until tender. Drain and set aside.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Meanwhile, preheat a large skillet or saucepan. Add the broccoli, red bell pepper, garlic, and salt and pepper, then simmer until the broccoli is tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Whisk the cream cheese and Parmesan together until smooth."
    },
    {
      "step": 5,
      "text": "Combine the chicken, pasta, vegetables, and cheese mixture, stirring until evenly coated. Serve garnished with the remaining cheese mixture and Parmesan."
    }
  ],
