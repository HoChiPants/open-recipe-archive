  "id": "braised-chicken-breasts-with-mirepoix-ragout",
  "name": "Braised Chicken Breasts with Mirepoix Ragout",
  "subtitle": "Tender chicken simmered with vegetables in a savory wine broth",
  "description": "Flour-coated chicken breasts are browned, then gently braised with onion, celery, carrots, garlic, herbs, wine, and broth.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "boneless",
      "item": "boneless",
      "quantity": 4,
      "preparation": "skinless chicken breast halves"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 2,
      "unit": "cups",
      "preparation": "diced"
    },
    {
      "ingredient_id": "celery",
      "item": "celery",
      "quantity": 1,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 1,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "finely-chopped-garlic",
      "item": "finely chopped garlic",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "bay-leaves",
      "item": "bay leaves",
      "quantity": 3
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dry-white-wine",
      "item": "dry white wine",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "32-fluid-ounce-containers-chicken-broth",
      "item": "(32 fluid ounce) containers chicken broth",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken with salt and pepper, then dredge it in the flour; shake off the excess."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large heavy pot over medium heat. Brown the chicken lightly on all sides, working in batches if needed, then transfer it to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the onion, celery, and carrots to the pot and cook until the onion begins to soften. Stir in the garlic, bay leaves, and thyme.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Pour in the wine and scrape up any browned bits. Return the chicken to the pot and add enough chicken broth to set the braising liquid around the chicken."
    },
    {
      "step": 5,
      "text": "Bring the liquid to a gentle simmer, cover, and cook until the chicken is tender and reaches 165°F in the thickest part.",
      "timer_minutes": 90
    },
    {
      "step": 6,
      "text": "Continue simmering the ragout and add additional chicken broth as needed to maintain a spoonable sauce.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Remove the bay leaves, adjust the seasoning, and serve the chicken with the vegetable ragout."
    }
  ],
