  "id": "creamy-mushroom-chicken-thighs",
  "name": "Creamy Mushroom Chicken Thighs",
  "subtitle": "Tender chicken in a savory mushroom, herb, and caper cream sauce",
  "description": "Chicken thighs are browned, baked, and finished with a creamy mushroom sauce brightened with lemon and capers.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 75
  },
  "ingredients": [
