  "instructions": [
    {
      "step": 1,
      "text": "Combine the chicken broth, onion, and garlic in a saucepan. Bring to a simmer and cook for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the white wine and simmer for 10 minutes. Stir in the mushrooms, rosemary, and sage; cook until the mushrooms are tender.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk in the heavy cream, butter, lemon juice, and capers. Continue cooking until the sauce thickens.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Heat the oven to 350°F. Coat the chicken thighs with cornstarch, shaking off the excess."
    },
    {
      "step": 5,
      "text": "Heat the olive oil in an oven-safe skillet over medium-high heat. Sauté the chicken until golden brown, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Pour the sauce over the chicken and transfer the skillet to the oven. Bake until the thickest part of each thigh reaches 165°F.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Rest briefly, then serve the chicken with the sauce."
    }
  ],
