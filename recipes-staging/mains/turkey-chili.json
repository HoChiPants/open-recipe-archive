  "instructions": [
    {
      "step": 1,
      "text": "Combine the ancho chile powder, paprika, ground cumin, salt, ground dried chipotle pepper, dried oregano, cocoa powder, black pepper, cayenne, and cinnamon."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large pot over medium heat. Add the onion and cook, stirring, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the spice mixture, ground turkey, and garlic. Cook, stirring and breaking up the turkey, for 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Stir in the tomato puree and water, then bring the chili to a gentle simmer. Cook uncovered for 60 minutes, stirring occasionally.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Stir in the drained beans and cook for 4 minutes. Confirm the turkey reaches 165°F at the thickest point before serving.",
      "timer_minutes": 4
    }
  ],
