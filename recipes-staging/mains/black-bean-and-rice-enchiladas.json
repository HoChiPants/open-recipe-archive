  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet. Add the green bell pepper, onion, garlic, tomatoes and green chilies, and red pepper flakes; cook until the vegetables are tender, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Stir in the black beans, picante sauce, chili powder, and ground cumin. Simmer briefly to combine and heat through."
    },
    {
      "step": 4,
      "text": "Fold in the cooked brown rice and 1 cup of shredded Cheddar cheese. Cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Spread the salsa in the bottom of a baking dish. Fill each warmed tortilla with the bean mixture, roll it up, and arrange the enchiladas seam-side down in the dish."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Top with the remaining shredded Cheddar cheese and chopped cilantro. Bake until the cheese is melted, about 3 minutes.",
      "timer_minutes": 3
    }
  ],
