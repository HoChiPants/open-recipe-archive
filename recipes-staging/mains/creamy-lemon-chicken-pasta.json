  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Season the chicken with salt and ground black pepper."
    },
    {
      "step": 2,
      "text": "Cook the farfalle in simmering water for 6 minutes, then drain and set aside.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Heat the butter and olive oil in a large ovenproof skillet. Cook the seasoned chicken until lightly browned, then continue until a thermometer inserted into the thickest part reaches 165°F. Transfer the chicken to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Pour in the wine and simmer briefly. Add the garlic and part of the lemon zest and juice; cook until fragrant.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Warm the cream cheese until softened. Whisk it with the flour and sour cream, then stir in the chicken stock, dried parsley, dried thyme, crushed red pepper, and salt and ground black pepper to taste."
    },
    {
      "step": 6,
      "text": "Add the sauce mixture to the skillet and simmer, stirring, until thickened. Add more chicken stock if needed for a pourable sauce."
    },
    {
      "step": 7,
      "text": "Stir in the remaining lemon zest and juice. Cut the chicken into bite-size pieces and return it to the skillet with the drained pasta. Mix in part of the Parmesan."
    },
    {
      "step": 8,
      "text": "Top with the remaining Parmesan and bake for 15 minutes. Continue baking for about 10 minutes, until lightly browned and hot throughout.",
      "timer_minutes": 10
    }
  ],
