      "unit": "small"
    },
    {
      "ingredient_id": "spears-asparagus",
      "item": "spears asparagus",
      "quantity": 10
    },
    {
      "ingredient_id": "8-ounce-skinless",
      "item": "(8 ounce) skinless",
      "quantity": 2,
      "preparation": "boneless, center-cut salmon fillets"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Cut two large sheets of parchment and fold each in half, then open them."
    },
    {
      "step": 2,
      "text": "Prepare the potatoes and asparagus. Coat the vegetables with the olive oil, season with salt and pepper, and transfer them to a pot of simmering water."
    },
    {
      "step": 3,
      "text": "Simmer the potatoes for about 20 minutes, or until tender. Add the asparagus during the final 5 minutes, then drain and transfer the vegetables to a bowl. Season to taste.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Place one salmon fillet on each parchment sheet. Drizzle with the extra-virgin olive oil and season with salt and pepper."
    },
    {
      "step": 5,
      "text": "Fold the parchment over the fish and seal the edges into packets. Transfer the packets to a baking sheet."
    },
    {
      "step": 6,
      "text": "Bake for 15 minutes, or until the salmon reaches 145°F internally and flakes easily.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Let the packets rest for 5 minutes, then open carefully and serve with the potatoes and asparagus.",
      "timer_minutes": 5
    }
  ],
