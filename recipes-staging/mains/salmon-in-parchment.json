  "id": "salmon-in-parchment",
  "name": "Salmon in Parchment",
  "subtitle": "Tender salmon with potatoes and asparagus",
  "description": "Salmon fillets steam gently in parchment with olive oil while tender potatoes and asparagus make a simple seasonal accompaniment.",
  "meal_type": "main",
  "cuisine": "French Inspired",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
