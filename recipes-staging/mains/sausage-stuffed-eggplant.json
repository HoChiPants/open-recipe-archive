{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "sausage-stuffed-eggplant",
  "name": "Sausage-Stuffed Eggplant",
  "subtitle": "Roasted eggplant filled with savory sausage and tomato sauce",
  "description": "Eggplant halves are roasted until tender, filled with seasoned Italian sausage, sauce, cheese, breadcrumbs, and egg, then baked until set and browned.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "1-1-2-pound-eggplant",
      "item": "(1 1/2 pound) eggplant",
      "quantity": 1,
      "preparation": "halved lengthwise"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "bulk-italian-sausage",
      "item": "bulk Italian sausage",
      "quantity": 0.5,
      "unit": "pound"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-italian-seasoning",
      "item": "dried Italian seasoning",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "black pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "spaghetti-sauce",
      "item": "spaghetti sauce",
      "quantity": 2,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Brush the cut sides of the eggplant with the olive oil and place them cut-side down in a baking dish. Roast for 30 minutes, until tender.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Meanwhile, cook the sausage with the Italian seasoning in a skillet over medium heat, breaking it into small pieces. Drain excess fat and transfer the sausage to a bowl."
    },
    {
      "step": 3,
      "text": "Stir the sausage with the garlic powder, remaining Italian seasoning, black pepper, 1 cup of the spaghetti sauce, 1/2 cup of the mozzarella, the breadcrumbs, and the beaten egg. Cooked sausage should reach 160°F."
    },
    {
      "step": 4,
      "text": "Turn the roasted eggplant cut-side up. Scoop out enough flesh to form shells, chop the removed flesh, and fold it into the sausage mixture."
    },
    {
      "step": 5,
      "text": "Fill the eggplant shells with the mixture. Spoon the remaining spaghetti sauce over and around them, then top with the remaining mozzarella."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until the filling is firm and the cheese is melted and lightly browned. Confirm the center reaches 160°F.",
      "timer_minutes": 30
    }
  ],
