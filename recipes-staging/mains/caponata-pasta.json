  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil, or reserved oil from the vegetables, in a large pan over medium heat. Cook the onion for 10 minutes until softened.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the sliced garlic and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir in the chopped Mediterranean vegetables, tomatoes, capers, and raisins. Bring to a simmer and cook for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Meanwhile, cook the pasta in salted boiling water according to the package directions until tender. Drain, reserving a little pasta water if needed."
    },
    {
      "step": 5,
      "text": "Toss the drained pasta with the sauce, loosening with a splash of reserved pasta water if necessary."
    },
    {
      "step": 6,
      "text": "Serve with basil leaves and shaved parmesan or vegetarian alternative."
    }
  ],
