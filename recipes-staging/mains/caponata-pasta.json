  "id": "caponata-pasta",
  "name": "Caponata Pasta",
  "subtitle": "Short pasta with Mediterranean vegetables, tomato, capers, and basil",
  "description": "A quick vegetarian pasta combining chargrilled vegetables with a sweet-tangy tomato sauce and fresh basil.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
