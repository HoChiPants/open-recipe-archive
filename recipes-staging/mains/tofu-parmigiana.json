  "id": "tofu-parmigiana",
  "name": "Tofu Parmigiana",
  "subtitle": "Crisp tofu baked with tomato sauce and melted cheese",
  "description": "Breaded tofu is browned, layered with seasoned tomato sauce, and baked until the cheese is melted and bubbling.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "seasoned-bread-crumbs",
      "item": "seasoned bread crumbs",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    },
    {
      "ingredient_id": "firm-tofu",
      "item": "firm tofu",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 ounce"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "tomato-sauce",
      "item": "tomato sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Combine the bread crumbs, Parmesan, 1 teaspoon oregano, salt, and pepper in a shallow dish."
    },
    {
      "step": 3,
      "text": "Cut the tofu into thick slices and coat each slice with the crumb mixture."
    },
    {
      "step": 4,
      "text": "Heat the olive oil in a skillet over medium heat. Cook the coated tofu until browned on both sides."
    },
    {
      "step": 5,
      "text": "Stir together the tomato sauce, remaining oregano, basil, and garlic."
    },
    {
      "step": 6,
      "text": "Spread some sauce in a baking dish, arrange the browned tofu over it, and spoon the remaining sauce on top."
    },
    {
      "step": 7,
      "text": "Sprinkle with the remaining Parmesan and the mozzarella."
    },
    {
      "step": 8,
      "text": "Bake for 20 minutes, until the sauce is hot and the cheese is melted and bubbling.",
      "timer_minutes": 20
    }
  ],
