  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Place the arctic char in a baking dish and season with sea salt. Add the lime zest and juice."
    },
    {
      "step": 3,
      "text": "Combine the olive oil, sherry wine, rosemary leaves, and garlic. Pour the mixture over the fish, then season with cayenne and black pepper."
    },
    {
      "step": 4,
      "text": "Bake for 15 minutes, then briefly grill for 2 minutes to finish. The fish is ready when it reaches 145°F internally or is opaque and flakes easily.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Serve immediately with the pan juices."
    }
  ],
