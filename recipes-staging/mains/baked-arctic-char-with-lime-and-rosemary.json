  "id": "baked-arctic-char-with-lime-and-rosemary",
  "name": "Baked Arctic Char with Lime and Rosemary",
  "subtitle": "A bright, herb-scented fish dinner",
  "description": "Arctic char is seasoned with lime, rosemary, garlic, sherry, and olive oil, then baked and briefly grilled for a finished surface.",
  "meal_type": "main",
  "cuisine": "American",
