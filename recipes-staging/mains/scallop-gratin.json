  "id": "scallop-gratin",
  "name": "Scallop Gratin",
  "subtitle": "Tender sea scallops with a creamy herb topping",
  "description": "Sea scallops are coated in seasoned butter, topped with crème fraîche, tarragon, and Parmesan, then baked and browned under the grill.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted, or as needed, divided"
    },
    {
      "ingredient_id": "creme-fraiche",
      "item": "creme fraiche",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "dry-pack-sea-scallops",
      "item": "dry-pack sea scallops",
      "quantity": 8
    },
    {
      "ingredient_id": "fresh-tarragon",
      "item": "fresh tarragon",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "finely-grated-parmesan-cheese",
      "item": "finely grated Parmesan cheese",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F. Lightly butter a small gratin dish with some of the melted butter."
    },
    {
      "step": 2,
      "text": "Whisk the white wine, lemon zest, cayenne, and salt into the crème fraîche until smooth."
    },
    {
      "step": 3,
      "text": "Coat the scallops with the remaining melted butter and arrange them in the prepared dish. Let stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Spoon the crème fraîche mixture over the scallops, then scatter the tarragon and Parmesan on top. Bake for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Switch to the grill and cook until the topping is golden brown and the scallops are opaque and easily flaked, about 4 minutes.",
      "timer_minutes": 4
    }
  ],
