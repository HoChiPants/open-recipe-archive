  "instructions": [
    {
      "step": 1,
      "text": "Place the diced sweet potato in a saucepan, cover with water, and add the salt. Bring to a simmer and cook until tender, about 15 minutes. Drain well.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Combine the sweet potato with the cilantro, chili powder, and remaining salt. Set aside."
    },
    {
      "step": 3,
      "text": "Cook the frozen corn in a skillet over medium heat for 2 minutes. Stir in the black beans, then remove the mixture from the pan.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Mix the corn and beans with the sweet potato mixture and half of the Cheddar."
    },
    {
      "step": 5,
      "text": "Place a tortilla on a work surface. Spread filling over one half, fold it over, and repeat with the remaining tortillas and filling."
    },
    {
      "step": 6,
      "text": "Lightly coat a skillet with cooking spray and preheat over medium heat. Cook the quesadillas in batches for about 4 minutes per side, turning once, until the tortillas are crisp and the cheese is melted.",
      "timer_minutes": 4
    },
    {
      "step": 7,
      "text": "Cut the quesadillas into wedges and serve warm."
    }
  ],
