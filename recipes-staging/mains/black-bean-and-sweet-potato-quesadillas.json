  "id": "black-bean-and-sweet-potato-quesadillas",
  "name": "Black Bean and Sweet Potato Quesadillas",
  "subtitle": "Crisp tortillas filled with smoky vegetables, beans, and melted cheese.",
  "description": "Tender sweet potato, corn, and black beans make a hearty filling for golden, cheesy quesadillas.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
