{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "eggplant-balls",
  "name": "Eggplant Balls",
  "subtitle": "Tender baked eggplant bites with Parmesan and parsley",
  "description": "Tender eggplant is combined with herbs, cheese, breadcrumbs, and eggs, then shaped and baked until firm.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "eggplant",
      "item": "eggplant",
      "quantity": 4,
      "unit": "cups",
      "preparation": "cubed, with peel"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large",
      "preparation": "beaten"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a skillet over medium heat. Add the garlic and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Stir in the eggplant and water, cover, and cook for 20 minutes, stirring occasionally, until the eggplant is tender.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Transfer the eggplant to a bowl and let it cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the parsley, bread crumbs, Parmesan, and beaten eggs. Mix until combined, adding more bread crumbs if needed for a shapeable mixture."
    },
    {
      "step": 5,
      "text": "Chill the mixture for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Heat the oven to 350°F and prepare a baking sheet."
    },
    {
      "step": 7,
      "text": "Shape the eggplant mixture into balls and place them on the baking sheet."
    },
    {
      "step": 8,
      "text": "Bake for 30 minutes, until firm and the center reaches 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 9,
      "text": "Serve warm."
    }
  ],
