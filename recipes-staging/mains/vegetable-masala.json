  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes, carrot, green beans, peas, and cold water in a pot. Bring to a boil, then drain."
    },
    {
      "step": 2,
      "text": "Return the drained vegetables to the pot and season with salt and turmeric. Cook for 8 minutes, stirring occasionally.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Meanwhile, preheat a skillet over medium heat. Toast the mustard seed and cumin briefly, then add the onion and vegetable oil.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the tomatoes, garam masala, ginger, garlic powder, and chili powder. Sauté for 3 minutes, then fold in the cooked vegetables.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Transfer to a serving dish and garnish with the cilantro leaves."
    }
  ],
