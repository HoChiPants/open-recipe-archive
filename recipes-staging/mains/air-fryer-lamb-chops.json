{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "air-fryer-lamb-chops",
  "name": "Air Fryer Lamb Chops",
  "subtitle": "Garlic-herb lamb chops with crisp edges",
  "description": "Season lamb chops with garlic, herbs, and olive oil, then air-fry until browned and cooked to a safe temperature. Finish with parsley if desired.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 12
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": "1 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-cloves-finely-grated",
      "item": "garlic cloves finely grated",
      "quantity": 2
    },
    {
      "ingredient_id": "fresh-herbs-such-as-rosemary",
      "item": "fresh herbs such as rosemary",
      "quantity": 1,
      "unit": "tbsp",
      "preparation": "chopped, thyme or oregano"
    },
    {
      "ingredient_id": "lamb-chops",
      "item": "lamb chops",
      "quantity": 8
    },
    {
      "ingredient_id": "fresh-parsley-to-serve-optional",
      "item": "fresh parsley to serve (optional)",
      "preparation": "chopped",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to the manufacturer's instructions."
    },
    {
      "step": 2,
      "text": "Combine the olive oil, garlic cloves finely grated, and fresh herbs such as rosemary. Coat the lamb chops evenly with the mixture."
    },
    {
      "step": 3,
      "text": "Arrange the lamb chops in a single layer in the air-fryer basket."
    },
    {
      "step": 4,
      "text": "Cook for 6 minutes, turn the chops, and cook for 6 minutes more, or until the thickest part reaches 145°F.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Transfer the chops to a plate and rest for 3 minutes. Sprinkle with fresh parsley to serve (optional).",
      "timer_minutes": 3
    }
  ],
