  "id": "tandoori-style-grilled-chicken",
  "name": "Tandoori-Style Grilled Chicken",
  "subtitle": "Yogurt-marinated chicken thighs with warm Indian spices",
  "description": "Chicken thighs are coated in a tangy yogurt and tandoori masala marinade, rested, then grilled until lightly charred and fully cooked.",
  "meal_type": "main",
  "cuisine": "Indian Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "lime",
      "item": "lime",
      "quantity": 0.5,
      "preparation": "juiced"
    },
    {
      "ingredient_id": "plain-yogurt",
      "item": "plain yogurt",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "tandoori-masala-powder",
      "item": "tandoori masala powder",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "boneless",
      "item": "boneless",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "skinless chicken thighs"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the lime juice, yogurt, tandoori masala, salt, and pepper in a bowl."
    },
    {
      "step": 2,
      "text": "Add the chicken and turn to coat thoroughly. Cover and refrigerate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Preheat a grill to high heat and lightly oil the grates if needed."
    },
    {
      "step": 4,
      "text": "Grill the chicken for 2 minutes, then turn and grill for 6 minutes per side, or until the thickest pieces reach 165°F.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Transfer the chicken to a plate and rest briefly before serving."
    }
  ],
