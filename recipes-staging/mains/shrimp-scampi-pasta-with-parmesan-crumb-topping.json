{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "shrimp-scampi-pasta-with-parmesan-crumb-topping",
  "name": "Shrimp Scampi Pasta with Parmesan Crumb Topping",
  "subtitle": "Garlic shrimp and angel hair finished with a crisp Parmesan topping",
  "description": "Tender shrimp and lemon-garlic sauce coat angel hair pasta beneath a golden, savory crumb topping.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "angel-hair-pasta",
      "item": "angel hair pasta",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "uncooked-medium-shrimp",
      "item": "uncooked medium shrimp",
      "quantity": 1,
      "unit": "pound",
      "preparation": "peeled and deveined"
    },
    {
      "ingredient_id": "white-cooking-wine",
      "item": "white cooking wine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1,
      "preparation": "juiced"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "seasoned-bread-crumbs",
      "item": "seasoned bread crumbs",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "freshly-grated-parmesan-cheese",
      "item": "freshly grated Parmesan cheese",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "finely-chopped-fresh-parsley",
      "item": "finely chopped fresh parsley",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer, then cook the angel hair pasta in boiling water for 5 minutes. Drain and set aside.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Preheat the broiler. Melt half of the butter in a large ovenproof skillet over medium heat."
    },
    {
      "step": 3,
      "text": "Add the garlic and stir briefly until fragrant."
    },
    {
      "step": 4,
      "text": "Add the shrimp, cooking wine, and lemon juice. Cook and stir for about 5 minutes, until the shrimp are opaque and fully cooked.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the red pepper flakes, then remove the skillet from the heat."
    },
    {
      "step": 6,
      "text": "Melt the remaining butter and combine it with the bread crumbs, half of the Parmesan, and parsley."
    },
    {
      "step": 7,
      "text": "Toss the drained pasta with the shrimp and sauce in the skillet."
    },
    {
      "step": 8,
      "text": "Top with the remaining Parmesan and the buttered bread crumbs."
    },
    {
      "step": 9,
      "text": "Broil for about 4 minutes, until the topping is golden brown.",
      "timer_minutes": 4
    },
    {
      "step": 10,
      "text": "Serve hot."
    }
  ],
