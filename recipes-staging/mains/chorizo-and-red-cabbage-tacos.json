  "instructions": [
    {
      "step": 1,
      "text": "Combine the sliced cabbage and chopped coriander with the lime juice. Set aside while preparing the filling."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet over medium heat. Add the chopped chorizo, onions, and peppers; cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the crushed garlic and smoked paprika, then add the drained pinto beans. Cook until the beans are hot throughout."
    },
    {
      "step": 4,
      "text": "Warm the corn tortillas in a dry skillet or according to package directions."
    },
    {
      "step": 5,
      "text": "Fill the tortillas with the chorizo mixture and top with the cabbage mixture and cubed avocado."
    }
  ],
