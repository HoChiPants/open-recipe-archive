  "id": "chorizo-and-red-cabbage-tacos",
  "name": "Chorizo and Red Cabbage Tacos",
  "subtitle": "Spiced chorizo and beans with fresh cabbage and avocado",
  "description": "Warm corn tortillas around a smoky chorizo, pepper, onion, and pinto bean filling, finished with lime-dressed cabbage, coriander, and avocado.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
