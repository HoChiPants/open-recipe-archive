  "instructions": [
    {
      "step": 1,
      "text": "Whisk the soy sauce, ginger, and sweet and sour sauce together. Add the steak and toss to coat; let stand for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Heat a large skillet or wok over high heat. Add the marinated steak and cook for 5 minutes, turning as needed, until it reaches 145°F. Transfer the steak to a plate and rest for 3 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Heat the butter in the skillet. Add the mushrooms, onion, bell pepper, and remaining sauce mixture, stirring to combine."
    },
    {
      "step": 4,
      "text": "Cook the vegetables and sauce for 3 minutes, then return the steak to the pan and cook for 2 minutes more.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Serve the ginger beef over the cooked rice."
    }
  ],
