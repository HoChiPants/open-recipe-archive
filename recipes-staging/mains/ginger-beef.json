  "id": "ginger-beef",
  "name": "Ginger Beef",
  "subtitle": "Tender sliced beef with crisp vegetables and tangy sauce",
  "description": "Thinly sliced round steak is briefly marinated with ginger and sauces, then stir-fried with mushrooms, onion, and bell pepper and served over rice.",
  "meal_type": "main",
