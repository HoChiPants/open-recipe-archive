  "id": "honey-balsamic-basil-chicken",
  "name": "Honey-Balsamic Basil Chicken",
  "subtitle": "Tender chicken strips with a sweet-tangy skillet glaze",
  "description": "Quickly sauté seasoned chicken, then finish it with fresh basil, honey, and balsamic vinegar for a simple two-serving meal.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "chicken-tenderloin-strips",
      "item": "chicken tenderloin strips",
      "quantity": 6,
      "unit": "ounces"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "basil",
      "item": "fresh basil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 1.5,
      "unit": "teaspoons",
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Season the chicken strips with the salt and black pepper, then add them to the skillet."
    },
    {
      "step": 3,
      "text": "Cook, stirring occasionally, until the chicken reaches 165°F in the thickest pieces, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the basil, honey, and balsamic vinegar. Cook briefly until the chicken is coated, then serve."
    }
  ],
