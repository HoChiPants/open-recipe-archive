  "id": "pineapple-salsa-chicken",
  "name": "Pineapple Salsa Chicken",
  "subtitle": "Grilled jerk-seasoned chicken with fresh pineapple salsa",
  "description": "Juicy grilled chicken is paired with a bright, lightly spicy pineapple salsa for an easy weeknight main.",
  "meal_type": "main",
  "cuisine": "American",
