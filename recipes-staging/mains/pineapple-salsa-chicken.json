  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill to medium-high heat. Pat the chicken dry, coat it with olive oil, and rub with the jerk seasoning."
    },
    {
      "step": 2,
      "text": "Combine the pineapple, bell pepper, jalapeno, red onion, cilantro, lime juice, and salt. Stir and set aside."
    },
    {
      "step": 3,
      "text": "Grill the chicken for about 14 minutes, turning as needed, until the thickest part reaches 165°F on a food thermometer.",
      "timer_minutes": 14
    },
    {
      "step": 4,
      "text": "Transfer the chicken to a plate and let it rest for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Top the chicken with the pineapple salsa and serve."
    }
  ],
