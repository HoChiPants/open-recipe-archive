  "id": "cuban-beans-and-rice",
  "name": "Cuban Beans and Rice",
  "subtitle": "A hearty baked rice dish with beans and vegetables",
  "description": "Rice, kidney beans, tomato paste, and sautéed vegetables combine into a filling one-dish meal.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "tomato-paste",
      "item": "tomato paste",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kidney-beans",
      "item": "kidney beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "15.25 ounce, drained with liquid reserved"
    },
    {
      "ingredient_id": "uncooked-white-rice",
      "item": "uncooked white rice",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and lightly oil a baking dish."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet. Add the onion, bell pepper, and garlic; cook until the vegetables begin to soften."
    },
    {
      "step": 3,
      "text": "Stir in the salt and tomato paste and cook briefly until the paste is evenly distributed.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the beans and rice, then stir to combine. Pour in the reserved bean liquid and mix evenly."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to the prepared baking dish and cook until the rice is tender and the liquid has been absorbed.",
      "timer_minutes": 50
    }
  ],
