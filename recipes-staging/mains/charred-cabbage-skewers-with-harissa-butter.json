  "id": "charred-cabbage-skewers-with-harissa-butter",
  "name": "Charred Cabbage Skewers with Harissa Butter",
  "subtitle": "Grilled cabbage with spicy butter, yogurt, and crisp onions",
  "description": "Tender cabbage is grilled until charred, then served with harissa butter, lemony yogurt, parsley, and crispy onions.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "as a side"
  },
