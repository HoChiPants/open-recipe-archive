  "instructions": [
    {
      "step": 1,
      "text": "Melt the salted butter with the harissa, lemon zest and juice, and crushed garlic over medium heat. Cook for 3 minutes, then stir in the parsley and set aside.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Prepare the pointed spring cabbage by removing any damaged outer leaves and cutting it into wedges suitable for skewering."
    },
    {
      "step": 3,
      "text": "Thread the cabbage wedges onto skewers and brush them with neutral oil."
    },
    {
      "step": 4,
      "text": "Grill the skewers for about 5 minutes, turning as needed, until the cabbage is tender and well charred.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Spread the thick Greek yogurt on a serving plate. Top with the grilled cabbage, harissa butter, and crispy onions."
    }
  ],
