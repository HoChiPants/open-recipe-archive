{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "italian-beef-sandwiches",
  "name": "Italian Beef Sandwiches",
  "subtitle": "Tender shredded beef with pepperoncini on toasted buns",
  "description": "Slow-cooked chuck roast becomes tender and shreddable, then is finished with pepperoncini and served in split buns.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 360
  },
  "ingredients": [
    {
      "ingredient_id": "beef-chuck-roast",
      "item": "beef chuck roast",
      "quantity": 3,
      "unit": "pounds"
    },
    {
      "ingredient_id": "dry-italian-salad-dressing-mix",
      "item": "dry Italian salad dressing mix",
      "quantity": 3,
      "unit": "package",
      "preparation": "1 ounce"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "16-ounce-jar-pepperoncini-peppers",
      "item": "(16 ounce) jar pepperoncini peppers",
      "quantity": 1
    },
    {
      "ingredient_id": "hamburger-buns",
      "item": "hamburger buns",
      "quantity": 8,
      "preparation": "split"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the chuck roast with the dry Italian salad dressing mix in a slow cooker."
    },
    {
      "step": 2,
      "text": "Add the water, cover, and cook for 6 hours, until the roast is tender. For safety, verify a whole-cut beef temperature of at least 145°F, then rest for 3 minutes.",
      "timer_minutes": 360
    },
    {
      "step": 3,
      "text": "Shred the beef in the cooking juices, removing any large pieces of fat."
    },
    {
      "step": 4,
      "text": "Add the pepperoncini peppers and stir to combine. Cook briefly until heated through."
    },
    {
      "step": 5,
      "text": "Serve the shredded beef and peppers in the split hamburger buns."
    }
  ],
