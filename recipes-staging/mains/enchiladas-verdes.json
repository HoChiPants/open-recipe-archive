  "instructions": [
    {
      "step": 1,
      "text": "Combine the chicken, broth, half the halved onion, 2 teaspoons salt, and half the garlic in a pot. Bring to a simmer and cook until the chicken reaches 165°F at the thickest part, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Transfer the chicken to cool. Reserve the broth, then remove the chicken from the bones and shred it."
    },
    {
      "step": 3,
      "text": "Simmer the tomatillos and serrano peppers in water until the tomatillos soften. Drain and transfer them to a blender with the remaining halved onion, remaining garlic, pinch of salt, reserved broth, and vegetable oil. Blend until smooth."
    },
    {
      "step": 4,
      "text": "Preheat a skillet over medium heat. Sauté the tortillas briefly in the oil until pliable, then drain them."
    },
    {
      "step": 5,
      "text": "Dip or soften each tortilla in the hot sauce, fill with shredded chicken, and roll. Arrange the enchiladas and spoon over the remaining sauce."
    },
    {
      "step": 6,
      "text": "Top with chopped onion, queso fresco, and cilantro. Serve warm."
    }
  ],
