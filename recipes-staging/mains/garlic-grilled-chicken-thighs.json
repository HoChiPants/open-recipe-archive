{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "garlic-grilled-chicken-thighs",
  "name": "Garlic Grilled Chicken Thighs",
  "subtitle": "Buttery chicken with garlic, soy, and parsley",
  "description": "Boneless, skin-on chicken thighs are coated in a savory garlic butter mixture and grilled until fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "minced"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dried-parsley",
      "item": "dried parsley",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "boneless-chicken-thighs",
      "item": "boneless chicken thighs",
      "quantity": 6,
      "preparation": "with skin"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill or broiler and prepare the cooking surface."
    },
    {
      "step": 2,
      "text": "Combine the garlic, soy sauce, dried parsley, and black pepper."
    },
    {
      "step": 3,
      "text": "Microwave the butter for 2 minutes, or until melted, then stir it into the garlic mixture.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Transfer the chicken thighs to the prepared surface and coat them with the butter mixture."
    },
    {
      "step": 5,
      "text": "Grill for about 20 minutes, turning as needed, until the thickest thigh reaches 165°F on a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Garnish with the dried parsley."
    }
  ],
