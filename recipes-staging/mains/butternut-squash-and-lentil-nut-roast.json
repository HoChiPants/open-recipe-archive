  "instructions": [
    {
      "step": 1,
      "text": "Soak the dried porcini mushrooms in boiling water for 10 minutes, then drain and chop. Reserve the soaking liquid if desired.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat 2 tablespoons of the olive oil in a pan. Cook the onion and button mushrooms for 15 minutes, then stir in the garlic and rosemary for 1 minute.",
      "timer_minutes": 16
    },
    {
      "step": 3,
      "text": "Meanwhile, toss the squash and courgette with the remaining olive oil and cook until tender, about 30 minutes. Cool briefly.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Combine the cooked mushrooms, porcini, breadcrumbs, lentils, chopped almonds, pecans, walnuts, cumin, and cayenne."
    },
    {
      "step": 5,
      "text": "Line a loaf tin or similar baking dish. Arrange the squash, courgette, and roasted peppers in layers with the nut-and-lentil mixture, finishing with a layer of vegetables. Cool completely if assembling ahead."
    },
    {
      "step": 6,
      "text": "Heat the oven to 350°F (180°C). Cover the roast and bake for 60 minutes; uncover and bake for a further 8 minutes.",
      "timer_minutes": 68
    },
    {
      "step": 7,
      "text": "Warm the caster sugar with the remaining layered vegetables as directed until melted, then bake for 10 minutes to finish the topping.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Rest briefly, scatter with parsley, and serve."
    }
  ],
