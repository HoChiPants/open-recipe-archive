  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill and cook the bacon rashers for about 5 minutes, turning as needed, until browned. Set aside to cool, then chop.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large ovenproof pan or skillet. Add the chicken thighs, oregano, and crushed garlic. Prepare the stock cube according to its directions, add it to the pan, and cook for 20 minutes, turning occasionally, until the chicken is tender and reaches 165°F at the thickest point.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Transfer the chicken to a plate. Stir the flour into the pan juices over heat until smooth, then gradually whisk in the cream. Cook for about 10 minutes, stirring, until thickened.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Meanwhile, cook the pasta in boiling water for about 10 minutes, or until tender. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Return the chicken to the sauce and stir in the Parmesan, mustard, chopped spinach, tomatoes, and bacon. Cut the chicken into bite-size pieces and fold in the drained pasta."
    },
    {
      "step": 6,
      "text": "Top with the breadcrumbs and bake in a preheated oven for 40 minutes, until bubbling, browned on top, and the chicken mixture is hot throughout.",
      "timer_minutes": 40
    }
  ],
