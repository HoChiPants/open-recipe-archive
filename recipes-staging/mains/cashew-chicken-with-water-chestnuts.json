  "id": "cashew-chicken-with-water-chestnuts",
  "name": "Cashew Chicken with Water Chestnuts",
  "subtitle": "Tender chicken and crisp vegetables in a savory cashew sauce",
  "description": "Chicken, peppers, onion, and water chestnuts are stir-fried with cashews and finished in a lightly thickened ginger-soy sauce.",
  "meal_type": "main",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "hot-pepper-sauce",
      "item": "hot pepper sauce",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 1,
      "unit": "pound",
      "preparation": "boneless chicken breast meat - cut into strips"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "water-chestnuts",
      "item": "water chestnuts",
      "quantity": 1,
      "unit": "can",
      "preparation": "8 ounce, sliced, drained"
    },
    {
      "ingredient_id": "cashews",
      "item": "cashews",
      "quantity": 0.66666668653488,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cornstarch with 2 tablespoons of the chicken broth until smooth. Stir in the soy sauce, ground ginger, and hot pepper sauce; set aside."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large skillet over medium-high heat. Add the chicken strips and stir-fry until lightly browned and cooked through, about 5 minutes. Confirm the thickest piece reaches 165°F with a food thermometer, then transfer the chicken to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the onion, green bell pepper, and water chestnuts to the skillet. Stir-fry until the vegetables begin to soften, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir the cornstarch mixture into the remaining chicken broth, then pour it into the skillet. Cook, stirring, until the sauce simmers and thickens."
    },
    {
      "step": 5,
      "text": "Return the chicken to the skillet and stir to coat. Add the cashews and serve hot."
    }
  ],
