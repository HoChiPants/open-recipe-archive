  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill to medium-high heat."
    },
    {
      "step": 2,
      "text": "Season the chicken with garlic powder, salt, and pepper. Drain the beans."
    },
    {
      "step": 3,
      "text": "Grill the chicken for 6 minutes, turning as needed, until cooked through and the thickest part reaches 165°F.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Rest the chicken briefly, then cut it into bite-size pieces."
    },
    {
      "step": 5,
      "text": "Warm the corn and black beans in a skillet over medium heat for 5 minutes; season with salt and pepper.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Divide the cooked rice between two bowls. Add the warm corn and beans, chopped lettuce, and chicken."
    },
    {
      "step": 7,
      "text": "Stir together the sour cream, shredded cheese, and salsa, then spoon the mixture over the bowls."
    }
  ],
