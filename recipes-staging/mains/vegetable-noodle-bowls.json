  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large skillet over medium-high heat. Add the mushrooms, snow peas, shredded carrot, and green onions; cook for 4 minutes, stirring occasionally, until tender.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Add the garlic and cook for 1 minute, stirring, until fragrant.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Stir together the soy sauce, sugar, and cayenne pepper, then pour the mixture into the skillet and combine with the vegetables."
    },
    {
      "step": 4,
      "text": "Add the cooked spaghetti and toss until evenly coated. Cook for 1 minute to heat through.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Divide among bowls and sprinkle with the toasted sesame seeds."
    }
  ],
