  "id": "beef-burgundy",
  "name": "Beef Burgundy",
  "subtitle": "Tender beef braised with red wine, mushrooms, and onions",
  "description": "Small pieces of beef are browned, coated in flour, and slowly simmered with broth, red wine, herbs, mushrooms, and onions until tender.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 7,
