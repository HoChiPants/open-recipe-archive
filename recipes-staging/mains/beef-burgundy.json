      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "round-steak",
      "item": "round steak",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "cut into small pieces"
    },
