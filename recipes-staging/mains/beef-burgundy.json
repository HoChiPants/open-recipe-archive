  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large oven-safe pot over medium-high heat. Brown the beef in batches, then return all the beef to the pot."
    },
    {
      "step": 2,
      "text": "Sprinkle in the flour and stir until the beef is evenly coated. Gradually add the beef broth, stirring to form a smooth sauce."
    },
    {
      "step": 3,
      "text": "Stir in the red wine, salt, marjoram, thyme, and pepper. Bring the mixture to a simmer."
    },
    {
      "step": 4,
      "text": "Cover the pot and simmer gently for 2 hours, stirring occasionally, until the beef is tender and reaches at least 145°F; rest whole-cut beef for 3 minutes before serving.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Add the mushrooms and onions, then continue cooking until the vegetables are tender and the sauce is hot."
    }
  ],
