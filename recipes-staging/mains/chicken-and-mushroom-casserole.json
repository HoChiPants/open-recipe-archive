{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chicken-and-mushroom-casserole",
  "name": "Chicken and Mushroom Casserole",
  "subtitle": "Tender chicken in a creamy mushroom sauce",
  "description": "Chicken, assorted mushrooms, sage, and cream are combined in a savory sauce and baked until fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 44
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "boneless-chicken-breast",
      "item": "boneless chicken breast",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "cut into strips"
    },
    {
      "ingredient_id": "cremini-mushrooms",
      "item": "cremini mushrooms",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "oyster-mushrooms",
      "item": "oyster mushrooms",
      "quantity": 5,
      "unit": "ounces",
      "preparation": "stemmed and sliced"
    },
    {
      "ingredient_id": "shiitake-mushrooms",
      "item": "shiitake mushrooms",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "stemmed and sliced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "chicken-stock",
      "item": "chicken stock",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "ground-sage",
      "item": "ground sage",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large skillet. Add the chicken and chicken stock, and stir for 2 minutes. Transfer the chicken and stock to a casserole dish.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the cremini, oyster, and shiitake mushrooms and the garlic to the skillet. Cook, stirring, until the mushrooms are tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the flour, then add the white wine. Add the ground sage, salt and black pepper, and simmer until the sauce thickens.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Warm the heavy whipping cream gently, then combine it with the mushroom sauce and the chicken mixture in the casserole dish."
    },
    {
      "step": 6,
      "text": "Bake until the casserole is hot and the chicken reaches 165°F at the thickest point.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Garnish with the chopped fresh parsley and serve."
    }
  ],
