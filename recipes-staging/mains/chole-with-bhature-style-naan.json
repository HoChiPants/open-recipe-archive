  "instructions": [
    {
      "step": 1,
      "text": "Mix the diced cucumber, diced tomatoes, diced red onion, mint sauce, and lemon juice. Set aside."
    },
    {
      "step": 2,
      "text": "Stir the grated cucumber, 500 ml yogurt, garam masala, milk, and finely chopped coriander together. Chill until serving."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a large pot. Add the finely chopped onions and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the finely chopped garlic, grated ginger, and green chillies; cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the canned tomatoes, garam masala, paprika, and methi. Cook until combined and slightly thickened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Stir in the rinsed chickpeas and powdered potato. Simmer for 10 minutes, then finish with the chopped coriander.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Combine the flour, 250 ml yogurt, milk, flavourless oil, sugar, baking powder, and ajwain. Knead into a soft dough, adding the extra oil as needed, then divide and shape into naan."
    },
    {
      "step": 8,
      "text": "Heat a heavy skillet over medium-high heat. Cook the naan in batches for about 2 minutes per side, adding the butter, sliced garlic, chopped coriander, and kalonji as a finishing topping. Serve with the chole, cucumber yogurt, and salad.",
      "timer_minutes": 2
    }
  ],
