  "id": "bombay-potato-fishcakes",
  "name": "Bombay Potato Fishcakes",
  "subtitle": "Crisp white-fish cakes with curry-seasoned potatoes",
  "description": "Flaky white fish and tender potatoes form six lightly spiced fishcakes, coated in crushed poppadums and pan-fried until crisp.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "(makes 6 fishcakes)"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "potatoes-cut-into-chunks",
      "item": "potatoes cut into chunks",
      "quantity": 2,
      "unit": "medium"
    },
    {
      "ingredient_id": "fresh-or-frozen-flaky-white-fish-fillet-about-200g-we-used-cod-loin",
      "item": "fresh or frozen flaky white fish fillet(about 200g; we used cod loin)",
      "quantity": 1
    },
    {
      "ingredient_id": "spring-onions-sliced",
      "item": "spring onions sliced",
      "quantity": 4
    },
    {
      "ingredient_id": "curry-powder-gluten-free",
      "item": "curry powder (gluten-free",
      "quantity": 2,
      "unit": "tsp",
      "preparation": "if needed)"
    },
    {
      "ingredient_id": "poppadums-crushed",
      "item": "poppadums crushed",
      "quantity": 2,
      "preparation": "or a handful of breadcrumbs (gluten-free if needed)"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "salad-mango-chutney-and-lemon-wedges",
      "item": "salad mango chutney and lemon wedges",
      "preparation": "to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Boil the potatoes in water for 15 minutes, or until tender.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Add the fish and sliced spring onions to the pot. Cook until the fish is opaque, flakes easily, and reaches 145°F in the thickest part."
    },
    {
      "step": 3,
      "text": "Drain well, then mash the potatoes and fish with the curry powder. Shape the mixture into 6 fishcakes."
    },
    {
      "step": 4,
      "text": "Coat each fishcake with the crushed poppadums or breadcrumbs. Chill until firm.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Heat the vegetable oil in a skillet over medium heat for about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Pan-fry the fishcakes until golden and heated through, turning once or twice. Serve with salad, mango chutney, and lemon wedges."
    }
  ],
