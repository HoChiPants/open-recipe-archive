  "id": "prosciutto-wrapped-pork-tenderloin-with-crispy-sage",
  "name": "Prosciutto-Wrapped Pork Tenderloin with Crispy Sage",
  "subtitle": "Tender pork wrapped in prosciutto and finished with crisp sage.",
  "description": "A simple roasted pork tenderloin with a browned prosciutto coating and savory fried sage leaves.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "pork-tenderloin",
      "item": "pork tenderloin",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "bunch-fresh-sage",
      "item": "bunch fresh sage",
      "quantity": 1,
      "preparation": "leaves removed and stems discarded, divided"
    },
    {
      "ingredient_id": "prosciutto",
      "item": "prosciutto",
      "quantity": 6,
      "unit": "ounces"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or more as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Season the pork tenderloin with salt and ground black pepper. Arrange part of the sage over the pork, wrap it completely with prosciutto, and chill for 10 minutes to set.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Heat the olive oil in an oven-safe skillet. Sauté the wrapped tenderloin for about 10 minutes, turning to brown the prosciutto lightly.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Transfer the skillet to the oven and bake for about 20 minutes, until the center reaches 145°F. Remove from the oven and rest for 3 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Sauté the remaining sage in the skillet until crisp, then slice the pork and serve with the sage.",
      "timer_minutes": 5
    }
  ],
