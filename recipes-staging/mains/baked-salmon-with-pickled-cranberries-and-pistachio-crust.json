  "instructions": [
    {
      "step": 1,
      "text": "Place the cranberries, cloves, and juniper berries in a heatproof bowl. Heat the cider vinegar and caster sugar until the sugar dissolves and the mixture reaches a simmer."
    },
    {
      "step": 2,
      "text": "Pour the hot vinegar mixture over the cranberries and stir for 4 minutes. Transfer to a container and chill until ready to serve.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Heat the oven to 400°F. Toast the panko in a dry skillet until lightly golden, then cool for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Combine the cooled panko with the thyme, sumac, lemon zest, and pistachios. Stir in the olive oil to make a loose crumb mixture."
    },
    {
      "step": 5,
      "text": "Place the salmon on a lined baking tray and drizzle with the extra olive oil. Press the crumb mixture over the top."
    },
    {
      "step": 6,
      "text": "Bake for about 25 minutes, until the thickest part reaches 145°F and the fish is opaque and flakes easily.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Transfer the salmon to a serving platter. Spoon the pickled cranberries around it and finish with the parsley."
    }
  ],
