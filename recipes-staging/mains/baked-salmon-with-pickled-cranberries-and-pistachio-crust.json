  "id": "baked-salmon-with-pickled-cranberries-and-pistachio-crust",
  "name": "Baked Salmon with Pickled Cranberries and Pistachio Crust",
  "subtitle": "Bright cranberry relish and a crisp, citrusy topping finish tender salmon.",
  "description": "Pickle the cranberries while preparing a seasoned panko and pistachio crust for an easy centerpiece meal.",
  "meal_type": "main",
