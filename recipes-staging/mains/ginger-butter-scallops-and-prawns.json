  "instructions": [
    {
      "step": 1,
      "text": "Combine the wine, stock, ginger, and garlic in a saucepan and bring to a simmer."
    },
    {
      "step": 2,
      "text": "Add the carrot and leek, then simmer for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the scallops and prawns. Cook gently until the seafood is opaque and cooked through; shellfish should reach 145°F if checked with a thermometer."
    },
    {
      "step": 4,
      "text": "Stir in the cubed butter until melted and the sauce is smooth."
    },
    {
      "step": 5,
      "text": "Season with salt and pepper, scatter with chives, and serve immediately."
    }
  ],
