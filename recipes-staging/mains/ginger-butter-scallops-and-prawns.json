  "id": "ginger-butter-scallops-and-prawns",
  "name": "Ginger Butter Scallops and Prawns",
  "subtitle": "Tender seafood in a light ginger-butter sauce",
  "description": "Scallops and prawns simmer gently with aromatics and vegetables, then finish with butter, chives, and simple seasoning.",
  "meal_type": "main",
  "cuisine": "American",
