  "id": "penne-with-chicken-and-asparagus",
  "name": "Penne with Chicken and Asparagus",
  "subtitle": "A savory pasta dinner with tender chicken and crisp-tender asparagus.",
  "description": "Chicken, asparagus, garlic, and Parmesan come together with penne in a light broth-based sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
