  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of salted water to a boil. Cook the penne for 11 minutes, or until tender, then drain.",
      "timer_minutes": 11
    },
    {
      "step": 2,
      "text": "Meanwhile, heat part of the olive oil in a large skillet. Season the chicken with garlic powder, salt, and pepper, then cook until browned and the thickest pieces reach 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the remaining olive oil, asparagus, sliced garlic, and broth to the skillet. Cook until the asparagus is tender and the broth has reduced slightly.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the drained penne to the skillet and toss until combined. Stir in the Parmesan and serve."
    }
  ],
