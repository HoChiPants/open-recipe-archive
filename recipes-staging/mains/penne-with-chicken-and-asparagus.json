    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "dried-penne-pasta",
      "item": "dried penne pasta",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 5,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 2,
      "preparation": "boneless chicken breast halves - cut into cubes"
    },
