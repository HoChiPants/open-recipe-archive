  "instructions": [
    {
      "step": 1,
      "text": "Preheat a skillet with the butter. Add the bacon, bacon drippings, and onion; stir for 8 minutes, then set aside.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Place the potatoes in a pot with salt, pepper, and water. Simmer until tender, about 20 minutes, then drain and mash until smooth.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Let the potatoes cool for 10 minutes. Mix in the cayenne, one egg, and farmer’s cheese. Chill the filling for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Whisk the remaining egg with the water. Lay out the wonton wrappers and place filling in the center of each. Brush the edges with the egg mixture, fold to seal, and press out excess air."
    },
    {
      "step": 5,
      "text": "Bring salted water to a boil. Simmer the dumplings for 3 minutes, until the wrappers are tender and the filling reaches 160°F or is fully set.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Drain the dumplings. Warm the bacon, drippings, and onion for 2 minutes, then whisk with the sour cream and chives. Serve the dumplings with the sauce.",
      "timer_minutes": 2
    }
  ],
