  "instructions": [
    {
      "step": 1,
      "text": "Cut the sausage links into bite-size pieces. Preheat a large skillet over medium heat, add the sausage, and cook until browned and the center reaches 160°F."
    },
    {
      "step": 2,
      "text": "Drain excess fat. Add the peppers, tomatoes, Italian seasoning, olive oil, onion, and garlic; stir to combine."
    },
    {
      "step": 3,
      "text": "Cover and cook until the vegetables are tender and the flavors have melded.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Stir in the Parmesan and mozzarella, then simmer until the cheese is melted and the mixture is hot.",
      "timer_minutes": 5
    }
