  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Toss the grape tomatoes, bell peppers, onion, balsamic vinegar, Italian seasoning, and half of the salt and pepper with 1 tablespoon olive oil. Spread the mixture on a baking sheet."
    },
    {
      "step": 3,
      "text": "Arrange the thinly sliced uette on the pan with the vegetables and roast for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Toss the remaining bell peppers, salt, and pepper with the remaining olive oil, then add the cooked chicken sausage."
    },
    {
      "step": 5,
      "text": "Add the sausage mixture to the pan and roast until the vegetables are tender and the sausage reaches 160°F internally.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Sprinkle with the fresh oregano and serve."
    }
  ],
