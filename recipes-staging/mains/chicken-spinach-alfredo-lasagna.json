  "id": "chicken-spinach-alfredo-lasagna",
  "name": "Chicken Spinach Alfredo Lasagna",
  "subtitle": "Creamy layered pasta with spinach, chicken, and melted mozzarella",
  "description": "A rich baked lasagna layered with Alfredo-style sauce, ricotta-spinach filling, diced chicken, noodles, and mozzarella.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "lasagna-noodles",
      "item": "lasagna noodles",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "cooked",
      "item": "cooked",
      "quantity": 3,
      "preparation": "boneless chicken breast halves, diced"
    },
    {
      "ingredient_id": "16-ounce-jars-alfredo-style-pasta-sauce",
      "item": "(16 ounce) jars Alfredo-style pasta sauce",
      "quantity": 2
    },
    {
      "ingredient_id": "ricotta-cheese",
      "item": "ricotta cheese",
      "quantity": 2,
      "unit": "pints"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 4,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Bring salted water to a simmer. Add the lasagna noodles and cook for 10 minutes, or until tender. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Cook the spinach for about 7 minutes, until tender, then drain well. Combine it with the ricotta cheese. Stir the Alfredo-style pasta sauce until smooth, seasoning with salt and pepper to taste.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Spread a little sauce in a baking dish. Layer noodles, the spinach-ricotta mixture, diced cooked chicken, sauce, and mozzarella. Repeat the layers, finishing with sauce and mozzarella."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until bubbling and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 60
    }
  ],
