    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "lime-juice",
      "item": "lime juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
