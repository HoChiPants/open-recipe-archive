      "item": "twists lime zest",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the olive oil, lime juice, garlic, cayenne, grated lime zest, black pepper, salt, and lime zest twists in a shallow dish."
    },
    {
      "step": 2,
      "text": "Add the mahi mahi fillets and turn to coat. Cover and refrigerate for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Preheat the grill and prepare the fillets for cooking."
    },
    {
      "step": 4,
      "text": "Grill the mahi mahi until lightly browned and opaque, and the thickest part reaches 145°F, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Garnish with lime juice, grated lime zest, and the lime zest twists before serving."
    }
  ],
