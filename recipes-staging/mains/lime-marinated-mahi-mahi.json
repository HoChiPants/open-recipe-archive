  "id": "lime-marinated-mahi-mahi",
  "name": "Lime-Marinated Mahi Mahi",
  "subtitle": "Bright citrus marinade and a quick grill",
  "description": "Mahi mahi fillets are coated in a garlicky lime marinade, grilled until lightly browned and safely cooked, then finished with lime.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
