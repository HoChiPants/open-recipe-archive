  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Place the pre-baked pizza crust on a baking sheet and bake for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk the garlic, Dijon mustard, rosemary, and white wine vinegar together. Gradually whisk in the olive oil until the mixture thickens."
    },
    {
      "step": 3,
      "text": "Stir the blue cheese and mozzarella together, then season with salt and pepper."
    },
    {
      "step": 4,
      "text": "Remove the crust from the oven and spread it with the dressing. Add the cheese mixture, then arrange the pears and walnut pieces over the top."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, until the cheese is melted. Let the pizza cool briefly before slicing and serving.",
      "timer_minutes": 10
    }
  ],
