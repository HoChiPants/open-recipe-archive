      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F. Coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Combine the sweet potatoes, sliced sausage, and apples in the prepared dish."
    },
    {
      "step": 3,
      "text": "Stir in the honey mustard, then season with salt and ground black pepper."
    },
    {
      "step": 4,
      "text": "Bake until the sweet potatoes are tender and the casserole is heated through, about 45 minutes. Confirm the chicken sausage reaches 165°F in the center before serving.",
