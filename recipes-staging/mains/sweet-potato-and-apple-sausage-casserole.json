      "item": "cooking spray"
    },
    {
      "ingredient_id": "sweet-potatoes",
      "item": "sweet potatoes",
      "quantity": 2,
      "preparation": "peeled and diced, or to taste"
    },
    {
      "ingredient_id": "precooked-apple-chicken-sausage",
      "item": "precooked apple chicken sausage",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 ounce, sliced into rounds"
    },
    {
