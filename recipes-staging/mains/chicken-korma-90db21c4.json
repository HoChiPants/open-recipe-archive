  "instructions": [
    {
      "step": 1,
      "text": "Process the onion, garlic, ginger, korma paste, and coriander into a coarse mixture."
    },
    {
      "step": 2,
      "text": "Cook the mixture in a large saucepan over medium heat, stirring frequently, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the chicken and stir for 2 minutes to coat it evenly.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the ground almonds, sultanas, chicken stock, and sugar. Simmer until the chicken is cooked through and reaches 165°F in the thickest pieces, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Fold in the yogurt and warm gently until the sauce is hot without boiling. Serve with extra ground almonds, if desired."
    }
  ],
