  "id": "salmon-patties",
  "name": "Salmon Patties",
  "subtitle": "Crisp-edged salmon cakes for an easy main dish",
  "description": "Mix canned salmon with egg and self-rising flour, shape into patties, and fry until golden and fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "canned-salmon",
      "item": "canned salmon",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.75 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying",
      "quantity": 1,
      "unit": "quart"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the canned salmon and self-rising flour in a bowl."
    },
    {
      "step": 2,
      "text": "Beat in the egg until the mixture holds together."
    },
    {
      "step": 3,
      "text": "Shape the mixture into four evenly sized patties."
    },
    {
      "step": 4,
      "text": "Heat the vegetable oil for frying in a skillet over medium heat."
    },
    {
      "step": 5,
      "text": "Fry the patties in batches if needed, turning once, until browned on both sides and the centers reach 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Drain the patties briefly before serving."
    }
  ],
