  "id": "make-ahead-manicotti",
  "name": "Make-Ahead Manicotti",
  "subtitle": "Spinach and cheese-filled pasta baked in tomato sauce",
  "description": "Stuff manicotti shells with a spinach, ricotta, and cheese filling, layer them with spaghetti sauce, chill, and bake until hot and fully set.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "ricotta-cheese",
      "item": "ricotta cheese",
      "quantity": 1,
      "unit": "pint"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed and drained"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "manicotti-shells",
      "item": "manicotti shells",
      "quantity": 12
    },
    {
      "ingredient_id": "32-ounce-jar-spaghetti-sauce",
      "item": "(32 ounce) jar spaghetti sauce",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the ricotta and eggs together. Mix in the spinach, mozzarella, sugar, salt, pepper, and half of the Parmesan."
    },
    {
      "step": 2,
      "text": "Prepare the manicotti shells according to package directions until pliable; drain and cool enough to handle."
    },
    {
      "step": 3,
      "text": "Spread a layer of spaghetti sauce in a baking dish. Fill the shells with the cheese mixture and arrange them over the sauce. Cover with the remaining sauce."
    },
    {
      "step": 4,
      "text": "Cover the dish and refrigerate for 8 hours or overnight.",
      "timer_minutes": 480
    },
    {
      "step": 5,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 6,
      "text": "Bake the covered manicotti for 40 minutes. Uncover, add the remaining Parmesan, and bake until bubbling and hot throughout.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Confirm the egg-containing filling reaches 160°F and the center is fully set before serving."
    }
  ],
