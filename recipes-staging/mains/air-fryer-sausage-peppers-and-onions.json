  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 350°F."
    },
    {
      "step": 2,
      "text": "Slice the onions. Toss them with the red, yellow, and orange bell peppers, olive oil, Italian seasoning, salt, and black pepper."
    },
    {
      "step": 3,
      "text": "Arrange the sausage links and seasoned vegetables in the air-fryer basket in as even a layer as possible. Cook for 15 minutes, shaking or stirring the vegetables once.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Turn the sausages and continue cooking until browned and the centers reach 160°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Place a sausage and a slice of provolone in each toasted bun, then top with the peppers and onions."
    }
  ],
