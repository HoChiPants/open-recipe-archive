  "instructions": [
    {
      "step": 1,
      "text": "Cook the penne until tender, then drain."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large pan. Add the chopped chicken and cook until browned and the thickest pieces reach 165°F on a food thermometer."
    },
    {
      "step": 3,
      "text": "Add the sliced mushrooms and butter. Cook until the mushrooms soften and begin to brown.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the garlic and thyme, then pour in the white wine. Simmer until slightly reduced.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the chicken stock and simmer until the chicken is cooked through and the sauce has reduced.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Stir in the double cream and cooked penne. Heat gently until combined, then serve with Parmesan and optional parsley."
    }
  ],
