  "id": "chicken-mushroom-pasta",
  "name": "Chicken Mushroom Pasta",
  "subtitle": "Creamy penne with chicken, mushrooms, and thyme",
  "description": "Penne tossed with browned chicken, mushrooms, garlic, thyme, white wine, stock, and cream, finished with Parmesan and optional parsley.",
  "meal_type": "main",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
