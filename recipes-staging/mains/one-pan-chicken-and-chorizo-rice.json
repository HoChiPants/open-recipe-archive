  "instructions": [
    {
      "step": 1,
      "text": "Warm a large deep skillet or sauté pan over medium heat. Add the diced chorizo and cook until it releases its fat and begins to brown."
    },
    {
      "step": 2,
      "text": "Add the onion and cook for 10 minutes, stirring occasionally, until softened. Add the garlic, diced chicken, dried oregano, dried basil, garlic granules, smoked paprika, and chopped pepper; sauté for 5 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Stir in the rice and stock. Bring to a gentle simmer, then cook for 15 minutes, stirring occasionally and adding more stock from the measured amount as needed to keep the rice moist.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Fold in the peas and continue cooking until the rice is tender and the chicken reaches 165°F at the thickest pieces.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Rest briefly, then scatter over the parsley and serve with the garlic mayonnaise."
    }
  ],
