  "id": "chicken-continental",
  "name": "Chicken Continental",
  "subtitle": "Skillet chicken with creamy mushrooms and rice",
  "description": "Boneless chicken breasts simmer with mushrooms in a creamy parsley sauce, then finish with instant rice for a simple one-pan meal.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "fresh-mushrooms",
      "item": "fresh mushrooms",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "instant-rice",
      "item": "instant rice",
      "quantity": 1.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large covered skillet over medium heat. Add the chicken breasts and mushrooms, then cook for 5 minutes, turning the chicken once.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the condensed soup, water, parsley, salt, and pepper. Bring the sauce to a gentle simmer."
    },
    {
      "step": 3,
      "text": "Cover and simmer for 20 minutes, turning the chicken occasionally, until the thickest piece reaches 165°F.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Stir in the instant rice, cover, and cook until the rice is tender and the chicken remains at 165°F.",
      "timer_minutes": 10
    }
  ],
