{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "roasted-brussels-sprouts-and-kielbasa",
  "name": "Roasted Brussels Sprouts and Kielbasa",
  "subtitle": "Crisp-edged sprouts with smoky sliced sausage",
  "description": "Brussels sprouts roast until browned, then finish with smoky kielbasa for a simple one-pan meal.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "brussels-sprouts",
      "item": "Brussels sprouts",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "trimmed and halved"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "smoked-paprika",
      "item": "smoked paprika",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "sea-salt",
      "item": "sea salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "smoked-kielbasa-sausage",
      "item": "smoked kielbasa sausage",
      "quantity": 1,
      "unit": "pound",
      "preparation": "sliced, or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Toss the Brussels sprouts with half the olive oil, half the smoked paprika, the sea salt, and black pepper. Spread them in a single layer on a baking sheet."
    },
    {
      "step": 3,
      "text": "Roast for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Add the sliced kielbasa to the pan. Toss with the remaining olive oil and smoked paprika, then return everything to an even layer."
    },
    {
      "step": 5,
      "text": "Roast for 15 minutes more, until the sprouts are browned and tender and the sausage reaches 160°F internally.",
      "timer_minutes": 15
    }
  ],
