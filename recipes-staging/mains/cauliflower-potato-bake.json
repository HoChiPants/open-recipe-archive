  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and butter a baking dish. Cut the potatoes into bite-size pieces and prepare the cauliflower florets."
    },
    {
      "step": 2,
      "text": "Bring a pot of water to a simmer. Add the potatoes and cauliflower, cook for 5 minutes, then continue until just tender, about 5 minutes more. Drain well.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Melt the butter in a pan and sauté the garlic and onions until softened."
    },
    {
      "step": 4,
      "text": "Arrange the drained vegetables in the prepared dish and mix in the softened onions."
    },
    {
      "step": 5,
      "text": "Whisk the eggs, milk, cream, and nutmeg together, then pour the mixture over the vegetables. Sprinkle with the Gruyère."
    },
    {
      "step": 6,
      "text": "Bake until bubbling, golden, and fully set in the center, about 25 minutes. For food safety, confirm the center reaches 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Rest briefly, scatter with the chives, and serve."
    }
  ],
