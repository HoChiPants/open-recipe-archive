  "id": "cauliflower-potato-bake",
  "name": "Cauliflower & Potato Bake",
  "subtitle": "A creamy vegetable casserole with Gruyère and chives",
  "description": "Tender potatoes and cauliflower are combined with buttery onions, a nutmeg-scented egg custard, and grated Gruyère, then baked until golden and fully set.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
