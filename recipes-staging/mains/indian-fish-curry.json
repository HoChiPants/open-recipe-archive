  "instructions": [
    {
      "step": 1,
      "text": "Stir together the Dijon mustard, ground black pepper, half the salt, and cayenne pepper. Coat the fish fillets evenly and chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 3,
      "text": "Heat half the canola oil in an oven-safe skillet. Add the onion, garlic, ginger, and cashews; cook, stirring, for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the remaining black pepper and salt, cumin, coriander, sugar, turmeric, and remaining cayenne. Stir for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the tomato and vegetable broth, then arrange the marinated fish in the skillet and drizzle with the remaining oil."
    },
    {
      "step": 6,
      "text": "Bake until the fish is opaque and flakes easily, or reaches 145°F in the thickest part, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Garnish with the cilantro and serve hot."
    }
  ],
