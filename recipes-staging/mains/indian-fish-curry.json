  "id": "indian-fish-curry",
  "name": "Indian Fish Curry",
  "subtitle": "Spiced baked fish with a savory cashew sauce",
  "description": "White fish is briefly chilled with mustard and spices, then baked in a fragrant onion, ginger, garlic, cashew, tomato, and broth sauce.",
