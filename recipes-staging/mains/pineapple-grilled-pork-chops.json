  "id": "pineapple-grilled-pork-chops",
  "name": "Pineapple Grilled Pork Chops",
  "subtitle": "Sweet-savory grilled pork with pineapple",
  "description": "Pork chops marinated with pineapple, brown sugar, soy sauce, and garlic, then grilled and served with the fruit.",
  "meal_type": "main",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 4,
