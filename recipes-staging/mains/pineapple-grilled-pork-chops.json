  "ingredients": [
    {
      "ingredient_id": "pineapple-rings",
      "item": "pineapple rings",
      "quantity": 1,
      "unit": "can",
      "preparation": "8 ounce, juice drained and reserved"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
