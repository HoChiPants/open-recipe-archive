      "item": "ground black pepper",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the pineapple rings, brown sugar, soy sauce, and garlic powder in a shallow dish. Add the pork chops, turn to coat, and refrigerate.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Preheat the grill. Remove the pork chops from the marinade and season with the black pepper."
    },
    {
      "step": 3,
      "text": "Grill the pork chops and pineapple rings, turning as needed, until the pork reaches 145°F in the center.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Transfer the pork to a plate and let it rest for 3 minutes. Serve with the grilled pineapple rings.",
      "timer_minutes": 3
    }
  ],
