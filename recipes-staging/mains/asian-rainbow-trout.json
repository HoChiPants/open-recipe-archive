  "id": "asian-rainbow-trout",
  "name": "Asian Rainbow Trout",
  "subtitle": "Pan-cooked trout with ginger, garlic, and green onion",
  "description": "Rainbow trout fillets are seasoned with soy and sugar, then pan-cooked with aromatic ginger, garlic, and green onion.",
  "meal_type": "main",
  "cuisine": "Asian",
