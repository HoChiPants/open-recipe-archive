  "instructions": [
    {
      "step": 1,
      "text": "Coat the trout fillets with soy sauce. Mix the sugar with salt and pepper, then season the fish and let it set briefly."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet over medium heat. Add the green onions, garlic, and ginger; stir until golden brown."
    },
    {
      "step": 3,
      "text": "Add the trout and cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Turn the fillets and cook for 3 minutes more, until opaque and easily flaked or the center reaches 145°F.",
      "timer_minutes": 3
    }
  ],
