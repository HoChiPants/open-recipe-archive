  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pepper-jelly-pork",
  "name": "Pepper Jelly Pork",
  "subtitle": "Roasted pork tenderloin with a sweet, tangy pepper glaze",
  "description": "Pork tenderloin is seasoned, roasted, and finished with warmed pepper jelly and balsamic vinegar.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "chili-powder",
      "item": "chili powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "pork-tenderloin",
      "item": "pork tenderloin",
      "quantity": 1
    },
    {
      "ingredient_id": "hot-pepper-jelly",
      "item": "hot pepper jelly",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Whisk together the chili powder, freshly ground black pepper, ground cumin, salt, and hot pepper jelly."
    },
    {
      "step": 3,
      "text": "Prepare the pork tenderloin with the seasoning mixture and transfer it to a baking dish."
    },
    {
      "step": 4,
      "text": "Roast for 30 minutes, or until the thickest part reaches 145°F.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Warm the freshly ground black pepper, hot pepper jelly, and balsamic vinegar at 150°F for 2 minutes, until melted.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Coat the pork with the warmed mixture and bake for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Rest the pork for 5 minutes before slicing; whole-cut pork should rest at least 3 minutes after reaching 145°F.",
      "timer_minutes": 5
    }
  ],
