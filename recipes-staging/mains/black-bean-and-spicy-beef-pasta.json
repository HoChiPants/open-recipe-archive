  "instructions": [
    {
      "step": 1,
      "text": "Cook the pasta shells according to the package directions until just set. Drain, reserving a little cooking water if needed.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a large skillet. Add the spring onions and garlic, and cook until softened.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir in the black beans, roasted peppers, sweetcorn, taco seasoning, and chipotle paste. Add the leftover ragu and mix thoroughly.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Pour in enough reserved pasta water to loosen the mixture, then simmer until hot and cohesive.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Fold in the pasta and double cream. Stir until warmed through, then mix in the grated cheddar."
    },
    {
      "step": 6,
      "text": "Divide among bowls and finish with the parsley."
    }
  ],
