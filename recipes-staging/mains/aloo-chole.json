  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a skillet over medium heat. Cook the red onion for 7 minutes, stirring occasionally, until softened.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Add the potatoes and cook for 3 minutes, turning gently to coat them in the oil.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir in the garlic paste, ginger paste, ground coriander, ground cumin, ground turmeric, chilli powder, chopped ginger, and half of the coriander leaves."
    },
    {
      "step": 4,
      "text": "Add the chickpeas and tomato purée, stirring until evenly coated. Cook for 5 minutes, stirring occasionally, until hot.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the garam masala and remaining coriander leaves. Serve with the sliced green chilli and basmati rice, naan, or chapatis."
    }
  ],
