  "id": "asparagus-risotto",
  "name": "Asparagus Risotto",
  "subtitle": "Creamy rice with tender asparagus and Parmesan",
  "description": "A straightforward stovetop risotto made with asparagus, warm stock, and a finish of butter and finely grated cheese.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "bunch-asparagus-about-200g",
      "item": "bunch asparagus (about 200g)",
      "quantity": 1
    },
    {
      "ingredient_id": "vegetable-broth",
      "item": "vegetable stock",
      "quantity": 800,
      "unit": "ml"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 25,
      "unit": "g"
    },
    {
      "ingredient_id": "onion-finely-chopped",
      "item": "onion finely chopped",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "risotto-rice",
      "item": "risotto rice",
      "quantity": 175,
      "unit": "g"
    },
    {
      "ingredient_id": "white-wine-or-vermouth-optional",
      "item": "white wine or vermouth (optional)",
      "quantity": 100,
      "unit": "ml",
      "optional": true
    },
    {
      "ingredient_id": "parmesan-or-vegetarian-alternative",
      "item": "parmesan or vegetarian alternative",
      "quantity": 25,
      "unit": "g",
      "preparation": "finely grated"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Trim the asparagus and cut it into bite-size pieces. Warm the vegetable stock in a separate saucepan and keep it hot."
    },
    {
      "step": 2,
      "text": "Heat the butter and olive oil in a heavy saucepan over medium heat. Add the onion and cook until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the asparagus and cook for 2 minutes. Stir in the risotto rice and cook briefly until the grains are coated.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Pour in the optional wine or vermouth and stir until absorbed."
    },
    {
      "step": 5,
      "text": "Add the hot stock gradually, stirring often and allowing each addition to absorb before adding more. Continue for about 15 minutes, until the rice is tender and creamy.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Stir in the remaining asparagus and cook for 2 minutes, or until tender.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Remove from the heat and stir in the finely grated Parmesan or vegetarian alternative and butter. Serve once creamy and hot."
    }
  ],
