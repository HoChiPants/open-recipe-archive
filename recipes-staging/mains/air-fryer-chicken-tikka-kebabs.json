  "id": "air-fryer-chicken-tikka-kebabs",
  "name": "Air Fryer Chicken Tikka Kebabs",
  "subtitle": "Yogurt-marinated chicken with warm naan and chutney",
  "description": "Tender spiced chicken cooked in the air fryer and served with naan, coriander, yogurt, and chutney.",
  "meal_type": "main",
  "cuisine": "Indian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-breasts-about-600g",
      "item": "chicken breasts (about 600g)",
      "quantity": "3-4",
      "preparation": "cut into bite-size pieces"
    },
    {
      "ingredient_id": "natural-yogurt-plus-extra-to-serve-optional",
      "item": "natural yogurt plus extra to serve (optional)",
      "quantity": 150,
      "unit": "g",
      "optional": true
    },
    {
      "ingredient_id": "tikka-masala-curry-paste",
      "item": "tikka masala curry paste",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-cloves-crushed-or-finely-grated",
      "item": "garlic cloves crushed or finely grated",
      "quantity": 2
    },
    {
      "ingredient_id": "thumb-sized-piece-of-ginger-peeled-and-grated",
      "item": "thumb-sized piece of ginger peeled and grated"
    },
    {
      "ingredient_id": "naans-we-used-round-naans",
      "item": "naans (we used round naans)",
      "quantity": 2,
      "unit": "large"
    },
    {
