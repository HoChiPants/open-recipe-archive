      "item": "handful of coriander chopped"
    },
    {
      "ingredient_id": "your-choice-of-mango-chutney",
      "item": "your choice of mango chutney",
      "preparation": "lime pickle, diced cucumber or raita and crumbled bhaji"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the yogurt, tikka masala paste, garlic, and ginger in a bowl. Add the chicken and coat thoroughly. Marinate for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Preheat the air fryer to 400°F."
    },
    {
      "step": 3,
      "text": "Arrange the marinated chicken in the air-fryer basket in a single layer. Air-fry for about 15 minutes, turning once, until browned and the thickest pieces reach 165°F.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Warm the naans in the microwave according to their package directions."
    },
    {
      "step": 5,
      "text": "Serve the chicken with the warm naans, coriander, extra yogurt if using, and your choice of chutney or accompaniments."
    }
  ],
