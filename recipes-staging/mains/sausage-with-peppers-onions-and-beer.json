  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet over medium heat. Add the Italian sausage links and cook until browned and set, turning as needed. Use a food thermometer to confirm the sausage reaches 160°F, then transfer it to a plate."
    },
    {
      "step": 2,
      "text": "Pour the beer into the skillet. Add the red bell peppers, green bell peppers, red onions, garlic, and salt and pepper to taste."
    },
    {
      "step": 3,
      "text": "Stir in the tomato paste, fresh oregano, fresh cilantro, and hot sauce. Simmer the vegetables until tender."
    },
    {
      "step": 4,
      "text": "Cut the sausage links and add them to the skillet with the vegetables. Continue simmering until the sausage is cooked through and reaches 160°F."
    }
  ],
