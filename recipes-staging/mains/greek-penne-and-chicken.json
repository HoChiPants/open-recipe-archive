  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of salted water to a boil. Cook the penne and artichoke hearts until the pasta is tender, then drain."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat. Add the onion and garlic; cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the chicken and cook until golden and the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Add the drained pasta and artichokes, tomato, feta, parsley, lemon juice, and oregano to the skillet. Toss to combine and warm through.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Season with salt and black pepper to taste, then serve."
    }
  ],
