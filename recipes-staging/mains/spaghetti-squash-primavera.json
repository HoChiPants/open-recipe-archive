  "id": "spaghetti-squash-primavera",
  "name": "Spaghetti Squash Primavera",
  "subtitle": "Tender squash with sautéed vegetables and feta",
  "description": "Microwaved spaghetti squash is tossed with seasoned zucchini, peppers, tomatoes, and feta for a simple vegetarian main dish.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
