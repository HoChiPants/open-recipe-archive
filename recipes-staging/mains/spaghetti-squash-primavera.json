  "instructions": [
    {
      "step": 1,
      "text": "Place the whole spaghetti squash in a microwave-safe dish and microwave for 12 minutes, until tender. Let it cool until safe to handle.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Halve the squash, remove the seeds, and pull the flesh into strands. Set aside."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a large skillet. Add the onion and cook for 3 minutes, until tender.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the garlic and cook for 3 minutes, stirring frequently.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Stir in the zucchini, green bell pepper, Italian herb seasoning, and black pepper. Add the tomato and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Add the squash strands and feta. Toss gently until combined and heated through, then serve."
    }
  ],
