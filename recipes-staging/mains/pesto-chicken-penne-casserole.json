  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the seasoned bread crumbs, grated Parmesan cheese, olive oil, and 1 cup of the Italian cheese blend; set aside."
    },
    {
      "step": 3,
      "text": "Cook the penne in boiling water for 11 minutes, or until cooked through. Drain.",
      "timer_minutes": 11
    },
    {
      "step": 4,
      "text": "Combine the chicken, remaining Italian cheese blend, fresh baby spinach, tomatoes, Alfredo sauce, pesto sauce, milk, and grated Parmesan cheese. Stir in the drained penne."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to a baking dish and sprinkle with the breadcrumb mixture."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, until golden brown and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 45
    }
  ],
