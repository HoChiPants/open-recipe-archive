  "id": "pesto-chicken-penne-casserole",
  "name": "Pesto Chicken Penne Casserole",
  "subtitle": "Creamy baked penne with chicken, spinach, and pesto",
  "description": "Cooked penne is folded with chicken, spinach, tomatoes, Alfredo sauce, pesto, milk, and cheese, then baked beneath a crisp Parmesan topping.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
