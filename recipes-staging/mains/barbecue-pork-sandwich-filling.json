  "id": "barbecue-pork-sandwich-filling",
  "name": "Barbecue Pork Sandwich Filling",
  "subtitle": "Tender shredded pork with tangy barbecue sauce",
  "description": "Slow-cooked pork is shredded, coated in barbecue sauce, and baked briefly for a hearty sandwich filling.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 270
  },
  "ingredients": [
    {
      "ingredient_id": "beef-broth",
      "item": "beef broth",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "boneless-pork-ribs",
      "item": "boneless pork ribs",
      "quantity": 3,
      "unit": "pounds"
    },
    {
      "ingredient_id": "barbeque-sauce",
      "item": "barbeque sauce",
      "quantity": 1,
      "unit": "bottle",
      "preparation": "18 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the beef broth and boneless pork ribs to a slow cooker."
    },
    {
      "step": 2,
      "text": "Cook for 240 minutes, until the pork is tender and reaches 145°F internally; rest it for 3 minutes before shredding.",
      "timer_minutes": 240
    },
    {
      "step": 3,
      "text": "Shred the pork and transfer it to an oven-safe baking dish."
    },
    {
      "step": 4,
      "text": "Stir in the barbeque sauce until evenly coated."
    },
    {
      "step": 5,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 6,
      "text": "Bake the sauced pork until hot throughout.",
      "timer_minutes": 30
    }
  ],
