  "instructions": [
    {
      "step": 1,
      "text": "Heat the peanut oil in a large skillet or wok over high heat."
    },
    {
      "step": 2,
      "text": "Add the garlic, ginger, green onions, salt, and onions. Stir-fry until fragrant and beginning to soften.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the chicken and 3/4 cup of the chicken broth. Stir-fry until the chicken is opaque, then continue cooking until it reaches 165°F in the thickest pieces.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Stir in the cabbage, bell pepper, and sugar snap peas."
    },
    {
      "step": 5,
      "text": "Whisk the remaining chicken broth with the soy sauce, white sugar, and cornstarch until smooth. Add the mixture to the skillet."
    },
    {
      "step": 6,
      "text": "Stir-fry until the vegetables are crisp-tender and the sauce is thickened."
    },
    {
      "step": 7,
      "text": "Serve hot."
    }
  ],
