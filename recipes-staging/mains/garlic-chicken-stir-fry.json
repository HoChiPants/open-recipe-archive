  "id": "garlic-chicken-stir-fry",
  "name": "Garlic Chicken Stir-Fry",
  "subtitle": "Tender chicken and crisp vegetables in a savory ginger-garlic sauce.",
  "description": "A quick skillet meal combining sliced chicken, colorful vegetables, and a thickened soy-broth sauce.",
  "meal_type": "main",
