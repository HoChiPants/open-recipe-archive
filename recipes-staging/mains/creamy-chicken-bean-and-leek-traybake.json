  "id": "creamy-chicken-bean-and-leek-traybake",
  "name": "Creamy Chicken, Bean, and Leek Traybake",
  "subtitle": "Tender chicken with creamy cannellini beans and leeks",
  "description": "Chicken thighs roast with sautéed leeks, cannellini beans, mustard, and crème fraîche for a comforting one-pan dinner.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "chicken-thighs",
      "item": "chicken thighs",
      "quantity": 8
    },
    {
      "ingredient_id": "leeks-sliced-into-rounds",
      "item": "leeks sliced into rounds",
      "quantity": 3
    },
    {
      "ingredient_id": "garlic-cloves-crushed",
      "item": "garlic cloves crushed",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "x-400g-cans-cannellini-beans-drained-and-rinsed",
      "item": "x 400g cans cannellini beans drained and rinsed",
      "quantity": 2
    },
    {
      "ingredient_id": "hot-chicken-stock",
      "item": "hot chicken stock",
      "quantity": 500,
      "unit": "ml"
    },
    {
      "ingredient_id": "wholegrain-mustard",
      "item": "wholegrain mustard",
      "quantity": "1 1/2-2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "cre-me-frai-che",
      "item": "crème fraîche",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-zested",
      "item": "lemon zested",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "crusty-bread-to-serve",
      "item": "crusty bread to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Heat the olive oil in a large ovenproof skillet or roasting pan, then sauté the chicken thighs with some of the hot chicken stock for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Transfer the chicken to a plate. Sauté the leeks in the pan for 5 minutes, then add the crushed garlic and cook for 1 minute.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Return the chicken to the pan and stir in the cannellini beans and remaining hot chicken stock."
    },
    {
      "step": 4,
      "text": "Stir in the wholegrain mustard and crème fraîche, then cook the mixture for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Transfer the pan to the oven and roast for 15 minutes, until the chicken reaches 165°F in the thickest part.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Finish with the lemon zest and serve with crusty bread."
    }
  ],
