      "item": "can chopped tomatoes",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "rice-chopped-coriander-and-1-red-chilli",
      "item": "rice chopped coriander and 1 red chilli",
      "preparation": "cooked, finely sliced (optional), to serve",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to its instructions."
    },
    {
      "step": 2,
      "text": "Toss the sweet potatoes with the oil and air-fry for 15 minutes, until beginning to soften.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Add the chopped onion and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the ginger, garlic, curry paste, and chickpeas; cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Add the chopped tomatoes and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Continue cooking until the vegetables are tender and the curry is thick, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Serve with the cooked rice, coriander, and optional sliced red chilli."
    }
  ],
