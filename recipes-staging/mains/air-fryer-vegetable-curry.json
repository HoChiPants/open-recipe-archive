      "item": "curry paste",
      "quantity": "2-3",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "can-chickpeas-drained",
      "item": "can chickpeas drained",
      "quantity": 400,
      "unit": "g"
    },
    {
