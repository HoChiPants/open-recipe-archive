  "id": "air-fryer-vegetable-curry",
  "name": "Air Fryer Vegetable Curry",
  "subtitle": "A hearty curry with roasted sweet potatoes and chickpeas",
  "description": "Sweet potatoes, chickpeas, tomatoes, aromatics, and curry paste come together in a thick, warming curry served with rice.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-potatoes-around-2-medium",
      "item": "sweet potatoes (around 2 medium)",
      "quantity": 400,
      "unit": "g",
      "preparation": "roughly chopped"
    },
    {
      "ingredient_id": "vegetable-or-sunflower-oil",
      "item": "vegetable or sunflower oil",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "onion-chopped",
      "item": "onion chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "thumb-sized-piece-of-ginger-finely-grated",
      "item": "thumb-sized piece of ginger finely grated"
    },
    {
      "ingredient_id": "garlic-cloves-crushed-or-finely-grated",
      "item": "garlic cloves crushed or finely grated",
      "quantity": 2
    },
    {
