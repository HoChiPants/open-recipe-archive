  "instructions": [
    {
      "step": 1,
      "text": "Stir the olive oil, minced garlic, and sea salt together. Set aside."
    },
    {
      "step": 2,
      "text": "Arrange the sliced tomatoes in a single layer and let them stand for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 4,
      "text": "Place the pre-baked pizza crusts on baking sheets."
    },
    {
      "step": 5,
      "text": "Brush the crusts with the seasoned oil. Sprinkle with mozzarella, Fontina, Parmesan, and feta."
    },
    {
      "step": 6,
      "text": "Top with the tomatoes and basil, then add the remaining cheeses."
    },
    {
      "step": 7,
      "text": "Bake for 10 minutes, until the cheese is golden brown.",
      "timer_minutes": 10
    }
  ],
