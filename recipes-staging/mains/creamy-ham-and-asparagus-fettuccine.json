  "instructions": [
    {
      "step": 1,
      "text": "Cook the fettuccini in simmering water, stirring occasionally, until tender, about 10 minutes. Add the asparagus during the final 5 minutes, then drain and transfer the pasta and asparagus to a serving dish.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Preheat the heavy cream and butter together in a saucepan until hot and blended."
    },
    {
      "step": 3,
      "text": "Stir in the Parmesan, garlic powder, black pepper, and cayenne pepper until combined."
    },
    {
      "step": 4,
      "text": "Stir in the cooked diced ham, then toss the sauce with the pasta and asparagus until evenly combined."
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
  ],
