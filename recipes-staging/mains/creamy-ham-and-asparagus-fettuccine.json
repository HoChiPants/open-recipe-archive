  "id": "creamy-ham-and-asparagus-fettuccine",
  "name": "Creamy Ham and Asparagus Fettuccine",
  "subtitle": "Fettuccine with tender asparagus, ham, and Parmesan cream sauce",
  "description": "A quick pasta dinner combining asparagus and diced ham with a smooth, peppered cream sauce.",
  "meal_type": "main",
