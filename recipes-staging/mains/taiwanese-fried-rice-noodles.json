  "instructions": [
    {
      "step": 1,
      "text": "Combine the pork with the soy sauce, rice wine, white pepper, five-spice powder, and cornstarch. Set aside to marinate."
    },
    {
      "step": 2,
      "text": "Soak the dried mushrooms in water until softened, about 20 minutes. Drain and slice them.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Soak the rice vermicelli in the rice wine until softened, about 10 minutes, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Heat part of the divided oil in a wok or large skillet. Add the beaten eggs and cook until fully set; for a measured endpoint, cook to 160°F. Remove and slice."
    },
    {
      "step": 5,
      "text": "Heat another portion of the oil. Stir-fry the mushrooms, drained noodles, garlic, and dried shrimp briefly, then add the marinated pork and cook for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 6,
      "text": "Add the carrots and onion and stir-fry for 3 minutes. Add the cooked pork mixture, mushrooms, bean sprouts, and napa cabbage; add the remaining oil as needed and stir-fry until the vegetables are tender.",
      "timer_minutes": 3
    },
    {
      "step": 7,
      "text": "Check the pork with a food thermometer and continue cooking until it reaches 145°F. Rest it for 3 minutes before serving.",
      "timer_minutes": 3
    },
    {
      "step": 8,
      "text": "Season with salt to taste, top with the cilantro sprigs, and serve hot."
    }
  ],
