      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fresh-shrimp",
      "item": "fresh shrimp",
      "quantity": 1,
      "unit": "pound",
      "preparation": "peeled and deveined"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
