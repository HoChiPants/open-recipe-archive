  "id": "shrimp-and-vegetable-sheet-pan-dinner",
  "name": "Shrimp and Vegetable Sheet Pan Dinner",
  "subtitle": "Roasted vegetables finished with seasoned shrimp",
  "description": "A simple one-pan meal of colorful roasted vegetables and lemon-garlic shrimp.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
      "preparation": "coarsely chopped"
    },
    {
      "ingredient_id": "red-bell-pepper",
      "item": "red bell pepper",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fresh-mushrooms",
      "item": "fresh mushrooms",
      "quantity": 1,
      "unit": "cup",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
