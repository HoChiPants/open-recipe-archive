      "item": "garlic powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "On a sheet pan, combine the onion, bell pepper, mushrooms, and zucchini with the paprika, salt, pepper, and enough of the divided olive oil to coat. Spread the vegetables evenly."
    },
    {
      "step": 3,
      "text": "Roast the vegetables for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Toss the shrimp with the remaining olive oil, lemon zest, garlic powder, and a little of the roasted bell pepper mixture from the pan."
    },
    {
      "step": 5,
      "text": "Arrange the shrimp over the vegetables and bake until the shrimp are opaque and cooked through.",
      "timer_minutes": 7
    }
  ],
