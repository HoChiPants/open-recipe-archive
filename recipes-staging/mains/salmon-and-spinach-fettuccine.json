  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer, add the fettuccine, and cook for 13 minutes. Drain.",
      "timer_minutes": 13
    },
    {
      "step": 2,
      "text": "Preheat the butter and milk in a saucepan over medium heat, then whisk in the flour until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the Parmesan until melted and the sauce is smooth."
    },
    {
      "step": 4,
      "text": "Add the smoked salmon, spinach, capers, sun-dried tomatoes, and oregano. Stir for 3 minutes, until the spinach wilts and the salmon is heated through. If using raw salmon, cook it to 145°F and until opaque and easily flaked.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Toss the sauce with the drained fettuccine and serve."
    }
  ],
