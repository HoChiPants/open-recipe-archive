  "id": "crab-leek-and-cheddar-tart",
  "name": "Crab, Leek, and Cheddar Tart",
  "subtitle": "A savory tart with tender leeks, crab, and a set cream filling.",
  "description": "Bake a crisp pastry shell, fill it with softened leeks and crab folded into a creamy egg mixture, then finish with cheddar until the center is fully set.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 35,
    "cook_minutes": 65
  },
  "ingredients": [
    {
      "ingredient_id": "plain-flour-plus-extra-for-dusting",
      "item": "plain flour plus extra for dusting",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "cold-butter-cut-into-cubes",
      "item": "cold butter cut into cubes",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "egg-yolk",
      "item": "egg yolk",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 10,
      "unit": "g"
    },
    {
      "ingredient_id": "leeks-about-500g",
      "item": "leeks (about 500g)",
      "quantity": 2,
      "preparation": "sliced into 2cm rings"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "cre-me-frai-che",
      "item": "crème fraîche",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "egg-plus-3-egg-yolks",
      "item": "egg plus 3 egg yolks",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "white-crabmeat",
      "item": "white crabmeat",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "cheddar-grated",
      "item": "cheddar grated",
      "quantity": 35,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Rub the flour and cold cubed butter together until crumbly. Mix in the egg yolk, then bring the mixture together into a dough."
    },
    {
      "step": 2,
      "text": "Dust the work surface with flour, roll out the dough, and use it to line a tart tin. Chill until firm.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Preheat the oven and cook the leeks gently in the butter until tender, about 15 minutes. Let them cool.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Line the pastry shell with parchment and baking weights, then blind-bake until lightly set.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Whisk the cream, crème fraîche, and egg mixture together. Fold in the crabmeat and grated cheddar."
    },
    {
      "step": 6,
      "text": "Arrange the cooled leeks in the pastry shell and pour in the crab custard."
    },
    {
      "step": 7,
      "text": "Bake until the filling is fully set in the center and reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 8,
      "text": "Cool the tart briefly before slicing and serving.",
      "timer_minutes": 15
    }
  ],
