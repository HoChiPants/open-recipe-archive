  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot. Add the onion and cook for 5 minutes. Stir in the first garlic portion and cook for 5 minutes more.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the stewed tomatoes, tomato paste, first portions of basil and parsley, salt, and the measured ground black pepper. Simmer the sauce for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Cook the lasagna noodles in simmering water for 9 minutes, then drain.",
      "timer_minutes": 9
    },
    {
      "step": 4,
      "text": "Preheat the oven to 400°F. Crumble the tofu and combine it with the second garlic portion, remaining basil and parsley, remaining salt, and ground black pepper to taste. Fold in the drained spinach."
    },
    {
      "step": 5,
      "text": "Spread some sauce in a baking dish. Layer noodles, tofu-spinach filling, and sauce, repeating until the ingredients are used. Finish with sauce over the top."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until heated through and bubbling. Serve hot.",
      "timer_minutes": 30
    }
  ],
