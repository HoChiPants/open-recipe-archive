  "instructions": [
    {
      "step": 1,
      "text": "Heat half the olive oil in a large skillet over medium heat. Cook the onion until golden brown, then transfer it to a plate."
    },
    {
      "step": 2,
      "text": "Season the pork chops with salt, black pepper, and garlic powder. Heat the remaining olive oil in the skillet and cook the chops until a thermometer inserted into the thickest part reads 145°F."
    },
    {
      "step": 3,
      "text": "Transfer the chops to a plate and let them rest for at least 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the onion, tomatoes, garlic, and dried basil to the skillet. Cook, stirring occasionally, until the tomatoes are tender.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Season the tomato mixture with salt and black pepper, then stir in the balsamic vinegar. Return the chops to the skillet and top with the feta."
    },
    {
      "step": 6,
      "text": "Serve with the lemon wedges."
    }
  ],
