  "id": "cod-with-butter-bean-colcannon",
  "name": "Cod with Butter Bean Colcannon",
  "subtitle": "Tender cod with creamy beans, cabbage, and pancetta",
  "description": "Bake cod with lemon, thyme, and butter, then serve it over a warm cabbage and butter-bean mash finished with cream.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "skinless-cod-fillets",
      "item": "skinless cod fillets",
      "quantity": 2
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 25,
      "unit": "g"
    },
    {
      "ingredient_id": "thyme-sprigs-leaves-picked",
      "item": "thyme sprigs leaves picked",
      "quantity": 6
    },
    {
      "ingredient_id": "lemon-sliced",
      "item": "lemon sliced",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "pack-smoked-diced-pancetta",
      "item": "pack smoked diced pancetta",
      "quantity": 77,
      "unit": "g"
    },
    {
      "ingredient_id": "savoy-cabbage-finely-shredded",
      "item": "Savoy cabbage finely shredded",
      "quantity": "1/2",
      "unit": "small"
    },
    {
      "ingredient_id": "can-butter-beans-drained-and-rinsed",
      "item": "can butter beans drained and rinsed",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "single-cream",
      "item": "single cream",
      "quantity": 50,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Arrange the cod in a baking dish with the butter, thyme leaves, and lemon slices. Add the butter beans around the fish."
    },
    {
      "step": 2,
      "text": "Bake for about 10 minutes, until the cod reaches 145°F internally or is opaque and flakes easily.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Meanwhile, cook the pancetta in a skillet over medium-high heat until browned. Add the cabbage, remaining butter, and butter beans, then cook until the cabbage softens and the beans are hot.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Mash the bean mixture lightly, whisk the cream until smooth, and fold it into the colcannon."
    },
    {
      "step": 5,
      "text": "Divide the colcannon between plates and top with the cod. Serve hot."
    }
  ],
