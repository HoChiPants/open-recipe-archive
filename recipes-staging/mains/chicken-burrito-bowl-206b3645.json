  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and arrange the sweet potato wedges and tortilla strips on a baking tray. Toss with some of the oil and bake until the sweet potato is tender and the tortilla strips are crisp, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Heat the remaining oil in a skillet. Add the garlic and onion and cook until softened."
    },
    {
      "step": 3,
      "text": "Add the chicken and cook, turning as needed, until the thickest piece reaches 165°F and is cooked through, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the vinegar, honey, and black beans; warm for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Add the rice and stir until heated through, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Combine the onion, tomato, lime zest and juice, and coriander in a bowl. Add hot sauce if using."
    },
    {
      "step": 7,
      "text": "Divide the rice and bean mixture between bowls. Top with chicken, sweet potato, avocado, and tortilla strips. Serve with the lime wedges and hot sauce, if desired."
    }
  ],
