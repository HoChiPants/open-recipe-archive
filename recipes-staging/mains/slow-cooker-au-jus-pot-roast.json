  "id": "slow-cooker-au-jus-pot-roast",
  "name": "Slow Cooker Au Jus Pot Roast",
  "subtitle": "Tender beef roast with a savory coffee pan sauce",
  "description": "Browned chuck roast cooks slowly with bouillon, coffee, tomato sauce, Worcestershire, and oregano until tender, then rests before slicing.",
  "meal_type": "main",
  "cuisine": "French",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 500
  },
  "ingredients": [
    {
      "ingredient_id": "4-pound-boneless-beef-chuck-roast",
      "item": "(4 pound) boneless beef chuck roast",
      "quantity": 1
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "montreal-style-steak-seasoning",
      "item": "Montreal-style steak seasoning",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cube-beef-bouillon",
      "item": "cube beef bouillon",
      "quantity": 1
    },
    {
      "ingredient_id": "hot-strong-black-coffee",
      "item": "hot strong black coffee",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "tomato-sauce",
      "item": "tomato sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Rub the roast with Montreal-style steak seasoning."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet, then brown the roast on all sides."
    },
    {
      "step": 3,
      "text": "Dissolve the beef bouillon in the hot coffee.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Place the browned roast in a slow cooker and pour in the bouillon coffee."
    },
    {
      "step": 5,
      "text": "Stir together the Worcestershire sauce, tomato sauce, and oregano; pour the mixture over the roast."
    },
    {
      "step": 6,
      "text": "Cover and cook on low until the roast is tender, about 8 hours 20 minutes. Check the center with a food thermometer; whole-cut beef should reach at least 145°F.",
      "timer_minutes": 500
    },
    {
      "step": 7,
      "text": "Transfer the roast to a plate and let it rest for 3 minutes before slicing. Serve with the cooking liquid.",
      "timer_minutes": 3
    }
  ],
