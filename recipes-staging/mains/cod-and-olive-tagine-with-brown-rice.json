  "instructions": [
    {
      "step": 1,
      "text": "Heat the rapeseed oil in a large, lidded pan. Add the onions, swede, carrots, lemon peel, garlic, cinnamon, cumin seeds, and ground coriander; cook until the vegetables begin to soften.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Mix in the chopped tomatoes, tomato purée, stock, and olives. Bring to a gentle simmer, cover, and cook until the vegetables are tender and the sauce has thickened.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Cook the brown rice according to its package directions. Keep it covered off the heat until serving, then fluff with some of the chopped coriander."
    },
    {
      "step": 4,
      "text": "Nestle the cod into the sauce, cover, and cook until opaque and easily flaked, or until the thickest part reaches 145°F.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Serve the cod and sauce with the brown rice, scattering the remaining chopped coriander over the top."
    }
  ],
