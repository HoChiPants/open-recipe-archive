  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 450°F. Toss the squash, zucchini, carrot, bell pepper, tomatoes, green beans, asparagus, half of the olive oil, Italian seasoning, lemon juice, salt, pepper, and lemon zest together until coated."
    },
    {
      "step": 2,
      "text": "Spread the vegetables on a baking sheet and roast until tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Bring a pot of salted water to a simmer. Add the penne and cook until tender, about 12 minutes. Drain.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Heat the remaining olive oil and the butter in a large skillet. Add the onion and garlic and cook until tender, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Add the drained pasta, roasted vegetables, lemon juice, onion mixture, lemon zest, basil, parsley, and balsamic vinegar. Cook and toss until hot and combined, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir in the Romano cheese and serve hot."
    }
  ],
