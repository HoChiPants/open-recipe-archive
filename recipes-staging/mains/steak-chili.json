  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a heavy pot over medium-high heat. Add the steak and cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the onions, garlic, green chile pepper, chili powder, cumin, and cayenne. Cook for 5 minutes, stirring to coat the steak and soften the aromatics.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pour in the tomatoes and add the kidney beans. Stir well and bring the mixture to a simmer."
    },
    {
      "step": 4,
      "text": "Simmer uncovered for 30 minutes, stirring occasionally. Check the largest steak cube with a food thermometer; beef should reach 145°F, then rest for 3 minutes before serving.",
      "timer_minutes": 30
    }
  ],
