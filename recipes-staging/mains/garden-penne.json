  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the penne in boiling water for 11 minutes, or until cooked through. Drain and set aside.",
      "timer_minutes": 11
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a large skillet. Add the zucchini, yellow squash, red onion, bell peppers, and garlic; cook until tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the drained tomatoes, pasta sauce, and corn. Add the crushed red pepper and black pepper, then simmer for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Combine the cooked penne with the vegetable sauce and transfer the mixture to a baking dish."
    },
    {
      "step": 6,
      "text": "Sprinkle with mozzarella and bake until the cheese is melted, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
