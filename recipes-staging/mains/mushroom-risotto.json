  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large saucepan over medium heat. Add the onions and cook until softened."
    },
    {
      "step": 2,
      "text": "Stir in the garlic, parsley, celery, and salt and pepper to taste. Cook briefly, then add the mushrooms and sauté until tender."
    },
    {
      "step": 3,
      "text": "Whisk together the whole milk, heavy cream, and rice, then add the mixture to the saucepan."
    },
    {
      "step": 4,
      "text": "Add the vegetable stock gradually, stirring as the rice absorbs each addition, until the rice is creamy and tender.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Stir in the butter and grated Parmesan cheese. Serve hot."
    }
  ],
