  "id": "mushroom-risotto",
  "name": "Mushroom Risotto",
  "subtitle": "Creamy rice with tender mushrooms and Parmesan",
  "description": "A savory stovetop risotto finished with milk, cream, butter, and Parmesan for a rich, smooth texture.",
  "meal_type": "main",
