  "instructions": [
    {
      "step": 1,
      "text": "Rinse the brown basmati rice. Put it in a saucepan with the 1/4 teaspoon turmeric, cardamom seeds, and enough water to cook it; bring to a boil, then simmer for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a large pan. Add the onion, ginger, and garlic and cook until softened. Stir in the cumin seeds, ground coriander, garam masala, and 1/2 teaspoon turmeric."
    },
    {
      "step": 3,
      "text": "Add the chicken pieces and stir until coated. Add the chopped tomatoes and tomato purée, then simmer until the chicken reaches 165°F internally."
    },
    {
      "step": 4,
      "text": "Stir in the chopped spinach and cook until wilted and the curry is hot throughout.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Reduce the heat, stir in the yogurt, and warm gently for 1 minute without boiling.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Drain the rice, then serve it with the chicken saag."
    }
  ],
