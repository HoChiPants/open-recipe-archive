  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "bacon-wrapped-stuffed-chicken-tenders",
  "name": "Bacon-Wrapped Stuffed Chicken Tenders",
  "subtitle": "Creamy jalapeño filling with a sweet pepper-jelly finish",
  "description": "Chicken tenders are filled with a seasoned cream cheese mixture, wrapped in bacon, and baked until cooked through.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "finely-chopped-green-onion",
      "item": "finely chopped green onion",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "jalapeno-pepper",
      "item": "jalapeno pepper",
      "quantity": 1,
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "chicken-tenders",
      "item": "chicken tenders",
      "quantity": 8
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 8
    },
    {
      "ingredient_id": "toothpicks",
      "item": "toothpicks",
      "quantity": 8
    },
    {
      "ingredient_id": "pepper-jelly",
      "item": "pepper jelly",
      "quantity": 6,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Lightly grease or line a baking dish or sheet."
    },
    {
      "step": 2,
      "text": "Stir the softened cream cheese, green onion, jalapeño, salt, black pepper, and pepper jelly together until evenly combined."
    },
    {
      "step": 3,
      "text": "Flatten or gently shape each chicken tender, place filling along the center, and fold the chicken around it."
    },
    {
      "step": 4,
      "text": "Cut the bacon slices as needed to fit, wrap one around each filled tender, and secure with a toothpick."
    },
    {
      "step": 5,
      "text": "Arrange the chicken bombs in the prepared dish with the bacon seams tucked underneath. Bake for 35 minutes, until the chicken reaches 165°F at the thickest point.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Let stand briefly, then remove the toothpicks before serving."
    }
  ],
