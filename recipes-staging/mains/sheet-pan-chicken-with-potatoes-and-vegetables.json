  "id": "sheet-pan-chicken-with-potatoes-and-vegetables",
  "name": "Sheet Pan Chicken with Potatoes and Vegetables",
  "subtitle": "Ranch-coated chicken with roasted potatoes and carrots",
  "description": "Chicken breasts, potatoes, and carrots roast together on one pan for a straightforward family dinner.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 28
  },
  "ingredients": [
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ranch-dressing-mix",
      "item": "ranch dressing mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1 ounce"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 2,
      "unit": "large",
      "preparation": "boneless chicken breasts, halved lengthwise"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "red-potatoes",
      "item": "red potatoes",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "halved or quartered if large"
    },
    {
      "ingredient_id": "baby-carrots",
      "item": "baby carrots",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the mayonnaise and ranch dressing mix together in a bowl."
    },
    {
      "step": 2,
      "text": "Heat the oven to 400°F. Oil a sheet pan, arrange the potatoes and carrots on it, and season with salt and pepper."
    },
    {
      "step": 3,
      "text": "Spread the mayonnaise mixture over the chicken, then coat the chicken with the bread crumbs. Place the chicken on the pan with the vegetables."
    },
    {
      "step": 4,
      "text": "Bake until the chicken reaches 165°F at the thickest point and the vegetables are tender.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Transfer the pan to the grill and cook for 5 minutes to finish.",
      "timer_minutes": 5
    }
  ],
