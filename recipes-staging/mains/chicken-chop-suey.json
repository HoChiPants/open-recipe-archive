  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a wok or large skillet over high heat."
    },
    {
      "step": 2,
      "text": "Toss the sliced chicken with the chicken powder or salt and the cornflour mixture."
    },
    {
      "step": 3,
      "text": "Stir-fry the onion and garlic until fragrant and lightly softened."
    },
    {
      "step": 4,
      "text": "Add the chicken, carrot, soy sauce, sugar, white pepper, and spring onions. Stir-fry until the chicken is cooked through and reaches 165°F internally."
    },
    {
      "step": 5,
      "text": "Add the beansprouts and remaining cornflour mixture. Stir-fry until the sauce thickens and the vegetables are hot.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Transfer the stir-fry to a serving dish."
    },
    {
      "step": 7,
      "text": "Warm the soy sauce and sesame oil in the wok until thickened, then spoon over the stir-fry."
    },
    {
      "step": 8,
      "text": "Serve with steamed white rice or fried noodles."
    }
  ],
