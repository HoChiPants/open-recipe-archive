  "instructions": [
    {
      "step": 1,
      "text": "Whisk the red wine vinegar, red wine, garlic, pepper, salt, cloves, bay leaves, and thyme in a nonreactive container."
    },
    {
      "step": 2,
      "text": "Add the pork and turn to coat. Cover and refrigerate for 48 hours.",
      "timer_minutes": 2880
    },
    {
      "step": 3,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 4,
      "text": "Transfer the pork and marinade to a baking dish and bake for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Drain the pork and discard the marinade."
    },
    {
      "step": 6,
      "text": "Heat the vegetable oil in a skillet over medium-high heat. Add the pork and cook, stirring occasionally, for 15 minutes, until browned and the center reaches 145°F.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Rest the pork for 3 minutes, then serve.",
      "timer_minutes": 3
    }
  ],
