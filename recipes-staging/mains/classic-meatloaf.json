  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Combine the carrot, celery, onion, bell pepper, mushrooms, garlic, black pepper, and cayenne pepper in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the ground chuck, Worcestershire sauce, beaten egg, Italian herbs, salt, and Sriracha. Mix until evenly combined, then fold in the breadcrumbs."
    },
    {
      "step": 3,
      "text": "Shape the mixture into a loaf and place it in a baking dish or loaf pan."
    },
    {
      "step": 4,
      "text": "Bake for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir together the brown sugar, ketchup, Dijon mustard, and Sriracha to make the glaze. Spread it over the meatloaf."
    },
    {
      "step": 6,
      "text": "Continue baking for about 45 minutes, until the center reaches 160°F on a food thermometer.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Rest briefly, then slice and serve."
    }
  ],
