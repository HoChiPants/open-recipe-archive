  "id": "honey-glazed-chicken",
  "name": "Honey Glazed Chicken",
  "subtitle": "Tender chicken in a sweet, savory glaze",
  "description": "Bite-size chicken breast pieces are cooked in olive oil and finished with a honey-soy glaze with a mild chili kick.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 2,
      "preparation": "boneless chicken breast halves, cut into bite-size pieces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the honey, soy sauce, and red pepper flakes together; set aside."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet over medium-high heat. Add the chicken and stir-cook for about 5 minutes, until nearly cooked through.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pour in the honey mixture and stir for about 5 minutes, until the glaze thickens and the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Serve hot."
    }
  ],
