  "instructions": [
    {
      "step": 1,
      "text": "Combine the soy sauce, bourbon, brown sugar, and halved garlic cloves in a baking dish or other nonreactive container."
    },
    {
      "step": 2,
      "text": "Add the pork tenderloin and turn to coat. Cover and refrigerate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Heat the oven to 325°F."
    },
    {
      "step": 4,
      "text": "Bake the marinated pork for about 45 minutes, or until a thermometer inserted in the thickest part registers 145°F.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Transfer the pork to a cutting board and let it rest for 3 minutes before slicing.",
      "timer_minutes": 3
    }
  ],
