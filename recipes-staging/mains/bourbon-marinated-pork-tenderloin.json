  "id": "bourbon-marinated-pork-tenderloin",
  "name": "Bourbon-Marinated Pork Tenderloin",
  "subtitle": "Tender pork with a savory-sweet bourbon marinade",
  "description": "Pork tenderloin is marinated with soy sauce, bourbon, brown sugar, and garlic, then baked until tender.",
  "meal_type": "main",
  "cuisine": "American",
