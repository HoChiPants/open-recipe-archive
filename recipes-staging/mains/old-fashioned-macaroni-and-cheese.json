      "unit": "pound",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Prepare the elbow macaroni according to its package directions, then drain."
    },
    {
      "step": 3,
      "text": "Melt the butter in a saucepan. Whisk in the flour, then gradually stir in the milk until smooth and thickened."
    },
    {
      "step": 4,
      "text": "Arrange the macaroni in a baking dish, layering it with the minced onion, salt and pepper, processed cheese food, Cheddar, and Swiss cheese."
    },
    {
      "step": 5,
      "text": "Pour the milk sauce over the layers and dot with the remaining butter. Season with additional salt and pepper to taste."
    },
    {
      "step": 6,
      "text": "Bake at 350°F until hot and set.",
      "timer_minutes": 45
    }
  ],
