  "id": "old-fashioned-macaroni-and-cheese",
  "name": "Old-Fashioned Macaroni and Cheese",
  "subtitle": "Creamy baked macaroni with three cheeses",
  "description": "Cooked macaroni is layered with onion, seasoned cheese, and a simple milk-based sauce, then baked until hot and set.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 7,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "uncooked-elbow-macaroni",
      "item": "uncooked elbow macaroni",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
