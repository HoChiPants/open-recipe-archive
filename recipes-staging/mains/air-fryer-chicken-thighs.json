  "id": "air-fryer-chicken-thighs",
  "name": "Air Fryer Chicken Thighs",
  "subtitle": "Herb-seasoned chicken with crisp, browned skin",
  "description": "Bone-in chicken thighs coated with paprika, herbs, and olive oil, then air-fried until fully cooked.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 2,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "mixed-herbs",
      "item": "mixed herbs",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "garlic-granules",
      "item": "garlic granules (optional)",
      "quantity": "1/2",
      "unit": "tsp",
      "optional": true
    },
    {
      "ingredient_id": "chicken-thighs-bone-in",
      "item": "chicken thighs bone in",
      "quantity": 4
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the paprika, mixed herbs, and optional garlic granules."
    },
    {
      "step": 2,
      "text": "Coat the bone-in chicken thighs with the olive oil, then rub them evenly with the spice mixture."
    },
    {
      "step": 3,
      "text": "Air-fry for 10 minutes. Turn the thighs and cook for 15 minutes more, or until cooked through and the thickest part reaches 165°F on a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Serve hot."
    }
  ],
