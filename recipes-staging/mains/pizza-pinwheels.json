  "id": "pizza-pinwheels",
  "name": "Pizza Pinwheels",
  "subtitle": "Crescent dough spirals with pepperoni and mozzarella",
  "description": "Roll crescent dough around pepperoni and mozzarella, bake until golden, and serve with warm pizza sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "refrigerated-crescent-roll-dough",
      "item": "refrigerated crescent roll dough",
      "quantity": 1,
      "unit": "can",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "slices-pepperoni",
      "item": "slices pepperoni",
      "quantity": 24
    },
    {
      "ingredient_id": "pizza-sauce",
      "item": "pizza sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Transfer the crescent roll dough to a work surface and shape it into an even rectangle."
    },
    {
      "step": 2,
      "text": "Arrange the pepperoni over the dough and sprinkle with the shredded mozzarella."
    },
    {
      "step": 3,
      "text": "Roll the dough into a log, then cut it into 8 even pinwheels."
    },
    {
      "step": 4,
      "text": "Place the pinwheels on a baking sheet and bake for 14 minutes, or until golden brown.",
      "timer_minutes": 14
    },
    {
      "step": 5,
      "text": "Serve the pinwheels with pizza sauce."
    }
  ],
