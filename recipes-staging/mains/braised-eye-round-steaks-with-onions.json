      "item": "fresh parsley",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a large heavy skillet over medium heat and add the vegetable oil. Add the sliced onions and cook, stirring, until lightly browned.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Transfer the onions to a plate. Season the steaks with seasoned salt and dried thyme, then coat them evenly with flour."
    },
    {
      "step": 3,
      "text": "Heat the skillet again, add the coated steaks, and brown them for about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Return the onions to the skillet. Add the Burgundy wine and beef consomme, and simmer the liquid briefly.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Cover and braise the steaks with the onions for 60 minutes, until tender and the thickest steak reaches 145°F. Remove from heat and rest the steaks for 3 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Garnish with chopped fresh parsley and serve with the braising onions and sauce."
    }
  ],
