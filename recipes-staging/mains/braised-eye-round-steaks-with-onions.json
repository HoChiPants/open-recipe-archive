  "id": "braised-eye-round-steaks-with-onions",
  "name": "Braised Eye Round Steaks with Onions",
  "subtitle": "Tender beef simmered with onions, wine, and thyme",
  "description": "Flour-coated eye round steaks are browned, then braised with lightly browned onions, Burgundy wine, and beef consomme until tender. Finish with parsley.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
