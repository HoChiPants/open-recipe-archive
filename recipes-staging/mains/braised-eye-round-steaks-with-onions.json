    "prep_minutes": 10,
    "cook_minutes": 80
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "unit": "large",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "4-ounce-beef-eye-of-round-steaks",
      "item": "(4 ounce) beef eye of round steaks",
      "quantity": 12
    },
    {
