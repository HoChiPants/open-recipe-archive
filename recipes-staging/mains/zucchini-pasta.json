  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of salted water to a boil. Cook the rotini for 10 minutes, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet. Add the garlic, red pepper flakes, and salt and pepper to taste; cook briefly until fragrant."
    },
    {
      "step": 3,
      "text": "Add the zucchini and parsley. Cook for 3 minutes, until the zucchini is tender.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the drained pasta and toss until combined. Stir in the Parmesan, then adjust the red pepper flakes and salt and pepper to taste."
    }
