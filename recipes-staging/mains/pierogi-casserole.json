  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Simmer the potatoes in water until tender, then drain and transfer to a bowl."
    },
    {
      "step": 3,
      "text": "Mash the potatoes with the milk and melted butter; season with salt and pepper."
    },
    {
      "step": 4,
      "text": "Cook the bacon, onion, and garlic with butter over medium heat for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Cook the lasagna noodles according to their package directions and drain."
    },
    {
      "step": 6,
      "text": "Layer the noodles, potato mixture, bacon mixture, and cheddar in a baking dish, repeating as needed and ending with cheese."
    },
    {
      "step": 7,
      "text": "Bake for 45 minutes, until the cheese is melted and the casserole reaches 165°F in the center.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Whisk the sour cream with the chives and serve with the hot casserole."
    }
  ],
