  "id": "pierogi-casserole",
  "name": "Pierogi Casserole",
  "subtitle": "Layered potatoes, noodles, bacon, and cheddar",
  "description": "A hearty baked casserole combining creamy mashed potatoes, savory bacon and onion, lasagna noodles, and melted cheddar, finished with chive sour cream.",
  "meal_type": "main",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 45
  },
  "ingredients": [
