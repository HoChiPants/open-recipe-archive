{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pork-chops-and-sauerkraut",
  "name": "Pork Chops and Sauerkraut",
  "subtitle": "Tender pork with tangy sauerkraut and apple",
  "description": "Pan-seared pork chops are finished with sauerkraut, onion, garlic, apple juice, and caraway for a savory one-pan meal.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "3-4-inch-thick-pork-chops",
      "item": "(3/4 inch) thick pork chops",
      "quantity": 4
    },
    {
      "ingredient_id": "sauerkraut",
      "item": "sauerkraut",
      "quantity": 16,
      "unit": "ounces"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "apple-juice",
      "item": "apple juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "caraway-seed",
      "item": "caraway seed",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Heat the vegetable oil in an ovenproof skillet over medium-high heat."
    },
    {
      "step": 2,
      "text": "Season the pork chops with salt and pepper, then sear them in the hot oil for 4 minutes, turning once.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Add the sauerkraut, onion, apple juice, garlic, and caraway seed around the pork chops. Cover the skillet."
    },
    {
      "step": 4,
      "text": "Bake for 20 minutes, or until a thermometer inserted into the thickest part of each chop reaches 145°F. Rest the pork for 3 minutes before serving.",
      "timer_minutes": 20
    }
  ],
