  "id": "antipasti-salmon",
  "name": "Antipasti Salmon",
  "subtitle": "Salmon with herbed antipasti butter",
  "description": "A salmon side topped with a savory butter mixture, olives, capers, tomatoes, and artichokes, then cooked until flaky.",
