  "instructions": [
    {
      "step": 1,
      "text": "Mix the sundried tomatoes, chopped basil, chopped dill, capers, garlic, lemon zest, and softened butter until combined."
    },
    {
      "step": 2,
      "text": "Place the salmon skin-side down and spread the flavored butter over the surface. Make shallow cuts across the salmon and tuck in or scatter the lemon slices, olives, and artichoke hearts."
    },
    {
      "step": 3,
      "text": "Preheat the grill. Cook the salmon for 30 minutes, then grill for 15 minutes until cooked through; the thickest part should reach 145°F or be opaque and easily flaked.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Rest briefly, then serve with the whole basil leaves and dill fronds."
    }
  ],
