  "instructions": [
    {
      "step": 1,
      "text": "Whisk the yogurt, lemon juice, white vinegar, crushed garlic, salt, smoked paprika, cumin, and oregano in a bowl. Stir in the 1/4 cup canola oil."
    },
    {
      "step": 2,
      "text": "Add the sliced chicken and toss until evenly coated. Cover and refrigerate for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Heat a large skillet over medium-high heat. Add the remaining canola oil as needed."
    },
    {
      "step": 4,
      "text": "Cook the chicken in batches for about 5 minutes, turning as needed, until tender and the thickest pieces reach 165°F.",
      "timer_minutes": 5
    }
  ],
