  "instructions": [
    {
      "step": 1,
      "text": "Place the pork on a work surface and make successive cuts through the roast to open it into one thick, flat piece."
    },
    {
      "step": 2,
      "text": "Combine olive oil, half the salt, pepper, sage, rosemary, orange zest, garlic, fennel seeds, and red pepper flakes. Spread the mixture over the pork, roll the roast tightly, and secure its shape. Season the outside with the remaining salt."
    },
    {
      "step": 3,
      "text": "Cover and refrigerate the rolled roast for 8 hours so the shape and seasoning set.",
      "timer_minutes": 480
    },
    {
      "step": 4,
      "text": "Heat the oven to 450°F. Transfer the pork to a roasting pan, coat the surface with olive oil, and roast for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Reduce the oven to 250°F and continue roasting until the center reaches 145°F. Remove the pork and let it rest for at least 3 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "While the pork rests, combine anchovy, red pepper flakes, white wine vinegar, and parsley with the pan juices or remaining seasoned oil to make a loose sauce."
    },
    {
      "step": 7,
      "text": "Slice the rested pork and serve with the parsley sauce."
    }
  ],
