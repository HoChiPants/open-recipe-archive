  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Cook the ziti according to the package directions for 8 minutes, then drain.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Cook the onion and lean ground turkey together for 7 minutes, breaking up the meat, until the turkey reaches 165°F on a food thermometer.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Stir in the spaghetti sauce and carrot. Simmer for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Combine the cooked ziti, sauce mixture, provolone, sour cream, mozzarella, and Parmesan in the prepared dish. Arrange the cheeses as needed for even coverage."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until the casserole is hot and the cheese is melted.",
      "timer_minutes": 30
    }
  ],
