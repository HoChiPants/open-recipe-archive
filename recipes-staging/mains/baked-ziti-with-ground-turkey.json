  "id": "baked-ziti-with-ground-turkey",
  "name": "Baked Ziti with Ground Turkey",
  "subtitle": "A hearty layered pasta casserole with savory turkey and melted cheese",
  "description": "Tender ziti is combined with seasoned turkey sauce, sour cream, and layered cheeses, then baked until bubbling and melted.",
  "meal_type": "main",
