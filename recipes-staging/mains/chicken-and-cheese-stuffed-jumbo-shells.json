  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Bring salted water to a simmer, add the shells, and cook for 10 minutes. Drain and set aside to cool slightly.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Cook the cubed chicken and chopped onion until the chicken is no longer pink. Let cool briefly."
    },
    {
      "step": 4,
      "text": "Combine the chicken mixture with the egg, breadcrumbs, oregano, basil, salt and pepper, and half of each shredded cheese."
    },
    {
      "step": 5,
      "text": "Spread the tomato sauce in a baking dish. Fill the shells with the chicken mixture and arrange them in the dish."
    },
    {
      "step": 6,
      "text": "Cover the shells with the remaining mozzarella and Cheddar, then bake for 45 minutes, until lightly browned and the filling reaches 165°F.",
      "timer_minutes": 45
    }
  ],
