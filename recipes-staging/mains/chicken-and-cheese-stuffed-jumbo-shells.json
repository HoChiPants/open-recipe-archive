  "id": "chicken-and-cheese-stuffed-jumbo-shells",
  "name": "Chicken and Cheese Stuffed Jumbo Shells",
  "subtitle": "Baked pasta shells with seasoned chicken and two cheeses",
  "description": "Jumbo shells filled with seasoned chicken, onion, breadcrumbs, egg, and shredded cheese, then baked in tomato sauce until browned and fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
