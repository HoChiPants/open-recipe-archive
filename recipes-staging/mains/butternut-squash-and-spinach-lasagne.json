  "id": "butternut-squash-and-spinach-lasagne",
  "name": "Butternut Squash and Spinach Lasagne",
  "subtitle": "A layered squash, spinach, and ricotta bake",
  "description": "Roasted squash, wilted spinach, and a creamy cheese mixture are layered and baked until golden and set.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 75
  },
  "ingredients": [
