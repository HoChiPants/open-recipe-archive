  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Lightly oil a baking dish."
    },
    {
      "step": 2,
      "text": "Cut the squash into thick slices, coat with some of the oil, and roast until tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Meanwhile, coat the onion with the remaining oil and cook until soft, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Transfer the spinach to boiling water for 2 minutes, then drain, cool, and squeeze out excess moisture. Chop it with the onion and sundried tomatoes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Stir together the ricotta, quark, grated Parmesan, and eggs."
    },
    {
      "step": 6,
      "text": "Arrange a layer of squash in the oiled dish, spread with some of the ricotta mixture, then add the spinach mixture and another layer of squash. Repeat as needed, finishing with the remaining ricotta mixture."
    },
    {
      "step": 7,
      "text": "Top with the grated Parmesan and cheddar or mozzarella. Bake at 375°F until golden brown and the center is fully set and reaches 165°F, about 55 minutes.",
      "timer_minutes": 55
    },
    {
      "step": 8,
      "text": "Let the lasagne cool for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
