  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of water to a boil. Add the linguine and cook until tender, about 11 minutes; drain.",
      "timer_minutes": 11
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet over medium heat. Cook the bacon, onion, garlic, and red pepper flakes until the onion is golden brown, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Pour in the wine and simmer for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Stir in the shrimp and langostino. Cook until the shrimp are opaque and the seafood is cooked through, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Add the peas, pesto sauce, half-and-half, and drained linguine. Toss and cook until heated through and coated, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Stir in the Parmigiano-Reggiano cheese and serve."
    }
  ],
