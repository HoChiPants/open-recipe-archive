  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Warm the milk with the saffron until steaming, then remove from the heat."
    },
    {
      "step": 2,
      "text": "Boil the potatoes in salted water until tender, about 15 minutes. Drain, return them to the pan, and cook for 5 minutes to dry.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a large ovenproof pan. Cook the chorizo briefly, then add the onion and peppers and sauté until softened. Stir in the garlic for 2 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Pour in the rioja and chicken stock. Add the bay leaf and thyme, arrange the chicken thighs in the pan, and transfer to the oven with the chorizo mixture."
    },
    {
      "step": 5,
      "text": "Roast for about 40 minutes, until the chicken reaches 165°F at the thickest part and the juices run clear.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Mash the potatoes with the saffron milk and butter. Whisk in the extra virgin olive oil, season as appropriate, and serve with the chicken, pan juices, and thyme leaves."
    }
  ],
