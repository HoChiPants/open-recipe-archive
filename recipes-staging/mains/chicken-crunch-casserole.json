  "id": "chicken-crunch-casserole",
  "name": "Chicken Crunch Casserole",
  "subtitle": "Creamy chicken with a crisp cracker topping",
  "description": "A simple baked casserole combining cooked chicken, creamy soup, sour cream, and a buttery cracker crust.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-breasts",
      "item": "chicken breasts",
      "quantity": 2,
      "preparation": "cooked and deboned"
    },
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "8-ounce-container-sour-cream",
      "item": "(8 ounce) container sour cream",
      "quantity": 1
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "buttery-round-crackers",
      "item": "buttery round crackers",
      "quantity": 40
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cut the cooked, deboned chicken breasts into bite-size pieces and combine them with the soup and sour cream."
    },
    {
      "step": 3,
      "text": "Melt the butter. Crush the crackers and mix them with the melted butter."
    },
    {
      "step": 4,
      "text": "Transfer the chicken mixture to a baking dish and cover it with the buttered cracker mixture."
    },
    {
      "step": 5,
      "text": "Bake at 350°F for 30 minutes, until the center reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
