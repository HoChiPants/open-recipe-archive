{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "sage-pork-chops",
  "name": "Sage Pork Chops",
  "subtitle": "Tender bone-in chops with savory sage broth",
  "description": "Seasoned pork chops are browned in butter, then gently cooked with sage and beef bouillon until tender and safely done.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "dried-sage",
      "item": "dried sage",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "center-cut-bone-in-pork-chops",
      "item": "center cut bone-in pork chops",
      "quantity": 6
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cubes-beef-bouillon",
      "item": "cubes beef bouillon",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the salt, sage, and pepper, then season both sides of the pork chops."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large covered skillet over medium heat. Brown the chops for 5 minutes, turning once.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Dissolve the bouillon cubes in the water and pour the broth into the skillet."
    },
    {
      "step": 4,
      "text": "Cover and cook gently for 45 minutes, turning the chops once, until a thermometer inserted into the thickest part reaches 145°F.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Transfer the chops to a plate and let them rest for 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
