  "instructions": [
    {
      "step": 1,
      "text": "Combine the Brussels sprouts, wine, sliced sausage, shallots, lemon, garlic, rosemary, fennel seeds, thyme, sage, salt, and pepper. Toss with the olive oil and let stand for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Preheat the oven to 475°F. Coat a sheet pan with nonstick cooking spray."
    },
    {
      "step": 3,
      "text": "Arrange the vegetable mixture on the pan and place the chicken thighs among it, skin side up."
    },
    {
      "step": 4,
      "text": "Roast for 25 minutes, or until the thickest part of each chicken thigh reaches 165°F and the sausage reaches 160°F when checked with a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Let the chicken rest for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
