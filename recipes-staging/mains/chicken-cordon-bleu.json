  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Set the milk and bread crumbs in separate shallow dishes."
    },
    {
      "step": 2,
      "text": "Season the chicken. Place one ham slice and one Swiss cheese slice on each breast, then roll the chicken around the filling and secure as needed."
    },
    {
      "step": 3,
      "text": "Dip each roll in milk, then coat it with bread crumbs."
    },
    {
      "step": 4,
      "text": "Heat the oil in an oven-safe skillet over medium heat. Brown the chicken rolls on all sides, then transfer them to a baking dish if needed."
    },
    {
      "step": 5,
      "text": "Warm the condensed soup with the heavy cream and season with salt and pepper. Pour the sauce over the chicken."
    },
    {
      "step": 6,
      "text": "Bake until the chicken reaches 165°F at the thickest point and the filling is hot, about 15 minutes.",
      "timer_minutes": 15
    }
  ],
