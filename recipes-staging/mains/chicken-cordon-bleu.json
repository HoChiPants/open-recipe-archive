  "id": "chicken-cordon-bleu",
  "name": "Chicken Cordon Bleu",
  "subtitle": "Ham and Swiss-filled chicken with a creamy crumb coating",
  "description": "Pounded chicken breasts are filled with ham and Swiss cheese, coated in crumbs, browned, and finished in a creamy chicken sauce.",
  "meal_type": "main",
  "cuisine": "French",
  "yield": {
    "quantity": 6,
