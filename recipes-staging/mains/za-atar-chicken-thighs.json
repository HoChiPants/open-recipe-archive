{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "za-atar-chicken-thighs",
  "name": "Za'atar Chicken Thighs",
  "subtitle": "Crisp-skinned chicken with warm za'atar seasoning",
  "description": "Seasoned chicken thighs are seared skin-side down, then finished in the oven until fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "bone-in-chicken-thighs",
      "item": "bone-in chicken thighs",
      "quantity": 4,
      "preparation": "with skin"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sea-salt-and-freshly-ground-black-pepper-to-taste",
      "item": "sea salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "za-atar",
      "item": "za'atar",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "divided, or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Pat the chicken thighs dry. Coat them with the olive oil, then season with the salt, pepper, and 2 tablespoons of the za'atar."
    },
    {
      "step": 3,
      "text": "Heat an oven-safe skillet over medium heat. Place the thighs skin-side down and cook until the skin is browned, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Turn the thighs skin-side up, sprinkle with the remaining za'atar, and transfer the skillet to the oven."
    },
    {
      "step": 5,
      "text": "Bake for about 15 minutes, or until the thickest part of each thigh reaches 165°F on a food thermometer.",
      "timer_minutes": 15
    }
  ],
  "tags": [
    "dinner",
    "chicken",
    "za-atar",
    "one-pan"
  ],
