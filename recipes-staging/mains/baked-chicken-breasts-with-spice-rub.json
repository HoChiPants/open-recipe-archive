  "id": "baked-chicken-breasts-with-spice-rub",
  "name": "Baked Chicken Breasts with Spice Rub",
  "subtitle": "Tender oven-baked chicken with a lightly sweet, savory crust",
  "description": "Chicken breasts are coated with a simple sugar-and-spice rub, baked until fully cooked, and served with optional potato wedges and green vegetables.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-breasts-skinless",
      "item": "chicken breasts (skinless",
      "quantity": 4,
      "preparation": "if you like)"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": "1 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": "1 1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "garlic-granules",
      "item": "garlic granules",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "sea-salt",
      "item": "sea salt",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "potato-wedges-and-green-veg",
      "item": "potato wedges and green veg",
      "preparation": "to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and place the chicken breasts in a baking dish."
    },
    {
      "step": 2,
      "text": "Combine the brown sugar, paprika, thyme, oregano, garlic granules, and sea salt. Rub the mixture over the chicken."
    },
    {
      "step": 3,
      "text": "Bake for 30 minutes, or until the thickest part of each breast reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Serve with potato wedges and green vegetables, if desired."
    }
  ],
