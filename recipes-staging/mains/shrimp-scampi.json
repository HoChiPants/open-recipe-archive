  "id": "shrimp-scampi",
  "name": "Shrimp Scampi",
  "subtitle": "Garlic-herb shrimp with a light wine and brandy finish.",
  "description": "Flour-dusted shrimp are cooked with aromatic herbs, then finished with wine and brandy for a simple skillet-style main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
