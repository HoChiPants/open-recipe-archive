  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, black pepper, salt, and cayenne in a shallow bowl. Coat the shrimp in the seasoned flour and shake off the excess."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Cook the shrimp in batches for about 2 minutes per side, until opaque and cooked through to 145°F; transfer to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Reduce the heat to medium. Add the garlic, shallot, parsley, and oregano to the skillet; cook, stirring, until fragrant and softened.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Stir in the white wine and brandy. Simmer briefly, scraping up any browned bits."
    },
    {
      "step": 5,
      "text": "Return the shrimp to the skillet and toss to coat in the sauce. Serve hot."
    }
  ],
