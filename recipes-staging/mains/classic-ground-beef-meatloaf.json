  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat a loaf pan or baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Stir together the onion, half of the bell pepper, milk, eggs, garlic, half of the ketchup, parsley, half of the Worcestershire sauce, thyme, Dijon mustard, and black pepper. Mix in the bread crumbs."
    },
    {
      "step": 3,
      "text": "Add the ground sirloin, remaining bell pepper, and salt. Gently combine until evenly mixed, then shape into a loaf in the prepared dish."
    },
    {
      "step": 4,
      "text": "Mix the remaining ketchup and Worcestershire sauce with the balsamic vinegar, then spread the mixture over the loaf."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, or until the center reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Let the meatloaf rest for 10 minutes, then slice and serve.",
      "timer_minutes": 10
    }
  ],
