  "instructions": [
    {
      "step": 1,
      "text": "Bring water to a simmer, cook the linguine for 8 minutes until tender, then drain.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Preheat a skillet with the butter. Add the garlic and cook for 1 minute, until lightly browned.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the shrimp and cook for 2 minutes, then stir in the wine, lemon juice, half-and-half, and Parmesan.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Continue stirring until the shrimp are opaque and safely cooked through. Toss in the drained linguine and parsley, then serve."
