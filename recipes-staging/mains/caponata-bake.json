  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grill according to your appliance settings for baking and browning."
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a large ovenproof pan. Add the onions and cook until softened. Add the aubergines and milk, then cook for 10 minutes, stirring occasionally.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the balsamic vinegar, bouillon powder, chopped tomatoes, red peppers, basil, and garlic. Cook until the vegetables are tender and the mixture has thickened, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Stir in the olives, capers, and parsley. Arrange the sliced potatoes over the caponata and sprinkle with the grated cheddar."
    },
    {
      "step": 5,
      "text": "Grill until the potato topping is browned and the cheese has melted."
    },
    {
      "step": 6,
      "text": "Meanwhile, bake or cook the broccoli florets until tender, then serve with the bake."
    }
  ],
