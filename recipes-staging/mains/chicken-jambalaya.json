  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large covered skillet or saucepan over medium heat. Add the celery, onion, green bell pepper, black pepper, and hot pepper sauce; cook until the vegetables begin to soften."
    },
    {
      "step": 2,
      "text": "Stir in the tomatoes, chicken broth, rice, thyme, garlic salt, bay leaf, and remaining black pepper and hot pepper sauce as listed. Bring the mixture to a simmer."
    },
    {
      "step": 3,
      "text": "Cover and cook for 20 minutes, or until the rice is tender and the liquid is absorbed.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Fold in the cubed cooked chicken and heat until steaming throughout and at least 165°F in the thickest pieces."
    },
    {
      "step": 5,
      "text": "Remove the bay leaf and serve hot."
    }
  ],
