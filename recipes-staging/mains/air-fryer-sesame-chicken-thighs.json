  "id": "air-fryer-sesame-chicken-thighs",
  "name": "Air Fryer Sesame Chicken Thighs",
  "subtitle": "Marinated chicken thighs with a sweet-spicy sesame finish.",
  "description": "Chicken thighs are briefly marinated, air-fried until browned and cooked through, then finished with green onion and toasted sesame seeds.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15,
    "inactive_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sriracha-sauce",
      "item": "sriracha sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "rice-vinegar",
      "item": "rice vinegar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "chicken-thighs",
      "item": "chicken thighs",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "green-onion",
      "item": "green onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "sesame-seeds",
      "item": "sesame seeds",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "toasted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir together the sesame oil, soy sauce, honey, sriracha sauce, rice vinegar, and sesame seeds in a bowl."
    },
    {
      "step": 2,
      "text": "Add the chicken thighs and turn to coat. Cover and refrigerate for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat the air fryer to 400°F. Drain the chicken thighs and arrange them in the basket in a single layer."
    },
    {
      "step": 4,
      "text": "Air-fry for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Turn the chicken and continue cooking until browned and the thickest part reaches 165°F on a food thermometer, about 10 minutes more.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Transfer the chicken to a serving plate and let rest for 5 minutes. Sprinkle with green onion and toasted sesame seeds.",
      "timer_minutes": 5
    }
  ],
