  "instructions": [
    {
      "step": 1,
      "text": "Coat the chicken breasts evenly with the flour, shaking off excess."
    },
    {
      "step": 2,
      "text": "Heat the oil and butter in a large skillet. Brown the chicken on both sides, then transfer it to a plate.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Cook the sliced mushrooms in the skillet until softened and browned.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the diced shallots and cook until softened. Stir in the garlic and pour in the Marsala; cook briefly to reduce.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Return the mushrooms to the skillet and add the chicken stock. Simmer until the sauce thickens and the chicken is cooked through, reaching 165°F in the thickest part.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Whisk in the cream and chopped parsley. Serve with the optional lemon wedges."
    }
  ],
