  "id": "chicken-marsala-feecda5f",
  "name": "Chicken Marsala",
  "subtitle": "Pan-seared chicken with mushrooms in a creamy wine sauce",
  "description": "Tender chicken breasts are coated, browned, and finished with mushrooms, Marsala, stock, and cream.",
  "meal_type": "main",
