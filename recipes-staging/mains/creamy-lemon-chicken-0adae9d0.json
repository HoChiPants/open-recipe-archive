  "id": "creamy-lemon-chicken-0adae9d0",
  "name": "Creamy Lemon Chicken",
  "subtitle": "Oven-baked chicken with a bright Parmesan cream sauce",
  "description": "Chicken breasts are baked in a smooth lemon-Parmesan sauce made with browned butter and half-and-half.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "salted butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 6,
      "preparation": "boneless chicken breasts"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "half-and-half",
      "item": "half-and-half",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "divided, or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Melt the salted butter in an oven-safe skillet and cook for 7 minutes, until lightly browned.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Stir in the lemon juice and lemon zest; cook for 4 minutes. Add the half-and-half and grated Parmesan cheese, stirring until smooth.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Place the chicken breasts in the skillet and bake for 30 minutes, or until the thickest part reaches 165°F.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Top with the remaining grated Parmesan cheese and serve."
    }
  ],
