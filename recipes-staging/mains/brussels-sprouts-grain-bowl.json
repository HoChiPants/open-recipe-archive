  "id": "brussels-sprouts-grain-bowl",
  "name": "Brussels Sprouts Grain Bowl",
  "subtitle": "Roasted squash and sprouts with tahini-lemon dressing",
  "description": "A warm grain bowl combining roasted vegetables, hummus, toasted seeds, herbs, and a tangy tahini dressing.",
  "meal_type": "main",
