  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Toss the squash with the olive oil and spread it on a baking sheet."
    },
    {
      "step": 3,
      "text": "Roast the squash for 20 minutes, then add the halved Brussels sprouts and roast for 15 minutes more, until tender.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Whisk the tahini, maple syrup, and lemon zest and juice until thick and smooth."
    },
    {
      "step": 5,
      "text": "Toast the pumpkin seeds in a dry skillet until fragrant, and warm the cooked grains according to their package directions."
    },
    {
      "step": 6,
      "text": "Divide the grains between two bowls. Add the roasted vegetables, hummus, pumpkin seeds, dressing, and chopped herbs."
    }
  ],
