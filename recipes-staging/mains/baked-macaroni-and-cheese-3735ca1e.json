    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Toss the baguette chunks with 1 tablespoon of the melted butter, spread them on a baking tray, and bake until set and lightly crisp.",
      "timer_minutes": 6
    },
    {
      "step": 2,
      "text": "Cook the pasta in simmering water for 2 minutes, then drain.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Melt the remaining butter in a saucepan. Stir in the garlic, mustard powder, and flour; cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Gradually whisk in the milk. Simmer, whisking occasionally, until the sauce thickens.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Remove the sauce from the heat and stir in the cheddar and half of the parmesan until smooth."
    },
    {
      "step": 6,
      "text": "Combine the pasta with the cheese sauce and transfer to a baking dish. Top with the baguette crumbs and remaining parmesan."
    },
    {
      "step": 7,
      "text": "Bake until bubbling and golden on top. Rest briefly before serving.",
      "timer_minutes": 20
    }
  ],
