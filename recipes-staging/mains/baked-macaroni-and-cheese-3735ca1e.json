  "id": "baked-macaroni-and-cheese-3735ca1e",
  "name": "Baked Macaroni and Cheese",
  "subtitle": "Creamy cheese sauce with a crisp baguette topping",
  "description": "Short pasta is coated in a mustard-garlic cheese sauce, topped with buttery crumbs, and baked until bubbling and golden.",
  "meal_type": "main",
  "cuisine": "British",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
