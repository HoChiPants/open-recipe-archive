  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chicken-enchiladas-with-ranch-sauce",
  "name": "Chicken Enchiladas with Ranch Sauce",
  "subtitle": "Tender chicken, green chilies, and cheese in creamy rolled tortillas",
  "description": "Flour tortillas are filled with seasoned chicken and green chilies, covered in a creamy ranch sauce, and baked with melted cheese.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves - cut into 1/2 inch cubes"
    },
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "16-ounce-container-sour-cream",
      "item": "(16 ounce) container sour cream",
      "quantity": 1
    },
    {
      "ingredient_id": "green-chilies",
      "item": "green chilies",
      "quantity": 1,
      "unit": "can",
      "preparation": "4.5 ounce, chopped"
    },
    {
      "ingredient_id": "ranch-dressing-mix",
      "item": "ranch dressing mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1 ounce"
    },
    {
      "ingredient_id": "8-inch-flour-tortillas",
      "item": "(8 inch) flour tortillas",
      "quantity": 10
    },
    {
      "ingredient_id": "mexican-cheese-blend",
      "item": "Mexican cheese blend",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Melt the butter in a skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the cubed chicken and cook, stirring, until it reaches 165°F at the center. Transfer the chicken to a bowl and combine with the chopped green chilies."
    },
    {
      "step": 3,
      "text": "Warm the condensed soup in a saucepan, stirring occasionally, for 7 minutes. Whisk in the sour cream and ranch dressing mix until smooth.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Spread a thin layer of sauce in a baking dish. Spoon chicken filling into the tortillas, roll them tightly, and arrange them seam-side down in the dish."
    },
    {
      "step": 5,
      "text": "Pour the remaining sauce over the tortillas and cover with the shredded cheese blend."
    },
    {
      "step": 6,
      "text": "Bake for 35 minutes, until hot throughout and the cheese is melted.",
      "timer_minutes": 35
    }
  ],
