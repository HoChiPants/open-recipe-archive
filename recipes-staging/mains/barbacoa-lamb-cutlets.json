  "id": "barbacoa-lamb-cutlets",
  "name": "Barbacoa Lamb Cutlets",
  "subtitle": "Smoky chile-marinated lamb for a quick dinner",
  "description": "Ancho and chipotle chiles, garlic, and onion create a smoky marinade for tender lamb cutlets finished with fresh herbs.",
  "meal_type": "main",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
