  },
  "ingredients": [
    {
      "ingredient_id": "dried-ancho-chillies",
      "item": "dried ancho chillies",
      "quantity": 2
    },
    {
      "ingredient_id": "dried-chipotle-chilli",
      "item": "dried chipotle chilli",
      "quantity": 1
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic cloves",
      "quantity": 6
    },
    {
      "ingredient_id": "2-onion",
      "item": "⁄2 onion",
      "quantity": 1
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 100,
