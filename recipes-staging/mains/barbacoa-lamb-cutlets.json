      "item": "micro herbs to decorate"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Toast the ancho chillies and chipotle chilli briefly in a dry pan until fragrant. Remove the stems and seeds if desired."
    },
    {
      "step": 2,
      "text": "Heat the garlic cloves and ⁄2 onion in the same pan until lightly charred and softened."
    },
    {
      "step": 3,
      "text": "Blend or process the toasted chillies, garlic, onion, and olive oil into a smooth marinade."
    },
    {
      "step": 4,
      "text": "Coat the lamb cutlets thoroughly with the marinade and leave them to marinate for 12 hours.",
      "timer_minutes": 720
    },
    {
      "step": 5,
      "text": "Preheat a grill or heavy skillet over high heat. Cook the lamb cutlets for about 7 minutes, turning as needed, until they reach 145°F in the thickest part.",
      "timer_minutes": 7
    },
    {
      "step": 6,
      "text": "Rest the lamb for 3 minutes, then serve decorated with the micro herbs to decorate.",
      "timer_minutes": 3
    }
  ],
