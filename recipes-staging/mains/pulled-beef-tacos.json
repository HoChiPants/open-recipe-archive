  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to a moderate temperature. Combine the vinegar, lime juice, chipotle paste, garlic, cloves, cumin, oregano, bay leaves, and sugar in a covered ovenproof dish."
    },
    {
      "step": 2,
      "text": "Add the beef and stock, turning the meat to coat. Cover and braise for about 2 hours, until the beef is tender and reaches at least 145°F internally; rest it for 3 minutes.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Let the beef cool slightly, then shred it with forks. Return it to the cooking juices and simmer briefly to coat.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Warm the tacos, fill them with the shredded beef, and finish with coriander, pickled onion, radishes, or crumbled feta."
    }
  ],
