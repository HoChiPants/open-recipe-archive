  "instructions": [
    {
      "step": 1,
      "text": "Press and drain the extra-firm tofu, then chill it for 3 hours so it firms up.",
      "timer_minutes": 180
    },
    {
      "step": 2,
      "text": "Heat the 2 tablespoons sesame oil. Cook the red onion, celery, mushrooms, and prepared herb stuffing until the vegetables are tender."
    },
    {
      "step": 3,
      "text": "Stir in the garlic, dried sage, dried thyme, salt and pepper to taste, dried rosemary, 0.25 cup tamari, and sprigs fresh rosemary. Cook for 5 minutes, then combine with the remaining prepared herb stuffing.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Heat the oven to 400°F. Whisk together the 0.5 cup sesame oil, remaining 0.25 cup tamari, miso paste, orange juice, honey mustard, and orange zest."
    },
    {
      "step": 5,
      "text": "Prepare the tofu by splitting or opening it for filling. Spread in the miso paste, pack in the stuffing mixture, close, and shape the tofu into a roast. Transfer it to a baking dish and add the dried rosemary and sprigs fresh rosemary."
    },
    {
      "step": 6,
      "text": "Bake at 400°F until golden brown. Transfer the roast with the tamari to a serving dish."
    }
  ],
