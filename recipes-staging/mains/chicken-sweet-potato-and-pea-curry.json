  "id": "chicken-sweet-potato-and-pea-curry",
  "name": "Chicken, Sweet Potato, and Pea Curry",
  "subtitle": "A creamy one-pot curry with tender chicken and vegetables",
  "description": "Chicken, sweet potatoes, lentils, peas, and tomatoes simmer in coconut milk and korma paste for a quick, satisfying meal.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "rapeseed-oil",
      "item": "rapeseed oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "korma-paste",
      "item": "korma paste",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "skinless-chicken-breast-fillets",
      "item": "skinless chicken breast fillets",
      "quantity": 2,
      "preparation": "each cut into 8-10 pieces"
    },
    {
      "ingredient_id": "sweet-potatoes-chopped-into-bite-sized-pieces",
      "item": "sweet potatoes chopped into bite-sized pieces",
      "quantity": 320,
      "unit": "g"
    },
    {
      "ingredient_id": "red-lentils",
      "item": "red lentils",
      "quantity": 6,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "can-light-coconut-milk-freeze-the-rest-for-later",
      "item": "can light coconut milk (freeze the rest for later)",
      "quantity": 325,
      "unit": "ml"
    },
    {
      "ingredient_id": "frozen-peas",
      "item": "frozen peas",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "cherry-tomatoes",
      "item": "cherry tomatoes",
      "quantity": 220,
      "unit": "g"
    },
    {
      "ingredient_id": "rice-or-roti",
      "item": "rice or roti",
      "quantity": 300,
      "unit": "g",
      "preparation": "cooked, to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large saucepan over medium heat. Add the korma paste and warm briefly until fragrant."
    },
    {
      "step": 2,
      "text": "Stir in the chicken, sweet potatoes, and red lentils until evenly coated."
    },
    {
      "step": 3,
      "text": "Pour in the coconut milk and bring the mixture to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Simmer for 20 minutes, stirring occasionally, until the sweet potatoes are tender and the chicken reaches 165°F internally.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Stir in the peas and cherry tomatoes and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Serve the curry with the cooked rice or roti."
    }
  ],
