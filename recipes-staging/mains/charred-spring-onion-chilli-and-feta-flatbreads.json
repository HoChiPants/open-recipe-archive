      "ingredient_id": "bunches-of-spring-onions-about-250g",
      "item": "bunches of spring onions (about 250g)",
      "quantity": 2,
      "preparation": "trimmed"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": "3 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-cloves-sliced",
      "item": "garlic cloves sliced",
      "quantity": 4
    },
    {
      "ingredient_id": "red-chilli-deseeded-if-you-prefer-less-heat",
      "item": "red chilli (deseeded if you prefer less heat)",
      "quantity": 1,
