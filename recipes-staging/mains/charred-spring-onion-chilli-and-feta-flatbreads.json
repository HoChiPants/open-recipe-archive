      "item": "olive oil plus extra for rising",
      "quantity": 2,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the yeast, bread flour, sugar, 3 1/2 tbsp olive oil, and enough water to make a soft dough."
    },
    {
      "step": 2,
      "text": "Knead the dough for 10 minutes, until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Coat the dough with a little of the additional olive oil, cover, and leave to rise until doubled in size.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Mix the yogurt with the crumbled feta until smooth, then set aside."
    },
    {
      "step": 5,
      "text": "Slice the trimmed spring onions. Heat a little olive oil in a skillet and cook the onions for about 3 minutes, until charred and set aside.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Cook the sliced garlic, sliced chilli, and nigella seeds briefly in the same skillet, then combine them with the charred onions."
    },
    {
      "step": 7,
      "text": "Divide the risen dough into four portions and dust the work surface with bread flour."
    },
    {
      "step": 8,
      "text": "Shape each portion into a flatbread, rest for 5 minutes, then reshape as needed.",
      "timer_minutes": 5
    },
    {
      "step": 9,
      "text": "Heat a clean skillet over high heat. Cook the flatbreads for about 3 minutes, turning as needed, until cooked through and marked.",
      "timer_minutes": 3
    },
    {
      "step": 10,
      "text": "Spread the yogurt and feta mixture over the warm flatbreads and top with the charred onion mixture."
    }
  ],
