  "id": "charred-spring-onion-chilli-and-feta-flatbreads",
  "name": "Charred Spring Onion, Chilli and Feta Flatbreads",
  "subtitle": "Soft flatbreads with smoky onions and tangy feta",
  "description": "Make a yeast-raised dough, cook it in a hot pan, and finish with yogurt, charred spring onions, chilli, garlic, and crumbled feta.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 35
  },
  "ingredients": [
