  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Arrange the chicken pieces in a baking dish in a single layer."
    },
    {
      "step": 2,
      "text": "Stir the ketchup, water, brown sugar, and onion soup mix together until evenly combined."
    },
    {
      "step": 3,
      "text": "Pour the sauce over the chicken, covering the pieces as evenly as possible."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, or until the thickest piece reaches 165°F on a food thermometer.",
      "timer_minutes": 60
    }
  ],
