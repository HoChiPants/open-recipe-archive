  "ingredients": [
    {
      "ingredient_id": "3-pound-whole-chicken",
      "item": "(3 pound) whole chicken",
      "quantity": 1,
      "preparation": "cut into pieces"
    },
    {
      "ingredient_id": "ketchup",
      "item": "ketchup",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
