  "id": "baked-chicken-with-brown-sugar-sauce",
  "name": "Baked Chicken with Brown Sugar Sauce",
  "subtitle": "Tender chicken pieces in a quick savory-sweet glaze",
  "description": "Chicken pieces are coated with a ketchup and brown sugar sauce, then baked until fully cooked and tender.",
  "meal_type": "main",
