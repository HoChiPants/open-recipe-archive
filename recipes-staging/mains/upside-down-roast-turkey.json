  "id": "upside-down-roast-turkey",
  "name": "Upside-Down Roast Turkey",
  "subtitle": "Herb-scented turkey roasted over buttered French bread",
  "description": "A generously salted whole turkey roasts breast-side down over buttered bread with fresh herbs, then rests before carving.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 120,
    "inactive_minutes": 735
  },
  "ingredients": [
    {
      "ingredient_id": "16-pound-whole-turkey",
      "item": "(16 pound) whole turkey",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "loaf-french-bread",
      "item": "loaf French bread",
      "quantity": 1
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sprigs-fresh-sage",
      "item": "sprigs fresh sage",
      "quantity": 2,
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "sprigs-fresh-rosemary",
      "item": "sprigs fresh rosemary",
      "quantity": 2,
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "sprigs-fresh-thyme",
      "item": "sprigs fresh thyme",
      "quantity": 2,
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pat the thawed turkey dry. Rub the kosher salt evenly over the skin and inside the cavity. Cover or refrigerate it for the inactive salting period.",
      "timer_minutes": 735
    },
    {
      "step": 2,
      "text": "Preheat the oven to 450°F and set a rack in a roasting pan."
    },
    {
      "step": 3,
      "text": "Cut the French bread into thick slices and arrange them in the roasting pan. Spread the softened butter over the bread."
    },
    {
      "step": 4,
      "text": "Place the sage, rosemary, and thyme in the turkey cavity. Set the turkey breast-side down over the bread."
    },
    {
      "step": 5,
      "text": "Roast for about 120 minutes, or until a thermometer inserted into the thickest parts of the breast and thigh registers 165°F.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Transfer the turkey to a board and rest for 20 minutes. Slice the bread and carve the turkey; serve together.",
      "timer_minutes": 20
    }
  ],
