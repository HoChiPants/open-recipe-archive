  "instructions": [
    {
      "step": 1,
      "text": "Mix the oregano, thyme, paprika, 0.5 teaspoon salt, and 0.25 teaspoon pepper. Season the chopped chicken with the mixture."
    },
    {
      "step": 2,
      "text": "Set an electric pressure cooker to sauté. Warm the butter and olive oil until the butter melts."
    },
    {
      "step": 3,
      "text": "Add the chicken and cook until browned and cooked through, reaching 165°F in the thickest pieces. Transfer it to a plate."
    },
    {
      "step": 4,
      "text": "Add the onion and cook for 2 minutes. Stir in the garlic and cook briefly until fragrant.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Add the remaining butter and rice. Stir for 3 minutes to coat the grains.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Pour in the wine and cook for 2 minutes, stirring and scraping up any browned bits.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Stir in the onion, chicken stock, and cooked chicken. Lock the lid and cook under high pressure for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Let the pressure release naturally for 15 minutes, then release any remaining pressure carefully. Open the cooker once the pressure indicator has dropped.",
      "timer_minutes": 15
    },
    {
      "step": 9,
      "text": "Stir in the Parmesan. Season with salt and pepper to taste, garnish with parsley, and serve."
    }
  ],
