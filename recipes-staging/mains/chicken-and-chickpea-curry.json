      "item": "ground turmeric",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "can-chickpeas-drained-and-rinsed",
      "item": "can chickpeas drained and rinsed",
      "quantity": 400,
      "unit": "g"
