  "id": "chicken-and-chickpea-curry",
  "name": "Chicken and Chickpea Curry",
  "subtitle": "A warming curry with tender chicken and chickpeas",
  "description": "Chicken thighs simmer with aromatics, tomato, and warm spices, then finish with chickpeas and fresh coriander. Serve with rice or naan.",
  "meal_type": "main",
  "cuisine": "Indian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 70
  },
  "ingredients": [
