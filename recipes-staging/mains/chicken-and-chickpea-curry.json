  "instructions": [
    {
      "step": 1,
      "text": "Heat the sunflower oil in a large heavy-based pan. Add the sliced onions and cook until softened and golden.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the garlic, green chillies, chilli powder, garam masala, ground coriander, and turmeric. Stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Mix in the tomato purée, then add the chicken thighs and turn to coat. Cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Cover and simmer gently until the chicken is cooked through and reaches 165°F at the thickest part near the bone.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Stir in the chickpeas and cook until heated through and the curry is thickened.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Rest briefly, scatter with coriander leaves, and serve with cooked rice or naans."
    }
  ],
