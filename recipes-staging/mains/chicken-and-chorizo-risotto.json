  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large heavy-based pan. Sauté the chorizo and onions until the onions begin to soften."
    },
    {
      "step": 2,
      "text": "Add the sliced red and yellow peppers and cook until softened. Add the chopped chicken and cook until golden outside and 165°F in the thickest pieces when checked with a food thermometer."
    },
    {
      "step": 3,
      "text": "Transfer the chicken, chorizo, and vegetables to a bowl. Add the basmati rice to the pan and sauté for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the optional white wine, if using, then add the stock and return the chicken mixture to the pan."
    },
    {
      "step": 5,
      "text": "Stir in the sweetcorn and frozen peas. Cook until the rice is tender and the mixture is thick and creamy, stirring frequently.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Remove from the heat and fold in the parmesan and butter. Stir until combined, then serve hot."
    }
  ],
