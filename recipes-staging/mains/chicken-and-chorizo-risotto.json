  "id": "chicken-and-chorizo-risotto",
  "name": "Chicken and Chorizo Risotto",
  "subtitle": "A hearty rice dish with peppers, peas, and sweetcorn",
  "description": "Sautéed chicken, chorizo, peppers, and onions are combined with basmati rice, stock, vegetables, butter, and parmesan for a rich one-pot meal.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
