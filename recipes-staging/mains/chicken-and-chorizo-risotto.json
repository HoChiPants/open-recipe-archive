      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "chorizo-chopped",
      "item": "chorizo chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "red-pepper-finely-sliced",
      "item": "red pepper finely sliced",
      "quantity": 1
    },
    {
      "ingredient_id": "yellow-pepper-finely-sliced",
      "item": "yellow pepper finely sliced",
      "quantity": 1
    },
    {
