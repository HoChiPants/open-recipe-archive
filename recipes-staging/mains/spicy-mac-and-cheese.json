  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Bring a pot of salted water to a boil. Cook the elbow macaroni for 10 minutes, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Melt the 0.25 cup butter in a saucepan. Stir in the flour and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the milk, cream cheese, chopped jalapeños, Dijon mustard, black pepper, salt, and Cheddar. Stir in the hot sauce and cook until the sauce thickens, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Combine the drained macaroni with the cheese sauce and transfer to a baking dish."
    },
    {
      "step": 6,
      "text": "Melt the 2 tablespoons butter and combine it with the bread crumbs and parsley. Scatter the mixture over the macaroni."
    },
    {
      "step": 7,
      "text": "Bake until the topping is golden brown, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "Serve hot."
    }
  ],
