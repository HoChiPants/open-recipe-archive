  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large pot over medium heat. Add the onions and cook for 5 minutes. Add the carrots and stir for 2 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Add the garlic and tomatoes with garlic and oregano; cook for 3 minutes, stirring occasionally.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Pour in the chicken broth, red wine, green beans, pinto beans, spinach, basil, oregano, and salt and pepper. Bring to a simmer."
    },
    {
      "step": 4,
      "text": "Cook gently for 40 minutes, or until the vegetables are tender. If the broth contains poultry, heat the soup to 165°F before serving.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Return the soup to a boil, add the seashell pasta, and cook for 8 minutes or until tender.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Stir in the Parmesan cheese and adjust the seasoning before serving."
    }
  ],
