  "id": "baked-halibut",
  "name": "Baked Halibut",
  "subtitle": "Halibut with a creamy dill-onion topping",
  "description": "Seasoned halibut is baked under a creamy mixture of sour cream, mayonnaise, dill, and green onions.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
