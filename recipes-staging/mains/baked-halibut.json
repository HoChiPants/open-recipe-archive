      "item": "dried dill weed",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 475°F and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Season the halibut pieces with salt and ground black pepper, then place them in the baking dish."
    },
    {
      "step": 3,
      "text": "Stir together the green onions, mayonnaise, sour cream, and dill weed. Spread the mixture over the halibut."
    },
    {
      "step": 4,
      "text": "Bake for 20 minutes, until the fish is opaque and reaches 145°F or flakes easily with a fork.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Let the baked halibut rest for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
