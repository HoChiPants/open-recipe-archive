  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken legs, onion, garlic, black peppercorns, bay leaf, and half the parsley in a pot with enough water to cover. Bring to a simmer and cook for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Remove the chicken and strain the cooking liquid, reserving it. Keep the chicken warm and discard the solids."
    },
    {
      "step": 3,
      "text": "Melt the butter in a clean pot over medium heat. Stir in the flour and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Whisk in the white wine, reserved cooking liquid, and cream. Add the bay leaf and simmer for 5 minutes, whisking until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the carrot, leek, celery, chicken, peas, lemon juice, and nutmeg. Simmer until the vegetables are tender and the chicken reaches 165°F internally."
    },
    {
      "step": 6,
      "text": "Stir in the remaining parsley and serve hot."
    }
  ],
