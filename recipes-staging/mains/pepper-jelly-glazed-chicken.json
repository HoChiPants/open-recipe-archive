    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "bone-in-chicken-breast-halves",
      "item": "bone-in chicken breast halves",
      "quantity": 4,
      "preparation": "with skin"
    },
    {
      "ingredient_id": "red-pepper-jelly",
      "item": "red pepper jelly",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.33333334326744,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Place the chicken breast halves in a baking dish."
    },
    {
      "step": 2,
      "text": "Stir together the red pepper jelly, Dijon mustard, and honey until combined."
    },
    {
      "step": 3,
      "text": "Coat the chicken evenly with the glaze."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, or until a thermometer inserted into the thickest part of the chicken registers 165°F.",
      "timer_minutes": 60
    }
  ],
