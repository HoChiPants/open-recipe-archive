  "id": "pepper-jelly-glazed-chicken",
  "name": "Pepper Jelly Glazed Chicken",
  "subtitle": "Sweet-tangy baked chicken with a glossy glaze",
  "description": "Bone-in chicken breasts are coated with a quick pepper jelly, mustard, and honey glaze, then baked until fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
