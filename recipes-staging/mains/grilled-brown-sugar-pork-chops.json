  "id": "grilled-brown-sugar-pork-chops",
  "name": "Grilled Brown Sugar Pork Chops",
  "subtitle": "Sweet-savory pork with a glossy ginger sauce",
  "description": "Boneless pork chops are grilled and finished with a brown sugar, apple juice, and ginger sauce thickened with cornstarch.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "firmly packed"
    },
    {
      "ingredient_id": "apple-juice",
      "item": "apple juice",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "boneless-pork-chops",
      "item": "boneless pork chops",
      "quantity": 6
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Combine the brown sugar, apple juice, soy sauce, ground ginger, and salt and pepper in a saucepan; bring to a simmer."
    },
    {
      "step": 2,
      "text": "Mix the cornstarch with the water until smooth. Stir it into the simmering sauce and cook until thickened."
    },
    {
      "step": 3,
      "text": "Brush the pork chops with the vegetable oil and grill until cooked through, about 12 minutes total, turning as needed. Verify the thickest chop reaches 145°F, then rest for 3 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Grill the chops briefly with the soy sauce, then serve with the thickened sauce."
    }
  ],
