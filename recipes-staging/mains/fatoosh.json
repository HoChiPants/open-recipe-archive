  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Prepare the pita breads and bake for 10 minutes, until crisp. Set aside to cool.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Combine the romaine, green onions, cucumber, tomatoes, parsley, and mint in a large bowl."
    },
    {
      "step": 4,
      "text": "Whisk the garlic, sumac, lemon juice, olive oil, salt, and pepper into a dressing."
    },
    {
      "step": 5,
      "text": "Add the dressing to the vegetables and toss well. Break the crisp pita into pieces, add them to the bowl, and toss again."
    }
  ],
