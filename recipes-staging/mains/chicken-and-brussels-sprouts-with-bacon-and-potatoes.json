  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Arrange the chicken thighs, potatoes, and Brussels sprouts in a baking dish or roasting pan."
    },
    {
      "step": 3,
      "text": "Toss the potatoes and Brussels sprouts with the garlic and olive oil. Season the vegetables and chicken with salt, pepper, and thyme."
    },
    {
      "step": 4,
      "text": "Sprinkle the ranch dressing mix over the chicken and vegetables, then scatter the chopped bacon throughout the pan."
    },
    {
      "step": 5,
      "text": "Bake for 35 minutes, or until the chicken reaches 165°F in the thickest part and the vegetables are tender.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Set the oven to broil and cook for about 3 minutes, until the chicken skin and bacon are golden brown. Watch closely.",
      "timer_minutes": 3
    }
  ],
