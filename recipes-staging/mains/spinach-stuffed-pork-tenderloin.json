  "id": "spinach-stuffed-pork-tenderloin",
  "name": "Spinach-Stuffed Pork Tenderloin",
  "subtitle": "Roasted pork with a savory spinach filling",
  "description": "Butterflied pork tenderloin is filled with seasoned spinach and breadcrumbs, rolled, and roasted with a tangy citrus-teriyaki glaze.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "10 ounce, thawed and drained"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove"
    },
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "pork-tenderloin",
      "item": "pork tenderloin",
      "quantity": 3,
      "unit": "pounds"
    },
    {
      "ingredient_id": "ketchup",
      "item": "ketchup",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "orange-juice",
      "item": "orange juice",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "teriyaki-sauce",
      "item": "teriyaki sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Melt the margarine in a skillet over medium heat. Add the spinach, onion, and garlic; cook until the onion softens. Stir in the bread crumbs and remove from the heat."
    },
    {
      "step": 3,
      "text": "Butterfly the pork tenderloin by cutting it lengthwise nearly through, then open it flat. Spread the spinach mixture over the meat and roll it up securely."
    },
    {
      "step": 4,
      "text": "Combine the ketchup, orange juice, and teriyaki sauce. Brush the mixture over the rolled tenderloin and sprinkle with the cumin."
    },
    {
      "step": 5,
      "text": "Place the tenderloin in a roasting pan and roast until the thickest part reaches 145°F on a food thermometer.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Let the pork rest for 3 minutes before slicing and serving.",
      "timer_minutes": 3
    }
  ],
