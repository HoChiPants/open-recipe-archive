  "id": "skillet-ham-cabbage-and-potatoes",
  "name": "Skillet Ham, Cabbage, and Potatoes",
  "subtitle": "A hearty one-pan dinner with tender vegetables and ham",
  "description": "Cabbage, potatoes, onion, and cubed cooked ham simmer together in a buttery skillet for a simple American-style main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "head-cabbage",
      "item": "head cabbage",
      "quantity": 1,
      "unit": "small",
      "preparation": "coarsely chopped"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 3,
      "unit": "large",
      "preparation": "scrubbed and sliced"
    },
    {
      "ingredient_id": "seasoning-salt",
      "item": "seasoning salt",
      "quantity": 1,
      "unit": "dash"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "dash",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "ham",
      "item": "ham",
      "quantity": 2,
      "unit": "cups",
      "preparation": "cubed cooked"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large skillet over medium heat. Add the onion and cook for 5 minutes, stirring, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the cabbage and water. Add the sliced potatoes, seasoning salt, and paprika, then bring the mixture to a simmer."
    },
    {
      "step": 3,
      "text": "Cover and simmer until the cabbage and potatoes are tender."
    },
    {
      "step": 4,
      "text": "Stir in the cubed cooked ham and simmer briefly until heated through."
    }
  ],
