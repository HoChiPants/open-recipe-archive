  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Cook the rotini in boiling water for 8 minutes, until cooked through, then drain.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Set up separate dishes for the flour, beaten eggs, and bread crumbs mixed with garlic powder. Coat each chicken piece in flour, egg, and the seasoned crumbs."
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil and sauté the coated chicken in batches for about 4 minutes, turning until golden brown. Drain and verify the chicken reaches 165°F internally.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Combine the drained pasta with half of the mozzarella and the Parmesan. Stir the marinara sauce with the red wine."
    },
    {
      "step": 5,
      "text": "Layer the pasta mixture and chicken in a baking dish, then pour the sauce over the top and combine gently."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes. Add the remaining mozzarella and Parmesan, then continue baking until the cheese is melted and the casserole is hot throughout.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Let the casserole rest for 5 minutes before serving.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Serve warm."
    }
  ],
