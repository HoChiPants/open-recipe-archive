  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large deep skillet over medium heat. Add the onion and cook for 3 minutes. Stir in the garlic, then the orzo, and cook for 1 minute.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Whisk the heavy cream, chicken broth, and salt together. Pour the mixture into the skillet and bring it to a simmer.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Simmer, stirring occasionally, until the orzo is tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the chicken and spinach. Cook until the spinach wilts and the chicken is heated through; verify the chicken reaches 165°F with a food thermometer.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Stir in the fontina, Parmesan, parsley, black pepper, lemon zest, and lemon juice until combined and creamy."
    },
    {
      "step": 6,
      "text": "Serve topped with additional Parmesan and parsley."
    }
  ],
