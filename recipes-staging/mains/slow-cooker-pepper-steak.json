      "item": "white sugar",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "green-bell-peppers",
      "item": "green bell peppers",
      "quantity": 3,
      "preparation": "cut into strips"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 1,
      "unit": "tablespoon"
