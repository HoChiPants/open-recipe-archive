      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "beef-sirloin",
      "item": "beef sirloin",
      "quantity": 3,
      "unit": "pounds",
      "preparation": "sliced into strips"
    },
