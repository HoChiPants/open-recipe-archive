  "id": "slow-cooker-pepper-steak",
  "name": "Slow Cooker Pepper Steak",
  "subtitle": "Tender beef with peppers in a savory sauce",
  "description": "Beef sirloin cooks slowly with garlic, onion, soy sauce, and bell peppers, then finishes with a lightly thickened sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
