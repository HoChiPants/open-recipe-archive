  "id": "japanese-broiled-mackerel",
  "name": "Japanese Broiled Mackerel",
  "subtitle": "Ginger-mirin glazed mackerel",
  "description": "Mackerel fillets are briefly marinated in a sweet, savory ginger sauce, then broiled until opaque and flaky.",
  "meal_type": "main",
  "cuisine": "Japanese",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "mackerel-fillets",
      "item": "mackerel fillets",
      "quantity": 4
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "mirin-japanese-sweet-wine",
      "item": "mirin (Japanese sweet wine)",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "grated-fresh-ginger-root",
      "item": "grated fresh ginger root",
      "quantity": 0.5,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pat the mackerel fillets dry and arrange them in a shallow dish."
    },
    {
      "step": 2,
      "text": "Stir together the soy sauce, mirin, sugar, and ginger. Pour the mixture over the mackerel and marinate for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Preheat the broiler and position the rack according to your broiler's instructions."
    },
    {
      "step": 4,
      "text": "Broil the mackerel for about 5 minutes, continuing briefly as needed until the thickest part reaches 145°F and the fish is opaque and flakes easily.",
      "timer_minutes": 5
    }
  ],
