  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Lightly coat a baking sheet with cooking spray."
    },
    {
      "step": 2,
      "text": "Pat the chicken wings dry. Season with the salt, then toss with the flour until evenly coated. Arrange the wings on the prepared sheet."
    },
    {
      "step": 3,
      "text": "Bake the wings for 45 minutes, turning as needed, until crisp and a thermometer inserted into the thickest part reads 165°F.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "While the wings bake, melt the butter with the hot sauce, red wine vinegar, Worcestershire sauce, honey, garlic powder, and cayenne pepper. Stir until combined."
    },
    {
      "step": 5,
      "text": "Transfer the baked wings to a bowl, pour over the sauce, and toss until evenly coated."
    },
    {
      "step": 6,
      "text": "Serve with the sliced celery and carrots."
    }
  ],
