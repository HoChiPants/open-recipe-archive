  "id": "oven-baked-chicken-wings",
  "name": "Oven-Baked Chicken Wings",
  "subtitle": "Crisp wings with a tangy hot-sauce glaze",
  "description": "Flour-coated chicken wings are baked until fully cooked, then tossed with a buttery hot-sauce mixture and served with sliced celery and carrots.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
