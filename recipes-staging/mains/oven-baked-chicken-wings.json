      "item": "cooking spray"
    },
    {
      "ingredient_id": "chicken-wings",
      "item": "chicken wings",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
