  "id": "bbq-beef-brisket-sandwiches",
  "name": "BBQ Beef Brisket Sandwiches",
  "subtitle": "Slow-cooked brisket with smoky barbecue sauce on toasted rolls",
  "description": "Seasoned beef brisket is cooked until tender, shredded, and finished in a savory barbecue sauce before serving on split kaiser rolls.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 545
  },
  "ingredients": [
    {
      "ingredient_id": "celery-salt",
      "item": "celery salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "onion-salt",
      "item": "onion salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "beef-brisket",
      "item": "beef brisket",
      "quantity": 3,
      "unit": "pounds"
    },
    {
      "ingredient_id": "russian-dressing",
      "item": "Russian dressing",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "hickory-flavored-barbeque-sauce",
      "item": "hickory-flavored barbeque sauce",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "kaiser-rolls",
      "item": "kaiser rolls",
      "quantity": 8,
      "preparation": "split"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the celery salt, ground black pepper, salt, garlic salt, and onion salt."
    },
    {
      "step": 2,
      "text": "Stir together the Worcestershire sauce and hickory-flavored barbeque sauce."
    },
    {
      "step": 3,
      "text": "Coat the beef brisket with the seasoning mixture and place it in a covered cooking vessel."
    },
    {
      "step": 4,
      "text": "Cook the brisket for 480 minutes, until tender and a thermometer inserted into the thickest part reads at least 145°F.",
      "timer_minutes": 480
    },
    {
      "step": 5,
      "text": "Transfer the brisket to a board and rest it for 3 minutes before shredding.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Combine the cooking sauce with the Russian dressing and hickory-flavored barbeque sauce, then simmer until hot."
    },
    {
      "step": 7,
      "text": "Return the shredded brisket to the sauce and combine; cook for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Spoon the sauced brisket into the split kaiser rolls and serve."
    }
  ],
