  "id": "air-fryer-harissa-sausage-and-vegetable-traybake",
  "name": "Air-Fryer Harissa Sausage and Vegetable Traybake",
  "subtitle": "Roasted squash, peppers, sausages, and greens with harissa and lemon",
  "description": "A simple air-fryer meal combining tender vegetables and sausages with spicy harissa, lemon, and dark leafy greens.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "butternut-squash-roughly-chopped-no-need-to-peel",
      "item": "butternut squash roughly chopped (no need to peel)",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "rapeseed-oil",
      "item": "rapeseed oil",
      "quantity": "1 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "red-pepper-roughly-chopped",
      "item": "red pepper roughly chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "red-onion-cut-into-8-wedges",
      "item": "red onion cut into 8 wedges",
      "quantity": 1
    },
    {
      "ingredient_id": "garlic-cloves-lightly-bashed",
      "item": "garlic cloves lightly bashed",
      "quantity": 4
    },
    {
      "ingredient_id": "sausages",
      "item": "sausages",
      "quantity": "4-6"
    },
    {
      "ingredient_id": "harissa-to-taste",
      "item": "harissa to taste",
      "quantity": "2-3",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "dark-green-leaves-such-as-kale-or-cavolo-nero",
      "item": "dark green leaves (such as kale or cavolo nero)",
      "quantity": 100,
      "unit": "g",
      "preparation": "roughly sliced"
    },
    {
      "ingredient_id": "natural-yogurt-to-serve-optional",
      "item": "natural yogurt to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to its instructions. Toss the squash, pepper, onion, and oil together in the basket or a suitable tray."
    },
    {
      "step": 2,
      "text": "Air-fry the vegetables until the squash begins to soften and brown.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Add the garlic and turn the vegetables. Continue cooking until more tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the sausages. Mix the harissa with the lemon juice and coat the sausages and vegetables with it."
    },
    {
      "step": 5,
      "text": "Air-fry until the vegetables are tender and the sausages reach 160°F internally on a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Add the sliced greens and cook until wilted and tender.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Serve with natural yogurt, if using."
    }
  ],
