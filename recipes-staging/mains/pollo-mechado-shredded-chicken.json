  "instructions": [
    {
      "step": 1,
      "text": "Simmer the chicken in water until cooked through and an instant-read thermometer registers 165°F, about 25 minutes. Transfer it to a plate, let it cool briefly, and shred it.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Warm the olive oil in a large skillet over medium heat. Add the onion and cook for 3 minutes, then add the bell pepper and continue cooking until the vegetables soften, about 10 minutes.",
      "timer_minutes": 13
    },
    {
      "step": 3,
      "text": "Stir in the garlic and cook for 1 minute. Add the shredded chicken, sherry, capers, and salt; cook, stirring occasionally, for 15 minutes so the flavors combine.",
      "timer_minutes": 16
    },
    {
      "step": 4,
      "text": "Fold in the tomato and cilantro. Cook until the tomato softens, about 10 minutes, then serve hot.",
      "timer_minutes": 10
    }
  ],
