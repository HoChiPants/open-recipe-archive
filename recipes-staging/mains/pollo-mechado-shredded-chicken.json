  "id": "pollo-mechado-shredded-chicken",
  "name": "Pollo Mechado (Shredded Chicken)",
  "subtitle": "Tender chicken with peppers, tomato, capers, and cilantro",
  "description": "Simmer chicken until cooked, shred it, then fold it into a savory sauté of vegetables, sherry, and capers.",
  "meal_type": "main",
