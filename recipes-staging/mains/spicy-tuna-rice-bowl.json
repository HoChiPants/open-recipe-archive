  "instructions": [
    {
      "step": 1,
      "text": "Combine the rice, water, and seasoned rice vinegar in a saucepan. Cook until the rice is tender and the liquid is absorbed, following the rice package method.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Remove the rice from the heat, cover, and let it stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Mix the lemon juice, soy sauce, Sriracha, sesame oil, and gochugaru in a bowl."
    },
    {
      "step": 4,
      "text": "Add the tuna, red bell pepper, jalapeno, and sliced green onions to the dressing. Toss until combined. If the tuna is not already cooked, heat it to 145°F, or until opaque and easily flaked."
    },
    {
      "step": 5,
      "text": "Fluff the rice and divide it between two bowls. Spoon the tuna mixture over the rice and garnish with the remaining sliced green onion."
    }
  ],
