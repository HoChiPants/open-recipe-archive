      "item": "freshly squeezed lemon juice",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Let the steaks stand at room temperature for 30 minutes. Heat the oven to 425°F.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Season the steaks with kosher salt, freshly ground black pepper, and freshly cracked black pepper."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in an oven-safe skillet over high heat. Add the steaks and sear for 3 minutes, until golden brown.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Transfer the skillet to the oven and cook the steaks for 2 minutes, then turn and cook for 3 minutes more. Check that the centers reach 145°F, then rest the steaks for at least 3 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Transfer the steaks to a plate, top with the optional butter or herb butter and the butter, and let them rest for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Return the skillet to the stovetop, add the sliced mushrooms, and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Pour in the white wine and cook until reduced. Whisk in the Worcestershire sauce, heavy cream, and freshly cracked black pepper; simmer for 2 minutes, until thickened.",
      "timer_minutes": 2
    },
    {
      "step": 8,
      "text": "Season with kosher salt, stir in the steaks and freshly squeezed lemon juice, and serve with the mushroom sauce."
    }
  ],
