  "id": "pan-seared-filet-mignon",
  "name": "Pan-Seared Filet Mignon",
  "subtitle": "Filet steaks with creamy mushrooms",
  "description": "Sear tender filet mignon, then serve it with mushrooms in a quick wine and cream sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "8-ounce-filet-mignon-steaks",
      "item": "(8 ounce) filet mignon steaks",
      "quantity": 2
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter-or-herb-butter-optional",
      "item": "butter or herb butter (optional)",
      "quantity": 2,
      "unit": "tablespoons",
      "optional": true
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
