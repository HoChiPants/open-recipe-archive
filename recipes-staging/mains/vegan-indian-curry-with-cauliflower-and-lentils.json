  "instructions": [
    {
      "step": 1,
      "text": "Heat 2 tablespoons of the oil in a large pot over medium heat. Add the onion and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the ginger, garlic, coriander, cumin, and turmeric. Cook for 2 minutes, until fragrant.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the lentils and hot stock, stirring to coat. Set aside while the cauliflower cooks."
    },
    {
      "step": 4,
      "text": "Heat the remaining oil in a large skillet over medium-high heat. Add the cauliflower and cook until lightly browned, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Transfer the cauliflower to the pot. Add the coconut milk and carrot, then bring to a gentle simmer."
    },
    {
      "step": 6,
      "text": "Simmer for about 10 minutes, stirring occasionally, until the lentils and cauliflower are tender. Stir in the green beans and cook for 4 minutes.",
      "timer_minutes": 14
    },
    {
      "step": 7,
      "text": "Remove from the heat. Stir in the chopped cilantro and lemon juice, then season with the salt and pepper. Garnish with the cilantro sprig."
    }
  ],
