  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Fit the pastry into a tart or quiche tin, trimming the edges, and prick the base. Bake the empty shell for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Simmer the broccoli for 5 minutes, then drain and let it cool.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir the beaten eggs, cream, mustard, and chopped herbs together. Prepare the cheese for sprinkling."
    },
    {
      "step": 4,
      "text": "Spread the onion chutney over the pastry shell, arrange the broccoli on top, and pour in the egg mixture. Sprinkle with the cheese."
    },
    {
      "step": 5,
      "text": "Bake for 40 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Let the quiche cool for 30 minutes before cutting and serving.",
      "timer_minutes": 30
    }
  ],
