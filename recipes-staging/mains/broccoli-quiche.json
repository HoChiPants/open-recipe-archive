  "id": "broccoli-quiche",
  "name": "Broccoli Quiche",
  "subtitle": "A savory pastry tart with broccoli, herbs, cheese, and onion chutney.",
  "description": "A crisp shortcrust shell holds tender broccoli and a creamy mustard-seasoned egg filling finished with mature cheese and fresh herbs.",
  "meal_type": "main",
  "yield": {
    "quantity": 8,
    "unit": "as part of a buffet or 12 as a starter"
  },
