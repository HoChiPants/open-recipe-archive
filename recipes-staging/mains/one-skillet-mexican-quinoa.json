  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large covered skillet over medium heat. Add the jalapeño, garlic, red pepper flakes, salt, and pepper; cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Stir in the black beans, tomatoes, corn, quinoa, chicken broth, chili powder, cumin, and additional salt and pepper as needed."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer, cover, and cook until the quinoa is tender and the dish reaches 165°F throughout.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Remove from the heat and fold in the avocado, lime juice, and cilantro. Serve warm."
    }
  ],
