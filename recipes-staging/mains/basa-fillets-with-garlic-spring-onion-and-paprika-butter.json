  "id": "basa-fillets-with-garlic-spring-onion-and-paprika-butter",
  "name": "Basa Fillets with Garlic, Spring Onion, and Paprika Butter",
  "subtitle": "Pan-cooked fish with a savory butter sauce",
  "description": "Flour-coated basa fillets are cooked in olive oil, then finished with melted butter, garlic, spring onions, and smoked paprika. Serve with cooked rice or potatoes and vegetables.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "basa-fillets-ours-weighed-250g-in-total",
      "item": "basa fillets (ours weighed 250g in total)",
      "quantity": 2
    },
    {
      "ingredient_id": "butter",
      "item": "salted butter",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "spring-onions-finely-sliced",
      "item": "spring onions finely sliced",
      "quantity": 3
    },
    {
      "ingredient_id": "garlic-cloves-grated",
      "item": "garlic cloves grated",
      "quantity": 2
    },
    {
      "ingredient_id": "smoked-sweet-paprika",
      "item": "smoked sweet paprika",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "rice-or-potatoes-and-veg-to-serve",
      "item": "rice or potatoes and veg to serve",
      "preparation": "cooked"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a frying pan over medium heat. Coat the basa fillets lightly with the flour, shaking off the excess."
    },
    {
      "step": 2,
      "text": "Cook the fillets in the hot oil for about 3 minutes, turning as needed, until opaque and easily flaked or until the center reaches 145°F.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Transfer the fish to a plate and drain any excess oil from the pan."
    },
    {
      "step": 4,
      "text": "Melt the salted butter in the pan. Stir in the spring onions and garlic, then cook with the smoked paprika for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Serve the fish with the paprika butter over the cooked rice or potatoes and vegetables."
    }
  ],
