  "id": "chicken-and-chorizo-skewers",
  "name": "Chicken and Chorizo Skewers",
  "subtitle": "Grilled skewers with peppers, onion, and oregano",
  "description": "Chicken and Spanish chorizo are marinated with vinegar, oregano, and cayenne, then grilled with red onion and bell pepper until fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 2,
      "preparation": "boneless chicken breasts, cut into 20 pieces"
    },
    {
      "ingredient_id": "spanish-chorizo",
      "item": "Spanish chorizo",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "cut into 1/2 inch pieces"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sherry-vinegar",
      "item": "sherry vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
