      "item": "fresh oregano",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
      "preparation": "cut into 1-inch squares"
    },
    {
      "ingredient_id": "red-bell-pepper",
      "item": "red bell pepper",
      "quantity": 1,
      "preparation": "cut into 1-inch squares"
    },
    {
      "ingredient_id": "12-inch-bamboo-or-metal-skewers",
      "item": "(12-inch) bamboo or metal skewers",
      "quantity": 4
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill to medium-high heat. If using bamboo skewers, soak them in water for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Combine the chicken, chorizo, olive oil, sherry vinegar, oregano, cayenne, salt, and pepper in a bowl. Add the bell pepper and toss to coat. Marinate for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Thread the chicken, chorizo, red onion, and bell pepper pieces onto the skewers, distributing them evenly."
    },
    {
      "step": 4,
      "text": "Grill the skewers for about 10 minutes, turning occasionally, until the chicken reaches 165°F internally and the ingredients are cooked through.",
      "timer_minutes": 10
    }
  ],
