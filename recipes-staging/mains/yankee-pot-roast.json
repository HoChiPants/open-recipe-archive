  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large heavy pot over medium-high heat. Season the roast with salt and pepper, dredge it in flour, and brown it on all sides. Transfer the roast to a plate."
    },
    {
      "step": 2,
      "text": "Add the onions, carrots, celery, garlic, and allspice berries to the pot. Cook, stirring, until the vegetables are lightly browned."
    },
    {
      "step": 3,
      "text": "Return the roast to the pot. Add the wine and beef broth, bring the liquid to a simmer, and cover."
    },
    {
      "step": 4,
      "text": "Reduce the heat to low and simmer until the roast is tender, about 130 minutes. Check the center with a food thermometer; whole-cut beef should reach at least 145°F, then rest for 3 minutes.",
      "timer_minutes": 130
    },
    {
      "step": 5,
      "text": "Transfer the roast to a cutting board and let it rest for 10 minutes. Keep the vegetables and broth in the pot.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Stir the cornstarch mixture into the simmering broth and cook until the gravy thickens."
    },
    {
      "step": 7,
      "text": "Slice the roast and serve it with the vegetables and gravy."
    }
  ],
