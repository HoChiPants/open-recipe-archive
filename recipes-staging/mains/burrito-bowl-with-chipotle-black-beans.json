  "instructions": [
    {
      "step": 1,
      "text": "Cook the basmati rice according to the package directions."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet over medium heat. Add the chopped garlic and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir in the black beans, cider vinegar, honey, chipotle paste, and chipotle hot sauce. Warm through."
    },
    {
      "step": 4,
      "text": "Prepare the avocado, tomato, and red onion while the beans heat.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Add the chopped kale to the skillet and simmer for 1 minute, until just wilted.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Divide the rice between two bowls. Top with the beans and kale, then add the avocado, tomato, and red onion."
    },
    {
      "step": 7,
      "text": "Serve with coriander leaves, lime wedges, and chipotle hot sauce."
    }
  ],
