  "id": "burrito-bowl-with-chipotle-black-beans",
  "name": "Burrito Bowl with Chipotle Black Beans",
  "subtitle": "Rice, greens, and fresh toppings with smoky beans",
  "description": "A simple vegetarian bowl layering basmati rice, chipotle-seasoned black beans, kale, avocado, and fresh vegetables.",
  "meal_type": "main",
  "cuisine": "Mexican",
  "yield": {
