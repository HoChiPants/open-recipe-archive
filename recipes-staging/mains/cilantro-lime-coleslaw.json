  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the shredded cabbage, diced red onion, and chopped cilantro in a large bowl."
    },
    {
      "step": 2,
      "text": "In a separate bowl, whisk the mayonnaise, lime zest, lime juice, rice vinegar, minced garlic, sweet chili sauce, and sugar until smooth."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the cabbage mixture and toss until evenly coated."
    }
