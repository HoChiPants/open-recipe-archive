  "id": "cilantro-lime-coleslaw",
  "name": "Cilantro-Lime Coleslaw",
  "subtitle": "Bright, creamy cabbage slaw with fresh lime and cilantro",
  "description": "A crisp cabbage slaw dressed with tangy lime, sweet chili, garlic, and cilantro.",
  "meal_type": "main",
