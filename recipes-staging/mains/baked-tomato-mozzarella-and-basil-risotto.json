{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "baked-tomato-mozzarella-and-basil-risotto",
  "name": "Baked Tomato, Mozzarella, and Basil Risotto",
  "subtitle": "A creamy oven-baked rice dish with tomatoes, basil, and a crisp cheese topping.",
  "description": "Risotto rice cooks in hot vegetable stock before being finished with tomatoes, basil, cheese, and breadcrumbs, then baked until tender and golden.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "onion-finely-chopped",
      "item": "onion finely chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "arborio-rice",
      "item": "arborio rice",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "glass-of-white-wine-optional",
      "item": "glass of white wine (optional)",
      "unit": "small",
      "preparation": "or 100ml extra stock",
      "optional": true
    },
    {
      "ingredient_id": "hot-vegetable-stock",
      "item": "hot vegetable stock",
      "quantity": 750,
      "unit": "ml"
    },
    {
      "ingredient_id": "cherry-tomatoes-halved",
      "item": "cherry tomatoes halved",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "handful-of-basil-leaves-finely-shredded",
      "item": "handful of basil leaves finely shredded",
      "unit": "small",
      "preparation": "plus a few extra small leaves to serve"
    },
    {
      "ingredient_id": "parmesan-or-vegetarian-alternative",
      "item": "parmesan or vegetarian alternative",
      "quantity": 25,
      "unit": "g",
      "preparation": "finely grated"
    },
    {
      "ingredient_id": "ball-mozzarella-torn-into-small-chunks",
      "item": "ball mozzarella torn into small chunks",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "dried-breadcrumbs-panko-are-good-but-any-will-do",
      "item": "dried breadcrumbs (panko are good but any will do)",
      "quantity": 25,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in an ovenproof pan. Add the onion and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the arborio rice. Add the white wine, if using, and cook for 2 minutes; otherwise use the extra stock.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Pour in the hot vegetable stock, stir, and bake for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir in the tomatoes, shredded basil, and grated parmesan or vegetarian alternative."
    },
    {
      "step": 6,
      "text": "Scatter the mozzarella over the rice. Mix the olive oil, parmesan or vegetarian alternative, and breadcrumbs, then sprinkle over the top."
    },
    {
      "step": 7,
      "text": "Bake until the rice is cooked through and the topping is golden, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Serve with the reserved basil leaves."
    }
  ],
