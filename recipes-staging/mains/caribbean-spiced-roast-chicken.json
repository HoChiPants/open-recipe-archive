  "id": "caribbean-spiced-roast-chicken",
  "name": "Caribbean-Spiced Roast Chicken",
  "subtitle": "Aromatic spices, lime, and rum for a warmly seasoned roast.",
  "description": "A whole chicken is coated with a sweet, tangy rum-lime mixture and fragrant Caribbean-inspired spices, then roasted until fully cooked.",
  "meal_type": "main",
  "cuisine": "Caribbean",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-lime-juice",
      "item": "fresh lime juice",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fluid-ounces-rum",
      "item": "fluid ounces rum",
      "quantity": 2
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-clove",
      "item": "ground clove",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-thyme-leaves",
      "item": "dried thyme leaves",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "3-pound-whole-chicken",
      "item": "(3 pound) whole chicken",
      "quantity": 1
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Stir together the lime juice, rum, and brown sugar until the sugar dissolves."
    },
    {
      "step": 2,
      "text": "Mix the cayenne, clove, cinnamon, ginger, black pepper, salt, and thyme."
    },
    {
      "step": 3,
      "text": "Pat the chicken dry, rub it with the oil, and coat it evenly with the lime-rum mixture and spice blend. Place it in a roasting pan."
    },
    {
      "step": 4,
      "text": "Roast for 90 minutes, or until the thickest part of the thigh reaches 165°F on a food thermometer.",
      "timer_minutes": 90
    },
    {
      "step": 5,
      "text": "Transfer the chicken to a board and rest for 10 minutes before carving.",
      "timer_minutes": 10
    }
  ],
