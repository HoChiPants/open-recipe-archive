  "instructions": [
    {
      "step": 1,
      "text": "Heat 1 teaspoon vegetable oil in a pot over medium-high heat. Add the chicken and cook briefly, turning as needed. Add 4 minutes of the divided chicken broth, cover, and cook until the chicken reaches 165°F in the thickest part. Transfer it to a plate to cool, then cut or shred it.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Heat the remaining 1 teaspoon vegetable oil in the pot. Add the onion, season with salt and pepper, and cook until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the garlic and cook for 1 minute. Add the ancho chile powder, cumin, flour, chipotle powder, oregano, and cayenne; stir until the onion is coated and the spices are fragrant.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Stir in the remaining divided chicken broth, then whisk in the cornmeal. Add the white beans and 1 cup chicken broth, and bring the chili to a gentle simmer.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Return the chicken to the pot. Simmer until heated through and slightly thickened, then adjust the seasoning with sugar, cayenne, salt, and pepper."
    },
    {
      "step": 6,
      "text": "Serve with green onions, sour cream, and cilantro."
    }
  ],
