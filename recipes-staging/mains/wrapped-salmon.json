  "id": "wrapped-salmon",
  "name": "Wrapped Salmon",
  "subtitle": "Phyllo-wrapped salmon with Dijon mustard",
  "description": "Salmon fillets are coated with Dijon mustard, wrapped in buttered phyllo, and baked until crisp and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "6-ounce-fillets-salmon",
      "item": "(6 ounce) fillets salmon",
      "quantity": 4,
      "preparation": "with skin and bones removed"
    },
    {
      "ingredient_id": "sheets-phyllo-dough",
      "item": "sheets phyllo dough",
      "quantity": 8
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 4,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Cut the phyllo sheets as needed for wrapping. Brush the sheets with melted butter."
    },
    {
      "step": 3,
      "text": "Place one salmon fillet on the prepared phyllo. Season with salt and pepper, then coat with Dijon mustard."
    },
    {
      "step": 4,
      "text": "Fold the phyllo around each fillet to enclose it completely. Place the wrapped fillets on a baking sheet and brush the tops with melted butter."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, until the phyllo is golden brown and the salmon reaches 145°F internally or is opaque and flakes easily.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Let rest for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
