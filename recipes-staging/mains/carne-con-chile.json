  "id": "carne-con-chile",
  "name": "Carne con Chile",
  "subtitle": "Pork simmered with roasted green chiles and tomatillos",
  "description": "A savory Mexican pork stew built around a smooth roasted tomatillo and chile sauce.",
  "meal_type": "main",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-tomatillos",
      "item": "fresh tomatillos",
      "quantity": 20,
      "preparation": "husks removed"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 2,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "serrano-chile-peppers",
      "item": "serrano chile peppers",
      "quantity": 7,
      "preparation": "chopped (wear gloves)"
    },
    {
      "ingredient_id": "fresh-chile-de-arbol-peppers",
      "item": "fresh chile de arbol peppers",
      "quantity": 10,
      "preparation": "chopped (wear gloves)"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 5,
      "unit": "cloves",
      "preparation": "divided"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "pork-stew-meat",
      "item": "pork stew meat",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "coarsely chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Wear gloves when handling the chiles. Roast the tomatillos, tomatoes, serranos, chile de arbol peppers, and half the garlic for 10 minutes, until tender.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Blend the roasted vegetables and garlic until smooth. Stir in the remaining garlic and season with salt to taste.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Cook the pork stew meat in a pot for 30 minutes, then add the chile sauce and continue cooking until the pork is tender.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Check the thickest pieces with a food thermometer; pork whole cuts should reach 145°F, then rest for 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
