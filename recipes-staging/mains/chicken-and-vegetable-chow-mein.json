  "instructions": [
    {
      "step": 1,
      "text": "Whisk the soy sauce, cornstarch, and sesame oil until smooth. Coat the chicken with the mixture and chill for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Stir together the chicken broth, oyster sauce, and white sugar to make the sauce."
    },
    {
      "step": 3,
      "text": "Cook the chow mein noodles according to the package directions until cooked through, then drain.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Heat the vegetable oil in a large skillet or wok over medium-high heat. Add the garlic and cook briefly until fragrant."
    },
    {
      "step": 5,
      "text": "Add the chilled chicken and stir-fry until no longer pink and a thermometer inserted into the thickest piece reads 165°F.",
      "timer_minutes": 6
    },
    {
      "step": 6,
      "text": "Add the bok choy, zucchini, sugar snap peas, and carrot. Stir-fry until the vegetables are crisp-tender.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Pour in the sauce and add the drained noodles. Toss until everything is hot and evenly coated.",
      "timer_minutes": 2
    },
    {
      "step": 8,
      "text": "Transfer to serving bowls and scatter the green onion over the top."
    }
  ],
