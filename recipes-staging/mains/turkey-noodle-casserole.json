  "id": "turkey-noodle-casserole",
  "name": "Turkey Noodle Casserole",
  "subtitle": "Creamy baked noodles with turkey, peppers, and a crisp topping",
  "description": "A creamy turkey and egg noodle casserole finished with melted pepperjack cheese and crushed potato chips.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "egg-noodles",
      "item": "egg noodles",
      "quantity": 12,
      "unit": "ounces"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cold-milk",
      "item": "cold milk",
      "quantity": 3.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "red-bell-pepper",
      "item": "red bell pepper",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "garam-masala",
      "item": "garam masala",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-tarragon",
      "item": "dried tarragon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "pepperjack-cheese",
      "item": "pepperjack cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "skinless-cooked-turkey",
      "item": "skinless cooked turkey",
      "quantity": 3,
      "unit": "cups",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "potato-chips",
      "item": "potato chips",
      "quantity": 5,
      "unit": "ounces",
      "preparation": "crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Bring a pot of water seasoned with the salt to a simmer. Add the egg noodles and skinless cooked turkey, and simmer for 4 minutes, until the noodles are cooked through. Drain.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Melt the butter in a saucepan. Whisk in the flour, then stir for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Gradually add the cold milk, stirring until smooth. Stir in the condensed cream of mushroom soup, red bell pepper, green bell pepper, green onions, garam masala, and dried tarragon. Simmer for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Combine the drained noodles and turkey with the sauce and pepperjack cheese, then transfer the mixture to a baking dish."
    },
    {
      "step": 6,
      "text": "Top with the crushed potato chips. Bake for 30 minutes, until golden brown and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
