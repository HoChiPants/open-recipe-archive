{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "asian-beef-and-vegetable-stir-fry",
  "name": "Asian Beef and Vegetable Stir-Fry",
  "subtitle": "Tender beef and crisp vegetables in a quick savory sauce",
  "description": "Sear beef with garlic, toss it with tender vegetables and stir-fry sauce, then serve over rice with peanuts.",
  "meal_type": "main",
  "cuisine": "Chinese",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "beef-top-sirloin-steak-boneless",
      "item": "beef top sirloin steak boneless",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut 1 inch thick"
    },
    {
      "ingredient_id": "assorted-fresh-vegetables",
      "item": "assorted fresh vegetables",
      "quantity": 4,
      "unit": "cups",
      "preparation": "such as sugar snap peas, broccoli florets, bell pepper and carrot strips"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "prepared-stir-fry-sauce",
      "item": "prepared stir-fry sauce",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "red-pepper",
      "item": "red pepper",
      "quantity": 0.125,
      "unit": "teaspoon",
      "preparation": "crushed, or to taste"
    },
    {
      "ingredient_id": "hot-cooked-rice",
      "item": "hot cooked rice",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "unsalted-dry-roasted-peanuts",
      "item": "unsalted dry-roasted peanuts",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the steak as specified. Stir-fry the vegetables for about 4 minutes, until tender-crisp; transfer them to a plate and drain any excess liquid.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Stir together the prepared stir-fry sauce and crushed red pepper until set aside."
    },
    {
      "step": 3,
      "text": "Preheat a wok or large skillet over high heat. Add the beef and garlic, then stir-fry for about 2 minutes, until the beef reaches 145°F on a food thermometer. Remove the beef and let it rest for 3 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Return the beef and vegetables to the pan, add the sauce mixture, and toss until heated through and evenly coated."
    },
    {
      "step": 5,
      "text": "Serve over the hot cooked rice and top with the peanuts."
    }
  ],
