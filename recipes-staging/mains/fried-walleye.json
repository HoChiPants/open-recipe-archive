  "id": "fried-walleye",
  "name": "Fried Walleye",
  "subtitle": "Crisp cracker-coated fillets with lemon",
  "description": "Walleye fillets are seasoned, dipped in egg, coated with crushed crackers, and fried until golden and flaky.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "walleye-fillets",
      "item": "walleye fillets",
      "quantity": 4
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "saltine-crackers",
      "item": "saltine crackers",
      "quantity": 2,
      "unit": "cups",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1,
      "preparation": "cut into wedges"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pat the walleye fillets dry. Combine the flour, garlic powder, black pepper, and salt in a shallow dish; place the beaten eggs and crushed crackers in separate shallow dishes."
    },
    {
      "step": 2,
      "text": "Heat enough vegetable oil for frying to 375°F in a skillet or deep pan."
    },
    {
      "step": 3,
      "text": "Coat each fillet in the seasoned flour, dip it in the beaten eggs, then press it into the crushed crackers."
    },
    {
      "step": 4,
      "text": "Fry the fillets in batches for about 3 minutes per side, turning once, until golden brown and the fish reaches 145°F or is opaque and flakes easily.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Drain briefly and serve with the lemon wedges."
    }
  ],
