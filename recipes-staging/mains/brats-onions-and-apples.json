  "id": "brats-onions-and-apples",
  "name": "Brats, Onions, and Apples",
  "subtitle": "Sausage simmered with sweet apples and onions",
  "description": "Brown bratwurst, then simmer it with tender apples, onions, and beer for a savory-sweet skillet meal.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "bratwurst",
      "item": "bratwurst",
      "quantity": 4
    },
    {
      "ingredient_id": "apple",
      "item": "apple",
      "quantity": 2,
      "preparation": "cored and sliced"
    },
    {
      "ingredient_id": "sweet-onion",
      "item": "sweet onion",
      "quantity": 1,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "or-bottles-beer",
      "item": "or bottles beer",
      "quantity": 2,
      "unit": "can",
      "preparation": "12 fluid ounce"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet over medium-high heat."
    },
    {
      "step": 2,
      "text": "Add the bratwurst and cook, turning occasionally, for 3 minutes. Transfer the brats to a plate.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the apples and sliced onion to the skillet. Stir, then cook the onion mixture until softened, about 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Return the bratwurst to the skillet, pour in the beer, and season with salt and pepper."
    },
    {
      "step": 5,
      "text": "Bring to a simmer and cook until the brats are fully cooked and reach 160°F internally, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Serve the bratwurst with the apples and onions."
    }
  ],
