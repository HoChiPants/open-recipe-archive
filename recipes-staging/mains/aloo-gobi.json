  "instructions": [
    {
      "step": 1,
      "text": "Heat 2 tablespoons oil in a large skillet over medium heat. Add the cumin seed and cook until golden and fragrant."
    },
    {
      "step": 2,
      "text": "Add the onion and cook, stirring often, until lightly browned. Stir in the serrano chile peppers and ginger paste; cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Stir in the ground coriander, turmeric powder, cayenne pepper, garam masala, and paprika. Cook briefly, stirring, until fragrant."
    },
    {
      "step": 4,
      "text": "Add the baking potatoes, salt, and remaining 1 tablespoon oil. Cook, stirring occasionally, for 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Add the cauliflower, cover, and cook over medium-low heat until the vegetables are tender, about 20 minutes. Stir occasionally to prevent sticking.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Stir in the lemon juice and cook uncovered for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
