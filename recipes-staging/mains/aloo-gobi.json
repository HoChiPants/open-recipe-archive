  "id": "aloo-gobi",
  "name": "Aloo Gobi",
  "subtitle": "Spiced potatoes and cauliflower cooked on the stovetop",
  "description": "A dry-style Indian potato and cauliflower dish seasoned with toasted cumin, chile, ginger, and warm spices.",
  "meal_type": "main",
  "cuisine": "Indian",
  "yield": {
    "quantity": 6,
    "unit": "servings"
