  "id": "shrimp-mac-and-cheese",
  "name": "Shrimp Mac and Cheese",
  "subtitle": "Creamy baked macaroni with seasoned shrimp and a crisp crumb topping",
  "description": "A compact baked pasta dish combining Cheddar sauce, sour cream, Cajun seasoning, and shrimp under a panko topping.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "elbow-macaroni",
      "item": "elbow macaroni",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "1-milk",
      "item": "1% milk",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "sharp-cheddar-cheese",
      "item": "sharp Cheddar cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cajun-seasoning",
      "item": "Cajun seasoning",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "frozen-salad-shrimp",
      "item": "frozen salad shrimp",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "panko-bread-crumbs",
      "item": "panko bread crumbs",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sharp-cheddar-cheese",
      "item": "sharp Cheddar cheese",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the elbow macaroni in boiling water for 8 minutes, then drain.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Melt the butter in a saucepan. Stir in the flour and cook until smooth."
    },
    {
      "step": 4,
      "text": "Gradually add the milk, then whisk in the shredded Cheddar, sour cream, and Cajun seasoning until combined."
    },
    {
      "step": 5,
      "text": "Stir in the macaroni and frozen salad shrimp."
    },
    {
      "step": 6,
      "text": "Transfer the mixture to a baking dish. Top with the remaining shredded Cheddar and panko bread crumbs."
    },
    {
      "step": 7,
      "text": "Bake for 20 minutes, until hot throughout and the shrimp are opaque.",
      "timer_minutes": 20
    }
  ],
