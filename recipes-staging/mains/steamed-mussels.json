  "id": "steamed-mussels",
  "name": "Steamed Mussels",
  "subtitle": "Mussels steamed with shallots, white wine, and parsley",
  "description": "A simple shellfish main course featuring mussels gently steamed in a shallot and white-wine broth.",
  "meal_type": "main",
  "cuisine": "American",
