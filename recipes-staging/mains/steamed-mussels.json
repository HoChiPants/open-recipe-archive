      "item": "ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large pot over medium heat. Add the shallots and cook until softened."
    },
    {
      "step": 2,
      "text": "Add the wine and mussels. Cover the pot and steam for 5 minutes, or until the mussels open.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the parsley and black pepper. Discard any mussels that remain closed, then serve immediately."
    }
