  "id": "italian-sausage-spaghetti",
  "name": "Italian Sausage Spaghetti",
  "subtitle": "Slow-simmered marinara with sausage and Parmesan",
  "description": "Sweet Italian sausage is simmered in marinara until tender and flavorful, then served over spaghetti with Parmesan and parsley.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 115
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "6-ounce-sweet-italian-sausage-links",
      "item": "(6 ounce) sweet Italian sausage links",
      "quantity": 4
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "32-ounce-jar-marinara-sauce",
      "item": "(32 ounce) jar marinara sauce",
      "quantity": 1
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "spaghetti",
      "item": "spaghetti",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "freshly-grated-parmigiano-reggiano-cheese",
      "item": "freshly grated Parmigiano-Reggiano cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flat-leaf-italian-parsley",
      "item": "flat-leaf (Italian) parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped, or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet or pot over medium heat. Add the sausage links and cook for about 5 minutes, turning, until browned and cooked through; verify sausage reaches 160°F with a food thermometer.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Pour in the white wine and stir, scraping up any browned bits. Simmer for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the marinara sauce and water. Bring the sauce to a simmer, then cut the sausage links into pieces and return them to the sauce."
    },
    {
      "step": 4,
      "text": "Cover partially and simmer gently until the sauce thickens and the sausage is tender, about 60 minutes. Continue cooking uncovered for about 30 minutes if needed to reach a thick consistency.",
      "timer_minutes": 90
    },
    {
      "step": 5,
      "text": "Meanwhile, bring the water to a boil and cook the spaghetti according to the package timing, about 11 minutes. Drain and combine with the marinara sauce.",
      "timer_minutes": 11
    },
    {
      "step": 6,
      "text": "Divide the spaghetti among bowls and top with the sausage, Parmigiano-Reggiano, and parsley."
    }
  ],
