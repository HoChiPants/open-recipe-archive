  "instructions": [
    {
      "step": 1,
      "text": "Boil the cashews, then leave them to soak and soften for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Blend the softened cashews with the lemon juice until smooth. Stir in the yogurt, ginger, garlic, cream, turmeric, chilli powder, carom seeds if using, garam masala, cumin, and pepper."
    },
    {
      "step": 3,
      "text": "Coat the drumsticks thoroughly with the marinade and leave them to rest for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Preheat the oven and a suitable pan with the ghee or sunflower oil."
    },
    {
      "step": 5,
      "text": "Arrange the drumsticks in the hot pan and cook until browned, then transfer them to the oven for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Continue cooking for another 15 minutes, then grill for 4 minutes to finish. Check that the thickest part of each drumstick reaches 165°F.",
      "timer_minutes": 19
    },
    {
      "step": 7,
      "text": "Transfer to a serving dish and serve with the lemon wedges and red onion rings."
    }
  ],
