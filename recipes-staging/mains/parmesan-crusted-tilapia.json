  "id": "parmesan-crusted-tilapia",
  "name": "Parmesan-Crusted Tilapia",
  "subtitle": "A crisp, savory baked fish dinner",
  "description": "Tilapia fillets are coated with seasoned Parmesan and baked until opaque and easily flaked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
