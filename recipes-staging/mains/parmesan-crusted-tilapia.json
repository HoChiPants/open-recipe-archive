  "ingredients": [
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "tilapia-fillets",
      "item": "tilapia fillets",
      "quantity": 4
    },
    {
      "ingredient_id": "drizzle-olive-oil",
      "item": "drizzle olive oil",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Whisk together the Parmesan, parsley, paprika, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Drizzle the tilapia with olive oil, then press the Parmesan mixture over the fillets to coat."
    },
    {
      "step": 4,
      "text": "Arrange the coated fillets in a baking dish and bake for 12 minutes, until the fish reaches 145°F or is opaque and flakes easily with a fork.",
      "timer_minutes": 12
    }
  ],
