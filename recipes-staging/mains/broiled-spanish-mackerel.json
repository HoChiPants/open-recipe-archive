      "ingredient_id": "slices-lemon",
      "item": "slices lemon",
      "quantity": 12
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the broiler. Arrange the mackerel fillets in a broiler-safe pan and coat them with the olive oil."
    },
    {
      "step": 2,
      "text": "Season the fillets with paprika, salt, and black pepper, then place the lemon slices over and around them."
    },
    {
      "step": 3,
      "text": "Broil until the fish is opaque, flakes easily, and reaches 145°F internally, checking at about 5 minutes and allowing up to 7 minutes as needed.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Serve immediately with the broiled lemon slices."
    }
  ],
