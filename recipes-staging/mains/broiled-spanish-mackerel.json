  "id": "broiled-spanish-mackerel",
  "name": "Broiled Spanish Mackerel",
  "subtitle": "Paprika-seasoned mackerel with lemon",
  "description": "Spanish mackerel fillets are coated with olive oil and paprika, broiled until opaque and flaky, and finished with lemon.",
  "meal_type": "main",
  "cuisine": "American",
