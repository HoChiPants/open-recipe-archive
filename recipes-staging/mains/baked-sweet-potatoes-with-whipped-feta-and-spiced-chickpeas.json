  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven and place the sweet potatoes on a baking tray. Bake until tender, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 2,
      "text": "Toss the drained chickpeas with the oil, cumin seeds, ground coriander, smoked paprika, and chilli flakes. Roast until browned and crisp, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Blend or whisk the tahini with the chopped coriander, garlic, juice of two limes, and enough reserved chickpea liquid to make a pourable green sauce."
    },
    {
      "step": 4,
      "text": "Beat the feta and Greek yogurt together until smooth."
    },
    {
      "step": 5,
      "text": "Split the baked sweet potatoes and transfer them to plates. Add the whipped feta and spiced chickpeas, drizzle with green tahini, and serve with the remaining lime cut into wedges and the reserved coriander leaves."
    }
  ],
