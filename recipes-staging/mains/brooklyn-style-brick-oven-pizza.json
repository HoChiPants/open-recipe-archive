  "instructions": [
    {
      "step": 1,
      "text": "Combine the warm water, yeast, and cold water. Let stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the salt and crushed tomatoes, then add the bread flour. Knead for 10 minutes, until the dough is smooth.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Shape the dough, coat it with 1 tablespoon olive oil, and let it rest, covered, for 16 hours.",
      "timer_minutes": 960
    },
    {
      "step": 4,
      "text": "Divide and stretch the dough into thin portions. Preheat the oven to 550°F."
    },
    {
      "step": 5,
      "text": "Transfer the dough to a floured baking surface and top with the sliced mozzarella, oregano, pepper, remaining olive oil, and crushed tomatoes."
    },
    {
      "step": 6,
      "text": "Bake for 6 minutes, then continue baking until the crust is browned and the cheese is melted, about 4 minutes more.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Top with the torn basil, cut into pieces, and serve."
    }
  ],
