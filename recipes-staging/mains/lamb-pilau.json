  "instructions": [
    {
      "step": 1,
      "text": "Rinse the basmati rice until the water runs mostly clear, then soak it and set aside while preparing the lamb."
    },
    {
      "step": 2,
      "text": "Heat the ghee and vegetable oil in a large heavy pot. Add the bay leaves, cinnamon sticks, cardamom pods, crushed garlic, crushed or grated ginger, and one portion of the sliced onions. Cook until fragrant.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the lamb and brown it on all sides. Stir in the curry powder, ground coriander, cumin, turmeric, and the remaining ghee. Add enough water to cover, bring to a boil, then simmer until the lamb is tender and reaches 145°F in the thickest pieces; rest it for 3 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "While the lamb cooks, heat the remaining oil or ghee in a separate pan. Fry the matchstick ginger and remaining sliced onions with the cloves, black peppercorns, bay leaves, cinnamon sticks, cardamom, and green chillies until golden brown. Set this aromatic mixture aside.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Drain the rice. Bring a large pot of water to a boil, add the rice, and cook until just tender. Drain thoroughly.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Layer the rice over the lamb, top with the fried aromatics, cover tightly, and cook over low heat until the rice is fully tender and the flavors have melded.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Fluff gently, spoon into a serving dish, and finish with extra ghee if desired."
    }
  ],
