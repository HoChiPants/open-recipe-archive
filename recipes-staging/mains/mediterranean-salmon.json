  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the olive oil, balsamic vinegar, garlic, garlic salt, cilantro, and basil in a shallow dish."
    },
    {
      "step": 2,
      "text": "Add the salmon and turn to coat. Let it marinate for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Preheat the grill and lightly oil the grates if needed."
    },
    {
      "step": 4,
      "text": "Grill the salmon for about 8 minutes, turning once if appropriate, until it reaches 145°F or is opaque and flakes easily.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
