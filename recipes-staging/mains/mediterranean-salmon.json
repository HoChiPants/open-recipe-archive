  "id": "mediterranean-salmon",
  "name": "Mediterranean Salmon",
  "subtitle": "Herb-marinated salmon finished on the grill",
  "description": "Salmon fillets are coated in a balsamic, garlic, and herb marinade, rested briefly, then grilled until opaque and flaky.",
  "meal_type": "main",
  "cuisine": "Mediterranean Inspired",
