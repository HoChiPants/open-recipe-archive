  "instructions": [
    {
      "step": 1,
      "text": "Simmer the sliced potatoes, garlic, and spring onions in boiling water for 5 minutes, until the potatoes are tender. Drain well.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Heat the olive oil in an ovenproof frying pan. Add the potatoes, broad beans, and peas, and cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Whisk the dill, lemon zest, eggs, and milk together. Pour into the pan and cook for 4 minutes, until the base begins to set.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Heat the grill. Dot the ricotta over the frittata, then place the pan under the grill for about 3 minutes, until the center is firm and fully set, or reaches 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Serve hot with the green salad."
    }
  ],
