  "instructions": [
    {
      "step": 1,
      "text": "Place the beef shank in a large pot and cover with the water. Add the onion, carrots, celery, and bay leaf."
    },
    {
      "step": 2,
      "text": "Bring the liquid to a gentle simmer, then cook until the beef is tender and reaches 145°F internally. Remove the beef and let it rest for 3 minutes.",
      "timer_minutes": 240
    },
    {
      "step": 3,
      "text": "Cut or pull the rested beef from the bone. Return the meat to the pot with the beets and cabbage."
    },
    {
      "step": 4,
      "text": "Simmer until the beets are tender and the cabbage is softened.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Stir in the vinegar, salt, and pepper. Taste and adjust the vinegar or seasoning as needed."
    },
    {
      "step": 6,
      "text": "Whisk the sour cream with the dill, then serve the hot soup with the dill cream for garnish."
    }
  ],
