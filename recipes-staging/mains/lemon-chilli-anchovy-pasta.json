  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil with the garlic over low heat for 3 minutes, then continue gently for 15 minutes to infuse the oil.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Cook the pasta in salted boiling water until al dente. Reserve a little cooking water, then drain."
    },
    {
      "step": 3,
      "text": "Remove the garlic if desired. Add the chopped anchovies and chilli to the infused oil and cook until the anchovies break down; use a thermometer to confirm the fish mixture reaches 145°F."
    },
    {
      "step": 4,
      "text": "Toss the drained pasta with the anchovy oil, lemon zest and juice, parsley, and enough reserved pasta water to loosen."
    },
    {
      "step": 5,
      "text": "Finish with the grated parmesan and serve immediately."
    }
  ],
