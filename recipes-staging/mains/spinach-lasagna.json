  "id": "spinach-lasagna",
  "name": "Spinach Lasagna",
  "subtitle": "Layered pasta with creamy spinach and cheese",
  "description": "Tender lasagna noodles layered with seasoned spinach-ricotta filling, pasta sauce, and a browned cheese topping.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 6,
