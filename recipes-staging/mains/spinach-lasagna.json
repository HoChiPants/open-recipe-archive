  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F and coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Bring a pot of water seasoned with salt and pepper to a simmer. Add the spinach and cook for 2 minutes, until tender. Drain, cool briefly, and squeeze out excess moisture.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Cook the lasagna noodles in boiling water for 8 minutes, then drain.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Combine the spinach, ricotta, mozzarella, beaten egg, nutmeg, basil, Parmesan, and additional salt and pepper to taste."
    },
    {
      "step": 5,
      "text": "Spread some pasta sauce in the baking dish. Layer noodles, sauce, and spinach filling, repeating until the ingredients are used. Finish with ricotta, mozzarella, and Parmesan on top."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until lightly browned and the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Let the lasagna stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
