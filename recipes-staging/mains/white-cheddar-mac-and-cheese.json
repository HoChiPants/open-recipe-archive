  "id": "white-cheddar-mac-and-cheese",
  "name": "White Cheddar Mac and Cheese",
  "subtitle": "Creamy stovetop macaroni with a crisp savory topping",
  "description": "Macaroni cooks in a single pan with seasoned milk and water, then is coated in white Cheddar and Parmesan before a brief broil with panko and bacon bits.",
  "meal_type": "main",
  "cuisine": "American",
