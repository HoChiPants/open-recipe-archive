  "instructions": [
    {
      "step": 1,
      "text": "Heat the milk, water, garlic salt, and salt in an oven-safe pan until simmering."
    },
    {
      "step": 2,
      "text": "Stir in the macaroni and cook for 10 minutes, or until tender, stirring as needed.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Set the broiler to high. Add the margarine and black pepper to the pan, stirring until the margarine melts."
    },
    {
      "step": 4,
      "text": "Mix in the white Cheddar and half of the Parmesan until melted and smooth, then fold in the panko, bacon bits, and remaining Parmesan."
    },
    {
      "step": 5,
      "text": "Broil for 3 minutes, until the topping is lightly browned.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Scatter the chives over the macaroni and serve hot."
    }
  ],
