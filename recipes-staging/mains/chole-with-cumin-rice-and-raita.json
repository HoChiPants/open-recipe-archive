  "id": "chole-with-cumin-rice-and-raita",
  "name": "Chole with Cumin Rice and Raita",
  "subtitle": "A warmly spiced chickpea meal with fragrant rice and cool yogurt relish",
  "description": "Simmer chickpeas in a ginger-garlic tomato sauce and serve with cumin rice and refreshing cucumber raita.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
