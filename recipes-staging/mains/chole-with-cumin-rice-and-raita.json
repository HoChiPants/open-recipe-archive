  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a saucepan over medium heat. Add the onion and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in 3 teaspoons of the cumin seeds, the ginger, garlic, and curry powder. Cook briefly until fragrant."
    },
    {
      "step": 3,
      "text": "Add the chickpeas, tomato purée, and half of the coriander. Stir well and simmer until hot and thickened."
    },
    {
      "step": 4,
      "text": "Meanwhile, bring a separate pot of water to a boil. Add the remaining cumin seeds and basmati rice, then cook until the rice is tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Drain the rice and fluff it gently."
    },
    {
      "step": 6,
      "text": "Mix the cucumber, yogurt, toasted and crushed cumin seeds, and mint in a bowl."
    },
    {
      "step": 7,
      "text": "Serve the chole with the cumin rice and raita. Scatter over the remaining coriander and optional pomegranate seeds."
    }
  ],
