  "id": "creamy-german-coleslaw",
  "name": "Creamy German Coleslaw",
  "subtitle": "Crisp cabbage with a tangy, creamy dressing",
  "description": "Thinly sliced cabbage is coated in a smooth vinegar-mayonnaise dressing and chilled before serving.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "head-cabbage",
      "item": "head cabbage",
      "quantity": 0.5,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cider-vinegar",
      "item": "cider vinegar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "celery-seed",
      "item": "celery seed",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the sliced cabbage in a large bowl."
    },
    {
      "step": 2,
      "text": "Whisk the sugar, cider vinegar, celery seed, salt, and mayonnaise until smooth."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the cabbage and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Cover and refrigerate for about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Stir the coleslaw before serving."
    }
  ],
