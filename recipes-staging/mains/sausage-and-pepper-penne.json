  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of salted water to a simmer, add the penne, and cook for 11 minutes, or until tender. Drain.",
      "timer_minutes": 11
    },
    {
      "step": 2,
      "text": "Heat the coconut oil in a large skillet. Add the sliced sausage, onion, bell peppers, mushrooms, black pepper, and red pepper flakes. Cook for 10 minutes, stirring, until the vegetables are tender and the sausage reaches 160°F in the center.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the diced tomatoes, tomato sauce, garlic, garlic powder, oregano, basil, and salt. Simmer for 10 minutes to blend the flavors.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the drained penne and toss with the sauce before serving."
    }
