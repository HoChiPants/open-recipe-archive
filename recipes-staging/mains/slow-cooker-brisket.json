  "ingredients": [
    {
      "ingredient_id": "3-pound-beef-brisket",
      "item": "(3 pound) beef brisket",
      "quantity": 1
    },
    {
      "ingredient_id": "chili-sauce",
      "item": "chili sauce",
      "quantity": 2,
      "unit": "bottle",
      "preparation": "12 ounce"
    },
    {
      "ingredient_id": "1-ounce-envelope-dry-onion-soup-mix",
      "item": "(1 ounce) envelope dry onion soup mix",
      "quantity": 1
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the beef brisket in a slow cooker."
    },
    {
      "step": 2,
      "text": "Stir together the chili sauce, dry onion soup mix, and garlic powder, then pour the mixture over the brisket."
    },
    {
      "step": 3,
      "text": "Cover and cook until the brisket is tender and reaches 145°F in the thickest part. Turn off the cooker and let the meat rest for 3 minutes.",
      "timer_minutes": 600
    },
    {
      "step": 4,
      "text": "Slice the brisket across the grain and serve with the sauce."
    }
  ],
