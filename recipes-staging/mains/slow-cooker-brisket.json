  "id": "slow-cooker-brisket",
  "name": "Slow Cooker Brisket",
  "subtitle": "Tender beef brisket in a savory chili-onion sauce",
  "description": "A simple slow-cooked brisket finished with a savory chili sauce and onion seasoning.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
