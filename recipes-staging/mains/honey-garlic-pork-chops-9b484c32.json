  "id": "honey-garlic-pork-chops-9b484c32",
  "name": "Honey-Garlic Pork Chops",
  "subtitle": "Skillet-seared pork with a glossy honey-garlic sauce",
  "description": "Seasoned pork chops are browned in olive oil, then finished with a quick honey, garlic, vinegar, and butter sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "5-ounce-pork-chops",
      "item": "(5 ounce) pork chops",
      "quantity": 4
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 6,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "rice-vinegar",
      "item": "rice vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the pork chops on both sides with salt, pepper, and garlic powder. Keep the minced garlic ready."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Cook the chops until golden brown, about 5 minutes, turning as needed.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Transfer the chops to a plate. Reduce the heat to medium and melt the butter in the skillet. Add the garlic and cook briefly until fragrant."
    },
    {
      "step": 4,
      "text": "Stir in the honey, water, and rice vinegar. Simmer until the sauce thickens, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Return the chops to the skillet and turn them in the sauce. Cook for about 2 minutes, until the thickest part reaches 145°F; rest for 3 minutes before serving.",
      "timer_minutes": 2
    }
  ],
