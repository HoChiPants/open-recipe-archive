  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the quinoa, water, and tomato sauce in a saucepan. Bring to a simmer and cook until the quinoa is tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Meanwhile, heat the olive oil in a skillet. Cook the onion and garlic for 7 minutes, then add the zucchini, eggplant, and diced tomato. Cook until the vegetables are tender, about 5 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Stir the cooked quinoa into the vegetables and season with salt and ground black pepper."
    },
    {
      "step": 5,
      "text": "Arrange the prepared bell peppers in a baking dish and fill them with the quinoa mixture."
    },
    {
      "step": 6,
      "text": "Bake until the peppers are tender, about 18 minutes.",
      "timer_minutes": 18
    },
    {
      "step": 7,
      "text": "Top the peppers with the mozzarella and bake until the cheese is melted."
    }
  ],
