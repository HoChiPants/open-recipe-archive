  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Warm the olive oil in a skillet, add the mushrooms, and stir until they are softened."
    },
    {
      "step": 3,
      "text": "Mix the mushrooms, cooked rice, salsa, diced chicken, shredded Cheddar, and sour cream in a baking dish."
    },
    {
      "step": 4,
      "text": "Bake for 35 minutes, until the center reaches 165°F on a food thermometer.",
      "timer_minutes": 35
    }
  ],
