  "id": "chicken-rice-and-salsa-bake",
  "name": "Chicken, Rice, and Salsa Bake",
  "subtitle": "A creamy, cheesy casserole with mushrooms and salsa",
  "description": "Combine cooked chicken and rice with salsa, mushrooms, cheese, and sour cream, then bake until hot and safely reheated.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
