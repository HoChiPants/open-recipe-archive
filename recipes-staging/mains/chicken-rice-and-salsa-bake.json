  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 4,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "fresh-sliced-mushrooms",
      "item": "fresh sliced mushrooms",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "white-rice",
      "item": "white rice",
      "quantity": 2,
      "unit": "cups",
      "preparation": "cooked"
    },
