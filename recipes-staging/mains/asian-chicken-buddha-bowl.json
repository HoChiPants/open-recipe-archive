  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Toss the sweet potato and red onion with part of the olive oil, salt, and pepper. Spread on a baking sheet and roast until the sweet potato is tender, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Simmer the quinoa in 2 cups of chicken broth until tender, about 20 minutes. Fluff and set aside.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Heat the remaining olive oil in a skillet. Add part of the garlic and the ginger; stir for 1 minute. Add the chicken, remaining chicken broth, and lime juice. Cook until the chicken reaches 165°F at the thickest part, about 6 minutes per side. Rest briefly, then slice.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Whisk the remaining garlic with the peanut butter, soy sauce, honey, sesame oil, and enough lime juice to make a smooth sauce."
    },
    {
      "step": 5,
      "text": "Divide the quinoa, roasted vegetables, spinach, chicken, and avocado among bowls. Spoon over the sauce and finish with cilantro and sesame seeds."
    }
  ],
