  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Place the prepared pizza crust on a baking sheet, brush it with the olive oil, and scatter the minced garlic over the surface."
    },
    {
      "step": 2,
      "text": "Bake the crust for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Top with the pepper Jack, Cheddar, and crushed red pepper flakes. Bake until the cheese melts, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Scatter the crumbled bacon and pickle chips over the pizza. Return it to the oven and bake until hot and the crust edges are crisp, about 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Garnish with the chopped fresh dill and serve."
    }
  ],
