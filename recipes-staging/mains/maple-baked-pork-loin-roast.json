  "id": "maple-baked-pork-loin-roast",
  "name": "Maple-Baked Pork Loin Roast",
  "subtitle": "Tender pork with a sweet maple-garlic glaze",
  "description": "A simple oven-roasted pork loin coated in flour, browned in oil, and finished with a maple-ketchup sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 125
  },
  "ingredients": [
    {
      "ingredient_id": "4-pound-boneless-pork-loin-roast",
      "item": "(4 pound) boneless pork loin roast",
      "quantity": 1
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "all-purpose-flour-for-dredging",
      "item": "all-purpose flour for dredging"
    },
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "ketchup",
      "item": "ketchup",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Season the pork with salt and pepper, then coat it lightly with flour."
    },
    {
      "step": 2,
      "text": "Warm the canola oil in an oven-safe skillet over medium-high heat. Add the pork and brown it briefly, about 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Stir together the maple syrup, ketchup, water, and minced garlic. Pour the mixture over the pork and turn the roast to coat it."
    },
    {
      "step": 4,
      "text": "Bake for 120 minutes, or until the center reaches 145°F. Remove from the oven and rest for 3 minutes before slicing.",
      "timer_minutes": 120
    }
  ],
