{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "aubergine-parmigiana-lasagne",
  "name": "Aubergine Parmigiana Lasagne",
  "subtitle": "Layered aubergine, tomato, basil, and cheese pasta bake",
  "description": "Roasted aubergine and tomato sauce are layered with lasagne sheets, basil, and cheese, then baked until bubbling and fully set.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "aubergines-trimmed-and-thinly-sliced-lengthways",
      "item": "aubergines trimmed and thinly sliced lengthways",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vegetarian-mozzarella-drained-and-coarsely-grated",
      "item": "vegetarian mozzarella drained and coarsely grated",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "vegetarian-italian-style-hard-cheese-grated",
      "item": "vegetarian Italian-style hard cheese grated",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "bunch-of-basil-leaves-picked-and-roughly-chopped",
      "item": "bunch of basil leaves picked and roughly chopped",
      "quantity": 1,
      "preparation": "plus extra to serve"
    },
    {
      "ingredient_id": "dried-lasagne-sheets-egg-lasagne-sheets-are-best-for-this",
      "item": "dried lasagne sheets (egg lasagne sheets are best for this)",
      "quantity": 8
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-cloves-finely-sliced",
      "item": "garlic cloves finely sliced",
      "quantity": 6
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "red-wine-vinegar",
      "item": "red wine vinegar",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "x-400g-cans-chopped-tomatoes",
      "item": "x 400g cans chopped tomatoes",
      "quantity": 3
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Arrange the aubergine slices on baking trays, brush with 4 tbsp olive oil, and roast until softened and lightly browned, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Meanwhile, warm 2 tbsp olive oil in a saucepan. Add the garlic and cook briefly until fragrant. Stir in the sugar, vinegar, and chopped tomatoes, then simmer until slightly thickened.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Reduce the oven to 375°F. Spread a little tomato sauce in a baking dish. Add layers of lasagne sheets, aubergine, sauce, mozzarella, hard cheese, and basil, finishing with sauce and the remaining cheeses."
    },
    {
      "step": 4,
      "text": "Cover the dish and bake for 30 minutes, then uncover and continue baking until bubbling and the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Rest for 10 minutes, scatter with the reserved basil, and serve.",
      "timer_minutes": 10
    }
  ],
