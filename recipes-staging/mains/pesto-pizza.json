  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Place the pre-baked pizza crust on a baking sheet and spread the pesto over it."
    },
    {
      "step": 3,
      "text": "Distribute the tomato, bell pepper, olives, red onion, and artichoke hearts over the pesto. Sprinkle with the feta."
    },
    {
      "step": 4,
      "text": "Bake for 10 minutes, until the feta is melted.",
