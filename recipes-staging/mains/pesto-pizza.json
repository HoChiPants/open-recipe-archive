  "id": "pesto-pizza",
  "name": "Pesto Pizza",
  "subtitle": "A colorful vegetable pizza with pesto and feta",
  "description": "Top a pre-baked crust with pesto, vegetables, olives, artichokes, and feta, then bake until the cheese melts.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
