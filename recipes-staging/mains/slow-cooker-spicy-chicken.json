  "id": "slow-cooker-spicy-chicken",
  "name": "Slow Cooker Spicy Chicken",
  "subtitle": "Tender chicken with salsa, cumin, and chili",
  "description": "Chicken breasts slowly cook in a seasoned salsa mixture, then are shredded for serving.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 3,
    "unit": "servings"
