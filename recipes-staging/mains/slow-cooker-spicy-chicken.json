    },
    {
      "ingredient_id": "salt-and-fresh-ground-pepper-to-taste",
      "item": "salt and fresh ground pepper to taste",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken in a slow cooker."
    },
    {
      "step": 2,
      "text": "Stir together the salsa and tomato sauce, then pour the mixture over the chicken. Add the garlic, onion, cumin, chili powder, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Cover and cook until the chicken is tender and reaches 165°F in the thickest part, about 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 4,
      "text": "Shred the chicken in the cooking juices and serve hot."
    }
  ],
