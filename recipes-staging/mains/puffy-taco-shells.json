  "id": "puffy-taco-shells",
  "name": "Puffy Taco Shells",
  "subtitle": "Crisp, airy masa shells for taco fillings",
  "description": "Form a simple masa dough, shape it into thick rounds, and fry until puffed and crisp.",
  "meal_type": "main",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 3
  },
  "ingredients": [
    {
      "ingredient_id": "masa-harina",
      "item": "masa harina",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lukewarm-water",
      "item": "lukewarm water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "lukewarm-water",
      "item": "lukewarm water",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "canola-oil-for-frying",
      "item": "canola oil for frying",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the masa harina and salt in a bowl. Add the 1/2 cup lukewarm water and knead for 3 minutes, adding the 2 tablespoons lukewarm water as needed until a firm dough forms.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Divide the dough into four portions. Press or pat each portion into a thick round, keeping the edges intact."
    },
    {
      "step": 3,
      "text": "Heat the canola oil for frying in a skillet over medium-high heat. Fry the rounds in batches until puffed and lightly crisp, turning as needed.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Drain the shells briefly on a paper towel-lined plate, shape them while warm if needed, and serve."
    }
  ],
