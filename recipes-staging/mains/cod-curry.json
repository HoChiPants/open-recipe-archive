  "instructions": [
    {
      "step": 1,
      "text": "Warm the oil in a large saucepan over medium heat. Add the onion and cook until softened, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Stir in the garlic paste and ginger paste; cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the cumin, coriander, cardamom, turmeric, and salt. Mix in the jalapeños, cilantro, lemon juice, and tomatoes with their juice."
    },
    {
      "step": 4,
      "text": "Bring the sauce to a gentle simmer and cook for 20 minutes. Blend until smooth, then return the sauce to the saucepan.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Add the cod and simmer gently until opaque, easily flaked, and at least 145°F in the center, about 15 minutes.",
      "timer_minutes": 15
    }
  ],
