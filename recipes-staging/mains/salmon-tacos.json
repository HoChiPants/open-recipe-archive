  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and place the salmon fillets in a baking dish."
    },
    {
      "step": 2,
      "text": "Stir together the melted butter, lemon juice, and Cajun seasoning, then coat the salmon with the mixture."
    },
    {
      "step": 3,
      "text": "Bake for 20 minutes, or until the thickest part reaches 145°F and the fish flakes easily.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Flake the salmon and toss it with the drained corn, black beans, diced tomato, red onion, and cilantro."
    },
    {
      "step": 5,
      "text": "Fill the warmed tortillas with the salmon mixture and shredded Cheddar."
    },
    {
      "step": 6,
      "text": "Serve with sour cream and guacamole."
    }
  ],
