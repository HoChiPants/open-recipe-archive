  "id": "salmon-tacos",
  "name": "Salmon Tacos",
  "subtitle": "Cajun-seasoned salmon with a fresh bean-and-corn filling",
  "description": "Bake seasoned salmon with lemon butter, flake it into a corn and black bean mixture, and serve in warm tortillas with cheese, sour cream, and guacamole.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
