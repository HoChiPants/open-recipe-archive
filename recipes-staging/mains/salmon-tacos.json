      "item": "(3 ounce) fillets salmon fillets",
      "quantity": 4,
      "preparation": "thawed if frozen"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
