    "prep_minutes": 5,
    "cook_minutes": 20,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "bone-in-chicken-breast-halves-with-skin",
      "item": "bone-in chicken breast halves with skin",
      "quantity": 4
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the broiler."
    },
    {
      "step": 2,
      "text": "Rub the chicken breasts with the olive oil, then season evenly with the salt and pepper."
    },
    {
      "step": 3,
      "text": "Arrange the chicken on a broiler pan and broil for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Turn the chicken and broil for 10 minutes more, until the thickest part reaches 165°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Let the chicken rest for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
