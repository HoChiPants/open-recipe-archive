  "id": "basic-broiled-chicken-breasts",
  "name": "Basic Broiled Chicken Breasts",
  "subtitle": "Simple skin-on chicken with crisp, savory edges",
  "description": "Season bone-in chicken breasts with olive oil, salt, and pepper, then broil until browned and safely cooked through.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
