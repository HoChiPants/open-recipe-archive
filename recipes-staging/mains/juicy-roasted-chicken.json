    {
      "ingredient_id": "stalk-celery",
      "item": "stalk celery",
      "quantity": 1,
      "preparation": "leaves removed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Place the chicken breast-side up in a roasting pan."
    },
    {
      "step": 2,
      "text": "Season the chicken inside and out with salt, pepper, and onion powder. Rub the butter or margarine over the skin and beneath it where accessible."
    },
    {
      "step": 3,
      "text": "Cut the celery into large pieces and place them inside the chicken cavity."
    },
    {
      "step": 4,
      "text": "Roast for 60 minutes, then check the thickest part of the thigh with a food thermometer. Continue roasting until the chicken reaches 165°F.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Transfer the chicken to a board and let it rest for 30 minutes before carving.",
      "timer_minutes": 30
    }
  ],
