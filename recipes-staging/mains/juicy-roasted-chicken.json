  "id": "juicy-roasted-chicken",
  "name": "Juicy Roasted Chicken",
  "subtitle": "Tender roast chicken with buttery seasoning",
  "description": "A straightforward whole chicken roasted with onion-seasoned butter and celery for a savory family dinner.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
