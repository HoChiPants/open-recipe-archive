  },
  "ingredients": [
    {
      "ingredient_id": "3-pound-whole-chicken",
      "item": "(3 pound) whole chicken",
      "quantity": 1,
      "preparation": "giblets removed"
    },
    {
      "ingredient_id": "salt-and-black-pepper-to-taste",
      "item": "salt and black pepper to taste"
    },
    {
      "ingredient_id": "onion-powder",
      "item": "onion powder",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "butter-or-margarine",
      "item": "butter or margarine",
      "quantity": 0.5,
      "unit": "cup"
