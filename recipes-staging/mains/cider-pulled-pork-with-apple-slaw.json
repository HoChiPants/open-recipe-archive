  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and place the pork shoulder in a roasting dish with the sliced onions."
    },
    {
      "step": 2,
      "text": "Mix the smoked paprika, caraway seeds, garlic granules, brown sugar, and salt. Rub the mixture over the pork and onions."
    },
    {
      "step": 3,
      "text": "Add the cider to the dish, cover, and cook until the pork is tender and reaches at least 145°F in the thickest part.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Roast the pork for 240 minutes, checking that it remains moist and tender.",
      "timer_minutes": 240
    },
    {
      "step": 5,
      "text": "Let the pork rest for at least 3 minutes, then shred it and mix with the cooking juices and onions."
    },
    {
      "step": 6,
      "text": "Whisk the soured cream, Dijon mustard, lemon juice, and dill. Stir in the chopped apples.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Fill the toasted ciabatta rolls with the pulled pork and apple slaw."
    }
  ],
