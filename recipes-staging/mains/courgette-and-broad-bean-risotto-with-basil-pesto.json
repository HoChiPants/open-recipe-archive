  "instructions": [
    {
      "step": 1,
      "text": "Crush the garlic with the toasted pine nuts, basil, and mint. Stir in the 1 tbsp olive oil and 1 tbsp grated parmesan to make a coarse pesto."
    },
    {
      "step": 2,
      "text": "Melt the butter with 1 tbsp of the olive oil in a wide pan. Add the courgettes, chilli, nutmeg, and courgette flowers if using; sauté until lightly softened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the spring onions and lemon zest, then add the rice and cook until the grains are glossy.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Pour in the wine or vermouth and let it absorb. Keep the stock hot; if using chicken stock, ensure it has been heated to 165°F before adding."
    },
    {
      "step": 5,
      "text": "Add the hot stock gradually, stirring frequently and allowing each addition to absorb before adding more, until the rice is tender and creamy.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Fold in the broad beans and any remaining courgette flowers. Cook briefly until heated through.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Remove from the heat and stir in the grated parmesan. Rest until creamy, then serve with the pesto, extra basil, and additional parmesan.",
      "timer_minutes": 5
    }
  ],
