  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Bring a large pot of water to a simmer and season it with the garlic salt. Add the macaroni and cook until tender, about 8 minutes. Drain well.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Whisk together the mozzarella, Swiss, Parmesan, provolone, ricotta, sour cream, heavy cream, parsley, Italian seasoning, and garlic salt. Reserve some of the cheese mixture for the topping."
    },
    {
      "step": 4,
      "text": "Fold the drained macaroni into the remaining cheese mixture and transfer it to a baking dish."
    },
    {
      "step": 5,
      "text": "Spread the reserved cheese mixture over the top and bake until melted, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Let the bake stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
