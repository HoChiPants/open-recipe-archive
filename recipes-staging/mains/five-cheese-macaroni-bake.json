  "id": "five-cheese-macaroni-bake",
  "name": "Five-Cheese Macaroni Bake",
  "subtitle": "Creamy pasta with a golden, melted cheese topping",
  "description": "Tender elbow macaroni is folded into a seasoned cream-and-cheese mixture, then baked until bubbling and melted.",
  "meal_type": "main",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
