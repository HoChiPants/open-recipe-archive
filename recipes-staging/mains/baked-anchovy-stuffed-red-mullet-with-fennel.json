  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Trim and slice the fennel, then arrange it with the onion in a baking dish. Toss with olive oil, lemon juice, and a little seasoning if desired."
    },
    {
      "step": 2,
      "text": "Bake the vegetables for 15 minutes, until beginning to soften.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Mix the anchovies, breadcrumbs, garlic, tomato, parsley, and enough extra olive oil to make a moist stuffing."
    },
    {
      "step": 4,
      "text": "Make a shallow opening along the back or side of each mullet and fill it with the stuffing. Set the fish over the vegetables and drizzle with additional olive oil."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, until the fish reaches 145°F internally, is opaque, and flakes easily.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Serve with the roasted fennel and onion, lemon wedges, and crusty bread."
    }
  ],
