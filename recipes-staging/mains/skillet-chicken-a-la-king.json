  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "skillet-chicken-a-la-king",
  "name": "Skillet Chicken à la King",
  "subtitle": "Tender chicken in a creamy mushroom sauce",
  "description": "Bite-size chicken simmers with mushrooms, pimentos, and seasonings in a smooth cream sauce for an easy four-serving main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 1,
      "unit": "pound",
      "preparation": "boneless chicken breast halves - cut into bite-size pieces"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "fresh-sliced-mushrooms",
      "item": "fresh sliced mushrooms",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "pimento-peppers",
      "item": "pimento peppers",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "onion-powder",
      "item": "onion powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a skillet over medium heat. Add the chicken and cook until no longer pink in the center and it reaches 165°F on a food thermometer.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Stir in the condensed soup and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the mushrooms and cook until lightly browned."
    },
    {
      "step": 4,
      "text": "Stir in the milk, pimento peppers, onion powder, and black pepper. Bring to a gentle simmer, then cook until thickened.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Stir once more and serve hot."
    }
  ],
