  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Spread the plain flour on a plate and coat the cod fillets evenly."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in an ovenproof pan. Brown the coated cod for 2 minutes, then add the lemon and thyme.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Bake the cod for 10 minutes, until opaque and easily flaked or it reaches 145°F internally.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Meanwhile, cook the leeks and mushrooms in a separate pan for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the orzo and low-salt stock. Simmer for 10 minutes, stirring occasionally, until the orzo is tender.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Stir the crème fraîche and lemon zest into the orzo. Serve the baked cod over it with the lemon slices and thyme."
    }
  ],
