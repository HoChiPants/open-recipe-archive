  "id": "baked-cod-with-creamy-mushroom-and-leek-orzo",
  "name": "Baked Cod with Creamy Mushroom and Leek Orzo",
  "subtitle": "Tender cod served over lemony, vegetable-filled orzo",
  "description": "Lightly flour-coated cod is browned, finished in the oven, and served with creamy orzo cooked with leeks, mushrooms, stock, lemon, and thyme.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
