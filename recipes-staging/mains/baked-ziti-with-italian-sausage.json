  "id": "baked-ziti-with-italian-sausage",
  "name": "Baked Ziti with Italian Sausage",
  "subtitle": "A hearty layered pasta bake with marinara, ricotta, and mozzarella.",
  "description": "Cooked ziti, seasoned sausage, and creamy ricotta are layered with marinara and baked until hot and bubbling.",
  "meal_type": "main",
