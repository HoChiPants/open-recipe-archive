  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the ziti in salted water for 10 minutes, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Brown the sausage in a skillet, breaking it into small pieces. Drain excess fat; cook until it reaches 160°F."
    },
    {
      "step": 4,
      "text": "Warm the marinara sauce with half of the dried basil."
    },
    {
      "step": 5,
      "text": "Combine the cooked sausage, ricotta, Italian seasoning, and salt and pepper."
    },
    {
      "step": 6,
      "text": "Layer ziti, the sausage mixture, mozzarella, and marinara in a baking dish. Repeat as needed, finishing with sauce and mozzarella. Sprinkle with the remaining basil and Italian seasoning."
    },
    {
      "step": 7,
      "text": "Bake until the casserole is hot, bubbling, and the center reaches 165°F.",
      "timer_minutes": 45
    }
  ],
