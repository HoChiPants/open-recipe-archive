  "id": "baked-pesto-chicken-with-potatoes-and-tomatoes",
  "name": "Baked Pesto Chicken with Potatoes and Tomatoes",
  "subtitle": "A simple one-pan chicken dinner with pesto-coated vegetables.",
  "description": "Chicken thighs roast with baby potatoes and cherry tomatoes in a seasoned pesto mixture until tender and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "bone-in",
      "item": "bone-in",
      "quantity": 2.5,
      "unit": "pounds",
      "preparation": "skinless chicken thighs"
    },
    {
      "ingredient_id": "baby-red-potatoes",
      "item": "baby red potatoes",
      "quantity": 1.5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "cherry-tomatoes",
      "item": "cherry tomatoes",
      "quantity": 1,
      "unit": "pint"
    },
    {
      "ingredient_id": "pesto",
      "item": "pesto",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Place the potatoes and tomatoes in a baking dish. Stir together the pesto, water, olive oil, salt, and pepper, then toss the vegetables with the mixture."
    },
    {
      "step": 3,
      "text": "Nestle the chicken thighs among the vegetables and spread everything into an even layer."
    },
    {
      "step": 4,
      "text": "Bake for 45 minutes, until the vegetables are tender and the thickest part of each chicken thigh reaches 165°F on a food thermometer.",
      "timer_minutes": 45
    }
  ],
