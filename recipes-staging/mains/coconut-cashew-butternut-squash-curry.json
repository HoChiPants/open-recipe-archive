  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large pot over medium heat. Cook the onion for 10 minutes, stirring occasionally, until softened.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the garlic, ginger, curry powder, and ground cashews. Stir briefly to coat the onion and release the aromas."
    },
    {
      "step": 3,
      "text": "Add the coconut milk, tomatoes, raisins, chickpeas, and squash. Stir to combine."
    },
    {
      "step": 4,
      "text": "Bring the curry to a gentle simmer, then cook for about 20 minutes, stirring occasionally, until the squash is tender.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Remove from the heat and let the curry rest briefly before serving."
    },
    {
      "step": 6,
      "text": "Serve with rice and, if desired, naan breads and pickles."
    }
  ],
