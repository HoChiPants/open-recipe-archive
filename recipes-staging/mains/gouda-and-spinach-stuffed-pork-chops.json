  "id": "gouda-and-spinach-stuffed-pork-chops",
  "name": "Gouda and Spinach Stuffed Pork Chops",
  "subtitle": "Tender pork chops filled with spinach and smoked cheese",
  "description": "Thick pork chops are filled with fresh spinach and smoked Gouda, coated with mustard-seasoned panko, and baked until safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "6-ounce-thick-cut-pork-chops",
      "item": "(6 ounce) thick cut pork chops",
      "quantity": 4
    },
    {
      "ingredient_id": "fresh-spinach",
      "item": "fresh spinach",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "rinsed and torn into bite-size pieces"
    },
    {
      "ingredient_id": "slices-smoked-gouda-cheese",
      "item": "slices smoked Gouda cheese",
      "quantity": 8
    },
    {
      "ingredient_id": "panko-bread-crumbs",
      "item": "panko bread crumbs",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "horseradish-mustard",
      "item": "horseradish mustard",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "creole-seasoning",
      "item": "Creole seasoning",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Cut a deep pocket into the side of each pork chop, keeping the edges intact. Fill each pocket with spinach and two slices of smoked Gouda."
    },
    {
      "step": 3,
      "text": "Spread the panko bread crumbs in a shallow dish. Coat the stuffed chops with horseradish mustard, then press them into the crumbs. Season with Creole seasoning."
    },
    {
      "step": 4,
      "text": "Transfer the chops to the prepared dish and bake for 45 minutes, or until the thickest part reaches 145°F on a food thermometer.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Rest the pork chops for 3 minutes before serving."
    }
  ],
