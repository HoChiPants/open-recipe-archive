  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a heavy pot over medium heat. Cook the chopped onion for 4 minutes, until softened.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Stir in the pepper, chilli, coriander, cumin, turmeric, ginger, and garlic. Cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the beef and stir to coat it evenly in the spiced onion mixture."
    },
    {
      "step": 4,
      "text": "Mix in the tomato paste or purée and beef stock, scraping up any browned bits.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Cover and simmer gently for 60 minutes, stirring occasionally, until the beef is tender. Check that the beef reaches 145°F, then rest it for 3 minutes before serving.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Uncover and cook for 8 minutes to thicken the sauce. Stir in the lemon juice and serve hot.",
      "timer_minutes": 8
    }
  ],
