    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven and arrange the ricotta and grape bunches in a shallow baking dish."
    },
    {
      "step": 2,
      "text": "Whisk together the honey, olive oil, chilli flakes, chopped thyme, and lemon zest. Spoon the mixture over the ricotta and grapes."
    },
    {
      "step": 3,
      "text": "Bake until the ricotta is warmed through and the grapes are softened.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Toast the baguette slices until crisp, then arrange them around the baked ricotta."
    },
    {
      "step": 5,
      "text": "Scatter the torn prosciutto over the dish and finish with the remaining chilli flakes. Serve warm."
    }
  ],
