  "id": "baked-ricotta-with-chilli-honey-grapes-and-prosciutto",
  "name": "Baked Ricotta with Chilli Honey, Grapes, and Prosciutto",
  "subtitle": "Warm ricotta and roasted grapes for easy sharing",
  "description": "Creamy baked ricotta, sweet grapes, chilli honey, crisp baguette, and torn prosciutto make a simple shared main.",
  "meal_type": "main",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
