  "id": "cauliflower-mac-and-cheese",
  "name": "Cauliflower Mac and Cheese",
  "subtitle": "Roasted cauliflower in a creamy cheddar sauce",
  "description": "Roasted cauliflower is folded into a warm cheddar-Parmesan sauce and baked until bubbling and lightly browned.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "head-cauliflower",
      "item": "head cauliflower",
      "quantity": 1,
      "preparation": "cut into florets"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "mixed-herbs",
      "item": "mixed herbs",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ghee-clarified-butter",
      "item": "ghee (clarified butter)",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Place the cauliflower florets on a baking sheet. Toss with the salt, mixed herbs, black pepper, and olive oil."
    },
    {
      "step": 3,
      "text": "Roast until tender and browned, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Meanwhile, heat the Cheddar, cream, ghee, nutmeg, and Parmesan in a saucepan. Simmer gently for 5 minutes, stirring until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Transfer the roasted cauliflower to a baking dish and combine it with the sauce. Sprinkle in the Cheddar and Parmesan as directed, then bake until hot and bubbling, about 10 minutes.",
      "timer_minutes": 10
    }
  ],
