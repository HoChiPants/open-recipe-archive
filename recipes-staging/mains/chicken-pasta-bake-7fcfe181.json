  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a suitable baking dish."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large oven-safe skillet or saucepan. Cook the bacon for 7 minutes, then add the chicken and cook until browned and the thickest pieces reach 165°F.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Transfer the bacon and chicken to a plate. Cook the onion and garlic in the same pan for 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Add the red and yellow peppers, oregano, and chilli flakes. Cook for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir in the chopped tomatoes, sugar, parsley, bacon, and chicken. Bring to a simmer and cook until thickened, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Stir in the mascarpone. Cook the pasta with the parsley for 2 minutes, then combine the pasta with the sauce.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Transfer the mixture to the baking dish, top with the cheddar and mozzarella, and bake until hot and bubbling, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Serve hot."
    }
  ],
