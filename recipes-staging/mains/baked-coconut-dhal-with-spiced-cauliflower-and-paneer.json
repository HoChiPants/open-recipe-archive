  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Toss the chopped onion with the oil and roast for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Whisk the coconut milk until smooth. Stir it with the roasted onion, ginger, garlic purée, curry paste, turmeric, nigella seeds, red lentils, chana dhal or split peas, and chopped tomatoes in a baking dish."
    },
    {
      "step": 3,
      "text": "Cover or seal the dish and bake for 50 minutes.",
      "timer_minutes": 50
    },
    {
      "step": 4,
      "text": "Stir the dhal. Mix the remaining coconut milk with curry paste and turmeric, then coat the paneer in the mixture."
    },
    {
      "step": 5,
      "text": "Add the lemon juice, cauliflower, and coated paneer to the dish. Stir in the chana dhal or split peas if needed to distribute them evenly."
    },
    {
      "step": 6,
      "text": "Bake uncovered for 40 minutes, until the dhal is tender and the cauliflower and paneer are cooked.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Prepare the sliced red onion and green chilli while the dish finishes. Let the dhal stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Serve topped with the sliced onion, chilli, and coriander leaves."
    }
  ],
