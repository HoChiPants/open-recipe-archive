  "id": "cheddar-bacon-asparagus-pastry-puffs",
  "name": "Cheddar, Bacon & Asparagus Pastry Puffs",
  "subtitle": "Golden puff pastry parcels with savory bacon, cheddar, and asparagus",
  "description": "Crisp pastry surrounds tender asparagus, smoky bacon, and melted cheddar for a simple savory bake.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "back-bacon-rashers",
      "item": "back bacon rashers",
      "quantity": 3
    },
    {
      "ingredient_id": "sheet-all-butter-puff-pastry",
      "item": "sheet all-butter puff pastry",
      "quantity": 320,
      "unit": "g"
    },
    {
      "ingredient_id": "cheddar-grated",
      "item": "cheddar grated",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "slim-asparagus-spears",
      "item": "slim asparagus spears",
      "quantity": 24
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Arrange the bacon rashers in a single layer on a baking tray and cook for 10 minutes. Transfer to a plate and let cool.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Trim the asparagus. Cut the pastry sheet into six portions, then cut the cooled bacon into strips."
    },
    {
      "step": 3,
      "text": "Place cheddar, asparagus, and bacon on each pastry portion, leaving a border. Fold the pastry around the filling and seal the edges."
    },
    {
      "step": 4,
      "text": "Arrange the pastries on the baking tray and bake for 25 minutes, or until puffed and golden brown.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Let the puffs cool briefly before serving."
    }
  ],
