  ],
  "instructions": [
    {
      "step": 1,
      "text": "Arrange the chicken in a slow cooker."
    },
    {
      "step": 2,
      "text": "Whisk together the melted butter, salt and pepper, garlic, condensed soup, broth, cream cheese, chipotle peppers, and adobo sauce until well combined. Pour the mixture over the chicken and stir to coat."
    },
    {
      "step": 3,
      "text": "Cover and cook for 6 hours, or until the thickest chicken piece reaches 165°F on a food thermometer.",
      "timer_minutes": 360
    }
  ],
