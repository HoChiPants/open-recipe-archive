  "id": "creamy-chipotle-chicken",
  "name": "Creamy Chipotle Chicken",
  "subtitle": "Tender chicken in a smoky, creamy sauce",
  "description": "Chicken breasts cook slowly in a rich chipotle sauce flavored with garlic, adobo, and cream cheese.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
