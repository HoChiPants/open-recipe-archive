      "item": "red onion",
      "quantity": 1,
      "preparation": "minced"
    },
    {
      "ingredient_id": "lime-juice",
      "item": "lime juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "avocado",
      "item": "avocado",
      "quantity": 1,
      "preparation": "diced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the salt, black pepper, and cayenne. Season the chicken evenly with the mixture."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet over medium heat. Add the chicken and lime juice, and cook for 7 minutes, turning as needed, until the thickest pieces reach 165°F.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Combine the minced red onion, diced avocado, and any remaining lime juice with the cooked chicken juices."
    },
    {
      "step": 4,
      "text": "Spoon the avocado mixture over the chicken and serve."
    }
  ],
