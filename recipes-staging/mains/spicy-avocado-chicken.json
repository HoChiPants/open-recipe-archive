  "id": "spicy-avocado-chicken",
  "name": "Spicy Avocado Chicken",
  "subtitle": "Cayenne-seasoned chicken with fresh avocado and lime",
  "description": "Skillet-cooked chicken is finished with a bright avocado, onion, and lime mixture.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
