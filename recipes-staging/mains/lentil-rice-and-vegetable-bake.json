  "instructions": [
    {
      "step": 1,
      "text": "Combine the rice with the water and let stand for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Cook the red lentils in the water until tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 4,
      "text": "Heat the vegetable oil and cook the onion and garlic until tender."
    },
    {
      "step": 5,
      "text": "Stir in the tomato, celery, carrots, zucchini, and tomato sauce."
    },
    {
      "step": 6,
      "text": "Season with the basil, oregano, cumin, salt, and pepper."
    },
    {
      "step": 7,
      "text": "Combine the rice and lentils with the vegetable mixture in a baking dish."
    },
    {
      "step": 8,
      "text": "Bake for 30 minutes, until the rice is tender and the mixture is hot throughout.",
