  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the crushed garlic into the melted butter."
    },
    {
      "step": 3,
      "text": "Mix the bread crumbs, Parmesan, parsley, salt, and pepper in a shallow dish."
    },
    {
      "step": 4,
      "text": "Coat the chicken pieces with the garlic butter, then press them into the crumb mixture."
    },
    {
      "step": 5,
      "text": "Arrange the coated chicken in a baking dish and bake for about 75 minutes, until the thickest pieces reach 165°F.",
      "timer_minutes": 75
    }
  ],
