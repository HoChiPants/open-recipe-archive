  "id": "oven-fried-parmesan-chicken",
  "name": "Oven-Fried Parmesan Chicken",
  "subtitle": "Crisp Parmesan-coated chicken baked until tender",
  "description": "Chicken pieces are coated in seasoned Parmesan crumbs and baked with a buttery garlic coating until crisp and safely cooked through.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
