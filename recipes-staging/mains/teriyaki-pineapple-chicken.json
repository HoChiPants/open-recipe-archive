  "instructions": [
    {
      "step": 1,
      "text": "Preheat a large skillet over medium-high heat and add the vegetable oil."
    },
    {
      "step": 2,
      "text": "Add the cubed chicken and cook for 10 minutes, stirring occasionally, until browned and the center reaches 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the mushrooms, onion, bell peppers, teriyaki sauce, pineapple with its liquid, garlic powder, and crushed red pepper."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a gentle simmer. Stir in the flour until smooth and incorporated."
    },
    {
      "step": 5,
      "text": "Simmer for 15 minutes, stirring occasionally, until the sauce thickens and the chicken is fully cooked.",
      "timer_minutes": 15
    }
  ],
