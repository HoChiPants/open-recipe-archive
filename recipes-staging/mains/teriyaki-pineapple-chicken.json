  "id": "teriyaki-pineapple-chicken",
  "name": "Teriyaki Pineapple Chicken",
  "subtitle": "Tender chicken and colorful vegetables in a sweet-savory sauce",
  "description": "Cubed chicken simmers with peppers, mushrooms, pineapple, and teriyaki sauce for a flavorful one-pan main dish.",
  "meal_type": "main",
  "cuisine": "Japanese",
