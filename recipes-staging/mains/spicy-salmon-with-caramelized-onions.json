  "instructions": [
    {
      "step": 1,
      "text": "Combine the pepper, paprika, cayenne, garlic, mustard, brown sugar, onion powder, salt, and minced onion. Stir in 1 tablespoon olive oil."
    },
    {
      "step": 2,
      "text": "Coat the salmon fillets with the mixture and refrigerate for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Heat the remaining 2 tablespoons olive oil in a skillet. Add the coated salmon and cook until browned, turning as needed.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Cook the onion mixture in the skillet until tender and caramelized, about 6 minutes. Continue cooking the salmon until it reaches 145°F internally and flakes easily.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Transfer the salmon and onions to plates and serve."
    }
  ],
