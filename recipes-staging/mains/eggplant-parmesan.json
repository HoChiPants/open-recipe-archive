  "id": "eggplant-parmesan",
  "name": "Eggplant Parmesan",
  "subtitle": "Crisp-coated eggplant with tomato sauce and melted cheese",
  "description": "Breaded eggplant is cooked until golden, then finished with spaghetti sauce, mozzarella, Parmesan, and a touch of heat.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
