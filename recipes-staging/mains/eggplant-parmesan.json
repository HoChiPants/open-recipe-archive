  "instructions": [
    {
      "step": 1,
      "text": "Whisk the egg and water in a shallow bowl. Place the seasoned bread crumbs in a second shallow dish."
    },
    {
      "step": 2,
      "text": "Dip each eggplant slice in the egg mixture, then coat it evenly with bread crumbs."
    },
    {
      "step": 3,
      "text": "Preheat a skillet with the vegetable oil and preheat the broiler."
    },
    {
      "step": 4,
      "text": "Cook the coated eggplant until golden brown and the egg coating reaches 160°F, turning as needed.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Combine the spaghetti sauce and crushed red pepper flakes. Spoon the mixture over the eggplant, then add the mozzarella and Parmesan."
    },
    {
      "step": 6,
      "text": "Broil until the cheeses melt and the topping is bubbling.",
      "timer_minutes": 2
    }
  ],
