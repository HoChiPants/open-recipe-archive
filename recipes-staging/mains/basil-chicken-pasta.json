  "id": "basil-chicken-pasta",
  "name": "Basil Chicken Pasta",
  "subtitle": "Creamy pasta with garlic, chicken, and basil",
  "description": "Rotini and tender chicken are coated in a creamy garlic-basil sauce finished with Parmesan.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
