    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "rotini-pasta",
      "item": "rotini pasta",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 1,
      "unit": "pound",
      "preparation": "boneless chicken breast halves - cut into 1/2 inch cubes"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the rotini in boiling water until tender, then drain."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat. Add the chicken and cook until no longer pink and the thickest pieces reach 165°F."
    },
    {
      "step": 3,
      "text": "Add the garlic and cook briefly until fragrant."
    },
    {
      "step": 4,
      "text": "Whisk in the pepper, dried basil, heavy cream, and Parmesan. Simmer gently for 4 minutes, stirring, until the sauce is smooth.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Toss the drained pasta with the chicken and sauce. Serve with the dried basil."
    }
  ],
