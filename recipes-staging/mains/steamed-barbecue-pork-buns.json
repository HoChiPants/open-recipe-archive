{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "steamed-barbecue-pork-buns",
  "name": "Steamed Barbecue Pork Buns",
  "subtitle": "Soft yeast buns with savory pork filling",
  "description": "Yeasted buns filled with barbecued pork, green onions, sesame oil, hoisin sauce, and cayenne, then steamed until set.",
  "meal_type": "main",
  "cuisine": "Chinese",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 15,
    "inactive_minutes": 175
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "barbecued-pork",
      "item": "barbecued pork",
      "quantity": 2,
      "unit": "cups",
      "preparation": "diced, or to taste"
    },
    {
      "ingredient_id": "finely-sliced-green-onions",
      "item": "finely sliced green onions",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "hoisin-sauce",
      "item": "hoisin sauce",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the water in a bowl, sprinkle in the yeast, and let it stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the vegetable oil, sugar, and flour. Mix into a dough, then knead for 10 minutes, until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Lightly coat the dough with oil, cover, and let it rise in a warm place for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Combine the barbecued pork, green onions, cayenne, sesame oil, and hoisin sauce for the filling."
    },
    {
      "step": 5,
      "text": "Add enough water to the remaining flour to form a set dough. Transfer it to a work surface, cut it into 12 pieces, and flatten each into a thick round."
    },
    {
      "step": 6,
      "text": "Place filling in each round, gather the dough around it, and pinch to seal. Arrange the buns in a steamer, leaving space between them, and let them rest for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Bring water in the steamer to a boil, add the buns, cover, and steam for 15 minutes, until set and the pork filling reaches at least 145°F; rest for 3 minutes before serving.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Serve warm."
    }
  ],
