  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of salted water to a boil. Cook the linguine for 10 minutes, or until tender, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet. Add the red onion and garlic and sauté for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the chicken and lemon juice. Cook, stirring, until the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Add the drained artichoke hearts, tomato, feta, parsley, oregano, and cooked linguine. Toss until evenly combined and warmed through, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Season with salt and pepper and serve with the lemon wedges."
    }
  ],
