{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "baked-cod-with-herb-cheese",
  "name": "Baked Cod with Herb Cheese",
  "subtitle": "Tender cod baked under a creamy tomato topping",
  "description": "Cod fillets are coated with butter, topped with seasoned herb cheese, tomatoes, and Parmesan, then baked until opaque and flaky.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "fresh-cod-fillets",
      "item": "fresh cod fillets",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "boursin-cheese-with-herbs",
      "item": "Boursin cheese with herbs",
      "quantity": 1,
      "unit": "package",
      "preparation": "4 ounce, room temperature"
    },
    {
      "ingredient_id": "tomatoes-with-garlic",
      "item": "tomatoes with garlic",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.5 ounce, diced, onion, and peppers, drained"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "parmesan-cheese",
      "item": "Parmesan cheese",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Brush a baking dish with the melted butter and place the cod fillets inside. Season with salt and ground black pepper."
    },
    {
      "step": 3,
      "text": "Stir together the room-temperature herb cheese, drained tomatoes, salt, and ground black pepper. Spoon the mixture over the cod and sprinkle with Parmesan."
    },
    {
      "step": 4,
      "text": "Bake for 25 minutes, until the cod reaches 145°F internally and is opaque and easily flaked with a fork.",
      "timer_minutes": 25
    }
  ],
