  "id": "chicken-with-basil-cream-sauce",
  "name": "Chicken with Basil Cream Sauce",
  "subtitle": "Crisp-coated chicken with a creamy pepper and basil sauce",
  "description": "Breaded chicken breasts are skillet-cooked in butter, then finished with a quick cream sauce flavored with pimento peppers, Parmesan, basil, and black pepper.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "dried-bread-crumbs",
      "item": "dried bread crumbs",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breasts"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
