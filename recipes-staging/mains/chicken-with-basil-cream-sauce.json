      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "4-ounce-jar-sliced-pimento-peppers",
      "item": "(4 ounce) jar sliced pimento peppers",
      "quantity": 1,
      "preparation": "drained"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "basil",
      "item": "fresh basil",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the milk and bread crumbs in separate shallow dishes. Dip each chicken breast in the milk, then coat it with bread crumbs."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat. Cook the coated chicken until browned and the thickest part reaches 165°F, about 5 minutes per side. Transfer the chicken to a plate.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Pour the chicken broth into the skillet and bring it to a gentle simmer. Whisk in the cream and drained pimento peppers."
    },
    {
      "step": 4,
      "text": "Stir for about 1 minute, then add the Parmesan, basil, and black pepper. Stir until the cheese is incorporated.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Return the chicken to the skillet and spoon the sauce over it before serving."
    }
  ],
