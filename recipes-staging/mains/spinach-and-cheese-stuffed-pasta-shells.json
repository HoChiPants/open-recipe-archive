  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Bring a large pot of water seasoned with salt and pepper to a boil. Add the shells and cook until tender, then drain."
    },
    {
      "step": 3,
      "text": "Combine the spinach, ricotta, Parmesan, fennel seed, basil, garlic, and additional salt and pepper as needed."
    },
    {
      "step": 4,
      "text": "Spread some spaghetti sauce in a baking dish. Fill the shells with the spinach-cheese mixture and arrange them in the dish."
    },
    {
      "step": 5,
      "text": "Spoon the remaining spaghetti sauce over the shells and sprinkle with Parmesan from the filling mixture."
    },
    {
      "step": 6,
      "text": "Bake until hot and bubbling.",
      "timer_minutes": 30
    }
  ],
