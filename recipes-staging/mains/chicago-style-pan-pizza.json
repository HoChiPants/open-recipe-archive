  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Press the thawed (1 pound) loaf frozen bread dough evenly into a deep baking pan, forming a crust up the sides."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a skillet. Add the bulk Italian sausage, breaking it up as it cooks. Stir in the fresh mushrooms and onion; cook until the onion is tender and the sausage reaches 160°F."
    },
    {
      "step": 4,
      "text": "Stir in the tomatoes, dried oregano, salt, fennel seed, and garlic powder, then remove the filling from the heat."
    },
    {
      "step": 5,
      "text": "Spread the sausage mixture over the dough and cover it with the mozzarella cheese and freshly grated Parmesan cheese."
    },
    {
      "step": 6,
      "text": "Bake for 35 minutes, until the crust and cheese are golden brown and the center is hot.",
      "timer_minutes": 35
    }
  ],
