  "id": "chicago-style-pan-pizza",
  "name": "Chicago-Style Pan Pizza",
  "subtitle": "A deep-pan pizza with sausage, mushrooms, tomatoes, and a browned cheese topping.",
  "description": "Thawed bread dough forms the crust for a savory sausage-and-tomato filling finished with mozzarella and Parmesan.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
