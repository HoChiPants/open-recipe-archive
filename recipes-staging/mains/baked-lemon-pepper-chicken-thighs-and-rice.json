{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "baked-lemon-pepper-chicken-thighs-and-rice",
  "name": "Baked Lemon-Pepper Chicken Thighs and Rice",
  "subtitle": "Tender chicken thighs baked over savory lemon rice",
  "description": "Chicken thighs are browned, then baked with onion-seasoned rice, stock, lemon, and pepper in one dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "bone-in",
      "item": "bone-in",
      "quantity": 5,
      "unit": "medium",
      "preparation": "skin-on chicken thighs"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.5,
      "unit": "teaspoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "lemon-pepper-seasoning",
      "item": "lemon-pepper seasoning",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "divided"
    },
    {
      "ingredient_id": "butter",
      "item": "salted butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "medium",
      "preparation": "diced"
    },
    {
      "ingredient_id": "chicken-stock",
      "item": "chicken stock",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "long-grain-white-rice",
      "item": "long-grain white rice",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "freshly-squeezed-lemon-juice",
      "item": "freshly squeezed lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Combine the lemon-pepper seasoning with half the salt and half the garlic powder; season the chicken thighs."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in an ovenproof skillet over medium-high heat. Brown the chicken skin-side down for 4 minutes, then transfer it to a plate.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Melt the butter in the skillet. Add the onion and cook until softened, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the stock, water, rice, lemon juice, remaining salt, remaining garlic powder, and black pepper. Bring the mixture to a simmer, then remove from the heat."
    },
    {
      "step": 5,
      "text": "Set the chicken thighs skin-side up over the rice. Cover the skillet and bake for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Uncover and check the rice. If needed, add the reserved stock and stir the rice, keeping the chicken on top."
    },
    {
      "step": 7,
      "text": "Continue baking uncovered until the rice is tender and the chicken reaches 165°F in the thickest part, about 15 minutes.",
      "timer_minutes": 15
    }
  ],
