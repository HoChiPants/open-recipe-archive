  "instructions": [
    {
      "step": 1,
      "text": "Combine the sage, rosemary, salt, thyme, fennel seed, sugar, and crumbled bay leaf."
    },
    {
      "step": 2,
      "text": "Coat the pork chops with the olive oil, then rub them evenly with the herb mixture."
    },
    {
      "step": 3,
      "text": "Cover and chill for 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 4,
      "text": "Preheat the grill to medium-high heat."
    },
    {
      "step": 5,
      "text": "Grill the chops for 4 minutes per side, turning as needed, until the thickest part reaches 145°F.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Rest the chops for 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
