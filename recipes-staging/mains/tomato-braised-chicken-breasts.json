  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Mix the flour, ½ teaspoon salt, and pepper in a shallow dish. Coat the chicken evenly in the mixture."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large ovenproof skillet over medium heat. Brown the coated chicken on both sides, working in batches if needed."
    },
    {
      "step": 3,
      "text": "Stir the tomatoes with their liquid, water, brown sugar, vinegar, Worcestershire sauce, remaining salt, chili powder, mustard powder, celery seed, garlic, and hot pepper sauce."
    },
    {
      "step": 4,
      "text": "Pour the tomato mixture around the chicken. Bring it to a gentle simmer, cover the skillet, and transfer it to the oven."
    },
    {
      "step": 5,
      "text": "Cook for 40 minutes, or until the chicken is tender and reaches 165°F at the thickest part.",
      "timer_minutes": 40
    }
  ],
