  "id": "cucumber-slaw",
  "name": "Cucumber Slaw",
  "subtitle": "A crisp, tangy no-cook vegetable slaw",
  "description": "Thinly sliced cucumbers, shredded carrots, and grated onion are tossed with a lightly sweetened coriander-vinegar dressing.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "cucumber",
      "item": "cucumbers",
      "quantity": 2,
      "preparation": "quartered, seeded, and thinly sliced"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 2,
      "preparation": "shredded"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.25,
      "preparation": "grated"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-coriander",
      "item": "ground coriander",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "coarse-ground-black-pepper",
      "item": "coarse ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "apple-cider-vinegar",
      "item": "apple cider vinegar",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the cucumbers, carrots, onion, sugar, coriander, salt, and pepper in a large bowl."
    },
    {
      "step": 2,
      "text": "Pour in the apple cider vinegar and toss until the vegetables are evenly coated. Serve immediately."
    }
  ],
