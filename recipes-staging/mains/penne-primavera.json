      "item": "broccoli florets",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "carrot",
      "item": "carrot",
      "quantity": 1,
      "unit": "medium",
      "preparation": "julienned"
    },
    {
      "ingredient_id": "vegetable-broth",
      "item": "vegetable broth",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "penne-pasta",
      "item": "penne pasta",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
