  "id": "penne-primavera",
  "name": "Penne Primavera",
  "subtitle": "One-pot pasta with vegetables and Parmesan",
  "description": "Penne cooks in vegetable broth with broccoli, carrot, peas, and garlic for a simple vegetable-forward meal finished with Parmesan.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
