      "item": "freshly grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. Add the crushed garlic and cook until tender."
    },
    {
      "step": 2,
      "text": "Add the broccoli florets and julienned carrot. Cook for 2 minutes, stirring occasionally.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Pour in the vegetable broth and bring it to a simmer."
    },
    {
      "step": 4,
      "text": "Stir in the penne pasta. Cook for 5 minutes, then add the frozen peas.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Continue cooking for 10 minutes, stirring occasionally, until the pasta is tender and most of the broth is absorbed.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Serve topped with the freshly grated Parmesan cheese."
    }
  ],
