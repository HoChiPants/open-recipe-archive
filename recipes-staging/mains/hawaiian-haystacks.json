  "instructions": [
    {
      "step": 1,
      "text": "Combine the cream of chicken soup, cooked chicken, and soy sauce in a saucepan. Stir in the milk until smooth, adding more milk as needed."
    },
    {
      "step": 2,
      "text": "Warm the chicken mixture over medium heat for 10 minutes, stirring occasionally, until smooth and steaming. If checking with a thermometer, reheat the poultry mixture to 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Arrange the cooked rice on a serving platter or in individual bowls."
    },
    {
      "step": 4,
      "text": "Spoon the warm chicken mixture over the rice, then arrange the chow mein noodles, pineapple, Cheddar, celery, bell peppers, green onions, coconut, and almonds over the top."
    }
  ],
