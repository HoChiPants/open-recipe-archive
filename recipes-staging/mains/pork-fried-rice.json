  "instructions": [
    {
      "step": 1,
      "text": "Heat 2 teaspoons oil in a large skillet or wok. Add the mushrooms and stir-fry until set, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Transfer the mushrooms to a bowl. Add the divided oil to the skillet, then stir-fry the pork, garlic, and ginger for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the celery, onion, and carrot; stir-fry for 4 minutes. Return the mushrooms to the skillet with the cooled rice and red bell pepper, and toss until combined.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Add the soy sauce and green onions, then stir until evenly distributed and the rice and pork are hot. If reheating leftover pork, heat the mixture thoroughly before serving."
    }
  ],
