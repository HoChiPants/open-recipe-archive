  "instructions": [
    {
      "step": 1,
      "text": "Warm the butter and olive oil in a large pot over medium heat. Add the onion, celery, and pinch of salt; cook until the onion softens, about 7 minutes. Stir in the garlic for 1 minute.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Pour in the wine and scrape up any browned bits. Add the tomato puree, water, bay leaf, oregano, pepper flakes, Worcestershire sauce, and remaining salt and pepper. Bring to a gentle simmer and cook for 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 3,
      "text": "Add the lemon slices and cod. Simmer for 2 minutes, then add the crab, shrimp, and mussels. Cover and cook about 5 minutes, until the shrimp and cod are opaque and reach 145°F, the mussels open, and any unopened mussels are discarded.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Fold in the parsley and basil, adjust the seasoning, and serve hot."
    }
  ],
