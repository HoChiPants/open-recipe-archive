{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "baked-shrimp-scampi",
  "name": "Baked Shrimp Scampi",
  "subtitle": "Tender shrimp with lemon-garlic butter and crisp crumbs",
  "description": "Shrimp are briefly cooked, coated in a bright butter and wine mixture, then baked with seasoned bread crumbs until golden and opaque.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "large-shrimp",
      "item": "large shrimp",
      "quantity": 1,
      "unit": "pound",
      "preparation": "peeled and deveined"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dried-parsley",
      "item": "dried parsley",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "minced"
    },
    {
      "ingredient_id": "italian-seasoned-bread-crumbs",
      "item": "Italian-seasoned bread crumbs",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Transfer the peeled and deveined shrimp to a pan and cook for 3 minutes, until opaque. Drain well.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Combine the butter, white wine, lemon juice, parsley, cayenne, and garlic."
    },
    {
      "step": 3,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 4,
      "text": "Arrange the drained shrimp in a baking dish and pour over the butter mixture. Top with the seasoned bread crumbs."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until the crumbs are golden and the shrimp are opaque and easily flaked.",
      "timer_minutes": 15
    }
  ],
