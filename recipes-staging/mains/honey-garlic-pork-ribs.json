  "id": "honey-garlic-pork-ribs",
  "name": "Honey Garlic Pork Ribs",
  "subtitle": "Oven-baked ribs with a sweet, savory glaze",
  "description": "Pork spareribs are coated in a honey-garlic sauce and baked until they reach a safe temperature and are ready to serve.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "pork-spareribs",
      "item": "pork spareribs",
      "quantity": 4,
      "unit": "pounds"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Cut the spareribs into serving-size sections."
    },
    {
      "step": 3,
      "text": "Stir together the honey, brown sugar, and baking soda. Mix in the soy sauce, vinegar, minced garlic, and garlic salt until combined."
    },
    {
      "step": 4,
      "text": "Arrange the ribs in a baking dish and coat them evenly with the sauce."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, or until a thermometer inserted into the thickest part reads at least 145°F. Rest the ribs for 3 minutes before serving.",
      "timer_minutes": 60
    }
  ],
