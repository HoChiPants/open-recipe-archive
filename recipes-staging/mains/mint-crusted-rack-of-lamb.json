  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Bring a small saucepan of water to a simmer, add the mint, and cook briefly until wilted. Transfer the mint to cold water, then drain well."
    },
    {
      "step": 2,
      "text": "Blend the mint with the sliced garlic, olive oil, bread crumbs, Parmigiano-Reggiano, cayenne, and the listed seasonings until a coarse paste forms. Stir until evenly combined."
    },
    {
      "step": 3,
      "text": "Mix 1/4 cup Dijon mustard with 2 teaspoons honey. Season the trimmed lamb racks with the listed salt, pepper, and cayenne."
    },
    {
      "step": 4,
      "text": "Warm the vegetable oil in an ovenproof skillet over medium-high heat. Sear the racks for 3 minutes, turning to brown the exterior.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Transfer the lamb to a work surface. Brush it with the mustard-honey mixture and press on the mint crumb coating. Return the racks to the skillet and roast for about 20 minutes, or until the thickest part reaches 145°F.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Whisk the extra-virgin olive oil, rice vinegar, remaining honey, remaining Dijon mustard, and salt and pepper to taste into a sauce."
    },
    {
      "step": 7,
      "text": "Rest the lamb for 3 minutes before slicing between the bones. Serve with the sauce.",
      "timer_minutes": 3
    }
  ],
