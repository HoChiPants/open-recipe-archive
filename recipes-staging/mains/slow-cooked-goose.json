  "instructions": [
    {
      "step": 1,
      "text": "Stir the celery, carrots, three soups, mushrooms, sage, rosemary, and thyme together in a slow cooker."
    },
    {
      "step": 2,
      "text": "Add the cut-up goose and turn the pieces to coat them with the mixture."
    },
    {
      "step": 3,
      "text": "Cover and cook on low until the goose is tender, about 6 hours; verify that the thickest pieces reach 165°F with a food thermometer.",
