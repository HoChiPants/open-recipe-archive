{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pigs-in-blankets-vegetable-casserole",
  "name": "Pigs-in-Blankets Vegetable Casserole",
  "subtitle": "Roasted root vegetables and sausages with a tangy herb finish",
  "description": "Roast carrots, parsnips, and red onion with pigs in blankets, then finish with vinegar and optional cream or crème fraîche. Serve with mashed potato or leftover roasties.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "carrots-about-100g",
      "item": "carrots (about 100g)",
      "quantity": 2,
      "unit": "medium",
      "preparation": "cut into thick slices"
    },
    {
      "ingredient_id": "parsnips-about-80g",
      "item": "parsnips (about 80g)",
      "quantity": 2,
      "unit": "small",
      "preparation": "peeled, woody cores removed and cut into chunks"
    },
    {
      "ingredient_id": "red-onion-cut-into-wedges",
      "item": "red onion cut into wedges",
      "quantity": 1
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "chipolata-sized-pigs-in-blankets-or-8-larger-ones",
      "item": "chipolata-sized pigs in blankets or 8 larger ones",
      "quantity": 16
    },
    {
      "ingredient_id": "wine-or-cider-vinegar",
      "item": "wine or cider vinegar",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "cream-or-cre-me-frai-che-optional",
      "item": "cream or crème fraîche (optional)",
      "quantity": "2-3",
      "unit": "tbsp",
      "optional": true
    },
    {
      "ingredient_id": "soft-herbs-such-as-basil-or-parsley",
      "item": "soft herbs such as basil or parsley",
      "quantity": 2,
      "unit": "tbsp",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "mashed-potato-or-leftover-roasties-see-tip",
      "item": "mashed potato or leftover roasties (see tip)",
      "preparation": "to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and place the carrots, parsnips, and red onion in a baking dish. Toss with the olive oil and spread into an even layer."
    },
    {
      "step": 2,
      "text": "Roast the vegetables until they begin to soften and color.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Add the pigs in blankets and roast until the sausages are browned.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Stir in the wine or cider vinegar, then continue cooking until the vegetables are tender and the sausages reach 160°F at the center.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Whisk the optional cream or crème fraîche with the chopped herbs. Spoon the casserole over mashed potato or leftover roasties and finish with the herb mixture."
    }
  ],
