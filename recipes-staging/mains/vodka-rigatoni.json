  "instructions": [
    {
      "step": 1,
      "text": "Drain the roasted red peppers, then cut them into small pieces."
    },
    {
      "step": 2,
      "text": "Combine the prosciutto, heavy cream, crushed tomatoes, vodka, roasted red peppers, parsley, garlic powder, sugar, salt, black pepper, and red pepper flakes in a large saucepan."
    },
    {
      "step": 3,
      "text": "Bring the sauce to a simmer and cook for 30 minutes, stirring occasionally.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Meanwhile, cook the rigatoni according to the package directions until tender; drain."
    },
    {
      "step": 5,
      "text": "Transfer the drained pasta to the sauce and stir in the peas and Parmesan until evenly coated and warmed through."
    }
  ],
