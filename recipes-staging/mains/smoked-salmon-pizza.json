      "item": "mozzarella cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Place the pre-baked pizza crust on a baking surface and brush it with the olive oil."
    },
    {
      "step": 3,
      "text": "Distribute the smoked salmon, artichoke hearts, and sun-dried tomatoes over the crust, then cover evenly with the mozzarella."
    },
    {
      "step": 4,
      "text": "Bake until the mozzarella is melted, about 15 minutes.",
      "timer_minutes": 15
    }
