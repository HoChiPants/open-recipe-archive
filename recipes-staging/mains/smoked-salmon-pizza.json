      "ingredient_id": "12-inch-pre-baked-pizza-crust",
      "item": "(12 inch) pre-baked pizza crust",
      "quantity": 1
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "smoked-salmon",
      "item": "smoked salmon",
      "quantity": 1,
      "unit": "cup",
      "preparation": "cut into 1/2 inch pieces"
    },
    {
      "ingredient_id": "6-ounce-jar-marinated-artichoke-hearts",
      "item": "(6 ounce) jar marinated artichoke hearts",
      "quantity": 0.5,
      "preparation": "drained and quartered"
    },
    {
