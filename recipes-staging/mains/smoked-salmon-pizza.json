  "id": "smoked-salmon-pizza",
  "name": "Smoked Salmon Pizza",
  "subtitle": "A crisp pizza topped with salmon, artichokes, tomatoes, and melted mozzarella.",
  "description": "Layer the prepared crust with olive oil, savory toppings, and shredded mozzarella, then bake until the cheese melts.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
