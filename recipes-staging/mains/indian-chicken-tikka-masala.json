  "instructions": [
    {
      "step": 1,
      "text": "Blend the tomatoes, yogurt, garlic, and ginger until smooth."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large skillet over medium heat. Add the onion and cook for 4 minutes, stirring occasionally. Stir in the masala curry paste and cook for 1 minute.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the blended tomato mixture and season with salt and pepper. Stir the water and flour together until smooth, then add the slurry to the skillet."
    },
    {
      "step": 4,
      "text": "Add the chicken, bring the sauce to a gentle simmer, and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Continue simmering for 15 minutes, stirring occasionally, until the sauce has thickened and the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Stir in the cilantro and serve."
    }
  ],
