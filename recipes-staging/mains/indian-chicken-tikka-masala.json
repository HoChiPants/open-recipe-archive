  "id": "indian-chicken-tikka-masala",
  "name": "Indian Chicken Tikka Masala",
  "subtitle": "Tender chicken in a smooth tomato-yogurt curry sauce",
  "description": "A warming Indian-style chicken curry built from blended aromatics, tomatoes, yogurt, and masala paste, then simmered until thick and fully cooked.",
  "meal_type": "main",
  "cuisine": "Indian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
