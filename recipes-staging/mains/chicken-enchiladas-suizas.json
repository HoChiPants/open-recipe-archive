  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken in a saucepan with the chicken broth. Season with salt and pepper, cover, and simmer until tender and the thickest piece reaches 165°F, about 20 minutes. Transfer the chicken to a plate, reserve the broth, and shred the meat when cool enough to handle.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Heat the oven to 350°F. Melt the butter in a skillet, then cook the onion and both bell peppers until softened, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Combine the shredded chicken, cooked vegetables, green chiles, green salsa, cilantro, cumin, chipotle peppers, and 1 cup of Cheddar. Season with salt and pepper."
    },
    {
      "step": 4,
      "text": "Whisk the reserved broth with the whipping cream. Spread a small amount of the mixture in a baking dish."
    },
    {
      "step": 5,
      "text": "Fill each tortilla with the chicken mixture, roll tightly, and arrange seam-side down in the dish. Pour the remaining cream mixture over the rolls and sprinkle with the remaining Cheddar and the Monterey Jack."
    },
    {
      "step": 6,
      "text": "Bake until the enchiladas are hot and the cheese is melted, about 30 minutes. Let them stand for 10 minutes before serving.",
      "timer_minutes": 30
    }
  ],
