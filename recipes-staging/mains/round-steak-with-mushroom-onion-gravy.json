  "id": "round-steak-with-mushroom-onion-gravy",
  "name": "Round Steak with Mushroom-Onion Gravy",
  "subtitle": "Tender baked steak in a savory creamy gravy",
  "description": "Thin-cut round steak is baked slowly with mushroom soup, French onion soup, and water until tender and richly sauced.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 130
  },
  "ingredients": [
    {
      "ingredient_id": "thin-cut-round-steak",
      "item": "thin cut round steak",
      "quantity": 1.5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "condensed-french-onion-soup",
      "item": "condensed French onion soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Cut the round steak into serving-size pieces and arrange them in a baking dish."
    },
    {
      "step": 3,
      "text": "Whisk together the mushroom soup, French onion soup, and water until smooth, then pour the mixture over the steak."
    },
    {
      "step": 4,
      "text": "Cover the dish and bake for 120 minutes, until the steak reaches at least 145°F in the thickest part. Rest for 3 minutes before serving.",
      "timer_minutes": 120
    }
  ],
