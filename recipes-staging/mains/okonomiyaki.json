  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour and water until smooth. Stir in the cabbage, crumbled bacon, eggs, diced sausage, green onions, cooked shrimp, shredded cheese, and tempura pearls until evenly coated."
    },
    {
      "step": 2,
      "text": "Preheat a lightly oiled skillet or griddle to 400°F. Add the mixture, shape it into a thick round pancake, and cook for 6 minutes, until the underside is golden brown.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Turn the pancake and cook until the second side is golden and the center is firm and fully set, reaching 160°F on a food thermometer."
    },
    {
      "step": 4,
      "text": "Mix the soy sauce, ketchup, and white vinegar. Serve the pancake with the sauce, then finish with panko and mayonnaise."
    }
  ],
