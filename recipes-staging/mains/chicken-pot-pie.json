  "id": "chicken-pot-pie",
  "name": "Chicken Pot Pie",
  "subtitle": "A quick crescent-topped chicken and vegetable bake.",
  "description": "Pantry chicken, vegetables, and creamy soup filling baked beneath a golden crescent-roll crust.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "white-meat-chicken",
      "item": "white meat chicken",
      "quantity": 3,
      "unit": "can",
      "preparation": "6 ounce, drained and broken into chunks"
    },
    {
      "ingredient_id": "mixed-vegetables",
      "item": "mixed vegetables",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, drained"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, diced, drained"
    },
    {
      "ingredient_id": "cream-of-chicken-soup",
      "item": "cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce, or more to taste"
    },
    {
      "ingredient_id": "refrigerated-crescent-rolls",
      "item": "refrigerated crescent rolls",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "In a baking dish, combine the chicken, mixed vegetables, potatoes, and cream of chicken soup until evenly coated."
    },
    {
      "step": 3,
      "text": "Unroll the crescent-roll dough and arrange it over the filling, pinching seams together as needed to form a top crust."
    },
    {
      "step": 4,
      "text": "Bake until the crust is golden brown and the filling reaches 165°F in the center.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Let stand briefly before serving."
    }
  ],
