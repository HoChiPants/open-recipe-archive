  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill."
    },
    {
      "step": 2,
      "text": "Place the orange roughy fillets with the lemon in a grill-safe dish."
    },
    {
      "step": 3,
      "text": "Grill the fillets for 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Mix the Parmesan, softened butter, Dijon-mayonnaise blend, garlic, and salt. Spread the mixture over the fillets and sprinkle with paprika."
    },
    {
      "step": 5,
      "text": "Grill for 3 minutes, until lightly browned and the fish reaches 145°F or is opaque and flakes easily.",
      "timer_minutes": 3
    }
  ],
