  "instructions": [
    {
      "step": 1,
      "text": "Pulse the red pepper, shallots, two grated garlic cloves, lemon peel, and ginger in a food processor. Add the grated carrots and pulse briefly."
    },
    {
      "step": 2,
      "text": "Add the drained chickpeas and blend to a coarse mixture. Transfer to a bowl, then mix in the garam masala, cumin, ground coriander, flour, egg, and chopped fresh coriander."
    },
    {
      "step": 3,
      "text": "Shape the mixture into 12 small fritters and let them stand briefly so they firm up.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Heat a thin layer of vegetable oil in a skillet. Fry the fritters in batches until browned on both sides and the centers are fully set, reaching 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Combine the grated cucumber, one grated garlic clove, and Greek yoghurt or dairy-free alternative. Stir in the ground coriander and fresh coriander, then serve with the fritters."
    }
  ],
