  "id": "hungarian-beef-goulash-0e6a0d94",
  "name": "Hungarian Beef Goulash",
  "subtitle": "Paprika-braised beef with tender onions",
  "description": "Beef chuck and sliced onions simmer with Hungarian paprika until tender and thick.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 125
  },
  "ingredients": [
    {
      "ingredient_id": "lard",
      "item": "lard",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "unit": "large",
      "preparation": "finely sliced"
    },
    {
      "ingredient_id": "beef-chuck",
      "item": "beef chuck",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "cut into 1-inch cubes"
    },
    {
      "ingredient_id": "hungarian-paprika",
      "item": "Hungarian paprika",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the lard in a heavy pot over medium heat. Add the onions and cook, stirring, for 8 minutes until softened.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Stir in the beef and paprika, coating the meat and onions evenly."
    },
    {
      "step": 3,
      "text": "Cover and cook over low heat for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Add the water, cover, and continue cooking for 60 minutes, adding more water as needed, until the goulash is thick and the beef is tender. Check that the beef reaches at least 145°F, then rest it for 3 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Season with salt and ground black pepper to taste."
    }
  ],
