  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken with salt and half of the lemon juice."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet over medium heat. Add the chicken and cook until golden brown, turning once.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the remaining lemon juice and oregano. Continue cooking until the thickest part of the chicken reaches 165°F."
    },
    {
      "step": 4,
      "text": "Garnish with the parsley and serve."
    }
  ],
