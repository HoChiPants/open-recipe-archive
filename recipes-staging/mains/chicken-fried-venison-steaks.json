{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chicken-fried-venison-steaks",
  "name": "Chicken-Fried Venison Steaks",
  "subtitle": "Crisp breaded venison with a tender center",
  "description": "Pounded venison steaks are dipped in seasoned crumbs, coated with egg wash, and pan-fried until crisp and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "seasoned-dry-bread-crumbs",
      "item": "seasoned dry bread crumbs",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-black-pepper-to-taste",
      "item": "salt and black pepper to taste"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "6-ounce-venison-loin-steaks",
      "item": "(6 ounce) venison loin steaks",
      "quantity": 4,
      "preparation": "pounded to 1/4 inch thick"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the seasoned bread crumbs, flour, salt, and black pepper in a shallow dish."
    },
    {
      "step": 2,
      "text": "Whisk the eggs and milk together in a second shallow dish."
    },
    {
      "step": 3,
      "text": "Dip each venison steak in the egg mixture, then press it into the crumb mixture until evenly coated."
    },
    {
      "step": 4,
      "text": "Preheat the vegetable oil in a large skillet over medium heat."
    },
    {
      "step": 5,
      "text": "Cook the steaks in the hot oil until golden brown, about 4 minutes per side, and verify that the thickest part reaches 160°F with a food thermometer.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Transfer the steaks to a serving plate and serve hot."
    }
  ],
