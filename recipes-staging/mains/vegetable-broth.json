      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "celery",
      "item": "celery",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into 1-inch pieces"
    },
    {
