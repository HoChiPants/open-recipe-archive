  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Arrange the onions, tomatoes, carrots, green bell pepper, and turnips in a roasting pan. Toss with the olive oil."
    },
    {
      "step": 3,
      "text": "Roast until the onions are tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Transfer the roasted vegetables to a large stockpot. Add the celery, parsley, garlic, peppercorns, cloves, bay leaf, and water."
    },
    {
      "step": 5,
      "text": "Bring the mixture to a boil, then reduce the heat and simmer gently until the vegetables and aromatics have infused the broth, about 75 minutes.",
      "timer_minutes": 75
    },
    {
      "step": 6,
      "text": "Strain the broth through a fine-mesh sieve before serving or using in another dish."
    }
  ],
