  "id": "vegetable-broth",
  "name": "Vegetable Broth",
  "subtitle": "Roasted vegetables simmered with herbs and spices",
  "description": "A full-bodied broth made from roasted vegetables, fresh parsley, garlic, and whole spices.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-onions",
      "item": "sweet onions",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "peeled and cut into wedges"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cored and quartered"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into 1-inch pieces"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into 1-inch pieces"
    },
    {
      "ingredient_id": "turnips",
      "item": "turnips",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "cubed"
    },
    {
