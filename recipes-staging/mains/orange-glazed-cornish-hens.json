  "instructions": [
    {
      "step": 1,
      "text": "Stir together the olive oil, 1 tablespoon Dijon mustard, lemon and orange zest and juice, garlic, salt, and pepper. Coat the hens thoroughly and refrigerate for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Heat the oven to 450°F. In a separate bowl, combine the remaining Dijon mustard, orange juice, soy sauce, honey, onion, ginger, and pepper."
    },
    {
      "step": 3,
      "text": "Arrange the hens in a roasting pan and pour the glaze over them."
    },
    {
      "step": 4,
      "text": "Roast for 50 minutes, basting with the pan juices and glaze during cooking. Continue roasting as needed until a thermometer inserted into the thickest part of each hen registers 165°F.",
      "timer_minutes": 50
    },
    {
      "step": 5,
      "text": "Rest briefly before serving with the pan juices."
    }
  ],
