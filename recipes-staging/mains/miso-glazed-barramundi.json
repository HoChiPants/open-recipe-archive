  "id": "miso-glazed-barramundi",
  "name": "Miso-Glazed Barramundi",
  "subtitle": "Pan-cooked barramundi with a sweet-savory miso glaze",
  "description": "Barramundi fillets are coated in a quick miso glaze and seared in a lightly oiled skillet until opaque and flaky.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "yellow-miso-paste",
      "item": "yellow miso paste",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "seasoned-rice-vinegar",
      "item": "seasoned rice vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "5-ounce-barramundi-asian-sea-bass-fillets",
      "item": "(5 ounce) barramundi (Asian sea bass) fillets",
      "quantity": 2
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the miso, rice vinegar, brown sugar, and soy sauce in a bowl until smooth."
    },
    {
      "step": 2,
      "text": "Coat the barramundi fillets evenly with the glaze."
    },
    {
      "step": 3,
      "text": "Preheat a skillet over medium-high heat, add the oil, and place in the fillets. Cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Turn the fillets and cook for 2 minutes more, until the fish reaches 145°F, is opaque, and flakes easily.",
      "timer_minutes": 2
    }
  ],
