      "item": "freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Cook the bacon in an oven-safe skillet until partially rendered and set; transfer it to a plate."
    },
    {
      "step": 2,
      "text": "Sear the partridge breasts in the bacon drippings for 2 minutes, then wrap each breast with bacon and secure it with a toothpick.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Return the wrapped breasts to the skillet. Add the broth, wine, shallots, garlic, salt, and pepper."
    },
    {
      "step": 4,
      "text": "Roast until the thickest part of each breast reaches 165°F on a food thermometer, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Transfer the cooked breasts to a serving dish. Whisk the flour into the skillet juices and cook until the sauce thickens."
    },
    {
      "step": 6,
      "text": "Remove the toothpicks and serve the partridge with the sauce."
    }
  ],
