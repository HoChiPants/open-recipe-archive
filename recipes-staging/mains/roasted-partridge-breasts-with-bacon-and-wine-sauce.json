  "id": "roasted-partridge-breasts-with-bacon-and-wine-sauce",
  "name": "Roasted Partridge Breasts with Bacon and Wine Sauce",
  "subtitle": "Bacon-wrapped game bird with a savory pan sauce",
  "description": "Partridge breasts are wrapped in bacon, roasted with wine and aromatics, then served with the thickened pan juices.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 60
  },
  "ingredients": [
