  "instructions": [
    {
      "step": 1,
      "text": "Cook the penne in simmering water for 12 minutes, or until tender. Drain and cool briefly.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Stir together the yogurt, sherry vinegar, mustard powder, and chopped spring onions."
    },
    {
      "step": 3,
      "text": "Combine the penne, celery, and cooked chicken with the yogurt dressing."
    },
    {
      "step": 4,
      "text": "Fold in the walnut pieces and halved grapes. Serve with the lettuce leaves."
