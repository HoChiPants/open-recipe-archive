  "id": "marinated-peppers",
  "name": "Marinated Peppers",
  "subtitle": "Roasted peppers with herbs, garlic, and balsamic",
  "description": "Colorful bell peppers are roasted, sliced, and dressed with garlic, herbs, balsamic vinegar, and olive oil.",
