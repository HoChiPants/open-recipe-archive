  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Place the whole bell peppers on a baking sheet and season with salt and pepper."
    },
    {
      "step": 3,
      "text": "Roast the peppers for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Transfer the roasted peppers to a work surface, then remove the stems and seeds and slice the peppers."
    },
    {
      "step": 5,
      "text": "Stir the sliced peppers with the garlic, balsamic vinegar, olive oil, basil, parsley, and additional salt and pepper to taste."
    }
  ],
