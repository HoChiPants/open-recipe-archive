      "item": "fresh cilantro",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. Add the onion and garlic, and stir for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Stir in the curry powder and tomato paste; cook for 3 minutes until fragrant.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the tomatoes, vegetable bouillon, frozen mixed vegetables, water, salt, and pepper. Stir to combine."
    },
    {
      "step": 4,
      "text": "Bring to a simmer and cook until the vegetables are tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Stir in the fresh cilantro and serve hot."
    }
  ],
