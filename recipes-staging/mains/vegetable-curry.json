  "id": "vegetable-curry",
  "name": "Vegetable Curry",
  "subtitle": "A saucy curry with tomatoes and mixed vegetables",
  "description": "Build a fragrant tomato-based curry with onion, garlic, warm spices, and frozen vegetables, then finish with fresh cilantro.",
  "meal_type": "main",
  "cuisine": "Asian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "curry-powder",
      "item": "curry powder",
      "quantity": 2.5,
      "unit": "tablespoons"
    },
    {
