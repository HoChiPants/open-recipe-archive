      "item": "cube vegetable bouillon",
      "quantity": 1
    },
    {
      "ingredient_id": "frozen-mixed-vegetables",
      "item": "frozen mixed vegetables",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce"
    },
    {
