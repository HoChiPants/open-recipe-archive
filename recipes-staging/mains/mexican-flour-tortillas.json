{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "mexican-flour-tortillas",
  "name": "Mexican Flour Tortillas",
  "subtitle": "Soft, homemade flour tortillas for the table",
  "description": "A simple dough of flour, leavening, fat, salt, and hot water, rested and cooked on a hot skillet until lightly spotted.",
  "meal_type": "main",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 25,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "shortening-or-lard",
      "item": "shortening or lard",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "hot-water",
      "item": "hot water",
      "quantity": 0.75,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, baking powder, and salt in a bowl."
    },
    {
      "step": 2,
      "text": "Cut in the shortening or lard until the mixture is evenly crumbly."
    },
    {
      "step": 3,
      "text": "Add the hot water and mix until a dough forms. Knead until smooth."
    },
    {
      "step": 4,
      "text": "Divide the dough into 12 portions and shape each into a ball on a lightly floured surface."
    },
    {
      "step": 5,
      "text": "Cover and let the dough rest for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Flatten each ball into a thick disk, then roll it into a thin round."
    },
    {
      "step": 7,
      "text": "Preheat a dry skillet or griddle over medium-high heat."
    },
    {
      "step": 8,
      "text": "Cook each tortilla on the hot surface for about 1 minute per side, until lightly browned in spots and cooked through.",
      "timer_minutes": 1
    },
    {
      "step": 9,
      "text": "Transfer the cooked tortillas to a plate, keep them covered, and serve warm."
    }
  ],
