  "id": "air-fryer-garlic-oregano-lamb-with-crispy-new-potatoes",
  "name": "Air-Fryer Garlic-Oregano Lamb with Crispy New Potatoes",
  "subtitle": "Herb-scented lamb served with crisp, cheesy potatoes",
  "description": "Garlic, oregano, and lemon flavor a tender lamb leg, while baby new potatoes finish crisp with a light pecorino or parmesan coating.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 65
  },
  "ingredients": [
    {
      "ingredient_id": "bone-in-half-leg-of-lamb",
      "item": "bone-in half leg of lamb",
      "quantity": "1-1.2",
      "unit": "kg"
    },
    {
      "ingredient_id": "garlic-cloves-quartered-lengthways",
      "item": "garlic cloves quartered lengthways",
      "quantity": 2
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "oregano-leaves-roughly-chopped",
      "item": "oregano leaves roughly chopped",
      "quantity": 1,
      "unit": "tbsp",
      "preparation": "plus a sprig to serve"
    },
    {
      "ingredient_id": "lemon-zested-and-juiced",
      "item": "lemon zested and juiced",
      "quantity": 1,
      "preparation": "plus slices to serve"
    },
    {
      "ingredient_id": "baby-new-potatoes",
      "item": "baby new potatoes",
      "quantity": 750,
      "unit": "g"
    },
    {
      "ingredient_id": "pecorino-or-parmesan-finely-grated",
      "item": "pecorino or parmesan finely grated",
      "quantity": 2,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Make small cuts in the lamb and press the quartered garlic into them. Rub with olive oil, chopped oregano, lemon zest, and lemon juice. Leave to stand for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Preheat the air fryer according to the appliance instructions. Add the lamb and cook, turning as needed, until the thickest part reaches 145°F.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Meanwhile, prepare the baby new potatoes according to the appliance instructions, then cook until crisp and tender. Toss with the grated pecorino or parmesan.",
      "timer_minutes": 65
    },
    {
      "step": 4,
      "text": "Transfer the lamb to a board, cover loosely, and rest for at least 3 minutes before slicing.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Serve the sliced lamb with the potatoes, lemon slices, and the oregano sprig."
    }
  ],
