{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "lemon-basil-chicken",
  "name": "Lemon Basil Chicken",
  "subtitle": "Skillet chicken with bright lemon and fresh basil",
  "description": "Boneless chicken breasts are lightly floured, browned in butter, and simmered with lemon, basil, zest, and chicken stock.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-breast-halves",
      "item": "chicken breast halves",
      "quantity": 4,
      "preparation": "boned and skinned"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "chicken-stock",
      "item": "chicken stock",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "basil",
      "item": "fresh basil",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly coat the chicken breast halves with the flour, shaking off the excess."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat. Add the chicken and chicken stock, and sauté until the chicken is lightly browned, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir in the lemon juice, chopped basil, and lemon zest. Bring the liquid to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Simmer until the chicken is cooked through and reaches 165°F at the thickest point, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer the chicken to a serving dish and spoon the lemon-basil sauce over it."
    }
  ],
  "tags": [
    "dinner",
    "chicken",
    "skillet",
    "lemon",
    "basil"
  ],
  "seasons": [
    "year-round"
  ],
