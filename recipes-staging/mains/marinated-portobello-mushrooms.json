    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir together the cooking wine, dark soy sauce, balsamic vinegar, olive oil, and minced garlic."
    },
    {
      "step": 2,
      "text": "Place the portobello mushroom caps in the marinade and let them stand for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Heat the oven to 400°F and arrange the marinated caps in a baking dish."
    },
    {
      "step": 4,
      "text": "Bake for 25 minutes, then continue baking until the mushrooms are tender.",
      "timer_minutes": 25
    }
  ],
