  "id": "marinated-portobello-mushrooms",
  "name": "Marinated Portobello Mushrooms",
  "subtitle": "Savory baked mushroom caps with balsamic marinade",
  "description": "Large portobello caps soak in a garlic-balsamic marinade before baking until tender.",
  "meal_type": "main",
