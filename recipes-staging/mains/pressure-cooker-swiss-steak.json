  "instructions": [
    {
      "step": 1,
      "text": "Cut the steak into four portions and season with salt and pepper. Dredge each piece in the flour, shaking off excess."
    },
    {
      "step": 2,
      "text": "Select the sauté function on a pressure cooker and heat part of the oil. Brown the steak for 2 minutes, turning as needed, then transfer it to a plate.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the remaining oil if needed. Sauté the bell pepper, onion, carrot, and celery for 4 minutes; add the garlic and cook for 1 minute.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Pour in the wine and scrape up any browned bits. Stir in the tomatoes, Worcestershire sauce, salt, oregano, paprika, and additional pepper."
    },
    {
      "step": 5,
      "text": "Return the steak and any juices to the pot. Seal the cooker and cook at high pressure for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Let the pressure release naturally for 15 minutes, then release any remaining pressure. Rest the beef for 5 minutes before serving.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Check the thickest portion with a food thermometer; whole-cut beef should reach at least 145°F, followed by a 3-minute rest. Serve with the sauce."
    }
  ],
