  "id": "pressure-cooker-swiss-steak",
  "name": "Pressure-Cooker Swiss Steak",
  "subtitle": "Tender beef in a savory tomato-vegetable sauce",
  "description": "Browned beef simmers under pressure with vegetables, wine, tomatoes, and seasonings for a hearty, saucy main dish.",
