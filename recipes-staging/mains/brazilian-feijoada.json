  "instructions": [
    {
      "step": 1,
      "text": "Cover the black beans with 2 quarts water and season with salt and pepper. Soak for 8 hours, then drain.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Return the beans to a large pot with fresh water, dried beef, bay leaf, and the pork chops. Bring to a simmer and cook until the beans are nearly tender, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Meanwhile, cook the bacon in a skillet until its fat renders. Add the linguica, Italian sausage, and 1 tablespoon parsley; cook for 10 minutes. Transfer the sausages to a board, then slice when cool enough to handle.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Cook the onion and garlic in the bacon fat for 5 minutes. Stir in the cumin, coriander, cayenne, and additional salt and pepper, then cook for 2 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Add the onion mixture to the beans. Remove the pork, bacon, and sliced sausages, cut the pork and bacon into smaller pieces, and return all of them to the pot. Add water as needed and simmer until the beans are tender and the stew thickens, about 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Check the meat with a thermometer: sausages should reach 160°F; pork should reach 145°F followed by a 3-minute rest. Continue cooking if needed."
    },
    {
      "step": 7,
      "text": "For the topping, heat the olive oil and toast the bread crumbs. Stir in 2 tablespoons parsley and the orange zest, then scatter over the stew."
    }
  ],
