  "instructions": [
    {
      "step": 1,
      "text": "Soak the rice vermicelli in water for 30 minutes, then drain well.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Heat the peanut oil in a large skillet or wok. Stir-fry the tofu until lightly browned, then drain and set aside."
    },
    {
      "step": 3,
      "text": "Cook the beaten egg in the same pan until fully set and at least 160°F. Transfer it to a plate."
    },
    {
      "step": 4,
      "text": "Return the pan to the heat with some of the oil. Cook the garlic briefly, then stir in the broth, lime juice, soy sauce, and sugar."
    },
    {
      "step": 5,
      "text": "Add the drained noodles and toss to coat. Fold in the tofu, salt, chili flakes, and the first portion of chopped peanuts."
    },
    {
      "step": 6,
      "text": "Add the cooked egg, bean sprouts, and green onion whites and greens. Stir for 2 minutes, until the sprouts are warmed and the mixture is combined.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Serve with the remaining peanuts and lime wedges."
    }
  ],
