  "id": "grilled-pork-chops",
  "name": "Grilled Pork Chops",
  "subtitle": "Soy-garlic marinated pork chops from the grill",
  "description": "Boneless pork chops marinated with soy sauce, lemon pepper, garlic, and oil, then grilled until tender and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
