  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, soy sauce, oil, lemon pepper seasoning, and garlic. Coat the pork chops with the marinade, cover, and refrigerate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Preheat the grill to medium-high heat. Remove the chops from the marinade and discard the marinade."
    },
    {
      "step": 3,
      "text": "Grill the chops, turning once, until browned and a thermometer inserted into the thickest part reads 145°F.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Rest the pork for 3 minutes, then serve.",
      "timer_minutes": 3
    }
  ],
