      "item": "metal or wooden skewers",
      "quantity": 4
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the mint, yogurt, lemon zest and juice, cumin, coriander, and grated ginger in a bowl. Reserve extra yogurt for serving if using."
    },
    {
      "step": 2,
      "text": "Coat the chicken pieces in the marinade and leave for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "If using wooden skewers, soak them in water for 20 minutes. Thread the chicken onto the skewers.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Preheat the grill to high."
    },
    {
      "step": 5,
      "text": "Grill the skewers, turning regularly, until the chicken is cooked through and reaches 165°F in the thickest piece.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Warm the flatbreads on the grill. Serve the chicken with the flatbreads, lettuce, red onion, and any optional cabbage, chili sauce, hummus, or extra yogurt."
    }
  ],
