  "id": "chicken-lemon-skewers",
  "name": "Chicken & Lemon Skewers",
  "subtitle": "Cumin-spiced chicken with mint yogurt and fresh sides",
  "description": "Chicken is marinated with lemon, ginger, cumin, and coriander, then grilled on skewers and served with warm flatbreads, lettuce, onion, and optional accompaniments.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
