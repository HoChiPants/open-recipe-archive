  "instructions": [
    {
      "step": 1,
      "text": "Combine the water and rice in a saucepan. Bring to a boil, reduce to a simmer, cover, and cook for 20 minutes, or until the rice is tender.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Stir together the soy sauce, peanut butter, white wine vinegar, and cayenne pepper until smooth; set aside."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a large skillet. Add the chicken, garlic, and ginger; cook until the aromatics are lightly browned and the chicken reaches 165°F internally.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the broccoli and prepared sauce. Cook until the broccoli is tender and the sauce is hot.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Spoon the chicken and broccoli over the rice. Top with the green onions and peanuts."
    }
  ],
