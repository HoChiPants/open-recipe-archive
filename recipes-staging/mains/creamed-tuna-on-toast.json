  "id": "creamed-tuna-on-toast",
  "name": "Creamed Tuna on Toast",
  "subtitle": "A quick savory tuna sauce served over crisp toast.",
  "description": "Warm tuna and celery soup with milk into a thick, creamy topping for toasted bread.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "condensed-cream-of-celery-soup",
      "item": "condensed cream of celery soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "tuna",
      "item": "tuna",
      "quantity": 1,
      "unit": "can",
      "preparation": "5 ounce, drained"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "slices-bread",
      "item": "slices bread",
      "quantity": 8,
      "preparation": "toasted"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the condensed soup and drained tuna in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Stir in the milk until smooth, then cook for 10 minutes, stirring occasionally, until thickened and heated through. Verify the tuna mixture reaches 145°F, or is steaming hot and the fish is opaque and flakes easily.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Season with salt and ground black pepper to taste."
    },
    {
      "step": 4,
      "text": "Spoon the creamed tuna over the toasted bread and serve."
    }
  ],
