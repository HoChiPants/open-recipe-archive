  "id": "slow-cooker-moose-roast",
  "name": "Slow Cooker Moose Roast",
  "subtitle": "Tender moose roast with apple-juice gravy",
  "description": "A simple slow-cooked moose roast seasoned with onion soup mix and apple juice.",
  "meal_type": "main",
