  "instructions": [
    {
      "step": 1,
      "text": "Preheat a skillet over medium-high heat and add the vegetable oil."
    },
    {
      "step": 2,
      "text": "Add the moose roast and brown it briefly on all sides."
    },
    {
      "step": 3,
      "text": "Place the roast in a slow cooker. Add the dry onion soup mix and apple juice."
    },
    {
      "step": 4,
      "text": "Cover and cook until tender, about 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 5,
      "text": "Check the thickest part with a food thermometer; cook until it reaches 145°F, then rest for 3 minutes before serving."
    }
  ],
