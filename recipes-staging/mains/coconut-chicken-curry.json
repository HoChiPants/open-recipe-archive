  "instructions": [
    {
      "step": 1,
      "text": "Heat the coconut oil in a large pot over medium-high heat. Add the cubed chicken and cook for 7 minutes, stirring occasionally, until browned and the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Add the onions, red bell pepper, jalapeno, garlic, ginger, and ground black pepper. Stir and cook for 7 minutes, until the aromatics soften.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Add the sweet potato, plantain, and carrots. Cook for 5 minutes, stirring occasionally, until beginning to soften.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the coconut milk, crushed tomatoes, and water. Bring the curry to a gentle simmer."
    },
    {
      "step": 5,
      "text": "Cook for 30 minutes, stirring occasionally.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Add the red bell pepper, jalapeno, baby kale, curry powder, sea salt, ground black pepper, and dried cilantro. Continue cooking for 30 minutes, until the sweet potato and carrots are tender and the chicken is fully cooked.",
      "timer_minutes": 30
    }
  ],
