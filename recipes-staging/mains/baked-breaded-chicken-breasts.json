  "id": "baked-breaded-chicken-breasts",
  "name": "Baked Breaded Chicken Breasts",
  "subtitle": "Mayonnaise-coated chicken with a crisp seasoned crumb crust",
  "description": "A straightforward oven-baked chicken dinner with a savory bread-crumb coating.",
  "meal_type": "main",
