      "item": "Italian seasoned bread crumbs",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Arrange a baking dish or sheet pan for the chicken."
    },
    {
      "step": 2,
      "text": "Season the chicken breast halves with salt and pepper."
    },
    {
      "step": 3,
      "text": "Spread mayonnaise over each piece of chicken, then press into the Italian seasoned bread crumbs to coat. Place the coated chicken in the prepared pan."
    },
    {
      "step": 4,
      "text": "Bake until the coating is browned and the thickest part of the chicken reaches 165°F on an instant-read thermometer.",
      "timer_minutes": 30
    }
  ],
