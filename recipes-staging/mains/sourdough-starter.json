  "id": "sourdough-starter",
  "name": "Sourdough Starter",
  "subtitle": "A simple potato-flake starter for homemade bread",
  "description": "Combine the listed ingredients to create a starter, allow it to rest, then refrigerate and refresh as needed.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
