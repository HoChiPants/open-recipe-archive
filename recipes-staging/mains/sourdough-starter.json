  },
  "ingredients": [
    {
      "ingredient_id": "instant-mashed-potato-flakes",
      "item": "instant mashed potato flakes",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "warm-water",
      "item": "warm water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 2.25,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the instant mashed potato flakes, white sugar, warm water, and active dry yeast together in a clean container."
    },
    {
      "step": 2,
      "text": "Cover loosely and let the mixture rest at room temperature for 6 hours.",
      "timer_minutes": 360
    },
    {
      "step": 3,
      "text": "Refrigerate the starter after the rest period."
    },
    {
      "step": 4,
      "text": "When refreshing the starter, stir in the listed potato flakes, sugar, and warm water, then cover and let it rest before returning it to the refrigerator."
    }
  ],
