  "id": "cod-and-cherry-tomato-bake",
  "name": "Cod and Cherry Tomato Bake",
  "subtitle": "Mediterranean-style cod with potatoes and green beans",
  "description": "Cod bakes with tomatoes, basil, olives, and garlic while potatoes and green beans cook alongside as a simple side.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 12,
    "cook_minutes": 18
  },
  "ingredients": [
    {
      "ingredient_id": "vine-cherry-tomatoes-halved",
      "item": "vine cherry tomatoes halved",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "finely-chopped-basil-leaves",
      "item": "finely chopped basil leaves",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "kalamata-olives-halved",
      "item": "Kalamata olives halved",
      "quantity": 6
    },
    {
