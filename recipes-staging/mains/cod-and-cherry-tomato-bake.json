      "item": "olive oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "cod-loins-about-130g-each",
      "item": "cod loins about 130g each",
      "quantity": 2
    },
    {
      "ingredient_id": "new-potatoes-halved",
      "item": "new potatoes halved",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "fine-green-beans-ends-trimmed",
      "item": "fine green beans ends trimmed",
      "quantity": 180,
      "unit": "g"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra virgin olive oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Combine the tomatoes, basil, olives, garlic, olive oil, and extra virgin olive oil in a baking dish."
    },
    {
      "step": 2,
      "text": "Nestle the cod loins into the tomato mixture and bake for 18 minutes, or until the thickest part reaches 145°F and flakes easily.",
      "timer_minutes": 18
    },
    {
      "step": 3,
      "text": "Meanwhile, cook the halved potatoes until nearly tender, add the green beans, and continue cooking until both are tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Drain the potatoes and beans, then toss them with the balsamic vinegar and the juices from the tomato mixture."
    },
    {
      "step": 5,
      "text": "Serve the cod with the baked tomatoes, potatoes, and green beans."
    }
  ],
