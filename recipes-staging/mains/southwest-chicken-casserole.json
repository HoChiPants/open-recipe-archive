  "id": "southwest-chicken-casserole",
  "name": "Southwest Chicken Casserole",
  "subtitle": "A layered bake with chicken, beans, corn, chiles, and melted cheese.",
  "description": "Tender chicken and vegetables are combined with seasoned beans, corn, and chiles, layered with tortillas, and baked under a creamy cheese topping.",
  "meal_type": "main",
