  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the chicken and water in a saucepan. Bring to a gentle simmer and cook until the thickest piece reaches 165°F. Shred the chicken."
    },
    {
      "step": 3,
      "text": "Cook the onion and red bell pepper in a skillet until tender, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Stir in the black beans, corn, picante sauce, green chiles, chili powder, cumin, and tomatoes. Simmer for 5 minutes, then fold in the shredded chicken.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Combine the nacho cheese soup with some of the green chiles and tomatoes. Layer tortillas, the chicken mixture, and the soup mixture in a baking dish, repeating as needed."
    },
    {
      "step": 6,
      "text": "Blend the remaining soup mixture with the Mexican cheese blend and spread it over the casserole."
    },
    {
      "step": 7,
      "text": "Bake until hot and the cheese is melted, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Let the casserole cool for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
