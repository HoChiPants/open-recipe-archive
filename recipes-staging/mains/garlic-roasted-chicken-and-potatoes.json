  "id": "garlic-roasted-chicken-and-potatoes",
  "name": "Garlic Roasted Chicken and Potatoes",
  "subtitle": "Tender chicken and potatoes with maple-garlic flavor",
  "description": "Chicken leg quarters, potatoes, and whole garlic cloves roast in butter, then finish with maple syrup for a savory-sweet glaze.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "chicken-leg-quarters",
      "item": "chicken leg quarters",
      "quantity": 6,
      "preparation": "split into drumsticks and thighs"
    },
    {
      "ingredient_id": "yukon-gold-potatoes",
      "item": "Yukon Gold potatoes",
      "quantity": 6,
      "unit": "large",
      "preparation": "cut into chunks"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 24,
      "unit": "cloves",
      "preparation": "unpeeled"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Place the butter in a large roasting pan and let it melt in the oven."
    },
    {
      "step": 2,
      "text": "Add the chicken, potatoes, and garlic. Season with salt and pepper, then toss to coat everything in the melted butter."
    },
    {
      "step": 3,
      "text": "Roast for 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "Turn the chicken and potatoes, drizzle with the maple syrup, and toss the vegetables gently to coat."
    },
    {
      "step": 5,
      "text": "Continue roasting until the potatoes are tender and the thickest part of the chicken reaches 165°F on a food thermometer, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Transfer the chicken and garlic to a serving platter and arrange the potatoes alongside."
    }
  ],
