  "id": "grilled-swordfish",
  "name": "Grilled Swordfish",
  "subtitle": "Teriyaki-marinated swordfish with garlic margarine",
  "description": "Swordfish steaks are briefly marinated in teriyaki sauce, grilled, and finished with softened garlic margarine.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
