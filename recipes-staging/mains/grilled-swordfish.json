    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "8-ounce-swordfish-steaks",
      "item": "(8 ounce) swordfish steaks",
      "quantity": 4
    },
    {
      "ingredient_id": "teriyaki-sauce",
      "item": "teriyaki sauce",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Combine the softened margarine with the garlic powder."
    },
    {
      "step": 2,
      "text": "Coat the swordfish steaks with the teriyaki sauce and let them stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Grill the steaks, turning once, until the fish reaches 145°F or is opaque and flakes easily.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Serve the grilled swordfish with the garlic margarine."
    }
  ],
