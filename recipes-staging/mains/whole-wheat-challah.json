      "item": "raisins",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, salt, active dry yeast, and vital wheat gluten in a large bowl. In a separate bowl, stir together the honey, olive oil, warm water, eggs, and raisins."
    },
    {
      "step": 2,
      "text": "Add the wet mixture to the flour mixture and stir until a dough forms. Knead on a lightly floured surface for 10 minutes, until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Shape the dough into a ball, place it in a prepared bowl, cover, and let it rise in a warm place for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Knead the dough briefly, then divide and shape it into a braid or other set loaf shape. Place it on a prepared baking sheet, cover, and let it rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Heat the oven to 350°F. Bake the loaf for 30 minutes, until golden brown.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool briefly, then slice and serve."
    }
  ],
