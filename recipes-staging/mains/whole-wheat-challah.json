  "id": "whole-wheat-challah",
  "name": "Whole Wheat Challah",
  "subtitle": "A tender braided loaf with a lightly sweet finish",
  "description": "Make a wholesome braided challah with honey, olive oil, eggs, and raisins folded into a yeast-raised whole-wheat dough.",
  "meal_type": "main",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
