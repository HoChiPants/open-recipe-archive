  "instructions": [
    {
      "step": 1,
      "text": "Stir the soy sauce and dry onion soup mix together until combined."
    },
    {
      "step": 2,
      "text": "Place the beef chuck roast in the slow cooker. Add the soy sauce mixture and sprinkle with black pepper."
    },
    {
      "step": 3,
      "text": "Cook until the roast is tender, about 22 hours. Check the thickest part with a food thermometer; whole-cut beef should reach at least 145°F.",
      "timer_minutes": 1320
    },
    {
      "step": 4,
      "text": "Let the roast rest for 3 minutes before slicing or serving."
    }
