  "instructions": [
    {
      "step": 1,
      "text": "Slice the mushrooms, carrot, and courgette. Keep the prepared vegetables separate for cooking."
    },
    {
      "step": 2,
      "text": "Microwave the beansprouts briefly, if needed, until just tender; drain any excess moisture."
    },
    {
      "step": 3,
      "text": "Heat a pan over medium-high heat. Cook the beansprouts with sesame oil and sesame seeds for 3 minutes, until tender. Transfer to a bowl.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Cook the mushrooms with sesame oil and sesame seeds for about 5 minutes, until tender. Transfer them separately.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir the cooked sushi rice with the vegetable oil, then warm it through for about 8 minutes, stirring occasionally.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Stir in the gochujang sauce until the rice is evenly coated. Add the courgette with sesame oil, vegetable oil, and sesame seeds, and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Add the spinach and cook just until wilted. Divide the rice among four bowls and arrange the cooked vegetables over it."
    },
    {
      "step": 8,
      "text": "Cook the eggs in the remaining vegetable oil until the whites and yolks are fully set, or until they reach 160°F. Top each bowl with an egg, more gochujang sauce, sesame oil, sesame seeds, and optional kimchi."
    }
  ],
