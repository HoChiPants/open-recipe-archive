  "id": "bibimbap",
  "name": "Bibimbap",
  "subtitle": "A colorful Korean-style rice bowl with vegetables, egg, and sesame.",
  "description": "Build bowls with cooked sushi rice, sautéed vegetables, spinach, a fried egg, sesame, gochujang sauce, and optional kimchi.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
