  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Season the pork chops with the salt, black pepper, garlic powder, and cayenne pepper."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in an oven-safe skillet over medium-high heat. Sear the chops for 2 minutes per side, then transfer them to a plate.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Whisk the honey, brown sugar, soy sauce, chopped garlic, butter, ground ginger, and any remaining garlic powder into the skillet sauce."
    },
    {
      "step": 5,
      "text": "Return the pork chops to the skillet and bake until the thickest part reaches 145°F on a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Rest the pork chops for 3 minutes before serving with the sauce.",
      "timer_minutes": 5
    }
  ],
