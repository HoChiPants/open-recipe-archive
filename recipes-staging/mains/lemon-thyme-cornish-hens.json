  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Combine the dried thyme, ground thyme, salt, black pepper, garlic powder, cumin, and red pepper flakes; season the hens inside and out."
    },
    {
      "step": 2,
      "text": "Place the seasoned hens in a roasting pan. Pour in the chicken broth and lemon juice, then spoon the melted margarine over the birds."
    },
    {
      "step": 3,
      "text": "Roast for 4 hours, basting occasionally with the pan liquid, until a thermometer inserted into the thickest part of each thigh registers 165°F.",
      "timer_minutes": 240
    },
    {
      "step": 4,
      "text": "Transfer the hens to a serving platter and rest briefly. Stir the chilled margarine cubes into the hot pan juices until melted, then serve the sauce with the hens."
    }
  ],
