  "instructions": [
    {
      "step": 1,
      "text": "Place the tuna in the teriyaki sauce and marinate for 45 minutes. Remove the tuna and reserve the marinade.",
      "timer_minutes": 45
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet over medium-high heat. Add the tuna and cook until it reaches 145°F internally, or is opaque and flakes easily."
    },
    {
      "step": 3,
      "text": "Squeeze the lemon over the tuna and sprinkle with sesame seeds. Season with sea salt and black pepper."
    },
    {
      "step": 4,
      "text": "Bring the reserved marinade to a full boil, then serve it with the tuna over the grated carrot."
    }
  ],
