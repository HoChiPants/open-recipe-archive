  "id": "teriyaki-tuna",
  "name": "Teriyaki Tuna",
  "subtitle": "Marinated tuna with lemon, sesame, and grated carrot",
  "description": "Tuna steaks marinated in teriyaki sauce, seared with lemon and sesame, and served over grated carrot.",
  "meal_type": "main",
  "cuisine": "Asian",
  "yield": {
    "quantity": 4,
