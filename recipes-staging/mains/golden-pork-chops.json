  "id": "golden-pork-chops",
  "name": "Golden Pork Chops",
  "subtitle": "Baked pork chops with mushroom-onion sauce",
  "description": "Seasoned pork chops bake beneath a savory mushroom and onion sauce for a simple American-style main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
