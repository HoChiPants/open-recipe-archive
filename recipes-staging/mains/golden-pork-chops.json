      "item": "pork chops",
      "quantity": 6
    },
    {
      "ingredient_id": "seasoned-salt",
      "item": "seasoned salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
