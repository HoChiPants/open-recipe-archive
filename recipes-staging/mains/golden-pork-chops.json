      "item": "fresh sliced mushrooms",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "condensed-golden-mushroom-soup",
      "item": "condensed golden mushroom soup",
      "quantity": 2,
      "unit": "can",
      "preparation": "10.75 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Season the pork chops evenly with seasoned salt and black pepper, then place them in a baking dish."
    },
    {
      "step": 3,
      "text": "Combine the chopped onion, sliced mushrooms, and condensed golden mushroom soup. Spoon the mixture over the pork chops."
    },
    {
      "step": 4,
      "text": "Bake for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Continue baking until the thickest chop reaches 145°F on a food thermometer. Rest the chops for 3 minutes before serving."
    }
  ],
