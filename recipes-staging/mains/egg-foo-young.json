  "instructions": [
    {
      "step": 1,
      "text": "Warm the sesame oil in a skillet over medium heat. Add the onion, green onion, celery, and bean sprouts; cook until the vegetables begin to soften.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir the cornstarch, shrimp, soy sauce, and salt together. Add this mixture to the vegetables and cook until the shrimp is opaque.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Let the mixture cool briefly, then fold it into the beaten eggs.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Heat a lightly oiled skillet over medium heat. Spoon the egg mixture into portions and cook until browned on the underside; turn and cook until browned on the second side and the centers are firm and fully set, reaching 160°F.",
      "timer_minutes": 7
    }
  ],
