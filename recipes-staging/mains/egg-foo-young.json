  "id": "egg-foo-young",
  "name": "Egg Foo Young",
  "subtitle": "Savory egg patties with shrimp and crisp vegetables",
  "description": "A Chinese-style egg dish combining chopped shrimp, bean sprouts, and vegetables in tender pan-cooked patties.",
  "meal_type": "main",
