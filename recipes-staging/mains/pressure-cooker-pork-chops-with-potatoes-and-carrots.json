  "id": "pressure-cooker-pork-chops-with-potatoes-and-carrots",
  "name": "Pressure Cooker Pork Chops with Potatoes and Carrots",
  "subtitle": "A one-pot pork dinner with savory vegetables",
  "description": "Bone-in pork chops are browned, then pressure-cooked with potatoes, carrots, onion, and a savory broth-based sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 35,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "inch-thick-bone-in-pork-chops",
      "item": "inch thick bone-in pork chops",
      "quantity": "4 3/4"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "baby-carrots",
      "item": "baby carrots",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "vegetable-broth",
      "item": "vegetable broth",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "russet-potatoes",
      "item": "russet potatoes",
      "quantity": 4,
      "unit": "whole",
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the pork chops with salt and pepper. Set the pressure cooker to its browning or sauté function and melt half the butter."
    },
    {
      "step": 2,
      "text": "Brown the pork chops in the butter for 5 minutes, turning as needed. Transfer them to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Melt the remaining butter in the cooker. Add the onion and carrots and sauté for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Pour in the vegetable broth and Worcestershire sauce, scraping up any browned bits. Return the pork chops to the cooker and arrange the potatoes around them."
    },
    {
      "step": 5,
      "text": "Secure the lid and cook at high pressure for 13 minutes. Let the pressure release naturally for 10 minutes, then release any remaining pressure carefully.",
      "timer_minutes": 13
    },
    {
      "step": 6,
      "text": "Check the thickest part of each pork chop with a food thermometer; pork should reach 145°F. Transfer the chops to a plate and let them rest for 3 minutes before cutting. Serve with the potatoes, carrots, and cooking liquid.",
      "timer_minutes": 3
    }
  ],
