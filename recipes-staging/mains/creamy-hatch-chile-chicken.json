      "ingredient_id": "mexican-crema",
      "item": "Mexican crema",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Char the Hatch chiles under a broiler, turning as needed, until blistered, about 8 minutes. Transfer to a bowl, cover, and rest for 10 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Peel and seed the chiles, then cut them into strips."
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet over medium heat. Add the onion and cook until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the chiles, corn, bouillon granules, and black pepper. Add the shredded chicken and crema, stirring until combined."
    },
    {
      "step": 5,
      "text": "Simmer gently until hot throughout; if reheating the chicken, verify it reaches 165°F.",
      "timer_minutes": 5
    }
  ],
