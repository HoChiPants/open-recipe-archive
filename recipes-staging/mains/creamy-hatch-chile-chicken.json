  "id": "creamy-hatch-chile-chicken",
  "name": "Creamy Hatch Chile Chicken",
  "subtitle": "Shredded chicken in a roasted chile cream sauce",
  "description": "Roasted Hatch chiles, sweet corn, and onion combine with shredded chicken and crema for a quick, comforting skillet meal.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
