    },
    {
      "ingredient_id": "chicken-bouillon-granules",
      "item": "chicken bouillon granules",
      "quantity": 0.75,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
