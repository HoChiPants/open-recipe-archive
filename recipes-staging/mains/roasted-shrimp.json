      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "cubed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Arrange the shrimp in a baking dish and coat them with the olive oil."
    },
    {
      "step": 3,
      "text": "Combine the garlic salt, dried parsley, and black pepper, then sprinkle the mixture over the shrimp."
    },
    {
      "step": 4,
      "text": "Scatter the cubed butter over the shrimp and roast until the shrimp are opaque, about 10 minutes.",
      "timer_minutes": 10
    }
