  "ingredients": [
    {
      "ingredient_id": "fresh-shrimp",
      "item": "fresh shrimp",
      "quantity": 1,
      "unit": "pound",
      "preparation": "peeled and deveined"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "dried-parsley",
      "item": "dried parsley",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
