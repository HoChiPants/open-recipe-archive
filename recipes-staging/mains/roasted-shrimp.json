  "id": "roasted-shrimp",
  "name": "Roasted Shrimp",
  "subtitle": "Garlic-seasoned shrimp roasted with butter",
  "description": "Shrimp are coated with olive oil and herbs, then roasted with cubed butter until opaque.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
