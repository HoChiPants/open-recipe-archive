  "id": "overnight-southern-buttermilk-biscuits",
  "name": "Overnight Southern Buttermilk Biscuits",
  "subtitle": "Tender biscuits prepared ahead for easy baking",
  "description": "A simple Southern-style biscuit dough rests overnight, then is shaped and baked the next day.",
  "meal_type": "main",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15,
    "inactive_minutes": 480
  },
  "ingredients": [
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the self-rising flour and sugar. Cut in the shortening until the mixture is crumbly."
    },
    {
      "step": 2,
      "text": "Stir in the buttermilk to form a dough. Knead until smooth."
    },
    {
      "step": 3,
      "text": "Cover and chill the dough for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 4,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 5,
      "text": "Lightly flour a work surface. Shape the dough and cut it into biscuits."
    },
    {
      "step": 6,
      "text": "Transfer the biscuits to a baking pan and bake at 425°F for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Cool briefly, then serve."
    }
  ],
