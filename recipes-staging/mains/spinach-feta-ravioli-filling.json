  "id": "spinach-feta-ravioli-filling",
  "name": "Spinach-Feta Ravioli Filling",
  "subtitle": "A savory filling for homemade ravioli",
  "description": "Wilted spinach, feta, and pine nuts make a simple filling for fresh pasta ravioli.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "fresh-spinach",
      "item": "fresh spinach",
      "quantity": 1,
      "unit": "bag",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "feta-cheese",
      "item": "feta cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "pine-nuts",
      "item": "pine nuts",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "fresh-pasta-sheets",
      "item": "fresh pasta sheets",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a skillet over medium heat. Add the spinach and cook for 2 minutes, until wilted.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Cool the spinach, then combine it with the feta and pine nuts."
    },
    {
      "step": 3,
      "text": "Prepare the fresh pasta sheets for filling. Whisk the egg with the water."
    },
    {
      "step": 4,
      "text": "Place small portions of filling on one pasta sheet, leaving space between them. Brush the exposed pasta with the egg mixture, cover with the second sheet, and press around each mound to seal."
    },
    {
      "step": 5,
      "text": "Cut the ravioli apart and press the edges firmly closed."
    },
    {
      "step": 6,
      "text": "Simmer the ravioli in water, stirring gently, until the pasta is tender and the filling is fully hot; cook for about 5 minutes. If checking the egg-containing filling, heat the center to 160°F.",
      "timer_minutes": 5
    }
  ],
