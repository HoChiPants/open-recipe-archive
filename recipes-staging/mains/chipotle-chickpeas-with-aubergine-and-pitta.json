  "id": "chipotle-chickpeas-with-aubergine-and-pitta",
  "name": "Chipotle Chickpeas with Aubergine and Pitta",
  "subtitle": "Smoky chickpeas with roasted aubergine, lime crema, and crisp pitta",
  "description": "A quick vegetarian meal combining chipotle-seasoned chickpeas and aubergine with a tangy tahini-lime crème fraîche sauce and toasted pitta.",
  "meal_type": "main",
