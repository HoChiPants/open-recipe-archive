  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Arrange the pitta triangles in a single layer and bake until crisp, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the crème fraîche, tahini, lime zest and juice, and crushed garlic until smooth."
    },
    {
      "step": 3,
      "text": "Heat the rapeseed oil in a large pan. Cook the onion and sliced aubergines until softened and lightly browned, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the chickpeas and chipotle paste. Cook for 5 minutes, stirring occasionally, until hot.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Fold in the chopped coriander. Serve with the pitta, tahini sauce, extra lime zest and wedges, and coriander."
    }
  ],
