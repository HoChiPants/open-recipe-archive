  "instructions": [
    {
      "step": 1,
      "text": "Prepare the shell-on prawns for steaming and arrange them in a heatproof dish."
    },
    {
      "step": 2,
      "text": "Combine the light soy sauce, minced garlic, and brandy."
    },
    {
      "step": 3,
      "text": "Pour the sauce over the prawns and place the dish in a steamer."
    },
    {
      "step": 4,
      "text": "Steam until the prawns are opaque throughout, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer the prawns to a serving dish and serve hot."
    }
