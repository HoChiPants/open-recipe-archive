  "id": "steamed-garlic-prawns",
  "name": "Steamed Garlic Prawns",
  "subtitle": "Shell-on prawns with a savory garlic sauce",
  "description": "Large prawns are steamed with minced garlic, light soy sauce, and brandy until opaque and ready to serve.",
  "meal_type": "main",
  "cuisine": "Chinese",
