      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, salt, and sugar in a mixing bowl."
    },
    {
      "step": 3,
      "text": "Cut in the butter or margarine until the mixture is crumbly, then stir in the mashed potatoes."
    },
    {
      "step": 4,
      "text": "Add the beaten egg, cold water, and 1/3 cup milk; stir just until a soft dough forms."
    },
    {
      "step": 5,
      "text": "Turn the dough onto a lightly floured surface and knead briefly until cohesive."
    },
    {
      "step": 6,
      "text": "Pat or roll the dough to biscuit thickness and cut into eight biscuits."
    },
    {
      "step": 7,
      "text": "Transfer the biscuits to a baking sheet and brush the tops with the remaining milk as needed."
    },
    {
      "step": 8,
      "text": "Bake for 20 minutes, until golden and the centers are fully set; verify the egg-containing centers reach 160°F.",
      "timer_minutes": 20
    }
  ],
