  "instructions": [
    {
      "step": 1,
      "text": "Preheat a heavy skillet or griddle over medium heat."
    },
    {
      "step": 2,
      "text": "Place the onion, carrot, celery, red pepper, garlic, and spring onions in a pot with the chicken. Add enough water to cover, bring to a simmer, and cook for 30 minutes. Check that the thickest chicken breast reaches 165°F; continue cooking if needed.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Remove the chicken and let it cool, then chill it briefly. Shred it and mix with the mayonnaise and lemon juice."
    },
    {
      "step": 4,
      "text": "Combine the harina with the celery specified in the preparation, add enough water to make a smooth dough, and rest for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Shape the dough into eight thick round cakes."
    },
    {
      "step": 6,
      "text": "Prepare the avocados with the lime juice, olive oil, and mustard until thick and combined."
    },
    {
      "step": 7,
      "text": "Cook the arepas on the preheated skillet for 5 minutes per side, or until firm and browned.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Split the arepas, fill with the chicken and avocado mixtures, and serve with the coriander leaves."
    }
  ],
