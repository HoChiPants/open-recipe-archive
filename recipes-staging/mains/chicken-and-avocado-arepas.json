  "id": "chicken-and-avocado-arepas",
  "name": "Chicken and Avocado Arepas",
  "subtitle": "Crisp corn cakes with creamy chicken-avocado filling",
  "description": "Make griddled arepas and fill them with chilled lemony chicken, avocado, mustard, and fresh vegetables.",
