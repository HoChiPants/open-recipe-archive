{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "spicy-soy-garlic-chicken",
  "name": "Spicy Soy-Garlic Chicken",
  "subtitle": "Quick skillet chicken with a tangy, savory glaze",
  "description": "Cornstarch-coated chicken is browned with garlic, then finished in a sweet-tart soy sauce with green onions and cayenne.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "boneless-skinless-chicken-breasts",
      "item": "boneless skinless chicken breasts",
      "quantity": 4,
      "preparation": "cut into cubes"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "low-sodium-soy-sauce",
      "item": "low-sodium soy sauce",
      "quantity": 5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 3,
      "preparation": "sliced diagonally into 1/2 inch pieces"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 0.125,
      "unit": "teaspoon",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Toss the cubed chicken with the cornstarch until evenly coated."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large skillet over medium-high heat. Add the chicken and garlic, spreading the chicken into an even layer."
    },
    {
      "step": 3,
      "text": "Cook, turning occasionally, until the chicken is lightly browned."
    },
    {
      "step": 4,
      "text": "Stir together the soy sauce, vinegar, water, and sugar. Pour the mixture into the skillet and stir to coat the chicken."
    },
    {
      "step": 5,
      "text": "Cook for 5 minutes, stirring occasionally, until the chicken reaches 165°F in the thickest pieces and the sauce thickens.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir in the green onions and cayenne pepper. Taste and adjust the cayenne if needed, then serve hot."
    }
  ],
