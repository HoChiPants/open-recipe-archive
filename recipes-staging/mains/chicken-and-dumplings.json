  "id": "chicken-and-dumplings",
  "name": "Chicken and Dumplings",
  "subtitle": "Tender chicken, vegetables, and homemade flour dumplings",
  "description": "A comforting American main dish of simmered chicken and vegetables finished with soft, hand-cut dumplings.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 100
  },
  "ingredients": [
    {
      "ingredient_id": "chicken",
      "item": "chicken",
      "quantity": 1,
      "unit": "whole"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "water-to-cover",
      "item": "water to cover"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1,
      "preparation": "halved"
    },
    {
      "ingredient_id": "stalks-celery",
      "item": "stalks celery",
      "quantity": 2,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 2,
      "preparation": "sliced, or more to taste"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken in a large pot and season with the pinch of salt and some of the salt and pepper. Add water to cover."
    },
    {
      "step": 2,
      "text": "Bring to a gentle simmer, then add the lemon, celery, onion, and carrots. Cover partially and simmer until the chicken is tender and reaches 165°F in the thickest part, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Remove the chicken and lemon. Let the chicken cool enough to handle, then remove the meat from the bones and cut or shred it. Reserve the cooking liquid and vegetables in the pot."
    },
    {
      "step": 4,
      "text": "Mix the flour with the remaining salt and pepper. Stir in enough reserved cooking liquid to form a soft dough, then knead briefly until smooth."
    },
    {
      "step": 5,
      "text": "Roll or pat the dough thin, cut it into dumplings, and place the pieces into the simmering broth."
    },
    {
      "step": 6,
      "text": "Simmer the dumplings until tender, about 30 minutes. Return the chicken to the pot and cook for 5 minutes before serving.",
      "timer_minutes": 35
    }
  ],
