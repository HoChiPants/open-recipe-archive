  "instructions": [
    {
      "step": 1,
      "text": "Preheat the slow cooker. Prepare the pork chops for cooking for 3 minutes, then drain.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Place the apples and onion in the slow cooker. Add the pork chops and enough water to cover."
    },
    {
      "step": 3,
      "text": "Cover and cook for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 4,
      "text": "Stir in the sauerkraut and fennel seed. Cover and continue cooking for 1 hour, 5 minutes, or until the pork reaches 145°F in the thickest part. Rest the pork for 3 minutes before serving.",
      "timer_minutes": 65
    }
  ],
