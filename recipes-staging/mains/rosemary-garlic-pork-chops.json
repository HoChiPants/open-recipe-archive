{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "rosemary-garlic-pork-chops",
  "name": "Rosemary-Garlic Pork Chops",
  "subtitle": "Tender boneless pork chops simmered with garlic and rosemary",
  "description": "Seasoned pork chops are browned in butter, then gently simmered in broth until tender and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "dried-rosemary",
      "item": "dried rosemary",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "6-ounce-boneless-center-cut-pork-loin-chops",
      "item": "(6 ounce) boneless center-cut pork loin chops",
      "quantity": 4,
      "preparation": "trimmed of fat"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "low-sodium-beef-broth",
      "item": "low-sodium beef broth",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the rosemary, black pepper, and salt. Season the pork chops on all sides with the mixture."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat. Add the pork chops and garlic."
    },
    {
      "step": 3,
      "text": "Cook the chops until golden brown, turning once as needed.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Pour in the beef broth and bring it to a gentle simmer."
    },
    {
      "step": 5,
      "text": "Cover and simmer the pork chops until tender and an instant-read thermometer inserted into the thickest part registers 145°F.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Remove from the heat and let the pork rest for 3 minutes before cutting or serving.",
      "timer_minutes": 3
    }
  ],
