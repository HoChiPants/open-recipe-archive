    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Simmer the lasagna noodles in water for 10 minutes, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Sauté the onion, garlic, and feta until the onion is tender, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Stir in the vegetable broth and rosemary, bring to a simmer, then add the artichokes and spinach."
    },
    {
      "step": 5,
      "text": "Stir in the tomato pasta sauce. Layer sauce, noodles, and the spinach-artichoke mixture in the prepared dish, finishing with noodles and the remaining mozzarella."
    },
    {
      "step": 6,
      "text": "Top with the remaining artichokes and mozzarella, then sprinkle with the remaining feta."
    },
    {
      "step": 7,
      "text": "Bake for 40 minutes, then continue baking for 15 minutes, until the lasagna is bubbling and heated through.",
      "timer_minutes": 55
    },
    {
      "step": 8,
      "text": "Let stand for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
