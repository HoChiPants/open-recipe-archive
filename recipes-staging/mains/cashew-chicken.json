  "instructions": [
    {
      "step": 1,
      "text": "Whisk the water and cornstarch until smooth. Add lemon juice, vinegar, ketchup, soy sauce, brown sugar, chile sauce, salt, and pepper; whisk to combine."
    },
    {
      "step": 2,
      "text": "Heat the oil in a large skillet over medium-high heat. Add the sliced red chile and ginger, and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the cashews and garlic. Cook, stirring, until the cashews are golden brown, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Pour in the sauce and stir until thickened. Add the chicken and toss until evenly coated and heated through; reheated poultry should reach 165°F."
    },
    {
      "step": 5,
      "text": "Fold in the cilantro and serve hot."
    }
  ],
