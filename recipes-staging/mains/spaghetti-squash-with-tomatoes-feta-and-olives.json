  "id": "spaghetti-squash-with-tomatoes-feta-and-olives",
  "name": "Spaghetti Squash with Tomatoes, Feta, and Olives",
  "subtitle": "Roasted squash tossed with a savory tomato topping",
  "description": "Tender roasted spaghetti squash is combined with sautéed onion, garlic, tomatoes, feta, olives, and fresh basil.",
  "meal_type": "main",
