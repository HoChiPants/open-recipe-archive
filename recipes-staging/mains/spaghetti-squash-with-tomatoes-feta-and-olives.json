  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Arrange the halved, seeded squash cut-side down in a baking dish and bake for 30 minutes, until tender. Let it cool until it can be handled safely.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Warm the vegetable oil in a skillet over medium heat. Add the onion and cook until tender."
    },
    {
      "step": 3,
      "text": "Stir in the garlic and cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the tomatoes and stir until combined. Use a fork to separate the squash strands, then transfer them to the skillet."
    },
    {
      "step": 5,
      "text": "Stir in the feta, olives, and basil. Serve warm."
    }
  ],
