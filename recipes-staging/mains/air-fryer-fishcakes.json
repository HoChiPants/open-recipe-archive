  "id": "air-fryer-fishcakes",
  "name": "Air Fryer Fishcakes",
  "subtitle": "Thai-seasoned salmon patties with crisp panko coating",
  "description": "Shape salmon with curry paste, herbs, aromatics, and green beans, then air-fry until crisp and safely cooked. Serve with a lime-sriracha mayonnaise.",
  "meal_type": "main",
  "cuisine": "Thai",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "skinless-salmon-fillets",
      "item": "skinless salmon fillets",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "thai-red-curry-paste",
      "item": "Thai red curry paste",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "handful-of-coriander-roughly-chopped",
      "item": "handful of coriander roughly chopped",
      "unit": "small"
    },
    {
      "ingredient_id": "fish-sauce",
      "item": "fish sauce",
      "quantity": "1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "lime-juiced",
      "item": "lime juiced",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "lemongrass-stalk-tough-outer-leaves-removed",
      "item": "lemongrass stalk (tough outer leaves removed)",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "spring-onions-roughly-chopped",
      "item": "spring onions roughly chopped",
      "quantity": 3,
      "preparation": "plus extra to serve"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 5,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "green-beans-finely-chopped",
      "item": "green beans finely chopped",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "panko-breadcrumbs",
      "item": "panko breadcrumbs",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "sriracha",
      "item": "sriracha",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 5,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "lime-juiced",
      "item": "lime juiced",
      "quantity": "1/2",
      "preparation": "plus extra wedges to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pulse the salmon, curry paste, coriander, fish sauce, lime, lemongrass, spring onions, and green beans until combined but still slightly textured."
    },
    {
      "step": 2,
      "text": "Mix in the egg and 2 tablespoons of the flour. Shape the mixture into six even patties."
    },
    {
      "step": 3,
      "text": "Combine the remaining flour and green beans. Lightly coat each patty, then brush or dab with fish sauce and press into the panko breadcrumbs."
    },
    {
      "step": 4,
      "text": "Preheat the air fryer according to its instructions, then arrange the fishcakes in a single layer with space between them."
    },
    {
      "step": 5,
      "text": "Air-fry until browned and the centers reach 160°F; the fish should be opaque and easily flaked and the egg fully set.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Stir the sriracha, mayonnaise, and the second lime juice together. Serve with the sauce, extra spring onions, and lime wedges."
    }
  ],
