  "id": "roasted-pork-chops",
  "name": "Roasted Pork Chops",
  "subtitle": "Thyme-seasoned pork with a simple oven roast",
  "description": "Season boneless pork chops with crushed thyme, salt, and pepper, then roast until safely cooked and rest before serving.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
