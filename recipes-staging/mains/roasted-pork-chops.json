  },
  "ingredients": [
    {
      "ingredient_id": "boneless-center-cut-pork-chops",
      "item": "boneless center-cut pork chops",
      "quantity": 4
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "lightly crushed, or more to taste"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Season the pork chops on all sides with the thyme, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Transfer the chops to a roasting pan or baking dish and roast for 20 minutes, or until a food thermometer inserted into the thickest part reads 145°F.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Remove the chops from the oven and let them rest for at least 3 minutes before cutting and serving.",
      "timer_minutes": 3
    }
  ],
