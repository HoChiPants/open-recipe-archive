  "id": "sausage-and-sauerkraut",
  "name": "Sausage and Sauerkraut",
  "subtitle": "Baked sauerkraut with browned bacon, onion, apple, and sliced sausage",
  "description": "A hearty baked dish combining tangy sauerkraut with sweet apple, caraway, bacon, onion, and kielbasa.",
  "meal_type": "main",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 125
  },
  "ingredients": [
    {
      "ingredient_id": "sauerkraut",
      "item": "sauerkraut",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "rinsed and drained"
    },
    {
      "ingredient_id": "caraway-seeds",
      "item": "caraway seeds",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "apple",
      "item": "apple",
      "quantity": 1,
      "preparation": "diced"
    },
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "cut into 1-inch pieces"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "kielbasa-sausage",
      "item": "kielbasa sausage",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "cut into 1-inch thick slices"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Coat a large baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Combine the sauerkraut, caraway seeds, brown sugar, and diced apple in the dish. Cover and bake for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Cook the bacon and onion in a skillet over medium heat until the bacon is browned and the onion is softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir the bacon and onion into the sauerkraut, then fold in the sliced kielbasa. Cover and bake for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir the sauerkraut mixture, uncover, and bake for 45 minutes, or until the sausage reaches 160°F in the center.",
      "timer_minutes": 45
    }
  ],
