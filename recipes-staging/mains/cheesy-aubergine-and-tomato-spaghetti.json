  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Coat the aubergine with some of the oil and bake for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Mix the cheese and hazelnuts. Add the baked aubergine and sage, then continue baking for 12 minutes, until tender.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Warm the remaining oil in a pan. Cook the garlic, carrot, celery, and small sage leaves for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the olives, tomato purée, and bouillon powder, then cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Cook the spaghetti until tender, then drain."
    },
    {
      "step": 6,
      "text": "Add the cherry tomatoes and parsley to the sauce. Toss with the spaghetti, then fold through the baked aubergine and finish with the parsley."
    }
  ],
