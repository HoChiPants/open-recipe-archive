  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a skillet. Sauté the wonton strips for 4 minutes, until crisp, then transfer them to a plate.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Preheat the oven to 450°F. Transfer the pizza dough to a suitable baking surface and bake for 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Mix the cream cheese with half the green onions, half the Parmesan, the crab meat, and the mozzarella."
    },
    {
      "step": 4,
      "text": "Spread the crab mixture over the partially baked dough. Top with the remaining green onions and Parmesan, then add the fried wonton strips."
    },
    {
      "step": 5,
      "text": "Bake for 8 minutes, until the cheeses are melted and the crab is opaque and heated through.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Drizzle with the sweet chili sauce before serving."
    }
  ],
