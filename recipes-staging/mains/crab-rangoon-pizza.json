  "id": "crab-rangoon-pizza",
  "name": "Crab Rangoon Pizza",
  "subtitle": "Crisp wonton strips and creamy crab topping on baked pizza dough",
  "description": "A savory pizza layered with softened cream cheese, crab, cheeses, green onions, fried wonton strips, and sweet chili sauce.",
  "meal_type": "main",
  "cuisine": "Asian Inspired",
