  "id": "chicken-tortilla-chip-casserole",
  "name": "Chicken Tortilla Chip Casserole",
  "subtitle": "A layered chicken casserole with tomatoes, chiles, and cheddar",
  "description": "Boiled chicken, tortilla chips, creamy soups, tomatoes with green chiles, onion, and cheddar form a warm layered casserole.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "3-pound-chicken",
      "item": "(3 pound) chicken",
      "quantity": 1,
      "preparation": "boiled and deboned"
    },
    {
      "ingredient_id": "tortilla-chips",
      "item": "tortilla chips",
      "quantity": 1,
      "unit": "package",
      "preparation": "14.5 ounce"
    },
    {
      "ingredient_id": "tomatoes-with-green-chile-peppers",
      "item": "tomatoes with green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce, diced"
    },
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 3,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Layer tortilla chips in a baking dish."
    },
    {
      "step": 3,
      "text": "Combine the chicken, tomatoes with green chile peppers, both condensed soups, and onion."
    },
    {
      "step": 4,
      "text": "Spoon the mixture over the chips and top with the shredded Cheddar cheese."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, until the casserole is hot and the chicken reaches 165°F in the center.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Top with the remaining tomatoes and Cheddar cheese, then let the cheese melt before serving."
    }
  ],
