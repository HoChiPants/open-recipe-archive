  "id": "spaghetti-with-fried-zucchini-and-pecorino",
  "name": "Spaghetti with Fried Zucchini and Pecorino",
  "subtitle": "A creamy Italian-style pasta with chilled, lightly browned zucchini.",
  "description": "Fried zucchini is chilled for deeper flavor, then warmed with spaghetti, butter, basil, and two grated cheeses for a simple, savory pasta.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
