  "instructions": [
    {
      "step": 1,
      "text": "Heat the sunflower oil to 350°F. Cut the zucchini into thin rounds and fry in batches for about 5 minutes, until lightly browned.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Layer the fried zucchini in a container, let it cool, then cover and chill for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Bring salted water to a simmer and cook the spaghetti for 2 minutes. Drain, reserving the pasta.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Warm the olive oil in a skillet. Add the chilled zucchini and salt, and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the spaghetti and toss with the zucchini. Stir in the basil and butter until the butter melts."
    },
    {
      "step": 6,
      "text": "Combine the Pecorino Romano and Parmigiano-Reggiano, then stir the cheeses into the pasta until coated. Add salt as needed."
    },
    {
      "step": 7,
      "text": "Serve immediately with the basil and remaining grated cheeses."
    }
  ],
