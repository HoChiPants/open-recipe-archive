  "id": "chicken-goujons",
  "name": "Chicken Goujons",
  "subtitle": "Crisp crumbed strips with carrot salad and dipping sauce",
  "description": "Tender marinated chicken strips are coated in panko, pan-cooked until crisp, and served with a bright carrot salad, sauce, and baked potatoes.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "buttermilk-or-skimmed-milk-mixed-with-2-tsp-lemon-juice-then-left-for-5-mins",
      "item": "buttermilk or skimmed milk mixed with 2 tsp lemon juice then left for 5 mins",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "skinless-chicken-breasts-or-4-small-pieces-pork-escalope",
      "item": "skinless chicken breasts or 4 small pieces pork escalope",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "panko-breadcrumbs",
      "item": "panko breadcrumbs",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "rapeseed-oil",
      "item": "rapeseed oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "ketchup",
      "item": "ketchup",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "or-4-small-carrots-about-300g",
      "item": "or 4 small carrots (about 300g)",
      "quantity": 2,
      "unit": "large",
      "preparation": "peeled and grated"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "baked-potatoes-to-serve",
      "item": "baked potatoes to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the chicken breasts or pork escalopes into strips. Toss them with the prepared buttermilk mixture, cover, and refrigerate for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Combine the ketchup, soy sauce, and white wine vinegar in a small bowl."
    },
    {
      "step": 3,
      "text": "Mix the grated carrots with the lemon juice and olive oil. Set aside."
    },
    {
      "step": 4,
      "text": "Remove the strips from the marinade, letting excess drip off, then coat them evenly in the panko breadcrumbs."
    },
    {
      "step": 5,
      "text": "Heat the rapeseed oil in a large frying pan over medium heat. Cook the strips for about 5 minutes per side, turning as needed, until crisp and cooked through. Chicken should reach 165°F; pork should reach 145°F followed by a 3-minute rest.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Serve the goujons with the carrot salad, sauce, and baked potatoes."
    }
  ],
