  "id": "chicken-onigiri",
  "name": "Chicken Onigiri",
  "subtitle": "Japanese rice balls with creamy chili chicken filling",
  "description": "Seasoned sushi rice surrounds a savory chicken, herb, and chili-mayo filling, then is shaped into individual rice balls and served with nori.",
  "meal_type": "main",
  "cuisine": "Japanese",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 15
  },
  "ingredients": [
