      "item": "heaped tbsp crispy chilli oil",
      "quantity": 1
    },
    {
      "ingredient_id": "ginger-finely-grated",
      "item": "ginger finely grated (optional)",
      "quantity": 5,
      "unit": "g",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare and cook the sushi rice according to its package directions until tender, about 15 minutes. If cooking the chicken from raw, cook it separately until the center reaches 165°F on a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Fold the sushi vinegar into the hot rice, then spread the rice on a tray and let it cool until easy to handle."
    },
    {
      "step": 3,
      "text": "Mix the cooked chicken with the spring onion, coriander, mayo, crispy chilli oil, and ginger if using."
    },
    {
      "step": 4,
      "text": "With damp hands, divide the rice into six portions. Flatten each portion, add some chicken mixture to the center, enclose it with rice, and shape into a smooth ball or triangle."
    },
    {
      "step": 5,
      "text": "Serve the onigiri with the nori sheets."
    }
  ],
