      "item": "sushi rice",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "sushi-vinegar",
      "item": "sushi vinegar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "nori-sheets-to-serve",
      "item": "nori sheets to serve"
    },
