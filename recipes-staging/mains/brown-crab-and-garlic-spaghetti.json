  "id": "brown-crab-and-garlic-spaghetti",
  "name": "Brown Crab and Garlic Spaghetti",
  "subtitle": "Buttery spaghetti with crab, shallot, and parmesan",
  "description": "A quick pasta dish combining sweet crab with garlic, shallot, butter, and parmesan.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "spaghetti",
      "item": "spaghetti",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "butter",
      "item": "salted butter",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "shallot-finely-sliced",
      "item": "shallot finely sliced",
      "quantity": 1
    },
    {
      "ingredient_id": "garlic-cloves-grated",
      "item": "garlic cloves grated",
      "quantity": 3
    },
    {
      "ingredient_id": "brown-crab",
      "item": "brown crab",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "parmesan-grated",
      "item": "parmesan grated",
      "quantity": 30,
      "unit": "g",
      "preparation": "plus extra to serve"
    },
    {
      "ingredient_id": "chives-finely-chopped-optional",
      "item": "chives finely chopped (optional)",
      "quantity": 10,
      "unit": "g",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the spaghetti in boiling water until al dente, then drain."
    },
    {
      "step": 2,
      "text": "Melt the salted butter in a large pan over medium heat. Add the sliced shallot and grated garlic, and cook until softened, about 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Stir in the brown crab and grated parmesan. Heat until the crab is steaming hot and opaque."
    },
    {
      "step": 4,
      "text": "Add the drained spaghetti and toss until evenly coated. Serve with extra parmesan and the chives, if using."
    }
  ],
