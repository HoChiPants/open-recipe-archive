  "id": "chickpea-spinach-curry",
  "name": "Chickpea & Spinach Curry",
  "subtitle": "Creamy coconut curry with tender chickpeas and greens",
  "description": "A simple Indian-style curry made with coconut milk, warm spices, chickpeas, and spinach, served with basmati rice.",
  "meal_type": "main",
  "cuisine": "Indian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "basmati-rice",
      "item": "basmati rice",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "oil",
      "item": "oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "onion-or-2-shallots",
      "item": "onion or 2 shallots",
      "quantity": 1,
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic cloves",
      "quantity": 2,
      "preparation": "crushed"
    },
    {
      "ingredient_id": "turmeric-plus-a-pinch",
      "item": "turmeric plus a pinch",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "garam-masala",
      "item": "garam masala",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "hot-chilli-powder",
      "item": "hot chilli powder",
      "quantity": "1/2-1",
      "unit": "tsp"
    },
    {
      "ingredient_id": "x-400g-cans-coconut-milk",
      "item": "x 400g cans coconut milk",
      "quantity": 2
    },
    {
      "ingredient_id": "x-400g-cans-chickpeas-drained-and-rinsed",
      "item": "x 400g cans chickpeas drained and rinsed",
      "quantity": 2
    },
    {
