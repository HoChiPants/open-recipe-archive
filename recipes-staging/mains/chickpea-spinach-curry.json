      "item": "frozen spinach",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "tamarind-or-a-squeeze-of-lime",
      "item": "tamarind or a squeeze of lime",
      "quantity": "1-2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "dessicated-coconut-to-serve-optional",
      "item": "dessicated coconut to serve (optional)",
      "preparation": "toasted",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the basmati rice according to package directions until tender; keep warm.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the oil in a large pot over medium heat. Add the onion or shallots and cook until softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the garlic, turmeric, cumin, garam masala, and chilli powder; cook until fragrant.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the coconut milk, chickpeas, cloves, and cinnamon stick. Bring to a gentle simmer and cook until slightly thickened.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir in the frozen spinach and cook until hot and fully incorporated.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Remove the cloves and cinnamon stick if desired. Stir in the tamarind or lime, then serve over the rice with toasted dessicated coconut if using."
    }
  ],
