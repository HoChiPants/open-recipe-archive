  "instructions": [
    {
      "step": 1,
      "text": "Stir the garlic, onion, ginger, sesame oil, brown sugar, Asian pear, soy sauce, gochugaru, and green onion tops together. Coat the beef with the mixture and refrigerate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Heat a skillet over high heat and brush it with vegetable oil. Add the remaining vegetable oil as needed, then arrange the beef in a single layer."
    },
    {
      "step": 3,
      "text": "Cook for about 3 minutes, turning as needed, until the beef reaches 145°F internally. Remove from the heat and rest for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Season with kosher salt as needed and serve over hot steamed rice."
    }
  ],
