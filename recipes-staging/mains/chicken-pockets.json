{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chicken-pockets",
  "name": "Chicken Pockets",
  "subtitle": "Creamy chicken filling baked in flaky crescent dough",
  "description": "Tender cooked chicken is folded into a seasoned cream cheese filling, enclosed in crescent dough, topped with buttery crumbs, and baked until golden and safely hot.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "refrigerated-crescent-rolls",
      "item": "refrigerated crescent rolls",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "3 ounce, softened"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "chicken",
      "item": "chicken",
      "quantity": 2,
      "unit": "cups",
      "preparation": "chopped cooked"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "cracker-crumbs",
      "item": "cracker crumbs",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Separate and arrange the crescent rolls, shaping them into four portions suitable for enclosing the filling."
    },
    {
      "step": 3,
      "text": "Combine the cream cheese, 1 tablespoon butter, salt, pepper, milk, and onion until smooth."
    },
    {
      "step": 4,
      "text": "Whisk the cooked chicken into the cream cheese mixture until evenly coated."
    },
    {
      "step": 5,
      "text": "Divide the filling among the dough portions, fold the dough over it, and seal the edges."
    },
    {
      "step": 6,
      "text": "Transfer the pockets to a baking sheet."
    },
    {
      "step": 7,
      "text": "Spread the softened butter over the tops and add cracker crumbs."
    },
    {
      "step": 8,
      "text": "Bake for 25 minutes, until golden and the filling reaches 165°F on a food thermometer.",
      "timer_minutes": 25
    }
  ],
