  "id": "fish-tacos-2ac93873",
  "name": "Fish Tacos",
  "subtitle": "Tilapia tacos with crisp cabbage slaw and lime cream",
  "description": "Sautéed tilapia fills warm flour tortillas with a crunchy cabbage topping, jalapeño, cilantro, and tangy lime sour cream.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "reduced-fat-sour-cream",
      "item": "reduced-fat sour cream",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "lime-juice",
      "item": "lime juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "jalapeno-pepper",
      "item": "jalapeno pepper",
      "quantity": 1,
      "preparation": "halved lengthwise"
    },
    {
      "ingredient_id": "red-cabbage",
      "item": "red cabbage",
      "quantity": 2.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 4,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "tilapia-fillets",
      "item": "tilapia fillets",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into strips"
    },
    {
      "ingredient_id": "6-inch-flour-tortillas",
      "item": "(6 inch) flour tortillas",
      "quantity": 8
    },
    {
      "ingredient_id": "fresh-cilantro",
      "item": "fresh cilantro",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the sour cream and lime juice together; season with salt and pepper."
    },
    {
      "step": 2,
      "text": "Remove the stem and seeds from the halved jalapeño, then finely chop it."
    },
    {
      "step": 3,
      "text": "Toss the cabbage, green onions, jalapeño, and cilantro with the lime cream until evenly coated."
    },
    {
      "step": 4,
      "text": "Heat the olive oil in a large skillet over medium-high heat."
    },
    {
      "step": 5,
      "text": "Season the tilapia strips with salt and pepper, add them to the skillet, and sauté for about 6 minutes, turning as needed, until golden and the thickest pieces reach 145°F or flake easily.",
      "timer_minutes": 6
    },
    {
      "step": 6,
      "text": "Warm the flour tortillas in a dry skillet or microwave until pliable."
    },
    {
      "step": 7,
      "text": "Divide the fish and cabbage mixture among the tortillas and serve immediately."
    }
  ],
