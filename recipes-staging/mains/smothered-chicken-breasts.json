  "id": "smothered-chicken-breasts",
  "name": "Smothered Chicken Breasts",
  "subtitle": "Seasoned chicken with bacon, sweet onions, and melted cheese",
  "description": "Pan-cooked chicken breasts are topped with brown-sugared bacon, onions, and shredded Colby-Monterey Jack cheese.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "6-ounce-skinless",
      "item": "(6 ounce) skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lemon-pepper-seasoning",
      "item": "lemon pepper seasoning",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "strips-bacon",
      "item": "strips bacon",
      "quantity": 8
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "colby-monterey-jack-cheese",
      "item": "Colby-Monterey Jack cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken breasts evenly with the salt and lemon pepper seasoning."
    },
    {
      "step": 2,
      "text": "Preheat a skillet over medium heat and add the vegetable oil. Cook the chicken for about 15 minutes, turning as needed, until a thermometer inserted into the thickest part reads 165°F.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Arrange the bacon on a baking sheet, sprinkle with the brown sugar, and cook in a preheated oven for 10 minutes. Transfer the bacon to a plate.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Cook the sliced onion with the remaining brown sugar until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Top the chicken with the bacon, onion, and shredded Colby-Monterey Jack cheese. Serve hot."
    }
  ],
