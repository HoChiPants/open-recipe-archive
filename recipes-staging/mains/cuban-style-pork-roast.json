  "id": "cuban-style-pork-roast",
  "name": "Cuban-Style Pork Roast",
  "subtitle": "Citrus-marinated pork shoulder with toasted spices",
  "description": "A garlic, citrus, herb, and sherry marinade seasons pork shoulder before a low oven roast.",
  "meal_type": "main",
