  "instructions": [
    {
      "step": 1,
      "text": "Toast the cumin seeds and peppercorns in a dry skillet over medium heat for 2 minutes. Remove from the heat and let cool.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Crush the cooled spices with the garlic, salt, and oregano."
    },
    {
      "step": 3,
      "text": "Stir in the orange juice, sherry, lemon juice, lime juice, and olive oil to make the marinade."
    },
    {
      "step": 4,
      "text": "Place the pork shoulder in a container, pour the marinade over it, cover, and chill for 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 5,
      "text": "Heat the oven to 325°F. Transfer the pork and marinade to a roasting pan."
    },
    {
      "step": 6,
      "text": "Roast for about 2 hours, until the thickest part reaches 145°F on a food thermometer. Rest for 3 minutes before serving.",
      "timer_minutes": 120
    },
    {
      "step": 7,
      "text": "Slice the pork and serve with the pan juices."
    }
  ],
