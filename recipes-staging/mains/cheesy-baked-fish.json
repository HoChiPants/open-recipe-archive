  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Melt the butter in a baking dish for 5 minutes, then arrange the sliced onion in the dish and season with seasoned salt.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Place the cod over the onions. Stir together the mayonnaise, Parmesan, provolone, mozzarella, and parsley, then spread the mixture over the fish."
    },
    {
      "step": 4,
      "text": "Bake for 20 minutes, or until the fish reaches 145°F and flakes easily with a fork.",
      "timer_minutes": 20
    }
  ],
