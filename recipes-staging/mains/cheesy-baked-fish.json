  "id": "cheesy-baked-fish",
  "name": "Cheesy Baked Fish",
  "subtitle": "Cod with a creamy cheese topping",
  "description": "Cod bakes over buttery onions beneath a savory mayonnaise and cheese topping.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
