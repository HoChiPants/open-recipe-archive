{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chicken-and-cashew-rice-noodles",
  "name": "Chicken and Cashew Rice Noodles",
  "subtitle": "A quick stir-fry with crisp vegetables and savory miso sauce.",
  "description": "Rice noodles, chicken, peppers, carrots, and cashews come together in a lightly sweet, savory skillet sauce.",
  "meal_type": "main",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "dried-flat-rice-noodles",
      "item": "dried flat rice noodles",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "garlic-infused-oil",
      "item": "garlic-infused oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "red-peppers-chopped-into-thin-strips",
      "item": "red peppers chopped into thin strips",
      "quantity": 2
    },
    {
      "ingredient_id": "carrots-thinly-sliced-on-the-diagonal",
      "item": "carrots thinly sliced on the diagonal",
      "quantity": 2,
      "unit": "medium"
    },
    {
      "ingredient_id": "chicken-breasts-chopped-into-thin-strips",
      "item": "chicken breasts chopped into thin strips",
      "quantity": 2
    },
    {
      "ingredient_id": "cashews",
      "item": "cashews",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "dried-chilli-flakes-optional",
      "item": "dried chilli flakes (optional)",
      "quantity": "1/2",
      "unit": "tsp",
      "optional": true
    },
    {
      "ingredient_id": "spring-onions-and-chopped-coriander",
      "item": "spring onions and chopped coriander",
      "quantity": 1,
      "preparation": "sliced, to serve"
    },
    {
      "ingredient_id": "gluten-free-soy-sauce",
      "item": "gluten-free soy sauce",
      "quantity": "4 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "gluten-free-white-or-red-miso-paste",
      "item": "gluten-free white or red miso paste",
      "quantity": "1 1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "ginger-paste",
      "item": "ginger paste",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "dark-brown-sugar",
      "item": "dark brown sugar",
      "quantity": "1 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "gluten-free-plain-flour",
      "item": "gluten-free plain flour",
      "quantity": 1,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir together the soy sauce, miso paste, ginger paste, brown sugar, and gluten-free flour until smooth."
    },
    {
      "step": 2,
      "text": "Cook the rice noodles according to the package directions, adding the optional chilli flakes. Drain well."
    },
    {
      "step": 3,
      "text": "Preheat a large wok or skillet over medium-high heat, then add the garlic-infused oil. Sauté the peppers and carrots with the brown sugar until lightly browned."
    },
    {
      "step": 4,
      "text": "Add the chicken and cook for 2 minutes, then continue cooking until the thickest pieces reach 165°F.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Toss in the drained noodles, cashews, and sauce. Stir until everything is hot and evenly coated."
    },
    {
      "step": 6,
      "text": "Serve topped with the sliced spring onions and chopped coriander."
    }
  ],
