  "id": "spicy-chicken-and-cheese-casserole",
  "name": "Spicy Chicken and Cheese Casserole",
  "subtitle": "Tender chicken baked with salsa, peppers, and cheddar",
  "description": "A simple baked chicken casserole with creamy salsa sauce, jalapeños, cheddar, and green onions.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
