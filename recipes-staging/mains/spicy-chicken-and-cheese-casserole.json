  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Grease a skillet or baking dish with the butter as needed."
    },
    {
      "step": 2,
      "text": "Cook the chicken chunks in the skillet over medium-high heat for 8 minutes, or until browned. Drain any excess liquid, then toss the chicken with the taco seasoning.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Transfer the chicken to a baking dish. Stir together the salsa, sour cream, and diced jalapeños, then spread the mixture over the chicken."
    },
    {
      "step": 4,
      "text": "Bake for 25 minutes. Top with the shredded Cheddar and bake for 5 minutes more, until melted and the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Let the casserole cool briefly, then scatter the sliced green onions over the top and serve."
    }
  ],
