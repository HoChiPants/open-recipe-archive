      "item": "butter",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breasts, cut into chunks"
    },
    {
