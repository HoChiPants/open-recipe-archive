  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Heat the olive oil and butter in a skillet. Add the diced onion, salt to taste, and salt; cook for 10 minutes, stirring, until golden brown. Add the garlic and cook briefly.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Transfer the onion mixture to a bowl. Stir in the bread crumbs and milk until combined, then let stand for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Combine the softened bread mixture with the ground chuck, parsley, Parmesan, beaten eggs, salt, black pepper, and cayenne. Stir until evenly mixed."
    },
    {
      "step": 5,
      "text": "Shape the mixture into a loaf and place it in a baking dish. Pour the tomato sauce over it."
    },
    {
      "step": 6,
      "text": "Bake for 60 minutes, or until the center reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Rest the meatloaf for 10 minutes before slicing.",
      "timer_minutes": 10
    }
  ],
