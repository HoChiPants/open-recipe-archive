  "instructions": [
    {
      "step": 1,
      "text": "Cook the brown basmati rice according to its package directions until tender, then drain if needed."
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a large frying pan. Add the crushed garlic and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the sliced chicken and hoisin sauce. Stir-fry until the chicken is cooked through and reaches 165°F in the thickest piece.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the defrosted edamame or peas and sweetcorn, and cook until hot and simmering.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Divide the rice among bowls and top with the chicken mixture, grated carrots, diced peppers, and sliced avocado."
    },
    {
      "step": 6,
      "text": "Serve with the lemon quarters, if using."
    }
  ],
