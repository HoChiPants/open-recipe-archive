  "id": "chicken-and-vegetable-rice-bowls",
  "name": "Chicken and Vegetable Rice Bowls",
  "subtitle": "Hoisin chicken with rice, vegetables, and avocado",
  "description": "Tender chicken, brown basmati rice, and colorful vegetables come together in a quick bowl-style meal finished with creamy avocado and optional lemon.",
  "meal_type": "main",
