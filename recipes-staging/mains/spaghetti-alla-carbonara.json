      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "grated-parmigiano-reggiano-cheese",
      "item": "grated Parmigiano-Reggiano cheese",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "grated-pecorino-romano-cheese",
      "item": "grated Pecorino Romano cheese",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "spaghetti",
      "item": "spaghetti",
      "quantity": 6,
      "unit": "ounces"
    },
    {
      "ingredient_id": "reserved-pasta-water",
      "item": "reserved pasta water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmigiano-reggiano-cheese",
      "item": "grated Parmigiano-Reggiano cheese",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "grated-pecorino-romano-cheese",
      "item": "grated Pecorino Romano cheese",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the guanciale, olive oil, and one portion of pepper in a skillet over medium heat for 5 minutes, until the guanciale is browned and its fat has rendered.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk the eggs with the cheeses and the remaining pepper until blended; set aside."
    },
    {
      "step": 3,
      "text": "Bring the reserved pasta water to a simmer in a saucepan."
    },
    {
      "step": 4,
      "text": "Cook the spaghetti in boiling water for 12 minutes, or until tender, then drain and reserve the measured pasta water.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Transfer the hot spaghetti to the skillet with the guanciale and toss to coat."
    },
    {
      "step": 6,
      "text": "Remove from the heat, add the egg mixture, and toss continuously while adding reserved pasta water as needed."
    },
    {
      "step": 7,
      "text": "Return the skillet to low heat and cook for 2 minutes, tossing, until the sauce is thick and reaches 160°F.",
      "timer_minutes": 2
    },
    {
      "step": 8,
      "text": "Stir in the remaining cheeses and enough reserved pasta water to make a glossy sauce; serve immediately."
    }
  ],
