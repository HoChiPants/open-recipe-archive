  "id": "spaghetti-alla-carbonara",
  "name": "Spaghetti alla Carbonara",
  "subtitle": "Silky cheese-and-egg pasta with crisp guanciale",
  "description": "A classic Italian pasta combining browned guanciale, pepper, eggs, and two cheeses in a glossy sauce.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "guanciale",
      "item": "guanciale",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "cut into 1/4-inch cubes"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
