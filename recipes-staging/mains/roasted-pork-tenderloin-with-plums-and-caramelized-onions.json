  "id": "roasted-pork-tenderloin-with-plums-and-caramelized-onions",
  "name": "Roasted Pork Tenderloin with Plums and Caramelized Onions",
  "subtitle": "Seared pork with roasted fruit and a balsamic onion sauce",
  "description": "Pork tenderloin is browned, roasted with thyme and plums, then served with caramelized onions finished with balsamic vinegar and butter.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "pork-tenderloin",
      "item": "pork tenderloin",
      "quantity": 1
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "shallots",
      "item": "shallots",
      "quantity": 2,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "fresh-thyme-sprigs",
      "item": "fresh thyme sprigs",
      "quantity": 3,
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "firm-plums",
      "item": "firm plums",
      "quantity": 2,
      "preparation": "pitted and each cut into 4 wedges"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "cold-butter",
      "item": "cold butter",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Season the pork with salt and pepper. Heat the oil in an ovenproof skillet over medium-high heat and sear the pork for 4 minutes, turning to brown it. Transfer it to a plate.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Add the sliced red onion and cook for 5 minutes. Add the shallots and continue cooking, stirring occasionally, until the onions are golden brown, about 10 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Return the pork to the skillet and add the thyme. Arrange the plum wedges around it."
    },
    {
      "step": 5,
      "text": "Roast for about 20 minutes, or until a thermometer inserted into the thickest part of the pork reads 145°F. Transfer the pork and plums to a plate and rest the pork for 3 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Add the water and balsamic vinegar to the skillet. Simmer, stirring, for 10 minutes to form a sauce.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Whisk in the cold butter until melted. Slice the rested pork and serve it with the plums, onions, and sauce."
    }
  ],
