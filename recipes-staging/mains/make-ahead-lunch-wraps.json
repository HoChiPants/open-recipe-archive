  "id": "make-ahead-lunch-wraps",
  "name": "Make-Ahead Lunch Wraps",
  "subtitle": "Brown rice, beans, corn, and cheese wrapped in soft tortillas",
  "description": "A hearty vegetarian filling rolled into flour tortillas for convenient lunches.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "uncooked-brown-rice",
      "item": "uncooked brown rice",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "black-beans",
      "item": "black beans",
      "quantity": 4,
      "unit": "can",
      "preparation": "15 ounce"
    },
    {
      "ingredient_id": "pinto-beans",
      "item": "pinto beans",
      "quantity": 2,
      "unit": "can",
      "preparation": "15.5 ounce"
    },
    {
      "ingredient_id": "whole-kernel-corn",
      "item": "whole kernel corn",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "tomatoes-and-green-chiles",
      "item": "tomatoes and green chiles",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce, diced"
    },
    {
      "ingredient_id": "10-inch-flour-tortillas",
      "item": "(10 inch) flour tortillas",
      "quantity": 16
    },
    {
      "ingredient_id": "pepperjack-cheese",
      "item": "pepperjack cheese",
      "quantity": 1,
      "unit": "pound",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the brown rice and water in a saucepan. Bring to a boil, cover, reduce the heat, and cook until the rice is tender, about 40 minutes. Let it cool briefly.",
      "timer_minutes": 40
    },
    {
      "step": 2,
      "text": "Drain the black beans and pinto beans. Drain the corn and tomatoes and green chiles if they are very wet."
    },
    {
      "step": 3,
      "text": "Combine the cooked rice, beans, corn, tomatoes and green chiles, and shredded pepperjack cheese."
    },
    {
      "step": 4,
      "text": "Divide the filling among the tortillas. Fold in the sides, roll each tortilla tightly, and place the seam side down."
    },
    {
      "step": 5,
      "text": "Serve immediately, or wrap and refrigerate for later lunches."
    }
  ],
