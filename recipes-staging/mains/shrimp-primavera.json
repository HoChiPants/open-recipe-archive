  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water with the salt to a boil. Add the rigatoni and cook for 13 minutes, or until tender. Drain.",
      "timer_minutes": 13
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large skillet. Add the onion and garlic and cook for 5 minutes, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the zucchini, yellow squash, green bell pepper, mushrooms, red pepper flakes, and ground black pepper. Cook for 5 minutes, until the vegetables are tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the crushed tomatoes, oregano, basil, remaining red pepper flakes, salt, and ground black pepper. Bring the sauce to a simmer."
    },
    {
      "step": 5,
      "text": "Add the shrimp and cook for 5 minutes, turning as needed, until opaque and cooked through.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Serve the shrimp and sauce over the drained rigatoni."
    }
  ],
