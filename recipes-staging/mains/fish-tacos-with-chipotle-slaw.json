  "instructions": [
    {
      "step": 1,
      "text": "Toss the coleslaw mix, half of the fresh cilantro, Greek yogurt, chopped chipotle peppers, vinegar, adobo sauce, and 1 teaspoon salt in a bowl. Set aside."
    },
    {
      "step": 2,
      "text": "Cut the fish fillets into taco-sized pieces. Mix the remaining salt, dried cilantro, cumin, and Mexican oregano; season the fish."
    },
    {
      "step": 3,
      "text": "Combine the flour, cornstarch, and cayenne pepper in a shallow dish. Coat the fish evenly and let it stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Heat the frying oil to 375°F in a suitable skillet or pot. Fry the fish in batches for about 3 minutes, turning as needed, until opaque, easily flaked, and at least 145°F internally.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Drain the fish. Warm the tortillas, then fill them with fish and slaw. Top with avocado and tomato."
    }
  ],
