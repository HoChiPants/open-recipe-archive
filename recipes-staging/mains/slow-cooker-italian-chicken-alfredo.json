  "id": "slow-cooker-italian-chicken-alfredo",
  "name": "Slow Cooker Italian Chicken Alfredo",
  "subtitle": "Tender chicken with creamy mushroom sauce over spaghetti",
  "description": "Chicken cooks slowly with Italian seasoning, garlic, cream cheese, soup, and mushrooms, then is served with spaghetti and parsley.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 300
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "4-ounce-skinless",
      "item": "(4 ounce) skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "dry-italian-style-salad-dressing-mix",
      "item": "dry Italian-style salad dressing mix",
      "quantity": 1,
      "unit": "package",
      "preparation": ".7 ounce"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "pressed"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "canned-mushrooms",
      "item": "canned mushrooms",
      "quantity": 1,
      "unit": "can",
      "preparation": "4.5 ounce, chopped"
    },
    {
      "ingredient_id": "spaghetti",
      "item": "spaghetti",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
