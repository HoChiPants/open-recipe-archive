      "item": "fresh parsley",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Coat the slow cooker with cooking spray. Add the chicken breasts."
    },
    {
      "step": 2,
      "text": "Whisk the water, dressing mix, and garlic together. Pour the mixture and condensed soup over the chicken."
    },
    {
      "step": 3,
      "text": "Cover and cook until the chicken is tender, about 4 hours. Stir in the softened cream cheese and whisk until the sauce is smooth.",
      "timer_minutes": 240
    },
    {
      "step": 4,
      "text": "Add the chopped mushrooms, cover, and continue cooking for 1 hour. Check that the chicken reaches 165°F in the thickest part.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Cook the spaghetti in boiling water until cooked through, about 12 minutes. Drain.",
      "timer_minutes": 12
    },
    {
      "step": 6,
      "text": "Serve the chicken and sauce over the spaghetti. Sprinkle with parsley."
    }
  ],
