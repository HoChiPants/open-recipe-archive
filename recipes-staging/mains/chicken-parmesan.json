  "id": "chicken-parmesan",
  "name": "Chicken Parmesan",
  "subtitle": "Crisp breaded chicken with tomato sauce and melted cheese",
  "description": "Breaded chicken breasts are fried until golden, topped with sauce, basil, and cheeses, then baked until fully cooked and bubbling.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
