  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F. Flatten the chicken breasts to an even thickness and season both sides with salt and pepper."
    },
    {
      "step": 2,
      "text": "Set out the flour, whisked eggs, and a mixture of panko, part of the Parmesan, and the provolone. Coat each chicken breast in flour, then egg, then the crumb mixture. Let the breaded chicken rest briefly.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Heat the frying olive oil in a skillet. Cook the chicken for about 2 minutes per side, until golden, then transfer it to a baking dish.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Spoon the tomato sauce over the chicken. Top with the remaining Parmesan, mozzarella, basil, provolone, and the olive oil."
    },
    {
      "step": 5,
      "text": "Bake until the cheese is melted and the chicken reaches 165°F at the thickest point on a food thermometer. Let it rest briefly before serving.",
      "timer_minutes": 20
    }
  ],
