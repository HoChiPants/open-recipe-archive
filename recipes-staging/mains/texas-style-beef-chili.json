  "id": "texas-style-beef-chili",
  "name": "Texas-Style Beef Chili",
  "subtitle": "Slow-simmered chuck with chile and cumin",
  "description": "Cubed beef chuck simmers with chile, cumin, oregano, and broth until tender in a hearty, thick chili.",
  "meal_type": "main",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "boneless-beef-chuck-roast",
      "item": "boneless beef chuck roast",
      "quantity": 3,
      "unit": "pounds",
      "preparation": "cut into 1 inch cubes"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "chili-powder",
      "item": "chili powder",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "beef-broth",
      "item": "beef broth",
      "quantity": 2,
      "unit": "can",
      "preparation": "14 ounce, divided"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large heavy pot over medium-high heat. Brown the beef in batches, then return all of it to the pot.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Add the garlic and cook briefly. Stir together the chili powder, ground cumin, and flour, then add the mixture and toss until the beef is evenly coated."
    },
    {
      "step": 3,
      "text": "Add the oregano, salt, pepper, and half of the beef broth. Stir to loosen any browned bits, then bring the mixture to a simmer."
    },
    {
      "step": 4,
      "text": "Cover partially and simmer gently, stirring occasionally and adding the remaining broth after 90 minutes. Continue cooking until the beef is tender and reaches at least 145°F, then rest for 3 minutes before serving.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Stir the chili until blended and adjust its consistency with the cooking liquid already in the pot."
    }
  ],
