  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Line a baking sheet with parchment."
    },
    {
      "step": 2,
      "text": "Process the chickpeas, cumin, coriander, cayenne, onion, garlic, sesame seeds, baking powder, and parsley stalks until combined but still slightly coarse. Shape into small falafel patties."
    },
    {
      "step": 3,
      "text": "Toss the cauliflower with the olive oil, then arrange it beside the falafel on the baking sheet."
    },
    {
      "step": 4,
      "text": "Bake the falafel for 20 minutes, turning once, until firm and browned.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "While they bake, combine the chopped parsley, mint, lemon juice, and zest. Cook the peas for 3 minutes, drain, and mash them with the avocado, feta, and some of the lemon mixture.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Toss the roasted cauliflower with the remaining herb and lemon mixture. Serve the falafel with the cauliflower tabbouleh, avocado-pea smash, and rocket."
    }
  ],
