  "id": "spiced-seared-tuna-steaks",
  "name": "Spiced Seared Tuna Steaks",
  "subtitle": "A citrusy spice crust for a quick skillet-seared fish dinner.",
  "description": "Tuna steaks are coated in lemon zest and warm spices, then seared in a hot skillet until safely cooked and lightly crusted.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "grated-lemon-zest",
      "item": "grated lemon zest",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-coriander",
      "item": "ground coriander",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1.25,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "5-ounce-tuna-steaks",
      "item": "(5 ounce) tuna steaks",
      "quantity": 4,
      "preparation": "about 1 inch thick"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the olive oil, lemon zest, coriander, ginger, black pepper, salt, and cinnamon into a smooth spice mixture."
    },
    {
      "step": 2,
      "text": "Coat the tuna steaks evenly with the spice mixture."
    },
    {
      "step": 3,
      "text": "Heat a skillet over medium-high heat until hot."
    },
    {
      "step": 4,
      "text": "Sear the tuna steaks for about 3 minutes per side, turning once, until a thermometer reads 145°F or the fish is opaque and flakes easily.",
      "timer_minutes": 3
    }
  ],
