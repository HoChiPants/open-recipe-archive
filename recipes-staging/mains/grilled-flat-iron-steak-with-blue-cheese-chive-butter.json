  "instructions": [
    {
      "step": 1,
      "text": "Whisk the vinegar, garlic, tablespoon of cracked black pepper, rosemary, oregano, salt, and olive oil into a marinade."
    },
    {
      "step": 2,
      "text": "Coat the steak with the marinade and let it stand for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat the grill to medium-high heat."
    },
    {
      "step": 4,
      "text": "Combine the softened butter, blue cheese, chives, and remaining cracked black pepper; mix until combined and set aside."
    },
    {
      "step": 5,
      "text": "Grill the steak for about 5 minutes per side, until a thermometer registers 145°F in the thickest part.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Transfer the steak to a board and rest for at least 3 minutes before slicing.",
      "timer_minutes": 3
    },
    {
      "step": 7,
      "text": "Serve with the blue cheese-chive butter."
    }
  ],
