  "instructions": [
    {
      "step": 1,
      "text": "Mix the garlic, ginger, ketchup, hoisin sauce, golden caster sugar, 2 tbsp dark soy sauce, 2 tbsp rice vinegar, and 2 tbsp sunflower oil. Coat the pork belly and place it in a roasting dish."
    },
    {
      "step": 2,
      "text": "Cook the pork belly for 180 minutes, then continue cooking for 45 minutes until browned and tender. Check the thickest part with a thermometer; pork is safe at 145°F, followed by a 3-minute rest.",
      "timer_minutes": 225
    },
    {
      "step": 3,
      "text": "Rest the pork for 20 minutes. Transfer the roasting juices to a saucepan with the remaining hoisin sauce and dark soy sauce, then reduce until thick. Cut or shred the pork and toss it with the glaze.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Mix the plain flour, caster sugar, yeast, milk, 1 tbsp sunflower oil, 1 tbsp rice vinegar, and enough water to form a dough. Knead for 15 minutes until smooth, cover, and leave to rise for 120 minutes.",
      "timer_minutes": 135
    },
    {
      "step": 5,
      "text": "Work in the baking powder and knead for 5 minutes. Divide the dough into 18 pieces. Roll each piece into a thick round, brush lightly with sunflower oil, and fold it over itself to form a bun.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Arrange the buns on a lightly oiled steamer surface, cover, and let them rest while preparing the steamer."
    },
    {
      "step": 7,
      "text": "Steam the buns for 8 minutes, then leave them covered for 2 minutes before opening the lid.",
      "timer_minutes": 8
    },
    {
      "step": 8,
      "text": "Open each bun and fill with glazed pork, shredded carrot and mooli, spring onions, and the wasabi mayonnaise."
    }
  ],
