  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Pat the turkey dry and coat it with the olive oil."
    },
    {
      "step": 2,
      "text": "Mix the salt, thyme, and pepper, then rub the seasoning over the oiled turkey."
    },
    {
      "step": 3,
      "text": "Place the turkey in a roasting pan and roast for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Stir together the honey, melted butter, parsley, sage, basil, and the remaining salt and pepper to make the glaze."
    },
    {
      "step": 5,
      "text": "Brush the turkey with the glaze and continue roasting until a thermometer in the thickest part of the thigh registers 165°F."
    },
    {
      "step": 6,
      "text": "Transfer the turkey to a cutting board, rest for 15 minutes, then carve.",
      "timer_minutes": 15
    }
  ],
