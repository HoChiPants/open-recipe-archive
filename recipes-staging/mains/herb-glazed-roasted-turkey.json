  "id": "herb-glazed-roasted-turkey",
  "name": "Herb-Glazed Roasted Turkey",
  "subtitle": "A golden roast with a honeyed herb finish",
  "description": "A whole turkey is seasoned, roasted, and brushed with a buttery honey-herb glaze before resting and carving.",
  "meal_type": "main",
  "cuisine": "American",
