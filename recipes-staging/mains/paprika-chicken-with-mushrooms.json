  "id": "paprika-chicken-with-mushrooms",
  "name": "Paprika Chicken with Mushrooms",
  "subtitle": "Tender chicken with buttery mushrooms and onions",
  "description": "Seasoned chicken breasts bake with sliced mushrooms and onion rings in a paprika-butter sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breasts"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "sliced into thin rings"
    },
    {
      "ingredient_id": "fresh-mushrooms",
      "item": "fresh mushrooms",
      "quantity": 1,
      "unit": "pound",
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Season the chicken breasts evenly with paprika, salt and pepper, and garlic powder."
    },
    {
      "step": 3,
      "text": "Melt the butter in an oven-safe skillet over medium heat. Add the chicken and transfer the skillet to the oven."
    },
    {
      "step": 4,
      "text": "Arrange the onion rings and mushrooms over and around the chicken."
    },
    {
      "step": 5,
      "text": "Bake until the vegetables begin to soften and the chicken reaches 165°F in the thickest part, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Stir the mushrooms and onions through the melted butter and juices, then continue cooking until the chicken is fully cooked, about 10 minutes more.",
      "timer_minutes": 10
    }
  ],
