  "id": "cheesy-chicken-alfredo-pasta-bake",
  "name": "Cheesy Chicken Alfredo Pasta Bake",
  "subtitle": "Creamy baked penne with chicken and melted cheese",
  "description": "Cubed chicken and penne are combined with a creamy Parmesan sauce, layered with mozzarella, and browned until set.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 32
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 3,
      "preparation": "boneless chicken breast halves, cubed"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic cloves",
      "quantity": 4,
      "preparation": "minced"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "penne-pasta",
      "item": "penne pasta",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet. Add the cubed chicken, season with salt and pepper, and cook, stirring, until golden brown, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the garlic and cook for 2 minutes. Whisk in the chicken broth and heavy cream.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the penne and cook until tender, about 15 minutes. Confirm the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Transfer the mixture to the prepared dish and layer it with the Parmesan and mozzarella."
    },
    {
      "step": 6,
      "text": "Bake until set, then grill or broil until the cheese is golden brown, about 15 minutes.",
      "timer_minutes": 15
    }
  ],
