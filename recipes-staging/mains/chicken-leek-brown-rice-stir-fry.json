  "id": "chicken-leek-brown-rice-stir-fry",
  "name": "Chicken, Leek & Brown Rice Stir-Fry",
  "subtitle": "A quick skillet meal with greens and chorizo",
  "description": "Thinly sliced chicken, chorizo, vegetables, kale, and wholegrain rice come together in a savory, lightly tangy stir-fry.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
