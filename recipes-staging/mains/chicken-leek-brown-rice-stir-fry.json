  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large wok or skillet over medium-high heat for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Add the chicken and chorizo. Stir-fry for 2 minutes, then continue cooking until the chicken reaches 165°F internally. Transfer the chicken and chorizo to a plate."
    },
    {
      "step": 3,
      "text": "Cook the leek and red pepper in the same pan for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the kale and cook for 1 minute, stirring until it begins to wilt.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Stir in the low salt soy sauce, red wine vinegar, and wholegrain rice. Return the chicken and chorizo to the pan, toss everything together, and cook until hot, about 3 minutes.",
      "timer_minutes": 3
    }
  ],
