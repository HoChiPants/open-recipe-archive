  "instructions": [
    {
      "step": 1,
      "text": "Stir the sugar into the warm water. Sprinkle in the yeast and let it stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mix the salt with 2 cups of the flour. Add the yeast mixture and olive oil, then stir to form a dough."
    },
    {
      "step": 3,
      "text": "Knead in the remaining flour until the dough is smooth."
    },
    {
      "step": 4,
      "text": "Place the dough in an oiled bowl, turn to coat, cover, and let rise for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Combine the ricotta, mozzarella, Parmesan, pepperoni, parsley, Italian seasoning, olives, bell pepper, and mushrooms."
    },
    {
      "step": 6,
      "text": "Heat the oven to 375°F. Divide the risen dough into portions, roll or stretch them out, and arrange the filling along the centers."
    },
    {
      "step": 7,
      "text": "Fold and seal the dough around the filling, then arrange the filled portions in a curved snake-like shape on a baking sheet."
    },
    {
      "step": 8,
      "text": "Whisk the egg with the water and brush the mixture over the dough."
    },
    {
      "step": 9,
      "text": "Bake for about 35 minutes, until golden brown and the center reaches 160°F on a food thermometer.",
      "timer_minutes": 35
    },
    {
      "step": 10,
      "text": "Let cool for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
