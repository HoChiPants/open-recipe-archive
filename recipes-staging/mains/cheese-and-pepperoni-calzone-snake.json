  "id": "cheese-and-pepperoni-calzone-snake",
  "name": "Cheese and Pepperoni Calzone Snake",
  "subtitle": "A shaped baked calzone with a savory cheese filling",
  "description": "Yeasted dough is filled with cheeses, pepperoni, vegetables, and herbs, then shaped and baked until golden and fully set.",
