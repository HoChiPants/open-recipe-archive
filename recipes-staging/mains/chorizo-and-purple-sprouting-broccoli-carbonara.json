  "id": "chorizo-and-purple-sprouting-broccoli-carbonara",
  "name": "Chorizo and Purple Sprouting Broccoli Carbonara",
  "subtitle": "A smoky pasta with greens and a creamy egg-Parmesan coating",
  "description": "Chorizo and tender purple sprouting broccoli are folded through spaghetti with a Parmesan egg sauce for a quick, savory main dish.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "garlic",
      "item": "garlic cloves",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "chorizo-chopped",
      "item": "chorizo chopped",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "eggs-plus-2-egg-yolks-freeze-the-whites-for-another-recipe",
      "item": "eggs plus 2 egg yolks (freeze the whites for another recipe)",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "parmesan-finely-grated",
      "item": "parmesan finely grated",
      "quantity": 120,
      "unit": "g"
    },
    {
      "ingredient_id": "spaghetti",
      "item": "spaghetti",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "purple-sprouting-broccoli-cut-into-small-pieces",
      "item": "purple sprouting broccoli cut into small pieces",
      "quantity": 250,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs and yolks, then stir in the finely grated Parmesan."
    },
    {
      "step": 2,
      "text": "Cook the spaghetti and broccoli together in boiling water for 5 minutes, or until the pasta is tender and the broccoli is cooked. Drain.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "While the pasta cooks, sauté the garlic and chopped chorizo for 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Toss the drained pasta and broccoli with the chorizo mixture. Remove from the heat, add the egg mixture, and stir until coated. Return briefly to low heat if needed, stirring continuously, until the sauce reaches 160°F and the egg is fully set without curdling."
    },
    {
      "step": 5,
      "text": "Serve immediately."
    }
  ],
