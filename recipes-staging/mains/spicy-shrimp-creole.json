{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "spicy-shrimp-creole",
  "name": "Spicy Shrimp Creole",
  "subtitle": "Shrimp in a peppery tomato sauce",
  "description": "A savory tomato-based shrimp dish with celery, onions, garlic, and cayenne.",
  "meal_type": "main",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "julienne-celery",
      "item": "julienne celery",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 2,
      "unit": "can",
      "preparation": "14.5 ounce, crushed"
    },
    {
      "ingredient_id": "tomato-sauce",
      "item": "tomato sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce"
    },
    {
      "ingredient_id": "bay-leaf",
      "item": "bay leaf",
      "quantity": 1,
      "preparation": "crushed"
    },
    {
      "ingredient_id": "hot-pepper-sauce",
      "item": "hot pepper sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "medium-shrimp",
      "item": "medium shrimp",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "peeled and deveined"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large pot over medium heat. Add the celery, onions, garlic, and sugar; cook until the vegetables begin to soften."
    },
    {
      "step": 2,
      "text": "Stir in the flour, salt, black pepper, and cayenne pepper until evenly combined."
    },
    {
      "step": 3,
      "text": "Add the crushed tomatoes, tomato sauce, bay leaf, and hot pepper sauce. Bring the mixture to a simmer."
    },
    {
      "step": 4,
      "text": "Simmer uncovered for 30 minutes, stirring occasionally.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Stir in the shrimp and cook for 15 minutes, until opaque and easily curled through. For a measured check, cook shrimp to 145°F.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Remove the bay leaf and serve hot."
    }
  ],
