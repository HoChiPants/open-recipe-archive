  "id": "arroz-con-gambas-y-calamar",
  "name": "Arroz con Gambas y Calamar",
  "subtitle": "Spanish seafood rice with saffron and squid",
  "description": "A saffron-scented rice dish cooked with shell-on prawns, sliced squid, tomato, wine, and seafood stock.",
  "meal_type": "main",
  "cuisine": "Spanish",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "raw",
      "item": "raw",
      "quantity": "18-24",
      "preparation": "shell-on king prawns (about 3-4 per person, depending on size)"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "onion-or-banana-shallot-finely-chopped",
      "item": "onion or banana shallot finely chopped",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "fresh-bay-leaf",
      "item": "fresh bay leaf",
      "quantity": 1
    },
    {
      "ingredient_id": "good-pinch-of-saffron",
      "item": "good pinch of saffron"
    },
    {
      "ingredient_id": "paella-rice",
      "item": "paella rice",
      "quantity": 450,
      "unit": "g"
    },
    {
      "ingredient_id": "tomato-pure-e",
      "item": "tomato purée",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "seafood-stock-see-tip",
      "item": "seafood stock (see tip)",
      "quantity": 680,
      "unit": "ml"
    },
    {
      "ingredient_id": "squid-about-600g",
      "item": "squid (about 600g)",
      "quantity": 3,
      "unit": "medium",
      "preparation": "cleaned and sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare all ingredients and keep the prawns and sliced squid ready."
    },
    {
      "step": 2,
      "text": "Heat the olive oil with the finely chopped onion or shallot over medium heat until softened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the bay leaf, saffron, paella rice, and tomato purée. Stir briefly to coat the rice.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Pour in the white wine and seafood stock, then add the squid and shell-on prawns.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Bring the mixture to a steady simmer and cook without stirring.",
      "timer_minutes": 12
    },
    {
      "step": 6,
      "text": "Stir the rice once, then continue simmering until the rice is cooked through and the liquid is absorbed.",
      "timer_minutes": 6
    },
    {
      "step": 7,
      "text": "Check that the prawns are opaque and fully cooked and that the squid is tender. Serve hot."
    }
  ],
