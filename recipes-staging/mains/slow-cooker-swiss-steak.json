  "instructions": [
    {
      "step": 1,
      "text": "Mix the flour with salt and pepper. Coat the steak pieces in the seasoned flour."
    },
    {
      "step": 2,
      "text": "Preheat a large skillet, add the oil, and cook the celery, onion, and carrots for 5 minutes, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the coated steak and brown sugar to the skillet. Cook for 5 minutes, turning as needed, until lightly browned.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Transfer the steak and vegetables to a slow cooker. Stir in the tomatoes with their juice and Worcestershire sauce."
    },
    {
      "step": 5,
      "text": "Cover and cook until the beef is tender, about 490 minutes. Confirm the beef reaches at least 145°F, then rest for 3 minutes before serving.",
      "timer_minutes": 490
    }
  ],
