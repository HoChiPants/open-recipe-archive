  "id": "slow-cooker-swiss-steak",
  "name": "Slow Cooker Swiss Steak",
  "subtitle": "Tender beef with vegetables in tomato sauce",
  "description": "Flour-coated round steak cooks with vegetables, tomatoes, brown sugar, and Worcestershire sauce for a hearty slow-cooker meal.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
