  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a skillet over medium heat. Sauté the paneer cubes for 5 minutes, turning as needed, then transfer the paneer and oil out of the skillet.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Heat the butter in the skillet. Add the onions and cook, stirring occasionally, for 10 minutes until golden brown.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the ginger paste and garlic paste; cook for 1 minute. Add the ground cashews, ground red chiles, ground cumin, ground coriander, and garam masala, and stir for 1 minute.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Mix in the tomato sauce, half-and-half, milk, white sugar, and salt. Simmer for 5 minutes, stirring occasionally, until thickened.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Return the paneer to the skillet and heat gently for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
