  "id": "paneer-butter-masala",
  "name": "Paneer Butter Masala",
  "subtitle": "Paneer in a creamy spiced tomato sauce",
  "description": "Pan-seared paneer is folded into a rich tomato sauce seasoned with aromatics, warm spices, cashews, and dairy.",
  "meal_type": "main",
