{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "roasted-turkey-with-tomato-ancho-sauce",
  "name": "Roasted Turkey with Tomato-Ancho Sauce",
  "subtitle": "Tender roast turkey with a savory tomato, chile, and pumpkin-seed sauce",
  "description": "A whole turkey is roasted with apple and olives, then served with a thick sauce built from tomatoes, bell pepper, ancho chiles, pumpkin seeds, and onion.",
  "meal_type": "main",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 200
  },
  "ingredients": [
    {
      "ingredient_id": "roma-plum-tomatoes",
      "item": "Roma (plum) tomatoes",
      "quantity": 10,
      "unit": "large",
      "preparation": "halved and seeded"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 1,
      "unit": "large",
      "preparation": "halved and seeded"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "10-pound-whole-turkey",
      "item": "(10 pound) whole turkey",
      "quantity": 1,
      "preparation": "neck and giblets removed"
    },
    {
      "ingredient_id": "granny-smith-apple",
      "item": "Granny Smith apple",
      "quantity": 1,
      "preparation": "peeled, quartered, and cored"
    },
    {
      "ingredient_id": "5-ounce-jar-pitted-green-olives",
      "item": "(5 ounce) jar pitted green olives",
      "quantity": 1,
      "preparation": "drained"
    },
    {
      "ingredient_id": "raw-pumpkin-seeds",
      "item": "raw pumpkin seeds",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "dried-ancho-chiles",
      "item": "dried ancho chiles",
      "quantity": 2,
      "preparation": "stemmed and seeded"
    },
    {
      "ingredient_id": "bay-leaves",
      "item": "bay leaves",
      "quantity": 2
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "cut into chunks"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Arrange the tomatoes and green bell pepper in a pan, season with salt and pepper, and cook for 5 minutes. Transfer them to a blender or food processor.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil in a large ovenproof roasting pan. Add the turkey and brown it for 10 minutes, turning as needed.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Place the apple and olives inside the turkey cavity. Set the turkey aside while preparing the sauce."
    },
    {
      "step": 5,
      "text": "Toast the pumpkin seeds, ancho chiles, and bay leaves in a dry skillet for 5 minutes, stirring the seeds frequently. Transfer them to the blender.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Add the cooked bell pepper and tomatoes, the pumpkin seeds, and onion. Blend until thick, seasoning with salt and pepper."
    },
    {
      "step": 7,
      "text": "Spread the sauce around and over the turkey in the roasting pan, then roast until the thickest part of the breast and thigh reaches 165°F on a food thermometer.",
      "timer_minutes": 180
    },
    {
      "step": 8,
      "text": "Rest the turkey briefly before carving and serving with the sauce."
    }
  ],
