  "instructions": [
    {
      "step": 1,
      "text": "Heat the rapeseed oil in a large saucepan. Add the sliced onion, garlic, and ginger, and cook for 8 minutes until softened.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Stir in the turmeric, ground coriander, cumin seeds, red chilli, and chopped coriander. Cook briefly until fragrant."
    },
    {
      "step": 3,
      "text": "Add the bouillon powder, red lentils, and aubergine. Stir in enough water to cover, bring to a boil, then cook for 15 minutes until the lentils and aubergine are tender.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Stir in the chickpeas and their liquid, and cook for 5 minutes until hot.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Mix the red onion, chopped coriander, mint, tomatoes, and yogurt to make the raita."
    },
    {
      "step": 6,
      "text": "Serve the dhal topped with the raita and the reserved mint leaves."
    }
  ],
