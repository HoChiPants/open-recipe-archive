  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Place the chicken in a baking dish, add enough stock to partially cover it, and season with paprika, salt, and cayenne. Bake for 20 minutes, or until the thickest part reaches 165°F. Cool briefly, then remove the skin and bones and shred the meat.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Cook the lasagna noodles in boiling salted water for 8 minutes. Drain and transfer them to a separate surface so they do not stick together.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a skillet. Add the celery and onion and cook, stirring, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Combine the shredded chicken, sautéed vegetables, buffalo sauce, blue cheese, ricotta, blue cheese dressing, egg, and mozzarella. Stir until evenly mixed; adjust the salt and cayenne if needed."
    },
    {
      "step": 5,
      "text": "Coat a baking dish with cooking spray. Layer noodles, chicken mixture, and ricotta mixture evenly, repeating until the ingredients are used. Finish with the remaining cheese mixture."
    },
    {
      "step": 6,
      "text": "Bake at 350°F until hot and cooked through, about 45 minutes. Verify the center reaches 165°F.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Let the lasagna rest for 20 minutes before slicing and serving.",
      "timer_minutes": 20
    }
  ],
