  "id": "spaghetti-lasagna",
  "name": "Spaghetti Lasagna",
  "subtitle": "Layered spaghetti baked with creamy cheese and sauce",
  "description": "Tender spaghetti is layered with seasoned sauce and a creamy cottage-cheese mixture, then baked under melted mozzarella.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "thin-spaghetti",
      "item": "thin spaghetti",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "prepared-spaghetti-sauce",
      "item": "prepared spaghetti sauce",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "small-curd-cottage-cheese",
      "item": "small curd cottage cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "fat-free-sour-cream",
      "item": "fat-free sour cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 ounce, shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Bring a pot of water to a simmer. Add the spaghetti and cook for 10 minutes, or until tender.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Drain the spaghetti and combine it with the spaghetti sauce."
    },
    {
      "step": 4,
      "text": "Stir together the cottage cheese, sour cream, and half of the mozzarella."
    },
    {
      "step": 5,
      "text": "Transfer half of the spaghetti mixture to a baking dish and spread the cheese mixture over it. Add the remaining spaghetti mixture, then top with the remaining mozzarella."
    },
    {
      "step": 6,
      "text": "Bake for 40 minutes, until hot throughout and the center reaches 165°F.",
      "timer_minutes": 40
    }
  ],
