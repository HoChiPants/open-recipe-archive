  "id": "grilled-turkey-tenderloins",
  "name": "Grilled Turkey Tenderloins",
  "subtitle": "Rosemary-mustard marinated turkey cooked over high heat",
  "description": "Turkey tenderloins are marinated in soy sauce, mustard, and crushed rosemary, then grilled until tender and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dijon-style-prepared-mustard",
      "item": "Dijon-style prepared mustard",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "dried-rosemary",
      "item": "dried rosemary",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "turkey-tenderloins",
      "item": "turkey tenderloins",
      "quantity": 1,
      "unit": "pound"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the soy sauce, mustard, and crushed rosemary in a shallow dish."
    },
    {
      "step": 2,
      "text": "Add the turkey tenderloins and turn to coat. Cover and refrigerate for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Preheat the grill to medium-high heat."
    },
    {
      "step": 4,
      "text": "Remove the turkey from the marinade and place it on the grill."
    },
    {
      "step": 5,
      "text": "Grill for about 10 minutes per side, turning once, until the thickest part reaches 165°F.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Rest briefly, then slice and serve."
    }
  ],
