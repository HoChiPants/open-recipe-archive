{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "fried-chicken-gizzards",
  "name": "Fried Chicken Gizzards",
  "subtitle": "Tender simmered gizzards with a crisp seasoned coating",
  "description": "Chicken gizzards are simmered until tender, cooled, seasoned, and fried until crisp for a hearty American main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-gizzards",
      "item": "chicken gizzards",
      "quantity": 1.5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "seasoned-salt",
      "item": "seasoned salt",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Trim and cut the chicken gizzards into smaller pieces. Transfer them to a saucepan, cover with water, and bring to a simmer."
    },
    {
      "step": 2,
      "text": "Simmer the gizzards for 15 minutes, then drain and let them cool enough to handle. Pat dry.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Combine the flour, seasoned salt, black pepper, and garlic powder in a bowl."
    },
    {
      "step": 4,
      "text": "Heat the vegetable oil to 375°F in a deep, heavy pan."
    },
    {
      "step": 5,
      "text": "Coat the cooled gizzards evenly in the seasoned flour mixture."
    },
    {
      "step": 6,
      "text": "Fry the coated gizzards for 10 minutes, working in batches if needed, until crisp and the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Drain on a lined plate or rack and serve hot."
    }
  ],
