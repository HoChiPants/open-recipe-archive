  "id": "baked-eggs-with-beans-and-mushrooms",
  "name": "Baked Eggs with Beans and Mushrooms",
  "subtitle": "Creamy beans and herbed mushrooms under softly baked eggs",
  "description": "Sautéed mushrooms and shallot are combined with beans, crème fraîche, and tarragon, then baked with eggs and served alongside garlic toast, yogurt, and extra herbs.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "shallot-or-1-2-onion",
      "item": "shallot or 1/2 onion",
      "quantity": 1,
      "preparation": "finely sliced"
    },
    {
      "ingredient_id": "chestnut-or-button-mushrooms-sliced",
      "item": "chestnut or button mushrooms sliced",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "garlic-cloves-1-crushed",
      "item": "garlic cloves 1 crushed",
      "quantity": 2,
      "preparation": "1 halved"
    },
    {
      "ingredient_id": "bunch-of-tarragon-finely-chopped",
      "item": "bunch of tarragon finely chopped",
      "quantity": "1/2",
      "unit": "small"
    },
    {
      "ingredient_id": "can-haricot-or-cannellini-beans-drained-and-rinsed",
      "item": "can haricot or cannellini beans drained and rinsed",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "reduced-fat-cre-me-frai-che",
      "item": "reduced-fat crème fraîche",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "slices-sourdough-or-bloomer",
      "item": "slices sourdough or bloomer",
      "quantity": 2
    },
    {
      "ingredient_id": "natural-yogurt",
      "item": "natural yogurt",
      "quantity": 100,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large ovenproof skillet over medium heat. Add the sliced shallot and cook for 5 minutes until softened.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the mushrooms and cook for 10 minutes, stirring occasionally, until browned and tender.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the crushed garlic, most of the tarragon, beans, and crème fraîche. Warm through, then make two wells and crack in the eggs."
    },
    {
      "step": 4,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 5,
      "text": "Bake for about 8 minutes, until the whites are set, the yolks are at the desired doneness, and the center reaches 160°F for egg safety.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Rub the bread with the halved garlic clove and toast it. Serve the baked eggs with the toast, natural yogurt, and remaining tarragon."
    }
  ],
