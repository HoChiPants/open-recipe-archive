{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pineapple-pork-loin",
  "name": "Pineapple Pork Loin",
  "subtitle": "Honey-mustard pork with pineapple",
  "description": "Pork loin is browned, coated with a honey-mustard mixture, and roasted with pineapple until tender.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "3-pound-pork-loin",
      "item": "(3 pound) pork loin",
      "quantity": 0.5
    },
    {
      "ingredient_id": "pineapple-chunks",
      "item": "pineapple chunks",
      "quantity": 0.5,
      "unit": "can",
      "preparation": "8 ounce, drained"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Stir together the honey, Dijon mustard, and black pepper."
    },
    {
      "step": 2,
      "text": "Brown the pork loin for 5 minutes, then transfer it to a baking dish and coat it with the honey-mustard mixture.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the drained pineapple chunks around the pork and season with salt. Reduce the oven temperature to 375°F and roast until the center reaches 145°F on a food thermometer.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "Rest the pork for 3 minutes. Blend the pineapple until smooth, if desired, and serve with the sliced pork.",
      "timer_minutes": 3
    }
  ],
