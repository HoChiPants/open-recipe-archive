  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Mix the thyme, oregano, salt, and ground black pepper, then season the chicken thighs."
    },
    {
      "step": 2,
      "text": "Warm the vegetable oil in a large ovenproof skillet over medium-high heat. Place the chicken skin-side down and cook until browned, about 8 minutes. Transfer the chicken to a plate.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Add the mushrooms to the skillet and cook until lightly browned, about 5 minutes. Stir in the onion and garlic; cook for 3 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Pour in the dry white wine and simmer for 2 minutes, scraping up browned bits. Add the chicken broth and bring the sauce to a steady simmer.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Return the chicken to the skillet and transfer it to the oven. Bake until the chicken reaches 165°F at the thickest part, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Stir in the heavy cream and adjust with the salt and freshly ground black pepper to taste. Sprinkle with the fresh parsley and serve when the sauce is set."
    }
  ],
