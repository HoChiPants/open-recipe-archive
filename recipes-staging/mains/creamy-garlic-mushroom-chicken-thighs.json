  "id": "creamy-garlic-mushroom-chicken-thighs",
  "name": "Creamy Garlic Mushroom Chicken Thighs",
  "subtitle": "Tender chicken with mushrooms in a savory cream sauce",
  "description": "Bone-in chicken thighs are browned, then finished with mushrooms, garlic, wine, broth, and cream for a rich one-pan dinner.",
  "meal_type": "main",
