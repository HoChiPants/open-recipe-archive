  "id": "maple-glazed-pork-chops",
  "name": "Maple-Glazed Pork Chops",
  "subtitle": "Tender bone-in chops with a tangy maple pan sauce",
  "description": "Brown thick pork chops, then bake them with a savory maple sauce until safely cooked and glazed.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "1-inch-thick-bone-in-pork-chops",
      "item": "(1-inch thick) bone-in pork chops",
      "quantity": 4
    },
    {
      "ingredient_id": "real-maple-syrup",
      "item": "real maple syrup",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "white-vinegar",
      "item": "white vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "chili-powder",
      "item": "chili powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Heat an oven-safe skillet over medium-high heat."
    },
    {
      "step": 2,
      "text": "Season the pork chops with salt and pepper, then brown them in the hot skillet for 3 minutes. Transfer the chops to a baking dish.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Whisk together the maple syrup, water, chopped onion, vinegar, Worcestershire sauce, chili powder, and any remaining salt and pepper. Pour the mixture over the chops."
    },
    {
      "step": 4,
      "text": "Bake until the pork reaches 145°F in the thickest part. Remove from the oven and let rest for 3 minutes before serving.",
      "timer_minutes": 45
    }
  ],
