  "id": "beef-rendang",
  "name": "Beef Rendang",
  "subtitle": "Slow-braised beef with coconut, chiles, and warm spices",
  "description": "Beef chuck cooks slowly with an aromatic chile-spice paste, coconut milk, tamarind, and lemongrass until deeply seasoned and tender.",
  "meal_type": "main",
  "cuisine": "Asian",
