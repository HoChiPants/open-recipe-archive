  "instructions": [
    {
      "step": 1,
      "text": "Cut the beef into large chunks. Blend or finely process the shallots, garlic, ginger, galangal, chiles, pepper flakes, coriander, turmeric, cardamom, nutmeg, and tamarind paste into a coarse paste."
    },
    {
      "step": 2,
      "text": "Warm the oil in a heavy pot over medium heat. Add the aromatic paste and cook, stirring, until fragrant and slightly thickened."
    },
    {
      "step": 3,
      "text": "Add the beef and stir to coat. Pour in the coconut milk, then mix in the brown sugar and add the lemongrass. Bring the liquid to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Reduce the heat to low and simmer uncovered, stirring occasionally, until the sauce is thick and the beef is tender, about 4 hours. Add small amounts of water only if needed to prevent scorching.",
      "timer_minutes": 240
    },
    {
      "step": 5,
      "text": "Check that the beef reaches at least 145°F, then let it rest for 3 minutes. Remove the lemongrass and serve warm.",
      "timer_minutes": 3
    }
  ],
