  "instructions": [
    {
      "step": 1,
      "text": "Cook the potatoes with the salt until tender, about 15 minutes, then set aside.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Heat the oil in a large pot for 2 minutes. Add the onion and garlic and cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Stir in the curry powder, garam masala, cumin, ginger, and cayenne; cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the potatoes, chickpeas, peas, tomatoes, and coconut milk. Bring to a simmer and cook for 10 minutes, stirring occasionally.",
      "timer_minutes": 10
    }
