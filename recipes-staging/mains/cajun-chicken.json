  "id": "cajun-chicken",
  "name": "Cajun Chicken",
  "subtitle": "Seasoned grilled chicken breasts",
  "description": "Chicken breasts are coated in a seasoned oil mixture, rested, then grilled until safely cooked and lightly charred.",
  "meal_type": "main",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
