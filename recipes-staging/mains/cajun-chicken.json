    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "cajun-seasoning",
      "item": "Cajun seasoning",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dried-italian-seasoning",
      "item": "dried Italian seasoning",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lemon-pepper-seasoning",
      "item": "lemon-pepper seasoning",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 10,
      "preparation": "boneless chicken breast halves - pounded to 1/2 inch thickness"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the Cajun seasoning, Italian seasoning, lemon-pepper seasoning, garlic powder, and vegetable oil in a bowl."
    },
    {
      "step": 2,
      "text": "Add the chicken and turn to coat evenly. Cover and refrigerate for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat a grill to medium-high heat and lightly oil the grates if needed."
    },
    {
      "step": 4,
      "text": "Grill the chicken for about 8 minutes, turning as needed, until browned and the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 8
    }
  ],
