  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Heat 1 tablespoon olive oil in a skillet. Add the onion and garlic; cook until tender, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the spinach and cook for 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Remove from the heat and stir in the basil, lemon juice, oregano, and black pepper. Let the mixture cool."
    },
    {
      "step": 5,
      "text": "Brush or coat a pizza pan with 1 tablespoon olive oil. Shape the pizza crust on the pan."
    },
    {
      "step": 6,
      "text": "Spread the cooled spinach mixture over the crust and top with 1 cup mozzarella and the feta."
    },
    {
      "step": 7,
      "text": "Arrange the tomato slices over the pizza and sprinkle with the bread crumbs and remaining mozzarella."
    },
    {
      "step": 8,
      "text": "Bake until the crust is golden brown, about 15 minutes.",
      "timer_minutes": 15
    }
  ],
