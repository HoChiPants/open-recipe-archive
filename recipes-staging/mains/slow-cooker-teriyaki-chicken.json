  "id": "slow-cooker-teriyaki-chicken",
  "name": "Slow Cooker Teriyaki Chicken",
  "subtitle": "Tender chicken in a sweet-savory garlic sauce",
  "description": "Diced chicken cooks gently in a simple teriyaki mixture for an easy dinner.",
