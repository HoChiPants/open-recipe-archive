  "instructions": [
    {
      "step": 1,
      "text": "Whisk the chicken broth, teriyaki sauce, brown sugar, and minced garlic in the slow cooker until the sugar is mostly dissolved."
    },
    {
      "step": 2,
      "text": "Add the diced chicken and stir to coat. Cover and cook on the slow cooker setting until the chicken reaches 165°F in the thickest pieces.",
