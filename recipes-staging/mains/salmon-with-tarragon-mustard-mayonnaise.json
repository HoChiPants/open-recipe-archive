  "id": "salmon-with-tarragon-mustard-mayonnaise",
  "name": "Salmon with Tarragon-Mustard Mayonnaise",
  "subtitle": "Pan-seared salmon finished in the oven with a bright herb sauce",
  "description": "Salmon fillets are quickly seared, oven-finished, and served with a creamy tarragon, parsley, mustard, and lemon sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "8-ounce-center-cut-salmon-fillets",
      "item": "(8 ounce) center-cut salmon fillets",
      "quantity": 2,
      "preparation": "with skin"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "fresh-tarragon",
      "item": "fresh tarragon",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fresh-flat-leaf-parsley",
      "item": "fresh flat-leaf parsley",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the salmon fillets with the kosher salt. Stir the garlic, tarragon, parsley, mayonnaise, Dijon mustard, lemon juice, and cayenne together until smooth."
    },
    {
      "step": 2,
      "text": "Heat the oven to 350°F. Warm the vegetable oil in an oven-safe skillet over medium-high heat."
    },
    {
      "step": 3,
      "text": "Place the salmon skin-side down in the skillet and cook for 5 minutes, until the skin is browned and crisp.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Transfer the skillet to the oven and bake for 4 minutes, or until the thickest part reaches 145°F and the fish flakes easily.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Serve the salmon with the herb mayonnaise."
    }
  ],
