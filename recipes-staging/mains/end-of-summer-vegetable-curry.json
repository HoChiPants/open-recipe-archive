  "instructions": [
    {
      "step": 1,
      "text": "Toast the cumin seeds, coriander seeds, cardamom pods, cloves, and black mustard seeds in a dry pan for about 2 minutes, until fragrant. Stir in the turmeric and chilli powder, then set aside.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Heat the oil in a large pot over medium heat. Add the toasted spice mixture and cook briefly, then add the onions and cook for 10 minutes until softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the garlic, ginger, and green chilli. Stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the squash, tomato, and potato. Stir to coat with the spices, cover, and cook for 20 minutes, stirring occasionally, until the potato and squash are tender.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Add the red pepper, fine beans, and courgette or marrow. Cook for 10 minutes, until all the vegetables are cooked through.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Remove from the heat and let the curry cool slightly. Stir in the yogurt, then scatter over the chopped fresh herbs and serve."
    }
  ],
