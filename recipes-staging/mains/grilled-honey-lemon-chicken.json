  "instructions": [
    {
      "step": 1,
      "text": "Whisk the oil, lemon zest and juice, mustard, honey, garlic, Worcestershire sauce, herb seasoning, salt, and pepper in a bowl."
    },
    {
      "step": 2,
      "text": "Place the chicken in a shallow dish or resealable bag. Pour the marinade over it and turn to coat."
    },
    {
      "step": 3,
      "text": "Cover and refrigerate until ready to grill."
    },
    {
      "step": 4,
      "text": "Preheat an outdoor grill to medium-high heat and lightly oil the grates if needed."
    },
    {
      "step": 5,
      "text": "Grill the chicken, turning as needed, until browned and the thickest part reaches 165°F on a food thermometer, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Rest briefly, then serve."
    }
  ],
