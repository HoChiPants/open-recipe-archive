  "instructions": [
    {
      "step": 1,
      "text": "Season the lamb shoulder chops with salt and ground black pepper."
    },
    {
      "step": 2,
      "text": "Preheat the pressure cooker on its sauté setting. Add the vegetable oil, then brown the chops in batches as needed. Transfer them to a plate.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the onion and garlic to the pot and sauté until tender.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Pour in the red wine and scrape up any browned bits. Add the beef consomme and rosemary, then return the lamb to the pot.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Secure the lid and cook at high pressure until the lamb is tender.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Allow the pressure to release naturally, then let the chops rest for 3 minutes. Check that whole-cut lamb reaches 145°F with a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Remove the lamb and switch the cooker to sauté. Mix the cornstarch with the water, stir the slurry into the cooking liquid, and cook until thickened.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Return the lamb to the sauce and serve."
    }
  ],
