      "item": "ground ginger",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "boneless-pork-loin-roast",
      "item": "boneless pork loin roast",
      "quantity": 2,
      "unit": "pounds"
