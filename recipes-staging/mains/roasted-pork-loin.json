  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Combine the brown sugar, cinnamon applesauce, and ground ginger in a bowl."
    },
    {
      "step": 3,
      "text": "Add the pork roast and turn to coat it with the mixture."
    },
    {
      "step": 4,
      "text": "Transfer the coated roast to a roasting pan."
    },
    {
      "step": 5,
      "text": "Roast for about 60 minutes, or until a food thermometer inserted into the thickest part registers 145°F.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Let the roast rest for 3 minutes, then cut into slices and serve.",
      "timer_minutes": 3
    }
  ],
