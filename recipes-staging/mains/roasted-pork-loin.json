  "id": "roasted-pork-loin",
  "name": "Roasted Pork Loin",
  "subtitle": "A sweet, spiced roast with an apple glaze",
  "description": "A boneless pork loin roast coated in brown sugar, cinnamon applesauce, and ginger, then roasted until tender.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
