  "instructions": [
    {
      "step": 1,
      "text": "Soak the chana dhal in water for 3 hours. Soak the dried sour plums or dried sour cherries separately for 1 hour, then drain both.",
      "timer_minutes": 180
    },
    {
      "step": 2,
      "text": "Heat the sunflower oil in a heavy pot over medium heat. Add the onion and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the ginger, garlic, and turmeric. Stir for 3 minutes, until fragrant.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the tomatoes, green chillies, red chilli, and drained chana dhal. Cook until the tomatoes begin to break down."
    },
    {
      "step": 5,
      "text": "Stir in the Greek yogurt and chicken stock or water. Add the drained sour plums or cherries and the chicken pieces."
    },
    {
      "step": 6,
      "text": "Bring to a gentle simmer, cover, and cook until the chicken is cooked through and reaches 165°F at the thickest part near the bone.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Garnish with coriander and serve with lime wedges, flatbreads, or cooked rice."
    }
  ],
