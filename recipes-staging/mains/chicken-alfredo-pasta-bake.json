  "id": "chicken-alfredo-pasta-bake",
  "name": "Chicken Alfredo Pasta Bake",
  "subtitle": "Creamy chicken, spinach, and pasta baked with cheese",
  "description": "A rich pasta casserole combining browned chicken and pancetta with a creamy cheddar sauce, spinach, and a Parmesan topping.",
  "meal_type": "main",
