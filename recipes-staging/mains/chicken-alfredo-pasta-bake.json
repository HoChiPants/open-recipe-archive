  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Heat the oil in a large skillet. Cook the pancetta until rendered and lightly browned, then transfer it to a plate."
    },
    {
      "step": 3,
      "text": "Add the chicken to the skillet and cook for 6 minutes, turning occasionally. Continue cooking with the onion and garlic for 10 minutes, until the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 16
    },
    {
      "step": 4,
      "text": "Meanwhile, simmer the pasta until just tender, then drain."
    },
    {
      "step": 5,
      "text": "Stir the flour into the chicken mixture and cook for 1 minute. Whisk in the cream and milk until smooth, then simmer until thickened.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Stir in the mustard and cheddar. Add the pancetta, drained pasta, and spinach, mixing until the spinach wilts."
    },
    {
      "step": 7,
      "text": "Transfer the mixture to the baking dish and sprinkle with Parmesan."
    },
    {
      "step": 8,
      "text": "Bake until bubbling and golden on top.",
      "timer_minutes": 20
    }
  ],
