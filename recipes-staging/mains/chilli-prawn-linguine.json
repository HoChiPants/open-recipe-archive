  "instructions": [
    {
      "step": 1,
      "text": "Mix the sugar snap peas, fromage frais, lime zest and juice, and sugar. Set aside."
    },
    {
      "step": 2,
      "text": "Cook the linguine according to the package directions, adding the sugar snap peas and sugar mixture as directed."
    },
    {
      "step": 3,
      "text": "Heat the olive oil with the garlic and chilli in a large pan."
    },
    {
      "step": 4,
      "text": "Add the prawns and cook for 3 minutes, until opaque and cooked through.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the cherry tomatoes and cook for a further 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Drain the linguine and peas, then toss with the prawn mixture and basil."
    },
    {
      "step": 7,
      "text": "Serve with the salad leaves and crusty white bread."
    }
  ],
