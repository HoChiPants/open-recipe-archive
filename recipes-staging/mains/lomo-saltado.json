  "instructions": [
    {
      "step": 1,
      "text": "Cut the steak into strips. Combine 2 tablespoons soy sauce with the sugar, add the steak, and marinate for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Preheat the oven to 200°F. Cook the frozen fries in 2 tablespoons olive oil until browned and crisp, about 7 minutes. Transfer them to a warm oven-safe dish and keep warm.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Heat 1 tablespoon olive oil in a large skillet. Add the marinated steak and cook until browned and it reaches 145°F internally. Transfer the steak to a plate and rest for 3 minutes."
    },
    {
      "step": 4,
      "text": "Heat the remaining 3 tablespoons olive oil in the skillet. Add the red onion, orange bell pepper, habanero pepper, green onion, and salt. Cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the garlic and ginger; stir for 1 minute. Add the tomatoes and cook for 3 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 6,
      "text": "Return the steak to the skillet. Stir in the remaining soy sauce, white vinegar, fries, and cilantro. Season with salt and serve."
    }
  ],
