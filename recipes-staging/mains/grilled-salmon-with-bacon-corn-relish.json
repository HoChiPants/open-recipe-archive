{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "grilled-salmon-with-bacon-corn-relish",
  "name": "Grilled Salmon with Bacon-Corn Relish",
  "subtitle": "Rich salmon with smoky bacon, sweet corn, and crisp vegetables",
  "description": "Grill salmon until opaque and flaky, then serve it over spinach with a warm bacon-corn relish brightened with vinegar.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 6,
      "preparation": "cut crosswise into 1/2-inch pieces"
    },
    {
      "ingredient_id": "ears-white-corn",
      "item": "ears white corn",
      "quantity": 2
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped, white and light green parts separated from green tops"
    },
    {
      "ingredient_id": "red-bell-pepper",
      "item": "red bell pepper",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "rice-vinegar",
      "item": "rice vinegar",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "8-ounce-center-cut-boneless-salmon-fillets",
      "item": "(8 ounce) center-cut boneless salmon fillets",
      "quantity": 2
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fresh-spinach-leaves",
      "item": "fresh spinach leaves",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill and a skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Cook the bacon in the skillet until browned and crisp, about 10 minutes. Transfer it to a plate, leaving the rendered fat in the skillet.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the corn, white and light green onion pieces, and bell pepper to the skillet. Season with cayenne, salt, and black pepper; cook, stirring, until the vegetables are tender, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the rice vinegar and olive oil. Fold in the bacon and set the relish aside."
    },
    {
      "step": 5,
      "text": "Brush the salmon with vegetable oil and season with cayenne, salt, and black pepper."
    },
    {
      "step": 6,
      "text": "Grill the salmon for about 5 minutes per side, or until it reaches 145°F internally and is opaque and easily flaked.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Arrange the spinach on plates and top with the grilled salmon. Spoon over the bacon-corn relish and garnish with the green onion tops."
    }
  ],
