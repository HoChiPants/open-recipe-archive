  "id": "pad-thai",
  "name": "Pad Thai",
  "subtitle": "Rice noodles with tamarind, tofu, prawns, and peanuts",
  "description": "Toss softened rice noodles with a tangy tamarind sauce, tofu, prawns, sprouts, egg, and fresh garnishes.",
  "meal_type": "main",
  "cuisine": "Thai",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
