  "instructions": [
    {
      "step": 1,
      "text": "Soak the rice noodles in water for 20 minutes, then drain well.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Stir together the tamarind paste, fish sauce, sugar, lime juice, and soy sauce. Set the lime wedges and chilli powder aside for serving."
    },
    {
      "step": 3,
      "text": "Heat the oil in a large wok or skillet. Add the tofu and cook until lightly browned, then add the prawns and cook until opaque and fully cooked, reaching 145°F."
    },
    {
      "step": 4,
      "text": "Add the drained noodles and toss for about 3 minutes. Pour in the sauce and fold through the beansprouts.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Push the noodles to one side. Add the eggs and cook, stirring, until fully set and at least 160°F.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Toss the set eggs through the noodles. Serve with chopped peanuts, spring onions, pickled turnip, lime wedges, chilli powder, and soy sauce."
    }
  ],
