{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "salisbury-style-cube-steaks",
  "name": "Salisbury-Style Cube Steaks",
  "subtitle": "Tender beef with onion gravy",
  "description": "Flour-coated cube steaks bake slowly with sliced onion in a savory stock-based sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "4-ounce-cube-steaks-pounded-round-meat",
      "item": "(4 ounce) cube steaks (pounded round meat)",
      "quantity": 6
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "sliced into strips"
    },
    {
      "ingredient_id": "beef-stock",
      "item": "beef stock",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Heat the vegetable oil in a large ovenproof skillet or baking dish."
    },
    {
      "step": 2,
      "text": "Dredge the cube steaks in part of the flour, coating both sides. Arrange them in the heated oil and top with the sliced onion."
    },
    {
      "step": 3,
      "text": "Whisk the remaining flour with the beef stock and Worcestershire sauce until smooth. Pour the mixture over the steaks and onion."
    },
    {
      "step": 4,
      "text": "Cover and bake for 120 minutes, until the beef reaches at least 145°F in the thickest part; rest for 3 minutes before serving.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Serve the steaks with the onions and thickened gravy."
    }
  ],
