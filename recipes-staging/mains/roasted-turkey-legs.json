  "id": "roasted-turkey-legs",
  "name": "Roasted Turkey Legs",
  "subtitle": "Tender oven-roasted turkey with celery and butter",
  "description": "Turkey legs roast over celery with butter, salt, and water for a simple savory main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "stalks-celery-stalks",
      "item": "stalks celery stalks",
      "quantity": 3,
      "preparation": "cut in thirds"
    },
    {
      "ingredient_id": "turkey-legs",
      "item": "turkey legs",
      "quantity": 3
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Arrange the celery in a roasting pan and place the turkey legs on top. Rub the legs with the butter and season with salt."
    },
    {
      "step": 3,
      "text": "Pour the water into the pan, keeping it around the turkey rather than over the skin."
    },
    {
      "step": 4,
      "text": "Roast for 90 minutes, adding water as needed and basting with melted butter from the pan if needed, until golden brown and the thickest part of each leg reaches 165°F on a food thermometer.",
      "timer_minutes": 90
    },
    {
      "step": 5,
      "text": "Rest briefly, then serve."
    }
  ],
