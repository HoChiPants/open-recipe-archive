      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Lightly coat a baking sheet with cooking spray."
    },
    {
      "step": 2,
      "text": "Combine the turkey, spinach, feta, paprika, onion powder, salt, and black pepper until evenly mixed."
    },
    {
      "step": 3,
      "text": "Shape the mixture into 24 meatballs and arrange them on the prepared baking sheet."
    },
    {
      "step": 4,
      "text": "Bake for 25 minutes, until cooked through and the centers reach 165°F on a food thermometer.",
      "timer_minutes": 25
    }
