  "id": "baked-spinach-feta-and-turkey-meatballs",
  "name": "Baked Spinach, Feta, and Turkey Meatballs",
  "subtitle": "Tender turkey meatballs with spinach and feta",
  "description": "Seasoned turkey meatballs baked with thawed spinach and crumbled feta for an easy main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
