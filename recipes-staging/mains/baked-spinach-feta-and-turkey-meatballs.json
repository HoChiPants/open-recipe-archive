      "item": "cooking spray"
    },
    {
      "ingredient_id": "lean-ground-turkey",
      "item": "lean ground turkey",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed and drained"
    },
    {
