  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a boil. Add the broccoli and cook for 5 minutes, until tender; drain.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Season the chicken with the ground ginger, crushed red pepper, salt, and black pepper."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Add the chicken and cook until browned and the thickest pieces reach 165°F."
    },
    {
      "step": 4,
      "text": "Add the green onions and garlic, and cook briefly until fragrant."
    },
    {
      "step": 5,
      "text": "Stir together the hoisin sauce, chile paste, and low sodium soy sauce. Add the chicken stock and stir for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Return the broccoli to the skillet, add the sauce, and toss until everything is evenly coated and heated through."
    }
  ],
