      "item": "yellow mustard",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "seasoned-rice-wine-vinegar",
      "item": "seasoned rice wine vinegar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sriracha",
      "item": "Sriracha",
      "quantity": 2,
      "unit": "teaspoons"
    },
