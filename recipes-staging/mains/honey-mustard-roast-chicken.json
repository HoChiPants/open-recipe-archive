      "item": "kosher salt",
      "quantity": 3,
      "unit": "teaspoons",
      "preparation": "plus more as needed"
    },
    {
      "ingredient_id": "4-5-pound-whole-chicken",
      "item": "(4.5 pound) whole chicken",
      "quantity": 1
    },
    {
