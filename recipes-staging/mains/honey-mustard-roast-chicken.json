      "item": "green onions",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped, or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the mustard, honey, vinegar, Sriracha, paprika, pepper, and 3 teaspoons salt until smooth."
    },
    {
      "step": 2,
      "text": "Prepare the chicken for roasting by cutting along the backbone and opening it flat. Coat it with the marinade, cover, and refrigerate for 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 3,
      "text": "Heat the oven to 425°F. Place the chicken in a roasting pan and pour the stock around it. Season with additional salt as needed."
    },
    {
      "step": 4,
      "text": "Roast for 40 minutes, then brush the chicken with pan juices or remaining marinade and continue roasting for about 15 minutes, until the thickest parts reach 165°F.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Rest the chicken briefly, then carve and serve with the chopped green onions."
    }
  ],
