  "id": "honey-mustard-roast-chicken",
  "name": "Honey Mustard Roast Chicken",
  "subtitle": "Tangy glazed chicken with a smoky finish",
  "description": "A whole chicken is marinated in a honey-mustard mixture, roasted until tender, and finished with green onions.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
