      "item": "fresh parsley",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a large heavy pot over medium-high heat. Season the short ribs with salt and pepper, then coat them with flour."
    },
    {
      "step": 2,
      "text": "Add the olive oil and brown the ribs for 3 minutes, turning as needed. Transfer the ribs to a plate.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the onions and cook for 2 minutes. Add the celery and carrots, then cook until the vegetables begin to soften.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the garlic, thyme, bay leaves, and additional salt and pepper to taste. Cook briefly until fragrant.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Pour in the red wine, scraping up any browned bits. Add the beef stock and return the ribs to the pot."
    },
    {
      "step": 6,
      "text": "Bring the liquid to a simmer, cover, and cook for 120 minutes, or until the sauce has thickened and the beef is tender. Confirm the thickest portions reach at least 145°F, then rest the ribs for 3 minutes.",
      "timer_minutes": 120
    },
    {
      "step": 7,
      "text": "Remove the bay leaves, stir in the parsley, and serve with the braising liquid."
    }
  ],
