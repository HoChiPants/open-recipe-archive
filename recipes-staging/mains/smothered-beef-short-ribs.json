{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "smothered-beef-short-ribs",
  "name": "Smothered Beef Short Ribs",
  "subtitle": "Tender beef braised with vegetables and herbs",
  "description": "Flour-coated short ribs are browned, then slowly cooked with aromatic vegetables, red wine, and beef stock until tender and the braising liquid thickens.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 150
  },
  "ingredients": [
    {
      "ingredient_id": "beef-short-ribs",
      "item": "beef short ribs",
      "quantity": 4,
      "unit": "pounds"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "celery",
      "item": "celery",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "minced"
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "bay-leaves",
      "item": "bay leaves",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "red-wine",
      "item": "red wine",
      "quantity": 1,
      "unit": "cup"
    },
    {
