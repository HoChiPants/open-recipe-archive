  "id": "lemon-cream-chicken-pasta",
  "name": "Lemon Cream Chicken Pasta",
  "subtitle": "Baked chicken and rotelle in a bright cream sauce",
  "description": "Chicken breasts bake with lemon and broth, then join rotelle pasta in a creamy lemon sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 3,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1,
      "preparation": "quartered"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "divided"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 2,
      "unit": "can",
      "preparation": "14.5 ounce"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "rotelle-pasta",
      "item": "rotelle pasta",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-lemon-zest",
      "item": "grated lemon zest",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Place the chicken in a baking dish and season with half of the garlic powder and black pepper. Add the quartered lemon, broth, and lemon juice."
    },
    {
      "step": 2,
      "text": "Cover and bake for 40 minutes, or until the chicken reaches 165°F in the thickest part. Transfer the chicken to a plate and reserve the cooking liquid.",
      "timer_minutes": 40
    },
    {
      "step": 3,
      "text": "Cook the rotelle according to the package directions, then drain."
    },
    {
      "step": 4,
      "text": "Whisk the reserved broth, heavy cream, lemon zest, and the remaining garlic powder and black pepper in the baking dish or a saucepan. Add the pasta and stir to coat."
    },
    {
      "step": 5,
      "text": "Return the chicken to the pasta and warm gently for 5 minutes. Serve with the lemon quarters.",
      "timer_minutes": 5
    }
  ],
