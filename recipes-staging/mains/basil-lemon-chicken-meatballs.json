  "instructions": [
    {
      "step": 1,
      "text": "Mix the lemon zest and juice with the breadcrumbs and milk; let stand until softened."
    },
    {
      "step": 2,
      "text": "Add the mozzarella, 1 tablespoon of the pesto, chicken, basil stems and leaves, and garlic. Mix until combined, then shape into evenly sized meatballs."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a large skillet over medium heat. Add the meatballs, turn to coat, and sauté until browned and nearly cooked through.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Transfer the meatballs to a plate. Add the onion to the skillet and stir until softened."
    },
    {
      "step": 5,
      "text": "Stir in the basil stems, garlic, and onion, then cook briefly. Add the remaining pesto and cherry tomatoes, stir in the sugar, and bring to a simmer.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Return the meatballs to the sauce and cook until the chicken reaches 165°F in the center and the sauce is cooked through.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Stir in the lemon juice, then add the basil leaves and serve over the cooked pasta."
    }
  ],
