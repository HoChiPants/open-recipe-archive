  "id": "basil-lemon-chicken-meatballs",
  "name": "Basil-Lemon Chicken Meatballs",
  "subtitle": "Tender chicken meatballs in a bright tomato sauce",
  "description": "Chicken meatballs with lemon, basil, mozzarella, and sun-dried tomato pesto, served with pasta.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
