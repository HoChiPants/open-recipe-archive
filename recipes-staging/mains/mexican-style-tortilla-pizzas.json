  "id": "mexican-style-tortilla-pizzas",
  "name": "Mexican-Style Tortilla Pizzas",
  "subtitle": "Crisp tortillas layered with beans, seasoned beef, sauce, cheese, and fresh toppings",
  "description": "Fried tortillas form the base for a quick baked meal with creamy beans, seasoned beef, melted cheese, and fresh vegetables.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
