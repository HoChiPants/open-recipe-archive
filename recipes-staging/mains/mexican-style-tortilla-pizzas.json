  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Heat the oil in a skillet. Cook the tortillas in batches for about 3 minutes, turning as needed, until golden brown. Drain on paper towels.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Spread the warmed beans over four tortillas and top with the cooked seasoned beef. Place one remaining tortilla over each stack."
    },
    {
      "step": 4,
      "text": "Stir together the taco sauce and enchilada sauce, then spoon it over the tortilla stacks. Sprinkle with both cheeses."
    },
    {
      "step": 5,
      "text": "Bake for 4 minutes, until the cheese is melted.",
      "timer_minutes": 4
    },
    {
      "step": 6,
      "text": "Top with the tomatoes, olives, and green onions. Cut into wedges and serve."
    }
  ],
