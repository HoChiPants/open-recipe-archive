{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "fajita-quesadillas",
  "name": "Fajita Quesadillas",
  "subtitle": "Sizzling peppers, onions, steak, and melted cheese in crisp tortillas.",
  "description": "A quick skillet meal combining sautéed fajita vegetables and cooked steak with tortillas and melted Mexican-style cheese.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 0.5,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "flour-tortillas",
      "item": "flour tortillas",
      "quantity": 4
    },
    {
      "ingredient_id": "steak",
      "item": "steak",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "cooked, cut into 1/4-inch thick pieces"
    },
    {
      "ingredient_id": "mexican-cheese-blend",
      "item": "Mexican cheese blend",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm a large skillet over medium heat and add half of the oil."
    },
    {
      "step": 2,
      "text": "Add the onion and green bell pepper. Cook, stirring occasionally, until softened, about 10 minutes. Season with salt to taste.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Transfer the vegetables to a plate and wipe out the skillet if needed."
    },
    {
      "step": 4,
      "text": "Place one tortilla in the skillet and sprinkle cheese over half. Add steak and sautéed vegetables, then top with more cheese. Fold the tortilla over the filling."
    },
    {
      "step": 5,
      "text": "Cook for about 4 minutes, turning once, until the tortilla is crisp and the cheese is melted. Repeat with the remaining tortillas and filling, adding the remaining oil as needed.",
      "timer_minutes": 4
    },
    {
      "step": 6,
      "text": "Cut the quesadillas into wedges and serve hot."
    }
  ],
