  "id": "grilled-chicken-foil-packets",
  "name": "Grilled Chicken Foil Packets",
  "subtitle": "Chicken and vegetables sealed for the grill",
  "description": "Chicken breasts, sliced potatoes, onions, peppers, and mushrooms are seasoned, wrapped in foil, and grilled until tender and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
