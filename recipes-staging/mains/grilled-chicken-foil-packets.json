      "item": "button mushrooms",
      "quantity": 2,
      "unit": "cups",
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill and prepare four large sheets of foil."
    },
    {
      "step": 2,
      "text": "Stir together the vegetable oil, cider vinegar, garlic powder, ground black pepper, salt, dried basil, dried thyme, and green bell pepper. Set the mixture aside."
    },
    {
      "step": 3,
      "text": "Divide the chicken, potatoes, onions, green bell pepper, and button mushrooms among the foil sheets. Add the reserved mixture, then fold and seal each sheet into a packet."
    },
    {
      "step": 4,
      "text": "Grill the packets until the contents are cooked through, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Check that the chicken reaches 165°F in the thickest part before serving."
    }
  ],
