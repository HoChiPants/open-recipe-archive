      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "unit": "large",
      "preparation": "cut into 1/4 inch thick slices"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 2,
      "unit": "large",
      "preparation": "cut into 1/4 inch strips"
    },
