{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "slow-cooker-barbecue-chicken-breast",
  "name": "Slow Cooker Barbecue Chicken Breast",
  "subtitle": "Tender chicken with tangy barbecue glaze",
  "description": "Seasoned chicken breasts cook slowly with barbecue sauce and vinegar, then finish with a sweet, spiced sauce until safely cooked through.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 360
  },
  "ingredients": [
    {
      "ingredient_id": "boneless-chicken-breasts",
      "item": "boneless chicken breasts",
      "quantity": 2
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "barbecue-sauce",
      "item": "barbecue sauce",
      "quantity": 1,
      "unit": "bottle",
      "preparation": "18 ounce, divided"
    },
    {
      "ingredient_id": "apple-cider-vinegar",
      "item": "apple cider vinegar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion-powder",
      "item": "onion powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken breasts with the salt, half of the ground black pepper, and the red pepper flakes."
    },
    {
      "step": 2,
      "text": "Place the chicken in a slow cooker. Add half of the barbecue sauce and the apple cider vinegar."
    },
    {
      "step": 3,
      "text": "Cover and cook for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 4,
      "text": "Stir together the remaining barbecue sauce with the brown sugar, onion powder, garlic powder, and remaining ground black pepper."
    },
    {
      "step": 5,
      "text": "Pour the sauce mixture over the chicken and continue cooking until the chicken is tender and reaches 165°F in the thickest part.",
      "timer_minutes": 180
    },
    {
      "step": 6,
      "text": "Serve the chicken with its sauce."
    }
  ],
  "tags": [
    "dinner",
    "slow-cooker",
    "chicken",
    "barbecue"
  ],
