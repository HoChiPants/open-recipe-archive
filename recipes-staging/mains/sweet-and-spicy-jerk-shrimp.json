  "id": "sweet-and-spicy-jerk-shrimp",
  "name": "Sweet and Spicy Jerk Shrimp",
  "subtitle": "Roasted shrimp with pineapple, peppers, and brown rice",
  "description": "Shrimp, pineapple, peppers, onion, and jalapeño roast with jerk seasoning, then finish with cilantro and lime over warm brown rice.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "large-shrimp-in-shells",
      "item": "large shrimp in shells",
      "quantity": 1.5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "pineapple-slices-packed-in-100-juice",
      "item": "pineapple slices packed in 100% juice",
      "quantity": 1,
      "unit": "can",
      "preparation": "20 ounce, drained, and cut into 2-inch pieces"
    },
    {
      "ingredient_id": "red-bell-peppers",
      "item": "red bell peppers",
      "quantity": 2,
      "preparation": "cut into thin strips"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "jalapeno-pepper",
      "item": "jalapeno pepper",
      "quantity": 1,
      "preparation": "halved lengthwise, seeded, and sliced"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "jamaican-jerk-seasoning",
      "item": "Jamaican jerk seasoning",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "fresh-cilantro",
      "item": "fresh cilantro",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "hot-cooked-brown-rice",
      "item": "hot cooked brown rice",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "lime",
      "item": "lime",
      "quantity": 1,
      "preparation": "cut into wedges"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Arrange the pineapple, bell peppers, red onion, and jalapeño on a large rimmed baking sheet. Toss with the olive oil and jerk seasoning."
    },
    {
      "step": 3,
      "text": "Add the shrimp and toss to coat evenly with the seasoned vegetables and fruit."
    },
    {
      "step": 4,
      "text": "Spread everything into an even layer and roast until the shrimp are opaque and reach 145°F in the thickest part, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Fold in the cilantro. Serve over the hot brown rice with lime wedges."
    }
  ],
