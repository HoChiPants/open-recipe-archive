  "instructions": [
    {
      "step": 1,
      "text": "Whisk the lime juice, olive oil, cilantro, jalapeño, ancho chile powder, cumin, salt, and pepper in a shallow dish. Add the halibut, turn to coat, and refrigerate for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Preheat a grill to medium-high heat. Remove the halibut from the marinade and drain briefly."
    },
    {
      "step": 3,
      "text": "Grill the halibut for about 5 minutes per side, until it reaches 145°F and flakes easily. Flake the fish into large pieces.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Grill the corn tortillas briefly on both sides until warm and pliable.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Fill the tortillas with cabbage and halibut. Top with salsa, pepper Jack, and avocado, then serve."
    }
  ],
