  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill to medium-high heat."
    },
    {
      "step": 2,
      "text": "Whisk the ketchup, honey, low-sodium soy sauce, and crushed garlic together."
    },
    {
      "step": 3,
      "text": "Grill the pork chops, turning as needed, until browned and cooked through, about 9 minutes total. Check the thickest part with a thermometer; pork is ready at 145°F.",
      "timer_minutes": 9
    },
    {
      "step": 4,
      "text": "Rest the pork chops for 3 minutes, then serve with the sauce.",
      "timer_minutes": 3
    }
  ],
