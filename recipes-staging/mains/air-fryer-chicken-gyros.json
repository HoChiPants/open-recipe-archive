  "instructions": [
    {
      "step": 1,
      "text": "Mix the coriander, cumin, paprika, mixed herbs, olive oil, grated garlic, lemon zest, and half the lemon juice. Coat the chicken and set aside for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Stir the cucumber, 80 g yogurt, grated small garlic clove, mint, and remaining lemon juice together. Set aside while the chicken marinates."
    },
    {
      "step": 3,
      "text": "Preheat the air fryer to 400°F for 5 minutes. Cook the fries according to the appliance instructions, adding the small garlic clove with the fries if appropriate, until crisp, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Add the marinated chicken to the air fryer and cook for about 25 minutes, turning once, until the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Rest the chicken for 5 minutes. Arrange the fries, chicken, tomato, and red onion with the yogurt sauces, then serve.",
      "timer_minutes": 5
    }
  ],
