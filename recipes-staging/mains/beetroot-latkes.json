  "instructions": [
    {
      "step": 1,
      "text": "Combine the beetroot, beaten egg, flour, garlic, caraway seeds, cumin, and lemon zest. Mix until evenly coated."
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a skillet over medium heat. Add portions of the beetroot mixture and flatten into patties."
    },
    {
      "step": 3,
      "text": "Cook the latkes in batches until browned on both sides and cooked through. Check that the centers are firm and fully set, or reach 160°F on a food thermometer."
    },
    {
      "step": 4,
      "text": "Stir the chopped mint into the Greek yogurt."
    },
    {
      "step": 5,
      "text": "Serve the latkes with the mint yogurt, rocket leaves, and halved cherry tomatoes."
    }
  ],
