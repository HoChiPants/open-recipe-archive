  "id": "beetroot-latkes",
  "name": "Beetroot Latkes",
  "subtitle": "Crisp beetroot patties with mint yogurt",
  "description": "Grated beetroot and warm spices form savory pan-cooked latkes, served with mint yogurt and a fresh rocket-tomato salad.",
  "meal_type": "main",
