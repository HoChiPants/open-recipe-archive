  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Arrange the potatoes, zucchini, and red onions in a baking dish."
    },
    {
      "step": 3,
      "text": "Combine the pureed tomatoes, olive oil, parsley, salt, and pepper, then pour the mixture over the vegetables and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes. Stir the vegetables, then continue baking for 30 minutes, or until tender.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Let the dish cool briefly before serving."
    }
  ],
