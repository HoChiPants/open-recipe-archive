  "id": "briam-greek-baked-zucchini-and-potatoes",
  "name": "Briam (Greek Baked Zucchini and Potatoes)",
  "subtitle": "Tender vegetables roasted with tomato, olive oil, and parsley",
  "description": "Thinly sliced potatoes, zucchini, and onions bake in a seasoned tomato and olive oil mixture until tender.",
  "meal_type": "main",
  "cuisine": "Greek",
