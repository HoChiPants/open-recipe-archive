  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a heavy pot over medium heat. Add the cardamom, bay leaves, cinnamon, and fenugreek seeds; cook briefly until fragrant."
    },
    {
      "step": 2,
      "text": "Add the sliced onions and cook until softened and lightly colored.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Add the beef, ginger, and crushed garlic. Sauté, stirring occasionally, until the beef is browned on the outside.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the hot curry powder, garam masala, ground coriander, ground cumin, Kashmiri chilli powder if using, chilli powder, and turmeric."
    },
    {
      "step": 5,
      "text": "Add the quartered tomatoes and cook until they begin to soften and break down.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Cover and simmer gently until the beef is tender, about 90 minutes. Confirm with a food thermometer that the beef reaches at least 145°F, then rest it for 3 minutes.",
      "timer_minutes": 90
    },
    {
      "step": 7,
      "text": "Stir in the remaining ginger and fresh coriander leaves. Serve with the reserved ginger slices and additional coriander leaves.",
      "timer_minutes": 10
    }
  ],
