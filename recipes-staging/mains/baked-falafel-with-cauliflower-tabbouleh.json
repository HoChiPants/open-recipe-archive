  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Line a baking sheet with parchment."
    },
    {
      "step": 2,
      "text": "Pulse the chickpeas, cumin, coriander, cayenne, onion, garlic, sesame seeds, baking powder, and parsley stalks until finely chopped and cohesive. Do not puree completely."
    },
    {
      "step": 3,
      "text": "Shape the mixture into small, firm patties and arrange them on the prepared sheet."
    },
    {
      "step": 4,
      "text": "Bake until browned and set, turning once halfway through.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Toss the cauliflower with the olive oil, cumin, and coriander, then roast until browned and tender.",
      "timer_minutes": 12
    },
    {
      "step": 6,
      "text": "Combine the chopped parsley leaves, mint, lemon juice, and roasted cauliflower. Serve the tabbouleh with the warm falafel."
    }
  ],
