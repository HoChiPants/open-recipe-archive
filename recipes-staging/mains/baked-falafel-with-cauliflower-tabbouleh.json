  "id": "baked-falafel-with-cauliflower-tabbouleh",
  "name": "Baked Falafel with Cauliflower Tabbouleh",
  "subtitle": "Herb-packed falafel served with lemony roasted cauliflower",
  "description": "A plant-based main combining tender baked falafel with roasted cauliflower, parsley, mint, and lemon.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
