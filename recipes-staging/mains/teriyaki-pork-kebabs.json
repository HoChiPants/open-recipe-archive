  "id": "teriyaki-pork-kebabs",
  "name": "Teriyaki Pork Kebabs",
  "subtitle": "Tender pork and colorful produce with a savory-sweet glaze",
  "description": "Marinated pork loin is threaded with mushrooms, onion, tomatoes, and pineapple, then grilled and finished with a teriyaki-style sauce.",
  "meal_type": "main",
  "cuisine": "Asian",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 25,
    "inactive_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "boneless-pork-loin",
      "item": "boneless pork loin",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into 1 inch cubes"
    },
    {
      "ingredient_id": "low-sodium-beef-broth",
      "item": "low-sodium beef broth",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.5 ounce"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "portobello-mushrooms",
      "item": "portobello mushrooms",
      "quantity": 3,
      "preparation": "cut into quarters"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "cut into 12 wedges"
    },
    {
      "ingredient_id": "cherry-tomatoes",
      "item": "cherry tomatoes",
      "quantity": 12
    },
    {
      "ingredient_id": "bite-size-chunks-fresh-pineapple",
      "item": "bite-size chunks fresh pineapple",
      "quantity": 12
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the soy sauce, olive oil, garlic, red pepper flakes, salt, and pepper with the broth, cornstarch, brown sugar, and ginger until smooth. Simmer for 5 minutes, stirring, until slightly thickened. Reserve enough sauce for serving and cool the remainder completely.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the pork cubes to the cooled sauce and turn to coat. Cover and refrigerate for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Preheat a grill to medium-high heat. Thread the pork, mushrooms, onion, tomatoes, and pineapple onto skewers, alternating the pieces."
    },
    {
      "step": 4,
      "text": "Grill the kebabs for about 15 minutes, turning regularly and brushing with the reserved sauce, until the pork reaches 145°F at the center. Rest for 3 minutes before serving.",
      "timer_minutes": 15
    }
  ],
