{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "baked-chicken-spaghetti",
  "name": "Baked Chicken Spaghetti",
  "subtitle": "Creamy chicken and cheese pasta from the oven",
  "description": "Tender spaghetti is combined with creamy soups and chicken, topped with Cheddar, and baked until bubbling and safely heated.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "spaghetti",
      "item": "spaghetti",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "chicken-chunks",
      "item": "chicken chunks",
      "quantity": 3,
      "unit": "can",
      "preparation": "12.5 fl oz, drained"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 4,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the spaghetti in boiling water for 12 minutes, then drain well.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Warm the chicken and both condensed soups together in a saucepan, stirring until the mixture reaches a gentle simmer."
    },
    {
      "step": 4,
      "text": "Add the drained spaghetti and stir until evenly coated. Transfer the mixture to a baking dish and spread it level."
    },
    {
      "step": 5,
      "text": "Cover the surface with the shredded Cheddar and bake for 30 minutes, until melted and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
