  "id": "creamy-chicken-tagliatelle",
  "name": "Creamy Chicken Tagliatelle",
  "subtitle": "Tagliatelle with chicken, bacon, mushrooms, and parmesan",
  "description": "A rich skillet pasta combining tender chicken, smoky bacon, mushrooms, cream, and parmesan.",
  "meal_type": "main",
