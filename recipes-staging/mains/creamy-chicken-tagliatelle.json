  "instructions": [
    {
      "step": 1,
      "text": "Cut the chicken, bacon, mushrooms, onion, and chicken stock ingredients as needed for cooking."
    },
    {
      "step": 2,
      "text": "Warm olive oil in a large skillet and cook the chicken and bacon until the chicken reaches 165°F in the thickest part."
    },
    {
      "step": 3,
      "text": "Add the mushrooms and onion, stirring until they begin to soften."
    },
    {
      "step": 4,
      "text": "Pour in the chicken stock and cook the chicken mixture for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Meanwhile, cook the tagliatelle according to the package directions, then drain."
    },
    {
      "step": 6,
      "text": "Stir the cream into the skillet and bring the sauce to a gentle simmer."
    },
    {
      "step": 7,
      "text": "Simmer for 5 minutes, until the sauce thickens.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Add the drained tagliatelle and toss to coat."
    },
    {
      "step": 9,
      "text": "Season with salt, pepper, and oregano, then finish with grated parmesan to taste."
    }
  ],
