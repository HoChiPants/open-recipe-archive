  "instructions": [
    {
      "step": 1,
      "text": "Boil the spaghetti in salted water until just tender, then drain. Set the raw prawns aside while the sauce is prepared."
    },
    {
      "step": 2,
      "text": "Warm the rapeseed oil in a wide pan for 5 minutes. Add the onion, chopped parsley stalks, and mussels; cook for 10 minutes, stirring as needed.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the garlic and tomatoes and cook for 3 minutes. Pour in the pale ale, add the prawns, and cook until the prawns are opaque and the mussels have opened, discarding any mussels that remain closed.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the spaghetti, parsley leaves, samphire, lemon zest and juice, and butter. Toss until coated and the samphire is warmed through."
    },
    {
      "step": 5,
      "text": "Serve immediately."
    }
  ],
