      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded, divided"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the prepared stuffing, chicken, broccoli, chicken gravy, and half of the divided Cheddar cheese."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a casserole dish and sprinkle the remaining Cheddar over the top."
    },
    {
      "step": 4,
      "text": "Bake for 25 minutes, until cooked through and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 25
    }
  ],
