  "ingredients": [
    {
      "ingredient_id": "prepared-stuffing",
      "item": "prepared stuffing",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "chicken",
      "item": "chicken",
      "quantity": 2,
      "unit": "cups",
      "preparation": "cubed cooked"
    },
    {
