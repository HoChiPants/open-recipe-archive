  "id": "chicken-and-stuffing-casserole",
  "name": "Chicken and Stuffing Casserole",
  "subtitle": "A warm, cheesy casserole with tender chicken and broccoli",
  "description": "Combine cooked chicken, broccoli, gravy, stuffing, and Cheddar, then bake until bubbling and safely heated through.",
  "meal_type": "main",
  "cuisine": "American",
