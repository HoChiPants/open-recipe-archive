  "id": "chicken-bake-with-garlic-croutons",
  "name": "Chicken Bake with Garlic Croutons",
  "subtitle": "Juicy chicken with tomatoes, mozzarella, and crisp sourdough",
  "description": "Chicken breasts bake with tomato, mozzarella, basil, and oregano, finished with crunchy garlic-seasoned bread cubes and served with salad.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
