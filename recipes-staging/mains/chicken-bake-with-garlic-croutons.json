      "ingredient_id": "green-salad-to-serve",
      "item": "green salad to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and lightly oil an ovenproof baking dish or skillet."
    },
    {
      "step": 2,
      "text": "Cut the chicken breasts as needed so they cook evenly. Heat the olive oil in the dish or skillet and cook the chicken for 3 minutes, turning once.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the passata and cherry tomatoes around the chicken. Top with the sliced mozzarella."
    },
    {
      "step": 4,
      "text": "Toss the sourdough cubes with the crushed garlic and dried oregano, then scatter them over the dish."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until the mozzarella is melted, the croutons are crisp, and the thickest chicken breast reaches 165°F on a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Scatter with the basil leaves and serve with the green salad."
    }
  ],
