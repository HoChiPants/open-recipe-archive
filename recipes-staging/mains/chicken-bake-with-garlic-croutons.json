      "item": "ball reduced-fat mozzarella drained and sliced",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "thick-slices-of-sourdough-or-bloomer",
      "item": "thick slices of sourdough or bloomer",
      "quantity": 3,
      "preparation": "cut into 2cm cubes"
    },
    {
