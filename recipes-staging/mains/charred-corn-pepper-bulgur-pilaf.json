  "id": "charred-corn-pepper-bulgur-pilaf",
  "name": "Charred Corn, Pepper & Bulgur Pilaf",
  "subtitle": "A smoky bulgur pilaf with sweet corn, peppers, lime, and coriander.",
  "description": "Char corn and cook it with peppers, spring onions, paprika, garlic, stock, and bulgur until tender. Finish with coriander and serve with lime and optional yogurt.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "rapeseed-oil",
      "item": "rapeseed oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "corn-cobs",
      "item": "corn cobs",
      "quantity": 2
    },
    {
      "ingredient_id": "red-peppers-sliced",
      "item": "red peppers sliced",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "bunch-of-spring-onions-sliced",
      "item": "bunch of spring onions sliced"
    },
    {
      "ingredient_id": "smoked-paprika-plus-extra-to-serve",
      "item": "smoked paprika plus extra to serve",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "garlic-cloves-crushed",
      "item": "garlic cloves crushed",
      "quantity": 2
    },
    {
      "ingredient_id": "vegetable-broth",
      "item": "vegetable stock",
      "quantity": 500,
      "unit": "ml"
    },
    {
      "ingredient_id": "bulgur-wheat",
      "item": "bulgur wheat",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "bunch-of-coriander",
      "item": "bunch of coriander",
      "quantity": "1/2",
      "unit": "small"
    },
    {
      "ingredient_id": "greek-yogurt-to-serve-optional",
      "item": "Greek yogurt to serve (optional)",
      "optional": true
    },
    {
      "ingredient_id": "lime-wedges-to-serve",
      "item": "lime wedges to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill or broiler to high."
    },
    {
      "step": 2,
      "text": "Heat the oil in a large ovenproof pan. Add the corn cobs and cook, turning occasionally, until charred, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Remove the cobs and cut off the kernels. Add the peppers, spring onions, paprika, and garlic to the pan; cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Return the corn kernels to the pan, add the stock, and bring to a simmer. Stir in the bulgur.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Cover and cook until the bulgur is tender and the liquid is absorbed, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Stir in the coriander. Serve with extra paprika, lime wedges, and optional Greek yogurt."
    }
  ],
