  "id": "baked-salmon",
  "name": "Baked Salmon",
  "subtitle": "Simple oven-roasted salmon for four",
  "description": "Salmon fillets are brushed with oil or butter, roasted until opaque and flaky, and served with optional herbs, lemon, and broccoli.",
