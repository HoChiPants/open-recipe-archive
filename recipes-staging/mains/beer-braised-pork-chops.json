{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "beer-braised-pork-chops",
  "name": "Beer-Braised Pork Chops",
  "subtitle": "Tender pork chops in a savory beer pan sauce",
  "description": "Flour-coated pork chops are briefly browned, then gently simmered in beer, mustard, vinegar, brown sugar, and rosemary until tender.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "boneless-pork-chops",
      "item": "boneless pork chops",
      "quantity": 4,
      "preparation": "1/2-inch thick"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "beer",
      "item": "beer",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "red-wine-vinegar",
      "item": "red wine vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "stone-ground-mustard",
      "item": "stone ground mustard",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "finely-chopped-fresh-rosemary",
      "item": "finely chopped fresh rosemary",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, salt, and pepper in a shallow dish. Dredge the pork chops in the seasoned flour, coating both sides."
    },
    {
      "step": 2,
      "text": "Heat the butter and olive oil in a large skillet over medium heat. Arrange the chops in the skillet, sprinkle in the brown sugar, and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Turn the chops and cook for 2 minutes more, then transfer them to a plate.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir together the beer, vinegar, mustard, brown sugar, and rosemary. Pour the mixture into the skillet and return the chops to the pan."
    },
    {
      "step": 5,
      "text": "Bring the sauce to a gentle simmer. Cook the chops for 12 minutes, turning once, until the thickest part reaches 145°F. Remove from the heat and let them rest for 3 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 6,
      "text": "Transfer the chops to serving plates. Simmer the sauce for about 3 minutes, until thickened, then spoon it over the pork.",
      "timer_minutes": 3
    }
  ],
