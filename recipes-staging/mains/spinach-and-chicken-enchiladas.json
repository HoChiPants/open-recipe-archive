  "id": "spinach-and-chicken-enchiladas",
  "name": "Spinach and Chicken Enchiladas",
  "subtitle": "Creamy chicken, spinach, and cheese wrapped in tortillas",
  "description": "Cooked chicken and spinach are folded into a seasoned ricotta filling, rolled in flour tortillas, covered with enchilada sauce and cheese, and baked until hot and bubbling.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
