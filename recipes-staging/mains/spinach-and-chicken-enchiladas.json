  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Melt the butter in a skillet over medium heat; add the green onions and garlic and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Stir in the diced chicken, spinach, chili powder, pepper, and salt. Cook for 5 minutes, stirring occasionally, then remove from the heat.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Combine the chicken mixture with the ricotta, sour cream, and part of the Monterey Jack and mozzarella cheeses."
    },
    {
      "step": 4,
      "text": "Warm the enchilada sauce. Spread a little sauce in a baking dish, fill each tortilla with the chicken mixture, and roll it closed."
    },
    {
      "step": 5,
      "text": "Arrange the enchiladas seam-side down in the dish. Pour the remaining sauce over them and top with the reserved cheeses."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until the cheese is melted and the center reaches 165°F on a food thermometer. Serve hot.",
      "timer_minutes": 30
    }
  ],
