  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a skillet. Cook the onion for 5 minutes, then add the crushed garlic and cook for 5 minutes more.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Briefly simmer the trimmed asparagus with some of the cold salted butter for 3 minutes. Drain, then cut the asparagus into manageable pieces; reserve the feta for the filling.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Rub the flour, grated hard cheese, and remaining cold salted butter together until crumbly. Add enough of the prepared butter mixture to form a dough, then chill until firm.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Dust the work surface and roll the dough out. Line a tart tin, trim the edges, and chill the pastry.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Preheat the oven and prepare the pastry shell for blind baking."
    },
    {
      "step": 6,
      "text": "Bake the shell for 15 minutes, then bake it for 5 minutes more to dry the base. Let it cool slightly.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Whisk the double cream, crème fraîche, yogurt, eggs, and grated hard cheese with the white pepper and smoked paprika. Fold in the dill, cooked onion and asparagus, and feta."
    },
    {
      "step": 8,
      "text": "Pour the filling into the pastry shell and bake for 40 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 9,
      "text": "Cool the quiche briefly before slicing."
    }
  ],
