  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet. Add the zucchini, onion, and garlic; cook, stirring, until tender, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the tomatoes, basil, salt, and black pepper, then warm the mixture through."
    },
    {
      "step": 4,
      "text": "Transfer the vegetable mixture to a baking dish and arrange the halibut steaks over it. Sprinkle with the feta cheese."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, or until the fish reaches 145°F and is opaque and easily flaked with a fork.",
      "timer_minutes": 15
    }
  ],
