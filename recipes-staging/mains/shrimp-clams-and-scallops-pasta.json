  "instructions": [
    {
      "step": 1,
      "text": "Heat half the olive oil in a large pot or deep skillet. Add the onion and half the garlic; stir for 5 minutes, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the tomatoes, tomato paste, wine, sugar, red pepper flakes, oregano, salt, and bay leaf. Simmer for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Bring the sauce back to a simmer and cook for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Cook the spaghetti in boiling water until tender, about 12 minutes. Drain.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Meanwhile, heat the remaining olive oil in a large skillet. Add the clams, cover, and cook for 7 minutes. Discard any clams that remain closed; transfer the opened clams to the sauce and stir.",
      "timer_minutes": 7
    },
    {
      "step": 6,
      "text": "Add the shrimp, scallops, and remaining garlic to the skillet. Stir for about 2 minutes, until the seafood is opaque and reaches a safe endpoint; transfer it to the sauce.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Add the drained spaghetti and Parmesan to the sauce, toss gently, and serve."
    }
  ],
