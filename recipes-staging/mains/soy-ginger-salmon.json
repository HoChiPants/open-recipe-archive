  "id": "soy-ginger-salmon",
  "name": "Soy Ginger Salmon",
  "subtitle": "Grilled salmon with a sweet citrus-soy glaze",
  "description": "Salmon is seasoned, marinated in a gingered soy mixture, then grilled until opaque and flaky.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10,
    "inactive_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "salmon-fillets",
      "item": "salmon fillets",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "lemon-pepper",
      "item": "lemon pepper",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "divided"
    },
    {
      "ingredient_id": "low-sodium-soy-sauce",
      "item": "low sodium soy sauce",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "1-inch-piece-fresh-ginger-root",
      "item": "(1 inch) piece fresh ginger root",
      "quantity": 1,
      "preparation": "minced"
    },
    {
      "ingredient_id": "orange-juice",
      "item": "orange juice",
      "quantity": 0.33333334326744,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Divide the brown sugar, lemon pepper, and garlic powder between seasoning the salmon and making the glaze. Rub one portion over the salmon."
    },
    {
      "step": 2,
      "text": "Combine the soy sauce, olive oil, orange juice, ginger, and remaining seasonings and brown sugar in a saucepan. Bring to a simmer, then remove from the heat."
    },
    {
      "step": 3,
      "text": "Coat the salmon with the glaze, cover, and refrigerate for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 4,
      "text": "Preheat the grill. Place the salmon on the grill and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Turn the salmon and grill for 2 minutes more.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Turn once more and grill until opaque and easily flaked, reaching 145°F in the thickest part, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 7,
      "text": "Rest the salmon for 5 minutes, then serve.",
      "timer_minutes": 5
    }
  ],
