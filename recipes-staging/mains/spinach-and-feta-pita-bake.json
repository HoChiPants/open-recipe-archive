  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Arrange the pita breads on a baking sheet and spread the sun-dried tomato pesto over them."
    },
    {
      "step": 2,
      "text": "Top the pitas with the tomatoes, spinach, mushrooms, feta, and Parmesan. Drizzle with olive oil and season with black pepper."
    },
    {
      "step": 3,
      "text": "Bake until the pitas are heated through and the toppings are lightly cooked, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Cut the baked pitas into portions and serve hot."
    }
