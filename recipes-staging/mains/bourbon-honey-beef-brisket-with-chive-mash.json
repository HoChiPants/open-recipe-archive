  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 160°F. Pat the tied brisket dry and rub it with the smoked paprika, mustard powder, onion powder, cinnamon, cloves, and 2 tablespoons of the brown sugar."
    },
    {
      "step": 2,
      "text": "Mix the remaining brown sugar with the honey, 50 ml bourbon, and vinegar to make the glaze."
    },
    {
      "step": 3,
      "text": "Heat the oil in a large ovenproof pot. Brown the brisket on all sides, then add the onions and bay leaves. Pour in enough water to partially cover the meat and bring to a simmer."
    },
    {
      "step": 4,
      "text": "Cover the pot and bake until the brisket is tender, about 7 hours. Check the thickest part with a food thermometer; the beef should reach at least 145°F, then rest for 3 minutes before carving.",
      "timer_minutes": 420
    },
    {
      "step": 5,
      "text": "Meanwhile, prepare the potatoes and carrots. Transfer the brisket to a board and arrange the potatoes and carrots in the cooking liquid or a roasting pan."
    },
    {
      "step": 6,
      "text": "Cook the vegetables until tender, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Brush the brisket with the glaze and return it to the oven with the vegetables. Cook uncovered until the glaze is glossy and the vegetables are fully tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Rest the brisket for 15 minutes. Mash the potatoes with the soured cream, butter, milk, and chives, adding extra butter to serve if desired.",
      "timer_minutes": 15
    },
    {
      "step": 9,
      "text": "Slice the brisket thickly and serve with the chive mash, carrots, onions, and remaining pan juices."
    }
  ],
