  "id": "bean-burrito-casserole",
  "name": "Bean Burrito Casserole",
  "subtitle": "A creamy baked casserole with chile, cheese, and fresh toppings",
  "description": "Bake frozen bean-and-cheese burritos under a creamy chile sauce, then finish with cheese and serve with fresh toppings.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-bean-and-cheese-burritos",
      "item": "frozen bean and cheese burritos",
      "quantity": 6
    },
    {
      "ingredient_id": "condensed-cream-of-chicken-or-cream-of-mushroom-soup",
      "item": "condensed cream of chicken or cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "green-chile-peppers",
      "item": "green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "4 ounce, diced, drained"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomato",
      "quantity": 1,
      "unit": "medium",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "avocados",
      "item": "avocados",
      "quantity": 1,
      "preparation": "peeled, pitted and sliced"
    },
    {
      "ingredient_id": "black-olives",
      "item": "black olives",
      "quantity": 1,
      "unit": "can",
      "preparation": "2.25 ounce, sliced, drained"
    },
    {
      "ingredient_id": "salsa",
      "item": "salsa",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Arrange the frozen burritos in a baking dish."
    },
    {
      "step": 3,
      "text": "Whisk together the condensed soup, sour cream, and drained green chiles. Spoon the mixture over the burritos."
    },
    {
      "step": 4,
      "text": "Top with the shredded Cheddar cheese."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until hot throughout and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Serve with the chopped tomato, sliced avocado, drained black olives, and salsa."
    }
  ],
