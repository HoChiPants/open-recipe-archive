      "item": "beef roasting joint",
      "quantity": 1.2,
      "unit": "kg"
    },
    {
      "ingredient_id": "neutral-flavoured-oil",
      "item": "neutral-flavoured oil",
      "quantity": "1-2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 1,
      "unit": "tsp"
    },
    {
