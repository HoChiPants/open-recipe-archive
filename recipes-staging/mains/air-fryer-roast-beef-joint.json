  "id": "air-fryer-roast-beef-joint",
  "name": "Air Fryer Roast Beef Joint",
  "subtitle": "Seasoned roast beef with a simple air-fryer method",
  "description": "A compact roast beef joint seasoned with thyme, onion, and mustard, then cooked in an air fryer and rested before slicing.",
  "meal_type": "main",
  "yield": {
    "quantity": 8,
    "unit": "servings"
