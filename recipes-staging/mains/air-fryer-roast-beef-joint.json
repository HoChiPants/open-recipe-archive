    {
      "ingredient_id": "mustard-powder",
      "item": "mustard powder",
      "quantity": 1,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Let the beef roasting joint stand at room temperature for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Preheat the air fryer according to the appliance instructions."
    },
    {
      "step": 3,
      "text": "Rub the joint with the oil, dried thyme, onion granules, and mustard powder."
    },
    {
      "step": 4,
      "text": "Cook in the air fryer for 10 minutes, then continue cooking for 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Check the center with a food thermometer; for a whole beef joint, cook to 145°F, then rest for at least 3 minutes. Rest the joint for 30 minutes before slicing.",
      "timer_minutes": 30
    }
  ],
