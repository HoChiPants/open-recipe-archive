  "id": "chicken-alfredo-ravioli-bake",
  "name": "Chicken Alfredo Ravioli Bake",
  "subtitle": "Tender chicken and cheese ravioli in a creamy baked sauce",
  "description": "Cheese ravioli and seasoned chicken are combined with Alfredo sauce, topped with mozzarella, and baked until bubbling and melted.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-cheese-ravioli",
      "item": "frozen cheese ravioli",
      "quantity": 1,
      "unit": "package",
      "preparation": "25 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 3,
      "preparation": "boneless chicken breasts, cut into 1-inch pieces"
    },
    {
      "ingredient_id": "italian-seasoning",
      "item": "Italian seasoning",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "16-ounce-jar-prepared-alfredo-sauce",
      "item": "(16 ounce) jar prepared Alfredo sauce",
      "quantity": 1
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Bring a large pot of water seasoned with salt and pepper to a simmer. Cook the frozen ravioli for 8 minutes, then drain.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Melt the butter in a large skillet over medium heat. Add the chicken and Italian seasoning, stirring until the chicken is cooked through and reaches 165°F, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Stir the Alfredo sauce into the skillet, then fold in the drained ravioli."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to a baking dish and cover with the mozzarella."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until the cheese is melted and the casserole is hot throughout.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Sprinkle with the Parmesan cheese and serve."
    }
  ],
