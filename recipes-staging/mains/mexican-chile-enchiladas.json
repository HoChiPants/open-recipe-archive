  "instructions": [
    {
      "step": 1,
      "text": "Place the dried chile de arbol peppers and water in a saucepan. Simmer for 15 minutes, adding enough water to keep the chiles covered.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Blend the softened chiles and their cooking water with the garlic and salt until smooth. Return the sauce to the saucepan and warm it until slightly thickened."
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil in a skillet over medium heat. Fry the corn tortillas briefly on both sides until pliable, then drain."
    },
    {
      "step": 4,
      "text": "Dip each tortilla in the chile sauce. Add queso fresco to the center, roll tightly, and arrange the enchiladas seam-side down."
    },
    {
      "step": 5,
      "text": "Top with the remaining queso fresco, sour cream, shredded lettuce, sliced tomatoes, and chopped green onions. Serve warm."
    }
  ],
