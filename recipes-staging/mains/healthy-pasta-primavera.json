  "instructions": [
    {
      "step": 1,
      "text": "Cook the pasta in simmering salted water for 11 minutes, or until tender; drain.",
      "timer_minutes": 11
    },
    {
      "step": 2,
      "text": "While the pasta cooks, preheat a large skillet over medium heat and add the olive oil and onion. Cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the asparagus, mushrooms, and squash. Sauté for 5 minutes, until the vegetables are tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the tomatoes, carrot, garlic, oregano, pepper, salt, and red pepper flakes. Cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Combine the drained pasta and vegetables. Stir in the Parmesan, then serve with lemon wedges."
    }
