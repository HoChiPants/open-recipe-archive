    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-new-mexico-chile-powder",
      "item": "ground New Mexico chile powder",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fresh-pork-butt-roast",
      "item": "fresh pork butt roast",
      "quantity": 7,
      "unit": "pounds"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Let the pork roast stand before cooking as needed for preparation.",
      "timer_minutes": 240
    },
    {
      "step": 2,
      "text": "Preheat a smoker to 225°F."
    },
    {
      "step": 3,
      "text": "Combine the brown sugar and chile powder. Coat the pork roast evenly with the mixture."
    },
    {
      "step": 4,
      "text": "Place the roast in the smoker and cook at 225°F until a thermometer inserted into the thickest part registers at least 145°F.",
      "timer_minutes": 360
    },
    {
      "step": 5,
      "text": "Remove the pork from the smoker and rest for at least 3 minutes before slicing or serving.",
      "timer_minutes": 3
    }
  ],
