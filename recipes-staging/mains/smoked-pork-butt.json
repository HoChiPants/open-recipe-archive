  "id": "smoked-pork-butt",
  "name": "Smoked Pork Butt",
  "subtitle": "Slow-smoked pork with a sweet chile crust",
  "description": "A simple brown sugar and New Mexico chile rub flavors pork butt during a low-temperature smoke.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
