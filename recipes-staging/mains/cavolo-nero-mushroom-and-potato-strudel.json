  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F and line a baking sheet with parchment."
    },
    {
      "step": 2,
      "text": "Blanch the cavolo nero in boiling water for 7 minutes. Drain, cool until manageable, then cut away any tough stems and chop the leaves.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Melt 30 g of the butter in a frying pan. Add the onion and cook for 10 minutes until soft.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Heat a little olive oil in a separate pan. Cook the mushrooms for 15 minutes until their moisture has evaporated and they are browned.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Boil the potatoes until tender, then drain and cut them into small pieces."
    },
    {
      "step": 6,
      "text": "Combine the cavolo nero, mushrooms, potatoes, crème fraîche, grated parmesan, fontina, and nutmeg. Stir until evenly mixed."
    },
    {
      "step": 7,
      "text": "Melt the remaining butter and keep it ready for brushing. Lay one filo sheet on the work surface, brush with butter, and cover with another sheet. Repeat until the sheets are stacked."
    },
    {
      "step": 8,
      "text": "Place the filling along one long edge, leaving a border. Fold in the ends and roll the pastry around the filling to form a strudel. Transfer it seam-side down to the baking sheet."
    },
    {
      "step": 9,
      "text": "Brush the top with the remaining butter and scatter with poppy seeds. Bake until golden brown and hot throughout.",
      "timer_minutes": 25
    },
    {
      "step": 10,
      "text": "Rest briefly, then slice and serve."
    }
  ],
