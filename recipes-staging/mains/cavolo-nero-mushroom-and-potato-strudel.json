  "id": "cavolo-nero-mushroom-and-potato-strudel",
  "name": "Cavolo Nero, Mushroom and Potato Strudel",
  "subtitle": "Crisp filo wrapped around a creamy vegetable filling",
  "description": "A savory strudel layered with cavolo nero, mushrooms, potatoes, and melting cheese beneath crisp filo pastry.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
