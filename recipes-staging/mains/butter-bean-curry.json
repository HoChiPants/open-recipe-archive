  "instructions": [
    {
      "step": 1,
      "text": "Heat the rapeseed oil in a large saucepan over medium heat. Add the finely chopped onions and cook until softened, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Stir in the ginger, garlic, sliced red chilli, cumin seeds, and curry powder. Cook briefly until fragrant."
    },
    {
      "step": 3,
      "text": "Add the butter beans, bouillon powder, chopped tomatoes, and aubergine. Stir well, bring to a simmer, and cook until the aubergine is tender and the curry is thickened.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Stir in the chopped coriander."
    },
    {
      "step": 5,
      "text": "Combine the bananas, lime juice, cucumber, red onion, sliced red chilli, and some of the chopped coriander to make the fresh relish."
    },
    {
      "step": 6,
      "text": "Heat the cooked wholegrain rice according to its package directions. Serve with the curry and relish."
    }
  ],
