  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and lightly prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Spread the cooked rice in the baking dish."
    },
    {
      "step": 3,
      "text": "Add the chicken, chili powder, and cumin, distributing them evenly over the rice."
    },
    {
      "step": 4,
      "text": "Combine the tomatoes, black beans, corn, red bell pepper, poblano pepper, garlic, and jalapeno slices, then layer the mixture over the chicken and rice."
    },
    {
      "step": 5,
      "text": "Top with the shredded cheese."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, until the center is hot and the chicken reaches 165°F on a food thermometer.",
      "timer_minutes": 45
    }
  ],
