  "instructions": [
    {
      "step": 1,
      "text": "Season the trimmed roast with the salt and black pepper. Combine the diced chile, taco seasoning, chili powder, cayenne, and garlic powder."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large oven-safe pot. Add the roast and cook for 3 minutes to brown the exterior, then transfer it to a plate.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the onion, hot sauce, and prepared chile mixture to the pot. Return the roast and turn it to coat with the seasoning mixture."
    },
    {
      "step": 4,
      "text": "Roast until the beef is tender, about 490 minutes. Confirm with a thermometer that the center reaches at least 145°F, then rest the roast for 3 minutes before serving.",
      "timer_minutes": 490
    }
  ],
