  "id": "mexican-style-pot-roast",
  "name": "Mexican-Style Pot Roast",
  "subtitle": "Slow-roasted beef with chiles, onion, and savory spices",
  "description": "A tender beef chuck roast seasoned with chiles, hot sauce, and taco spices for a hearty Mexican-inspired main dish.",
