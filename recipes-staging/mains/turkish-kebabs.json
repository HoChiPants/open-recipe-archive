  "instructions": [
    {
      "step": 1,
      "text": "Transfer the chopped onions to a bowl and toss with 2 tablespoons of the lemon juice. Add the garlic cloves, 0.5 cup olive oil, dried oregano, 1 teaspoon ground black pepper, turmeric, curry powder, and 1 teaspoon salt; stir to combine."
    },
    {
      "step": 2,
      "text": "Add the thinly sliced beef and coat thoroughly. Cover and refrigerate for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Stir together the sour cream, 2 tablespoons olive oil, 1 tablespoon lemon juice, 0.5 teaspoon salt, 0.5 teaspoon ground black pepper, fresh dill, and crushed garlic. Chill until serving."
    },
    {
      "step": 4,
      "text": "Preheat a grill or grill pan. Remove the beef from the marinade and discard the marinade. Thread the slices onto skewers if desired."
    },
    {
      "step": 5,
      "text": "Grill the kebabs, turning as needed, until browned and the thickest pieces reach 145°F on a food thermometer. Rest for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Warm the pita rounds and serve with the kebabs, onion mixture, and dill-garlic cream."
    }
  ],
