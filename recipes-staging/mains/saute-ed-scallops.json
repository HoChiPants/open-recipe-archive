  "id": "saute-ed-scallops",
  "name": "Sautéed Scallops",
  "subtitle": "Golden scallops with garlic and rosemary butter",
  "description": "Quickly sauté scallops in butter infused with garlic and fresh rosemary until golden, firm, and opaque.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "sprigs-fresh-rosemary",
      "item": "sprigs fresh rosemary",
      "quantity": 2
    },
    {
      "ingredient_id": "scallops",
      "item": "scallops",
      "quantity": 1,
      "unit": "pound"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the butter in a skillet over medium heat until melted."
    },
    {
      "step": 2,
      "text": "Add the crushed garlic and rosemary sprigs; cook briefly to infuse the butter."
    },
    {
      "step": 3,
      "text": "Add the scallops and sauté until golden brown on the first side.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Turn the scallops and cook until firm and opaque throughout.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Remove the garlic and rosemary sprigs, then serve the scallops with the infused butter."
    }
  ],
