  "ingredients": [
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "3-pound-boneless-pork-loin-roast",
      "item": "(3 pound) boneless pork loin roast",
      "quantity": 1
    },
    {
      "ingredient_id": "green-salsa",
      "item": "green salsa",
      "quantity": 11,
      "unit": "ounces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a skillet over medium-high heat and add the canola oil."
    },
    {
      "step": 2,
      "text": "Add the pork loin roast and brown it for 3 minutes, turning as needed.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Transfer the pork to a slow cooker and pour in the green salsa."
    },
    {
      "step": 4,
      "text": "Cook until the pork reaches 145°F in the thickest part, then rest it for 3 minutes before shredding.",
      "timer_minutes": 300
    },
    {
      "step": 5,
      "text": "Shred the pork and combine it with the salsa. Let it stand for 180 minutes before serving.",
      "timer_minutes": 180
    }
