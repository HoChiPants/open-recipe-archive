  "id": "salsa-verde-pork",
  "name": "Salsa Verde Pork",
  "subtitle": "Tender shredded pork with bright green salsa",
  "description": "Brown a boneless pork loin, slow-cook it with green salsa, then shred and rest it before serving.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
