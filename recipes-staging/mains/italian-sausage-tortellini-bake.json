  "id": "italian-sausage-tortellini-bake",
  "name": "Italian Sausage Tortellini Bake",
  "subtitle": "Cheesy baked tortellini with sausage and marinara",
  "description": "A hearty pasta casserole layered with savory sausage, vegetables, tomato sauce, tender tortellini, and melted mozzarella.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 80
  },
  "ingredients": [
    {
      "ingredient_id": "bulk-italian-sausage",
      "item": "bulk Italian sausage",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "24-ounce-jar-marinara-sauce",
      "item": "(24 ounce) jar marinara sauce",
      "quantity": 1
    },
    {
      "ingredient_id": "italian-style-diced-tomatoes",
      "item": "Italian-style diced tomatoes",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "frozen-cheese-filled-tortellini",
      "item": "frozen cheese-filled tortellini",
      "quantity": 1,
      "unit": "package",
      "preparation": "9 ounce"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the sausage, onion, and bell pepper in a large skillet, stirring, for 10 minutes, until the sausage is browned and reaches 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Drain the skillet. Stir in the marinara sauce, diced tomatoes, and garlic powder. Simmer for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "Cook the frozen tortellini in boiling water for 7 minutes, then drain.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Fold the tortellini into the simmering sauce and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Transfer the mixture to a baking dish and top with the mozzarella."
    },
    {
      "step": 7,
      "text": "Bake for 30 minutes, until golden brown and the casserole center reaches 165°F.",
      "timer_minutes": 30
    }
  ],
