  "instructions": [
    {
      "step": 1,
      "text": "Cook the fettuccine according to the package directions; drain and keep warm."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat. Add the garlic, jalapeno peppers, onion, and bell peppers; sauté until the vegetables begin to soften."
    },
    {
      "step": 3,
      "text": "Add the cubed chicken and cook, stirring occasionally, until the thickest pieces reach 165°F on a food thermometer."
    },
    {
      "step": 4,
      "text": "Stir in the chicken stock, tequila, lime juice, and soy sauce. Simmer briefly, then whisk in the heavy whipping cream."
    },
    {
      "step": 5,
      "text": "Continue simmering until the sauce thickens slightly and the chicken is cooked through. Toss with the warm fettuccine and garnish with the cilantro before serving."
    }
  ],
