  "id": "butternut-squash-korma-with-mini-naans",
  "name": "Butternut Squash Korma with Mini Naans",
  "subtitle": "A mild, creamy squash curry for two",
  "description": "Roasted butternut squash is folded into a gently spiced almond korma sauce and finished with cream, toasted almonds, rice, and mini naans.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
