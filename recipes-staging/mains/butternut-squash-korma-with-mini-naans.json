  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Toss the cubed squash with the rapeseed oil, place it in a roasting dish, and roast for 30 minutes until tender.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Meanwhile, cook the chopped onion, crushed garlic, and grated ginger until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the korma paste and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the ground almonds and vegetable stock, then whisk in the roasted squash and single cream. Simmer gently for 10 minutes until the sauce is smooth and the squash is heated through.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Serve with the toasted flaked almonds, cooked rice, and mini naans."
    }
  ],
