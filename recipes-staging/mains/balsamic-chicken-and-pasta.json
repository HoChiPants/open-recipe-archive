  "id": "balsamic-chicken-and-pasta",
  "name": "Balsamic Chicken and Pasta",
  "subtitle": "Marinated chicken with basil, tomatoes, and penne",
  "description": "Chicken baked in a basil-balsamic marinade is sliced and tossed with penne, tomatoes, and fresh basil for a simple Italian-style dinner.",
  "meal_type": "main",
  "cuisine": "Italian",
