  "instructions": [
    {
      "step": 1,
      "text": "Combine the garlic, half of the basil, olive oil, and balsamic vinegar. Season the chicken with the salt and pepper, coat it with the marinade, and refrigerate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Heat the oven to 300°F."
    },
    {
      "step": 3,
      "text": "Arrange the marinated chicken in a baking dish and bake until cooked through and the thickest part reaches 165°F on a food thermometer, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Let the chicken rest briefly, then slice it."
    },
    {
      "step": 5,
      "text": "Meanwhile, bring a pot of salted water to a boil. Add the penne and cook until tender, about 11 minutes; drain.",
      "timer_minutes": 11
    },
    {
      "step": 6,
      "text": "Chop the remaining basil. Toss the pasta with the tomatoes, remaining olive oil and balsamic vinegar, salt, and pepper. Add the basil and sliced chicken, then combine gently."
    }
  ],
