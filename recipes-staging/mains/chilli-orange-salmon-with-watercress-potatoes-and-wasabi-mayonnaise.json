  "id": "chilli-orange-salmon-with-watercress-potatoes-and-wasabi-mayonnaise",
  "name": "Chilli-Orange Salmon with Watercress Potatoes and Wasabi Mayonnaise",
  "subtitle": "Roasted salmon with citrus, fennel, and peppery greens",
  "description": "Salmon roasted with orange, chilli, garlic, and fennel, served with tender new potatoes, watercress, and wasabi mayonnaise.",
  "meal_type": "main",
