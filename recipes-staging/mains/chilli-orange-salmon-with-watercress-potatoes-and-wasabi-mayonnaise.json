  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Whisk together the sesame oil and crushed garlic with the orange juice, zest, and chopped chillies."
    },
    {
      "step": 2,
      "text": "Arrange the sliced fennel in a roasting dish. Place the salmon skin-side up over the fennel, add the orange slices, and coat with the citrus mixture."
    },
    {
      "step": 3,
      "text": "Roast for about 20 minutes, until the salmon reaches 145°F internally or is opaque and flakes easily.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Meanwhile, simmer the potatoes in water for about 15 minutes, until tender. Drain, then toss with the chopped watercress and olive oil.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Whisk the wasabi paste into the mayonnaise."
    },
    {
      "step": 6,
      "text": "Serve the salmon with the watercress potatoes and wasabi mayonnaise."
    }
  ],
