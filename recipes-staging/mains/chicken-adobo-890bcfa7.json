  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large heavy pot or deep skillet. Brown the chicken pieces on all sides, working in batches if needed. Transfer them to a plate."
    },
    {
      "step": 2,
      "text": "Add the garlic, onion, and sugar to the pot. Cook, stirring, until the aromatics soften, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pour in the vinegar and let it bubble for 5 minutes. Stir in the soy sauce, bay leaves, and peppercorns.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Return the chicken and any juices to the pot. Cover and simmer gently until the chicken is tender and reaches 165°F at the thickest part, about 22 minutes.",
      "timer_minutes": 22
    },
    {
      "step": 5,
      "text": "Remove the bay leaves and peppercorns as desired. Rest the chicken briefly, scatter with spring onions, and serve with steamed jasmine rice.",
      "timer_minutes": 3
    }
  ],
