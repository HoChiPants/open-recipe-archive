  "name": "Chicken Adobo",
  "subtitle": "Tender chicken simmered in a savory vinegar-soy sauce",
  "description": "Browned chicken cooks with garlic, onion, vinegar, soy sauce, bay leaves, and peppercorns, then is finished with spring onions and served over jasmine rice.",
  "meal_type": "main",
  "cuisine": "Asian",
