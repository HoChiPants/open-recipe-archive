  "id": "shrimp-pizza",
  "name": "Shrimp Pizza",
  "subtitle": "Spinach-Parmesan pizza with sautéed vegetables and shrimp",
  "description": "A creamy spinach-and-cheese pizza topped with tender peppers, onions, and shrimp.",
  "meal_type": "main",
  "cuisine": "American",
