  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Whisk the softened cream cheese, Parmesan, mayonnaise, garlic, and drained spinach until evenly combined. Set aside."
    },
    {
      "step": 3,
      "text": "Prepare the pizza dough on a baking sheet, brush it with 2 tablespoons olive oil, and sprinkle with 1 teaspoon Italian seasoning. Bake until golden brown, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "While the crust bakes, heat the remaining 2 tablespoons olive oil in a skillet. Cook the bell pepper and onion for about 5 minutes, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the remaining Italian seasoning and drained shrimp. Cook until the shrimp are opaque and heated through."
    },
    {
      "step": 6,
      "text": "Spread the spinach mixture over the baked dough and add the shrimp and vegetables. Cut into pieces and serve."
    }
  ],
