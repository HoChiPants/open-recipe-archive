  "id": "red-wine-pork-tenderloin",
  "name": "Red Wine Pork Tenderloin",
  "subtitle": "Tender roasted pork with a savory wine gravy",
  "description": "Pork tenderloin is seasoned, roasted with vegetables and red wine, then served with a thickened pan gravy.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "pork-tenderloin",
      "item": "pork tenderloin",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "stalk-celery",
      "item": "stalk celery",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "red-wine",
      "item": "red wine",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "dry-brown-gravy-mix",
      "item": "dry brown gravy mix",
      "quantity": 1,
      "unit": "packet",
      "preparation": ".75 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Season the pork with the salt, pepper, and garlic powder."
    },
    {
      "step": 2,
      "text": "Place the pork in a baking dish with the onion, celery, and red wine."
    },
    {
      "step": 3,
      "text": "Bake for 45 minutes, or until the thickest part reaches 145°F. Transfer the pork to a cutting board and let it rest for 3 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "Combine the red wine and dry brown gravy mix as directed by the mixture, and cook until thickened."
    },
    {
      "step": 5,
      "text": "Cut the rested pork into slices and serve with the gravy."
    }
  ],
