{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "creamy-chicken-with-angel-hair-pasta",
  "name": "Creamy Chicken with Angel Hair Pasta",
  "subtitle": "Tender baked chicken with a savory cream sauce over delicate pasta.",
  "description": "Chicken breasts are baked beneath a creamy mushroom-wine sauce and served with angel hair pasta.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 6,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "dry-italian-style-salad-dressing-mix",
      "item": "dry Italian-style salad dressing mix",
      "quantity": 1,
      "unit": "package",
      "preparation": ".7 ounce"
    },
    {
      "ingredient_id": "condensed-golden-mushroom-soup",
      "item": "condensed golden mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cream-cheese-with-chives",
      "item": "cream cheese with chives",
      "quantity": 4,
      "unit": "ounces"
    },
    {
      "ingredient_id": "angel-hair-pasta",
      "item": "angel hair pasta",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Melt the butter in a baking dish, arrange the chicken in the dish, and set aside."
    },
    {
      "step": 2,
      "text": "In a saucepan, combine the dressing mix, soup, and wine. Bring the mixture to a simmer, then cook for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Whisk in the cream cheese and stir until the sauce is smooth and heated through."
    },
    {
      "step": 4,
      "text": "Pour the sauce over the chicken and bake for 60 minutes, or until the thickest piece reaches 165°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "While the chicken finishes, cook the angel hair pasta in boiling water for about 5 minutes, until tender. Drain well.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Serve the baked chicken and sauce over the drained pasta."
    }
  ],
