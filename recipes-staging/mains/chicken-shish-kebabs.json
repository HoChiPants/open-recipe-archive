  "id": "chicken-shish-kebabs",
  "name": "Chicken Shish Kebabs",
  "subtitle": "Yogurt-marinated chicken with colorful peppers",
  "description": "Tender chicken and peppers are coated in a garlicky yogurt marinade, cooked until done, and served with warm flatbreads and fresh garnishes.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
