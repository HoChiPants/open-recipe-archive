  "instructions": [
    {
      "step": 1,
      "text": "Mix the garlic, yogurt, paprika, and ketchup in a bowl. Add the chicken and stir until evenly coated; chill while preparing the remaining ingredients.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Prepare the peppers and arrange the chicken and peppers for cooking. Preheat a grill or grill pan."
    },
    {
      "step": 3,
      "text": "Cook the chicken and peppers, turning as needed, until the chicken is cooked through and reaches 165°F in the thickest pieces.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Serve with warmed flatbreads chopped and tomato and lemon wedges, with natural or Greek yogurt alongside."
    }
