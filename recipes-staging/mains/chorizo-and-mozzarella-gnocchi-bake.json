  "id": "chorizo-and-mozzarella-gnocchi-bake",
  "name": "Chorizo and Mozzarella Gnocchi Bake",
  "subtitle": "A saucy tomato bake with crisp-edged gnocchi and melted mozzarella",
  "description": "A hearty tomato-based gnocchi bake with sautéed onion, garlic, diced chorizo, basil, and mozzarella, served with green salad.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
