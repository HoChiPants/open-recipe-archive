      "item": "green salad to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large ovenproof skillet or casserole. Sauté the onion and garlic for 10 minutes, until softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the diced chorizo and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the chopped tomatoes and caster sugar, then add the gnocchi. Simmer for 8 minutes, stirring occasionally, until the gnocchi is nearly tender.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Stir in half the mozzarella and the torn basil. Top with the remaining mozzarella."
    },
    {
      "step": 6,
      "text": "Bake for about 2 minutes, or until the mozzarella is melted and the center is bubbling.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Serve hot with the green salad."
    }
  ],
