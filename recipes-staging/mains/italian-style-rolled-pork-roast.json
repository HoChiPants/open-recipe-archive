  "id": "italian-style-rolled-pork-roast",
  "name": "Italian-Style Rolled Pork Roast",
  "subtitle": "Herb-seasoned pork shoulder roasted until tender and sliceable",
  "description": "A butterflied pork shoulder is seasoned with garlic and fresh herbs, rolled, browned, and roasted with red wine for a savory Italian-inspired main dish.",
  "meal_type": "main",
  "cuisine": "Italian",
