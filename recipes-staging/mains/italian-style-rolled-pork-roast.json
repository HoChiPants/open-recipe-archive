  "instructions": [
    {
      "step": 1,
      "text": "Combine the olive oil, garlic, rosemary, and dill. Season the butterflied pork with the salt and pepper, then spread the herb mixture over the meat."
    },
    {
      "step": 2,
      "text": "Roll the pork tightly with the skin on the outside and secure it with kitchen twine. Let it rest for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 3,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 4,
      "text": "Place the roast in a roasting pan, pour in the red wine, and brush the skin with the browning sauce."
    },
    {
      "step": 5,
      "text": "Roast until the thickest part reaches 145°F on a food thermometer. Rest for at least 3 minutes for safety, then continue resting for 30 minutes before slicing.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Remove the twine, slice the roast, and let the slices stand for 15 minutes before serving.",
      "timer_minutes": 15
    }
  ],
