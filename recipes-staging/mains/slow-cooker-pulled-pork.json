  "instructions": [
    {
      "step": 1,
      "text": "Whisk the beer, mustard, honey, Worcestershire sauce, garlic, cayenne, and salt together. Place the pork in a container, pour the mixture over it, cover, and chill for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Transfer the pork and marinade to a slow cooker. Cover and cook on low for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Add the water and chopped onion. Continue cooking until the pork is very tender and reaches at least 145°F internally, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Rest the pork for 3 minutes, then shred it. Return the shredded pork and onion to the cooking liquid and toss to coat."
    }
  ],
