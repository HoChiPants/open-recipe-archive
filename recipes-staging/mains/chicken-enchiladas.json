  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Melt the butter in a large skillet over medium heat. Add the chopped onion and cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the chicken, water, green onions, green chiles, and taco seasoning mix. Simmer until the chicken reaches 165°F in the thickest pieces, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Transfer the chicken to a bowl, let it cool briefly, then shred or chop it. Reserve the cooking mixture."
    },
    {
      "step": 4,
      "text": "Stir together the sour cream, condensed soup, chili powder, lime juice, onion powder, garlic powder, and enchilada sauce until smooth. Add the reserved cooking mixture and combine."
    },
    {
      "step": 5,
      "text": "Spread a little sauce in a baking dish. Fill the tortillas with the chicken mixture and some Cheddar cheese, roll them up, and arrange them seam-side down."
    },
    {
      "step": 6,
      "text": "Pour the remaining sauce over the tortillas. Top with the remaining Cheddar cheese, reserved green onions, and black olives."
    },
    {
      "step": 7,
      "text": "Bake until the cheese is melted and the filling is hot, about 25 minutes.",
      "timer_minutes": 25
    }
  ],
