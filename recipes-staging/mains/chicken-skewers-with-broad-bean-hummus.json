  "instructions": [
    {
      "step": 1,
      "text": "Mix the oil, oregano, smoked paprika, 2 teaspoons lemon juice, grated garlic, and chicken. Toss until coated, then thread the chicken onto skewers."
    },
    {
      "step": 2,
      "text": "Combine the chopped red onions with 1 tablespoon lemon juice and set aside."
    },
    {
      "step": 3,
      "text": "Simmer the broad beans in water until tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Drain and rest the beans briefly, then blend or mash them with the garlic cloves, 2 tablespoons lemon juice, tahini, ground coriander, and cumin until smooth."
    },
    {
      "step": 5,
      "text": "Heat a grill, barbecue, or grill pan for 5 minutes. Cook the chicken skewers, turning regularly, until browned and the thickest pieces reach 165°F.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Toss the tomatoes and cucumber with the lemony onions. Serve the chicken with the broad bean hummus and salad."
    }
  ],
