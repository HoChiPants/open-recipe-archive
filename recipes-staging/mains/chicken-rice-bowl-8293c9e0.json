  "instructions": [
    {
      "step": 1,
      "text": "Divide the cooked rice between two bowls. If the chicken or rice is being reheated, heat until steaming hot; chicken should reach 165°F in the thickest piece.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Combine the lime juice, honey, chopped herbs, garlic granules, and olive oil."
    },
    {
      "step": 3,
      "text": "Toss the sweetcorn, chopped pepper, avocado, halved tomatoes, and giardiniera together."
    },
    {
      "step": 4,
      "text": "Arrange the sliced chicken and vegetable mixture over the rice. Spoon over the lime dressing and serve."
