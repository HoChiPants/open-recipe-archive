  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, mushrooms, carrot, yellow onion, most of the green onions, soy sauce, garlic, sriracha, sesame oil, vinegar, white pepper, and black pepper in a pot."
    },
    {
      "step": 2,
      "text": "Bring the seasoned mixture to a simmer and cook until the broth reaches 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the ramen noodles and cook for 5 minutes, or until tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Ladle into bowls and top with the remaining green onions."
    }
