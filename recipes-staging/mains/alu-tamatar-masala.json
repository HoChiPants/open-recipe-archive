  "id": "alu-tamatar-masala",
  "name": "Alu Tamatar Masala",
  "subtitle": "Tender potatoes in a spiced tomato sauce",
  "description": "A simple Indian-style potato curry finished with fresh herbs and green chili.",
  "meal_type": "main",
  "cuisine": "Indian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
