  "instructions": [
    {
      "step": 1,
      "text": "Cook the potatoes until tender, about 15 minutes, then drain.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Warm the oil in a wide pan. Add the mustard seeds and let them sizzle briefly."
    },
    {
      "step": 3,
      "text": "Add the curry leaves, half of the sliced chili, garlic, and ginger. Stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the tomatoes, garam masala, chili powder, and turmeric. Cook, stirring occasionally, until the tomatoes soften into a thick sauce, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Fold in the potatoes and remaining chili. Cover and cook until the potatoes are fully tender and coated, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Rest briefly, then scatter over the coriander leaves and remaining curry leaves before serving."
    }
  ],
