  "instructions": [
    {
      "step": 1,
      "text": "Heat the frying oil and vegetable oil to 350°F in separate pans or in sequence. Fry the plantain halves for 2 minutes, then drain.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Flatten each plantain half, return it to the 350°F oil, and fry for about 3 minutes until golden brown. Drain well.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Heat the remaining 2 tablespoons vegetable oil in a skillet. Add the garlic, steak, onion, cumin, and oregano; cook until the steak reaches 145°F, then rest for 3 minutes."
    },
    {
      "step": 4,
      "text": "Place one fried plantain half on a plate and layer with mayonnaise, half the cheese, tomato, steak mixture, remaining cheese, tomato, and lettuce."
    },
    {
      "step": 5,
      "text": "Top with the second plantain half, press gently, and cut to serve."
    }
  ],
