  "id": "jibarito",
  "name": "Jibarito",
  "subtitle": "Crisp plantain sandwich with seasoned steak",
  "description": "Fried green plantain halves serve as the bread for a warm steak sandwich layered with cheese, tomato, lettuce, and mayonnaise.",
  "meal_type": "main",
