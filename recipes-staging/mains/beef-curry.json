  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil and butter in a heavy pot over medium heat. Add the onion and cook for about 15 minutes, stirring occasionally, until golden brown.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Stir in the garlic, ginger, chilli powder, turmeric, ground coriander, cardamom, and half of the chopped coriander. Cook briefly until fragrant."
    },
    {
      "step": 3,
      "text": "Add the diced beef and stir to coat. Pour in the tomatoes, beef stock, and sugar, then bring to a gentle simmer.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Cover and simmer gently for about 2 hours, stirring occasionally, until the beef is tender. Confirm the beef reaches at least 145°F, then rest it for 3 minutes before serving.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Mix in the garam masala and optional cream. Taste and adjust the consistency with a brief uncovered simmer if needed."
    },
    {
      "step": 6,
      "text": "Serve with the remaining chopped coriander and naan bread or rice."
    }
  ],
