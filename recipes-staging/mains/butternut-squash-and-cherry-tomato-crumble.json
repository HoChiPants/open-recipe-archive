  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large ovenproof skillet or saucepan. Add the onion and cook for 12 minutes until softened.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Add the garlic and squash, then stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Stir in the cherry tomatoes, mascarpone, and spinach. Cook for 10 minutes, until the spinach wilts and the mixture is hot.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Rub the cold butter into the flour until coarse crumbs form. Mix in the grated parmesan, cheddar, walnuts, and thyme leaves."
    },
    {
      "step": 6,
      "text": "Spread the squash mixture evenly in a baking dish, then scatter the crumble topping over it."
    },
    {
      "step": 7,
      "text": "Bake for 40 minutes, until the squash is tender and the topping is golden.",
      "timer_minutes": 40
    }
  ],
