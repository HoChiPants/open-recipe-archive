    },
    {
      "ingredient_id": "pork-flavored-seasoning-coating-mix-e-g",
      "item": "pork flavored seasoning coating mix (e.g.",
      "quantity": 1,
      "unit": "package",
      "preparation": "5.5 ounce, SHAKE-N-BAKE)"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and place the bacon in a suitable baking dish or pan."
    },
    {
      "step": 2,
      "text": "Combine the pork-flavored seasoning coating mix with the sliced calves' liver, turning the slices until evenly coated."
    },
    {
      "step": 3,
      "text": "Arrange the coated liver with the bacon and place the pan in the preheated oven."
    },
    {
      "step": 4,
      "text": "Cook until the liver reaches 145°F in the center, then let it rest for 3 minutes. Cook the bacon for the final 2 minutes as needed for crispness.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
