  "id": "slow-cooker-chicken-enchilada-meat",
  "name": "Slow Cooker Chicken Enchilada Meat",
  "subtitle": "Tender shredded chicken in a chile-spiced tomato sauce",
  "description": "Chicken breasts cook slowly in a blended tomato, chile, and cumin sauce until tender enough to shred.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 480
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.5 ounce, diced"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "chili-powder",
      "item": "chili powder",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove"
    },
    {
      "ingredient_id": "oregano",
      "item": "oregano",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken broth, tomatoes, flour, chili powder, cumin, garlic, oregano, salt, and cayenne in a blender. Blend until smooth."
    },
    {
      "step": 2,
      "text": "Place the chicken in a slow cooker and pour the blended sauce over it."
    },
    {
      "step": 3,
      "text": "Cover and cook on low for 8 hours, or until the chicken reaches 165°F in the thickest part.",
      "timer_minutes": 480
    },
    {
      "step": 4,
      "text": "Shred the chicken in the slow cooker and stir it into the sauce."
    }
  ],
