  "id": "pizza-dough-b8cf58c9",
  "name": "Pizza Dough",
  "subtitle": "A simple yeast dough for homemade pizza",
  "description": "Mix, knead, rest, and bake this versatile dough for a crisp-edged pizza base.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20,
    "inactive_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 2,
      "unit": "cups",
      "preparation": "plus more for dusting"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the yeast, sugar, and warm water together. Let the mixture stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Combine the flour and salt in a bowl. Add the yeast mixture and olive oil, then knead until a smooth dough forms, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Cover the dough and let it rest until puffy, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Heat the oven to 475°F. Dust a work surface with flour, shape the dough, and transfer it to a baking surface. Add desired pizza toppings."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until the crust is cooked through and the topping is melted. Serve warm.",
      "timer_minutes": 15
    }
  ],
