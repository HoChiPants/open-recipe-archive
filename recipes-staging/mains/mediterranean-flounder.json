  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Bring a pot of water to a boil. Add the tomatoes, cook until the skins split, then drain. When cool enough to handle, remove the skins and cut the tomatoes into pieces."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in an oven-safe skillet over medium heat. Sauté the onion for 5 minutes, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the tomatoes, garlic, and Italian seasoning. Cook for 7 minutes, until the tomatoes are tender.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Mix in the olives, wine, capers, lemon juice, chopped basil, and Parmesan. Simmer until the mixture thickens, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Place the flounder fillets over the tomato mixture and top with the torn basil."
    },
    {
      "step": 7,
      "text": "Bake for 12 minutes, until the fish is opaque, easily flaked, and reaches 145°F in the thickest part.",
      "timer_minutes": 12
    }
  ],
