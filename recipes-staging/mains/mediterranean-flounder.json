  "id": "mediterranean-flounder",
  "name": "Mediterranean Flounder",
  "subtitle": "Flounder baked with tomatoes, olives, capers, and basil",
  "description": "Tender flounder fillets are baked over a savory tomato mixture brightened with wine, lemon, olives, and capers, then finished with Parmesan and fresh basil.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
