  "id": "air-fryer-lemon-garlic-chicken-thighs",
  "name": "Air-Fryer Lemon-Garlic Chicken Thighs",
  "subtitle": "Juicy bone-in thighs with crisp skin and bright lemon flavor",
  "description": "Marinated chicken thighs cook quickly in the air fryer for a simple, savory dinner finished with lemon wedges.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
