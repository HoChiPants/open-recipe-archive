  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the lemon juice, olive oil, mustard, garlic, salt, and pepper in a bowl. Add the chicken and turn to coat. Cover and refrigerate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Heat the air fryer to 360°F. Remove the chicken from the marinade and arrange it in the basket in a single layer, skin-side down."
    },
    {
      "step": 3,
      "text": "Cook for 12 minutes, turn the thighs skin-side up, and continue cooking until browned and the thickest part reaches 165°F.",
      "timer_minutes": 24
    },
    {
      "step": 4,
      "text": "Serve hot with the lemon wedges."
    }
  ],
