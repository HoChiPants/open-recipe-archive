  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Stir together the paprika, salt, black pepper, onion powder, garlic powder, oregano, basil, ground thyme, and cayenne pepper."
    },
    {
      "step": 3,
      "text": "Rub the drumsticks with the oil, then coat them evenly with the spice mixture."
    },
    {
      "step": 4,
      "text": "Arrange the drumsticks on a baking sheet and bake for 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Preheat the grill or broiler. Grill the drumsticks for 5 minutes, turning as needed for even browning.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Check the thickest part of a drumstick with a food thermometer; serve when it reaches 165°F."
    }
  ],
