  "id": "cajun-chicken-drumsticks",
  "name": "Cajun Chicken Drumsticks",
  "subtitle": "Spiced drumsticks with a crisp grilled finish",
  "description": "Chicken drumsticks are seasoned with a Cajun-style spice blend, baked, then briefly grilled until fully cooked.",
  "meal_type": "main",
