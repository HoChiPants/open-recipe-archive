    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Place the chicken thighs in a baking dish."
    },
    {
      "step": 3,
      "text": "Mix the garlic powder, onion flakes, and salt, then sprinkle the mixture evenly over the chicken."
    },
    {
      "step": 4,
      "text": "Bake for 45 minutes, or until the thickest part of each thigh reaches 165°F on a food thermometer.",
      "timer_minutes": 45
    }
