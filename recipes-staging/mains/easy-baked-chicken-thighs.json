  "id": "easy-baked-chicken-thighs",
  "name": "Easy Baked Chicken Thighs",
  "subtitle": "Seasoned chicken baked until tender",
  "description": "Chicken thighs coated with garlic, onion, and salt, then baked for an easy dinner.",
  "meal_type": "main",
