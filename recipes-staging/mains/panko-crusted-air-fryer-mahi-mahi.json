  "id": "panko-crusted-air-fryer-mahi-mahi",
  "name": "Panko-Crusted Air-Fryer Mahi Mahi",
  "subtitle": "Crisp seasoned coating with lemon and parsley",
  "description": "Mahi mahi fillets are coated in seasoned panko and air-fried until crisp and flaky, then finished with parsley and lemon.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "panko-bread-crumbs",
      "item": "panko bread crumbs",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "everything-bagel-seasoning",
      "item": "everything bagel seasoning",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-turmeric",
      "item": "ground turmeric",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "4-ounce-mahi-mahi-fillets",
      "item": "(4 ounce) mahi mahi fillets",
      "quantity": 4
    },
    {
      "ingredient_id": "grapeseed-oil",
      "item": "grapeseed oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "nonstick-cooking-spray",
      "item": "nonstick cooking spray"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1,
      "unit": "medium",
      "preparation": "cut into 4 wedges"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 400°F for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Combine the panko, everything bagel seasoning, garlic salt, turmeric, and black pepper in a shallow dish."
    },
    {
      "step": 3,
      "text": "Coat the mahi mahi fillets with grapeseed oil, then press them into the seasoned panko mixture until covered."
    },
    {
      "step": 4,
      "text": "Spray the air-fryer basket with nonstick cooking spray and arrange the coated fillets in a single layer."
    },
    {
      "step": 5,
      "text": "Air-fry for 15 minutes, or until the fish reaches 145°F and flakes easily when tested with a fork.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Garnish with chopped parsley and serve with lemon wedges."
    }
  ],
