  "instructions": [
    {
      "step": 1,
      "text": "Set an electric pressure cooker to its browning or sauté setting. Pat the roast dry and season it with the garlic salt and black pepper."
    },
    {
      "step": 2,
      "text": "Add half the olive oil and brown the roast on all sides, about 5 minutes total. Transfer it to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pour in the beef broth, scraping up any browned bits. Add the potatoes, carrots, onion, and dry onion soup mix; stir to coat evenly."
    },
    {
      "step": 4,
      "text": "Return the roast to the cooker. Seal the lid and cook at high pressure for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Release the pressure according to the cooker instructions. Add the remaining olive oil and the vegetables if they were set aside, then cook at high pressure for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Release pressure and transfer the roast and vegetables to a serving platter. Check the roast with a food thermometer; whole-cut beef should reach 145°F, then rest for 3 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Set the cooker to simmer or sauté. Whisk the water and cornstarch together, stir the mixture into the broth, and cook until thickened, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 8,
      "text": "Slice the rested roast and serve with the vegetables and gravy."
    }
  ],
