  "instructions": [
    {
      "step": 1,
      "text": "Whisk the vinegar, olive oil, and crushed garlic together. Add the chicken, coat well, and marinate for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Sauté the marinated chicken in some of the oil until cooked through; verify that the thickest part reaches 165°F. Cool slightly, then chop."
    },
    {
      "step": 3,
      "text": "Cook the manicotti in boiling water until just tender. Drain and set aside."
    },
    {
      "step": 4,
      "text": "Melt the butter in a saucepan. Whisk in the cream, nutmeg, black pepper, and salt, then stir in Parmesan until smooth. Set the sauce aside."
    },
    {
      "step": 5,
      "text": "Combine the chopped chicken with the ricotta, egg, oregano, marjoram, basil, and part of the mozzarella and Parmesan."
    },
    {
      "step": 6,
      "text": "Spread some sauce in a baking dish. Fill the manicotti with the chicken mixture and arrange them in the dish. Cover with the remaining sauce and top with the remaining Parmesan, ricotta, and mozzarella."
    },
    {
      "step": 7,
      "text": "Bake at 350°F until hot, bubbling, and fully set in the center. If needed, confirm the casserole reaches 165°F.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Let the baked manicotti rest for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
