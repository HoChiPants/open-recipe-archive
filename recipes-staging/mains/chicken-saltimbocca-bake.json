  "id": "chicken-saltimbocca-bake",
  "name": "Chicken Saltimbocca Bake",
  "subtitle": "Crisp prosciutto chicken with potatoes and green beans",
  "description": "Chicken thighs wrapped with prosciutto bake over garlicky potatoes, olives, wine, and sage, with green beans added near the end.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "small-waxy-potatoes-such-as-ratte-or-anya",
      "item": "small waxy potatoes such as Ratte or Anya",
      "quantity": 750,
      "unit": "g"
    },
    {
      "ingredient_id": "olive-oil-or-rapeseed-oil",
      "item": "olive oil or rapeseed oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic cloves",
      "quantity": 3
    },
    {
      "ingredient_id": "mixed-olives",
      "item": "mixed olives",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "marsala-or-white-wine",
      "item": "marsala or white wine",
      "quantity": 50,
      "unit": "ml"
    },
    {
      "ingredient_id": "slices-prosciutto",
      "item": "slices prosciutto",
      "quantity": 6
    },
    {
      "ingredient_id": "boneless-skin-on-chicken-thighs",
      "item": "boneless skin-on chicken thighs",
      "quantity": 6
    },
    {
      "ingredient_id": "bunch-of-sage-leaves-picked",
      "item": "bunch of sage leaves picked",
      "unit": "small"
    },
    {
      "ingredient_id": "green-beans",
      "item": "green beans",
      "quantity": 250,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Cut the potatoes into bite-size pieces and rub them with the garlic cloves."
    },
    {
      "step": 2,
      "text": "Arrange the potatoes in a baking dish with the oil, olives, and marsala or white wine."
    },
    {
      "step": 3,
      "text": "Wrap the chicken thighs with the prosciutto and place them over the potatoes. Scatter over the sage leaves."
    },
    {
      "step": 4,
      "text": "Bake for 35 minutes, then add the green beans around the chicken.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Continue baking for 20 minutes, until the potatoes and green beans are tender and the chicken reaches 165°F at the thickest point.",
      "timer_minutes": 20
    }
  ],
