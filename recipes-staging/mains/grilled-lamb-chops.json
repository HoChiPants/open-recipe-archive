    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "6-ounce-lamb-chops",
      "item": "(6 ounce) lamb chops",
      "quantity": 6
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the onion, vinegar, olive oil, garlic, salt, and pepper in a shallow dish."
    },
    {
      "step": 2,
      "text": "Add the lamb chops and turn to coat. Cover and refrigerate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Preheat a grill to medium-high heat."
    },
    {
      "step": 4,
      "text": "Remove the chops from the marinade and grill for 3 minutes per side, or until a thermometer registers 145°F in the thickest part.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Rest the lamb chops for 3 minutes, then serve.",
      "timer_minutes": 3
    }
  ],
