  "id": "grilled-lamb-chops",
  "name": "Grilled Lamb Chops",
  "subtitle": "Vinegar-marinated chops with garlic and onion",
  "description": "Lamb chops marinate in a tangy garlic mixture before grilling for a quick main course.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
