  "id": "tilapia-in-parchment",
  "name": "Tilapia in Parchment",
  "subtitle": "Tender fish with tomato, basil, capers, and lemon",
  "description": "Tilapia fillets steam gently in parchment with fresh vegetables, herbs, capers, lemon, butter, and white wine for a light French-inspired main dish.",
  "meal_type": "main",
  "cuisine": "French",
