  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Lightly butter the parchment sheets, reserving the divided butter for the fish."
    },
    {
      "step": 3,
      "text": "Place one tilapia fillet near the center of each sheet and season with salt and pepper."
    },
    {
      "step": 4,
      "text": "Top each fillet with tomato, garlic, basil, capers, lemon juice, and a portion of the divided butter."
    },
    {
      "step": 5,
      "text": "Drizzle the white wine around the fillets. Fold and tightly seal each parchment packet, leaving room for steam."
    },
    {
      "step": 6,
      "text": "Transfer the packets to a baking sheet and bake until the fish reaches 145°F and flakes easily, beginning to check at 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Open the packets carefully, as escaping steam is hot, and serve immediately."
    }
  ],
