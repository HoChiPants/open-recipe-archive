      "item": "lemon juice",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the yogurt, ginger and garlic paste, curry powder, cumin, coriander, turmeric, smoked paprika, chilli powder, and lemon juice in a bowl. Add the chicken and coat thoroughly."
    },
    {
      "step": 2,
      "text": "Chill the coated chicken while the grill preheats."
    },
    {
      "step": 3,
      "text": "Arrange the chicken on the hot grill and cook for 5 minutes per side, turning once, until browned and the thickest pieces reach 165°F.",
      "timer_minutes": 5
    }
  ],
