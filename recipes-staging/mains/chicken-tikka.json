  "id": "chicken-tikka",
  "name": "Chicken Tikka",
  "subtitle": "Spiced yogurt-marinated chicken for grilling",
  "description": "Tender chicken chunks coated in a lemony yogurt marinade with warm curry spices, then grilled until fully cooked.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "as a starter"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-breasts-cut-into-chunks",
      "item": "chicken breasts cut into chunks",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "greek-yogurt",
      "item": "Greek yogurt",
      "quantity": 75,
      "unit": "g"
    },
    {
