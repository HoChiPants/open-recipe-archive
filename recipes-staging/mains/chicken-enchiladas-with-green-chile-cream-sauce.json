  "id": "chicken-enchiladas-with-green-chile-cream-sauce",
  "name": "Chicken Enchiladas with Green Chile Cream Sauce",
  "subtitle": "Rolled corn tortillas layered with chicken, chiles, cream, and melted cheese",
  "description": "Corn tortillas are lightly fried, filled with cooked chicken, rolled, and baked in a green chile cream sauce until hot and the cheese is melted.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "chopped",
      "item": "chopped",
      "quantity": 2,
      "unit": "cups",
      "preparation": "cooked chicken"
    },
    {
      "ingredient_id": "green-chilies",
      "item": "green chilies",
      "quantity": 0.5,
      "unit": "can",
      "preparation": "4 ounce, chopped"
    },
    {
      "ingredient_id": "prepared-green-chile-salsa",
      "item": "prepared green chile salsa",
      "quantity": 1,
      "unit": "can",
      "preparation": "7 ounce"
    },
    {
      "ingredient_id": "whipping-cream",
      "item": "whipping cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "oil-for-frying",
      "item": "oil for frying"
    },
    {
      "ingredient_id": "corn-tortillas",
      "item": "corn tortillas",
      "quantity": 12
    },
    {
      "ingredient_id": "monterey-jack-cheese",
      "item": "Monterey Jack cheese",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the green chilies and green chile salsa. Whisk the whipping cream with the salt until combined."
    },
    {
      "step": 3,
      "text": "Warm a thin layer of oil in a skillet and briefly fry the tortillas until pliable. Drain briefly."
    },
    {
      "step": 4,
      "text": "Place cooked chicken in each tortilla, roll tightly, and arrange the enchiladas seam-side down in a baking dish."
    },
    {
      "step": 5,
      "text": "Pour the cream mixture and chile mixture over the enchiladas, then top evenly with the shredded Monterey Jack cheese."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, until the cheese is melted and the casserole reaches 165°F at the center.",
      "timer_minutes": 20
    }
  ],
