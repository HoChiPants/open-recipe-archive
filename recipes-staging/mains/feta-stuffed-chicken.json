  "id": "feta-stuffed-chicken",
  "name": "Feta-Stuffed Chicken",
  "subtitle": "Tender chicken filled with creamy feta and finished with crisp breadcrumbs",
  "description": "Boneless chicken breasts are filled with seasoned feta, coated with breadcrumbs, and baked until cooked through.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 6,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "tomato-basil-feta-cheese",
      "item": "tomato basil feta cheese",
      "quantity": 6,
      "unit": "ounces",
      "preparation": "crumbled"
    },
    {
      "ingredient_id": "italian-style-dry-bread-crumbs",
      "item": "Italian-style dry bread crumbs",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "divided"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the chicken breast halves on a work surface and cut a pocket into the thickest part of each piece."
    },
    {
      "step": 3,
      "text": "Fill each pocket with the crumbled feta, then close the openings."
    },
    {
      "step": 4,
      "text": "Coat the chicken with half of the breadcrumbs and arrange it in a baking dish."
    },
    {
      "step": 5,
      "text": "Sprinkle the remaining breadcrumbs over the chicken."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until the chicken reaches 165°F in the thickest part.",
      "timer_minutes": 30
    }
  ],
