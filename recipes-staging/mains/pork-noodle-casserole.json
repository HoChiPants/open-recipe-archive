  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Bring salted water to a simmer. Cook the egg noodles for 9 minutes, until tender, then drain.",
      "timer_minutes": 9
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet. Add the onion, celery, carrots, red bell pepper, and ground black pepper; cook, stirring, until the onion softens, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Combine the noodles, sautéed vegetables, pork, condensed soup, Cheddar, corn, sour cream, salt, and pepper in a large bowl."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to the prepared dish and sprinkle the bread crumbs evenly over the top."
    },
    {
      "step": 6,
      "text": "Bake for 35 minutes, until hot throughout and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 35
    }
  ],
