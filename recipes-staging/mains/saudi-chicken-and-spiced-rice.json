  "instructions": [
    {
      "step": 1,
      "text": "Combine the saffron, cinnamon, allspice, dried lime powder, cardamom, white pepper, and salt and black pepper. Set aside."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large pot over medium heat. Cook the onion and garlic until softened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the chicken pieces and cook, turning as needed, until lightly browned.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the tomato puree, diced tomatoes with their juices, carrots, cloves, nutmeg, cumin, coriander, and the spice mixture. Cook briefly.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Pour in the hot water and add the chicken bouillon cube. Bring to a simmer, then cook until the chicken is cooked through and reaches 165°F in the thickest pieces.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Stir in the basmati rice. Simmer, covered, until the rice is nearly tender.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Add more hot water if the pot is dry, then stir in the raisins. Cover and cook until the rice is tender and the liquid is absorbed.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Arrange the chicken over the rice and scatter the toasted almonds on top before serving."
    }
  ],
