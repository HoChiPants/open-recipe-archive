  "instructions": [
    {
      "step": 1,
      "text": "Stir the vinegar and sugar together, add the sliced red onion, and leave it to pickle for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Mix the chipotle paste, honey, and lime with the cooked king prawns."
    },
    {
      "step": 3,
      "text": "Combine the rice, pickled onion, lime, spring onions, and kidney beans."
    },
    {
      "step": 4,
      "text": "Divide the rice mixture between two bowls. Add the sweetcorn, avocado, tomatoes, and seasoned prawns."
    },
    {
      "step": 5,
      "text": "Top with crème fraîche, coriander, and chilli flakes, then serve with optional lime wedges."
    }
