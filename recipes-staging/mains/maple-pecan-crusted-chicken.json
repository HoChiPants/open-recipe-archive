  "id": "maple-pecan-crusted-chicken",
  "name": "Maple-Pecan-Crusted Chicken",
  "subtitle": "Crisp pecan coating with a lightly sweet maple finish",
  "description": "Chicken strips are coated in a maple-mayonnaise mixture, covered with pecan panko crumbs, and baked until fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "pure-maple-syrup",
      "item": "pure maple syrup",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "panko-bread-crumbs",
      "item": "panko bread crumbs",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "unit": "medium",
      "preparation": "boneless chicken breast halves, cut into strips"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Lightly coat a baking dish or sheet with cooking spray."
    },
    {
      "step": 2,
      "text": "Stir together the maple syrup, mayonnaise, and salt. In a separate bowl, combine the panko bread crumbs and chopped pecans."
    },
    {
      "step": 3,
      "text": "Coat each chicken strip with the maple mixture, then press it into the pecan-panko mixture. Arrange the strips in the prepared dish."
    },
    {
      "step": 4,
      "text": "Bake until the coating is crisp and the thickest pieces reach 165°F on a food thermometer, about 20 minutes.",
      "timer_minutes": 20
    }
  ],
