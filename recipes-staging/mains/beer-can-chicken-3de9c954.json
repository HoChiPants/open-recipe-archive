  "id": "beer-can-chicken-3de9c954",
  "name": "Beer-Can Chicken",
  "subtitle": "Seasoned whole chicken grilled over a smoky beer can",
  "description": "A simply seasoned whole chicken is positioned over beer flavored with liquid smoke and bay leaves, then grilled until fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 120,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "2-to-3-pound-whole-chicken",
      "item": "(2 to 3 pound) whole chicken",
      "quantity": 1
    },
    {
      "ingredient_id": "beer",
      "item": "beer",
      "quantity": 1,
      "unit": "can",
      "preparation": "12 fluid ounce"
    },
    {
      "ingredient_id": "poultry-seasoning",
      "item": "poultry seasoning",
      "quantity": 5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "liquid-smoke-flavoring",
      "item": "liquid smoke flavoring",
      "quantity": 4,
      "unit": "dashes"
    },
    {
      "ingredient_id": "bay-leaves",
      "item": "bay leaves",
      "quantity": 4
    },
    {
      "ingredient_id": "long-metal-skewer",
      "item": "long metal skewer",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pat the chicken dry, then coat it evenly with the poultry seasoning."
    },
    {
      "step": 2,
      "text": "Open the beer can. Add the liquid smoke flavoring and bay leaves to the can."
    },
    {
      "step": 3,
      "text": "Position the chicken upright over the beer can, using the long metal skewer to secure it if needed."
    },
    {
      "step": 4,
      "text": "Preheat the grill for indirect cooking and place the chicken upright on the grill away from direct heat."
    },
    {
      "step": 5,
      "text": "Grill until the thickest part of the breast and thigh reaches 165°F on a food thermometer, about 120 minutes.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Remove the chicken and beer can carefully. Rest the chicken for 15 minutes before carving.",
      "timer_minutes": 15
    }
  ],
