  "instructions": [
    {
      "step": 1,
      "text": "Stir together the yogurt, feta, lemon zest, lemon juice, oregano, salt, black pepper, and rosemary."
    },
    {
      "step": 2,
      "text": "Add the chicken, onion, and bell pepper; toss until evenly coated."
    },
    {
      "step": 3,
      "text": "Cover and refrigerate for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 4,
      "text": "Preheat a grill to medium-high heat."
    },
    {
      "step": 5,
      "text": "Thread the chicken and vegetables onto skewers, arranging them evenly."
    },
    {
      "step": 6,
      "text": "Grill for about 15 minutes, turning as needed, until the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 15
    }
  ],
