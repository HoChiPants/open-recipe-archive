  "instructions": [
    {
      "step": 1,
      "text": "Arrange the aubergine quarters on a tray and leave them to stand for 60 minutes. Pat dry before coating.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Warm the 2 tablespoons olive oil in a saucepan. Add the crushed garlic and tomato purée, then stir in the chopped tomatoes, dried oregano, sugar, capers, and chilli flakes. Simmer until thickened.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Set out the flour in one shallow dish. Beat the eggs in a second dish. In a third, combine the breadcrumbs, garlic granules, dried oregano, and grated parmesan or vegetarian alternative."
    },
    {
      "step": 4,
      "text": "Coat each aubergine quarter in flour, then egg, then the breadcrumb mixture, pressing gently so it adheres."
    },
    {
      "step": 5,
      "text": "Heat the frying oil and fry the coated aubergine in batches until crisp and golden, turning as needed.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Cook the spaghetti in boiling water until tender, then drain."
    },
    {
      "step": 7,
      "text": "Serve the spaghetti with the tomato sauce and crisp aubergine. Finish with basil and extra parmesan shavings.",
      "timer_minutes": 2
    }
  ],
