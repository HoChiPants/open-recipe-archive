{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "saffron-chicken-with-onion",
  "name": "Saffron Chicken with Onion",
  "subtitle": "Tender chicken thighs in a saffron-spiced stock",
  "description": "Bloom saffron in hot water, build an aromatic onion sauce, then simmer seasoned chicken thighs until fully cooked.",
  "meal_type": "main",
  "cuisine": "Persian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 35,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "saffron-threads",
      "item": "saffron threads",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "hot-water",
      "item": "hot water",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "boneless",
      "item": "boneless",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "skinless chicken thighs"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "freshly-cracked-black-pepper-to-taste",
      "item": "freshly cracked black pepper to taste"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "onion",
      "item": "yellow onion",
      "quantity": 1,
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "curry-powder",
      "item": "curry powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "chicken-stock",
      "item": "chicken stock",
      "quantity": 1.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the saffron threads and hot water in a small bowl. Let stand for 10 minutes to infuse.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Season the chicken thighs with half of the kosher salt and black pepper."
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil in a wide skillet over medium-high heat. Add the chicken and cook until browned, about 4 minutes per side. Transfer to a plate.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Add the yellow onion to the skillet and cook until softened, about 4 minutes. Stir in the garlic and curry powder and cook for 1 minute.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Pour in the chicken stock and saffron water, scraping up any browned bits. Return the chicken and add the remaining kosher salt."
    },
    {
      "step": 6,
      "text": "Reduce the heat, cover, and simmer for about 20 minutes, until the thickest thigh reaches 165°F on a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Serve the chicken with the sauce and adjust with freshly cracked black pepper to taste."
    }
  ],
