  "id": "gizzards-and-rice",
  "name": "Gizzards and Rice",
  "subtitle": "Tender chicken gizzards with savory rice and vegetables",
  "description": "Chicken gizzards are simmered until tender, then combined with seasoned vegetables, tomatoes, broth, and brown rice for a hearty one-dish meal.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
