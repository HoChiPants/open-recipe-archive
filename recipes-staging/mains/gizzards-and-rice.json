  "instructions": [
    {
      "step": 1,
      "text": "Place the gizzards in a pot, cover with water, and simmer until tender and the thickest piece reaches 165°F. Drain, cool briefly, and cut into bite-size pieces."
    },
    {
      "step": 2,
      "text": "Preheat the oven to 350°F. Prepare the instant brown rice according to its package directions.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Warm the oil in a large ovenproof skillet over medium heat. Add the onion, mushrooms, garlic, and soup mix; cook until the vegetables are tender."
    },
    {
      "step": 4,
      "text": "Stir in the gizzards, chicken broth, and drained tomatoes. Simmer for 15 minutes, then fold in the prepared rice.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Season with salt and pepper. Transfer to the preheated oven and heat until hot throughout."
    }
  ],
