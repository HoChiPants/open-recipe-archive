  "id": "chicken-tacos",
  "name": "Chicken Tacos",
  "subtitle": "Seasoned chicken with fresh cabbage, beans, and sweetcorn",
  "description": "Warm homemade flour tortillas with spiced chicken, charred sweetcorn, black beans, cabbage, coriander, yogurt, and chilli sauce.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": ", plus 2 lunchboxes"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30
  },
  "ingredients": [
