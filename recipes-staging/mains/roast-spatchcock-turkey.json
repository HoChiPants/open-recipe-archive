  "id": "roast-spatchcock-turkey",
  "name": "Roast Spatchcock Turkey",
  "subtitle": "Herb-oiled turkey roasted until tender and golden",
  "description": "A flattened whole turkey coated with olive oil, fresh herbs, salt, and pepper, then roasted in two oven stages for even cooking.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 105
  },
  "ingredients": [
    {
      "ingredient_id": "10-pound-whole-turkey",
      "item": "(10 pound) whole turkey",
      "quantity": 1
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-sage",
      "item": "fresh sage",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fresh-thyme-leaves",
      "item": "fresh thyme leaves",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "finely-chopped-fresh-rosemary",
      "item": "finely chopped fresh rosemary",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "black pepper",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the turkey breast-side down on a sturdy work surface. Cut along both sides of the backbone with kitchen shears and remove it, then turn the turkey breast-side up and press firmly to flatten it."
    },
    {
      "step": 3,
      "text": "Combine the olive oil, sage, thyme, rosemary, salt, and pepper. Rub the mixture evenly over the turkey, including beneath the skin where accessible."
    },
    {
      "step": 4,
      "text": "Transfer the turkey to a roasting pan and roast at 350°F for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Raise the oven temperature to 400°F and continue roasting until the thickest part of the breast and thigh reaches 165°F on a food thermometer, about 45 minutes more.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Transfer the turkey to a carving board and rest for 15 minutes before carving and serving.",
      "timer_minutes": 15
    }
  ],
