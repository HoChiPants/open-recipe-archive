      "quantity": 3,
      "unit": "pounds"
    },
    {
      "ingredient_id": "whole-berry-cranberry-sauce",
      "item": "whole berry cranberry sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "ketchup",
      "item": "ketchup",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
