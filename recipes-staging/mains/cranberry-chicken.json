  "id": "cranberry-chicken",
  "name": "Cranberry Chicken",
  "subtitle": "Oven-baked chicken thighs with tangy cranberry sauce",
  "description": "Chicken thighs bake over softened onion beneath a sweet-tart cranberry glaze.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "chicken-thighs",
