      "item": "apple cider vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "dry-mustard-powder",
      "item": "dry mustard powder",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Place the chopped onion and butter in a baking dish and bake until the onion begins to soften.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Arrange the chicken thighs over the onion and return the dish to the oven.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "While the chicken bakes, stir together the cranberry sauce, ketchup, brown sugar, apple cider vinegar, and dry mustard powder."
    },
    {
      "step": 4,
      "text": "Spread the sauce over the chicken and onion. Continue baking until the thickest pieces reach 165°F on a food thermometer and are cooked through.",
      "timer_minutes": 20
    }
  ],
