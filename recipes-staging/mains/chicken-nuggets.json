{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chicken-nuggets",
  "name": "Chicken Nuggets",
  "subtitle": "Crisp Parmesan-coated chicken bites",
  "description": "Tender chicken pieces are coated in seasoned crumbs and Parmesan, then baked until crisp and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 3,
      "preparation": "boneless chicken breasts"
    },
    {
      "ingredient_id": "italian-seasoned-bread-crumbs",
      "item": "Italian seasoned bread crumbs",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Cut the chicken breasts into nugget-sized pieces."
    },
    {
      "step": 3,
      "text": "Combine the bread crumbs, Parmesan, basil, thyme, and salt in a shallow dish."
    },
    {
      "step": 4,
      "text": "Dip each chicken piece in the melted butter, then turn it in the crumb mixture to coat."
    },
    {
      "step": 5,
      "text": "Arrange the coated pieces in a single layer on a baking sheet."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, until the chicken is cooked through and reaches 165°F in the thickest piece.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Serve hot."
    }
  ],
