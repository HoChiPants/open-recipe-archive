  "instructions": [
    {
      "step": 1,
      "text": "Combine the Greek yogurt, cucumber, 2 minced garlic cloves, 1 tablespoon olive oil, dill, white vinegar, lemon juice, and salt and pepper. Blend until smooth; chill until serving."
    },
    {
      "step": 2,
      "text": "Whisk the remaining garlic, lemon juice, 2 tablespoons olive oil, oregano, red wine vinegar, and salt and pepper. Add the chicken and turn to coat. Cover and refrigerate for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Preheat a grill to medium-high heat. Grill the chicken until lightly browned and the thickest pieces reach 165°F, about 4 minutes total. Transfer to a plate and rest for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Warm the pita rounds on the preheated grill for about 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Fill each pita with chicken, tomato, red onion, and lettuce. Serve with the cucumber yogurt sauce."
    }
  ],
