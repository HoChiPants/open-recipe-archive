{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pesto-salmon-phyllo-parcels",
  "name": "Pesto Salmon Phyllo Parcels",
  "subtitle": "Crisp pastry-wrapped salmon with basil pesto",
  "description": "Salmon fillets are coated with pesto, wrapped in layered phyllo, and baked until golden and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "4-ounce-fillets-salmon-fillets",
      "item": "(4 ounce) fillets salmon fillets",
      "quantity": 2
    },
    {
      "ingredient_id": "basil-pesto-store-bought-or-homemade",
      "item": "basil pesto (store-bought or homemade)",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sheets-phyllo-dough",
      "item": "sheets phyllo dough",
      "quantity": 8,
      "preparation": "thawed if frozen"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "plus more if needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Keep the thawed phyllo covered so it does not dry out."
    },
    {
      "step": 2,
      "text": "Spread pesto over the salmon fillets."
    },
    {
      "step": 3,
      "text": "Lay out four phyllo sheets, brushing each lightly with olive oil before adding the next. Place one salmon fillet in the center of each stack and fold the pastry over it to enclose. Repeat with the remaining phyllo, salmon, pesto, and oil."
    },
    {
      "step": 4,
      "text": "Set the parcels seam-side down on a baking sheet and brush the tops with additional oil if needed. Let them stand for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Bake until the phyllo is golden brown and the salmon reaches 145°F internally or is opaque and flakes easily.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Rest the parcels briefly before serving."
    }
  ],
