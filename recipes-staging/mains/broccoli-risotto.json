  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil and 2 tablespoons of the butter in a large saucepan. Warm the heavy cream separately and keep it hot."
    },
    {
      "step": 2,
      "text": "Add the onion and garlic; cook until the onion is golden brown, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir in the Arborio rice and toast for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Add the wine and lemon juice, stirring until absorbed. Add the hot broth gradually, stirring often and allowing each addition to absorb before adding more."
    },
    {
      "step": 5,
      "text": "Cook until the rice is tender and creamy, about 20 minutes. The risotto should be hot throughout and reach 165°F.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Stir in the hot cream, cooked broccoli, chives, Parmesan, Asiago, and remaining butter. Season with salt and pepper.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Serve immediately."
    }
  ],
