  "id": "broccoli-risotto",
  "name": "Broccoli Risotto",
  "subtitle": "Creamy rice with broccoli and aged cheese",
  "description": "A gently stirred Arborio risotto finished with broccoli, cream, chives, lemon, and two flavorful cheeses.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 6,
