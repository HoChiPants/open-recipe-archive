  "id": "chilli-tempeh-stir-fry",
  "name": "Chilli Tempeh Stir-Fry",
  "subtitle": "Tempeh with broccoli, ginger, chilli, and gochujang",
  "description": "A quick plant-based stir-fry combining crisp tempeh, tender broccoli, aromatic ginger and garlic, and a spicy gochujang glaze.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "long-stem-broccoli",
      "item": "long-stem broccoli",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": "1/2",
      "unit": "tbsp",
      "preparation": "toasted"
    },
    {
      "ingredient_id": "tempeh-sliced-and-cut-into-2cm-cubes",
      "item": "tempeh sliced and cut into 2cm cubes",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "garlic-cloves-thinly-sliced",
      "item": "garlic cloves thinly sliced",
      "quantity": 2
    },
    {
      "ingredient_id": "thumb-sized-piece-ginger-peeled-and-finely-grated",
      "item": "thumb-sized piece ginger peeled and finely grated",
      "quantity": 1
    },
    {
      "ingredient_id": "red-chilli-deseeded-and-finely-chopped",
      "item": "red chilli deseeded and finely chopped",
      "quantity": "1/2",
      "unit": "small"
    },
    {
      "ingredient_id": "gochujang-paste",
      "item": "gochujang paste",
      "quantity": "1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "sesame-seeds",
      "item": "sesame seeds",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "steamed-brown-rice-to-serve-optional",
      "item": "steamed brown rice to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Simmer the broccoli for 1 minute, then drain well.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Heat a wok or large frying pan over medium-high heat. Add the toasted sesame oil and stir-fry the tempeh for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the garlic, ginger, and chilli; sauté for 2 minutes until aromatic.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the drained broccoli and gochujang paste, tossing until the vegetables and tempeh are evenly coated."
    },
    {
      "step": 5,
      "text": "Scatter in the sesame seeds and cook for 2 minutes, stirring occasionally.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Serve immediately with steamed brown rice, if desired."
    }
  ],
