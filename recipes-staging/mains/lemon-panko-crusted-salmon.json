  "id": "lemon-panko-crusted-salmon",
  "name": "Lemon Panko-Crusted Salmon",
  "subtitle": "Crisp herb-seasoned salmon with lemon and Parmesan",
  "description": "Salmon fillets are coated with buttery lemon-herb panko and baked until the crust is golden and the fish flakes easily.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "panko-bread-crumbs",
      "item": "panko bread crumbs",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "lemon-pepper-seasoning",
      "item": "lemon-pepper seasoning",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-parsley",
      "item": "dried parsley",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "granulated-garlic",
      "item": "granulated garlic",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "4-ounce-salmon-fillets",
      "item": "(4 ounce) salmon fillets",
      "quantity": 2
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine the panko, Parmesan, lemon-pepper seasoning, thyme, parsley, granulated garlic, and lemon zest."
    },
    {
      "step": 3,
      "text": "Place the salmon fillets in a baking dish and top evenly with the seasoned crumbs."
    },
    {
      "step": 4,
      "text": "Drizzle the melted butter over the crumb topping."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, until the salmon reaches 145°F internally or is opaque and flakes easily.",
      "timer_minutes": 25
    }
  ],
