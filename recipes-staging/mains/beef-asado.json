  "instructions": [
    {
      "step": 1,
      "text": "Season the quartered beef with salt and pepper. Heat the oil in a large heavy pot over medium-high heat and brown the beef on all sides; transfer it to a plate."
    },
    {
      "step": 2,
      "text": "Cook the diced onion and crushed garlic in the same pot until softened and fragrant.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Return the beef to the pot. Add the tomatoes, quartered onion, olives, bouillon cubes, bay leaves, crushed peppercorns, ketchup, and sliced bell pepper. Stir to combine."
    },
    {
      "step": 4,
      "text": "Cover and simmer gently until the beef is beginning to become tender.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Add the potatoes, cover, and continue simmering until the beef is tender and the potatoes are cooked. Confirm the beef reaches at least 145°F in the thickest part, then rest it for 3 minutes before cutting.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Transfer the beef and vegetables as needed and cut the beef into serving pieces."
    },
    {
      "step": 7,
      "text": "Whisk the corn flour with the water. Stir the slurry into the simmering sauce and cook until slightly thickened; return the beef to the sauce and serve.",
      "timer_minutes": 5
    }
  ],
