  "id": "chicken-pesto-gnocchi-with-fresh-mozzarella",
  "name": "Chicken Pesto Gnocchi with Fresh Mozzarella",
  "subtitle": "Tender chicken and potato gnocchi in a warm pesto sauce",
  "description": "A one-pan-style Italian main dish combining browned chicken, pillowy gnocchi, pesto, and fresh mozzarella.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 1,
      "preparation": "boneless chicken breast half - cut into 1 1/2-inch cubes"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "8-ounce-jar-prepared-pesto",
      "item": "(8 ounce) jar prepared pesto",
      "quantity": 1
    },
    {
      "ingredient_id": "potato-gnocchi",
      "item": "potato gnocchi",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 ounce"
    },
    {
      "ingredient_id": "small-fresh-mozzarella-balls",
      "item": "small fresh mozzarella balls",
      "quantity": 4,
      "unit": "ounces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Season the chicken with salt and ground black pepper, then cook until browned and the thickest pieces reach 165°F, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the chicken broth and simmer briefly, scraping up any browned bits. Stir in the prepared pesto and keep the sauce warm."
    },
    {
      "step": 3,
      "text": "Meanwhile, bring a pot of water to a boil, add the potato gnocchi, and cook for about 3 minutes, until tender and floating.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Drain the gnocchi, add it to the skillet, and stir with the chicken and sauce until heated through, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Fold in the small fresh mozzarella balls and serve warm."
    }
  ],
