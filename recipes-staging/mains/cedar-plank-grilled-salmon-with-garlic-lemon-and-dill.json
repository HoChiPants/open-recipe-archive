  "id": "cedar-plank-grilled-salmon-with-garlic-lemon-and-dill",
  "name": "Cedar Plank-Grilled Salmon with Garlic, Lemon and Dill",
  "subtitle": "Herb-seasoned salmon grilled on a soaked cedar plank",
  "description": "A whole salmon filet is coated with garlic, dill, lemon zest, salt, and pepper, then grilled on a cedar plank until opaque and flaky.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "3-pound-whole-filet-of-salmon",
      "item": "(3 pound) whole filet of salmon",
      "quantity": 1,
      "preparation": "skin on, scored (up to but not through the skin) into serving pieces"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic cloves",
      "quantity": 4,
      "unit": "large",
      "preparation": "minced"
    },
    {
      "ingredient_id": "fresh-dill",
      "item": "fresh dill",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "minced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "plus lemon wedges for serving"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Soak a cedar plank in water for 30 minutes. Preheat the grill to medium-high heat.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Stir together the garlic, dill, salt, black pepper, lemon zest, and olive oil."
    },
    {
      "step": 3,
      "text": "Pat the salmon dry and coat the flesh evenly with the seasoned oil mixture."
    },
    {
      "step": 4,
      "text": "Place the salmon skin-side down on the soaked plank, positioning it so the scored portions can be served separately."
    },
    {
      "step": 5,
      "text": "Grill with the lid closed until the thickest part reaches 145°F, is opaque, and flakes easily, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Carefully transfer the plank and salmon from the grill, then rest for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Serve with lemon wedges."
    }
  ],
