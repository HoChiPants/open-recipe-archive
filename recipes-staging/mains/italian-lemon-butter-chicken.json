  "instructions": [
    {
      "step": 1,
      "text": "Bring the white wine and 4 tablespoons of the lemon juice to a simmer in a small saucepan. Whisk in the heavy cream, then gradually whisk in the chilled butter until the sauce is smooth. Season with salt and pepper; keep warm."
    },
    {
      "step": 2,
      "text": "Cook the farfalle in salted boiling water until tender, about 10 minutes. Drain and set aside.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Season the chicken with salt and pepper, coat with the flour, and shake off the excess. Heat the olive oil and 1 tablespoon butter in a skillet over medium-high heat. Cook the chicken until browned and the thickest part reaches 165°F; transfer to a plate."
    },
    {
      "step": 4,
      "text": "Cook the bacon in the same skillet. Stir in the mushrooms, artichoke hearts, and capers, and cook until the mushrooms are tender."
    },
    {
      "step": 5,
      "text": "Slice the chicken. Add the remaining 1 tablespoon lemon juice and a little of the lemon butter sauce to the skillet, then toss with the farfalle. Season with salt and pepper, top with chicken, and spoon over the remaining sauce. Garnish with parsley."
    }
  ],
