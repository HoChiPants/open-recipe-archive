  "id": "roast-potatoes",
  "name": "Roast Potatoes",
  "subtitle": "Crisp-edged potatoes with a fluffy center",
  "description": "Par-cooked potatoes are shaped and roasted in hot oil until deeply golden and crisp.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "maris-piper-potatoes-peeled-and-cut-into-chunks",
      "item": "Maris Piper potatoes peeled and cut into chunks",
      "quantity": 8
    },
    {
      "ingredient_id": "vegetable-oil-for-the-roasting-tin",
      "item": "vegetable oil for the roasting tin"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Simmer the potatoes for 10 minutes, until tender. Drain and let them cool briefly.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the cooled potatoes to a bowl and toss or turn them until their surfaces are thick and roughened; shape them as needed for roasting."
    },
    {
      "step": 3,
      "text": "Preheat the oven and place the roasting tin inside with the vegetable oil to heat."
    },
    {
      "step": 4,
      "text": "Carefully add the potatoes to the hot oiled tin and roast for 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Turn the potatoes and roast for a further 20 minutes, until crisp and golden.",
      "timer_minutes": 20
    }
  ],
