  "id": "broiled-lobster-tails",
  "name": "Broiled Lobster Tails",
  "subtitle": "Paprika-butter lobster with lemon",
  "description": "Lobster tails are broiled with seasoned melted butter and served with lemon wedges.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "lobster-tails",
      "item": "lobster tails",
      "quantity": 2,
      "unit": "whole"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "ground-paprika",
      "item": "ground paprika",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-ground-white-pepper-to-taste",
      "item": "salt and ground white pepper to taste"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1,
      "preparation": "cut into wedges"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the broiler."
    },
    {
      "step": 2,
      "text": "Cut the lobster tails lengthwise and place them on a broiler-safe pan."
    },
    {
      "step": 3,
      "text": "Stir the melted butter, paprika, salt, and white pepper together, then spoon the mixture over the lobster."
    },
    {
      "step": 4,
      "text": "Broil until lightly browned and the lobster meat is opaque and firm, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Serve with the lemon wedges."
    }
  ],
