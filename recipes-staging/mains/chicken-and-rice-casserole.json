  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the chicken and celery in a pot, cover with water, and season with the salt and pepper. Bring to a simmer and cook until the chicken reaches 165°F at the thickest part, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 3,
      "text": "Drain the chicken and celery. Remove the chicken from the bones and cut or shred the meat."
    },
    {
      "step": 4,
      "text": "Combine the soup, sour cream, celery salt, garlic powder, onion powder, and salt and pepper to taste. Stir in the cooked rice, chicken, and celery."
    },
    {
      "step": 5,
      "text": "Mix the crushed crackers with the melted butter or margarine."
    },
    {
      "step": 6,
      "text": "Transfer the chicken mixture to a baking dish and spread the cracker mixture over the top."
    },
    {
      "step": 7,
      "text": "Bake at 350°F until hot throughout and lightly browned, about 35 minutes.",
      "timer_minutes": 35
    }
  ],
