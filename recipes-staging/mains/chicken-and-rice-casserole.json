  "id": "chicken-and-rice-casserole",
  "name": "Chicken and Rice Casserole",
  "subtitle": "Creamy baked chicken with rice and a crisp cracker topping",
  "description": "Chicken is simmered with celery, combined with seasoned soup, sour cream, and cooked rice, then baked beneath a buttery cracker topping.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
