  "id": "greek-pork-tenderloin",
  "name": "Greek Pork Tenderloin",
  "subtitle": "Lime, oregano, and garlic grilled pork",
  "description": "Pork tenderloins marinated in a bright lime-and-oregano mixture, then grilled and rested for a simple Greek-inspired main dish.",
  "meal_type": "main",
  "cuisine": "Greek",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-lime-juice",
      "item": "fresh lime juice",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 6,
      "unit": "cloves",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "1-pound-pork-tenderloins",
      "item": "(1 pound) pork tenderloins",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the lime juice, olive oil, sliced garlic, salt, and oregano in a bowl."
    },
    {
      "step": 2,
      "text": "Add the pork tenderloins and turn to coat thoroughly. Cover and refrigerate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Preheat a grill to medium-high heat and remove the pork from the marinade."
    },
    {
      "step": 4,
      "text": "Grill the tenderloins, turning as needed, until the thickest part reaches 145°F on a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Transfer the pork to a cutting board and let it rest for at least 3 minutes before slicing.",
      "timer_minutes": 3
    }
  ],
