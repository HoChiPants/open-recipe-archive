  "id": "grilled-lamb-chops-with-brown-sugar-spice-rub",
  "name": "Grilled Lamb Chops with Brown Sugar Spice Rub",
  "subtitle": "Sweet-spiced lamb from the grill",
  "description": "Lamb chops rest in a brown sugar and herb-spice mixture before being grilled until safely cooked and lightly charred.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
