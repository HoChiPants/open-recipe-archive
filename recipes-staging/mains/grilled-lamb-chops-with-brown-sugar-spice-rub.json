      "item": "vegetable oil for the grill"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the brown sugar, ginger, tarragon, cinnamon, black pepper, garlic powder, and salt."
    },
    {
      "step": 2,
      "text": "Coat the lamb chops with the spice mixture, cover, and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Preheat the grill and oil the grates."
    },
    {
      "step": 4,
      "text": "Grill the lamb chops for 5 minutes per side, or until a thermometer inserted into the thickest part reads 145°F. Rest for 3 minutes before serving.",
      "timer_minutes": 5
    }
  ],
