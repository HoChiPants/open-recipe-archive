    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a skillet over medium heat. Add the sliced onions and sauté until tender."
    },
    {
      "step": 2,
      "text": "Stir in the brown sugar, ketchup, cider vinegar, mustard, Worcestershire sauce, and hot pepper sauce. Simmer the sauce for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Transfer the sauce and onions to a slow cooker and add the kielbasa. Cover and cook on low for about 4 hours 30 minutes, until hot throughout and the sausage reaches 160°F.",
      "timer_minutes": 270
    },
    {
      "step": 4,
      "text": "Prepare for serving and serve hot."
    }
  ],
