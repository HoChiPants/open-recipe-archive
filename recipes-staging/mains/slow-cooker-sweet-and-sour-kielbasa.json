  "id": "slow-cooker-sweet-and-sour-kielbasa",
  "name": "Slow Cooker Sweet-and-Sour Kielbasa",
  "subtitle": "Tender sausage in a tangy brown-sugar sauce",
  "description": "Kielbasa and sliced onions cook slowly in a sweet, tangy, lightly spicy sauce for an easy main dish.",
  "meal_type": "main",
  "yield": {
    "quantity": 8,
    "unit": "servings"
