  "id": "grilled-venison-backstrap",
  "name": "Grilled Venison Backstrap",
  "subtitle": "Cider-marinated venison wrapped in bacon",
  "description": "Venison chunks are soaked in apple cider, coated with barbecue sauce, wrapped with bacon, and grilled until safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 20,
    "inactive_minutes": 270
  },
  "ingredients": [
    {
      "ingredient_id": "venison-backstrap",
      "item": "venison backstrap",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "cut into 2-inch chunks"
    },
    {
      "ingredient_id": "apple-cider",
      "item": "apple cider",
      "quantity": 1,
      "unit": "quart"
    },
    {
      "ingredient_id": "barbecue-sauce",
      "item": "barbecue sauce",
      "quantity": 2,
      "unit": "bottle",
      "preparation": "12 ounce, your choice"
    },
    {
      "ingredient_id": "thick-sliced-bacon",
      "item": "thick sliced bacon",
      "quantity": 1.5,
      "unit": "pounds"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the venison in a container, cover with the apple cider, and chill for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Drain the venison, coat it with the barbecue sauce, cover, and chill for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Remove the venison from refrigeration and let it stand for 30 minutes. Preheat the grill and prepare it for grilling.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Wrap the venison pieces with bacon and secure as needed. Grill for about 20 minutes, turning as needed, until the thickest piece reaches 160°F on a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Rest briefly, then serve."
    }
  ],
