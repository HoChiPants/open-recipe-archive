  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of salted water to a simmer. Add the pasta and cook for 10 minutes, or until tender. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet. Add the onions, bell pepper, and salt and pepper; cook for 10 minutes, until lightly browned.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the corn, black beans, diced tomatoes, salsa, olives, taco seasoning mix, and additional salt and pepper. Cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Combine the sauce mixture with the drained pasta and serve."
