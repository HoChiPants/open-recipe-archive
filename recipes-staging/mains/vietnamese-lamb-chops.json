  "instructions": [
    {
      "step": 1,
      "text": "Place the lamb chops in a shallow dish. Combine the sugar, sliced garlic, garlic powder, chili powder, and black pepper, then rub the mixture over the chops."
    },
    {
      "step": 2,
      "text": "Mix the olive oil, lime juice, and soy sauce; pour over the chops and turn to coat. Cover and refrigerate for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Heat the oven to 400°F. Arrange the marinated chops in a baking dish."
    },
    {
      "step": 4,
      "text": "Roast for about 20 minutes, or until the thickest chop reaches 145°F. Rest for 3 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Top with cilantro and serve with the lemon and lime wedges."
    }
  ],
