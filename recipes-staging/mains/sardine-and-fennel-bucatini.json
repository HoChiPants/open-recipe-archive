  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven for the final finish."
    },
    {
      "step": 2,
      "text": "Warm part of the olive oil in a skillet. Add the bread crumbs and stir until toasted, about 5 minutes; transfer to a bowl.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Combine the saffron, white wine, and salt in a small saucepan and simmer gently."
    },
    {
      "step": 4,
      "text": "Cook the bucatini in boiling water for 11 minutes, then drain.",
      "timer_minutes": 11
    },
    {
      "step": 5,
      "text": "Heat the remaining olive oil in a large skillet. Add the onion, fennel, fennel fronds, and salt; stir until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Add the raisins, garlic, and anchovy, and stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 7,
      "text": "Add the saffron wine and cook for 2 minutes. Stir in the pine nuts and red pepper flakes, then let the mixture combine for 5 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 8,
      "text": "Add the drained pasta and sardines. Heat until the sardines reach 145°F and are opaque and easily flaked."
    },
    {
      "step": 9,
      "text": "Transfer the pasta to an ovenproof dish and heat in the preheated oven for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 10,
      "text": "Finish with the toasted bread crumbs, fennel, and remaining fennel fronds."
    }
  ],
