  "id": "st-louis-toasted-ravioli",
  "name": "St. Louis Toasted Ravioli",
  "subtitle": "Crisp breaded ravioli with warm marinara",
  "description": "Thawed cheese ravioli are coated in seasoned crumbs, fried until crisp, and served with marinara and Parmesan.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "16-ounce-jar-marinara-sauce",
      "item": "(16 ounce) jar marinara sauce",
      "quantity": 1
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "italian-seasoned-bread-crumbs",
      "item": "Italian seasoned bread crumbs",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "frozen-cheese-ravioli",
      "item": "frozen cheese ravioli",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "25 ounce, thawed"
    },
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying",
      "quantity": 3,
      "unit": "cups",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the marinara sauce in a saucepan over low heat."
    },
    {
      "step": 2,
      "text": "Whisk the egg with the whole milk in a shallow bowl. In a second shallow bowl, combine the bread crumbs and salt."
    },
    {
      "step": 3,
      "text": "Dip each thawed ravioli in the egg mixture, then coat it evenly with the seasoned crumbs."
    },
    {
      "step": 4,
      "text": "Heat the vegetable oil in a deep skillet to 350°F."
    },
    {
      "step": 5,
      "text": "Fry the coated ravioli in batches for about 1 minute per side, until crisp and the egg coating reaches 160°F.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Drain on a rack or paper towels. Serve with the warm marinara and sprinkle with Parmesan."
    }
  ],
