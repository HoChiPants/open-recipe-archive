  "id": "whole-chicken-in-a-pan",
  "name": "Whole Chicken in a Pan",
  "subtitle": "Sage-seasoned chicken cooked in a skillet",
  "description": "Cut-up chicken is seasoned with sage, salt, and pepper, then browned and cooked in a butter-and-oil skillet.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "fryer-chicken",
      "item": "fryer chicken",
      "quantity": 1,
      "unit": "whole",
      "preparation": "3 to 4 pounds"
    },
    {
      "ingredient_id": "dried-sage",
      "item": "dried sage",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "crumbled"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the chicken into serving pieces. Pat dry."
    },
    {
      "step": 2,
      "text": "Combine the sage, salt, and pepper, then season the chicken evenly."
    },
    {
      "step": 3,
      "text": "Heat the butter and olive oil in a large pan over medium heat."
    },
    {
      "step": 4,
      "text": "Arrange the chicken in the pan and cook for 15 minutes, turning as needed for even browning.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Continue cooking until the thickest pieces reach 165°F on a food thermometer and the juices run clear."
    },
    {
      "step": 6,
      "text": "Transfer the chicken to a serving dish and serve hot."
    }
  ],
