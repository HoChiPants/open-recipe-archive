  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to its instructions."
    },
    {
      "step": 2,
      "text": "Combine the cheddar, tomatoes, chorizo, parsley, chilli, spring onions, and lime juice in a bowl."
    },
    {
      "step": 3,
      "text": "Place four tortillas on a work surface. Divide the filling among them, leaving a narrow edge, then top with the remaining tortillas and press lightly to seal."
    },
    {
      "step": 4,
      "text": "Arrange the quesadillas in the air-fryer basket without overlapping. Cook until the tortillas are crisp and the cheese is melted, turning once if needed.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Cut into wedges and serve with lime wedges."
    }
  ],
