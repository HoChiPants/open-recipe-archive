  "id": "air-fryer-quesadillas",
  "name": "Air fryer quesadillas",
  "subtitle": "Crisp tortillas with melted cheddar and chorizo",
  "description": "Cheddar, chorizo, tomatoes, herbs, and lime make a savory filling for crisp air-fried quesadillas.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
