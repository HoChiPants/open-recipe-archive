  "id": "charred-squash-with-spiced-lamb",
  "name": "Charred Squash with Spiced Lamb",
  "subtitle": "Smoky squash and seasoned lamb with bright pomegranate toppings",
  "description": "Charred squash and spiced lamb are finished with pomegranate, herbs, pistachios, and feta, then served with salad leaves.",
  "meal_type": "main",
