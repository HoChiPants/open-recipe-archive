  "instructions": [
    {
      "step": 1,
      "text": "Toss the sliced squash with the rapeseed oil, ground coriander, and ground cumin."
    },
    {
      "step": 2,
      "text": "Preheat a grill or barbecue. Grill the squash for about 10 minutes, turning as needed, until tender and charred.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the trimmed lamb steaks and cook for 3 minutes, turning as needed, until a thermometer inserted into the thickest part reads 145°F. Rest the lamb for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Cut the cooked squash into serving pieces and arrange it with the lamb."
    },
    {
      "step": 5,
      "text": "Combine the pomegranate molasses, lemon juice, parsley, pistachios, pomegranate seeds, and feta. Spoon over the squash and lamb."
    },
    {
      "step": 6,
      "text": "Serve with the mixed salad leaves."
    }
  ],
