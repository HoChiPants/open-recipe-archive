  "id": "salmon-fillets-with-creamy-dill",
  "name": "Salmon Fillets with Creamy Dill",
  "subtitle": "Baked salmon with a herbed mustard-mayonnaise topping",
  "description": "Salmon fillets bake beneath a creamy, herb-seasoned topping for an easy main dish.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "prepared-mustard",
      "item": "prepared mustard",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-thyme",
      "item": "fresh thyme",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fresh-basil-leaves",
      "item": "fresh basil leaves",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salmon-fillets",
      "item": "salmon fillets",
      "quantity": 1.5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "dried-dill",
      "item": "dried dill",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Stir the mayonnaise and prepared mustard together, then mix in the fresh thyme, dried oregano, and fresh basil leaves."
    },
    {
      "step": 3,
      "text": "Place the salmon fillets in a baking dish and spread the mayonnaise mixture over them. Sprinkle with the dried dill."
    },
    {
      "step": 4,
      "text": "Bake for 40 minutes, until the salmon reaches 145°F or is opaque and easily flaked.",
      "timer_minutes": 40
    }
  ],
