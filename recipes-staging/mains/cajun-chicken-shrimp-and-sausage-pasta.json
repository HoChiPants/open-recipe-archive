  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer. Add the fettuccine and cook for 8 minutes, or until cooked through. Transfer the pasta to a colander and drain.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat. Add the garlic and shrimp, then cook until the shrimp is opaque and easily flakes."
    },
    {
      "step": 3,
      "text": "Stir in the sausage, tomatoes, broccoli, bell pepper, mushrooms, green onions, and black pepper. Cook until the sausage and vegetables are tender."
    },
    {
      "step": 4,
      "text": "Add the cooked chicken, white wine, Cajun seasoning, milk, and 0.25 cup grated Parmesan. Stir for 5 minutes, until hot and the shrimp is fully opaque.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the drained fettuccine, 2 tablespoons grated Parmesan, the remaining green bell pepper, and black pepper. Toss to combine and serve."
    }
  ],
