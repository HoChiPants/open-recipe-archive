  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cabbage-and-dumplings",
  "name": "Cabbage and Dumplings",
  "subtitle": "Tender cabbage with simple boiled dumplings",
  "description": "Buttery cabbage and onion are paired with flour dumplings for a warm, uncomplicated meal.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "medium",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "head-green-cabbage",
      "item": "head green cabbage",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large pot over medium heat."
    },
    {
      "step": 2,
      "text": "Add the onion and cabbage, and cook until the cabbage begins to soften."
    },
    {
      "step": 3,
      "text": "Bring the water to a simmer. Combine the flour with enough of the simmering water to form a soft dumpling mixture."
    },
    {
      "step": 4,
      "text": "Drop spoonfuls of the mixture into boiling water and cook until the dumplings are done."
    },
    {
      "step": 5,
      "text": "Drain the dumplings, then add them to the cabbage mixture and toss gently."
    },
    {
      "step": 6,
      "text": "Season with salt to taste and serve hot."
    }
  ],
