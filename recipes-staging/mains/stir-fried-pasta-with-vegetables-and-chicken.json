  "id": "stir-fried-pasta-with-vegetables-and-chicken",
  "name": "Stir-Fried Pasta with Vegetables and Chicken",
  "subtitle": "A quick skillet pasta with crisp vegetables and savory seasoning.",
  "description": "Boiled spaghetti is tossed with sautéed chicken, colorful vegetables, garlic, and soy sauce for a simple one-pan-style main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
