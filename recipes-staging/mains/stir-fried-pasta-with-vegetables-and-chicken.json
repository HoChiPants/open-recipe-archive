  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer, then cook the spaghetti in boiling water until tender. Drain well."
    },
    {
      "step": 2,
      "text": "Preheat a large skillet over medium-high heat and add the olive oil."
    },
    {
      "step": 3,
      "text": "Cook the garlic in the oil for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the onion and stir until it begins to soften."
    },
    {
      "step": 5,
      "text": "Add the chicken and stir-fry until no longer pink and the center reaches 165°F on a food thermometer."
    },
    {
      "step": 6,
      "text": "Add the broccoli, cauliflower, and carrots. Cook, stirring often, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Add the drained spaghetti, salt, pepper, and soy sauce. Toss until evenly combined and heated through."
    },
    {
      "step": 8,
      "text": "Serve hot."
    }
  ],
