  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Arrange the bell peppers and onion on a sheet pan. Add the olive oil, salt, chili powder, garlic powder, black pepper, and cumin, using the divided amounts as directed, and toss to coat."
    },
    {
      "step": 3,
      "text": "Spread the vegetables evenly and place the flank steak on the pan. Coat the steak with the remaining seasonings and oil."
    },
    {
      "step": 4,
      "text": "Bake for 14 minutes, until the steak reaches at least 145°F in the thickest part on a food thermometer.",
      "timer_minutes": 14
    },
    {
      "step": 5,
      "text": "Transfer the steak to a cutting board and rest it for at least 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Slice the steak across the grain. Fill the warmed tortillas with the steak and vegetables, and serve with the lime quarters."
    }
  ],
