  "id": "sheet-pan-beef-fajitas",
  "name": "Sheet Pan Beef Fajitas",
  "subtitle": "Roasted steak and peppers for warm tortillas",
  "description": "Seasoned flank steak roasts alongside peppers and onion, then is sliced and served in warm flour tortillas with lime.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
