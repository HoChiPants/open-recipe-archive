  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large pot. Add the chicken pieces and minced ginger; cook for 8 minutes, turning as needed. Set the chicken aside.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Place the spinach and 0.25 cup water in the pot. Cook for 10 minutes, then transfer the spinach to a bowl and set aside.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the onions, garlic, and remaining minced ginger to the pot. Cook for 10 minutes, stirring, until lightly browned.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the crushed tomatoes, coriander, salt, cayenne, turmeric, cardamom, and cloves. Add 1 tablespoon water if needed and cook for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Mix in the milk, return the chicken to the pot, and simmer for 20 minutes, until tender and the thickest pieces reach 165°F.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Stir in the spinach and garam masala. Cook for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Whisk the sour cream with the hot sauce until smooth. Melt the butter and finish the dish with the sour cream mixture and butter."
    }
  ],
