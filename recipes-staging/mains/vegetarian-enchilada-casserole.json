  "id": "vegetarian-enchilada-casserole",
  "name": "Vegetarian Enchilada Casserole",
  "subtitle": "Layered tortillas, beans, tempeh, chiles, and melted cheese",
  "description": "A hearty baked casserole with seasoned beans and tempeh layered with corn tortillas, enchilada sauce, olives, and Cheddar.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "black-beans",
      "item": "black beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, rinsed and drained"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "green-chile-peppers",
      "item": "green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "4 ounce, diced"
    },
    {
      "ingredient_id": "jalapeno-pepper",
      "item": "jalapeno pepper",
      "quantity": 1,
      "preparation": "seeded and minced"
    },
    {
      "ingredient_id": "tempeh",
      "item": "tempeh",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, crumbled"
    },
    {
      "ingredient_id": "6-inch-corn-tortillas",
      "item": "(6 inch) corn tortillas",
      "quantity": 6
    },
    {
      "ingredient_id": "enchilada-sauce",
      "item": "enchilada sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "19 ounce"
    },
    {
      "ingredient_id": "black-olives",
      "item": "black olives",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce, sliced"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and lightly prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Combine the black beans, garlic, onion, green chile peppers, jalapeno, and tempeh."
    },
    {
      "step": 3,
      "text": "Spread some enchilada sauce in the dish. Add a layer of tortillas, followed by part of the bean-tempeh mixture and more sauce. Repeat as needed."
    },
    {
      "step": 4,
      "text": "Top with the remaining tortillas, enchilada sauce, black olives, and Cheddar cheese."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, then continue baking for 15 minutes, until the cheese is melted and the center is hot.",
      "timer_minutes": 45
    }
  ],
