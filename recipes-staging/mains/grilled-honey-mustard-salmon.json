{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "grilled-honey-mustard-salmon",
  "name": "Grilled Honey-Mustard Salmon",
  "subtitle": "A sweet, tangy salmon fillet for an easy dinner",
  "description": "Salmon is coated in a buttery honey-mustard sauce, chilled to absorb the flavors, and grilled until opaque and flaky.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15,
    "inactive_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "honey-mustard",
      "item": "honey mustard",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "melted"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "salmon-fillet",
      "item": "salmon fillet",
      "quantity": 1,
      "unit": "pound"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the honey mustard, melted butter, Worcestershire sauce, brown sugar, and garlic powder until smooth."
    },
    {
      "step": 2,
      "text": "Coat the salmon with the sauce, cover, and chill for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 3,
      "text": "Preheat the grill and lightly oil the grates with the vegetable oil."
    },
    {
      "step": 4,
      "text": "Grill the salmon for about 12 minutes, turning as appropriate, until opaque and easily flaked or until it reaches 145°F internally.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
  ],
