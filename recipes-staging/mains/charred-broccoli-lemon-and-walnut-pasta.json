  "id": "charred-broccoli-lemon-and-walnut-pasta",
  "name": "Charred Broccoli, Lemon and Walnut Pasta",
  "subtitle": "A quick pasta with smoky broccoli, garlic, chili, and bright lemon.",
  "description": "Char broccoli until browned, then toss it with pasta, toasted walnuts, garlic, chili, and lemon for a fast, textured meal.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "head-broccoli-cut-into-small-florets-and-stalk-cut-into-small-pieces",
      "item": "head broccoli cut into small florets and stalk cut into small pieces",
      "quantity": 1
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tsp"
    },
    {
      "ingredient_id": "penne-or-fusilli",
      "item": "penne or fusilli",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "garlic-cloves-crushed",
      "item": "garlic cloves crushed",
      "quantity": 2
    },
    {
      "ingredient_id": "roughly-chopped-walnuts",
      "item": "roughly chopped walnuts",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "of-chilli-flakes",
      "item": "of chilli flakes",
      "unit": "pinch"
    },
    {
      "ingredient_id": "lemon-zested-and-juiced",
      "item": "lemon zested and juiced",
      "quantity": "1/2"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the grill to high. Toss the broccoli with half the olive oil and arrange it in a single layer on a grill-safe tray."
    },
    {
      "step": 2,
      "text": "Grill the broccoli until charred and tender, turning once if needed.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Meanwhile, cook the penne or fusilli in salted boiling water until tender. Drain, reserving a little cooking water."
    },
    {
      "step": 4,
      "text": "Warm the remaining olive oil in a pan. Add the crushed garlic, walnuts, and chilli flakes, and cook until fragrant and lightly toasted.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Add the pasta and broccoli to the pan. Toss with the lemon zest and juice, loosening with a splash of reserved pasta water if needed."
    },
    {
      "step": 6,
      "text": "Serve hot with the remaining lemon zest and juice."
    }
  ],
