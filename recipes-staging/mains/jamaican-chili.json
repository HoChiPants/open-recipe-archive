  "instructions": [
    {
      "step": 1,
      "text": "Heat a large pot over medium-high heat. Coat it with cooking spray, add the ground round, ground cumin, and ground cloves, and cook until browned. Drain excess fat; the beef should reach 160°F."
    },
    {
      "step": 2,
      "text": "Return the pot to medium heat. Add the olive oil, onion, and garlic; cook until the onion is tender. Add the yellow bell pepper and cook until tender."
    },
    {
      "step": 3,
      "text": "Stir in the hot paprika, chile powder, white sugar, and salt. Add the stewed tomatoes, kidney beans, black beans, cannellini beans, tomato paste, and water, stirring to combine."
    },
    {
      "step": 4,
      "text": "Bring the chili to a simmer, then stir the cooked beef into the pot. Simmer gently until thickened and the flavors develop.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Stir in the balsamic vinegar and fresh cilantro just before serving."
    }
  ],
