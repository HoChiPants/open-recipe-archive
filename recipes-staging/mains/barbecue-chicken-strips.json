  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the butter, barbeque sauce, Worcestershire sauce, and garlic powder in a skillet, stirring until the butter melts and the sauce is smooth."
    },
    {
      "step": 2,
      "text": "Add the chicken strips and stir to coat them with the sauce."
    },
    {
      "step": 3,
      "text": "Cook, stirring occasionally, until the chicken is cooked through, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Continue cooking as needed until the thickest pieces reach 165°F on a food thermometer, about 4 minutes more.",
      "timer_minutes": 4
    }
  ],
