  "id": "barbecue-chicken-strips",
  "name": "Barbecue Chicken Strips",
  "subtitle": "Tender chicken in a tangy barbecue sauce",
  "description": "Quick skillet-cooked chicken strips coated in a buttery barbecue and Worcestershire sauce.",
