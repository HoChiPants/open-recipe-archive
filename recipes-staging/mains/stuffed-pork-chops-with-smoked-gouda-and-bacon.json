      "item": "ground black pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill for 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Mix the smoked Gouda, bacon, parsley, and 0.125 teaspoon ground black pepper."
    },
    {
      "step": 3,
      "text": "Cut a pocket horizontally into the side of each pork chop, taking care not to cut through the opposite side, and fill each pocket with the cheese mixture."
    },
    {
      "step": 4,
      "text": "Brush the chops with olive oil and season with salt and the remaining 0.125 teaspoon ground black pepper."
    },
    {
      "step": 5,
      "text": "Grill the chops for about 20 minutes, turning as needed, until the thickest part reaches 145°F on a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Transfer the chops to a plate and let them rest for 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
