  "id": "stuffed-pork-chops-with-smoked-gouda-and-bacon",
  "name": "Stuffed Pork Chops with Smoked Gouda and Bacon",
  "subtitle": "Grilled pork chops with a savory cheese-and-bacon filling",
  "description": "Thick bone-in pork chops are filled with smoked Gouda, bacon, parsley, and pepper, then grilled until safely cooked and rested before serving.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
