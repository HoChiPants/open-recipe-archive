      "item": "salt and black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill to high heat."
    },
    {
      "step": 2,
      "text": "Melt the butter and combine it with Worcestershire sauce, meat tenderizer, minced garlic, salt, and black pepper."
    },
    {
      "step": 3,
      "text": "Coat the frozen steak with the seasoned butter mixture and place it on the hot grill."
    },
    {
      "step": 4,
      "text": "Grill for 8 minutes, turn, and continue cooking until the thickest part reaches 145°F.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Transfer the steak to a plate and let it rest for 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
