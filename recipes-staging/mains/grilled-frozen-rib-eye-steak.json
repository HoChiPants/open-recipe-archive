      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "1-2-pound-frozen-delmonico-rib-eye-steak",
      "item": "(1/2 pound) frozen Delmonico (rib-eye) steak",
      "quantity": 1
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or to taste"
