  "id": "grilled-frozen-rib-eye-steak",
  "name": "Grilled Frozen Rib-Eye Steak",
  "subtitle": "A simple seasoned steak finished over high heat",
  "description": "Grill a frozen rib-eye with garlic, Worcestershire sauce, and butter for a quick, savory dinner.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
