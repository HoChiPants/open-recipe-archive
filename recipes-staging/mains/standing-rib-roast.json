  "instructions": [
    {
      "step": 1,
      "text": "Combine the warm water, coffee, salt, soup mix, diced onion, minced garlic, Worcestershire sauce, garlic powder, and onion powder in a large container."
    },
    {
      "step": 2,
      "text": "Add the roast, cover, and refrigerate in the brine for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Remove the roast from the brine and transfer it to a roasting pan. Season with the soup mix, onion, garlic, garlic powder, onion powder, and black pepper as directed by the ingredient list."
    },
    {
      "step": 4,
      "text": "Roast at 180°F for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Raise the oven temperature to 375°F and continue roasting for about 60 minutes, until the thickest part reaches at least 145°F.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Transfer the roast to a cutting board and rest for at least 3 minutes before carving.",
      "timer_minutes": 3
    }
  ],
