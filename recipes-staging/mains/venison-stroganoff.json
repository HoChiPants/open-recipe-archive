  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet. Season the venison with the salt, pepper, garlic powder, and onion powder, then brown it in the hot oil for 8 minutes. Transfer the meat to a slow cooker.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Return the skillet to medium heat. Stir in the flour and cook for 5 minutes, until golden brown. Gradually stir in the water, then mix in the condensed soup.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pour the sauce over the venison. Cover and cook for 4 hours, or until tender and the venison reaches 160°F on a food thermometer.",
      "timer_minutes": 240
    },
    {
      "step": 4,
      "text": "Bring the remaining water to a simmer in a pot, add the egg noodles, and cook for 10 minutes or until tender. Drain and serve with the venison and sauce.",
      "timer_minutes": 10
    }
  ],
