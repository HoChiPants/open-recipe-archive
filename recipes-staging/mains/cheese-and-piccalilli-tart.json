  "id": "cheese-and-piccalilli-tart",
  "name": "Cheese and Piccalilli Tart",
  "subtitle": "A savory baked tart with sharp cheddar and tangy piccalilli",
  "description": "A crisp pastry shell filled with mature cheddar, chopped piccalilli, and a lightly seasoned egg custard.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 65
  },
  "ingredients": [
    {
      "ingredient_id": "plain-flour-plus-extra-for-dusting",
      "item": "plain flour plus extra for dusting",
      "quantity": 240,
      "unit": "g"
    },
    {
      "ingredient_id": "unsalted-butter-cut-into-cubes",
      "item": "unsalted butter cut into cubes",
      "quantity": 120,
      "unit": "g",
      "preparation": "then chilled"
    },
    {
      "ingredient_id": "yeast-extract",
      "item": "yeast extract",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "medium"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 175,
      "unit": "ml"
    },
    {
      "ingredient_id": "piccalilli-any-large-pieces-chopped",
      "item": "piccalilli any large pieces chopped",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "mature-cheddar-finely-grated",
      "item": "mature cheddar finely grated",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "onion-seeds",
      "item": "onion seeds",
      "quantity": 1,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Rub the chilled butter into the flour until the mixture resembles fine crumbs. Mix in the yeast extract, then bring the mixture together into a dough. Shape into a disc, wrap, and chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Lightly butter a tart tin. Roll the dough on a floured surface and use it to line the tin, pressing it into the edges. Trim the excess and chill the lined tin while the oven heats."
    },
    {
      "step": 3,
      "text": "Preheat the oven to 400°F. Line the pastry with parchment and baking weights, then bake for 25 minutes. Remove the weights and parchment and bake for 10 minutes more.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "Whisk the eggs and milk together until combined. Stir in the chopped piccalilli, grated cheddar, and onion seeds."
    },
    {
      "step": 5,
      "text": "Pour the filling into the pastry shell and bake for about 30 minutes, until the center is firm and fully set.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool the tart briefly, then cut into portions and serve."
    }
  ],
