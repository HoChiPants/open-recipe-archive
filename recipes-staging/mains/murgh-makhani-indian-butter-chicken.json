  "instructions": [
    {
      "step": 1,
      "text": "Stir the yogurt, tandoori masala, garam masala, and chili powder together. Add the chicken and coat thoroughly; refrigerate for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Blend the chopped onion, ginger, water, and garlic until smooth. Set aside."
    },
    {
      "step": 3,
      "text": "Drain the chicken marinade. Heat half the oil in a large skillet over medium-high heat and cook the chicken for about 5 minutes, turning as needed.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Heat the remaining oil in the skillet. Sauté the onion mixture for 3 minutes, then add the tandoori masala, garam masala, and chili powder and cook for 1 minute.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Add the tomato sauce and simmer for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir in the half and half, butter, fenugreek leaves, and salt. Return the chicken to the skillet and simmer for 20 minutes, until the thickest pieces reach 165°F.",
      "timer_minutes": 20
    }
  ],
