  "id": "creamy-chicken-toast",
  "name": "Creamy Chicken Toast",
  "subtitle": "Tender chicken in a peppered herb cream sauce over crisp toast",
  "description": "Sautéed chicken and peppers are folded into a rich tarragon cream sauce and spooned over toasted bread.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
