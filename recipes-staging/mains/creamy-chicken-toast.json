  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken with salt. Melt the butter in a large skillet over medium-high heat and cook the chicken until browned and cooked through, 3 minutes per side or as needed. Verify the thickest pieces reach 165°F, then transfer the chicken to a plate.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Add the green onions, red bell pepper, jalapeno, black pepper, and cayenne to the skillet. Cook, stirring, until the vegetables soften, about 5 minutes; season with salt.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pour in the chicken broth and scrape up any browned bits. Stir in the heavy cream, bring the sauce to a gentle simmer, and cook until slightly reduced, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Cut the chicken into bite-size pieces if needed. Return it to the skillet with the crème fraîche and simmer until heated through and the sauce coats the chicken, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Stir in the tarragon. Spoon the creamy chicken and sauce over the toasted bread and serve."
    }
  ],
