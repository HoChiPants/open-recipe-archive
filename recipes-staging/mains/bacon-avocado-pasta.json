  "id": "bacon-avocado-pasta",
  "name": "Bacon Avocado Pasta",
  "subtitle": "Creamy avocado pasta with crisp bacon and basil",
  "description": "Bow-tie pasta is tossed with chopped avocado, fresh basil, lemon, garlic, and Romano cheese, then finished with crisp bacon.",
  "meal_type": "main",
  "cuisine": "American",
