  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water seasoned with the salt to a simmer. Add the pasta and cook for 12 minutes, or until tender. Drain.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Cook the bacon in a preheated skillet for about 10 minutes, turning as needed, until crisp. Drain and crumble.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Combine the chopped avocados, basil, lemon juice, olive oil, garlic, and black pepper in a large bowl."
    },
    {
      "step": 4,
      "text": "Stir in the crumbled bacon, then add the drained pasta and toss until coated."
    },
    {
      "step": 5,
      "text": "Add the Romano cheese and combine gently. Serve immediately."
    }
  ],
