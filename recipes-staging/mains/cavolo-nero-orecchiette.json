  "instructions": [
    {
      "step": 1,
      "text": "Cook the orecchiette until tender, following the package timing. Drain well."
    },
    {
      "step": 2,
      "text": "Warm the olive oil in a pan. Add the cavolo nero stems, garlic, chilli, and shallot, then cook for 5 minutes. Add the leaves and continue until the greens are tender.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the drained pasta to the pan and toss with the greens and aromatics."
    },
    {
      "step": 4,
      "text": "Stir in the lemon zest, lemon juice, and ricotta until evenly combined. Finish with the toasted almonds and serve."
    }
  ],
