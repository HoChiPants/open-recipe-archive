  "instructions": [
    {
      "step": 1,
      "text": "Heat a large skillet over medium heat with the 2 tablespoons white wine. Add the chicken and cook for 6 minutes, turning as needed. Transfer the chicken to a plate when set aside.",
      "timer_minutes": 6
    },
    {
      "step": 2,
      "text": "Add the garlic and diced onion to the skillet. Stir the onion for about 3 minutes, until tender.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the tomatoes and 1/2 cup white wine. Bring the mixture to a simmer and cook for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the thyme and basil, then return the chicken to the skillet. Add the olive oil, Kalamata olives, and parsley. Cook until the chicken reaches 165°F in the thickest part and the sauce is hot.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Season with salt and pepper to taste, then serve."
    }
  ],
