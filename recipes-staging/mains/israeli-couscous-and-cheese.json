  "id": "israeli-couscous-and-cheese",
  "name": "Israeli Couscous and Cheese",
  "subtitle": "Creamy pearl couscous with cheddar and chives",
  "description": "Toasted pearl couscous becomes creamy with broth and heavy cream, then is finished with cheddar, pimientos, and chives.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "pearl-israeli-couscous",
      "item": "pearl (Israeli) couscous",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "pimientos",
      "item": "pimientos",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "sharp-cheddar-cheese",
      "item": "sharp Cheddar cheese",
      "quantity": 3,
      "unit": "ounces",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "fresh-chives",
      "item": "fresh chives",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium heat. Add the couscous and stir for 3 minutes, until lightly toasted.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Pour in the chicken broth and bring to a simmer. Whisk in the heavy cream, cayenne, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Simmer for 7 minutes, stirring occasionally, until the couscous is tender. If homemade broth contains raw poultry, heat the finished dish to 165°F.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Stir in the pimientos and Cheddar until the cheese melts, then fold in the chives and serve."
    }
  ],
