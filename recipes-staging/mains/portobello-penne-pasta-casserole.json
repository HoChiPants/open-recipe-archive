  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "portobello-penne-pasta-casserole",
  "name": "Portobello Penne Pasta Casserole",
  "subtitle": "Creamy baked pasta with mushrooms and spinach",
  "description": "Penne is tossed with sautéed portobellos, spinach, and a creamy mozzarella sauce, then baked until bubbling.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "uncooked-penne-pasta",
      "item": "uncooked penne pasta",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "portobello-mushrooms",
      "item": "portobello mushrooms",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "clove-garlic",
      "item": "clove garlic",
      "quantity": 1,
      "unit": "large",
      "preparation": "minced"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Cook the penne according to package directions, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a skillet. Add the mushrooms and soy sauce; stir for 1 minute, until the mushrooms are set aside.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Melt the margarine in the skillet. Stir in the flour, garlic, and basil, then gradually add the milk. Cook and stir until thickened."
    },
    {
      "step": 4,
      "text": "Stir in the mozzarella until melted. Combine the sauce with the penne, mushrooms, and thawed spinach."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to a casserole dish and bake at 350°F until hot and bubbling.",
      "timer_minutes": 20
    }
  ],
