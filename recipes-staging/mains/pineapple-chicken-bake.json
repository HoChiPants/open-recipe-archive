      "item": "pineapple",
      "quantity": 1,
      "unit": "can",
      "preparation": "9 ounce, crushed"
    },
    {
      "ingredient_id": "assorted-chicken-pieces-such-as-breasts",
      "item": "assorted chicken pieces such as breasts",
      "quantity": 3,
      "unit": "pounds",
      "preparation": "thighs, wings, and drumsticks"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan. Stir in the ketchup and brown sugar."
    },
    {
      "step": 3,
      "text": "Whisk the cornstarch with the vinegar until smooth, then whisk in the salt, soy sauce, and Worcestershire sauce."
    },
    {
      "step": 4,
      "text": "Add the mixture to the saucepan and cook for 2 minutes, stirring, until thickened.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Stir in the crushed pineapple."
    },
    {
      "step": 6,
      "text": "Arrange the chicken pieces in a baking dish and pour the sauce over them."
    },
    {
      "step": 7,
      "text": "Bake for 45 minutes, or until the thickest chicken piece reaches 165°F on a food thermometer.",
      "timer_minutes": 45
    }
  ],
