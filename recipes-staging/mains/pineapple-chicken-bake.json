  "id": "pineapple-chicken-bake",
  "name": "Pineapple Chicken Bake",
  "subtitle": "Tender chicken in a sweet-tangy pineapple sauce",
  "description": "Chicken pieces bake in a thick sauce made with pineapple, ketchup, brown sugar, vinegar, and savory seasonings.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "ketchup",
      "item": "ketchup",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
