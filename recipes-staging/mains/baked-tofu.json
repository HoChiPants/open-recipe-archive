  "id": "baked-tofu",
  "name": "Baked Tofu",
  "subtitle": "Savory ginger-sesame tofu with caramelized edges",
  "description": "Tofu is coated in a savory soy-ginger glaze and baked until firm and lightly browned.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "agave-nectar",
      "item": "agave nectar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "toasted"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "fresh-ginger",
      "item": "fresh ginger",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "sesame-seeds",
      "item": "sesame seeds",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "tofu",
      "item": "tofu",
      "quantity": 1,
      "unit": "pound",
      "preparation": "sliced into 8 even pieces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Lightly coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk the soy sauce, agave nectar, sesame oil, garlic, ginger, and sesame seeds until combined."
    },
    {
      "step": 3,
      "text": "Arrange the tofu pieces in the prepared dish and pour the sauce over them, turning to coat."
    },
    {
      "step": 4,
      "text": "Bake for 30 minutes. Turn the tofu, spoon the pan sauce over it, and finish baking for 30 minutes, until browned and heated through.",
      "timer_minutes": 60
    }
  ],
