  "id": "baked-garlic-prawns-with-roasted-peppers-and-gremolata-toasts",
  "name": "Baked Garlic Prawns with Roasted Peppers and Gremolata Toasts",
  "subtitle": "Garlic prawns with sweet peppers, crisp toast, and fresh lemon-parsley topping",
  "description": "Roasted peppers and wine form a savory base for prawns, served with crisp garlic toasts and bright gremolata.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "red-peppers-halved-and-deseeded",
      "item": "red peppers halved and deseeded",
      "quantity": 2
    },
    {
      "ingredient_id": "garlic-cloves-thinly-sliced",
      "item": "garlic cloves thinly sliced",
      "quantity": 3,
      "preparation": "plus 1 whole peeled clove"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra virgin olive oil",
      "quantity": 6,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "white-wine-or-vermouth-optional",
      "item": "white wine or vermouth",
      "quantity": 125,
      "unit": "ml"
    },
    {
      "ingredient_id": "large-prawns-unpeeled",
      "item": "large prawns unpeeled",
      "quantity": 800,
      "unit": "g"
    },
    {
      "ingredient_id": "baguette-sliced-into-2cm-pieces",
      "item": "baguette sliced into 2cm pieces",
      "quantity": 1
    },
    {
      "ingredient_id": "smoked-paprika",
      "item": "smoked paprika",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "bunch-of-parsley",
      "item": "bunch of parsley",
      "unit": "small"
    },
    {
      "ingredient_id": "garlic-cloves-crushed",
      "item": "garlic cloves crushed",
      "quantity": 2
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra virgin olive oil",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "lemon-zested",
      "item": "lemon zested",
      "quantity": 1,
      "unit": "small"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Arrange the halved peppers in a baking dish and add the sliced garlic, 6 tablespoons of olive oil, and wine or vermouth."
    },
    {
      "step": 2,
      "text": "Roast the peppers until tender, then let them cool for 10 minutes. Peel away the skins and cut the peppers into strips.",
      "timer_minutes": 50
    },
    {
      "step": 3,
      "text": "Mix the parsley, crushed garlic, and lemon zest to make the gremolata; set aside briefly."
    },
    {
      "step": 4,
      "text": "Prepare the prawns by seasoning them with the smoked paprika and combining them with the roasted peppers and their cooking juices."
    },
    {
      "step": 5,
      "text": "Arrange the prawn mixture for baking and cook until the prawns are opaque and easily curled, reaching 145°F in the thickest part."
    },
    {
      "step": 6,
      "text": "Meanwhile, coat the baguette pieces with the remaining olive oil and sliced garlic. Bake until crisp, about 10 minutes, then rub with the whole peeled garlic clove.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Top the prawns and peppers with the gremolata, finish with lemon, and serve with the garlic toasts."
    }
  ],
