  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a skillet over medium-high heat. Add the ground turkey and brown sugar, breaking up the meat as it cooks, until browned, about 10 minutes. Drain any excess fat and transfer the turkey to a slow cooker.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the tomatoes, pumpkin, chili beans, seasoned black beans, onion, pumpkin pie spice, and chili powder. Stir until evenly combined."
    },
    {
      "step": 3,
      "text": "Cover and cook until the pumpkin is tender and the chili reaches 165°F in the center, about 3 hours.",
      "timer_minutes": 180
    }
  ],
