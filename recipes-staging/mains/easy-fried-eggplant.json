  "id": "easy-fried-eggplant",
  "name": "Easy Fried Eggplant",
  "subtitle": "Crisp, golden slices for a simple meal",
  "description": "Eggplant slices are dipped in beaten egg, coated with breadcrumbs, and fried until golden.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "eggplant",
      "item": "eggplant",
      "quantity": 1,
      "unit": "large",
      "preparation": "peeled and sliced"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Set the beaten eggs and dry bread crumbs in separate shallow dishes."
    },
    {
      "step": 2,
      "text": "Preheat a skillet over medium heat and add the canola oil."
    },
    {
      "step": 3,
      "text": "Dip each eggplant slice in the beaten eggs, then coat it evenly with dry bread crumbs."
    },
    {
      "step": 4,
      "text": "Fry the coated slices in the hot oil until golden brown, about 3 minutes, turning as needed.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Transfer the fried eggplant to a paper towel-lined plate to drain, then serve."
    }
  ],
