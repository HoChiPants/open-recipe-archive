  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a wok or large skillet over high heat. Add the ginger and pork, then stir in the soy sauces, salt, and sugar."
    },
    {
      "step": 2,
      "text": "Stir-fry for 10 minutes, turning the pork often, until it is tender and reaches 145°F internally. Rest the pork for 3 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Mix in the sesame oil, green onion, and Chinese rice wine. Simmer briefly until the pork is tender and the sauce is hot."
    }
