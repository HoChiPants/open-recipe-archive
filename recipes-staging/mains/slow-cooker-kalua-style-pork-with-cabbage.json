    "cook_minutes": 630
  },
  "ingredients": [
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "5-pound-bone-in-pork-shoulder-roast",
      "item": "(5 pound) bone-in pork shoulder roast",
      "quantity": 1
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "liquid-smoke-flavoring",
      "item": "liquid smoke flavoring",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
