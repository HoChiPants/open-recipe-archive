  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the salt, black pepper, and ginger. Rub the mixture evenly over the pork shoulder and place the roast in a slow cooker."
    },
    {
      "step": 2,
      "text": "Whisk together the soy sauce, Worcestershire sauce, and liquid smoke. Pour the mixture over the pork."
    },
    {
      "step": 3,
      "text": "Cover and cook until the pork is tender and reaches at least 145°F in the thickest part. Remove it from the heat and rest for 3 minutes.",
      "timer_minutes": 600
    },
    {
      "step": 4,
      "text": "Add the shredded cabbage around the pork. Cover and cook until the cabbage is tender.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Shred the pork, discarding the bone, and mix or serve it with the cabbage and cooking juices."
    }
  ],
