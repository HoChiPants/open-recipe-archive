  "id": "slow-cooker-kalua-style-pork-with-cabbage",
  "name": "Slow-Cooker Kalua-Style Pork with Cabbage",
  "subtitle": "Tender shredded pork with savory cabbage",
  "description": "A slow-cooked pork shoulder seasoned with ginger and pepper, finished with tender shredded cabbage.",
  "meal_type": "main",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
