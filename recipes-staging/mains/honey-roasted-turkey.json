  "id": "honey-roasted-turkey",
  "name": "Honey-Roasted Turkey",
  "subtitle": "A golden roast turkey with honey-butter glaze",
  "description": "A whole turkey is filled with aromatic fruit and vegetables, glazed with honey and butter, and roasted with stock until tender and safely cooked.",
