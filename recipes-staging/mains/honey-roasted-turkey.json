  "instructions": [
    {
      "step": 1,
      "text": "Pat the thawed turkey dry and season it inside and out with salt and black pepper. Place the lemon halves, apple, onion, and potato inside the cavity."
    },
    {
      "step": 2,
      "text": "Melt the honey and butter together, then brush the mixture over the turkey. Let it stand for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 4,
      "text": "Roast the turkey at 400°F for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Reduce the oven to 350°F. Roast for 30 minutes, add the chicken stock to the roasting pan, and continue roasting for up to 120 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Check the thickest part of the thigh with a food thermometer; the turkey is ready when it reaches 165°F. Let it stand for 15 minutes, then rest for 15 minutes before carving.",
      "timer_minutes": 15
    }
  ],
