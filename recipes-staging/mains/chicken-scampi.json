      "item": "dried oregano",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "boneless-chicken-breast-halves",
      "item": "boneless chicken breast halves",
      "quantity": 4,
      "preparation": "sliced lengthwise into thirds"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large skillet over medium heat. Add the olive oil."
    },
    {
      "step": 2,
      "text": "Stir together the parsley, basil, oregano, garlic, and salt, then add the mixture to the skillet. Stir in the lemon juice."
    },
    {
      "step": 3,
      "text": "Add the chicken pieces and cook for 3 minutes, turning to coat them in the seasoned fat.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Continue cooking until the chicken is cooked through and reaches 165°F in the thickest piece, about 15 minutes total cooking time.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Spoon the lemon-butter sauce over the chicken and serve hot."
    }
  ],
