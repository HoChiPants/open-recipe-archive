  "id": "chicken-scampi",
  "name": "Chicken Scampi",
  "subtitle": "Garlic-herb chicken in a lemon butter sauce",
  "description": "Tender sliced chicken breasts cooked with garlic, herbs, lemon juice, butter, and olive oil for a simple savory dinner.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "dried-parsley",
