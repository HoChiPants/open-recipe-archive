  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Pat the roast dry and season it with the divided salt, pepper, and garlic powder."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large oven-safe pot over medium-high heat. Brown the roast on all sides, about 4 minutes total, then transfer it to a plate.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Melt the butter in the pot. Add the onion, mushrooms, and carrots; cook until the butter is melted and the vegetables begin to soften, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the remaining garlic powder and the halved head of garlic for 1 minute. Add the red wine and scrape up any browned bits."
    },
    {
      "step": 5,
      "text": "Add the thyme, bay leaves, and Worcestershire. Return the roast to the pot and add enough beef broth to reach partway up the meat."
    },
    {
      "step": 6,
      "text": "Bring the liquid to a simmer, cover the pot, and braise in the oven for 2 hours, or until the beef is tender. Check that the thickest part reaches at least 145°F, then rest the roast for 3 minutes.",
      "timer_minutes": 120
    },
    {
      "step": 7,
      "text": "Remove the thyme stems, bay leaves, and garlic halves. Slice or break the beef into portions, spoon the vegetables and braising liquid over it, and garnish with parsley."
    }
  ],
