  "id": "braised-beef",
  "name": "Braised Beef",
  "subtitle": "Tender chuck with mushrooms, carrots, and herbs",
  "description": "A hearty beef braise with browned chuck, savory vegetables, red wine, broth, and fresh herbs.",
  "meal_type": "main",
  "cuisine": "American",
