  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Arrange the sliced aubergine on a baking tray, coat with half the rapeseed oil, and roast until tender and browned, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Meanwhile, heat the remaining oil in a large pan. Add the onions and ginger and cook until softened and lightly golden, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir the bulgur, bouillon powder, cumin seeds, and drained chickpeas into the onions. Add enough water according to the bulgur package directions, cover, and cook until the bulgur is tender and the liquid is absorbed."
    },
    {
      "step": 4,
      "text": "Fold the roasted aubergine and coriander through the pilaf. Top with the feta and toasted almonds, then serve hot."
    }
  ],
