  "id": "bulgur-and-aubergine-pilaf",
  "name": "Bulgur and Aubergine Pilaf",
  "subtitle": "A hearty grain pilaf with chickpeas, herbs, feta, and almonds",
  "description": "Roasted aubergine and chickpeas add substance to bulgur cooked with cumin, ginger, and softened onions, finished with coriander, feta, and toasted almonds.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
