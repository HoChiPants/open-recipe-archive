      "ingredient_id": "rapeseed-oil",
      "item": "rapeseed oil",
      "quantity": 4,
      "unit": "tsp"
    },
    {
      "ingredient_id": "onions-halved-and-thinly-sliced-about-280g",
      "item": "onions halved and thinly sliced (about 280g)",
      "quantity": 2,
      "preparation": "scrunched to separate the pieces"
    },
    {
      "ingredient_id": "finely-chopped-ginger",
      "item": "finely chopped ginger",
      "quantity": 1,
      "unit": "tbsp"
    },
