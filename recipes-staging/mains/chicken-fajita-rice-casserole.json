  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Place the rice in a baking dish and cook it for 4 minutes, then stir in the chopped cilantro and the zest and juice of the limes.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Combine the sliced chicken, bell peppers, red onion, fajita seasoning, olive oil, kosher salt, and ground black pepper until evenly coated."
    },
    {
      "step": 3,
      "text": "Spread the seasoned chicken and vegetables over the rice, pour the chicken broth evenly into the dish, and cover the rice as much as possible."
    },
    {
      "step": 4,
      "text": "Bake for 50 minutes, or until the rice is tender and the thickest chicken pieces reach 165°F on a food thermometer.",
      "timer_minutes": 50
    },
    {
      "step": 5,
      "text": "Rest briefly, then serve with the lime wedges."
    }
  ],
