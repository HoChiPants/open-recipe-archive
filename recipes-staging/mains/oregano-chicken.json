  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 6,
      "preparation": "boneless chicken breast halves"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the melted butter, lemon juice, Worcestershire sauce, soy sauce, dried oregano, and garlic powder together until smooth."
    },
    {
      "step": 3,
      "text": "Place the chicken in a baking dish and pour the sauce over it, turning the pieces to coat."
    },
    {
      "step": 4,
      "text": "Bake for 15 minutes, spoon some of the pan juices over the chicken, then bake for 15 minutes more, until the thickest piece reaches 165°F.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Transfer the chicken to a serving dish and spoon the remaining pan juices over it."
    }
  ],
