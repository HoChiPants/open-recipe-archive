  "id": "oregano-chicken",
  "name": "Oregano Chicken",
  "subtitle": "Baked chicken with lemon-herb pan juices",
  "description": "Chicken breasts bake in a buttery, savory oregano sauce brightened with lemon juice.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 7,
    "unit": "servings"
  },
