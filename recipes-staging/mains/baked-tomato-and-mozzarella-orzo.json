  "id": "baked-tomato-and-mozzarella-orzo",
  "name": "Baked Tomato and Mozzarella Orzo",
  "subtitle": "A simple oven-baked orzo with tomato, peppers, olives, and melted mozzarella.",
  "description": "Orzo bakes in a seasoned tomato mixture until tender, then is finished with mozzarella for a bubbling, satisfying meal.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "orzo",
      "item": "orzo",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": "1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "roasted-red-peppers-from-a-jar",
      "item": "roasted red peppers from a jar",
      "quantity": 2,
      "preparation": "roughly chopped"
    },
    {
      "ingredient_id": "handful-olives-roughly-chopped",
      "item": "handful olives roughly chopped"
    },
    {
      "ingredient_id": "big-pinch-chilli-flakes",
      "item": "big pinch chilli flakes"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "can-chopped-tomatoes-with-garlic-if-you-can-t-find-ready-mixed",
      "item": "can chopped tomatoes with garlic (if you can’t find ready mixed",
      "quantity": 400,
      "unit": "g",
      "preparation": "crush 1 garlic clove into a can of tomatoes)"
    },
    {
      "ingredient_id": "ball-mozzarella",
      "item": "ball mozzarella",
      "quantity": 125,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to a moderate baking temperature."
    },
    {
      "step": 2,
      "text": "Stir the orzo with the olive oil, roasted peppers, olives, chilli flakes, and oregano in a baking dish."
    },
    {
      "step": 3,
      "text": "Pour over the chopped tomatoes and mix until the orzo is evenly coated."
    },
    {
      "step": 4,
      "text": "Bake until the orzo is tender and the sauce is bubbling, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Stir the orzo, then let it stand briefly so the mixture can settle and finish absorbing the sauce.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Top with the mozzarella and return the dish to the oven until the cheese is melted."
    },
    {
      "step": 7,
      "text": "Serve hot."
    }
  ],
