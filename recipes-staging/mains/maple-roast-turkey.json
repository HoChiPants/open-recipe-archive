  "instructions": [
    {
      "step": 1,
      "text": "Combine the cider, maple syrup, and apple brandy in a saucepan. Bring to a boil, then cook until reduced and slightly thickened. Let cool."
    },
    {
      "step": 2,
      "text": "Mix the chopped thyme, marjoram, and lemon zest with the softened butter. Season with salt and pepper, then chill until firm enough to spread."
    },
    {
      "step": 3,
      "text": "Preheat the oven to 375°F. Pat the turkey dry and season inside and out. Rub the herb butter over the breast and legs and place the turkey in a roasting pan."
    },
    {
      "step": 4,
      "text": "Scatter the onion, celery, and carrots around the turkey. Add part of the broth to the pan and place the reserved neck and giblets alongside the vegetables. Add the remaining herbs and bay leaf."
    },
    {
      "step": 5,
      "text": "Roast for 30 minutes. Reduce the oven to 350°F and continue roasting, basting with the cider-maple mixture as needed, until the thickest part of the breast and thigh reaches 165°F.",
      "timer_minutes": 180
    },
    {
      "step": 6,
      "text": "Transfer the turkey to a carving board and rest for 30 minutes before carving.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Strain the pan drippings into a saucepan and add enough broth to make the desired gravy volume. Combine the maple syrup, butter, and flour until smooth, whisk into the drippings, and add the remaining broth."
    },
    {
      "step": 8,
      "text": "Stir until thickened, simmer for 10 minutes, and season with salt and pepper. Serve the gravy with the turkey.",
      "timer_minutes": 10
    }
  ],
