      "item": "garlic cloves grated",
      "quantity": 2
    },
    {
      "ingredient_id": "thumb-sized-piece-of-ginger-grated",
      "item": "thumb-sized piece of ginger grated"
    },
    {
      "ingredient_id": "coconut-milk",
      "item": "coconut milk",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "onion-finely-sliced",
      "item": "onion finely sliced",
      "quantity": 1
    },
    {
      "ingredient_id": "spring-greens-or-spinach",
      "item": "spring greens or spinach",
      "quantity": 250,
      "unit": "g",
      "preparation": "roughly chopped"
    },
    {
      "ingredient_id": "maple-syrup-or-honey",
      "item": "maple syrup or honey",
      "quantity": 1,
      "unit": "tsp"
    },
    {
