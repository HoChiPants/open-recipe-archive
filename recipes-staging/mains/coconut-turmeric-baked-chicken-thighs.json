  "id": "coconut-turmeric-baked-chicken-thighs",
  "name": "Coconut & Turmeric Baked Chicken Thighs",
  "subtitle": "Tender chicken in a warmly spiced coconut sauce",
  "description": "Seasoned chicken thighs bake with coconut milk, greens, onion, and a touch of sweetness, served over rice.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-thighs-skin-on",
      "item": "chicken thighs skin on",
      "quantity": "6-8",
      "preparation": "about 130g with bone in"
    },
    {
      "ingredient_id": "heaped-tsp-salt",
      "item": "heaped tsp salt",
      "quantity": 1
    },
    {
      "ingredient_id": "heaped-tsp-turmeric",
      "item": "heaped tsp turmeric",
      "quantity": 1
    },
    {
      "ingredient_id": "heaped-tsp-cumin",
      "item": "heaped tsp cumin",
      "quantity": 1
    },
    {
