      "item": "rice to serve",
      "quantity": 400,
      "unit": "g",
      "preparation": "cooked"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the chicken with the salt, turmeric, cumin, garlic, ginger, and coconut milk. Set aside for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 3,
      "text": "Combine the coconut milk, onion, greens, and maple syrup or honey in an ovenproof baking dish. Cook until the greens soften, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the chicken and coat it with the sauce. Bake for about 40 minutes, until the thickest thigh reaches 165°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Serve with the cooked rice."
    }
  ],
