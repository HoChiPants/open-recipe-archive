  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a saucepan over medium heat. Add the onion, celery, and fennel; cook for 5 minutes until softened.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the large grated garlic clove and pancetta. Cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the beans, tomatoes, tomato purée, stock, and vinegar. Stir well and simmer for 10 minutes until thickened.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Combine the basil, parsley, lemon zest, and half grated garlic clove in a small bowl."
    },
    {
      "step": 5,
      "text": "Remove the ragu from the heat and let it stand briefly, then stir in the herb mixture."
    },
    {
      "step": 6,
      "text": "Serve with the optional Parmesan and crusty bread."
    }
  ],
