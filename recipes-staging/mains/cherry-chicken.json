{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cherry-chicken",
  "name": "Cherry Chicken",
  "subtitle": "Tender chicken with a bright cherry-orange sauce",
  "description": "Chicken pieces are browned, baked until fully cooked, and finished in a thick cherry sauce with sliced orange and toasted almonds.",
  "meal_type": "main",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "4-pound-whole-chicken",
      "item": "(4 pound) whole chicken",
      "quantity": 1,
      "preparation": "cut into 8 pieces"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "all-purpose-flour-for-dusting",
      "item": "all-purpose flour for dusting",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "dark-cherries-packed-in-water",
      "item": "dark cherries packed in water",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, pitted"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "orange",
      "item": "orange",
      "quantity": 1,
      "preparation": "with peel, quartered and thinly sliced"
    },
    {
      "ingredient_id": "slivered-almonds",
      "item": "slivered almonds",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "toasted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Season the chicken with salt and pepper, then dust lightly with flour."
    },
    {
      "step": 3,
      "text": "Heat the oil in a large ovenproof skillet and sauté the chicken until browned on all sides."
    },
    {
      "step": 4,
      "text": "Transfer the skillet to the oven and bake until the chicken is tender and reaches 165°F at the thickest part, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Transfer the chicken to a plate. Heat the cherries and their liquid in the skillet, stir in the sugar, then blend in the cornstarch until smooth."
    },
    {
      "step": 6,
      "text": "Cook, stirring, until the sauce thickens."
    },
    {
      "step": 7,
      "text": "Return the chicken to the sauce and add the sliced orange and toasted almonds, turning the pieces to coat."
    },
    {
      "step": 8,
      "text": "Bake or gently heat for 10 minutes, until hot throughout, then serve.",
      "timer_minutes": 10
    }
  ],
