  "id": "slow-cooker-round-steak-with-vegetables",
  "name": "Slow Cooker Round Steak with Vegetables",
  "subtitle": "Tender beef with potatoes and carrots in a savory mushroom sauce",
  "description": "Round steak cooks slowly with vegetables, onion soup mix, and mushroom soup for a hearty six-serving meal.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 420
  },
  "ingredients": [
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 3,
      "preparation": "peeled and quartered"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 6,
      "preparation": "peeled and sliced into 1 inch pieces"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "boneless-round-steak",
      "item": "boneless round steak",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "dry-onion-soup-mix",
      "item": "dry onion soup mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Arrange the potatoes, carrots, and onion in the slow cooker."
    },
    {
      "step": 2,
      "text": "Cut the round steak into serving-size pieces and place them over the vegetables."
    },
    {
      "step": 3,
      "text": "Whisk together the mushroom soup, water, and onion soup mix, then pour the mixture over the steak and vegetables."
    },
    {
      "step": 4,
      "text": "Cover and cook on low for 7 hours, until the vegetables are tender and the steak reaches at least 145°F in the thickest piece. Let the steak rest for 3 minutes before serving.",
      "timer_minutes": 420
    }
  ],
