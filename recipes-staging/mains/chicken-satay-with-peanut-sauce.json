  "instructions": [
    {
      "step": 1,
      "text": "Whisk ½ cup coconut milk with the garlic, 1½ teaspoons brown sugar, 1 teaspoon curry powder, ½ teaspoon salt, and pepper. Add the chicken and turn to coat. Cover and refrigerate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Preheat a grill to medium-high heat. Thread the marinated chicken onto the soaked skewers."
    },
    {
      "step": 3,
      "text": "Combine the remaining coconut milk, chicken stock, peanut butter, ¼ cup brown sugar, 1 tablespoon curry powder, lime or lemon juice, soy sauce, and salt to taste in a saucepan."
    },
    {
      "step": 4,
      "text": "Bring the sauce to a simmer and cook, stirring, until smooth, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Grill the skewers for about 5 minutes per side, turning as needed, until the chicken reaches 165°F internally.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Serve the chicken satay with the warm peanut sauce."
    }
  ],
