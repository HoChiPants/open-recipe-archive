  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large skillet over medium-high heat. Add the onion, bell peppers, sausage, onion powder, and black pepper; cook for 2 minutes, stirring occasionally.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Add the frozen corn, seasoned salt, garlic powder, and MSG. Cook for about 7 minutes, stirring occasionally, until the corn is tender and the sausage reaches 160°F internally.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Stir everything together, taste for seasoning, and serve hot."
