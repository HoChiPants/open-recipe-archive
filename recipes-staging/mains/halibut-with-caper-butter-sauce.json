  "id": "halibut-with-caper-butter-sauce",
  "name": "Halibut with Caper Butter Sauce",
  "subtitle": "Pan-cooked halibut finished with garlic, capers, and white wine butter",
  "description": "Sear halibut steaks in olive oil, then build a quick white wine, garlic, butter, and caper sauce in the same pan.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "8-ounce-steaks-halibut",
      "item": "(8 ounce) steaks halibut",
      "quantity": 2
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "capers",
      "item": "capers",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "with liquid"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a skillet over medium-high heat. Season the halibut with salt and pepper, then place it in the skillet."
    },
    {
      "step": 2,
      "text": "Cook the halibut for 3 minutes per side, or until it reaches 145°F and flakes easily. Transfer it to a plate.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Pour the white wine into the skillet. Stir in the butter, garlic, and capers, scraping up any browned bits."
    },
    {
      "step": 4,
      "text": "Simmer the sauce for 1 minute, then season with salt and pepper.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Return the halibut to the skillet and coat it with the sauce. Serve immediately."
    }
  ],
