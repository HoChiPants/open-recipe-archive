  "id": "neck-bones-and-lima-beans",
  "name": "Neck Bones and Lima Beans",
  "subtitle": "Tender pork neck bones with seasoned lima beans",
  "description": "Pork neck bones are seasoned, browned, and simmered with lima beans, onion, and pepper for a hearty main dish.",
  "meal_type": "main",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
