  "instructions": [
    {
      "step": 1,
      "text": "Combine the garlic powder, onion powder, cayenne, sage, nutmeg, seasoned salt, and salt and pepper. Season the pork neck bones with the mixture."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large pot. Add the onion, red bell pepper, and the remaining seasoning mixture; cook until the vegetables begin to soften.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the neck bones and cook until browned. Add enough of the divided water to cover, bring to a boil, then simmer until the pork is tender and reaches at least 145°F; rest for 3 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Meanwhile, place the dried lima beans in a separate pot with the remaining divided water. Bring to a boil and cook until tender, then drain.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Add the drained lima beans to the pot with the neck bones. Bring the mixture back to a boil, then reduce the heat."
    },
    {
      "step": 6,
      "text": "Simmer until the beans and pork are fully tender and the flavors have combined.",
      "timer_minutes": 30
    }
  ],
