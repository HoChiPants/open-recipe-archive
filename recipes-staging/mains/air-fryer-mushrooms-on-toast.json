  "id": "air-fryer-mushrooms-on-toast",
  "name": "Air-Fryer Mushrooms on Toast",
  "subtitle": "Herbed mushrooms served over crisp sourdough",
  "description": "Air-fried mushrooms seasoned with thyme and garlic powder make a quick savory topping for toasted sourdough.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "chestnut-mushrooms-quartered-or-sliced",
      "item": "chestnut mushrooms quartered or sliced",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "a-few-thyme-sprigs-leaves-picked",
      "item": "a few thyme sprigs leaves picked"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "vegetable-oil-or-other-neutral-oil",
      "item": "vegetable oil or other neutral oil",
      "quantity": 1,
      "unit": "tbsp",
      "preparation": "plus extra for the bread"
    },
    {
      "ingredient_id": "slices-of-sourdough",
      "item": "slices of sourdough",
      "quantity": 2
    },
    {
      "ingredient_id": "garlic-clove-peeled-but-left-whole-optional",
      "item": "garlic clove peeled but left whole (optional)",
      "quantity": 1,
      "optional": true
    },
    {
      "ingredient_id": "handful-of-chopped-parsley",
      "item": "handful of chopped parsley (optional)",
      "unit": "small",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Toss the mushrooms with the thyme leaves, garlic powder, oil, and the optional whole garlic clove."
    },
    {
      "step": 2,
      "text": "Preheat the air fryer according to its instructions, then arrange the mushrooms in the basket."
    },
    {
      "step": 3,
      "text": "Air-fry the mushrooms for 15 minutes, shaking the basket halfway through, until browned and tender.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Toast the sourdough and brush or drizzle with the extra oil. Rub with the optional garlic clove if desired."
    },
    {
      "step": 5,
      "text": "Spoon the mushrooms over the toast and finish with the optional parsley."
    }
  ],
