  "id": "shrimp-alfredo-pasta",
  "name": "Shrimp Alfredo Pasta",
  "subtitle": "Creamy pasta with seasoned shrimp and vegetables",
  "description": "Angel hair pasta and tender shrimp come together with Alfredo sauce, bell pepper, onion, garlic powder, and cumin for a simple skillet-style main dish.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
