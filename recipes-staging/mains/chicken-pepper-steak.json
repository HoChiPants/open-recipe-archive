  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large skillet over medium-high heat. Season the chicken breasts with the seasoning salt and onion powder, then add them to the skillet with the onion."
    },
    {
      "step": 2,
      "text": "Cook for 7 minutes, turning as needed, until the chicken is browned.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Add the garlic, onion powder, and half of the soy sauce. Stir to coat the chicken and onion."
    },
    {
      "step": 4,
      "text": "Whisk the cornstarch with the water and remaining soy sauce until smooth. Pour the mixture into the skillet."
    },
    {
      "step": 5,
      "text": "Stir in the green bell pepper and tomatoes. Bring the sauce to a simmer and cook until thickened and the chicken reaches 165°F in the center."
    }
  ],
