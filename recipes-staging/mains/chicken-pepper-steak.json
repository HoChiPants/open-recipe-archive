  "id": "chicken-pepper-steak",
  "name": "Chicken Pepper Steak",
  "subtitle": "Skillet chicken with peppers, tomatoes, and savory sauce",
  "description": "Tender chicken breasts simmer with onion, bell pepper, tomatoes, garlic, and soy sauce for a hearty one-pan main dish.",
  "meal_type": "main",
