  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Heat the vegetable oil in a large oven-safe pot over medium-high heat."
    },
    {
      "step": 2,
      "text": "Sear the beef pot roast in the hot oil for 3 minutes, turning as needed.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Mix the brown sugar, salt, dry mustard, and black pepper. Coat the roast with the mixture."
    },
    {
      "step": 4,
      "text": "Arrange the potatoes, carrots, and onion around the roast. Add the vinegar and water."
    },
    {
      "step": 5,
      "text": "Cover the pot and roast for 4 hours, or until the thickest part of the beef reaches 145°F.",
      "timer_minutes": 240
    },
    {
      "step": 6,
      "text": "Transfer the roast to a board and rest for at least 3 minutes before slicing. Serve with the vegetables.",
      "timer_minutes": 3
    }
  ],
