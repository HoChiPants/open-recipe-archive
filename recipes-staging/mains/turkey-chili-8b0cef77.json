  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. Add the green bell peppers, onion, garlic, habanero, red pepper flakes, and black pepper; cook until the onion begins to soften."
    },
    {
      "step": 2,
      "text": "Add the ground turkey and cook, breaking it up, until browned and it reaches 165°F in the center.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the hot chocolate mix, chili powder, paprika, cumin, oregano, seasoned salt, tomatoes, kidney beans, tomato sauce, Worcestershire sauce, liquid smoke, hot pepper sauce, and beer."
    },
    {
      "step": 4,
      "text": "Bring the chili to a gentle simmer, then cook, stirring occasionally, to blend the flavors.",
      "timer_minutes": 50
    },
    {
      "step": 5,
      "text": "Stir in the corn and continue simmering.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Remove from the heat and let cool briefly before serving."
    }
  ],
