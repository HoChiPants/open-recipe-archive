  "id": "spicy-peach-glazed-pork-chops",
  "name": "Spicy Peach-Glazed Pork Chops",
  "subtitle": "Tender pork chops with a sweet, chile-spiced glaze",
  "description": "Pork chops are browned, finished with white wine, and coated in a quick peach glaze before baking.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "peach-preserves",
      "item": "peach preserves",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "chile-paste",
      "item": "chile paste",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "boneless-pork-chops",
      "item": "boneless pork chops",
      "quantity": 4
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Stir the peach preserves, Worcestershire sauce, and chile paste together."
    },
    {
      "step": 2,
      "text": "Season the pork chops with ginger, cinnamon, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil in an oven-safe skillet over medium-high heat. Add the chops and cook until lightly browned, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir the white wine into the skillet, then stir in the peach-preserve mixture. Turn the chops to coat them with the sauce."
    },
    {
      "step": 5,
      "text": "Transfer the skillet to the oven and bake until the pork reaches 145°F at the thickest point. Rest for 3 minutes before serving.",
      "timer_minutes": 8
    }
  ],
