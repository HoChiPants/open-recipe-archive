  "instructions": [
    {
      "step": 1,
      "text": "Combine 0.5 cup rice vinegar, onion, garlic, kosher salt, 1 tablespoon Chinese five-spice powder, red pepper flakes, bay leaves, ribs, and sambal oelek in a pot. Add enough water to cover the ribs."
    },
    {
      "step": 2,
      "text": "Bring the pot to a simmer, then cook the ribs until tender, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Heat the oven to 375°F. Whisk the soy sauce, 1.5 tablespoons rice vinegar, sambal oelek, Dijon mustard, ketchup, honey, brown sugar, and 0.5 teaspoon Chinese five-spice powder into a glaze."
    },
    {
      "step": 4,
      "text": "Transfer the ribs to a baking dish and coat them with the glaze."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until the pork reaches at least 145°F in the thickest part. Rest for 3 minutes before serving.",
      "timer_minutes": 15
    }
  ],
