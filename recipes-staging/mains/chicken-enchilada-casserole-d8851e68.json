    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "cooked, boneless chicken breast halves, chopped"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 8,
      "unit": "ounces"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salsa",
      "item": "salsa",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "green-chiles",
      "item": "green chiles",
      "quantity": 1,
      "unit": "can",
      "preparation": "4 ounce, diced"
    },
    {
      "ingredient_id": "monterey-jack-cheese",
      "item": "Monterey Jack cheese",
      "quantity": 4,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "8-inch-flour-tortillas",
      "item": "(8 inch) flour tortillas",
      "quantity": 12
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir together the condensed soup, sour cream, chopped green onions, and diced green chiles."
    },
    {
      "step": 3,
      "text": "Combine the chopped chicken with the salsa, green onions, and green chiles."
    },
    {
      "step": 4,
      "text": "Arrange tortillas in a baking dish, then layer with portions of the chicken mixture, soup mixture, salsa, and shredded cheese. Repeat the layers, finishing with tortillas and the remaining cheese as directed by the available ingredients."
    },
    {
      "step": 5,
      "text": "Bake for 55 minutes, until the casserole is hot throughout and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 55
    },
    {
      "step": 6,
      "text": "Add the remaining Monterey Jack cheese and bake until melted.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Let the casserole stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
