  "id": "chicken-enchilada-casserole-d8851e68",
  "name": "Chicken Enchilada Casserole",
  "subtitle": "A layered casserole with chicken, salsa, chiles, and melted cheese.",
  "description": "Layer tortillas with seasoned chicken, creamy soup mixture, salsa, and cheese, then bake until hot and fully set.",
  "meal_type": "main",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
