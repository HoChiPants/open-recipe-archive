  "id": "sweet-cucumber-relish",
  "name": "Sweet Cucumber Relish",
  "subtitle": "A crisp, tangy relish for generous batch cooking",
  "description": "Cucumbers and onions are salted, drained, and combined with a spiced vinegar mixture before being portioned into jars.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 128,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 40,
    "inactive_minutes": 480
  },
  "ingredients": [
    {
      "ingredient_id": "english-cucumbers",
      "item": "English cucumbers",
      "quantity": 7,
      "unit": "large"
    },
    {
      "ingredient_id": "sweet-onions",
      "item": "sweet onions",
      "quantity": 4,
      "unit": "large",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "pickling-salt",
      "item": "pickling salt",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-turmeric",
      "item": "ground turmeric",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "celery-seed",
      "item": "celery seed",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ning-jars-with-lids-and-rings",
      "item": "ning jars with lids and rings",
      "quantity": 4,
      "unit": "can",
      "preparation": "1 pint"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Finely chop the cucumbers and peeled onions, combine them in a large bowl, and toss with the pickling salt. Cover and refrigerate for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Drain the vegetables thoroughly, rinse them, and drain again. Prepare the jars, lids, and rings in boiling water for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the flour, turmeric, ginger, celery seed, and 2 cups of the sugar in a saucepan."
    },
    {
      "step": 4,
      "text": "Add the vinegar and water, then whisk in the remaining sugar until smooth."
    },
    {
      "step": 5,
      "text": "Stir in the drained vegetables and bring the mixture to a simmer. Cook for 15 minutes, stirring occasionally, until thickened.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Transfer the hot relish to the prepared pint jars, leaving the jar contents arranged for processing, and secure the lids and rings."
    },
    {
      "step": 7,
      "text": "Place the filled jars in boiling water and simmer for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Transfer the jars out of the water and let them cool completely."
    }
  ],
