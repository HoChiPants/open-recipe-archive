  "instructions": [
    {
      "step": 1,
      "text": "Place the pork shoulder in a large container. Add the water, white vinegar, and kosher salt, adding liquid as needed to cover the pork. Cover and refrigerate for 12 hours.",
      "timer_minutes": 720
    },
    {
      "step": 2,
      "text": "Drain the pork and place it in a slow cooker with the onion wedges."
    },
    {
      "step": 3,
      "text": "Combine the ground cumin, ground mustard, chili powder, and brown sugar, then coat the pork evenly with the mixture."
    },
    {
      "step": 4,
      "text": "Cover and cook on low until the pork is fork-tender and reaches at least 145°F internally. Rest for 3 minutes.",
      "timer_minutes": 480
    },
    {
      "step": 5,
      "text": "Shred the pork with forks and serve."
    }
  ],
