  "id": "slow-cooked-pulled-pork-shoulder",
  "name": "Slow-Cooked Pulled Pork Shoulder",
  "subtitle": "Tender, spice-rubbed pork for easy serving",
  "description": "Pork shoulder is soaked, seasoned with warm spices and brown sugar, then slow-cooked with onion until tender enough to shred.",
  "meal_type": "main",
