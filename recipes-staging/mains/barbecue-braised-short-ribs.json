  "id": "barbecue-braised-short-ribs",
  "name": "Barbecue-Braised Short Ribs",
  "subtitle": "Tender beef ribs in a savory barbecue sauce",
  "description": "Browned beef short ribs are braised with vegetables, tomato sauce, barbecue sauce, and broth until tender.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lean-beef-short-ribs",
      "item": "lean beef short ribs",
      "quantity": 5,
      "unit": "pounds",
      "preparation": "cut into 3-inch pieces"
    },
    {
      "ingredient_id": "fresh-ground-black-pepper",
      "item": "fresh ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "cut into thick slices and separated into rings"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 5,
      "preparation": "peeled and cut into chunks"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "coarsely chopped"
    },
    {
      "ingredient_id": "tomato-sauce",
      "item": "tomato sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "barbeque-sauce",
      "item": "barbeque sauce",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "beef-broth",
      "item": "beef broth",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large ovenproof pot over medium-high heat. Season the short ribs with black pepper, add them to the pot, and brown for 5 minutes. Transfer the ribs to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the onion and carrots to the pot and cook the onion for 8 minutes, stirring occasionally. Add the garlic and cook for 1 minute.",
      "timer_minutes": 9
    },
    {
      "step": 4,
      "text": "Stir in the tomato sauce, barbecue sauce, and beef broth. Blend the sauce for 1 minute, then return the ribs to the pot.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Cover and bake until the ribs are tender, about 120 minutes. Check that the thickest pieces reach at least 145°F, then rest for 3 minutes before serving.",
      "timer_minutes": 120
    }
  ],
