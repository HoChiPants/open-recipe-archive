  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the mushrooms, cumin, and black pepper. Sauté for 5 minutes, until lightly browned.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the onion and garlic, then sauté for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the bay scallops and stir for about 3 minutes, until opaque and cooked through.",
      "timer_minutes": 3
    }
