  "id": "saute-ed-mushrooms-and-scallops",
  "name": "Sautéed Mushrooms and Scallops",
  "subtitle": "Tender bay scallops with seasoned mushrooms",
  "description": "A quick skillet main dish combining browned mushrooms, aromatics, and bay scallops in butter.",
  "meal_type": "main",
  "cuisine": "American",
