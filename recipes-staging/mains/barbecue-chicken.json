  "id": "barbecue-chicken",
  "name": "Barbecue Chicken",
  "subtitle": "Vinegar-marinated grilled chicken with barbecue glaze",
  "description": "Chicken halves are chilled in a tangy garlic marinade, seasoned with a spiced rub, then grilled and finished with barbecue sauce.",
  "meal_type": "main",
