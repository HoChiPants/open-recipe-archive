  "instructions": [
    {
      "step": 1,
      "text": "Whisk the rice vinegar, 2 tablespoons barbecue sauce, and crushed garlic in a large bowl. Coat the chicken halves with the mixture, cover, and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Preheat the grill. Combine the salt, black pepper, paprika, onion powder, and cayenne pepper, then season the chicken evenly."
    },
    {
      "step": 3,
      "text": "Grill the chicken for 4 minutes, then turn and brush with the remaining barbecue sauce. Continue grilling, turning and brushing as needed, until the thickest parts reach 165°F.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Rest the chicken briefly before serving."
    }
  ],
