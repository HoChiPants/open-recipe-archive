  "id": "mongolian-beef-and-spring-onions",
  "name": "Mongolian Beef and Spring Onions",
  "subtitle": "Crisp beef in a savory ginger-garlic sauce",
  "description": "Thinly sliced flank steak is coated with cornstarch, quickly fried, and finished with a sweet soy sauce, garlic, ginger, and green onions.",
  "meal_type": "main",
  "cuisine": "Asian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "finely-chopped-garlic",
      "item": "finely chopped garlic",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "grated-fresh-ginger-root",
      "item": "grated fresh ginger root",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dark-brown-sugar",
      "item": "dark brown sugar",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "beef-flank-steak",
      "item": "beef flank steak",
      "quantity": 1,
      "unit": "pound",
      "preparation": "sliced 1/4 inch thick on the diagonal"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "bunches-green-onions",
      "item": "bunches green onions",
      "quantity": 2,
      "preparation": "cut in 2-inch lengths"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the 2 teaspoons vegetable oil in a saucepan. Add the garlic and ginger and stir briefly until fragrant."
    },
    {
      "step": 2,
      "text": "Stir in the brown sugar, soy sauce, and water. Bring the sauce to a simmer and cook for 4 minutes, then remove it from the heat and set aside.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Toss the sliced flank steak with the cornstarch until evenly coated. Let it stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Heat the frying oil to 375°F in a deep, heavy pot or skillet. Fry the beef in batches for 2 minutes, or until crisp and the thickest pieces reach 145°F.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Transfer the beef to a rack or paper towels to drain. Carefully discard or reserve the frying oil, leaving the pan ready for finishing."
    },
    {
      "step": 6,
      "text": "Return the sauce to the pan and add the fried beef. Stir to coat, then add the green onions and cook for 2 minutes, until heated through and tender-crisp.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Rest the beef for 3 minutes, then serve.",
      "timer_minutes": 3
    }
  ],
