  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large pot over medium heat. Add the pork and cook, stirring occasionally, for 15 minutes, until browned and cooked through; verify whole pork pieces reach 145°F, then rest for 3 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Sprinkle in the flour and stir until the pork is evenly coated."
    },
    {
      "step": 3,
      "text": "Add the green chiles, jalapeños, onion, onion salt, garlic salt, and salt and black pepper. Stir in the tomato sauce and water."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a simmer, then cook for 30 minutes, stirring occasionally.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Continue cooking for 10 minutes, until the pork is tender and the broth is slightly thickened.",
      "timer_minutes": 10
    }
  ],
