  "id": "pork-green-chile-stew",
  "name": "Pork Green Chile Stew",
  "subtitle": "Tender pork simmered with green chiles and tomato",
  "description": "A savory pork stew with green chiles, jalapeños, onion, and a lightly thickened tomato broth.",
  "meal_type": "main",
  "cuisine": "Mexican",
