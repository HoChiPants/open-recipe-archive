  "id": "chicken-cordon-bleu-lasagna",
  "name": "Chicken Cordon Bleu Lasagna",
  "subtitle": "Creamy layered lasagna with chicken, ham, and Swiss cheese",
  "description": "Tender noodles are layered with a smooth Swiss cheese sauce, cooked chicken, and chopped ham, then finished with seasoned crumbs and baked until bubbling and hot.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
