  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Bring a large pot of salted water to a simmer, cook the lasagna noodles for 8 minutes, then drain.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan over medium heat. Whisk in the softened cream cheese, salt, onion powder, and pepper, then gradually whisk in the warm milk until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the Swiss cheese and simmer gently, stirring, until melted and creamy, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Spread some sauce in a baking dish. Layer in noodles, sauce, chicken, and ham, repeating until the ingredients are used. Finish with sauce, bread crumbs, and Italian seasoning."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, then continue baking until the crumb topping is lightly browned and the center reaches 165°F, about 10 minutes more.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Let the lasagna stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
