  "id": "ground-sausage-spaghetti",
  "name": "Ground Sausage Spaghetti",
  "subtitle": "Spaghetti with savory sausage and melted cheese",
  "description": "A simple skillet sauce of browned sausage, vegetables, tomatoes, and Italian seasoning tossed with spaghetti and finished with Parmesan and mozzarella.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
