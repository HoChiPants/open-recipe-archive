      "ingredient_id": "spaghetti",
      "item": "spaghetti",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "ground-sausage",
      "item": "ground sausage",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 0.5,
      "preparation": "chopped"
    },
