      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "shredded, or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the spaghetti in boiling water until tender, about 12 minutes. Drain.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Cook the ground sausage in a large skillet for about 7 minutes, breaking it up as it browns. Drain excess fat and verify it reaches 160°F.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Stir in the onion, green bell pepper, and margarine. Cook until the onion softens, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the tomatoes, tomato sauce, and Italian seasoning. Bring the mixture to a simmer and heat through."
    },
    {
      "step": 5,
      "text": "Stir the drained spaghetti and Parmesan into the sauce. Add the mozzarella and serve when melted."
    }
  ],
