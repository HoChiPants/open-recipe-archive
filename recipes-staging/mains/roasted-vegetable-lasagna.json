  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F and coat a baking sheet with olive oil cooking spray."
    },
    {
      "step": 2,
      "text": "Arrange the zucchini, bell peppers, mushrooms, and onion on the sheet. Combine the basil and garlic, then toss them with the vegetables, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Roast until the vegetables are lightly browned.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Bring salted water to a boil. Cook the lasagna noodles until boiling and tender, about 8 minutes, then drain.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Warm the pasta sauce gently. Combine the mozzarella and Parmesan."
    },
    {
      "step": 6,
      "text": "Spread sauce in a baking dish. Layer noodles, sauce, roasted vegetables, and the cheese mixture, repeating as needed and finishing with sauce and cheese."
    },
    {
      "step": 7,
      "text": "Bake until the cheese is melted and the lasagna is heated through.",
      "timer_minutes": 25
    },
    {
      "step": 8,
      "text": "Let the lasagna rest before slicing and serving.",
      "timer_minutes": 10
    }
  ],
