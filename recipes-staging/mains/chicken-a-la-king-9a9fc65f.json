  "name": "Chicken à la king",
  "subtitle": "Creamy chicken with peppers, mushrooms, and rice",
  "description": "Cooked chicken and vegetables simmer in a paprika- and sherry-seasoned cream sauce, then serve over rice.",
  "meal_type": "main",
