  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large pan. Add the mushrooms and sauté for 6 minutes, until softened and lightly browned.",
      "timer_minutes": 6
    },
    {
      "step": 2,
      "text": "Set the roasted red peppers aside. Melt the butter in the pan, add the onion and green pepper, and cook for 10 minutes until tender.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the paprika, mustard, and sherry; cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the mushrooms, cooked chicken, and stock. Bring the mixture to a simmer and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Whisk in the cream and roasted red peppers. Simmer for 3 minutes. If reheating chilled chicken, ensure the center reaches 165°F.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Stir in the lemon juice and serve over the cooked rice."
    }
  ],
