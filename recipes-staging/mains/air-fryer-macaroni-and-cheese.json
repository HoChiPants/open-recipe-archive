{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "air-fryer-macaroni-and-cheese",
  "name": "Air-Fryer Macaroni and Cheese",
  "subtitle": "Creamy cheese sauce with a crisp breadcrumb topping",
  "description": "A compact baked macaroni and cheese finished in the air fryer for a browned, crunchy top.",
  "meal_type": "main",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "macaroni",
      "item": "macaroni",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 30,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 30,
      "unit": "g"
    },
    {
      "ingredient_id": "mature-cheddar-grated",
      "item": "mature cheddar grated",
      "quantity": 65,
      "unit": "g"
    },
    {
      "ingredient_id": "english-mustard",
      "item": "English mustard",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "panko-breadcrumbs",
      "item": "panko breadcrumbs",
      "quantity": 30,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the macaroni until just set, then drain."
    },
    {
      "step": 2,
      "text": "Warm the whole milk in a microwave-safe container."
    },
    {
      "step": 3,
      "text": "Melt the butter, add the plain flour, and cook together for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Gradually add the warm milk, stirring until the sauce is smooth and thickened."
    },
    {
      "step": 5,
      "text": "Preheat the air fryer for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Stir the mature cheddar grated and English mustard into the sauce until melted, then combine the sauce with the macaroni."
    },
    {
      "step": 7,
      "text": "Transfer the mixture to an air-fryer-safe dish and cover with the panko breadcrumbs."
    },
    {
      "step": 8,
      "text": "Air-fry for about 20 minutes, until bubbling and the topping is golden.",
      "timer_minutes": 20
    }
  ],
