  "instructions": [
    {
      "step": 1,
      "text": "Mix the flour, finely chopped fenugreek or coriander, and ground fenugreek. Add enough lukewarm milk to form a soft dough, then knead until smooth. Cover and rest for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Heat the ghee in a large pot. Add the chopped onions and cumin seeds; cook until the onions soften and color lightly."
    },
    {
      "step": 3,
      "text": "Stir in the cardamom, ginger, garlic, green chillies, cinnamon, ground coriander, ground ginger, Kashmiri chilli powder, anardana, and chopped coriander leaves.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the tomatoes and tomato purée. Cook until the tomatoes break down and the mixture thickens.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Pour in the brewed tea. Add the chickpeas and turmeric, then season with kala namak and black pepper. Simmer until the chickpeas are tender and the curry is well flavored.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Divide the dough into portions and roll each on a lightly floured surface into a thick round."
    },
    {
      "step": 7,
      "text": "Heat the sunflower oil in a deep, heavy pot to 350°F. Fry the dough rounds one at a time, turning once, until puffed and golden. Drain carefully."
    },
    {
      "step": 8,
      "text": "Serve the channa with the bhatura, sliced red onion, yogurt, and extra coriander."
    }
  ],
