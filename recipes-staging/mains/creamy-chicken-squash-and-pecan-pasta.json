  "id": "creamy-chicken-squash-and-pecan-pasta",
  "name": "Creamy Chicken, Squash and Pecan Pasta",
  "subtitle": "A one-pot pasta with tender chicken and creamy squash",
  "description": "Chicken and butternut squash cook with pasta in stock, then finish with cream cheese, pecans, parsley, and Parmesan.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "l-chicken-stock",
      "item": "l chicken stock",
      "quantity": 1
    },
    {
      "ingredient_id": "butternut-squash-peeled-and-chopped-into-small-chunks",
      "item": "butternut squash peeled and chopped into small chunks",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "chicken-breasts",
      "item": "chicken breasts",
      "quantity": 2
    },
    {
      "ingredient_id": "pasta-we-used-casarecce",
      "item": "pasta (we used casarecce)",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "pecans-chopped-optional",
      "item": "pecans chopped",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "pack-flat-leaf-parsley-chopped",
      "item": "pack flat-leaf parsley chopped",
      "unit": "small"
    },
    {
      "ingredient_id": "parmesan-grated",
      "item": "parmesan grated",
      "quantity": 25,
      "unit": "g",
      "preparation": "plus extra to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken stock and squash in a large pot. Add the chicken breasts and bring to a gentle simmer; cook for 15 minutes, or until the chicken reaches 165°F internally.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Transfer the chicken to a plate. Add the pasta to the stock and squash, then cook until the pasta is tender."
    },
    {
      "step": 3,
      "text": "Shred the chicken. Mash some of the softened squash into the cooking liquid, then stir in the cream cheese, chopped pecans, parsley, and grated Parmesan."
    },
    {
      "step": 4,
      "text": "Return the shredded chicken to the pot and stir to combine. Serve with extra Parmesan."
    }
  ],
