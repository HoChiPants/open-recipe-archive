  "id": "chicken-in-a-pot",
  "name": "Chicken in a Pot",
  "subtitle": "Tender chicken with mushrooms in a savory tomato broth",
  "description": "Breaded chicken breasts are browned briefly, then simmered with mushrooms in a seasoned tomato broth.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
