      "item": "fresh sliced mushrooms",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the chicken broth, tomato paste, pepper, oregano, salt, and garlic together in a bowl."
    },
    {
      "step": 2,
      "text": "Coat the chicken breast halves with the seasoned broth mixture, then press them into the bread crumbs."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a large pot over medium-high heat. Add the chicken and cook until lightly browned, about 2 minutes per side.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the mushrooms and any remaining seasoned broth mixture. Cover, reduce the heat, and cook until the chicken reaches 165°F in the thickest part and the mushrooms are tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Transfer the chicken and mushrooms to plates and spoon the broth over them. Serve hot."
    }
  ],
