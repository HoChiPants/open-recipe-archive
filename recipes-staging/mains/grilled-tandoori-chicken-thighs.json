  "instructions": [
    {
      "step": 1,
      "text": "Stir the yogurt, salt, ginger, black pepper, and cloves together. Combine the garlic, paprika, cumin, cinnamon, and coriander, then stir the spice mixture into the yogurt."
    },
    {
      "step": 2,
      "text": "Transfer the chicken thighs to the marinade and turn to coat. Cover and refrigerate for 480 minutes.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Preheat the grill and prepare the chicken thighs by removing excess marinade. Lightly coat the grill grates with olive oil spray."
    },
    {
      "step": 4,
      "text": "Grill the chicken thighs for 2 minutes, turn, and cook for 2 minutes more. Continue grilling until browned and the thickest pieces reach 165°F.",
      "timer_minutes": 40
    }
  ],
