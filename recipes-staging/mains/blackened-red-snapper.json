  "instructions": [
    {
      "step": 1,
      "text": "Combine the paprika, salt, onion powder, garlic powder, cayenne, white pepper, black pepper, thyme, and oregano in a bowl."
    },
    {
      "step": 2,
      "text": "Preheat a heavy skillet over medium-high heat for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Dip each snapper fillet in the melted butter, then coat it evenly with the spice mixture."
    },
    {
      "step": 4,
      "text": "Place the fillets in the hot skillet and cook for about 5 minutes on the first side.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Turn the fillets and cook for about 2 minutes, then continue until the fish reaches 145°F and flakes easily.",
      "timer_minutes": 2
    }
  ],
