  "instructions": [
    {
      "step": 1,
      "text": "Combine the cucumber, tomatoes, red onion, serrano peppers, cilantro, and pepper. Add half the salt and set aside."
    },
    {
      "step": 2,
      "text": "Juice the limes and combine the juice with the remaining salt and pepper."
    },
    {
      "step": 3,
      "text": "Bring a pot of water to a simmer, then add the shrimp and cook until opaque and easily flaked, or until they reach 145°F.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Drain and cool the shrimp briefly, then cut it into bite-size pieces."
    },
    {
      "step": 5,
      "text": "Toss the shrimp with the lime mixture and chill for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Fold in the reserved vegetable mixture and avocado, then serve chilled."
    }
  ],
