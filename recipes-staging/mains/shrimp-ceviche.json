  "id": "shrimp-ceviche",
  "name": "Shrimp Ceviche",
  "subtitle": "Citrus-marinated shrimp with crisp vegetables and avocado",
  "description": "Briefly cook shrimp, then combine it with lime, fresh vegetables, cilantro, and avocado for a bright chilled main dish.",
  "meal_type": "main",
  "cuisine": "American",
