  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Pat the chicken dry. Rub it with 1 tablespoon butter and season with salt and pepper."
    },
    {
      "step": 3,
      "text": "Place the onion, celery, lemon, and sliced garlic inside the chicken cavity, then set the chicken breast-side up in a roasting pan."
    },
    {
      "step": 4,
      "text": "Melt the 2 tablespoons butter and stir in the dried parsley and Italian herb seasoning. Brush the mixture over the chicken."
    },
    {
      "step": 5,
      "text": "Roast at 450°F for 20 minutes. Baste the chicken with the pan juices and herb butter, then roast for 10 minutes more.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Reduce the oven temperature to 325°F and continue roasting for 60 minutes, or until a thermometer inserted into the thickest part of the breast and thigh reads 165°F.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Let the chicken rest for 10 minutes before carving and serving.",
      "timer_minutes": 10
    }
  ],
