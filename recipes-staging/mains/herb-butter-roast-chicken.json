  "id": "herb-butter-roast-chicken",
  "name": "Herb-Butter Roast Chicken",
  "subtitle": "Crisp-skinned chicken with aromatic citrus and herbs",
  "description": "A whole chicken is seasoned with butter, filled with fresh aromatics, coated in herb butter, and roasted in stages until fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
