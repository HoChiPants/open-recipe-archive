  "id": "fettuccine-alfredo-with-ham",
  "name": "Fettuccine Alfredo with Ham",
  "subtitle": "Creamy pasta with savory diced ham",
  "description": "Tender fettuccine is tossed with a Parmesan cream sauce and cooked ham for a simple Italian-inspired main dish.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "dry-fettuccine-pasta",
      "item": "dry fettuccine pasta",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ham",
      "item": "ham",
      "quantity": 6,
      "unit": "ounces",
      "preparation": "diced cooked"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of water to a simmer. Add the fettuccine and cook for 10 minutes, or until tender. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat. Add the diced ham and stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Pour in the heavy cream and bring it to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Stir in the Parmesan until the sauce thickens."
    },
    {
      "step": 5,
      "text": "Add the drained fettuccine and toss until evenly coated. Serve hot."
    }
  ],
