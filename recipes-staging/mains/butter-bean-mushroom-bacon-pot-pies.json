  "id": "butter-bean-mushroom-bacon-pot-pies",
  "name": "Butter Bean, Mushroom & Bacon Pot Pies",
  "subtitle": "A creamy vegetable-and-bean filling baked until bubbling",
  "description": "Smoky bacon, mushrooms, butter beans, and kale combine in a mustardy crème fraîche sauce for a warming baked main dish.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "rapeseed-oil",
      "item": "rapeseed oil",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "red-onions-thinly-sliced",
      "item": "red onions thinly sliced",
      "quantity": 2
    },
    {
      "ingredient_id": "mushrooms-thickly-sliced",
      "item": "mushrooms thickly sliced",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "smoked-streaky-bacon-sliced-into-thin-strips",
      "item": "smoked streaky bacon sliced into thin strips",
      "quantity": 70,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "low-salt-vegetable-stock",
      "item": "low-salt vegetable stock",
      "quantity": 500,
      "unit": "ml"
    },
    {
      "ingredient_id": "kale-roughly-sliced",
      "item": "kale roughly sliced",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "wholegrain-mustard",
      "item": "wholegrain mustard",
      "quantity": 3,
      "unit": "tsp"
    },
    {
      "ingredient_id": "reduced-fat-cre-me-frai-che",
      "item": "reduced-fat crème fraîche",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "finely-chopped-tarragon",
      "item": "finely chopped tarragon",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "lemon-zested-and-juiced",
      "item": "lemon zested and juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "x-400g-cans-butter-beans-drained-and-rinsed",
      "item": "x 400g cans butter beans drained and rinsed",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a large ovenproof pan. Add the onions, mushrooms, and bacon, then cook until the vegetables soften and the bacon is thoroughly cooked.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the flour and cook briefly. Gradually add the stock, stirring until the sauce thickens.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Mix in the kale, mustard, crème fraîche, tarragon, lemon zest and juice, and butter beans. Cook until the kale wilts and the filling is hot.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Divide the filling among four ovenproof dishes if needed, or leave it in the pan. Bake until bubbling and lightly browned.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Let the pot pies cool briefly before serving."
    }
  ],
