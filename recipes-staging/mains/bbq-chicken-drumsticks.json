  "id": "bbq-chicken-drumsticks",
  "name": "BBQ Chicken Drumsticks",
  "subtitle": "Tender drumsticks with a tangy homemade barbecue glaze",
  "description": "Seasoned chicken drumsticks are rested, grilled for flavor, then finished in the oven with a savory barbecue sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cloves-cloves-garlic",
      "item": "cloves cloves garlic",
      "quantity": 2,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
