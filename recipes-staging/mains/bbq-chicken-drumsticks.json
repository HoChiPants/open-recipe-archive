      "item": "Worcestershire sauce",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the brown sugar, chopped garlic, salt, and black pepper. Coat the drumsticks with the mixture and let them rest for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a saucepan. Add the onion and cook for 5 minutes, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the ketchup, white wine vinegar, and Worcestershire sauce. Simmer for 10 minutes, then blend until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Preheat the grill and oven to 350°F."
    },
    {
      "step": 5,
      "text": "Grill the drumsticks for 5 minutes, turning as needed for light browning.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Transfer the drumsticks to the oven and cook for 20 minutes. Brush with the sauce and continue cooking for 10 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Check the thickest part of the chicken with a food thermometer; it should reach 165°F before serving."
    }
  ],
