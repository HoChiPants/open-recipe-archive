  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Arrange the green bell peppers upright in a baking dish, season with salt and pepper, and bake for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Meanwhile, heat the olive oil in a skillet. Cook the onion, mushrooms, zucchini, chopped red and yellow bell peppers, and spinach until tender."
    },
    {
      "step": 3,
      "text": "Add the ground turkey and cook, breaking it up, until it reaches 165°F on a food thermometer."
    },
    {
      "step": 4,
      "text": "Stir in the drained tomatoes, tomato paste, Italian seasoning, and garlic powder. Season with salt and pepper."
    },
    {
      "step": 5,
      "text": "Fill the partially baked peppers with the turkey mixture and return them to the oven until heated through and the peppers are tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
