  "id": "stuffed-peppers-with-turkey-and-vegetables",
  "name": "Stuffed Peppers with Turkey and Vegetables",
  "subtitle": "Tender peppers filled with savory turkey and garden vegetables",
  "description": "Bell peppers are partially baked, then filled with seasoned ground turkey, mushrooms, zucchini, spinach, and tomatoes for a simple baked main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
