      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "yellow-onions",
      "item": "yellow onions",
      "quantity": 2,
      "unit": "medium",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "fresh-poblano-chile-peppers",
      "item": "fresh poblano chile peppers",
      "quantity": 2,
      "unit": "medium",
      "preparation": "seeded and cut into 1/2 inch strips"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
