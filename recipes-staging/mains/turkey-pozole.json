    },
    {
      "ingredient_id": "white-hominy",
      "item": "white hominy",
      "quantity": 2,
      "unit": "can",
      "preparation": "15 ounce, drained"
    },
    {
      "ingredient_id": "green-chile-peppers",
      "item": "green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "4 ounce, chopped"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or as needed"
    },
