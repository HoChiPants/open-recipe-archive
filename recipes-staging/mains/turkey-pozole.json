  "id": "turkey-pozole",
  "name": "Turkey Pozole",
  "subtitle": "A hearty turkey and hominy soup with poblano chiles",
  "description": "This Mexican-inspired soup combines cooked turkey, hominy, beans, chiles, and warming spices in a savory broth.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 70
  },
  "ingredients": [
