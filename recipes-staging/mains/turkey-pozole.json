      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. Add the onions, poblano strips, and green chiles; cook, stirring occasionally, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the garlic and cook for 2 minutes, stirring frequently.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir in the chili powder, cumin, and oregano until the vegetables are evenly coated."
    },
    {
      "step": 4,
      "text": "Add the broth, turkey, beans, hominy, and salt and pepper. Stir in the water, adding only as needed for the desired consistency."
    },
    {
      "step": 5,
      "text": "Bring to a simmer, then cook uncovered for 60 minutes, stirring occasionally. If the turkey was not fully reheated, continue until it reaches 165°F.",
      "timer_minutes": 60
    }
  ],
