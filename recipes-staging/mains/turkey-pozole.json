      "item": "chili powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "turkey-broth",
      "item": "turkey broth",
      "quantity": 2,
      "unit": "quarts"
    },
    {
