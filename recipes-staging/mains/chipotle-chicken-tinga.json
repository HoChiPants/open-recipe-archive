  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large deep skillet over medium heat. Add the sliced onions and brown sugar; cook for 10 minutes, stirring occasionally, until softened and lightly caramelized.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the crushed garlic and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the chipotle paste and chopped tomatoes. Nestle in the chicken thighs and bring the sauce to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Cover and simmer for 25 minutes, turning the chicken once, until the thickest part reaches 165°F and the chicken is cooked through.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Shred or roughly break up the chicken in the sauce and stir to coat."
    },
    {
      "step": 6,
      "text": "Combine the finely chopped red onion, ripe tomatoes, lime zest and juice, and chopped coriander to make a fresh salsa."
    },
    {
      "step": 7,
      "text": "Serve the chicken tinga with the salsa, extra coriander leaves, tortilla chips, and guacamole."
    }
  ],
