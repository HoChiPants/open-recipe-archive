  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large pot over medium heat. Add the onions and garlic; cook for 5 minutes, stirring, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in both curry powders, the black pepper, and salt. Add the chicken and cook, stirring, for 5 minutes to coat and lightly brown it.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the potatoes and stir to combine. Cover and cook for 20 minutes, stirring occasionally, until the potatoes are tender.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Continue cooking the chicken as needed until the thickest pieces reach 165°F on a food thermometer."
    }
  ],
