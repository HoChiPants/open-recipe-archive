  "id": "chicken-curry-with-potatoes",
  "name": "Chicken Curry with Potatoes",
  "subtitle": "Tender chicken and russet potatoes in a warmly spiced curry",
  "description": "A straightforward one-pot curry combining browned chicken, sautéed aromatics, curry spices, and potatoes until tender.",
  "meal_type": "main",
