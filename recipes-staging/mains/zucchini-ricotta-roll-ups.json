      "item": "pasta sauce",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmigiano-reggiano-cheese",
      "item": "grated Parmigiano-Reggiano cheese",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the ricotta, spinach, lightly beaten egg, half of the ground black pepper, and half of the grated Parmigiano-Reggiano until evenly mixed."
    },
    {
      "step": 3,
      "text": "Blend or finely crush the basil, olive oil, garlic, pine nuts, and remaining ground black pepper into a coarse herb mixture."
    },
    {
      "step": 4,
      "text": "Slice the zucchini lengthwise into 9 thin strips. Spread the herb mixture over the strips, then place a portion of the ricotta filling on each and roll up."
    },
    {
      "step": 5,
      "text": "Secure each roll with a soaked toothpick. Spread the pasta sauce in a baking dish and arrange the rolls seam-side down."
    },
    {
      "step": 6,
      "text": "Spoon any remaining pasta sauce over the rolls and sprinkle with the remaining Parmigiano-Reggiano."
    },
    {
      "step": 7,
      "text": "Bake for 20 minutes, until the zucchini is tender and the egg-containing filling is firm and fully set, reaching 160°F in the center.",
      "timer_minutes": 20
    }
  ],
