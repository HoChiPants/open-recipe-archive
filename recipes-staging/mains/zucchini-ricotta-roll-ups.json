  "id": "zucchini-ricotta-roll-ups",
  "name": "Zucchini Ricotta Roll-Ups",
  "subtitle": "Spinach-filled zucchini baked with sauce and cheese",
  "description": "Tender zucchini rolls filled with ricotta, spinach, and herbs, finished with pasta sauce and Parmigiano-Reggiano.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 35,
    "cook_minutes": 20
  },
  "ingredients": [
