  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a heavy pot over medium heat. Add the onion and garlic and stir for 5 minutes, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Transfer the aromatics to a plate. Increase the heat, add the beef shank, and cook for 5 minutes, turning to brown the surface.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Return the onion and garlic to the pot. Add the thyme, oregano, rosemary, marjoram, tomatoes, tomato paste, and water; stir to combine."
    },
    {
      "step": 4,
      "text": "Mix in the lemon zest, sea salt, and black pepper. Bring the mixture to a gentle simmer."
    },
    {
      "step": 5,
      "text": "Cover and simmer until the shank is tender, about 2 hours. Check that the thickest part reaches at least 145°F, then rest the meat for 3 minutes before serving.",
      "timer_minutes": 120
    }
  ],
