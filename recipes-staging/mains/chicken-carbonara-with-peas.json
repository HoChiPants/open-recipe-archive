  "instructions": [
    {
      "step": 1,
      "text": "Heat a large skillet over medium heat. Cook the chopped bacon until crisp, then transfer it to a plate and drain excess fat as needed.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Season the chicken with salt and pepper. Cook it in the skillet until browned and the center reaches 165°F. Transfer to a plate and rest for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the garlic and ground black pepper to the skillet. Stir briefly, pour in the wine, and simmer until slightly thickened.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Whisk the eggs and Parmesan together in a bowl until blended."
    },
    {
      "step": 5,
      "text": "Bring the water to a boil, season with the salt and pepper, and cook the spaghetti for about 12 minutes, until tender. Add the peas near the end of cooking, then drain.",
      "timer_minutes": 12
    },
    {
      "step": 6,
      "text": "Return the spaghetti and peas to the skillet. Stir in the wine mixture, bacon, and egg-Parmesan mixture, using the residual heat to coat the pasta without scrambling the eggs. Slice the rested chicken and serve it over the pasta."
    }
  ],
