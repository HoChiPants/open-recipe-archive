  "id": "angel-hair-pasta-with-shrimp-and-basil",
  "name": "Angel Hair Pasta with Shrimp and Basil",
  "subtitle": "Tender pasta with shrimp, tomatoes, herbs, and Parmesan",
  "description": "Angel hair pasta is tossed with shrimp in a tomato and white wine sauce finished with parsley, basil, and Parmesan.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
