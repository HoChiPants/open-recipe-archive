  "instructions": [
    {
      "step": 1,
      "text": "Cook the angel hair pasta according to the package directions until tender. Drain and set aside."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet over medium heat. Add the garlic and cook until tender, about 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the shrimp and cook for about 5 minutes, turning as needed, until opaque and safely cooked.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the tomatoes, white wine, parsley, and basil. Simmer for 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Return the shrimp to the sauce and cook for 3 minutes, until opaque and easily curled.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Toss the sauce with the drained pasta, drizzle with the remaining olive oil, and serve with Parmesan."
    }
  ],
