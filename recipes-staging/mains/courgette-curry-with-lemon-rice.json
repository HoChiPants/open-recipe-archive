  "instructions": [
    {
      "step": 1,
      "text": "Heat the first olive oil in a large pot. Add the ginger, cumin seeds, chillies, garlic, potatoes, ground coriander, ground turmeric, and optional mustard seeds; stir for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Add the tomatoes, tomato purée, stock, and cinnamon stick. Bring to a simmer and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the courgettes and cook until the potatoes and courgettes are tender, about 12 minutes. Fold in the fresh coriander.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Meanwhile, heat the second olive oil in a saucepan. Add the remaining cumin seeds and optional mustard seeds, then stir in the turmeric, rice, and optional curry leaves."
    },
    {
      "step": 5,
      "text": "Add the chickpeas and lemon juice with the rice, bring to a boil, and cook until the rice is tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Serve the curry with the lemon rice."
    }
  ],
