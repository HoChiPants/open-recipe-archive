  "schema_version": "1.0.0",
  "id": "garlic-lemon-sea-scallops",
  "name": "Garlic-Lemon Sea Scallops",
  "subtitle": "Tender scallops in a bright garlic-butter sauce",
  "description": "Sear sea scallops until golden and firm, then finish them with lemon-seasoned garlic butter.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "minced"
    },
    {
      "ingredient_id": "large-sea-scallops",
      "item": "large sea scallops",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large skillet over medium-high heat. Stir in the garlic briefly until fragrant."
    },
    {
      "step": 2,
      "text": "Arrange the scallops in the skillet in a single layer. Cook for 2 minutes, until the undersides are golden brown.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Turn the scallops and cook for about 2 minutes more, until firm and opaque.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Transfer the scallops to a serving dish. Whisk the lemon juice, salt, and pepper into the skillet butter, then spoon the sauce over the scallops."
    }
  ],
