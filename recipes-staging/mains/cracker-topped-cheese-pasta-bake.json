  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and cook the spirali pasta until set; drain well."
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan. Cook the crushed garlic briefly, then stir in the flour to form a smooth roux."
    },
    {
      "step": 3,
      "text": "Gradually add the milk, stirring until smooth. Stir in the mustard and grated cheese, and heat until the cheese melts into a creamy sauce."
    },
    {
      "step": 4,
      "text": "Combine the pasta and cheese sauce in a baking dish."
    },
    {
      "step": 5,
      "text": "Crush the crackers and mix them with the parmesan or vegetarian alternative and thyme leaves. Scatter over the pasta."
    },
    {
      "step": 6,
      "text": "Bake until bubbling and the topping is golden.",
      "timer_minutes": 25
    }
  ],
