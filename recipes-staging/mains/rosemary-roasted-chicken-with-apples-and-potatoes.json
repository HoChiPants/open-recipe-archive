  "id": "rosemary-roasted-chicken-with-apples-and-potatoes",
  "name": "Rosemary-Roasted Chicken with Apples and Potatoes",
  "subtitle": "Savory chicken thighs with sweet apples and tender potatoes",
  "description": "Caramelized onion, apples, and sliced potatoes roast beneath rosemary-seasoned chicken thighs for a balanced one-pan dinner.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "preparation": "plus more to taste"
    },
    {
      "ingredient_id": "sugar",
