      "item": "ground black pepper"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Lightly coat a large oven-safe skillet or baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Melt the butter over medium heat. Add the onion and salt; cook for 2 minutes. Add cooking spray and sugar, then cook for 8 minutes, stirring occasionally, until the onion is softened and lightly caramelized.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Layer the onion, apples, and potatoes in the prepared dish."
    },
    {
      "step": 4,
      "text": "Rub the chicken thighs with olive oil, salt, rosemary, and black pepper. Arrange them over the vegetables."
    },
    {
      "step": 5,
      "text": "Roast for 60 minutes, until the chicken reaches 165°F in the thickest part and the vegetables are tender.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Serve the chicken with the roasted onion, apples, and potatoes."
    }
  ],
