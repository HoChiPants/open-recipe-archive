      "item": "apples",
      "quantity": 5,
      "unit": "medium",
      "preparation": "peeled, cored, and cut into 1/4-inch slices"
    },
    {
      "ingredient_id": "yukon-gold-potatoes",
      "item": "Yukon Gold potatoes",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into 1/4-inch slices"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
