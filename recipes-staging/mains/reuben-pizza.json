  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Prepare the thawed dough, then shape it into a pizza crust and transfer it to a baking surface. Shape or stretch it evenly as needed."
    },
    {
      "step": 3,
      "text": "Bake the crust for 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Spread the dressing over the crust. Top with 1 cup of the Swiss cheese, the corned beef, sauerkraut, remaining Swiss cheese, and caraway seed."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, until the cheese is melted and the center is hot.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Top with the chopped dill pickles and let the pizza stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
