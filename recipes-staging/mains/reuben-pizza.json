  "id": "reuben-pizza",
  "name": "Reuben Pizza",
  "subtitle": "A crisp bread-dough crust layered with classic deli-style toppings",
  "description": "Thousand Island dressing, Swiss cheese, corned beef, sauerkraut, caraway, and pickles make a savory pizza for eight servings.",
  "meal_type": "main",
  "cuisine": "American",
