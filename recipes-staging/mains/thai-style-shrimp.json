  "id": "thai-style-shrimp",
  "name": "Thai-Style Shrimp",
  "subtitle": "Shrimp simmered with coconut milk, tomato, basil, and warm spices",
  "description": "A quick stovetop shrimp dish built from a fragrant garlic-ginger paste, softened onion, tomatoes, and coconut milk.",
  "meal_type": "main",
  "cuisine": "Thai",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
