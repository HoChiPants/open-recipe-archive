    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "1-inch-piece-fresh-ginger-root",
      "item": "(1 inch) piece fresh ginger root",
      "quantity": 1
