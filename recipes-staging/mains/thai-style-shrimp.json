      "item": "onion",
      "quantity": 1,
      "unit": "medium",
      "preparation": "diced"
    },
    {
      "ingredient_id": "medium-shrimp",
      "item": "medium shrimp",
      "quantity": 1,
      "unit": "pound",
      "preparation": "peeled and deveined"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 2,
      "preparation": "seeded and diced"
    },
    {
      "ingredient_id": "coconut-milk",
      "item": "coconut milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-basil-leaves",
      "item": "fresh basil leaves",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Crush the garlic, ginger, jalapeno, salt, and turmeric together until smooth, then set aside."
    },
    {
      "step": 2,
      "text": "Heat the oil in a large skillet over medium heat. Add the onion and cook until softened."
    },
    {
      "step": 3,
      "text": "Stir in the spice paste and cook briefly until fragrant."
    },
    {
      "step": 4,
      "text": "Add the shrimp, tomatoes, and coconut milk. Simmer for 5 minutes, stirring occasionally, until the shrimp are opaque and easily curled.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the basil and serve hot."
    }
  ],
