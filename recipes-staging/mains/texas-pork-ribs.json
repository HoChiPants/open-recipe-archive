  "id": "texas-pork-ribs",
  "name": "Texas Pork Ribs",
  "subtitle": "Tender oven-baked ribs finished over wood smoke",
  "description": "Pork spareribs are seasoned overnight, baked until tender, coated with a tangy spicy sauce, and finished on the grill with soaked wood chips.",
  "meal_type": "main",
