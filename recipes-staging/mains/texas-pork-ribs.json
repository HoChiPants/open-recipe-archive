  "instructions": [
    {
      "step": 1,
      "text": "Cut the ribs into manageable portions. Stir together the white sugar, salt, ground black pepper, sweet paprika, cayenne pepper, garlic powder, brown sugar, cayenne pepper to taste, and salt and pepper to taste. Coat the ribs with the seasoning mixture."
    },
    {
      "step": 2,
      "text": "Transfer the seasoned ribs to a covered dish and chill for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Preheat the oven to 275°F. Arrange the ribs in a roasting pan and bake until tender, about 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 4,
      "text": "Heat the pan drippings in a saucepan. Add the onion and brown sugar and cook until lightly browned."
    },
    {
      "step": 5,
      "text": "Add the ketchup, hot water, white sugar, salt, ground black pepper, cayenne pepper, cayenne pepper to taste, and salt and pepper to taste. Simmer the sauce for 1 hour, stirring occasionally.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Prepare a grill for indirect cooking and add the soaked wood chips."
    },
    {
      "step": 7,
      "text": "Transfer the baked ribs to the grill. Cook for about 20 minutes, turning and brushing with sauce, until lightly smoky and the thickest meaty portion reaches at least 145°F. Rest for 3 minutes before serving.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "Let the ribs stand for 10 minutes, then serve with the remaining sauce.",
      "timer_minutes": 10
    }
  ],
