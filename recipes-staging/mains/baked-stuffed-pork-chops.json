{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "baked-stuffed-pork-chops",
  "name": "Baked Stuffed Pork Chops",
  "subtitle": "Corn and bread crumb stuffing with a creamy mushroom topping",
  "description": "Thick pork chops are filled with a buttery corn-and-bread-crumb mixture, topped with condensed mushroom soup, and baked until safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "whole-kernel-corn",
      "item": "whole kernel corn",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large",
      "preparation": "beaten"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "thick-cut-pork-chops",
      "item": "thick cut pork chops",
      "quantity": 4
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the corn, bread crumbs, beaten egg, and softened butter in a bowl."
    },
    {
      "step": 3,
      "text": "Cut a pocket into each pork chop and fill with the stuffing."
    },
    {
      "step": 4,
      "text": "Arrange the chops in a baking dish and spread the condensed mushroom soup over them."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, until the pork reaches 145°F in the thickest part and the stuffing reaches 160°F or is fully set.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Rest the pork chops for 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
