  "id": "cedar-planked-halibut",
  "name": "Cedar-Planked Halibut",
  "subtitle": "Herb-butter halibut grilled over cedar",
  "description": "Halibut steaks are coated with lemony herb butter and grilled on a soaked cedar plank until opaque and flaky.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "untreated-cedar-plank",
      "item": "untreated cedar plank",
      "quantity": 1
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "herbes-de-provence",
      "item": "herbes de Provence",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "dried-dill-weed",
      "item": "dried dill weed",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "dried-tarragon",
      "item": "dried tarragon",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "halibut-steaks",
      "item": "halibut steaks",
      "quantity": 4
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Soak the untreated cedar plank in water for 30 minutes, keeping it submerged.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Preheat the grill to medium heat."
    },
    {
      "step": 3,
      "text": "Stir together the melted butter, lemon juice, herbs, paprika, and garlic."
    },
    {
      "step": 4,
      "text": "Place the halibut steaks on the soaked plank, season with black pepper, and brush with some of the butter mixture."
    },
    {
      "step": 5,
      "text": "Set the plank on the grill and cook for 20 minutes. Brush the fish with the remaining butter mixture and continue grilling for about 10 minutes, until opaque, easily flaked, and 145°F in the center.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Remove the plank from the grill and serve the halibut hot."
    }
  ],
