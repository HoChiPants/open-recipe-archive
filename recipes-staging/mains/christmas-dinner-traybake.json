  "instructions": [
    {
      "step": 1,
      "text": "Soak the dried porcini mushrooms according to package directions, then drain and chop finely."
    },
    {
      "step": 2,
      "text": "Heat 1 tbsp olive oil in a pan. Cook the finely chopped onion for 10 minutes until softened. Stir in the chopped garlic, chestnuts, rosemary, sage, and porcini.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Combine the onion mixture with the fresh breadcrumbs, beaten egg, and finely grated vegetarian hard cheese. Shape into compact stuffing portions and set aside."
    },
    {
      "step": 4,
      "text": "Cut the aubergine into thick pieces and prepare it with 2 tbsp olive oil, garlic granules, and smoked paprika. Cut or arrange the halloumi batons with the aubergine, red onions, and carrots."
    },
    {
      "step": 5,
      "text": "Heat the oven to 400°F. Parboil the potatoes for 15 minutes, drain well, and coat them with the vegetable oil.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Arrange the potatoes, parsnips, red onions, carrots, aubergine, halloumi, and stuffing on roasting trays. Roast for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Add the Brussels sprouts and continue roasting for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Add the figs and return the trays to the oven for 25 minutes, until the vegetables are tender, the halloumi is browned, and the stuffing is golden with a firm center reaching 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 9,
      "text": "Serve hot with cranberry sauce."
    }
  ],
