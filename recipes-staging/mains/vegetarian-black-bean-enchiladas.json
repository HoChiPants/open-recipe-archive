  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Warm the olive oil in a skillet. Add the onion, red bell pepper, and salt and ground black pepper to taste; cook until tender, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the vegetarian refried black beans, corn kernels, cream cheese, ground cumin, and additional salt and ground black pepper to taste. Cook until hot and well combined, then simmer for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Blend the loosely packed and chopped fresh cilantro, canned green chiles, tomato salsa, tomato sauce, vegetable broth, lime, garlic, and dried oregano until smooth."
    },
    {
      "step": 5,
      "text": "Spread a little sauce in the baking dish. Fill each flour tortilla with the bean mixture and part of the Cheddar cheese, roll tightly, and arrange seam-side down."
    },
    {
      "step": 6,
      "text": "Cover the tortillas with the remaining sauce and Cheddar cheese. Bake until the cheese is melted, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Top with the avocado, tomatoes, and sour cream before serving."
    }
  ],
