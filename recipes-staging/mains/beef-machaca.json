  "instructions": [
    {
      "step": 1,
      "text": "Whisk the olive oil, Worcestershire sauce, and lime juice together. Pour the mixture over the beef and turn to coat."
    },
    {
      "step": 2,
      "text": "Arrange the beef in a slow cooker. Add the tomatoes, onion, bell pepper, garlic, jalapeño, broth, oregano, cumin, chili powder, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Cover and cook until the beef is fork-tender and reaches at least 145°F in the center; allow a 3-minute rest before shredding.",
      "timer_minutes": 470
    },
    {
      "step": 4,
      "text": "Shred the beef with forks and stir it into the cooking juices. Cover briefly so the meat can absorb the sauce.",
      "timer_minutes": 30
    }
