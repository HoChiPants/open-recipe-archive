  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Add the chicken and cook until golden brown, then transfer it to a plate."
    },
    {
      "step": 2,
      "text": "Reduce the heat to medium. Add the onions, garlic, and paprika, and cook for 8 minutes, stirring, until softened and fragrant.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Stir in the chicken stock, Dijon mustard, and Worcestershire sauce, scraping up any browned bits."
    },
    {
      "step": 4,
      "text": "Return the chicken and any juices to the skillet. Simmer for 6 minutes, or until the chicken reaches 165°F at the thickest piece.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Stir in the soured cream or crème fraiche until combined and warmed through."
    },
    {
      "step": 6,
      "text": "Serve with chopped parsley over rice, mash, or pasta."
    }
  ],
