  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and oil a baking tin."
    },
    {
      "step": 2,
      "text": "Grate the courgettes, then squeeze or drain them thoroughly until excess moisture is removed."
    },
    {
      "step": 3,
      "text": "Whisk the eggs with the spring onions, parsley, mint, dill, feta, olive oil, flour, baking powder, sesame seeds, and nigella seeds."
    },
    {
      "step": 4,
      "text": "Fold in the drained courgettes, halloumi, and garlic until evenly combined."
    },
    {
      "step": 5,
      "text": "Let the oven finish heating for 5 minutes, then transfer the mixture to the prepared tin and smooth the surface.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Bake for about 35 minutes, until golden and the center is firm and fully set; verify that the center reaches 160°F.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Rest for 20 minutes, then scatter with extra dill, sesame seeds, and nigella seeds before serving.",
      "timer_minutes": 20
    }
  ],
