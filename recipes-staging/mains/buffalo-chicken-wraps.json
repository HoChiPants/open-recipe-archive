  "id": "buffalo-chicken-wraps",
  "name": "Buffalo Chicken Wraps",
  "subtitle": "Spicy chicken, crisp vegetables, and creamy dressing in warm tortillas",
  "description": "Sautéed chicken is coated in hot sauce, then wrapped with lettuce, celery, and blue cheese dressing.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 1,
      "unit": "pound",
      "preparation": "boneless chicken breasts, cut into bite-size pieces"
    },
    {
      "ingredient_id": "hot-sauce",
      "item": "hot sauce",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "10-inch-flour-tortillas",
      "item": "(10 inch) flour tortillas",
      "quantity": 4
    },
    {
      "ingredient_id": "lettuce",
      "item": "lettuce",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "celery-stalk",
      "item": "celery stalk",
      "quantity": 1,
      "preparation": "diced"
    },
    {
      "ingredient_id": "blue-cheese-dressing",
      "item": "blue cheese dressing",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the vegetable oil and butter in a skillet over medium-high heat. Add the chicken and cook, stirring occasionally, until browned and the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Remove the skillet from the heat and toss the chicken with the hot sauce."
    },
    {
      "step": 3,
      "text": "Warm the tortillas briefly until flexible."
    },
    {
      "step": 4,
      "text": "Divide the lettuce, celery, chicken, and blue cheese dressing among the tortillas. Fold in the sides, roll each tortilla closed, and serve."
    }
  ],
