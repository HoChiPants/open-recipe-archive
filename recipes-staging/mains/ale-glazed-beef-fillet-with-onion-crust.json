  "instructions": [
    {
      "step": 1,
      "text": "Whisk the soy sauce and sherry vinegar with the pale ale, malt extract, and yeast extract in a saucepan. Simmer for 30 minutes, until reduced to a thick glaze.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Heat the oven to 400°F. Lightly coat the beef fillet and Chantenay carrots with the sunflower oil, then sear them in a hot ovenproof pan until browned.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Brush the beef with some glaze and coat it with the crispy fried onions. Roast for 10 minutes, then add more glaze and roast for about 15 minutes, until the center reaches 145°F. Transfer the beef to a board and rest for at least 3 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "While the beef rests, simmer the carrots for 7 minutes, until tender. Toss them with the unsalted butter and fennel seeds.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Warm a pan, add the baby spinach, and cook just until wilted."
    },
    {
      "step": 6,
      "text": "Slice the beef and serve it with the carrots and spinach, spooning the remaining glaze over the top."
    }
  ],
