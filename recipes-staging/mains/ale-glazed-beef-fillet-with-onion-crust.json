  "id": "ale-glazed-beef-fillet-with-onion-crust",
  "name": "Ale-Glazed Beef Fillet with Onion Crust",
  "subtitle": "Roasted beef with a savory ale glaze, crisp onions, carrots, and spinach",
  "description": "A center-cut beef fillet is roasted with a concentrated ale glaze and crisp onion crust, then served with buttered fennel carrots and wilted spinach.",
  "meal_type": "main",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
