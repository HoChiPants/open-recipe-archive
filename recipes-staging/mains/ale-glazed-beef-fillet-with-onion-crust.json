      "ingredient_id": "crispy-fried-onions-available-in-some-supermarkets-or-online",
      "item": "crispy fried onions (available in some supermarkets or online)",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "sunflower-oil",
      "item": "sunflower oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "beef-fillet",
      "item": "beef fillet",
      "quantity": 800,
      "unit": "g",
      "preparation": "cut from the centre"
    },
