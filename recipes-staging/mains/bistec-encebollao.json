  "instructions": [
    {
      "step": 1,
      "text": "Whisk the stock, oil, vinegar, garlic, sazón, salt, and oregano in a large bowl. Add the steak and onion rings, turning to coat."
    },
    {
      "step": 2,
      "text": "Cover and refrigerate the mixture for 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 3,
      "text": "Warm a large heavy skillet over medium heat. Transfer the steak, onions, and marinade to the skillet."
    },
    {
      "step": 4,
      "text": "Bring the liquid to a simmer, reduce the heat, and cook for 40 minutes, or until the beef is tender and reaches 145°F in the thickest pieces.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Remove the beef from the heat and let it rest for 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
