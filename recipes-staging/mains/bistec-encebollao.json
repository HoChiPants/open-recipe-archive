  "id": "bistec-encebollao",
  "name": "Bistec Encebollao",
  "subtitle": "Marinated beef with tender onions",
  "description": "Thin-sliced sirloin is marinated with vinegar, garlic, oregano, and seasoning, then simmered with onions until tender.",
  "meal_type": "main",
  "cuisine": "Puerto Rican",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
