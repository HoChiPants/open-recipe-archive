    "cook_minutes": 40,
    "inactive_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "beef-sirloin-steak",
      "item": "beef sirloin steak",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "sliced thinly across the grain"
    },
    {
      "ingredient_id": "white-onions",
      "item": "white onions",
      "quantity": 2,
      "unit": "large",
      "preparation": "sliced into rings"
    },
    {
