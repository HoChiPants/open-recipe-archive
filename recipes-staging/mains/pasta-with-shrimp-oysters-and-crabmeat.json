  "instructions": [
    {
      "step": 1,
      "text": "Melt 0.5 cup butter with 0.5 cup olive oil in a large skillet over medium heat. Stir in the garlic for 3 minutes, then add 1.25 cups parsley and cook for 1 minute. Mix in the lemon juice, crushed red pepper, and salt and pepper; set the sauce aside.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Cook the bow tie pasta in boiling water until tender, about 10 minutes, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Warm the remaining butter and olive oil in a large skillet. Add the peeled shrimp and cook until firm and opaque. Add the drained oysters and crabmeat, season with the remaining salt and pepper, and heat until the shellfish is opaque or heated through and the oysters have opened if still in shells.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Toss the drained pasta with the seafood and sauce until coated. Scatter the remaining chopped parsley over the top and serve."
    }
  ],
