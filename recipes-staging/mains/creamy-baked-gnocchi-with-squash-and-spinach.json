  "instructions": [
    {
      "step": 1,
      "text": "Microwave the squash for 5 minutes, then cook it with the olive oil and crushed garlic for about 12 minutes, adding the spinach until wilted. Continue until the squash is tender.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Stir in the mascarpone, nutmeg, and Parmesan or vegetarian alternative until smooth. Add the gnocchi and simmer for 2 minutes, until the sauce thickens.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a baking dish. Sprinkle with the breadcrumbs and finish under a preheated oven or air fryer until bubbling and golden."
