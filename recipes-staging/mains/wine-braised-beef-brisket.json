  "id": "wine-braised-beef-brisket",
  "name": "Wine-Braised Beef Brisket",
  "subtitle": "Tender brisket in a savory tomato-wine braise",
  "description": "Seasoned beef brisket is seared, then braised with onion, broth, tomato sauce, and red wine until tender.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 150
  },
  "ingredients": [
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "3-pound-beef-brisket",
      "item": "(3 pound) beef brisket",
      "quantity": 1
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "beef-broth",
      "item": "beef broth",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.5 ounce"
    },
    {
      "ingredient_id": "tomato-sauce",
      "item": "tomato sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "red-wine",
      "item": "red wine",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the thyme, salt, and pepper, then coat the brisket with the seasoning."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in an oven-safe pot. Add the brisket and sear for 4 minutes, then set it aside.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Cook the sliced onion in the pot for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Stir in the beef broth, tomato sauce, and red wine. Return the brisket to the pot."
    },
    {
      "step": 6,
      "text": "Transfer the covered pot to the oven and roast for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Continue cooking in the braising liquid until the brisket is tender and reaches at least 145°F in the center. Rest for 3 minutes before slicing."
    },
    {
      "step": 8,
      "text": "Transfer the brisket with the tomato sauce for serving."
    }
  ],
