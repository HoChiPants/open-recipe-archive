  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer. Add the farfalle and cook for 12 minutes, or until cooked through; drain.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan over medium heat. Whisk in the cream and peeled garlic, then simmer for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Remove the garlic. Add the drained pasta to the sauce and toss until coated."
    },
    {
      "step": 4,
      "text": "Season with black pepper to taste, add the Parmesan, and stir until combined."
    }
  ],
