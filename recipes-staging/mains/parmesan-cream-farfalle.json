  "id": "parmesan-cream-farfalle",
  "name": "Parmesan Cream Farfalle",
  "subtitle": "Bow-tie pasta in a simple garlic-Parmesan cream sauce",
  "description": "Tender farfalle is coated in a buttery cream sauce with garlic, black pepper, and grated Parmesan for an easy savory main dish.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
