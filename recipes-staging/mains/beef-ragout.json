{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "beef-ragout",
  "name": "Beef Ragout",
  "subtitle": "Slow-braised beef with tomatoes and herbs",
  "description": "Beef shin is browned and gently braised with aromatic vegetables, wine, tomatoes, and stock until tender, then served with pappardelle and parmesan.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 210
  },
  "ingredients": [
    {
      "ingredient_id": "beef-shin",
      "item": "beef shin",
      "quantity": 1.2,
      "unit": "kg",
      "preparation": "cut into chunks"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": "4-5",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "onions-finely-chopped",
      "item": "onions finely chopped",
      "quantity": 2
    },
    {
      "ingredient_id": "carrots-finely-chopped",
      "item": "carrots finely chopped",
      "quantity": 3
    },
    {
      "ingredient_id": "celery-sticks",
      "item": "celery sticks",
      "quantity": 4,
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic cloves",
      "quantity": 4,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "tomato-pure-e",
      "item": "tomato purée",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "red-wine",
      "item": "red wine",
      "quantity": 400,
      "unit": "ml"
    },
    {
      "ingredient_id": "rosemary-sprigs",
      "item": "rosemary sprigs",
      "quantity": 2
    },
    {
      "ingredient_id": "bay-leaves",
      "item": "bay leaves",
      "quantity": 2
    },
    {
      "ingredient_id": "x-400g-cans-chopped-tomatoes",
      "item": "x 400g cans chopped tomatoes",
      "quantity": 2
    },
    {
      "ingredient_id": "beef-stock",
      "item": "beef stock",
      "quantity": 500,
      "unit": "ml"
    },
    {
      "ingredient_id": "parmesan-grated",
      "item": "parmesan grated",
      "preparation": "and pappardelle, to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Pat the beef dry and season as desired."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large ovenproof pot. Brown the beef in batches, then transfer it to a plate.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Cook the onions, carrots, celery, and garlic in the pot until softened.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the tomato purée and cook briefly.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Return the beef to the pot. Add the wine, chopped tomatoes, stock, rosemary, and bay leaves, then bring to a simmer."
    },
    {
      "step": 6,
      "text": "Cover and cook in the oven until the beef is tender and reaches at least 145°F internally. Hold it at that temperature for a 3-minute rest before serving.",
      "timer_minutes": 120
    },
    {
      "step": 7,
      "text": "Remove the rosemary and bay leaves. Adjust the ragout's consistency with a little stock if needed, and season as desired."
    },
    {
      "step": 8,
      "text": "Cook the pappardelle according to its package directions, then serve with the ragout and grated parmesan.",
      "timer_minutes": 3
    }
  ],
