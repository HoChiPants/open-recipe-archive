  "instructions": [
    {
      "step": 1,
      "text": "Mix the salt, paprika, thyme, pepper, garlic powder, sage, and pinch of salt and pepper. Coat the chicken breasts evenly with the seasoning."
    },
    {
      "step": 2,
      "text": "Add the olive oil and chicken stock to the pressure cooker. Arrange the seasoned chicken in the cooker and seal the lid."
    },
    {
      "step": 3,
      "text": "Cook under pressure for 5 minutes, then allow a 15-minute natural release. Release any remaining pressure and check that the chicken reaches 165°F internally.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Transfer the chicken to a plate, cover loosely with aluminum foil, and let it rest while making the gravy."
    },
    {
      "step": 5,
      "text": "Combine the cold water and cornstarch in a small bowl. Set the cooker to sauté or a comparable heating setting, bring the stock to a simmer, and whisk in the slurry."
    },
    {
      "step": 6,
      "text": "Cook, whisking, until the gravy thickens, about 5 minutes. Season with the remaining salt and ground black pepper to taste, then serve with the chicken.",
      "timer_minutes": 5
    }
  ],
