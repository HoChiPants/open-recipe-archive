  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large skillet over medium heat. Add the mushrooms, half the wine, and half the garlic; cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the sausage and cook for about 7 minutes, breaking it apart, until browned and it reaches 160°F on a food thermometer. Drain excess fat if needed.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Stir in the tortellini, Alfredo basil sauce, remaining wine, and remaining garlic. Cover and cook until the tortellini is tender and heated through.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the spinach and cook until wilted.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Stir everything together and serve hot."
    }
  ],
