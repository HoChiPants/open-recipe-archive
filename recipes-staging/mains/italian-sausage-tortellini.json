  "id": "italian-sausage-tortellini",
  "name": "Italian Sausage Tortellini",
  "subtitle": "Creamy tortellini with sausage, mushrooms, and spinach",
  "description": "A quick Italian-style pasta skillet combining browned sausage, tender mushrooms, creamy basil sauce, and wilted spinach.",
  "meal_type": "main",
