  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "slow-cooker-pineapple-chicken",
  "name": "Slow Cooker Pineapple Chicken",
  "subtitle": "Tender chicken thighs in a sweet-savory pineapple sauce",
  "description": "Flour-coated chicken thighs cook slowly with pineapple, soy sauce, brown sugar, ketchup, and garlic for an easy dinner.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "chicken-thighs",
      "item": "chicken thighs",
      "quantity": 4,
      "preparation": "trimmed"
    },
    {
      "ingredient_id": "pineapple-chunks",
      "item": "pineapple chunks",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "pineapple-juice",
      "item": "pineapple juice",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "ketchup",
      "item": "ketchup",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Spread the flour in a shallow dish and coat the trimmed chicken thighs on all sides, shaking off excess."
    },
    {
      "step": 2,
      "text": "Place the coated chicken in the slow cooker. Add the pineapple chunks and juice."
    },
    {
      "step": 3,
      "text": "Whisk the soy sauce, brown sugar, ketchup, and minced garlic with the pineapple mixture until evenly combined."
    },
    {
      "step": 4,
      "text": "Cover and cook on the slow-cooker setting for 240 minutes, until the chicken reaches 165°F at the thickest part.",
      "timer_minutes": 240
    }
  ],
