  "id": "lemon-butter-cod-fillets",
  "name": "Lemon Butter Cod Fillets",
  "subtitle": "Tender cod baked in a bright lemon-garlic butter sauce",
  "description": "Cod fillets are coated with a seasoned lemon butter sauce and baked until opaque and easily flaked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1,
      "preparation": "juiced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-parsley",
      "item": "dried parsley",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "4-ounce-fillets-cod",
      "item": "(4 ounce) fillets cod",
      "quantity": 6
    },
    {
      "ingredient_id": "lemon-pepper",
      "item": "lemon pepper",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan. Stir in the lemon juice, salt, black pepper, parsley, garlic, and lemon pepper."
    },
    {
      "step": 3,
      "text": "Bring the sauce to a gentle simmer and stir for 10 minutes, until thickened.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Arrange the cod fillets in a baking dish and pour the sauce over them."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, until the fish reaches 145°F, is opaque, and flakes easily.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Transfer the fillets to serving plates and spoon the pan butter over them."
    }
  ],
