  "id": "roasted-cherry-tomatoes-with-angel-hair",
  "name": "Roasted Cherry Tomatoes with Angel Hair",
  "subtitle": "A quick pasta dish with roasted tomatoes, basil, and Parmesan",
  "description": "Cherry tomatoes roast with garlic and olive oil, then coat delicate angel hair pasta with basil and a touch of heat.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
