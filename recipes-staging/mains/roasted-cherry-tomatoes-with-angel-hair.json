  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Toss the halved tomatoes with olive oil, garlic, salt, black pepper, and red pepper flakes. Spread them in a baking dish."
    },
    {
      "step": 3,
      "text": "Roast until the tomatoes soften and release their juices.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Bring a pot of salted water to a boil. Cook the angel hair until tender, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Drain the pasta, then return it to the warm pot and stir briefly to keep it hot."
    },
    {
      "step": 6,
      "text": "Add the roasted tomatoes, basil, and any remaining seasoning to the pasta. Toss gently to combine."
    },
    {
      "step": 7,
      "text": "Top with Parmesan and serve warm."
    }
  ],
