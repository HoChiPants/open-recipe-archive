  "id": "avocado-tacos",
  "name": "Avocado Tacos",
  "subtitle": "Warm corn tortillas with creamy avocado filling",
  "description": "Mashed avocado, onion, garlic salt, cilantro, and jalapeño sauce make a quick filling for gently baked corn tortillas.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "avocados",
      "item": "avocados",
      "quantity": 3,
      "preparation": "peeled, pitted, and mashed"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "6-inch-corn-tortillas",
      "item": "(6 inch) corn tortillas",
      "quantity": 12
    },
    {
      "ingredient_id": "bunch-fresh-cilantro-leaves",
      "item": "bunch fresh cilantro leaves",
      "quantity": 1,
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "jalapeno-pepper-sauce",
      "item": "jalapeno pepper sauce",
      "preparation": "to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Mix the mashed avocados, diced onions, and garlic salt until evenly combined."
    },
    {
      "step": 3,
      "text": "Arrange the corn tortillas in layers in a baking dish, separating them as needed so they can warm evenly."
    },
    {
      "step": 4,
      "text": "Bake the tortillas for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Transfer the warm tortillas to a serving surface and fill or top them with the avocado mixture."
    },
    {
      "step": 6,
      "text": "Finish with the chopped cilantro and jalapeño pepper sauce to taste."
    }
  ],
