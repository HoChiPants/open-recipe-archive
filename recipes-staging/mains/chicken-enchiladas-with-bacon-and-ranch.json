  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 450°F. Coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet over medium heat. Add the yellow onion and cook for 5 minutes, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the chicken, bacon, roasted garlic, salt, black pepper, garlic powder, and green onions. Cook until warmed through."
    },
    {
      "step": 4,
      "text": "Mix the ranch dressing with the sour cream, then stir the mixture into the chicken filling. Fold in part of the shredded cheese."
    },
    {
      "step": 5,
      "text": "Spread some enchilada sauce in the baking dish. Fill each tortilla with the chicken mixture, roll it closed, and arrange the enchiladas seam-side down."
    },
    {
      "step": 6,
      "text": "Pour the remaining enchilada sauce over the tortillas and top with the remaining cheese."
    },
    {
      "step": 7,
      "text": "Bake for 15 minutes, until bubbling and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 15
    }
  ],
