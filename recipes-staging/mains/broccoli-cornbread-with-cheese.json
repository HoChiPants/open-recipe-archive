  "id": "broccoli-cornbread-with-cheese",
  "name": "Broccoli Cornbread with Cheese",
  "subtitle": "A savory baked cornbread with broccoli and cheddar",
  "description": "This tender, cheesy cornbread combines thawed broccoli, onion, and cottage cheese in a simple baked side or main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 35,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "cottage-cheese",
      "item": "cottage cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "corn-bread-muffin-mix",
      "item": "corn bread/muffin mix",
      "quantity": 2,
      "unit": "package",
      "preparation": "8.5 ounce"
    },
    {
      "ingredient_id": "frozen-chopped-broccoli",
      "item": "frozen chopped broccoli",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, cottage cheese, melted butter, and Cheddar cheese until combined."
    },
    {
      "step": 3,
      "text": "Stir in the corn bread/muffin mix. Fold in the thawed broccoli and chopped onion."
    },
    {
      "step": 4,
      "text": "Transfer the batter to a prepared baking dish and bake until the center is firm and set, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Let the cornbread cool for 10 minutes before slicing and serving.",
      "timer_minutes": 10
    }
  ],
