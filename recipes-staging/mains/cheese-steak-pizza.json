  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Lightly coat a skillet or baking surface with cooking spray and butter-flavored cooking spray."
    },
    {
      "step": 2,
      "text": "Cook the thinly sliced sirloin in the prepared skillet for 4 minutes, then transfer it to a plate. For food safety, cook whole-cut beef to 145°F and let it rest for 3 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Coat the skillet again, add the mushrooms, onion, and green bell pepper, and cook until tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Shape the refrigerated pizza dough on a suitable baking surface. Arrange the white American cheese, cooked sirloin, and vegetables over the dough, then cover with the shredded cheese blend."
    },
    {
      "step": 5,
      "text": "Bake until the cheese is melted and the crust is golden brown.",
      "timer_minutes": 20
    }
  ],
