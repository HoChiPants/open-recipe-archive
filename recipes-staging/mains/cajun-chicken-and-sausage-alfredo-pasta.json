  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium-high heat. Season the chicken with salt and pepper, then cook it with 1 cup of the broth for 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Add the sausage and cook for 5 minutes, stirring occasionally, until lightly browned. Stir in the garlic and cook for 2 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Whisk in the remaining broth, heavy cream, penne, and Cajun seasoning. Bring the mixture to a simmer, then cook for 20 minutes, stirring occasionally, until the pasta is tender and the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Stir in the Parmesan and parsley. Adjust the Cajun seasoning to taste and serve hot."
    }
  ],
