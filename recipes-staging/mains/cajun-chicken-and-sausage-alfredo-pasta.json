  "name": "Cajun Chicken and Sausage Alfredo Pasta",
  "subtitle": "Creamy one-pot pasta with Cajun seasoning",
  "description": "Chicken, smoked sausage, penne, and Parmesan simmer together in a seasoned cream sauce for a hearty skillet meal.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
