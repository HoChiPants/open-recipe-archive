  "id": "pot-roast-in-foil",
  "name": "Pot Roast in Foil",
  "subtitle": "Tender beef baked with mushroom and onion sauce",
  "description": "A simple foil-baked pot roast with a savory mushroom-onion coating and minimal preparation.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "bottom-round",
      "item": "bottom round",
      "quantity": 3,
      "unit": "pounds"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "dry-onion-soup-mix",
      "item": "dry onion soup mix",
      "quantity": 1,
      "unit": "packet"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Place the bottom round in the center of a large sheet of foil set in a baking dish."
    },
    {
      "step": 3,
      "text": "Stir together the condensed cream of mushroom soup, dry onion soup mix, and water. Spread the mixture over the roast."
    },
    {
      "step": 4,
      "text": "Fold the foil tightly around the roast to seal the packet."
    },
    {
      "step": 5,
      "text": "Bake for 4 hours, or until the roast reaches at least 145°F internally. Rest for 3 minutes before slicing.",
      "timer_minutes": 240
    }
  ],
