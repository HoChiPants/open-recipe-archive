  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Season the pork tenderloin with ground sage and garlic salt, then place it in a baking dish."
    },
    {
      "step": 3,
      "text": "Chop the apple and onion, and combine them with the drained sauerkraut and brown sugar. Arrange the mixture around the pork."
    },
    {
      "step": 4,
      "text": "Bake for 3 hours, or until the thickest part of the pork reaches 145°F on a food thermometer. Rest the pork for 3 minutes before slicing.",
      "timer_minutes": 180
    }
  ],
