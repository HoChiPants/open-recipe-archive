{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "baked-scallops",
  "name": "Baked Scallops",
  "subtitle": "Tender scallops with a crisp cracker topping",
  "description": "Scallops are coated with seasoned cracker crumbs, finished with a buttery wine-lemon mixture, and baked until lightly browned and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "buttery-round-crackers",
      "item": "buttery round crackers",
      "quantity": 20,
      "preparation": "crushed"
    },
    {
      "ingredient_id": "black-pepper-to-taste",
      "item": "black pepper to taste"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sea-scallops",
      "item": "sea scallops",
      "quantity": 1,
      "unit": "pound",
      "preparation": "rinsed and drained"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "dry-white-wine",
      "item": "dry white wine",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 0.5,
      "preparation": "juiced"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped, for garnish"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Mix the crushed crackers with the pepper and garlic powder."
    },
    {
      "step": 3,
      "text": "Coat the rinsed, drained scallops evenly with the cracker mixture and place them in a baking dish."
    },
    {
      "step": 4,
      "text": "Stir together the melted butter, wine, and lemon juice, then pour the mixture over the scallops."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until lightly browned and the scallops reach 145°F or are opaque and easily flaked.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Garnish with the chopped parsley and serve."
    }
  ],
