  "id": "feta-and-bacon-stuffed-chicken-breasts",
  "name": "Feta and Bacon Stuffed Chicken Breasts",
  "subtitle": "Oregano-seasoned chicken with a savory feta center",
  "description": "Boneless chicken breasts are filled with feta and bacon, coated in garlicky lemon oil, and baked until fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 8,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breasts"
    },
    {
      "ingredient_id": "slices-feta-cheese",
      "item": "slices feta cheese",
      "quantity": 4
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 4,
      "preparation": "fried and drained"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the lemon juice, crushed garlic, oregano, and salt and pepper. Whisk in the olive oil."
    },
    {
      "step": 3,
      "text": "Cut a pocket into each chicken breast. Fill each pocket with one slice of feta and one slice of bacon."
    },
    {
      "step": 4,
      "text": "Arrange the stuffed breasts in a baking dish and coat them with the seasoned oil mixture."
    },
    {
      "step": 5,
      "text": "Bake at 350°F for 35 minutes, or until the thickest part of each breast reaches 165°F on a food thermometer.",
      "timer_minutes": 35
    }
  ],
