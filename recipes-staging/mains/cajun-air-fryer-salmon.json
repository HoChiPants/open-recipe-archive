  "id": "cajun-air-fryer-salmon",
  "name": "Cajun Air Fryer Salmon",
  "subtitle": "Spiced salmon fillets with a lightly sweet crust",
  "description": "Season salmon with Cajun spice and brown sugar, then air-fry until opaque and easily flaked for a quick dinner.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "cajun-seasoning",
      "item": "Cajun seasoning",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "6-ounce-skin-on-salmon-fillets",
      "item": "(6 ounce) skin-on salmon fillets",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat an air fryer to 390°F."
    },
    {
      "step": 2,
      "text": "Pat the salmon fillets dry and lightly coat them with cooking spray."
    },
    {
      "step": 3,
      "text": "Combine the Cajun seasoning and brown sugar, then coat the flesh side of each fillet with the mixture."
    },
    {
      "step": 4,
      "text": "Place the fillets skin-side down in the air fryer basket, leaving space between them."
    },
    {
      "step": 5,
      "text": "Air-fry for 8 minutes, or until the salmon reaches 145°F internally or is opaque and flakes easily.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Let the salmon rest for 2 minutes before serving.",
      "timer_minutes": 2
    }
  ],
