  "instructions": [
    {
      "step": 1,
      "text": "Mix the softened cream cheese with onion, parsley, dill, garlic, and lemon pepper. Fold in the crabmeat, then chill the filling for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Cut a pocket into each chicken breast and fill with the chilled crab mixture. Secure the openings as needed."
    },
    {
      "step": 3,
      "text": "Coat each breast in flour, dip it in beaten egg, and cover it with fresh breadcrumbs."
    },
    {
      "step": 4,
      "text": "Heat the butter and vegetable oil in a suitable pan. Add the coated chicken and cook, turning as needed, until the coating is golden and the thickest part reaches 165°F."
    },
    {
      "step": 5,
      "text": "Drain briefly before serving."
    }
  ],
