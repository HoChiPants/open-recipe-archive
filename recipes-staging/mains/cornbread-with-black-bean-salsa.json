  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and melt the unsalted butter. Let it cool until warm rather than hot."
    },
    {
      "step": 2,
      "text": "Whisk together the plain flour, cornmeal or fine ground polenta, baking powder, bicarbonate of soda, and chipotle chilli flakes to taste."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the cooled butter with the buttermilk, vegetable oil, 2 tablespoons of the honey, and eggs. Stir the wet mixture into the dry ingredients until smooth."
    },
    {
      "step": 4,
      "text": "Transfer the batter to a prepared baking pan and bake until golden and the center is fully set.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Combine the x 400g can black beans drained and rinsed, spring onions finely sliced, coriander finely chopped, feta crumbled, and avocados peeled, stoned and cut into 1cm cubes. Toss with the extra virgin olive oil and lime juiced."
    },
    {
      "step": 6,
      "text": "Mix the remaining honey with lime juiced and chipotle chilli flakes to taste, then spoon or drizzle it over the cornbread and salsa."
    },
    {
      "step": 7,
      "text": "Serve warm, with grilled streaky bacon and poached eggs to serve (optional). If using poached eggs, cook them until the whites are set and the yolks reach 160°F."
    }
  ],
