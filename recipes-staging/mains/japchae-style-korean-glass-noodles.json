  "id": "japchae-style-korean-glass-noodles",
  "name": "Japchae-Style Korean Glass Noodles",
  "subtitle": "Sesame noodles with sautéed vegetables and shiitake mushrooms",
  "description": "Tender Korean glass noodles are tossed with a sweet soy dressing and stir-fried vegetables for a savory, colorful main dish.",
  "meal_type": "main",
  "cuisine": "Korean",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "korean-dang-myun-noodles",
      "item": "Korean dang myun noodles",
      "quantity": 0.5,
      "unit": "pound"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 2.5,
      "unit": "teaspoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 2,
      "preparation": "cut into match-stick size pieces"
    },
    {
      "ingredient_id": "asparagus",
      "item": "asparagus",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "thinly-sliced-onions",
      "item": "thinly sliced onions",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "green-onions-cut-into-1-inch-pieces",
      "item": "green onions cut into 1-inch pieces",
      "quantity": 3
    },
    {
