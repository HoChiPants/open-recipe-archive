      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a boil. Cook the noodles for 5 minutes, or until tender. Drain well, toss with part of the divided sesame oil and some sesame seeds, and set aside.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk the soy sauce and white sugar together until the sugar dissolves; set aside."
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil in a large skillet over medium-high heat. Stir-fry the carrots, asparagus, onions, garlic, and green onions for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the softened shiitake mushrooms and stir briefly to combine."
    },
    {
      "step": 5,
      "text": "Add the noodles and soy sauce mixture. Toss and stir-fry for 3 minutes, until evenly coated and hot.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Warm the remaining sesame oil briefly with the remaining sesame seeds, then toss with the noodles and serve."
    }
  ],
