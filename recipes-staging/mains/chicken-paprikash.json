  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken thighs with salt. Heat the olive oil in a large heavy pot over medium-high heat, add the chicken skin-side down, and brown both sides; transfer to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the onions and kosher salt to the pot and cook until softened. Stir in the garlic, tomato paste, and flour, then cook briefly until blended.",
      "timer_minutes": 9
    },
    {
      "step": 3,
      "text": "Mix in the black pepper, smoked paprika, sweet Hungarian paprika, and cayenne. Pour in the chicken broth, scraping up any browned bits, and return the chicken to the pot.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Cover and simmer gently until the chicken is tender and reaches 165°F at the thickest part.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Transfer the chicken to a plate. Whisk the sour cream and heavy whipping cream with a little hot sauce from the pot, then stir the mixture back into the pot."
    },
    {
      "step": 6,
      "text": "Return the chicken to the sauce and simmer gently until heated through. Taste and adjust with salt.",
      "timer_minutes": 10
    }
  ],
