  "id": "pesto-lasagna",
  "name": "Pesto Lasagna",
  "subtitle": "A layered spinach, pesto, and cheese bake",
  "description": "Tender noodles are layered with sautéed spinach, pesto, seasoned ricotta, and creamy sauce, then baked until bubbling and fully set.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
