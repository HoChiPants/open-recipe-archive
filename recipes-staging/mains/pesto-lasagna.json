  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Bring salted water to a simmer. Add the lasagna noodles and cook for 10 minutes. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Heat the olive oil and onion until the onion is tender. Stir in the spinach and warm through; set aside."
    },
    {
      "step": 4,
      "text": "Stir the pesto into the spinach mixture. In a separate bowl, combine the ricotta, egg, salt, pepper, nutmeg, mozzarella, and Parmesan."
    },
    {
      "step": 5,
      "text": "Layer noodles, spinach mixture, and ricotta mixture in a baking dish. Repeat as needed, finishing with noodles, ricotta mixture, mozzarella, Alfredo-style pasta sauce, and Parmesan."
    },
    {
      "step": 6,
      "text": "Bake until bubbling and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 55
    },
    {
      "step": 7,
      "text": "Let the lasagna rest for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
