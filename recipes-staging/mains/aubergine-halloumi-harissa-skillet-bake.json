  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and warm a large ovenproof skillet over medium-high heat."
    },
    {
      "step": 2,
      "text": "Add 2 tablespoons of the olive oil and cook the aubergine rounds in batches for about 3 minutes, turning once, until lightly softened. Transfer them to a plate.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the crushed garlic to the skillet and sauté briefly. Stir in the chopped tomatoes, harissa, and sugar, then simmer until the sauce is slightly thickened."
    },
    {
      "step": 4,
      "text": "Arrange the aubergine and halloumi slices over the sauce. Drizzle with the remaining olive oil and sprinkle with dried mint."
    },
    {
      "step": 5,
      "text": "Bake for about 20 minutes, until the aubergine is tender and the halloumi is browned.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Serve hot with flatbreads, rice, or couscous."
    }
  ],
