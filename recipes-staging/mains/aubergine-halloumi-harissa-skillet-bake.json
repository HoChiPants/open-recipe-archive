  "id": "aubergine-halloumi-harissa-skillet-bake",
  "name": "Aubergine, Halloumi & Harissa Skillet Bake",
  "subtitle": "Tender aubergine in a spiced tomato sauce with browned halloumi",
  "description": "A simple vegetarian skillet bake with aubergine, harissa-tomato sauce, and halloumi, served with flatbreads, rice, or couscous.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
