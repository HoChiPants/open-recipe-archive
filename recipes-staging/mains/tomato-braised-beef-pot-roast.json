  "id": "tomato-braised-beef-pot-roast",
  "name": "Tomato-Braised Beef Pot Roast",
  "subtitle": "Tender beef with onion and bay in a savory tomato sauce",
  "description": "A slow-roasted tip round becomes tender in tomato sauce with onion and bay leaves, then the cooking juices are thickened into a simple gravy.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 420
  },
  "ingredients": [
    {
      "ingredient_id": "tip-round-roast",
      "item": "tip round roast",
      "quantity": 2.5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "tomato-sauce",
      "item": "tomato sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "cut into thin strips"
    },
    {
      "ingredient_id": "bay-leaves",
      "item": "bay leaves",
      "quantity": 2
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Season the tip round roast with salt and pepper, and place it in a covered roasting pan or Dutch oven."
    },
    {
      "step": 3,
      "text": "Pour in the tomato sauce, add the onion and bay leaves, cover, and roast until the beef reaches 145°F in the thickest part.",
      "timer_minutes": 420
    },
    {
      "step": 4,
      "text": "Transfer the roast to a cutting board and rest it for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Remove the bay leaves. Whisk the flour into the tomato sauce, then cook until the sauce thickens; season with salt and pepper to taste."
    },
    {
      "step": 6,
      "text": "Slice the roast and serve it with the thickened sauce."
    }
  ],
