  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water seasoned with the salt to a boil. Cook the angel hair pasta for 3 minutes, then drain.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet. Add the onion, lemon juice, garlic, parsley, wine, black pepper, and Worcestershire sauce; stir to combine."
    },
    {
      "step": 3,
      "text": "Add the shrimp and cook, stirring occasionally, until opaque throughout, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Toss the hot pasta with the shrimp and sauce. Fold in the Asiago cheese and avocado, then serve."
    }
  ],
