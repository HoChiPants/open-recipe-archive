  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of salted water to a boil. Cook the spaghetti for 12 minutes, or until tender, then drain.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium heat. Add the leek and cook, stirring, for 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Add the white wine and lemon juice. Simmer for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the crème fraîche, mustard, and cayenne. Warm the sauce for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the sliced salmon and cook, stirring gently, for 3 minutes, until it reaches 145°F, is opaque, and flakes easily.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Transfer the spaghetti to the skillet and toss to coat with the sauce. Fold in the cilantro and adjust the cayenne to taste."
    }
  ],
