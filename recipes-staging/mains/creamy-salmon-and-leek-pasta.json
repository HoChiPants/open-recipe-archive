  "id": "creamy-salmon-and-leek-pasta",
  "name": "Creamy Salmon and Leek Pasta",
  "subtitle": "Silky pasta with tender salmon, leek, and lemon",
  "description": "Spaghetti is tossed with sliced salmon and a creamy white-wine, lemon, mustard, and tarragon sauce, finished with cilantro.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
