  "id": "corn-dogs",
  "name": "Corn Dogs",
  "subtitle": "Crisp cornmeal-coated frankfurters",
  "description": "Frankfurters are dipped in a simple cornmeal batter, deep-fried until crisp, and served with ketchup and mustard.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "cornmeal",
      "item": "cornmeal",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 100,
      "unit": "g"
    },
    {
