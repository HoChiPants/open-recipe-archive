      "quantity": 8
    },
    {
      "ingredient_id": "vegetable-oil-for-deep-frying",
      "item": "vegetable oil for deep-frying"
    },
    {
      "ingredient_id": "ketchup-and-american-mustard",
      "item": "ketchup and American mustard",
      "preparation": "to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cornmeal, plain flour, caster sugar, fine sea salt, baking powder, whole milk, and lightly beaten egg until smooth."
    },
    {
      "step": 2,
      "text": "Transfer the batter to a tall glass or narrow container. Prepare the frankfurters for coating and heat the vegetable oil for deep-frying."
    },
    {
      "step": 3,
      "text": "Dip each frankfurter in the batter, turning to coat completely."
    },
    {
      "step": 4,
      "text": "Fry the coated frankfurters in batches for 3 minutes, turning as needed, until golden and the batter reaches 160°F at the center.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Drain briefly, then serve with ketchup and American mustard."
    }
  ],
