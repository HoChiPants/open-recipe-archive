  "instructions": [
    {
      "step": 1,
      "text": "Heat 2 tablespoons vegetable oil in a large skillet over medium heat. Add the onion, red bell pepper, green bell pepper, and jalapeno; cook for 8 minutes, stirring, until softened.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Season the vegetables with salt, cumin, and chili powder. Add the shrimp and cook for 5 minutes, stirring, until opaque and safely cooked to 145°F.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the lime juice, then transfer the shrimp mixture to a bowl and combine it with the shredded cheese."
    },
    {
      "step": 4,
      "text": "Divide the filling among the tortillas and fold each tortilla over to enclose it."
    },
    {
      "step": 5,
      "text": "Lightly oil the skillet as needed. Cook the quesadillas in batches for 5 minutes per side, turning once, until lightly browned and the cheese is melted.",
      "timer_minutes": 10
    }
  ],
