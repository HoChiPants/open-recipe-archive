  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large skillet over medium heat. Add the onion and cook until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the garlic and ginger, then cook until fragrant and the onion is lightly colored, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Stir in the coriander, cumin, turmeric, and fenugreek."
    },
    {
      "step": 4,
      "text": "Add the chickpeas and stir to coat them with the spiced onion mixture. Cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Pour in the vegetable stock and stir in the almond butter. Add the spinach and cook until wilted and the mixture is hot, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Spoon the chickpea mixture over the cooked rice and serve hot."
    }
  ],
