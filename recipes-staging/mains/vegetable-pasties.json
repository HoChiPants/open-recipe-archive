  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Shape the pastry for a double crust into four portions and let them rest until set."
    },
    {
      "step": 2,
      "text": "Melt the butter in a pan. Add the onion and cook for 5 minutes. Add the carrot, turnip, potato, mushrooms, and water, then cook for 10 minutes until the vegetables begin to soften.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Whisk the yeast extract spread and milk together. Stir in the egg, then combine the mixture with the cooked vegetables. Stir in the Cheddar cheese and season with salt and pepper. Let the filling cool until set."
    },
    {
      "step": 4,
      "text": "Roll out the pastry portions, divide the cooled filling among them, and fold each portion over the filling. Seal the edges and brush the pastries with the beaten egg."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until golden brown and the filling is fully set and reaches 160°F at the center when checked with a food thermometer.",
      "timer_minutes": 30
    }
  ],
