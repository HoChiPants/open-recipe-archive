      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt-and-ground-black-pepper-to-taste",
      "item": "kosher salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "jumbo-lump-crabmeat",
      "item": "jumbo lump crabmeat",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cooked, drained and picked over for shells"
    },
    {
      "ingredient_id": "panko-bread-crumbs",
      "item": "panko bread crumbs",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or more as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk together the mayonnaise, beaten egg, Dijon mustard, Worcestershire sauce, and hot sauce. Season with kosher salt and ground black pepper."
    },
    {
      "step": 2,
      "text": "In a separate bowl, combine the crabmeat, panko, and parsley. Fold in the mayonnaise mixture until evenly moistened."
    },
    {
      "step": 3,
      "text": "Shape the mixture into four evenly sized cakes."
    },
    {
      "step": 4,
      "text": "Preheat a skillet over medium heat, then add the canola oil."
    },
    {
      "step": 5,
      "text": "Cook the crab cakes until golden brown, about 5 minutes per side. Verify that the centers reach 160°F and are fully set.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Transfer the cakes to a plate and prepare for serving."
    }
  ],
