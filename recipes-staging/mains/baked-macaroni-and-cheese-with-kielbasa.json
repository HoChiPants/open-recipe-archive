  "id": "baked-macaroni-and-cheese-with-kielbasa",
  "name": "Baked Macaroni and Cheese with Kielbasa",
  "subtitle": "Creamy, crumb-topped pasta with savory sausage",
  "description": "Elbow macaroni and kielbasa are folded into a cheddar sauce, topped with bread crumbs, and baked until bubbling and golden.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 45,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "fully-cooked-kielbasa-sausage",
      "item": "fully cooked kielbasa sausage",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce, cut into 1/2-inch pieces"
    },
    {
      "ingredient_id": "elbow-macaroni",
      "item": "elbow macaroni",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sharp-cheddar-cheese",
      "item": "sharp Cheddar cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, cubed"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or more as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Grease or prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Cook the kielbasa in a skillet until heated through, about 8 minutes. Set aside.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Cook the elbow macaroni in salted water until tender, then drain."
    },
    {
      "step": 4,
      "text": "Melt the butter in a saucepan and cook the onion until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Whisk in the flour and cook for 3 minutes. Gradually add the milk, whisking until the sauce thickens, about 2 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Add the cubed Cheddar and whisk until smooth."
    },
    {
      "step": 7,
      "text": "Combine the drained macaroni with the cheese sauce. Stir in the kielbasa and season with salt and ground black pepper."
    },
    {
      "step": 8,
      "text": "Transfer the mixture to the prepared dish and cover with the dry bread crumbs."
    },
    {
      "step": 9,
      "text": "Bake until hot and the topping is golden, about 20 minutes. Let stand for 15 minutes before serving.",
      "timer_minutes": 20
    }
  ],
