      "item": "water chestnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "drained and chopped"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, wild rice, and water chestnuts in a saucepan. Cook until the rice is tender, about 50 minutes.",
      "timer_minutes": 50
    },
    {
      "step": 2,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 3,
      "text": "Whisk together the cooked rice mixture, chicken, soup, pimento peppers, onion, green beans, mayonnaise, and salt and pepper."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until hot throughout and the chicken mixture reaches 165°F in the center.",
      "timer_minutes": 30
    }
  ],
