  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "uncooked-wild-rice",
      "item": "uncooked wild rice",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cooked",
      "item": "cooked",
      "quantity": 3,
      "unit": "cups",
      "preparation": "cubed chicken breast meat"
    },
    {
