  "id": "chicken-and-wild-rice-casserole",
  "name": "Chicken and Wild Rice Casserole",
  "subtitle": "A creamy baked chicken and rice dinner",
  "description": "Tender wild rice, chicken, green beans, pimentos, and water chestnuts are combined with a creamy dressing and baked until hot.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
