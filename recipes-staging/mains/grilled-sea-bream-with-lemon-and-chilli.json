  "instructions": [
    {
      "step": 1,
      "text": "Heat the barbecue or grill to medium-high heat. Pat the fish dry and make several shallow cuts through the skin on each side."
    },
    {
      "step": 2,
      "text": "Arrange the sliced onion with the fish. Slice the spring onions and chillies, split the garlic, and prepare them for grilling."
    },
    {
      "step": 3,
      "text": "Brush the fish with olive oil and cook for 12 minutes, turning carefully once.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Grill the lemon slices and prepared aromatics alongside the fish for about 10 minutes, turning as needed.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Continue cooking the fish for 8 minutes, or until it reaches 145°F internally and is opaque and easily flaked.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Rest the fish briefly, then cut into portions and serve with the grilled garnishes and boiled new potatoes."
    }
  ],
