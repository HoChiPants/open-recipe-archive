  "instructions": [
    {
      "step": 1,
      "text": "Combine the orange, lemon, and lime juices in a bowl. Add the garlic, salt, annatto, chipotle, cumin, cayenne, oregano, and black pepper; whisk well."
    },
    {
      "step": 2,
      "text": "Slice the pork tenderloins into grilling portions and coat thoroughly with the citrus marinade. Cover and refrigerate for 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 3,
      "text": "Remove the pork from the marinade and pat dry. Rub with the vegetable oil and sprinkle with annatto powder."
    },
    {
      "step": 4,
      "text": "Preheat a grill to medium-high heat and lightly oil the grates."
    },
    {
      "step": 5,
      "text": "Grill the pork, turning as needed, until browned and the thickest pieces reach 145°F on a food thermometer."
    },
    {
      "step": 6,
      "text": "Transfer to a clean plate and rest for at least 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
