  "id": "yucatan-style-grilled-pork",
  "name": "Yucatan-Style Grilled Pork",
  "subtitle": "Citrus-marinated pork with warm annatto and chile",
  "description": "Pork tenderloin is marinated in citrus, garlic, and spices, then grilled until browned and safely cooked.",
  "meal_type": "main",
