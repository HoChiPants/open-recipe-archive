  "id": "air-fryer-turkey-crown",
  "name": "Air-Fryer Turkey Crown",
  "subtitle": "Herb-seasoned turkey with citrus aromatics",
  "description": "A simple air-fried turkey crown flavored with mixed herbs, fresh herbs, clementine, shallot, and garlic.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "turkey-crown",
      "item": "turkey crown",
      "quantity": 1.7,
      "unit": "kg"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "dried-mixed-herbs",
      "item": "dried mixed herbs",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "clementine-halved",
      "item": "clementine halved",
      "quantity": 1
    },
    {
      "ingredient_id": "shallot-halved",
      "item": "shallot halved",
      "quantity": 1
    },
    {
      "ingredient_id": "garlic-cloves-bashed",
      "item": "garlic cloves bashed",
      "quantity": 2
    },
    {
      "ingredient_id": "a-few-fresh-herb-sprigs-such-as-sage",
      "item": "a few fresh herb sprigs such as sage",
      "preparation": "thyme or oregano"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Pat the turkey crown dry and rub it with the vegetable oil."
    },
    {
      "step": 3,
      "text": "Combine the dried mixed herbs with the fresh herb sprigs."
    },
    {
      "step": 4,
      "text": "Place the clementine, shallot, garlic, and fresh herb sprigs around the turkey crown in the air-fryer basket or suitable tray."
    },
    {
      "step": 5,
      "text": "Set the turkey crown in the basket or tray, skin-side up if applicable."
    },
    {
      "step": 6,
      "text": "Cook for 30 minutes, then check the thickest part with a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Continue cooking as needed until the turkey reaches 165°F throughout."
    },
    {
      "step": 8,
      "text": "Rest briefly, then carve and serve."
    }
  ],
