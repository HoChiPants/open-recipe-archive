  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large skillet over medium heat. Add the chicken, onion, and garlic; cook for 10 minutes, stirring occasionally, until the chicken reaches 165°F internally and the onion is tender.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the whole peeled tomatoes, tomato sauce, green bell pepper strips, salt, dried basil, and cayenne pepper. Bring the mixture to a simmer."
    },
    {
      "step": 3,
      "text": "Simmer for 5 minutes to blend the flavors.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Prepare the uncooked instant rice according to its package directions for 5 minutes, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir the rice into the chicken and tomato mixture, then serve."
    }
  ],
