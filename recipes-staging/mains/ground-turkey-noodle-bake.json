  "id": "ground-turkey-noodle-bake",
  "name": "Ground Turkey Noodle Bake",
  "subtitle": "A creamy, tomato-coated noodle casserole with browned turkey and melted cheese.",
  "description": "Tender egg noodles are layered with seasoned ground turkey, tomato sauce, and a creamy cheese mixture, then baked until bubbling and the turkey reaches a safe temperature.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "ground-turkey",
      "item": "ground turkey",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "medium",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "wide-egg-noodles",
      "item": "wide egg noodles",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "tomato-sauce",
      "item": "tomato sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce"
    },
    {
      "ingredient_id": "italian-seasoning",
      "item": "Italian seasoning",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 4,
      "unit": "ounces"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "part-skim-mozzarella-cheese",
      "item": "part-skim mozzarella cheese",
      "quantity": 1.25,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F and coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Cook the ground turkey and onion in a skillet, stirring, for 10 minutes, until the turkey is no longer pink. Drain excess fat, then stir in the tomato sauce and Italian seasoning.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Simmer the sauce over medium-low heat for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Meanwhile, simmer the wide egg noodles in boiling water for 5 minutes, or until tender. Drain.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Warm the milk, cream cheese, fresh parsley, and garlic in a saucepan. Whisk in the part-skim mozzarella cheese for 5 minutes, until smooth and melted.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Combine the drained noodles with the cheese mixture. Layer the noodles and turkey sauce in the prepared dish, finishing with the cream cheese and mozzarella mixture."
    },
    {
      "step": 7,
      "text": "Bake for 30 minutes, until the topping is melted and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
