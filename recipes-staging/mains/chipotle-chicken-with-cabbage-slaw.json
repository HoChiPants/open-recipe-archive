  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Whisk together the rapeseed oil, chipotle paste, and honey, then coat the chicken drumsticks."
    },
    {
      "step": 2,
      "text": "Roast the drumsticks for 30 minutes, until the thickest part reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Blend the lime zest and juice, avocado, Greek yogurt, and part of the carrot until smooth."
    },
    {
      "step": 4,
      "text": "Toss the cabbage, remaining carrot, and spring onions with the avocado dressing."
    },
    {
      "step": 5,
      "text": "Serve the chicken with the slaw and optional steamed corn."
    }
  ],
