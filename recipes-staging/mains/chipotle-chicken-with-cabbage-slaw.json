  "id": "chipotle-chicken-with-cabbage-slaw",
  "name": "Chipotle Chicken with Cabbage Slaw",
  "subtitle": "Smoky roasted drumsticks with creamy lime slaw",
  "description": "Roasted chipotle-honey chicken is paired with crisp cabbage, carrot, and spring onions in a smooth avocado-lime dressing.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
