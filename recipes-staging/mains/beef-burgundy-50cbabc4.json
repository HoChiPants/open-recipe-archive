  "id": "beef-burgundy-50cbabc4",
  "name": "Beef Burgundy",
  "subtitle": "Tender beef with mushrooms in a rich wine sauce",
  "description": "Cubed sirloin tips bake with mushrooms, onion, golden mushroom soup, butter, and Burgundy wine for a hearty French-inspired main dish.",
  "meal_type": "main",
  "cuisine": "French",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 135
  },
  "ingredients": [
    {
      "ingredient_id": "sirloin-tips",
      "item": "sirloin tips",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "medium",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "mushrooms",
      "item": "mushrooms",
      "quantity": 12,
      "unit": "ounces",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "condensed-golden-mushroom-soup",
      "item": "condensed golden mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "burgundy-wine",
      "item": "Burgundy wine",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Place the cubed sirloin tips in a baking dish."
    },
    {
      "step": 3,
      "text": "Cook the chopped onion with the condensed golden mushroom soup until golden brown."
    },
    {
      "step": 4,
      "text": "Add the mushrooms, butter, and Burgundy wine, then stir until evenly combined."
    },
    {
      "step": 5,
      "text": "Pour the mixture over the beef, cover the dish, and bake for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Check the thickest beef pieces with a thermometer; they should reach 145°F. Rest for 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
