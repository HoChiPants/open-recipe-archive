  "id": "shrimp-and-peanut-butter-noodles",
  "name": "Shrimp and Peanut Butter Noodles",
  "subtitle": "Udon with shrimp, broccoli, and tangy peanut sauce",
  "description": "Tender udon and shrimp are tossed with broccoli in a sweet, savory peanut sauce and finished with chopped peanuts.",
  "meal_type": "main",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "light-soy-sauce",
      "item": "light soy sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "chinese-black-vinegar",
      "item": "Chinese black vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "dried-japanese-udon-noodles",
      "item": "dried Japanese udon noodles",
      "quantity": 10,
      "unit": "ounces"
    },
    {
      "ingredient_id": "uncooked-large-shrimp",
      "item": "uncooked large shrimp",
      "quantity": 20,
      "preparation": "peeled, deveined, tails left intact"
    },
    {
      "ingredient_id": "broccoli-florets",
      "item": "broccoli florets",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "roasted-peanuts",
      "item": "roasted peanuts",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the peanut butter, 1 tablespoon soy sauce, vinegar, sugar, and sesame oil together until smooth; set aside."
    },
    {
      "step": 2,
      "text": "Bring a pot of water to a boil. Add the udon and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the broccoli and shrimp to the boiling noodles. Cook for 3 minutes, until the broccoli is tender and the shrimp are opaque and easily reach 145°F on a food thermometer.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Drain, return the mixture to the pot, and toss with the peanut sauce and remaining 1 tablespoon soy sauce."
    },
    {
      "step": 5,
      "text": "Divide among servings and scatter the chopped roasted peanuts over the top."
    }
  ],
