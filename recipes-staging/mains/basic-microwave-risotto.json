  "id": "basic-microwave-risotto",
  "name": "Basic Microwave Risotto",
  "subtitle": "Creamy Arborio rice with Parmesan",
  "description": "A simple microwave risotto combining buttery aromatics, broth, white wine, and Parmesan for a creamy Italian-inspired main dish.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
