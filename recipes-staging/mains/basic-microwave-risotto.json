  "instructions": [
    {
      "step": 1,
      "text": "Combine the butter, garlic, and onion in a microwave-safe dish. Microwave for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Microwave the vegetable broth for 2 minutes, or until boiling.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir the rice into the butter mixture, then add the hot broth. Microwave for 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Stir in the white wine and microwave for 10 minutes, until the rice is tender and creamy.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Let the risotto simmer briefly, then stir in the Parmesan and serve."
    }
  ],
