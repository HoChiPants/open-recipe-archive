  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Bring a large pot of water to a simmer and add the salt. Add the lasagna noodles and cook for 10 minutes, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Combine the crumbled tofu, eggs, pepper, nutmeg, milk, spaghetti sauce, dried parsley, half of the mozzarella, and the Parmesan."
    },
    {
      "step": 4,
      "text": "Layer the drained noodles and tofu mixture in a baking dish, finishing with noodles and any remaining sauce."
    },
    {
      "step": 5,
      "text": "Top with the remaining mozzarella."
    },
    {
      "step": 6,
      "text": "Bake for 35 minutes, until the center is fully set and reaches 160°F.",
      "timer_minutes": 35
    }
  ],
