{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "garlic-glazed-pork-chops",
  "name": "Garlic-Glazed Pork Chops",
  "subtitle": "Thick-cut chops with a sweet, tangy garlic glaze",
  "description": "Bone-in pork chops marinate in a savory garlic mixture, then sear and finish with a sticky glaze.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "light-brown-sugar",
      "item": "light brown sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 6,
      "unit": "cloves",
      "preparation": "crushed, or more to taste"
    },
    {
      "ingredient_id": "rice-vinegar",
      "item": "rice vinegar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "fish-sauce",
      "item": "fish sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ketchup",
      "item": "ketchup",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "hot-sauce",
      "item": "hot sauce",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "10-ounce-thick-cut-bone-in-pork-chops",
      "item": "(10 ounce) thick-cut bone-in pork chops",
      "quantity": 2
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the brown sugar, garlic, rice vinegar, fish sauce, soy sauce, ketchup, black pepper, and hot sauce in a bowl until combined."
    },
    {
      "step": 2,
      "text": "Add the pork chops and turn to coat. Cover and refrigerate for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Remove the chops from the marinade and pat them dry; reserve the marinade."
    },
    {
      "step": 4,
      "text": "Heat the vegetable oil in a large skillet over medium-high heat. Add the chops and sear for about 5 minutes per side.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer the chops to a plate. Pour the reserved marinade into the skillet and simmer for 5 minutes, stirring, until slightly thickened.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Return the chops to the skillet and cook for about 8 minutes, turning to coat with the glaze, until a thermometer inserted into the thickest part reads 145°F.",
      "timer_minutes": 8
    },
    {
      "step": 7,
      "text": "Rest the pork chops for 3 minutes, then cut and serve with the glaze.",
      "timer_minutes": 3
    }
  ],
