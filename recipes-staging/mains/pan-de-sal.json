{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pan-de-sal",
  "name": "Pan de Sal",
  "subtitle": "Soft, lightly sweet Filipino-style bread rolls",
  "description": "A simple yeast dough shaped into small rolls and baked until golden brown.",
  "meal_type": "main",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 6,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the warm water, yeast, and part of the sugar together. Let stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Mix in the remaining sugar, oil, salt, and enough flour to form a smooth dough."
    },
    {
      "step": 3,
      "text": "Knead in the remaining flour until smooth, then knead for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Coat the dough lightly with oil, place it in a bowl, and let it rise for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Turn the dough onto a floured surface. Shape it into a log, cut it into 20 pieces, and form each piece into a roll."
    },
    {
      "step": 6,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 7,
      "text": "Arrange the rolls for a final 30-minute rest.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Bake at 375°F for 20 minutes, or until golden brown.",
      "timer_minutes": 20
    }
  ],
