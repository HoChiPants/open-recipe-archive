  "instructions": [
    {
      "step": 1,
      "text": "Place the pork loin roast in a slow cooker."
    },
    {
      "step": 2,
      "text": "Stir together the cranberry sauce, sliced onion, and French salad dressing, then pour the mixture over the roast."
    },
    {
      "step": 3,
      "text": "Cover and cook until the thickest part of the pork reaches 145°F on a food thermometer.",
      "timer_minutes": 240
    },
    {
      "step": 4,
      "text": "Rest the roast for 3 minutes, then slice and serve with the sauce."
    }
