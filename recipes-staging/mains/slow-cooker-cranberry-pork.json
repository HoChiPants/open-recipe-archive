  "id": "slow-cooker-cranberry-pork",
  "name": "Slow Cooker Cranberry Pork",
  "subtitle": "Tender pork with a sweet-tart cranberry sauce",
  "description": "A simple slow-cooked pork roast coated in cranberry sauce, sliced onion, and French dressing.",
  "meal_type": "main",
