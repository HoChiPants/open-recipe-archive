  "instructions": [
    {
      "step": 1,
      "text": "Arrange the pepper halves cut-side up in a microwave-safe baking dish. Cover and microwave for 4 minutes, until tender.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Combine the stewed tomatoes, brown rice, and hot water in a microwave-safe bowl. Cover and microwave for 4 minutes, until the rice is tender.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Stir in the kidney beans, corn, green onions, and crushed red pepper flakes. Cover and microwave for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Fill the softened pepper halves with the rice mixture and sprinkle with the mozzarella and Parmesan."
    },
    {
      "step": 5,
      "text": "Microwave uncovered for 2 minutes, until the cheese is melted.",
      "timer_minutes": 2
    }
  ],
