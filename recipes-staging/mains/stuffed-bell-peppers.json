  "id": "stuffed-bell-peppers",
  "name": "Stuffed Bell Peppers",
  "subtitle": "Microwave-ready peppers with rice, beans, corn, and melted cheese",
  "description": "Tender bell peppers filled with a savory tomato, brown rice, bean, and corn mixture, then finished with two cheeses.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
