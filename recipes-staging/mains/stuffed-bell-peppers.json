      "item": "red bell peppers",
      "quantity": 2,
      "unit": "large",
      "preparation": "halved and seeded"
    },
    {
      "ingredient_id": "stewed-tomatoes",
      "item": "stewed tomatoes",
      "quantity": 1,
      "unit": "can",
      "preparation": "8 ounce, with liquid"
    },
    {
      "ingredient_id": "quick-cooking-brown-rice",
      "item": "quick-cooking brown rice",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "hot-water",
      "item": "hot water",
      "quantity": 2,
