  "id": "chicken-supreme",
  "name": "Chicken Supreme",
  "subtitle": "Creamy chicken with bacon, onion, and mustard",
  "description": "Pan-cooked chicken breasts finished in a creamy white wine sauce with bacon, onion, garlic, and Dijon mustard.",
