  "instructions": [
    {
      "step": 1,
      "text": "Heat the butter in a large pan. Add the onion and cook until golden brown.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Add the bacon and cook until golden. Stir in the crushed garlic and cook briefly.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Heat the olive oil in the pan. Add the chicken breasts skin-side down and sauté until golden, then turn and cook the other side.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Return the onion and bacon mixture to the pan. Stir in the flour and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Pour in the white wine, then add the cream and Dijon mustard. Return the chicken to the sauce and simmer until cooked through and the thickest part reaches 165°F.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Serve with the optional parsley, mashed potato, and steamed green veg."
    }
  ],
