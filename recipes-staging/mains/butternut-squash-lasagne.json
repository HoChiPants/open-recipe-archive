  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and lightly oil a roasting pan. Toss the squash, unpeeled garlic, and sage leaves with the olive oil, then roast the squash for 50 minutes, until tender.",
      "timer_minutes": 50
    },
    {
      "step": 2,
      "text": "Squeeze the roasted garlic from its skins and mash it with the squash. Wilt the spinach in boiling water, drain well, and cut it into smaller pieces."
    },
    {
      "step": 3,
      "text": "Melt the butter, stir in the flour, and cook briefly. Gradually add the milk, stirring until smooth. Simmer for 1 minute, then stir in the mascarpone, grated parmesan, and nutmeg.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Layer sauce, lasagne sheets, squash, and spinach in a baking dish, repeating until the ingredients are used. Finish with sauce, mozzarella, pine nuts, and parmesan."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, until bubbling and set. Cool for 5 minutes before serving.",
      "timer_minutes": 25
    }
  ],
