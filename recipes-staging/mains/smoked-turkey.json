  "id": "smoked-turkey",
  "name": "Smoked Turkey",
  "subtitle": "Hickory-smoked turkey with garlic, apple, and onion",
  "description": "Season a whole turkey with garlic and spices, fill the cavity with aromatics, and smoke it over hickory until fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
