  "instructions": [
    {
      "step": 1,
      "text": "Preheat the smoker to 250°F. Prepare it for indirect smoking with hickory wood chips."
    },
    {
      "step": 2,
      "text": "Pat the turkey dry. Combine the garlic, seasoned salt, garlic powder, and salt, then rub the mixture over the turkey and inside the cavity."
    },
    {
      "step": 3,
      "text": "Place the turkey in the smoker. Put the apple and onion in the cavity, and add the cola-flavored beverage to the smoker’s liquid pan as appropriate for the smoker."
    },
    {
      "step": 4,
      "text": "Melt the butter and use it to baste the turkey during smoking, adding more hickory chips as needed to maintain smoke."
    },
    {
      "step": 5,
      "text": "Smoke for about 9 hours, maintaining the smoker near 250°F. Begin checking near the end of cooking; the turkey is ready when a food thermometer registers 165°F in the thickest breast and innermost thigh.",
      "timer_minutes": 540
    },
    {
      "step": 6,
      "text": "Transfer the turkey to a serving dish and rest for 20 minutes before carving.",
      "timer_minutes": 20
    }
  ],
