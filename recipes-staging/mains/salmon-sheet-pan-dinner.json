{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "salmon-sheet-pan-dinner",
  "name": "Salmon Sheet Pan Dinner",
  "subtitle": "Roasted salmon with sweet potatoes and broccoli",
  "description": "Salmon, sweet potato wedges, and broccoli roast together on one pan with a tangy honey-mustard glaze and everything seasoning.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "sweet-potatoes",
      "item": "sweet potatoes",
      "quantity": 2,
      "unit": "medium",
      "preparation": "sliced into 1/4-inch wedges"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "divided"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "divided"
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "broccoli-florets",
      "item": "broccoli florets",
      "quantity": 5,
      "unit": "cups"
    },
    {
      "ingredient_id": "5-ounce-salmon-fillets",
      "item": "(5 ounce) salmon fillets",
      "quantity": 4
    },
    {
      "ingredient_id": "everything-bagel-seasoning",
      "item": "everything bagel seasoning",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F and coat a sheet pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Toss the sweet potatoes with the olive oil, half of the salt and pepper, and the cayenne. Spread them on the pan and roast for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir together the Dijon mustard, honey, and cayenne. Season the broccoli with the remaining salt and pepper, then arrange the broccoli and sweet potatoes around the salmon fillets on the pan."
    },
    {
      "step": 4,
      "text": "Brush the salmon with the mustard mixture and sprinkle with the everything bagel seasoning."
    },
    {
      "step": 5,
      "text": "Roast until the salmon reaches 145°F internally and flakes easily, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 6,
      "text": "Stir the soy sauce into any remaining mustard mixture and serve with the roasted vegetables and salmon."
    }
  ],
