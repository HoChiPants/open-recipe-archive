  "instructions": [
    {
      "step": 1,
      "text": "Preheat a large pot over medium heat. Add the vegetable oil and sauté the onions for 10 minutes, until softened and lightly colored.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the minced garlic, then add the lentils and water. Bring the mixture to a simmer."
    },
    {
      "step": 3,
      "text": "Cook the lentils at a gentle simmer for 35 minutes, or until tender.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "Prepare the frozen spinach according to its package directions, then add it to the pot with the salt and cumin."
    },
    {
      "step": 5,
      "text": "Simmer until the spinach is hot and the flavors are combined."
    },
    {
      "step": 6,
      "text": "Mix the crushed garlic with the black pepper, stir it into the lentils, and serve hot."
    }
  ],
