  "id": "lentils-and-spinach",
  "name": "Lentils and Spinach",
  "subtitle": "A savory lentil dish with cumin and wilted spinach",
  "description": "Cook lentils with onions, garlic, and warm spices, then fold in spinach for a hearty vegetarian main dish.",
  "meal_type": "main",
  "cuisine": "Indian",
