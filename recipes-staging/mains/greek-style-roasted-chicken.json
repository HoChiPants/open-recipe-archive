  "id": "greek-style-roasted-chicken",
  "name": "Greek-Style Roasted Chicken",
  "subtitle": "Lemon-and-herb chicken roasted until tender",
  "description": "Bone-in, skin-on chicken leg quarters are coated with olive oil and a savory dried-herb blend, then roasted with lemon halves for a straightforward dinner.",
  "meal_type": "main",
  "cuisine": "Greek Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-leg-quarters",
      "item": "chicken leg quarters",
      "quantity": 4,
      "preparation": "with bone and skin"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemons",
      "quantity": 4,
      "preparation": "halved"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 4,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 4,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 4,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 4,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 4,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the chicken leg quarters in a roasting pan and coat them with the olive oil."
    },
    {
      "step": 3,
      "text": "Arrange the halved lemons around the chicken."
    },
    {
      "step": 4,
      "text": "Mix the oregano, basil, garlic powder, salt, and black pepper, then sprinkle the mixture over the chicken."
    },
    {
      "step": 5,
      "text": "Roast for 60 minutes, then continue roasting as needed until the thickest part of each quarter reaches 165°F on a food thermometer, up to about 75 minutes total.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Remove the chicken from the oven and serve with the roasted lemons."
    }
  ],
