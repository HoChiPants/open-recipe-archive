{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "four-cheese-truffled-macaroni-and-cheese",
  "name": "Four-Cheese Truffled Macaroni and Cheese",
  "subtitle": "Creamy baked pasta with smoky cheese and truffle oil",
  "description": "Cavatappi is folded into a smooth four-cheese sauce, topped with crumbs, and baked until golden.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 45,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cavatappi-corkscrew-macaroni",
      "item": "cavatappi (corkscrew macaroni)",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 5.5,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "smoked-gouda-cheese",
      "item": "smoked Gouda cheese",
      "quantity": 2.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "sharp-cheddar-cheese",
      "item": "sharp Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "swiss-cheese",
      "item": "Swiss cheese",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "truffle-oil",
      "item": "truffle oil",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Bring a large pot of water to a boil. Cook the cavatappi for 8 minutes, then drain.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Melt the butter in a saucepan. Whisk in the flour, then gradually whisk in the milk until smooth."
    },
    {
      "step": 4,
      "text": "Simmer the sauce for 10 minutes, whisking occasionally, until thickened.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Remove the sauce from the heat. Add the smoked Gouda, Cheddar, Swiss, and divided Parmesan; stir until smooth."
    },
    {
      "step": 6,
      "text": "Fold in the drained pasta and transfer the mixture to a baking dish."
    },
    {
      "step": 7,
      "text": "Stir the remaining Parmesan and bread crumbs together, then sprinkle over the pasta. Add the truffle oil."
    },
    {
      "step": 8,
      "text": "Bake for 30 minutes, until the topping is golden and the casserole is hot throughout.",
      "timer_minutes": 30
    },
    {
      "step": 9,
      "text": "Cool for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
