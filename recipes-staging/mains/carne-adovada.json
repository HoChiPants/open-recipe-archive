  "id": "carne-adovada",
  "name": "Carne Adovada",
  "subtitle": "Chile-marinated pork baked until tender",
  "description": "Cubed pork is coated with New Mexico red chile and baked in a savory flour-thickened sauce until tender.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 10,
