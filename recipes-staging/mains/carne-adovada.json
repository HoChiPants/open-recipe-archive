  "instructions": [
    {
      "step": 1,
      "text": "Heat the canola oil in an oven-safe pot. Stir in the flour and cook until golden brown."
    },
    {
      "step": 2,
      "text": "Blend in the red chile powder, then gradually add the warm water. Stir in the garlic, oregano, cumin, and salt."
    },
    {
      "step": 3,
      "text": "Let the chile sauce stand for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Place the cubed pork in the pot and combine it thoroughly with the chile mixture. Cover and marinate for 12 hours.",
      "timer_minutes": 720
    },
    {
      "step": 5,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 6,
      "text": "Bake the covered pork for 2 hours, or until tender and the thickest pieces reach at least 145°F. Rest for 3 minutes before serving.",
      "timer_minutes": 120
    }
  ],
