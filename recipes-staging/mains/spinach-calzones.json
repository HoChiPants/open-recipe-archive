  "id": "spinach-calzones",
  "name": "Spinach Calzones",
  "subtitle": "Cheesy spinach-filled calzones with a crisp baked crust",
  "description": "Thawed bread dough encloses a seasoned ricotta, spinach, and cheese filling for eight hearty baked calzones.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 60,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "15-ounce-container-ricotta-cheese",
      "item": "(15 ounce) container ricotta cheese",
      "quantity": 1
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "dried-italian-seasoning",
      "item": "dried Italian seasoning",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 3,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "freshly-grated-parmesan-cheese",
      "item": "freshly grated Parmesan cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed and squeezed dry"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "frozen-white-bread-dough",
      "item": "frozen white bread dough",
      "quantity": 1,
      "unit": "package",
      "preparation": "32 ounce, thawed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Stir together the ricotta, eggs, Italian seasoning, mozzarella, Parmesan, spinach, salt, and pepper until evenly combined."
    },
    {
      "step": 3,
      "text": "Divide the thawed dough into eight portions. Roll each portion into a round."
    },
    {
      "step": 4,
      "text": "Place filling on one side of each dough round, leaving a border. Fold the dough over the filling and press the edges firmly to seal."
    },
    {
      "step": 5,
      "text": "Transfer the calzones to a baking sheet and bake until the crust is browned and the filling reaches 160°F in the center.",
      "timer_minutes": 30
    }
  ],
