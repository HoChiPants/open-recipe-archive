  "instructions": [
    {
      "step": 1,
      "text": "Blend the dried chiles, cinnamon, cumin, peppercorns, turmeric, cloves, and green chiles with the 1 tablespoon vinegar until smooth. Season with salt."
    },
    {
      "step": 2,
      "text": "Place the pork in a bowl, add the spice paste, and turn to coat evenly. Cover and refrigerate for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Heat the oil in a large heavy pot over medium heat. Add the onions, garlic, and ginger; cook, stirring, until golden brown.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the marinated pork and cook, stirring, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Pour in the boiling water. Cover, reduce the heat, and simmer until the pork is tender and reaches 145°F internally; rest the pork for 3 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Stir in the remaining vinegar and the green chile strips. Cook uncovered until the sauce thickens."
    },
    {
      "step": 7,
      "text": "Taste and adjust the salt before serving."
    }
  ],
