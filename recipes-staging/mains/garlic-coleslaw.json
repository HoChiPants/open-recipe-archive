  "instructions": [
    {
      "step": 1,
      "text": "Place the shredded cabbage in a large bowl. Add the garlic and salt, toss to distribute, and transfer the mixture to a clean mixing bowl if needed for dressing preparation."
    },
    {
      "step": 2,
      "text": "Whisk together the garlic, grapeseed oil, mayonnaise, vinegar, paprika, white pepper, sugar, and celery seed until blended."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the cabbage and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Cover and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Stir before serving."
    }
  ],
