  "id": "chicken-pasta-bake",
  "name": "Chicken Pasta Bake",
  "subtitle": "Creamy tomato penne with chicken and a melted cheese topping",
  "description": "Penne and chicken are combined with a creamy tomato sauce, finished with cheddar, mozzarella, and parsley, then baked until golden.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "onion-finely-chopped",
      "item": "onion finely chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "garlic-cloves-crushed",
      "item": "garlic cloves crushed",
      "quantity": 2
    },
    {
      "ingredient_id": "chilli-flakes-optional",
      "item": "chilli flakes",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "x-400g-cans-chopped-tomatoes",
      "item": "x 400g cans chopped tomatoes",
      "quantity": 2
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "mascarpone",
      "item": "mascarpone",
      "quantity": 6,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "skinless-chicken-breasts",
      "item": "skinless chicken breasts",
      "quantity": 4,
      "preparation": "sliced into strips"
    },
    {
      "ingredient_id": "penne",
      "item": "penne",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "mature-cheddar-grated",
      "item": "mature cheddar grated",
      "quantity": 70,
      "unit": "g"
    },
    {
      "ingredient_id": "grated-mozzarella",
      "item": "grated mozzarella",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "bunch-of-parsley-finely-chopped",
      "item": "bunch of parsley finely chopped",
      "quantity": "1/2",
      "unit": "small"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pan. Cook the onion for 12 minutes until softened.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Add the garlic and chilli flakes; cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Stir in the tomatoes and caster sugar, then simmer until slightly reduced. Stir in the mascarpone and cook until the sauce thickens.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Preheat the oven for baking. Cook the chicken strips in a separate pan until cooked through and the thickest piece reaches 165°F on a food thermometer.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Cook the penne according to the package directions, then drain."
    },
    {
      "step": 6,
      "text": "Combine the pasta, tomato sauce, and chicken in a baking dish. Sprinkle with the cheddar, mozzarella, and parsley."
    },
    {
      "step": 7,
      "text": "Bake until the cheese is melted and golden brown.",
      "timer_minutes": 20
    }
  ],
