  "id": "chicken-quinoa-and-vegetables",
  "name": "Chicken, Quinoa, and Vegetables",
  "subtitle": "A bright one-pan-style meal with feta and basil",
  "description": "Tender chicken and vegetables are served over broth-cooked quinoa with feta, basil, and lime.",
  "meal_type": "main",
  "cuisine": "Mediterranean Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
