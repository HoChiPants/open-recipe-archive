      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "quinoa",
      "item": "quinoa",
      "quantity": 1,
      "unit": "cup",
      "preparation": "rinsed"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
