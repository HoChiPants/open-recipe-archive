  "instructions": [
    {
      "step": 1,
      "text": "Combine the chicken broth and rinsed quinoa in a saucepan. Bring to a simmer, cover, and cook for 12 minutes, or until the quinoa is set and the liquid is absorbed.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Meanwhile, heat half of the olive oil in a skillet. Add the garlic scapes and onion and stir for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Transfer the aromatics to a plate. Add the remaining olive oil and cook the chicken strips until no longer pink and the thickest piece reaches 165°F."
    },
    {
      "step": 4,
      "text": "Add the zucchini and tomato to the skillet and stir until tender, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Return the aromatics to the skillet and add the feta, basil, and lime juice. Stir briefly to combine."
    },
    {
      "step": 6,
      "text": "Fluff the quinoa and serve the chicken and vegetables over it."
    }
  ],
