  "id": "keto-white-chicken-chili",
  "name": "Keto White Chicken Chili",
  "subtitle": "Creamy chicken chili with green chilies and Monterey Jack",
  "description": "Tender seasoned chicken is shredded and folded into a creamy, cheesy chili base with green chilies and warm spices.",
  "meal_type": "main",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40,
    "inactive_minutes": 10
  },
  "ingredients": [
