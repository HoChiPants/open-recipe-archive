  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Melt half of the butter with the oil in a large oven-safe skillet or pot. Season the chicken with chili powder, salt, and pepper, then add it to the pan with the chicken broth."
    },
    {
      "step": 3,
      "text": "Cook the chicken in the broth for 5 minutes, then continue cooking for 15 minutes, turning as needed, until the thickest part reaches 165°F.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Transfer the chicken to a plate and let it rest for 10 minutes. Shred it once rested.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Melt the remaining butter in the skillet. Add the cream, cream cheese, onion powder, cumin, hot sauce, Monterey Jack, and the cooking broth; whisk for 5 minutes, until smooth and melted.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir in the green chilies and shredded chicken. Simmer gently, seasoning with salt and pepper to taste, until hot throughout."
    }
  ],
