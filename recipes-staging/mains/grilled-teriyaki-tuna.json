  "instructions": [
    {
      "step": 1,
      "text": "Combine the teriyaki sauce, olive oil, minced garlic, and black pepper in a shallow dish."
    },
    {
      "step": 2,
      "text": "Add the tuna fillets and turn to coat. Cover and marinate for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat the grill to medium-high heat and lightly oil the grates if needed."
    },
    {
      "step": 4,
      "text": "Grill the tuna for about 5 minutes per side, turning once, until opaque and easily flaked or the center reaches 145°F.",
      "timer_minutes": 10
    }
