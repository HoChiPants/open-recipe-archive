  "id": "chicken-and-bacon-tagliatelle",
  "name": "Chicken and Bacon Tagliatelle",
  "subtitle": "Creamy tagliatelle with chicken, bacon, and parsley",
  "description": "A rich pasta dish combining shredded chicken and crisp bacon with a mascarpone-Parmesan cream sauce.",
