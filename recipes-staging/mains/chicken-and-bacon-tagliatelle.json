  "instructions": [
    {
      "step": 1,
      "text": "Cook the tagliatelle according to the package directions until tender, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the olive oil and butter in a large skillet. Add the onion and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the garlic and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Whisk in the cream, mascarpone, Parmesan, and crumbled stock cube until smooth and hot."
    },
    {
      "step": 5,
      "text": "Add the shredded chicken and chopped bacon. Warm through; if the chicken was refrigerated, heat the mixture to 165°F."
    },
    {
      "step": 6,
      "text": "Toss the pasta with the sauce and parsley. Serve with the green salad."
    }
  ],
