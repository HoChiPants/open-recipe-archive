  "id": "crispy-baked-chicken-with-giardiniera",
  "name": "Crispy Baked Chicken with Giardiniera",
  "subtitle": "Breaded chicken topped with giardiniera and melted provolone",
  "description": "Chicken breasts are coated with crushed garlic croutons, browned in olive oil, then baked with giardiniera and provolone until fully cooked.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "4-ounce-boneless",
      "item": "(4 ounce) boneless",
      "quantity": 4,
      "preparation": "skinless chicken breasts"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "butter-and-garlic-croutons",
      "item": "butter and garlic croutons",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large",
      "preparation": "beaten"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "giardiniera",
      "item": "giardiniera",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "slices-provolone-cheese",
      "item": "slices provolone cheese",
      "quantity": 4
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "minced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Season the chicken with salt and pepper, and crush the croutons into coarse crumbs."
    },
    {
      "step": 2,
      "text": "Place the flour and beaten eggs in separate shallow dishes. Dredge each chicken breast in flour, dip it in egg, then coat it with the crouton crumbs."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in an oven-safe skillet over medium-high heat. Brown the coated chicken for about 2 minutes per side.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Chop the giardiniera and place it over the chicken. Top each breast with a slice of provolone."
    },
    {
      "step": 5,
      "text": "Bake until the chicken reaches 165°F at the thickest point and the cheese is melted, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Sprinkle with the minced parsley and serve."
    }
  ],
