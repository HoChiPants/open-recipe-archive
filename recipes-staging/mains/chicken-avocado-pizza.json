  "id": "chicken-avocado-pizza",
  "name": "Chicken Avocado Pizza",
  "subtitle": "Crisp individual pizzas with creamy avocado and chicken",
  "description": "Pre-baked crusts are brushed with olive oil, layered with garlic, chicken, tomatoes, cheese, and cayenne, then grilled until the cheese melts and finished with a lime-seasoned avocado topping.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "avocados",
      "item": "avocados",
      "quantity": 2,
      "preparation": "peeled, pitted and diced"
    },
    {
      "ingredient_id": "fresh-cilantro",
      "item": "fresh cilantro",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fresh-lime-juice",
      "item": "fresh lime juice",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "7-inch-pre-baked-pizza-crusts",
      "item": "(7 inch) pre-baked pizza crusts",
      "quantity": 4
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "chicken-breast-meat",
      "item": "chicken breast meat",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped cooked"
    },
    {
      "ingredient_id": "cherry-tomatoes",
      "item": "cherry tomatoes",
      "quantity": 1,
      "unit": "cup",
      "preparation": "quartered"
    },
    {
      "ingredient_id": "monterey-jack-cheese",
      "item": "Monterey Jack cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Mash or stir the avocados with cilantro, lime juice, and salt until combined; set aside."
    },
    {
      "step": 2,
      "text": "Halve the garlic clove and rub the cut side over the pizza crusts. Brush the crusts with olive oil."
    },
    {
      "step": 3,
      "text": "Top each crust with cooked chicken and tomatoes, then scatter over the Monterey Jack and cayenne pepper."
    },
    {
      "step": 4,
      "text": "Grill the pizzas for 5 minutes, or until the cheese is melted and the chicken is heated to 165°F.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Cut the pizzas and serve with the avocado mixture spooned over the top."
    }
  ],
