  "id": "blistered-sweet-potatoes-with-herby-tuna",
  "name": "Blistered Sweet Potatoes with Herby Tuna",
  "subtitle": "Microwaved potatoes finished in a hot skillet with lemony tuna salad",
  "description": "Tender sweet potatoes are blistered in olive oil and topped with tuna, herbs, vegetables, feta, and a creamy pesto dressing.",
  "meal_type": "main",
