  "instructions": [
    {
      "step": 1,
      "text": "Prick the sweet potatoes and microwave until tender, about 10 minutes. Split them lengthwise.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Place the sweet potatoes cut-side down and cook until blistered and browned, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Mix the drained tuna with the pesto, Greek yogurt, lemon juice and zest, parsley, roasted pepper, cucumber, and feta. If using uncooked tuna, cook it separately to 145°F, or until opaque and easily flaked, before mixing."
    },
    {
      "step": 4,
      "text": "Spoon the tuna mixture over the sweet potatoes. Finish with the extra dill and serve with the optional salad."
    }
  ],
