  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of water to a boil. Cook the rigatoni for 13 minutes, then drain.",
      "timer_minutes": 13
    },
    {
      "step": 2,
      "text": "Meanwhile, heat a skillet and cook the diced bacon for 10 minutes, until set and browned. Stir in the garlic and cook briefly.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the milk, cream cheese, softened butter, and Parmesan in a saucepan over gentle heat. Simmer, stirring, until smooth."
    },
    {
      "step": 4,
      "text": "Add the bacon, peas, and diced cooked ham to the sauce. Cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Combine the drained rigatoni with the sauce and serve hot."
    }
  ],
