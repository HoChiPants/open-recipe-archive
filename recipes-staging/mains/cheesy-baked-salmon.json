      "item": "green onions",
      "quantity": 6,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F. Place the salmon fillets in a baking dish."
    },
    {
      "step": 2,
      "text": "Combine the crushed garlic, dill, salt, and pepper, then spread the mixture over the salmon."
    },
    {
      "step": 3,
      "text": "Bake the salmon for 20 minutes, or until it reaches 145°F and flakes easily with a fork.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Top the salmon with the chopped green onions and shredded Cheddar."
    },
    {
      "step": 5,
      "text": "Bake for 5 minutes more, until the cheese is melted.",
      "timer_minutes": 5
    }
  ],
