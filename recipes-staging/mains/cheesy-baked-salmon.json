  "id": "cheesy-baked-salmon",
  "name": "Cheesy Baked Salmon",
  "subtitle": "Tender salmon with dill, scallions, and melted cheddar",
  "description": "Seasoned salmon is baked until flaky, topped with green onions and cheddar, then returned to the oven until the cheese melts.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
