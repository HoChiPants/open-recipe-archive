      "ingredient_id": "salmon-fillets",
      "item": "salmon fillets",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "dried-dill-weed",
      "item": "dried dill weed",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
