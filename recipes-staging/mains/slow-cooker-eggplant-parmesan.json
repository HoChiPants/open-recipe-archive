  "id": "slow-cooker-eggplant-parmesan",
  "name": "Slow Cooker Eggplant Parmesan",
  "subtitle": "Tender eggplant layered with marinara and melted cheese",
  "description": "Salted eggplant is briefly sautéed, then layered with marinara, Parmesan, breadcrumbs, and mozzarella for a hands-off baked-style main dish.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 260,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "eggplant",
      "item": "eggplant",
      "quantity": 4,
      "preparation": "peeled and cut into 1/2-inch slices"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "seasoned-bread-crumbs",
      "item": "seasoned bread crumbs",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "32-ounce-jar-prepared-marinara-sauce",
      "item": "(32 ounce) jar prepared marinara sauce",
      "quantity": 1
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce, sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Arrange the eggplant slices in layers, sprinkling salt between them. Let stand for 30 minutes, then drain well.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Whisk the eggs, water, and flour in a bowl until smooth. In a separate bowl, combine the Parmesan, seasoned bread crumbs, and mozzarella."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a skillet. Dip the eggplant in the egg mixture and sauté in batches until golden brown. Drain the slices."
    },
    {
      "step": 4,
      "text": "Spread some marinara in the slow cooker. Add layers of eggplant, the cheese mixture, and more marinara, repeating until the ingredients are used."
    },
    {
      "step": 5,
      "text": "Cover and cook on low until the eggplant is tender and the layers are hot, about 260 minutes.",
      "timer_minutes": 260
    }
  ],
