  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer."
    },
    {
      "step": 2,
      "text": "Warm the olive oil in a pan over medium heat. Add the onion and garlic and cook until softened, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir in the chopped tomatoes and chilli flakes. Simmer for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Combine the cooked pasta, drained tuna, half of the mozzarella, parsley, and tomato sauce in a heatproof dish. Top with the remaining mozzarella."
    },
    {
      "step": 5,
      "text": "Air-fry until the cheese is melted, the dish is bubbling, and the center reaches 145°F or is hot throughout, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
