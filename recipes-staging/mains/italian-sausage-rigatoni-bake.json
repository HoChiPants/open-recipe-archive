  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the rigatoni in boiling water for 12 minutes, then drain and set aside.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Cook the sausage and onion in a skillet for 7 minutes, breaking up the sausage, until browned and cooked through to 160°F.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Stir together the cottage cheese, eggs, half the mozzarella, Parmesan, parsley, Italian seasoning, basil, and salt and pepper."
    },
    {
      "step": 5,
      "text": "Combine the cooked sausage mixture with the spaghetti sauce, then fold in the drained rigatoni and cottage cheese mixture."
    },
    {
      "step": 6,
      "text": "Transfer the mixture to a baking dish and bake for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Top with the remaining cottage cheese, mozzarella, and Parmesan, then bake for 15 minutes, until melted and the center reaches 165°F.",
      "timer_minutes": 15
    }
  ],
