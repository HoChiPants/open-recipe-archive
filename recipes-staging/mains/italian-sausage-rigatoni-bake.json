  "id": "italian-sausage-rigatoni-bake",
  "name": "Italian Sausage Rigatoni Bake",
  "subtitle": "A hearty layered pasta casserole with seasoned sausage and melted cheese.",
  "description": "Rigatoni, browned sausage, tomato sauce, seasoned cottage cheese, and mozzarella bake together into a comforting Italian-inspired main dish.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
