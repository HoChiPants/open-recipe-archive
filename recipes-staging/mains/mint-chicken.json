  "id": "mint-chicken",
  "name": "Mint Chicken",
  "subtitle": "Tender chicken with lemon and fresh mint",
  "description": "Bite-size chicken is coated in flour, cooked with garlic in margarine, and finished with lemon juice and chopped mint.",
