  "instructions": [
    {
      "step": 1,
      "text": "Toss the chicken pieces with the crushed garlic, then coat them evenly with the flour."
    },
    {
      "step": 2,
      "text": "Melt the margarine in a skillet over medium heat. Add the coated chicken and stir as it cooks until the thickest pieces reach 165°F."
    },
    {
      "step": 3,
      "text": "Stir in the lemon juice and chopped mint. Continue cooking until the chicken is cooked through, about 5 minutes.",
