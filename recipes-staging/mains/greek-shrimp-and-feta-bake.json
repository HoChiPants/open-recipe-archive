  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 250°F."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large ovenproof skillet or baking dish. Stir in the garlic, chopped parsley, tomatoes, white wine, and parsley sprigs."
    },
    {
      "step": 3,
      "text": "Simmer the mixture until the sauce thickens.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Stir in the shrimp and cook briefly, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Transfer the mixture to a baking dish if needed, then scatter the feta over the top."
    },
    {
      "step": 6,
      "text": "Bake until the shrimp are opaque and firm and the feta is warmed through.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Garnish with chopped parsley and serve with the lemon halves."
    }
  ],
