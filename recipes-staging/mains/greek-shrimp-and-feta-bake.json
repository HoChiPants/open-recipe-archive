  "id": "greek-shrimp-and-feta-bake",
  "name": "Greek Shrimp and Feta Bake",
  "subtitle": "Tomato-braised shrimp finished with feta and lemon",
  "description": "A Greek-style baked shrimp dish with a rich tomato and white-wine sauce, feta, parsley, and lemon.",
  "meal_type": "main",
