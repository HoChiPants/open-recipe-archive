  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Toss the chicken with the butter, garlic powder, salt, ground black pepper, and red pepper flakes."
    },
    {
      "step": 2,
      "text": "Grill the chicken for 6 minutes, turning as needed, until it reaches 165°F at the center. Cut into bite-size pieces if needed.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Bring a pot of salted water to a simmer. Add the penne and cook until tender, about 11 minutes.",
      "timer_minutes": 11
    },
    {
      "step": 4,
      "text": "Drain the pasta and return it to the pot. Add the chicken, spinach, Parmesan, ground black pepper, and red pepper flakes."
    },
    {
      "step": 5,
      "text": "Heat gently until the spinach wilts and the cheese begins to melt. Adjust the salt, pepper, and red pepper flakes to taste, then serve."
    }
  ],
