      "item": "pork spareribs",
      "quantity": 3,
      "unit": "pounds",
      "preparation": "cut into serving size pieces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Combine the vinegar, ketchup, soy sauce, and crushed pineapple in a saucepan. Stir in the brown sugar, cornstarch, salt, and grated ginger."
    },
    {
      "step": 3,
      "text": "Cook over medium heat, stirring frequently, until the sauce thickens, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Arrange the spareribs in layers in a baking dish, spooning sauce between and over the pieces."
    },
    {
      "step": 5,
      "text": "Bake until tender, about 120 minutes. Check that the thickest pieces reach at least 145°F, then let them rest for 3 minutes before serving.",
      "timer_minutes": 120
    }
  ],
