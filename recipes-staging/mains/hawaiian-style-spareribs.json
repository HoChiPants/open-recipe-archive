  "id": "hawaiian-style-spareribs",
  "name": "Hawaiian-Style Spareribs",
  "subtitle": "Tender pork ribs with pineapple-ginger sauce",
  "description": "Pork spareribs bake in a tangy pineapple sauce sweetened with brown sugar and thickened with cornstarch.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
