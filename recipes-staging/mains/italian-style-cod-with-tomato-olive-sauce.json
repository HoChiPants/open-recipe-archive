  "id": "italian-style-cod-with-tomato-olive-sauce",
  "name": "Italian-Style Cod with Tomato-Olive Sauce",
  "subtitle": "Cod simmered in a savory tomato, olive, and white wine sauce",
  "description": "A simple stovetop cod entrée layered with tomatoes, olives, parsley, garlic, and wine.",
  "meal_type": "main",
