  "instructions": [
    {
      "step": 1,
      "text": "Preheat a large, deep skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the olive oil, onion, and garlic. Sauté until the onion softens and the garlic is fragrant."
    },
    {
      "step": 3,
      "text": "Stir in the tomatoes, black olives, fresh parsley, and dry white wine."
    },
    {
      "step": 4,
      "text": "Simmer the sauce for 5 minutes to blend the flavors.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Nestle the cod fillets into the sauce. Cover and simmer until the fish reaches 145°F or is opaque and flakes easily."
    }
  ],
