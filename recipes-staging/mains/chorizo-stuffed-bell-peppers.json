  "instructions": [
    {
      "step": 1,
      "text": "Bring the water to a boil in a large pot. Add the bell peppers and salt and pepper to taste; blanch for 5 minutes, then drain and let them cool until set.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 3,
      "text": "Cook the chorizo sausage in a skillet until browned, then drain excess fat."
    },
    {
      "step": 4,
      "text": "Stir in the celery, carrot, onion, and garlic. Cook for 5 minutes, then season with salt and pepper to taste.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the chopped tomatoes, Worcestershire sauce, parsley, basil, uncooked rice, water, and tomato soup. Simmer for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Arrange the cooled peppers in a baking dish and season them with salt and pepper to taste. Fill with the chorizo mixture and top with the Monterey Jack, Cheddar, and Mozzarella cheeses."
    },
    {
      "step": 7,
      "text": "Bake for 30 minutes, until the peppers are tender and the sausage filling reaches 160°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
