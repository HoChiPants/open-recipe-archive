  "instructions": [
    {
      "step": 1,
      "text": "Cut the celeriac into thick pieces. Prepare it for roasting, seasoning with soy sauce to taste as directed by the component preparation."
    },
    {
      "step": 2,
      "text": "Simmer the celeriac for 12 minutes, then prepare it for roasting. Preheat the oven.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Warm the celeriac with 25 g butter and the light brown sugar for 10 minutes. Transfer it to a roasting dish with the maple syrup, bunch of thyme, thyme sprig, and thyme leaves.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Bake the celeriac until tender, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Prepare the remaining celeriac, cut it into thick pieces, and simmer for 10 minutes. Add the crème fraîche, cayenne pepper, and freshly grated nutmeg, then prepare the mash until set.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Prepare the tomato purée until smooth. Preheat the cooking surface for the gravy and prepare the celeriac and onion."
    },
    {
      "step": 7,
      "text": "Add the celeriac, 25 g butter, onion, light brown sugar, and vegetable stock pot or cube. Cook for 15 minutes, then cook with the sugar as needed.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Stir in the plain flour, Marmite, and tomato purée. Cook with the red wine vinegar, then add the celeriac, vegetable stock pot or cube, and soy sauce to taste. Simmer until thickened."
    },
    {
      "step": 9,
      "text": "Prepare the accompaniments and preheat the oven or serving dish with the celeriac for 10 minutes. Cut any remaining pieces thickly.",
      "timer_minutes": 10
    },
    {
      "step": 10,
      "text": "Serve the roasted celeriac, mash, and gravy with the bunch of thyme, onion finely chopped, bay leaves, thyme sprig, and thyme leaves. Add the cooked chestnuts if using."
    }
  ],
