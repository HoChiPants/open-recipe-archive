  "id": "chicken-a-la-king",
  "name": "Chicken à la King",
  "subtitle": "Creamy chicken with mushrooms and peppers",
  "description": "Tender chicken and vegetables simmer in a sherry-scented cream sauce, finished with fresh herbs and chives.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
