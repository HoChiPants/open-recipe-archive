  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large skillet over medium heat. Add the mushrooms, season with salt and black pepper, and sauté for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the shallots and cook for 4 minutes, until softened.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Add the flour and stir until it coats the vegetables; cook for 5 minutes to form a smooth roux.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the bell peppers, a little salt and pepper, and the cayenne. Cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Pour in the sherry and cook briefly, then gradually whisk in the chicken stock until smooth."
    },
    {
      "step": 6,
      "text": "Simmer for about 15 minutes, stirring occasionally, until the sauce thickens.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Season with nutmeg, cayenne, salt, and black pepper. Whisk in the thyme, parsley, and crème fraîche or cream."
    },
    {
      "step": 8,
      "text": "Fold in the cubed roasted chicken and heat for 5 minutes, until the mixture reaches 165°F throughout.",
      "timer_minutes": 5
    },
    {
      "step": 9,
      "text": "Garnish with the chopped chives and serve hot."
    }
  ],
