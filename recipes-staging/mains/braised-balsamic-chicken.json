  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken breasts with garlic salt and black pepper."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Add the chicken and cook for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Add the sliced onion and cook, stirring occasionally, for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Add the diced tomatoes and balsamic vinegar. Stir in the basil, oregano, rosemary, and thyme."
    },
    {
      "step": 5,
      "text": "Reduce the heat and simmer for 15 minutes, or until the chicken reaches 165°F in the thickest part.",
      "timer_minutes": 15
    }
  ],
