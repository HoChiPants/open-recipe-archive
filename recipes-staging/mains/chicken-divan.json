{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chicken-divan",
  "name": "Chicken Divan",
  "subtitle": "A creamy chicken and broccoli casserole with a browned Cheddar topping.",
  "description": "Layer frozen broccoli and cooked chicken in a baking dish, cover with a creamy lemon-mayonnaise sauce, and bake with Cheddar until lightly browned.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-chopped-broccoli",
      "item": "frozen chopped broccoli",
      "quantity": 2,
      "unit": "package",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "boneless-chicken-breast-halves",
      "item": "boneless chicken breast halves",
      "quantity": 2,
      "preparation": "cooked, chopped"
    },
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the frozen broccoli in a baking dish and arrange the chopped cooked chicken over it."
    },
    {
      "step": 3,
      "text": "Stir both soups, mayonnaise, and lemon juice together until combined. Spread the mixture over the chicken and broccoli."
    },
    {
      "step": 4,
      "text": "Sprinkle the shredded Cheddar evenly over the top."
    },
    {
      "step": 5,
      "text": "Bake for 40 minutes, until lightly browned and heated through. If any chicken was not fully cooked before assembly, verify the casserole reaches 165°F with a food thermometer.",
      "timer_minutes": 40
    }
  ],
