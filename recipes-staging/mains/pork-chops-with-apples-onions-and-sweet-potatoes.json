  "id": "pork-chops-with-apples-onions-and-sweet-potatoes",
  "name": "Pork Chops with Apples, Onions, and Sweet Potatoes",
  "subtitle": "A simple baked pork dinner with sweet and savory layers.",
  "description": "Pork chops bake with rings of apple and onion and sliced sweet potatoes, finished with brown sugar and seasoning.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "pork-chops",
      "item": "pork chops",
      "quantity": 4
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "preparation": "sliced into rings"
    },
    {
      "ingredient_id": "sweet-potatoes",
      "item": "sweet potatoes",
      "quantity": 2,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "apples",
      "item": "apples",
      "quantity": 2,
      "preparation": "peeled, cored, and sliced into rings"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Arrange the pork chops in a baking dish and season with the salt and pepper to taste, freshly ground black pepper, and salt."
    },
    {
      "step": 3,
      "text": "Layer the onions, sweet potatoes, and apples around and over the pork chops. Sprinkle the brown sugar over the top."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, until the sweet potatoes are tender and the pork reaches 145°F on a food thermometer. Rest the pork for 3 minutes before serving.",
      "timer_minutes": 60
    }
  ],
