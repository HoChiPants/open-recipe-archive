{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "scandinavian-cod",
  "name": "Scandinavian Cod",
  "subtitle": "Tender cod with a buttery paprika finish",
  "description": "Cod is simmered briefly in a sweet-salty liquid, grilled until golden, and finished with melted butter and paprika.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 6,
      "unit": "cups",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "6-ounce-fillets-cod",
      "item": "(6 ounce) fillets cod",
      "quantity": 6
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "melted"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "dash"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Stir the water, white sugar, and salt together in a saucepan, using enough water to cover the fish."
    },
    {
      "step": 2,
      "text": "Bring the seasoned liquid to a simmer and maintain it for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the cod fillets and simmer gently until they are opaque and begin to flake. Transfer them carefully to the grill."
    },
    {
      "step": 4,
      "text": "Grill the cod until golden brown and the thickest part reaches 145°F or flakes easily.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Serve the fish with the melted butter and a dash of paprika."
    }
  ],
