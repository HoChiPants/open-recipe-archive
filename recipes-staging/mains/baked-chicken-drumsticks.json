  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Combine the olive oil, cumin, smoked paprika, oregano, garlic granules, and black pepper. Coat the chicken drumsticks evenly with the mixture."
    },
    {
      "step": 3,
      "text": "Transfer the drumsticks to a baking dish or sheet and bake for 20 minutes. Continue baking until cooked through and the thickest part reaches 165°F on a food thermometer, about 40 minutes total.",
      "timer_minutes": 20
    }
  ],
