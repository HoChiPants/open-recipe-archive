  "instructions": [
    {
      "step": 1,
      "text": "Simmer the red wine, brandy, shallot, and garlic in a small pan until reduced and softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Heat the sunflower oil in a skillet and cook the chicken livers until browned and a thermometer registers 165°F at the center, about 1 minute per side or as needed.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Transfer the livers and wine reduction to a blender. Add the thyme, cream, and melted unsalted butter, then blend until smooth."
    },
    {
      "step": 4,
      "text": "Divide the mixture among serving dishes, chill until set, about 2 hours, then cover the surface with the melted clarified butter and chill until firm.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Serve with the brioche and chutney."
    }
  ],
