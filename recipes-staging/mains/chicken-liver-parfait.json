  "id": "chicken-liver-parfait",
  "name": "Chicken Liver Parfait",
  "subtitle": "Smooth liver spread with brioche and fruit chutney",
  "description": "A rich chicken liver parfait blended with aromatics, cream, and butter, then chilled and finished with clarified butter. Serve with toasted brioche and chutney.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
