  "id": "baked-parmesan-chicken-thighs",
  "name": "Baked Parmesan Chicken Thighs",
  "subtitle": "Crisp, savory chicken from the oven",
  "description": "Boneless chicken thighs are coated with seasoned Parmesan and baked until browned and safely cooked through.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
