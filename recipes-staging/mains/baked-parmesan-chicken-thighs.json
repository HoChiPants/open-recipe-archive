      "ingredient_id": "5-ounce-boneless",
      "item": "(5 ounce) boneless",
      "quantity": 8,
      "preparation": "skinless chicken thighs"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Arrange the chicken thighs in a single layer in a baking dish."
    },
    {
      "step": 2,
      "text": "Place the olive oil in a shallow dish. Combine the Parmesan, celery salt, cayenne, and garlic powder in a separate shallow dish."
    },
    {
      "step": 3,
      "text": "Dip each chicken thigh in the oil, then coat it with the seasoned Parmesan mixture. Transfer the coated thighs to the baking dish."
    },
    {
      "step": 4,
      "text": "Bake for 25 minutes, until the chicken reaches 165°F in the thickest part on a food thermometer.",
      "timer_minutes": 25
    }
  ],
