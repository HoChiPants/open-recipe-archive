{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "baked-macaroni-and-cheese-ceedefbd",
  "name": "Baked Macaroni and Cheese",
  "subtitle": "Creamy cheddar pasta with a golden baked finish",
  "description": "Tender macaroni is folded into a smooth cheddar and cream cheese sauce, layered with more cheese, and baked until bubbling.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "elbow-macaroni",
      "item": "elbow macaroni",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 4,
      "unit": "teaspoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "sharp-cheddar-cheese",
      "item": "sharp Cheddar cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.333,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-mustard",
      "item": "ground mustard",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 3.5,
      "unit": "cups",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 3,
      "unit": "ounces",
      "preparation": "softened"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and coat a large baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Bring a pot of water to a simmer, add the macaroni and part of the divided salt, and cook for 6 minutes. Drain when the pasta is set but still firm.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Shred the Cheddar and divide it for the sauce and topping; break the softened cream cheese into small pieces."
    },
    {
      "step": 4,
      "text": "Melt the butter in a saucepan. Whisk in the flour and cook for 4 minutes, until the mixture is smooth.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Whisk in the ground mustard and milk. Continue cooking and whisking for about 5 minutes, until the sauce thickens.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Add the cream cheese and the sauce portion of the Cheddar. Whisk for about 5 minutes, until smooth and thick, then season with the remaining salt, black pepper, and cayenne.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Stir the drained macaroni into the cheese sauce, adding more milk if needed to reach a thick, pourable consistency."
    },
    {
      "step": 8,
      "text": "Layer the macaroni mixture in the prepared dish with the remaining Cheddar, finishing with cheese on top."
    },
    {
      "step": 9,
      "text": "Bake for 30 minutes, until hot and bubbling.",
      "timer_minutes": 30
    }
  ],
