  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Toss the cubed pumpkin with part of the olive oil and season with salt and pepper."
    },
    {
      "step": 2,
      "text": "Spread the pumpkin on a baking sheet and roast until tender and golden brown."
    },
    {
      "step": 3,
      "text": "Bring the vegetable broth to a boil, then keep it hot over low heat."
    },
    {
      "step": 4,
      "text": "Warm the remaining olive oil in a large pan. Cook the onion and garlic until tender."
    },
    {
      "step": 5,
      "text": "Stir in the Arborio rice and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Add the hot broth and season with salt and pepper. Cook, stirring occasionally, until the rice is tender and creamy."
    },
    {
      "step": 7,
      "text": "Fold in the roasted pumpkin and spinach. Stir in the feta, reserving some cubes for topping if desired, and serve hot."
    }
  ],
