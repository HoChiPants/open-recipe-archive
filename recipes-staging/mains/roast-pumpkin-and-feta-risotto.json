      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "divided, or as needed"
    },
    {
      "ingredient_id": "peeled",
      "item": "peeled",
      "quantity": 3.25,
      "unit": "cups",
      "preparation": "cubed pumpkin"
    },
    {
