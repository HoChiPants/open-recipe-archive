  "id": "roast-pumpkin-and-feta-risotto",
  "name": "Roast Pumpkin and Feta Risotto",
  "subtitle": "Creamy rice with roasted pumpkin, spinach, and feta",
  "description": "Roasted pumpkin adds sweetness to this comforting risotto, finished with wilted spinach and feta.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 45
  },
  "ingredients": [
