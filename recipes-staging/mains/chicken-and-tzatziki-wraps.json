  "id": "chicken-and-tzatziki-wraps",
  "name": "Chicken and Tzatziki Wraps",
  "subtitle": "Warm chicken, cool yogurt sauce, and fresh vegetables in soft wraps.",
  "description": "Make a quick cucumber-yogurt sauce, cook the chicken, and fill warmed wraps with the sauce, chicken, and tomatoes.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "cucumber-three-quarters-deseeded-and-coarsely-grated",
      "item": "cucumber three-quarters deseeded and coarsely grated",
      "quantity": 1,
      "preparation": "the rest halved and sliced"
    },
    {
      "ingredient_id": "greek-yogurt",
      "item": "Greek yogurt",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "chicken-breast-thinly-sliced",
      "item": "chicken breast thinly sliced",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "wholemeal-wraps",
      "item": "wholemeal wraps",
      "quantity": 4
    },
    {
      "ingredient_id": "ripe-tomatoes-thinly-sliced",
      "item": "ripe tomatoes thinly sliced",
      "quantity": 4,
      "unit": "large"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the grated cucumber and Greek yogurt in a bowl; set aside."
    },
    {
      "step": 2,
      "text": "Toss the sliced chicken with the olive oil."
    },
    {
      "step": 3,
      "text": "Preheat a skillet over medium-high heat. Cook the chicken for about 10 minutes, turning as needed, until cooked through and the thickest piece reaches 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Warm the wraps briefly in a microwave until pliable."
    },
    {
      "step": 5,
      "text": "Spread the cucumber-yogurt mixture over the wraps and add the chicken and sliced tomatoes."
    },
    {
      "step": 6,
      "text": "Fold in the sides and roll each wrap closed."
    }
  ],
