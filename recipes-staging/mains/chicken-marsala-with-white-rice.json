  "instructions": [
    {
      "step": 1,
      "text": "Combine the rice and water in a saucepan. Bring to a boil, cover, reduce heat, and cook for 25 minutes, or until tender. Remove from the heat and let stand, covered, until set.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Whisk the flour with the salt, pepper, and oregano in a shallow dish. Coat the chicken cutlets on both sides, shaking off excess flour."
    },
    {
      "step": 3,
      "text": "Heat the olive oil and half the butter in a large skillet over medium heat. Cook the chicken for about 8 minutes, turning as needed, until golden brown and the thickest pieces reach 165°F. Transfer the chicken to a plate.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Melt the remaining butter in the skillet. Stir in the garlic, then add the mushrooms and cook until tender.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Season the mushrooms with salt and pepper. Pour in the Marsala wine and chicken stock, stirring to loosen browned bits from the pan."
    },
    {
      "step": 6,
      "text": "Return the chicken and any collected juices to the skillet. Simmer until the sauce thickens.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Spoon the chicken and sauce over the rice and serve."
    }
  ],
