  "id": "chicken-marsala-with-white-rice",
  "name": "Chicken Marsala with White Rice",
  "subtitle": "Tender chicken cutlets with mushrooms in a savory Marsala pan sauce.",
  "description": "Serve lightly floured chicken cutlets and tender mushrooms over fluffy white rice with a reduced Marsala and chicken stock sauce.",
  "meal_type": "main",
  "cuisine": "American",
