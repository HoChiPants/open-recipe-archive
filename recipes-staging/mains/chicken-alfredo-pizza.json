  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Combine the chicken seasoning ingredients, coat the roasted chicken, and cut it into bite-size pieces. If starting with raw chicken, cook it to 165°F internally before cutting."
    },
    {
      "step": 2,
      "text": "Melt 2 tablespoons butter in a pan. Add the minced garlic, rosemary, and pinch of salt; stir until the garlic is tender."
    },
    {
      "step": 3,
      "text": "For the sauce, melt 4 tablespoons butter. Stir in the flour, salt, and pepper, then gradually add the milk and Romano cheese. Simmer, stirring, until thickened."
    },
    {
      "step": 4,
      "text": "Stir the yeast into the warm water and let it stand for 5 minutes. Mix in the oil, sugar, salt, rosemary, and garlic powder, then add the flour and knead until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Cover the dough and let it rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Shape the dough on a baking pan or pizza pan. Spread on the sauce, arrange the chicken over it, and add the garlic-butter mixture."
    },
    {
      "step": 7,
      "text": "Bake until the crust and topping are lightly browned, about 20 minutes. Let the pizza rest for 3 minutes before serving.",
      "timer_minutes": 20
    }
  ],
