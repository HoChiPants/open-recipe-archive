  "id": "spaghetti-with-tuna-and-capers",
  "name": "Spaghetti with Tuna and Capers",
  "subtitle": "A quick, briny pasta dinner",
  "description": "Spaghetti is tossed with olive-oil-packed tuna, capers, sweet onion, red pepper, and parsley.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "tuna-packed-in-olive-oil",
      "item": "tuna packed in olive oil",
      "quantity": 1,
      "unit": "can",
      "preparation": "5 ounce, undrained"
    },
    {
      "ingredient_id": "capers",
      "item": "capers",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "drained"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "spaghetti",
      "item": "spaghetti",
      "quantity": 0.5,
      "unit": "pound"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 0.5,
      "unit": "tablespoon",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil and undrained tuna in a skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the onion and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the capers and red pepper flakes. Heat the tuna mixture until it reaches 145°F on a food thermometer, or until the fish is opaque and flakes easily."
    },
    {
      "step": 4,
      "text": "Meanwhile, cook the spaghetti in boiling water until tender, about 1 minute, then drain.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Combine the drained spaghetti with the tuna mixture and toss well."
    },
    {
      "step": 6,
      "text": "Fold in the parsley and serve."
    }
  ],
