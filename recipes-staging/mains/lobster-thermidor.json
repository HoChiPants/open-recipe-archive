  "id": "lobster-thermidor",
  "name": "Lobster Thermidor",
  "subtitle": "Lobster tails with creamy mushroom sauce",
  "description": "Lobster tails are folded into a cognac-scented mushroom cream sauce, topped with breadcrumbs and cheese, and baked until bubbling and opaque.",
  "meal_type": "main",
  "cuisine": "French",
