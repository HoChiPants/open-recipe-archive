  "instructions": [
    {
      "step": 1,
      "text": "Cut the lobster tails lengthwise through the shells. Melt half of the 3 tablespoons butter in a large ovenproof skillet over medium heat, place the tails cut-side down, and cook for 3 minutes. Turn and cook for 1 minute, then remove the lobster and let it cool enough to handle.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Melt the remaining butter in the skillet. Add the shallots and salt; cook, stirring, for 4 minutes. Add the mushrooms and cook for 6 minutes, until golden brown.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the flour and cook for 2 minutes. Remove the skillet from the heat, add the cognac or brandy, and carefully ignite if desired; let the flame subside completely. Stir in the milk and cook for 2 minutes, then remove from the heat and stir in the creme fraiche or heavy cream. Cool briefly.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Preheat the oven to 450°F. Remove the lobster meat from the shells, cut it into pieces, and return the pieces to the shells. Fold the lobster meat into the sauce with the tarragon, salt, and cayenne pepper."
    },
    {
      "step": 5,
      "text": "Spoon the mixture into the lobster shells and arrange them in the skillet or a baking dish. Combine the bread crumbs and Parmigiano-Reggiano with the melted butter, then sprinkle over the lobster."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, then grill for 1 minute to brown the topping. Serve when the lobster is opaque and cooked through.",
      "timer_minutes": 11
    }
  ],
