      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "slices-pepper-jack-cheese",
      "item": "slices pepper jack cheese",
      "quantity": 4
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill or broiler. Melt the butter with the olive oil in a large skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Season the chicken breasts with the Creole-style seasoning, garlic powder, salt, and pepper. Cook until golden brown and the thickest part reaches 165°F, about 10 minutes, turning as needed.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Mash the avocados with the tomato, red onion, and lime juice. Season with additional salt and pepper to taste."
    },
    {
      "step": 4,
      "text": "Top each cooked chicken breast with the avocado mixture and one slice of pepper jack cheese."
    },
    {
      "step": 5,
      "text": "Grill or broil until the cheese is melted, about 4 minutes. Serve immediately.",
      "timer_minutes": 4
    }
  ],
