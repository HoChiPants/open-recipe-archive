  "id": "guacamole-chicken-melt",
  "name": "Guacamole Chicken Melt",
  "subtitle": "Seasoned chicken topped with fresh avocado salsa and melted pepper jack",
  "description": "Pan-cooked chicken breasts are finished with a bright avocado topping and melted cheese for an easy four-serving main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
