  "id": "black-bean-and-prawn-quesadillas",
  "name": "Black Bean and Prawn Quesadillas",
  "subtitle": "Crisp tortillas filled with smoky prawns, beans, peppers, and melted mozzarella.",
  "description": "Sautéed prawns and vegetables combine with seasoned black beans in flour tortillas for a quick, filling meal.",
  "meal_type": "main",
  "cuisine": "Mexican",
