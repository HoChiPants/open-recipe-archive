  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a skillet over medium heat. Cook the onion and red pepper for 10 minutes, stirring occasionally, until golden brown.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the prawns, garlic, and paprika. Cook for 3 minutes, stirring, until the prawns are opaque and easily pierced.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir in the coriander and black beans, then remove the filling from the skillet."
    },
    {
      "step": 4,
      "text": "Place one tortilla in the skillet. Spread the filling over half, sprinkle with mozzarella, and fold the tortilla over."
    },
    {
      "step": 5,
      "text": "Cook for 2 minutes per side, turning carefully, until crisp and the cheese has melted.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Cut into wedges and serve with the optional salad and hot sauce."
    }
  ],
