      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a large covered skillet over medium heat. Season the pork chops with salt and pepper."
    },
    {
      "step": 2,
      "text": "Arrange the pork chops, potatoes, and chopped onion in the skillet, layering as needed."
    },
    {
      "step": 3,
      "text": "Stir the condensed soup, water, and milk together until smooth, then pour the mixture over the skillet contents."
    },
    {
      "step": 4,
      "text": "Cover and cook for 45 minutes, or until the potatoes are tender and the pork reaches 145°F in the thickest part. Remove from heat and rest the pork for 3 minutes before serving.",
      "timer_minutes": 45
    }
  ],
