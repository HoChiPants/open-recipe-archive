  "id": "stovetop-pork-chops-and-potatoes",
  "name": "Stovetop Pork Chops and Potatoes",
  "subtitle": "Tender pork and sliced potatoes in a creamy mushroom sauce",
  "description": "Pork chops, potatoes, and onion simmer together in a creamy mushroom sauce for a straightforward one-pan dinner.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
