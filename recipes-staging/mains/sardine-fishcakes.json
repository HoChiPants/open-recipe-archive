      "quantity": 2,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Crush or finely chop the garlic and chilli, then mix with the cumin, paprika, cayenne pepper, and extra virgin olive oil."
    },
    {
      "step": 2,
      "text": "Finely chop the sardine fillets. Combine them with the spice mixture, grated tomato if using, parsley, and coriander."
    },
    {
      "step": 3,
      "text": "Divide the mixture into 8 portions and shape each into a fishcake. Dust all sides with the semolina or flour."
    },
    {
      "step": 4,
      "text": "Heat the frying oil in a skillet over medium heat for about 3 minutes, until hot.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Fry the fishcakes in batches if needed, turning once, until golden brown and the fish reaches 145°F or is opaque and flakes easily.",
      "timer_minutes": 12
    },
    {
      "step": 6,
      "text": "Serve hot with the optional salad."
    }
  ],
