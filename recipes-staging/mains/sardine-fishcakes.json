  "id": "sardine-fishcakes",
  "name": "Sardine Fishcakes",
  "subtitle": "Crisp, herb-filled fishcakes with warm spices",
  "description": "Tender sardine fishcakes seasoned with herbs, garlic, chilli, and spices, then dusted and fried until golden.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "(makes 8 fishcakes)"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 12
  },
  "ingredients": [
