  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F (220°C). Lightly oil two baking sheets."
    },
    {
      "step": 2,
      "text": "Cook the sliced courgettes, garlic, and onion in the teaspoon of oil until softened. Add the cherry tomatoes and tomato purée, then simmer until thick and spoonable.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Blend the cashews with the milk and one-half teaspoon of bouillon powder until smooth. Set aside."
    },
    {
      "step": 4,
      "text": "Mix the flour, baking powder, grated courgette, tablespoon of oil, remaining bouillon powder, and enough milk mixture to form a soft dough."
    },
    {
      "step": 5,
      "text": "Divide the dough into four portions and press each into a thin round on the prepared sheets."
    },
    {
      "step": 6,
      "text": "Spread with the tomato mixture and dollop over the cashew cream. Bake until the bases are cooked through and lightly browned.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Top with basil leaves and lemon zest, then serve warm."
    }
  ],
