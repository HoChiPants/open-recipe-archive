  "id": "pressure-cooker-barbecue-chicken",
  "name": "Pressure Cooker Barbecue Chicken",
  "subtitle": "Tender chicken thighs in a tangy chile sauce",
  "description": "Chicken thighs are seasoned, briefly browned, then pressure-cooked with onion and a vinegar-based chile sauce for an easy savory main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "boneless",
      "item": "boneless",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "skinless chicken thighs"
    },
    {
      "ingredient_id": "ground-paprika",
      "item": "ground paprika",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "minced"
    },
    {
      "ingredient_id": "chile-sauce",
      "item": "chile sauce",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vinegar",
      "item": "vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Set the pressure cooker to its browning or sauté setting and preheat it. Season the chicken thighs with paprika, salt, and black pepper."
    },
    {
      "step": 2,
      "text": "Brown the chicken in the cooker for 3 minutes, turning as needed.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir together the minced onion, chile sauce, water, and vinegar. Transfer the chicken to the pressure-cooker pot and pour the sauce over it."
    },
    {
      "step": 4,
      "text": "Lock the lid and cook at high pressure for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Let the pressure release naturally for 10 minutes, then release any remaining pressure carefully.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Check the thickest pieces with a food thermometer; serve when the chicken reaches 165°F."
    }
  ],
