  "id": "parmesan-panko-chicken-poppers",
  "name": "Parmesan Panko Chicken Poppers",
  "subtitle": "Crisp, bite-sized chicken with a savory cheese crust",
  "description": "Chicken breast pieces are breaded with seasoned flour, egg, and Parmesan panko, then fried until golden and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "panko-bread-crumbs",
      "item": "panko bread crumbs",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
