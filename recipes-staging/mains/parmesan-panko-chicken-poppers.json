      "item": "garlic powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "boneless chicken breast, cut in bite-sized pieces"
    },
    {
      "ingredient_id": "oil-for-frying",
      "item": "oil for frying"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the panko, Parmesan, salt, pepper, and garlic powder in a shallow dish."
    },
    {
      "step": 2,
      "text": "Whisk the eggs and milk in a second shallow dish. Place the flour in a third dish."
    },
    {
      "step": 3,
      "text": "Coat each chicken piece in flour, dip it in the egg mixture, then press it into the seasoned panko mixture."
    },
    {
      "step": 4,
      "text": "Heat the frying oil to 350°F."
    },
    {
      "step": 5,
      "text": "Fry the coated chicken in batches for about 5 minutes, turning as needed, until golden and the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 5
    }
  ],
