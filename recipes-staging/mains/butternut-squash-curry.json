  "id": "butternut-squash-curry",
  "name": "Butternut Squash Curry",
  "subtitle": "A warming vegetable curry with chickpeas, rice, and yogurt.",
  "description": "Tender squash and chickpeas simmer with tomatoes and curry paste, served over brown basmati rice with yogurt and coriander.",
  "meal_type": "main",
  "cuisine": "Indian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "brown-basmati-rice",
      "item": "brown basmati rice",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "butternut-squash-diced",
      "item": "butternut squash diced",
      "quantity": 1
    },
    {
      "ingredient_id": "red-onion-diced",
      "item": "red onion diced",
      "quantity": 1
    },
    {
