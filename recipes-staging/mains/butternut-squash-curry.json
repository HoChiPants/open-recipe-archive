      "item": "mild curry paste",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vegetable-broth",
      "item": "vegetable stock",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "tomatoes-roughly-chopped",
      "item": "tomatoes roughly chopped",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "can-chickpeas-rinsed-and-drained",
      "item": "can chickpeas rinsed and drained",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "danone-skyr-plain-yoghurt",
      "item": "Danone Skyr Plain Yoghurt",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "handful-coriander-chopped",
      "item": "handful coriander chopped",
      "unit": "small"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the brown basmati rice in boiling water until tender, then drain."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large pan. Add the diced butternut squash and cook until lightly browned.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir in the diced red onion and mild curry paste; cook until the onion begins to soften.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Add the vegetable stock, cover, and simmer until the squash is tender.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Add the chopped tomatoes and chickpeas, then simmer until heated through.",
      "timer_minutes": 4
    },
    {
      "step": 6,
      "text": "Serve the curry over the rice with the yogurt and chopped coriander."
    }
  ],
