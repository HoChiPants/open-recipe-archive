  "id": "amatriciana",
  "name": "Amatriciana",
  "subtitle": "Linguine with bacon-tomato sauce",
  "description": "A quick Italian-style pasta with smoky bacon, tomatoes, basil, and Parmesan.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 4,
      "preparation": "diced"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
