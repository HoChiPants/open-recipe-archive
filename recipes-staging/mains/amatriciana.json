      "item": "grated Parmesan cheese",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a large skillet over medium heat until crisp. Drain the bacon, reserving a little of the drippings in the skillet.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Cook the onion in the skillet until softened. Stir in the garlic and red pepper flakes and cook briefly until fragrant.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the stewed tomatoes and simmer, breaking them up with a spoon as needed. Return the bacon to the sauce.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Meanwhile, cook the linguine in boiling water until tender, then drain."
    },
    {
      "step": 5,
      "text": "Toss the drained linguine with the sauce and basil. Serve topped with Parmesan."
    }
  ],
