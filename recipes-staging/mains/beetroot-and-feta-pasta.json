  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Transfer the beetroot to an ovenproof dish and cook for 5 minutes, then set aside.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Prepare the onions, celery, carrots, basil, and garlic, keeping the celery tops separate."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a large pan. Add the onions, celery, and carrots; cook for 8 minutes, until set.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Simmer the beetroot and wholemeal pasta for 15 minutes, then drain.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Blend the beetroot with the basil and crème fraîche until smooth. Add the drained pasta and stir until thick and evenly coated."
    },
    {
      "step": 6,
      "text": "Prepare the reserved basil and feta, then finish the pasta with them."
    }
  ],
