  "instructions": [
    {
      "step": 1,
      "text": "Combine the instant brown rice and 1.75 cups water in a microwave-safe dish. Microwave for 8 minutes, then set aside.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Whisk the 6 tablespoons water with the soy sauce, honey, cider vinegar, and cornstarch until smooth. Set the sauce aside."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Add the shrimp and cook briefly, then stir in the chopped garlic."
    },
    {
      "step": 4,
      "text": "Add the broccoli, baby carrots, chopped onion, and black pepper. Stir-fry for 5 minutes, until the broccoli and carrots are tender.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the sliced mushrooms and stir-fry for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Pour in the prepared sauce and cook for 1 minute, stirring, until thickened.",
      "timer_minutes": 1
    },
    {
      "step": 7,
      "text": "Return or keep the shrimp in the skillet and stir-fry for 3 minutes, until opaque and fully cooked, reaching 145°F if checked with a thermometer.",
      "timer_minutes": 3
    },
    {
      "step": 8,
      "text": "Stir the cooked rice into the stir-fry and serve."
    }
  ],
