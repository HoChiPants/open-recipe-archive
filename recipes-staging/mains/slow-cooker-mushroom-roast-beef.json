      "item": "ground black pepper"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Spread the sliced mushrooms in the slow cooker and place the beef roast on top."
    },
    {
      "step": 2,
      "text": "Sprinkle the onion soup mix over the roast, pour in the beer, and season with ground black pepper."
    },
    {
      "step": 3,
      "text": "Cover and cook on low for about 9 hours, until the thickest part of the roast reaches 145°F on a food thermometer.",
      "timer_minutes": 540
    },
    {
      "step": 4,
      "text": "Transfer the roast to a cutting board and rest for 3 minutes before slicing. Serve with the mushrooms and cooking liquid.",
      "timer_minutes": 3
    }
  ],
