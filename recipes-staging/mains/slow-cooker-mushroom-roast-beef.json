  "id": "slow-cooker-mushroom-roast-beef",
  "name": "Slow Cooker Mushroom Roast Beef",
  "subtitle": "Tender beef roast with mushrooms in a savory beer sauce",
  "description": "A simple slow-cooked beef roast layered with mushrooms and finished in a savory onion-seasoned sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
