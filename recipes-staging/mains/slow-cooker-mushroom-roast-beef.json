  "ingredients": [
    {
      "ingredient_id": "fresh-mushrooms",
      "item": "fresh mushrooms",
      "quantity": 1,
      "unit": "pound",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "4-pound-standing-beef-rib-roast",
      "item": "(4 pound) standing beef rib roast",
      "quantity": 1
    },
    {
      "ingredient_id": "1-25-ounce-envelope-onion-soup-mix",
      "item": "(1.25 ounce) envelope onion soup mix",
      "quantity": 1
    },
    {
      "ingredient_id": "beer",
      "item": "beer",
      "quantity": 1,
      "unit": "bottle",
      "preparation": "12 fluid ounce"
