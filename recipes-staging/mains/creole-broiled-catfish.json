  "id": "creole-broiled-catfish",
  "name": "Creole Broiled Catfish",
  "subtitle": "Seasoned catfish fillets cooked under high heat",
  "description": "Catfish fillets are coated with olive oil and a savory Creole-style seasoning blend, then broiled until opaque and flaky.",
  "meal_type": "main",
  "cuisine": "Creole",
  "yield": {
    "quantity": 8,
