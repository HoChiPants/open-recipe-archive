  },
  "ingredients": [
    {
      "ingredient_id": "8-ounce-fillets-catfish",
      "item": "(8 ounce) fillets catfish",
      "quantity": 8
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "seasoned-pepper",
      "item": "seasoned pepper",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic-powder-with-parsley",
      "item": "garlic powder with parsley",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "spicy-seasoned-salt",
      "item": "spicy seasoned salt",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the broiler or grill to high heat."
    },
    {
      "step": 2,
      "text": "Combine the seasoned pepper, garlic powder with parsley, and spicy seasoned salt."
    },
    {
      "step": 3,
      "text": "Arrange the catfish fillets on a broiler-safe pan. Brush them with olive oil and coat both sides with the seasoning mixture."
    },
    {
      "step": 4,
      "text": "Broil or grill for 5 minutes per side, until the fish reaches 145°F or is opaque and flakes easily.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
  ],
