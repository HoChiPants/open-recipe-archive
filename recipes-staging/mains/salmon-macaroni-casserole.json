  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Grease a baking dish with the butter."
    },
    {
      "step": 2,
      "text": "Bring salted water to a boil. Add the macaroni and cook for 8 minutes, then drain.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Combine the drained macaroni, salmon, soup, milk, Parmesan, salt, and pepper."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared baking dish and spread it evenly."
    },
    {
      "step": 5,
      "text": "Top with the French-fried onions."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until lightly browned and the salmon mixture reaches 145°F or is opaque and flakes easily.",
      "timer_minutes": 30
    }
  ],
