  "id": "salmon-macaroni-casserole",
  "name": "Salmon Macaroni Casserole",
  "subtitle": "Creamy baked macaroni with salmon and Parmesan",
  "description": "A simple American casserole combining tender macaroni, salmon, mushroom sauce, Parmesan, and crisp fried onions.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
