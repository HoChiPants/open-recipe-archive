  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Season the salmon fillets with salt."
    },
    {
      "step": 2,
      "text": "Grill the salmon for 8 minutes, turning as needed, until it reaches 145°F or is opaque and flakes easily.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Combine the water, rice vinegar, brown sugar, garlic, chile paste, ginger, and soy sauce in a saucepan. Bring to a simmer."
    },
    {
      "step": 4,
      "text": "Simmer until the glaze thickens, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Add the grilled salmon and chopped basil to the glaze, turning the fillets to coat before serving."
    }
  ],
