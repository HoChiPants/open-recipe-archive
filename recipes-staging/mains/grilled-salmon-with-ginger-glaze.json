  "id": "grilled-salmon-with-ginger-glaze",
  "name": "Grilled Salmon with Ginger Glaze",
  "subtitle": "Tender salmon finished with a sweet, spicy ginger sauce",
  "description": "Seasoned salmon is grilled, then coated with a quick glaze of rice vinegar, brown sugar, garlic, chile, ginger, soy sauce, and basil.",
  "meal_type": "main",
  "cuisine": "American",
