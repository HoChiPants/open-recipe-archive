  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Season the drumsticks with salt, pepper, and red pepper flakes."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large ovenproof skillet. Add the garlic, green bell pepper, and chile; cook for 2 minutes. Add the chicken and brown for 3 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Transfer the skillet to the oven and roast the chicken for 10 minutes, or until a thermometer inserted into the thickest part reaches 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Whisk the water and cornstarch together. Combine the apricot nectar, slurry, curry powder, dried apricots, and water chestnuts in a saucepan; heat, stirring, until combined."
    },
    {
      "step": 5,
      "text": "In the skillet, cook the carrots, onion, green bell pepper, and chile with the remaining seasoned pan juices until the onion softens.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Add the chicken and apricot mixture to the skillet. Simmer until the chicken is tender and reaches 165°F internally.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Taste and adjust the salt, pepper, and red pepper flakes. Stir in the water chestnuts if not already added, and serve hot."
    }
  ],
