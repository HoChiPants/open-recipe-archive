  "instructions": [
    {
      "step": 1,
      "text": "Combine the kosher salt, lemon zest, garlic, lemon juice, black pepper mixture, and lemon thyme. Let stand for 2 minutes, then stir in the basil, parsley, and oregano.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk in the divided olive oil until the mixture is combined and slightly thickened.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the shrimp and toss until evenly coated. Cover and chill for 3 hours, then let them sit briefly while the grill heats.",
      "timer_minutes": 180
    },
    {
      "step": 4,
      "text": "Preheat the grill. Thread the shrimp onto the skewers."
    },
    {
      "step": 5,
      "text": "Grill the skewers for about 3 minutes, turning as needed, until the shrimp are opaque and safely cooked through.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Whisk the remaining olive oil with the lemon juice, red pepper flakes, cayenne, lemon zest, lemon thyme, and salt and pepper to make a dressing."
    },
    {
      "step": 7,
      "text": "Remove the shrimp from the skewers, toss or drizzle with the dressing, and serve with lemon wedges."
    }
  ],
