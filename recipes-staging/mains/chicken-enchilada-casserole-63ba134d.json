  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Lightly grease a suitable baking dish."
    },
    {
      "step": 2,
      "text": "Stir the tomato sauce, water, taco seasoning mix, and chili powder in a saucepan. Bring to a gentle simmer, then keep warm."
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil in a skillet. Add the chicken and cook, turning as needed, until the thickest piece reaches 165°F, about 8 minutes. Transfer the chicken to a plate, let it rest briefly, and shred it.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Combine the drained black beans, cream cheese, and half of the Mexican-style cheese blend. Stir the shredded chicken into the seasoned sauce."
    },
    {
      "step": 5,
      "text": "Mix the corn bread mix with the milk and egg until just combined."
    },
    {
      "step": 6,
      "text": "Spread the chicken and sauce in the baking dish, layer the bean mixture over it, and top with the cornbread batter. Sprinkle with the remaining cheese."
    },
    {
      "step": 7,
      "text": "Bake until the cornbread topping is set and the casserole is hot throughout, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
