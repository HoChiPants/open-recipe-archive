  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "mini-sweet-peppers",
      "item": "mini sweet peppers",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "sliced crosswise (about 10 peppers, mixed colors)"
    },
    {
      "ingredient_id": "onion",
      "item": "yellow onion",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "lean-ground-sirloin-9-0-10",
      "item": "lean ground sirloin (9 0/10)",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "italian-seasoning",
      "item": "Italian seasoning",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "tomato-sauce",
      "item": "tomato sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce"
    },
    {
