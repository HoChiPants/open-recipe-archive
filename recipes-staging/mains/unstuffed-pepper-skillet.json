      "item": "microwavable white rice (such as Uncle Ben’s)",
      "quantity": 1,
      "unit": "package",
      "preparation": "8.8 ounce, crumbled"
    },
    {
      "ingredient_id": "italian-cheese-blend",
      "item": "Italian cheese blend",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "fresh-basil-or-flat-leaf-parsley",
      "item": "fresh basil or flat-leaf parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large skillet over medium heat. Add the peppers, onion, and 1 tablespoon of the hot cherry pepper spread; cook until the vegetables begin to soften.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Add the ground sirloin and cook, breaking it into small pieces, until lightly browned and it reaches 160°F on a food thermometer.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the garlic and Italian seasoning; cook briefly until fragrant.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the tomato sauce, water, remaining hot cherry pepper spread, and salt. Stir in the crumbled rice, cover, and cook until the rice is tender and the mixture is hot.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Scatter the cheese over the skillet, cover, and heat until melted.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Top with the chopped basil or parsley and serve hot."
    }
  ],
