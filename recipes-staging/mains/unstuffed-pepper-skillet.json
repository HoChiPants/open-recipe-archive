  "id": "unstuffed-pepper-skillet",
  "name": "Unstuffed Pepper Skillet",
  "subtitle": "A saucy beef-and-pepper skillet with rice and melted cheese",
  "description": "Ground sirloin, sweet peppers, onion, and tomato sauce make a quick one-pan dinner finished with rice, cheese, and herbs.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
