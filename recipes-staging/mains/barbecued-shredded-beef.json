  "id": "barbecued-shredded-beef",
  "name": "Barbecued Shredded Beef",
  "subtitle": "Tender oven-braised beef with barbecue flavor",
  "description": "Beef roast cooks slowly with onions, beer, barbecue sauce, and savory seasonings until tender enough to shred.",
