  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 275°F."
    },
    {
      "step": 2,
      "text": "Place the beef roast and chopped onions in an oven-safe cooking vessel."
    },
    {
      "step": 3,
      "text": "Combine the Worcestershire sauce, liquid smoke, garlic powder, black pepper, salt, and barbecue sauce. Pour the mixture over the roast."
    },
    {
      "step": 4,
      "text": "Add the beer and water, then stir to distribute the liquids around the roast."
    },
    {
      "step": 5,
      "text": "Cook at 275°F for 5 hours, or until the beef is tender and reaches at least 145°F internally. Let it rest for 3 minutes, then shred.",
      "timer_minutes": 300
    },
    {
      "step": 6,
      "text": "Combine the Worcestershire sauce and barbecue sauce."
    }
  ],
