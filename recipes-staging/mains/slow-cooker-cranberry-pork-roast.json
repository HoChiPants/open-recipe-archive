  "id": "slow-cooker-cranberry-pork-roast",
  "name": "Slow Cooker Cranberry Pork Roast",
  "subtitle": "Tender pork with a tart cranberry glaze",
  "description": "A boneless pork loin cooks slowly in cranberry sauce, then the cooking liquid is thickened into a simple gravy.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 370
  },
  "ingredients": [
    {
      "ingredient_id": "jellied-cranberry-sauce",
      "item": "jellied cranberry sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "cranberry-juice",
      "item": "cranberry juice",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "dry-mustard",
      "item": "dry mustard",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cloves",
      "item": "ground cloves",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "1-1-2-pound-boneless-pork-loin-roast",
      "item": "(1 1/2-pound) boneless pork loin roast",
      "quantity": 1
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the cranberry sauce and cranberry juice in a bowl. Stir in the sugar, dry mustard, cloves, and salt."
    },
    {
      "step": 2,
      "text": "Place the pork roast in a slow cooker and pour the cranberry mixture over it."
    },
    {
      "step": 3,
      "text": "Cover and cook on Low for 6 hours 10 minutes, or until the center reaches 145°F on a food thermometer.",
      "timer_minutes": 370
    },
    {
      "step": 4,
      "text": "Transfer the roast to a cutting board and let it rest for 3 minutes before slicing.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Pour the cooking liquid into a saucepan. Add water as needed to make about 1 cup of liquid."
    },
    {
      "step": 6,
      "text": "Whisk the cold water and cornstarch together until smooth."
    },
    {
      "step": 7,
      "text": "Bring the cooking liquid to a simmer, whisk in the cornstarch mixture, and cook until thickened."
    },
    {
      "step": 8,
      "text": "Slice the rested pork and serve with the cranberry gravy."
    }
  ],
