  "id": "quick-black-beans-and-rice",
  "name": "Quick Black Beans and Rice",
  "subtitle": "A simple one-pan meal with beans, tomatoes, and tender brown rice.",
  "description": "Black beans and stewed tomatoes simmer with onion and oregano before instant brown rice is added for an easy, hearty main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "black-beans",
      "item": "black beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, undrained"
    },
    {
      "ingredient_id": "stewed-tomatoes",
      "item": "stewed tomatoes",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.5 ounce"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "uncooked-instant-brown-rice",
      "item": "uncooked instant brown rice",
      "quantity": 1.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a covered skillet over medium heat. Add the onion and cook, stirring occasionally, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the black beans, stewed tomatoes, dried oregano, and garlic powder. Bring the mixture to a simmer.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the uncooked instant brown rice. Cover, reduce the heat as needed to maintain a gentle simmer, and cook until the rice is tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Remove the skillet from the heat and let it stand, covered, for 5 minutes before serving."
    }
  ],
