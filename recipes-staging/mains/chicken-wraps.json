  "id": "chicken-wraps",
  "name": "Chicken Wraps",
  "subtitle": "Spiced chicken with aubergine, avocado, and tahini yogurt",
  "description": "Warm tortilla wraps filled with spiced chicken, tender aubergine, quick-pickled onion, fresh tomato, avocado, and a creamy tahini yogurt sauce.",
  "meal_type": "main",
