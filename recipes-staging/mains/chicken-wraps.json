  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill or large frying pan for 2 minutes. Cook the aubergine rounds until tender and lightly browned, turning as needed."
    },
    {
      "step": 2,
      "text": "Toss the sliced onion with the olive oil and cider vinegar; set aside while preparing the remaining components."
    },
    {
      "step": 3,
      "text": "Stir together the yogurt, tahini, and crushed garlic."
    },
    {
      "step": 4,
      "text": "Mix the cumin, ground coriander, and paprika. Coat the chicken breasts with the spice mixture and let them stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Heat the vegetable oil in a frying pan. Cook the chicken until browned and cooked through; check the thickest part reaches 165°F, then slice."
    },
    {
      "step": 6,
      "text": "Warm the tortilla wraps briefly. Fill with aubergine, chicken, onion, tomato, and avocado, then drizzle with the tahini yogurt sauce and roll up."
    }
  ],
