  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven; use the temperature specified for your oven and traybake method."
    },
    {
      "step": 2,
      "text": "Mix the garlic granules, smoked paprika, cumin, oregano, chilli powder, tomato purée, and vegetable oil into a seasoning paste."
    },
    {
      "step": 3,
      "text": "Add the onion, peppers, chicken, and drained beans to a roasting tray. Toss thoroughly with the seasoning mixture."
    },
    {
      "step": 4,
      "text": "Roast for 35 minutes, turning once, until the chicken reaches 165°F in the thickest pieces and the vegetables are tender.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Bake the tortillas for 5 minutes until warmed and pliable.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Fill the tortillas with the traybake and serve with the lime wedges, soured cream, salsa, and guacamole."
    }
  ],
