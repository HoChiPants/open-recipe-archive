  "id": "chicken-and-bean-fajita-traybake",
  "name": "Chicken and Bean Fajita Traybake",
  "subtitle": "A colorful roasted filling for warm tortillas",
  "description": "Roast seasoned chicken, peppers, onion, and beans together, then serve with warmed tortillas and fresh toppings.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
