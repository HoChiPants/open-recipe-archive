  "id": "sausage-and-potato-hash",
  "name": "Sausage and Potato Hash",
  "subtitle": "A quick skillet meal with vegetables and melted cheddar",
  "description": "Browned Italian sausage, tender potatoes, mixed vegetables, and cheddar make a hearty two-serving dinner.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "bulk-italian-sausage",
      "item": "bulk Italian sausage",
      "quantity": 8,
      "unit": "ounces"
    },
    {
      "ingredient_id": "potato",
      "item": "potato",
      "quantity": 1,
      "preparation": "peeled and diced"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.25,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "frozen-mixed-vegetables",
      "item": "frozen mixed vegetables",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a large skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Cook the bulk Italian sausage, stirring and breaking it apart, for 5 minutes; verify it reaches 160°F with a food thermometer.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the potato and onion, then cook until the potato is tender.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Stir in the vegetable oil and frozen mixed vegetables, and heat through."
    },
    {
      "step": 5,
      "text": "Season with salt and pepper to taste."
    },
    {
      "step": 6,
      "text": "Sprinkle with the shredded Cheddar cheese and serve when melted."
    }
  ],
