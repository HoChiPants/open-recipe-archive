  "id": "oven-roasted-trout-with-lemon-dill-stuffing",
  "name": "Oven-Roasted Trout with Lemon-Dill Stuffing",
  "subtitle": "Herbed bread stuffing brightened with lemon and dill",
  "description": "Whole cleaned trout are filled with a savory bread-crumb stuffing, then roasted until opaque and flaky.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "soft-bread-crumbs",
      "item": "soft bread crumbs",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sweet-onion",
      "item": "sweet onion",
      "quantity": 0.5,
      "preparation": "minced"
    },
    {
      "ingredient_id": "fresh-dill",
      "item": "fresh dill",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "grated-lemon-zest",
      "item": "grated lemon zest",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "trout",
      "item": "trout",
      "quantity": 4,
      "preparation": "cleaned and head removed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Combine the bread crumbs, onion, dill, lemon zest, garlic, and half of the divided olive oil. Season with salt and pepper."
    },
    {
      "step": 3,
      "text": "Fill each trout with the stuffing. Rub the fish with the remaining olive oil and season the outsides with salt and pepper."
    },
    {
      "step": 4,
      "text": "Place the trout in a baking dish and roast for 20 minutes, until the thickest part reaches 145°F or the flesh is opaque and flakes easily.",
      "timer_minutes": 20
    }
  ],
