      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "bone-in-chicken-pieces",
      "item": "bone-in chicken pieces",
      "quantity": 2,
      "unit": "pounds"
    },
    {
