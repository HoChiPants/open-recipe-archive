  "id": "chicken-and-lentils",
  "name": "Chicken and Lentils",
  "subtitle": "Tender chicken braised with lentils, tomato, and herbs",
  "description": "Bone-in chicken cooks with lentils, vegetables, tomato sauce, and herbs for a hearty one-pan meal finished with lemon juice.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
