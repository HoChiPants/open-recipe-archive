  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in an ovenproof skillet. Add the chicken pieces and chicken broth, then cook for 5 minutes. Transfer the chicken and broth to a bowl.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Return the skillet to the heat. Add the onion and cook until tender, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the carrot, garlic, lentils, and reserved broth. Season with the salt."
    },
    {
      "step": 5,
      "text": "Nestle the chicken into the lentil mixture and bake for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Stir in the tomato sauce, dried rosemary, and dried basil. Continue baking until the lentils are tender, about 10 minutes, and the chicken reaches 165°F at the thickest part.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Stir in the lemon juice and serve hot."
    }
  ],
