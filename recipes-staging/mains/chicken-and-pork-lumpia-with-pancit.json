  "instructions": [
    {
      "step": 1,
      "text": "Simmer the chicken in water until the thickest piece reaches 165°F. Cool briefly, then cut or shred it.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Sauté the pork until it reaches 145°F, then let it rest for 3 minutes."
    },
    {
      "step": 3,
      "text": "Stir in the cabbage and carrots; cook until the vegetables are tender. Season with salt, pepper, and MSG, then combine with the chicken."
    },
    {
      "step": 4,
      "text": "Mix the flour and water into a smooth paste. Place filling in the spring roll wrappers, fold in the sides, and seal the rolls with the paste."
    },
    {
      "step": 5,
      "text": "Heat the frying oil. Fry the lumpia in batches until golden brown, then drain."
    },
    {
      "step": 6,
      "text": "Prepare the pancit noodles until tender, then drain and combine them with the remaining cooked filling."
    },
    {
      "step": 7,
      "text": "Combine the apple cider vinegar and garlic for dipping."
    },
    {
      "step": 8,
      "text": "Serve the lumpia with the pancit and garlic-vinegar sauce."
    }
  ],
