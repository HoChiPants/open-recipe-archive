  "id": "chicken-and-pork-lumpia-with-pancit",
  "name": "Chicken and Pork Lumpia with Pancit",
  "subtitle": "Crisp spring rolls served with savory noodles and tangy garlic sauce",
  "description": "Tender chicken, pork, and vegetables are wrapped and fried until crisp, then served with pancit noodles and a sharp vinegar-garlic sauce.",
  "meal_type": "main",
  "cuisine": "Filipino",
  "yield": {
    "quantity": 10,
