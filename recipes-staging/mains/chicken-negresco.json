  "id": "chicken-negresco",
  "name": "Chicken Negresco",
  "subtitle": "Creamy chicken and egg-noodle casserole with a crisp cheese topping",
  "description": "Tender poached chicken and celery are combined with egg noodles, a seasoned cream sauce, and a Parmesan-breadcrumb topping before baking until golden.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
