  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken, celery, 1 teaspoon salt, and pepper in a pot. Add enough water to cover the chicken and bring to a gentle simmer."
    },
    {
      "step": 2,
      "text": "Simmer for 25 minutes, or until the thickest part of each breast reaches 165°F. Transfer the chicken to a plate to cool, then cut or shred it. Reserve the celery.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Heat the oven to 350°F. Cook the noodles in boiling salted water for 5 minutes, then drain.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Warm the milk in a saucepan until steaming but not boiling."
    },
    {
      "step": 5,
      "text": "Melt the butter in a separate saucepan. Whisk in the flour and cook, stirring, for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Gradually whisk in the warm milk. Simmer the sauce for 10 minutes, then stir in the remaining salt, garlic powder, and nutmeg.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Combine the noodles, chicken, and celery with the sauce. Transfer the mixture to a baking dish."
    },
    {
      "step": 8,
      "text": "Mix the bread crumbs, Parmesan, and olive oil, then scatter the topping over the casserole."
    },
    {
      "step": 9,
      "text": "Bake until the topping is golden brown and the casserole is hot throughout.",
      "timer_minutes": 45
    }
  ],
