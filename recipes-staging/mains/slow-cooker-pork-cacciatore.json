  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a skillet over medium-high heat. Brown the pork chops briefly on both sides, then transfer them to a slow cooker."
    },
    {
      "step": 2,
      "text": "Cook the onion in the skillet until softened. Add the mushrooms and bell pepper and cook briefly, stirring, until the vegetables begin to soften."
    },
    {
      "step": 3,
      "text": "Stir the pasta sauce, diced tomatoes, and white wine into the vegetables. Mix in the garlic, Italian seasoning, and basil."
    },
    {
      "step": 4,
      "text": "Pour the sauce over the pork in the slow cooker. Cover and cook until the pork is tender and reaches 145°F in the thickest part.",
      "timer_minutes": 440
    },
    {
      "step": 5,
      "text": "Rest the pork for 3 minutes, then place one mozzarella slice on each chop. Cover briefly until the cheese melts, and serve with the sauce."
    }
  ],
