  "id": "slow-cooker-pork-cacciatore",
  "name": "Slow Cooker Pork Cacciatore",
  "subtitle": "Tender pork simmered with peppers, mushrooms, and tomato sauce",
  "description": "Browned pork chops cook slowly in a savory tomato, vegetable, wine, and herb sauce, then finish with melted mozzarella.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
