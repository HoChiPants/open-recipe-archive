  "id": "chicken-yakisoba",
  "name": "Chicken Yakisoba",
  "subtitle": "Spicy noodles with chicken and crisp vegetables",
  "description": "Chicken, soba noodles, cabbage, onion, and carrots are tossed in a savory chile-garlic sauce for a quick Japanese-style meal.",
  "meal_type": "main",
  "cuisine": "Japanese",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
