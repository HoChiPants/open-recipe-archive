      "preparation": "sliced lengthwise into eighths"
    },
    {
      "ingredient_id": "head-cabbage",
      "item": "head cabbage",
      "quantity": 0.5,
      "unit": "medium",
      "preparation": "coarsely chopped"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 2,
      "preparation": "coarsely chopped"
    },
    {
      "ingredient_id": "soba-noodles",
      "item": "soba noodles",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "cooked and drained"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir together the sesame oil, canola oil, and chile paste in a large skillet or wok over medium-high heat."
    },
    {
      "step": 2,
      "text": "Add the chicken and cook, stirring frequently, until no longer pink and the thickest pieces reach 165°F on a food thermometer."
    },
    {
      "step": 3,
      "text": "Add the garlic and soy sauce. Stir and simmer until the sauce is hot and slightly reduced.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the onion, cabbage, and carrots; toss until the vegetables begin to soften while retaining some texture.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the cooked soba noodles and toss until evenly coated and heated through."
    },
    {
      "step": 6,
      "text": "Serve immediately."
    }
  ],
