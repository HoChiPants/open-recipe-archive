  "schema_version": "1.0.0",
  "id": "mussels-mariniere",
  "name": "Mussels Mariniere",
  "subtitle": "Mussels steamed in a fragrant white-wine broth",
  "description": "Tender mussels cook quickly in a savory broth of wine, aromatics, herbs, and butter, then are finished with parsley and more butter.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 35,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "mussels",
      "item": "mussels",
      "quantity": 4,
      "unit": "quarts",
      "preparation": "cleaned and debearded"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 6,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "bay-leaf",
      "item": "bay leaf",
      "quantity": 1
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "divided"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Check the mussels, discarding any cracked shells or shells that remain open when tapped. Rinse the cleaned, debearded mussels and drain."
    },
    {
      "step": 2,
      "text": "Combine the garlic, onion, half the parsley, bay leaf, thyme, wine, and half the butter in a large pot. Bring the mixture to a simmer."
    },
    {
      "step": 3,
      "text": "Cover the pot and heat it for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the mussels, cover, and cook for 4 minutes. Shake the pot once or twice so the mussels cook evenly.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Continue cooking until the mussels are opaque and the shells have opened. Discard any shells that remain closed."
    },
    {
      "step": 6,
      "text": "Transfer the mussels to serving bowls, leaving the broth in the pot."
    },
    {
      "step": 7,
      "text": "Stir the remaining parsley and butter into the hot broth until the butter melts."
    },
    {
      "step": 8,
      "text": "Pour the finished broth over the mussels and serve immediately."
    }
  ],
