  "instructions": [
    {
      "step": 1,
      "text": "Cover the cashews with boiling water and leave them to soften for 2 hours. Drain, then blend with the lemon juice until smooth.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Stir the cashew mixture with the yogurt, ginger, garlic, spices, pepper, and cream. Coat the drumsticks thoroughly and leave them to marinate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Heat the oven and a roasting dish containing the ghee or sunflower oil. Arrange the marinated drumsticks in the hot dish and roast for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Transfer the chicken to a hot grill or broiler and cook for 15 minutes, turning as needed, then grill for 4 minutes to finish. Check the thickest pieces with a thermometer; they must reach 165°F.",
      "timer_minutes": 19
    },
    {
      "step": 5,
      "text": "Serve the drumsticks with the onion rings and extra lemon wedges."
    }
  ],
