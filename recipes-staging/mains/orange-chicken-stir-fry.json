  "id": "orange-chicken-stir-fry",
  "name": "Orange Chicken Stir-Fry",
  "subtitle": "Tender chicken and crisp vegetables in a bright citrus sauce",
  "description": "A quick skillet meal combining thinly sliced chicken, mixed vegetables, snap peas, broccoli, and carrot with a thick orange-ginger sauce.",
  "meal_type": "main",
