  "instructions": [
    {
      "step": 1,
      "text": "Combine the orange juice, soy sauce, garlic, orange zest, ginger, and red pepper flakes in a bowl."
    },
    {
      "step": 2,
      "text": "Whisk the chicken broth with the cornstarch until smooth, then stir it into the citrus mixture."
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil in a large skillet over medium-high heat. Add the chicken and cook, stirring, until the thickest pieces reach 165°F."
    },
    {
      "step": 4,
      "text": "Transfer the chicken to a plate. Add the frozen stir-fry vegetables, snap peas, broccoli, and carrot to the skillet and stir-fry until crisp-tender.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Return the chicken to the skillet, pour in the sauce, and cook, stirring, until the sauce thickens and everything is hot.",
      "timer_minutes": 10
    }
  ],
