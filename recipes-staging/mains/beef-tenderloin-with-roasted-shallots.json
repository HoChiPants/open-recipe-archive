  "id": "beef-tenderloin-with-roasted-shallots",
  "name": "Beef Tenderloin With Roasted Shallots",
  "subtitle": "Roasted tenderloin with port-thyme pan sauce",
  "description": "A tender beef roast served with caramelized shallots, bacon, and a smooth port-based sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "shallots",
      "item": "shallots",
      "quantity": 0.75,
      "unit": "pound",
      "preparation": "halved lengthwise and peeled"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "beef-broth",
      "item": "beef broth",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "port-wine",
      "item": "port wine",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "tomato-paste",
      "item": "tomato paste",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "beef-tenderloin-roast",
      "item": "beef tenderloin roast",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "trimmed"
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 3,
      "preparation": "diced"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sprigs-watercress",
      "item": "sprigs watercress",
      "quantity": 4,
      "preparation": "for garnish"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Toss the shallots with the olive oil, season with salt and pepper, and roast until tender and browned, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Simmer the beef broth, port wine, and tomato paste until reduced and concentrated. Stir in the dried thyme and season with salt and pepper."
    },
    {
      "step": 3,
      "text": "Cook the diced bacon in an ovenproof skillet until it begins to render. Add the tenderloin and brown it on all sides, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Transfer the skillet to the oven and roast the beef until a thermometer inserted in the thickest part reads 145°F. Transfer the roast to a board and rest for 3 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Set the skillet over medium heat. Stir in the butter and flour to make a smooth mixture, then whisk in the reduced broth. Cook, stirring, until the sauce thickens."
    },
    {
      "step": 6,
      "text": "Stir the roasted shallots and bacon into the sauce. Slice the tenderloin thickly and serve with the sauce and watercress."
    }
  ],
