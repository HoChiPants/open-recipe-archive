  "instructions": [
    {
      "step": 1,
      "text": "Heat the rapeseed oil in a large pan. Add the onion, red pepper, and yellow pepper, and cook for 7 minutes until softened.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Prepare the chicken breasts so their thickest parts cook evenly, then coat them with the za'atar."
    },
    {
      "step": 3,
      "text": "Preheat the grill and grill the chicken for 4 minutes, turning as needed, until cooked through and the thickest part reaches 165°F.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Warm the chickpeas with the harissa paste, then crush them lightly."
    },
    {
      "step": 5,
      "text": "Wilt the spinach in the microwave, then stir it into the chickpeas with the cooked peppers, onion, and parsley."
    },
    {
      "step": 6,
      "text": "Serve the harissa chickpeas with the chicken and lemon wedges."
    }
  ],
