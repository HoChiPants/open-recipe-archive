  "id": "za-atar-chicken-with-harissa-chickpeas",
  "name": "Za'atar Chicken with Harissa Chickpeas",
  "subtitle": "Quick grilled chicken with warm, crushed chickpeas and greens",
  "description": "Za'atar-seasoned chicken is grilled and served with harissa chickpeas, softened peppers, spinach, parsley, and lemon.",
  "meal_type": "main",
