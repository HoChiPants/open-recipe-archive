  "instructions": [
    {
      "step": 1,
      "text": "Combine the chopped garlic bulb, ginger, red onion, lemongrass, black peppercorns, lime juice, lemon juice, brown sugar, 200 ml cane vinegar, and bay leaves. Add the crushed garlic and 60 ml achuete oil."
    },
    {
      "step": 2,
      "text": "Coat the spatchcocked poussin with the marinade, cover, and refrigerate for 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 3,
      "text": "Stir together the softened butter, lemon juice, dark brown sugar, 2 tablespoons achuete oil, chilli, finely chopped ginger, finely chopped garlic, shallot or red onion, 40 ml cane vinegar, and peppercorns. Set aside for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Preheat a grill to medium-high. Remove the poussin from the marinade and pat lightly dry, then coat with achuete oil and the seasoned butter."
    },
    {
      "step": 5,
      "text": "Grill the poussin, turning as needed, until browned and the thickest part of the meat reaches 165°F."
    },
    {
      "step": 6,
      "text": "Rest the cooked poussin for 10 minutes. Cut the banana leaf to fit the serving plates and grill it briefly until softened.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Serve the poussin on the banana leaf with spring onion, soy vinegar, achuete oil, and atchara."
    }
  ],
