{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "fried-scallops",
  "name": "Fried Scallops",
  "subtitle": "Crisp, golden scallops with a peppered buttermilk coating",
  "description": "Large scallops are dipped in buttermilk, coated in seasoned flour, and fried until crisp and opaque.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "fresh-scallops",
      "item": "fresh scallops",
      "quantity": 12,
      "unit": "large"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the fryer or cooking vessel to 400°F, using the vegetable oil for frying."
    },
    {
      "step": 2,
      "text": "Place the buttermilk in one shallow dish. In a second dish, combine the flour, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Dip each scallop in buttermilk, then turn it in the seasoned flour until coated."
    },
    {
      "step": 4,
      "text": "Fry the scallops for 4 minutes, working in batches if needed, until golden and opaque throughout; verify shellfish reaches 145°F if using a thermometer.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Transfer the fried scallops to a rack or paper towels to drain, then serve hot."
    }
  ],
