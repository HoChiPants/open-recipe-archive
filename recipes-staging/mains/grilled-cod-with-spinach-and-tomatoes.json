  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Season the cod with salt, pepper, and garlic powder."
    },
    {
      "step": 2,
      "text": "Combine the spinach, tomato, and onion. Add the olive oil, balsamic vinegar, and mozzarella, then fold gently to combine."
    },
    {
      "step": 3,
      "text": "Grill the cod for about 9 minutes, turning as appropriate for the grill, until it reaches 145°F, is opaque, and flakes easily.",
