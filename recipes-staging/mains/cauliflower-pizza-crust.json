  "id": "cauliflower-pizza-crust",
  "name": "Cauliflower Pizza Crust",
  "subtitle": "A crisp-edged vegetable crust for your favorite toppings",
  "description": "Tender cauliflower, cheese, parsley, garlic, and egg form a savory crust baked until lightly browned and fully set.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "head-cauliflower",
      "item": "head cauliflower",
      "quantity": 0.5,
      "preparation": "coarsely chopped"
    },
    {
      "ingredient_id": "italian-cheese-blend",
      "item": "Italian cheese blend",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Steam the cauliflower over simmering water until tender, about 15 minutes. Drain well and let it cool for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Heat the oven to 450°F and prepare a baking sheet for the crust."
    },
    {
      "step": 3,
      "text": "Stir the cauliflower with the cheese, parsley, egg, garlic, salt, and pepper until evenly combined."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared baking sheet and shape it into an even pizza crust."
    },
    {
      "step": 5,
      "text": "Bake for about 15 minutes, until lightly browned and the center is firm and fully set.",
      "timer_minutes": 15
    }
  ],
