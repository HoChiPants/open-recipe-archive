  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, garlic powder, salt, and black pepper in a bowl. Add the chicken and toss until evenly coated."
    },
    {
      "step": 2,
      "text": "Heat part of the oil in a large skillet over medium-high heat. Add the coated chicken and cook, turning occasionally, until browned and the thickest pieces reach 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Transfer the chicken to a plate. Add the remaining oil to the skillet, then add the celery, bell peppers, and onion. Cook, stirring, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Whisk the ketchup, lemon juice, crushed pineapple with syrup, and brown sugar together."
    },
    {
      "step": 5,
      "text": "Return the chicken to the skillet and pour in the sauce. Stir until heated through and the chicken is fully coated.",
      "timer_minutes": 3
    }
  ],
