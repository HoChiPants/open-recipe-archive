  "schema_version": "1.0.0",
  "id": "baked-flounder-with-parmesan",
  "name": "Baked Flounder with Parmesan",
  "subtitle": "Tender flounder with a creamy, savory topping",
  "description": "Flounder fillets are seasoned, baked briefly, then finished with a Parmesan, butter, mayonnaise, lemon, and green onion topping.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "flounder-fillets",
      "item": "flounder fillets",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "rinsed and patted dry"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Season the rinsed, patted-dry flounder with salt and arrange the fillets in the prepared dish. Add the divided lemon juice as directed by the preparation."
    },
    {
      "step": 3,
      "text": "Stir the remaining lemon juice with Parmesan, melted butter, mayonnaise, and green onions to make the topping."
    },
    {
      "step": 4,
      "text": "Bake the fish for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Spread the topping over the fillets and bake for 5 minutes more, until the fish reaches 145°F or is opaque and flakes easily.",
      "timer_minutes": 5
    }
  ],
