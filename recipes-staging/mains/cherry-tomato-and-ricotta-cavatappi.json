  "id": "cherry-tomato-and-ricotta-cavatappi",
  "name": "Cherry Tomato and Ricotta Cavatappi",
  "subtitle": "A creamy baked pasta with tomato, basil, and ricotta",
  "description": "Cavatappi is folded through a garlicky cherry-tomato sauce, topped with seasoned ricotta and parmesan, then baked until bubbling.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 30
  },
  "ingredients": [
    {
