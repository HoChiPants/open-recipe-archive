      "item": "crusty bread to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Heat the olive oil in a large ovenproof skillet or saucepan, add the sliced garlic, and cook briefly until fragrant."
    },
    {
      "step": 2,
      "text": "Stir in the cherry tomatoes, bring to a gentle simmer, and cook until slightly thickened.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Meanwhile, cook the cavatappi in boiling water until al dente, then drain.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Mix the ricotta, double cream, and nutmeg until smooth."
    },
    {
      "step": 5,
      "text": "Toss the drained pasta and torn basil through the tomato sauce, then spoon the ricotta mixture over the top."
    },
    {
      "step": 6,
      "text": "Bake until the pasta is hot and the topping is bubbling. Sprinkle with the parmesan or vegetarian alternative and bake until lightly browned.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Serve hot with crusty bread."
    }
  ],
