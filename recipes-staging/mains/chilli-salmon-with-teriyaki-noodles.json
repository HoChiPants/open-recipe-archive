  "id": "chilli-salmon-with-teriyaki-noodles",
  "name": "Chilli Salmon with Teriyaki Noodles",
  "subtitle": "Roasted salmon with ginger, greens, and saucy noodles",
  "description": "Chilli and ginger season roasted salmon served with tender mangetout and teriyaki noodles.",
  "meal_type": "main",
  "cuisine": "Asian",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "skin-on-salmon-fillets-about-125g-4-1-2oz-each",
      "item": "skin-on salmon fillets (about 125g/4 1/2oz each)",
      "quantity": 2
    },
    {
      "ingredient_id": "red-chilli-deseeded-and-finely-chopped",
      "item": "red chilli deseeded and finely chopped",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "mirin",
      "item": "mirin",
      "quantity": 1,
