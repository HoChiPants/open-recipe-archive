      "item": "straight-to-wok noodles",
      "quantity": 300,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F (200°C).",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Place the salmon fillets in a roasting dish. Mix the chilli, mirin, ginger, and coriander, then spoon the mixture over the fish."
    },
    {
      "step": 3,
      "text": "Roast until the salmon is opaque, flakes easily, and reaches 145°F at the thickest point.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Meanwhile, heat the mangetout until tender. Add the soy sauce, teriyaki sauce, and noodles, then cook until the noodles are hot and coated.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Divide the noodles and mangetout between two bowls and top with the roasted salmon."
    }
  ],
