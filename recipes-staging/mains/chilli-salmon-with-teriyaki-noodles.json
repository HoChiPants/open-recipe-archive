      "item": "thumb-sized piece ginger peeled and finely grated",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "pack-coriander-chopped",
      "item": "pack coriander chopped",
      "quantity": "1/2",
      "unit": "small"
    },
    {
