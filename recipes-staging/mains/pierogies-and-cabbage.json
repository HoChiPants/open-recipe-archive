  "id": "pierogies-and-cabbage",
  "name": "Pierogies and Cabbage",
  "subtitle": "Crisp potato-and-cheese pierogies with smoky bacon and tender cabbage",
  "description": "Pan-browned pierogies are served with bacon, cabbage, onion, tomatoes, and a lightly sweet vinegar dressing.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
