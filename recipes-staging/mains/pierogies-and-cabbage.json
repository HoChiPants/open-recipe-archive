  "instructions": [
    {
      "step": 1,
      "text": "Heat a large skillet and add half of the oil. Cook the frozen pierogies for about 8 minutes, turning as needed, until golden brown. Transfer them to a plate.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Cook the diced bacon in the skillet for about 10 minutes, until browned. Transfer it to the plate with the pierogies.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the remaining oil, cabbage, and onion to the skillet. Cook for 10 minutes, stirring occasionally, until the vegetables are tender.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the tomatoes, vinegar, sugar, and salt. Return the bacon to the skillet and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Toss the cabbage mixture with the browned pierogies and serve hot."
    }
  ],
