  "id": "grilled-halibut-with-parmesan-topping",
  "name": "Grilled Halibut with Parmesan Topping",
  "subtitle": "Tender halibut finished with a savory, lightly browned topping",
  "description": "A quick grilled fish dish topped with a creamy Parmesan mixture, green onions, lemon, and hot pepper sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "hot-pepper-sauce",
      "item": "hot pepper sauce",
      "quantity": 1,
      "unit": "dash"
    },
    {
      "ingredient_id": "skinless-halibut-fillets",
      "item": "skinless halibut fillets",
      "quantity": 2,
      "unit": "pounds"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill."
    },
    {
      "step": 2,
      "text": "Place the halibut fillets on the grill and cook for 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Mix the butter, mayonnaise, green onions, lemon juice, salt, hot pepper sauce, and half of the Parmesan until combined."
    },
    {
      "step": 4,
      "text": "Spread the mixture over the grilled fillets and sprinkle with the remaining Parmesan."
    },
    {
      "step": 5,
      "text": "Grill until the topping is lightly browned and the fish reaches 145°F, or is opaque and flakes easily.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
