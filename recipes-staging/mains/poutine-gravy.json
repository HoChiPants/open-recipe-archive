{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "poutine-gravy",
  "name": "Poutine Gravy",
  "subtitle": "Crisp fries with beef gravy and cheese curds",
  "description": "A savory beef-and-onion gravy ladled over golden fries, finished with fresh cheese curds and chives.",
  "meal_type": "main",
  "cuisine": "French",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "boneless-beef-chuck",
      "item": "boneless beef chuck",
      "quantity": 1,
      "unit": "pound",
      "preparation": "chopped, or more to taste"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 1,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper-to-taste",
      "item": "freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "homemade-beef-broth",
      "item": "homemade beef broth",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "crinkle-cut-french-fries",
      "item": "crinkle-cut French fries",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce, or to taste"
    },
    {
      "ingredient_id": "fresh-cheese-curds",
      "item": "fresh cheese curds",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "fresh-chives",
      "item": "fresh chives",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "chopped, or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a pot over medium-high heat. Add the chopped beef and beef broth; stir for 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Melt the butter in the pot. Add the onions, salt, black pepper, and cayenne; cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir in the flour and cook for 3 minutes, stirring continuously.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Bring the gravy to a simmer and cook for 20 minutes, stirring occasionally, until thickened and the beef reaches at least 145°F on a food thermometer. Let the beef rest for 3 minutes, then adjust the salt.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Preheat the oven to 450°F. Prepare the crinkle-cut French fries according to the package directions and bake until golden brown, about 18 minutes.",
      "timer_minutes": 18
    },
    {
      "step": 6,
      "text": "Arrange the fries on serving plates, top with the cheese curds, and spoon over the beef gravy. Garnish with the chives."
    }
  ],
