  "id": "barbecue-chicken-platter",
  "name": "Barbecue Chicken Platter",
  "subtitle": "Spice-rubbed chicken with a tangy mustard glaze",
  "description": "Chicken is seasoned with smoked paprika and garlic, cooked until fully done, and finished with a sweet-tangy mustard sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-jointed",
      "item": "chicken jointed",
      "quantity": 1,
      "unit": "whole",
      "preparation": "or 8 bone-in chicken pieces (we used legs, breasts, thighs and wings)"
    },
    {
      "ingredient_id": "sea-salt",
      "item": "sea salt",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "smoked-paprika",
      "item": "smoked paprika",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-granules",
      "item": "garlic granules",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "runny-honey",
      "item": "runny honey",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "cider-vinegar",
      "item": "cider vinegar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "american-mustard",
      "item": "American mustard",
      "quantity": 200,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sea salt, smoked paprika, and garlic granules. Rub the mixture over the chicken and set it aside."
    },
    {
      "step": 2,
      "text": "Stir the honey, cider vinegar, brown sugar, and mustard together in a saucepan. Bring to a gentle simmer, then cook until smooth and slightly thickened."
    },
    {
      "step": 3,
      "text": "Preheat the oven or grill to medium-high heat."
    },
    {
      "step": 4,
      "text": "Coat the chicken with the sauce and place it in the cooking vessel."
    },
    {
      "step": 5,
      "text": "Cook for about 60 minutes, turning and basting as needed, until the thickest pieces reach 165°F on a food thermometer and the juices run clear.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Serve the chicken hot with any remaining sauce."
    }
  ],
