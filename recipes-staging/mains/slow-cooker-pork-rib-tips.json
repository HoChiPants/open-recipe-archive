  "instructions": [
    {
      "step": 1,
      "text": "Mix the brown sugar, chili powder, salt, pepper, garlic powder, and onion powder. Coat the pork rib tips evenly with the seasoning and let them stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Place the seasoned pork in a slow cooker. Stir together the liquid smoke and half of the barbecue sauce, pour the mixture over the pork, and cover."
    },
    {
      "step": 3,
      "text": "Cook until tender and the pork reaches at least 145°F in the thickest portion. Rest for 3 minutes before serving."
    },
    {
      "step": 4,
      "text": "Warm the remaining barbecue sauce in a small saucepan over medium-low heat for 5 minutes. Serve it with the rib tips.",
      "timer_minutes": 5
    }
  ],
