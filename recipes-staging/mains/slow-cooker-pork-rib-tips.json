  "id": "slow-cooker-pork-rib-tips",
  "name": "Slow Cooker Pork Rib Tips",
  "subtitle": "Tender, smoky pork with a sweet-spiced crust",
  "description": "Seasoned pork rib tips cook slowly with barbecue sauce and liquid smoke, then receive a warm sauce finish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
