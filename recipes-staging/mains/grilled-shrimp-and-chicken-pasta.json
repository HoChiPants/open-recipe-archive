  "instructions": [
    {
      "step": 1,
      "text": "Combine the garlic powder, poultry seasoning, cayenne, white pepper, onion powder, and white wine. Coat the chicken and shrimp with the mixture; let the chicken stand for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan. Whisk in the heavy cream and milk, then cook until thickened and set. Keep the sauce warm over low heat."
    },
    {
      "step": 3,
      "text": "Cook the linguine in boiling water for 10 minutes, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Preheat the grill and brush the grates with the olive oil. Grill the chicken until the thickest part reaches 165°F."
    },
    {
      "step": 5,
      "text": "Grill the shrimp for about 4 minutes, turning as needed, until opaque.",
      "timer_minutes": 4
    },
    {
      "step": 6,
      "text": "Toss the linguine with the warm cream sauce and serve with the grilled chicken and shrimp. Whisk the sauce briefly if needed, then garnish with the Romano cheese."
    }
  ],
