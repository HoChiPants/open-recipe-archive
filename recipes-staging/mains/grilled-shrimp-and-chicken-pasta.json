  "id": "grilled-shrimp-and-chicken-pasta",
  "name": "Grilled Shrimp and Chicken Pasta",
  "subtitle": "Linguine with creamy white-wine sauce",
  "description": "Seasoned grilled chicken and shrimp are served over linguine with a creamy Romano-finished sauce.",
  "meal_type": "main",
  "cuisine": "Italian",
