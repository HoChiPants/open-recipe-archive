  "instructions": [
    {
      "step": 1,
      "text": "Cook the penne according to package directions until tender, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet over medium heat. Add the garlic and onion; cook until softened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pour in the white wine and simmer briefly. Stir in the red pepper flakes, butter, asparagus, and salt and pepper.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Cook until the asparagus is tender.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the shrimp and lemon juice. Cook until the shrimp are opaque and cooked through, then season with salt and pepper."
    },
    {
      "step": 6,
      "text": "Toss the drained penne with the asparagus and shrimp mixture. Finish with parsley and Parmesan."
    }
  ],
