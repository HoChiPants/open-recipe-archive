  "instructions": [
    {
      "step": 1,
      "text": "Cook the penne until tender, then drain."
    },
    {
      "step": 2,
      "text": "Warm the olive oil in a large pan. Add the crushed garlic and spinach, and cook until the spinach wilts.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir in the soft cheese and heat until melted and smooth."
    },
    {
      "step": 4,
      "text": "Add the shredded cooked chicken, frozen peas, and optional Parmesan. Simmer until the peas are hot and the chicken reaches 165°F throughout.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the drained pasta and stir until evenly coated. Finish with the chopped parsley or basil and serve."
    }
  ],
