  "id": "creamy-chicken-penne",
  "name": "Creamy Chicken Penne",
  "subtitle": "Tender pasta with chicken, greens, peas, and a smooth cheese sauce.",
  "description": "A quick, creamy penne dish combining shredded chicken, spinach, peas, and fresh herbs for an easy main course.",
  "meal_type": "main",
