  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Toss the beetroot with 1 tablespoon of the oil, place in a roasting dish, and cook for about 30 minutes, until tender.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Heat the remaining oil in a large lidded pan over medium heat. Cook the onion for 10 minutes, until softened and lightly golden.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the ginger and garlic and cook for 1 minute. Stir in the bay leaf, cardamom, turmeric, and garam masala for 2 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Mix in the rinsed rice, then pour in the stock. Bring to a simmer, cover, and cook for 25 minutes, until the rice is cooked through.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Stir the roasted beetroot through the rice. Blend the yogurt with the garlic and coriander until smooth, then serve alongside the biriyani with chutney or pickle if desired."
    }
  ],
