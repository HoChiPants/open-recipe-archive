  "id": "beetroot-biriyani",
  "name": "Beetroot Biriyani",
  "subtitle": "Spiced basmati rice with tender beetroot",
  "description": "A colorful vegetarian rice dish combining roasted beetroot, warm spices, and a cool yogurt-coriander accompaniment.",
  "meal_type": "main",
  "yield": {
