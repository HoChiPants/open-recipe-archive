  "id": "baked-sauerkraut-and-rotelle-casserole",
  "name": "Baked Sauerkraut and Rotelle Casserole",
  "subtitle": "A savory baked pasta dish with bacon, mushrooms, and sauerkraut",
  "description": "Tender rotelle combines with smoky bacon, sautéed vegetables, creamy mushroom soup, and tangy sauerkraut in a hearty baked casserole.",
  "meal_type": "main",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "rotelle-pasta",
      "item": "rotelle pasta",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "mushrooms",
      "item": "mushrooms",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "quartered"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 2,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "sauerkraut",
      "item": "sauerkraut",
      "quantity": 1,
      "unit": "can",
      "preparation": "16 ounce, rinsed and drained"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Bring a pot of water seasoned with salt and pepper to a simmer, add the rotelle, and cook for 10 minutes, or until tender. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Cook the bacon in a large skillet until browned. Transfer it out of the skillet, leaving the drippings behind."
    },
    {
      "step": 3,
      "text": "Add the onions to the skillet and cook until softened. Add the butter, mushrooms, and condensed soup; stir until combined and heated."
    },
    {
      "step": 4,
      "text": "Combine the drained pasta, bacon, onion mixture, and sauerkraut. Season with salt and pepper, then transfer to a baking dish."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, until hot throughout.",
      "timer_minutes": 45
    }
  ],
