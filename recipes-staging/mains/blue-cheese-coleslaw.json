  "instructions": [
    {
      "step": 1,
      "text": "Whisk the mayonnaise, Dijon-style mustard, crumbled blue cheese, sugar, and cider vinegar until smooth and evenly blended."
    },
    {
      "step": 2,
      "text": "Combine the coleslaw mix, halved grapes, and shredded carrot in a large bowl. Add the dressing and toss until evenly coated."
    },
    {
      "step": 3,
      "text": "Cover and chill before serving."
    }
  ],
