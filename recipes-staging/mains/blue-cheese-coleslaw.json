  "id": "blue-cheese-coleslaw",
  "name": "Blue Cheese Coleslaw",
  "subtitle": "Creamy slaw with grapes and blue cheese",
  "description": "A crisp, creamy coleslaw combining shredded vegetables, sweet red grapes, tangy dressing, and blue cheese.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
