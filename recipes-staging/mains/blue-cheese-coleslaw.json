      "item": "coleslaw mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce, shredded"
    },
    {
      "ingredient_id": "seedless-red-grapes",
      "item": "seedless red grapes",
      "quantity": 2,
