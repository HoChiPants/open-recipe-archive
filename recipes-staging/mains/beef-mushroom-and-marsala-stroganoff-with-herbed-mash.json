  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes and celery salt (optional) in a saucepan, cover with water, and simmer until tender.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Drain the potatoes, return them to the pan, and cook briefly to remove excess moisture.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Mash with the butter and milk. Stir in the soured cream and soft herbs, reserving some herbs for serving; keep warm."
    },
    {
      "step": 4,
      "text": "Heat the rapeseed oil in a large pan. Add the onion and mushrooms and cook until softened and lightly browned.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Stir in the smoked paprika and Marsala, then add the leftover ragu. Simmer until hot and well combined.",
      "timer_minutes": 7
    },
    {
      "step": 6,
      "text": "If the ragu contains ground beef, check that it reaches 160°F; otherwise heat the mixture thoroughly before serving."
    },
    {
      "step": 7,
      "text": "Remove from the heat and stir in the Dijon mustard and double cream."
    },
    {
      "step": 8,
      "text": "Spoon the stroganoff over the mash and scatter with the reserved herbs."
    }
  ],
