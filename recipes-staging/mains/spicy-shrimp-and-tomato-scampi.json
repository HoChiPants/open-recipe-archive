  "instructions": [
    {
      "step": 1,
      "text": "Cook the penne in boiling water until cooked through, about 11 minutes. Drain and set aside.",
      "timer_minutes": 11
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet. Add the garlic and onion, and cook until the onion softens, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the drained tomatoes with green chilies and simmer for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the lemon juice and shrimp. Cook, stirring occasionally, until the shrimp are opaque and cooked through, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the parsley, salt, black pepper, and red pepper flakes. Serve the shrimp and sauce over the penne, and top with the tomatoes and Parmesan."
    }
  ],
