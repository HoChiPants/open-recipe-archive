  "id": "chilled-olive-oil-poached-tuna",
  "name": "Chilled Olive Oil-Poached Tuna",
  "subtitle": "Tender tuna infused with garlic, thyme, and chili",
  "description": "Gently poach tuna in seasoned olive oil, then chill it for a make-ahead main dish.",
  "meal_type": "main",
