  "instructions": [
    {
      "step": 1,
      "text": "Let the tuna stand at room temperature for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Combine the garlic, thyme, and red pepper flakes with the olive oil in a pan deep enough to hold the steaks."
    },
    {
      "step": 3,
      "text": "Warm the oil and aromatics gently for 10 minutes, keeping the oil below a simmer.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the tuna and poach gently for 7 minutes, turning as needed, until the thickest part reaches 145°F or the fish is opaque and flakes easily.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Remove the pan from the heat and let the tuna cool in the oil."
    },
    {
      "step": 6,
      "text": "Cover and refrigerate for 24 hours. Season with sea salt to taste before serving.",
      "timer_minutes": 1440
    }
  ],
