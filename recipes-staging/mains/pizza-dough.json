  "schema_version": "1.0.0",
  "id": "pizza-dough",
  "name": "Pizza Dough",
  "subtitle": "A simple yeasted dough for homemade pizza",
  "description": "Mix, rest, shape, and bake this straightforward dough into a crisp-edged pizza base.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Combine the warm water, yeast, and sugar. Let stand until the yeast softens and becomes lightly foamy, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the flour, olive oil, and salt, then whisk or stir until a smooth dough forms."
    },
    {
      "step": 4,
      "text": "Let the dough rest for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Shape the dough on a lightly floured surface and transfer it to a baking surface."
    },
    {
      "step": 6,
      "text": "Bake until golden brown, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Cool for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
