  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Season the skirt steak and chicken thighs with the fajita seasoning and half of the garlic powder."
    },
    {
      "step": 2,
      "text": "Cook the steak and chicken until the steak reaches 145°F, then rest it for 3 minutes; cook the chicken to 165°F. Cut both into bite-size pieces."
    },
    {
      "step": 3,
      "text": "Warm the refried beans. Stir the mashed avocados with the remaining garlic powder, salt, lemon pepper, and green bell pepper; set aside."
    },
    {
      "step": 4,
      "text": "Cut the corn tortillas into wedges. Heat the corn oil and sauté the wedges until crisp, then transfer them to a serving dish or oven-safe platter."
    },
    {
      "step": 5,
      "text": "Sauté the cooked meats with the onion, remaining green bell pepper, and lemon pepper. Stir in the cilantro and cook for 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 6,
      "text": "Layer the tortilla chips with the refried beans, meat mixture, and shredded American cheese."
    },
    {
      "step": 7,
      "text": "Bake until the beans are hot and the cheese is melted, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "Whisk the sour cream until smooth. Top the platter with the sour cream, avocado mixture, chopped tomatoes, and sliced pickled jalapeño peppers."
    }
  ],
