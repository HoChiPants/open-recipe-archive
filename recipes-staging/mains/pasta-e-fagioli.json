  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. Add the onion, celery, and carrots and cook until softened.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the garlic, rosemary, and bay leaves, then add the stock and tomatoes. Bring to a gentle simmer."
    },
    {
      "step": 3,
      "text": "Add the cannellini beans and simmer to bring the flavors together.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the pasta and cavolo nero. Cook until the pasta and greens are tender.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Remove the rosemary sprigs and bay leaves. Serve with a drizzle of olive oil and grated parmesan or vegetarian alternative."
    }
