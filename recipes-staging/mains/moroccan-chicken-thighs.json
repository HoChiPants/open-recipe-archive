  "id": "moroccan-chicken-thighs",
  "name": "Moroccan Chicken Thighs",
  "subtitle": "Spiced chicken with lemon, olives, and parsley",
  "description": "Chicken thighs are seasoned with warm spices, seared with onion, then baked in a lemony broth and finished with olives and parsley.",
  "meal_type": "main",
