  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken thighs with salt and pepper. Mix the broth, paprika, cumin, ginger, turmeric, cinnamon, and lemon zest and juice, then coat the chicken. Cover and let stand for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 3,
      "text": "Heat the canola oil in an oven-safe skillet over medium-high heat. Add the chicken with its broth mixture and cook for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Turn the chicken and cook for 4 minutes more, then transfer the chicken to a plate.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Add the chopped onion to the skillet and sauté until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Return the chicken and broth to the skillet and transfer it to the oven. Bake until the chicken reaches 165°F at the thickest part near the bone, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Stir in the olive oil and olives. Garnish with the lemon and parsley before serving."
    }
  ],
