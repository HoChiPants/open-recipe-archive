  "id": "garlic-breaded-chicken",
  "name": "Garlic Breaded Chicken",
  "subtitle": "Crisp seasoned crumbs over tender garlic-butter chicken",
  "description": "Chicken breast halves are coated in garlic butter and seasoned bread crumbs, then baked until fully cooked.",
  "meal_type": "main",
