  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Melt the butter and combine it with the crushed garlic."
    },
    {
      "step": 3,
      "text": "Coat the chicken with the garlic butter, then cover it with the seasoned bread crumbs."
    },
    {
      "step": 4,
      "text": "Transfer the coated chicken to a baking dish."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, until the thickest piece reaches 165°F on a food thermometer.",
      "timer_minutes": 45
    }
