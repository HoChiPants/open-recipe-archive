  "id": "beef-paprika",
  "name": "Beef Paprika",
  "subtitle": "Tender beef in a savory paprika sauce",
  "description": "Cubed beef chuck is braised with onion, garlic, paprika, and a tangy-sweet sauce, then lightly thickened before serving.",
  "meal_type": "main",
  "cuisine": "American",
