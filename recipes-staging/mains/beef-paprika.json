  "instructions": [
    {
      "step": 1,
      "text": "Heat the shortening in a large heavy pot over medium-high heat. Add the beef and cook until browned on several sides."
    },
    {
      "step": 2,
      "text": "Add the onion and garlic and cook until softened. Stir in the brown sugar."
    },
    {
      "step": 3,
      "text": "Add the ketchup, Worcestershire sauce, salt, mustard powder, paprika, and 1.5 cups water. Stir to combine."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a boil, then reduce the heat, cover, and simmer for 2 hours, or until the beef is tender and reaches at least 145°F internally followed by a 3-minute rest.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Whisk the remaining water with the flour until smooth. Stir the slurry into the pot and bring the sauce back to a boil, stirring until thickened."
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
