  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. Add the spring onions, garlic, and coriander, and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Stir in the tagine paste and lemon zest and juice; cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the chopped tomatoes and dates or prunes. Simmer for 10 minutes, stirring occasionally, until thickened.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Fold in the chickpeas and piquillo peppers, and cook for 5 minutes until hot.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Prepare the couscous according to its package directions. Serve the tagine with the couscous."
    }
  ],
