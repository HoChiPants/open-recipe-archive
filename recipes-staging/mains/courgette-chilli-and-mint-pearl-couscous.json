  "instructions": [
    {
      "step": 1,
      "text": "Cook the pearl couscous according to its package directions until set, then drain well."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet. Add the courgettes and red onion and sauté until tender and lightly browned.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the chilli and garlic; cook until fragrant.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Toss the couscous with the sautéed vegetables, chopped mint, lemon juice, and honey. Crumble over the salad cheese and scatter with the reserved whole mint leaves."
    }
