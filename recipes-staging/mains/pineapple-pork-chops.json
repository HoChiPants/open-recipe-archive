  "id": "pineapple-pork-chops",
  "name": "Pineapple Pork Chops",
  "subtitle": "Skillet pork chops with caramelized pineapple and goat cheese",
  "description": "Seared pork chops are finished with browned pineapple, red onion, warm spices, and a tangy goat cheese topping.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "chipotle-chile-powder",
      "item": "chipotle chile powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "onion-powder",
      "item": "onion powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "pineapple-rings",
      "item": "pineapple rings",
      "quantity": 1,
      "unit": "can",
      "preparation": "8 ounce, drained and juice reserved"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "divided"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "boneless-pork-chops",
      "item": "boneless pork chops",
      "quantity": 4
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "crumbled-goat-cheese",
      "item": "crumbled goat cheese",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir together the chipotle chile powder, garlic powder, cinnamon, and onion powder. Season the pork chops with salt and black pepper, then coat them with the spice mixture."
    },
    {
      "step": 2,
      "text": "Heat half of the olive oil in a large skillet over medium-high heat. Add the pineapple rings and red onion, sprinkle with the brown sugar, and cook until the pineapple is lightly browned, about 3 minutes. Transfer the fruit and onion to a plate.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the remaining olive oil to the skillet. Cook the pork chops for about 3 minutes per side, adding a splash of the reserved pineapple juice if the pan becomes dry.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Check the thickest part of each chop with a food thermometer; continue cooking as needed until it reaches 145°F. Remove from the heat and rest for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Return the pineapple and onion to the skillet, spoon the pan juices over the pork, and finish with the goat cheese."
    }
  ],
