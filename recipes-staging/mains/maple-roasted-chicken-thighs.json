{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "maple-roasted-chicken-thighs",
  "name": "Maple-Roasted Chicken Thighs",
  "subtitle": "Roasted chicken with sweet potatoes and Brussels sprouts",
  "description": "Chicken thighs and autumn vegetables roast with a maple-thyme glaze, then finish with toasted pecans and dried cranberries.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "snipped-fresh-thyme",
      "item": "snipped fresh thyme",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.75,
      "unit": "teaspoon",
      "preparation": "divided"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.75,
      "unit": "teaspoon",
      "preparation": "divided"
    },
    {
      "ingredient_id": "sweet-potatoes",
      "item": "sweet potatoes",
      "quantity": 1,
      "unit": "pound",
      "preparation": "peeled and cut into 1-inch wedges"
    },
    {
      "ingredient_id": "brussels-sprouts",
      "item": "Brussels sprouts",
      "quantity": 1,
      "unit": "pound",
      "preparation": "trimmed and halved"
    },
    {
      "ingredient_id": "bone-in-chicken-thighs",
      "item": "bone-in chicken thighs",
      "quantity": 4
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped toasted"
    },
    {
      "ingredient_id": "dried-cranberries",
      "item": "dried cranberries",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Whisk the maple syrup, half the olive oil, thyme, half the salt, and half the pepper until combined; set aside."
    },
    {
      "step": 2,
      "text": "Toss the sweet potatoes and Brussels sprouts with the remaining olive oil, salt, and pepper until evenly coated."
    },
    {
      "step": 3,
      "text": "Rub the chicken thighs with the remaining olive oil and season with the remaining salt and pepper. Arrange the chicken and sweet potatoes on a sheet pan."
    },
    {
      "step": 4,
      "text": "Roast for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Brush the chicken with the maple mixture and add the Brussels sprouts to the pan, turning the vegetables as needed."
    },
    {
      "step": 6,
      "text": "Roast for 15 minutes more, until the vegetables are tender and the chicken reaches 165°F in the thickest part.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Sprinkle with the pecans and dried cranberries, then serve."
    }
  ],
