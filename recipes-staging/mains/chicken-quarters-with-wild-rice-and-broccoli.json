  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the chicken leg quarters and condensed cream of chicken soup in a baking dish. Bake for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 3,
      "text": "Combine the instant rice, water, sour cream, both preparations of garlic, and broccoli."
    },
    {
      "step": 4,
      "text": "Remove the chicken from the dish and drain the liquid. Add the rice mixture and return the chicken to the dish."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, until the rice is tender and the chicken reaches 165°F at the thickest part.",
      "timer_minutes": 45
    }
