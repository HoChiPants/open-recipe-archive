  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Heat the oil in a large ovenproof skillet or frying pan. Brown the chicken legs on all sides for 5 minutes, then transfer them to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Cook the onion and pepper in the pan for 10 minutes, until softened. Stir in the chilli flakes and garlic.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the wine and let it reduce briefly. Stir in the tomatoes, oregano, chicken stock, spinach, and sugar."
    },
    {
      "step": 5,
      "text": "Simmer the sauce for 10 minutes, until the spinach wilts and the mixture is slightly reduced.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Return the chicken to the sauce and transfer everything to a baking dish if needed. Bake for 40 minutes, or until the thickest part of each leg reaches 165°F.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Cook the pasta according to the package directions and drain."
    },
    {
      "step": 8,
      "text": "Serve the chicken and sauce with the pasta, garnished with extra oregano."
    }
  ],
