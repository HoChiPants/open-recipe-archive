  "id": "baked-chicken-arrabbiata",
  "name": "Baked Chicken Arrabbiata",
  "subtitle": "Spicy tomato-baked chicken with pasta",
  "description": "Chicken legs are browned, then baked in a spicy tomato sauce with peppers, spinach, and oregano. Serve with pasta for a complete meal.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
