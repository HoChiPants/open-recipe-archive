  "instructions": [
    {
      "step": 1,
      "text": "Combine the lime juice, minced garlic, and chopped basil. Coat the pork chops with the mixture, then season with salt and black pepper."
    },
    {
      "step": 2,
      "text": "Cover and let the seasoned chops rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat the grill."
    },
    {
      "step": 4,
      "text": "Grill the chops for 10 minutes, turning as needed, until the thickest part reaches 145°F on a food thermometer. Rest for 3 minutes before serving.",
      "timer_minutes": 10
    }
  ],
