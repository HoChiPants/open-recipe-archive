  "id": "slow-cooker-apple-cider-pork-shoulder",
  "name": "Slow Cooker Apple Cider Pork Shoulder",
  "subtitle": "Tender pork with a tangy cider pan sauce",
  "description": "Pork shoulder is browned, slow-cooked with apple cider and aromatics, then served with a reduced buttery sauce and fresh herbs.",
  "meal_type": "main",
  "cuisine": "American",
