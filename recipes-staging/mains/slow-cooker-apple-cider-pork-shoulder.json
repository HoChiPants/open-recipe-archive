  "instructions": [
    {
      "step": 1,
      "text": "Season the pork shoulder with salt, black pepper, and cayenne pepper."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large skillet over medium-high heat. Brown the pork on all sides, about 3 minutes total, then transfer it to a slow cooker.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Cook the shallots and celery in the skillet until softened, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Pour in the apple cider vinegar and apple cider, scraping up any browned bits. Cook for 5 minutes, then add the garlic and bay leaf.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Pour the cider mixture over the pork. Cover and cook on low until the roast is tender, about 6 hours. Confirm the center reaches at least 145°F with a food thermometer.",
      "timer_minutes": 360
    },
    {
      "step": 6,
      "text": "Transfer the pork to a platter and let it rest for at least 3 minutes. Remove the bay leaf from the cooking liquid.",
      "timer_minutes": 3
    },
    {
      "step": 7,
      "text": "Simmer the liquid in a skillet for 10 minutes. Whisk in the Dijon mustard, remaining salt and cayenne pepper, and cold butter until smooth; stir in the fresh herbs.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Cut the pork into thick slices and serve with the sauce."
    }
  ],
