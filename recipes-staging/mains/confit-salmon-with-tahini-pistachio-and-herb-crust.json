  "instructions": [
    {
      "step": 1,
      "text": "Mix the sea salt flakes with the lemon zest and juice. Rub the mixture over the salmon and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Preheat the oven for the salmon confit. Wipe the cure from the salmon and pat it dry."
    },
    {
      "step": 3,
      "text": "Place the salmon in a baking dish. Warm the 350 ml olive oil with the cardamom, cumin, caraway, and fennel seeds, then pour it over the fish."
    },
    {
      "step": 4,
      "text": "Cook the salmon in the oil for 25 minutes, until it reaches 145°F internally or is opaque and flakes easily.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Stir the Greek yogurt, tahini, crushed garlic, and lemon juice until smooth."
    },
    {
      "step": 6,
      "text": "Combine the pistachios, shallot, chilli, pomegranate seeds, dill, parsley, mint, and 2 tbsp olive oil."
    },
    {
      "step": 7,
      "text": "Lift the salmon from the oil and serve with the tahini sauce and herb topping."
    }
  ],
