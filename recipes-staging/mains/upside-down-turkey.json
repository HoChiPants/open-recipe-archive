  "id": "upside-down-turkey",
  "name": "Upside-Down Turkey",
  "subtitle": "Tender roast turkey with pan juices",
  "description": "Roast the turkey breast-side down so the meat stays moist while the pan collects flavorful juices.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "12-pound-whole-turkey",
      "item": "(12 pound) whole turkey",
      "quantity": 1
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Prepare the turkey for roasting, removing any included packet and patting the skin dry."
    },
    {
      "step": 3,
      "text": "Place the turkey breast-side down in a roasting pan."
    },
    {
      "step": 4,
      "text": "Cut the butter into pieces and distribute it over the turkey. Pour the water into the pan."
    },
    {
      "step": 5,
      "text": "Roast for 120 minutes, then continue roasting as needed until the thickest part of the breast and thigh reaches 165°F on a food thermometer.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Rest the turkey briefly before carving."
    }
  ],
