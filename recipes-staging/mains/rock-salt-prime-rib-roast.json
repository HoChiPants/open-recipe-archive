  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "rock-salt-prime-rib-roast",
  "name": "Rock Salt Prime Rib Roast",
  "subtitle": "Mustard-coated beef with horseradish cream",
  "description": "A salt-crusted prime rib roast served with lightly whipped horseradish cream.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "4-pound-prime-rib-roast",
      "item": "(4 pound) prime rib roast",
      "quantity": 1
    },
    {
      "ingredient_id": "prepared-hot-mustard",
      "item": "prepared hot mustard",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "rock-salt",
      "item": "rock salt",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "cream",
      "item": "cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "prepared-horseradish",
      "item": "prepared horseradish",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Coat the prime rib roast evenly with the prepared hot mustard."
    },
    {
      "step": 3,
      "text": "Pack the rock salt in a thick layer around the mustard-coated roast."
    },
    {
      "step": 4,
      "text": "Roast for 60 minutes, or until a thermometer inserted into the center reads 145°F.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Remove the roast from the salt crust and let it rest for at least 3 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Whisk the cream to stiff peaks, then fold in the prepared horseradish."
    },
    {
      "step": 7,
      "text": "Cut the roast into portions and serve with the horseradish cream."
    }
  ],
