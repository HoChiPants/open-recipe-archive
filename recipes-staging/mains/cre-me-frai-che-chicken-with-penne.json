  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet over medium heat. Add the chicken, white wine, half the onion, and salt and pepper."
    },
    {
      "step": 2,
      "text": "Cover and cook until the chicken reaches 165°F in the thickest part, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Meanwhile, cook the penne according to the package directions until tender, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Transfer the cooked chicken to a board and cut it into bite-size pieces."
    },
    {
      "step": 5,
      "text": "In the skillet, cook the remaining onion and garlic until the onion is tender.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Add the mushrooms and cook until softened."
    },
    {
      "step": 7,
      "text": "Whisk the crème fraîche and sour cream together, then stir them into the skillet. Season with salt and pepper and cook until the sauce is set."
    },
    {
      "step": 8,
      "text": "Stir in the drained pasta and chicken. Top with the grated Parmesan cheese and serve."
    }
  ],
