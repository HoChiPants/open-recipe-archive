  "id": "cre-me-frai-che-chicken-with-penne",
  "name": "Crème Fraîche Chicken with Penne",
  "subtitle": "Tender chicken and mushrooms in a creamy French-style sauce",
  "description": "Chicken breasts, mushrooms, and penne are combined with crème fraîche, sour cream, and Parmesan for a rich skillet dinner.",
  "meal_type": "main",
  "cuisine": "French",
