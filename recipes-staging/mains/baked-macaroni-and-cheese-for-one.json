  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Bring a small saucepan of water seasoned with the salt to a boil. Cook the macaroni for 8 minutes, then drain.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Melt the butter in the saucepan. Whisk in the milk, flour, onion powder, pepper, and remaining salt until smooth. Stir for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the ground mustard, Worcestershire sauce, hot sauce, and 1/3 cup shredded cheddar. Stir until the cheese melts and the sauce is smooth."
    },
    {
      "step": 5,
      "text": "Return the macaroni to the saucepan and stir to coat. Transfer to a small baking dish, then top with the breadcrumbs and 1 tablespoon shredded cheddar."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, until the cheese is melted and the top is lightly browned.",
      "timer_minutes": 10
    }
  ],
