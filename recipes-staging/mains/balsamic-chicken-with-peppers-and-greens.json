  "instructions": [
    {
      "step": 1,
      "text": "Warm the 2 tablespoons olive oil in a large skillet over medium heat. Stir in the first garlic portion for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Season the chicken with salt and black pepper, add it to the skillet, and cook, turning as needed, until browned and the thickest part reaches 165°F.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Transfer the chicken to a plate. Add the remaining olive oil and garlic to the skillet, then stir in the peppers, onion, asparagus, salt, and black pepper. Cook until the vegetables are tender-crisp.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the spinach and toss until just wilted."
    },
    {
      "step": 5,
      "text": "Combine the balsamic vinegar and brown sugar in the skillet. Simmer until slightly thickened.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Return the chicken to the skillet and spoon the balsamic mixture over it. Serve with the vegetables and remaining glaze."
    }
  ],
