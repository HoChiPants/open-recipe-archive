{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "stuffed-chicken-breasts-with-bacon-and-cream-cheese",
  "name": "Stuffed Chicken Breasts with Bacon and Cream Cheese",
  "subtitle": "Creamy cheese-filled chicken with crisp bacon and herbs",
  "description": "Chicken breasts are filled with seasoned cream cheese, Cheddar, herbs, and bacon, then baked until tender and fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "5-ounce-skinless",
      "item": "(5 ounce) skinless",
      "quantity": 6,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "shredded, divided"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped, or to taste"
    },
    {
      "ingredient_id": "fresh-cilantro",
      "item": "fresh cilantro",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped, or to taste"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Arrange the bacon in a single layer in a baking pan and bake until cooked, about 15 minutes. Drain, cool briefly, and chop.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Cut a pocket horizontally into the thick side of each chicken breast, taking care not to cut through."
    },
    {
      "step": 4,
      "text": "Combine the softened cream cheese, 1/2 cup of the Cheddar, green onions, cilantro, garlic, and chopped bacon."
    },
    {
      "step": 5,
      "text": "Fill each chicken pocket with the mixture and place the breasts in a baking dish."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, then sprinkle with the remaining Cheddar. Continue baking until the cheese melts and the chicken reaches 165°F in the thickest part, about 10 minutes more.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Let the chicken cool briefly before serving."
    }
  ],
