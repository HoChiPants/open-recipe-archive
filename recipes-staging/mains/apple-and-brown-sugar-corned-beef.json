  "id": "apple-and-brown-sugar-corned-beef",
  "name": "Apple and Brown Sugar Corned Beef",
  "subtitle": "Tender corned beef with sweet apple broth and vegetables",
  "description": "Corned beef briskets simmer with apple juice, brown sugar, mustard, and hearty vegetables for a complete one-pot meal.",
  "meal_type": "main",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "apple-juice",
      "item": "apple juice",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "prepared-mustard",
      "item": "prepared mustard",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "3-pound-corned-beef-briskets-with-spice-packets",
      "item": "(3 pound) corned beef briskets with spice packets",
      "quantity": 2
    },
    {
      "ingredient_id": "red-potatoes",
      "item": "red potatoes",
      "quantity": 20,
      "unit": "small",
      "preparation": "scrubbed"
    },
    {
      "ingredient_id": "head-cabbage",
      "item": "head cabbage",
      "quantity": 1,
      "preparation": "cored and cut into large chunks"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "preparation": "cut into 8 wedges"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 4,
      "preparation": "cut into chunks"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour the apple juice into a large pot. Stir together the brown sugar and prepared mustard, then add the mixture to the pot."
    },
    {
      "step": 2,
      "text": "Place the corned beef briskets and their spice packets in the pot. Add the potatoes, cabbage, onions, and carrots around the meat."
    },
    {
      "step": 3,
      "text": "Cover and cook until the briskets are tender, about 4 hours. Check that the beef reaches at least 145°F with a food thermometer, then rest it for 3 minutes.",
      "timer_minutes": 240
    },
    {
      "step": 4,
      "text": "Slice the rested briskets and serve with the cooked vegetables and cooking liquid."
    }
  ],
