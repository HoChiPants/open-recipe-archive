  "instructions": [
    {
      "step": 1,
      "text": "Toast the cumin seeds in a dry pan until fragrant. Remove from the heat and let cool, then combine with the deggi mirch spice blend and optional amchoor powder."
    },
    {
      "step": 2,
      "text": "Mix the yogurt, lime juice, ginger, finely grated garlic, chopped curry leaves, chopped coriander, spice mixture, sugar, rapeseed oil, and ketchup. Add the chicken and coat thoroughly. Cover and marinate for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Stir the rice flour into the marinated chicken until evenly coated."
    },
    {
      "step": 4,
      "text": "Heat the vegetable oil for deep-frying. Fry the chicken in batches for about 4 minutes, or until golden and the thickest pieces reach 165°F.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Heat the rapeseed oil in a pan. Add the finely grated garlic, chopped curry leaves, chopped coriander, slit green chillies, finely chopped garlic, and whole curry leaves; cook briefly until aromatic."
    },
    {
      "step": 6,
      "text": "Add the fried chicken and toss for 1 minute to coat. Serve with lime wedges.",
      "timer_minutes": 1
    }
  ],
