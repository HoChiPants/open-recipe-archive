  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Line a baking sheet with aluminum foil."
    },
    {
      "step": 2,
      "text": "Brush the squash cut sides with olive oil and season with half the salt and pepper. Place cut-side down on the prepared sheet."
    },
    {
      "step": 3,
      "text": "Roast for 45 minutes, or until the squash is tender.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "While the squash roasts, cook the ground turkey in a skillet, seasoning it with some of the remaining pepper, until it reaches 165°F internally."
    },
    {
      "step": 5,
      "text": "Add the tomatoes, asparagus, onion, basil, garlic, oregano, and remaining salt and pepper. Stir in the chicken broth and cook until the asparagus is tender and the mixture is heated through.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Let the squash cool briefly. Scrape the flesh into strands with a fork, return the strands to the squash shells, and top with the turkey mixture."
    }
  ],
