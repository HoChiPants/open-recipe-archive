      "ingredient_id": "aluminum-foil",
      "item": "aluminum foil"
    },
    {
      "ingredient_id": "spaghetti-squash",
      "item": "spaghetti squash",
      "quantity": 1,
      "preparation": "halved and seeded"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "divided, or more to taste"
    },
