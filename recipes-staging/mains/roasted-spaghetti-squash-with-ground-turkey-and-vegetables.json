  "id": "roasted-spaghetti-squash-with-ground-turkey-and-vegetables",
  "name": "Roasted Spaghetti Squash with Ground Turkey and Vegetables",
  "subtitle": "Tender squash strands with a savory turkey and vegetable filling",
  "description": "Roast spaghetti squash until tender, then fill it with seasoned ground turkey, tomatoes, asparagus, onion, basil, and garlic.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
