  "id": "honey-garlic-chicken",
  "name": "Honey-Garlic Chicken",
  "subtitle": "Tender chicken in a sweet, savory, lightly spicy sauce",
  "description": "Cubed chicken breast is pressure-cooked with a honey-garlic sauce, then finished with green onions and sesame seeds.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
