  "instructions": [
    {
      "step": 1,
      "text": "Whisk honey, soy sauce, garlic, ketchup, and sriracha together; set aside."
    },
    {
      "step": 2,
      "text": "Coat the chicken cubes with cornstarch, then combine them with the chicken broth."
    },
    {
      "step": 3,
      "text": "Set the pressure cooker to sauté and heat the vegetable oil. Add the chicken mixture and sauté for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the prepared sauce, secure the lid, and pressure-cook for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Release pressure according to the cooker instructions, then verify that the thickest chicken pieces reach 165°F.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Transfer the chicken to a serving dish. Stir the sauce in the pot until smooth and slightly thickened, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Return the chicken to the sauce, garnish with green onions and sesame seeds, and serve."
    }
  ],
