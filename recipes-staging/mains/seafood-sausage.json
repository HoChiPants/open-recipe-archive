  "instructions": [
    {
      "step": 1,
      "text": "Melt 1 tablespoon butter in a skillet over medium heat. Add the shallot and sauté for 5 minutes; cool completely.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Combine the sole, salmon, shrimp, breadcrumbs, egg whites, egg, kosher salt, and cayenne in a food processor. Process until smooth, then mix in the cooled shallot and 2 tablespoons parsley."
    },
    {
      "step": 3,
      "text": "Shape the mixture into three compact sausages. Wrap each tightly and chill for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Bring a shallow pan of water to a gentle simmer. Add the wrapped sausages and simmer for 20 minutes, turning as needed. Remove and cool for 20 minutes, then chill until firm.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Unwrap the sausages and cut them into slices. Melt the remaining butter in a skillet and cook the slices for about 6 minutes, turning to brown both sides. Confirm the centers reach 160°F and the seafood is opaque.",
      "timer_minutes": 6
    },
    {
      "step": 6,
      "text": "Warm the lemon juice with 2 tablespoons water for 3 minutes. Whisk in the cold butter until melted, then add the remaining parsley and salt to taste. Spoon the sauce over the browned seafood sausages.",
      "timer_minutes": 3
    }
  ],
