  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Prepare the refrigerated pizza crust, shape it on a baking sheet, and bake for 7 minutes, until golden brown.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Cook the chicken until the thickest part reaches 165°F on a food thermometer. Let it rest briefly, then cut it into bite-size pieces."
    },
    {
      "step": 4,
      "text": "Spread the Ranch-style salad dressing over the warm crust."
    },
    {
      "step": 5,
      "text": "Top with the chicken, mozzarella, Cheddar, tomatoes, and green onions."
    },
    {
      "step": 6,
      "text": "Return the pizza to the oven and bake for 25 minutes, until the cheeses are melted.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Cut into portions and serve."
    }
  ],
