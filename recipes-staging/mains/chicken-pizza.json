  "id": "chicken-pizza",
  "name": "Chicken Pizza",
  "subtitle": "A ranch-dressed pizza with chicken, vegetables, and melted cheese",
  "description": "Par-bake the crust, add ranch dressing, chicken, vegetables, and cheeses, then bake until the topping is melted and golden.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
