      "item": "skinless",
      "quantity": 2,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "refrigerated-pizza-crust",
      "item": "refrigerated pizza crust",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce"
