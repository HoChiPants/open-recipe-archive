  "id": "creamy-chard-and-squash-tart",
  "name": "Creamy Chard and Squash Tart",
  "subtitle": "A savory tart layered with roasted squash, wilted chard, and rich mascarpone.",
  "description": "Buttery pastry holds sweetened shallots, thyme-roasted squash, chard, mascarpone, Parmesan, and hazelnuts. Serve warm with chicory salad.",
  "meal_type": "main",
