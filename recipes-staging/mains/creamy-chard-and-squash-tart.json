  ],
  "instructions": [
    {
      "step": 1,
      "text": "Chill the butter until firm. Rub the unsalted butter into the flour and salt until crumbly. Stir in the beaten egg mixture to form a dough, shape into a disc, wrap, and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Toss the squash with olive oil and half the thyme. Roast until tender, about 15 minutes, then set aside.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Melt the butter in a pan. Cook the shallots until softened, about 15 minutes. Add the sugar and vinegar; cook for 3 minutes, then cool.",
      "timer_minutes": 18
    },
    {
      "step": 4,
      "text": "Cook the chard with the remaining thyme for 3 minutes, until wilted. Drain and cool.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Mix the mascarpone, grated Parmesan, and hazelnuts. Heat the oven and roll the pastry out to line a tart tin. Trim the edge and prick the base."
    },
    {
      "step": 6,
      "text": "Spread the shallots over the pastry. Add the squash and chard, then spoon over the mascarpone mixture. Fold or crimp the pastry edge and brush it with the remaining beaten egg. Chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Bake for 40 minutes, until the pastry is golden and the center is firm and fully set; verify the egg-containing filling reaches 160°F.",
      "timer_minutes": 40
    },
    {
      "step": 8,
      "text": "Rest briefly, garnish with thyme sprigs, and serve with chicory salad."
    }
  ],
