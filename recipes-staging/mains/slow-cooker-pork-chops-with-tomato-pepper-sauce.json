  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a skillet over medium heat. Add the pork chops and brown sugar; cook for 5 minutes, turning once.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Place the browned pork chops in a slow cooker and arrange the sliced onion and green peppers around them."
    },
    {
      "step": 3,
      "text": "Whisk together the tomato sauce, apple cider vinegar, Worcestershire sauce, and salt. Pour the mixture over the pork and vegetables."
    },
    {
      "step": 4,
      "text": "Cover and cook on low for 6 hours 10 minutes, or until the pork is tender and reaches 145°F in the thickest part.",
      "timer_minutes": 370
    },
    {
      "step": 5,
      "text": "Transfer the pork chops to a plate and let them rest for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Whisk the cornstarch into the sauce in the slow cooker. Cook until the sauce thickens, then return the pork chops and coat them with the sauce."
    }
  ],
