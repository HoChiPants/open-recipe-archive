  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Melt half the butter in a large oven-safe skillet. Add the bacon, onion, garlic, and seasoning; cook until the onion softens, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the chicken, broccoli, cauliflower, mushrooms, leek, and chicken stock. Cook until the vegetables begin to soften and the chicken is nearly cooked through, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Transfer the skillet mixture to a baking dish and drain any excess stock."
    },
    {
      "step": 5,
      "text": "Melt the remaining butter in the skillet. Whisk in the heavy cream and cream cheese, then cook until smooth, about 3 minutes. Whisk in the Parmesan and Cheddar until melted, about 4 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 6,
      "text": "Pour the cheese sauce over the chicken and vegetables, then bake until bubbling, the cheese is melted, and the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 10
    }
  ],
