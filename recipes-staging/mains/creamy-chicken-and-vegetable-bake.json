  "id": "creamy-chicken-and-vegetable-bake",
  "name": "Creamy Chicken and Vegetable Bake",
  "subtitle": "Chicken, vegetables, bacon, and melted cheese in a rich baked sauce.",
  "description": "A hearty baked casserole combining cubed chicken with broccoli, cauliflower, mushrooms, leek, bacon, and a creamy cheese sauce.",
  "meal_type": "main",
  "cuisine": "American",
