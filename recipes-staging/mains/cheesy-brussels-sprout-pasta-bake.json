  "id": "cheesy-brussels-sprout-pasta-bake",
  "name": "Cheesy Brussels Sprout Pasta Bake",
  "subtitle": "Penne and roasted sprouts in a mustard-cheddar sauce",
  "description": "A straightforward baked pasta combining balsamic Brussels sprouts with a creamy cheddar sauce and a crisp, satisfying finish.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 45
  },
  "ingredients": [
    {
