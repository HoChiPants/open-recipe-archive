  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking dish. Toss the Brussels sprouts with the olive oil and balsamic vinegar, then bake for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Cook the penne in boiling water until set, then drain."
    },
    {
      "step": 3,
      "text": "Melt the butter in a saucepan. Add the crushed garlic and flour; cook for 2 minutes, stirring.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Gradually add the milk, stirring until smooth. Cook for 5 minutes, then stir in the mustard and grated cheddar until combined.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Mix the drained pasta and roasted sprouts with the sauce. Transfer to the baking dish and bake for 20 minutes, until bubbling and hot throughout.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Serve with the optional salad leaves."
    }
  ],
