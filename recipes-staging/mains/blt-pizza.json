  "id": "blt-pizza",
  "name": "BLT Pizza",
  "subtitle": "Crisp bacon, tomato, lettuce, and mozzarella on a baked crust",
  "description": "Bake a cheesy tomato pizza, then finish it with crisp bacon and creamy dressed lettuce for a simple BLT-inspired main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
