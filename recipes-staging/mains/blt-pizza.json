      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Cook the bacon in a skillet until crisp, then drain it and cut it into pieces."
    },
    {
      "step": 2,
      "text": "Unroll and shape the pizza crust dough on a baking sheet. Brush it with the olive oil, then add the mozzarella and chopped tomato."
    },
    {
      "step": 3,
      "text": "Bake for 15 minutes, or until the cheese is melted and the crust is baked through.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Toss the shredded lettuce with the mayonnaise, then season with salt and pepper."
    },
    {
      "step": 5,
      "text": "Cut the baked pizza into portions and top with the dressed lettuce and bacon."
    }
  ],
