  "id": "cabbage-potato-and-kielbasa-bake",
  "name": "Cabbage, Potato, and Kielbasa Bake",
  "subtitle": "A hearty baked casserole with tender vegetables and savory sausage.",
  "description": "Shredded cabbage, diced potatoes, and sliced smoked kielbasa are baked under an egg-and-milk mixture with bread and butter until tender and set.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
