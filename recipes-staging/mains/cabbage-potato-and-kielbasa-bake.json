      "unit": "cup",
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Prepare the small head of cabbage and shred it."
    },
    {
      "step": 2,
      "text": "Combine the shredded cabbage, diced potatoes, and sliced smoked kielbasa in a baking dish."
    },
    {
      "step": 3,
      "text": "Whisk together the milk, beaten eggs, salt, and ground black pepper until combined."
    },
    {
      "step": 4,
      "text": "Fold the cubed bread into the egg mixture and let it stand for 2 minutes, until set.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Pour the mixture over the cabbage, potato, and kielbasa mixture. Arrange the sliced butter over the top."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, or until the potatoes are tender and the casserole center is fully set. Confirm the sausage reaches 160°F with a food thermometer.",
      "timer_minutes": 45
    }
  ],
