  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Bring a large pot of water to a simmer, add the elbow macaroni, and cook for 8 minutes or until cooked through. Drain.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan. Whisk in the flour and cook for 2 minutes, then gradually whisk in the divided milk until smooth. Continue heating until thickened.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir in the smoked Gouda, Cheddar, Swiss, and 1 cup of Parmesan until melted and smooth. Fold in the drained macaroni."
    },
    {
      "step": 4,
      "text": "Transfer the macaroni mixture to a baking dish. Combine the remaining Parmesan, bread crumbs, cayenne, and enough olive oil to prepare the topping, then scatter it over the pasta."
    },
    {
      "step": 5,
      "text": "Bake at 350°F until hot and lightly browned. Let stand for 10 minutes before serving.",
      "timer_minutes": 40
    }
  ],
