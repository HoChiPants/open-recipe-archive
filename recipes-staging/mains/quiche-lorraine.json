  "instructions": [
    {
      "step": 1,
      "text": "Shape the 9-inch unbaked pie crust in a pie dish and chill it for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Preheat the oven to 425°F. Prepare the chilled crust for blind baking, then bake for 7 minutes. Remove any weights or covering and bake 5 minutes more, until golden brown.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Cook the bacon in a skillet for about 10 minutes, until cooked through. Drain it, reserving the bacon for the filling.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Cook the leeks and onion with salt, black pepper, and cayenne for about 7 minutes, until tender.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Reduce the oven temperature to 325°F. Whisk the eggs, egg yolks, heavy cream, and milk until smooth; stir in the thyme."
    },
    {
      "step": 6,
      "text": "Arrange the bacon, leek mixture, and Gruyere in the prepared crust. Pour the custard over the filling."
    },
    {
      "step": 7,
      "text": "Bake until the quiche is set and the center reaches 160°F on a food thermometer.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Cool briefly before slicing and serving."
    }
  ],
