  "id": "quiche-lorraine",
  "name": "Quiche Lorraine",
  "subtitle": "A savory custard tart with bacon, leeks, onion, and Gruyere",
  "description": "A crisp blind-baked pastry shell filled with smoky bacon, tender aromatics, cheese, and a thyme-scented cream custard.",
  "meal_type": "main",
  "cuisine": "American",
