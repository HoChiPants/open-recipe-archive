  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the potatoes, celery, carrot, and water in a saucepan. Simmer for 20 minutes, or until the vegetables are tender; drain.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Melt the 3 tablespoons butter in a skillet. Add the green bell pepper and onion and cook for 5 minutes, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Melt the 1/4 cup butter in a saucepan. Stir in the flour and cook for 3 minutes. Gradually add the milk, salt, and pepper; simmer for 2 minutes, until thickened.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the Cheddar until melted. Combine the sauce with the drained vegetables and ham, then transfer to a baking dish."
    },
    {
      "step": 6,
      "text": "Sprinkle the bread crumbs over the top. Bake for 30 minutes, until hot throughout and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Let the casserole stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
