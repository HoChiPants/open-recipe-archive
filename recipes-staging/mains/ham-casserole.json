  "id": "ham-casserole",
  "name": "Ham Casserole",
  "subtitle": "A creamy baked casserole with ham, vegetables, and cheddar",
  "description": "Tender potatoes, vegetables, and fully cooked ham are combined with cheddar sauce, topped with bread crumbs, and baked until hot and golden.",
