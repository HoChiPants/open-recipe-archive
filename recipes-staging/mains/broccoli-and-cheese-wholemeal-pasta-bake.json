  "instructions": [
    {
      "step": 1,
      "text": "Cook the pasta in boiling water until just tender. Add the broccoli for the final few minutes, then drain well and toss with the olive oil."
    },
    {
      "step": 2,
      "text": "Warm the milk with the bay leaf, then remove the bay leaf. Melt the butter, stir in the flour, and cook the mixture briefly until combined."
    },
    {
      "step": 3,
      "text": "Gradually whisk in the warm milk and cook for about 10 minutes, stirring, until thickened. Stir in the cheddar, mustard, and nutmeg.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Preheat the oven and transfer the pasta and broccoli to a baking dish. Pour over the cheese sauce and scatter the breadcrumbs on top."
    },
    {
      "step": 5,
      "text": "Bake for 35 minutes, or until the breadcrumbs are golden brown. Rest for 5 minutes before serving.",
      "timer_minutes": 40
    }
  ],
