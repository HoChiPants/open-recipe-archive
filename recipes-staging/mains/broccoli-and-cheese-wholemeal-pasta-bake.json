  "id": "broccoli-and-cheese-wholemeal-pasta-bake",
  "name": "Broccoli and Cheese Wholemeal Pasta Bake",
  "subtitle": "Wholemeal pasta and broccoli in a creamy cheddar sauce",
  "description": "A comforting vegetarian pasta bake finished with crisp brown breadcrumbs and baked until golden.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
