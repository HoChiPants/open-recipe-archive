  "instructions": [
    {
      "step": 1,
      "text": "Place the chopped sweet potatoes in a saucepan, cover with water, and simmer until tender, about 6 minutes. Drain well.",
      "timer_minutes": 6
    },
    {
      "step": 2,
      "text": "Preheat the oven or grill. Combine the sweet potatoes, tomatoes, curry powder, chili powder, ground cumin, and chili jam in a suitable baking dish."
    },
    {
      "step": 3,
      "text": "Stir in the coconut milk, spinach, green chile, and vegetable bouillon. Bring to a simmer and cook until the curry is hot and the spinach has wilted, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Arrange the sliced halloumi over the curry and cook under the preheated grill until lightly browned, about 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Stir in the drained chickpeas and cook for 5 minutes more. Serve hot.",
      "timer_minutes": 5
    }
  ],
