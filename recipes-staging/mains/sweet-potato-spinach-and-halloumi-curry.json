  "id": "sweet-potato-spinach-and-halloumi-curry",
  "name": "Sweet Potato, Spinach, and Halloumi Curry",
  "subtitle": "A creamy vegetable curry with golden halloumi",
  "description": "Tender sweet potatoes and chickpeas simmer with tomatoes, coconut milk, spinach, and warm spices, then are finished with sliced halloumi.",
  "meal_type": "main",
