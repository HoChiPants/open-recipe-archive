  "instructions": [
    {
      "step": 1,
      "text": "Transfer the warm water to a mixing bowl. Stir in the active dry yeast and white sugar, then let stand briefly until combined."
    },
    {
      "step": 2,
      "text": "Add the bread flour, 2 teaspoons of the olive oil, and kosher salt. Mix into a dough and knead until smooth."
    },
    {
      "step": 3,
      "text": "Coat a deep rectangular baking pan with the remaining olive oil. Place the dough in the pan and press it outward toward the corners. Let it rest until puffy.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Combine the marinara sauce, dried oregano, red pepper flakes, and garlic powder in a saucepan. Bring to a simmer and cook until seasoned and slightly thickened.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Preheat the oven to 525°F."
    },
    {
      "step": 6,
      "text": "Combine the Monterey Jack cheese and mild Cheddar cheese. Arrange the thick pepperoni slices in the prepared pan, then spread the cheese over the dough, reaching the edges."
    },
    {
      "step": 7,
      "text": "Spoon the marinara sauce over the cheese and finish with the remaining red pepper flakes and thick pepperoni slices."
    },
    {
      "step": 8,
      "text": "Bake until the crust is cooked through and the cheese is golden brown.",
      "timer_minutes": 15
    },
    {
      "step": 9,
      "text": "Cool in the pan for 5 minutes, then loosen the pizza, cut it into portions, and serve.",
      "timer_minutes": 5
    }
  ],
