  "id": "detroit-style-pizza",
  "name": "Detroit-Style Pizza",
  "subtitle": "Crisp-edged pan pizza with pepperoni and layered cheese",
  "description": "A thick, airy pizza baked in an oiled pan until the cheese is deeply golden around the edges, then finished with seasoned marinara and pepperoni.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 9,
