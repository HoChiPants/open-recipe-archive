  "id": "chicken-eggplant-stir-fry",
  "name": "Chicken Eggplant Stir-Fry",
  "subtitle": "Tender chicken and vegetables in a savory skillet dish",
  "description": "Salted eggplant, chicken, mushrooms, spinach, garlic, and soy sauce come together in a quick, balanced stir-fry.",
  "meal_type": "main",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
