      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "mushrooms",
      "item": "mushrooms",
