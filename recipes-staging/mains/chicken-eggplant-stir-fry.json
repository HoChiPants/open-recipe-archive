      "item": "spinach",
      "quantity": 4,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Toss the eggplant rounds with the salt and let them rest for 5 minutes. Pat dry if needed.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Heat the canola oil in a large skillet over medium-high heat. Cook the eggplant until lightly browned, then transfer it to a plate."
    },
    {
      "step": 3,
      "text": "Add the cubed chicken, garlic, and soy sauce to the skillet. Stir-fry until the chicken is cooked through and reaches 165°F in the thickest pieces.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the mushrooms and black pepper. Cook, stirring, until the mushrooms are tender.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Return the eggplant to the skillet and add the spinach. Stir until the spinach is wilted and everything is heated through.",
      "timer_minutes": 3
    }
  ],
