  "id": "mushroom-and-black-bean-quesadillas",
  "name": "Mushroom and Black Bean Quesadillas",
  "subtitle": "Sautéed mushrooms, beans, and mozzarella in crisp tortillas",
  "description": "A quick vegetarian quesadilla filling with tender mushrooms, seasoned black beans, cilantro, lime, and melted mozzarella, served with salsa.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fresh-mushrooms",
      "item": "fresh mushrooms",
      "quantity": 1,
      "unit": "cup",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "and-drained-canned-black-beans",
      "item": "and drained canned black beans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "rinsed"
    },
    {
      "ingredient_id": "fresh-cilantro",
      "item": "fresh cilantro",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "wheat-tortillas",
      "item": "wheat tortillas",
      "quantity": 2,
      "unit": "whole"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "lime-juice",
      "item": "lime juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salsa",
      "item": "salsa",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a skillet over medium heat. Add the mushrooms and onion and cook until lightly browned.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Stir in the and drained canned black beans, cilantro, salt and pepper. Sauté for 3 minutes, then transfer the filling to a bowl.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Warm the skillet again over medium heat. Place one wheat tortilla in the skillet and spread half the filling over one side. Top with half the mozzarella and drizzle with half the lime juice.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Fold the tortilla over the filling and cook until the underside is golden and the cheese melts. Transfer to a plate and repeat with the remaining tortilla and filling.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Cut the quesadillas into wedges and serve with salsa."
    }
  ],
