  "instructions": [
    {
      "step": 1,
      "text": "Combine the garlic, chile sauce, maple syrup, soy sauce, mayonnaise, rice vinegar, salt, and pepper in a bowl; stir until smooth."
    },
    {
      "step": 2,
      "text": "Add the chicken thighs and turn to coat. Cover and chill for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Let the chicken stand at room temperature for 30 minutes, then season with additional salt and pepper if needed.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Preheat a grill to medium-high heat."
    },
    {
      "step": 5,
      "text": "Grill the chicken for about 20 minutes, turning as needed, until golden brown and the thickest pieces reach 165°F.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Transfer the chicken to a serving platter and rest for 5 minutes. Serve with the lime wedges.",
      "timer_minutes": 5
    }
  ],
