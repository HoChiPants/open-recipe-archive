  "id": "grilled-chile-maple-chicken-thighs",
  "name": "Grilled Chile-Maple Chicken Thighs",
  "subtitle": "Sweet, tangy, and lightly spicy grilled chicken",
  "description": "Chicken thighs marinated in a maple-chile mixture, then grilled until browned and fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
