{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pan-fried-pork-chops",
  "name": "Pan-Fried Pork Chops",
  "subtitle": "Flour-dusted pork chops cooked in a skillet",
  "description": "Seasoned boneless pork chops are lightly coated with flour, pan-fried until browned, and rested before serving.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "boneless-pork-chops",
      "item": "boneless pork chops",
      "quantity": 4,
      "preparation": "3/4-inch thick"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cooking-oil",
      "item": "cooking oil",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the pork chops with salt and freshly ground black pepper. Lightly dredge them in the flour, shaking off excess."
    },
    {
      "step": 2,
      "text": "Heat the cooking oil in a skillet over medium-high heat until shimmering."
    },
    {
      "step": 3,
      "text": "Add the pork chops and cook until browned, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Turn the chops and cook until browned on the second side and the thickest part reaches 145°F on a food thermometer.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Transfer the chops to a plate and rest for 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
  "tags": [
    "dinner",
    "american"
  ],
