  "ingredients": [
    {
      "ingredient_id": "4-ounce-skinless",
      "item": "(4 ounce) skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1.5,
      "unit": "tablespoons",
      "preparation": "minced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "poultry-seasoning",
      "item": "poultry seasoning",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "artificial-sweetener",
      "item": "artificial sweetener",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Place the chicken breasts in a baking dish."
    },
    {
      "step": 3,
      "text": "Combine the onion, garlic, poultry seasoning, soy sauce, and artificial sweetener, then spoon the mixture over the chicken."
    },
    {
      "step": 4,
      "text": "Bake at 425°F until the thickest part of each breast reaches 165°F on a food thermometer."
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
  ],
