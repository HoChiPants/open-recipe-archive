  "id": "low-cal-chicken",
  "name": "Low-Cal Chicken",
  "subtitle": "Savory baked chicken with garlic and soy",
  "description": "Chicken breasts are seasoned with a savory soy-garlic mixture and baked until fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
