  "id": "slow-cooker-beef-stroganoff",
  "name": "Slow-Cooker Beef Stroganoff",
  "subtitle": "Tender beef and mushrooms in a creamy sauce with fusilli",
  "description": "A hearty slow-cooked beef and mushroom dish finished with a creamy sauce and served over fusilli pasta.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "beef-stew-meat",
      "item": "beef stew meat",
      "quantity": 1.3333333730698,
      "unit": "pounds",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "fresh-mushrooms",
      "item": "fresh mushrooms",
      "quantity": 2,
      "unit": "cups",
      "preparation": "thickly sliced"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "herb-and-garlic-flavored-cream-cheese",
      "item": "herb and garlic-flavored cream cheese",
      "quantity": 6,
      "unit": "ounces"
    },
    {
      "ingredient_id": "fusilli-pasta",
      "item": "fusilli pasta",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the beef, mushrooms, condensed soup, milk, onions, Worcestershire sauce, cream cheese, and sour cream in a slow cooker. Stir to combine."
    },
    {
      "step": 2,
      "text": "Cover and cook for 240 minutes, until the beef is tender and reaches at least 145°F internally; rest it for 3 minutes before serving.",
      "timer_minutes": 240
    },
    {
      "step": 3,
      "text": "Whisk the sauce until the cream cheese and sour cream are evenly incorporated. Continue cooking for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Simmer the mixture for 20 minutes while preparing the pasta.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Cook the fusilli in boiling water for 12 minutes, or until tender. Drain well.",
      "timer_minutes": 12
    },
    {
      "step": 6,
      "text": "Whisk the drained pasta into the creamy beef mixture and serve."
    }
  ],
