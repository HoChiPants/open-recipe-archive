  "instructions": [
    {
      "step": 1,
      "text": "Heat the sunflower oil in a large skillet over medium heat. Add the onion and brown sugar; cook until softened and lightly caramelized.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the minced garlic, oregano, cumin seeds, chipotle paste, and garlic clove. Cook briefly until fragrant."
    },
    {
      "step": 3,
      "text": "Add the vinegar, chopped tomatoes, and stock. Stir in the black beans and simmer until the sauce thickens.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the shredded turkey and heat thoroughly until steaming, reaching 165°F in the thickest portion."
    },
    {
      "step": 5,
      "text": "Blend or mash the avocados with the lime zest and juice, cumin seeds, and garlic clove until smooth."
    },
    {
      "step": 6,
      "text": "Serve the tinga with tortilla chips or flour tortillas, cooked rice, coriander, feta, chopped red onion, and lime wedges."
    }
  ],
