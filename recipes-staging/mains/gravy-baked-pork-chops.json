{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "gravy-baked-pork-chops",
  "name": "Gravy Baked Pork Chops",
  "subtitle": "Tender pork chops in creamy mushroom gravy",
  "description": "Brown thick pork chops, cover them with a simple mushroom gravy, and bake until safely cooked through.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "1-1-4-inch-thick-pork-chops",
      "item": "(1 1/4 inch thick) pork chops",
      "quantity": 4
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Season the pork chops with salt and pepper."
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet over medium heat. Add the pork chops and cook for 5 minutes, turning as needed to brown them.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir together the milk, water, and condensed cream of mushroom soup."
    },
    {
      "step": 5,
      "text": "Place the browned pork chops in a baking dish and pour the soup mixture over them."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, or until the center of the pork reaches 145°F. Let the chops rest for 3 minutes before serving.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Serve the pork chops with the gravy."
    }
  ],
