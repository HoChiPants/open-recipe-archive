      "item": "freshly grated Parmesan cheese",
      "quantity": 4,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the spaghetti in simmering water until tender, then drain."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet. Add the crushed garlic and stir for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the fine bread crumbs and cook, stirring, until crisp and golden, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the chopped parsley and black pepper."
    },
    {
      "step": 5,
      "text": "Combine the drained spaghetti with the garlic oil, bread-crumb mixture, anchovy fillets, and Parmesan. Heat the anchovy mixture to 145°F."
    },
    {
      "step": 6,
      "text": "Serve immediately."
    }
  ],
