  "id": "anchovy-pasta",
  "name": "Anchovy Pasta",
  "subtitle": "Garlic pasta with crisp crumbs and Parmesan",
  "description": "Spaghetti is coated with garlic-infused oil, savory anchovies, parsley, Parmesan, and toasted bread crumbs.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 8,
