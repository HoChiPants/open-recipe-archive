  "id": "bread-crusted-seared-yellowfin-tuna",
  "name": "Bread-Crusted Seared Yellowfin Tuna",
  "subtitle": "Crisp seasoned coating with a quick sear",
  "description": "Yellowfin tuna portions are seasoned, coated in breadcrumbs, and quickly seared in olive oil for a crisp exterior.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "sashimi-grade-yellowfin-tuna",
      "item": "sashimi grade yellowfin tuna",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "kosher-salt-to-taste",
      "item": "kosher salt to taste"
    },
    {
      "ingredient_id": "fresh-ground-black-pepper-to-taste",
      "item": "fresh ground black pepper to taste"
    },
    {
      "ingredient_id": "italian-seasoned-bread-crumbs",
      "item": "Italian seasoned bread crumbs",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the tuna into four portions, then shape them into evenly thick pieces."
    },
    {
      "step": 2,
      "text": "Season all sides with kosher salt and fresh ground black pepper, then coat evenly with the Italian seasoned bread crumbs."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a skillet over medium-high heat until shimmering."
    },
    {
      "step": 4,
      "text": "Sear the tuna for about 1 minute per side, turning to brown the remaining sides. Cook until the center reaches 145°F, or until the fish is opaque and flakes easily.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Transfer to a cutting board, rest briefly, and slice into thick pieces before serving."
    }
  ],
