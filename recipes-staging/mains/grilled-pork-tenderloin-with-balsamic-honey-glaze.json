  "instructions": [
    {
      "step": 1,
      "text": "Mix the garlic powder, onion powder, chili powder, paprika, and salt. Pat the pork dry and coat it with the seasoning mixture."
    },
    {
      "step": 2,
      "text": "Heat half of the olive oil in a skillet over medium-high heat. Brown the pork on all sides, about 2 minutes total.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Preheat the grill. Transfer the pork to the grill and cook, turning as needed, for about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Stir together the remaining olive oil, balsamic vinegar, honey, and Dijon mustard. Brush the glaze over the pork and continue grilling until a thermometer inserted into the thickest part reads 145°F.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Remove the pork from the grill and let it rest for at least 3 minutes before slicing.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Slice and serve with any remaining glaze."
    }
  ],
