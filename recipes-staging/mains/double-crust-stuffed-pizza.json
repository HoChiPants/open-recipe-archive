  "instructions": [
    {
      "step": 1,
      "text": "Stir the white sugar and brown sugar into the warm water. Sprinkle in the yeast and let the mixture stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mix in the tablespoon of olive oil, then add the salt and flour. Knead until the dough is smooth, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Coat the dough lightly with the teaspoon of olive oil, place it in a bowl, and let it rise until doubled, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Combine the crushed tomatoes, remaining brown sugar, garlic powder, remaining salt, and remaining olive oil. Cook the sauce for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Heat the oven to 450°F and prepare a baking pan."
    },
    {
      "step": 6,
      "text": "Divide the risen dough and shape one portion to cover the bottom and sides of the pan. Shape the other portion into a top crust."
    },
    {
      "step": 7,
      "text": "Cover the base with some of the mozzarella, then distribute the sausage, pepperoni, mushrooms, and bell peppers over it. Add the remaining mozzarella and spoon the tomato sauce over the filling."
    },
    {
      "step": 8,
      "text": "Place the second crust over the filling, seal the edges, and cut vents in the top. Bake for about 45 minutes, until set and the sausage reaches 160°F in the center.",
      "timer_minutes": 45
    },
    {
      "step": 9,
      "text": "Let the pizza stand for 15 minutes before slicing.",
      "timer_minutes": 15
    }
  ],
