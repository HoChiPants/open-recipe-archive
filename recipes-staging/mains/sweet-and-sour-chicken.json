  "id": "sweet-and-sour-chicken",
  "name": "Sweet and Sour Chicken",
  "subtitle": "Tangy baked chicken with a balanced sweet glaze",
  "description": "Chicken breast halves rest in a soy-vinegar sauce flavored with ginger and garlic, then bake until tender and safely cooked.",
  "meal_type": "main",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 4,
