  "instructions": [
    {
      "step": 1,
      "text": "Whisk the soy sauce, sugar, vinegar, cornstarch, water, ginger, garlic, and pepper until evenly combined."
    },
    {
      "step": 2,
      "text": "Place the chicken in a baking dish and transfer the sauce over it, turning the pieces to coat."
    },
    {
      "step": 3,
      "text": "Cover and refrigerate for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Heat the oven to 325°F."
    },
    {
      "step": 5,
      "text": "Bake the chicken for 40 minutes, until the thickest portion reaches 165°F on a food thermometer.",
      "timer_minutes": 40
    }
  ],
