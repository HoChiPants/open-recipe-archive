  "instructions": [
    {
      "step": 1,
      "text": "Stir together the barbecue sauce, teriyaki sauce, beer, garlic, ginger, onion, pepper, and salt. Add the roast, coat well, cover, and refrigerate for 6 hours.",
      "timer_minutes": 360
    },
    {
      "step": 2,
      "text": "Transfer the roast and marinade to a roasting pan. Preheat the oven and bring the marinade to a simmer in a saucepan for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Return the simmered sauce to the pan, cover the roast, and roast until the thickest part reaches 145°F on a food thermometer.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Rest the roast for 3 minutes, then slice and serve with the sauce.",
      "timer_minutes": 3
    }
  ],
