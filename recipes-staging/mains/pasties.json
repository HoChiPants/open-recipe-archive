  "id": "pasties",
  "name": "Pasties",
  "subtitle": "Hand pies filled with beef and root vegetables",
  "description": "Tender pastry surrounds seasoned steak, potatoes, onion, carrot, and rutabaga for a hearty baked main dish.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
