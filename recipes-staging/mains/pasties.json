  "instructions": [
    {
      "step": 1,
      "text": "Combine the sifted flour and 1.5 teaspoons salt. Cut in the shortening until the mixture is crumbly, then stir in the cold water to form a dough."
    },
    {
      "step": 2,
      "text": "Shape the dough into a disk, cover, and chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 4,
      "text": "Combine the steak, potatoes, onion, carrot, rutabaga, and salt and pepper."
    },
    {
      "step": 5,
      "text": "Divide the dough into six portions and roll each into a round on a lightly floured surface."
    },
    {
      "step": 6,
      "text": "Place the filling on one side of each round and top each portion with 1 tablespoon margarine."
    },
    {
      "step": 7,
      "text": "Fold the dough over the filling and seal the edges firmly. Transfer the pasties to a baking sheet."
    },
    {
      "step": 8,
      "text": "Bake for 60 minutes, or until the vegetables are tender and the beef reaches 145°F in the center. Rest for 3 minutes before serving.",
      "timer_minutes": 60
    }
  ],
