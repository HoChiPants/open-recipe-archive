  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir together the soy sauce, honey, garlic, and dry mustard. Add the pork and turn to coat. Cover and refrigerate for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Preheat the grill to medium-high heat. Remove the pork from the marinade and arrange the pieces for grilling."
    },
    {
      "step": 3,
      "text": "Grill the pork for about 5 minutes per side, turning once, until the center reaches 145°F on a food thermometer.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Rest the pork for 3 minutes before serving."
    }
  ],
