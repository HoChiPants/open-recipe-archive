  "id": "grilled-pork-tenderloin",
  "name": "Grilled Pork Tenderloin",
  "subtitle": "Honey-soy pork with garlic and mustard",
  "description": "Pork tenderloin pieces marinated in a savory-sweet mixture and grilled until safely cooked.",
