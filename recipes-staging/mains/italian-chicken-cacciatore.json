  "instructions": [
    {
      "step": 1,
      "text": "Heat half the olive oil in a large skillet or Dutch oven over medium heat. Add the onion and cook until softened, about 5 minutes. Transfer the onion to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Combine the flour, measured salt, measured pepper, and the salt and ground black pepper to taste. Coat the chicken thighs evenly in the mixture."
    },
    {
      "step": 3,
      "text": "Heat the remaining olive oil in the skillet. Brown the chicken for about 5 minutes, turning as needed, then transfer it to the plate.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Pour in the wine and add the sugar, scraping up browned bits. Bring to a simmer."
    },
    {
      "step": 5,
      "text": "Stir in the tomatoes and tomato paste; season with additional salt and pepper to taste."
    },
    {
      "step": 6,
      "text": "Return the onion and chicken to the skillet and add the broth, using more as needed to keep the sauce loose. Cover and simmer until the chicken reaches 165°F internally and the sauce thickens, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Stir in the olives, parsley, and basil. Serve hot."
    }
  ],
