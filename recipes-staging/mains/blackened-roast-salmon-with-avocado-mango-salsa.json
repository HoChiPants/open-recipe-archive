  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Mix the paprika, oregano, cayenne, brown sugar, crushed garlic, lime zest, lime juice, and 2 tablespoons of the oil into a seasoning paste."
    },
    {
      "step": 2,
      "text": "Toss the peppers and onions with the remaining oil, spread in a roasting pan, and roast for 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Stir the drained black beans into the roasted vegetables. Coat the salmon with the seasoning paste and place it on top."
    },
    {
      "step": 4,
      "text": "Roast for 25 minutes, or until the thickest part reaches 145°F and the fish is opaque and flakes easily.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Dice the avocados and mango, then combine them with the chopped chili, coriander, and any remaining lime juice."
    },
    {
      "step": 6,
      "text": "Serve the salmon with the roasted vegetables, beans, and avocado-mango salsa, with lime wedges alongside."
    }
  ],
