      "item": "olive oil",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "white-onion",
      "item": "white onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "sliced into rings"
    },
    {
