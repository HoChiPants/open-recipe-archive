  "id": "lentils-and-rice-with-fried-onions",
  "name": "Lentils and Rice with Fried Onions",
  "subtitle": "A savory one-pot meal with crisp onion rings",
  "description": "Tender lentils and long-grain rice are paired with deeply browned onions and a cool yogurt or sour cream topping.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
