      "item": "plain yogurt or sour cream",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. Add the onion rings and cook, stirring occasionally, until well browned, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Transfer the lentils to the pot and season with salt and pepper. Cover and cook for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Stir in the rice and adjust the seasoning. Cover and simmer until the lentils and rice are tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Top the lentils and rice with the fried onions. Whisk the onion juices with the yogurt or sour cream, then serve alongside."
    }
  ],
