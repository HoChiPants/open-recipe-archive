{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "layered-chicken-and-black-bean-enchilada-casserole",
  "name": "Layered Chicken and Black Bean Enchilada Casserole",
  "subtitle": "A saucy, cheesy tortilla casserole for an easy shared meal",
  "description": "Seasoned chicken, black beans, green chiles, tortillas, enchilada sauce, and a creamy cheese topping are baked into a layered casserole.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-breast-meat",
      "item": "chicken breast meat",
      "quantity": 2,
      "unit": "cups",
      "preparation": "diced"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-coriander",
      "item": "ground coriander",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "black-beans",
      "item": "black beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, rinsed and drained"
    },
    {
      "ingredient_id": "green-chile-peppers",
      "item": "green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "4.5 ounce, diced, drained"
    },
    {
      "ingredient_id": "fresh-cilantro",
      "item": "fresh cilantro",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "red-enchilada-sauce",
      "item": "red enchilada sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "6-inch-corn-tortillas",
      "item": "(6 inch) corn tortillas",
      "quantity": 8
    },
    {
      "ingredient_id": "mexican-blend-cheese",
      "item": "Mexican blend cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "8-ounce-container-sour-cream",
      "item": "(8 ounce) container sour cream",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F and lightly coat a baking dish with the cooking spray or coating specified for the dish."
    },
    {
      "step": 2,
      "text": "Cook the diced chicken with the cumin and coriander until no longer pink and it reaches 165°F in the thickest pieces. Transfer the chicken to a bowl."
    },
    {
      "step": 3,
      "text": "Stir the black beans, green chiles, and cilantro into the chicken."
    },
    {
      "step": 4,
      "text": "Spread some enchilada sauce in the baking dish. Arrange tortillas over the sauce, then add part of the chicken mixture and repeat the layers, finishing with sauce."
    },
    {
      "step": 5,
      "text": "Whisk the shredded cheese and sour cream together, then spread the mixture over the casserole."
    },
    {
      "step": 6,
      "text": "Bake uncovered until heated through and bubbling, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Let the casserole rest for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
