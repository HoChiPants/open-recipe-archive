  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Simmer the tomatoes, garlic, basil, salt, and pepper together to make the sauce."
    },
    {
      "step": 3,
      "text": "Blend the ricotta and egg for 10 minutes, then combine the mixture with the mozzarella and Parmesan.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Spread sauce over the bottom of a baking dish. Add noodles, ricotta mixture, carrots, spinach, and mozzarella in layers, repeating as needed."
    },
    {
      "step": 5,
      "text": "Finish with noodles, sauce, and the remaining cheese mixture and mozzarella."
    },
    {
      "step": 6,
      "text": "Cover and bake for 30 minutes. Uncover and bake for 10 minutes more, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Let the lasagna rest for 15 minutes before serving.",
      "timer_minutes": 15
    }
  ],
