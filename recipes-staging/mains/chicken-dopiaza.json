  "instructions": [
    {
      "step": 1,
      "text": "Combine the chicken with the grated ginger, garlic, yogurt, turmeric, and freshly ground pepper."
    },
    {
      "step": 2,
      "text": "Heat the ghee in a heavy pot over medium heat. Add the star anise, black and green cardamom, cumin, coriander seeds, peppercorns, dried chillies, bay leaf, and cinnamon; cook briefly until aromatic.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the onions and cook until softened and lightly browned.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Add the chicken and turn to coat in the spiced onions. Cover and cook until the thickest pieces reach 165°F and the chicken is cooked through.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Stir in the chopped coriander, green chilli, and garam masala. Finish with lime juice and garnish with the reserved ginger strips before serving."
    }
  ],
