  "id": "potato-and-cheese-pierogi-0c7d1c4b",
  "name": "Potato and Cheese Pierogi",
  "subtitle": "Tender dumplings with a savory potato-cheese filling",
  "description": "Make a simple egg dough, fill it with seasoned potatoes and cheese, then simmer the dumplings until cooked through.",
  "meal_type": "main",
  "cuisine": "Ukrainian",
  "yield": {
    "quantity": 60,
    "unit": "servings"
  },
