      "unit": "pinch"
    },
    {
      "ingredient_id": "water-as-needed",
      "item": "water as needed"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 5,
      "unit": "pounds",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "processed-cheese",
      "item": "processed cheese",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "onion-salt-to-taste",
      "item": "onion salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring water to a simmer with salt, pepper, and onion salt. Add the peeled potatoes and cook for 15 minutes, or until tender. Drain well.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Combine the flour, eggs, pinch of salt, pepper, and onion salt. Add water as needed to form a workable dough."
    },
    {
      "step": 3,
      "text": "Roll the dough out thick and prepare it for filling."
    },
    {
      "step": 4,
      "text": "Combine the drained potatoes with the cubed processed cheese and season with salt, pepper, and onion salt. Mash or mix until combined."
    },
    {
      "step": 5,
      "text": "Place filling portions on the dough, fold over, and seal the edges to form pierogi."
    },
    {
      "step": 6,
      "text": "Simmer the pierogi in water, stirring gently so they do not stick, until cooked through and they rise to the surface. Remove with a slotted spoon.",
      "timer_minutes": 10
    }
  ],
