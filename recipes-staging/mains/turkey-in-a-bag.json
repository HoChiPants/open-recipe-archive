  "id": "turkey-in-a-bag",
  "name": "Turkey in a Bag",
  "subtitle": "A straightforward oven-roasted turkey with celery and onion",
  "description": "Seasoned turkey roasts in a flour-dusted roasting bag with celery and onion for a simple holiday-style main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
