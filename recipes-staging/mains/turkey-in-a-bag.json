  "ingredients": [
    {
      "ingredient_id": "12-pound-whole-turkey",
      "item": "(12 pound) whole turkey",
      "quantity": 1
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "stalks-celery",
      "item": "stalks celery",
      "quantity": 5,
      "preparation": "cut into 1-inch pieces"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
