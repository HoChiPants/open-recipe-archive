    {
      "ingredient_id": "turkey-bag",
      "item": "turkey bag",
      "quantity": 1,
      "unit": "large"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Prepare the turkey bag according to its use instructions, add the flour, and shake to coat the inside. Place the bag in a roasting pan."
    },
    {
      "step": 3,
      "text": "Season the turkey with salt and ground black pepper, then place it in the floured bag. Add the celery and onions."
    },
    {
      "step": 4,
      "text": "Secure the bag as directed and transfer the pan to the oven."
    },
    {
      "step": 5,
      "text": "Bake for 120 minutes, then continue baking until the thickest part of the turkey reaches 165°F on a food thermometer, about 180 minutes total.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Remove the pan from the oven and prepare the turkey for serving according to the bag instructions."
    }
  ],
