  "instructions": [
    {
      "step": 1,
      "text": "Preheat a skillet over medium heat and add the olive oil."
    },
    {
      "step": 2,
      "text": "Add the chicken, frozen corn, sliced red bell pepper, salt, and black pepper. Stir for 5 minutes, until the pepper is tender and the chicken is hot throughout; if reheating poultry, verify it reaches 165°F.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Divide the cooked brown rice between two bowls."
    },
    {
      "step": 4,
      "text": "Top with the chicken mixture, salsa, and shredded Monterey Jack cheese."
    }
