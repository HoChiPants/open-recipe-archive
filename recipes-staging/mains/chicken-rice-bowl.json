  "id": "chicken-rice-bowl",
  "name": "Chicken Rice Bowl",
  "subtitle": "Warm chicken, vegetables, rice, salsa, and melted cheese",
  "description": "A quick bowl layered with seasoned chicken, sweet corn, crisp pepper, brown rice, salsa, and Monterey Jack.",
