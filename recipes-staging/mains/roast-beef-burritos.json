  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven for baking the assembled burritos."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a skillet. Add the onion and garlic and cook for 5 minutes, stirring, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the tomatoes, roast beef, prepared taco sauce, green chile peppers, cumin, and red pepper flakes. Simmer until the mixture thickens, about 25 minutes. If reheating the cooked beef, ensure the filling reaches 165°F.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Place the warmed flour tortillas on a work surface. Divide the beef mixture among them, then add the Cheddar cheese and lettuce."
    },
    {
      "step": 5,
      "text": "Fold in the sides and roll each tortilla into a burrito. Arrange the burritos for baking and heat until warmed through."
    }
  ],
