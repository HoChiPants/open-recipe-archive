  "instructions": [
    {
      "step": 1,
      "text": "Mix the turmeric, curry powder, smoked paprika, tomato purée, yogurt, oil, crushed garlic, and lemon juice in a bowl."
    },
    {
      "step": 2,
      "text": "Add the chicken and red onion, coat well, cover, and marinate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Thread the chicken, peppers, and onion onto skewers. Brush lightly with oil."
    },
    {
      "step": 4,
      "text": "Preheat the grill to medium-high. Grill the kebabs for about 15 minutes, turning regularly, until browned and the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Warm the flatbreads or pittas, then fill with the kebabs, lettuce, yogurt, chili sauce, and lemon wedges."
    }
  ],
