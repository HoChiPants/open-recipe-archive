  "id": "spinach-blue-cheese-and-bacon-stuffed-chicken",
  "name": "Spinach, Blue Cheese, and Bacon Stuffed Chicken",
  "subtitle": "Tender chicken filled with savory spinach, cheese, and bacon",
  "description": "Chicken breasts are filled with spinach, blue cheese, and bacon, lightly seasoned, coated in flour, and baked until fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 8
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves - pounded to 1/2 inch thickness"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed and squeezed dry"
    },
    {
      "ingredient_id": "crumbled-blue-cheese",
      "item": "crumbled blue cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Combine the spinach and blue cheese, then mix in the bacon until evenly distributed."
    },
    {
      "step": 2,
      "text": "Place the chicken breasts on a work surface. Divide the filling among them, fold the chicken over the filling, and secure as needed."
    },
    {
      "step": 3,
      "text": "Combine the flour, pepper, and salt in a shallow dish. Coat the stuffed chicken on all sides."
    },
    {
      "step": 4,
      "text": "Heat the olive oil in an oven-safe skillet over medium heat. Add the chicken and cook briefly until lightly browned."
    },
    {
      "step": 5,
      "text": "Transfer the skillet to the oven and bake for about 30 minutes, until the thickest part of each breast reaches 165°F.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Let the chicken rest briefly, then serve."
    }
  ],
