  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Coat the chicken thighs and drumsticks with the salt, black pepper, paprika, and chicken stock."
    },
    {
      "step": 3,
      "text": "Melt the salted butter in an oven-safe skillet over medium-high heat. Add the chicken and its stock, and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Transfer the chicken and stock to a plate. Add the thyme and garlic to the skillet; cook for 1 minute, until the garlic is lightly browned.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Whisk in the flour until thick. Gradually whisk in the white wine, chicken stock, lemon juice, and heavy cream; cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir in the Parmesan until melted, then return the chicken and stock to the skillet."
    },
    {
      "step": 7,
      "text": "Bake for 30 minutes, or until the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
