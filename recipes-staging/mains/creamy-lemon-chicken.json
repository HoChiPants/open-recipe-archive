  "id": "creamy-lemon-chicken",
  "name": "Creamy Lemon Chicken",
  "subtitle": "Thyme chicken with a bright Parmesan cream sauce",
  "description": "Seasoned chicken thighs and drumsticks are browned, then baked in a lemony Parmesan cream sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
