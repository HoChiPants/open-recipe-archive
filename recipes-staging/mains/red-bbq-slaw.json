  "ingredients": [
    {
      "ingredient_id": "finely-shredded-cabbage",
      "item": "finely shredded cabbage",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "apple-cider-vinegar",
      "item": "apple cider vinegar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
