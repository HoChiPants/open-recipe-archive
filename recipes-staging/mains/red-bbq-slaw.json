  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the shredded cabbage in a large bowl."
    },
    {
      "step": 2,
      "text": "Whisk the vinegar, ketchup, sugar, red pepper flakes, and hot pepper sauce together in a separate bowl."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the cabbage and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Cover and refrigerate for 60 minutes before serving.",
      "timer_minutes": 60
    }
