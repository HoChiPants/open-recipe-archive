  "id": "red-bbq-slaw",
  "name": "Red BBQ Slaw",
  "subtitle": "Tangy cabbage slaw with a spicy-sweet dressing",
  "description": "A crisp cabbage slaw tossed with vinegar, ketchup, sugar, and adjustable heat, then chilled for better flavor.",
  "meal_type": "main",
