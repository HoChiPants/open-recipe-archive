  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 300°F. Place the pork roast in a roasting pan and roast for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Transfer the roast as needed. Stir together the honey, Dijon mustard, black pepper, crushed dried thyme, and salt."
    },
    {
      "step": 3,
      "text": "Coat the pork with the honey-mustard mixture and return it to the pan."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, or until a thermometer inserted into the thickest part registers 145°F.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Rest the roast for 15 minutes before slicing; the rest exceeds the required 3-minute rest for whole-cut pork.",
      "timer_minutes": 15
    }
  ],
