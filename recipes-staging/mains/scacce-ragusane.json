  "id": "scacce-ragusane",
  "name": "Scacce Ragusane",
  "subtitle": "Semolina flatbread layered with tomato, basil, and provolone",
  "description": "A folded Sicilian-style stuffed flatbread with a crisp semolina crust and savory tomato-cheese filling.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20,
    "inactive_minutes": 175
  },
  "ingredients": [
    {
      "ingredient_id": "warm-water",
      "item": "warm water",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
