      "unit": "teaspoons"
    },
    {
      "ingredient_id": "cornmeal",
      "item": "cornmeal",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "prepared-pizza-sauce",
      "item": "prepared pizza sauce",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "basil",
      "item": "fresh basil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped, or to taste"
    },
    {
      "ingredient_id": "aged-provolone-cheese",
      "item": "aged provolone cheese",
      "quantity": 6,
      "unit": "ounces",
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour the warm water into a bowl, stir in the yeast, and let stand for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Add the semolina flour, olive oil, and salt. Mix into a dough, adding more water as needed."
    },
    {
      "step": 3,
      "text": "Transfer the dough to a work surface and knead until smooth, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Shape the dough into a smooth ball, cover, and let rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Knead the dough for 4 minutes, reshape it, and place it in a semolina-dusted bowl. Cover and let rise for 2 hours.",
      "timer_minutes": 124
    },
    {
      "step": 6,
      "text": "Heat the oven to 500°F and sprinkle a baking surface with cornmeal."
    },
    {
      "step": 7,
      "text": "Roll or stretch the dough into a thin rectangle. Combine the pizza sauce with the basil, then spread some sauce over the dough and arrange sliced provolone on top."
    },
    {
      "step": 8,
      "text": "Fold the dough over the filling, add another layer of sauce and provolone, and fold again to enclose the layers. Finish with any remaining sauce and cheese as directed by the folded shape."
    },
    {
      "step": 9,
      "text": "Transfer the filled flatbread to the cornmeal-dusted baking surface and bake until browned and cooked through, about 18 minutes.",
      "timer_minutes": 18
    },
    {
      "step": 10,
      "text": "Let rest for 15 minutes before slicing and serving.",
      "timer_minutes": 15
    }
  ],
