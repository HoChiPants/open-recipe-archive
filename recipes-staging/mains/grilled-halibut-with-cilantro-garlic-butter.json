  "id": "grilled-halibut-with-cilantro-garlic-butter",
  "name": "Grilled Halibut with Cilantro Garlic Butter",
  "subtitle": "Tender grilled fish with a bright herb butter",
  "description": "Halibut fillets are grilled and served with a warm cilantro-garlic butter finished with lime.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 8
  },
  "ingredients": [
    {
      "ingredient_id": "6-ounce-fillets-halibut",
      "item": "(6 ounce) fillets halibut",
      "quantity": 4
    },
    {
      "ingredient_id": "lime",
      "item": "lime",
      "quantity": 1,
      "preparation": "cut into wedges"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "coarsely chopped"
    },
    {
      "ingredient_id": "fresh-cilantro",
      "item": "fresh cilantro",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fresh-lime-juice",
      "item": "fresh lime juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill to medium-high heat. Lightly coat the halibut with olive oil, then season with salt, pepper, and lime juice."
    },
    {
      "step": 2,
      "text": "Grill the halibut for about 5 minutes, turning as needed, until it reaches 145°F or is opaque and flakes easily.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Meanwhile, warm a small skillet over medium heat. Add the garlic and stir for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the cilantro, lime juice, and butter until the butter melts and the mixture is combined."
    },
    {
      "step": 5,
      "text": "Serve the grilled halibut with the cilantro garlic butter and lime wedges."
    }
  ],
