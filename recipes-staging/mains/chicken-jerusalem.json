      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Arrange the chicken in a baking dish and pour in the chicken stock."
    },
    {
      "step": 2,
      "text": "Bake until the chicken reaches 165°F in the thickest part, about 30 minutes. Transfer the chicken to a serving dish and reserve the stock.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Simmer the reserved stock with the garlic and onion until the onion softens. Stir in the white wine and cook until the mixture thickens.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the mushrooms and artichoke hearts, and cook until the mushrooms are tender.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Whisk in the heavy cream and simmer until the sauce thickens. Season with salt and pepper, then spoon the sauce over the chicken and serve.",
      "timer_minutes": 2
    }
  ],
