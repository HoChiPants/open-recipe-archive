  "id": "chicken-jerusalem",
  "name": "Chicken Jerusalem",
  "subtitle": "Baked chicken with mushrooms, artichokes, and cream sauce",
  "description": "Chicken breasts are baked with stock, then finished with a creamy mushroom and artichoke sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
