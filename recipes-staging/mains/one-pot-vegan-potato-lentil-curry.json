  "instructions": [
    {
      "step": 1,
      "text": "Heat the canola oil in a large pot over medium heat. Add the onions, garlic, and ginger; cook, stirring, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the raw sugar and cumin; cook for 2 minutes. Add the curry paste and cook for 2 minutes more.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Add the potatoes, tomatoes with their juices, coconut milk, red lentils, vegetable bouillon, and lemon juice. Stir well and bring to a simmer."
    },
    {
      "step": 4,
      "text": "Cover and simmer until the potatoes and lentils are cooked through, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Season with salt and freshly ground black pepper to taste, then serve hot."
    }
  ],
