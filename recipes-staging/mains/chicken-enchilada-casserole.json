  "id": "chicken-enchilada-casserole",
  "name": "Chicken Enchilada Casserole",
  "subtitle": "A cheesy layered casserole with chicken, corn tortillas, and chile sauce.",
  "description": "Cooked chicken is layered with tortillas and a creamy enchilada mixture, then baked until lightly browned and heated through.",
  "meal_type": "main",
