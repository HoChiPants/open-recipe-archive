  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine both soups, enchilada sauce, diced tomatoes with green chile peppers, green chiles, onion, garlic powder, chicken broth, and chili powder in a bowl."
    },
    {
      "step": 3,
      "text": "Melt the processed cheese spread and stir it into the sauce mixture until smooth."
    },
    {
      "step": 4,
      "text": "Spread some sauce in a baking dish. Add a layer of corn tortillas, followed by diced chicken and more sauce. Repeat the layers, finishing with sauce and cheese."
    },
    {
      "step": 5,
      "text": "Bake until lightly browned and the center reaches 165°F, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Let the casserole stand for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
