  "instructions": [
    {
      "step": 1,
      "text": "Dissolve the active dry yeast in the warm water and let it stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mix the flour, white sugar, dried oregano, and salt. Stir in the yeast mixture, egg, and olive oil to form a dough."
    },
    {
      "step": 3,
      "text": "Knead the dough for 8 minutes, until smooth. Coat it lightly with oil, cover, and let it rise in a warm place for 60 minutes.",
      "timer_minutes": 68
    },
    {
      "step": 4,
      "text": "Heat the oven to 450°F."
    },
    {
      "step": 5,
      "text": "Combine the tomatoes, tomato paste, chopped onion, dried oregano, garlic, onion powder, kosher salt, and black pepper in a saucepan."
    },
    {
      "step": 6,
      "text": "Cook the sauce for 20 minutes, stirring occasionally, until thickened.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Roll or stretch the dough into a pizza shape on a floured surface and transfer it to a prepared pan.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Spread the tomato sauce over the dough. Add 1.25 cups of mozzarella, the bell pepper, onion, and mushrooms, then finish with the remaining mozzarella."
    },
    {
      "step": 9,
      "text": "Bake for 25 minutes, until the cheese is melted and the center is fully set; verify the center reaches 160°F with a food thermometer.",
      "timer_minutes": 25
    }
  ],
