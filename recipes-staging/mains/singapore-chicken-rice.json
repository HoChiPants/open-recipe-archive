  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken, garlic, peeled ginger pieces, green onions, and 0.5 teaspoon salt in a pot. Add the chicken stock, bring to a gentle simmer, and poach until the thickest part of the chicken reaches 165°F, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 2,
      "text": "Transfer the chicken to a board and reserve the cooking stock. Let the chicken rest briefly before cutting it into serving pieces."
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil and 1 tablespoon sesame oil in a saucepan. Sauté the shallots, minced garlic, and chopped ginger until fragrant."
    },
    {
      "step": 4,
      "text": "Stir in the chopped cilantro and rinsed rice, then add enough reserved chicken stock to cook the rice. Season with the remaining 0.5 teaspoon salt."
    },
    {
      "step": 5,
      "text": "Cover and simmer the rice until tender, about 20 minutes. Remove from the heat and let it stand covered until ready to serve.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Drizzle the chicken with 2 tablespoons sesame oil. Arrange it with the rice, cilantro sprigs, sliced green onion, cucumber, and tomatoes."
    }
  ],
