  "id": "california-style-pizza-dough",
  "name": "California-Style Pizza Dough",
  "subtitle": "A yeasted dough for crisp, golden pizza crusts.",
  "description": "Mix, knead, rest, shape, and bake this straightforward pizza dough for homemade crusts.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "water",
      "item": "Water",
      "quantity": 1,
      "unit": "cup",
      "preparation": "municipal"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 5,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.75,
      "unit": "cups",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "cornmeal",
      "item": "cornmeal",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the yeast, honey, and water in a bowl. Let stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the salt, olive oil, and flour. Add more flour as needed to form a workable dough."
    },
    {
      "step": 3,
      "text": "Turn the dough onto a floured surface and knead until smooth."
    },
    {
      "step": 4,
      "text": "Transfer the dough to an oiled bowl, cover, and let rise for 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Fold the dough over itself, then cover and let it rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Heat the oven to 450°F. Dust the work surface or baking vessel with flour and cornmeal."
    },
    {
      "step": 7,
      "text": "Shape the dough and transfer it to the prepared surface. Use the divided olive oil as directed to oil the dough or baking surface."
    },
    {
      "step": 8,
      "text": "Bake for 5 minutes, then continue baking for 10 minutes, or until the crust is baked through and golden.",
      "timer_minutes": 15
    }
  ],
