{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cream-cheese-garlic-and-chive-stuffed-chicken",
  "name": "Cream Cheese, Garlic, and Chive Stuffed Chicken",
  "subtitle": "Tender chicken filled with a savory herb-and-garlic cream cheese mixture",
  "description": "Butterflied chicken breasts are filled with seasoned cream cheese, wrapped in turkey bacon, brushed with butter, and baked until fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "dried-chives",
      "item": "dried chives",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves, butterflied"
    },
    {
      "ingredient_id": "slices-turkey-bacon",
      "item": "slices turkey bacon",
      "quantity": 4
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the softened cream cheese, dried chives, and minced garlic until evenly combined."
    },
    {
      "step": 3,
      "text": "Place the butterflied chicken breasts on a work surface and spread the cream cheese mixture over each one. Fold the chicken closed and wrap each piece with a slice of turkey bacon."
    },
    {
      "step": 4,
      "text": "Arrange the stuffed chicken in a baking dish and brush with the melted butter."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, or until the thickest part of each breast reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
