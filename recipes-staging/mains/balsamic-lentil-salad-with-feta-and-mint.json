  "id": "balsamic-lentil-salad-with-feta-and-mint",
  "name": "Balsamic Lentil Salad with Feta and Mint",
  "subtitle": "A bright lentil salad with crisp radishes and peas",
  "description": "Cooked puy lentils, radishes, peas, feta, and mint come together with a tangy balsamic dressing for a quick vegetarian main.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "bunch-of-mint-finely-chopped",
      "item": "bunch of mint finely chopped",
      "quantity": "1/2",
      "unit": "small",
      "preparation": "plus extra leaves to serve"
    },
    {
      "ingredient_id": "feta-cut-into-cubes",
      "item": "feta cut into cubes",
      "quantity": 55,
      "unit": "g"
    },
    {
      "ingredient_id": "frozen-peas",
      "item": "frozen peas",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "puy-lentils",
      "item": "puy lentils",
      "quantity": 200,
      "unit": "g",
      "preparation": "cooked"
    },
    {
      "ingredient_id": "radishes-finely-sliced",
      "item": "radishes finely sliced",
      "quantity": 200,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the olive oil, balsamic vinegar, and finely chopped mint together in a serving bowl."
    },
    {
      "step": 2,
      "text": "Simmer the frozen peas briefly in boiling water until tender, then drain well."
    },
    {
      "step": 3,
      "text": "Add the cooked puy lentils, peas, and sliced radishes to the dressing and toss to coat."
    },
    {
      "step": 4,
      "text": "Fold in the cubed feta, then scatter with the extra mint leaves and serve."
    }
  ],
