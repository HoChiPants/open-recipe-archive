  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Heat the vegetable oil in an oven-safe skillet or separate pan, place the lobster tails cut-side down, and cook for 2 minutes. Transfer them to a plate, let them cool briefly, remove the meat, and cut it into bite-size pieces. Confirm the lobster is opaque and reaches 145°F.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Melt the 2 tablespoons butter in a saucepan over medium heat. Whisk in the flour and stir for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Gradually whisk in the cold milk. Add the paprika, nutmeg, cayenne, salt, and Worcestershire sauce. Simmer, stirring, until the sauce thickens, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Stir in the Cheddar, Gruyere, and Parmesan until melted. Keep the sauce warm over low heat."
    },
    {
      "step": 5,
      "text": "Cook the elbow macaroni in boiling salted water for 8 minutes, then drain. Stir the pasta and thyme into the cheese sauce, fold in the lobster, and transfer the mixture to a baking dish.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Combine the panko bread crumbs with the melted 1 tablespoon butter and remaining grated cheeses. Sprinkle the topping over the pasta."
    },
    {
      "step": 7,
      "text": "Bake until the casserole is hot and the topping is golden, about 20 minutes. Serve hot.",
      "timer_minutes": 20
    }
  ],
