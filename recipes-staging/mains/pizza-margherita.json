  "id": "pizza-margherita",
  "name": "Pizza Margherita",
  "subtitle": "Thin-crust pizza with tomato, mozzarella, and basil",
  "description": "A simple yeast-risen pizza topped with sauce, fresh mozzarella, basil, olive oil, and sea salt.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
