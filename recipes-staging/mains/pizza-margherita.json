  "instructions": [
    {
      "step": 1,
      "text": "Stir the all-purpose flour and salt together. Combine the water, active dry yeast, and white sugar separately, then let the mixture stand until set."
    },
    {
      "step": 2,
      "text": "Add the yeast mixture to the flour mixture and stir until a dough forms. Knead on a lightly floured surface for 8 minutes, until smooth.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Coat the dough lightly with olive oil, transfer it to a warm place, and let it rise for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Preheat the oven to 500°F. Divide and shape the risen dough, then stretch it on a surface dusted with flour for dusting."
    },
    {
      "step": 5,
      "text": "Transfer the dough to a baking surface, spread on the pizza sauce, and arrange the mozzarella and basil over it. Finish with olive oil and sea salt to taste."
    },
    {
      "step": 6,
      "text": "Bake for about 7 minutes, until the crust is golden brown and the cheese is melted.",
      "timer_minutes": 7
    }
  ],
