  "instructions": [
    {
      "step": 1,
      "text": "Combine the olive oil, tomato sauce, garlic, vinegar, basil, salt, and cayenne pepper in a bowl."
    },
    {
      "step": 2,
      "text": "Add the shrimp and toss until evenly coated. Cover and chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat the grill to medium-high heat. Thread the marinated shrimp onto the skewers."
    },
    {
      "step": 4,
      "text": "Grill the skewers, turning as needed, until the shrimp are opaque and reach 145°F internally, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
  ],
