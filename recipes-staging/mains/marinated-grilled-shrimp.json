  "id": "marinated-grilled-shrimp",
  "name": "Marinated Grilled Shrimp",
  "subtitle": "Garlic-basil shrimp with a tangy tomato marinade",
  "description": "Shrimp marinated with tomato sauce, garlic, basil, vinegar, and cayenne, then grilled on skewers until opaque.",
  "meal_type": "main",
  "cuisine": "American",
