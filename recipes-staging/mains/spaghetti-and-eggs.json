  "id": "spaghetti-and-eggs",
  "name": "Spaghetti and Eggs",
  "subtitle": "A quick buttery pasta with rosemary-seasoned eggs",
  "description": "Cook spaghetti, fold it with seasoned set eggs and melted butter, then finish with Parmesan for a simple one-serving meal.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "spaghetti",
      "item": "spaghetti",
      "quantity": 4,
      "unit": "ounces"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg",
