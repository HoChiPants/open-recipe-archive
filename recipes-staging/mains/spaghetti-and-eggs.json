      "item": "garlic powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    },
    {
