      "item": "dried rosemary",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "preparation": "to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of salted water to a simmer, add the spaghetti, and cook for 10 minutes or until tender. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium heat."
    },
    {
      "step": 3,
      "text": "Beat the eggs with the garlic powder, black pepper, minced onion, and rosemary. Add the mixture to the skillet and cook, stirring, until fully set and at least 160°F."
    },
    {
      "step": 4,
      "text": "Toss the drained spaghetti with the set eggs and transfer to a serving dish."
    },
    {
      "step": 5,
      "text": "Top with grated Parmesan cheese to taste and serve."
    }
  ],
