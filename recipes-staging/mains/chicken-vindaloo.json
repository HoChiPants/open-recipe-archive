  "instructions": [
    {
      "step": 1,
      "text": "Combine the lemon juice, garlic, and ginger with the diced chicken. Cover and marinate for 4 hours in the refrigerator.",
      "timer_minutes": 240
    },
    {
      "step": 2,
      "text": "Heat the oil in a large pot. Add the cinnamon, mustard seeds, 2 tsp chilli flakes, and the cayenne pinch; cook briefly until fragrant.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the onion and cook until softened and lightly colored.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Stir in the turmeric, tomato purée, remaining chilli flakes, garam masala, cumin, ground coriander, and cayenne pepper."
    },
    {
      "step": 5,
      "text": "Add the marinated chicken and chopped tomatoes. Simmer until the sauce is cooked through and the chicken reaches 165°F at the thickest pieces.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Serve with coriander leaves and the optional accompaniments."
    }
  ],
