  "instructions": [
    {
      "step": 1,
      "text": "Place the beef, salt, onion, garlic, coconut milk, beef broth, red curry paste, jalapeno peppers, lime juice, peanut oil, and brown sugar in a slow cooker; stir to combine."
    },
    {
      "step": 2,
      "text": "Cover and cook until the beef is tender, about 400 minutes. Check the thickest pieces with a food thermometer; whole-cut beef should reach at least 145°F, then rest for 3 minutes.",
      "timer_minutes": 400
    },
    {
      "step": 3,
      "text": "Near the end of the beef's cooking time, bring the water to a boil, add the jasmine rice, and cook until tender, about 25 minutes. Drain if needed.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Stir the baby spinach into the hot curry and let it wilt."
    },
    {
      "step": 5,
      "text": "Serve the curry over the rice and garnish with the fresh basil leaves."
    }
  ],
