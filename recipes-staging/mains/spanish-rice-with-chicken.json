  "id": "spanish-rice-with-chicken",
  "name": "Spanish Rice with Chicken",
  "subtitle": "A one-pan rice dinner with salsa and tender chicken",
  "description": "Rice mix is toasted in butter, then cooked with salsa, tomatoes, and cubed chicken for a savory, colorful meal.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "spanish-style-rice-mix",
      "item": "Spanish-style rice mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "6.8 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "hot-water",
      "item": "hot water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 1,
      "preparation": "boneless chicken breast half - cut into cubes"
    },
    {
      "ingredient_id": "salsa",
      "item": "salsa",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "tomatoes-with-green-chile-peppers",
      "item": "tomatoes with green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.5 ounce, diced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large oven-safe skillet over medium heat. Add the rice mix and cook, stirring, until the grains are golden brown."
    },
    {
      "step": 2,
      "text": "Stir in the hot water, salsa, and diced tomatoes. Add the cubed chicken and mix gently to distribute it evenly."
    },
    {
      "step": 3,
      "text": "Cover the skillet and cook for 30 minutes, or until the rice is tender and the chicken reaches 165°F in the center.",
      "timer_minutes": 30
    }
  ],
