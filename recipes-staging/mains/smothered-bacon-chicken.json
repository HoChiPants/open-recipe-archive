  "id": "smothered-bacon-chicken",
  "name": "Smothered Bacon Chicken",
  "subtitle": "Chicken breasts baked with bacon and creamy mushroom sauce",
  "description": "Boneless chicken breasts are topped with bacon and covered in a simple sour-cream mushroom sauce for a rich baked main dish.",
  "meal_type": "main",
