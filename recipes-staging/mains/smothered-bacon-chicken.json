  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the chicken breasts in a baking dish and arrange the bacon slices over them."
    },
    {
      "step": 3,
      "text": "Whisk the sour cream and condensed cream of mushroom soup together until smooth."
    },
    {
      "step": 4,
      "text": "Spread the sauce over the chicken and bacon."
    },
    {
      "step": 5,
      "text": "Bake for 50 minutes, or until the chicken reaches 165°F in the thickest part on a food thermometer.",
      "timer_minutes": 50
    }
  ],
