  "id": "chicken-and-sweet-potato-traybake",
  "name": "Chicken and Sweet Potato Traybake",
  "subtitle": "A simple roasted chicken dinner with sweet potatoes, onions, and broccoli.",
  "description": "Chicken thighs roast with seasoned sweet potatoes and red onion, then finish with broccoli for a complete family-style meal.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "adults, 2 children"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-potatoes-about-900g",
      "item": "sweet potatoes (about 900g)",
      "quantity": 3,
      "unit": "large",
      "preparation": "peeled and cut into large chunks"
    },
    {
      "ingredient_id": "oil-for-drizzling",
      "item": "oil for drizzling"
    },
    {
      "ingredient_id": "chicken-thighs",
      "item": "chicken thighs",
      "quantity": "6-8",
      "preparation": "skin left on"
    },
    {
      "ingredient_id": "red-onions-cut-into-wedges",
      "item": "red onions cut into wedges",
      "quantity": 2
    },
    {
      "ingredient_id": "sachet-piri-piri-spice-mix-or-a-mild-version",
      "item": "sachet piri-piri spice mix (or a mild version",
      "quantity": 25,
      "unit": "g",
      "preparation": "if you like)"
    },
    {
      "ingredient_id": "long-stem-broccoli",
      "item": "long-stem broccoli",
      "quantity": 300,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Arrange the sweet potatoes and red onions in a roasting pan, drizzle with oil, and toss with the piri-piri spice mix."
    },
    {
      "step": 2,
      "text": "Nestle the chicken thighs among the vegetables, skin-side up, and roast until the vegetables are beginning to brown and the chicken is nearly cooked.",
      "timer_minutes": 40
    },
    {
      "step": 3,
      "text": "Add the long-stem broccoli to the pan and drizzle with a little more oil if needed."
    },
    {
      "step": 4,
      "text": "Roast until the broccoli is tender and the chicken reaches 165°F in the thickest part, checked with a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Serve the chicken and roasted vegetables hot."
    }
  ],
