  "id": "baked-ham-with-glaze",
  "name": "Baked Ham with Glaze",
  "subtitle": "A sweet, warmly spiced centerpiece for a crowd",
  "description": "Bake a bone-in ham with a quick brown sugar glaze flavored with ginger ale, mustard, and cinnamon.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "6-pound-bone-in-whole-ham",
      "item": "(6 pound) bone-in whole ham",
      "quantity": 1
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ginger-ale",
      "item": "ginger ale",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dry-mustard",
      "item": "dry mustard",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.125,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Transfer the ham to a roasting pan."
    },
    {
      "step": 2,
      "text": "Bake the ham for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 3,
      "text": "Whisk the brown sugar, ginger ale, dry mustard, and cinnamon into a glaze."
    },
    {
      "step": 4,
      "text": "Spread the glaze over the ham and return it to the oven. Bake until the total cooking time reaches 90 minutes and the thickest part registers 145°F.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Rest the ham for 3 minutes before slicing and serving.",
      "timer_minutes": 3
    }
  ],
