  "instructions": [
    {
      "step": 1,
      "text": "Rinse the quinoa if needed. Combine it with the water and a pinch of salt in a saucepan. Bring to a simmer, cover, and cook until tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Let the quinoa cool, then refrigerate it until thoroughly chilled, about 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Stir together the soy sauce, teriyaki sauce, and sesame oil."
    },
    {
      "step": 4,
      "text": "Heat a large skillet or wok over medium-high heat. Add half the olive oil and sauté the carrots and onion for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Add the scallions, garlic, and ginger; sauté for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Add the remaining olive oil and chilled quinoa. Cook for 2 minutes, stirring occasionally.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Pour in the sauce mixture and stir-fry for 2 minutes, until the quinoa is evenly coated.",
      "timer_minutes": 2
    },
    {
      "step": 8,
      "text": "Push the quinoa mixture aside and add the beaten eggs. Stir until fully cooked and set, reaching 160°F if checked with a thermometer, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 9,
      "text": "Stir in the frozen peas and cook for 3 minutes. Add the remaining scallions and serve hot.",
      "timer_minutes": 3
    }
  ],
