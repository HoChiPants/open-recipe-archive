  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Heat the reserved artichoke marinade in a large ovenproof skillet for 10 minutes, then transfer it to a bowl.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Cook the chicken chunks in the skillet until lightly browned. Add the onion, garlic, mushrooms, oregano, basil, salt, rosemary, pepper, and olives; stir for 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Stir in the artichokes, diced tomatoes with their juice, tomato sauce, and Madeira wine. Return the chicken mixture to the skillet and combine well."
    },
    {
      "step": 4,
      "text": "Cover and bake until the chicken reaches 165°F at the thickest pieces and the sauce is bubbling, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Top with the mozzarella and bake until the cheese is fully melted, about 7 minutes.",
      "timer_minutes": 7
    }
  ],
