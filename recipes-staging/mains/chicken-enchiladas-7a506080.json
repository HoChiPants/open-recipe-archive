  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Warm the olive oil in a large ovenproof skillet or sauté pan. Cook the red onions, red peppers, two deseeded and chopped red chillies, coriander stalks, garlic, ground coriander, and cumin seeds until softened and fragrant.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the chicken and cook, stirring, until the pieces are no longer pink on the outside. Stir in the refried beans, sweetcorn, and about half of the passata. Continue cooking until the chicken reaches 165°F at the thickest piece."
    },
    {
      "step": 3,
      "text": "Mix the remaining passata with the golden caster sugar and set it aside as the topping sauce."
    },
    {
      "step": 4,
      "text": "Divide the chicken mixture among the tortillas, roll them up, and arrange them seam-side down in a baking dish. Pour over the passata mixture."
    },
    {
      "step": 5,
      "text": "Whisk the soured cream until smooth, spread it over the enchiladas, and sprinkle with the grated cheddar and sliced chilli."
    },
    {
      "step": 6,
      "text": "Bake until the sauce is bubbling and the cheese is melted and lightly browned. Scatter with the chopped coriander leaves and serve hot.",
      "timer_minutes": 30
    }
  ],
