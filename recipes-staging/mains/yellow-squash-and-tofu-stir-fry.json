  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Add the garlic and stir briefly until fragrant."
    },
    {
      "step": 2,
      "text": "Add the yellow squash and zucchini. Stir-fry for 7 minutes, until tender-crisp, then transfer the vegetables to a plate.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Add the tofu, brown sugar, soy sauce, and sriracha sauce to the skillet. Cook, stirring occasionally, for 5 minutes, until the tofu is golden brown.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Return the squash and zucchini to the skillet and stir-fry for 3 minutes to combine and heat through.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Season with salt and ground black pepper to taste, then serve."
    }
  ],
