  "id": "cajun-spiced-pork-chops",
  "name": "Cajun-Spiced Pork Chops",
  "subtitle": "Pan-seared pork with a savory chile-seasoned crust",
  "description": "Pork chops are coated in a paprika-and-spice blend, cooked in olive oil, and finished at a safe internal temperature.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
