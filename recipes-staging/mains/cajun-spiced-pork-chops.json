      "item": "center cut pork chops",
      "quantity": 4
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the paprika, cumin, black pepper, cayenne, sage, and garlic salt. Coat the pork chops evenly with the spice mixture."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet over medium-high heat. Add the seasoned chops and cook, turning once, until browned and the thickest part reaches 145°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Transfer the chops to a plate and let them rest for 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
