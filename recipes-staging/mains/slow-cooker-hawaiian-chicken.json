  "id": "slow-cooker-hawaiian-chicken",
  "name": "Slow Cooker Hawaiian Chicken",
  "subtitle": "Tender chicken with pineapple and barbecue sauce",
  "description": "Chicken breasts cook slowly with pineapple, honey barbecue sauce, and soy sauce for a sweet-savory main dish.",
  "meal_type": "main",
