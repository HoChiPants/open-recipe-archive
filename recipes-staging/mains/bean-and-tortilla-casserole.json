  "id": "bean-and-tortilla-casserole",
  "name": "Bean and Tortilla Casserole",
  "subtitle": "A quick layered bake with beans, tortillas, salsa, and melted cheese.",
  "description": "This simple casserole layers seasoned refried beans with tortillas, salsa, and shredded cheese for an easy main dish.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "refried-beans",
      "item": "refried beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.75,
      "preparation": "diced"
    },
    {
      "ingredient_id": "10-inch-flour-tortillas",
      "item": "(10 inch) flour tortillas",
      "quantity": 5
    },
    {
      "ingredient_id": "salsa",
      "item": "salsa",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cheddar-or-colby-jack-cheese",
      "item": "Cheddar or Colby Jack cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Warm the refried beans with the diced onion in a small saucepan over medium heat until heated through.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Spread a layer of the bean mixture in a baking dish. Top with tortillas, salsa, and some of the shredded cheese; repeat the layers, finishing with cheese."
    },
    {
      "step": 4,
      "text": "Bake until the casserole is hot and the cheese is melted.",
      "timer_minutes": 20
    }
  ],
