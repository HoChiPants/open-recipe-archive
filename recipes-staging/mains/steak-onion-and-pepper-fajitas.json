  "id": "steak-onion-and-pepper-fajitas",
  "name": "Steak, Onion, and Pepper Fajitas",
  "subtitle": "Marinated grilled steak with tender peppers and onions",
  "description": "Beef round steak is marinated with lime and tequila, grilled, sliced, and served with seasoned peppers and onions.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
