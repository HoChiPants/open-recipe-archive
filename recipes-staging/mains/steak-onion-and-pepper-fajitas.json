    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "beef-round-steak",
      "item": "beef round steak",
      "quantity": 1.5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "fresh-lime-juice",
      "item": "fresh lime juice",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "tequila",
      "item": "tequila",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "cooking-oil",
      "item": "cooking oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
