  "instructions": [
    {
      "step": 1,
      "text": "Combine the steak, lime juice, and tequila in a covered container. Marinate for 2 hours, then discard the marinade.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Preheat a grill. Remove the steak from the marinade and pat it dry."
    },
    {
      "step": 3,
      "text": "Grill the steak for 8 minutes, turning as needed, until it reaches 145°F in the thickest part. Rest for 3 minutes, then cut into strips.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Preheat a skillet over medium heat. Add the cooking oil, liquid smoke, Worcestershire sauce, ground black pepper, salt, and paprika; stir to combine."
    },
    {
      "step": 5,
      "text": "Add the bell peppers and onions. Cook, stirring occasionally, until the vegetables are tender."
    },
    {
      "step": 6,
      "text": "Transfer the sliced steak and cooked vegetables to a serving dish and combine."
    }
  ],
