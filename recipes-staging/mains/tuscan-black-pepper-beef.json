  "id": "tuscan-black-pepper-beef",
  "name": "Tuscan Black Pepper Beef",
  "subtitle": "Slow-braised beef with wine, garlic, and herbs",
  "description": "Beef short ribs are gently braised with crushed peppercorns, red wine, garlic, and herbs until tender, then finished with a concentrated sauce.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 210
  },
  "ingredients": [
    {
      "ingredient_id": "beef-short-ribs-8-to-10-oz-each",
      "item": "beef short ribs (8 to 10 oz. each)",
      "quantity": 6
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 8,
      "unit": "cloves",
      "preparation": "peeled and crushed"
    },
    {
      "ingredient_id": "tomato-paste",
      "item": "tomato paste",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "whole-black-peppercorns",
      "item": "whole black peppercorns",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "freshly crushed"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sage-leaves",
      "item": "sage leaves",
      "quantity": 3
    },
    {
      "ingredient_id": "sprigs-fresh-rosemary",
      "item": "sprigs fresh rosemary",
      "quantity": 3,
      "unit": "small"
    },
    {
      "ingredient_id": "bay-leaves",
      "item": "bay leaves",
      "quantity": 2
    },
    {
      "ingredient_id": "red-wine",
      "item": "red wine",
      "quantity": 2,
      "unit": "cups",
      "preparation": "preferably Chianti"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste",
      "preparation": "to adjust sauce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the short ribs evenly with the kosher salt, then arrange them in a heavy oven-safe pot."
    },
    {
      "step": 2,
      "text": "Add the garlic, tomato paste, crushed whole peppercorns, ground black pepper, sage, rosemary, bay leaves, and red wine."
    },
    {
      "step": 3,
      "text": "Cover the pot and braise in a preheated oven until the beef is tender, about 3 1/2 hours. Confirm the thickest portions reach at least 145°F, then rest for 3 minutes.",
      "timer_minutes": 210
    },
    {
      "step": 4,
      "text": "Transfer the ribs to a serving dish and keep warm. Remove the herb sprigs and bay leaves from the pot."
    },
    {
      "step": 5,
      "text": "Bring the braising liquid to a simmer and cook until thickened, about 10 minutes. Adjust the seasoning with salt to taste.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Return the ribs to the thickened sauce and cook for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
