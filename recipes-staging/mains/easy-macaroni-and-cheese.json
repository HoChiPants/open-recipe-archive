  "id": "easy-macaroni-and-cheese",
  "name": "Easy Macaroni and Cheese",
  "subtitle": "Creamy stovetop macaroni in minutes",
  "description": "Tender elbow macaroni is folded into melted cheese and milk with a touch of black pepper for a quick, comforting main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "elbow-macaroni",
      "item": "elbow macaroni",
      "quantity": 4,
      "unit": "ounces"
    },
    {
      "ingredient_id": "processed-cheese-food",
      "item": "processed cheese food",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "fluid-ounces-milk",
      "item": "fluid ounces milk",
      "quantity": 2
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer, then bring it to a boil."
    },
    {
      "step": 2,
      "text": "Cook the elbow macaroni in the boiling water for 10 minutes, or until tender. Drain well.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Preheat a saucepan over low heat. Add the cubed processed cheese food, milk, and black pepper; cook and stir until the cheese melts."
    },
    {
      "step": 4,
      "text": "Add the drained macaroni and stir until evenly coated. Serve hot."
    }
  ],
