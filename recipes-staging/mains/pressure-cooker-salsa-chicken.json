  "id": "pressure-cooker-salsa-chicken",
  "name": "Pressure-Cooker Salsa Chicken",
  "subtitle": "Tender shredded chicken with salsa and taco seasoning",
  "description": "Frozen chicken cooks in a seasoned salsa-and-broth mixture, then is shredded for an easy dinner.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-skinless",
      "item": "frozen skinless",
      "quantity": 1,
      "unit": "pound",
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "taco-seasoning-mix",
      "item": "taco seasoning mix",
      "quantity": 1,
      "unit": "packet",
      "preparation": "1 ounce"
    },
    {
      "ingredient_id": "salsa",
      "item": "salsa",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "low-sodium-chicken-broth",
      "item": "low-sodium chicken broth",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour the chicken broth into the pressure cooker. Add the taco seasoning and salsa, stirring to combine."
    },
    {
      "step": 2,
      "text": "Add the frozen chicken and secure the lid."
    },
    {
      "step": 3,
      "text": "Cook under high pressure for 15 minutes, then allow the pressure to release naturally for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Release any remaining pressure carefully and open the cooker. Check that the chicken reaches 165°F in the thickest part."
    },
    {
      "step": 5,
      "text": "Shred the chicken in the cooking liquid and serve."
    }
  ],
