  "id": "monterey-chicken",
  "name": "Monterey Chicken",
  "subtitle": "Baked chicken with vegetables, bacon, and melted cheese",
  "description": "Marinated chicken is baked until fully cooked, then topped with sautéed vegetables, bacon, and mozzarella.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "5-ounce-skinless",
      "item": "(5 ounce) skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "teriyaki-marinade-sauce",
      "item": "teriyaki marinade sauce",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 0.5,
      "unit": "pound"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "cut into long slices"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 1,
      "unit": "small",
      "preparation": "cut into thin strips"
    },
    {
      "ingredient_id": "fresh-mushrooms",
      "item": "fresh mushrooms",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, coarsely chopped"
    },
    {
      "ingredient_id": "slices-mozzarella-cheese",
      "item": "slices mozzarella cheese",
      "quantity": 4
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the chicken in a shallow dish and coat it with the teriyaki marinade sauce. Cover and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Heat the oven to 350°F. Transfer the chicken to a baking dish, reserving the marinade, and let it stand briefly while the oven heats."
    },
    {
      "step": 3,
      "text": "Bake the chicken for 30 minutes, or until the thickest piece reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Meanwhile, cook the bacon in a skillet until set. Drain, then crumble or cut it into pieces."
    },
    {
      "step": 5,
      "text": "Melt the butter in a skillet and cook the onion, bell pepper, and mushrooms for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Bring the reserved marinade to a full boil before using it. Add it to the vegetables and cook until the onion is tender and the mixture is set."
    },
    {
      "step": 7,
      "text": "Top each baked chicken breast with the vegetable mixture, bacon, and a slice of mozzarella."
    },
    {
      "step": 8,
      "text": "Return the dish to the oven and bake until the mozzarella is melted.",
      "timer_minutes": 15
    },
    {
      "step": 9,
      "text": "Serve hot."
    }
  ],
