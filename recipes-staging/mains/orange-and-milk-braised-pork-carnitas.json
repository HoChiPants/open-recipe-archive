  "id": "orange-and-milk-braised-pork-carnitas",
  "name": "Orange and Milk-Braised Pork Carnitas",
  "subtitle": "Tender citrus-scented pork with crisp edges",
  "description": "Pork shoulder is seasoned, browned, gently braised with orange and milk, then roasted until richly browned and crisp.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 150
  },
  "ingredients": [
    {
      "ingredient_id": "boneless-pork-shoulder",
      "item": "boneless pork shoulder",
      "quantity": 3.5,
      "unit": "pounds",
      "preparation": "cut into large pieces"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "bay-leaves",
      "item": "bay leaves",
      "quantity": 2
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "orange",
      "item": "orange",
      "quantity": 1,
      "preparation": "juiced and zested"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the pork with the pepper, salt, and cayenne."
    },
    {
      "step": 2,
      "text": "Heat the oil in a large oven-safe pot over medium-high heat. Brown the pork in batches, turning as needed, for about 5 minutes total.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Return all the pork to the pot and add the bay leaves, cumin, oregano, orange juice and zest, and milk. Stir to combine."
    },
    {
      "step": 4,
      "text": "Bring the liquid to a gentle simmer, then cover and cook until the pork is very tender and reaches at least 145°F in the center; allow a 3-minute rest before crisping.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Heat the oven to 450°F. Transfer the pork to a baking sheet, leaving the braising liquid behind, and arrange the pieces in a single layer. Adjust seasoning with additional salt if needed."
    },
    {
      "step": 6,
      "text": "Roast until the edges are browned and crisp, about 15 minutes. Turn or stir the pieces and roast for about 3 minutes more.",
      "timer_minutes": 15
    }
  ],
