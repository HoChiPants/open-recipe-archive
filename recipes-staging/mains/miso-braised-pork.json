      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "pork-butt-shoulder-roast-cut-into-2-inch-slices",
      "item": "pork butt (shoulder roast) cut into 2-inch slices",
      "quantity": 5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "minced"
    },
    {
