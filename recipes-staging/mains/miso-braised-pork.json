      "item": "white (shiro) miso",
      "quantity": 0.75,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the canola oil in a large heavy pot over medium-high heat. Coat the pork slices with the brown sugar, then brown them in batches; transfer the browned pork to a plate."
    },
    {
      "step": 2,
      "text": "Add the garlic and ginger to the pot and stir briefly until fragrant."
    },
    {
      "step": 3,
      "text": "Stir in the water, soy sauce, remaining brown sugar, and white miso, scraping up any browned bits."
    },
    {
      "step": 4,
      "text": "Return the pork to the pot and add enough additional water to keep the meat partly submerged."
    },
    {
      "step": 5,
      "text": "Bring the liquid to a simmer, cover, and cook gently for about 3 hours, turning the pork occasionally, until very tender. Add more water if needed to prevent scorching.",
      "timer_minutes": 180
    },
    {
      "step": 6,
      "text": "Check that the pork reaches at least 145°F internally, then let it rest for 3 minutes before serving with the braising sauce."
    }
  ],
