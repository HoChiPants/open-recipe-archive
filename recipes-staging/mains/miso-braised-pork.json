  "id": "miso-braised-pork",
  "name": "Miso-Braised Pork",
  "subtitle": "Tender pork shoulder in a savory miso sauce",
  "description": "Pork shoulder slowly braised with white miso, soy sauce, garlic, ginger, and brown sugar until tender.",
  "meal_type": "main",
  "cuisine": "Japanese",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
