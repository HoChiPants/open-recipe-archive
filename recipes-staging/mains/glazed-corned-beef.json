{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "glazed-corned-beef",
  "name": "Glazed Corned Beef",
  "subtitle": "Tender baked beef with a sweet apricot glaze",
  "description": "Bake rinsed corned beef with water until tender, then finish it with a quick apricot-brown sugar glaze and slice for serving.",
  "meal_type": "main",
  "yield": {
    "quantity": 7,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 145
  },
  "ingredients": [
    {
      "ingredient_id": "nonstick-cooking-spray",
      "item": "nonstick cooking spray"
    },
    {
      "ingredient_id": "corned-beef",
      "item": "corned beef",
      "quantity": 4.5,
      "unit": "pounds",
      "preparation": "rinsed"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "apricot-preserves",
      "item": "apricot preserves",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat a baking dish with nonstick cooking spray."
    },
    {
      "step": 2,
      "text": "Place the rinsed corned beef in the dish and pour in the water. Cover and bake for 120 minutes.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Drain the liquid from the dish. Stir together the apricot preserves, brown sugar, and soy sauce, then spread the glaze over the corned beef."
    },
    {
      "step": 4,
      "text": "Return the dish to the oven and bake uncovered until the beef is tender and reaches at least 145°F in the thickest part. Rest for 3 minutes before slicing."
    },
    {
      "step": 5,
      "text": "Cut the corned beef across the grain and serve with the glaze."
    }
  ],
