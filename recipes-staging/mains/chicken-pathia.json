  "instructions": [
    {
      "step": 1,
      "text": "In a saucepan, combine the first measured garlic, ginger, ground coriander, paprika, turmeric, and some of the chopped coriander leaves with the chopped onion."
    },
    {
      "step": 2,
      "text": "Add the plum tomatoes and water. Bring to a simmer and cook until thickened, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Blend the tomato mixture until smooth, then return it to the saucepan."
    },
    {
      "step": 4,
      "text": "Add the second chopped onion, green pepper, remaining garlic, ginger, cumin, coriander, cinnamon, salt, cayenne, vinegar, sugar, food colouring, chicken, and stock. Stir to combine."
    },
    {
      "step": 5,
      "text": "Add the remaining chopped coriander leaves and simmer for 20 minutes, until the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 20
    }
  ],
