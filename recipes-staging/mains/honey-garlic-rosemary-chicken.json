{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "honey-garlic-rosemary-chicken",
  "name": "Honey Garlic Rosemary Chicken",
  "subtitle": "Baked chicken thighs with a buttery honey-garlic glaze",
  "description": "Chicken thighs are baked in a savory honey, garlic, and rosemary sauce until fully cooked and glazed.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "rosemary",
      "item": "rosemary",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "skinless-chicken-thighs",
      "item": "skinless chicken thighs",
      "quantity": 6
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Warm the butter in a skillet over medium heat. Stir in the garlic powder, rosemary, salt, and pepper, and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Stir in the honey and bring the mixture to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Arrange the chicken thighs in a baking dish and pour the honey-garlic mixture over them."
    },
    {
      "step": 5,
      "text": "Bake until the chicken reaches 165°F in the thickest part, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Coat the chicken with the pan juices before serving."
    }
  ],
