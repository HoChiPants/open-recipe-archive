  "id": "balsamic-lentil-pies-with-vegetable-mash",
  "name": "Balsamic Lentil Pies with Vegetable Mash",
  "subtitle": "Rosemary lentils under a hearty root-vegetable topping",
  "description": "A savory vegetarian pie layered with balsamic lentils, wilted greens, creamy root vegetables, and a browned cheese crust.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "rapeseed-oil-plus-a-drop-extra",
      "item": "rapeseed oil plus a drop extra",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "red-onions-thinly-sliced",
      "item": "red onions thinly sliced",
      "quantity": 4
    },
    {
      "ingredient_id": "puy-lentils",
      "item": "puy lentils",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "finely-chopped-rosemary",
      "item": "finely chopped rosemary",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vegetable-bouillon-powder",
      "item": "vegetable bouillon powder",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "and-diced-celeriac",
      "item": "and diced celeriac",
      "quantity": 350,
      "unit": "g",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "and-diced-swede",
      "item": "and diced swede",
      "quantity": 350,
      "unit": "g",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "and-diced-potato",
      "item": "and diced potato",
      "quantity": 350,
      "unit": "g",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "x-160g-broccoli",
      "item": "x 160g broccoli",
      "quantity": 2
    },
    {
      "ingredient_id": "x-160g-spinach",
      "item": "x 160g spinach",
      "quantity": 2
    },
    {
      "ingredient_id": "vegetarian-italian-style-hard-cheese-finely-grated",
      "item": "vegetarian Italian-style hard cheese finely grated",
      "quantity": 50,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven or grill to high. Cook the celeriac, swede, potato, and broccoli in boiling water until tender, about 25 minutes; drain well.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Meanwhile, heat the rapeseed oil in a pan and cook the onions until softened, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Add the lentils, rosemary, bouillon powder, balsamic vinegar, and enough water to cover. Simmer until the lentils are tender and the liquid is mostly absorbed, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "Wilt the spinach with the extra drop of oil for about 2 minutes. Mash the cooked root vegetables and broccoli until mostly smooth, then fold in the spinach.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Spoon the lentil mixture into four ovenproof dishes and cover with the vegetable mash. Sprinkle with the grated cheese."
    },
    {
      "step": 6,
      "text": "Grill until the cheese is melted and browned. Serve hot."
    }
  ],
