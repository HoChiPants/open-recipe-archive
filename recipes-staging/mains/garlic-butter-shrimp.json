{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "garlic-butter-shrimp",
  "name": "Garlic Butter Shrimp",
  "subtitle": "A quick skillet shrimp dinner with garlic and a silky butter sauce.",
  "description": "Frozen shrimp cook in seasoned butter, then are finished with a cornstarch slurry for a lightly thickened sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "frozen-medium-shrimp",
      "item": "frozen medium shrimp",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large skillet over medium heat. Add the frozen shrimp and cook, stirring occasionally, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the garlic powder."
    },
    {
      "step": 3,
      "text": "Whisk the water and cornstarch together until smooth, then add the slurry to the skillet."
    },
    {
      "step": 4,
      "text": "Cook, stirring, for 5 minutes, until the shrimp are opaque and easily flake and the sauce thickens.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Season with salt and ground black pepper to taste, then serve."
    }
  ],
