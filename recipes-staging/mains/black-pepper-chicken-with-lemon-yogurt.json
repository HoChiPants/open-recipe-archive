  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "black-pepper-chicken-with-lemon-yogurt",
  "name": "Black Pepper Chicken with Lemon Yogurt",
  "subtitle": "Roasted spatchcock chicken with pepper, turmeric, and bright yogurt",
  "description": "A boldly seasoned roast chicken served with creamy lemon yogurt and peppered rice.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "black-peppercorns",
      "item": "black peppercorns",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-cloves-grated",
      "item": "garlic cloves grated",
      "quantity": 5,
      "preparation": "plus 1 whole garlic bulb"
    },
    {
      "ingredient_id": "ground-turmeric",
      "item": "ground turmeric",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "lemons-1-juiced",
      "item": "lemons 1 juiced",
      "quantity": 2,
      "preparation": "plus extra wedges to serve"
    },
    {
      "ingredient_id": "whole-chicken-spatchcocked-see-tip",
      "item": "whole chicken spatchcocked (see tip",
      "quantity": "1 1/2",
      "unit": "kg",
      "preparation": "below)"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "greek-yogurt",
      "item": "Greek yogurt",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "bunch-of-coriander-roughly-chopped",
      "item": "bunch of coriander roughly chopped (optional)",
      "unit": "small",
      "optional": true
    },
    {
      "ingredient_id": "peppered-rice-to-serve-see-goes-well-with",
      "item": "peppered rice to serve (see 'goes well with')"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Crush the peppercorns, then mix with the grated garlic, turmeric, lemon juice, and olive oil to make a thick paste."
    },
    {
      "step": 2,
      "text": "Rub the paste over the spatchcocked chicken. Cover and chill for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Preheat the oven to 425°F. Place the chicken and whole garlic bulb in a roasting pan."
    },
    {
      "step": 4,
      "text": "Roast until the garlic is soft and the chicken reaches 165°F at the thickest part of the breast and thigh.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Rest the chicken for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Squeeze the roasted garlic into the Greek yogurt and stir in the remaining lemon juice and pan juices."
    },
    {
      "step": 7,
      "text": "Carve the chicken and serve with the lemon yogurt, coriander if using, lemon wedges, and peppered rice."
    }
  ],
