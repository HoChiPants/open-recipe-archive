      "item": "Hawaiian style marinade",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "4-ounce-skinless",
      "item": "(4 ounce) skinless",
      "quantity": 6,
      "preparation": "boneless chicken breast halves - pounded to 1/4 inch thickness"
    },
