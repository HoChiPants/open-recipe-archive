  "id": "grilled-chicken-and-pineapple-sandwiches",
  "name": "Grilled Chicken and Pineapple Sandwiches",
  "subtitle": "Juicy grilled chicken with sweet pineapple and melted cheese",
  "description": "Marinated chicken is grilled and layered into toasted rolls with pineapple, cheese, lettuce, tomato, and creamy dressing.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
