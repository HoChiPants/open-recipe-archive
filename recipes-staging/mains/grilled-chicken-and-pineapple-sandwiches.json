  "instructions": [
    {
      "step": 1,
      "text": "Place the marinade in a shallow dish. Add the chicken and turn to coat. Cover and refrigerate for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Preheat a grill to medium-high heat and lightly coat the grates with cooking spray."
    },
    {
      "step": 3,
      "text": "Remove the chicken from the marinade and discard the used marinade. Grill the chicken for about 10 minutes, turning as needed, until a thermometer inserted into the thickest piece reads 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "During the last few minutes, grill the pineapple rings and tomato slices for about 2 minutes, toast the split rolls, and place the provolone on the chicken for about 1 minute, until melted.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Fill each roll with a chicken breast, pineapple ring, lettuce leaf, tomato slice, and melted cheese. Spread the dressing over the rolls and serve."
    }
  ],
