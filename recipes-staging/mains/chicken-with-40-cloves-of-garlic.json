  "id": "chicken-with-40-cloves-of-garlic",
  "name": "Chicken with 40 Cloves of Garlic",
  "subtitle": "Aromatic roasted chicken with tender garlic",
  "description": "A whole chicken is browned with butter and olive oil, then roasted with garlic, lemon, herbs, and a light pan sauce.",
  "meal_type": "main",
  "cuisine": "French",
