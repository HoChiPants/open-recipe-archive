  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Warm the butter and olive oil in a large ovenproof pot."
    },
    {
      "step": 2,
      "text": "Add the chicken and brown it in the fat for 10 minutes, turning as needed. Remove it briefly and drain excess fat from the pot.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir the garlic into the pot, then return the chicken. Add the water, lemon juice, salt, thyme, and pepper."
    },
    {
      "step": 4,
      "text": "Cover and bake for 90 minutes, until the thickest part of the chicken reaches 165°F on a food thermometer.",
      "timer_minutes": 90
    },
    {
      "step": 5,
      "text": "Set the oven to 180°F if needed to keep the cooked chicken warm, then let the chicken rest for 10 minutes before carving.",
      "timer_minutes": 10
    }
  ],
