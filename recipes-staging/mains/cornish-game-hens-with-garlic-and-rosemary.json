  "id": "cornish-game-hens-with-garlic-and-rosemary",
  "name": "Cornish Game Hens with Garlic and Rosemary",
  "subtitle": "Roasted hens with a simple garlic pan sauce",
  "description": "Cornish game hens roast with lemon, rosemary, and garlic, then finish with a light wine-and-broth sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "cornish-game-hens",
      "item": "Cornish game hens",
      "quantity": 4
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1,
      "preparation": "quartered"
    },
    {
      "ingredient_id": "sprigs-fresh-rosemary",
      "item": "sprigs fresh rosemary",
      "quantity": 8,
      "preparation": "divided"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 24,
      "unit": "cloves"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "low-sodium-chicken-broth",
      "item": "low-sodium chicken broth",
      "quantity": 0.33333334326744,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 450°F. Pat the hens dry, rub them with part of the divided olive oil, and season with salt and pepper."
    },
    {
      "step": 2,
      "text": "Place a lemon quarter and rosemary in each hen. Arrange the hens and garlic cloves in a roasting pan."
    },
    {
      "step": 3,
      "text": "Roast for 25 minutes. Whisk the remaining olive oil with the white wine and chicken broth.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Reduce the oven to 350°F and pour the wine mixture into the pan. Continue roasting until golden brown and the thickest part of each hen reaches 165°F.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer the hens to a serving dish and let them rest briefly. Remove the lemon and rosemary used for roasting."
    },
    {
      "step": 6,
      "text": "Simmer the garlic and pan juices for 6 minutes, then add the garlic as directed and spoon the sauce over the hens. Garnish with the remaining rosemary.",
      "timer_minutes": 6
    }
  ],
