{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "salmon-tuna-patties",
  "name": "Salmon Tuna Patties",
  "subtitle": "Crisp fish patties with a simple cracker coating",
  "description": "Canned salmon and tuna combine with crushed crackers and egg, then are shaped, floured, and sautéed until browned and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "salmon",
      "item": "salmon",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.75 ounce, drained and flaked"
    },
    {
      "ingredient_id": "tuna",
      "item": "tuna",
      "quantity": 2,
      "unit": "can",
      "preparation": "5 ounce, drained"
    },
    {
      "ingredient_id": "saltine-crackers",
      "item": "saltine crackers",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, crushed"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the salmon, tuna, crushed saltine crackers, and beaten egg in a bowl until evenly mixed."
    },
    {
      "step": 2,
      "text": "Shape the mixture into six patties."
    },
    {
      "step": 3,
      "text": "Place the flour in a shallow dish and coat the patties on both sides."
    },
    {
      "step": 4,
      "text": "Preheat a skillet over medium heat and add the canola oil."
    },
    {
      "step": 5,
      "text": "Sauté the patties for about 15 minutes, turning as needed, until browned and the centers reach 160°F and are opaque and easily flaked.",
      "timer_minutes": 15
    }
  ],
