  "id": "spicy-fried-chicken",
  "name": "Spicy Fried Chicken",
  "subtitle": "Crisp, cayenne-seasoned chicken with a tangy buttermilk soak",
  "description": "Chicken pieces are marinated in seasoned buttermilk, coated in spiced flour, and deep-fried until crisp and safely cooked.",
  "meal_type": "main",
