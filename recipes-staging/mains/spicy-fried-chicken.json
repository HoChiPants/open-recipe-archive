  "instructions": [
    {
      "step": 1,
      "text": "Whisk the buttermilk with the hot pepper sauce, 1 teaspoon cayenne, and salt and pepper. Add the chicken, turn to coat, cover, and refrigerate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Combine the flour, 1 tablespoon cayenne, garlic powder, paprika, and salt and pepper in a shallow dish."
    },
    {
      "step": 3,
      "text": "Lift the chicken from the buttermilk, letting the excess drip off, then coat each piece thoroughly in the seasoned flour."
    },
    {
      "step": 4,
      "text": "Heat the vegetable oil to 350°F in a deep, heavy pot. Fry the chicken in batches for about 15 minutes, turning as needed, until the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Transfer the chicken to a rack or paper towels to drain before serving."
    }
  ],
