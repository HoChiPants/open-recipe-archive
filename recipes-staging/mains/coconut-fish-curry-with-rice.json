  "instructions": [
    {
      "step": 1,
      "text": "Toss the fish with the lime juice, turmeric, cumin, and ground coriander. Set aside while preparing the curry."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil or ghee in a large pan. Cook the onion for 10 minutes, until softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the ginger and sliced garlic; cook for 2 minutes. Stir in the tomato purée and chilli.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the squash and sweet potato mix, coconut milk, and tamarind paste if using. Simmer until the vegetables are tender and the sauce has thickened.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Add the fish and its marinade. Simmer gently until the fish is opaque and flakes easily, or reaches 145°F on a food thermometer.",
      "timer_minutes": 6
    },
    {
      "step": 6,
      "text": "Fold in the chopped coriander or mint, adjust with the remaining lime, and serve with the cooked rice."
    }
  ],
