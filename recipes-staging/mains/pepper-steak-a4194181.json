  "instructions": [
    {
      "step": 1,
      "text": "Warm the oil in a large covered skillet over medium heat. Add the green and red peppers, season with salt and pepper, and cook for 10 minutes, stirring occasionally, until tender. Transfer the peppers to a plate.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the steak and grated onion to the skillet. Cook for 10 minutes, stirring, until the beef is browned.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Return the peppers to the skillet and stir in the crushed tomatoes, water, sugar, and additional salt and pepper as needed."
    },
    {
      "step": 4,
      "text": "Cover and simmer gently for 45 minutes, or until the beef is tender and reaches at least 145°F in the thickest pieces. Let the beef rest for 3 minutes before serving.",
      "timer_minutes": 45
    }
  ],
