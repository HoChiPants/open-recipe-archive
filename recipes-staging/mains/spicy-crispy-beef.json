  "instructions": [
    {
      "step": 1,
      "text": "Whisk the soy sauce, rice vinegar, rice wine, honey, granulated sugar, chile paste, water, and ginger together for the sauce."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a saucepan. Add the garlic, onion, and red bell pepper; cook until softened. Stir in the sauce mixture and simmer until slightly thickened and set aside.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Heat the frying oil to 375°F in a deep, heavy pot."
    },
    {
      "step": 4,
      "text": "Season the cornstarch with salt and black pepper. Coat the sliced flank steak evenly, shaking off excess."
    },
    {
      "step": 5,
      "text": "Fry the beef in batches until crisp and golden brown. Drain on a rack, then confirm the thickest pieces reach 145°F; rest for 3 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Warm the sauce if needed, add the fried beef, and toss until evenly glazed.",
      "timer_minutes": 5
    }
  ],
