      "item": "mushrooms",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "diced"
    },
    {
      "ingredient_id": "frozen-shrimp",
      "item": "frozen shrimp",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, deveined and tails removed, thawed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the fettuccine in salted water for about 8 minutes, or until tender. Drain and set aside.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Melt butter with the cream in a saucepan over medium heat. Add the Romano, Parmesan, divided garlic, salt, and pepper; stir for about 5 minutes, until the cheeses are incorporated.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Heat the remaining butter and olive oil in a skillet. Add the onion and cook for 3 minutes. Stir in the remaining garlic and mushrooms, then cook for 2 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the thawed shrimp and cook for about 2 minutes, until opaque. If using a thermometer, verify the shrimp reaches 145°F.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Fold the shrimp and mushroom mixture into the sauce, add the drained pasta, and toss to coat."
    }
  ],
