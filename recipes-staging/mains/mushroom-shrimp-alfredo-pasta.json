  "id": "mushroom-shrimp-alfredo-pasta",
  "name": "Mushroom Shrimp Alfredo Pasta",
  "subtitle": "Creamy fettuccine with sautéed mushrooms and shrimp",
  "description": "Fettuccine is coated in a Romano-Parmesan cream sauce and finished with garlic, mushrooms, onion, and tender shrimp.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "dry-fettuccine-pasta",
      "item": "dry fettuccine pasta",
      "quantity": 1,
      "unit": "box",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1.25,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "pint"
    },
    {
      "ingredient_id": "grated-romano-cheese",
      "item": "grated Romano cheese",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
