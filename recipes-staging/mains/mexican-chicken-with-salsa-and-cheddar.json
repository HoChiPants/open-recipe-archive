    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly coat a baking dish with cooking spray and preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine the minced garlic, salt, black pepper, and cumin. Rub the mixture over the chicken breasts."
    },
    {
      "step": 3,
      "text": "Arrange the chicken in the prepared dish and bake for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Spoon the salsa over the chicken and cover with the shredded Cheddar."
    },
    {
      "step": 5,
      "text": "Continue baking until the cheese is melted and the chicken reaches 165°F in the thickest part, about 20 minutes.",
      "timer_minutes": 20
    }
  ],
