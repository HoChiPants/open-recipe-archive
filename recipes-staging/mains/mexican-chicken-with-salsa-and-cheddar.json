  "id": "mexican-chicken-with-salsa-and-cheddar",
  "name": "Mexican Chicken with Salsa and Cheddar",
  "subtitle": "Oven-baked chicken finished with salsa and melted cheese",
  "description": "Seasoned chicken breasts bake under a savory salsa topping and shredded Cheddar for a simple weeknight main dish.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
