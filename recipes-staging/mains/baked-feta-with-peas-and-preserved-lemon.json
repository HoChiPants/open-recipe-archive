  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Place the feta in a baking dish and add the olive oil, chilli, preserved lemon, and lemon zest."
    },
    {
      "step": 2,
      "text": "Bake for 20 minutes, until the feta is hot and softened.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Cook the podded peas until tender, then drain well for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Toss the peas with the chopped mint and lemon juice, then spoon them around the baked feta."
    },
    {
      "step": 5,
      "text": "Finish with the remaining mint and a drizzle of olive oil. Serve with crusty bread."
    }
  ],
