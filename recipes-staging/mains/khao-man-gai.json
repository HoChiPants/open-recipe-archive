  "instructions": [
    {
      "step": 1,
      "text": "Bring the water to a simmer in a large pot. Add the whole chicken, chopped fresh ginger root, head garlic, sugar, salt, coarsely chopped ginger, chopped garlic, chicken broth, and pickled garlic."
    },
    {
      "step": 2,
      "text": "Return the liquid to a simmer, cover, and cook until the chicken reaches 165°F in the thickest part of the breast and thigh, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 3,
      "text": "Transfer the chicken to a tray and reserve the cooking broth. Let both stand for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Heat the coconut oil in a pot. Add fresh ginger root, head garlic, coarsely chopped ginger, pandan leaves, chopped garlic, shallots, and pickled garlic; stir until aromatic."
    },
    {
      "step": 5,
      "text": "Add the jasmine rice and stir to coat it with the aromatics. Pour in the reserved broth, stir, cover, and cook until the rice is tender and set."
    },
    {
      "step": 6,
      "text": "Combine the remaining fresh ginger root, head garlic, coarsely chopped ginger, chopped garlic, red Thai chile peppers, pickled garlic, fermented soybeans, white vinegar, and thin soy sauce. Blend until smooth."
    },
    {
      "step": 7,
      "text": "Cut the cooked chicken into serving pieces and arrange it over the rice. Serve with the sauce, cilantro, and cucumber slices."
    }
  ],
