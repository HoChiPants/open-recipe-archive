  "id": "sweet-sesame-slaw",
  "name": "Sweet Sesame Slaw",
  "subtitle": "Crunchy cabbage salad with a honey-sesame dressing",
  "description": "A crisp cabbage slaw combining jicama, carrot, and black sesame with a creamy, lightly sweet dressing. Chill before serving for the best texture and flavor.",
  "meal_type": "main",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
