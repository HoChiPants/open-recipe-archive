  },
  "ingredients": [
    {
      "ingredient_id": "head-green-cabbage",
      "item": "head green cabbage",
      "quantity": 1,
      "preparation": "shredded"
    },
    {
      "ingredient_id": "carrot",
      "item": "carrot",
      "quantity": 1,
      "unit": "large",
      "preparation": "grated"
    },
    {
      "ingredient_id": "grated-jicama",
      "item": "grated jicama",
      "quantity": 1,
      "unit": "cup"
    },
    {
