      "item": "mayonnaise",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "rice-vinegar",
      "item": "rice vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the shredded cabbage, grated carrot, jicama, black sesame seeds, and sesame oil in a large bowl."
    },
    {
      "step": 2,
      "text": "In a separate bowl, whisk the mayonnaise, rice vinegar, sesame oil, and honey until smooth."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the vegetables and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Cover and refrigerate for 4 hours before serving.",
      "timer_minutes": 240
    }
  ],
