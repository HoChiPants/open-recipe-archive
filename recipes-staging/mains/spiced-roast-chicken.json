  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Pat the chicken dry and place it breast-side up in a roasting pan."
    },
    {
      "step": 3,
      "text": "Rub the chicken with olive oil. Combine the salt, black pepper, oregano, basil, paprika, and cayenne, then coat the chicken evenly with the mixture."
    },
    {
      "step": 4,
      "text": "Roast at 450°F for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Reduce the oven temperature to 400°F and continue roasting for 40 minutes, or until a thermometer inserted into the thickest part of the thigh reads 165°F.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Let the chicken rest for 15 minutes before carving.",
      "timer_minutes": 15
    }
  ],
