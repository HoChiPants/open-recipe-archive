  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Rub the cauliflower with the rapeseed oil and roast until tender.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "While it roasts, cook the onions in a saucepan until softened. Add the garlic, mace, picked thyme leaves, and flour; stir for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Gradually stir in the almond milk. Simmer, stirring, until the sauce thickens, then mix in the soya cream and mustard."
    },
    {
      "step": 4,
      "text": "Combine the breadcrumbs and flaked almonds for the topping."
    },
    {
      "step": 5,
      "text": "Transfer the roasted cauliflower to a baking dish, pour the sauce over it, and add the whole thyme sprigs."
    },
    {
      "step": 6,
      "text": "Top with the breadcrumb mixture and bake until bubbling, thickened, and golden.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Serve with vegan garlic bread and a green salad with a lemony dressing."
    }
  ],
