  "id": "baked-bacon-ranch-chicken",
  "name": "Baked Bacon Ranch Chicken",
  "subtitle": "Tender chicken with bacon, creamy dressing, and Parmesan",
  "description": "Chicken breasts are baked beneath a savory sauce, crisp bacon, tender onion, and a Parmesan topping.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "thick-cut-bacon",
      "item": "thick cut bacon",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 6,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "stir-fry-sauce",
      "item": "stir-fry sauce",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ranch-style-salad-dressing",
      "item": "Ranch-style salad dressing",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the bacon in a skillet until crisp. Drain, crumble, and set aside."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in the skillet and sauté the chopped onion until tender."
    },
    {
      "step": 4,
      "text": "Arrange the chicken breast halves in a baking dish. Stir together the stir-fry sauce and Ranch-style dressing, then pour the mixture over the chicken."
    },
    {
      "step": 5,
      "text": "Scatter the bacon, onion, and Parmesan over the top."
    },
    {
      "step": 6,
      "text": "Bake until the chicken is cooked through and reaches 165°F in the thickest part, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
