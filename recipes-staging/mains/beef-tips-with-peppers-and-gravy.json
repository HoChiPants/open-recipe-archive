  "id": "beef-tips-with-peppers-and-gravy",
  "name": "Beef Tips with Peppers and Gravy",
  "subtitle": "Tender beef simmered with peppers, onions, and savory gravy.",
  "description": "Beef tenderloin chunks cook with sliced vegetables, broth, garlic, and Worcestershire sauce before being finished with thick brown gravy.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
