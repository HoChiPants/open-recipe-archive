      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "beef-tenderloin",
      "item": "beef tenderloin",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "trimmed and cut into chunks"
    },
