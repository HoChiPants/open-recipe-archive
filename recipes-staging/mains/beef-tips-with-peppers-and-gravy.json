  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Add the beef, bell pepper, onion, steak seasoning, salt and pepper, and broth."
    },
    {
      "step": 2,
      "text": "Stir and cook until the vegetables soften and the beef reaches 145°F in the thickest pieces. Remove the beef and vegetables, reserving the cooking liquid, and rest the beef for 3 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Return the skillet to the heat and add the reserved liquid, garlic, Worcestershire sauce, and bay leaf. Simmer, then return the beef and vegetables to the skillet.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the dry brown gravy mix and cook until the sauce thickens and the beef is cooked through.",
      "timer_minutes": 10
    }
  ],
