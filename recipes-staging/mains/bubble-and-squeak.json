    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the sliced cabbage in boiling water until tender, about 5 minutes. Drain well.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Cook the diced bacon and sliced onion in a skillet until the bacon is crisp and the onion is softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the cabbage, butter, ham, and potatoes to the skillet. Season with paprika, salt, and pepper, then toss to combine."
    },
    {
      "step": 4,
      "text": "Cook the mixture until heated through and lightly browned, stirring occasionally."
    }
  ],
