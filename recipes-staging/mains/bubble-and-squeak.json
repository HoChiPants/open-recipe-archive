  "id": "bubble-and-squeak",
  "name": "Bubble and Squeak",
  "subtitle": "A hearty skillet of cabbage, potatoes, bacon, and ham",
  "description": "Tender cabbage combines with crisp bacon, onion, ham, and sliced potatoes for a savory one-pan main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
