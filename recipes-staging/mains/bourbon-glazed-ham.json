  "instructions": [
    {
      "step": 1,
      "text": "Place the ham in a suitable baking dish or roasting pan."
    },
    {
      "step": 2,
      "text": "Add the bourbon, brown sugar, crushed pineapple with its juice, honey, garlic, and pineapple rings around the ham. Cover and chill for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 4,
      "text": "Pour the water into the pan and arrange the pineapple rings over or around the ham."
    },
    {
      "step": 5,
      "text": "Bake for about 90 minutes, basting with the pan juices as needed, until the thickest part reaches 145°F on a food thermometer.",
      "timer_minutes": 90
    },
    {
      "step": 6,
      "text": "Rest the ham for 3 minutes before slicing and serving.",
      "timer_minutes": 3
    }
  ],
