    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "haddock-fillets",
      "item": "haddock fillets",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "mild-cheddar-cheese",
      "item": "mild Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Arrange the haddock fillets in a baking dish and season with salt and pepper."
    },
    {
      "step": 3,
      "text": "Layer the sliced onion over the fish."
    },
    {
      "step": 4,
      "text": "Whisk together the condensed mushroom soup and shredded Cheddar, then spread the mixture over the onion and fish."
    },
    {
      "step": 5,
      "text": "Bake for 40 minutes, until the fish reaches 145°F or is opaque and flakes easily.",
      "timer_minutes": 40
    }
  ],
