  "id": "haddock-bake",
  "name": "Haddock Bake",
  "subtitle": "Tender fish baked with creamy mushroom sauce and Cheddar",
  "description": "Haddock fillets are layered with onion and covered in a creamy mushroom-cheese sauce before baking until flaky.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
