  "id": "spicy-pesto-chicken-with-farfalle",
  "name": "Spicy Pesto Chicken with Farfalle",
  "subtitle": "Chile-kissed chicken tossed with pesto and bow-tie pasta",
  "description": "A quick, creamy-tasting pasta dinner with basil pesto, Parmesan, cilantro, and a lively chile accent.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "uncooked-farfalle-bow-tie-pasta",
      "item": "uncooked farfalle (bow tie) pasta",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "hot-chile-paste-such-as-sambal-oelek",
      "item": "hot chile paste (such as sambal oelek)",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 1,
      "unit": "pound",
      "preparation": "boneless chicken breast halves - cut into 1 inch pieces"
    },
    {
      "ingredient_id": "prepared-basil-pesto",
      "item": "prepared basil pesto",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cilantro",
      "item": "cilantro",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the farfalle in boiling water until tender, about 10 minutes; drain well.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Warm the olive oil in a large skillet, then stir in the chile paste."
    },
    {
      "step": 3,
      "text": "Add the chicken and cook, stirring often, until browned and the thickest pieces reach 165°F on a food thermometer, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Toss the drained pasta with the chicken mixture, pesto, Parmesan, and cilantro. Serve hot."
    }
  ],
