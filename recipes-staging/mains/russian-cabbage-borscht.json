  "instructions": [
    {
      "step": 1,
      "text": "Bring the vegetable stock or water to a simmer. Add the potatoes and beets, and simmer until tender. Set them aside, reserving the cooking liquid."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large pot over medium heat. Stir in the onions, caraway seed, and salt, then cook until the onions soften."
    },
    {
      "step": 3,
      "text": "Add the celery, carrot, and red cabbage. Stir to coat, then pour in the reserved cooking liquid."
    },
    {
      "step": 4,
      "text": "Cook the cabbage mixture until the vegetables are tender.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Return the potatoes and beets to the pot. Season with black pepper and dill, then stir in the cider vinegar, honey, and tomato puree."
    },
    {
      "step": 6,
      "text": "Let the soup stand for 30 minutes before serving.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Top each serving with sour cream and chopped tomatoes."
    }
  ],
