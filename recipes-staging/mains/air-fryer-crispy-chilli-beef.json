  "instructions": [
    {
      "step": 1,
      "text": "Toss the beef with the cornflour and the matchstick ginger until evenly coated. Arrange the strips in a single layer in the air-fryer basket and drizzle with the vegetable oil."
    },
    {
      "step": 2,
      "text": "Preheat the air fryer according to the appliance instructions, then cook the beef for 6 minutes, turning halfway, until crisp and cooked through. For food safety, check that whole-cut beef reaches 145°F and rest for 3 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "While the beef cooks, mix the vinegar, 1 tablespoon soy sauce, sweet chilli sauce, ketchup, five-spice powder, the remaining soy sauce, sesame oil, and sugar."
    },
    {
      "step": 4,
      "text": "Heat the oil drizzle in a pan. Add the garlic, remaining ginger, chilli, red pepper, and the white spring-onion pieces; cook for 3 minutes, stirring, until fragrant and just tender.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the vinegar mixture and toss in the cooked beef. Stir until coated, then serve with the green spring-onion pieces."
    }
  ],
