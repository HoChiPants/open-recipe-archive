  "id": "pasta-with-arugula-and-tomatoes",
  "name": "Pasta with Arugula and Tomatoes",
  "subtitle": "Spaghetti with warm tomatoes, peppery greens, and Parmesan",
  "description": "Toss spaghetti with garlic-sautéed cherry tomatoes and wilted arugula, then finish with Parmesan.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "spaghetti",
      "item": "spaghetti",
      "quantity": 10,
      "unit": "ounces"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "cherry-tomatoes",
      "item": "cherry tomatoes",
      "quantity": 1,
      "unit": "pint",
      "preparation": "halved"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "arugula",
      "item": "arugula",
      "quantity": 1,
      "unit": "package",
      "preparation": "5 ounce, torn"
    },
    {
      "ingredient_id": "shaved-parmesan-cheese",
      "item": "shaved Parmesan cheese",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of salted water to a boil. Cook the spaghetti for 12 minutes, or until tender, then drain.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Heat the olive oil with the minced garlic for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the halved cherry tomatoes and cook for 7 minutes, until lightly browned. Season with salt and freshly ground black pepper.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Stir in the torn arugula until warmed and slightly wilted."
    },
    {
      "step": 5,
      "text": "Combine the drained spaghetti with the tomato mixture and olive oil. Serve topped with shaved Parmesan cheese."
    }
  ],
