    "inactive_minutes": 750
  },
  "ingredients": [
    {
      "ingredient_id": "18-pound-whole-turkey",
      "item": "(18 pound) whole turkey",
      "quantity": 1,
      "preparation": "neck and giblets removed"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted, divided"
    },
    {
