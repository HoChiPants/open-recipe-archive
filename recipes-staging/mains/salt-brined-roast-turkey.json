      "quantity": 4,
      "preparation": "coarsely chopped, divided"
    },
    {
      "ingredient_id": "stalks-celery",
      "item": "stalks celery",
      "quantity": 4,
      "preparation": "chopped, divided"
    },
    {
      "ingredient_id": "sprigs-fresh-thyme",
      "item": "sprigs fresh thyme",
      "quantity": 2,
      "preparation": "divided"
    },
    {
      "ingredient_id": "bay-leaf",
      "item": "bay leaf",
      "quantity": 1
    },
    {
      "ingredient_id": "dry-white-wine",
      "item": "dry white wine",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pat the turkey dry and rub it thoroughly with the kosher salt, including the cavity. Place it on a rack over a tray and refrigerate uncovered for 12 hours.",
      "timer_minutes": 720
    },
    {
      "step": 2,
      "text": "Remove the turkey from the refrigerator and let it stand while the oven heats to 350°F."
    },
    {
      "step": 3,
      "text": "Pat the turkey dry again. Brush the skin with some of the melted butter and place the bird breast-side up on a rack in a roasting pan."
    },
    {
      "step": 4,
      "text": "Scatter the onions, carrots, celery, thyme, and bay leaf in the pan. Place some of the thyme inside the cavity, then pour in the wine."
    },
    {
      "step": 5,
      "text": "Roast for 4 hours, basting occasionally with the remaining melted butter and pan juices, until a thermometer in the thickest part of the breast and thigh reads 165°F.",
      "timer_minutes": 240
    },
    {
      "step": 6,
      "text": "Transfer the turkey to a carving board and rest for 30 minutes before carving.",
      "timer_minutes": 30
    }
  ],
