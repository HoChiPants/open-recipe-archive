  "id": "salt-brined-roast-turkey",
  "name": "Salt-Brined Roast Turkey",
  "subtitle": "A crisp-skinned centerpiece with herb-scented pan juices",
  "description": "Dry-brine a whole turkey overnight, then roast it over vegetables, herbs, and wine until the meat reaches a safe temperature.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
