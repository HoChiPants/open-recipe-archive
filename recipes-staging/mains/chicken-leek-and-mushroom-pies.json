{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chicken-leek-and-mushroom-pies",
  "name": "Chicken, Leek, and Mushroom Pies",
  "subtitle": "Creamy chicken filling beneath crisp pastry",
  "description": "Individual savory pies filled with chicken, leeks, mushrooms, stock, cream, and lemon, then finished with pastry and baked until golden.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "individual pies"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "leeks-washed-and-finely-sliced",
      "item": "leeks washed and finely sliced",
      "quantity": 3
    },
    {
      "ingredient_id": "thyme-sprig",
      "item": "thyme sprig",
      "quantity": 1
    },
    {
      "ingredient_id": "button-mushrooms-sliced",
      "item": "button mushrooms sliced",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "dried-porcini-mushrooms-roughly-crumbled",
      "item": "dried porcini mushrooms roughly crumbled",
      "quantity": 20,
      "unit": "g"
    },
    {
      "ingredient_id": "skinless-and-boneless-chicken-thighs",
      "item": "skinless and boneless chicken thighs",
      "quantity": 6,
      "preparation": "cut into chunks"
    },
    {
      "ingredient_id": "flour",
      "item": "flour",
      "quantity": 30,
      "unit": "g"
    },
    {
      "ingredient_id": "splash-of-white-wine-optional",
      "item": "splash of white wine (optional)",
      "optional": true
    },
    {
      "ingredient_id": "chicken-stock",
      "item": "chicken stock",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "quantity-pie-pastry-see-goes-well-with-below",
      "item": "quantity pie pastry (see 'Goes well with' below)",
      "quantity": 1,
      "preparation": "or use shop-bought"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven and six individual pie dishes according to the pastry directions."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large pan. Add the leeks and thyme, and cook gently until the leeks soften.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Add both mushrooms and the chicken, stirring until the mushrooms begin to soften and the chicken starts to color.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the flour and cook briefly to remove its raw taste.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Gradually whisk in the optional wine, stock, cream, and lemon juice. Simmer until the sauce thickens and the chicken is cooked through; check that the thickest pieces reach 165°F.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Remove the thyme and divide the filling among the pie dishes. Chill until cool enough to cover."
    },
    {
      "step": 7,
      "text": "Cover each dish with pastry, trim the edges, and bake until the pastry is puffed and golden and the filling is hot throughout."
    }
  ],
