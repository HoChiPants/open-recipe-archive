  "instructions": [
    {
      "step": 1,
      "text": "Heat the grill to high. Toss the chicken thighs with the za’atar, chilli flakes, and 1 tablespoon of the olive oil."
    },
    {
      "step": 2,
      "text": "Grill the chicken for 15 minutes, turning once, until cooked through and the thickest piece reaches 165°F on a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Brush the aubergine rounds with the remaining olive oil and grill for about 6 minutes, turning once, until tender and lightly charred.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Chop the parsley. Stir together the yogurt, mayonnaise, garlic, and half the parsley to make the sauce."
    },
    {
      "step": 5,
      "text": "Toss the remaining parsley with the onion and lemon juice."
    },
    {
      "step": 6,
      "text": "Warm the pittas, then fill them with sliced chicken, aubergine, parsley-onion salad, yogurt sauce, hummus, sliced chilli, and pickled gherkins."
    }
  ],
