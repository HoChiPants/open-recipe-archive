  "id": "chicken-and-aubergine-shawarma-pittas",
  "name": "Chicken and Aubergine Shawarma Pittas",
  "subtitle": "Spiced chicken and grilled aubergine with herbed yogurt",
  "description": "Warm pitta breads filled with za’atar-seasoned chicken, tender aubergine, fresh parsley, and creamy yogurt sauce.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
