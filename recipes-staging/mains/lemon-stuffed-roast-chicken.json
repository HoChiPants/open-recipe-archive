  "id": "lemon-stuffed-roast-chicken",
  "name": "Lemon-Stuffed Roast Chicken",
  "subtitle": "A citrus-scented roast with savory stuffing",
  "description": "A whole chicken filled with lemon and stuffing, seasoned with herbs and paprika, then roasted until safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "3-pound-whole-chicken",
      "item": "(3 pound) whole chicken",
      "quantity": 1
    },
    {
      "ingredient_id": "stuffing-mix",
      "item": "stuffing mix",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemons",
      "quantity": 2
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-rosemary",
      "item": "dried rosemary",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-sage",
      "item": "dried sage",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cut the lemons into halves or wedges. Combine the stuffing mix with the olive oil, then place it in and around the chicken as appropriate, reserving any needed to fill the cavity."
    },
    {
      "step": 3,
      "text": "Place the chicken in a roasting pan. Mix the salt, paprika, rosemary, and sage, and rub the mixture over the chicken."
    },
    {
      "step": 4,
      "text": "Roast for 120 minutes, or until the thickest part of the chicken and the center of the stuffing reach 165°F on a food thermometer.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Let the chicken rest briefly before carving and serving."
    }
  ],
