  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 390°F."
    },
    {
      "step": 2,
      "text": "Stir the melted butter and minced garlic together."
    },
    {
      "step": 3,
      "text": "Lightly coat the air-fryer basket with cooking spray. Place the salmon fillets skin-side down in the basket."
    },
    {
      "step": 4,
      "text": "Brush the fillets with the garlic butter, then sprinkle with lemon-pepper seasoning and dried parsley. Arrange the lemon slices over and around the salmon."
    },
    {
      "step": 5,
      "text": "Air-fry for 10 minutes, or until the salmon reaches 145°F internally and flakes easily.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Rest the salmon for 2 minutes before serving.",
      "timer_minutes": 2
    }
  ],
