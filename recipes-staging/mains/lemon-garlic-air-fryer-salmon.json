  "id": "lemon-garlic-air-fryer-salmon",
  "name": "Lemon-Garlic Air Fryer Salmon",
  "subtitle": "Tender salmon with bright lemon and garlic butter",
  "description": "Seasoned salmon fillets cook quickly in the air fryer with lemon slices for a simple, savory main dish.",
  "meal_type": "main",
  "cuisine": "American",
