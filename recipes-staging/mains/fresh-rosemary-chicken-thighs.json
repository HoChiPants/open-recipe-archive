  "id": "fresh-rosemary-chicken-thighs",
  "name": "Fresh Rosemary Chicken Thighs",
  "subtitle": "Lemon-rosemary baked chicken",
  "description": "Chicken thighs are seasoned with rosemary, lemon zest, salt, and pepper, then baked until tender and safely cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-rosemary-leaves",
      "item": "fresh rosemary leaves",
      "quantity": 1.5,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "chicken-thighs",
      "item": "chicken thighs",
      "quantity": 4
    },
    {
      "ingredient_id": "olive-oil-cooking-spray",
      "item": "olive oil cooking spray"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the rosemary, lemon zest, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Lightly coat a baking dish with olive oil cooking spray and arrange the chicken thighs inside. Sprinkle the seasoning mixture over the chicken."
    },
    {
      "step": 4,
      "text": "Bake for 35 minutes, or until the thickest part of each thigh reaches 165°F on a food thermometer.",
      "timer_minutes": 35
    }
  ],
