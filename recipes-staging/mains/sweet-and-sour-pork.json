  "id": "sweet-and-sour-pork",
  "name": "Sweet and Sour Pork",
  "subtitle": "Tender pork with vegetables, pineapple, and tangy sauce",
  "description": "Cubed pork simmers with crisp vegetables, pineapple, and a glossy sweet-and-sour sauce for a simple Asian-inspired main dish.",
  "meal_type": "main",
  "cuisine": "Asian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
