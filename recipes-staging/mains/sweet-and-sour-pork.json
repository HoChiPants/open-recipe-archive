    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kikkoman-soy-sauce",
      "item": "Kikkoman Soy Sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "boneless-pork",
      "item": "boneless pork",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into 1-inch cubes"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 2,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chunked"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 1,
      "preparation": "cut into 1-inch squares"
    },
    {
      "ingredient_id": "kikkoman-sweet-sour-sauce",
      "item": "Kikkoman Sweet & Sour Sauce",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "pineapple-chunks",
      "item": "pineapple chunks",
      "quantity": 1,
      "unit": "can",
      "preparation": "8 ounce, drained"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cornstarch, soy sauce, and sweet-and-sour sauce until smooth. Toss the pork with the mixture to coat."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large skillet over medium-high heat. Add the pork and cook, stirring, until browned."
    },
    {
      "step": 3,
      "text": "Stir in the carrots, onion, and bell pepper. Bring the mixture to a simmer and cook until the vegetables begin to soften.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Continue simmering until the pork reaches 145°F in the center. Remove from the heat and let it rest for 3 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Fold in the drained pineapple and stir gently before serving."
    }
  ],
