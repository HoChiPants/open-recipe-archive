  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Cut the sweet potato and sweet onion into bite-size pieces, then place them in a microwave-safe baking dish."
    },
    {
      "step": 3,
      "text": "Microwave the sweet potato and onion for 10 minutes, or until they begin to soften.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Cut the carrots and apple into bite-size pieces and add them to the dish. Stir in the barbecue sauce and dried cranberries."
    },
    {
      "step": 5,
      "text": "Arrange the chicken breast halves over the vegetables. Bake for 55 minutes, until the vegetables are tender and the chicken reaches 165°F in the thickest part.",
      "timer_minutes": 55
    },
    {
      "step": 6,
      "text": "Let the dish rest for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
