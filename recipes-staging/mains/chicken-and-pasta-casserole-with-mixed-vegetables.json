  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Bring a pot of salted water to a boil. Cook the fusilli for 12 minutes, then drain.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a skillet. Add the chicken and cook until no longer pink. Stir in both soups, dried onion, basil, parsley, garlic powder, and salt and pepper."
    },
    {
      "step": 4,
      "text": "Whisk in the cooked pasta and frozen vegetables until evenly coated."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to a baking dish."
    },
    {
      "step": 6,
      "text": "Combine the bread crumbs, Parmesan, and melted butter. Sprinkle the topping over the casserole."
    },
    {
      "step": 7,
      "text": "Bake for 30 minutes, until lightly browned and the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 30
    }
  ],
