  "id": "sour-cream-enchiladas",
  "name": "Sour Cream Enchiladas",
  "subtitle": "Chicken enchiladas with creamy green chile sauce",
  "description": "Flour tortillas filled with seasoned chicken, onion, and Cheddar are covered in a sour cream, green chile, and chicken soup sauce, then baked until hot and topped with melted cheese.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "skinless-boneless-chicken-breasts",
      "item": "skinless boneless chicken breasts",
      "quantity": 2,
      "preparation": "cut into 1-inch cubes"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "10-inch-flour-tortillas",
      "item": "(10 inch) flour tortillas",
      "quantity": 12
    },
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "green-chiles",
      "item": "green chiles",
      "quantity": 1,
      "unit": "can",
      "preparation": "3 ounce, chopped, undrained"
    },
    {
      "ingredient_id": "8-ounce-container-sour-cream",
      "item": "(8 ounce) container sour cream",
      "quantity": 1
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the chicken and condensed soup together in a skillet over medium heat for 10 minutes, until the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Combine the remaining condensed soup with the sour cream and green chiles in a bowl; whisk until smooth."
    },
    {
      "step": 4,
      "text": "Fill each tortilla with the cooked chicken mixture, onion, and 1.5 cups of Cheddar. Roll and arrange seam-side down in a baking dish."
    },
    {
      "step": 5,
      "text": "Pour the sour cream sauce over the tortillas and sprinkle with the remaining Cheddar."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until the cheese is melted and the enchiladas are hot throughout.",
      "timer_minutes": 25
    }
  ],
