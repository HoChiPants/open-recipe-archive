  "instructions": [
    {
      "step": 1,
      "text": "Heat the ghee or coconut oil in a large pot over medium heat."
    },
    {
      "step": 2,
      "text": "Add the onions, mustard seeds, curry leaves, and nigella seeds. Cook, stirring occasionally, for 10 minutes until the onions soften.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the garlic, ginger, chilli, turmeric, coriander, and cumin. Cook briefly until fragrant."
    },
    {
      "step": 4,
      "text": "Add the vegetable stock, coconut milk, and rinsed lentils, stirring to combine."
    },
    {
      "step": 5,
      "text": "Bring to a simmer, then cook uncovered for about 40 minutes, stirring occasionally, until the lentils are tender and the mixture is saucy.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Adjust the consistency with a little water if needed, then portion for serving or storage."
    }
  ],
