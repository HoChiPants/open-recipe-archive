  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Line a sheet pan with parchment or lightly oil it."
    },
    {
      "step": 2,
      "text": "Stir the chili powder, paprika, cumin, onion powder, 1 teaspoon kosher salt, and 1/2 teaspoon pepper together. Coat the mahi mahi with the spice mixture and 3 tablespoons olive oil, then arrange the fillets on the pan."
    },
    {
      "step": 3,
      "text": "Bake the fish for 12 minutes, or until it reaches 145°F and flakes easily with a fork.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Toss the coleslaw mix, cilantro, jalapeño, 2 tablespoons olive oil, lime juice, vinegar, garlic powder, 1/4 teaspoon kosher salt, and 1/4 teaspoon pepper in a bowl."
    },
    {
      "step": 5,
      "text": "Whisk the sour cream, chopped chipotle, adobo sauce, and remaining 1/4 teaspoon kosher salt until smooth."
    },
    {
      "step": 6,
      "text": "Warm the tortillas. Divide the fish among them, top with slaw and sauce, and serve with lime wedges."
    }
  ],
