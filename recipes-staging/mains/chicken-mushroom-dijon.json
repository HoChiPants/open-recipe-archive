  "instructions": [
    {
      "step": 1,
      "text": "Place the milk and flour in separate shallow dishes. Season the chicken with salt and pepper, dip each piece in the milk, then coat it with flour."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large skillet over medium heat. Sauté the coated chicken for about 3 minutes per side, until golden brown and cooked through. Transfer to a plate.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Melt the butter in the skillet. Add the mushrooms and cook for 2 minutes, stirring occasionally.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the wine, chicken gravy, half-and-half, and Dijon mustard. Season with salt and pepper."
    },
    {
      "step": 5,
      "text": "Simmer the sauce for 2 minutes, return the chicken to the skillet, and cook for 5 minutes. Confirm the thickest part of each chicken breast reaches 165°F on a food thermometer before serving.",
      "timer_minutes": 5
    }
  ],
