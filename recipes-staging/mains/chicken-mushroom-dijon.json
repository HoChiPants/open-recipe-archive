  "id": "chicken-mushroom-dijon",
  "name": "Chicken Mushroom Dijon",
  "subtitle": "Pan-seared chicken with a creamy mustard mushroom sauce",
  "description": "Evenly pounded chicken breasts are lightly coated, browned, and finished with mushrooms in a creamy Dijon sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
