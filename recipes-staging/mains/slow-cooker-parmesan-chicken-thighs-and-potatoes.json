  "instructions": [
    {
      "step": 1,
      "text": "Combine the basil, oregano, rosemary, salt, and pepper, then season the chicken thighs."
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium-high heat. Add the chicken and cook until golden brown, about 3 minutes per side. Transfer the thighs to a plate.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Place the quartered potatoes in the slow cooker. Toss with the olive oil, garlic, thyme, and additional salt and pepper as needed."
    },
    {
      "step": 4,
      "text": "Arrange the seared chicken thighs over the potatoes. Cover and cook on low until the potatoes are tender and the thickest chicken pieces reach 165°F internally, about 7 hours 5 minutes.",
      "timer_minutes": 425
    },
    {
      "step": 5,
      "text": "Top with Parmesan and parsley, then serve hot."
    }
  ],
