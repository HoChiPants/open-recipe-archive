  "id": "kosher-cholent",
  "name": "Kosher Cholent",
  "subtitle": "A slow-cooked beef, bean, barley, and potato stew",
  "description": "Layer beef, beans, barley, and potatoes in a seasoned pot, then slowly cook until the meat and legumes are tender.",
  "meal_type": "main",
  "cuisine": "Jewish",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 600
  },
  "ingredients": [
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 3,
      "preparation": "quartered"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "chuck-roast",
      "item": "chuck roast",
      "quantity": 4,
      "unit": "pounds",
      "preparation": "cut into large chunks"
    },
    {
      "ingredient_id": "dry-kidney-beans",
      "item": "dry kidney beans",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "dried-pinto-beans",
      "item": "dried pinto beans",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "pearl-barley",
      "item": "pearl barley",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 5,
      "unit": "large",
      "preparation": "peeled and cut into thirds"
    },
    {
      "ingredient_id": "boiling-water-to-cover",
      "item": "boiling water to cover"
    },
    {
      "ingredient_id": "dry-onion-and-mushroom-soup-mix",
      "item": "dry onion and mushroom soup mix",
      "quantity": 2,
      "unit": "package",
      "preparation": "1 ounce"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large oven-safe pot. Add the onions and chuck roast, and cook until the onions begin to soften and the beef is browned."
    },
    {
      "step": 2,
      "text": "Add the kidney beans, pinto beans, pearl barley, potatoes, and enough boiling water to cover. Stir in the soup mix and garlic powder, then season with salt and pepper."
    },
    {
      "step": 3,
      "text": "Bring the pot to a boil and simmer for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Cover the pot and transfer it to an oven preheated to 200°F. Cook until the beans, barley, potatoes, and beef are tender, about 10 hours.",
      "timer_minutes": 600
    },
    {
      "step": 5,
      "text": "Add more boiling water if needed during cooking and stir gently. Before serving, verify that the beef reaches at least 145°F throughout, then let it rest for 3 minutes."
    },
    {
      "step": 6,
      "text": "Serve the cholent hot with the potatoes."
    }
  ],
