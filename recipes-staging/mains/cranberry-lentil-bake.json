  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Warm the dried cranberries with the red wine until softened, then transfer them to a baking dish and set aside."
    },
    {
      "step": 2,
      "text": "Prepare the cooked lentils. Heat the olive oil and cook the onion until softened.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Stir in the garlic, smoked paprika, and ground cloves. Add the lentils, tomato purée, soy sauce, cornflour, sage, and parsley; mix thoroughly."
    },
    {
      "step": 4,
      "text": "Combine the lentil mixture with the cranberries in the baking dish. Freeze the assembled dish if preparing it ahead, then prepare it for baking."
    },
    {
      "step": 5,
      "text": "Bake until hot and set.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Let the bake cool briefly before serving.",
      "timer_minutes": 1
    }
  ],
