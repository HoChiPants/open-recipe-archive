  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the rosemary, garlic salt, thyme, and black pepper. Rub the seasoning mixture evenly over the pork roast."
    },
    {
      "step": 3,
      "text": "Place the roast in a roasting pan and bake for 60 minutes, or until the center reaches 145°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Let the roast rest for 3 minutes before slicing and serving.",
      "timer_minutes": 3
    }
