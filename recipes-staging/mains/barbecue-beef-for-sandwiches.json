  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Place the chuck roast in an oven-safe roasting pan or Dutch oven and cook for 2 hours, until tender and the center reaches at least 145°F. Rest for 3 minutes before shredding.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan over medium heat. Add the onion and cook until softened."
    },
    {
      "step": 3,
      "text": "Stir in the chile sauce, vinegar, and Worcestershire sauce. Add the garlic, brown sugar, mustard powder, salt, black pepper, and cayenne."
    },
    {
      "step": 4,
      "text": "Cook the sauce, stirring occasionally, until thickened."
    },
    {
      "step": 5,
      "text": "Shred the rested beef and return it to the sauce. Stir to coat and cook for 30 minutes.",
      "timer_minutes": 30
    }
  ],
