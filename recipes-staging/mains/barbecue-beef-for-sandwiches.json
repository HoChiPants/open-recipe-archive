  "id": "barbecue-beef-for-sandwiches",
  "name": "Barbecue Beef for Sandwiches",
  "subtitle": "Tender shredded beef in a tangy barbecue sauce",
  "description": "Slow-cooked chuck roast is shredded and finished in a savory, sweet, and lightly spicy sauce for serving in sandwiches.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 150
  },
  "ingredients": [
