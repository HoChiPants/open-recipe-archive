      "ingredient_id": "boneless-chuck-roast",
      "item": "boneless chuck roast",
      "quantity": 4,
      "unit": "pounds"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
