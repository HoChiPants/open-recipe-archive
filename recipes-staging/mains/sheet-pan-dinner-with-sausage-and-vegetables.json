  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Coat a sheet pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Combine half the olive oil with the rosemary, half the salt, half the pepper, and the yellow bell pepper. Toss the potatoes with this mixture and arrange them on the pan."
    },
    {
      "step": 3,
      "text": "Roast the potatoes until tender, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Stir together the remaining olive oil, salt, and pepper with the onion flakes, smoked paprika, parsley, and oregano. Toss with the sausage, green beans, bell pepper, and onion until evenly coated."
    },
    {
      "step": 5,
      "text": "Add the roasted potatoes and sausage mixture to the pan, spreading everything into an even layer."
    },
    {
      "step": 6,
      "text": "Roast until the vegetables are tender and the sausage is hot throughout; if checked with a thermometer, the sausage should reach 165°F.",
      "timer_minutes": 25
    }
  ],
