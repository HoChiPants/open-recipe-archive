  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of salted water to a simmer. Cook the angel hair pasta in the boiling water for 5 minutes, then drain.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Melt half the butter in a skillet over medium heat. Add the frozen shrimp and cook for 5 minutes. Transfer the shrimp to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the remaining butter to the skillet. Stir in the onion and garlic, and cook until the onion softens, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Add the tomatoes and stir for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the drained pasta and asparagus. Simmer until the asparagus is tender, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Return the shrimp to the skillet and cook until opaque throughout, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 7,
      "text": "Season with salt and add the Parmesan. Serve with lemon wedges."
    }
  ],
