  "id": "garlic-angel-hair-shrimp",
  "name": "Garlic Angel Hair Shrimp",
  "subtitle": "Angel hair pasta with shrimp, asparagus, and Parmesan",
  "description": "Tender pasta and asparagus are tossed with garlic, tomatoes, butter, and shrimp, then finished with Parmesan and lemon.",
  "meal_type": "main",
  "cuisine": "American",
