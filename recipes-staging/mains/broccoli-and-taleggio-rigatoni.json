  "id": "broccoli-and-taleggio-rigatoni",
  "name": "Broccoli and Taleggio Rigatoni",
  "subtitle": "Creamy broccoli pasta with melted cheese",
  "description": "A quick rigatoni dish with finely blitzed broccoli, Taleggio, Parmesan, nutmeg, and a drizzle of olive oil.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "broccoli-blitzed-in-a-food-processor-until-very-fine",
      "item": "broccoli blitzed in a food processor until very fine",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "rigatoni",
      "item": "rigatoni",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "parmesan-finely-grated",
      "item": "parmesan finely grated",
      "quantity": 30,
      "unit": "g"
    },
    {
      "ingredient_id": "taleggio-cut-into-chunks",
      "item": "taleggio cut into chunks",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "grating-of-nutmeg",
      "item": "grating of nutmeg"
    },
    {
      "ingredient_id": "olive-oil-for-drizzling-optional",
      "item": "olive oil for drizzling"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Simmer the milk and finely blitzed broccoli together for 15 minutes, until the mixture is thickened and cohesive.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Cook the rigatoni in boiling water until al dente, then drain."
    },
    {
      "step": 3,
      "text": "Stir the rigatoni and Taleggio into the hot broccoli mixture and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Stir in the Parmesan and nutmeg until the cheese has melted and the sauce is smooth."
    },
    {
      "step": 5,
      "text": "Transfer to serving dishes, top with the remaining Taleggio, and drizzle with olive oil."
    }
  ],
