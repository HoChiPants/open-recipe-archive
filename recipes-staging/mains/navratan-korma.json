  "instructions": [
    {
      "step": 1,
      "text": "Heat part of the divided vegetable oil in a large skillet. Stir in the mixed nuts and cook until golden brown; transfer them to a bowl."
    },
    {
      "step": 2,
      "text": "Add the grated onion to the skillet and cook until tender. Add the garlic paste and ginger paste and stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Stir in the tomato sauce, cayenne pepper, ground turmeric, ground coriander, and garam masala. Add the water, raisins, carrots, green bell pepper, fresh green beans, green peas, and potatoes."
    },
    {
      "step": 4,
      "text": "Bring the vegetable mixture to a simmer, cover, and cook until the potatoes are tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Meanwhile, heat the remaining vegetable oil in a separate skillet and cook the cubed paneer until golden brown. Drain if needed."
    },
    {
      "step": 6,
      "text": "Stir the paneer, milk, and heavy cream into the vegetable mixture. Simmer for 3 minutes, then season with salt to taste and fold in the toasted nuts.",
      "timer_minutes": 3
    }
  ],
