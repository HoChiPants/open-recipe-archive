  "id": "air-fryer-roast-chicken",
  "name": "Air-Fryer Roast Chicken",
  "subtitle": "Crisp-skinned chicken with a smoky herb rub",
  "description": "A whole chicken coated in oil and a simple smoked paprika, herb, and garlic seasoning, then roasted in the air fryer until fully cooked.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "whole-chicken",
      "item": "whole chicken",
      "quantity": 2.25,
      "unit": "kg"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "smoked-paprika",
      "item": "smoked paprika",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "dried-mixed-herbs",
      "item": "dried mixed herbs",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "garlic-granules",
      "item": "garlic granules",
      "quantity": 1,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pat the chicken dry. Rub it all over with the vegetable oil."
    },
    {
      "step": 2,
      "text": "Mix the smoked paprika, dried mixed herbs, and garlic granules, then coat the chicken evenly with the mixture."
    },
    {
      "step": 3,
      "text": "Preheat the air fryer to 375°F for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Place the chicken in the air fryer and cook for 30 minutes. Turn the chicken, then continue cooking until the thickest part of the breast and thigh reaches 165°F.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Rest briefly before carving and serving."
    }
  ],
