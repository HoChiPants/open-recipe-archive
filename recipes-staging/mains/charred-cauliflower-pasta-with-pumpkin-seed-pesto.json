      "preparation": "parmesan or vegetarian alternative)"
    },
    {
      "ingredient_id": "bunch-of-roughly-chopped-soft-herbs-such-as-parsley-or-basil",
      "item": "bunch of roughly chopped soft herbs (such as parsley or basil)",
      "unit": "small"
    },
    {
      "ingredient_id": "lemon-zested-and-juiced",
      "item": "lemon zested and juiced",
      "quantity": "1/2"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Toss the cauliflower with olive oil and arrange it on a baking sheet."
    },
    {
      "step": 2,
      "text": "Roast the cauliflower until deeply browned and tender.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Cook the pasta according to the package directions, then drain."
    },
    {
      "step": 4,
      "text": "Warm olive oil in a skillet over medium heat. Cook the onion until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the crushed garlic and chilli flakes; stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Toast the pumpkin seeds and the whole garlic clove in the remaining olive oil until fragrant."
    },
    {
      "step": 7,
      "text": "Blend or finely process the toasted seeds and garlic with the cheese, herbs, lemon zest, and enough of the remaining oil to make a spoonable pesto."
    },
    {
      "step": 8,
      "text": "Toss the pasta with the cauliflower, onion, pesto, and lemon juice. Adjust the consistency with a little pasta water if needed."
    },
    {
      "step": 9,
      "text": "Serve warm."
    }
  ],
