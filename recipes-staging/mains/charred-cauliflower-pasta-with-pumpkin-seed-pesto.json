  "id": "charred-cauliflower-pasta-with-pumpkin-seed-pesto",
  "name": "Charred Cauliflower Pasta with Pumpkin Seed Pesto",
  "subtitle": "Roasted cauliflower and herb pesto tossed with pasta",
  "description": "Char cauliflower until browned, blend pumpkin seeds with herbs and cheese into a bright pesto, then toss everything with pasta and lemon.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
