  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven for baking potatoes. Lightly coat the potatoes with vegetable oil and bake until tender when pierced, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Mix the drained tuna with the celery, red onion, pepper, mayonnaise, mustard, lemon zest, and a little lemon juice."
    },
    {
      "step": 3,
      "text": "Cut the butter into four portions. Split the hot potatoes, add the butter, spoon in the tuna mixture, and finish with grated cheddar or mature crumbly cheese."
    },
    {
      "step": 4,
      "text": "Serve with coleslaw, sliced spring onions, cucumber, radishes, and crunchy dressed salad leaves."
    },
    {
      "step": 5,
      "text": "Canned tuna is ready to eat; if any fish is uncooked, cook it to 145°F and until opaque and easily flaked."
    }
  ],
