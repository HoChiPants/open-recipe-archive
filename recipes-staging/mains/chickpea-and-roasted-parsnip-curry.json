  "id": "chickpea-and-roasted-parsnip-curry",
  "name": "Chickpea and Roasted Parsnip Curry",
  "subtitle": "Roasted parsnips and chickpeas in a creamy coconut curry",
  "description": "Roast parsnips with cumin, then simmer them with chickpeas, coconut milk, onion, coriander, curry paste, and lime. Serve with yogurt, rice, or naan bread.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "parsnips-cut-into-batons-about-500g",
      "item": "parsnips cut into batons (about 500g)",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "vegetable-oil-or-sunflower-oil",
      "item": "vegetable oil or sunflower oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "cumin-seeds",
      "item": "cumin seeds",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "onion-chopped",
      "item": "onion chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "bunch-coriander-leaves-picked-and-stalks-very-finely-chopped",
      "item": "bunch coriander leaves picked and stalks very finely chopped"
    },
    {
      "ingredient_id": "curry-paste-we-used-balti",
      "item": "curry paste (we used balti)",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "x-400g-cans-chickpeas-drained",
      "item": "x 400g cans chickpeas drained",
      "quantity": 2
    },
    {
      "ingredient_id": "coconut-milk",
      "item": "coconut milk",
      "quantity": 400,
      "unit": "ml"
    },
    {
      "ingredient_id": "limes-1-juiced-and-1-cut-into-wedges",
      "item": "limes 1 juiced and 1 cut into wedges",
      "quantity": 2
    },
    {
      "ingredient_id": "yogurt-rice-or-naan-bread",
      "item": "yogurt rice or naan bread",
      "preparation": "to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Toss the parsnips and cumin seeds with the oil, reserving enough oil for the pan if needed, and spread on a baking sheet."
    },
    {
      "step": 2,
      "text": "Roast the parsnips until tender and browned, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Meanwhile, heat a large saucepan and cook the chopped onion and coriander stalks for about 15 minutes, stirring occasionally.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Stir in the curry paste, chickpeas, and coconut milk. Simmer for 10 minutes, stirring occasionally.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Fold in the roasted parsnips, chopped coriander leaves, and lime juice. Serve with lime wedges and yogurt, rice, or naan bread."
    }
  ],
