  "instructions": [
    {
      "step": 1,
      "text": "Make shallow cuts in the pork tenderloins to help the marinade penetrate."
    },
    {
      "step": 2,
      "text": "Blend the onion, thyme, vinegar, garlic, habaneros, ginger, soy sauce, oil, sugar, allspice, black pepper, cayenne, nutmeg, and cinnamon until smooth."
    },
    {
      "step": 3,
      "text": "Transfer the marinade to a shallow dish or sealable bag. Add the pork, turn to coat, cover, and refrigerate for 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 4,
      "text": "Preheat the grill."
    },
    {
      "step": 5,
      "text": "Grill the pork, turning about every 7 minutes, until the thickest part reaches 145°F.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Rest the pork for 3 minutes, then slice and serve.",
      "timer_minutes": 3
    }
  ],
