  "instructions": [
    {
      "step": 1,
      "text": "Toss the chicken with the lime juice, paprika, hot chilli powder, and green chilli. Set aside while you prepare the remaining ingredients.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Heat the oil in a large deep skillet or balti dish. Add the cinnamon, cardamom, green chilli, and cumin seed; cook until fragrant.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the grated onion, garlic, and ginger. Cook, stirring, until softened.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Stir in the turmeric, ground cumin, ground coriander, garam masala, and half of the fresh coriander.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Add the chicken and cook, stirring, until the pieces are coated and lightly colored.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Pour in the passata and add the red pepper. Bring to a gentle simmer, cover, and cook until the chicken is tender and reaches 165°F in the thickest pieces.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Stir in the chopped tomato and spinach. Cook until the spinach wilts and the sauce is hot.",
      "timer_minutes": 3
    },
    {
      "step": 8,
      "text": "Scatter with the remaining fresh coriander and serve with chapatis or basmati rice, if desired."
    }
  ],
