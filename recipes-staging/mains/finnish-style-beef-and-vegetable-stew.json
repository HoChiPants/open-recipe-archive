      "item": "stalks celery",
      "quantity": 2,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large heavy pot over medium heat. Add the beef roast and cook, turning as needed, until browned on the outside."
    },
    {
      "step": 2,
      "text": "Add 4 cups of the water, onion, salt, and pepper. Cover and cook gently for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Add the potatoes, carrots, and celery. Cover and simmer until the vegetables are tender and the beef reaches at least 145°F internally, then rest the beef for 3 minutes before slicing or serving."
    },
    {
      "step": 4,
      "text": "Whisk the remaining 0.5 cup water with the flour until smooth. Stir the mixture into the pot and cook for 15 minutes, stirring occasionally, until the broth thickens.",
      "timer_minutes": 15
    }
  ],
