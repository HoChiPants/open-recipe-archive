  "id": "finnish-style-beef-and-vegetable-stew",
  "name": "Finnish-Style Beef and Vegetable Stew",
  "subtitle": "A hearty one-pot stew with tender beef and root vegetables.",
  "description": "Beef cooks with onion, potatoes, carrots, and celery in a buttery broth finished with a simple flour slurry.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
