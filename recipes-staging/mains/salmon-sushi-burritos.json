      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "sriracha-or-to-taste",
      "item": "sriracha or to taste (optional)",
      "quantity": 1,
      "unit": "tsp",
      "optional": true
    },
    {
      "ingredient_id": "salmon-fillet-honey-roast-salmon-or-hot-smoked-salmon",
      "item": "salmon fillet honey-roast salmon or hot smoked salmon",
      "quantity": "100-140",
      "unit": "g",
      "preparation": "cooked, flaked"
    },
    {
      "ingredient_id": "packs-of-seaweed-thins",
      "item": "packs of seaweed thins",
      "quantity": 2
    },
    {
      "ingredient_id": "avocado-peeled",
      "item": "avocado peeled",
      "quantity": "1/2",
      "preparation": "stoned and sliced"
    },
    {
      "ingredient_id": "cucumber-cut-into-matchsticks",
      "item": "cucumber cut into matchsticks",
      "quantity": "1/4"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the mayonnaise with the sriracha, if using."
    },
    {
      "step": 2,
      "text": "Combine the cooked rice, spring onions, soy sauce, and cucumber. Fold in the flaked salmon."
    },
    {
      "step": 3,
      "text": "Lay out the seaweed thins and divide the rice mixture, avocado, and remaining cucumber between them. Add the mayonnaise mixture."
    },
    {
      "step": 4,
      "text": "Fold in the sides and roll each seaweed thin tightly around the filling. Serve immediately."
    }
  ],
