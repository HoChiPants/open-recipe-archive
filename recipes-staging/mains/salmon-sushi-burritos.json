  "id": "salmon-sushi-burritos",
  "name": "Salmon Sushi Burritos",
  "subtitle": "Seaweed-wrapped rice rolls with salmon and fresh vegetables",
  "description": "Season cooked rice with soy sauce and spring onions, then wrap it with salmon, avocado, cucumber, and a creamy spicy sauce in seaweed thins.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "white-rice",
      "item": "white rice",
      "quantity": 200,
      "unit": "g",
      "preparation": "cooked"
    },
    {
      "ingredient_id": "spring-onions-finely-sliced",
      "item": "spring onions finely sliced",
      "quantity": 2
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 2,
      "unit": "tsp"
    },
    {
