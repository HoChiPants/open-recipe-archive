  "id": "chicken-and-apple-curry",
  "name": "Chicken and Apple Curry",
  "subtitle": "Baked chicken in a gently spiced apple curry sauce",
  "description": "Chicken breasts bake beneath a creamy curry sauce enriched with finely chopped apples and onion.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 2,
      "unit": "small",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "apples",
      "item": "apples",
      "quantity": 2,
      "preparation": "peeled, cored and finely chopped"
    },
    {
      "ingredient_id": "curry-powder",
      "item": "curry powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "hot-chicken-broth",
      "item": "hot chicken broth",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 8,
      "preparation": "boneless chicken breasts"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat. Add the onion and apples and cook until tender."
    },
    {
      "step": 3,
      "text": "Stir in the curry powder and cook for 1 minute. Add the flour and cook for 1 minute more.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Gradually stir in the milk, then add the hot chicken broth and season with salt and pepper. Cook, stirring, until combined."
    },
    {
      "step": 5,
      "text": "Arrange the chicken breasts in a baking dish and pour the curry sauce over them."
    },
    {
      "step": 6,
      "text": "Bake until the chicken is cooked through and reaches 165°F in the thickest part.",
      "timer_minutes": 50
    }
  ],
