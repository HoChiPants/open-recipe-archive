  "instructions": [
    {
      "step": 1,
      "text": "Bring a saucepan of water to a boil. Cook the dried wheat noodles until tender, then drain."
    },
    {
      "step": 2,
      "text": "Heat the sesame oil in a skillet over medium heat. Add the aubergine and cook until softened and lightly browned.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the Chinese five-spice powder, crushed garlic, and ground Sichuan peppercorns; cook briefly until fragrant.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Mix the tahini or Chinese sesame paste, hoisin sauce, light soy sauce, black rice vinegar, and crispy chilli oil until smooth."
    },
    {
      "step": 5,
      "text": "Add the sauce to the aubergine and stir until hot and thickened. Toss in the drained noodles and coat thoroughly.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Serve with the sliced spring onions and toasted sesame seeds."
    }
  ],
