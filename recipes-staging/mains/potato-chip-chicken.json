  "instructions": [
    {
      "step": 1,
      "text": "Arrange the chicken in a baking dish. Stir the melted butter, salt, and pepper together, then coat the chicken with the mixture. Cover and chill for 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 2,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 3,
      "text": "Crush the potato chips and press them over the seasoned chicken, shaping the coating so it adheres."
    },
    {
      "step": 4,
      "text": "Bake at 375°F for 45 minutes, until the coating is crisp and the thickest piece reaches 165°F on a food thermometer.",
      "timer_minutes": 45
    }
