  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large ovenproof pot or Dutch oven over medium heat. Add the onion, bell pepper, celery, and garlic; sauté until tender."
    },
    {
      "step": 3,
      "text": "Stir in the tomato paste, bay leaves, Creole seasoning, and Worcestershire sauce. Cook briefly until combined."
    },
    {
      "step": 4,
      "text": "Add the whole peeled tomatoes and chicken stock, then stir in the ham, sausage, chicken, shrimp, and uncooked rice."
    },
    {
      "step": 5,
      "text": "Cover the pot and bake for 2 hours, or until the rice is tender and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Remove the bay leaves, stir the jambalaya, and serve hot."
    }
  ],
