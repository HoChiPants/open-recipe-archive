  "id": "beer-brined-chicken",
  "name": "Beer-Brined Chicken",
  "subtitle": "Juicy roast chicken with a spiced maple finish",
  "description": "A whole chicken is brined with beer, citrus, and aromatics, then roasted upright over beer and finished with a smoky-sweet spice coating.",
  "meal_type": "main",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
