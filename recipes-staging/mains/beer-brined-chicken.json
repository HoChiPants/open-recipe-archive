  "instructions": [
    {
      "step": 1,
      "text": "Slice the lemons. Combine the beer, salt, caster sugar, bay leaves, mustard seeds, black peppercorns, and lemons in a large saucepan; simmer until the salt and sugar dissolve. Cool the brine completely."
    },
    {
      "step": 2,
      "text": "Submerge the chicken in the cold brine, cover, and chill until thoroughly seasoned. Remove it from the brine and pat the skin very dry; let it stand while the oven heats."
    },
    {
      "step": 3,
      "text": "Heat the oven to 400°F. Stir the olive oil, maple syrup, cayenne pepper, and ground cumin together."
    },
    {
      "step": 4,
      "text": "Pour the beer into a sturdy roasting pan or beer-can chicken holder. Set the chicken upright over it, brush with the spiced maple mixture, and roast for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Continue roasting until the thickest part of the breast and thigh reaches 165°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Transfer the chicken to a board and rest for 10 minutes before carving.",
      "timer_minutes": 10
    }
  ],
