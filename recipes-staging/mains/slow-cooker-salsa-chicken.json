  "id": "slow-cooker-salsa-chicken",
  "name": "Slow Cooker Salsa Chicken",
  "subtitle": "Tender shredded chicken with a spiced salsa sauce",
  "description": "Chicken breasts simmer slowly with salsa, green chiles, and warm spices for an easy main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 360
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-breasts",
      "item": "chicken breasts",
      "quantity": 3
    },
    {
      "ingredient_id": "chili-powder",
      "item": "chili powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "onion-powder",
      "item": "onion powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "15-5-ounce-jar-salsa",
      "item": "(15.5 ounce) jar salsa",
      "quantity": 1
    },
    {
      "ingredient_id": "green-chile-peppers",
      "item": "green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "4 ounce, chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Arrange the chicken breasts in the slow cooker."
    },
    {
      "step": 2,
      "text": "Stir the chili powder, garlic powder, ground cumin, and onion powder into the salsa and chopped green chile peppers. Pour the mixture over the chicken."
    },
    {
      "step": 3,
      "text": "Cover and cook until the chicken is tender, about 6 hours, and reaches 165°F in the thickest part.",
      "timer_minutes": 360
    },
    {
      "step": 4,
      "text": "Shred the chicken in the cooking juices and serve."
    }
  ],
