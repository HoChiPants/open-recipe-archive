  "id": "almond-crusted-chicken-thighs",
  "name": "Almond-Crusted Chicken Thighs",
  "subtitle": "A crisp, paprika-seasoned coating for oven-baked chicken.",
  "description": "Chicken thighs are coated in seasoned almond meal and baked until browned and safely cooked through.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "almond-meal",
      "item": "almond meal",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-paprika",
      "item": "ground paprika",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sea-salt",
      "item": "sea salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken thighs"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the almond meal, paprika, salt, and black pepper together in a shallow dish."
    },
    {
      "step": 3,
      "text": "Press each chicken thigh into the seasoning mixture, turning to cover all sides evenly."
    },
    {
      "step": 4,
      "text": "Arrange the coated chicken on a baking sheet and bake for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Check the thickest part with a food thermometer; remove the chicken when it reaches 165°F."
    }
  ],
