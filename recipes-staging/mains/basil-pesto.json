  "id": "basil-pesto",
  "name": "Basil Pesto",
  "subtitle": "A fresh, no-cook basil sauce with cheese and pine nuts",
  "description": "Blend basil, cheese, olive oil, pine nuts, garlic, and seasoning into a smooth pesto for pasta, vegetables, or bread.",
  "meal_type": "main",
  "cuisine": "Italian",
