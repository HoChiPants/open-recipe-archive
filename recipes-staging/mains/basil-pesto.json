      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the basil, cheese, and olive oil to a food processor or blender."
    },
    {
      "step": 2,
      "text": "Add the pine nuts, minced garlic, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Process until the mixture is smooth, scraping down the sides as needed."
    },
    {
      "step": 4,
      "text": "Transfer the pesto to a serving bowl or storage container and smooth the surface."
    },
    {
      "step": 5,
      "text": "Use immediately or cover and refrigerate until needed."
    }
  ],
