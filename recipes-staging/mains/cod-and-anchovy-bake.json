  "id": "cod-and-anchovy-bake",
  "name": "Cod and Anchovy Bake",
  "subtitle": "Layered cod with potatoes, tomatoes, and spinach",
  "description": "A savory fish bake with tender potatoes, anchovies, tomato, peppers, and a light cheddar topping, served with wilted spinach.",
