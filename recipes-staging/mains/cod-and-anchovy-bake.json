  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven and lightly oil a baking dish with the olive or rapeseed oil.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Boil the potato slices and onion for 7 minutes, then drain well.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Combine the thyme, chopped anchovies, and sliced red pepper. Add the tomatoes, vinegar, bouillon powder, and garlic, then cook until the mixture softens and becomes saucy.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Arrange the potato and onion in the baking dish. Spoon over the tomato mixture and place the cod loins on top."
    },
    {
      "step": 5,
      "text": "Scatter over the cheddar and bake until the cod is opaque and flakes easily, reaching 145°F in the thickest part.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Serve with the wilted baby spinach."
    }
  ],
