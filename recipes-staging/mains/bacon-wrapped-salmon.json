  "id": "bacon-wrapped-salmon",
  "name": "Bacon-Wrapped Salmon",
  "subtitle": "Seasoned salmon fillets wrapped in crisp bacon",
  "description": "Salmon fillets are seasoned with dill and garlic, wrapped in bacon, baked, and briefly grilled for a browned finish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "4-ounce-skin-on-salmon-fillets",
      "item": "(4 ounce) skin-on salmon fillets",
      "quantity": 4
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-dill-weed",
      "item": "dried dill weed",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "cut in half"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Place the salmon fillets in a baking dish. Season with garlic powder, dill, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Wrap each fillet with the halved bacon, arranging the seam underneath."
    },
    {
      "step": 4,
      "text": "Bake for 25 minutes, until the salmon reaches 145°F or is opaque and flakes easily.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Grill or broil for 2 minutes to brown and crisp the bacon, watching closely.",
      "timer_minutes": 2
    }
  ],
