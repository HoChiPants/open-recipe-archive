      "item": "chunks of crusty white bread to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a wide pan over medium heat. Stir in the cayenne, mace, and crushed pink peppercorns, and cook until the butter is browned and fragrant."
    },
    {
      "step": 2,
      "text": "Bring a pan of water to a simmer and season it with the sea salt. Add the asparagus and cook until tender-crisp.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Warm the brown shrimp, shredded wild garlic, and lemon juice in the spiced butter until the shrimp are opaque and heated through."
    },
    {
      "step": 4,
      "text": "Transfer the asparagus to serving plates and spoon over the shrimp and butter. Scatter with the remaining wild garlic and optional chive flowers, and serve with crusty bread."
    }
  ],
