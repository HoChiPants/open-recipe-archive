      "item": "sea salt",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-mace",
      "item": "ground mace",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "pink-peppercorns-lightly-crushed-using-a-pestle-and-mortar",
      "item": "pink peppercorns lightly crushed using a pestle and mortar",
      "quantity": "1/4",
      "unit": "tsp"
    },
