      "item": "brown shrimp (or see tip below)",
      "quantity": 200,
      "unit": "g",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "wild-garlic-leaves-plus-a-few-to-serve-optional",
      "item": "wild garlic leaves plus a few to serve (optional)",
      "quantity": 2,
      "preparation": "or handful finely shredded chervil or chives",
      "optional": true
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": 1
    },
    {
