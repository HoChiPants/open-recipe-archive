  "id": "asparagus-with-brown-shrimp",
  "name": "Asparagus with Brown Shrimp",
  "subtitle": "Tender asparagus with spiced brown butter and lemon",
  "description": "Blanched asparagus is finished with nutty spiced butter, peeled brown shrimp, herbs, and lemon, then served with crusty bread.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "as a starter or 2 for lunch"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
