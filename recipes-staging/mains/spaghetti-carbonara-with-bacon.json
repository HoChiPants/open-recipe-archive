  "id": "spaghetti-carbonara-with-bacon",
  "name": "Spaghetti Carbonara with Bacon",
  "subtitle": "Creamy spaghetti with smoky bacon and Parmesan",
  "description": "A rich Italian-style pasta tossed with bacon, aromatics, Parmesan, cream, and beaten eggs.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "spaghetti",
      "item": "spaghetti",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "slices-thick-cut",
      "item": "slices thick-cut",
      "quantity": 12,
      "preparation": "applewood-smoked bacon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "cloves-garlic",
      "item": "cloves garlic",
      "quantity": 2,
      "unit": "large",
      "preparation": "minced"
    },
    {
      "ingredient_id": "dry-vermouth",
      "item": "dry vermouth",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "parmesan-cheese",
      "item": "Parmesan cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "whipping-cream",
      "item": "whipping cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 10°F for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Cook the spaghetti in boiling water for 12 minutes, then drain.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Cook the bacon until crisp. Drain, let rest briefly, and cut into pieces."
    },
    {
      "step": 4,
      "text": "Heat half the olive oil with the onion until softened, about 5 minutes. Add the garlic and cook for 1 minute.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Transfer the onion mixture to a bowl and stir in the vermouth.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Whisk together the Parmesan, cream, beaten eggs, and black pepper."
    },
    {
      "step": 7,
      "text": "Toss the hot spaghetti with the remaining olive oil, bacon, onion mixture, and cream mixture. Warm gently, stirring constantly, until the sauce reaches 160°F and coats the pasta."
    },
    {
      "step": 8,
      "text": "Serve immediately."
    }
  ],
