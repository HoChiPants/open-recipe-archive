      "item": "frozen peas",
      "quantity": 1,
      "unit": "cup",
      "preparation": "thawed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the water, onion, butter, curry powder, and salt for about 2 minutes, until the butter melts.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Stir in the rice, unthawed fish fillets, and thawed peas, then sprinkle the sliced almonds over the top."
    },
    {
      "step": 3,
      "text": "Cover and cook for about 20 minutes, until the rice is tender and the fish is opaque and flakes easily. Verify the fish reaches 145°F.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Gently combine the rice and peas, then serve."
    }
  ],
