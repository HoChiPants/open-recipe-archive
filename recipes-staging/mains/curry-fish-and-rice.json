  "id": "curry-fish-and-rice",
  "name": "Curry Fish and Rice",
  "subtitle": "One-pan rice with peas, almonds, and white fish",
  "description": "Tender curried rice cooks with white fish, peas, onion, and sliced almonds for a simple savory main dish.",
  "meal_type": "main",
  "cuisine": "Indian",
  "yield": {
    "quantity": 4,
