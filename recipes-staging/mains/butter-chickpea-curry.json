  "instructions": [
    {
      "step": 1,
      "text": "Place the cubed potatoes in a pot, cover with water, and bring to a simmer. Cook until tender, then drain well."
    },
    {
      "step": 2,
      "text": "Heat the canola oil in a large skillet over medium heat. Add the onion and garlic and cook until softened."
    },
    {
      "step": 3,
      "text": "Stir in the curry powder, garam masala, ground ginger, cumin, and salt. Cook briefly to bloom the spices.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Whisk in the condensed tomato soup and cream or milk, then fold in the rinsed chickpeas and cooked potatoes."
    },
    {
      "step": 5,
      "text": "Simmer gently until the curry is hot and the sauce is cohesive.",
      "timer_minutes": 5
    }
  ],
