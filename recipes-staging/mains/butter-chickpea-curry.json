  "id": "butter-chickpea-curry",
  "name": "Butter Chickpea Curry",
  "subtitle": "A creamy spiced curry with potatoes and chickpeas",
  "description": "Tender potatoes and chickpeas simmer in a tomato-based sauce enriched with cream or milk and aromatic Indian spices.",
  "meal_type": "main",
  "cuisine": "Indian",
