  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 225°F."
    },
    {
      "step": 2,
      "text": "Mix the kosher salt, black pepper, smoked paprika, garlic powder, cayenne, dried rosemary, and chopped fresh rosemary."
    },
    {
      "step": 3,
      "text": "Coat the tri-tip evenly with the seasoning mixture and place it in a roasting pan."
    },
    {
      "step": 4,
      "text": "Roast for about 90 minutes, or until a thermometer inserted in the thickest part reaches 145°F.",
      "timer_minutes": 90
    },
    {
      "step": 5,
      "text": "Rest the roast for 20 minutes; whole-cut beef should rest at least 3 minutes after reaching 145°F.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Slice the tri-tip across the grain."
    },
    {
      "step": 7,
      "text": "Combine the sliced roast's juices with the beef broth and serve alongside the meat."
    }
  ],
