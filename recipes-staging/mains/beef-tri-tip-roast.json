  "id": "beef-tri-tip-roast",
  "name": "Beef Tri-Tip Roast",
  "subtitle": "Rosemary-Paprika Tri-Tip",
  "description": "A spice-rubbed tri-tip roast cooked gently, rested, sliced, and served with warm beef broth.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
