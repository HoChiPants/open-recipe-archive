  "instructions": [
    {
      "step": 1,
      "text": "Mash the avocado with the olive oil and juice from the lime. Fold in the chopped cherry tomatoes."
    },
    {
      "step": 2,
      "text": "Cut the bagels in half. Divide the spinach and shredded cooked chicken between the bagel bottoms."
    },
    {
      "step": 3,
      "text": "Spoon the avocado mixture over the chicken, add the bagel tops, and serve. If reheating the chicken before assembly, heat it to 165°F."
    }
