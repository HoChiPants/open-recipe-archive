  "id": "chicken-bagel",
  "name": "Chicken Bagel",
  "subtitle": "Avocado, chicken, and spinach on sesame bagels",
  "description": "A quick assembled bagel layered with seasoned avocado, chopped tomatoes, shredded cooked chicken, and fresh spinach.",
  "meal_type": "main",
