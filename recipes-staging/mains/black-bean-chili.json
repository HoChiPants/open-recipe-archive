  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large pot over medium heat."
    },
    {
      "step": 2,
      "text": "Add the tomatoes, bell pepper, onion, mushrooms, corn, jalapeño, and black pepper. Cook until the vegetables begin to soften.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the chili powder, cumin, and black beans."
    },
    {
      "step": 4,
      "text": "Add the broth and salt, then bring the mixture to a simmer."
    },
    {
      "step": 5,
      "text": "Simmer until the vegetables are tender and the chili reaches 165°F throughout.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Stir, adjust the consistency briefly as needed, and serve hot."
    }
  ],
