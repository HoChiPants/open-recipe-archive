  "id": "chicken-zucchini-enchiladas",
  "name": "Chicken Zucchini Enchiladas",
  "subtitle": "Tender zucchini filled with seasoned chicken and enchilada sauce",
  "description": "Halved zucchini are filled with a spiced chicken mixture, covered with enchilada sauce and cheese, then baked until tender and bubbling.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
