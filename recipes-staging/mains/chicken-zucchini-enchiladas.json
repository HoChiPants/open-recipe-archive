  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet. Add the onion and cook for 5 minutes, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the garlic, cumin, chili powder, and oregano. Stir briefly to combine."
    },
    {
      "step": 4,
      "text": "Stir in the chicken, part of the enchilada sauce, and chopped chile peppers until evenly mixed."
    },
    {
      "step": 5,
      "text": "Arrange the zucchini halves in a baking dish. Spoon the chicken mixture over and between the zucchini, then cover with the remaining enchilada sauce."
    },
    {
      "step": 6,
      "text": "Scatter the shredded cheese over the top and bake for 20 minutes, until melted and bubbling. If reheating from chilled, heat the center to 165°F.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Garnish with the cilantro and serve hot."
    }
  ],
