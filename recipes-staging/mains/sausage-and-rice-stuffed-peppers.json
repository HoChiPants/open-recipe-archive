  "id": "sausage-and-rice-stuffed-peppers",
  "name": "Sausage and Rice Stuffed Peppers",
  "subtitle": "Tender peppers filled with savory sausage, rice, and melted Cheddar",
  "description": "Green bell peppers are softened, filled with seasoned sausage rice, topped with Cheddar, and baked until tender and melted.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "green-bell-peppers",
      "item": "green bell peppers",
      "quantity": 6,
      "unit": "large"
    },
    {
      "ingredient_id": "ground-sausage",
      "item": "ground sausage",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2.6666667461395,
      "unit": "cups"
    },
    {
      "ingredient_id": "tomato-soup",
      "item": "tomato soup",
      "quantity": 2,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "chili-powder",
      "item": "chili powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "pound",
      "preparation": "shredded, divided"
    },
    {
      "ingredient_id": "uncooked-instant-rice",
      "item": "uncooked instant rice",
      "quantity": 3,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the tops from the peppers and remove the seeds. Season the peppers with salt and pepper."
    },
    {
      "step": 2,
      "text": "Bring the water to a simmer in a large pot. Add the peppers, cover, and cook for 15 minutes, until tender. Transfer them to a baking dish and let them drain.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Cook the sausage and onion in a skillet over medium heat, breaking up the meat, until the sausage reaches 160°F on a food thermometer and the onion is tender."
    },
    {
      "step": 4,
      "text": "Stir in the water, tomato soup, chili powder, garlic powder, and salt and pepper. Bring the mixture to a simmer."
    },
    {
      "step": 5,
      "text": "Stir in the rice and one portion of the shredded Cheddar. Simmer for 30 minutes, until the rice is tender and the filling is set.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Heat the oven to 350°F. Spoon the filling into the peppers and arrange them upright in the baking dish."
    },
    {
      "step": 7,
      "text": "Bake for 30 minutes. Top with the remaining Cheddar and return to the oven until the cheese is melted and the filling is hot.",
      "timer_minutes": 30
    }
  ],
