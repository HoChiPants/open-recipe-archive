      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the bread crumbs and salt. Coat the scallops evenly in the mixture."
    },
    {
      "step": 2,
      "text": "Heat the butter and olive oil in a skillet over medium-high heat."
    },
    {
      "step": 3,
      "text": "Cook the coated scallops for about 2 minutes, turning as needed, until opaque and cooked through. Transfer them to a plate.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the white wine, lemon juice, parsley, and garlic to the skillet, stirring to loosen any browned bits."
    },
    {
      "step": 5,
      "text": "Simmer the sauce until thickened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Return the scallops to the skillet and coat them with the sauce. Serve hot."
    }
  ],
