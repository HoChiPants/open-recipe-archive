  "id": "skillet-sea-scallops",
  "name": "Skillet Sea Scallops",
  "subtitle": "Breaded scallops with lemon-white wine pan sauce",
  "description": "Sea scallops are lightly coated, quickly seared, then finished with a bright garlic, parsley, lemon, and white wine sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sea-scallops",
      "item": "sea scallops",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "dry-white-wine",
      "item": "dry white wine",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "minced"
    },
    {
