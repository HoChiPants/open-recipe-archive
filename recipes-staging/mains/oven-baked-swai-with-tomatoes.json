  "id": "oven-baked-swai-with-tomatoes",
  "name": "Oven-Baked Swai with Tomatoes",
  "subtitle": "Tender fish baked with a simple tomato and onion topping",
  "description": "Swai fillets are seasoned, topped with sautéed onion, garlic, and diced tomatoes, then baked until opaque and flaky.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "4-ounce-fillets-swai-fish",
      "item": "(4 ounce) fillets swai fish",
      "quantity": 2
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "petite-diced-tomatoes",
      "item": "petite diced tomatoes",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.5 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Season the swai fillets with salt and black pepper and place them in a baking dish."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a skillet over medium heat. Add the onion and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the garlic and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Add the diced tomatoes, stir, and simmer for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Spoon the tomato mixture over the fish. Bake for about 20 minutes, until the fish reaches 145°F and is opaque and easily flaked with a fork.",
      "timer_minutes": 20
    }
  ],
