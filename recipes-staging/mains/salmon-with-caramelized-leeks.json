  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "salmon-with-caramelized-leeks",
  "name": "Salmon with Caramelized Leeks",
  "subtitle": "Roasted salmon with sweet, tender vegetables",
  "description": "Roast seasoned salmon over buttery caramelized leeks and matchstick carrots for a simple, balanced dinner.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "leeks",
      "item": "leeks",
      "quantity": 4
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 3,
      "preparation": "cut into matchsticks"
    },
    {
      "ingredient_id": "kosher-salt-to-taste",
      "item": "kosher salt to taste"
    },
    {
      "ingredient_id": "salmon-fillets",
      "item": "salmon fillets",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt-and-ground-black-pepper-to-taste",
      "item": "kosher salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Trim and slice the leeks, then rinse them thoroughly and drain."
    },
    {
      "step": 2,
      "text": "Melt the butter in an oven-safe skillet over medium heat. Add the leeks and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the brown sugar and cook for 20 minutes, stirring occasionally, until the leeks are deeply tender and lightly caramelized.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Add the carrots and season with kosher salt. Cook for about 5 minutes, stirring, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Place the salmon fillets over the vegetables. Brush with olive oil and season with kosher salt and ground black pepper."
    },
    {
      "step": 6,
      "text": "Roast until the salmon is opaque and flakes easily, about 10 minutes, or until it reaches 145°F in the thickest part.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Serve the salmon with the caramelized leeks and carrots."
    }
  ],
