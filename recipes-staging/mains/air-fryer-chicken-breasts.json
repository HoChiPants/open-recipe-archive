  "id": "air-fryer-chicken-breasts",
  "name": "Air Fryer Chicken Breasts",
  "subtitle": "Seasoned chicken with crisp edges and tender centers",
  "description": "Chicken breasts coated in seasoned oil and air-fried until fully cooked, with optional rice, greens, or salad for serving.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-breasts",
      "item": "chicken breasts",
      "quantity": 4
    },
    {
      "ingredient_id": "rapeseed-oil",
      "item": "rapeseed oil",
      "quantity": "1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "garlic-granules",
      "item": "garlic granules",
      "quantity": "1 1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "smoked-sweet-paprika",
      "item": "smoked sweet paprika",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "mixed-herbs",
      "item": "mixed herbs",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "pepper",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "steamed-rice-and-greens-such-as-broccoli-or-green-beans-or-a-green-salad",
      "item": "steamed rice and greens such as broccoli or green beans or a green salad",
      "preparation": "to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Coat the chicken breasts with the rapeseed oil."
    },
    {
      "step": 2,
      "text": "Combine the salt, garlic granules, smoked sweet paprika, mixed herbs, and pepper. Coat the oiled chicken evenly with the seasoning."
    },
    {
      "step": 3,
      "text": "Arrange the chicken in the air fryer basket and cook for 20 minutes, until the thickest part reaches 165°F on a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Serve with steamed rice and greens or a green salad, if desired."
    }
  ],
