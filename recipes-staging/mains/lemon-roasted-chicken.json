  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Combine the chicken, onion, lemon, garlic, and rosemary in a roasting pan or baking dish."
    },
    {
      "step": 3,
      "text": "Add the olive oil, salt, and black pepper, then toss to coat the chicken and vegetables."
    },
    {
      "step": 4,
      "text": "Arrange the chicken in the pan and roast for 50 minutes, until the thickest pieces reach 165°F on a food thermometer.",
