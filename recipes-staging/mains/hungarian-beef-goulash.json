  "id": "hungarian-beef-goulash",
  "name": "Hungarian Beef Goulash",
  "subtitle": "Paprika-braised beef with egg noodles",
  "description": "Tender beef simmers with onion, paprika, caraway, garlic, lemon zest, and tomato before being served with broad egg noodles.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "beef-stew-meat",
      "item": "beef stew meat",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "caraway-seeds",
      "item": "caraway seeds",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "pound",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "tomato-paste",
      "item": "tomato paste",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce"
    },
    {
      "ingredient_id": "beef-consomme",
      "item": "beef consomme",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "broad-egg-noodles",
      "item": "broad egg noodles",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, cooked, rinsed, drained (Kosher for Passover)"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm a heavy pot over medium heat and melt the butter."
    },
    {
      "step": 2,
      "text": "Add the beef, caraway seeds, sliced onion, and paprika. Stir until the beef is coated and the onion begins to soften."
    },
    {
      "step": 3,
      "text": "Stir in the garlic, lemon zest, tomato paste, and beef consomme."
    },
    {
      "step": 4,
      "text": "Bring to a gentle simmer, cover, and cook until the beef is tender and reaches at least 145°F on a food thermometer; let it rest for 3 minutes.",
      "timer_minutes": 90
    },
    {
      "step": 5,
      "text": "Add the broad egg noodles and cook until tender.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Drain the noodles and serve with the goulash."
    }
  ],
