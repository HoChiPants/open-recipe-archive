  "id": "chorizo-steamed-clams",
  "name": "Chorizo Steamed Clams",
  "subtitle": "Clams simmered with spicy sausage, wine, and herbs",
  "description": "A quick skillet meal combining tender clams, savory chorizo, garlic, parsley, and a buttery wine broth.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "finely-diced-onions",
      "item": "finely diced onions",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "spanish-chorizo-sausage",
      "item": "Spanish chorizo sausage",
      "quantity": 3,
      "unit": "ounces",
      "preparation": "quartered lengthwise, cut into1/4-inch pieces"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "littleneck-clams",
      "item": "littleneck clams",
      "quantity": 3,
      "unit": "pounds",
      "preparation": "scrubbed and rinsed"
    },
    {
      "ingredient_id": "italian-parsley",
      "item": "Italian parsley",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a wide covered pot over medium heat. Add the onions and cook, stirring, for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Add the chorizo and cook for 3 minutes, then add the garlic and cook for 1 minute. The sausage should reach 160°F.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Pour in the white wine and bring it to a simmer. Add the clams, cover, and cook for 7 minutes, shaking the pot once or twice, until the shells open.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Stir in the parsley and butter. Discard any clams that remain closed, then serve immediately with the broth."
    }
  ],
