{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "beef-carnitas",
  "name": "Beef Carnitas",
  "subtitle": "Slow-roasted beef with chile and warm spices",
  "description": "Chuck roast is seasoned with green chiles, garlic, oregano, cumin, and chili powder, then slowly roasted until tender enough to shred.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "chuck-roast",
      "item": "chuck roast",
      "quantity": 4,
      "unit": "pounds"
    },
    {
      "ingredient_id": "green-chile-peppers",
      "item": "green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "4 ounce, chopped"
    },
    {
      "ingredient_id": "chili-powder",
      "item": "chili powder",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Place the chuck roast in an oven-safe baking dish or pot."
    },
    {
      "step": 3,
      "text": "Stir together the green chiles, chili powder, oregano, cumin, garlic, and salt, then spread the mixture over the roast."
    },
    {
      "step": 4,
      "text": "Bake for 4 hours, or until the beef reaches at least 145°F and is tender enough to shred.",
      "timer_minutes": 240
    },
    {
      "step": 5,
      "text": "Let the roast rest for 3 minutes, then shred the meat before serving."
    }
  ],
