  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F (200°C). Set out a deep roasting tin and prepare the chopping board, sharp knife, scissors, and other utensils."
    },
    {
      "step": 2,
      "text": "Trim and snip the spring onions. Remove the cauliflower leaves, dry the head if needed, and cut it into bite-size florets."
    },
    {
      "step": 3,
      "text": "Put the cauliflower and spring onions in the roasting tin. Add the oil and toss to coat."
    },
    {
      "step": 4,
      "text": "Roast for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Crush the garlic into the tin, add the korma paste, and stir. Drain the chickpeas and add them."
    },
    {
      "step": 6,
      "text": "Whisk the cream with the stock cube in the measuring jug, then pour it into the tin. Add the green beans and ground almonds; stir with the wooden spoon."
    },
    {
      "step": 7,
      "text": "Bake for 25 minutes, until the cauliflower and beans are tender and the sauce is hot throughout.",
      "timer_minutes": 25
    },
    {
      "step": 8,
      "text": "Serve with cooked basmati rice or naans and mango chutney."
    }
  ],
