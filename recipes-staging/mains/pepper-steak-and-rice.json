  "instructions": [
    {
      "step": 1,
      "text": "Combine the rice, 2 cups water, and browning sauce in a saucepan. Bring to a boil, cover, reduce the heat, and cook until the rice is tender and the liquid is absorbed; keep covered off the heat.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet. Add the onion, green bell pepper, browning sauce, and black pepper, and cook until the vegetables are tender."
    },
    {
      "step": 3,
      "text": "Add the steak and garlic. Sprinkle with paprika, seasoning salt, and additional black pepper, then stir-fry until the steak reaches 145°F in the thickest pieces. Remove from the heat and rest for 3 minutes."
    },
    {
      "step": 4,
      "text": "Add 1.5 cups water to the skillet and bring the mixture to a boil."
    },
    {
      "step": 5,
      "text": "Whisk the cornstarch with 0.5 cup water until smooth. Stir the mixture into the skillet and cook, stirring, until the sauce thickens and returns to a boil."
    },
    {
      "step": 6,
      "text": "Serve the pepper steak and sauce over the cooked rice."
    }
  ],
