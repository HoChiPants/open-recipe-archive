  "id": "smoked-salmon-linguine",
  "name": "Smoked Salmon Linguine",
  "subtitle": "Creamy linguine with shallot and smoked salmon",
  "description": "A quick pasta dish tossed with a smooth milk-and-cream-cheese sauce, shallot, and pieces of smoked salmon.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 2,
