      "item": "reduced-fat cream cheese",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a boil. Cook the linguine for 11 minutes, or until tender, then drain.",
      "timer_minutes": 11
    },
    {
      "step": 2,
      "text": "Warm the butter and olive oil in a skillet over medium heat. Add the shallot and cook until softened."
    },
    {
      "step": 3,
      "text": "Whisk in the milk and cream cheese. Bring the sauce to a gentle simmer, then stir in the smoked salmon and warm through. If the salmon is uncooked, heat the mixture to 145°F."
    },
    {
      "step": 4,
      "text": "Add the drained linguine and toss until evenly coated. Serve immediately."
    }
  ],
