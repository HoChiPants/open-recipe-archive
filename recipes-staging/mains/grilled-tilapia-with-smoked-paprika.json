      "item": "freshly ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "6-ounce-tilapia-fillets",
      "item": "(6 ounce) tilapia fillets",
      "quantity": 4
    },
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir together the olive oil, smoked paprika, garlic powder, salt, and black pepper."
    },
    {
      "step": 2,
      "text": "Preheat the grill and lightly coat the grates with cooking spray."
    },
    {
      "step": 3,
      "text": "Coat the tilapia fillets with the seasoned oil mixture."
    },
    {
      "step": 4,
      "text": "Grill the fillets for about 4 minutes per side, until opaque, easily flaked, and at least 145°F in the center.",
      "timer_minutes": 4
    }
  ],
