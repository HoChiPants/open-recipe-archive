  "id": "grilled-tilapia-with-smoked-paprika",
  "name": "Grilled Tilapia with Smoked Paprika",
  "subtitle": "Smoky-seasoned tilapia cooked on the grill",
  "description": "Tilapia fillets are coated with a smoky garlic seasoning and grilled until opaque and flaky.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
