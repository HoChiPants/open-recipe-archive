  "instructions": [
    {
      "step": 1,
      "text": "Heat the sunflower oil in a large saucepan over medium heat. Add the curry leaves and cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Add the onion, turmeric, cumin, coriander, and optional chilli powder. Cook, stirring occasionally, until the onion mixture is lightly browned, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Stir in the ginger, garlic, and tomato purée. Cook for 4 minutes, stirring often.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Add the beetroot, vegetable stock, and coconut milk. Bring the mixture to a simmer."
    },
    {
      "step": 5,
      "text": "Cover and simmer gently until the beetroot is tender, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Stir in the lime juice. Serve with long-grain white rice, paratha, and yogurt."
    }
  ],
