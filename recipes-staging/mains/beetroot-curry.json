  "id": "beetroot-curry",
  "name": "Beetroot Curry",
  "subtitle": "Tender beetroot in a spiced coconut sauce",
  "description": "A warming beetroot curry built with toasted spices, aromatics, vegetable stock, and coconut milk. Finish with lime and serve with a choice of rice, paratha, or yogurt.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
