  "id": "smothered-chicken-with-mushrooms",
  "name": "Smothered Chicken with Mushrooms",
  "subtitle": "Oregano-seasoned chicken baked with mushrooms, onion, and melted mozzarella.",
  "description": "Tender chicken breasts are seasoned, baked, topped with a savory mushroom mixture, and finished with mozzarella.",
