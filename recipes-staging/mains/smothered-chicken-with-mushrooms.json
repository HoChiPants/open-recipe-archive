  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Season the chicken breasts with oregano, cayenne, and the salt and ground black pepper."
    },
    {
      "step": 3,
      "text": "Bake the chicken for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Melt the butter in a skillet over medium heat. Add the mushrooms, onion, Worcestershire sauce, red wine, and the remaining pinch of salt and cracked black pepper. Stir for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Top the chicken with the mushroom mixture and continue baking until tender and the thickest part reaches 165°F.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Sprinkle with mozzarella and bake until the cheese melts.",
      "timer_minutes": 5
    }
  ],
