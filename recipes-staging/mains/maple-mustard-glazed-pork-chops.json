  "id": "maple-mustard-glazed-pork-chops",
  "name": "Maple-Mustard Glazed Pork Chops",
  "subtitle": "Grilled pork chops with a sweet, tangy glaze",
  "description": "Season boneless pork chops, chill them to set the coating, then grill and finish with maple-mustard glaze.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15,
    "inactive_minutes": 360
  },
  "ingredients": [
    {
      "ingredient_id": "lightly-packed-brown-sugar",
      "item": "lightly packed brown sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-ground-black-pepper",
      "item": "fresh-ground black pepper",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "onion-powder",
      "item": "onion powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "6-ounce-boneless-pork-loin-chops",
      "item": "(6 ounce) boneless pork loin chops",
      "quantity": 4
    },
    {
      "ingredient_id": "pure-maple-syrup",
      "item": "pure maple syrup",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "spicy-brown-mustard",
      "item": "spicy brown mustard",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the brown sugar, pepper, onion powder, paprika, salt, and spicy brown mustard into a seasoning mixture."
    },
    {
      "step": 2,
      "text": "Coat the pork chops evenly with the mixture and place them in a covered dish. Chill for 6 hours.",
      "timer_minutes": 360
    },
    {
      "step": 3,
      "text": "Preheat the grill and transfer the chilled pork chops to the grates."
    },
    {
      "step": 4,
      "text": "Whisk the maple syrup and spicy brown mustard together for the glaze."
    },
    {
      "step": 5,
      "text": "Grill the chops for 5 minutes, then turn them.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Grill the second side for 5 minutes. Brush with the glaze and grill for 1 minute.",
      "timer_minutes": 6
    },
    {
      "step": 7,
      "text": "Turn the chops, brush the other side with glaze, and grill for 1 minute more. Cook until the center reaches 145°F, then rest for 3 minutes.",
      "timer_minutes": 1
    },
    {
      "step": 8,
      "text": "Transfer the pork chops to a serving dish and add any remaining glaze."
    }
  ],
