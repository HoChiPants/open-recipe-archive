  "instructions": [
    {
      "step": 1,
      "text": "Whisk the water, cornstarch, and fresh corn kernels together. In a separate bowl, combine the olive oil and soy sauce. Set both mixtures aside."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large wok or skillet over medium-high heat."
    },
    {
      "step": 3,
      "text": "Add the red bell pepper, zucchini, and carrot. Stir-fry for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the bean sprouts, fresh corn kernels, green onions, and garlic. Stir to combine."
    },
    {
      "step": 5,
      "text": "Transfer in the olive oil and soy sauce mixture, then stir-fry for 5 minutes, until the vegetables are tender.",
      "timer_minutes": 5
    }
  ],
