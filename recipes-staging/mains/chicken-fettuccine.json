      "item": "heavy cream",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water seasoned with the garlic salt to a simmer. Add the fettuccini and cook for 10 minutes, or until tender. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat. Add the chicken and mushrooms, season with the garlic salt and black pepper, and cook until the chicken reaches 165°F and the mushrooms are cooked through."
    },
    {
      "step": 3,
      "text": "Pour in the heavy cream and whisk until the sauce thickens."
    },
    {
      "step": 4,
      "text": "Stir in the Parmesan cheese, then toss with the drained pasta and serve."
    }
  ],
