  "id": "chicken-fettuccine",
  "name": "Chicken Fettuccine",
  "subtitle": "Creamy pasta with chicken, mushrooms, and Parmesan",
  "description": "Tender chicken and mushrooms are folded into a quick cream sauce and served with fettuccine.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "fettuccini-pasta",
      "item": "fettuccini pasta",
      "quantity": 8,
      "unit": "ounces"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 3,
      "preparation": "boneless chicken breast halves - cut into chunks"
    },
    {
      "ingredient_id": "mushrooms",
      "item": "mushrooms",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
