  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of water to a simmer and season it with the salt."
    },
    {
      "step": 2,
      "text": "Cook the spaghetti in the boiling water for 9 minutes, then add the shrimp and cook until the shrimp are opaque and reach 145°F.",
      "timer_minutes": 9
    },
    {
      "step": 3,
      "text": "Drain the spaghetti and shrimp."
    },
    {
      "step": 4,
      "text": "Whisk the Parmesan, olive oil, lemon juice, black pepper, salt, and lemon zest into a smooth dressing."
    },
    {
      "step": 5,
      "text": "Toss the drained pasta and shrimp with the dressing and thawed peas until coated."
    },
    {
      "step": 6,
      "text": "Fold in the basil and finish with the lemon juice and lemon zest."
    }
  ],
