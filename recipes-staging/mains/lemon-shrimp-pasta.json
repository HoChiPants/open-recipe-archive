  "id": "lemon-shrimp-pasta",
  "name": "Lemon Shrimp Pasta",
  "subtitle": "Bright lemon, basil, and Parmesan meet tender shrimp and peas.",
  "description": "A quick pasta dinner tossed with lemon, olive oil, Parmesan, basil, peas, and shrimp.",
  "meal_type": "main",
