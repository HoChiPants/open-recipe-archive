      "item": "chili powder",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the beef, chopped onion, bay leaves, pepper, garlic powder, vinegar, and chili powder in a slow cooker."
    },
    {
      "step": 2,
      "text": "Cover and cook until the beef is tender, about 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 3,
      "text": "Stir in the tomato sauce and salt to taste."
    },
    {
      "step": 4,
      "text": "Cover and continue cooking for 2 hours, until the beef reaches at least 145°F internally and is tender; rest it for 3 minutes before serving.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Remove the bay leaves, shred the beef with forks, and stir it into the sauce."
    }
  ],
