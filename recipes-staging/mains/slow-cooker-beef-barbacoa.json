  },
  "ingredients": [
    {
      "ingredient_id": "boneless-beef-chuck-roast",
      "item": "boneless beef chuck roast",
      "quantity": 3,
      "unit": "pounds"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
