  "id": "slow-cooker-beef-barbacoa",
  "name": "Slow Cooker Beef Barbacoa",
  "subtitle": "Tender shredded beef in a tangy chili sauce",
  "description": "A hands-off slow-cooker main dish made with beef chuck, vinegar, garlic, chili powder, and tomato sauce.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
