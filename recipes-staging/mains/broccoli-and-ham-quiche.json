  "id": "broccoli-and-ham-quiche",
  "name": "Broccoli and Ham Quiche",
  "subtitle": "A savory baked custard with broccoli, ham, and Cheddar",
  "description": "Tender broccoli and diced ham fill a Cheddar-studded egg custard in an unbaked pie crust.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
