  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the frozen broccoli in a microwave-safe dish, prepare it according to the package directions, and microwave for 5 minutes. Drain well.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet. Add the onion and garlic and cook for 5 minutes, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir the broccoli, onion mixture, and ham together, then spread the mixture in the unbaked pie crust."
    },
    {
      "step": 5,
      "text": "Whisk the Cheddar, milk, beaten eggs, and black pepper together. Pour the mixture into the crust and sprinkle with smoked paprika."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, or until the center is firm and fully set and a thermometer inserted into the filling registers 160°F.",
      "timer_minutes": 45
    }
  ],
