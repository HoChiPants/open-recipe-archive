  "instructions": [
    {
      "step": 1,
      "text": "Season the pork generously with kosher salt and let it stand for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a heavy pot over medium-high heat. Brown the pork in batches, then transfer it to a plate."
    },
    {
      "step": 3,
      "text": "Add the onion, salt, black pepper, and cayenne to the pot. Cook, stirring, until the onion begins to soften, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the sage, hard apple cider, and apple cider vinegar, scraping up any browned bits. Bring the liquid to a simmer."
    },
    {
      "step": 5,
      "text": "Return the pork and accumulated juices to the pot. Cover and simmer gently until the pork is tender, about 60 minutes or as needed. Check that it reaches at least 145°F, then rest it for 3 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Transfer the pork to a serving dish and keep it warm. Warm the crème fraîche or heavy cream, whisk it into the braising liquid, and simmer until the sauce thickens, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Return the pork to the sauce and adjust the seasoning with more salt if needed. Garnish with crème fraîche and chopped chives."
    }
  ],
