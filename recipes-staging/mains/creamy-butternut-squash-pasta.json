  "instructions": [
    {
      "step": 1,
      "text": "Bring salted water to a simmer. Add the ziti and cook for 11 minutes, or until tender; drain and set aside.",
      "timer_minutes": 11
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large pan. Add the cubed butternut squash and cook for 15 minutes, stirring occasionally, until tender.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Stir in the garlic, sage, and thyme, then cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Whisk in the heavy cream and spinach. Bring the sauce to a simmer, then add the Parmesan, salt, and pepper."
    },
    {
      "step": 5,
      "text": "Add the drained ziti and cook for 3 minutes, stirring, until the sauce thickens and coats the pasta evenly.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Preheat the oven and prepare a baking dish. Transfer the pasta to the dish and finish with the remaining Parmesan and chopped walnuts."
    }
  ],
