      "ingredient_id": "ziti",
      "item": "ziti",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "butternut-squash",
      "item": "butternut squash",
      "quantity": 2,
      "unit": "cups",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "fresh-garlic",
      "item": "fresh garlic",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "rubbed-dried-sage",
      "item": "rubbed dried sage",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
