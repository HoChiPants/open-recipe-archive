  "id": "creamy-butternut-squash-pasta",
  "name": "Creamy Butternut Squash Pasta",
  "subtitle": "Ziti with squash, spinach, herbs, and Parmesan",
  "description": "Tender ziti is coated in a creamy butternut squash sauce with spinach, herbs, Parmesan, and walnuts.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
