  "id": "steamed-fish-with-ginger",
  "name": "Steamed Fish with Ginger",
  "subtitle": "Tender halibut with ginger, scallions, and warm sesame oil",
  "description": "Steam seasoned halibut until opaque and flaky, then finish it with soy sauces, aromatic oils, scallions, and cilantro.",
  "meal_type": "main",
  "cuisine": "Chinese",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "halibut-fillet",
      "item": "halibut fillet",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "coarse-sea-salt-or-kosher-salt",
      "item": "coarse sea salt or kosher salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fresh-ginger",
      "item": "fresh ginger",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "thinly-sliced-green-onion",
      "item": "thinly sliced green onion",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dark-soy-sauce",
      "item": "dark soy sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "light-soy-sauce",
      "item": "light soy sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "peanut-oil",
      "item": "peanut oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "toasted"
    },
    {
      "ingredient_id": "lightly-packed-fresh-cilantro-sprigs",
      "item": "lightly packed fresh cilantro sprigs",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pat the halibut dry and season both sides with the salt. Place it on a heatproof plate and scatter the minced ginger over the top."
    },
    {
      "step": 2,
      "text": "Set the plate in a steamer over simmering water, cover, and steam until the fish reaches 145°F or is opaque and flakes easily, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Mix the dark soy sauce and light soy sauce. Remove the fish from the steamer, top with the green onion, and spoon the soy mixture over it."
    },
    {
      "step": 4,
      "text": "Heat the peanut oil and toasted sesame oil until hot, then drizzle them over the fish and scallions."
    },
    {
      "step": 5,
      "text": "Garnish with the cilantro sprigs and serve immediately."
    }
  ],
