  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir together both condensed soups, sour cream, white wine, onion, mushrooms, garlic powder, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Arrange the chicken breasts in a baking dish and spread the sauce evenly over them."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, or until tender and the thickest chicken breast reaches 165°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Garnish with the chopped parsley before serving."
    }
