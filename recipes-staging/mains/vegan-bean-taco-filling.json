  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the onion, garlic, bell pepper, and cayenne pepper. Stir and cook until the vegetables are tender."
    },
    {
      "step": 3,
      "text": "Stir in the mashed black beans, then mix in the yellow cornmeal."
    },
    {
      "step": 4,
      "text": "Add the cumin, paprika, chili powder, and salsa, stirring until evenly combined."
    },
    {
      "step": 5,
      "text": "Cook the mixture for 5 minutes, stirring occasionally, until hot and cohesive.",
      "timer_minutes": 5
    }
