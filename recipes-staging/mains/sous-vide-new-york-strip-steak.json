  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a water bath to 130°F."
    },
    {
      "step": 2,
      "text": "Season the steaks with salt and pepper, place them in a suitable sealed bag, and remove excess air."
    },
    {
      "step": 3,
      "text": "Cook the sealed steaks in the 130°F water bath for 120 minutes.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Remove the steaks from the bag and pat them thoroughly dry."
    },
    {
      "step": 5,
      "text": "Heat the vegetable oil in a skillet over high heat. Sear the steaks for about 1 minute per side, then transfer them to a plate.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Add the butter and mushrooms to the skillet and cook for 5 minutes. Add the garlic and cook for 2 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 7,
      "text": "Stir in the water and balsamic vinegar, then scrape up any browned bits. Remove from the heat and stir until the butter melts; season with salt and pepper."
    },
    {
      "step": 8,
      "text": "Serve the steaks with the mushrooms and pan sauce. For whole-cut safety guidance, verify that the steaks reach 145°F and rest for 3 minutes; the stated bath temperature produces a lower-temperature medium-rare result.",
      "timer_minutes": 3
    }
  ],
