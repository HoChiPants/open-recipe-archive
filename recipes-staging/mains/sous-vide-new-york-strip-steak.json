  "id": "sous-vide-new-york-strip-steak",
  "name": "Sous Vide New York Strip Steak",
  "subtitle": "Tender steak with garlic mushrooms and balsamic butter",
  "description": "Cook strip steaks gently in a 130°F water bath, then sear them briefly and serve with garlic mushrooms and a balsamic butter sauce.",
  "meal_type": "main",
  "cuisine": "American",
