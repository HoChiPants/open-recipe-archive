  "instructions": [
    {
      "step": 1,
      "text": "Combine the tomatoes, finely chopped onion, lime juice, cilantro, jalapeño, and salt and pepper. Set aside."
    },
    {
      "step": 2,
      "text": "Heat half of the olive oil in a large skillet. Add the chicken strips and cook, stirring occasionally, until cooked through and a thermometer registers 165°F in the thickest pieces. Transfer to a plate."
    },
    {
      "step": 3,
      "text": "Heat the remaining olive oil in the skillet. Sauté the sliced onion and bell pepper with salt and pepper until tender. Stir in the garlic and cook briefly, then return the chicken to the skillet and combine."
    },
    {
      "step": 4,
      "text": "Warm a large skillet or griddle over medium heat. Place one tortilla in the pan, scatter over one-quarter of the cheese, add one-quarter of the chicken mixture, and top with another quarter of the cheese. Fold the tortilla over the filling."
    },
    {
      "step": 5,
      "text": "Cook until the underside is golden and the cheese begins to melt. Turn and cook until the second side is golden and the filling is hot. Repeat with the remaining tortillas, cheese, and filling."
    },
    {
      "step": 6,
      "text": "Cut the quesadillas into wedges. Serve with the pico de gallo and sour cream."
    }
  ],
