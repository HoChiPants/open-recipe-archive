  "id": "stuffed-leg-of-lamb",
  "name": "Stuffed Leg of Lamb",
  "subtitle": "Spinach, goat cheese, and pine nuts in a herb-seasoned roast",
  "description": "Butterflied boneless lamb is filled with spinach, goat cheese, and pine nuts, tied, seasoned, and roasted until tender.",
  "meal_type": "main",
  "yield": {
    "quantity": 8,
    "unit": "servings"
