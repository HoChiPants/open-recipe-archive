  "instructions": [
    {
      "step": 1,
      "text": "Transfer the lamb to a work surface. Cut it lengthwise to open it, then make additional cuts through the thick sections so it lies more evenly."
    },
    {
      "step": 2,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 3,
      "text": "Season the lamb with salt and black pepper. Add the spinach, then scatter the goat cheese and pine nuts over the surface."
    },
    {
      "step": 4,
      "text": "Roll the lamb around the filling and tie it securely with kitchen twine."
    },
    {
      "step": 5,
      "text": "Combine the flour, salt, ground black pepper, dried thyme, and fennel seeds. Coat the tied lamb with the mixture."
    },
    {
      "step": 6,
      "text": "Heat the sesame oil in a roasting pan or ovenproof skillet. Add the lamb and roast until browned and a thermometer inserted into the thickest part reads 145°F.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Transfer the lamb to a board and rest for at least 3 minutes before removing the twine and slicing.",
      "timer_minutes": 15
    }
  ],
