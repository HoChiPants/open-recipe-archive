  "instructions": [
    {
      "step": 1,
      "text": "Combine the tomatoes, red onion, lemon juice, cider vinegar, and 1 tsp of the oregano. Set aside as a relish."
    },
    {
      "step": 2,
      "text": "Cook the cauliflower and broccoli in simmering water for 3 minutes, then drain well and pat dry.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Mix the olive oil, smoked paprika, and remaining oregano. Toss the vegetables with the mixture and let them stand briefly."
    },
    {
      "step": 4,
      "text": "Heat a barbecue or grill. Grill the vegetables until lightly charred and tender, turning as needed.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Grill the halloumi cubes for about 1 minute, turning, until browned.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Serve the vegetables and halloumi with the tomato relish and cooked couscous, if using."
    }
  ],
