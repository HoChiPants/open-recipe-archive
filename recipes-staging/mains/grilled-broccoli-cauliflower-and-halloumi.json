  "id": "grilled-broccoli-cauliflower-and-halloumi",
  "name": "Grilled Broccoli, Cauliflower and Halloumi",
  "subtitle": "Smoky vegetables with bright tomato relish",
  "description": "Tender grilled vegetables and browned halloumi are served with a fresh tomato, onion, lemon, and oregano relish, with couscous if desired.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
