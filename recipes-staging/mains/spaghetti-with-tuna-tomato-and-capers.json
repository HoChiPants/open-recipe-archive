  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large skillet over medium heat. Add the anchovy and capers; stir for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Add the minced garlic and stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Pour in the wine and add oregano, red pepper flakes, salt, black pepper, and cayenne. Cook for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Stir in the crushed tomatoes. Adjust the seasonings, then simmer for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir in the tuna and 1/4 cup chopped parsley. Continue simmering for 10 minutes, until the fish reaches 145°F or is opaque and easily flaked.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Cook the spaghetti in boiling water for 11 minutes, or until cooked through. Drain and transfer it to the skillet.",
      "timer_minutes": 11
    },
    {
      "step": 7,
      "text": "Combine the pasta and sauce for 3 minutes. Finish with olive oil, the remaining parsley, extra-virgin olive oil, and Parmigiano-Reggiano.",
      "timer_minutes": 3
    }
  ],
