  "instructions": [
    {
      "step": 1,
      "text": "Combine the lentils, 2.5 cups water, and smoky barbeque sauce in a saucepan. Bring to a simmer and cook until the lentils are tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Stir the ground flax seed, 0.33333334326744 cup water, and ground black pepper together. Let stand until set, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a skillet. Add the onion, mushrooms, celery, garlic, and onion powder; cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 5,
      "text": "Transfer the cooked lentils to a mixing bowl. Add the flax mixture, sautéed vegetables, oats, flour, basil, remaining pepper, salt, and remaining onion powder; mix until combined."
    },
    {
      "step": 6,
      "text": "Combine the ketchup, brown sugar, mustard, and smoky barbeque sauce; stir until smooth, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Press the lentil mixture into a loaf pan and spread the sauce over the top. Bake until cooked through, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 8,
      "text": "Transfer the loaf from the oven and let it rest for 15 minutes before slicing and serving.",
      "timer_minutes": 15
    }
  ],
