  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "three-cheese-chicken-penne-pasta-bake",
  "name": "Three-Cheese Chicken Penne Pasta Bake",
  "subtitle": "Creamy chicken, spinach, and penne under a golden cheese topping",
  "description": "A hearty baked penne combines basil-seasoned chicken, spinach, tomatoes, and spaghetti sauce with three cheeses.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "multi-grain-penne-pasta",
      "item": "multi-grain penne pasta",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "uncooked"
    },
    {
      "ingredient_id": "fresh-spinach-leaves",
      "item": "fresh spinach leaves",
      "quantity": 1,
      "unit": "bag",
      "preparation": "9 ounce"
    },
    {
      "ingredient_id": "boneless-skinless-chicken-breasts",
      "item": "boneless skinless chicken breasts",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into bite-sized pieces"
    },
    {
      "ingredient_id": "dried-basil-leaves",
      "item": "dried basil leaves",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.5 ounce, diced, drained"
    },
    {
      "ingredient_id": "14-ounce-jar-spaghetti-sauce",
      "item": "(14 ounce) jar spaghetti sauce",
      "quantity": 1
    },
    {
      "ingredient_id": "philadelphia-neufchatel-cheese",
      "item": "PHILADELPHIA Neufchatel cheese",
      "quantity": 2,
      "unit": "ounces",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "kraft-2-milk-shredded-mozzarella-cheese",
      "item": "KRAFT 2% Milk Shredded Mozzarella Cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "kraft-grated-parmesan-cheese",
      "item": "KRAFT Grated Parmesan Cheese",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Bring a pot of water to a simmer, add the penne, and cook for 11 minutes, or until tender. Add the spinach during the boiling stage, then drain.",
      "timer_minutes": 11
    },
    {
      "step": 3,
      "text": "Coat a large skillet with cooking spray over medium heat. Add the chicken and basil; cook for 3 minutes, stirring, until the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Stir in the drained tomatoes and spaghetti sauce. Simmer until hot."
    },
    {
      "step": 5,
      "text": "Add the Neufchatel, half of the mozzarella, and the Parmesan. Stir until the cheeses melt."
    },
    {
      "step": 6,
      "text": "Fold in the drained penne and spinach until evenly combined, then transfer the mixture to the prepared baking dish."
    },
    {
      "step": 7,
      "text": "Bake for 20 minutes. Sprinkle with the remaining mozzarella and bake for 3 minutes more, until melted.",
      "timer_minutes": 23
    }
  ],
