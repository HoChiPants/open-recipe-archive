  "id": "greek-style-baked-swordfish",
  "name": "Greek-Style Baked Swordfish",
  "subtitle": "Swordfish with tomato, basil, garlic, and lime",
  "description": "Bake swordfish steaks with garlic butter and serve them with a fresh tomato-basil mixture brightened with lime.",
  "meal_type": "main",
  "cuisine": "Greek",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "minced, divided"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 3,
      "preparation": "cubed"
    },
    {
      "ingredient_id": "basil",
      "item": "fresh basil",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fresh-lime-juice",
      "item": "fresh lime juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "6-ounce-swordfish-steaks",
      "item": "(6 ounce) swordfish steaks",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Melt half of the butter with half of the garlic. Stir in the tomatoes and basil, then set the mixture aside."
    },
    {
      "step": 3,
      "text": "Melt the remaining butter and combine it with the remaining garlic. Place the swordfish steaks in a baking dish and coat them with the garlic butter."
    },
    {
      "step": 4,
      "text": "Bake for 7 minutes, or until the fish reaches 145°F and flakes easily.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Stir the lime juice into the tomato mixture and serve it with the swordfish."
    }
  ],
