      "item": "butter",
      "quantity": 2.5,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "minced"
    },
