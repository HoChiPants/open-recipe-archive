      "ingredient_id": "ground-cayenne-pepper",
      "item": "ground cayenne pepper",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, Creole-style seasoning, garlic powder, 1 tablespoon cayenne, onion powder, and black pepper in a bowl."
    },
    {
      "step": 2,
      "text": "Dredge the shrimp in the seasoned flour, shaking off excess. Let the coated shrimp rest for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Whisk the hot pepper sauce, melted butter, minced garlic, and remaining cayenne until combined; set aside."
    },
    {
      "step": 4,
      "text": "Heat the frying oil to 350°F."
    },
    {
      "step": 5,
      "text": "Fry the shrimp in batches for about 3 minutes, turning as needed, until crisp and opaque throughout or until they reach 145°F.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Drain the shrimp briefly, then toss with the sauce and serve."
    }
  ],
