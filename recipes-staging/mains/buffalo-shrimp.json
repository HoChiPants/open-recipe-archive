  "id": "buffalo-shrimp",
  "name": "Buffalo Shrimp",
  "subtitle": "Crisp fried shrimp tossed in a spicy garlic sauce",
  "description": "Seasoned shrimp are fried until opaque and crisp, then coated in a buttery hot-pepper sauce.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "creole-style-seasoning",
      "item": "Creole-style seasoning",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-cayenne-pepper",
      "item": "ground cayenne pepper",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
