  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large pot over medium heat. Add the onion, bell peppers, jalapeno, garlic, and salt; cook until tender.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the chili powder, cumin, oregano, and tomato paste. Add the diced tomatoes and water, then simmer until thickened.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Drain the black beans, kidney beans, and chickpeas. Stir all three beans into the chili and cook until heated through.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Whisk the optional sour cream until smooth. Serve the chili with sour cream, shredded Cheddar cheese, and fresh cilantro leaves, if desired."
    }
