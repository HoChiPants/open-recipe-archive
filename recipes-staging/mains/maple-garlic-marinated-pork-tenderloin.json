  "instructions": [
    {
      "step": 1,
      "text": "Whisk the Dijon mustard, sesame oil, minced garlic, black pepper, and maple syrup together. Coat the pork tenderloin with the marinade, cover, and chill for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Preheat the grill over medium heat for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Transfer the marinated pork tenderloin to the grill. Cook for about 25 minutes, turning as needed, until the center reaches 145°F on a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Remove the pork from the grill and let it rest for 3 minutes before slicing.",
      "timer_minutes": 3
    }
  ],
