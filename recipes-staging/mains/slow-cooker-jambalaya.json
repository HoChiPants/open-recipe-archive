  "instructions": [
    {
      "step": 1,
      "text": "Add the tomatoes, chicken, sausage, onion, bell pepper, celery, broth, oregano, parsley, Cajun seasoning, cayenne, and thyme to a slow cooker. Stir to combine."
    },
    {
      "step": 2,
      "text": "Cover and cook for 180 minutes, until the chicken reaches 165°F in the thickest pieces and the sausage reaches 160°F.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Stir in the frozen cooked shrimp, cover, and continue cooking until heated through and opaque.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Serve hot."
    }
  ],
