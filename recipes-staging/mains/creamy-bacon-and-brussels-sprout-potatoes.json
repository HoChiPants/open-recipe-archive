  "id": "creamy-bacon-and-brussels-sprout-potatoes",
  "name": "Creamy Bacon and Brussels Sprout Potatoes",
  "subtitle": "Crisp roasted potatoes with a creamy bacon and sprout topping",
  "description": "Roasted seasoned potatoes are finished with a savory skillet topping of bacon, shredded Brussels sprouts, mustard, and cream.",
  "meal_type": "main",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "floury-potatoes-like-maris-piper",
      "item": "floury potatoes (like Maris Piper)",
      "quantity": 125,
      "unit": "g",
      "preparation": "halved or quarted if large"
    },
    {
      "ingredient_id": "heaped-tbsp-plain-flour",
      "item": "heaped tbsp plain flour",
      "quantity": 1
    },
    {
      "ingredient_id": "onion-granules",
      "item": "onion granules",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "dried-rosemary",
      "item": "dried rosemary",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 50,
      "unit": "ml"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 20,
      "unit": "g"
    },
    {
      "ingredient_id": "smoked-bacon-roughly-chopped",
      "item": "smoked bacon roughly chopped",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "brussels-sprouts-shredded",
      "item": "brussels sprouts shredded",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "garlic-paste",
      "item": "garlic paste",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "wholegrain-mustard",
      "item": "wholegrain mustard",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 100,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Boil the potatoes for 12 minutes, then drain well.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Mix the plain flour, onion granules, and dried rosemary. Toss the drained potatoes with this mixture and the olive oil."
    },
    {
      "step": 3,
      "text": "Roast the coated potatoes until crisp and tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Melt the butter in a skillet and cook the chopped bacon for 6 minutes, until set and cooked through.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Add the shredded Brussels sprouts and cook for 10 minutes, stirring occasionally.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Stir in the garlic paste, Worcestershire sauce, and wholegrain mustard; cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Whisk in the double cream and cook for about 3 minutes, until thickened.",
      "timer_minutes": 3
    },
    {
      "step": 8,
      "text": "Spoon the creamy bacon and sprout mixture over the roasted potatoes and serve."
    }
  ],
