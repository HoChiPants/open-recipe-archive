  "id": "chicken-enchiladas-adcfa2d2",
  "name": "Chicken Enchiladas",
  "subtitle": "Creamy chicken enchiladas with green chiles and melted cheese",
  "description": "Tender chicken and spicy peppers are wrapped in flour tortillas, covered with a creamy cheese sauce, and baked until golden.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "bone-in-chicken-breast-halves",
      "item": "bone-in chicken breast halves",
      "quantity": 4
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "green-chile-peppers",
      "item": "green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "4 ounce, diced, drained"
    },
    {
      "ingredient_id": "jalapeno-pepper",
      "item": "jalapeno pepper",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "monterey-jack-cheese",
      "item": "Monterey Jack cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded, divided"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "10-inch-flour-tortillas",
      "item": "(10 inch) flour tortillas",
      "quantity": 8
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the bone-in chicken breast halves and water in a pot. Bring to a simmer and cook for 20 minutes, or until the thickest portion reaches 165°F.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Remove the chicken and let it cool enough to handle. Remove the bones and shred the meat."
    },
    {
      "step": 3,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 4,
      "text": "Heat the olive oil in a skillet. Add the green chile peppers, jalapeno pepper, and garlic; cook briefly until fragrant."
    },
    {
      "step": 5,
      "text": "Whisk the cream cheese, heavy cream, and half of the Monterey Jack cheese in the skillet until smooth. Stir in the water and combine until set."
    },
    {
      "step": 6,
      "text": "Stir the shredded chicken into the sauce."
    },
    {
      "step": 7,
      "text": "Spoon the chicken mixture into the (10 inch) flour tortillas, roll them, and arrange them seam-side down in a baking dish."
    },
    {
      "step": 8,
      "text": "Cover with the remaining Monterey Jack cheese and bake for 30 minutes, until golden brown and heated through.",
      "timer_minutes": 30
    }
  ],
