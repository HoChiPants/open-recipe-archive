  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large skillet over medium-high heat."
    },
    {
      "step": 2,
      "text": "Mix 2 tablespoons cornflour, the plain flour, 1/2 teaspoon Kashmiri chilli powder, 1 tablespoon hot chilli sauce, the chopped green chilli, and green pepper into a smooth coating. Add the paneer and toss until covered."
    },
    {
      "step": 3,
      "text": "Sauté the coated paneer in the hot oil, turning often, until crisp and lightly browned. Transfer to a plate and set aside."
    },
    {
      "step": 4,
      "text": "Whisk the remaining 2 teaspoons cornflour with the soy sauce, remaining hot chilli sauce, ketchup, rice vinegar, and honey until smooth."
    },
    {
      "step": 5,
      "text": "Add the ginger, garlic, remaining Kashmiri chilli powder, red onion, and green pepper to the skillet. Sauté until the vegetables soften and lightly brown."
    },
    {
      "step": 6,
      "text": "Pour in the sauce mixture and cook briefly, stirring, until thickened."
    },
    {
      "step": 7,
      "text": "Return the paneer to the skillet and toss to coat. Scatter with the sliced spring onion and serve with the cooked rice."
    }
  ],
