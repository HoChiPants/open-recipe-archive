  "id": "spinach-chicken-parmesan",
  "name": "Spinach Chicken Parmesan",
  "subtitle": "Baked chicken with creamy spinach and Parmesan",
  "description": "Chicken breasts are baked under a savory spinach-Parmesan sauce until tender.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
