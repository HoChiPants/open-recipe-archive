    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "skim-milk",
      "item": "skim milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "10 ounce, thawed and drained"
    },
    {
      "ingredient_id": "pimento-peppers",
      "item": "pimento peppers",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the Parmesan cheese and Italian seasoning. Press the mixture over the chicken breasts, then arrange them in a baking dish."
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet over medium heat. Sauté the green onions until tender."
    },
    {
      "step": 4,
      "text": "Stir in the flour and skim milk. Simmer, stirring, until the mixture thickens."
    },
    {
      "step": 5,
      "text": "Stir in the spinach and pimento peppers, then add the remaining Parmesan mixture."
    },
    {
      "step": 6,
      "text": "Pour the spinach sauce over the chicken. Bake for 35 minutes, or until the chicken is tender and reaches 165°F at the thickest point.",
      "timer_minutes": 35
    }
  ],
