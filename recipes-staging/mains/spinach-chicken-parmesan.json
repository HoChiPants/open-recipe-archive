      "item": "Italian seasoning",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 6,
      "preparation": "boneless chicken breasts"
    },
    {
