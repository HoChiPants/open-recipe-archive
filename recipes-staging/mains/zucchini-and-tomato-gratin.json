  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Lightly oil a baking dish and season the sliced tomatoes with salt and pepper."
    },
    {
      "step": 2,
      "text": "Warm the olive oil in a skillet over medium heat. Add the zucchini and crushed garlic, season lightly, and cook until the zucchini is golden brown, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Arrange the zucchini and tomatoes in the baking dish, then layer the mozzarella, Parmesan, and basil over the vegetables. Season with additional salt and pepper as needed."
    },
    {
      "step": 4,
      "text": "Bake until the cheeses are melted and the top is lightly browned, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
