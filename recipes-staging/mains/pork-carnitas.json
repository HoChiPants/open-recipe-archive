  "id": "pork-carnitas",
  "name": "Pork Carnitas",
  "subtitle": "Tender citrus-spiced pork with crisp edges",
  "description": "Pork shoulder is slowly cooked with garlic, orange, warm spices, and bay leaves, then briefly crisped before serving.",
  "meal_type": "main",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
