  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 275°F."
    },
    {
      "step": 2,
      "text": "Cut the pork shoulder into large chunks. Combine it with the garlic, olive oil, orange juice and peel, salt, bay leaves, pepper, cumin, cinnamon, and five-spice powder."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a covered ovenproof pot or baking dish and bake until the pork is tender and reaches at least 145°F in the thickest pieces. Remove the cover and rest the pork for 3 minutes.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Heat the broiler. Remove the garlic, orange peel, and bay leaves, then transfer the pork to a broiler-safe pan."
    },
    {
      "step": 5,
      "text": "Separate the pork into bite-size pieces and broil until the edges are browned and crisp, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Let the pork stand for 5 minutes, then transfer it to a serving dish.",
      "timer_minutes": 5
    }
  ],
