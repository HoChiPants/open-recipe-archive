  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a large pot over medium heat. Add the cubed chicken and cook until no longer pink and the thickest pieces reach 165°F."
    },
    {
      "step": 2,
      "text": "Add the bell pepper, onion, jalapeños, 1 quart broth, black pepper, and cayenne. Simmer for 7 minutes, until the vegetables begin to soften.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Stir in the garlic and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the salsa, chili powder, cumin, salt, paprika, and remaining seasonings. Simmer for 20 minutes, until the chicken is tender and the flavors combine.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Fold in the beans and cilantro, then cook for 10 minutes more. Serve hot.",
      "timer_minutes": 10
    }
  ],
