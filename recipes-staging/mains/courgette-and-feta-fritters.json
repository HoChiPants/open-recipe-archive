      "item": "vegetable or sunflower oil for air-frying"
    },
    {
      "ingredient_id": "yogurt-drizzled-with-olive-oil",
      "item": "yogurt drizzled with olive oil",
      "preparation": "to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the grated courgettes and leave them for 60 minutes to release excess moisture.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Drain the courgettes thoroughly, squeezing out as much liquid as possible."
    },
    {
      "step": 3,
      "text": "Mix the feta, spring onions, parsley, and dill in a bowl. In a separate bowl, combine the flour and breadcrumbs."
    },
    {
      "step": 4,
      "text": "Add the courgettes and egg to the feta mixture, then mix until evenly combined."
    },
    {
      "step": 5,
      "text": "Shape the mixture into eight fritters and coat them with the flour-and-breadcrumb mixture."
    },
    {
      "step": 6,
      "text": "Preheat the air fryer for 12 minutes, following its preheat setting.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Lightly oil the fritters and arrange them in the air-fryer basket without crowding. Cook in batches as needed for 8 minutes per batch, turning if required, until firm and the centers are fully set; verify the egg-containing center reaches 160°F.",
      "timer_minutes": 8
    },
    {
      "step": 8,
      "text": "Prepare the yogurt drizzled with olive oil and serve it with the hot fritters."
    }
  ],
