  "id": "courgette-and-feta-fritters",
  "name": "Courgette and Feta Fritters",
  "subtitle": "Crisp vegetable fritters with herbed yogurt",
  "description": "Grated courgettes, feta, herbs, and breadcrumbs form savory fritters for air-frying and serving with yogurt.",
  "meal_type": "main",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "courgettes-about-650g",
      "item": "courgettes (about 650g)",
      "quantity": 3,
      "preparation": "coarsely grated"
    },
    {
      "ingredient_id": "feta",
      "item": "feta",
      "quantity": 75,
      "unit": "g"
    },
    {
