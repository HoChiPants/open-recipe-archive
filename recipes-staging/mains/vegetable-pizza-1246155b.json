  "id": "vegetable-pizza-1246155b",
  "name": "Vegetable Pizza",
  "subtitle": "A chilled crescent-crust appetizer topped with creamy dressing and crisp vegetables.",
  "description": "Bake a crescent-roll crust, spread it with a seasoned cream cheese mixture, add chopped vegetables and Cheddar, then chill before cutting.",
  "meal_type": "main",
  "cuisine": "American",
