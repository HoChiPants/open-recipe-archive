  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Press the crescent rolls into a single even crust on a baking sheet or shallow pan, sealing the seams."
    },
    {
      "step": 2,
      "text": "Bake the crust for 12 minutes, until lightly golden. Cool completely for 15 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Whisk the softened cream cheese, mayonnaise, and dressing mix until smooth. Stir in the shredded Cheddar cheese."
    },
    {
      "step": 4,
      "text": "Transfer the creamy mixture to the cooled crust and spread it evenly. Scatter the broccoli, tomatoes, bell pepper, cauliflower, and carrots over the top."
    },
    {
      "step": 5,
      "text": "Chill for 60 minutes, then cut into portions and serve.",
      "timer_minutes": 60
    }
  ],
