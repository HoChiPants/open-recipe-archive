  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 500°F."
    },
    {
      "step": 2,
      "text": "Roast the prime rib briefly at the high temperature."
    },
    {
      "step": 3,
      "text": "Combine the sliced garlic, salt, pepper, and Dijon mustard, then spread the mixture over the roast."
    },
    {
      "step": 4,
      "text": "Continue roasting for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Continue roasting for another 90 minutes, or until the thickest part reaches 145°F on a food thermometer.",
      "timer_minutes": 90
    },
    {
      "step": 6,
      "text": "Remove the roast and let it rest for at least 3 minutes before carving."
    }
  ],
