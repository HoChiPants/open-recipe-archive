  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large heavy pot. Stir together the yogurt and vinegar, then add the onion and cook until tender."
    },
    {
      "step": 2,
      "text": "Add the tomatoes, green chile peppers, garlic, ginger paste, and salt and pepper. Cook, stirring, until the tomatoes are tender."
    },
    {
      "step": 3,
      "text": "Stir in the garam masala, dried mint, remaining salt and pepper, and cilantro. Add the chicken and turn to coat it in the sauce."
    },
    {
      "step": 4,
      "text": "Cover and cook the chicken mixture for 45 minutes, or until the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Meanwhile, bring the water to a simmer with the rice, green chile peppers, cinnamon stick, bay leaf, green cardamom, black cardamom, and salt and pepper."
    },
    {
      "step": 6,
      "text": "Cook the rice for 20 minutes, until tender. Remove the cinnamon stick, bay leaf, and cardamom pods, then drain or transfer the rice as needed.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Combine the rice with the chicken mixture and sprinkle in the powdered yellow food coloring. Fold gently until evenly mixed and serve hot."
    }
  ],
