  "id": "chicken-french",
  "name": "Chicken French",
  "subtitle": "Golden chicken cutlets with lemon-sherry pan sauce",
  "description": "Tender chicken cutlets are coated, browned, and finished with a bright lemon pan sauce enriched with butter and parsley.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
