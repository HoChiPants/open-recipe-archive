  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs and milk in a shallow bowl. In a second shallow bowl, whisk the flour with the salt, black pepper, cayenne, and additional salt and pepper to taste."
    },
    {
      "step": 2,
      "text": "Dredge each chicken cutlet in the seasoned flour, then dip it in the egg mixture, letting excess drip away."
    },
    {
      "step": 3,
      "text": "Heat the olive oil and butter in a large skillet over medium-high heat until hot.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Cook the chicken until lightly browned, about 3 minutes per side, working in batches if needed. Transfer the chicken to a plate and verify the thickest piece reaches 165°F.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the vegetable broth, dry sherry, and lemon juice to the skillet. Bring to a simmer, scraping up browned bits."
    },
    {
      "step": 6,
      "text": "Return the chicken to the skillet and simmer briefly until hot and fully cooked."
    },
    {
      "step": 7,
      "text": "Stir in the cold butter until melted, then season with salt and pepper and stir in the parsley.",
      "timer_minutes": 2
    }
  ],
