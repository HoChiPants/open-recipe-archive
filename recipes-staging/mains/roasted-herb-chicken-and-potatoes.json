  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Cut the potatoes into thick pieces."
    },
    {
      "step": 2,
      "text": "Stir together the soy sauce, oil, vinegar, garlic, oregano, rosemary, and pepper."
    },
    {
      "step": 3,
      "text": "Arrange the potatoes and onion in a roasting pan and coat them evenly with the soy mixture."
    },
    {
      "step": 4,
      "text": "Prepare the chicken, drain it if needed, and place it over the vegetables. Coat the chicken with the remaining seasoning mixture."
    },
    {
      "step": 5,
      "text": "Roast for 60 minutes, or until the thickest part of the chicken reaches 165°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Let the chicken rest for 10 minutes before carving and serving with the vegetables.",
      "timer_minutes": 10
    }
  ],
