  "id": "baked-chicken-pepperoni",
  "name": "Baked Chicken Pepperoni",
  "subtitle": "Chicken breasts baked with herbed tomato sauce, mozzarella, and turkey pepperoni.",
  "description": "A simple oven-baked chicken dinner layered with seasoned spaghetti sauce, melted mozzarella, and turkey pepperoni.",
  "meal_type": "main",
