  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Combine the oregano and dried basil."
    },
    {
      "step": 2,
      "text": "Lightly coat a skillet with cooking spray over medium heat. Add the garlic and stir for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the spaghetti sauce and cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Spread some sauce in a baking dish, arrange the chicken breasts over it, and coat them with the remaining sauce."
    },
    {
      "step": 5,
      "text": "Top with the mozzarella and turkey pepperoni."
    },
    {
      "step": 6,
      "text": "Bake until the cheese is melted and the chicken reaches 165°F in the thickest part, extending the baking time if needed.",
      "timer_minutes": 10
    }
  ],
