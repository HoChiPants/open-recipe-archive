  "instructions": [
    {
      "step": 1,
      "text": "Rinse the brown rice and quinoa. Cook them according to their separate package directions until tender, then drain and keep warm.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a large skillet. Add the sliced red onion and cumin seeds; cook until the onion begins to soften."
    },
    {
      "step": 3,
      "text": "Add the chicken, minced garlic, and minced ginger. Cook, stirring, until the chicken is no longer raw on the outside."
    },
    {
      "step": 4,
      "text": "Stir in the tomato purée, turmeric, ground coriander, Kashmiri chilli powder, and garam masala."
    },
    {
      "step": 5,
      "text": "Add the sliced peppers and simmer until the chicken reaches 165°F in the thickest pieces and the peppers are tender.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Fold in the spinach and cook until wilted. Serve with the brown rice and quinoa, garnished with the fresh coriander."
    }
  ],
