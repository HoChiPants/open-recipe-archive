  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Season the chicken inside and out with salt and pepper."
    },
    {
      "step": 3,
      "text": "Arrange the onions, potatoes, carrots, and celery in a roasting pan. Set the chicken among the vegetables and pour the water into the pan."
    },
    {
      "step": 4,
      "text": "Roast for 120 minutes, or until golden brown and a thermometer inserted into the thickest part of the chicken reaches 165°F.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Let the chicken rest for 10 minutes before carving and serving with the vegetables.",
      "timer_minutes": 10
    }
  ],
