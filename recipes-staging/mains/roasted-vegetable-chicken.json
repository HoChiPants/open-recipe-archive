  "id": "roasted-vegetable-chicken",
  "name": "Roasted Vegetable Chicken",
  "subtitle": "A simple oven-roasted chicken with hearty vegetables",
  "description": "A whole seasoned chicken roasts over onions, potatoes, carrots, and celery for a complete, comforting main dish.",
  "meal_type": "main",
