      "item": "(8 ounce) thick-cut boneless",
      "quantity": 2,
      "preparation": "skinless Chilean sea bass fillets"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 450°F. Place the quartered potatoes in a microwave-safe dish, toss with the olive oil, and microwave for 5 minutes, or until partly tender.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk together the sherry vinegar, smoked paprika, kosher salt, green onions, and jalapeño. Toss the warm potatoes with the mixture."
    },
    {
      "step": 3,
      "text": "Arrange the potatoes in a baking dish or on a sheet pan. Place the sea bass fillets among them, drizzle with additional olive oil, and season with smoked paprika and kosher salt."
    },
    {
      "step": 4,
      "text": "Bake for 15 minutes, until the fish reaches 145°F in the thickest part or is opaque and flakes easily.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Serve immediately, seasoning with additional salt to taste."
    }
  ],
