  "id": "spanish-style-sea-bass-with-paprika-potatoes",
  "name": "Spanish-Style Sea Bass with Paprika Potatoes",
  "subtitle": "Roasted sea bass with tangy paprika potatoes",
  "description": "Tender sea bass fillets roast over quickly softened potatoes dressed with sherry vinegar, smoked paprika, green onions, and jalapeño.",
  "meal_type": "main",
  "cuisine": "Spanish",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
