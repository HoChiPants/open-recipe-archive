  "id": "slow-cooker-pot-roast-c513cef3",
  "name": "Slow Cooker Pot Roast",
  "subtitle": "Tender beef with potatoes and garden vegetables",
  "description": "A straightforward slow-cooked beef roast served with potatoes, carrots, celery, onions, and parsley.",
  "meal_type": "main",
