  "instructions": [
    {
      "step": 1,
      "text": "Season the chuck roast all over with salt and ground black pepper."
    },
    {
      "step": 2,
      "text": "Preheat a large skillet over medium-high heat. Sear the roast for 4 minutes, turning as needed to brown the surface.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Transfer the roast to a slow cooker. Add the beef stock and chopped onions."
    },
    {
      "step": 4,
      "text": "Cover and cook on the slow cooker’s low setting for 5 hours.",
      "timer_minutes": 300
    },
    {
      "step": 5,
      "text": "Add the potatoes, carrots, celery, and parsley. Cover and continue cooking for 3 hours, until the vegetables are tender and the roast is fork-tender.",
      "timer_minutes": 180
    },
    {
      "step": 6,
      "text": "Check that the roast reaches at least 145°F in the thickest part, then let it rest for 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
