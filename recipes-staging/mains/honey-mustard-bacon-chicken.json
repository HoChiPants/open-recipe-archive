      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "fresh-mushrooms",
      "item": "fresh mushrooms",
      "quantity": 1,
      "unit": "cup",
      "preparation": "sliced"
    },
    {
