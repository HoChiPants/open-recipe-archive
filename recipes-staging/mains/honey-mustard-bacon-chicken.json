  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken evenly with seasoning salt and refrigerate for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Whisk the mustard, honey, corn syrup, mayonnaise, and onion flakes together; chill until set."
    },
    {
      "step": 3,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 4,
      "text": "Cook the bacon in a skillet until browned, then drain."
    },
    {
      "step": 5,
      "text": "Heat the oil in the skillet, add the mushrooms, and cook for 5 minutes. Transfer the mushrooms to a baking dish.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Arrange the chicken in the dish and spread with the mustard-honey sauce. Top with the bacon, mushrooms, and shredded cheese."
    },
    {
      "step": 7,
      "text": "Bake until the cheese is melted and the thickest chicken portion reaches 165°F.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Garnish with parsley and serve with any remaining sauce."
    }
  ],
