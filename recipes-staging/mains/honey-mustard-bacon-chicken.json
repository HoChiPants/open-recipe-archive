  "id": "honey-mustard-bacon-chicken",
  "name": "Honey-Mustard Bacon Chicken",
  "subtitle": "Baked chicken with mushrooms, bacon, and melted cheese",
  "description": "Seasoned chicken is paired with a sweet mustard sauce, sautéed mushrooms, bacon, and cheese, then baked until tender and fully cooked.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves - pounded to 1/2 inch thickness"
    },
    {
      "ingredient_id": "seasoning-salt",
      "item": "seasoning salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 6,
      "preparation": "cut in half"
    },
