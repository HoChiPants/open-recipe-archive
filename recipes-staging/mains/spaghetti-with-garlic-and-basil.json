  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of water to a simmer and season with the salt and pepper."
    },
    {
      "step": 2,
      "text": "Add the spaghetti and cook for 10 minutes, or until tender.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Drain the spaghetti, then toss it with the olive oil, melted butter, garlic, and basil until evenly coated."
    },
    {
      "step": 4,
      "text": "Serve topped with the grated Parmesan cheese."
