  "id": "mustard-chicken",
  "name": "Mustard Chicken",
  "subtitle": "Baked chicken with a crisp onion coating",
  "description": "Chicken breasts are coated in prepared mustard and French-fried onions, then baked until fully cooked.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breasts"
    },
    {
      "ingredient_id": "prepared-mustard",
      "item": "prepared mustard",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "french-fried-onions",
      "item": "French-fried onions",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Spread the prepared mustard in a shallow dish. Place the French-fried onions in another shallow dish, then coat each chicken breast with mustard and press it into the onions."
    },
    {
      "step": 3,
      "text": "Transfer the coated chicken to a baking dish."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, or until the thickest part reaches 165°F and the chicken is cooked through.",
      "timer_minutes": 60
    }
  ],
