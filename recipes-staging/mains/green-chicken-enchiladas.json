{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "green-chicken-enchiladas",
  "name": "Green Chicken Enchiladas",
  "subtitle": "Tender chicken rolled in tortillas with green sauce and melted cheese",
  "description": "Shredded chicken and Monterey Jack are wrapped in flour tortillas, covered with green enchilada sauce, and baked until hot and bubbling.",
  "meal_type": "main",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 1,
      "unit": "pound",
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "monterey-jack-cheese",
      "item": "Monterey Jack cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, shredded"
    },
    {
      "ingredient_id": "10-inch-flour-tortillas",
      "item": "(10 inch) flour tortillas",
      "quantity": 12
    },
    {
      "ingredient_id": "green-enchilada-sauce",
      "item": "green enchilada sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "19 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Transfer the chicken to a saucepan, cover with water, and bring to a gentle simmer. Cook for 25 minutes, or until the thickest piece reaches 165°F on a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Let the chicken cool for 10 minutes, then shred it.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 4,
      "text": "Spread a thin layer of green enchilada sauce in a baking dish. Set aside some Monterey Jack for topping."
    },
    {
      "step": 5,
      "text": "Fill each tortilla with shredded chicken and some cheese, roll tightly, and arrange seam-side down in the dish."
    },
    {
      "step": 6,
      "text": "Pour the remaining green enchilada sauce over the rolled tortillas and top with the reserved cheese."
    },
    {
      "step": 7,
      "text": "Bake for 30 minutes, until the enchiladas are hot and the cheese is melted.",
      "timer_minutes": 30
    }
  ],
