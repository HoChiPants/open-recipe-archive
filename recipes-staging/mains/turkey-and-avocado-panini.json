  "id": "turkey-and-avocado-panini",
  "name": "Turkey and Avocado Panini",
  "subtitle": "Pressed ciabatta with creamy avocado, turkey, peppers, and spinach",
  "description": "A crisp, warm panini layered with avocado mayonnaise, smoked turkey, provolone, roasted peppers, and fresh spinach.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "ripe-avocado",
      "item": "ripe avocado",
      "quantity": 0.5
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "ciabatta-rolls",
      "item": "ciabatta rolls",
      "quantity": 2
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "divided"
    },
    {
      "ingredient_id": "slices-provolone-cheese",
      "item": "slices provolone cheese",
      "quantity": 2
    },
    {
      "ingredient_id": "whole-fresh-spinach-leaves",
      "item": "whole fresh spinach leaves",
      "quantity": 1,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "thinly-sliced-mesquite-smoked-turkey-breast",
      "item": "thinly sliced mesquite smoked turkey breast",
      "quantity": 0.25,
      "unit": "pound"
    },
    {
      "ingredient_id": "roasted-red-peppers",
      "item": "roasted red peppers",
      "quantity": 2,
      "preparation": "sliced into strips"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mash the avocado with the mayonnaise until combined."
    },
    {
      "step": 2,
      "text": "Preheat a panini press or heavy skillet. Split the ciabatta rolls and brush the cut sides lightly with some of the divided olive oil."
    },
    {
      "step": 3,
      "text": "Layer each roll with avocado mixture, provolone, spinach, smoked turkey, and roasted red pepper strips; close the sandwiches."
    },
    {
      "step": 4,
      "text": "Brush the outsides with the remaining olive oil and place the sandwiches in the press or skillet."
    },
    {
      "step": 5,
      "text": "Cook until the bread is golden brown and the cheese is melted, about 8 minutes. If the turkey is not fully cooked, heat the sandwich until its center reaches 165°F.",
      "timer_minutes": 8
    }
  ],
