      "item": "dried mixed herbs",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "penne",
      "item": "penne",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "ball-mozzarella-drained-and-torn-into-pieces",
      "item": "ball mozzarella drained and torn into pieces",
      "quantity": 125,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Butter a suitable round baking tin. Slice the courgettes lengthwise into thin strips and prepare them until pliable, then drain and cool."
    },
    {
      "step": 2,
      "text": "Heat the oven while preparing the filling."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a pan. Remove the sausage meat from its casings, crumble it into the pan, and cook with the onion until the sausage reaches 160°F internally.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the nduja, chopped tomatoes, and dried herbs; simmer until combined and thickened.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Cook the penne in boiling water until just tender, then drain. Stir it into the sauce with the mozzarella."
    },
    {
      "step": 6,
      "text": "Line the buttered tin with the courgette strips, overlapping them and leaving enough overhang to cover the filling. Fold in the pasta mixture and cover the top with the remaining courgette."
    },
    {
      "step": 7,
      "text": "Bake until golden brown and hot throughout.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Rest the timballo before cutting and serving.",
      "timer_minutes": 20
    }
  ],
