  "id": "courgette-and-sausage-timballo",
  "name": "Courgette and Sausage Timballo",
  "subtitle": "A layered baked pasta with courgette, spicy sausage, tomato, and mozzarella.",
  "description": "Courgette forms a tender shell around penne tossed with sausage, nduja, tomato, herbs, and mozzarella, then baked until golden.",
  "meal_type": "main",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "knob-of-butter-for-the-tin",
      "item": "knob of butter for the tin"
    },
    {
      "ingredient_id": "courgettes",
      "item": "courgettes",
      "quantity": 6
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": "2-3",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "red-onion-finely-chopped",
      "item": "red onion finely chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "sausages-of-your-choice",
      "item": "sausages of your choice",
      "quantity": 4
    },
    {
      "ingredient_id": "nduja-paste-depending-on-your-preference-for-chilli-heat",
      "item": "nduja paste (depending on your preference for chilli heat)",
      "quantity": "2-3",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "can-chopped-tomatoes",
      "item": "can chopped tomatoes",
      "quantity": 400,
      "unit": "g"
    },
    {
