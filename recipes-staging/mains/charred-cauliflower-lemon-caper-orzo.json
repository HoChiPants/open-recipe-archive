  "id": "charred-cauliflower-lemon-caper-orzo",
  "name": "Charred Cauliflower, Lemon & Caper Orzo",
  "subtitle": "A bright, savory orzo bowl with roasted cauliflower and capers",
  "description": "Tender orzo is tossed with charred cauliflower, lemon, garlic, capers, and vegetable stock, then finished with peppery rocket.",
  "meal_type": "main",
  "yield": {
    "quantity": 1,
    "unit": ", plus 1 lunchbox for leftovers"
