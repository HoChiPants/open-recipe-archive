  "instructions": [
    {
      "step": 1,
      "text": "Heat the grill or broiler. Toss the cauliflower florets and chopped stalk with the olive oil, arrange on a tray, and grill until tender and charred.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Meanwhile, cook the orzo in boiling water until tender, about 8 minutes. Drain well.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Warm the capers and sliced garlic briefly in the cooking pan."
    },
    {
      "step": 4,
      "text": "Add the drained orzo, lemon zest and juice, vegetable stock, and most of the cauliflower. Stir until combined and warmed through."
    },
    {
      "step": 5,
      "text": "Top with the remaining cauliflower and rocket. Serve warm or let cool for a lunchbox.",
      "timer_minutes": 1
    }
  ],
