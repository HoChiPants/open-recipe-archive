  "instructions": [
    {
      "step": 1,
      "text": "Warm a dry skillet over medium heat. Toast the dried guajillo chilies, ground ancho chile powder, and dried oregano for 5 minutes, turning as needed. Remove from the heat and let cool.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Toast the cumin seeds and cloves briefly in the same skillet, then crush or grind them."
    },
    {
      "step": 3,
      "text": "Cover the toasted dried guajillo chilies and ground ancho chile powder with the boiling water. Let stand for 60 minutes, until softened.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Blend the soaked chile mixture with the cumin seeds, cloves, onion, garlic, dried oregano, ground thyme, apple cider vinegar, and lime juice until smooth."
    },
    {
      "step": 5,
      "text": "Place the boneless beef chuck roast in a large dish and coat it thoroughly with the sauce. Cover and refrigerate for 10 hours.",
      "timer_minutes": 600
    },
    {
      "step": 6,
      "text": "Preheat the oven to 325°F. Transfer the roast and sauce to a covered oven-safe pot and add the bay leaves."
    },
    {
      "step": 7,
      "text": "Bake for 6 hours, or until the beef is fork-tender and reaches at least 145°F internally. Rest for 3 minutes, then remove the bay leaves and shred or slice the beef.",
      "timer_minutes": 360
    }
  ],
