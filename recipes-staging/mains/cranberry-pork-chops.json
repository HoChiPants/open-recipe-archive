  "id": "cranberry-pork-chops",
  "name": "Cranberry Pork Chops",
  "subtitle": "Tender pork chops with a sweet-tart cranberry sauce",
  "description": "Pork chops simmer gently with cranberries, sugar, and simple seasonings for a comforting, fruit-forward main dish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "pork-chops",
      "item": "pork chops",
      "quantity": 6
    },
    {
      "ingredient_id": "fresh-or-frozen-cranberries",
      "item": "fresh or frozen cranberries",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "water-as-needed",
      "item": "water as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare the pork chops and drain any excess liquid."
    },
    {
      "step": 2,
      "text": "Preheat a large covered skillet or Dutch oven over medium heat."
    },
    {
      "step": 3,
      "text": "Add the pork chops, cranberries, sugar, salt, pepper, and enough water to keep the mixture moist."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a gentle simmer, cover, and cook until the pork is tender, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Check the thickest chop with a food thermometer; whole-cut pork should reach 145°F, then rest for 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
