  "id": "paprika-grilled-chicken",
  "name": "Paprika-Grilled Chicken",
  "subtitle": "Yogurt-marinated chicken with a tangy paprika finish",
  "description": "Chicken pieces marinate in a garlicky paprika yogurt mixture, grill until cooked through, and receive a sharp vinegar-based sauce before serving.",
  "meal_type": "main",
  "cuisine": "American",
