  "instructions": [
    {
      "step": 1,
      "text": "Whisk the yogurt, crushed garlic, ground paprika, 2 tablespoons olive oil, 1 tablespoon chile paste, cayenne, paprika, and salt and pepper to taste in a bowl."
    },
    {
      "step": 2,
      "text": "Coat the chicken pieces with the yogurt mixture, cover, and refrigerate for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Preheat the grill. Remove excess marinade from the chicken and season with salt."
    },
    {
      "step": 4,
      "text": "Stir together the remaining olive oil, sherry vinegar, ketchup, chile paste, paprika, and salt and pepper to taste; set aside."
    },
    {
      "step": 5,
      "text": "Grill the chicken for 4 minutes, turn, and grill for 6 minutes more, adjusting as needed for even cooking.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Check the thickest pieces with a food thermometer; poultry should reach 165°F. Let the chicken rest briefly, then serve with the vinegar sauce."
    }
  ],
