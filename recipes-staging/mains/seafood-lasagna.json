  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Bring salted water to a boil. Cook the lasagna noodles for 10 minutes, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet and cook the minced onion until tender."
    },
    {
      "step": 4,
      "text": "Stir together the cottage cheese, softened cream cheese, beaten egg, basil, salt, pepper, Cheddar, and Parmesan."
    },
    {
      "step": 5,
      "text": "Combine the mushroom soup, shrimp, crabmeat, milk, wine, and cooked onion."
    },
    {
      "step": 6,
      "text": "Layer noodles, cheese mixture, and seafood sauce in a baking dish, repeating as needed and finishing with the remaining sauce."
    },
    {
      "step": 7,
      "text": "Bake for 45 minutes, until the center is fully set and reaches 165°F on a food thermometer.",
      "timer_minutes": 45
    }
  ],
