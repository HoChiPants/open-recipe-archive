  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "orange-glazed-roast-duck",
  "name": "Orange-Glazed Roast Duck",
  "subtitle": "Tender roast duck with a sweet citrus glaze",
  "description": "A whole duck roasted with orange, barbecue, teriyaki, and mushroom flavors for a glossy, savory-sweet finish.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 150
  },
  "ingredients": [
    {
      "ingredient_id": "or-bottle-orange-soda",
      "item": "or bottle orange soda",
      "quantity": 1,
      "unit": "can",
      "preparation": "12 fluid ounce"
    },
    {
      "ingredient_id": "frozen-orange-juice-concentrate",
      "item": "frozen orange juice concentrate",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce, thawed"
    },
    {
      "ingredient_id": "honey-barbecue-sauce",
      "item": "honey barbecue sauce",
      "quantity": 0.5,
      "unit": "bottle",
      "preparation": "18 ounce"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "bottled-teriyaki-sauce",
      "item": "bottled teriyaki sauce",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "5-pound-whole-frozen-duckling",
      "item": "(5 pound) whole frozen duckling",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "mushrooms",
      "item": "mushrooms",
      "quantity": 1,
      "unit": "can",
      "preparation": "4.5 ounce, sliced, drained"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the orange soda, orange juice concentrate, honey barbecue sauce, brown sugar, and teriyaki sauce together until smooth."
    },
    {
      "step": 2,
      "text": "Heat the oven to 350°F. Place the thawed duck in a roasting pan and pour the orange soda and orange juice concentrate over it."
    },
    {
      "step": 3,
      "text": "Add the remaining glaze mixture and the mushrooms to the roasting pan."
    },
    {
      "step": 4,
      "text": "Roast for 120 minutes, basting occasionally with the pan juices. Continue roasting for 30 minutes, or until the thickest part of the duck reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
