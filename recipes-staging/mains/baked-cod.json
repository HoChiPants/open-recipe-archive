{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "baked-cod",
  "name": "Baked Cod",
  "subtitle": "Flour-coated cod with lemon and thyme",
  "description": "Cod fillets are lightly coated in flour, briefly browned in olive oil, then finished in the oven with lemon and thyme.",
  "meal_type": "main",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "cod-loin-fillets",
      "item": "cod loin fillets",
      "quantity": 4
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "lemon-sliced",
      "item": "lemon sliced",
      "quantity": 1
    },
    {
      "ingredient_id": "bunch-of-thyme",
      "item": "bunch of thyme",
      "quantity": "1/2",
      "unit": "small"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and warm the olive oil in an ovenproof skillet."
    },
    {
      "step": 2,
      "text": "Add the flour to a shallow dish and coat the cod fillets evenly."
    },
    {
      "step": 3,
      "text": "Place the coated cod in the skillet and cook until lightly golden brown, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Transfer the skillet to the oven. Arrange the sliced lemon and thyme around the fish."
    },
    {
      "step": 5,
      "text": "Bake until the cod is opaque, flakes easily, and reaches 145°F internally.",
      "timer_minutes": 10
    }
  ],
