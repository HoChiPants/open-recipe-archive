  "id": "steak-au-poivre",
  "name": "Steak au Poivre",
  "subtitle": "Pepper-crusted tenderloin with a creamy pan sauce",
  "description": "Tenderloin steaks are coated with crushed peppercorns, seared in butter, and finished with a cognac, wine, broth, and cream sauce.",
  "meal_type": "main",
  "cuisine": "French",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 19
  },
  "ingredients": [
    {
      "ingredient_id": "whole-black-peppercorns",
      "item": "whole black peppercorns",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "6-ounce-1-1-4-inch-thick-tenderloin-steaks",
      "item": "(6 ounce) (1 1/4-inch-thick) tenderloin steaks",
      "quantity": 2
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "shallot",
      "item": "shallot",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "cognac",
      "item": "cognac",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "red-wine",
      "item": "red wine",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "beef-broth",
      "item": "beef broth",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Crush the peppercorns coarsely and press them over both sides of the steaks."
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium-high heat, then add the steaks. Cook for 2 minutes, turn, and cook for 5 minutes more, until firm and a thermometer inserted into the thickest part reads 145°F.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Transfer the steaks to a plate and let them rest for 3 minutes while preparing the sauce."
    },
    {
      "step": 4,
      "text": "Add the minced shallot to the skillet and stir briefly. Pour in the cognac and red wine, then simmer for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Add the beef broth and cook for 2 minutes, stirring until the mixture is smooth.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Whisk in the heavy cream and cook for 2 minutes. Return the steaks and any accumulated juices to the skillet, turning them in the sauce before serving.",
      "timer_minutes": 2
    }
  ],
