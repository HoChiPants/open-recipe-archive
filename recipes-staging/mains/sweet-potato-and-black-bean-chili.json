  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Toss the sweet potatoes with the chipotle pepper, ½ teaspoon salt, 1 tablespoon olive oil, the bell pepper, jalapeño, and cayenne. Spread in a single layer and roast until the potatoes are tender, about 25 minutes. Set aside.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Warm the remaining olive oil in a large pot over medium heat. Add the onion and cook for 5 minutes. Stir in the garlic, ancho chile powder, cumin, and oregano.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the tomatoes, 1 cup water, cornmeal, remaining salt, sugar, cocoa powder, and any remaining cayenne. Bring the mixture to a simmer and cook for 30 minutes, adding water if it becomes too thick.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Stir in the roasted vegetables and black beans. Simmer for 15 minutes, or until thick and heated through.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Whisk the sour cream with the cilantro and spoon it over the chili before serving."
    }
  ],
