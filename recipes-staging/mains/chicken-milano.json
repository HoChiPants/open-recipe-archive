  "id": "chicken-milano",
  "name": "Chicken Milano",
  "subtitle": "Creamy chicken with basil and sun-dried tomatoes",
  "description": "Tender chicken and fettuccini are coated in a savory cream sauce enriched with garlic, basil, and sun-dried tomatoes.",
  "meal_type": "main",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
