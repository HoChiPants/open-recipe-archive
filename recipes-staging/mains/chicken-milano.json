  "instructions": [
    {
      "step": 1,
      "text": "Cook the fettuccini according to the package directions until tender; drain."
    },
    {
      "step": 2,
      "text": "Season the chicken with salt and pepper. Heat the oil in a large skillet over medium-high heat and cook the chicken for about 4 minutes per side, until the thickest part reaches 165°F. Transfer to a plate.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Melt the butter in the skillet. Add the garlic and cook briefly until fragrant."
    },
    {
      "step": 4,
      "text": "Add the tomatoes and half of the broth. Simmer until the tomatoes are tender.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Whisk in the cream and remaining broth. Simmer until the sauce thickens, then stir in the basil and adjust the seasoning."
    },
    {
      "step": 6,
      "text": "Return the chicken to the skillet and warm it through in the sauce. Serve over the fettuccini."
    }
  ],
