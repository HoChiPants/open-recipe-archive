      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "basil",
      "item": "fresh basil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
