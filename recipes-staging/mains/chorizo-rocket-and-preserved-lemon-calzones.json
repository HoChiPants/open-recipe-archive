  "id": "chorizo-rocket-and-preserved-lemon-calzones",
  "name": "Chorizo, Rocket and Preserved Lemon Calzones",
  "subtitle": "Folded pizza dough filled with spiced tomato, greens, chorizo, and cheese",
  "description": "A savory baked calzone with paprika dough, tangy preserved lemon tomato filling, greens, chorizo, and two cheeses.",
  "meal_type": "main",
