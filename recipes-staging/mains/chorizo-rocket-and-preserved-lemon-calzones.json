  "instructions": [
    {
      "step": 1,
      "text": "Mix the flour, paprika, yeast, and olive oil with enough water to form a dough. Knead for 10 minutes, until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Oil a bowl, place the dough inside, cover, and leave to rise for about 2 hours, or until doubled in size.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Cook the sliced chorizo in a pan for 2 minutes. Add the garlic and cook briefly.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the passata, brown sugar, red wine vinegar, and preserved lemon. Cook until thick, then mix in the basil and rocket. Cool the filling.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Heat the oven and dust a baking tray with semolina."
    },
    {
      "step": 6,
      "text": "Divide the dough into four pieces and roll each into a round on a lightly floured surface."
    },
    {
      "step": 7,
      "text": "Spoon the cooled filling onto one half of each round and add the mozzarella. Fold the dough over, press the edges firmly to seal, and arrange the calzones on the prepared tray."
    },
    {
      "step": 8,
      "text": "Scatter with the grated parmesan and bake for about 20 minutes, until golden brown and the chorizo filling reaches 160°F on a food thermometer.",
      "timer_minutes": 20
    }
  ],
