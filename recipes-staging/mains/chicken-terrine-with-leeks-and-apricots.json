  "instructions": [
    {
      "step": 1,
      "text": "Put the chicken thighs and breasts in a saucepan with the stock, bay leaves, thyme, parsley, peppercorns, and the leek trimmings. Bring to a gentle simmer and cook until the chicken reaches 165°F internally and is tender.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Meanwhile, butter a loaf tin. Melt the remaining butter in a frying pan, add the chopped leeks and shallot, and cook until softened. Add the bacon and garlic and cook through.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Remove the chicken from the stock and let it cool enough to handle. Remove the bones, discard the skin, and shred the meat; reserve the cooking stock."
    },
    {
      "step": 4,
      "text": "Soak the gelatine sheets in cold water until pliable.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir the apricots and brandy into the shredded chicken. Squeeze out the gelatine, dissolve it in some hot reserved stock, and mix it into the chicken mixture."
    },
    {
      "step": 6,
      "text": "Pack the chicken mixture firmly into the buttered tin, pour in enough reserved stock to bind it, and refrigerate until set."
    },
    {
      "step": 7,
      "text": "Turn out the terrine, garnish with bay leaves, slice, and serve with olive-oil toast."
    }
  ],
