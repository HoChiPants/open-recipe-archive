  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of water to a boil. Add the pasta shells and cook for 13 minutes, or until cooked through; drain.",
      "timer_minutes": 13
    },
    {
      "step": 2,
      "text": "Preheat a large skillet with the vegetable oil over medium heat. Add the onion, bell pepper, and garlic, and stir for 5 minutes, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the sausage and cook for 8 minutes, breaking it up as it browns, until cooked through and it reaches 160°F on a food thermometer.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Whisk the stewed tomatoes and heavy cream into the skillet. Cook for 5 minutes, stirring occasionally, to heat the sauce.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the drained pasta and combine with the sauce. Stir in the Parmesan cheese and parsley, then serve."
    }
  ],
