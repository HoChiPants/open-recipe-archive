  "id": "chicken-club-wraps",
  "name": "Chicken Club Wraps",
  "subtitle": "Creamy chipotle wraps with chicken, bacon, avocado, and crisp vegetables.",
  "description": "Warm tortillas, spread with a smoky creamy sauce, then fill with chicken, cheese, bacon, avocado, and fresh vegetables.",
  "meal_type": "main",
