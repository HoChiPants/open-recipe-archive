  "instructions": [
    {
      "step": 1,
      "text": "Whisk the mayonnaise, plain yogurt, and chipotle chiles together until smooth."
    },
    {
      "step": 2,
      "text": "Warm the spinach tortillas in the microwave until pliable."
    },
    {
      "step": 3,
      "text": "Spread the sauce over the tortillas, dividing it evenly."
    },
    {
      "step": 4,
      "text": "Top with lettuce, Monterey Jack cheese, avocado, bacon, red onion, tomato, and cooked chicken."
    },
    {
      "step": 5,
      "text": "Fold in the sides, roll each tortilla tightly, and serve. If cooking the chicken separately, verify that it reaches 165°F internally."
    }
  ],
