  "id": "ham-and-cheese-stromboli",
  "name": "Ham and Cheese Stromboli",
  "subtitle": "A hearty baked roll with deli meats, vegetables, and mozzarella",
  "description": "Pizza dough is filled with sauce, sliced meats, vegetables, and cheese, then rolled and baked until golden.",
