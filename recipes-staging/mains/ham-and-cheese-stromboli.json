  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Prepare the refrigerated pizza crust dough and shape it into an even rectangle or rectangles for rolling."
    },
    {
      "step": 3,
      "text": "Spread spaghetti sauce over the dough, leaving a border. Arrange the ham, Capacola sausage, salami, pepperoni sausage, green bell pepper, onion, mushrooms, and mozzarella over the sauce. Season with garlic powder."
    },
    {
      "step": 4,
      "text": "Roll the filled dough into a compact loaf, seal the edges, and transfer it to a baking surface."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until golden brown and the center reaches 160°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Let the stromboli rest briefly, then cut into slices and serve."
    }
  ],
