{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chicken-piccata",
  "name": "Chicken Piccata",
  "subtitle": "Tender chicken with a bright lemon-caper pan sauce",
  "description": "Flour-dredged chicken breasts are browned, then finished with a buttery lemon, wine, and caper sauce.",
  "meal_type": "main",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "cayenne-pepper-to-taste",
      "item": "cayenne pepper to taste"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "all-purpose-flour-for-dredging",
      "item": "all-purpose flour for dredging"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "capers",
      "item": "capers",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "drained"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "cold-unsalted-butter",
      "item": "cold unsalted butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "cut in 1/4-inch slices"
    },
    {
      "ingredient_id": "fresh-italian-parsley",
      "item": "fresh Italian parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken with cayenne, salt, and black pepper, then coat lightly with flour and shake off the excess."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Add the chicken and cook for about 5 minutes per side, until browned and the thickest part reaches 165°F.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Transfer the chicken to a plate. Add the capers to the skillet and cook briefly."
    },
    {
      "step": 4,
      "text": "Pour in the white wine and simmer for 2 minutes, scraping up any browned bits.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Stir in the lemon juice, water, and cold butter. Cook, stirring, until the sauce thickens, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Return the chicken to the skillet, coat with the sauce, and cook for 2 minutes. Sprinkle with parsley and serve.",
      "timer_minutes": 2
    }
  ],
