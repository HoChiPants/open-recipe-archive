  "id": "dijon-tarragon-cream-chicken",
  "name": "Dijon-Tarragon Cream Chicken",
  "subtitle": "Skillet chicken with a silky mustard-herb sauce",
  "description": "Seasoned chicken breasts are cooked in butter and olive oil, then finished with a quick Dijon, cream, and tarragon sauce.",
  "meal_type": "main",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "fresh-tarragon",
      "item": "fresh tarragon",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the chicken breast halves on all sides with salt and pepper."
    },
    {
      "step": 2,
      "text": "Heat the butter and olive oil in a large skillet over medium heat. Add the chicken and cook until browned and the thickest part reaches 165°F, about 15 minutes, turning as needed.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Transfer the chicken to a plate. Whisk the cream, Dijon mustard, and tarragon into the skillet juices."
    },
    {
      "step": 4,
      "text": "Simmer the sauce for about 5 minutes, stirring, until thickened.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Return the chicken to the skillet and turn to coat with the sauce. Serve hot."
    }
  ],
