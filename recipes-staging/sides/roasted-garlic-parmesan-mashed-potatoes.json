  "id": "roasted-garlic-parmesan-mashed-potatoes",
  "name": "Roasted Garlic Parmesan Mashed Potatoes",
  "subtitle": "Creamy mashed potatoes with mellow roasted garlic and Parmesan",
  "description": "Tender potatoes are mashed with roasted garlic, milk, butter, and Parmesan for a savory side dish.",
  "meal_type": "side",
  "cuisine": "Italian",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 6,
      "unit": "cloves",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-potatoes",
      "item": "baking potatoes",
      "quantity": 7,
      "preparation": "peeled and cubed"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Place the garlic in a small baking dish and coat it with the olive oil."
    },
    {
      "step": 2,
      "text": "Roast the garlic until golden brown, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 3,
      "text": "Meanwhile, simmer salted water in a pot. Add the cubed potatoes and cook until tender."
    },
    {
      "step": 4,
      "text": "Drain the potatoes and return them to the pot. Add the roasted garlic, milk, Parmesan, and butter."
    },
    {
      "step": 5,
      "text": "Mash until smooth, then whisk in the remaining salt and black pepper. Serve warm."
    }
  ],
