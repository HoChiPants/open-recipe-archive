    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "head-cabbage",
      "item": "head cabbage",
      "quantity": 1,
      "preparation": "coarsely chopped"
    },
    {
      "ingredient_id": "white-vinegar",
      "item": "white vinegar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the coarsely chopped cabbage in an electric pressure cooker."
    },
    {
      "step": 2,
      "text": "Add the white vinegar, water, and salt, and stir to combine."
    },
    {
      "step": 3,
      "text": "Secure the lid and cook at high pressure until the cabbage is tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Allow the pressure to release naturally for 10 minutes, then release any remaining pressure according to the cooker’s instructions.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir the sauerkraut and serve warm."
    }
  ],
