  "id": "pressure-cooked-sauerkraut",
  "name": "Pressure-Cooked Sauerkraut",
  "subtitle": "Tangy cabbage side with a quick pressure-cook method",
  "description": "Coarsely chopped cabbage is seasoned with vinegar, water, and salt, then pressure-cooked until tender and tangy.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
