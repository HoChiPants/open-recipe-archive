  "id": "cheesy-leeks",
  "name": "Cheesy Leeks",
  "subtitle": "Tender leeks in a cheddar sauce with a crisp crumb topping",
  "description": "Leeks are folded into a mustard-cheddar sauce, finished with thyme breadcrumbs, and baked until bubbling and golden.",
  "meal_type": "side",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "leeks-about-3-medium-trimmed-and-cut-into-2cm-rounds",
      "item": "leeks (about 3 medium) trimmed and cut into 2cm rounds",
      "quantity": 600,
      "unit": "g"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 500,
      "unit": "ml"
    },
    {
      "ingredient_id": "mature-cheddar-grated",
      "item": "mature cheddar grated",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "english-mustard",
      "item": "English mustard",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "stale-bread-blitzed-to-crumbs",
      "item": "stale bread blitzed to crumbs",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "thyme-leaves",
      "item": "thyme leaves",
      "quantity": 2,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Cook the leeks for 8 minutes, until tender.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Melt the butter, stir in the flour, and cook until thickened into a roux."
    },
    {
      "step": 4,
      "text": "Gradually add the milk, stirring until the sauce thickens, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Stir in the cheddar and mustard, then fold in the cooked leeks."
    },
    {
      "step": 6,
      "text": "Combine the breadcrumbs with the thyme, scatter over the leeks, and bake for 20 minutes until bubbling and golden.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Let the dish stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
