  "id": "aloo-tikki",
  "name": "Aloo Tikki",
  "subtitle": "Crisp potato cakes with spiced peas",
  "description": "Seasoned potato and pea cakes with a crisp breadcrumb coating, suitable as an Indian side dish or snack.",
  "meal_type": "side",
  "cuisine": "Indian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "potatoes-maris-piper-or-king-edwards",
      "item": "potatoes Maris Piper or King Edwards",
      "quantity": 500,
      "unit": "g",
      "preparation": "cut into even-sized chunks"
    },
    {
      "ingredient_id": "fresh-breadcrumbs",
      "item": "fresh breadcrumbs",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "sunflower-oil-plus-extra-for-frying",
      "item": "sunflower oil plus extra for frying",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "red-onion-finely-chopped",
      "item": "red onion finely chopped",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "fresh-ginger-peeled-and-finely-grated",
      "item": "fresh ginger peeled and finely grated",
      "quantity": 20,
      "unit": "g"
    },
    {
      "ingredient_id": "green-chilli-deseeded-and-finely-chopped",
      "item": "green chilli deseeded and finely chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "kashmiri-chilli-powder",
      "item": "Kashmiri chilli powder",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "garam-masala",
      "item": "garam masala",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "mango-powder-amchoor-or-juice-of-1-2-lemon",
      "item": "mango powder (amchoor) or juice of 1/2 lemon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "frozen-peas",
      "item": "frozen peas",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "coriander",
      "item": "coriander",
      "quantity": 2,
      "unit": "tbsp",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Simmer the potatoes in water until tender. Drain and let them cool until easy to handle."
    },
    {
      "step": 2,
      "text": "Heat 3 tablespoons of sunflower oil in a pan. Cook the onion until softened, then stir in the ginger, chilli, Kashmiri chilli powder, garam masala, cumin, and mango powder or lemon juice."
    },
    {
      "step": 3,
      "text": "Add the peas and cook until tender. Stir in the chopped coriander, then remove from the heat and cool."
    },
    {
      "step": 4,
      "text": "Mash the cooled potatoes with the breadcrumbs and flour. Fold in the cooled pea mixture and mix until evenly combined."
    },
    {
      "step": 5,
      "text": "Shape the mixture into compact patties and chill until firm.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Heat extra sunflower oil in a frying pan and fry the patties in batches until crisp and browned on both sides."
    },
    {
      "step": 7,
      "text": "Serve hot, garnished with the remaining chopped coriander."
    }
  ],
