    "prep_minutes": 10,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "baked-beans",
      "item": "baked beans",
      "quantity": 2,
      "unit": "can",
      "preparation": "28 ounce"
    },
    {
      "ingredient_id": "chili-sauce",
      "item": "chili sauce",
      "quantity": 1,
      "unit": "bottle",
      "preparation": "12 ounce"
    },
    {
      "ingredient_id": "sweet-onion",
      "item": "sweet onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Arrange the bacon in a baking dish and cook until it is browned and cooked through; drain excess fat."
    },
    {
      "step": 3,
      "text": "Add the baked beans, chili sauce, chopped onion, and packed brown sugar. Stir until evenly combined."
    },
    {
      "step": 4,
      "text": "Bake for 45 minutes, until bubbling and heated through.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
  ],
