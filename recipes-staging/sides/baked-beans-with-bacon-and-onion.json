  "id": "baked-beans-with-bacon-and-onion",
  "name": "Baked Beans with Bacon and Onion",
  "subtitle": "A sweet, savory casserole-style side",
  "description": "Bacon, beans, chili sauce, onion, and brown sugar bake together into a bubbling, hearty side dish.",
  "meal_type": "side",
  "yield": {
    "quantity": 11,
    "unit": "servings"
  },
