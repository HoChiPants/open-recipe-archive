{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "loaded-cauliflower-casserole",
  "name": "Loaded Cauliflower Casserole",
  "subtitle": "Creamy cauliflower with bacon, mushrooms, cheese, and chives",
  "description": "Tender cauliflower is combined with a seasoned creamy dressing, mushrooms, bacon, cheese, and chives, then baked until bubbling and melted.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "slices-turkey-bacon",
      "item": "slices turkey bacon",
      "quantity": 6,
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "head-cauliflower",
      "item": "head cauliflower",
      "quantity": 1,
      "unit": "large",
      "preparation": "cut into florets"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "colby-monterey-jack-cheese",
      "item": "Colby-Monterey Jack cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded, divided"
    },
    {
      "ingredient_id": "baby-bella-mushrooms",
      "item": "baby bella mushrooms",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, roughly chopped"
    },
    {
      "ingredient_id": "fresh-chives",
      "item": "fresh chives",
      "quantity": 6,
      "unit": "tablespoons",
      "preparation": "chopped, divided"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Cook the turkey bacon in a skillet over medium heat for about 10 minutes, until browned and cooked through; if it is raw poultry bacon, verify 165°F with a food thermometer. Drain and chop or crumble.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Bring a pot of water to a simmer. Add the cauliflower florets and cook for about 20 minutes, until tender. Drain well and transfer to a large bowl.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Stir together the sour cream, mayonnaise, garlic, salt, and pepper."
    },
    {
      "step": 5,
      "text": "Fold the dressing into the cauliflower with the bacon, mushrooms, half of the cheese, and half of the chives."
    },
    {
      "step": 6,
      "text": "Transfer the mixture to a baking dish and top with the remaining cheese."
    },
    {
      "step": 7,
      "text": "Bake for about 20 minutes, until the cheese is melted and the casserole is hot throughout.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "Sprinkle with the remaining chives and serve."
    }
  ],
  "tags": [
    "dinner",
