{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "grilled-lemon-parmesan-asparagus",
  "name": "Grilled Lemon Parmesan Asparagus",
  "subtitle": "Bright, savory asparagus with lightly charred edges",
  "description": "Tender asparagus is coated with lemon, olive oil, seasoning, and Parmesan, then grilled and finished with extra cheese.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-asparagus",
      "item": "fresh asparagus",
      "quantity": 1,
      "unit": "pound",
      "preparation": "trimmed"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or more if needed"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or more if needed"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "plus extra for topping"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill."
    },
    {
      "step": 2,
      "text": "Place the trimmed asparagus in a bowl. Add the olive oil and lemon juice, season with salt and pepper, and toss to coat."
    },
    {
      "step": 3,
      "text": "Add 0.25 cup Parmesan and toss again until the asparagus is evenly coated."
    },
    {
      "step": 4,
      "text": "Transfer the asparagus to the grill and cook until tender and lightly charred, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Transfer to a serving dish and top with extra Parmesan."
    }
  ],
