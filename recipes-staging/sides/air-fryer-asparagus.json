  "id": "air-fryer-asparagus",
  "name": "Air Fryer Asparagus",
  "subtitle": "Crisp-tender asparagus with garlic, pepper flakes, and Parmesan.",
  "description": "A quick air-fryer side dish with seasoned asparagus and a savory Parmesan finish.",
  "meal_type": "side",
  "cuisine": "American",
