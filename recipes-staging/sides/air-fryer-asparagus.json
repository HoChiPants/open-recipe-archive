      "item": "freshly grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 375°F."
    },
    {
      "step": 2,
      "text": "Arrange the asparagus in the air-fryer basket and coat with avocado oil cooking spray. Season with garlic powder, Himalayan pink salt, ground multi-colored peppercorns, and red pepper flakes."
    },
    {
      "step": 3,
      "text": "Air-fry until the asparagus is crisp-tender, about 9 minutes, shaking the basket once during cooking.",
      "timer_minutes": 9
    },
    {
      "step": 4,
      "text": "Sprinkle with freshly grated Parmesan cheese and serve."
    }
  ],
