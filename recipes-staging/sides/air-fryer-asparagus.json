      "item": "bunch fresh asparagus",
      "quantity": 1,
      "preparation": "trimmed"
    },
    {
      "ingredient_id": "avocado-oil-cooking-spray",
      "item": "avocado oil cooking spray"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "himalayan-pink-salt",
      "item": "Himalayan pink salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
