  "id": "fried-cabbage",
  "name": "Fried Cabbage",
  "subtitle": "Tender cabbage simmered in buttery broth",
  "description": "A simple cabbage side dish cooked slowly until tender and seasoned just before serving.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce"
    },
    {
      "ingredient_id": "head-cabbage",
      "item": "head cabbage",
      "quantity": 1,
      "preparation": "cored and coarsely chopped"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper",
      "item": "salt and ground black pepper",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large pot over medium heat. Add the chicken broth and bring it to a simmer, verifying with a thermometer that the liquid reaches at least 165°F."
    },
    {
      "step": 2,
      "text": "Add the chopped cabbage, cover, and simmer gently for 45 minutes, or until tender.",
      "timer_minutes": 45
    },
    {
      "step": 3,
      "text": "Season with the salt and ground black pepper, then serve hot."
    }
  ],
