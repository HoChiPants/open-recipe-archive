  "id": "pan-fried-spinach",
  "name": "Pan-Fried Spinach",
  "subtitle": "Tender spinach with bacon, onion, and garlic",
  "description": "Spinach is wilted in a buttery olive-oil skillet with bacon, onion, and garlic, then seasoned simply before serving.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
