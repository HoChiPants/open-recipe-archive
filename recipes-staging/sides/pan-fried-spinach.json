      "ingredient_id": "coarse-salt-and-ground-black-pepper-to-taste",
      "item": "coarse salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a large skillet over medium heat until crisp. Drain it, reserving the skillet."
    },
    {
      "step": 2,
      "text": "Heat the butter and olive oil in the skillet over medium heat. Add the garlic, onion, and bacon, and cook until the onion begins to soften."
    },
    {
      "step": 3,
      "text": "Add the spinach and toss until evenly coated.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Continue cooking until the spinach is tender.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Season with coarse salt and ground black pepper to taste, then serve."
    }
  ],
