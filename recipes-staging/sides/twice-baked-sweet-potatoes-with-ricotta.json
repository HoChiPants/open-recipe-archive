  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Prepare the sweet potatoes for baking and place them on a baking sheet."
    },
    {
      "step": 2,
      "text": "Bake the sweet potatoes until tender, about 60 minutes. Let them cool for 20 minutes, then reduce the oven temperature to 350°F.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "While the potatoes cool, warm the olive oil in a skillet. Add the shallots and cook until softened, about 10 minutes. Stir in the brown sugar.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Halve the sweet potatoes lengthwise and scoop the flesh into a bowl, leaving the skins intact."
    },
    {
      "step": 5,
      "text": "Blend the sweet potato flesh until smooth. Add the ricotta, brown sugar, salt, black pepper, and ginger, and blend again until smooth."
    },
    {
      "step": 6,
      "text": "Fold in the cooked shallots, Parmesan, and sage. Spoon the mixture into the sweet potato skins and arrange them on the baking sheet."
    },
    {
      "step": 7,
      "text": "Bake at 350°F until the filling is set and heated through, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
