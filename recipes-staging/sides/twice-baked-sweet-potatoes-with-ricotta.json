  "id": "twice-baked-sweet-potatoes-with-ricotta",
  "name": "Twice-Baked Sweet Potatoes with Ricotta",
  "subtitle": "Creamy, savory-sweet stuffed sweet potatoes",
  "description": "Baked sweet potatoes are filled with seasoned ricotta, shallots, Parmesan, and sage, then returned to the oven until hot and lightly browned.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
