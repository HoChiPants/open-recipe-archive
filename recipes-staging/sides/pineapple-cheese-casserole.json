  "id": "pineapple-cheese-casserole",
  "name": "Pineapple Cheese Casserole",
  "subtitle": "A sweet-and-savory baked side with pineapple, Cheddar, and a crisp cracker topping.",
  "description": "Pineapple and sharp Cheddar combine with a lightly sweetened flour mixture, then bake beneath buttery cracker crumbs.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "pineapple-chunks",
      "item": "pineapple chunks",
      "quantity": 2,
      "unit": "can",
      "preparation": "15 ounce, drained"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "sharp-cheddar-cheese",
      "item": "sharp Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "buttery-round-crackers",
      "item": "buttery round crackers",
      "quantity": 25,
      "preparation": "crumbled"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Transfer the drained pineapple to a baking dish."
    },
    {
      "step": 3,
      "text": "Stir together the sugar, flour, and shredded Cheddar."
    },
    {
      "step": 4,
      "text": "Add the mixture to the pineapple and combine."
    },
    {
      "step": 5,
      "text": "Top with the crumbled crackers and pour the melted butter evenly over them."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until hot and lightly browned.",
      "timer_minutes": 30
    }
  ],
