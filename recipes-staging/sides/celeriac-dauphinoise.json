  "id": "celeriac-dauphinoise",
  "name": "Celeriac Dauphinoise",
  "subtitle": "Creamy baked celeriac with garlic and thyme",
  "description": "Thinly sliced celeriac is layered with garlic and thyme, coated in a mustard cream mixture, and baked until tender.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil-for-the-baking-dish",
      "item": "olive oil for the baking dish"
    },
    {
      "ingredient_id": "plant-based-double-cream",
      "item": "plant-based double cream",
      "quantity": 540,
      "unit": "ml"
    },
    {
      "ingredient_id": "unsweetened-non-dairy-milk",
      "item": "unsweetened non-dairy milk",
      "quantity": 50,
      "unit": "ml"
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "celeriac-peeled-and-thinly-sliced-using-a-mandoline-or-sharp-knife",
      "item": "celeriac peeled and thinly sliced using a mandoline or sharp knife",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "fat-garlic-cloves-finely-chopped",
      "item": "fat garlic cloves finely chopped",
      "quantity": 2
    },
    {
      "ingredient_id": "handful-of-thyme-leaves-picked",
      "item": "handful of thyme leaves picked"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to a moderate baking temperature and coat a baking dish with the olive oil."
    },
    {
      "step": 2,
      "text": "Whisk the plant-based double cream, unsweetened non-dairy milk, and Dijon mustard until combined."
    },
    {
      "step": 3,
      "text": "Arrange the celeriac in layers in the dish, scattering the chopped garlic and thyme between the layers. Pour the cream mixture over the top."
    },
    {
      "step": 4,
      "text": "Bake until the celeriac is tender when pierced and the top is deeply golden, about 60 minutes; continue cooking as needed to reach the stated 90-minute cook time.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Let the dish stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
