  "id": "italian-style-swiss-chard",
  "name": "Italian-Style Swiss Chard",
  "subtitle": "Tender greens with garlic and chile",
  "description": "Swiss chard is briefly cooked, drained, then finished in olive oil with garlic and crushed red pepper.",
  "meal_type": "side",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "bunch-swiss-chard",
      "item": "bunch Swiss chard",
      "quantity": 1
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "coarsely chopped"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 0.125,
      "unit": "teaspoon",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the Swiss chard into manageable pieces, separating the thick stems from the leaves if needed."
    },
    {
      "step": 2,
      "text": "Bring a pot of water to a simmer, add the tablespoon of salt, and cook the chard until tender, about 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Drain the chard thoroughly."
    },
    {
      "step": 4,
      "text": "Warm the olive oil with the garlic and crushed red pepper flakes over medium heat for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the drained chard and stir until evenly coated and heated through, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Season with salt to taste and serve warm."
    }
  ],
