  "id": "butter-beans-with-kale-lemon-chilli-and-garlic",
  "name": "Butter Beans with Kale, Lemon, Chilli and Garlic",
  "subtitle": "A bright, garlicky bean and greens side dish",
  "description": "Tender butter beans and sliced kale are tossed with lemon, garlic, olive oil, and chilli for a quick savory side.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "as a side"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-cloves-finely-sliced",
      "item": "garlic cloves finely sliced",
      "quantity": 2
    },
    {
      "ingredient_id": "chilli-flakes-or-to-taste",
      "item": "chilli flakes or to taste",
      "quantity": "1/2-1",
      "unit": "tsp"
    },
    {
      "ingredient_id": "lemon-zested-and-juiced",
      "item": "lemon zested and juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "can-butter-beans-drained-and-rinsed",
      "item": "can butter beans drained and rinsed",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "kale-tough-stalks-removed",
      "item": "kale tough stalks removed",
      "quantity": 180,
      "unit": "g",
      "preparation": "leaves finely sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a skillet over medium heat. Add the sliced garlic, chilli flakes, and lemon zest, and cook gently for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Stir in the drained butter beans and cook for 8 minutes, stirring occasionally, until heated through.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Meanwhile, bring a separate pot of water to a boil. Add the sliced kale and cook for 10 minutes, until tender, then drain well.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Combine the kale with the butter beans. Add the lemon juice, toss to coat, and serve warm."
    }
  ],
