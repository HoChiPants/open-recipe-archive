  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "baked-potato-puffs",
  "name": "Baked Potato Puffs",
  "subtitle": "Light, savory potato bites with a crisp baked exterior",
  "description": "Mashed potatoes are folded into a simple buttery egg batter, seasoned with cayenne and nutmeg, then baked until golden.",
  "meal_type": "side",
  "cuisine": "French Inspired",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 45,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "yukon-gold-potatoes",
      "item": "Yukon gold potatoes",
      "quantity": 4,
      "unit": "small",
      "preparation": "or as needed, quartered"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt-to-taste",
      "item": "kosher salt to taste"
    },
    {
      "ingredient_id": "flour",
      "item": "flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "freshly-grated-nutmeg",
      "item": "freshly grated nutmeg",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the quartered potatoes in a saucepan with the water and salt. Simmer until tender, about 15 minutes, then drain and mash until smooth.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Heat the oven to 450°F. Line a baking sheet with parchment."
    },
    {
      "step": 3,
      "text": "Bring the butter, water, and a little salt to a boil in a saucepan. Stir in the flour until a cohesive dough forms and pulls from the pan."
    },
    {
      "step": 4,
      "text": "Transfer the dough to a bowl and let it cool for 5 minutes. Beat in the eggs one at a time until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Fold in the mashed potatoes, cayenne, and nutmeg. Adjust the salt, then portion the mixture into 24 mounds on the baking sheet."
    },
    {
      "step": 6,
      "text": "Bake until puffed and golden brown, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Let the puffs rest for 1 minute, then cool for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
