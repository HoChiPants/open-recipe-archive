{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "indian-saffron-rice",
  "name": "Indian Saffron Rice",
  "subtitle": "Fragrant rice with saffron and butter",
  "description": "Long-grain rice is toasted with butter and salt, then simmered with saffron-infused water until tender.",
  "meal_type": "side",
  "cuisine": "Indian",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "powdered-saffron",
      "item": "powdered saffron",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "boiling-water",
      "item": "boiling water",
      "quantity": 2,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "uncooked-long-grain-white-rice",
      "item": "uncooked long-grain white rice",
      "quantity": 1,
      "unit": "cup",
      "preparation": "not rinsed"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the saffron in a small bowl and pour in enough of the boiling water to cover it. Set aside briefly."
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan over medium heat. Add the unrinsed rice and salt, stirring until the grains become opaque."
    },
    {
      "step": 3,
      "text": "Pour in the remaining boiling water and the saffron water. Bring the liquid back to a boil."
    },
    {
      "step": 4,
      "text": "Cover, reduce the heat to low, and cook until the rice is tender and the liquid is absorbed.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Remove from the heat and let the rice stand briefly, then fluff before serving."
    }
  ],
