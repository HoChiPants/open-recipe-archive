  "id": "red-smashed-potatoes",
  "name": "Red Smashed Potatoes",
  "subtitle": "Creamy, rustic potatoes with sour cream and butter",
  "description": "Tender red potatoes are smashed with warm dairy, butter, sour cream, salt, and pepper for a rich, rustic side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "red-potatoes",
      "item": "red potatoes",
      "quantity": 3,
      "unit": "pounds"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "half-and-half",
      "item": "half-and-half",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes and 1 tablespoon kosher salt in a large pot. Add enough water to cover, then bring to a simmer and cook until the potatoes are tender, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 2,
      "text": "Meanwhile, warm the half-and-half and butter in a saucepan over low heat until the butter melts, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Drain the potatoes and return them to the pot. Mash until mostly smooth, then fold in the warm half-and-half mixture and sour cream."
    },
    {
      "step": 4,
      "text": "Stir in 2 teaspoons kosher salt and the black pepper. Taste and adjust the seasoning if needed."
    }
  ],
