  "id": "twice-baked-sweet-potatoes",
  "name": "Twice-Baked Sweet Potatoes",
  "subtitle": "Creamy, warmly spiced sweet potato halves with walnuts",
  "description": "Sweet potatoes are baked until tender, filled with a rich cream cheese mixture, topped with walnuts, and briefly baked again.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 65
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-potatoes",
      "item": "sweet potatoes",
      "quantity": 6
    },
    {
      "ingredient_id": "salad-oil",
      "item": "salad oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Rub the sweet potatoes with salad oil and place them on a baking sheet."
    },
    {
      "step": 2,
      "text": "Bake the sweet potatoes for 60 minutes, or until tender when pierced.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Combine the cream cheese, brown sugar, margarine, vanilla extract, salt, and pepper until smooth."
    },
    {
      "step": 4,
      "text": "Halve the baked sweet potatoes lengthwise and scoop out most of the flesh, leaving the skins intact. Stir the flesh into the cream cheese mixture, then fold in the walnuts."
    },
    {
      "step": 5,
      "text": "Spoon the filling back into the potato skins and return them to the baking sheet."
    },
    {
      "step": 6,
      "text": "Bake for 5 minutes, until heated through.",
      "timer_minutes": 5
    }
  ],
