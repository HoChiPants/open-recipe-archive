{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "spicy-chili-french-fries",
  "name": "Spicy Chili French Fries",
  "subtitle": "Oven-baked fries with a bold chili coating",
  "description": "Crisp russet fries are coated in a spicy chili mixture and baked until browned and tender.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "russet-potatoes",
      "item": "russet potatoes",
      "quantity": 4,
      "unit": "large",
      "preparation": "peeled and cut into 1/4 inch thick fries"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "tomato-vegetable-juice-cocktail",
      "item": "tomato-vegetable juice cocktail",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "chili-powder",
      "item": "chili powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "dried-onion-granules",
      "item": "dried onion granules",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Place the cut potatoes in water and let them stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the oil, juice cocktail, chili powder, onion granules, cumin, garlic powder, cayenne, sugar, and salt in a bowl."
    },
    {
      "step": 4,
      "text": "Drain the potatoes and toss them with the mixture until evenly coated."
    },
    {
      "step": 5,
      "text": "Spread the fries in a single layer on a baking sheet and bake for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Turn the fries and bake for 20 minutes more, until tender and browned.",
      "timer_minutes": 20
    }
  ],
