  "id": "air-fryer-brussels-sprouts-c954f70b",
  "name": "Air-Fryer Brussels Sprouts",
  "subtitle": "Crisp-edged sprouts with an optional savory topping",
  "description": "Brussels sprouts are lightly oiled, air-fried until browned and tender, then finished with a choice of bacon chilli flakes or roasted hazelnuts.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-brussels-sprouts-or-250g-frozen",
      "item": "fresh brussels sprouts or 250g frozen",
      "quantity": 350,
      "unit": "g"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "bacon-chilli-flakes-or-chopped-roasted-hazelnuts",
      "item": "bacon chilli flakes or chopped roasted hazelnuts",
      "preparation": "chopped cooked, to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to its manufacturer’s instructions."
    },
    {
      "step": 2,
      "text": "Trim and halve the fresh Brussels sprouts. If using frozen sprouts, use them as provided."
    },
    {
      "step": 3,
      "text": "Toss the sprouts with the vegetable oil until evenly coated."
    },
    {
      "step": 4,
      "text": "Arrange the sprouts in a single layer in the air-fryer basket."
    },
    {
      "step": 5,
      "text": "Air-fry for 15 minutes, shaking the basket halfway through, until browned and tender.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Serve immediately with the optional bacon chilli flakes or chopped roasted hazelnuts."
    }
  ],
