  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a covered saucepan over medium heat. Add the quinoa, onion, bell pepper, garlic, and garlic powder; cook, stirring occasionally, until the onion is tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the water, tomato sauce, chili powder, garlic powder, and cumin. Bring the mixture to a simmer."
    },
    {
      "step": 3,
      "text": "Cover, reduce the heat to low, and cook until the quinoa is tender and the liquid is absorbed, about 30 minutes. Fluff gently before serving.",
      "timer_minutes": 30
    }
  ],
