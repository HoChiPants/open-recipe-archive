  "id": "spanish-style-quinoa",
  "name": "Spanish-Style Quinoa",
  "subtitle": "A savory quinoa side with tomato and warm spices",
  "description": "Quinoa simmers with aromatics, tomato sauce, and spices for a simple, flavorful side dish.",
