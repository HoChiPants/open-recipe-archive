{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "roasted-brussels-sprouts-with-cipollini-onions",
  "name": "Roasted Brussels Sprouts with Cipollini Onions",
  "subtitle": "Blanched vegetables finished with butter, roasting heat, and lemon",
  "description": "Tender Brussels sprouts and cipollini onions are briefly cooked, butter-coated, roasted until tender, and served with lemon wedges.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "brussels-sprouts",
      "item": "Brussels sprouts",
      "quantity": 1,
      "unit": "pound",
      "preparation": "trimmed and halved lengthwise"
    },
    {
      "ingredient_id": "cipollini-onions",
      "item": "cipollini onions",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "stem and root ends trimmed"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1,
      "preparation": "cut into wedges"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F. Bring a pot of water to a simmer."
    },
    {
      "step": 2,
      "text": "Cook the Brussels sprouts in the simmering water for 2 minutes, then cool and drain them.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Transfer the cipollini onions to the boiling water and cook until tender, about 10 minutes. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Melt the butter in an oven-safe skillet or roasting pan. Add the Brussels sprouts and onions, stirring to coat. Season with salt and ground black pepper."
    },
    {
      "step": 5,
      "text": "Roast until the vegetables are tender and browned, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Serve with the lemon wedges."
    }
  ],
