      "ingredient_id": "brussels-sprouts-halved",
      "item": "brussels sprouts halved",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
