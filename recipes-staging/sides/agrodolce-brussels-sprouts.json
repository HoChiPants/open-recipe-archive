  "id": "agrodolce-brussels-sprouts",
  "name": "Agrodolce Brussels Sprouts",
  "subtitle": "Roasted sprouts with tangy raisins and toasted pine nuts",
  "description": "Tender roasted Brussels sprouts are finished with a sweet-tart vinegar sauce, raisins, parsley, and pine nuts.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
