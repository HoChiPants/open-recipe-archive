  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven. Toss the halved Brussels sprouts with the olive oil, arrange them in a single layer, and roast for 20 minutes, until tender and browned.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Toast the pine nuts in a dry skillet until lightly golden; set aside."
    },
    {
      "step": 3,
      "text": "Warm the sugar and chopped raisins for 4 minutes, then set aside.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Combine the shallot, vinegar, warmed sugar, and raisins. Stir in the chopped parsley."
    },
    {
      "step": 5,
      "text": "Toss the roasted Brussels sprouts with the agrodolce mixture. Finish with the toasted pine nuts and remaining parsley."
    }
  ],
