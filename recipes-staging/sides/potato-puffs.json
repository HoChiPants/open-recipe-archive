  "schema_version": "1.0.0",
  "id": "potato-puffs",
  "name": "Potato Puffs",
  "subtitle": "Crisp, golden bites with a soft potato center",
  "description": "Seasoned mashed potato puffs are shaped, deep-fried until golden and fully set, then drained for serving.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "mashed-potatoes",
      "item": "mashed potatoes",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "vegetable-oil-for-deep-frying",
      "item": "vegetable oil for deep frying",
      "quantity": 1,
      "unit": "quart"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, baking powder, and salt together. Stir in the mashed potatoes and beaten egg until a cohesive mixture forms, then shape it into small puffs."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil for deep frying to 365°F in a deep, heavy pot or fryer."
    },
    {
      "step": 3,
      "text": "Fry the puffs in batches for about 5 minutes, turning as needed, until golden brown and firm in the center; verify an egg-containing center reaches 160°F.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Transfer the puffs to a lined plate or rack to drain before serving."
    }
  ],
