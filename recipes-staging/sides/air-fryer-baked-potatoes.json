  "id": "air-fryer-baked-potatoes",
  "name": "Air Fryer Baked Potatoes",
  "subtitle": "Crisp-skinned potatoes with seasoned butter",
  "description": "Whole potatoes are seasoned, air-fried until tender, then split and finished with butter.",
