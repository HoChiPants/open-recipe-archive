  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 400°F."
    },
    {
      "step": 2,
      "text": "Rub the potatoes with olive oil, then season with salt, pepper, garlic powder, and dried parsley."
    },
    {
