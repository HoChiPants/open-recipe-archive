  "id": "zucchini-saute",
  "name": "Zucchini Sauté",
  "subtitle": "A quick skillet vegetable side",
  "description": "Zucchini, mushrooms, tomato, onion, and garlic are sautéed with Italian seasoning until tender.",
  "meal_type": "side",
