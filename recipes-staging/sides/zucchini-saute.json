  "instructions": [
    {
      "step": 1,
      "text": "Preheat a large skillet over medium heat and add the olive oil."
    },
    {
      "step": 2,
      "text": "Add the red onion, season with salt and pepper, and sauté for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir in the zucchini and mushrooms, then add the tomato, garlic, and Italian seasoning."
    },
    {
      "step": 4,
      "text": "Cook, stirring occasionally, until the vegetables are tender and the mushrooms are cooked through."
    }
