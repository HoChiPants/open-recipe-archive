  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the frying oil to 375°F. In a separate pan, combine the green beans and water, bring to a simmer, and cook for 4 minutes. Drain the beans once the water has evaporated or the beans are just tender.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Whisk the egg and milk together in a bowl. In another bowl, stir the bread crumbs with the chili powder, garlic powder, and onion powder."
    },
    {
      "step": 3,
      "text": "Dredge the warm beans in the flour, dip them in the egg mixture, and roll them in the seasoned crumbs. Arrange them so the coating stays intact."
    },
    {
      "step": 4,
      "text": "Fry the coated beans in batches until golden brown and crisp, about 2 minutes per batch. Confirm the egg-containing coating is fully set and reaches 160°F.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Transfer the fries to a drainable surface and serve hot."
    }
  ],
