  "id": "green-bean-fries",
  "name": "Green Bean Fries",
  "subtitle": "Crisp, seasoned green beans for the table",
  "description": "Briefly steam fresh green beans, coat them in seasoned flour and crumbs, then fry until crisp and golden.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
