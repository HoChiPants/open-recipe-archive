  "id": "zucchini-and-potato-bake",
  "name": "Zucchini and Potato Bake",
  "subtitle": "A savory baked mix of potatoes, zucchini, and peppers",
  "description": "Chunky vegetables are coated with olive oil, garlic, breadcrumbs, and seasonings, then baked until the potatoes are tender.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 4,
      "unit": "medium",
      "preparation": "peeled and cut into large chunks"
    },
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 2,
      "unit": "medium",
      "preparation": "quartered and cut into large pieces"
    },
    {
      "ingredient_id": "red-bell-pepper",
      "item": "red bell pepper",
      "quantity": 1,
      "unit": "medium",
      "preparation": "seeded and chopped"
    },
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "paprika-to-taste",
      "item": "paprika to taste"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Combine the potatoes, zucchini, red bell pepper, breadcrumbs, olive oil, and sliced garlic in a baking dish or large bowl."
    },
    {
      "step": 3,
      "text": "Season with paprika, salt, and black pepper, then toss until the vegetables are evenly coated."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, or until the potatoes are tender when pierced with a fork.",
      "timer_minutes": 60
    }
  ],
