      "quantity": 6,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "uncooked-instant-rice",
      "item": "uncooked instant rice",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "chicken-stock",
      "item": "chicken stock",
      "quantity": 3,
      "unit": "cups"
    },
    {
