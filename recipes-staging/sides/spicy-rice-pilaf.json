  "id": "spicy-rice-pilaf",
  "name": "Spicy Rice Pilaf",
  "subtitle": "A savory skillet side with peppers, mushrooms, and garlic",
  "description": "Instant rice simmers with sautéed vegetables, stock, and chili flakes for a quick, warmly spiced side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
