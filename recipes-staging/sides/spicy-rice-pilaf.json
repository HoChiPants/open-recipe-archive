      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Add the onion, roasted red pepper, mushrooms, garlic, red pepper flakes, and ground black pepper. Cook, stirring occasionally, until the vegetables are tender.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the rice and chicken stock, then bring the mixture to a simmer."
    },
    {
      "step": 4,
      "text": "Cover and simmer until the rice is tender and the liquid is absorbed. If the stock contains raw poultry ingredients, verify that the finished pilaf reaches 165°F with a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Prepare the garnish or finishing mixture with the roasted red pepper, red pepper flakes, salt, and ground black pepper, and serve with the pilaf."
    }
  ],
