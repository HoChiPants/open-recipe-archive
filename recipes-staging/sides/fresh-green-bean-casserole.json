  "id": "fresh-green-bean-casserole",
  "name": "Fresh Green Bean Casserole",
  "subtitle": "Tender green beans with creamy mushroom sauce and crisp onions",
  "description": "A warm side dish combining briefly cooked green beans, mushroom soup, Cheddar, and French-fried onions in one baked casserole.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-green-beans",
      "item": "fresh green beans",
      "quantity": 4,
      "unit": "pounds",
      "preparation": "trimmed and cut into 2-inch pieces"
    },
    {
      "ingredient_id": "cream-of-mushroom-soup",
      "item": "cream of mushroom soup",
      "quantity": 2,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "sharp-cheddar-cheese",
      "item": "sharp Cheddar cheese",
      "quantity": 1,
      "unit": "pound",
      "preparation": "grated"
    },
    {
      "ingredient_id": "french-fried-onions",
      "item": "French-fried onions",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the green beans in boiling water for 5 minutes, or until tender. Drain well.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Combine the drained green beans with the mushroom soup."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish and top with the grated Cheddar and French-fried onions."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until the cheese is melted.",
      "timer_minutes": 30
    }
  ],
