  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Toss the potatoes with the olive oil, arrange them in a roasting pan, and bake until cooked through, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 2,
      "text": "While the potatoes bake, stir together the white wine vinegar, mustard, parsley, and capers."
    },
    {
      "step": 3,
      "text": "Transfer the hot potatoes to a serving bowl. Add the wild garlic or watercress to the warm roasting pan briefly so it wilts, then add it to the potatoes."
    },
    {
      "step": 4,
      "text": "Toss the potatoes and wilted greens with the dressing, then let the dish cool slightly before serving."
    }
  ],
