  "id": "baked-new-potatoes-with-wilted-wild-garlic",
  "name": "Baked New Potatoes with Wilted Wild Garlic",
  "subtitle": "Roasted potatoes with a tangy herb-and-caper finish",
  "description": "Tender baked new potatoes are tossed with mustard, vinegar, parsley, capers, and roughly chopped greens for a bright, savory side dish.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
