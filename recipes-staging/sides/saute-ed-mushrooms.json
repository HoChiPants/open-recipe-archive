      "item": "garlic salt",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper-to-taste",
      "item": "freshly ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil, butter, and teriyaki sauce in a large skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the mushrooms, red cooking wine, garlic, garlic salt, and black pepper; stir to coat."
    },
    {
      "step": 3,
      "text": "Cook, stirring occasionally, until the mushrooms are lightly browned, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Continue cooking until the mushrooms are tender, about 5 minutes more.",
      "timer_minutes": 5
    }
