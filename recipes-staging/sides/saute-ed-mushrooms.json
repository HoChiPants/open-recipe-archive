  "id": "saute-ed-mushrooms",
  "name": "Sautéed Mushrooms",
  "subtitle": "Tender mushrooms with garlic and savory sauce",
  "description": "Sliced button mushrooms are cooked in butter and olive oil with garlic, wine, and teriyaki sauce until lightly browned and tender.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
