      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "button-mushrooms",
      "item": "button mushrooms",
      "quantity": 1,
      "unit": "pound",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "red-cooking-wine",
      "item": "red cooking wine",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
