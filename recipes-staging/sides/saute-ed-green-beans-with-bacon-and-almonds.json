  "id": "saute-ed-green-beans-with-bacon-and-almonds",
  "name": "Sautéed Green Beans with Bacon and Almonds",
  "subtitle": "A savory green bean side with crisp bacon and toasted nuts",
  "description": "Frozen green beans are sautéed in butter, then finished with browned almonds and chopped bacon.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 5
    },
    {
      "ingredient_id": "slivered-almonds",
      "item": "slivered almonds",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "frozen-cut-green-beans",
      "item": "frozen cut green beans",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a skillet over medium heat. Add the bacon and cook until crisp; transfer it to a plate and chop when cool enough to handle."
    },
    {
      "step": 2,
      "text": "Melt the butter in the skillet, then add the frozen green beans."
    },
    {
      "step": 3,
      "text": "Stir and cook the beans for 8 minutes, or until tender.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Add the almonds and stir until golden brown."
    },
    {
      "step": 5,
      "text": "Return the chopped bacon to the skillet, toss to combine, and serve."
    }
  ],
