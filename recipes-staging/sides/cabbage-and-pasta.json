  "id": "cabbage-and-pasta",
  "name": "Cabbage and Pasta",
  "subtitle": "Buttery bow-tie pasta with tender cabbage",
  "description": "A simple American side dish combining farfalle with buttery sautéed cabbage, onion, and garlic.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
