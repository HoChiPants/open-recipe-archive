      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer and season it with the salt."
    },
    {
      "step": 2,
      "text": "Add the farfalle and cook for 10 minutes, or until tender. Drain well.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Heat the butter in a large skillet over medium heat."
    },
    {
      "step": 4,
      "text": "Add the cabbage, onion, garlic, remaining salt, and pepper. Cook for 15 minutes, stirring occasionally, until the cabbage is tender.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir the drained pasta into the cabbage mixture and serve warm."
    }
  ],
