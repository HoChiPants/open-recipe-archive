      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the water and lentils in a pot. Bring to a boil, then cook until the lentils begin to soften, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Drain the lentils and set them aside."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in the pot over medium heat. Add the bell pepper, onion, and salt and pepper; cook until the vegetables are tender."
    },
    {
      "step": 4,
      "text": "Stir in the tomatoes and drained lentils. Simmer until the lentils are fully tender and the mixture is thickened, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
