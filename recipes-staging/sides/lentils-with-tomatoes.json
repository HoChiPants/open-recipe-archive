  "id": "lentils-with-tomatoes",
  "name": "Lentils with Tomatoes",
  "subtitle": "Tender lentils simmered with tomatoes and sautéed vegetables",
  "description": "A simple, savory lentil side dish with green pepper, onion, and chopped tomatoes.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
