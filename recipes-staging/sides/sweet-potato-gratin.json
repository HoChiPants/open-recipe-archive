  "id": "sweet-potato-gratin",
  "name": "Sweet Potato Gratin",
  "subtitle": "Thin-sliced sweet potatoes with herbs, cream, and Gruyere",
  "description": "A creamy, savory gratin layered with sweet potatoes, fresh herbs, garlic, and melted cheese.",
  "meal_type": "side",
