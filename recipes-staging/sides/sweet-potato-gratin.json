  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F and coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Warm the heavy cream, butter, and garlic together until the butter melts and the mixture reaches a gentle simmer. Remove from the heat."
    },
    {
      "step": 3,
      "text": "Combine the parsley, thyme, sage, rosemary, salt, and pepper."
    },
    {
      "step": 4,
      "text": "Arrange the sweet potato slices in the prepared dish, sprinkling the herb mixture between layers. Pour the warm cream mixture evenly over the potatoes, then cover with the Gruyere."
    },
    {
      "step": 5,
      "text": "Bake until the potatoes are tender and the top is golden brown, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
