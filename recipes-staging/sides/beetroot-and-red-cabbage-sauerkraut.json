  "id": "beetroot-and-red-cabbage-sauerkraut",
  "name": "Beetroot and Red Cabbage Sauerkraut",
  "subtitle": "A crisp, brightly colored vegetable ferment base",
  "description": "Grated beetroot, red cabbage, onion, caraway, and sea salt are combined and packed into jars for a tangy sauerkraut-style side.",
  "meal_type": "side",
  "yield": {
    "quantity": 2,
    "unit": "x 500ml jars"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "raw-beetroot-peeled-and-coarsely-grated",
      "item": "raw beetroot peeled and coarsely grated",
      "quantity": 320,
      "unit": "g"
    },
    {
      "ingredient_id": "very-finely-shredded-red-cabbage",
      "item": "very finely shredded red cabbage",
      "quantity": 450,
      "unit": "g"
    },
    {
      "ingredient_id": "red-onion-85g",
      "item": "red onion (85g)",
      "quantity": 1,
      "unit": "small",
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "caraway-seeds",
      "item": "caraway seeds",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "heaped-tbsp-flaky-sea-salt",
      "item": "heaped tbsp flaky sea salt",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the grated beetroot, shredded cabbage, chopped onion, caraway seeds, and salt in a large bowl."
    },
    {
      "step": 2,
      "text": "Massage and stir the mixture until the vegetables soften and release liquid, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pack the mixture and its liquid into two clean 500ml jars, pressing it down firmly. No federal meat, poultry, fish, or egg temperature endpoint applies to this uncooked vegetable preparation."
    }
  ],
