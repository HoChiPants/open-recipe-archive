  "id": "stir-fried-snow-peas-and-carrots",
  "name": "Stir-Fried Snow Peas and Carrots",
  "subtitle": "Tender-crisp vegetables in a light sesame sauce",
  "description": "A quick vegetable side dish combining snow peas and carrots with a savory thickened broth sauce.",
  "meal_type": "side",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "snow-peas",
      "item": "snow peas",
      "quantity": 0.5,
      "unit": "pound"
    },
    {
      "ingredient_id": "thinly-sliced-carrot",
      "item": "thinly sliced carrot",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the soy sauce and cornstarch together until smooth; set aside."
    },
    {
      "step": 2,
      "text": "Coat a skillet with cooking spray and preheat it over medium-high heat. Add the sesame oil, snow peas, and carrot, then stir-fry for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Pour in the chicken broth and bring the mixture to 165°F, checking with a food thermometer."
    },
    {
      "step": 4,
      "text": "Simmer for 5 minutes, stirring occasionally, until the vegetables are tender-crisp.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the soy sauce mixture and cook until the sauce thickens."
    }
  ],
