  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Bring the milk and 0.5 cup butter to a boil in a saucepan."
    },
    {
      "step": 3,
      "text": "Whisk in the uncooked grits and cook for 5 minutes, stirring until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Season with the salt and white pepper, then whisk to combine."
    },
    {
      "step": 5,
      "text": "Stir in the remaining butter, Cheddar cheese, and grated Parmesan cheese."
    },
    {
      "step": 6,
      "text": "Transfer the mixture to the prepared dish and bake for 60 minutes, until firm.",
      "timer_minutes": 60
    }
  ],
