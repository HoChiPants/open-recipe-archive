  "id": "cheesy-baked-grits",
  "name": "Cheesy Baked Grits",
  "subtitle": "Creamy grits baked with cheddar and Parmesan",
  "description": "Cook grits in buttery milk, enrich them with cheese, and bake until firm for a savory side dish.",
  "meal_type": "side",
