  "id": "spicy-watermelon",
  "name": "Spicy Watermelon",
  "subtitle": "Chili-lime watermelon with warm spice",
  "description": "Juicy watermelon gets a bright lime finish and a balanced blend of chili, cumin, coriander, and cayenne.",
  "meal_type": "side",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-coriander",
      "item": "ground coriander",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "chili-powder",
      "item": "chili powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "watermelon",
      "item": "watermelon",
      "quantity": 2,
      "unit": "cups",
      "preparation": "cubed seeded"
    },
    {
      "ingredient_id": "lime",
      "item": "lime",
      "quantity": 0.5,
      "preparation": "juiced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the cumin, coriander, chili powder, salt, and cayenne together in a small bowl."
    },
    {
      "step": 2,
      "text": "Place the cubed, seeded watermelon in a serving bowl and sprinkle it with the spice mixture."
    },
    {
      "step": 3,
      "text": "Add the lime juice and toss gently until the watermelon is evenly coated. Serve immediately."
    }
  ],
