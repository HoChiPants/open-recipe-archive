  "id": "asparagus-peas-and-potatoes-with-mint-garlic-butter",
  "name": "Asparagus, Peas and Potatoes with Mint-Garlic Butter",
  "subtitle": "A spring vegetable side with bright herbs and toasted almonds",
  "description": "Tender potatoes, peas, and asparagus are finished with mint, wild garlic, lemon, and buttery toasted almonds.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "as a side"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "jersey-royal-potatoes",
      "item": "Jersey Royal potatoes",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "handful-slivered-almonds",
      "item": "handful slivered almonds"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 75,
      "unit": "g",
      "preparation": "softened"
    },
    {
      "ingredient_id": "handful-wild-garlic-leaves",
      "item": "handful wild garlic leaves",
      "unit": "small",
      "preparation": "very finely chopped (or 1 crushed garlic clove)"
    },
    {
      "ingredient_id": "mint-leaves",
      "item": "mint leaves",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "freshly-podded-peas",
      "item": "freshly podded peas",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "drizzle-olive-oil-for-frying",
      "item": "drizzle olive oil for frying"
    },
    {
      "ingredient_id": "lemon-zested-and-juiced",
      "item": "lemon zested and juiced",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "a-bunch-of-asparagus",
      "item": "A bunch of asparagus"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Simmer the potatoes in water for 10 minutes, or until tender, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a pan and toast the slivered almonds until lightly golden. Set them aside."
    },
    {
      "step": 3,
      "text": "Mix the softened butter with the wild garlic and mint; set aside."
    },
    {
      "step": 4,
      "text": "Cook the peas in boiling water until tender, then drain."
    },
    {
      "step": 5,
      "text": "Heat the olive oil in a pan. Coat the asparagus with the oil and cook for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 6,
      "text": "Stir the potatoes, peas, and asparagus with the herb butter, lemon zest, and lemon juice."
    },
    {
      "step": 7,
      "text": "Scatter the toasted almonds over the vegetables and serve."
    }
  ],
