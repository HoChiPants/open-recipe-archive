  },
  "ingredients": [
    {
      "ingredient_id": "zucchinis",
      "item": "zucchinis",
      "quantity": 2,
      "preparation": "quartered lengthwise"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "italian-seasoning",
      "item": "Italian seasoning",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
