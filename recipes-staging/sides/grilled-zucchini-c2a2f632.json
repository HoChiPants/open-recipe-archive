    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Brush the zucchini with the olive oil."
    },
    {
      "step": 2,
      "text": "Combine the Italian seasoning, garlic powder, and salt, then sprinkle the mixture over the zucchini."
    },
    {
      "step": 3,
      "text": "Grill the zucchini until golden brown, turning as needed for even cooking.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Drizzle the balsamic vinegar over the grilled zucchini and let it stand briefly.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
