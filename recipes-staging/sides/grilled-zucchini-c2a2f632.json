  "name": "Grilled Zucchini",
  "subtitle": "Seasoned zucchini with a balsamic finish",
  "description": "Quartered zucchini is grilled with Italian seasoning and garlic, then finished with balsamic vinegar.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
