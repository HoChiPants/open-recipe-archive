  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "oven-roasted-sweet-potatoes",
  "name": "Oven-Roasted Sweet Potatoes",
  "subtitle": "Tender roasted vegetables with balsamic finish",
  "description": "Sweet potatoes, onion, and garlic roast until golden, then are finished with balsamic vinegar and seasoning.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-potato",
      "item": "sweet potato",
      "quantity": 4,
      "unit": "cups",
      "preparation": "chopped peeled"
    },
    {
      "ingredient_id": "sweet-onion",
      "item": "sweet onion",
      "quantity": 1,
      "preparation": "cut into wedges"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Combine the sweet potato, onion, and garlic with the olive oil, then spread the mixture on a baking sheet."
    },
    {
      "step": 3,
      "text": "Roast for 30 minutes, or until the vegetables are golden brown.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Drizzle with balsamic vinegar and season with salt and ground black pepper to taste."
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
