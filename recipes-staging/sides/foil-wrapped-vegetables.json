      "item": "fresh green beans",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "cut into 1 inch pieces"
    },
    {
      "ingredient_id": "sprig-fresh-rosemary",
      "item": "sprig fresh rosemary",
      "quantity": 1
    },
