  "id": "foil-wrapped-vegetables",
  "name": "Foil-Wrapped Vegetables",
  "subtitle": "Tender seasonal vegetables cooked in sealed foil packets",
  "description": "Sliced potatoes, onion, green beans, and fresh herbs are seasoned, oiled, and baked in foil packets until tender.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
