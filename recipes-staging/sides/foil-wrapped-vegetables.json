      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Combine the new potatoes, sweet potato, onions, green beans, rosemary, and thyme in a large bowl."
    },
    {
      "step": 2,
      "text": "Add 2 tablespoons olive oil and season with salt and pepper; toss to coat."
    },
    {
      "step": 3,
      "text": "Lay out large sheets of foil and divide the vegetables among them. Drizzle with the remaining olive oil, then fold and seal the foil into packets."
    },
    {
      "step": 4,
      "text": "Arrange the packets on a baking sheet and bake for 30 minutes, or until the potatoes and vegetables are tender.",
      "timer_minutes": 30
    }
  ],
