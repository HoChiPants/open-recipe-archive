  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Coat a roasting pan or baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Combine the potatoes, carrots, onion, balsamic vinegar, melted butter, thyme, garlic, salt, and pepper in a bowl."
    },
    {
      "step": 3,
      "text": "Spread the vegetables in an even layer in the prepared pan."
    },
    {
      "step": 4,
      "text": "Roast for 15 minutes, then stir the vegetables.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Continue roasting for 30 minutes, or until the vegetables are tender and lightly browned.",
      "timer_minutes": 30
    }
  ],
