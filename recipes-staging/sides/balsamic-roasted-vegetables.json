  "id": "balsamic-roasted-vegetables",
  "name": "Balsamic-Roasted Vegetables",
  "subtitle": "Tender vegetables with a tangy balsamic glaze",
  "description": "Potatoes, carrots, and onion roast with balsamic vinegar, butter, thyme, and garlic for a savory side dish.",
  "meal_type": "side",
  "cuisine": "Italian",
  "yield": {
