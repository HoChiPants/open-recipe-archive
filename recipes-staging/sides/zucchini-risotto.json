  "id": "zucchini-risotto",
  "name": "Zucchini Risotto",
  "subtitle": "Creamy rice with zucchini, tomatoes, herbs, and cheese",
  "description": "A savory Italian-style risotto finished with tender zucchini, sun-dried tomatoes, basil, and grated cheese.",
  "meal_type": "side",
  "cuisine": "Italian",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-or-chicken-stock",
      "item": "vegetable or chicken stock",
      "quantity": 7,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "medium",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "arborio-rice",
      "item": "Arborio rice",
      "quantity": 2,
      "unit": "cups",
      "preparation": "uncooked"
    },
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 0.5,
      "unit": "medium",
      "preparation": "thinly sliced with a vegetable peeler"
    },
    {
      "ingredient_id": "sun-dried-tomatoes",
      "item": "sun-dried tomatoes",
      "quantity": 10,
      "preparation": "softened and chopped"
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "freshly-grated-parmesan-or-mozzarella-cheese",
      "item": "freshly grated Parmesan (or mozzarella) cheese",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fresh-basil-leaves",
      "item": "fresh basil leaves",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped, or to taste"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper-to-taste",
      "item": "freshly ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring the stock to a simmer in a saucepan. If using homemade chicken stock containing poultry, reheat it to 165°F, verified with a food thermometer, before proceeding."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large saucepan over medium heat. Add the onion and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir in the Arborio rice and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the simmering stock and cook, stirring regularly, until the rice is tender and the mixture is creamy."
    },
    {
      "step": 5,
      "text": "Stir in the zucchini, sun-dried tomatoes, and thyme, and continue cooking until the zucchini is tender."
    },
    {
      "step": 6,
      "text": "Fold in the cheese and basil, then season with black pepper and serve."
    }
  ],
