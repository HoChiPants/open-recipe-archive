  "ingredients": [
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 3,
      "unit": "medium",
      "preparation": "cut into cubes"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "italian-style-bread-crumbs",
      "item": "Italian-style bread crumbs",
      "quantity": 1,
