  "id": "roasted-zucchini-with-parmesan-breadcrumbs",
  "name": "Roasted Zucchini with Parmesan Breadcrumbs",
  "subtitle": "Tender zucchini with a crisp, savory topping",
  "description": "Cubed zucchini is coated with olive oil, seasoned breadcrumbs, Parmesan, and garlic, then baked until tender.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
