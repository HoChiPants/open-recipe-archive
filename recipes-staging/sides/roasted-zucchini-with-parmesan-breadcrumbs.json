      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Place the cubed zucchini in a baking dish and coat with the olive oil."
    },
    {
      "step": 3,
      "text": "Mix the breadcrumbs, Parmesan, garlic, salt, and pepper, then spread the mixture over the zucchini."
    },
    {
      "step": 4,
      "text": "Bake until the zucchini is tender and the topping is lightly browned, about 15 minutes.",
      "timer_minutes": 15
    }
  ],
