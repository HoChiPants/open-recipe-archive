  "id": "salt-and-pepper-skillet-fries",
  "name": "Salt and Pepper Skillet Fries",
  "subtitle": "Crisp-edged potatoes seasoned simply",
  "description": "Potato strips cook in a butter-and-oil skillet until browned, then finish with coarse salt and cracked pepper.",
  "meal_type": "side",
