  "id": "creamy-corn-and-bean-casserole",
  "name": "Creamy Corn and Bean Casserole",
  "subtitle": "A warm, cheesy vegetable side with a mild jalapeño kick.",
  "description": "Cream cheese, corn, black beans, tomatoes, and jalapeños bake into a rich, colorful casserole topped with melted cheddar.",
  "meal_type": "side",
  "cuisine": "Mexican Inspired",
  "yield": {
