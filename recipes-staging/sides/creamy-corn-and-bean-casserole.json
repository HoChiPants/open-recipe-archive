  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "In a saucepan, whisk the cream cheese, butter, and half of the cheddar over heat until melted. Stir until smooth."
    },
    {
      "step": 3,
      "text": "Combine the cream cheese mixture with the black beans, tomatoes, both corns, and remaining cheddar."
    },
    {
      "step": 4,
      "text": "Transfer to a baking dish and bake for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Stir in the jalapeños and any melted cheese from the surface, then return the dish to the oven until the cheese is melted."
    }
  ],
