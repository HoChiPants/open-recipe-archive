  "id": "spinach-mashed-potatoes",
  "name": "Spinach Mashed Potatoes",
  "subtitle": "Creamy mashed potatoes with spinach and Cheddar",
  "description": "A warm, creamy potato side dish combined with seasoned spinach and topped with melted Cheddar.",
  "meal_type": "side",
