  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Prepare the spinach according to the package directions."
    },
    {
      "step": 3,
      "text": "Place the potatoes in a pot, cover with water, and cook for 15 minutes, or until tender. Drain and let cool briefly.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Combine the potatoes and spinach with the butter, sour cream, onion, salt, and dill. Mash until combined, then transfer to a baking dish."
    },
    {
      "step": 5,
      "text": "Top with the shredded Cheddar cheese and bake until hot and the cheese is melted, about 20 minutes.",
      "timer_minutes": 20
    }
  ],
