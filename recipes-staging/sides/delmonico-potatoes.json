  "id": "delmonico-potatoes",
  "name": "Delmonico Potatoes",
  "subtitle": "Creamy layered potatoes with cheese and herbs",
  "description": "Partially boiled potatoes are chilled, layered with seasoned butter, sour cream, milk, and shredded processed cheese, then baked until lightly browned.",
  "meal_type": "side",
  "cuisine": "American",
