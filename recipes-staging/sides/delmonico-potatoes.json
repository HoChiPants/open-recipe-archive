  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water seasoned with the salt to a simmer. Add the potatoes and cook for 10 minutes, until boiling and partially tender.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Drain the potatoes, let them cool, and chill them for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 4,
      "text": "Melt the butter with the minced onion, dried parsley, and ground black pepper."
    },
    {
      "step": 5,
      "text": "Whisk the sour cream and milk together."
    },
    {
      "step": 6,
      "text": "Layer the chilled potatoes in a baking dish. Add the melted butter and onion mixture, then pour the sour cream mixture over the top."
    },
    {
      "step": 7,
      "text": "Sprinkle the shredded processed cheese over the potatoes and bake for 60 minutes, until lightly browned and the center is fully hot.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Serve hot."
    }
  ],
