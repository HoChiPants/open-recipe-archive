  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Cook the bulk Italian sausage with the rubbed dried sage and fresh sage in a large skillet, breaking it up, until browned and cooked through to 160°F. Drain and transfer to a large bowl."
    },
    {
      "step": 3,
      "text": "Heat the pancetta bacon and olive oil in the skillet. Add the celery and onions; cook until the onions soften, about 8 minutes. Stir in the garlic and cook for 3 minutes.",
      "timer_minutes": 11
    },
    {
      "step": 4,
      "text": "Add the cooked sausage mixture, day-old French bread, crumbled cornbread, pine nuts, poultry seasoning, rubbed dried sage, salt, and fresh sage to the skillet or bowl; toss to combine."
    },
    {
      "step": 5,
      "text": "Pour in the chicken broth and add the mozzarella cheese and shaved Parmesan cheese. Stir until the bread is evenly moistened and the mixture is combined."
    },
    {
      "step": 6,
      "text": "Transfer the stuffing to a buttered baking dish and dot the top with the butter."
    },
    {
      "step": 7,
      "text": "Bake until the center reaches 165°F, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Continue baking until the top is golden brown, about 15 minutes more.",
      "timer_minutes": 15
    },
    {
      "step": 9,
      "text": "Serve warm."
    }
  ],
