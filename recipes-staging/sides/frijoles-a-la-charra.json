  "instructions": [
    {
      "step": 1,
      "text": "Transfer the dry pinto beans to a large pot and cover with water. Add the garlic and salt, then bring to a boil and cook for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Cook the diced bacon in a skillet until tender. Drain excess fat, return the skillet to heat, and cook the onion until tender."
    },
    {
      "step": 3,
      "text": "Stir in the tomatoes and sliced jalapeño peppers. Add this mixture and the bacon to the pot of beans."
    },
    {
      "step": 4,
      "text": "Simmer the beans gently until tender, about 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 5,
      "text": "Stir in the beer and cilantro, then continue cooking for 30 minutes before serving.",
      "timer_minutes": 30
    }
  ],
