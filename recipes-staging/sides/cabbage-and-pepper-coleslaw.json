  "instructions": [
    {
      "step": 1,
      "text": "Place the cabbage, onion, bell peppers, carrot, and black pepper in a large bowl."
    },
    {
      "step": 2,
      "text": "Whisk the vinegar, sugar, salt, remaining black pepper, and vegetable oil until blended."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the vegetables and toss until evenly coated."
    }
