  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "fried-buttered-noodles",
  "name": "Fried Buttered Noodles",
  "subtitle": "Tender egg noodles with buttery toasted crumbs",
  "description": "Cooked egg noodles are combined with butter and bread crumbs, then finished until hot and crisp-edged.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "egg-noodles",
      "item": "egg noodles",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "bread-crumbs",
      "item": "bread crumbs",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of salted water to a simmer. Add the egg noodles and cook for 8 minutes, or until tender.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Drain the noodles thoroughly."
    },
    {
      "step": 3,
      "text": "Melt the butter in a large oven-safe skillet or baking dish. Stir in the bread crumbs."
    },
    {
      "step": 4,
      "text": "Add the drained noodles and toss until evenly coated."
    },
    {
      "step": 5,
      "text": "Cook the mixture for 30 minutes, until hot throughout; verify that the center reaches 160°F with a food thermometer before serving.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Season with salt to taste."
    }
  ],
