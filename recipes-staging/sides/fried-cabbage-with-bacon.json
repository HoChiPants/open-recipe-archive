  "id": "fried-cabbage-with-bacon",
  "name": "Fried Cabbage with Bacon",
  "subtitle": "Savory skillet cabbage with crisp bacon and onion",
  "description": "Cabbage cooks down with bacon, onion, garlic, and simple seasonings for a hearty American side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "thick-bacon-strips",
      "item": "thick bacon strips",
      "quantity": 5,
      "preparation": "cut into small pieces"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced, or more to taste"
    },
    {
      "ingredient_id": "head-cabbage",
      "item": "head cabbage",
      "quantity": 1,
      "unit": "medium",
      "preparation": "shredded or chopped"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat a large skillet over medium heat. Add the bacon and cook for 5 minutes, until rendered and set.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the onion and garlic. Cook for 5 minutes, stirring occasionally, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the cabbage, paprika, sugar, salt, and black pepper. Toss to combine."
    },
    {
      "step": 4,
      "text": "Cook for 10 minutes, stirring occasionally, until the cabbage begins to soften.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Continue cooking the cabbage and bacon for 30 minutes, stirring periodically, until tender and well browned.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
