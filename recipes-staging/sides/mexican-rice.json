    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion-powder",
      "item": "onion powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "uncooked-white-rice",
      "item": "uncooked white rice",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "tomato-sauce",
      "item": "tomato sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "6.5 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the canola oil in a saucepan over medium heat. Stir in the onion powder and garlic powder."
    },
    {
      "step": 2,
      "text": "Add the uncooked rice and stir for 4 minutes, coating the grains in the seasoned oil.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Stir in the water and tomato sauce, then bring the mixture to a simmer."
    },
    {
      "step": 4,
      "text": "Cover, reduce the heat to low, and cook for 15 minutes, or until the rice is tender.",
      "timer_minutes": 15
    }
  ],
