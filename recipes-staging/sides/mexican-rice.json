  "id": "mexican-rice",
  "name": "Mexican Rice",
  "subtitle": "Tender tomato-seasoned rice for a simple side",
  "description": "Rice is toasted in seasoned oil, then simmered with water and tomato sauce until tender.",
  "meal_type": "side",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
