      "item": "garlic powder to taste"
    },
    {
      "ingredient_id": "onion-powder-to-taste",
      "item": "onion powder to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Arrange the squash halves cut-side up in a baking dish."
    },
    {
      "step": 2,
      "text": "Combine the stuffing mix, broth, seasonings, and the divided butter and brown sugar as directed by the ingredient divisions. Spoon the mixture into the squash cavities."
    },
    {
      "step": 3,
      "text": "Bake for 60 minutes, until the squash is tender and the stuffing reaches 165°F in the center.",
      "timer_minutes": 60
    }
  ],
