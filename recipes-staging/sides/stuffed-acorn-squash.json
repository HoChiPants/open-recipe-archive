      "ingredient_id": "acorn-squash",
      "item": "acorn squash",
      "quantity": 1,
      "preparation": "halved and seeded"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "dry-bread-stuffing-mix",
      "item": "dry bread stuffing mix",
      "quantity": 2,
      "unit": "cups",
      "preparation": "divided"
    },
    {
