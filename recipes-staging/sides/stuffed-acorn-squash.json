  "id": "stuffed-acorn-squash",
  "name": "Stuffed Acorn Squash",
  "subtitle": "Tender squash filled with savory bread stuffing",
  "description": "Roasted acorn squash halves hold a buttery, seasoned bread stuffing for a warm, autumnal side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
