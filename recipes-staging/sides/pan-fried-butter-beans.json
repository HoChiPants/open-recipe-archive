{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pan-fried-butter-beans",
  "name": "Pan-Fried Butter Beans",
  "subtitle": "Crisp-edged beans with rosemary, garlic, and vinegar",
  "description": "Tender butter beans are pan-fried until lightly crisp, then finished with rosemary, garlic, chile, and white wine vinegar.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter-beans",
      "item": "butter beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, drained, rinsed, and patted dry"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "peeled and smashed"
    },
    {
      "ingredient_id": "sprigs-fresh-rosemary",
      "item": "sprigs fresh rosemary",
      "quantity": 2
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the butter beans and cook, stirring occasionally, until heated through and lightly browned, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the garlic, rosemary, red pepper flakes, salt, and black pepper. Cook, stirring, until fragrant, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the white wine vinegar, then remove the garlic and rosemary sprigs if desired."
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
