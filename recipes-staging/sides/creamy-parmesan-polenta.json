  "id": "creamy-parmesan-polenta",
  "name": "Creamy Parmesan Polenta",
  "subtitle": "A warm, savory polenta side with Parmesan and pepper",
  "description": "Warm cubed polenta with broth, then finish it with Parmesan, pepper, and paprika for a creamy, flavorful side dish.",
  "meal_type": "side",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "polenta",
      "item": "polenta",
      "quantity": 1,
      "unit": "package",
      "preparation": "18 ounce, cut into 1/2-inch cubes"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the cubed polenta and chicken broth in a saucepan and heat until steaming hot, reaching 165°F on a food thermometer."
    },
    {
      "step": 2,
      "text": "Cook for 5 minutes, stirring occasionally, until the polenta is hot and softened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the Parmesan, black pepper, and paprika. Serve warm."
    }
  ],
