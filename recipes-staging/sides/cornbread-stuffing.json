      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "buttermilk-or-natural-yogurt",
      "item": "buttermilk or natural yogurt",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "red-chillies-deseeded-and-finely-chopped",
      "item": "red chillies deseeded and finely chopped",
      "quantity": "1-2"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease a baking dish with some of the extra butter."
    },
    {
      "step": 2,
      "text": "Whisk the fine semolina or polenta, plain flour, baking powder, and bicarbonate of soda. In another bowl, combine the eggs, melted butter, buttermilk or natural yogurt, and red chillies; stir into the dry ingredients until just combined."
    },
    {
      "step": 3,
      "text": "Pour the batter into the prepared dish and bake until set and lightly golden. Cool, then cut into chunks.",
      "timer_minutes": 50
    },
    {
      "step": 4,
      "text": "Cook the bacon in a skillet over medium heat until browned and crisp.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the onion, garlic, and celery; sauté until softened. Stir in the sage, then remove from the heat and let the mixture cool slightly.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Break the cornbread into a large bowl. Toss with the bacon mixture, beaten eggs, and cooled vegetable stock until evenly moistened."
    },
    {
      "step": 7,
      "text": "Transfer the stuffing to the greased dish and bake until golden brown and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 20
    }
  ],
