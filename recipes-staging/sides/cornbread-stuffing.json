      "item": "garlic cloves finely chopped",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "celery-sticks-finely-chopped",
      "item": "celery sticks finely chopped",
      "quantity": 3
    },
    {
      "ingredient_id": "bunch-of-sage-finely-chopped",
      "item": "bunch of sage finely chopped",
      "unit": "small"
    },
    {
      "ingredient_id": "eggs-beaten",
      "item": "eggs beaten",
      "quantity": 2
    },
    {
      "ingredient_id": "vegetable-stock-cooled",
      "item": "vegetable stock cooled",
      "quantity": 400,
      "unit": "ml"
    },
    {
      "ingredient_id": "salted-butter-melted",
      "item": "salted butter melted",
      "quantity": 50,
      "unit": "g",
      "preparation": "plus extra for the dish"
    },
    {
      "ingredient_id": "fine-semolina-or-polenta",
      "item": "fine semolina or polenta",
      "quantity": 175,
