  "id": "cornbread-stuffing",
  "name": "Cornbread Stuffing",
  "subtitle": "Sage, bacon, and celery stuffing with a tender cornbread base",
  "description": "Bake a lightly spicy cornbread, fold it with crisp bacon, aromatic vegetables, sage, and stock, then bake until golden and the center reaches 165°F.",
  "meal_type": "side",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 60,
    "cook_minutes": 70
  },
  "ingredients": [
