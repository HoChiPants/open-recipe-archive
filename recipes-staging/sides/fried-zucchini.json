  "id": "fried-zucchini",
  "name": "Fried Zucchini",
  "subtitle": "Crisp cornmeal-coated zucchini and onion",
  "description": "Sliced zucchini and onion are coated in a seasoned flour-cornmeal mixture, then fried until golden and drained before serving.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 2,
      "preparation": "quartered and sliced"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "sliced into rings"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornmeal",
      "item": "cornmeal",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the zucchini and onion in a bowl."
    },
    {
      "step": 2,
      "text": "Mix the flour, cornmeal, salt, black pepper, and garlic powder in a separate bowl."
    },
    {
      "step": 3,
      "text": "Add the zucchini and onion to the flour mixture and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Heat the vegetable oil in a skillet over medium heat."
    },
    {
      "step": 5,
      "text": "Fry the coated vegetables in batches for about 30 minutes, turning as needed, until golden brown.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Drain on paper towels and serve."
    }
  ],
