  "id": "fried-cabbage-and-bacon",
  "name": "Fried Cabbage and Bacon",
  "subtitle": "Tender cabbage with crisp bacon and tangy vinegar",
  "description": "A savory skillet side dish combining cabbage, bacon, onion, and a light cider-vinegar finish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 3,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cabbage",
      "item": "cabbage",
      "quantity": 6,
      "unit": "cups",
      "preparation": "cut into thin wedges"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "cider-vinegar",
      "item": "cider vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the chopped bacon in a large skillet and heat the skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Cook the bacon until set, then add the onion and cook until the onion is tender."
    },
    {
      "step": 3,
      "text": "Stir in the cabbage, water, sugar, salt, and pepper."
    },
    {
      "step": 4,
      "text": "Cook for 15 minutes, stirring occasionally, until the cabbage is tender.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir the bacon back through the cabbage and mix in the cider vinegar before serving."
    }
  ],
