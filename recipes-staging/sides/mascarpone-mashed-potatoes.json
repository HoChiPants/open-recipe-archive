  "id": "mascarpone-mashed-potatoes",
  "name": "Mascarpone Mashed Potatoes",
  "subtitle": "Creamy potatoes with a golden baked finish",
  "description": "Mashed russet potatoes enriched with mascarpone, milk, egg yolk, and butter, then baked until golden and set.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 35,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "russet-potatoes",
      "item": "russet potatoes",
      "quantity": 4.5,
      "unit": "pounds",
      "preparation": "peeled and halved lengthwise"
    },
    {
      "ingredient_id": "mascarpone-cheese-at-room-temperature",
      "item": "mascarpone cheese at room temperature",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-yolk",
      "item": "egg yolk",
      "quantity": 1
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "cut into chunks"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Cook the potatoes in salted water until tender, about 15 minutes. Drain and let them stand for 5 minutes to release excess steam.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Whisk the mascarpone until smooth, then stir in the egg yolk and milk. Season with salt, black pepper, and cayenne."
    },
    {
      "step": 3,
      "text": "Mash the potatoes with the butter, then fold in the mascarpone mixture until combined. Transfer to a baking dish."
    },
    {
      "step": 4,
      "text": "Bake until golden brown and the center reaches 160°F, about 20 minutes.",
      "timer_minutes": 20
    }
  ],
