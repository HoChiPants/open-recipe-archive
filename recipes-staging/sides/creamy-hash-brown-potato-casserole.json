      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-dill-weed",
      "item": "dried dill weed",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "paprika-to-taste",
      "item": "paprika to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the thawed hash brown potatoes, both condensed soups, sour cream, milk, and chopped onion in a large bowl."
    },
    {
      "step": 3,
      "text": "Stir in the salt, pepper, and dried dill weed until evenly distributed."
    },
    {
      "step": 4,
      "text": "Fold in the shredded Cheddar, then transfer the mixture to a baking dish and sprinkle with paprika."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until hot throughout and bubbling at the edges.",
      "timer_minutes": 60
    }
  ],
