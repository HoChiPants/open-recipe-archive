    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-hash-brown-potatoes",
      "item": "frozen hash brown potatoes",
      "quantity": 1,
      "unit": "package",
      "preparation": "2 pound, thawed"
    },
    {
      "ingredient_id": "condensed-cream-of-potato-soup",
      "item": "condensed cream of potato soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "condensed-cream-of-celery-soup",
      "item": "condensed cream of celery soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "16-ounce-container-sour-cream",
      "item": "(16 ounce) container sour cream",
      "quantity": 1
    },
