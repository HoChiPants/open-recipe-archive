  "id": "creamy-hash-brown-potato-casserole",
  "name": "Creamy Hash Brown Potato Casserole",
  "subtitle": "A rich, savory baked potato side",
  "description": "Thawed hash browns combine with creamy soups, sour cream, onion, seasonings, and Cheddar for a warm, spoonable casserole.",
  "meal_type": "side",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
