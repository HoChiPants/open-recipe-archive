  "ingredients": [
    {
      "ingredient_id": "ears-corn",
      "item": "ears corn",
      "quantity": 10,
      "preparation": "husked and cleaned"
    },
    {
      "ingredient_id": "cajun-seasoning-to-taste",
      "item": "Cajun seasoning to taste"
    },
    {
      "ingredient_id": "salt-and-black-pepper-to-taste",
      "item": "salt and black pepper to taste"
    },
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "package",
      "preparation": "1 pound, sliced"
    },
