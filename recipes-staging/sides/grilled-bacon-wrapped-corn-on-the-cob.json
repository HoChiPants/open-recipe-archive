  "id": "grilled-bacon-wrapped-corn-on-the-cob",
  "name": "Grilled Bacon-Wrapped Corn on the Cob",
  "subtitle": "Seasoned corn wrapped in crisp bacon",
  "description": "Corn is seasoned, wrapped in bacon, enclosed in foil, and grilled until tender.",
  "meal_type": "side",
  "cuisine": "American",
