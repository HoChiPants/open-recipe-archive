      "ingredient_id": "12x8-inch-sheets-aluminum-foil",
      "item": "12x8-inch sheets aluminum foil",
      "quantity": 10
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill."
    },
    {
      "step": 2,
      "text": "Season the cleaned corn with Cajun seasoning, salt, and black pepper."
    },
    {
      "step": 3,
      "text": "Wrap each ear with bacon, then enclose each one in a sheet of aluminum foil."
    },
    {
      "step": 4,
      "text": "Grill the foil-wrapped corn for 10 minutes, turning as needed.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Continue grilling with the bacon-wrapped corn for about 45 minutes, turning occasionally, until the corn is tender.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Carefully open the foil and serve hot."
    }
  ],
