  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cheesy-bacon-corn-bake",
  "name": "Cheesy Bacon Corn Bake",
  "subtitle": "Creamy corn with crisp bacon and melted cheese",
  "description": "A warm, savory corn side dish layered with bacon, aromatics, cream, jalapeño, and two cheeses.",
  "meal_type": "side",
  "cuisine": "Korean",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, chopped"
    },
    {
      "ingredient_id": "frozen-sweet-corn",
      "item": "frozen sweet corn",
      "quantity": 2,
      "unit": "package",
      "preparation": "16 ounce, thawed"
    },
    {
      "ingredient_id": "bunch-green-onions",
      "item": "bunch green onions",
      "quantity": 1,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "jalapeno-peppers",
      "item": "jalapeno peppers",
      "quantity": 2,
      "preparation": "diced, or more to taste"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "monterey-jack-cheese",
      "item": "Monterey Jack cheese",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 2,
      "unit": "ounces",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F and lightly grease a baking dish."
    },
    {
      "step": 2,
      "text": "Cook the bacon in a large skillet until browned and crisp, about 8 minutes. Drain excess fat if needed.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Drain the thawed corn, add it to the skillet, and cook with the bacon until lightly golden, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the green onions, jalapeños, and garlic; cook until fragrant and the vegetables soften, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Season with the salt, pepper, and cayenne. Whisk in the heavy cream, then stir until the corn is evenly coated and the mixture is hot."
    },
    {
      "step": 6,
      "text": "Transfer the mixture to the prepared dish and top with the Monterey Jack and mozzarella."
    },
    {
      "step": 7,
      "text": "Bake until the cheese is melted and bubbling, about 10 minutes. Serve hot.",
      "timer_minutes": 10
    }
  ],
