  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Place the Brussels sprouts and butternut squash on a sheet pan. Add the olive oil, garlic powder, smoked paprika, sea salt, and black pepper, then toss to coat evenly."
    },
    {
      "step": 3,
      "text": "Spread the vegetables in an even layer and roast for 25 minutes, until tender and browned at the edges.",
