{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "creamy-vegetable-medley",
  "name": "Creamy Vegetable Medley",
  "subtitle": "A warm, cheesy vegetable casserole with crisp onion topping.",
  "description": "Frozen broccoli, carrots, and cauliflower are baked in a creamy mushroom sauce with Cheddar and French-fried onions for a comforting side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-broccoli",
      "item": "frozen broccoli",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce, carrots and cauliflower combination"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded, divided"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.33300000429153,
      "unit": "cup"
    },
    {
      "ingredient_id": "french-fried-onions",
      "item": "French-fried onions",
      "quantity": 1,
      "unit": "package",
      "preparation": "2.8 ounce, divided"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the frozen vegetable mixture in boiling water for 11 minutes, then drain well.",
      "timer_minutes": 11
    },
    {
      "step": 3,
      "text": "Whisk together the soup, sour cream, black pepper, half the Cheddar, and half the French-fried onions until smooth."
    },
    {
      "step": 4,
      "text": "Fold the drained vegetables into the sauce and transfer the mixture to a baking dish."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Top with the remaining Cheddar and French-fried onions, then return to the oven until the cheese is melted and the onions are crisp."
    }
  ],
