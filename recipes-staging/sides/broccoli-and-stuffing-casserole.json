  "id": "broccoli-and-stuffing-casserole",
  "name": "Broccoli and Stuffing Casserole",
  "subtitle": "A savory baked broccoli side with a crisp stuffing topping",
  "description": "Tender broccoli is layered with a creamy egg and mushroom-soup mixture, then finished with buttery stuffing, Cheddar, and a brief bake.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
