      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Boil the broccoli until tender, then drain well."
    },
    {
      "step": 3,
      "text": "Stir together the beaten eggs, chopped onion, condensed soup, and mayonnaise."
    },
    {
      "step": 4,
      "text": "Layer the broccoli in a baking dish and spread the soup mixture over it."
    },
    {
      "step": 5,
      "text": "Top with the stuffing mix, drizzle with melted butter, and sprinkle with shredded Cheddar."
    },
    {
      "step": 6,
      "text": "Bake at 350°F until hot and set, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
