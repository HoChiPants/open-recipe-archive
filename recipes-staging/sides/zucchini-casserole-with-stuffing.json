  "id": "zucchini-casserole-with-stuffing",
  "name": "Zucchini Casserole with Stuffing",
  "subtitle": "A creamy vegetable casserole with a crisp stuffing topping.",
  "description": "Tender zucchini, carrots, and onion are combined with a creamy sauce, layered with buttered stuffing mix, and baked until golden.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 6,
      "unit": "cups",
      "preparation": "diced"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "dry-bread-stuffing-mix",
      "item": "dry bread stuffing mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "6 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Prepare the zucchini as needed, then simmer it in water for 5 minutes, until tender. Drain well.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Transfer the zucchini to a casserole dish. Whisk together the condensed cream of mushroom soup, sour cream, carrots, and onion, then pour the mixture over the zucchini."
    },
    {
      "step": 4,
      "text": "Combine the dry bread stuffing mix with the melted butter."
    },
    {
      "step": 5,
      "text": "Layer the buttered stuffing mixture over the zucchini mixture."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, until golden brown.",
      "timer_minutes": 20
    }
  ],
