  "id": "rosemary-potatoes-with-roasted-garlic",
  "name": "Rosemary Potatoes with Roasted Garlic",
  "subtitle": "Tender red potatoes baked with rosemary, butter, wine, and garlic",
  "description": "Red potatoes roast until tender while garlic softens and flavors the dish with rosemary, butter, wine, and olive oil.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
