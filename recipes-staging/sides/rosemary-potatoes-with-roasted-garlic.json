  "ingredients": [
    {
      "ingredient_id": "new-red-potatoes",
      "item": "new red potatoes",
      "quantity": 4,
      "unit": "pounds",
      "preparation": "cut into 1-inch pieces"
    },
    {
      "ingredient_id": "heads-garlic",
      "item": "heads garlic",
      "quantity": 2,
      "unit": "large",
      "preparation": "top third sliced off and discarded"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "cut into pieces"
    },
    {
      "ingredient_id": "sprigs-fresh-rosemary",
      "item": "sprigs fresh rosemary",
      "quantity": 3,
      "preparation": "chopped"
    },
