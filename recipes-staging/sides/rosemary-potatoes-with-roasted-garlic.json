      "item": "extra-virgin olive oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Transfer the cut potatoes to a baking dish and place the prepared garlic heads among them. Dot the potatoes and garlic with the butter."
    },
    {
      "step": 3,
      "text": "Add the chopped rosemary, white wine, and olive oil. Season with salt and black pepper."
    },
    {
      "step": 4,
      "text": "Bake for 45 minutes, until the potatoes are tender and the garlic is soft.",
      "timer_minutes": 45
    }
  ],
