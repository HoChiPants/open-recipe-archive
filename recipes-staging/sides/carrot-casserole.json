  "id": "carrot-casserole",
  "name": "Carrot Casserole",
  "subtitle": "Tender carrots in a creamy cheese sauce with a crisp crouton topping",
  "description": "A warm vegetable side dish combining tender carrots, creamy celery sauce, melted cheese, and buttery seasoned croutons.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 5,
      "unit": "cups",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
