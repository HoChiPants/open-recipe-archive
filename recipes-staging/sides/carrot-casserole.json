      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "condensed-cream-of-celery-soup",
      "item": "condensed cream of celery soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "processed-cheese",
      "item": "processed cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "seasoned-croutons",
      "item": "seasoned croutons",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Simmer the sliced carrots in water until tender, about 8 minutes. Drain well.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Melt the 3 tablespoons of butter in a saucepan. Add the onion, condensed celery soup, cubed cheese, salt, and pepper; stir until combined and the cheese melts."
    },
    {
      "step": 4,
      "text": "Fold the drained carrots into the sauce and transfer the mixture to a baking dish."
    },
    {
      "step": 5,
      "text": "Combine the melted butter with the seasoned croutons, then spread the topping over the casserole."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until hot throughout and lightly browned on top.",
      "timer_minutes": 30
    }
  ],
