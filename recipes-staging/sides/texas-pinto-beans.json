  "instructions": [
    {
      "step": 1,
      "text": "Rinse and sort the pinto beans, discarding any stones or damaged beans. Place them in a large pot with the chicken broth."
    },
    {
      "step": 2,
      "text": "Stir in the onion, jalapeño, garlic, green salsa, cumin, and black pepper."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a boil, then reduce the heat and simmer until the beans are tender, about 120 minutes. Add water if needed to keep the beans covered.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Check that the cooking liquid reaches 165°F before serving. Adjust the consistency with water if needed."
    }
  ],
