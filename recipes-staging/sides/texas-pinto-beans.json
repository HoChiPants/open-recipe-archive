  "id": "texas-pinto-beans",
  "name": "Texas Pinto Beans",
  "subtitle": "Tender pinto beans simmered with salsa, jalapeño, and warm spices",
  "description": "A savory Southwestern-style bean side dish with a lightly spicy, broth-rich base.",
  "meal_type": "side",
