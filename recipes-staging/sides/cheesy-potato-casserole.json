  "id": "cheesy-potato-casserole",
  "name": "Cheesy Potato Casserole",
  "subtitle": "A creamy, crunchy potato side for a crowd",
  "description": "Frozen hash brown potatoes are combined with a savory mushroom-sour cream sauce, Cheddar, and onion, then finished with buttery cereal for a crisp topping.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45,
    "inactive_minutes": 1440
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-hash-brown-potatoes",
      "item": "frozen hash brown potatoes",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 2,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1,
      "unit": "pint"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 2.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "crispy-rice-cereal-squares",
      "item": "crispy rice cereal squares",
      "quantity": 4.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.66666668653488,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Thaw the hash brown potatoes in the refrigerator for 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 2,
      "text": "Whisk together the mushroom soup, onion, sour cream, Cheddar, salt, and pepper until combined."
    },
    {
      "step": 3,
      "text": "Combine the thawed potatoes with the soup mixture and transfer to a baking dish."
    },
    {
      "step": 4,
      "text": "Melt the butter and combine it with the crispy rice cereal squares."
    },
    {
      "step": 5,
      "text": "Spread the cereal mixture over the potato mixture, cover, and refrigerate overnight."
    },
    {
      "step": 6,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 7,
      "text": "Bake for 45 minutes, until hot throughout and bubbling at the edges.",
      "timer_minutes": 45
    }
  ],
