  "id": "garlic-parmesan-oven-fries",
  "name": "Garlic-Parmesan Oven Fries",
  "subtitle": "Crisp, seasoned potato fries from the oven",
  "description": "Potato strips are coated with oil, Parmesan, and savory spices, then baked until browned and crisp.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "russet-potatoes",
      "item": "russet potatoes",
      "quantity": 3,
      "unit": "medium",
      "preparation": "or more to taste, sliced into even strips"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion-powder",
      "item": "onion powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 0.5,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Toss the sliced potatoes with the olive oil until evenly coated."
    },
    {
      "step": 3,
      "text": "Combine the Parmesan, garlic powder, onion powder, paprika, salt, and black pepper. Add the mixture to the potatoes and toss to coat."
    },
    {
      "step": 4,
      "text": "Transfer the potatoes to a baking sheet and spread them into an even layer."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Turn the fries and bake for 15 minutes more, until browned and tender.",
      "timer_minutes": 15
    }
  ],
