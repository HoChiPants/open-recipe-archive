{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "slow-cooker-green-bean-casserole",
  "name": "Slow Cooker Green Bean Casserole",
  "subtitle": "A creamy, crunchy side made with frozen green beans",
  "description": "Frozen green beans simmer with creamy soup, Parmesan, and seasonings, then finish with crisp fried onions.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 300
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-cut-green-beans",
      "item": "frozen cut green beans",
      "quantity": 2,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "cream-of-chicken-soup",
      "item": "cream of chicken soup",
      "quantity": 2,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "french-fried-onions",
      "item": "French-fried onions",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce, divided"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the green beans, soup, milk, Parmesan, salt, pepper, and half of the fried onions to a slow cooker. Stir until evenly combined."
    },
    {
      "step": 2,
      "text": "Cover and cook on the slow cooker setting for 5 hours, until hot throughout and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 300
    },
    {
      "step": 3,
      "text": "Top with the remaining fried onions and serve hot."
    }
  ],
