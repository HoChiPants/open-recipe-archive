{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "roasted-sweet-potatoes-and-onions",
  "name": "Roasted Sweet Potatoes and Onions",
  "subtitle": "Tender vegetables with thyme, amaretto, and toasted almonds",
  "description": "Sweet potatoes and onions roast until tender in a thyme-seasoned amaretto glaze, then receive a crisp almond finish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-potatoes",
      "item": "sweet potatoes",
      "quantity": 2,
      "unit": "large",
      "preparation": "peeled and cut in 1-inch chunks"
    },
    {
      "ingredient_id": "vidalia-or-other-sweet-onions",
      "item": "Vidalia or other sweet onions",
      "quantity": 2,
      "unit": "medium",
      "preparation": "cut in 1-inch chunks"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "amaretto-liqueur",
      "item": "amaretto liqueur",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper",
      "item": "Salt and freshly ground black pepper",
      "preparation": "to taste"
    },
    {
      "ingredient_id": "almonds",
      "item": "almonds",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "sliced, toasted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Place the sweet potatoes and onions in a roasting pan. Add the olive oil, amaretto, thyme, salt, and pepper, then toss to coat evenly."
    },
    {
      "step": 3,
      "text": "Roast for 30 minutes. Stir the vegetables, return the pan to the oven, and roast for 20 minutes more, until tender and lightly browned.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Scatter the toasted almonds over the roasted vegetables and serve warm."
    }
  ],
