  "id": "cauliflower-rice-stir-fry",
  "name": "Cauliflower Rice Stir-Fry",
  "subtitle": "A quick vegetable side with scrambled egg",
  "description": "Tender cauliflower rice is seasoned with garlic, ginger, and soy sauce, then combined with softly cooked egg for a savory side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "grated-fresh-ginger",
      "item": "grated fresh ginger",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "frozen-riced-cauliflower-medley",
      "item": "frozen riced cauliflower medley",
      "quantity": 2,
      "unit": "package",
      "preparation": "12 ounce"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "lightly beaten"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the sesame oil in a large skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the garlic and ginger; cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the frozen riced cauliflower medley and cook until tender, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the soy sauce and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Transfer the cauliflower mixture to a bowl. Add the beaten eggs to the skillet and stir until fully set, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Return the cauliflower mixture to the skillet and combine with the cooked eggs for 1 minute.",
      "timer_minutes": 1
    }
  ],
