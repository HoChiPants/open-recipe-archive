  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Microwave the yams for 20 minutes, or until tender. Transfer them to a bowl and whisk until smooth.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Whisk in the eggs, then stir in the first brown sugar, 2 tablespoons melted butter, salt, cinnamon, allspice, and nutmeg until combined."
    },
    {
      "step": 4,
      "text": "Transfer the yam mixture to a casserole dish and spread it evenly."
    },
    {
      "step": 5,
      "text": "Arrange the pecan halves over the surface. Stir the remaining brown sugar with the remaining melted butter and spoon the mixture over the pecans."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 25
    }
  ],
