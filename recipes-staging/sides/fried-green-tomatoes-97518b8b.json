  "id": "fried-green-tomatoes-97518b8b",
  "name": "Fried Green Tomatoes",
  "subtitle": "Crisp-coated green tomato slices",
  "description": "Tangy green tomatoes are seasoned, coated in flour and egg wash, and fried in butter until golden.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "green-tomatoes",
      "item": "green tomatoes",
      "quantity": 2,
      "unit": "large",
      "preparation": "sliced 1/3-inch thick"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sugar, salt, and pepper in a small bowl."
    },
    {
      "step": 2,
      "text": "Whisk the milk and eggs together in a second bowl. Place the flour in a shallow dish."
    },
    {
      "step": 3,
      "text": "Season the tomato slices, then coat each slice in flour, dip it in the egg mixture, and coat it again in flour."
    },
    {
      "step": 4,
      "text": "Melt the butter in a large skillet over medium heat, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Fry the coated tomato slices in batches until golden brown, turning once. Add butter as needed to keep the skillet coated."
    },
    {
      "step": 6,
      "text": "Transfer the fried tomatoes to a plate and serve hot."
    }
  ],
