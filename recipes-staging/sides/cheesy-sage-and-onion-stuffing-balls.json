  "id": "cheesy-sage-and-onion-stuffing-balls",
  "name": "Cheesy Sage and Onion Stuffing Balls",
  "subtitle": "Crisp, savory stuffing bites with sage and Parmesan",
  "description": "Soft breadcrumbs are combined with sautéed onion, leek, sage, Parmesan, egg, and nutmeg, then shaped and baked until golden and set.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil-plus-extra-for-the-baking-tray-and-drizzling",
      "item": "olive oil plus extra for the baking tray and drizzling",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "onion-finely-chopped",
      "item": "onion finely chopped",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "leek-sliced",
      "item": "leek sliced",
      "quantity": 1,
      "unit": "medium"
    },
    {
      "ingredient_id": "soft-breadcrumbs",
      "item": "soft breadcrumbs",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "bunch-of-sage-leaves-picked-and-finely-chopped",
      "item": "bunch of sage leaves picked and finely chopped",
      "quantity": "1/2",
      "unit": "small"
    },
    {
      "ingredient_id": "parmesan-finely-grated",
      "item": "parmesan finely grated",
      "quantity": 50,
      "unit": "g",
      "preparation": "plus extra to serve"
    },
    {
      "ingredient_id": "eggs-lightly-beaten",
      "item": "eggs lightly beaten",
      "quantity": 2
    },
    {
      "ingredient_id": "grating-of-nutmeg",
      "item": "grating of nutmeg"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a pan. Add the onion and cook for 10 minutes, stirring, until tender.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the leek and soft breadcrumbs. Cook for 10 minutes, then remove from the heat and cool.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Preheat the oven and oil a baking tray."
    },
    {
      "step": 4,
      "text": "Combine the cooled mixture with the sage, Parmesan, eggs, and nutmeg."
    },
    {
      "step": 5,
      "text": "Shape the mixture into balls and arrange them on the prepared tray. Drizzle with a little extra olive oil."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, or until golden and the centers are firm and reach 160°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Serve with extra grated Parmesan."
    }
  ],
