      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "sprigs-fresh-parsley",
      "item": "sprigs fresh parsley",
      "quantity": 2,
      "preparation": "or as desired"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Arrange the halved, seeded squash in a baking dish and add the water around it."
    },
    {
      "step": 2,
      "text": "Bake the squash for 60 minutes, or until tender.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Scoop the cooked squash from its skin and mash it. Whisk in the 0.75 cup sour cream, 0.5 cup butter, brown sugar, cinnamon, salt, and pepper until smooth."
    },
    {
      "step": 4,
      "text": "Whisk the 1 tablespoon sour cream with the parsley and spoon it over the mashed squash before serving."
    }
  ],
