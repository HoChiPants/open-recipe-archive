  "id": "mashed-butternut-squash",
  "name": "Mashed Butternut Squash",
  "subtitle": "Tender squash blended with butter, sour cream, and warm cinnamon",
  "description": "Roasted butternut squash is mashed until smooth, then enriched with butter and sour cream and finished with a lightly sweet cinnamon seasoning.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butternut-squash",
      "item": "butternut squash",
      "quantity": 2,
      "preparation": "halved and seeded"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
