  "id": "kno-del",
  "name": "Knödel",
  "subtitle": "Tender bread dumplings with onion and parsley",
  "description": "Toasted bread cubes are moistened with seasoned milk and egg, combined with sautéed onion and parsley, then shaped and cooked until set.",
  "meal_type": "side",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 70,
    "inactive_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "1-pound-loaf-white-bread",
      "item": "(1 pound) loaf white bread",
      "quantity": 0.5,
      "preparation": "toasted and cut into cubes"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large",
      "preparation": "beaten"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a skillet over medium heat. Add the onion and parsley, and cook until the onion softens."
    },
    {
      "step": 2,
      "text": "Place the toasted bread cubes in a large bowl. Whisk together the milk, beaten eggs, salt, and pepper, then pour over the bread."
    },
    {
      "step": 3,
      "text": "Add the onion mixture and gently combine. Let stand until the bread absorbs the liquid.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Shape the mixture into dumplings and transfer them to a pot of gently simmering water."
    },
    {
      "step": 5,
      "text": "Cook until the dumplings are firm throughout and the center reaches 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Let the cooked dumplings cool briefly before serving.",
      "timer_minutes": 10
    }
  ],
