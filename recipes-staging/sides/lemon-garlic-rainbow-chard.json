  "id": "lemon-garlic-rainbow-chard",
  "name": "Lemon-Garlic Rainbow Chard",
  "subtitle": "Tender sautéed greens with bright lemon and gentle heat",
  "description": "Rainbow chard is quickly sautéed with olive oil, garlic, and red pepper flakes, then finished with lemon juice.",
  "meal_type": "side",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "bunches-rainbow-chard",
      "item": "bunches rainbow chard",
      "quantity": 3,
      "preparation": "trimmed and rinsed"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 6,
      "unit": "cloves",
      "preparation": "sliced, or to taste"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Separate the chard leaves from the stems, then cut both into bite-size pieces."
    },
    {
      "step": 2,
      "text": "Warm the olive oil in a large skillet over medium heat."
    },
    {
      "step": 3,
      "text": "Add the chard, garlic, and red pepper flakes; toss to coat."
    },
    {
      "step": 4,
      "text": "Cook the garlic mixture for 3 minutes, stirring occasionally.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the chard and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir until the chard is tender, then finish with the lemon juice and serve."
    }
  ],
