  "id": "broccoli-souffle",
  "name": "Broccoli Soufflé",
  "subtitle": "A tender broccoli bake with creamy sauce and Cheddar",
  "description": "Thawed broccoli is folded into a rich milk-based sauce with eggs, onion, and mayonnaise, then baked until fully set and topped with melted Cheddar.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-chopped-broccoli",
      "item": "frozen chopped broccoli",
      "quantity": 1,
      "unit": "bag",
      "preparation": "14 ounce, thawed"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Bring water to a simmer, add the thawed broccoli, and cook until tender, about 4 minutes. Drain well.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Melt the margarine in a saucepan. Stir in the flour until combined, then whisk in the milk. Cook, stirring, until thickened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Combine the broccoli, mayonnaise, beaten eggs, chopped onion, and thickened sauce. Season with salt and ground black pepper."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to a baking dish and bake for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Sprinkle the Cheddar over the top and continue baking until the center is firm and reaches 160°F, about 15 minutes more.",
      "timer_minutes": 15
    }
  ],
