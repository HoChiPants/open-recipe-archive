  "id": "barbecued-parmesan-new-potatoes-with-garlic-and-thyme",
  "name": "Barbecued Parmesan New Potatoes with Garlic and Thyme",
  "subtitle": "Tender potatoes with a crisp, savory cheese topping",
  "description": "Parboiled new potatoes are finished on the barbecue with garlic, thyme, oil, and grated parmesan.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
