  ],
  "instructions": [
    {
      "step": 1,
      "text": "Simmer the new potatoes in water for 15 minutes, until nearly tender. Drain well.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Preheat the barbecue to medium heat. Halve the potatoes and toss them with the oil, garlic, and thyme."
    },
    {
      "step": 3,
      "text": "Transfer the potatoes to a suitable barbecue pan or foil tray and cook for 20 minutes, turning occasionally.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Scatter over the grated parmesan and cook for a further 20 minutes, until the potatoes are tender and the cheese is browned.",
      "timer_minutes": 20
    }
  ],
