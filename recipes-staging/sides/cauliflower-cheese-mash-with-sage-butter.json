  "instructions": [
    {
      "step": 1,
      "text": "Cook the cauliflower until very tender, about 10 minutes, then drain well.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Blend the cauliflower until smooth. Add the crème fraîche and parmesan, then blend again until fully combined."
    },
    {
      "step": 3,
      "text": "Melt the salted butter in a small pan. Add the sage leaves and cook until the butter is fragrant and lightly browned."
    },
    {
      "step": 4,
      "text": "Transfer the mash to a serving dish and spoon the sage butter and leaves over the top."
    }
