  "id": "braised-spring-onions-with-peas",
  "name": "Braised Spring Onions with Peas",
  "subtitle": "Tender spring onions finished with mint, feta, and lemon",
  "description": "Spring onions are gently braised in mustard-seasoned stock, then finished with peas, herbs, feta, and lemon for a bright vegetable side.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
