  "instructions": [
    {
      "step": 1,
      "text": "Heat the butter and olive oil in a wide pan. Add the trimmed spring onions and cook until beginning to soften.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the vegetable stock and Dijon mustard, then bring to a gentle simmer."
    },
    {
      "step": 3,
      "text": "Cover and simmer until the onions are nearly tender.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the frozen peas and continue cooking until the onions are tender and the peas are heated through.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Finish with the chopped mint, lemon zest and juice, and crumbled feta. Serve warm with the remaining lemon juice if desired."
    }
  ],
