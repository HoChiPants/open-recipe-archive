  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the onion and garlic; cook, stirring, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the bell pepper, cayenne, salt, and black pepper. Cook until the pepper is tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the cumin and dry mustard, stirring to coat the vegetables."
    },
    {
      "step": 5,
      "text": "Stir in the kidney beans and corn with their liquids. Bring to a gentle simmer, then cook until heated through and the flavors combine.",
      "timer_minutes": 20
    }
