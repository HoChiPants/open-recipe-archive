  "id": "air-fryer-brussels-sprouts",
  "name": "Air-Fryer Brussels Sprouts",
  "subtitle": "Crisp-edged sprouts with simple savory seasoning",
  "description": "Brussels sprouts are coated with olive oil and pantry spices, then air-fried until browned and tender.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
