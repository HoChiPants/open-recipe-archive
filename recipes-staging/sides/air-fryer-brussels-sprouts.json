    "cook_minutes": 15,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "brussels-sprouts",
      "item": "Brussels sprouts",
      "quantity": 1.5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 390°F.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Trim the Brussels sprouts and cut them in half."
    },
    {
      "step": 3,
      "text": "Transfer the sprouts to a bowl. Add the olive oil, garlic powder, salt, and pepper, and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Place the seasoned sprouts in the air-fryer basket in an even layer."
    },
    {
      "step": 5,
      "text": "Air-fry for 15 minutes, or until browned and tender.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
