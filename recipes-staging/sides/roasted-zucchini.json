  "id": "roasted-zucchini",
  "name": "Roasted Zucchini",
  "subtitle": "Tender zucchini with lemon and parsley",
  "description": "Zucchini strips are seasoned, roasted until golden, and finished with lemon, parsley, and flaky salt.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into 2-inch strips"
    },
    {
      "ingredient_id": "grapeseed-oil",
      "item": "grapeseed oil",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "serving-cooking-spray",
      "item": "serving cooking spray",
      "quantity": 1
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 0.5
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "sea-salt-flakes-to-taste",
      "item": "sea salt flakes to taste",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Toss the zucchini with the grapeseed oil, salt and ground black pepper, garlic powder, and cayenne pepper until evenly coated."
    },
    {
      "step": 3,
      "text": "Coat a baking sheet with the serving cooking spray and arrange the zucchini in a single layer."
    },
    {
      "step": 4,
      "text": "Roast until golden brown, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Finish with the lemon, fresh parsley, and sea salt flakes. Adjust with the remaining salt and ground black pepper to taste."
    }
  ],
