  "instructions": [
    {
      "step": 1,
      "text": "Boil the Brussels sprouts with salt in water until tender, about 15 minutes. Drain well.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium heat. Add the mushrooms and cook until lightly browned."
    },
    {
      "step": 3,
      "text": "Add the Brussels sprouts, parsley, lemon juice, and pepper. Toss gently to combine and adjust seasoning."
    },
    {
      "step": 4,
      "text": "Serve warm."
    }
