  "id": "roasted-smashed-potatoes",
  "name": "Roasted Smashed Potatoes",
  "subtitle": "Crisp-edged potatoes with garlic and herbs",
  "description": "Boiled potatoes are chilled, gently smashed, and roasted with herb-infused butter until golden and crisp.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60,
    "inactive_minutes": 490
  },
  "ingredients": [
    {
      "ingredient_id": "medium-yellow-potatoes",
      "item": "medium yellow potatoes",
      "quantity": 3.5,
      "unit": "pounds",
      "preparation": "washed"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "thickly sliced"
    },
    {
      "ingredient_id": "sprigs-fresh-rosemary",
      "item": "sprigs fresh rosemary",
      "quantity": 4,
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "sprigs-fresh-thyme",
      "item": "sprigs fresh thyme",
      "quantity": 4,
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes in a large pot, cover with water, and add the kosher salt and some black pepper. Bring to a boil, then cook until tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Drain the potatoes and let them cool completely. Transfer them to a covered container and refrigerate for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Melt the butter with the sliced garlic, rosemary, and thyme over medium heat for 5 minutes. Remove the herbs and reserve the butter and garlic separately.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Heat the oven to 450°F. Arrange the chilled potatoes on a baking sheet and press each one until thickly smashed. Season with salt, pepper, and cayenne, then spoon over the butter."
    },
    {
      "step": 5,
      "text": "Roast until the potatoes are crisp and browned, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Warm the reserved butter and stir in the garlic for about 4 minutes, until golden brown.",
      "timer_minutes": 4
    },
    {
      "step": 7,
      "text": "Transfer the roasted potatoes to a serving platter and top with the golden garlic and butter."
    }
  ],
