  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the sweet potato chunks in simmering water until tender, about 20 minutes. Drain well.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Transfer the sweet potatoes to a mixing bowl and mash with the white sugar, milk, beaten eggs, salt, vanilla extract, and cinnamon. Spread the mixture in a baking dish."
    },
    {
      "step": 4,
      "text": "Combine the brown sugar, pecans, and flour. Stir in the melted margarine, then scatter the topping over the sweet potato mixture."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until the topping is browned and the center is firm and fully set, reaching 160°F on a food thermometer.",
      "timer_minutes": 60
    }
  ],
