  "id": "sweet-potato-casserole-with-pecans",
  "name": "Sweet Potato Casserole with Pecans",
  "subtitle": "Creamy sweet potatoes with a crisp pecan topping",
  "description": "Mashed sweet potatoes are blended with warm spices and a lightly sweetened egg mixture, then baked beneath a pecan-flour topping.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
