  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a skillet over medium heat and warm the soy sauce with it."
    },
    {
      "step": 2,
      "text": "Add the sliced mushrooms and sauté until tender."
    },
    {
      "step": 3,
      "text": "Stir in the flour, then gradually add the milk and continue stirring until smooth."
    },
    {
      "step": 4,
      "text": "Cook until the sauce thickens, then season with salt and pepper to taste and serve warm."
    }
