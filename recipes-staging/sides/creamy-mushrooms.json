  "id": "creamy-mushrooms",
  "name": "Creamy Mushrooms",
  "subtitle": "Tender mushrooms in a simple cream sauce",
  "description": "Sautéed mushrooms are folded into a thick, savory milk-based sauce for an easy side dish.",
  "meal_type": "side",
  "cuisine": "American",
