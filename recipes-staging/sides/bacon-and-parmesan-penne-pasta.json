    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "dry-penne-pasta",
      "item": "dry penne pasta",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "pound",
      "preparation": "coarsely chopped"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer. Add the dry penne pasta and cook for 11 minutes, or until tender.",
      "timer_minutes": 11
    },
    {
      "step": 2,
      "text": "While the pasta cooks, preheat a skillet over medium heat. Add the bacon and onion and cook for 10 minutes, until the bacon is cooked and the onion is softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Transfer the cooked pasta to the skillet and stir in the olive oil."
    },
    {
      "step": 4,
      "text": "Add the bacon and onion, then stir in the grated Parmesan cheese until combined."
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
