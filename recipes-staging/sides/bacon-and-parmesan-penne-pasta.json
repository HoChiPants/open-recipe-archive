  "id": "bacon-and-parmesan-penne-pasta",
  "name": "Bacon and Parmesan Penne Pasta",
  "subtitle": "A savory pasta side with crisp bacon and Parmesan",
  "description": "Penne is combined with sautéed bacon and onion, olive oil, and Parmesan for a simple, savory side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
