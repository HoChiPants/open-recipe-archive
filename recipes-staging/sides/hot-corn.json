  "id": "hot-corn",
  "name": "Hot Corn",
  "subtitle": "Creamy baked corn with jalapeño and cheddar",
  "description": "A warm, cheesy corn casserole with a mild jalapeño kick, ready for a family-style side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
