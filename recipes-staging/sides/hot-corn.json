      "ingredient_id": "12-ounce-jar-jalapeno-peppers",
      "item": "(12 ounce) jar jalapeno peppers",
      "quantity": 1,
      "preparation": "drained and diced"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Warm the cream cheese, butter, milk, and Cheddar in a saucepan, stirring until smooth."
    },
    {
      "step": 3,
      "text": "Combine the drained corn and diced jalapeños with the cheese mixture, then whisk until evenly blended."
    },
    {
      "step": 4,
      "text": "Transfer to a baking dish and bake until hot and bubbling, about 35 minutes.",
      "timer_minutes": 35
    }
  ],
