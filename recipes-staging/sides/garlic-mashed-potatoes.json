  "id": "garlic-mashed-potatoes",
  "name": "Garlic Mashed Potatoes",
  "subtitle": "Creamy potatoes with Romano and oregano",
  "description": "A savory mashed potato side combining tender red potatoes with butter, Romano cheese, garlic, and herbs.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 100,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "unpeeled-red-potatoes",
      "item": "unpeeled red potatoes",
      "quantity": 50,
      "unit": "pounds",
      "preparation": "quartered"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 8,
      "unit": "pounds",
      "preparation": "room temperature"
    },
    {
      "ingredient_id": "romano-cheese",
      "item": "Romano cheese",
      "quantity": 3,
      "unit": "pounds",
      "preparation": "grated"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of water seasoned with the salt to a simmer."
    },
    {
      "step": 2,
      "text": "Add the quartered potatoes and simmer for 45 minutes, or until tender.",
      "timer_minutes": 45
    },
    {
      "step": 3,
      "text": "Drain the potatoes thoroughly and return them to the pot."
    },
    {
      "step": 4,
      "text": "Add the room-temperature butter, Romano cheese, garlic, remaining salt, and oregano; stir until evenly combined and mashed."
    },
    {
      "step": 5,
      "text": "Transfer to a serving dish and serve hot."
    }
  ],
