  "id": "baked-acorn-squash",
  "name": "Baked Acorn Squash",
  "subtitle": "Tender squash with a simple brown sugar butter topping",
  "description": "A warm, lightly sweet side dish of baked acorn squash.",
  "meal_type": "side",
  "cuisine": "American",
