    {
      "ingredient_id": "acorn-squash",
      "item": "acorn squash",
      "quantity": 1,
      "unit": "medium",
      "preparation": "halved and seeded"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the squash halves cut-side down in a baking dish and bake until beginning to soften.",
      "timer_minutes": 45
    },
    {
      "step": 3,
      "text": "Turn the squash cut-side up. Divide the brown sugar and butter between the centers."
    },
    {
      "step": 4,
      "text": "Bake until the squash is very tender and the topping is melted.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
