  "id": "roasted-melting-potatoes",
  "name": "Roasted Melting Potatoes",
  "subtitle": "Crisp-edged potatoes with a tender center",
  "description": "Thick potato slices roast in seasoned butter, then finish with broth and garlic for a tender, flavorful side.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
