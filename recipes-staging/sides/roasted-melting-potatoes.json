  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 500°F."
    },
    {
      "step": 2,
      "text": "Stir the melted butter with the thyme, salt, and pepper. Coat the potato slices in the seasoned butter."
    },
    {
      "step": 3,
      "text": "Arrange the potatoes in a single layer in a roasting pan or baking dish."
    },
    {
      "step": 4,
      "text": "Roast for 15 minutes, then turn the potatoes and roast for 15 minutes more.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Pour in the vegetable broth and add the garlic. Continue roasting until the potatoes are tender, about 15 minutes.",
      "timer_minutes": 15
    }
  ],
