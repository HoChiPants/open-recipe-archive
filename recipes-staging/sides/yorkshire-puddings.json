  "id": "yorkshire-puddings",
  "name": "Yorkshire Puddings",
  "subtitle": "Crisp, airy British roast-dinner puddings",
  "description": "A simple egg batter baked in hot oil until risen, golden, and crisp around the edges.",
  "meal_type": "side",
  "cuisine": "British",
  "yield": {
    "quantity": 8,
    "unit": "large puds or 24 small"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "plain-flour-this-is-about-200ml-7fl-oz",
      "item": "plain flour (this is about 200ml/7fl oz)",
      "quantity": 140,
      "unit": "g"
    },
    {
      "ingredient_id": "eggs-200ml-7fl-oz",
      "item": "eggs (200ml/7fl oz)",
      "quantity": 4
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "sunflower-oil-for-cooking",
      "item": "sunflower oil for cooking"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Add a little sunflower oil to each well of a suitable pudding or muffin tin, then place the tin in the oven to heat until the oil is very hot."
    },
    {
      "step": 2,
      "text": "Whisk the flour and eggs together until smooth. Gradually whisk in the milk to make a pourable batter."
    },
    {
      "step": 3,
      "text": "Carefully remove the hot tin and divide the batter among the oiled wells."
    },
    {
      "step": 4,
      "text": "Return the tin to the oven and bake until the puddings are well risen and golden, about 20 minutes. Keep the oven closed during baking.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Serve immediately. Cool any extras completely, freeze them in a sealed container, and reheat until hot before serving."
    }
  ],
  "tags": [
