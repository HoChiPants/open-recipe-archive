  "id": "fried-onion-rings",
  "name": "Fried Onion Rings",
  "subtitle": "Crisp battered onion rings",
  "description": "Sliced onions are dipped in a seasoned beer batter, fried until golden, and drained for a crisp side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying",
      "quantity": 1,
      "unit": "quart"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "beer",
      "item": "beer",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 4,
      "preparation": "peeled and sliced into rings"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil to 365°F in a deep, heavy pot or fryer."
    },
    {
      "step": 2,
      "text": "Whisk the flour, beer, salt, and pepper together until the batter is smooth. Let it stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Dip the onion rings into the batter, turning to coat them evenly."
    },
    {
      "step": 4,
      "text": "Fry the rings in batches until golden brown, turning as needed for even cooking."
    },
    {
      "step": 5,
      "text": "Transfer the onion rings to a draining rack or paper towels and serve hot."
    }
  ],
