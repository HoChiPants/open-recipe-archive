  "instructions": [
    {
      "step": 1,
      "text": "Slice the scallions. Whisk the eggs, flour, water, 1 tablespoon soy sauce, 2 teaspoons sesame oil, pepper, and part of the divided salt until smooth."
    },
    {
      "step": 2,
      "text": "Fold in the cabbage, grated carrot, and scallions until evenly coated."
    },
    {
      "step": 3,
      "text": "Heat the 1/4 cup sesame oil in a skillet over medium heat. Add the cabbage mixture in pancake portions and cook until golden brown, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Continue cooking until the centers are firm and fully set, reaching 160°F. Drain briefly, then season with the remaining divided salt."
    },
    {
      "step": 5,
      "text": "Stir together the mayonnaise and 1 tablespoon Sriracha. In a separate bowl, whisk the remaining soy sauce with the honey, rice vinegar, 1 teaspoon Sriracha, and 1 teaspoon sesame oil."
    },
    {
      "step": 6,
      "text": "Serve the pancakes with the sauces, garnished with scallions and Sriracha."
    }
  ],
