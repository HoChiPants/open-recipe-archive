  "id": "slow-cooker-cheesy-hash-brown-potatoes",
  "name": "Slow Cooker Cheesy Hash Brown Potatoes",
  "subtitle": "Creamy, golden potatoes with melted Cheddar",
  "description": "Frozen hash browns cook slowly with buttery soup, sour cream, and Cheddar for a rich, comforting side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
