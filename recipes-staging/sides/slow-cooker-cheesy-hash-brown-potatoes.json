    "cook_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-shredded-hash-brown-potatoes",
      "item": "frozen shredded hash brown potatoes",
      "quantity": 1,
      "unit": "package",
      "preparation": "30 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 2,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the frozen hash brown potatoes in a slow cooker and pour the melted butter over them."
    },
    {
      "step": 2,
      "text": "Whisk the condensed soup with the sour cream, then add the mixture and shredded Cheddar to the slow cooker. Stir to combine."
    },
    {
      "step": 3,
      "text": "Cover and cook on the slow-cooker setting for 4 hours, stirring once after 2 hours, until hot throughout and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 240
    }
  ],
