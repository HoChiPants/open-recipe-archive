  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil and butter in a large skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the onion, carrots, and garlic; stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the cabbage, shredded coconut, curry powder, and coconut milk. Stir to combine."
    },
    {
      "step": 4,
      "text": "Cook, stirring occasionally, until the cabbage is tender, about 9 minutes. Season with salt and pepper.",
      "timer_minutes": 9
    },
    {
      "step": 5,
      "text": "Stir in the tomato, green onions, and cilantro, then serve."
