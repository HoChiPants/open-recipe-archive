  "id": "brown-buttered-winter-vegetables",
  "name": "Brown-Buttered Winter Vegetables",
  "subtitle": "Tender seasonal vegetables with sage butter",
  "description": "Carrots, Brussels sprouts, and leeks are gently cooked, then finished with browned butter and optional sage.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "carrots-thickly-sliced",
      "item": "carrots thickly sliced",
      "quantity": 3,
      "preparation": "at an angle"
    },
    {
      "ingredient_id": "brussels-sprouts-trimmed-and-halved",
      "item": "brussels sprouts trimmed and halved",
      "quantity": 300,
      "unit": "g",
      "preparation": "if they’re large"
    },
    {
      "ingredient_id": "leeks-trimmed-and-thickly-sliced",
      "item": "leeks trimmed and thickly sliced",
      "quantity": 2,
      "preparation": "at an angle"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "handful-sage-leaves-optional",
      "item": "handful sage leaves (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the carrots, Brussels sprouts, and leeks to a large pan and cook for 3 minutes, stirring occasionally.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Cover and simmer the vegetables for 5 minutes, or until just tender.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the butter and optional sage leaves, cooking until the butter is golden and nutty."
    },
    {
      "step": 4,
      "text": "Transfer the browned butter over the vegetables and stir to coat."
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
