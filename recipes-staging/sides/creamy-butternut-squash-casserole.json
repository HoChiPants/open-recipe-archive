      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "unit": "small",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "2-1-2-pound-butternut-squash",
      "item": "(2 1/2 pound) butternut squash",
      "quantity": 1,
      "preparation": "peeled, seeded, and cubed"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
