      "ingredient_id": "coarsely-shredded-mozzarella-cheese",
      "item": "coarsely shredded mozzarella cheese",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "8 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large ovenproof skillet or sauté pan. Add the onions and cook until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the cubed squash, crushed garlic, and salt. Cook until the squash begins to become tender, about 10 minutes, adding the water if the pan becomes dry.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Transfer the squash mixture to a bowl. Whisk the eggs, sour cream, Parmesan, basil, black pepper, and mozzarella until combined."
    },
    {
      "step": 5,
      "text": "Fold the squash into the egg mixture and transfer it to a baking dish. Sprinkle with the remaining Parmesan and mozzarella."
    },
    {
      "step": 6,
      "text": "Bake until the squash is tender and the center is fully set, about 30 minutes. For food safety, confirm the center reaches 160°F with a thermometer before serving.",
      "timer_minutes": 30
    }
  ],
