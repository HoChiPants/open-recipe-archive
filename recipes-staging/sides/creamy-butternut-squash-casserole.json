  "id": "creamy-butternut-squash-casserole",
  "name": "Creamy Butternut Squash Casserole",
  "subtitle": "Tender squash baked with eggs, cream, herbs, and melted cheese",
  "description": "Sautéed butternut squash is folded into a savory egg and sour cream mixture, then baked until tender and lightly browned.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 50
  },
  "ingredients": [
