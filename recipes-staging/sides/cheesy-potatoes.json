  "id": "cheesy-potatoes",
  "name": "Cheesy Potatoes",
  "subtitle": "A creamy hash brown casserole with a crisp potato-chip topping.",
  "description": "Frozen hash browns bake with potato soup, sour cream, and Cheddar under a buttery, crunchy topping.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-southern-style-hash-brown-potatoes",
      "item": "frozen Southern-style hash brown potatoes",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "condensed-cream-of-potato-soup",
      "item": "condensed cream of potato soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "16-ounce-container-sour-cream",
      "item": "(16 ounce) container sour cream",
      "quantity": 1
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce, shredded"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "potato-chips",
      "item": "potato chips",
      "quantity": 1,
      "unit": "cup",
      "preparation": "crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the frozen hash browns, condensed soup, and sour cream until evenly coated. Fold in half of the Cheddar cheese."
    },
    {
      "step": 3,
      "text": "Combine the remaining Cheddar cheese with the melted butter and crushed potato chips."
    },
    {
      "step": 4,
      "text": "Spread the hash brown mixture in a baking dish and distribute the cheese, butter, and chip mixture over the top."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until hot throughout and lightly browned.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Let the casserole rest for 15 minutes before serving.",
      "timer_minutes": 15
    }
  ],
