  "instructions": [
    {
      "step": 1,
      "text": "Bring the water and lentils to a boil in a saucepan."
    },
    {
      "step": 2,
      "text": "Reduce the heat and simmer for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Stir in the potato, red bell pepper, onion, garlic, salt, ground black pepper, and green onion."
