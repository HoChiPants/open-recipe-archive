{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "comte-rosemary-shortbread",
  "name": "Comté Rosemary Shortbread",
  "subtitle": "Savory cheese biscuits with fragrant rosemary",
  "description": "Tender, crisp shortbread enriched with finely grated Comté and fresh rosemary.",
  "meal_type": "side",
  "yield": {
    "quantity": 28,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 18
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-cut-into-cubes",
      "item": "unsalted butter cut into cubes",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "plain-flour-plus-extra-for-dusting",
      "item": "plain flour plus extra for dusting",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "rosemary-sprigs-leaves-picked-and-finely-chopped",
      "item": "rosemary sprigs leaves picked and finely chopped",
      "quantity": 3
    },
    {
      "ingredient_id": "comte-cheese-finely-grated",
      "item": "comté cheese finely grated",
      "quantity": 130,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a baking sheet with parchment."
    },
    {
      "step": 2,
      "text": "Rub the cubed butter into the plain flour and cornflour until the mixture resembles fine crumbs."
    },
    {
      "step": 3,
      "text": "Mix in the chopped rosemary and grated Comté to form a cohesive dough."
    },
    {
      "step": 4,
      "text": "Shape the dough into a log, wrap it, and chill for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Dust the work surface with extra flour. Slice the chilled dough into about 28 even rounds and arrange them on the prepared sheet."
    },
    {
      "step": 6,
      "text": "Bake for 18 minutes, or until golden brown.",
      "timer_minutes": 18
    },
    {
      "step": 7,
      "text": "Cool on the baking sheet before serving or storing."
    }
  ],
  "tags": [
