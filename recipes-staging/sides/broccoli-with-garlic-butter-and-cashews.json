  "instructions": [
    {
      "step": 1,
      "text": "Transfer the broccoli to a pot of simmering water and cook until tender, about 7 minutes. Drain well.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Warm the butter in a skillet over medium heat."
    },
    {
      "step": 3,
      "text": "Stir in the brown sugar, soy sauce, vinegar, black pepper, and garlic; heat until combined."
    },
    {
      "step": 4,
      "text": "Add the broccoli and cashews, tossing until evenly coated and hot."
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
