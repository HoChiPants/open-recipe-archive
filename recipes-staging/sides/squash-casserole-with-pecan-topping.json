  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Place the halved, seeded squash cut-side down in a baking dish and bake for 50 minutes, until tender. Let it cool enough to handle, then scoop out the flesh.",
      "timer_minutes": 50
    },
    {
      "step": 2,
      "text": "Reduce the oven temperature to 350°F. Mash or whisk the squash flesh until smooth. Add the eggs, white sugar, half-and-half, vanilla extract, and salt; mix until evenly combined."
    },
    {
      "step": 3,
      "text": "Combine the softened butter, brown sugar, and flour, then stir in the chopped pecans to make the topping."
    },
    {
      "step": 4,
      "text": "Spread the squash mixture in a baking dish and scatter the pecan topping evenly over it."
    },
    {
      "step": 5,
      "text": "Bake at 350°F for 40 minutes, until the center is fully set; an egg-based casserole should reach 160°F in the center. Serve warm.",
      "timer_minutes": 40
    }
  ],
