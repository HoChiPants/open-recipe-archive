  "id": "squash-casserole-with-pecan-topping",
  "name": "Squash Casserole with Pecan Topping",
  "subtitle": "Tender baked squash with a buttery, nutty finish",
  "description": "Roasted acorn squash is folded into a lightly sweet egg custard and baked beneath a crisp pecan topping.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
