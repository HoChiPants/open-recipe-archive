  "id": "ajwain-puri",
  "name": "Ajwain Puri",
  "subtitle": "Crisp, seed-seasoned Indian fried bread",
  "description": "A simple Indian side made from chapatti flour and ajwain or cumin seeds, shaped and fried until golden.",
  "meal_type": "side",
  "cuisine": "Indian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "chapatti-flour",
      "item": "chapatti flour",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "ajwain-or-cumin-seeds",
      "item": "ajwain or cumin seeds",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "sunflower-oil-for-deep-frying",
      "item": "sunflower oil for deep-frying"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the chapatti flour and ajwain or cumin seeds."
    },
    {
      "step": 2,
      "text": "Knead the mixture into a dough for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Shape the dough into small puris."
    },
    {
      "step": 4,
      "text": "Preheat the sunflower oil for deep-frying."
    },
    {
      "step": 5,
      "text": "Fry the puris for about 1 minute, turning as needed, until golden brown.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
