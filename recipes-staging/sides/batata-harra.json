  "id": "batata-harra",
  "name": "Batata Harra",
  "subtitle": "Crisp potatoes with garlic, chili, lemon, and coriander",
  "description": "Tender potatoes are roasted until crisp, then finished with garlicky chili, lemon, and fresh coriander.",
  "meal_type": "side",
  "cuisine": "Lebanese",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "baking-potatoes-roughly-1kg",
      "item": "baking potatoes (roughly 1kg)",
      "quantity": "3-4",
      "unit": "large",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "olive-oil-or-use-vegetable-oil",
      "item": "olive oil (or use vegetable oil)",
      "quantity": 6,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-cloves-crushed",
      "item": "garlic cloves crushed",
      "quantity": 4
    },
    {
      "ingredient_id": "red-chilli-paste",
      "item": "red chilli paste",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "handful-of-coriander-chopped",
      "item": "handful of coriander chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the peeled potatoes into bite-size pieces. Cook them in boiling water for 8 minutes, then drain and let them steam-dry for 5 minutes.",
      "timer_minutes": 13
    },
    {
      "step": 2,
      "text": "Preheat the oven and prepare a roasting pan with the olive oil."
    },
    {
      "step": 3,
      "text": "Add the potatoes to the pan and roast for about 40 minutes, turning once, until tender and crisp.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "Warm the garlic in the roasting pan for 2 minutes, stir in the red chilli paste, and coat the potatoes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Finish with the lemon juice and chopped coriander, then serve hot."
    }
  ],
