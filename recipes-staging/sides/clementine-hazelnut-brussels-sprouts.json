      "item": "butter",
      "quantity": 25,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Simmer the Brussels sprouts for 6 minutes, until tender, then drain well.",
      "timer_minutes": 6
    },
    {
      "step": 2,
      "text": "Prepare the hazelnuts while the sprouts drain."
    },
    {
      "step": 3,
      "text": "Heat the oil with the shallot for 8 minutes, stirring occasionally.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Add the butter and stir until melted. Add the sprouts and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Stir in the hazelnuts, clementine zest, and juice, then serve."
    }
  ],
