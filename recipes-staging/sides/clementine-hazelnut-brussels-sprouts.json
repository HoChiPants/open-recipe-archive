    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "brussels-sprouts-trimmed",
      "item": "brussels sprouts trimmed",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "hazelnuts-roughly-chopped",
      "item": "hazelnuts roughly chopped",
      "quantity": 65,
      "unit": "g"
    },
    {
      "ingredient_id": "vegetable-or-sunflower-oil",
      "item": "vegetable or sunflower oil",
      "quantity": "1/2",
      "unit": "tbsp"
    },
    {
