  "id": "clementine-hazelnut-brussels-sprouts",
  "name": "Clementine-Hazelnut Brussels Sprouts",
  "subtitle": "Tender sprouts with citrus, butter, and toasted hazelnuts",
  "description": "A bright, nutty Brussels sprouts side dish finished with clementine zest and juice.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
