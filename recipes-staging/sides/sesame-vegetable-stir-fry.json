  "instructions": [
    {
      "step": 1,
      "text": "Cut the broccoli into bite-size florets. Bring water to a boil and blanch the broccoli and snow peas for 1 minute; drain well.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Heat the sesame oil and sesame seeds in a large skillet or wok over medium-high heat."
    },
    {
      "step": 3,
      "text": "Add the broccoli, snow peas, onion, bell pepper, and garlic. Stir-fry briefly to combine and heat the vegetables.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the soy sauce and continue stirring until the vegetables are coated and crisp-tender.",
      "timer_minutes": 1
    }
  ],
