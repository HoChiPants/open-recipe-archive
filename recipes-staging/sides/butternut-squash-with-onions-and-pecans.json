    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "diced"
    },
    {
      "ingredient_id": "butternut-squash",
      "item": "butternut squash",
      "quantity": 2.25,
      "unit": "pounds"
    },
    {
      "ingredient_id": "pecans",
