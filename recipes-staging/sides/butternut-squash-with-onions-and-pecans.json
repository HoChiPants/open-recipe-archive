      "item": "fresh parsley",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Spread the chopped pecans on a baking sheet and toast for 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Peel and cut the butternut squash into bite-size pieces."
    },
    {
      "step": 3,
      "text": "Melt the butter in a large skillet over medium heat. Add the diced onion and cook for 15 minutes, stirring occasionally, until tender.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Add the squash and stir to coat with the butter. Cook for about 15 minutes, stirring occasionally, until tender.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Season with salt and pepper. Transfer to a serving dish and sprinkle with the toasted pecans and chopped parsley."
    }
  ],
