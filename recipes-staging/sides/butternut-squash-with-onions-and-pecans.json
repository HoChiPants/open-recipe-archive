  "id": "butternut-squash-with-onions-and-pecans",
  "name": "Butternut Squash with Onions and Pecans",
  "subtitle": "Tender squash finished with toasted pecans and parsley",
  "description": "Butternut squash is cooked with softened onion, then topped with toasted pecans and fresh parsley for a savory, nutty side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
