  "instructions": [
    {
      "step": 1,
      "text": "Heat the butter and olive oil in a skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the sliced garlic and cook until lightly browned."
    },
    {
      "step": 3,
      "text": "Stir in the green beans, salt, and pepper."
    },
    {
      "step": 4,
      "text": "Cook until the beans are tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir in the Parmesan and warm briefly before serving."
    }
