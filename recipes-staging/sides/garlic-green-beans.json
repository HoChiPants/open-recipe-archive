  "id": "garlic-green-beans",
  "name": "Garlic Green Beans",
  "subtitle": "Tender green beans with garlic, butter, and Parmesan",
  "description": "Canned green beans are warmed with browned garlic, butter, olive oil, and a savory Parmesan finish.",
  "meal_type": "side",
