  "instructions": [
    {
      "step": 1,
      "text": "Blend the fresh basil leaves, Parmesan cheese, 0.25 cup pine nuts, 0.25 cup olive oil, lemon juice, garlic, and grated Parmesan cheese until combined."
    },
    {
      "step": 2,
      "text": "Cook the mini penne pasta in boiling water for 11 minutes, then drain and transfer to a bowl. Toss with enough of the divided olive oil to coat.",
      "timer_minutes": 11
    },
    {
      "step": 3,
      "text": "Preheat the remaining divided olive oil in a skillet over medium heat. Add the remaining pine nuts and cook for 2 minutes, stirring, until lightly browned.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the asparagus, zucchini, Kalamata olives, roasted red pepper, and sun-dried tomatoes. Stir for 7 minutes, until the vegetables are tender.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Combine the pasta, vegetables, and pesto. Serve with Parmesan cheese and grated Parmesan cheese."
    }
