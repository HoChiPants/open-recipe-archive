  "id": "cheesy-green-vegetable-gratin",
  "name": "Cheesy Green Vegetable Gratin",
  "subtitle": "Tender green vegetables in a cheddar sauce",
  "description": "Cauliflower, purple sprouting broccoli, and spinach are folded into a mustard-cheddar sauce, topped with reserved cauliflower leaves, and baked until bubbling and golden.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "cauliflower-450g",
      "item": "cauliflower (450g)",
      "quantity": 1,
      "preparation": "broken into florets, leaves reserved"
    },
    {
      "ingredient_id": "purple-sprouting-broccoli",
      "item": "purple sprouting broccoli",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "spinach",
      "item": "spinach",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 70,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 70,
      "unit": "g"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 900,
      "unit": "ml"
    },
    {
      "ingredient_id": "english-mustard",
      "item": "English mustard",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "mature-cheddar",
      "item": "mature cheddar",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "bunch-of-chives-finely-chopped",
      "item": "bunch of chives finely chopped",
      "quantity": "1/2"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Simmer the cauliflower florets for 3 minutes, add the broccoli, and cook for 2 minutes more. Drain well.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Cook the spinach for 4 minutes, then drain and squeeze out excess moisture.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Preheat the oven."
    },
    {
      "step": 4,
      "text": "Melt the butter, stir in the flour, and cook until a thick paste forms."
    },
    {
      "step": 5,
      "text": "Gradually whisk in the milk and cook, stirring, until the sauce thickens.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Whisk in the mustard, cheddar, and chives."
    },
    {
      "step": 7,
      "text": "Arrange the cauliflower and broccoli in a baking dish, add the spinach, and pour over the sauce. Scatter the reserved cauliflower leaves over the top."
    },
    {
      "step": 8,
      "text": "Bake for 30 minutes, until bubbling and golden.",
      "timer_minutes": 30
    }
  ],
