  "id": "three-cheese-garlic-scalloped-potatoes",
  "name": "Three-Cheese Garlic Scalloped Potatoes",
  "subtitle": "Creamy layered potatoes with garlic and melted cheese",
  "description": "Thinly sliced Yukon Gold potatoes bake in seasoned garlic cream beneath layers of Cheddar, provolone, and Parmesan or Romano.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "yukon-gold-potatoes",
      "item": "Yukon Gold potatoes",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "pint"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "slices-provolone-cheese",
      "item": "slices provolone cheese",
      "quantity": 4
    },
    {
      "ingredient_id": "grated-parmesan-or-romano-cheese",
      "item": "grated Parmesan or Romano cheese",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Grease a baking dish with half of the butter."
    },
    {
      "step": 2,
      "text": "Arrange the potato slices in the dish, seasoning lightly with salt and pepper between layers. Pour the cream over them and distribute the sliced garlic throughout."
    },
    {
      "step": 3,
      "text": "Layer the Cheddar, provolone slices, and Parmesan or Romano over the potatoes. Dot the top with the remaining butter."
    },
    {
      "step": 4,
      "text": "Bake for 30 minutes, then check the potatoes for tenderness. Continue baking for about 30 minutes, until the potatoes are tender and the cheese is browned and bubbling.",
      "timer_minutes": 60
    }
  ],
