  "instructions": [
    {
      "step": 1,
      "text": "Combine the cabbage, carrot, onion, bell pepper, jalapeño, cilantro, cayenne, and salt and pepper in a large bowl."
    },
    {
      "step": 2,
      "text": "Whisk the canola oil, apple cider vinegar, sugar, cayenne, and salt and pepper until blended."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the vegetables and toss thoroughly to coat."
    },
