  "id": "slow-cooker-spaghetti-squash",
  "name": "Slow Cooker Spaghetti Squash",
  "subtitle": "Tender strands with minimal hands-on work",
  "description": "Cook a whole spaghetti squash in a slow cooker, then separate the tender flesh into strands for an easy side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
