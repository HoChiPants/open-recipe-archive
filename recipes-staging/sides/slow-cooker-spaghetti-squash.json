    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "spaghetti-squash",
      "item": "spaghetti squash",
      "quantity": 1,
      "unit": "whole",
      "preparation": "washed thoroughly"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the washed spaghetti squash in a slow cooker and pour the water around it."
    },
    {
      "step": 2,
      "text": "Cover and cook until the squash is tender when pierced, about 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 3,
      "text": "Transfer the squash to a work surface and let it rest until cool enough to handle.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Halve the squash lengthwise and remove the seeds."
    },
    {
      "step": 5,
      "text": "Use a fork to pull the flesh into strands and serve."
    }
  ],
