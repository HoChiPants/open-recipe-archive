    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Wash and dry the potatoes, then cut each into even wedges."
    },
    {
      "step": 2,
      "text": "Combine the olive oil, minced garlic, salt, black pepper, onion powder, and paprika. Toss the potato wedges in the seasoned oil until evenly coated."
    },
    {
      "step": 3,
      "text": "Arrange the wedges in a single layer on a baking sheet."
    },
    {
      "step": 4,
      "text": "Bake for 20 minutes, turn the wedges, and continue baking until tender inside and browned at the edges, about 25 minutes more.",
      "timer_minutes": 45
    }
  ],
