  "id": "cajun-potato-wedges",
  "name": "Cajun Potato Wedges",
  "subtitle": "Crisp, seasoned wedges with garlic and paprika",
  "description": "Oven-baked potato wedges coated in olive oil, garlic, and warm Cajun-style spices.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
