  "id": "zucchini-cornbread-casserole",
  "name": "Zucchini Cornbread Casserole",
  "subtitle": "A savory baked side with tender zucchini and a cheesy cornbread topping",
  "description": "Shredded zucchini and onion combine with corn muffin mix, eggs, seasonings, and Cheddar for a simple golden casserole.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 4,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "dry-corn-muffin-mix",
      "item": "dry corn muffin mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "8.5 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Mix the zucchini, onion, corn muffin mix, beaten eggs, salt, and pepper until combined."
    },
    {
      "step": 3,
      "text": "Stir most of the Cheddar into the mixture, reserving some for the top."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared dish and scatter the reserved Cheddar over it."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until lightly browned and the center is firm and reaches 160°F.",
      "timer_minutes": 60
    }
  ],
