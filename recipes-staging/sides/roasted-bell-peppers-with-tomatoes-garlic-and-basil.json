  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Lightly coat a baking dish with the cooking spray."
    },
    {
      "step": 2,
      "text": "Arrange the pepper halves in the dish, cut side up. Divide the tomatoes, basil, and garlic among them, then season with the salt and black pepper."
    },
    {
      "step": 3,
      "text": "Bake for 15 minutes. Drizzle with the herb vinegar and continue baking until the peppers are tender and the filling is hot, about 15 minutes more.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Serve warm."
    }
  ],
