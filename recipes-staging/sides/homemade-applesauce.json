  "id": "homemade-applesauce",
  "name": "Homemade Applesauce",
  "subtitle": "A simple cinnamon-sweetened fruit side",
  "description": "Tender chopped apples cooked with water, sugar, and cinnamon until soft, then cooled for serving.",
  "meal_type": "side",
