      "item": "sunflower or olive oil",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the potatoes into evenly sized pieces. Simmer for 5 minutes, then drain well.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Prepare the drained potatoes for air frying and add the oil, coating the pieces evenly."
    },
    {
      "step": 3,
      "text": "Cook in the air fryer for 30 minutes, shaking or turning as needed for even browning.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Continue cooking for 10 minutes, or until the potatoes are cooked through and crisp.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Prepare for serving while hot."
    }
