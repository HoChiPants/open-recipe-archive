  "id": "belgian-endive-au-gratin",
  "name": "Belgian Endive au Gratin",
  "subtitle": "Tender endive wrapped in ham with a nutmeg cheese sauce",
  "description": "Belgian endive is simmered until tender, wrapped in ham, covered with creamy cheese sauce, and baked until browned.",
  "meal_type": "side",
  "cuisine": "Belgian",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "heads-belgian-endive",
      "item": "heads Belgian endive",
      "quantity": 8,
      "preparation": "trimmed"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-gruyere-cheese",
      "item": "grated Gruyere cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "or amount to taste"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "slices-deli-style-ham",
      "item": "slices deli-style ham",
      "quantity": 8
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven for baking the gratin."
    },
    {
      "step": 2,
      "text": "Bring salted water to a boil, add the trimmed Belgian endive, and cook for 10 minutes, or until tender. Drain well.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Melt the butter in a saucepan. Whisk in the flour and cook until golden brown, then gradually whisk in the milk until thickened."
    },
    {
      "step": 4,
      "text": "Stir in the divided Gruyere, Parmesan, nutmeg, and remaining salt and pepper until combined. Cook the sauce for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Cut the endive as needed, wrap each portion in a slice of ham, and transfer to a baking dish."
    },
    {
      "step": 6,
      "text": "Pour the cheese sauce over the wrapped endive. Top with the remaining Gruyere and Parmesan and sprinkle with parsley."
    },
    {
      "step": 7,
      "text": "Bake until the topping is golden brown and the gratin is heated through.",
      "timer_minutes": 10
    }
  ],
