  "instructions": [
    {
      "step": 1,
      "text": "Rinse the rice, then combine it with the coconut milk and enough water to cook it according to the rice package directions. Simmer until tender, about 12 minutes, then drain if needed and let it steam briefly.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "While the rice cooks, heat the butter and coconut oil in a large skillet over medium heat. Add the onion, garlic, spring onion, red pepper, shredded Brussels sprouts, thyme, and coconut; cook until the vegetables begin to soften and the coconut is lightly toasted.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Stir in the peas and sweetcorn, then add the cooked rice and soy sauce. Toss until hot and evenly combined.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Serve topped with the chopped parsley and pomegranate seeds."
    }
  ],
