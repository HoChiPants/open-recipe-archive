  "id": "baked-red-onions-with-ricotta",
  "name": "Baked Red Onions with Ricotta",
  "subtitle": "Tender roasted onions with herbed butter and creamy ricotta",
  "description": "Slow-baked red onions are finished with oregano-garlic butter, nigella seeds, ricotta, and crusty bread.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 105
  },
  "ingredients": [
    {
      "ingredient_id": "red-onions-halved",
      "item": "red onions halved",
      "quantity": 6,
      "unit": "medium"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "salted-butter-cut-into-cubes",
      "item": "salted butter cut into cubes",
      "quantity": 85,
      "unit": "g"
    },
    {
      "ingredient_id": "oregano-sprigs",
      "item": "oregano sprigs",
      "quantity": 10,
      "unit": "g"
    },
    {
      "ingredient_id": "garlic-cloves-finely-grated",
      "item": "garlic cloves finely grated",
      "quantity": 3
    },
    {
      "ingredient_id": "nigella-seeds",
      "item": "nigella seeds",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ricotta",
      "item": "ricotta",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "crusty-bread-to-serve",
      "item": "crusty bread to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Arrange the halved onions in a baking dish, cut sides up. Drizzle with the olive oil, dot with the butter, season with salt, and tuck in the oregano sprigs."
    },
    {
      "step": 2,
      "text": "Cover the dish and bake for 60 minutes, until the onions are tender. Uncover and continue baking until deeply softened and browned, about 45 minutes.",
      "timer_minutes": 105
    },
    {
      "step": 3,
      "text": "Warm the remaining butter in a small pan with the oregano, grated garlic, and nigella seeds. Cook for 3 minutes, until fragrant.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Spread the ricotta on a serving platter and spoon the baked onions and their buttery juices over it. Serve with the crusty bread."
    }
  ],
