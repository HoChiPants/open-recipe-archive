  "id": "carrot-and-swede-mash-with-thyme-butter",
  "name": "Carrot and Swede Mash with Thyme Butter",
  "subtitle": "A tender root-vegetable mash finished with fragrant browned butter.",
  "description": "Carrots and swede are cooked until soft, mashed, and enriched with thyme-scented brown butter for a simple savory side.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "thyme-sprigs-leaves-picked",
      "item": "thyme sprigs leaves picked",
      "quantity": 3
    },
    {
      "ingredient_id": "carrots-peeled-and-roughly-chopped",
      "item": "carrots peeled and roughly chopped",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "swede-around-600g",
      "item": "swede (around 600g)",
      "quantity": 1,
      "unit": "medium",
      "preparation": "peeled and roughly chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the butter with the thyme leaves in a small pan over medium heat until fragrant and lightly browned."
    },
    {
      "step": 2,
      "text": "Place the carrots and swede in a saucepan, cover with water, and bring to a gentle simmer."
    },
    {
      "step": 3,
      "text": "Cook until the vegetables are tender when pierced with a knife.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "Drain the vegetables thoroughly and mash until mostly smooth."
    },
    {
      "step": 5,
      "text": "Stir the browned thyme butter through the mash and serve warm."
    }
  ],
