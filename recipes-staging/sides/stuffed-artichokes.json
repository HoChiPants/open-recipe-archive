  "id": "stuffed-artichokes",
  "name": "Stuffed Artichokes",
  "subtitle": "Tender artichokes with a savory bread-and-cheese filling",
  "description": "Artichokes are filled with seasoned bread, herbs, garlic, and Romano cheese, then baked until tender.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "artichokes",
      "item": "artichokes",
      "quantity": 6,
      "unit": "whole"
    },
    {
      "ingredient_id": "slices-italian-bread",
      "item": "slices Italian bread",
      "quantity": 3,
      "preparation": "cubed"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 0.125,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "grated-romano-cheese",
      "item": "grated Romano cheese",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 5,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Trim the artichoke stems and cut about 1 inch from the tops. Spread the leaves gently to make room for filling."
    },
    {
      "step": 2,
      "text": "Combine the cubed bread, garlic, parsley, Romano, oregano, salt, pepper, and 3 tablespoons of the oil."
    },
    {
      "step": 3,
      "text": "Divide the filling among the artichokes, tucking it between the leaves and into the centers. Arrange them upright in a baking dish and drizzle with the remaining oil."
    },
    {
      "step": 4,
      "text": "Cover the dish and bake for 45 minutes. Uncover and continue baking until the artichoke leaves pull away easily and the filling is lightly browned, about 15 minutes more.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Let stand briefly, then serve warm."
    }
  ],
