{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "tomato-zucchini-squash-skillet",
  "name": "Tomato Zucchini Squash Skillet",
  "subtitle": "A buttery mix of tender summer vegetables",
  "description": "Zucchini, yellow squash, onion, and tomatoes cook together in one skillet for a simple savory side.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "salted butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "vidalia-onion",
      "item": "Vidalia onion",
      "quantity": 1,
      "preparation": "cut into bite-size pieces"
    },
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 2,
      "preparation": "cut into bite-size pieces"
    },
    {
      "ingredient_id": "yellow-squash",
      "item": "yellow squash",
      "quantity": 1,
      "preparation": "cut into bite-size pieces"
    },
    {
      "ingredient_id": "roma-plum-tomatoes",
      "item": "roma (plum) tomatoes",
      "quantity": 4,
      "preparation": "cut into bite-size pieces"
    },
    {
      "ingredient_id": "kosher-salt-and-freshly-ground-black-pepper-to-taste",
      "item": "kosher salt and freshly ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm a large skillet over medium heat and add the butter."
    },
    {
      "step": 2,
      "text": "Add the onion and cook, stirring occasionally, until the butter is melted and the onion has softened, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Stir in the zucchini and yellow squash. Cook until the vegetables are tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Fold in the tomatoes, then season with kosher salt and freshly ground black pepper to taste. Serve warm."
    }
  ],
