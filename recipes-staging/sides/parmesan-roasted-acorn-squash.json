  "id": "parmesan-roasted-acorn-squash",
  "name": "Parmesan-Roasted Acorn Squash",
  "subtitle": "Tender squash with a crisp, savory cheese topping",
  "description": "Acorn squash slices are seasoned with thyme, Parmesan, olive oil, salt, and pepper, then roasted until golden brown.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
