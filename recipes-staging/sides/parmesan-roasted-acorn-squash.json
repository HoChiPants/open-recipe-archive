      "item": "kosher salt",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Arrange the squash slices on a baking sheet. Toss or brush with olive oil, then season evenly with Parmesan, thyme, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Roast until the squash is tender and golden brown, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Serve warm."
    }
  ],
