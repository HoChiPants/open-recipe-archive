  "ingredients": [
    {
      "ingredient_id": "2-pound-acorn-squash",
      "item": "(2 pound) acorn squash",
      "quantity": 1,
      "preparation": "halved lengthwise, seeded, and cut into 3/4-inch slices"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sprigs-fresh-thyme",
      "item": "sprigs fresh thyme",
      "quantity": 8
    },
    {
