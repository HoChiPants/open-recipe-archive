  "id": "cheese-and-pickle-scones",
  "name": "Cheese and Pickle Scones",
  "subtitle": "Savory scones with tangy pickle and cheese",
  "description": "Tender savory scones combining sharp cheese, chopped pickles, and a lightly enriched dough.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 350,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "salted-butter-cold",
      "item": "salted butter cold",
      "quantity": 60,
      "unit": "g",
      "preparation": "cut into cubes"
    },
    {
      "ingredient_id": "buttermilk-plus-a-little-extra-for-brushing",
      "item": "buttermilk plus a little extra for brushing",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "egg-beaten",
      "item": "egg beaten",
      "quantity": 1
    },
    {
      "ingredient_id": "pickles-finely-chopped-with-1-tbsp-of-the-brine",
      "item": "pickles finely chopped with 1 tbsp of the brine",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "red-leicester-cheese-or-vegetarian-alternative",
      "item": "red leicester cheese (or vegetarian alternative)",
      "quantity": 125,
      "unit": "g",
      "preparation": "cut into small cubes"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Combine the self-raising flour and baking powder. Rub in the cold butter until the mixture resembles coarse crumbs."
    },
    {
      "step": 3,
      "text": "Stir in the pickles, brine, and cubed cheese."
    },
    {
      "step": 4,
      "text": "Add the buttermilk and mix just until a soft dough forms. Knead briefly on a lightly floured surface."
    },
    {
      "step": 5,
      "text": "Pat the dough into a thick round and cut it into 8 portions. Rest for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Brush the tops with beaten egg and transfer the scones to the prepared sheet."
    },
    {
      "step": 7,
      "text": "Bake for 25 minutes, until golden, the center is firm, and the center reaches 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 8,
      "text": "Serve warm."
    }
  ],
