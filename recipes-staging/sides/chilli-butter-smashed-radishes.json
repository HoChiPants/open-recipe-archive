  "id": "chilli-butter-smashed-radishes",
  "name": "Chilli-Butter Smashed Radishes",
  "subtitle": "Tender radishes with warm chilli butter and lemon",
  "description": "Smashed radishes are cooked in golden chilli butter until tender, then finished with lemon juice.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "(as a side)"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "chilli-flakes-optional",
      "item": "chilli flakes",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "radishes-leaves-removed",
      "item": "radishes leaves removed",
      "quantity": 500,
      "unit": "g",
      "preparation": "smashed with the flat edge of a knife (or halved/quartered if you find this hard to do)"
    },
    {
      "ingredient_id": "2-lemon-juiced",
      "item": "⁄2 lemon juiced",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large skillet over medium heat. Stir in the chilli flakes and cook until the butter turns golden brown."
    },
    {
      "step": 2,
      "text": "Add the smashed radishes and toss to coat. Cook for 15 minutes, turning occasionally, until tender.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Remove from the heat and stir in the lemon juice. Serve warm."
    }
  ],
