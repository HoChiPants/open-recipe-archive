  "instructions": [
    {
      "step": 1,
      "text": "Stir the warm water, sugar, and yeast together. Let stand for 5 minutes, until foamy.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mix in the 2 tablespoons olive oil, 1/4 cup minced rosemary, flour, salt, and salt and pepper until a dough forms."
    },
    {
      "step": 3,
      "text": "Knead the dough on a lightly floured surface for 10 minutes, until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Knead in the pitted black olives until evenly distributed."
    },
    {
      "step": 5,
      "text": "Transfer the dough to an oiled bowl, cover, and let rise for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 7,
      "text": "Oil a baking pan with the 3 tablespoons olive oil and place the dough in the pan, pressing it out evenly."
    },
    {
      "step": 8,
      "text": "Arrange the sliced tomatoes over the dough. Sprinkle with minced garlic, 2 tablespoons minced rosemary, salt and pepper, and grated Parmesan or Romano cheese."
    },
    {
      "step": 9,
      "text": "Bake for about 15 minutes, until golden brown.",
      "timer_minutes": 15
    },
    {
      "step": 10,
      "text": "Let the focaccia rest for 20 minutes, then cut into portions.",
      "timer_minutes": 20
    }
  ],
