  "id": "mashed-parsnips-turnips-and-carrots",
  "name": "Mashed Parsnips, Turnips, and Carrots",
  "subtitle": "A creamy mash of sweet and earthy root vegetables",
  "description": "Tender carrots, parsnips, and turnips are mashed with butter, cream, nutmeg, and a touch of cayenne for a smooth savory side dish.",
  "meal_type": "side",
  "cuisine": "American",
