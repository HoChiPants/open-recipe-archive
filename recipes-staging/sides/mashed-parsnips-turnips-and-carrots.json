  "instructions": [
    {
      "step": 1,
      "text": "Place the carrots, parsnips, turnips, and salt and ground black pepper in a pot."
    },
    {
      "step": 2,
      "text": "Simmer for 25 minutes, or until the vegetables are tender.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Drain the vegetables well."
    },
    {
      "step": 4,
      "text": "Combine the butter, heavy whipping cream, nutmeg, and cayenne in the pot."
    },
    {
      "step": 5,
      "text": "Return the vegetables to the pot and mash with the cream mixture until smooth. Adjust the seasoning to taste."
    }
