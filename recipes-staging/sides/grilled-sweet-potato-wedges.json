  "id": "grilled-sweet-potato-wedges",
  "name": "Grilled Sweet Potato Wedges",
  "subtitle": "Smoky-spiced wedges with a gentle cinnamon heat",
  "description": "Sweet potato wedges are coated in seasoned olive oil and grilled until browned outside and tender inside.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-potatoes",
      "item": "sweet potatoes",
      "quantity": 2,
      "unit": "medium"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "smoked-paprika",
      "item": "smoked paprika",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill to medium-high heat. Scrub the sweet potatoes and cut them lengthwise into even wedges."
    },
    {
      "step": 2,
      "text": "Combine the smoked paprika, salt, garlic powder, cinnamon, and cayenne with most of the olive oil. Toss the wedges in the seasoned oil."
    },
    {
      "step": 3,
      "text": "Brush the grill grates with the remaining olive oil, then arrange the wedges in a single layer. Grill, turning occasionally, until browned and tender, about 18 minutes.",
      "timer_minutes": 18
    },
    {
      "step": 4,
      "text": "Transfer the wedges to a serving dish and let them stand for 2 minutes before serving.",
      "timer_minutes": 2
    }
  ],
