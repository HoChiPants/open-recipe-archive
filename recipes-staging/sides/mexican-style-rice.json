  "id": "mexican-style-rice",
  "name": "Mexican-Style Rice",
  "subtitle": "Tomato-seasoned rice with peas, carrots, and cilantro",
  "description": "Toast long-grain rice with aromatics, then simmer it with tomato, spices, broth, and thawed vegetables until tender.",
  "meal_type": "side",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 6,
