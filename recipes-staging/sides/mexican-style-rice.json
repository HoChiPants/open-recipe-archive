  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the vegetable oil in a saucepan over medium heat. Add the rice and cook, stirring, for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Add the minced onion and cook for 2 minutes. Stir in the garlic and cook for 1 minute.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the broth, tomato, cumin, saffron, salt, and pepper. Stir to combine."
    },
    {
      "step": 4,
      "text": "Cover and simmer for 20 minutes, or until the rice is tender and the liquid is absorbed. Verify with a food thermometer that the finished dish reaches 165°F.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Fold in the thawed peas and carrots, then garnish with the cilantro sprig."
    }
  ],
