  "id": "cacik",
  "name": "Cacik",
  "subtitle": "Cool yogurt and cucumber side",
  "description": "A refreshing blend of thick yogurt, cucumber, lemon, garlic, olive oil, and mint.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
