    {
      "ingredient_id": "garlic-cloves-crushed",
      "item": "garlic cloves crushed",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare the yogurt until thick and smooth."
    },
    {
      "step": 2,
      "text": "Stir together the lemon juice, olive oil, and dried mint."
    },
    {
      "step": 3,
      "text": "Peel or finely chop the cucumber, then combine it with the crushed garlic."
    },
    {
      "step": 4,
      "text": "Add the cucumber mixture and seasoned oil to the yogurt, and stir until evenly combined."
    },
    {
      "step": 5,
      "text": "Garnish with olive oil and extra dried mint before serving."
    }
  ],
