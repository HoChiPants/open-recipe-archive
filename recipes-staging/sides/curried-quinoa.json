  "id": "curried-quinoa",
  "name": "Curried Quinoa",
  "subtitle": "Spiced quinoa cooked with aromatics and savory broth",
  "description": "A warmly seasoned quinoa side dish with onion, garlic, curry powder, and ancho chile.",
  "meal_type": "side",
  "cuisine": "Indian",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "diced"
    },
    {
