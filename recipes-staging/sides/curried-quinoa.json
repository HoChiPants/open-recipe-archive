      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "quinoa",
      "item": "quinoa",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "curry-powder",
      "item": "curry powder",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "ancho-chile-powder",
      "item": "ancho chile powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a saucepan over medium heat. Add the onion and garlic; cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Stir in the quinoa and toast for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the chicken broth, curry powder, and ancho chile powder. Bring to a simmer."
    },
    {
      "step": 4,
      "text": "Cover and simmer for 25 minutes, or until the quinoa is tender and the liquid is absorbed. If the broth contains poultry pieces, verify they reach 165°F.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Season with salt and pepper to taste, then serve."
    }
  ],
