      "item": "onion",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "processed-cheese",
      "item": "processed cheese",
      "quantity": 0.66699999570847,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Bring a pot of water to a boil, add the sliced carrots, and cook for 10 minutes, or until tender. Drain well.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Combine the crushed crackers with the melted margarine and set aside."
    },
    {
      "step": 3,
      "text": "Warm the remaining melted margarine with the onion in a saucepan until the onion is tender. Stir in the flour, salt, and pepper, then cook briefly."
    },
    {
      "step": 4,
      "text": "Gradually add the milk, stirring until the sauce thickens. Stir in the shredded processed cheese until smooth."
    },
    {
      "step": 5,
      "text": "Fold the carrots into the cheese sauce and transfer the mixture to a baking dish. Sprinkle evenly with the cracker mixture."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, until golden brown and heated through.",
      "timer_minutes": 20
    }
  ],
