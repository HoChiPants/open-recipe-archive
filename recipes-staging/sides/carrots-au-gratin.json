  "id": "carrots-au-gratin",
  "name": "Carrots Au Gratin",
  "subtitle": "Tender carrots in a creamy cheese sauce with a crisp cracker topping",
  "description": "A warm baked side dish combining tender carrots, savory cheese sauce, and buttery crushed crackers.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 4.5,
      "unit": "cups",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "buttery-round-crackers",
      "item": "buttery round crackers",
      "quantity": 0.66699999570847,
      "unit": "cup",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
