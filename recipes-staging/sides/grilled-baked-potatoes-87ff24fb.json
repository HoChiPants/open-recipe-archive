  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill."
    },
    {
      "step": 2,
      "text": "Simmer the potato quarters until nearly tender, about 10 minutes, then drain well.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Toss the potatoes with the olive oil, pepper, garlic powder, rosemary, and salt until evenly coated."
    },
    {
      "step": 4,
      "text": "Grill the potatoes for about 15 minutes, turning as needed, until tender and lightly browned.",
