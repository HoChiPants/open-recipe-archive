{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "caramelized-brussels-sprouts-with-pistachios",
  "name": "Caramelized Brussels Sprouts with Pistachios",
  "subtitle": "Tender sprouts with tangy caramelized onions and a crisp nut topping",
  "description": "Brussels sprouts are simmered until tender, then finished in butter with red onions, vinegar, and sugar before being topped with pistachios.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "brussels-sprouts",
      "item": "Brussels sprouts",
      "quantity": 4,
      "unit": "pounds"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "red-onions",
      "item": "red onions",
      "quantity": 4,
      "unit": "small",
      "preparation": "cut into strips"
    },
    {
      "ingredient_id": "red-wine-vinegar",
      "item": "red wine vinegar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "coarsely-chopped-pistachios",
      "item": "coarsely chopped pistachios",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of salted water to a simmer. Add the Brussels sprouts and cook until tender, about 10 minutes. Drain well.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat."
    },
    {
      "step": 3,
      "text": "Add the red onions and red wine vinegar; stir until the onions soften and the vinegar reduces slightly."
    },
    {
      "step": 4,
      "text": "Add the drained sprouts and sugar. Toss and cook until the vegetables are browned and lightly caramelized, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Season with salt and pepper to taste."
    },
    {
      "step": 6,
      "text": "Transfer to a serving dish and scatter the pistachios over the top."
    }
  ],
