  "id": "boiled-potatoes-with-chives",
  "name": "Boiled Potatoes with Chives",
  "subtitle": "Tender potatoes finished with butter and fresh herbs",
  "description": "Small red potatoes are boiled until tender, then cut and tossed with softened butter, chives, salt, and pepper.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "very-small-red-potatoes",
      "item": "very small red potatoes",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "scrubbed"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "finely-chopped-fresh-chives",
      "item": "finely chopped fresh chives",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the scrubbed potatoes in a pot and cover them with water. Season the water with some of the salt and pepper."
    },
    {
      "step": 2,
      "text": "Bring to a boil, then reduce the heat and simmer until the potatoes are tender when pierced, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Drain the potatoes and let them cool for 2 minutes, or until easy to handle.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Cut the potatoes into bite-size pieces and toss with the softened butter and chives. Adjust the salt and pepper before serving."
    }
  ],
