{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "french-potato-bacon-and-cheese-casserole",
  "name": "French Potato, Bacon, and Cheese Casserole",
  "subtitle": "A rich layered bake with tender potatoes, smoky bacon, and melting cheese.",
  "description": "Par-cooked potatoes are layered with bacon, softened onions, crème fraîche, and washed-rind cheese, then baked until tender and bubbling.",
  "meal_type": "side",
  "cuisine": "French",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "whole-russet-potatoes",
      "item": "whole russet potatoes",
      "quantity": 3,
      "unit": "pounds"
    },
    {
      "ingredient_id": "thick-cut-bacon",
      "item": "thick cut bacon",
      "quantity": 12,
      "unit": "ounces",
      "preparation": "cut into 1/2-inch pieces"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "unit": "large",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "dry-white-wine",
      "item": "dry white wine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "creme-fraiche",
      "item": "creme fraiche",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "16-ounce-round-reblochon-cheese-or-other-ripe",
      "item": "(16 ounce) round Reblochon cheese or other ripe",
      "quantity": 1,
      "preparation": "washed rind cheese"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the potatoes in salted water until nearly tender, about 25 minutes. Drain and let cool enough to handle.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 3,
      "text": "Cook the bacon in a skillet for about 7 minutes, then transfer it to a plate. Cook the onions in the bacon fat with the butter until softened, about 6 minutes. Season with the salt, black pepper, and cayenne.",
      "timer_minutes": 13
    },
    {
      "step": 4,
      "text": "Add the wine to the onions and cook for 2 minutes. Remove from the heat.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Peel and slice the cooled potatoes. Cut the cheese in half horizontally, then divide each half into pieces."
    },
    {
      "step": 6,
      "text": "Layer the potatoes, bacon, and onion mixture in a baking dish. Spoon the crème fraîche over the layers and arrange the cheese on top."
    },
    {
      "step": 7,
      "text": "Bake until the potatoes are tender and the cheese is melted and bubbling, about 50 minutes.",
      "timer_minutes": 50
    }
  ],
