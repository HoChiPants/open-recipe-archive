  "id": "air-fryer-patatas-bravas",
  "name": "Air Fryer Patatas Bravas",
  "subtitle": "Crisp potatoes with smoky tomato sauce",
  "description": "Golden air-fried potatoes are served with a quick paprika-spiced tomato sauce and fresh basil.",
  "meal_type": "side",
  "cuisine": "Spanish",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
