  "instructions": [
    {
      "step": 1,
      "text": "Drain the potatoes thoroughly and leave them to dry for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Preheat the air fryer according to its instructions. Toss the potatoes with 2 tablespoons of the olive oil, add them to the basket, and cook until crisp and tender, shaking occasionally.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Meanwhile, heat the remaining olive oil in a pan. Cook the onion until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the garlic and smoked paprika, then add the tomato purée and chopped tomatoes. Cook until the sauce thickens.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer the potatoes to the sauce and toss to coat. Serve with the basil leaves."
    }
  ],
