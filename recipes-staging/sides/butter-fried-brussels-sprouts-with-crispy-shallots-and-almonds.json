  "id": "butter-fried-brussels-sprouts-with-crispy-shallots-and-almonds",
  "name": "Butter-Fried Brussels Sprouts with Crispy Shallots and Almonds",
  "subtitle": "Golden sprouts with crisp shallots and toasted almonds",
  "description": "Halved Brussels sprouts are cooked in butter and finished with crisp shallots, garlic, and slivered almonds.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "sunflower-oil",
      "item": "sunflower oil",
      "quantity": 50,
      "unit": "ml"
    },
    {
      "ingredient_id": "shallots-peeled-and-sliced-into-thin-rings",
      "item": "shallots peeled and sliced into thin rings",
      "quantity": 4,
      "unit": "small"
    },
    {
      "ingredient_id": "garlic-cloves-finely-sliced",
      "item": "garlic cloves finely sliced",
      "quantity": 2
    },
    {
      "ingredient_id": "slivered-almonds",
      "item": "slivered almonds",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "cold-butter-cut-into-cubes",
      "item": "cold butter cut into cubes",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "brussels-sprouts-halved",
      "item": "brussels sprouts halved",
      "quantity": 500,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the sunflower oil in a large skillet over medium heat. Add the shallots and cook for about 10 minutes, stirring occasionally, until crisp and golden. Transfer them to a plate, leaving the oil in the skillet.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the garlic and slivered almonds to the skillet and cook for 5 minutes, stirring frequently, until the garlic is lightly golden and the almonds are toasted. Transfer them to the plate with the shallots.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the cold butter and halved Brussels sprouts to the skillet. Stir and cook for 10 minutes, turning the sprouts occasionally, until tender and browned.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Return the shallots, garlic, and almonds to the skillet. Stir everything together and serve hot."
    }
  ],
