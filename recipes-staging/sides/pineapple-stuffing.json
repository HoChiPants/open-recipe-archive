  "id": "pineapple-stuffing",
  "name": "Pineapple Stuffing",
  "subtitle": "A sweet, buttery baked side with crushed pineapple",
  "description": "Cubed white bread combines with pineapple, eggs, sugar, and butter for a golden baked side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter-or-margarine",
      "item": "butter or margarine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "pineapple",
      "item": "pineapple",
      "quantity": 1,
      "unit": "can",
      "preparation": "20 ounce, crushed, drained"
    },
    {
      "ingredient_id": "slices-white-bread",
      "item": "slices white bread",
      "quantity": 5,
      "preparation": "cubed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the sugar and butter or margarine, then whisk until smooth."
    },
    {
      "step": 3,
      "text": "Whisk in the eggs, crushed drained pineapple, and cubed bread until evenly combined."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish."
    },
    {
      "step": 5,
      "text": "Bake at 350°F until golden brown and the center is fully set, about 50 minutes.",
      "timer_minutes": 50
    }
  ],
