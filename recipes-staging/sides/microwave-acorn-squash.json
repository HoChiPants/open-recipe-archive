  "ingredients": [
    {
      "ingredient_id": "1-pound-acorn-squash",
      "item": "(1 pound) acorn squash",
      "quantity": 2,
      "preparation": "halved and seeded"
    },
    {
      "ingredient_id": "butter",
      "item": "salted butter",
      "quantity": 4,
      "unit": "teaspoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 4,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Arrange the halved, seeded squash cut-side up in a microwave-safe dish."
    },
    {
      "step": 2,
      "text": "Divide the melted butter and brown sugar among the squash halves."
    },
    {
      "step": 3,
      "text": "Cover the dish loosely and microwave for 10 minutes, or until the squash is tender when pierced with a fork.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Season with salt and ground black pepper, then serve hot."
    }
  ],
