  "id": "microwave-acorn-squash",
  "name": "Microwave Acorn Squash",
  "subtitle": "Tender squash with brown sugar and butter",
  "description": "Acorn squash halves cook quickly in the microwave for a simple sweet-savory side.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
