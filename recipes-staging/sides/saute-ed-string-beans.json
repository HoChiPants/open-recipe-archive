      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fresh-green-beans",
      "item": "fresh green beans",
      "quantity": 1,
      "unit": "pound",
      "preparation": "trimmed and snapped"
    },
    {
