  "id": "saute-ed-string-beans",
  "name": "Sautéed String Beans",
  "subtitle": "Tender green beans with marinated onions",
  "description": "Fresh green beans are sautéed until tender, then finished with savory seasonings and marinated cocktail onions.",
  "meal_type": "side",
  "cuisine": "American",
