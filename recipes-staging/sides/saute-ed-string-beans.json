  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large skillet over medium-high heat."
    },
    {
      "step": 2,
      "text": "Add the green beans and sauté, stirring occasionally, for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Season with garlic salt, garlic powder, black pepper, and dried minced onion. Add the marinated cocktail onions with their liquid."
    },
    {
      "step": 4,
      "text": "Cook for 5 minutes, stirring occasionally, until the green beans are tender.",
      "timer_minutes": 5
    }
  ],
