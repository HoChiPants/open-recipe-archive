{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cheese-and-onion-rugelach",
  "name": "Cheese and Onion Rugelach",
  "subtitle": "Savory pastry spirals with a rich cheese dough",
  "description": "Tender, cheese-filled pastry shaped around a sweet-savory onion filling and baked until golden.",
  "meal_type": "side",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 18
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-at-room-temperature",
      "item": "unsalted butter at room temperature",
      "quantity": 115,
      "unit": "g"
    },
    {
      "ingredient_id": "full-fat-soft-cheese-at-room-temperature",
      "item": "full-fat soft cheese at room temperature",
      "quantity": 115,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": "120-140",
      "unit": "g"
    },
    {
      "ingredient_id": "vegetarian-italian-style-hard-cheese-finely-grated",
      "item": "vegetarian Italian-style hard cheese finely grated",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "extra-strong-vegetarian-cheddar-finely-grated",
      "item": "extra-strong vegetarian cheddar finely grated",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "onion-marmalade-or-finely-chopped-smooth-onion-chutney",
      "item": "onion marmalade or finely chopped smooth onion chutney",
      "quantity": "40-60",
      "unit": "g"
    },
    {
      "ingredient_id": "egg-beaten",
      "item": "egg beaten",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Beat the butter, soft cheese, and grated Italian-style hard cheese until smooth."
    },
    {
      "step": 2,
      "text": "Mix in the cheddar and enough flour to make a soft, workable dough. Divide into portions, wrap, and chill until firm, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Heat the oven to 375°F and line a baking sheet with parchment."
    },
    {
      "step": 4,
      "text": "Roll each dough portion into a round. Spread with the onion marmalade or chutney, then cut each round into wedges."
    },
    {
      "step": 5,
      "text": "Roll the wedges from the wide edge toward the point to form crescents, and arrange them on the baking sheet."
    },
    {
      "step": 6,
      "text": "Brush with the beaten egg and bake for 18 minutes, until golden and the pastry center reaches 160°F.",
      "timer_minutes": 18
    },
    {
      "step": 7,
      "text": "Cool briefly on the baking sheet before transferring to a serving plate."
    }
  ],
