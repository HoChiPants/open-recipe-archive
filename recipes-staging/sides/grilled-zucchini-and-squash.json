  "id": "grilled-zucchini-and-squash",
  "name": "Grilled Zucchini and Squash",
  "subtitle": "Tender summer vegetables with garlic and pepper",
  "description": "Sliced zucchini and summer squash are coated with seasoned butter and grilled until tender for a simple vegetable side.",
  "meal_type": "side",
