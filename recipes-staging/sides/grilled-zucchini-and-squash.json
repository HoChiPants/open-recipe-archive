  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill or grill pan to medium heat."
    },
    {
      "step": 2,
      "text": "Melt the butter. Mix the salt, black pepper, and garlic powder into the melted butter."
    },
    {
      "step": 3,
      "text": "Toss the zucchini and summer squash with the seasoned butter."
    },
    {
      "step": 4,
      "text": "Grill the vegetables, turning as needed, until tender, about 20 minutes.",
