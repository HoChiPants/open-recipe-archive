{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "potato-knishes",
  "name": "Potato Knishes",
  "subtitle": "Tender potato filling wrapped in simple baked dough",
  "description": "Seasoned mashed potatoes and sautéed onions are enclosed in egg dough and baked until golden.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 60,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "baking-potatoes",
      "item": "baking potatoes",
      "quantity": 7,
      "preparation": "peeled and cubed"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "warm-water",
      "item": "warm water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 2
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes, salt, and warm water in a pot. Bring to a simmer and cook until tender, about 20 minutes. Drain.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil, add the onions, and cook for 5 minutes. Stir in the garlic, sugar, pepper, and remaining salt.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Mash the potatoes until smooth, then combine them with the onion mixture. Set aside."
    },
    {
      "step": 4,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 5,
      "text": "Whisk the eggs, salt, and warm water together. Stir in the flour, then knead for 8 minutes, until smooth.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Divide the dough into portions, roll or stretch each into a strip, and cut into pieces. Flatten each piece, add potato filling, and seal into a knish."
    },
    {
      "step": 7,
      "text": "Arrange the knishes on a baking sheet. Whisk the egg yolks with the milk and brush the tops."
    },
    {
      "step": 8,
      "text": "Bake for 45 minutes, until golden brown and the dough is fully set; the egg-containing center should reach 160°F.",
      "timer_minutes": 45
    }
  ],
