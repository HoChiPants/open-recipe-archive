  "id": "carrot-casserole-91ef8b5c",
  "name": "Carrot Casserole",
  "subtitle": "A creamy baked carrot side with a crisp cracker topping.",
  "description": "Tender carrots and onion are folded into a sweet, cheesy mayonnaise mixture, then baked with crushed crackers until hot and lightly browned.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "baby-carrots",
      "item": "baby carrots",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-cheddar-cheese",
      "item": "grated Cheddar cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "buttery-round-crackers",
      "item": "buttery round crackers",
      "quantity": 10,
      "preparation": "crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the baby carrots and chopped onion until the carrots are tender, about 10 minutes. Let cool briefly.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir together the mayonnaise, Cheddar cheese, and sugar."
    },
    {
      "step": 4,
      "text": "Add the cooled carrots and onion, stirring until evenly coated."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to a baking dish and sprinkle the crushed crackers over the top."
    },
    {
      "step": 6,
      "text": "Bake until heated through and lightly browned, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
