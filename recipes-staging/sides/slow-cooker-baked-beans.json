  "instructions": [
    {
      "step": 1,
      "text": "In the slow cooker, stir together the barbecue sauce, ketchup, brown sugar, and dry mustard until smooth."
    },
    {
      "step": 2,
      "text": "Add the beans, bell pepper, onion, and cooked ham; stir until evenly combined."
    },
