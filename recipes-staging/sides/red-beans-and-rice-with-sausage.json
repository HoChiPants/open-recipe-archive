  "instructions": [
    {
      "step": 1,
      "text": "Soak the dried red beans for 8 hours, then drain.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Transfer the beans to a cooking pot and stir in the dried onion and dried garlic."
    },
    {
      "step": 3,
      "text": "Combine the salt, sugar, celery seed, cumin, cayenne, red pepper flakes, and bay leaf; add the mixture to the beans with the ham hock."
    },
    {
      "step": 4,
      "text": "Cook the bean mixture for 4 hours, until the beans are tender. Verify that the ham hock reaches 145°F, then let it rest for 3 minutes before serving or removing the meat.",
      "timer_minutes": 240
    },
    {
      "step": 5,
      "text": "Stir in the sliced smoked sausage and cook until it reaches 160°F."
    },
    {
      "step": 6,
      "text": "Serve the beans and sausage over hot cooked rice."
    }
  ],
