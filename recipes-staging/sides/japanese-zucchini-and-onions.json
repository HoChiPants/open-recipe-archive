  "id": "japanese-zucchini-and-onions",
  "name": "Japanese Zucchini and Onions",
  "subtitle": "Quick sautéed zucchini with savory glaze",
  "description": "Tender zucchini and onions are sautéed with teriyaki, soy sauce, and toasted sesame seeds for a quick Asian-inspired side.",
  "meal_type": "side",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "medium",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "zucchinis",
      "item": "zucchinis",
      "quantity": 2,
      "unit": "medium",
      "preparation": "cut into thin strips"
    },
    {
      "ingredient_id": "teriyaki-sauce",
      "item": "teriyaki sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sesame-seeds",
      "item": "sesame seeds",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "toasted"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a skillet over medium heat and add the vegetable oil."
    },
    {
      "step": 2,
      "text": "Add the onion and cook for 5 minutes, stirring occasionally. Add the zucchini, teriyaki sauce, soy sauce, and toasted sesame seeds."
    },
    {
      "step": 3,
      "text": "Cook for 5 minutes, stirring, until the zucchini is tender. Season with ground black pepper."
    },
    {
      "step": 4,
      "text": "Serve warm."
    }
  ],
