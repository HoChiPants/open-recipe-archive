  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Butter a baking dish and arrange the sliced Brussels sprouts in it."
    },
    {
      "step": 3,
      "text": "Whisk together the heavy cream, Parmesan, garlic, salt, and pepper. Pour the mixture over the sprouts and sprinkle with nutmeg."
    },
    {
      "step": 4,
      "text": "Bake until the Brussels sprouts are tender, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Remove from the oven and let stand for 15 minutes before serving.",
      "timer_minutes": 15
    }
