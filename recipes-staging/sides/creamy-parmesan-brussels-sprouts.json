  "id": "creamy-parmesan-brussels-sprouts",
  "name": "Creamy Parmesan Brussels Sprouts",
  "subtitle": "Tender Brussels sprouts baked in a savory cream sauce",
  "description": "Sliced Brussels sprouts are coated with garlic-Parmesan cream, seasoned with nutmeg, and baked until tender.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
