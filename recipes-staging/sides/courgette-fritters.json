  "instructions": [
    {
      "step": 1,
      "text": "Combine the grated courgettes, flour, beaten egg, and parmesan or vegetarian alternative, if using, until evenly mixed. Let stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Preheat a frying pan over medium heat and add the olive oil."
    },
    {
      "step": 3,
      "text": "Cook spoonfuls of the mixture in the pan for about 3 minutes, turning as needed, until golden brown and the centers are fully set.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Serve the fritters with the roasted red pepper hummus."
    }
