  "id": "honey-rosemary-carrots",
  "name": "Honey Rosemary Carrots",
  "subtitle": "Tender carrots with a buttery honey glaze",
  "description": "Diagonal carrot slices simmer with butter, honey, and fresh rosemary for a simple sweet-savory side dish.",
