  "instructions": [
    {
      "step": 1,
      "text": "Preheat a large skillet or saucepan over medium heat for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the carrots, water, and butter. Bring to a simmer and cook until the carrots begin to soften."
