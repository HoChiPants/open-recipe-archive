  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Cut the squash in half lengthwise and scoop out the centers, leaving thick shells."
    },
    {
      "step": 2,
      "text": "Boil the squash shells for 5 minutes, then drain and let them set briefly.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet. Add the onion and garlic and cook until softened, then stir in the spinach."
    },
    {
      "step": 4,
      "text": "Combine the spinach mixture with the eggs, ricotta, Parmesan, parsley, salt, Italian seasoning, and pepper."
    },
    {
      "step": 5,
      "text": "Arrange the squash shells in a baking dish and fill them with the ricotta mixture. Bake at 375°F until the filling is firm and reaches 160°F in the center.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Serve with the spaghetti sauce."
    }
  ],
