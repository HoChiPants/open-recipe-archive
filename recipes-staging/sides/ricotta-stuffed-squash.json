  "id": "ricotta-stuffed-squash",
  "name": "Ricotta Stuffed Squash",
  "subtitle": "Tender squash filled with spinach, ricotta, and herbs",
  "description": "Blanched yellow squash is filled with a savory ricotta-spinach mixture, baked, and served with spaghetti sauce.",
