  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Season the Brussels sprouts with salt and pepper, then transfer them to a roasting pan. Roast for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Drain any excess moisture from the pan."
    },
    {
      "step": 4,
      "text": "Stir in the potatoes, carrots, cauliflower, beets, shallots, olive oil, and additional salt and pepper. Spread the vegetables in an even layer."
    },
    {
      "step": 5,
      "text": "Roast until all the vegetables are cooked through and browned, about 45 minutes.",
      "timer_minutes": 45
    }
  ],
