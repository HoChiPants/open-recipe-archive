  "id": "zucchini-patties",
  "name": "Zucchini Patties",
  "subtitle": "Crisp-edged vegetable patties with melted cheese",
  "description": "Grated zucchini, eggs, flour, cheese, and onion form savory patties that are sautéed until golden and fully set.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "grated-zucchini",
      "item": "grated zucchini",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the grated zucchini and Parmesan cheese in a bowl."
    },
    {
      "step": 2,
      "text": "Stir in the beaten eggs, flour, mozzarella, onion, and salt until combined."
    },
    {
      "step": 3,
      "text": "Preheat a skillet over medium heat and add the vegetable oil."
    },
    {
      "step": 4,
      "text": "Spoon the mixture into patties and sauté until golden brown, turning as needed; ensure the centers are firm and fully set before serving.",
      "timer_minutes": 10
    }
  ],
