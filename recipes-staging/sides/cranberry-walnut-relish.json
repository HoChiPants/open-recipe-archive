    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-or-frozen-cranberries",
      "item": "fresh or frozen cranberries",
      "quantity": 12,
      "unit": "ounces"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "12-ounce-jar-orange-marmalade",
      "item": "(12 ounce) jar orange marmalade",
      "quantity": 1
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the cranberries in a baking dish and sprinkle with the sugar."
    },
    {
      "step": 3,
      "text": "Bake for 35 minutes, then stir in the chopped walnuts.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "Bake for 10 minutes more.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir together the orange marmalade and lemon juice, then combine with the baked cranberry mixture."
    },
    {
      "step": 6,
      "text": "Let the relish cool, then cover and chill for 3 hours before serving.",
      "timer_minutes": 180
    }
  ],
