  "id": "cranberry-walnut-relish",
  "name": "Cranberry Walnut Relish",
  "subtitle": "A tart, citrusy relish with a nutty finish",
  "description": "Bake cranberries with sugar and walnuts, then fold in marmalade and lemon juice before cooling and chilling.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
