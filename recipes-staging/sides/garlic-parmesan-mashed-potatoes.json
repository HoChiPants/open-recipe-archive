  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes and sea salt in a large pot and add enough water to cover. Bring to a simmer and cook until the potatoes are tender, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "While the potatoes cook, melt the butter in a saucepan over medium heat. Add the garlic and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Drain the potatoes, then return them to the pot. Add the butter and garlic mixture, milk, Parmesan, parsley, sea salt, and black pepper."
    },
    {
      "step": 4,
      "text": "Mash until smooth, then serve warm."
    }
  ],
