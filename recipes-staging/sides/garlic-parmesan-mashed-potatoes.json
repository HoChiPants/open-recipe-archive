  "id": "garlic-parmesan-mashed-potatoes",
  "name": "Garlic Parmesan Mashed Potatoes",
  "subtitle": "Smooth, savory potatoes with garlic and Parmesan",
  "description": "Tender potatoes are mashed with garlicky butter, milk, Parmesan, and parsley for a rich side dish.",
  "meal_type": "side",
