  "id": "syracuse-salt-potatoes",
  "name": "Syracuse Salt Potatoes",
  "subtitle": "Tender potatoes with a crisp salt coating and melted butter",
  "description": "Boil new potatoes in heavily salted water until tender, then drain and finish with melted butter.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "new-potatoes",
      "item": "new potatoes",
      "quantity": 4,
      "unit": "pounds"
    },
    {
      "ingredient_id": "fine-salt",
      "item": "fine salt",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 8,
      "unit": "tablespoons",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the new potatoes in a large pot and cover with water."
    },
    {
      "step": 2,
      "text": "Stir the fine salt into the water, then bring it to a boil."
    },
    {
      "step": 3,
      "text": "Boil until the potatoes are tender when pierced, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Drain the potatoes thoroughly and return them to the pot."
    },
    {
      "step": 5,
      "text": "Toss with the melted butter and serve hot."
    }
  ],
