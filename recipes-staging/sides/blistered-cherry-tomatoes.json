  "id": "blistered-cherry-tomatoes",
  "name": "Blistered Cherry Tomatoes",
  "subtitle": "A quick, buttery tomato side with sweet basil flavor",
  "description": "Cherry tomatoes cook briefly in butter with dried basil and a touch of sugar until hot and lightly blistered.",
