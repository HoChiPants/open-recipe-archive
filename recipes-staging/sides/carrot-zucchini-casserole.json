{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "carrot-zucchini-casserole",
  "name": "Carrot Zucchini Casserole",
  "subtitle": "Tender vegetables with a savory crumb topping",
  "description": "Carrots and zucchini are combined with a tangy mayonnaise sauce, finished with buttery Italian bread crumbs, and baked until lightly browned.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 1,
      "unit": "pound",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "zucchinis",
      "item": "zucchinis",
      "quantity": 3,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-onion",
      "item": "grated onion",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "prepared-horseradish",
      "item": "prepared horseradish",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "italian-bread-crumbs",
      "item": "Italian bread crumbs",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F and prepare a casserole dish."
    },
    {
      "step": 2,
      "text": "Place the carrots and salt in a saucepan, cover with water, and simmer for about 15 minutes, until tender.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Add the sliced zucchinis and simmer for 3 minutes, then drain the vegetables well.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Stir together the mayonnaise, grated onion, prepared horseradish, remaining salt, and black pepper. Combine the sauce with the drained vegetables and transfer to the casserole dish."
    },
    {
      "step": 5,
      "text": "Mix the Italian bread crumbs with the melted butter and scatter the mixture over the vegetables."
    },
    {
      "step": 6,
      "text": "Bake for about 15 minutes, until the topping is lightly browned.",
      "timer_minutes": 15
    }
  ],
