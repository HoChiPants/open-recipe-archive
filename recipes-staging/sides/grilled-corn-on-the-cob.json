  "ingredients": [
    {
      "ingredient_id": "ears-corn",
      "item": "ears corn",
      "quantity": 6
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 6,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat an outdoor grill to medium heat."
    },
    {
      "step": 2,
      "text": "Prepare the corn by removing the husks and silk, then rinse and dry the ears."
    },
    {
      "step": 3,
      "text": "Place the corn in a bowl and coat it with the softened butter. Season with salt and ground black pepper."
    },
    {
      "step": 4,
      "text": "Arrange the corn on the grill and cook, turning regularly, until tender and lightly charred.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Serve hot with any remaining butter and seasoning from the bowl."
    }
  ],
