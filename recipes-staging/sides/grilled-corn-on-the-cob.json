  "id": "grilled-corn-on-the-cob",
  "name": "Grilled Corn on the Cob",
  "subtitle": "Tender corn with buttery seasoning",
  "description": "Grill corn until tender, then serve it with softened butter, salt, and black pepper.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
