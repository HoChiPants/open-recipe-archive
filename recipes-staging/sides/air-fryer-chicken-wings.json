  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to its instructions."
    },
    {
      "step": 2,
      "text": "Toss the chicken wings with the oil and chosen seasoning until evenly coated."
    },
    {
      "step": 3,
      "text": "Arrange the wings in the air-fryer basket and cook for 35 minutes, or until tender.",
      "timer_minutes": 35
