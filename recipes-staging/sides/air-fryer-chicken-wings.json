  "id": "air-fryer-chicken-wings",
  "name": "Air Fryer Chicken Wings",
  "subtitle": "Crisp wings with your choice of seasoning",
  "description": "Seasoned chicken wings cooked in an air fryer and served with optional dipping sauce.",
  "meal_type": "side",
  "yield": {
