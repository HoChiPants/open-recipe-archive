    {
      "step": 4,
      "text": "Continue cooking for 5 minutes, then verify that the thickest pieces reach 165°F with a food thermometer.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Serve hot with the optional dipping sauce."
    }
