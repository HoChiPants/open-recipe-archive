  "id": "courgette-and-cheddar-cornbread",
  "name": "Courgette and Cheddar Cornbread",
  "subtitle": "A tender polenta-based bake with savory cheddar and grated courgette.",
  "description": "This savory cornbread combines instant polenta, cheddar, and courgette in a moist, lightly crisp-edged bake.",
  "meal_type": "side",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "butter-melted",
      "item": "butter melted",
      "quantity": 75,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "strong-white-bread-flour",
      "item": "strong white bread flour",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "instant-polenta",
      "item": "instant polenta",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 350,
      "unit": "ml"
    },
    {
      "ingredient_id": "mature-cheddar-grated",
      "item": "mature cheddar grated",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "or-1-medium-courgette-about-200g",
      "item": "or 1 medium courgette (about 200g)",
      "quantity": 2,
      "unit": "small",
      "preparation": "trimmed and roughly grated"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F (200°C). Grease a baking tin with the extra butter."
    },
    {
      "step": 2,
      "text": "Combine the bread flour, polenta, and baking powder in a large bowl."
    },
    {
      "step": 3,
      "text": "Whisk the melted butter, eggs, and milk in a separate bowl, then stir into the dry ingredients until just combined."
    },
    {
      "step": 4,
      "text": "Fold in the grated cheddar and courgette. Transfer the batter to the prepared tin and smooth the surface."
    },
    {
      "step": 5,
      "text": "Bake for 40 minutes, until golden and fully set in the center; a thermometer should read at least 160°F (71°C).",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Cool briefly, then cut into portions and serve."
    }
  ],
