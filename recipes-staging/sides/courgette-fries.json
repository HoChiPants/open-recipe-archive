  "id": "courgette-fries",
  "name": "Courgette Fries",
  "subtitle": "Crisp fried courgette batons with Parmesan",
  "description": "Flour-coated courgette batons are fried until crisp, drained, and finished with grated Parmesan.",
  "meal_type": "side",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "courgettes-cut-into-1cm-batons",
      "item": "courgettes cut into 1cm batons",
      "quantity": 2
    },
    {
      "ingredient_id": "oil-for-deep-frying",
      "item": "oil for deep frying"
    },
    {
      "ingredient_id": "parmesan-grated",
      "item": "parmesan grated",
      "quantity": 15,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Toss the courgette batons with the flour until they are thickly coated."
    },
    {
      "step": 2,
      "text": "Heat the oil for deep frying in a deep, heavy pan until ready for frying."
    },
    {
      "step": 3,
      "text": "Fry the courgette in batches until golden and crisp, turning as needed.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Prepare a plate or tray lined with kitchen paper for draining."
    },
    {
      "step": 5,
      "text": "Transfer the fries to the lined plate and drain well."
    },
    {
      "step": 6,
      "text": "Sprinkle with the grated Parmesan and serve hot."
    }
  ],
