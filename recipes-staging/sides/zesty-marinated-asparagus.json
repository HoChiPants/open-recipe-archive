  "id": "zesty-marinated-asparagus",
  "name": "Zesty Marinated Asparagus",
  "subtitle": "Tender asparagus chilled in balsamic dressing with lemon and parsley",
  "description": "Blanch asparagus briefly, marinate it in balsamic vinaigrette, then finish with lemon zest, parsley, salt, and pepper for a bright make-ahead side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 5,
    "inactive_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-asparagus",
      "item": "fresh asparagus",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "trimmed and cut into 2 1/2 inch pieces"
    },
    {
      "ingredient_id": "balsamic-vinaigrette-salad-dressing",
      "item": "balsamic vinaigrette salad dressing",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "grated-lemon-zest",
      "item": "grated lemon zest",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water seasoned with the kosher salt to a simmer. Add the asparagus and cook for 1 minute, until tender.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Cool the asparagus, then transfer it to a shallow dish and pour the balsamic vinaigrette over it. Cover and refrigerate for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Drain the asparagus, then toss it with the lemon zest, parsley, remaining kosher salt, and black pepper. Serve with the dressing."
    }
  ],
