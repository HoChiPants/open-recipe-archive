  "id": "candied-sweet-potatoes-with-brandy",
  "name": "Candied Sweet Potatoes with Brandy",
  "subtitle": "Tender sweet potatoes in a buttery brown-sugar glaze",
  "description": "Diced sweet potatoes are simmered until tender, then finished in a brandy-spiked butter and brown-sugar glaze.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-potatoes",
      "item": "sweet potatoes",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "peeled and diced"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "brandy",
      "item": "brandy",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the sweet potatoes in a saucepan, cover with water, and bring to a simmer."
    },
    {
      "step": 2,
      "text": "Cook until the potatoes are tender, about 15 minutes, then drain well.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Melt the butter in the saucepan over medium heat. Stir in the brown sugar, brandy, and salt until combined."
    },
    {
      "step": 4,
      "text": "Return the sweet potatoes to the pan and cook, stirring gently, until coated and the glaze is thickened."
    }
  ],
