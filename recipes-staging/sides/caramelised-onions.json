  "id": "caramelised-onions",
  "name": "Caramelised Onions",
  "subtitle": "Sweet, tangy onions for savoury dishes",
  "description": "Slow-cooked onions finished with brown sugar and balsamic vinegar until tender, glossy, and richly flavoured.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "onions-red-or-white",
      "item": "onions (red or white)",
      "quantity": 3,
      "unit": "large",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "of-salt",
      "item": "of salt",
      "unit": "pinch"
    },
    {
      "ingredient_id": "soft-brown-sugar",
      "item": "soft brown sugar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": "1-2",
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the onions and salt. Cook for about 40 minutes, stirring occasionally, until very soft and deeply golden.",
      "timer_minutes": 40
    },
    {
      "step": 3,
      "text": "Stir in the brown sugar, then add the balsamic vinegar and mix well."
    },
    {
      "step": 4,
      "text": "Cook for 5 minutes, stirring as needed, until glossy. Serve warm.",
      "timer_minutes": 5
    }
  ],
