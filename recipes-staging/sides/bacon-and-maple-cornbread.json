  "id": "bacon-and-maple-cornbread",
  "name": "Bacon and Maple Cornbread",
  "subtitle": "Savory cornbread with smoky bacon and a maple finish",
  "description": "A tender, lightly sweet cornbread baked with bacon and finished with warm maple butter.",
  "meal_type": "side",
  "yield": {
    "quantity": 9,
    "unit": "squares"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
