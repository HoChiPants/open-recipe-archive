  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking pan with the vegetable oil."
    },
    {
      "step": 2,
      "text": "Cook the bacon lardons for 6 minutes, then add the smoked streaky bacon and sauté until set. Transfer the bacon to a plate.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Whisk the buttermilk, eggs, 3 tablespoons maple syrup, and the vegetable oil. Separately combine the cornmeal or polenta, plain flour, baking powder, and bicarbonate of soda."
    },
    {
      "step": 4,
      "text": "Stir the wet mixture into the dry ingredients, then fold in the bacon. Transfer the batter to the prepared pan.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Melt the butter with 2 tablespoons maple syrup. Bake the cornbread until golden brown and the center is fully set, reaching 160°F on a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Brush or drizzle with the maple butter, then cool before cutting into 9 squares."
    }
  ],
