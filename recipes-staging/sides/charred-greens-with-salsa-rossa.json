  "id": "charred-greens-with-salsa-rossa",
  "name": "Charred Greens with Salsa Rossa",
  "subtitle": "Smoky greens with a bright tomato-chilli sauce",
  "description": "Char lettuce or kale until lightly blistered, then serve with a smooth, tangy salsa rossa.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
