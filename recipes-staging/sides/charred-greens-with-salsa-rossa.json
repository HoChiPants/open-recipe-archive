  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill or broiler to high."
    },
    {
      "step": 2,
      "text": "Blend the tomatoes, chilli garlic sauce, capers, garlic, extra virgin olive oil, white balsamic vinegar, and red chilli until smooth."
    },
    {
      "step": 3,
      "text": "Warm the salsa in a pan until set and thickened."
    },
    {
      "step": 4,
      "text": "Drizzle the halved lettuces or kale with olive oil, then grill in batches until charred and just tender."
    },
    {
      "step": 5,
      "text": "Arrange the greens on a serving platter and spoon over the salsa rossa."
    }
  ],
