  "id": "dijon-roasted-cauliflower",
  "name": "Dijon Roasted Cauliflower",
  "subtitle": "Tender florets with a savory mustard coating",
  "description": "Cauliflower is coated with Dijon mustard, aromatics, and oil, then roasted until tender.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "shallot",
      "item": "shallot",
      "quantity": 1,
      "preparation": "minced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced, or more to taste"
    },
    {
      "ingredient_id": "head-cauliflower",
      "item": "head cauliflower",
      "quantity": 1,
      "unit": "large",
      "preparation": "cut into florets"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the Dijon mustard and vegetable oil in a large bowl until smooth. Stir in the shallot and garlic."
    },
    {
      "step": 3,
      "text": "Add the cauliflower, season with salt and pepper, and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Transfer the cauliflower to a baking dish or sheet pan and bake for about 45 minutes, until tender.",
      "timer_minutes": 45
    }
  ],
