{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "caraway-oatcakes",
  "name": "Caraway Oatcakes",
  "subtitle": "Crisp oatcakes with caraway and thyme",
  "description": "Savory oatcakes flavored with toasted caraway, fresh thyme, and butter; serve as a side or with a cheeseboard.",
  "meal_type": "side",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "caraway-seeds",
      "item": "caraway seeds",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "rolled-porridge-oats",
      "item": "rolled porridge oats",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "wholemeal-flour-plus-extra-for-dusting",
      "item": "wholemeal flour plus extra for dusting",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "thyme-sprigs-leaves-picked",
      "item": "thyme sprigs leaves picked",
      "quantity": 6
    },
    {
      "ingredient_id": "butter-cubed",
      "item": "butter cubed",
      "quantity": 50,
      "unit": "g",
      "preparation": "softened"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Toast the caraway seeds in a dry pan for 2 minutes, then crush or finely chop them.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Combine the toasted caraway, rolled porridge oats, wholemeal flour plus extra for dusting, and thyme leaves."
    },
    {
      "step": 4,
      "text": "Melt the butter cubed until boiling, then pour it into the dry mixture and stir to form a cohesive dough."
    },
    {
      "step": 5,
      "text": "Turn the dough onto a lightly floured surface, shape it into a slab, and let it cool for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Roll or press the dough to an even thickness, cut out 25 oatcakes, and arrange them on the prepared sheet."
    },
    {
      "step": 7,
      "text": "Bake for 20 minutes, until firm and lightly colored.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "Cool the oatcakes on the sheet for 3 minutes, then transfer them to a rack to finish cooling.",
      "timer_minutes": 3
    }
  ],
  "tags": [
