  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "bavarian-sauerkraut",
  "name": "Bavarian Sauerkraut",
  "subtitle": "Tangy sauerkraut with onion and caraway",
  "description": "A warm, savory sauerkraut side dish balanced with brown sugar, stock, sherry, and caraway.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "bacon-drippings",
      "item": "bacon drippings",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "finely-chopped-onion",
      "item": "finely chopped onion",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sauerkraut",
      "item": "sauerkraut",
      "quantity": 2,
      "unit": "package",
      "preparation": "16 ounce, undrained"
    },
    {
      "ingredient_id": "chicken-stock",
      "item": "chicken stock",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cooking-sherry",
      "item": "cooking sherry",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "caraway-seeds",
      "item": "caraway seeds",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the bacon drippings in a large saucepan over medium heat. Add the onion and cook, stirring, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Transfer the undrained sauerkraut to the saucepan and stir in the chicken stock, cooking sherry, brown sugar, and caraway seeds."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a gentle simmer, then cook until heated throughout and a food thermometer registers 165°F.",
      "timer_minutes": 35
    }
  ],
