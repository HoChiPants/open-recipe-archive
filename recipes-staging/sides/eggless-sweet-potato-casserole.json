  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the mashed sweet potatoes, evaporated milk, orange juice, vanilla, white sugar, salt, 3 tablespoons melted butter, nutmeg, cinnamon, and packed brown sugar until smooth."
    },
    {
      "step": 3,
      "text": "Spread the sweet potato mixture in a baking dish."
    },
    {
      "step": 4,
      "text": "Stir together the remaining melted butter, white sugar, packed brown sugar, flour, and chopped pecans to form the topping."
    },
    {
      "step": 5,
      "text": "Scatter the topping over the sweet potatoes and bake for 45 minutes, or until the center is set.",
      "timer_minutes": 45
    }
  ],
