  "id": "sheet-pan-roasted-eggplant-with-garlic",
  "name": "Sheet-Pan Roasted Eggplant with Garlic",
  "subtitle": "Smoky, seasoned eggplant slices roasted until tender",
  "description": "Eggplant slices are coated with seasoned oil, roasted on a sheet pan, and finished with salt for a simple vegetable side.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "eggplant",
      "item": "eggplant",
      "quantity": 1,
      "preparation": "cut crosswise into 1/2-inch slices"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "smoked-paprika",
      "item": "smoked paprika",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "italian-seasoning",
      "item": "Italian seasoning",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Arrange the eggplant slices in a single layer on a sheet pan."
    },
    {
      "step": 3,
      "text": "Stir the olive oil with the garlic powder, smoked paprika, and Italian seasoning, then coat the eggplant evenly."
    },
    {
      "step": 4,
      "text": "Roast for 25 minutes, until the slices are tender and lightly browned.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Sprinkle with the salt and serve warm."
    }
  ],
