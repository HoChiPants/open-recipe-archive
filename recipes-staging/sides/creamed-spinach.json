{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "creamed-spinach",
  "name": "Creamed Spinach",
  "subtitle": "A rich, savory spinach side",
  "description": "Thawed spinach is folded into a smooth garlic cream sauce with Parmesan and nutmeg for a comforting side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "es-boxes-frozen-chopped-spinach",
      "item": "es boxes frozen chopped spinach",
      "quantity": 4,
      "unit": "box",
      "preparation": "10 ounce, thawed and squeezed dry; reserve 1/2 cup liquid"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic cloves",
      "quantity": 3,
      "unit": "large",
      "preparation": "minced"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper",
      "item": "Salt and ground black pepper"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Thaw the spinach, squeeze it dry, and reserve 1/2 cup of its liquid."
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan over medium heat. Add the garlic and cook, stirring occasionally, until softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk in the flour. Gradually whisk in the milk until the mixture is smooth."
    },
    {
      "step": 4,
      "text": "Stir in the spinach and cook until the sauce thickens.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the Parmesan, nutmeg, salt, and black pepper. Serve warm."
    }
  ],
