  "id": "cream-braised-brussels-sprouts",
  "name": "Cream-Braised Brussels Sprouts",
  "subtitle": "Tender sprouts in a bright, silky cream sauce",
  "description": "Quartered Brussels sprouts are gently braised in cream, then finished with lemon juice for balance.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "brussels-sprouts",
      "item": "Brussels sprouts",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "trimmed and quartered"
    },
    {
      "ingredient_id": "sea-salt",
      "item": "sea salt",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large skillet over medium heat. Add the Brussels sprouts and sea salt, and cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Pour in the heavy cream and bring it to a gentle simmer. Cover and cook for 35 minutes, or until the sprouts are tender.",
      "timer_minutes": 35
    },
    {
      "step": 3,
      "text": "Stir in the lemon juice. Taste and adjust with the listed sea salt or lemon juice as needed, then serve warm."
    }
  ],
