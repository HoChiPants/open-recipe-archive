      "quantity": 4,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Slice the red potatoes into thin, even pieces and arrange them in a baking dish."
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium heat. Cook the onion and garlic for 10 minutes, until the butter is melted and the aromatics are softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in both condensed soups, the milk, salt and pepper, and the shredded Cheddar. Heat until the cheese melts and the sauce is smooth."
    },
    {
      "step": 4,
      "text": "Pour the sauce over the potatoes and top with the remaining shredded Cheddar."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, then continue baking for 10 minutes more, until the potatoes are tender and the cheese is melted and lightly browned.",
      "timer_minutes": 55
    }
  ],
