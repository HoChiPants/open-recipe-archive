  "id": "scalloped-red-potatoes",
  "name": "Scalloped Red Potatoes",
  "subtitle": "Tender layered potatoes in a creamy cheddar sauce",
  "description": "Thinly sliced red potatoes bake beneath a savory broccoli-celery sauce and melted cheddar for a comforting side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
