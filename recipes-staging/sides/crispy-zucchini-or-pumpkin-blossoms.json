  "id": "crispy-zucchini-or-pumpkin-blossoms",
  "name": "Crispy Zucchini or Pumpkin Blossoms",
  "subtitle": "Lightly battered blossoms with basil and Parmesan",
  "description": "Fresh blossoms are coated in a savory basil-Parmesan batter, fried until crisp, and drained before serving.",
  "meal_type": "side",
  "cuisine": "Italian",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "leaves-fresh-basil",
      "item": "leaves fresh basil",
      "quantity": 3,
      "preparation": "minced"
    },
    {
      "ingredient_id": "finely-grated-parmesan-cheese",
      "item": "finely grated Parmesan cheese",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "oil-for-frying",
      "item": "oil for frying",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "pumpkin-or-zucchini-blossoms",
      "item": "pumpkin or zucchini blossoms",
      "quantity": 12
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir together the flour, baking powder, minced basil, and Parmesan."
    },
    {
      "step": 2,
      "text": "Combine the cold water and beaten eggs, then mix into the dry ingredients until smooth."
    },
    {
      "step": 3,
      "text": "Heat the frying oil in a deep skillet or saucepan until hot."
    },
    {
      "step": 4,
      "text": "Coat the blossoms in the batter, allowing excess to drip off."
    },
    {
      "step": 5,
      "text": "Fry the coated blossoms in batches until crisp and golden, about 10 minutes total.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Transfer the blossoms to a draining rack or paper-lined plate before serving."
    }
  ],
