  "instructions": [
    {
      "step": 1,
      "text": "Heat the ghee or groundnut oil in a large pot. Cook the onions until softened, then add the garlic and ginger and stir briefly."
    },
    {
      "step": 2,
      "text": "Add the turmeric, nigella seeds, ground cumin, ground coriander, paprika, cinnamon, chilli flakes, cardamom, and bay leaves. Stir until fragrant."
    },
    {
      "step": 3,
      "text": "Add the split peas, chickpeas, and coconut milk. Bring to a boil, then reduce the heat and simmer until the split peas are tender and the dhal is thick, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "For the tempering, heat the ghee or unsalted butter in a small pan. Add the shallots, cumin seeds, mustard seeds, and remaining chilli flakes; cook until the shallots are browned and the seeds are fragrant."
    },
    {
      "step": 5,
      "text": "Stir the tempering and chopped coriander through the dhal, then serve hot."
    }
  ],
