{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "creamy-potato-casserole",
  "name": "Creamy Potato Casserole",
  "subtitle": "A cheesy, creamy bake for a crowd",
  "description": "Frozen hash browns are folded into a rich sour cream and potato-soup mixture, topped with Cheddar, and baked until hot and bubbling.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "condensed-cream-of-potato-soup",
      "item": "condensed cream of potato soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "frozen-hash-brown-potatoes",
      "item": "frozen hash brown potatoes",
      "quantity": 1,
      "unit": "package",
      "preparation": "2 pound"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 0.33300000429153,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir together the sour cream, condensed cream of potato soup, and butter until combined."
    },
    {
      "step": 3,
      "text": "Fold in the frozen hash brown potatoes, 1 cup of the Cheddar cheese, and the green onions. Season with salt and pepper."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish and sprinkle the remaining 1 cup Cheddar over the top."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, until hot and bubbling.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
