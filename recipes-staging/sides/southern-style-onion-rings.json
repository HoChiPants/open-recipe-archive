{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "southern-style-onion-rings",
  "name": "Southern-Style Onion Rings",
  "subtitle": "Crisp, golden rings with a seasoned coating",
  "description": "Thick sweet-onion rings are dipped in a tangy egg-white batter, coated in seasoned flour, and fried until crisp and fully set.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "oil-for-frying",
      "item": "oil for frying",
      "quantity": 1,
      "unit": "quart",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 3
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-vinegar",
      "item": "white vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sweet-onions",
      "item": "sweet onions",
      "quantity": 3,
      "unit": "large",
      "preparation": "peeled and sliced into thick rings"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the frying oil to 375°F in a deep, heavy pot or fryer."
    },
    {
      "step": 2,
      "text": "Combine the flour with half of the salt and half of the pepper in a shallow dish."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the egg whites, milk, vinegar, and the remaining salt and pepper until blended."
    },
    {
      "step": 4,
      "text": "Dip each onion ring into the batter, then turn it in the seasoned flour until evenly coated."
    },
    {
      "step": 5,
      "text": "Fry the rings in batches for about 5 minutes, turning as needed, until golden brown, the coating is fully set, and the center reaches 160°F.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Transfer the fried rings to a draining rack or paper towels and serve hot."
    }
  ],
