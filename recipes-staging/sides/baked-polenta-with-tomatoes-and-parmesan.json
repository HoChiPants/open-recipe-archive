  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Bring the water, milk, and 1 tablespoon butter to a simmer in a saucepan."
    },
    {
      "step": 3,
      "text": "Gradually stir in the polenta and cook, stirring, until thickened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the Parmesan, chopped basil, salt, and pepper. Transfer the polenta to the baking dish and dot with the chilled butter pieces."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Arrange the sliced tomatoes over the polenta and sprinkle with the remaining Parmesan and basil."
    },
    {
      "step": 7,
      "text": "Bake until the cheese is melted and the tomatoes are warmed, about 10 minutes.",
      "timer_minutes": 10
    }
  ],
