  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a preheated oven until crisp, about 10 minutes. Drain and crumble.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium heat. Add the onion, celery, and garlic; cook until tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Combine the mashed potatoes, cheese, flour, beaten egg, mustard, pepper, hot sauce, crumbled bacon, and cooked vegetables. Mix until evenly blended."
    },
    {
      "step": 4,
      "text": "Heat the vegetable oil in the skillet. Shape the mixture into 8 cakes and cook until golden brown on both sides, about 7 minutes total. Confirm the centers are firm and fully set, or reach 160°F with a food thermometer.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Whisk the sour cream until smooth and serve with the potato cakes."
    }
  ],
