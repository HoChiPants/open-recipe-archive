      "item": "sweet potato vermicelli (glass noodles)",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "boiling-water",
      "item": "boiling water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "reduced-sodium-soy-sauce",
      "item": "reduced-sodium soy sauce",
      "quantity": 0.5,
