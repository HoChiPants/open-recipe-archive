    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the glass noodles in a heatproof bowl, cover with boiling water, and soak for 10 minutes. Drain well.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the boiling water, soy sauce, and brown sugar in a saucepan. Bring the mixture to a boil, then cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Preheat a large skillet over medium heat and add the vegetable oil."
    },
    {
      "step": 4,
      "text": "Add the drained noodles and soy sauce mixture. Stir until the noodles are thoroughly coated and heated through, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Transfer to a serving dish and sprinkle with the toasted sesame seeds."
    }
  ],
