  "id": "korean-glass-noodles",
  "name": "Korean Glass Noodles",
  "subtitle": "Sweet-savory noodles with toasted sesame",
  "description": "Tender glass noodles coated in a simple soy-brown sugar sauce and finished with sesame seeds.",
  "meal_type": "side",
  "cuisine": "Korean",
  "yield": {
    "quantity": 4,
