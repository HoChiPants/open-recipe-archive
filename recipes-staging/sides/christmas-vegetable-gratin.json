  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F and set aside a shallow baking dish.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Warm the double cream and whole milk with the garlic and thyme. Season with the nutmeg, then remove the garlic and thyme."
    },
    {
      "step": 3,
      "text": "Arrange the leek, Brussels sprouts, carrot, and potato slices in the baking dish, layering the vegetables evenly."
    },
    {
      "step": 4,
      "text": "Pour the warm cream mixture over the vegetables and gently press them down so the liquid reaches most of the layers."
    },
    {
      "step": 5,
      "text": "Cover with the grated gruyère or cheddar and bake for 50 minutes, until the potatoes are tender and the top is golden.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Rest for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
