  "id": "christmas-vegetable-gratin",
  "name": "Christmas Vegetable Gratin",
  "subtitle": "Layered winter vegetables baked in a creamy, cheesy sauce",
  "description": "A comforting baked side dish combining potatoes and winter vegetables with cream, herbs, nutmeg, and a browned cheese topping.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "(with leftovers)"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
