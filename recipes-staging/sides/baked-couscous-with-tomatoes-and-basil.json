  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the couscous and boiling water, cover, and let stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Warm the olive oil in an oven-safe skillet or baking dish. Stir in the garlic, red bell pepper, green onions, and black pepper; cook briefly until fragrant."
    },
    {
      "step": 4,
      "text": "Stir in the couscous, cherry tomatoes, basil, salt, and black pepper. Add the balsamic vinegar and mix well."
    },
    {
      "step": 5,
      "text": "Bake until heated through, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Sprinkle with the grated Parmesan cheese and serve warm."
    }
  ],
