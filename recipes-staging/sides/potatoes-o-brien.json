    "prep_minutes": 15,
    "cook_minutes": 30,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "russet-baking-potatoes",
      "item": "russet (baking) potatoes",
      "quantity": 6,
      "unit": "large"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "cut into 1/2-inch dice"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 1,
      "unit": "large",
      "preparation": "cut into 1/2-inch dice"
    },
    {
      "ingredient_id": "red-bell-pepper",
      "item": "red bell pepper",
      "quantity": 1,
      "unit": "large",
      "preparation": "cut into 1/2-inch dice"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes in a pot, cover with water, and bring to a simmer until partly tender."
    },
    {
      "step": 2,
      "text": "Drain the potatoes and let them cool for 30 minutes. Dice them into bite-size pieces.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat the oven to 425°F.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Combine the potatoes, onion, green bell pepper, and red bell pepper. Add the vegetable oil and stir until evenly coated."
    },
    {
      "step": 5,
      "text": "Spread the mixture on a baking sheet and roast until golden brown, about 20 minutes.",
      "timer_minutes": 20
    }
  ],
