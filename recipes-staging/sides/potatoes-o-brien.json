  "id": "potatoes-o-brien",
  "name": "Potatoes O'Brien",
  "subtitle": "Crisp roasted potatoes with peppers and onion",
  "description": "Parboiled potatoes are cooled, diced, mixed with peppers and onion, coated in oil, and roasted until golden brown.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
