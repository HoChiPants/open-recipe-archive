  "id": "purple-hull-peas-with-okra-and-bacon",
  "name": "Purple Hull Peas with Okra and Bacon",
  "subtitle": "A savory simmered Southern-style vegetable side",
  "description": "Purple hull peas and okra simmer with bacon, sugar, and simple seasoning until tender.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-purple-hull-peas",
      "item": "frozen purple hull peas",
      "quantity": 1.5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "water-to-cover",
      "item": "water to cover"
    },
    {
      "ingredient_id": "fresh-okra",
      "item": "fresh okra",
      "quantity": 8,
      "unit": "ounces"
    },
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "cut into 1/2 inch pieces"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the frozen purple hull peas in a large pot and add enough water to cover them."
    },
    {
      "step": 2,
      "text": "Warm a skillet, add the fresh okra, and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the bacon, white sugar, baking soda, and salt and pepper to the pot with the peas."
    },
    {
      "step": 4,
      "text": "Bring the pot to a simmer and cook until the peas are tender, about 2 hours.",
      "timer_minutes": 120
    }
  ],
