      "item": "small uncooked seashell pasta",
      "quantity": 4,
      "unit": "ounces"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra virgin olive oil",
