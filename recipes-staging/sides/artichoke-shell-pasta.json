  "id": "artichoke-shell-pasta",
  "name": "Artichoke Shell Pasta",
  "subtitle": "Tender pasta with garlicky artichokes and basil",
  "description": "A quick Italian-inspired side combining shell pasta with buttery, olive-oil-sautéed artichokes, garlic, and fresh basil.",
  "meal_type": "side",
