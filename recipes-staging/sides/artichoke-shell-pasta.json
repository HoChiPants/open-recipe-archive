  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer and add the pasta. Cook for 10 minutes, or until tender.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "While the pasta cooks, heat the butter and olive oil in a skillet. Add the artichoke hearts, garlic, and chopped basil."
    },
    {
      "step": 3,
      "text": "Stir the artichoke mixture over medium heat for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Drain the pasta and add it to the skillet. Toss with the artichoke mixture until combined, then serve."
    }
  ],
