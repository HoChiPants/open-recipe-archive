  "id": "thyme-roasted-brussels-sprouts-with-fresh-cranberries",
  "name": "Thyme-Roasted Brussels Sprouts with Fresh Cranberries",
  "subtitle": "A savory-sweet roasted vegetable side",
  "description": "Brussels sprouts roast with thyme and cranberries, then finish with maple syrup for a bright, lightly sweet side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "brussels-sprouts",
      "item": "Brussels sprouts",
      "quantity": 1,
      "unit": "pound",
      "preparation": "trimmed and halved"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fresh-thyme",
      "item": "fresh thyme",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "fresh-cranberries",
      "item": "fresh cranberries",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "pure-maple-syrup",
      "item": "pure maple syrup",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Toss the Brussels sprouts with olive oil, thyme, salt, and pepper in a bowl."
    },
    {
      "step": 3,
      "text": "Spread the sprouts in a single layer on a baking sheet."
    },
    {
      "step": 4,
      "text": "Roast for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir in the cranberries and continue roasting for 10 minutes, until the sprouts are tender and browned and the cranberries have softened.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Transfer the roasted vegetables to a serving dish and toss with the maple syrup."
    }
  ],
