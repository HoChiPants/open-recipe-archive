    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "whole-kernel-corn",
      "item": "whole kernel corn",
      "quantity": 1,
      "unit": "can",
      "preparation": "15.25 ounce, with liquid"
    },
    {
      "ingredient_id": "cream-style-corn",
      "item": "cream style corn",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.75 ounce"
    },
    {
      "ingredient_id": "small-uncooked-seashell-pasta",
      "item": "small uncooked seashell pasta",
