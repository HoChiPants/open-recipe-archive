      "preparation": "cut into pieces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the whole kernel corn with its liquid, cream-style corn, uncooked pasta, cubed cheese, and butter until combined."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a baking dish."
    },
    {
      "step": 4,
      "text": "Bake for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Stir, then bake for 30 minutes more, until the pasta is tender.",
      "timer_minutes": 30
    }
