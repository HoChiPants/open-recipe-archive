  "id": "macaroni-corn-casserole",
  "name": "Macaroni Corn Casserole",
  "subtitle": "A creamy baked corn and pasta side",
  "description": "Corn, shell pasta, cheese, and butter bake together into a warm, spoonable casserole.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
