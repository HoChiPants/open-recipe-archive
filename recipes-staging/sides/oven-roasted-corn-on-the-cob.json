  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Cut the prepared corn ears as needed for serving and arrange them in a baking dish."
    },
    {
      "step": 3,
      "text": "Stir the mayonnaise, Parmesan, chili powder, black pepper, and parsley until thick and evenly combined."
    },
    {
      "step": 4,
      "text": "Spread the mixture over the corn, coating the pieces evenly."
    },
    {
      "step": 5,
      "text": "Bake until the topping is hot and lightly browned.",
      "timer_minutes": 10
    }
