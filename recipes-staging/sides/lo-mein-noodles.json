  "instructions": [
    {
      "step": 1,
      "text": "Cook the spaghetti in boiling water until tender, about 12 minutes. Drain and let cool briefly.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Whisk the soy sauce, teriyaki sauce, honey, and ground ginger together; set aside."
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil in a large skillet. Stir-fry the celery, carrots, sweet onion, and green onions until tender, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Add the spaghetti and sauce to the skillet. Toss and cook until the noodles are evenly coated, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
  ],
