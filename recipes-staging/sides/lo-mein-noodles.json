      "item": "low-sodium soy sauce",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "teriyaki-sauce",
      "item": "teriyaki sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
