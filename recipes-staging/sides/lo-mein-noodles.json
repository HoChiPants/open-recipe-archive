  "id": "lo-mein-noodles",
  "name": "Lo Mein Noodles",
  "subtitle": "Savory noodles with crisp-tender vegetables",
  "description": "Spaghetti is tossed with a sweet-savory soy and teriyaki sauce, celery, carrots, and onions for an easy vegetable noodle side.",
  "meal_type": "side",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
