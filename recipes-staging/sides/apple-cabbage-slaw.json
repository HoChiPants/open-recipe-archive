  "id": "apple-cabbage-slaw",
  "name": "Apple Cabbage Slaw",
  "subtitle": "Crisp cabbage and apple with a tangy mustard dressing",
  "description": "A fresh cabbage slaw balanced with tart apple, green onion, and a gently simmered cider dressing.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "head-cabbage",
      "item": "head cabbage",
      "quantity": 1,
      "unit": "small",
      "preparation": "cored and finely chopped"
    },
    {
      "ingredient_id": "granny-smith-apple",
      "item": "Granny Smith apple",
      "quantity": 1,
      "preparation": "cut into matchstick-size pieces"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 5,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "apple-cider-vinegar",
      "item": "apple cider vinegar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the vinegar, sugar, olive oil, vegetable oil, mustard, and red pepper flakes in a saucepan. Bring the mixture to a simmer, stirring until blended.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Toss the cabbage, apple, and green onions in a large bowl. Pour the warm dressing over the cabbage mixture and mix until evenly coated."
    },
    {
      "step": 3,
      "text": "Cover and refrigerate the slaw for at least 60 minutes before serving.",
      "timer_minutes": 60
    }
  ],
