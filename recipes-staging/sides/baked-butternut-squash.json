  "id": "baked-butternut-squash",
  "name": "Baked Butternut Squash",
  "subtitle": "Tender roasted squash finished with butter and seasoning",
  "description": "Bake halved butternut squash until tender, then cut or scoop the flesh and season it with butter, salt, and pepper.",
  "meal_type": "side",
