    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the squash halves in a baking dish with the cut sides facing up."
    },
    {
      "step": 3,
      "text": "Bake until the squash is tender when pierced with a fork, about 90 minutes.",
      "timer_minutes": 90
    },
    {
      "step": 4,
      "text": "Cut the cooked squash into pieces or scoop the flesh from the skins."
    },
    {
      "step": 5,
      "text": "Add the butter pieces and season with salt and ground black pepper to taste."
    }
