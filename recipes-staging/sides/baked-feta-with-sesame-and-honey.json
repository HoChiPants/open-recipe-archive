      "item": "warmed pitta breads to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Place the block feta in a small baking dish. Drizzle with the honey and olive oil, then scatter over the toasted sesame seeds and oregano."
    },
    {
      "step": 3,
      "text": "Bake for 20 minutes, until the feta is warm and softened.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Drizzle with extra honey and serve with warmed pitta breads."
    }
  ],
