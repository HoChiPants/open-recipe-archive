  "id": "baked-feta-with-sesame-and-honey",
  "name": "Baked Feta with Sesame and Honey",
  "subtitle": "Warm feta with toasted sesame, oregano, and honey",
  "description": "Bake feta until warm and soft, then finish it with sesame, oregano, olive oil, and honey. Serve with warmed pitta breads.",
  "meal_type": "side",
  "cuisine": "Greek",
  "yield": {
    "quantity": 4,
