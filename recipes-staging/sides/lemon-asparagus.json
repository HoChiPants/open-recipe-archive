  "schema_version": "1.0.0",
  "id": "lemon-asparagus",
  "name": "Lemon Asparagus",
  "subtitle": "Roasted asparagus with bright lemon butter",
  "description": "Tender asparagus is roasted until lightly browned, then finished with a simple lemon-butter seasoning.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "bunch-fresh-asparagus",
      "item": "bunch fresh asparagus",
      "quantity": 1,
      "preparation": "trimmed"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Toss the trimmed asparagus with the vegetable oil, then season with salt and ground black pepper to taste."
    },
    {
      "step": 3,
      "text": "Roast the asparagus until lightly browned, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Combine the lemon juice, butter, measured salt, and measured ground black pepper in a small saucepan."
    },
    {
      "step": 5,
      "text": "Warm the mixture for 1 minute, until the butter melts, then stir to combine.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Toss the roasted asparagus with the lemon-butter mixture and serve."
    }
  ],
