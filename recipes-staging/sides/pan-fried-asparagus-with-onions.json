  "instructions": [
    {
      "step": 1,
      "text": "Melt 1 tablespoon of butter in a large skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the asparagus and cook, stirring, until the butter is melted and the asparagus is coated, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Add the remaining butter, sliced onion, and onion salt. Stir to combine."
    },
    {
      "step": 4,
      "text": "Cook, stirring occasionally, until the asparagus is tender and the onion is softened, about 5 minutes.",
      "timer_minutes": 5
    }
