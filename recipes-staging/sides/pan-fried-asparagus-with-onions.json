  "id": "pan-fried-asparagus-with-onions",
  "name": "Pan-Fried Asparagus with Onions",
  "subtitle": "Tender asparagus with sweet sautéed onion",
  "description": "A quick stovetop side dish of asparagus and sliced onion finished with a light seasoning of onion salt.",
  "meal_type": "side",
