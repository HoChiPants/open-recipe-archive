  "id": "chargrilled-butter-cabbage",
  "name": "Chargrilled Butter Cabbage",
  "subtitle": "Tender cabbage wedges with lime, garlic, and chilli butter",
  "description": "Cabbage wedges are chargrilled until tender, then finished with a bright, spicy butter dressing.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 8,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "white-cabbage",
      "item": "white cabbage",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "butter",
      "item": "salted butter",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "rapeseed-oil",
      "item": "rapeseed oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-clove-crushed",
      "item": "garlic clove crushed",
      "quantity": 1
    },
    {
      "ingredient_id": "ingredient-4",
      "item": "⁄4",
      "quantity": 1,
      "preparation": "1 chilli (scotch bonnet works well), deseeded and finely chopped"
    },
    {
      "ingredient_id": "limes-zested-and-juiced",
      "item": "limes zested and juiced",
      "quantity": 2
    },
    {
      "ingredient_id": "2-tsp-ground-white-pepper",
      "item": "⁄2 tsp ground white pepper",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the cabbage into thick wedges, keeping the core attached so the wedges hold together."
    },
    {
      "step": 2,
      "text": "Preheat a grill or barbecue to high heat. Melt the salted butter gently, then stir in the crushed garlic, chopped chilli, lime zest and juice, and ground white pepper."
    },
    {
      "step": 3,
      "text": "Brush the cabbage wedges with rapeseed oil and grill, turning as needed, until deeply charred and tender throughout.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Spoon the warm butter mixture over the grilled cabbage and serve immediately."
    }
  ],
