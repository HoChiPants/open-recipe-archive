{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "norwegian-potato-lefsa",
  "name": "Norwegian Potato Lefsa",
  "subtitle": "Tender potato flatbreads with a lightly sweet finish",
  "description": "Boiled potatoes are combined with dairy, seasoning, and flour, then chilled, rolled thin, and cooked on a hot dry surface.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "baking-potatoes",
      "item": "baking potatoes",
      "quantity": 18,
      "preparation": "scrubbed"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the scrubbed potatoes in a pot, cover with water, and simmer until tender. Drain well."
    },
    {
      "step": 2,
      "text": "While hot, mash the potatoes with the cream, butter, salt, and sugar until smooth."
    },
    {
      "step": 3,
      "text": "Cool, cover, and chill the potato mixture for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Mix the chilled potatoes with the flour to form a soft dough."
    },
    {
      "step": 5,
      "text": "Divide the dough into 8 portions. On a flour-dusted surface, roll each portion into a very thin round."
    },
    {
      "step": 6,
      "text": "Preheat a dry griddle or large skillet over medium-high heat."
    },
    {
      "step": 7,
      "text": "Cook the rounds one at a time until lightly browned in spots and cooked through, turning once."
    },
    {
      "step": 8,
      "text": "Fold the lefse and serve warm or at room temperature."
    }
  ],
