  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot or skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the onion, garlic, cayenne pepper, green bell pepper, and salt and black pepper. Stir for 1 minute, then cook until the pepper is tender, about 5 minutes.",
