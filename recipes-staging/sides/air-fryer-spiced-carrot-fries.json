  "instructions": [
    {
      "step": 1,
      "text": "Cut the carrots into fry-shaped sticks."
    },
    {
      "step": 2,
      "text": "Combine the paprika, garlic powder, onion granules, and potato starch. Toss the carrot sticks with the spice mixture, then stir in the olive oil until evenly coated."
    },
    {
      "step": 3,
      "text": "Preheat the air fryer according to the appliance instructions."
    },
    {
      "step": 4,
      "text": "Arrange the carrots in the air-fryer basket in a single layer and cook for 20 minutes, or until tender with browned edges.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Stir together the natural yogurt, garlic powder, lemon juice, and chopped mint."
    },
    {
      "step": 6,
      "text": "Serve the hot carrot fries with the yogurt sauce."
    }
  ],
