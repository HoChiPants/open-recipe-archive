{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "parmesan-zucchini-fries",
  "name": "Parmesan Zucchini Fries",
  "subtitle": "Herb-seasoned zucchini strips with a crisp cheese coating",
  "description": "Zucchini strips are dipped in egg, coated with seasoned Parmesan, and baked until tender and golden.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "dried-mixed-herbs",
      "item": "dried mixed herbs",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "zucchinis",
      "item": "zucchinis",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "cut into 1/2-inch French fry strips"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Lightly coat a baking sheet with cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk the eggs in a shallow bowl. In a separate shallow bowl, combine the Parmesan, dried herbs, garlic powder, paprika, and black pepper."
    },
    {
      "step": 3,
      "text": "Dip each zucchini strip in the egg, then turn it in the Parmesan mixture to coat. Arrange the strips in a single layer on the prepared baking sheet."
    },
    {
      "step": 4,
      "text": "Bake until the zucchini is tender and the coating is golden, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
