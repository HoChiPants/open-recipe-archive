  "instructions": [
    {
      "step": 1,
      "text": "Shred the trimmed, peeled beets."
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan over medium heat. Add the beets and stir for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pour in the water, cover if needed, and simmer the beets until tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the balsamic vinegar and season with salt and ground black pepper to taste."
    }
