  "id": "bone-marrow-stuffing",
  "name": "Bone Marrow Stuffing",
  "subtitle": "Savory breadcrumb stuffing with herbs and diced marrow",
  "description": "A rich, herb-flecked stuffing made with sautéed onion, bone marrow, and crisp white breadcrumbs.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "rapeseed-oil",
      "item": "rapeseed oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "onion-finely-chopped",
      "item": "onion finely chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "dried-white-breadcrumbs",
      "item": "dried white breadcrumbs",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "bone-marrow-meat-ask-your-butcher-for-this-cut-into-2cm-dice",
      "item": "bone marrow meat (ask your butcher for this) cut into 2cm dice",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "bunch-thyme-leaves-finely-chopped",
      "item": "bunch thyme leaves finely chopped",
      "unit": "small"
    },
    {
      "ingredient_id": "bunch-parsley-roughly-chopped",
      "item": "bunch parsley roughly chopped",
      "unit": "small"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and lightly grease a baking dish."
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a pan. Add the onion and diced bone marrow meat, then sauté for 10 minutes, until the onion softens and the meat is cooked through.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Combine the sautéed mixture with the breadcrumbs, thyme, and parsley. Transfer to the prepared dish and spread evenly."
    },
    {
      "step": 4,
      "text": "Bake for 35 minutes, until golden brown and the center reaches 165°F.",
      "timer_minutes": 35
    }
  ],
