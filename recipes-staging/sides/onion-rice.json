{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "onion-rice",
  "name": "Onion Rice",
  "subtitle": "Savory rice with tender red onion",
  "description": "Long-grain white rice is simmered with sautéed red onion, pepper, and chicken broth for a simple side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "long-grain-white-rice",
      "item": "long-grain white rice",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Add the oil and red onion. Stir until the onion is tender."
    },
    {
      "step": 3,
      "text": "Stir in the rice and cook briefly to coat the grains."
    },
    {
      "step": 4,
      "text": "Add the pepper and chicken broth. Bring to a simmer."
    },
    {
      "step": 5,
      "text": "Cover and simmer until the rice is tender and the liquid is absorbed, about 20 minutes. If the broth contains poultry pieces, verify the mixture reaches 165°F.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Remove from the heat and let stand briefly before serving."
    }
  ],
