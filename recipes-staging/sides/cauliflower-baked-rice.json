  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Cut the cauliflower into small florets. Keep the chopped mint ready for finishing."
    },
    {
      "step": 3,
      "text": "Toss the cauliflower and sliced red onion with the olive oil, then arrange them in a baking dish."
    },
    {
      "step": 4,
      "text": "Prepare the basmati rice until tender, following the package method, and mix in the dried fruit."
    },
    {
      "step": 5,
      "text": "Layer the rice over the cauliflower and onion. Bake until hot and lightly browned.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Whisk the white wine vinegar, extra virgin olive oil, honey, and crushed garlic together."
    },
    {
      "step": 7,
      "text": "Combine the dressing with the chopped shallots, olives, and feta."
    },
    {
      "step": 8,
      "text": "Add the mixture to the baked rice and fold gently. Scatter over the mint and chopped parsley, then garnish with the whole parsley leaves."
    }
  ],
