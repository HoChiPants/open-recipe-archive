{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "grilled-hearts-of-romaine",
  "name": "Grilled Hearts of Romaine",
  "subtitle": "Charred lettuce with cheese and tangy vinegar dressing",
  "description": "Romaine hearts are lightly grilled, then finished with Parmigiano-Reggiano and a two-vinegar dressing.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "romaine-lettuce-hearts",
      "item": "romaine lettuce hearts",
      "quantity": 3,
      "preparation": "halved lengthwise"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "divided, or as needed"
    },
    {
      "ingredient_id": "freshly-grated-parmigiano-reggiano-cheese",
      "item": "freshly grated Parmigiano-Reggiano cheese",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "sherry-vinegar",
      "item": "sherry vinegar",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill to medium-high heat."
    },
    {
      "step": 2,
      "text": "Brush the cut sides of the romaine hearts with the divided 1 tablespoon olive oil."
    },
    {
      "step": 3,
      "text": "Place the romaine cut-side down on the grill and cook until lightly charred, about 2 minutes. Turn and grill until just wilted.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Arrange the grilled romaine on a serving platter. Drizzle with the remaining olive oil, balsamic vinegar, and sherry vinegar, then sprinkle with Parmigiano-Reggiano."
    }
  ],
