  "id": "baked-cheesy-potatoes",
  "name": "Baked Cheesy Potatoes",
  "subtitle": "A creamy, savory potato casserole with bacon",
  "description": "Thawed hash brown potatoes are combined with melted cheese, mayonnaise, onion, and bacon bits, then baked until hot and golden.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "processed-cheese",
      "item": "processed cheese",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "frozen-hash-brown-potatoes",
      "item": "frozen hash brown potatoes",
      "quantity": 1,
      "unit": "package",
      "preparation": "2 pound, thawed"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "white-onion",
      "item": "white onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "3-ounce-jar-real-bacon-bits",
      "item": "(3 ounce) jar real bacon bits",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Melt the processed cheese until smooth."
    },
    {
      "step": 3,
      "text": "Stir together the thawed hash brown potatoes, mayonnaise, and chopped onion. Add the bacon bits and melted cheese, mixing until evenly combined."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish and bake at 350°F for 60 minutes, until hot throughout and lightly browned.",
      "timer_minutes": 60
    }
  ],
