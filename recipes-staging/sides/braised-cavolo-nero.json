  "id": "braised-cavolo-nero",
  "name": "Braised Cavolo Nero",
  "subtitle": "Tender greens with garlic, chilli, and white wine",
  "description": "A quick braise that softens cavolo nero or kale while adding savory garlic, gentle heat, and wine.",
  "meal_type": "side",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-clove-finely-sliced",
      "item": "garlic clove finely sliced",
      "quantity": 1
    },
    {
      "ingredient_id": "red-chilli",
      "item": "red chilli",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "cavolo-nero-or-kale",
      "item": "cavolo nero or kale",
      "quantity": 200,
      "unit": "g",
      "preparation": "stalks removed and chopped"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 100,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a pan over medium heat. Add the finely sliced garlic and red chilli, and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Add the chopped greens and stir to coat."
    },
    {
      "step": 3,
      "text": "Pour in the white wine, cover, and cook for 8 minutes, until the greens are tender.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Serve warm with the cooked chilli."
    }
  ],
