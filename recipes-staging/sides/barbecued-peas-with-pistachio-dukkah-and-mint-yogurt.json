  "instructions": [
    {
      "step": 1,
      "text": "Warm a dry frying pan over medium heat. Toast the pistachios for 2 minutes, then add the coriander seeds, cumin seeds, and sesame seeds and toast for 2 minutes more, stirring, until golden brown.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Stir in the chilli flakes and 1 tsp sea salt flakes. Crush or pulse the toasted mixture into a coarse dukkah."
    },
    {
      "step": 3,
      "text": "Mix the preserved lemon paste, garlic, chopped mint, and yogurt with the remaining 1 tsp sea salt flakes."
    },
    {
      "step": 4,
      "text": "Heat a barbecue or grill. Toss the peas in their pods with the olive or rapeseed oil and grill for about 3 minutes, turning as needed, until lightly charred and tender.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Transfer the peas to a serving dish. Spoon over the mint yogurt, scatter with dukkah, and finish with the extra virgin olive oil."
    }
  ],
