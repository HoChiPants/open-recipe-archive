  "id": "red-bell-pepper-coulis",
  "name": "Red Bell Pepper Coulis",
  "subtitle": "A smooth pepper sauce with shallots and sour cream",
  "description": "Sweet red peppers and shallots are softened, simmered with wine and broth, then blended with sour cream into a silky sauce.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "red-bell-peppers",
      "item": "red bell peppers",
      "quantity": 2,
      "preparation": "seeded and chopped"
    },
    {
      "ingredient_id": "shallots",
      "item": "shallots",
      "quantity": 2,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a saucepan over medium heat. Add the peppers and shallots, and sauté until softened.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Add the white wine and chicken broth. Bring the mixture to 165°F, then simmer until the vegetables are tender and the liquid is slightly reduced.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Whisk in the sour cream. Blend the mixture until smooth, then serve warm."
    }
  ],
