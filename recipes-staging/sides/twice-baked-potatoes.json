  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Bake the potatoes for 60 minutes, then let them cool for 10 minutes.",
      "timer_minutes": 70
    },
    {
      "step": 2,
      "text": "Cook the bacon in a skillet until crisp; drain and crumble it."
    },
    {
      "step": 3,
      "text": "Cut the potatoes in half lengthwise and scoop out the centers, leaving the skins intact."
    },
    {
      "step": 4,
      "text": "Mash or blend the potato centers with the sour cream, milk, salt, pepper, 0.5 cup shredded Cheddar, and 4 sliced green onions."
    },
    {
      "step": 5,
      "text": "Fold in the cooked bacon. Spoon the filling into the potato skins and place them on a baking sheet."
    },
    {
      "step": 6,
      "text": "Top with the remaining 0.5 cup shredded Cheddar and 4 sliced green onions. Bake for 15 minutes, until the cheese is melted and the filling is hot.",
      "timer_minutes": 15
    }
  ],
