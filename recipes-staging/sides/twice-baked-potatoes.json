  "id": "twice-baked-potatoes",
  "name": "Twice-Baked Potatoes",
  "subtitle": "Creamy stuffed potatoes with bacon and cheddar",
  "description": "Baked potato shells are filled with seasoned potato, sour cream, milk, bacon, cheddar, and green onions, then baked again until hot and melted.",
  "meal_type": "side",
