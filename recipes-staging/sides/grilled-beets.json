  "id": "grilled-beets",
  "name": "Grilled Beets",
  "subtitle": "Tender beets with buttery seasoning",
  "description": "Whole scrubbed beets are grilled with butter, salt, and pepper until tender, then cooled briefly before serving.",
  "meal_type": "side",
  "cuisine": "American",
