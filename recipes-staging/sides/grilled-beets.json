    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Lightly coat a sheet of heavy-duty foil with cooking spray."
    },
    {
      "step": 2,
      "text": "Place the scrubbed beets and butter on the foil, season with salt and pepper, and fold the foil into a sealed packet."
    },
    {
      "step": 3,
      "text": "Grill the packet until the beets are tender when pierced with a knife, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Let the beets cool for 5 minutes, then serve.",
      "timer_minutes": 5
    }
