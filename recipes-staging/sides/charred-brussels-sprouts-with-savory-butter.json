  "id": "charred-brussels-sprouts-with-savory-butter",
  "name": "Charred Brussels Sprouts with Savory Butter",
  "subtitle": "Tender sprouts with browned edges and rich umami butter",
  "description": "Briefly simmered Brussels sprouts are coated in savory butter and cooked over high heat until charred at the edges.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-softened",
      "item": "unsalted butter softened",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "marmite",
      "item": "Marmite",
      "quantity": 3,
      "unit": "tsp"
    },
    {
      "ingredient_id": "brussels-sprouts-halved",
      "item": "brussels sprouts halved",
      "quantity": 500,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened butter and Marmite until smooth. Chill until firm enough to handle."
    },
    {
      "step": 2,
      "text": "Bring a saucepan of water to a simmer. Add the halved Brussels sprouts and simmer for 4 minutes, then drain well.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Preheat a large skillet or roasting pan over high heat for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the chilled butter mixture to the hot pan and let it melt. Add the sprouts and coat them in the butter."
    },
    {
      "step": 5,
      "text": "Cook the sprouts over high heat until browned and charred at the edges, then serve hot."
    }
  ],
