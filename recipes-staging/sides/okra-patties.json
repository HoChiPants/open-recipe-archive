  "instructions": [
    {
      "step": 1,
      "text": "Heat the frying oil to 375°F in a deep, heavy pan."
    },
    {
      "step": 2,
      "text": "Combine the okra, onion, water, salt, and pepper in a saucepan. Cook over medium heat for 2 minutes, then transfer to a bowl and let cool briefly.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Beat in the egg. Stir in the flour, cornmeal, and baking powder until a cohesive mixture forms."
    },
    {
      "step": 4,
      "text": "Shape the mixture into six patties."
    },
    {
      "step": 5,
      "text": "Fry the patties in batches until browned on both sides and firm in the center. Confirm the center reaches 160°F before serving."
    }
  ],
