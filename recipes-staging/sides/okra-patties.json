  "id": "okra-patties",
  "name": "Okra Patties",
  "subtitle": "Crisp vegetable patties with cornmeal coating",
  "description": "Chopped okra and onion form tender, savory patties with a crisp fried exterior.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
