{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "gruyere-mashed-potato-casserole",
  "name": "Gruyere Mashed Potato Casserole",
  "subtitle": "Creamy baked potatoes with whipped cream and two cheeses",
  "description": "Tender russet potatoes are enriched with butter, buttermilk, Gruyere, and Parmigiano-Reggiano, then folded with whipped cream and baked until lightly browned.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "russet-potatoes",
      "item": "russet potatoes",
      "quantity": 4,
      "unit": "large",
      "preparation": "peeled and quartered"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 6,
      "unit": "tablespoons",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "kosher-salt-to-taste",
      "item": "kosher salt to taste"
    },
    {
      "ingredient_id": "grated-gruyere-cheese",
      "item": "grated Gruyere cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "finely-grated-parmigiano-reggiano-cheese",
      "item": "finely grated Parmigiano-Reggiano cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cold-heavy-cream",
      "item": "cold heavy cream",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 475°F. Place the potatoes in a pot, cover with salted water, and simmer until tender, about 20 minutes. Drain well.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Return the potatoes to the warm pot. Add the butter, Gruyere, buttermilk, cayenne, salt, and half of the Parmigiano-Reggiano. Mash until smooth."
    },
    {
      "step": 3,
      "text": "Whisk the cold heavy cream until thick, about 2 minutes, then gently fold it into the mashed potatoes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Transfer the potatoes to a buttered baking dish, sprinkle with the remaining Parmigiano-Reggiano, and bake until heated through and lightly browned, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Let the casserole rest for 5 minutes, then scatter the green onions over the top and serve.",
      "timer_minutes": 5
    }
  ],
