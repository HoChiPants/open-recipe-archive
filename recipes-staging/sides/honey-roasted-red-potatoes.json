      "unit": "pinch"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Arrange the quartered potatoes and diced onion in a baking dish."
    },
    {
      "step": 3,
      "text": "Combine the melted butter, honey, dry mustard, salt, and black pepper."
    },
    {
      "step": 4,
      "text": "Pour the mixture over the potatoes and onion, then toss to coat evenly."
    },
    {
      "step": 5,
      "text": "Bake for 35 minutes, until the potatoes are tender.",
      "timer_minutes": 35
    }
  ],
