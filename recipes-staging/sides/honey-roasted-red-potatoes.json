    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "red-potatoes",
      "item": "red potatoes",
      "quantity": 1,
      "unit": "pound",
      "preparation": "quartered"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "diced"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "dry-mustard",
      "item": "dry mustard",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
