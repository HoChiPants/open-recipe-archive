  "id": "garlic-baby-bok-choy",
  "name": "Garlic Baby Bok Choy",
  "subtitle": "Tender greens with soy, sesame, and black pepper",
  "description": "Baby bok choy is quickly sautéed with garlic, seasoned with soy sauce and sugar, then steamed until tender and finished with sesame oil.",
  "meal_type": "side",
  "cuisine": "Chinese",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "minced"
    },
    {
      "ingredient_id": "baby-bok-choy",
      "item": "baby bok choy",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "light-soy-sauce",
      "item": "light soy sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the canola oil in a large skillet over medium-high heat. Add the garlic and stir briefly until fragrant."
    },
    {
      "step": 2,
      "text": "Add the baby bok choy, light soy sauce, white sugar, and salt. Toss to coat and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the water, cover, and cook until the bok choy is tender, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Remove from the heat and toss with the sesame oil and black pepper. Serve warm."
    }
  ],
