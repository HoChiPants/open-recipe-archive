  "id": "black-pepper-garlic-roasted-sweet-potatoes",
  "name": "Black Pepper & Garlic Roasted Sweet Potatoes",
  "subtitle": "Spicy roasted wedges with lime and coriander",
  "description": "Sweet potato wedges are roasted until tender with garlic, chilli, curry leaves, and olive oil, then finished with lime and fresh coriander.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "green-chilli-finely-chopped",
      "item": "green chilli finely chopped",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "fresh-or-dried-curry-leaves-roughly-chopped",
      "item": "fresh or dried curry leaves roughly chopped",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-cloves-crushed",
      "item": "garlic cloves crushed",
      "quantity": 4
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "lime-juiced",
      "item": "lime juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "sweet-potatoes-scrubbed-and-cut-into-wedges",
      "item": "sweet potatoes scrubbed and cut into wedges",
      "quantity": 1,
      "unit": "kg"
    },
    {
      "ingredient_id": "bunch-of-coriander-stalks-and-leaves-separated-and-roughly-chopped",
      "item": "bunch of coriander stalks and leaves separated and roughly chopped",
      "quantity": "1/2",
      "unit": "small"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Combine the green chilli, curry leaves, crushed garlic, olive oil, lime juice, and coriander stalks in a bowl."
    },
    {
      "step": 3,
      "text": "Toss the sweet potato wedges with the seasoning mixture and arrange them in a single layer on a roasting tray."
    },
    {
      "step": 4,
      "text": "Roast for 40 minutes, turning once, until the wedges are tender and browned.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Scatter the chopped coriander leaves over the roasted sweet potatoes and serve."
    }
  ],
