  "id": "boondi-raita",
  "name": "Boondi Raita",
  "subtitle": "Cooling yogurt with crisp boondi and mint",
  "description": "A simple Indian yogurt side seasoned with cumin, boondi, and fresh mint.",
  "meal_type": "side",
