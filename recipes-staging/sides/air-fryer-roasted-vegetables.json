  "id": "air-fryer-roasted-vegetables",
  "name": "Air-Fryer Roasted Vegetables",
  "subtitle": "A colorful mix of squash, potatoes, peppers, and onions",
  "description": "Mixed vegetables roast with garlic, thyme, and olive oil until tender and lightly browned.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
