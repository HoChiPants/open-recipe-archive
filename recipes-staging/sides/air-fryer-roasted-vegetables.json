  "instructions": [
    {
      "step": 1,
      "text": "Toss the red onion wedges with the olive oil. Add the squash, sweet potato, pepper, potatoes, garlic, and thyme, and mix to coat."
    },
    {
      "step": 2,
      "text": "Arrange the vegetables in the air fryer basket in an even layer. Roast for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Continue cooking for 20 minutes, shaking or turning the vegetables once or twice, until cooked through and lightly browned.",
      "timer_minutes": 20
    }
