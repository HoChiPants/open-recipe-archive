  "instructions": [
    {
      "step": 1,
      "text": "Heat the bacon for 4 minutes, turning as needed, until crisp. Set aside to cool, then chop or crumble.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Mix the cooled bacon with the softened butter and marmalade."
    },
    {
      "step": 3,
      "text": "Place the carrots in boiling water and simmer for 6 minutes, or until tender.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Drain the carrots and toss with the bacon butter until melted and evenly coated."
