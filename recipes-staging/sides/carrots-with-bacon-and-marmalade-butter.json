  "id": "carrots-with-bacon-and-marmalade-butter",
  "name": "Carrots with Bacon and Marmalade Butter",
  "subtitle": "Tender carrots with a savory-sweet butter topping",
  "description": "Cook sliced carrots until tender, then finish them with crisp bacon, softened butter, and fine-shred marmalade.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
