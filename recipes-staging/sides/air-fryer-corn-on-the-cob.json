  "id": "air-fryer-corn-on-the-cob",
  "name": "Air Fryer Corn on the Cob",
  "subtitle": "Smoky, lime-finished corn with parsley",
  "description": "Tender air-fried corn is seasoned with smoked paprika and onion powder, then finished with parsley and lime.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
