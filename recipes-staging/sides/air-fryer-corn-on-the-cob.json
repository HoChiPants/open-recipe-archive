      "item": "handful of chopped parsley"
    },
    {
      "ingredient_id": "lime-cut-into-wedges",
      "item": "lime cut into wedges",
      "quantity": 1,
      "preparation": "to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to the manufacturer's instructions."
    },
    {
      "step": 2,
      "text": "Toss the halved corn with the oil, smoked paprika, and onion powder until evenly coated."
    },
    {
      "step": 3,
      "text": "Air-fry the corn until tender and lightly browned, turning once during cooking, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Scatter with chopped parsley and serve with lime wedges."
    }
