  "ingredients": [
    {
      "ingredient_id": "corn-cobs-halved",
      "item": "corn cobs halved",
      "quantity": 2,
      "preparation": "or 4 pre-cut cobs"
    },
    {
      "ingredient_id": "vegetable-or-sunflower-oil",
      "item": "vegetable or sunflower oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "smoked-paprika",
      "item": "smoked paprika",
      "quantity": 1,
      "unit": "tsp"
    },
    {
