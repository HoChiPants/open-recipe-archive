  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil and butter in a large skillet. Add the onions and cook, stirring occasionally, until golden brown."
    },
    {
      "step": 2,
      "text": "Stir in the basil, black pepper, water, and chicken bouillon. Cook for 10 minutes, reaching 165°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the cooked pasta and toss until evenly coated and hot."
