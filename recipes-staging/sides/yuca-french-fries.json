  "id": "yuca-french-fries",
  "name": "Yuca French Fries",
  "subtitle": "Tender inside, crisp and golden",
  "description": "Simmered yuca is cut into thick fries, fried until golden, and finished with salt.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "yuca",
      "item": "yuca",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "peeled, and cut into 4 inch sections"
    },
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying",
      "quantity": 2,
      "unit": "quarts"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the yuca sections in a large pot and cover with water. Bring to a boil, then simmer for 30 minutes, until tender but not falling apart.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Drain the yuca and cut each section into fry-size sticks."
    },
    {
      "step": 3,
      "text": "Heat the oil to 375°F in a deep fryer or heavy pot, using a thermometer to monitor the temperature."
    },
    {
      "step": 4,
      "text": "Fry the yuca in batches for about 5 minutes, turning as needed, until golden brown.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Drain well and season with salt while hot. Serve immediately."
    }
  ],
