  "id": "acorn-squash-with-brown-sugar-butter",
  "name": "Acorn Squash with Brown Sugar Butter",
  "subtitle": "Tender squash with a simple sweet finish",
  "description": "Microwaved acorn squash is seasoned and finished with melted butter and brown sugar.",
  "meal_type": "side",
