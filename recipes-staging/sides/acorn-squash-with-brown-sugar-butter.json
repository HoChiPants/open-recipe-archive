  "instructions": [
    {
      "step": 1,
      "text": "Transfer the halved, seeded squash to a microwave-safe dish and cut into manageable portions if needed."
    },
    {
      "step": 2,
      "text": "Microwave for 20 minutes, or until tender. Drain any excess liquid and season with salt and pepper.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Transfer the divided butter and brown sugar to a grill-safe dish. Grill for 5 minutes, until the butter is melted, then combine.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Spoon the melted brown sugar butter over the warm squash and serve."
    }
