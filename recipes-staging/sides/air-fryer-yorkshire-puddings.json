  "id": "air-fryer-yorkshire-puddings",
  "name": "Air-Fryer Yorkshire Puddings",
  "subtitle": "Light, crisp puddings for a roast dinner",
  "description": "A simple British side made from a smooth egg batter cooked in hot oil until puffed and set.",
  "meal_type": "side",
  "cuisine": "British",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "sunflower-or-vegetable-oil",
      "item": "sunflower or vegetable oil",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 70,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 100,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to its instructions. Divide the oil among four heatproof pudding molds or wells and place them in the basket."
    },
    {
      "step": 2,
      "text": "Whisk the flour and eggs together. Gradually add the milk, whisking until the batter is smooth.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Carefully pour the batter into the hot oiled molds."
    },
    {
      "step": 4,
      "text": "Cook until puffed and beginning to set.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Continue cooking until the puddings are cooked through, with firm centers reaching 160°F if checked with a thermometer.",
      "timer_minutes": 5
    }
  ],
