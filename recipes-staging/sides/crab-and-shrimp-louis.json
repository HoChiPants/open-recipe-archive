  "instructions": [
    {
      "step": 1,
      "text": "Place the eggs in a saucepan, cover with water, and bring to a simmer. Cook until the centers are firm and fully set, about 10–12 minutes; cool, peel, and slice.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Combine the mayonnaise, hot chile sauce, sweet pickle relish, salt, and pepper in a bowl."
    },
    {
      "step": 3,
      "text": "Arrange the shredded lettuce, tomatoes, avocado, and cucumber on four plates. Top with the crabmeat and cooked shrimp, then add the sliced eggs."
    },
    {
      "step": 4,
      "text": "Spoon the dressing over the salads and garnish with parsley and lemon wedges. If the crabmeat was raw, cook it until opaque before serving."
    }
  ],
