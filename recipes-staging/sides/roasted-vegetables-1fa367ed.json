  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 475°F."
    },
    {
      "step": 2,
      "text": "Arrange the squash, potatoes, bell peppers, sweet potato, and onion in a large roasting pan or on a large rimmed baking sheet. Season with salt and pepper."
    },
    {
      "step": 3,
      "text": "Stir together the olive oil, balsamic vinegar, rosemary, and thyme, then toss with the vegetables until evenly coated."
    },
    {
      "step": 4,
      "text": "Spread the vegetables in an even layer. Roast, stirring about every 10 minutes, until all vegetables are tender and cooked through, about 35 minutes total.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
  ],
