  "id": "cheesy-bunny-buns",
  "name": "Cheesy Bunny Buns",
  "subtitle": "Soft savory buns with cheddar and chives",
  "description": "Shape a yeasted dough into bunny buns, fill with buttery cheddar and chives, then bake until golden.",
  "meal_type": "side",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "milk-plus-a-drizzle",
      "item": "milk plus a drizzle",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "strong-white-bread-flour-plus-extra-for-dusting",
      "item": "strong white bread flour plus extra for dusting",
      "quantity": 350,
      "unit": "g"
    },
    {
      "ingredient_id": "fast-action-dried-yeast",
      "item": "fast-action dried yeast",
      "quantity": 5,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "drizzle-of-flavourless-oil-like-rapeseed-or-sunflower",
      "item": "drizzle of flavourless oil like rapeseed or sunflower"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "mature-cheddar-grated",
      "item": "mature cheddar grated",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "bunch-of-chives-chopped",
      "item": "bunch of chives chopped",
      "unit": "small"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven as needed for baking the buns."
    },
    {
      "step": 2,
      "text": "Combine the flour, yeast, and sugar in a mixing bowl."
    },
    {
      "step": 3,
      "text": "Warm the milk with a drizzle of flavourless oil, then add it to the dry ingredients and mix into a dough."
    },
    {
      "step": 4,
      "text": "Knead the dough for 10 minutes, then continue kneading for 5 minutes until smooth and elastic.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Cover the dough and leave it to rise for 2 hours, or until expanded.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Dust the work surface with flour and turn out the dough. Divide and shape it into bunny forms."
    },
    {
      "step": 7,
      "text": "Combine the butter, grated cheddar, and chopped chives, then add the mixture to the shaped dough as filling."
    },
    {
      "step": 8,
      "text": "Refine the shapes and arrange the buns on a baking tray."
    },
    {
      "step": 9,
      "text": "Prepare the buns for baking, then cut and shape the dough to define the bunny features."
    },
    {
      "step": 10,
      "text": "Cover and leave the shaped buns to rise for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 11,
      "text": "Brush the buns with the milk mixture and bake for 25 minutes, until golden brown.",
      "timer_minutes": 25
    },
    {
      "step": 12,
      "text": "Cool briefly before serving."
    }
  ],
