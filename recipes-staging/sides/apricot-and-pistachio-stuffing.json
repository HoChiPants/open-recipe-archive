  "id": "apricot-and-pistachio-stuffing",
  "name": "Apricot and Pistachio Stuffing",
  "subtitle": "A savory bread stuffing with sweet apricots, pistachios, and sage.",
  "description": "Caramelized onions, dried fruit, nuts, and sage add layered flavor to this baked sourdough stuffing.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
