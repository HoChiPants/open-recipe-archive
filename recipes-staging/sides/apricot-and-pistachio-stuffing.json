  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Melt the unsalted butter with the olive oil. Add the onions and cook for 20 minutes, stirring occasionally, until softened. Add the garlic and cook for 1 minute.",
      "timer_minutes": 21
    },
    {
      "step": 3,
      "text": "Prepare the sourdough bread, then combine it with the onion mixture, pistachios, chopped sage, apricots, and beaten eggs."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish and bake until golden brown and the center reaches 165°F.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Melt the remaining unsalted butter with the sage leaves and add it to the baked stuffing. Finish with the pistachios."
    }
  ],
