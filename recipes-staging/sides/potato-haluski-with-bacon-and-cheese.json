{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "potato-haluski-with-bacon-and-cheese",
  "name": "Potato Haluski with Bacon and Cheese",
  "subtitle": "Tender potato dumplings finished with crisp bacon and melted cheese",
  "description": "A hearty Eastern European-style side dish combining potato dumplings, savory bacon, and shredded brick cheese.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 4,
      "unit": "small",
      "preparation": "peeled and coarsely chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "wisconsin-brick-cheese",
      "item": "Wisconsin brick cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon until crisp. Drain it, let it cool, and crumble or chop it.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Process or mash the potatoes until finely broken down. Stir in the flour, beaten eggs, baking powder, and salt to form a thick dough; let it stand until set.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Bring a large pot of salted water to a simmer. Cut small pieces of dough directly into the boiling water and cook until the dumplings are tender and their centers reach 160°F."
    },
    {
      "step": 4,
      "text": "Preheat the oven for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Combine the cooked dumplings with the bacon and shredded cheese in a baking dish."
    },
    {
      "step": 6,
      "text": "Bake until the cheese melts and the mixture is hot throughout."
    }
  ],
  "tags": [
    "side-dish",
    "potato",
