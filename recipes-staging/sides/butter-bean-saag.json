  "instructions": [
    {
      "step": 1,
      "text": "Heat the ghee or butter in a large pan over medium heat. Add the finely chopped onion and black mustard seeds; cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the grated ginger, grated garlic, chopped green chilli, and tomato purée. Add the ground cumin, ground coriander, and ground turmeric, then cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the dried fenugreek leaves, if using, and the frozen spinach. Stir well and simmer for 10 minutes, or until the mixture has thickened.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Fold in the drained butter beans and lemon juice, warming until heated through. Serve with chapatis and mango chutney."
    }
  ],
