  "id": "spinach-and-cauliflower-bhaji",
  "name": "Spinach and Cauliflower Bhaji",
  "subtitle": "A warmly spiced vegetable side with tender cauliflower and wilted spinach",
  "description": "Cauliflower and spinach simmer with tomatoes, aromatics, and warming spices for a savory vegetable dish.",
  "meal_type": "side",
