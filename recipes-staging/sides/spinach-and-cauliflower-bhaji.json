  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large pot over medium heat. Add the onions and cauliflower, and stir for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Add the coriander, garlic, cayenne, ginger, cumin, turmeric, salt, and black pepper. Stir briefly to coat the vegetables."
    },
    {
      "step": 3,
      "text": "Stir in the diced tomatoes and vegetable broth. Adjust the cayenne, salt, and black pepper to taste."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a simmer and cook for 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Stir in the spinach, then continue simmering until the cauliflower and spinach are tender, about 10 minutes.",
      "timer_minutes": 10
    }
  ],
