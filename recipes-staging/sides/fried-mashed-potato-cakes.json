  "id": "fried-mashed-potato-cakes",
  "name": "Fried Mashed Potato Cakes",
  "subtitle": "Crisp-edged cakes from cooled mashed potatoes",
  "description": "Shape seasoned mashed potatoes into small cakes and fry them until golden and fully set.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "leftover-mashed-potatoes",
      "item": "leftover mashed potatoes",
      "quantity": 1,
      "unit": "cup",
      "preparation": "cooled"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the cooled mashed potatoes, flour, and salt. Add the egg and mix until evenly incorporated."
    },
    {
      "step": 2,
      "text": "Shape the mixture into six small, even cakes."
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil in a skillet over medium heat."
    },
    {
      "step": 4,
      "text": "Add the cakes and cook for about 3 minutes per side, turning carefully, until browned and the centers are fully set; verify an egg-containing center reaches 160°F.",
      "timer_minutes": 3
    }
  ],
