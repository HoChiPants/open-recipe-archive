  "id": "roasted-cherry-tomatoes",
  "name": "Roasted Cherry Tomatoes",
  "subtitle": "Tender tomatoes with balsamic seasoning",
  "description": "Cherry tomatoes are coated in seasoned oil and balsamic vinegar, then roasted until tender.",
  "meal_type": "side",
  "cuisine": "American",
