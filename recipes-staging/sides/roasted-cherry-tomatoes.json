      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cherry-tomatoes",
      "item": "cherry tomatoes",
      "quantity": 3,
      "unit": "pints"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the olive oil, balsamic vinegar, salt, and pepper in a bowl."
    },
    {
      "step": 3,
      "text": "Add the cherry tomatoes and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Spread the tomatoes in a single layer in a baking dish or on a sheet pan."
    },
    {
      "step": 5,
      "text": "Roast for 35 minutes, or until tender.",
      "timer_minutes": 35
    }
