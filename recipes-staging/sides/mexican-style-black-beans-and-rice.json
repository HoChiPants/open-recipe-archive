  "instructions": [
    {
      "step": 1,
      "text": "Warm the coconut oil in a skillet over medium heat. Stir in the chili powder, garlic powder, cumin, and coriander, and cook briefly until fragrant."
    },
    {
      "step": 2,
      "text": "Add the chopped celery and cook, stirring occasionally, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Mix in the tomato, corn, oregano, and cilantro. Stir in the black beans and salsa."
    },
    {
      "step": 4,
      "text": "Add the water and simmer for 15 minutes, adding a little more water if needed to keep the mixture moist.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Warm the cooked rice, combine it with the bean mixture, and season with salt to taste."
    }
  ],
