{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "potato-roses",
  "name": "Potato Roses",
  "subtitle": "Crisp-edged potato spirals with rosemary and Parmesan",
  "description": "Thin Yukon Gold potato slices are layered into individual rosettes, seasoned with rosemary and spices, and baked with butter and Parmigiano-Reggiano until tender and golden.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "yukon-gold-potatoes",
      "item": "Yukon Gold potatoes",
      "quantity": 3,
      "unit": "pounds",
      "preparation": "no wider than a muffin tin cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "melted, or as needed, divided"
    },
    {
      "ingredient_id": "fresh-rosemary",
      "item": "fresh rosemary",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "grated-parmigiano-reggiano-cheese",
      "item": "grated Parmigiano-Reggiano cheese",
      "quantity": 0.75,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F and grease a 12-cup muffin tin with some of the melted butter."
    },
    {
      "step": 2,
      "text": "Slice the potatoes very thinly, keeping the slices no wider than a muffin tin cup."
    },
    {
      "step": 3,
      "text": "Combine the rosemary, salt, black pepper, and cayenne. Toss the potato slices with the seasoning and enough melted butter to coat.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Arrange overlapping potato slices in each muffin cup to form 12 roses. Sprinkle Parmigiano-Reggiano between the layers and over the tops, then brush with the remaining butter."
    },
    {
      "step": 5,
      "text": "Bake until the roses are cooked through and tender, about 45 minutes. Serve warm.",
      "timer_minutes": 45
    }
  ],
