  "id": "corn-simmered-in-milk",
  "name": "Corn Simmered in Milk",
  "subtitle": "Tender corn with a creamy, lightly sweet finish",
  "description": "Corn is simmered until tender in a rich milk mixture seasoned with sugar and butter.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "preparation": "or as needed to cover"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "ears-corn-on-the-cob",
      "item": "ears corn on the cob",
      "quantity": 8,
      "preparation": "husks and silk removed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Put the water in a large pot, using enough to cover the corn, and bring it to a simmer."
    },
    {
      "step": 2,
      "text": "Whisk together the milk, sugar, cream, and butter until combined."
    },
    {
      "step": 3,
      "text": "Add the milk mixture and corn to the simmering water."
    },
    {
      "step": 4,
      "text": "Simmer until the corn is tender, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Remove the corn and let it set briefly before serving."
    }
  ],
