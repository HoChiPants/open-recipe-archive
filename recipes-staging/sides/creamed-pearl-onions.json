{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "creamed-pearl-onions",
  "name": "Creamed Pearl Onions",
  "subtitle": "Tender pearl onions in a light nutmeg cream sauce",
  "description": "Simmered pearl onions are folded into a smooth, buttery cream sauce and finished with parsley.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "pearl-onions",
      "item": "pearl onions",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "light-cream",
      "item": "light cream",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the pearl onions in a saucepan with salted water and bring to a simmer."
    },
    {
      "step": 2,
      "text": "Cook until the onions are tender, about 10 minutes, then drain well.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Melt the butter in the saucepan. Stir in the flour and nutmeg, cooking until the mixture is smooth and melted, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Season with the salt and black pepper, then whisk in the light cream."
    },
    {
      "step": 5,
      "text": "Stir over gentle heat until the sauce thickens, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Whisk in the parsley, return the onions to the sauce, and warm through for about 3 minutes.",
      "timer_minutes": 3
    }
  ],
