    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "chilled-mashed-potatoes",
      "item": "chilled mashed potatoes",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "slightly beaten, (separate bowls)"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "black pepper",
      "quantity": 0.5,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flour-for-dredging",
      "item": "flour for dredging",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kikkoman-panko-bread-crumbs",
      "item": "Kikkoman Panko Bread Crumbs",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil-for-pan-frying",
      "item": "vegetable oil for pan frying",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the chilled mashed potatoes, chopped onion, and black pepper until evenly mixed."
    },
    {
      "step": 2,
      "text": "Set the slightly beaten eggs, flour, and panko in separate shallow bowls."
    },
    {
      "step": 3,
      "text": "Shape the potato mixture into eight thick cakes."
    },
    {
      "step": 4,
      "text": "Dredge each cake in flour, dip it in beaten egg, and coat it with panko."
    },
    {
      "step": 5,
      "text": "Preheat the vegetable oil in a skillet over medium heat."
    },
    {
      "step": 6,
      "text": "Add the coated cakes in a single layer, working in batches if needed."
    },
    {
      "step": 7,
      "text": "Pan-fry until both sides are golden and crisp and the centers are heated through, turning once."
    }
  ],
