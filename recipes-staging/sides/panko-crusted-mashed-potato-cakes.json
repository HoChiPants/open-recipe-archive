  "id": "panko-crusted-mashed-potato-cakes",
  "name": "Panko-Crusted Mashed Potato Cakes",
  "subtitle": "Crisp-coated potato cakes for serving alongside a meal.",
  "description": "Chilled mashed potatoes are shaped into thick cakes, coated with flour, egg, and panko, then pan-fried until crisp and heated through.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
