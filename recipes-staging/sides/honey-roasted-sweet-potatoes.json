  "id": "honey-roasted-sweet-potatoes",
  "name": "Honey-Roasted Sweet Potatoes",
  "subtitle": "Tender roasted cubes with cinnamon and honey",
  "description": "Sweet potatoes are roasted with olive oil and honey, then finished with cinnamon and an extra honey drizzle.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-potatoes",
      "item": "sweet potatoes",
      "quantity": 2,
      "unit": "large",
      "preparation": "peeled and cubed"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Toss the cubed sweet potatoes with 0.5 cup honey and the olive oil."
    },
    {
      "step": 3,
      "text": "Spread the sweet potatoes in a baking dish or on a sheet pan."
    },
    {
      "step": 4,
      "text": "Bake for 30 minutes, until tender.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Let the sweet potatoes cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Toss the cooled sweet potatoes with the ground cinnamon, transfer to a serving dish, and drizzle with 1 tablespoon honey, or to taste."
    }
  ],
