{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "sour-cream-scalloped-potatoes",
  "name": "Sour Cream Scalloped Potatoes",
  "subtitle": "Tender potatoes baked with creamy soup, sour cream, and cheddar",
  "description": "Boiled potatoes are combined with a rich sour-cream sauce, topped with cheddar, and baked until tender and heated through.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 12,
      "unit": "large",
      "preparation": "peeled and halved"
    },
    {
      "ingredient_id": "cream-of-chicken-soup",
      "item": "cream of chicken soup",
      "quantity": 2,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded, divided"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the potatoes in a saucepan, season with salt and pepper, cover with water, and simmer for 15 minutes, or until tender.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Drain the potatoes, let them cool briefly, then cut them into bite-size pieces."
    },
    {
      "step": 4,
      "text": "Whisk together the soup, sour cream, and half of the shredded cheddar. Season with salt and pepper, then fold in the potatoes."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to a baking dish and sprinkle the remaining cheddar over the top."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until bubbling and heated through; the center should reach 165°F.",
      "timer_minutes": 30
    }
  ],
