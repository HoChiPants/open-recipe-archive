  "id": "chickpea-panisse",
  "name": "Chickpea Panisse",
  "subtitle": "Set chickpea slices fried until crisp",
  "description": "A simple chickpea-flour preparation chilled until firm, cut into pieces, fried in olive oil, and served with mayonnaise.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil-plus-extra-for-the-tin-and-frying",
      "item": "olive oil plus extra for the tin and frying",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "gram-flour-chickpea-flour",
      "item": "gram flour (chickpea flour)",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "mayonnaise-to-serve",
      "item": "mayonnaise to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Oil a shallow tin and prepare the chickpea-flour mixture with the measured olive oil."
    },
    {
      "step": 2,
      "text": "Preheat as directed for the preparation, allowing 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the mixture until smooth, then transfer it to the prepared tin."
    },
    {
      "step": 4,
      "text": "Chill until set, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Cut the set mixture into serving pieces."
    },
    {
      "step": 6,
      "text": "Preheat olive oil for frying for 3 minutes, then fry the pieces until crisp and browned.",
      "timer_minutes": 3
    },
    {
      "step": 7,
      "text": "Serve with mayonnaise."
    }
  ],
