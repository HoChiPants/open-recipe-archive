  "id": "cabbage-and-noodles",
  "name": "Cabbage and Noodles",
  "subtitle": "Buttery noodles tossed with tender cabbage and onion",
  "description": "A simple savory side dish combining egg noodles with buttery sautéed cabbage and onion.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "egg-noodles",
      "item": "egg noodles",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "head-cabbage",
      "item": "head cabbage",
      "quantity": 1,
      "preparation": "cored and chopped"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of salted water to a boil. Stir in the egg noodles and cook for 5 minutes, until tender and at least 160°F. Drain well.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat. Add the onion and cook, stirring, for 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Add the cabbage and continue cooking and stirring for 8 minutes, until softened.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Toss the drained noodles with the cabbage mixture. Season with salt and ground black pepper to taste, then serve."
    }
  ],
