      "preparation": "for topping"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the grated zucchini with 0.5 teaspoon salt. Let stand for 10 minutes, then squeeze out and discard excess moisture.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the egg, flour, Parmesan cheese, 0.25 teaspoon salt, and black pepper until combined. Stir in the drained zucchini."
    },
    {
      "step": 3,
      "text": "Heat oil in a skillet over medium heat. Add portions of the batter and flatten slightly."
    },
    {
      "step": 4,
      "text": "Cook for about 5 minutes, turning once, until golden brown and the centers are firm and reach 160°F.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Whisk the sour cream until smooth. Serve the fritters with sour cream, grated Parmesan cheese, and a pinch of salt."
    }
  ],
