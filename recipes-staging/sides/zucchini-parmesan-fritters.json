  "id": "zucchini-parmesan-fritters",
  "name": "Zucchini Parmesan Fritters",
  "subtitle": "Crisp-edged fritters with a cool sour-cream topping",
  "description": "Grated zucchini is combined with egg, flour, Parmesan, and pepper, then pan-fried until golden and fully set.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
