    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 3,
      "unit": "large",
      "preparation": "finely grated"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
