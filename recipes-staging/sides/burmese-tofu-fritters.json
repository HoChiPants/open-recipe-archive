  "id": "burmese-tofu-fritters",
  "name": "Burmese Tofu Fritters",
  "subtitle": "Crisp gram-flour fritters with a bright chili dipping sauce",
  "description": "Set a turmeric-seasoned gram-flour mixture, cut it into pieces, fry until crisp, and serve with lime, chili, garlic, and savory sauce.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil-plus-extra-for-the-dish-and-fryer",
      "item": "vegetable oil plus extra for the dish and fryer",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "gram-flour-optional",
      "item": "gram flour",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "vegetable-bouillon-powder",
      "item": "vegetable bouillon powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-turmeric",
      "item": "ground turmeric",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": "1 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "fish-sauce",
      "item": "fish sauce",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "light-soy-sauce",
      "item": "light soy sauce",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "limes-juiced",
      "item": "limes juiced",
      "quantity": 2
    },
    {
      "ingredient_id": "finger-chillies-sliced-into-rings",
      "item": "finger chillies sliced into rings",
      "quantity": 2
    },
    {
