      "item": "garlic cloves crushed",
      "quantity": 3
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the fish sauce and light soy sauce. Set aside for the sauce."
    },
    {
      "step": 2,
      "text": "Oil a shallow dish. Whisk the gram flour, salt, vegetable bouillon powder, turmeric, and baking powder together."
    },
    {
      "step": 3,
      "text": "Bring the fish sauce and soy sauce mixture to a boil; verify it reaches at least 145°F with a food thermometer. Add the lime juice, chilies, and garlic, then set aside."
    },
    {
      "step": 4,
      "text": "Stir the hot liquid into the gram-flour mixture until smooth. Cook, stirring, until thick, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer the mixture to the oiled dish and smooth the surface. Let cool, then chill until firm, about 48 hours.",
      "timer_minutes": 2880
    },
    {
      "step": 6,
      "text": "Cut the chilled mixture into fritter-sized pieces. Heat extra oil for frying."
    },
    {
      "step": 7,
      "text": "Prepare the remaining sliced chilies. Sauté the sugar for 3 minutes, then drain and set aside.",
      "timer_minutes": 3
    },
    {
      "step": 8,
      "text": "Sauté the fritters with the chilies in hot oil for about 5 minutes, turning as needed, until crisp. Drain and serve with the sauce.",
      "timer_minutes": 5
    }
  ],
