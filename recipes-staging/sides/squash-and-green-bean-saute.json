  "id": "squash-and-green-bean-saute",
  "name": "Squash and Green Bean Sauté",
  "subtitle": "A bright vegetable side with lemon and herbs",
  "description": "Yellow squash, green beans, and cherry tomatoes are quickly sautéed with lemon juice, parsley, and coriander.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "yellow-squash",
      "item": "yellow squash",
      "quantity": 2,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "green-beans",
      "item": "green beans",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "cherry-tomatoes",
      "item": "cherry tomatoes",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "halved"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dried-parsley",
      "item": "dried parsley",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-coriander",
      "item": "ground coriander",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.125,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.125,
      "unit": "teaspoon",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a large skillet over medium heat for 3 minutes, then add the sliced squash and green beans.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Stir in the halved cherry tomatoes, lemon juice, parsley, coriander, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Continue stirring and sautéing until the vegetables are tender and the tomatoes are warmed through, about 10 minutes.",
      "timer_minutes": 10
    }
  ],
