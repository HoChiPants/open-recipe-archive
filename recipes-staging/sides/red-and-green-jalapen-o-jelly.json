  "instructions": [
    {
      "step": 1,
      "text": "Combine the chopped red bell pepper, jalapeño pepper, sugar, and apple cider vinegar in a large saucepan."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a simmer, then continue simmering for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Bring the mixture back to a boil and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the liquid pectin and cook for 2 minutes, stirring frequently.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Stir for 1 minute, then transfer the jelly to serving containers and let it cool completely.",
      "timer_minutes": 1
    }
