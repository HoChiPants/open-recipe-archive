  "id": "air-fryer-miso-aubergine",
  "name": "Air-Fryer Miso Aubergine",
  "subtitle": "Tender aubergine with a savory-sweet miso glaze",
  "description": "A simple air-fried side dish finished with lime, sesame seeds, and coriander.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "aubergines-halved-lengthways",
      "item": "aubergines halved lengthways",
      "quantity": 2
    },
    {
      "ingredient_id": "white-miso-paste",
      "item": "white miso paste",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": "1 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "lime-juiced",
      "item": "lime juiced",
      "quantity": "1/2",
      "preparation": "plus extra wedges to serve"
    },
    {
      "ingredient_id": "sesame-seeds-and-coriander-leaves",
      "item": "sesame seeds and coriander leaves",
      "preparation": "to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Score the cut sides of the aubergines in a crosshatch pattern, taking care not to cut through the skin."
    },
    {
      "step": 2,
      "text": "Mix the miso, soy sauce, honey, vegetable oil, and lime juice into a smooth glaze."
    },
    {
      "step": 3,
      "text": "Brush the glaze over the aubergine flesh. Arrange the halves cut-side up in the air fryer and cook at 375°F until tender and browned, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "Serve topped with sesame seeds and coriander leaves, with extra lime wedges alongside."
    }
  ],
