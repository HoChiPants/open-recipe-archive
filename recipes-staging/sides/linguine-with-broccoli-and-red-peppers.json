  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of water to a simmer. Add the linguine and cook for 10 minutes, or until tender; drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Microwave the chopped broccoli for 7 minutes, until tender.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Heat the olive oil and butter in a large skillet. Add the garlic, red bell pepper, and garlic salt; stir until fragrant and the pepper begins to soften."
    },
    {
      "step": 4,
      "text": "Add the broccoli and drained linguine to the skillet. Toss to combine, then stir in the Parmesan and serve."
    }
  ],
