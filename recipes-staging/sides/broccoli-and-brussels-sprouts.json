  "instructions": [
    {
      "step": 1,
      "text": "Heat a large skillet over medium heat and add the divided butter."
    },
    {
      "step": 2,
      "text": "Add the garlic and stir for 2 minutes, until fragrant.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir in the broccoli and Brussels sprouts until evenly coated."
    },
    {
      "step": 4,
      "text": "Add the remaining butter and diced tomato, then season with the salt and red pepper flakes."
    },
    {
