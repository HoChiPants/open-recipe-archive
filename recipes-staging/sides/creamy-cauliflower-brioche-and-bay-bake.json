  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk with the bay leaves for 10 minutes, then simmer the cauliflower in the infused milk for 3 minutes, until tender. Remove the bay leaves and reserve the milk.",
      "timer_minutes": 13
    },
    {
      "step": 2,
      "text": "Melt the butter in a large ovenproof pan or baking dish. Stir in the flour and cook briefly to form a smooth paste."
    },
    {
      "step": 3,
      "text": "Gradually whisk in the reserved milk until smooth. Stir in the cream, nutmeg, mustard, and parmesan or vegetarian alternative."
    },
    {
      "step": 4,
      "text": "Fold the cauliflower into the sauce and transfer the mixture to a baking dish if needed. Scatter the brioche cubes over the top."
    },
    {
      "step": 5,
      "text": "Bake in a preheated oven for 30 minutes, until the sauce is bubbling and the topping is golden.",
      "timer_minutes": 30
    }
  ],
