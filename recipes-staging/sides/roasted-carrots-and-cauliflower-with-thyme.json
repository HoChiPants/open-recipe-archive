  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Toss the carrots and cauliflower with the olive oil, thyme, garlic, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Arrange the vegetables in an even layer on a baking sheet."
    },
    {
      "step": 4,
      "text": "Roast for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Stir the vegetables and continue roasting for 15 minutes, or until tender.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Sprinkle with the Parmesan cheese before serving."
    }
