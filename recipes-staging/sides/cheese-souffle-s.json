  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Brush two small baking dishes with the melted butter, then coat them with the 2 tablespoons white sugar; shake out the excess."
    },
    {
      "step": 2,
      "text": "Separate the eggs. Whisk the yolks with 1 tablespoon white sugar, flour, ¼ teaspoon salt, vanilla, lemon zest, softened cream cheese, and Cheddar until smooth."
    },
    {
      "step": 3,
      "text": "Beat the egg whites with the pinch of salt until soft peaks form. Fold them gently into the cheese mixture in two additions until just combined."
    },
    {
      "step": 4,
      "text": "Divide the mixture between the prepared dishes and bake for 12 minutes, until puffed and the centers are fully set or reach 160°F.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Serve immediately."
    }
  ],
