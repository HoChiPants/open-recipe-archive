  "id": "cheese-souffle-s",
  "name": "Cheese Soufflés",
  "subtitle": "Light, savory individual soufflés with a crisp sugared edge",
  "description": "Small cheese soufflés combining a creamy cheese base with softly whipped egg whites, baked until puffed and fully set.",
  "meal_type": "side",
