  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet. Add the onion, red bell pepper, fresh mushrooms, half the salt, and the black pepper. Cook, stirring occasionally, for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Stir in the flour and cook for 1 minute, until combined.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the remaining salt and heated milk. Simmer, stirring, for about 3 minutes, until thickened.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Stir in the broccoli, Cheddar, and Romano. Transfer the mixture to a baking dish."
    },
    {
      "step": 6,
      "text": "Top with the bread crumbs and additional Cheddar and Romano from the listed ingredients, then dot with the butter."
    },
    {
      "step": 7,
      "text": "Bake for 40 minutes, until hot and the topping is browned.",
      "timer_minutes": 40
    },
    {
      "step": 8,
      "text": "Let stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
