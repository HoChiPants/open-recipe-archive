    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "mini-potatoes",
      "item": "mini potatoes",
      "quantity": 0.5,
      "unit": "pound"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "dry-italian-style-salad-dressing-mix",
      "item": "dry Italian-style salad dressing mix",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 400°F."
    },
    {
      "step": 2,
      "text": "Halve the mini potatoes. Toss with the extra-virgin olive oil and dry Italian-style salad dressing mix until evenly coated."
    },
    {
      "step": 3,
      "text": "Arrange the potatoes in a single layer in the air-fryer basket. Cook for 7 minutes, shaking the basket once or twice, until the potatoes are golden brown.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Continue cooking until tender, about 3 minutes more. Season with salt and ground black pepper to taste before serving.",
      "timer_minutes": 3
    }
  ],
