  "id": "air-fryer-roasted-potatoes",
  "name": "Air Fryer Roasted Potatoes",
  "subtitle": "Seasoned mini potatoes with crisp, golden edges",
  "description": "Mini potatoes are coated in olive oil and Italian-style dressing mix, then air-fried until browned and tender.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
