  "id": "creamed-peas-and-new-potatoes",
  "name": "Creamed Peas and New Potatoes",
  "subtitle": "Tender potatoes and peas in a simple creamy sauce",
  "description": "A straightforward American side dish combining tender baby potatoes and English peas with a lightly thickened butter-and-milk sauce.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "baby-red-potatoes",
      "item": "baby red potatoes",
      "quantity": 1,
      "unit": "pound",
      "preparation": "quartered"
    },
    {
      "ingredient_id": "shelled-english-peas",
      "item": "shelled English peas",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the quartered potatoes in a pot, season with salt and pepper, cover with water, and bring to a simmer. Cook until tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Drain the potatoes. Return the pot to the heat, add the peas, and simmer until tender, about 7 minutes. Drain the peas.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Melt the butter in the pot. Stir in the flour and cook until the mixture thickens slightly."
    },
    {
      "step": 4,
      "text": "Gradually whisk in the milk and cook until the sauce thickens. Season with salt and pepper."
    },
    {
      "step": 5,
      "text": "Return the potatoes and peas to the pot, then simmer gently for 5 minutes. Serve warm.",
      "timer_minutes": 5
    }
  ],
