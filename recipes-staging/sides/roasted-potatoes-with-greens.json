  "id": "roasted-potatoes-with-greens",
  "name": "Roasted Potatoes with Greens",
  "subtitle": "Rosemary potatoes finished with wilted spinach",
  "description": "Quartered red potatoes are coated with garlic-rosemary butter, roasted until tender, and finished with fresh spinach.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "red-potatoes",
      "item": "red potatoes",
      "quantity": 6,
      "unit": "small",
      "preparation": "quartered"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "fresh-rosemary",
      "item": "fresh rosemary",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "sea-salt-and-ground-black-pepper-to-taste",
      "item": "sea salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "fresh-spinach-leaves",
      "item": "fresh spinach leaves",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Arrange the quartered potatoes in a single layer in a baking dish."
    },
    {
      "step": 2,
      "text": "Melt the butter in a small pan over medium heat. Add the garlic and cook briefly, then stir in the rosemary and cook until fragrant."
    },
    {
      "step": 3,
      "text": "Pour the seasoned butter over the potatoes and toss to coat. Season with sea salt and ground black pepper."
    },
    {
      "step": 4,
      "text": "Roast for 30 minutes, or until the potatoes are tender.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Add the spinach leaves to the hot potatoes and cook until just wilted, about 2 minutes. Serve warm.",
      "timer_minutes": 2
    }
  ],
