  "id": "texas-style-baked-beans",
  "name": "Texas-Style Baked Beans",
  "subtitle": "Sweet, smoky beans with bacon and peppers",
  "description": "Cooked pinto beans are combined with bacon, vegetables, beer, barbecue sauce, brown sugar, and molasses, then baked until hot and richly flavored.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
      "unit": "medium",
      "preparation": "diced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced, or more to taste"
    },
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "pound",
      "preparation": "diced"
    },
    {
      "ingredient_id": "red-bell-pepper",
      "item": "red bell pepper",
      "quantity": 1,
      "unit": "medium",
      "preparation": "diced"
    },
    {
      "ingredient_id": "jalapeno-peppers",
      "item": "jalapeno peppers",
      "quantity": 3,
      "unit": "medium",
      "preparation": "minced, or to taste"
    },
    {
      "ingredient_id": "beer",
      "item": "beer",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "barbecue-sauce",
      "item": "barbecue sauce",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "molasses",
      "item": "molasses",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "pinto-beans",
      "item": "pinto beans",
      "quantity": 6,
      "unit": "cups",
      "preparation": "cooked"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "cracked-black-pepper-to-taste",
      "item": "cracked black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Grease a baking dish with the butter."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large skillet over medium heat. Cook the red onion, garlic, and garlic salt for about 7 minutes, until softened.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Add the bacon, red bell pepper, jalapeno peppers, and cracked black pepper. Cook, stirring occasionally, for 10 minutes; stir in the brown sugar.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Mix in the beer, barbecue sauce, remaining brown sugar, and molasses. Fold in the pinto beans and adjust the garlic salt and black pepper to taste."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to the prepared baking dish and bake at 375°F for about 45 minutes, until bubbling and heated through.",
      "timer_minutes": 45
    }
  ],
