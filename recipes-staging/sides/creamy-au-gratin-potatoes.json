{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "creamy-au-gratin-potatoes",
  "name": "Creamy Au Gratin Potatoes",
  "subtitle": "Tender sliced potatoes in a light cheese sauce",
  "description": "Layered potatoes and onion are baked under a creamy reduced-fat Cheddar sauce until tender.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "russet-potatoes",
      "item": "russet potatoes",
      "quantity": 4,
      "preparation": "sliced into 1/4 inch slices"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "sliced into rings"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "low-fat-1-milk",
      "item": "low-fat (1%) milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "reduced-fat-cheddar-cheese",
      "item": "reduced-fat Cheddar cheese",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan over medium heat."
    },
    {
      "step": 3,
      "text": "Arrange the potato slices in layers in a baking dish, adding the onion rings between layers. Season with salt and ground black pepper."
    },
    {
      "step": 4,
      "text": "Whisk the flour, 1/2 teaspoon salt, and additional ground black pepper into the melted butter."
    },
    {
      "step": 5,
      "text": "Gradually stir in the milk. Cook, stirring, until the sauce thickens."
    },
    {
      "step": 6,
      "text": "Stir in the shredded Cheddar until melted."
    },
    {
      "step": 7,
      "text": "Pour the cheese sauce over the potatoes and onion."
    },
    {
      "step": 8,
      "text": "Bake until the potatoes are tender, about 120 minutes.",
      "timer_minutes": 120
    }
  ],
