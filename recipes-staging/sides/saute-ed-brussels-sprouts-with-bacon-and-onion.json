  "id": "saute-ed-brussels-sprouts-with-bacon-and-onion",
  "name": "Sautéed Brussels Sprouts with Bacon and Onion",
  "subtitle": "A savory skillet side with crisp bacon and Parmesan",
  "description": "Brussels sprouts cook in bacon drippings with onion and garlic, then finish with chopped bacon and Parmesan.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
