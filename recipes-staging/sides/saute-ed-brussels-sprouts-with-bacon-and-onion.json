    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "slices-lower-sodium-bacon",
      "item": "slices lower-sodium bacon",
      "quantity": 6
    },
    {
      "ingredient_id": "white-onion",
      "item": "white onion",
      "quantity": 0.5,
      "unit": "large",
      "preparation": "diced"
    },
    {
      "ingredient_id": "brussels-sprouts",
      "item": "Brussels sprouts",
      "quantity": 30,
      "preparation": "halved lengthwise"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "chopped"
    },
    {
