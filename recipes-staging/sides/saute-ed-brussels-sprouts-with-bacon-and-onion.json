      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat a large skillet over medium heat. Cook the bacon until crisp, about 10 minutes. Transfer it to paper towels to drain, then chop it.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Return the skillet to medium heat. Add the diced onion and cook in the bacon drippings until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the Brussels sprouts and garlic. Season with salt and pepper, then cook, stirring occasionally, until the sprouts are lightly browned and tender, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the chopped bacon. Remove from the heat and top with Parmesan before serving."
    }
  ],
