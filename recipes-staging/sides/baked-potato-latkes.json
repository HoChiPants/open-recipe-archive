      "preparation": "minced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "freshly-ground-multi-colored-peppercorns",
      "item": "freshly ground multi-colored peppercorns",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "whisked"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 2,
      "unit": "cups",
      "preparation": "or as need for frying"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the potatoes, onion, garlic, salt, peppercorns, flour, and whisked eggs in a bowl. Fold until evenly mixed."
    },
    {
      "step": 2,
      "text": "Preheat the cooking surface to 375°F and add the olive oil for frying."
    },
    {
      "step": 3,
      "text": "Shape the mixture into thick patties and fry until golden brown, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Turn the patties and cook for about 3 minutes more, until browned and firm.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Transfer the latkes to a serving plate."
    }
  ],
