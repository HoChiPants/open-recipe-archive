  "id": "baked-potato-latkes",
  "name": "Baked Potato Latkes",
  "subtitle": "Crisp-edged potato patties with onion and garlic",
  "description": "Mashed baked potatoes combine with onion, garlic, flour, and whisked eggs, then cook in olive oil until browned and set.",
  "meal_type": "side",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
