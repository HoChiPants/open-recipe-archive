      "ingredient_id": "quinoa",
      "item": "quinoa",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "canned-garbanzo-beans-chickpeas",
      "item": "canned garbanzo beans (chickpeas)",
      "quantity": 1,
