  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the quinoa, water, and 0.125 teaspoon salt in a saucepan. Bring to a simmer."
    },
    {
      "step": 2,
      "text": "Cover and cook until the quinoa is tender and the liquid is absorbed, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Stir in the drained chickpeas, chopped tomato, minced garlic, lime juice, olive oil, ground cumin, and salt and pepper to taste."
    },
    {
      "step": 4,
      "text": "Fold in the chopped parsley and serve warm."
    }
  ],
