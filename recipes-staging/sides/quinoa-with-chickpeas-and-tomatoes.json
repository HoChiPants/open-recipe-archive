  "id": "quinoa-with-chickpeas-and-tomatoes",
  "name": "Quinoa with Chickpeas and Tomatoes",
  "subtitle": "A bright, hearty grain side with citrus and herbs",
  "description": "Tender quinoa is combined with chickpeas, tomato, garlic, lime, cumin, and parsley for a fresh savory side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
