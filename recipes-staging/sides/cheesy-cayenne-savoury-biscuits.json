  "id": "cheesy-cayenne-savoury-biscuits",
  "name": "Cheesy Cayenne Savoury Biscuits",
  "subtitle": "Crisp, cheese-rich biscuits with rosemary and gentle heat",
  "description": "Savoury slice-and-bake biscuits combining sharp cheeses, herbs, mustard, and cayenne, finished with a poppy-seed coating.",
  "meal_type": "side",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "mustard-powder",
      "item": "mustard powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "of-cayenne-pepper",
      "item": "of cayenne pepper",
      "unit": "pinch"
    },
    {
      "ingredient_id": "dried-rosemary",
      "item": "dried rosemary",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 150,
      "unit": "g",
      "preparation": "softened"
    },
    {
      "ingredient_id": "parmesan-finely-grated",
      "item": "parmesan finely grated",
      "quantity": 70,
      "unit": "g"
    },
    {
      "ingredient_id": "gruye-re-finely-grated",
      "item": "gruyère finely grated",
      "quantity": 70,
      "unit": "g"
    },
    {
      "ingredient_id": "egg-yolk-lightly-beaten",
      "item": "egg yolk lightly beaten",
      "quantity": 1
    },
    {
      "ingredient_id": "poppy-seeds",
      "item": "poppy seeds",
      "quantity": 3,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, mustard powder, cayenne pepper, and rosemary. Work in the softened butter, Parmesan, and Gruyère until a cohesive dough forms."
    },
    {
      "step": 2,
      "text": "Whisk the beaten egg yolk until smooth, then mix it into the dough. Shape the dough into a compact log and roll it evenly in the poppy seeds."
    },
    {
      "step": 3,
      "text": "Chill the coated log until firm, about 35 minutes. Preheat the oven to 350°F.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "Slice the chilled log into biscuits and arrange them on a baking sheet. Freeze briefly to firm the slices, then brush with the remaining beaten egg yolk."
    },
    {
      "step": 5,
      "text": "Bake for about 15 minutes, until golden and firm in the center; an egg-containing biscuit should reach 160°F. Cool before serving.",
      "timer_minutes": 15
    }
  ],
