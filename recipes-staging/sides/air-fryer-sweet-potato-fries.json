  "id": "air-fryer-sweet-potato-fries",
  "name": "Air Fryer Sweet Potato Fries",
  "subtitle": "Seasoned sweet potato fries with crisp edges",
  "description": "Cut sweet potatoes are coated with oil, smoked paprika, herbs, and seasoning, then air-fried until tender and browned.",
  "meal_type": "side",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
