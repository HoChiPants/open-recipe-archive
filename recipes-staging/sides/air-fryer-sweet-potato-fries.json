  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the sweet potatoes into evenly sized fries."
    },
    {
      "step": 2,
      "text": "Toss the fries with the olive oil, sweet smoked paprika or other seasonings such as Cajun seasoning, and mixed herbs until evenly coated."
    },
    {
      "step": 3,
      "text": "Let the seasoned fries stand for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Preheat the air fryer for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Arrange the fries in the basket without overcrowding and air-fry for about 45 minutes, turning or shaking as needed, until tender and browned.",
      "timer_minutes": 45
    }
  ],
