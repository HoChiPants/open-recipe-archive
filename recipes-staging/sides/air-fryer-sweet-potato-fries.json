    "prep_minutes": 5,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-potatoes",
      "item": "sweet potatoes",
      "quantity": 2
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "sweet-smoked-paprika-or-other-seasonings-such-as-cajun-seasoning",
      "item": "sweet smoked paprika or other seasonings such as Cajun seasoning",
      "quantity": 1,
      "unit": "tsp",
      "preparation": "BBQ seasoning or garlic granules"
    },
    {
      "ingredient_id": "mixed-herbs",
      "item": "mixed herbs",
      "quantity": "1/2",
      "unit": "tsp"
