  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Place the carrots, potatoes, beet, onion, garlic, chickpeas, and beet greens in a roasting pan."
    },
    {
      "step": 3,
      "text": "Toss the vegetables with the olive oil, thyme, salt, and pepper."
    },
    {
      "step": 4,
      "text": "Roast for 30 minutes, stirring once.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Stir in the white wine and continue roasting until the vegetables are tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Adjust the seasoning with salt and pepper before serving."
    }
