  "instructions": [
    {
      "step": 1,
      "text": "Combine the olive oil, herbs, balsamic vinegar, salt, pepper, garlic, and bell peppers in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the onion, asparagus, mushrooms, eggplant, and bell peppers; toss to coat. Cover and marinate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Preheat an outdoor grill to medium-high heat."
    },
    {
