  "id": "cheesy-hash-brown-casserole",
  "name": "Cheesy Hash Brown Casserole",
  "subtitle": "A creamy, savory potato side for sharing",
  "description": "Thawed hash browns combine with cheese, sour cream, soup, onion, and butter before baking until hot and bubbling.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-cubed-hash-brown-potatoes",
      "item": "frozen cubed hash brown potatoes",
      "quantity": 1,
      "unit": "package",
      "preparation": "2 pound, thawed"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "16-ounce-container-sour-cream",
      "item": "(16 ounce) container sour cream",
      "quantity": 1
    },
    {
      "ingredient_id": "cream-of-chicken-soup",
      "item": "cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
