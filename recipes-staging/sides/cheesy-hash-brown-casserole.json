      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the thawed hash browns, mozzarella, sour cream, soup, melted butter, onion, salt, and pepper in a large bowl."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a baking dish and bake for 30 minutes, until the center reaches 165°F and the casserole is hot and bubbling.",
      "timer_minutes": 30
    }
  ],
