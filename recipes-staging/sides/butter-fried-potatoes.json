  "instructions": [
    {
      "step": 1,
      "text": "Melt half of the butter in a large skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the potatoes and cook for 15 minutes, stirring occasionally, until golden brown.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Melt the remaining butter in the skillet, then add the onion and garlic. Cook for 5 minutes, stirring, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir the onion mixture into the potatoes and continue cooking until the potatoes are tender."
    }
  ],
