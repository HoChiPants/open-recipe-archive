  "id": "butter-fried-potatoes",
  "name": "Butter-Fried Potatoes",
  "subtitle": "Golden skillet potatoes with onion and garlic",
  "description": "Cubed potatoes are browned in butter, then finished with tender onion and garlic for a simple savory side.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
