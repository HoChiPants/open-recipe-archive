  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 6,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 2,
      "unit": "large",
      "preparation": "cut into 1/2-inch cubes"
    },
