  "instructions": [
    {
      "step": 1,
      "text": "Preheat a steamer and prepare a lightly greased steaming surface."
    },
    {
      "step": 2,
      "text": "Toast the fenugreek seeds, black pepper, and sesame seeds as directed; set the sesame seeds aside."
    },
    {
      "step": 3,
      "text": "Heat the mustard or vegetable oil. Sauté the fenugreek seeds and black pepper, then add both garlic preparations, both ginger preparations, and both chili preparations.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the coriander powder, cumin powder, garam masala, ground turmeric, and tomatoes. Cook until softened, then remove from the heat and cool.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Mix the plain flour and baking powder with the coriander powder and cumin powder mixture, add enough water to form a smooth dough, and knead until supple.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Combine the chicken mince with the red onion, spring onion, chopped coriander, lemongrass, melted butter, lemon juice, and crushed black peppercorns."
    },
    {
      "step": 7,
      "text": "Divide and roll the dough into thin wrappers, dusting with plain flour and cornflour. Fill and pleat each wrapper around the chicken mixture."
    },
    {
      "step": 8,
      "text": "Arrange the momos in the steamer, leaving space between them, and steam until the wrappers are set and the chicken reaches 165°F internally.",
      "timer_minutes": 12
    },
    {
      "step": 9,
      "text": "Stir the toasted sesame seeds, finely chopped coriander, and lemon or lime juice into the cooled tomato chutney. Serve with the hot momos."
    }
  ],
