  "id": "turnip-bake",
  "name": "Turnip Bake",
  "subtitle": "Tender turnips and apples beneath a buttery brown-sugar topping",
  "description": "A warm baked side dish combining mashed turnip with cinnamon-seasoned apples and a simple crumb topping.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
