  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Simmer the cubed turnip with the salt and pepper until tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Drain the turnip and mash it with 2 tablespoons butter until smooth."
    },
    {
      "step": 4,
      "text": "Toss the diced apples with 2 tablespoons brown sugar and the cinnamon."
    },
    {
      "step": 5,
      "text": "Spread the mashed turnip in a baking dish and arrange the apples over it."
    },
    {
      "step": 6,
      "text": "Combine the flour, 1/4 cup brown sugar, and softened butter to make a crumbly topping; scatter it over the apples."
    },
    {
      "step": 7,
      "text": "Bake until the topping is golden and the dish is cooked through, about 60 minutes.",
      "timer_minutes": 60
    }
  ],
