{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "scalloped-cabbage",
  "name": "Scalloped Cabbage",
  "subtitle": "Tender cabbage in a creamy cheese sauce with a crisp cracker topping",
  "description": "Boiled cabbage is layered with a simple cheese sauce and crushed crackers, then baked until bubbling and golden.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "head-cabbage",
      "item": "head cabbage",
      "quantity": 1,
      "unit": "medium",
      "preparation": "cut into small wedges"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "american-cheese",
      "item": "American cheese",
      "quantity": 0.66666668653488,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "buttery-round-crackers",
      "item": "buttery round crackers",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Bring a pot of salted water to a simmer. Add the cabbage and cook for 10 minutes, until tender. Drain well.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Melt the butter in a saucepan. Stir in the flour and remaining salt, then gradually whisk in the milk. Cook until the mixture thickens."
    },
    {
      "step": 4,
      "text": "Stir in the shredded cheese until melted and smooth."
    },
    {
      "step": 5,
      "text": "Place the drained cabbage in a baking dish and pour the cheese sauce over it, stirring gently to coat. Sprinkle the crushed crackers on top."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until hot and bubbling with a lightly browned topping.",
      "timer_minutes": 30
    }
  ],
