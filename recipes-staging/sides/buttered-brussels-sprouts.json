  "id": "buttered-brussels-sprouts",
  "name": "Buttered Brussels Sprouts",
  "subtitle": "Crisp air-fried sprouts with lemon zest",
  "description": "Halved Brussels sprouts are air-fried until tender and finished with melted butter and lemon zest.",
  "meal_type": "side",
  "yield": {
