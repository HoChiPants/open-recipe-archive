  "id": "chantilly-potatoes",
  "name": "Chantilly Potatoes",
  "subtitle": "Creamy baked potatoes with Swiss cheese",
  "description": "Mashed potatoes are enriched with cream, seasoned, topped with Swiss cheese, and baked until hot and lightly browned.",
  "meal_type": "side",
  "cuisine": "French",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "mashed-potatoes",
      "item": "mashed potatoes",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-swiss-cheese",
      "item": "grated Swiss cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Butter a baking dish with the teaspoon of butter, or use as much as needed to coat it."
    },
    {
      "step": 2,
      "text": "Transfer the mashed potatoes to a bowl. Whisk in the heavy cream, then fold in half of the Swiss cheese and season with salt and freshly ground black pepper."
    },
    {
      "step": 3,
      "text": "Spread the potato mixture in the prepared dish and sprinkle the remaining Swiss cheese over the top."
    },
    {
      "step": 4,
      "text": "Bake until heated through and the cheese is melted and lightly browned, about 25 minutes.",
      "timer_minutes": 25
    }
  ],
