  "id": "air-fryer-spaghetti-squash",
  "name": "Air Fryer Spaghetti Squash",
  "subtitle": "Tender, seasoned squash strands made in the air fryer.",
  "description": "A simple air-fryer side dish with olive oil, salt, pepper, and smoked paprika.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "3-pound-spaghetti-squash",
      "item": "(3 pound) spaghetti squash",
      "quantity": 1
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sea-salt",
      "item": "sea salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "smoked-paprika",
      "item": "smoked paprika",
      "quantity": 0.125,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Carefully halve the spaghetti squash lengthwise and scoop out the seeds.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Rub the cut sides with olive oil, then season with sea salt, black pepper, and smoked paprika."
    },
    {
      "step": 3,
      "text": "Preheat the air fryer to 360°F."
    },
    {
      "step": 4,
      "text": "Place the squash halves cut-side up in the air-fryer basket. Cook until the flesh is tender and separates easily into strands, working in batches if needed.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Let cool briefly, then scrape the flesh into strands with a fork and serve."
    }
  ],
