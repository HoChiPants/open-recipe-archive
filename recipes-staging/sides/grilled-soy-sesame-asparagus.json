  "id": "grilled-soy-sesame-asparagus",
  "name": "Grilled Soy-Sesame Asparagus",
  "subtitle": "Tender asparagus with a savory sesame glaze",
  "description": "Asparagus is grilled until tender, then finished with a savory soy, garlic, brown sugar, and sesame coating.",
  "meal_type": "side",
  "cuisine": "Asian",
  "yield": {
    "quantity": 4,
