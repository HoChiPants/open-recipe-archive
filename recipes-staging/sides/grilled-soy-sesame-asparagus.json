      "preparation": "toasted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill."
    },
    {
      "step": 2,
      "text": "Combine the toasted sesame oil, soy sauce, minced garlic, brown sugar, and toasted sesame seeds."
    },
    {
      "step": 3,
      "text": "Coat the trimmed asparagus evenly with the mixture."
    },
    {
      "step": 4,
      "text": "Grill the asparagus, turning as needed, until tender, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Transfer to a serving dish and garnish with the remaining sesame oil and sesame seeds."
    }
  ],
