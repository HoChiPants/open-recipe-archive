      "item": "lemon zest",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "sprigs-fresh-oregano-leaves",
      "item": "sprigs fresh oregano leaves",
      "quantity": 4,
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Cut the potatoes into thick wedges and arrange them in a baking dish."
    },
    {
      "step": 2,
      "text": "Season the potatoes with salt, black pepper, and cayenne, then coat them evenly with the olive oil."
    },
    {
      "step": 3,
      "text": "Bake for 20 minutes. Meanwhile, combine the broth, lemon juice, and lemon zest; heat the mixture to 165°F, measured with a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Pour the hot broth mixture over the potatoes and add the oregano. Turn the wedges to coat, then season with additional black pepper or cayenne if desired."
    },
    {
      "step": 5,
      "text": "Return the dish to the oven and roast until the potatoes are tender and browned, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Let the potatoes rest for 10 minutes, then serve with additional olive oil and oregano as desired.",
      "timer_minutes": 10
    }
  ],
