      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 1,
      "unit": "cup"
    },
    {
