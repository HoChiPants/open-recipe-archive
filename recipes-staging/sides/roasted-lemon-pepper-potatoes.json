  "id": "roasted-lemon-pepper-potatoes",
  "name": "Roasted Lemon-Pepper Potatoes",
  "subtitle": "Tender potatoes with bright lemon and oregano",
  "description": "Potato wedges roast with a savory lemon-broth mixture, pepper, cayenne, and fresh oregano until tender and browned.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
