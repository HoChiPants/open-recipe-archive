  "instructions": [
    {
      "step": 1,
      "text": "Simmer the corn in water until tender, about 10 minutes. Drain well.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet over medium heat. Add the onion and garlic; cook until the onion begins to soften, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the zucchini and tomatoes. Cook, stirring occasionally, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the drained corn, poblano, salt, and black pepper. Cook until the zucchini is tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Remove from the heat and sprinkle with the cotija cheese."
    }
