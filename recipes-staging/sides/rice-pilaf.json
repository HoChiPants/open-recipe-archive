      "item": "Greek seasoning",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the chicken bouillon granules into the water until dissolved."
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan over medium heat. Add the vermicelli and stir until golden brown.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pour in the bouillon mixture, then stir in the rice, black pepper, salt, and Greek seasoning."
    },
    {
      "step": 4,
      "text": "Bring to a simmer, cover, and cook until the rice is tender and the liquid reaches 165°F.",
      "timer_minutes": 25
    }
  ],
