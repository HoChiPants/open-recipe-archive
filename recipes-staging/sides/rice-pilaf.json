  "id": "rice-pilaf",
  "name": "Rice Pilaf",
  "subtitle": "Toasted vermicelli with seasoned long-grain rice",
  "description": "A simple stovetop pilaf made with browned vermicelli, white rice, butter, and savory seasoning.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-bouillon-granules",
      "item": "chicken bouillon granules",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "broken-pieces-vermicelli-pasta",
      "item": "broken pieces vermicelli pasta",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "long-grain-white-rice",
      "item": "long grain white rice",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
