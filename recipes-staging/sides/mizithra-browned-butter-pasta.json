  "id": "mizithra-browned-butter-pasta",
  "name": "Mizithra Browned Butter Pasta",
  "subtitle": "Spaghetti tossed with browned butter and aged cheese",
  "description": "A simple savory pasta side made with tender spaghetti, nutty browned butter, and crumbled Mizithra cheese.",
  "meal_type": "side",
