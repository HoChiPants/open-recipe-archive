      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "mizithra-cheese",
      "item": "Mizithra cheese",
      "quantity": 0.75,
      "unit": "pound"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the spaghetti in boiling water until tender, then drain well."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat. Continue heating until it turns golden and smells nutty."
    },
    {
      "step": 3,
      "text": "Add the drained spaghetti and toss to coat with the browned butter."
    },
    {
      "step": 4,
      "text": "Add the Mizithra cheese and toss until evenly distributed. Serve warm."
    }
  ],
