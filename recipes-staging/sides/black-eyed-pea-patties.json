  "id": "black-eyed-pea-patties",
  "name": "Black-Eyed Pea Patties",
  "subtitle": "Crisp-edged patties with savory bacon and peppers",
  "description": "Mashed black-eyed peas are combined with bacon, roasted peppers, shallot, and flour, then pan-fried until golden.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 0.5,
      "unit": "pound"
    },
    {
      "ingredient_id": "canned-black-eyed-peas",
      "item": "canned black-eyed peas",
      "quantity": 3,
      "unit": "cups",
      "preparation": "rinsed and drained"
    },
    {
      "ingredient_id": "roasted-red-peppers",
      "item": "roasted red peppers",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "shallot",
      "item": "shallot",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "minced"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "salt-and-black-pepper-to-taste",
      "item": "salt and black pepper to taste"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a skillet over medium heat until crisp, about 10 minutes. Transfer it to a paper towel-lined plate, reserving the drippings, and drain well.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Mash the black-eyed peas with the salt and black pepper until mostly smooth."
    },
    {
      "step": 3,
      "text": "Crumble the bacon and stir it into the peas with the roasted red peppers and shallot. Mix in the flour until the mixture holds together; add only as needed."
    },
    {
      "step": 4,
      "text": "Divide the mixture into patties and season lightly with additional salt and black pepper if desired."
    },
    {
      "step": 5,
      "text": "Heat the butter, vegetable oil, and reserved bacon drippings in the skillet over medium heat."
    },
    {
      "step": 6,
      "text": "Add the patties and cook until golden brown, about 4 minutes per side, turning once.",
      "timer_minutes": 8
    }
  ],
