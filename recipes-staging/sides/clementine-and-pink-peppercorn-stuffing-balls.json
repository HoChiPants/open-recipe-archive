  "id": "clementine-and-pink-peppercorn-stuffing-balls",
  "name": "Clementine and Pink Peppercorn Stuffing Balls",
  "subtitle": "Citrusy sausage stuffing with fragrant bay and peppercorns",
  "description": "A savory baked side dish combining sausage, sourdough, clementine zest, herbs, and aromatic peppercorns.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
