      "item": "pink peppercorns",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "sourdough-slices",
      "item": "sourdough slices",
      "quantity": 2,
      "preparation": "torn"
    },
    {
