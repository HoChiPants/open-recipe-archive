    {
      "ingredient_id": "sausagemeat",
      "item": "sausagemeat",
      "quantity": 500,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a pan. Add the onions, bay leaves, and pink peppercorns, and cook gently until the onions are soft.",
      "timer_minutes": 35
    },
    {
      "step": 2,
      "text": "Stir in the clementine zest, then transfer the mixture to a bowl and let it cool."
    },
    {
      "step": 3,
      "text": "Crush the pink peppercorns and combine them with the torn sourdough. Add the cooled onion mixture and parsley."
    },
    {
      "step": 4,
      "text": "Mix in the sausagemeat until evenly combined. Shape the mixture into stuffing balls and arrange them in a baking dish."
    },
    {
      "step": 5,
      "text": "Cover and chill before baking.",
      "timer_minutes": 1440
    },
    {
      "step": 6,
      "text": "Preheat the oven to 400°F (200°C). Bake the stuffing balls until browned and cooked through, reaching 160°F (71°C) in the center.",
      "timer_minutes": 30
    }
  ],
