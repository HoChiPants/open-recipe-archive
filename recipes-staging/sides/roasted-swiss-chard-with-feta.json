  "id": "roasted-swiss-chard-with-feta",
  "name": "Roasted Swiss Chard with Feta",
  "subtitle": "Tender greens with a salty cheese finish",
  "description": "Rainbow chard and onion roast until tender, then finish with pieces of feta for a simple savory side.",
  "meal_type": "side",
