  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Coat a baking dish with the olive oil."
    },
    {
      "step": 2,
      "text": "Add the chopped chard stems and onion to the dish. Season with salt and black pepper, and toss to coat."
    },
    {
      "step": 3,
      "text": "Bake for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Stir in the chard leaves and season with additional salt and black pepper as needed."
    },
    {
      "step": 5,
      "text": "Scatter the feta over the vegetables and return the dish to the oven. Bake until the chard is tender, about 20 minutes.",
      "timer_minutes": 20
    }
  ],
