  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "x-400g-cans-butter-beans-drained",
      "item": "x 400g cans butter beans drained",
      "quantity": 2,
      "preparation": "reserving the liquid"
    },
    {
      "ingredient_id": "pecorino-or-parmesan-finely-grated",
      "item": "pecorino or parmesan finely grated",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "preparation": "crusty bread and cooked greens to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the butter and drained butter beans in a skillet over medium heat, stirring for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Continue stirring until the butter has melted and the beans are hot. Add a little reserved bean liquid if needed for a loose coating."
    },
    {
      "step": 3,
      "text": "Transfer the beans to serving dishes and top with the grated pecorino or parmesan."
    },
    {
      "step": 4,
      "text": "Drizzle with olive oil and serve with crusty bread and cooked greens."
    }
  ],
