  "id": "cacio-e-pepe-butter-beans",
  "name": "Cacio e Pepe Butter Beans",
  "subtitle": "Creamy beans with grated cheese and olive oil",
  "description": "Warm butter beans are coated in melted butter and finished with finely grated pecorino or parmesan. Serve with crusty bread and cooked greens.",
  "meal_type": "side",
  "cuisine": "Italian",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
