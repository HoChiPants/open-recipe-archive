  "id": "vegan-scalloped-potatoes",
  "name": "Vegan Scalloped Potatoes",
  "subtitle": "Layered potatoes in a savory dairy-free sauce",
  "description": "Thinly sliced potatoes and onions bake beneath a simple broth-based sauce until tender and lightly seasoned with paprika.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 12,
      "preparation": "peeled and thinly sliced"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "non-dairy-butter",
      "item": "non-dairy butter",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-broth",
      "item": "vegetable broth",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Arrange the potatoes and onions in layers in the prepared dish, seasoning each layer with salt and black pepper."
    },
    {
      "step": 3,
      "text": "Melt the non-dairy butter in a saucepan over medium heat. Stir in the flour until smooth, then gradually whisk in the vegetable broth to make a smooth sauce."
    },
    {
      "step": 4,
      "text": "Pour the sauce evenly over the layered vegetables and sprinkle with paprika."
    },
    {
      "step": 5,
      "text": "Bake until the potatoes are tender, about 50 minutes.",
      "timer_minutes": 50
    }
  ],
