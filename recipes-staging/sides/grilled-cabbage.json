  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill."
    },
    {
      "step": 2,
      "text": "Cut the cabbage into wedges and place them on a sheet of aluminum foil."
    },
    {
      "step": 3,
      "text": "Season the cabbage with garlic powder, salt, and pepper, then fold the foil around it to form a sealed packet."
    },
    {
      "step": 4,
      "text": "Grill the foil packet until the cabbage is tender, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Open the packet and grill the cabbage for 1 minute before serving.",
      "timer_minutes": 1
