  "id": "broccoli-with-cheddar",
  "name": "Broccoli with Cheddar",
  "subtitle": "A quick, buttery vegetable side",
  "description": "Tender broccoli is tossed with melted butter, seasoning, and shredded Cheddar for an easy savory side.",
  "meal_type": "side",
