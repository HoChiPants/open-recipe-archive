  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a saucepan over medium heat. Add the chopped onion and cook for 8 minutes, stirring occasionally, until softened.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Stir in the instant rice, diced tomatoes, chopped cilantro, and chicken broth."
    },
    {
      "step": 3,
      "text": "Cook for 10 minutes, stirring as needed, until the rice is tender and the mixture reaches 165°F on a food thermometer.",
