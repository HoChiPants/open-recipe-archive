  "instructions": [
    {
      "step": 1,
      "text": "Cover the washed beans with water and soak for 8 hours. Drain.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Combine the beans, chicken stock, salt, and pepper in a large pot. Bring to a simmer."
    },
    {
      "step": 3,
      "text": "Preheat the oven for the covered cooking stage, then stir the beans and add the tomatoes, dark beer, onion, cilantro, jalapeños, garlic, oregano, and bay leaves.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Cook until the beans are tender and the liquid reaches at least 165°F when checked with a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Remove the bay leaves, adjust the salt and pepper, and serve hot."
    }
