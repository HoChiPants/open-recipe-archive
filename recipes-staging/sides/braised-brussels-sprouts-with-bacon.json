      "item": "Chardonnay wine",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter with the olive oil in a large skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the onion and garlic; cook for 7 minutes, stirring occasionally, until softened.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Add the Brussels sprouts and cook for 10 minutes, stirring occasionally, until they begin to brown.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the bacon, bouillon, red pepper flakes, black pepper, and Chardonnay."
    },
    {
      "step": 5,
      "text": "Cook for 2 minutes, stirring, then continue cooking the sprouts until tender and the finished dish reaches 165°F when checked with a food thermometer.",
      "timer_minutes": 15
    }
  ],
