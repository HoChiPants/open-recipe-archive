  "id": "braised-brussels-sprouts-with-bacon",
  "name": "Braised Brussels Sprouts with Bacon",
  "subtitle": "Tender sprouts with savory bacon and wine",
  "description": "Brussels sprouts are sautéed with aromatics, bacon, spices, and Chardonnay, then cooked until tender.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
