      "quantity": 2,
      "unit": "pounds",
      "preparation": "trimmed and halved"
    },
    {
      "ingredient_id": "crumbled-cooked-bacon",
      "item": "crumbled cooked bacon",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "powdered-chicken-bouillon",
      "item": "powdered chicken bouillon",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
