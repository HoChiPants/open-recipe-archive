  "id": "charred-hispi-cabbage-with-hazelnut-chilli-butter",
  "name": "Charred Hispi Cabbage with Hazelnut-Chilli Butter",
  "subtitle": "Tender cabbage with a crisp, nutty finish",
  "description": "Cabbage wedges are charred until tender, then served with warm butter flavored with chilli, hazelnuts, and parsley.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "as a side"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "hispi",
      "item": "hispi",
      "quantity": 1,
      "unit": "large",
      "preparation": "pointed or sweetheart cabbage"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": "1 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "red-chilli-deseeded-and-finely-chopped",
      "item": "red chilli deseeded and finely chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "hazelnuts-blanched-and-chopped",
      "item": "hazelnuts blanched and chopped",
      "quantity": 20,
      "unit": "g"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "finely-chopped-parsley",
      "item": "finely chopped parsley",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill or grill pan to high heat."
    },
    {
      "step": 2,
      "text": "Cut the cabbage into wedges, keeping the core intact so the pieces hold together."
    },
    {
      "step": 3,
      "text": "Brush the wedges with the olive oil and grill until well charred, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Continue cooking until the cabbage is tender throughout, about 15 minutes more.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Meanwhile, sauté the chilli and hazelnuts for 3 minutes. Stir in the butter until melted, then fold in the parsley.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Serve the tender cabbage with the warm hazelnut-chilli butter."
    }
  ],
