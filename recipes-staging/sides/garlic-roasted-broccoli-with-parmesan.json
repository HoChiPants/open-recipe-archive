  "id": "garlic-roasted-broccoli-with-parmesan",
  "name": "Garlic-Roasted Broccoli with Parmesan",
  "subtitle": "Tender roasted broccoli with garlic, lemon, and savory cheese",
  "description": "Broccoli is roasted with garlic and seasonings, then finished with Parmesan and lemon juice for a bright, savory side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "head-broccoli",
      "item": "head broccoli",
      "quantity": 1,
      "preparation": "washed and cut into bite-sized pieces"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra virgin olive oil",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "coarse-ground-black-pepper",
      "item": "coarse ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dietz-watson-shaved-parmesan-cheese",
      "item": "Dietz & Watson Shaved Parmesan Cheese",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Combine the broccoli and garlic with most of the divided olive oil, salt, and pepper. Toss to coat."
    },
    {
      "step": 3,
      "text": "Spread the broccoli on a baking sheet and roast until tender, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Stir together the remaining olive oil, Parmesan cheese, and lemon juice."
    },
    {
      "step": 5,
      "text": "Toss the roasted broccoli with the Parmesan mixture and serve."
    }
  ],
