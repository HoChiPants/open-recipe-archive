{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cheesy-ranch-potato-bake",
  "name": "Cheesy Ranch Potato Bake",
  "subtitle": "Tender seasoned potatoes with a creamy melted cheese topping",
  "description": "Cubed russet potatoes bake with chili seasoning and butter, then finish under a melted cheese and ranch topping.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "russet-potatoes",
      "item": "russet potatoes",
      "quantity": 4,
      "unit": "pounds",
      "preparation": "cut into 1/4 inch cubes"
    },
    {
      "ingredient_id": "chili-powder",
      "item": "chili powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 6,
      "unit": "tablespoons",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "colby-monterey-jack-cheese-blend",
      "item": "colby-Monterey Jack cheese blend",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, shredded"
    },
    {
      "ingredient_id": "ranch-dressing",
      "item": "Ranch dressing",
      "quantity": 1,
      "unit": "bottle",
      "preparation": "8 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Place the cubed potatoes in a baking dish. Mix the chili powder, salt, and pepper, then sprinkle the mixture over the potatoes and toss to coat."
    },
    {
      "step": 3,
      "text": "Dot the potatoes with the cubed butter and bake until tender, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Stir together the shredded cheese and ranch dressing. Spread the mixture over the potatoes and bake until the cheese is melted, about 10 minutes.",
      "timer_minutes": 10
    }
  ],
