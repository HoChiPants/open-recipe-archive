  "id": "baked-sweet-potato-sticks",
  "name": "Baked Sweet Potato Sticks",
  "subtitle": "Paprika-seasoned wedges with crisp edges",
  "description": "Sweet potatoes are coated with olive oil and paprika, then baked until tender with browned edges.",
  "meal_type": "side",
