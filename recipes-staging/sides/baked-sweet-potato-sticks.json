    },
    {
      "ingredient_id": "sweet-potatoes",
      "item": "sweet potatoes",
      "quantity": 8,
      "preparation": "sliced lengthwise into quarters"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Place the sweet potato quarters in a bowl. Stir the olive oil and paprika together, then coat the potatoes evenly with the mixture."
    },
    {
      "step": 3,
      "text": "Transfer the seasoned potatoes to a baking sheet in a single layer."
    },
    {
      "step": 4,
      "text": "Bake for 40 minutes, until tender and browned at the edges.",
