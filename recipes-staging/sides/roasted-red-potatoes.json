  "id": "roasted-red-potatoes",
  "name": "Roasted Red Potatoes",
  "subtitle": "Crisp-edged potatoes with peppers and thyme",
  "description": "Red potatoes roast with bell pepper, thyme, and a lightly spicy seasoning until tender and browned.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 65,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "or more if needed"
    },
    {
      "ingredient_id": "red-potatoes",
      "item": "red potatoes",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "cut into evenly sized pieces"
    },
    {
      "ingredient_id": "red-bell-pepper",
      "item": "red bell pepper",
      "quantity": 0.5,
      "unit": "large",
      "preparation": "seeded and cut into 1-inch pieces"
    },
    {
      "ingredient_id": "fresh-thyme-sprigs",
      "item": "fresh thyme sprigs",
      "quantity": 5,
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "kosher-salt-and-freshly-ground-black-pepper-to-taste",
      "item": "kosher salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Pour the olive oil into a baking dish and add the potatoes. Toss to coat evenly."
    },
    {
      "step": 3,
      "text": "Add the bell pepper, thyme, salt, black pepper, and cayenne; toss again to distribute the seasonings."
    },
    {
      "step": 4,
      "text": "Bake for 30 minutes, then stir and spread the vegetables into an even layer.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Continue baking until the potatoes are tender and browned, about 35 minutes.",
      "timer_minutes": 35
    }
  ],
