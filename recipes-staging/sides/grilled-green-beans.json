  "id": "grilled-green-beans",
  "name": "Grilled Green Beans",
  "subtitle": "Garlic-seasoned green beans with smoky char",
  "description": "Green beans are coated with olive oil, garlic, and salt, rested to absorb flavor, then grilled until tender with lightly charred edges.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-green-beans",
      "item": "fresh green beans",
      "quantity": 1,
      "unit": "pound",
      "preparation": "trimmed"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the green beans, olive oil, garlic, and kosher salt in a bowl; toss until evenly coated."
    },
    {
      "step": 2,
      "text": "Let the seasoned beans stand for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat a grill to medium-high heat."
    },
    {
      "step": 4,
      "text": "Transfer the beans to a grill basket, then place the basket on the grill."
    },
    {
      "step": 5,
      "text": "Grill, stirring occasionally, for 10 minutes, or until the beans are tender and lightly charred.",
      "timer_minutes": 10
    }
  ],
