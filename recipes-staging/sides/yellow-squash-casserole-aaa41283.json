  "id": "yellow-squash-casserole-aaa41283",
  "name": "Yellow Squash Casserole",
  "subtitle": "Tender squash baked with a creamy cheese mixture and crisp stuffing topping",
  "description": "A savory American side dish combining sautéed yellow squash and onion with a creamy cheese sauce, finished with seasoned stuffing mix.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
