  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Heat the oil in a skillet. Add the diced squash and onion, and cook until tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the water as needed and cook for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Stir the cooked squash and onion with the soup, sour cream, and shredded Cheddar until evenly combined."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to a baking dish and sprinkle the stuffing mix evenly over the top."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until hot and bubbling throughout and the center reaches 165°F.",
      "timer_minutes": 30
    }
  ],
