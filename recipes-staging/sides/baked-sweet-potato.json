  "id": "baked-sweet-potato",
  "name": "Baked Sweet Potato",
  "subtitle": "Tender oven-baked sweet potatoes with optional toppings",
  "description": "Soft, caramelized sweet potatoes finished with olive oil, sea salt, and a choice of simple toppings.",
  "meal_type": "side",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-potatoes",
      "item": "sweet potatoes",
      "quantity": 2,
      "unit": "medium"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "of-sea-salt-flakes",
      "item": "of sea salt flakes",
      "unit": "pinch"
    },
    {
      "ingredient_id": "butter-tuna-mayo",
      "item": "butter tuna mayo",
      "preparation": "chilli con carne, baked beans, cheese or green salad (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Scrub the sweet potatoes, dry them, and pierce each several times with a fork. Rub with olive oil and sprinkle with sea salt flakes."
    },
    {
      "step": 3,
      "text": "Bake for 60 minutes, checking after 45 minutes, until the potatoes are tender when pierced with a knife.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Split open and add butter tuna mayo, if desired. If the optional topping contains fish, heat it to 145°F; if it contains egg in a raw egg dish, heat it to 160°F."
    }
  ],
