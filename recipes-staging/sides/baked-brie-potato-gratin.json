      "item": "white miso paste (optional)",
      "quantity": 1,
      "unit": "tsp",
      "optional": true
    },
    {
      "ingredient_id": "potatoes-such-as-de-sire-e",
      "item": "potatoes (such as Désirée",
      "quantity": 900,
      "unit": "g",
      "preparation": "Russet or Maris Piper), peeled and thinly sliced on a mandoline"
    },
    {
