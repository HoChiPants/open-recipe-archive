  "id": "baked-brie-potato-gratin",
  "name": "Baked Brie Potato Gratin",
  "subtitle": "Creamy layered potatoes with thyme and brie",
  "description": "Thinly sliced potatoes simmer in an aromatic cream mixture, then bake with brie until tender and bubbling.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "thyme-sprigs-leaves-picked",
      "item": "thyme sprigs leaves picked",
      "quantity": 3
    },
    {
