      "item": "vegetarian brie thinly sliced",
      "quantity": 200,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the double cream and milk together in a saucepan. Stir in the thyme leaves, bashed garlic, grated nutmeg, and miso if using."
    },
    {
      "step": 2,
      "text": "Add the sliced potatoes and cook gently until they are tender but still hold their shape.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Meanwhile, butter a baking dish and preheat the oven to 400°F."
    },
    {
      "step": 4,
      "text": "Layer the tender potatoes and sliced brie in the prepared dish, finishing with a layer of brie."
    },
    {
      "step": 5,
      "text": "Bake until the gratin is bubbling, golden, and fully tender in the center.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Let the gratin stand briefly before serving.",
      "timer_minutes": 10
    }
  ],
