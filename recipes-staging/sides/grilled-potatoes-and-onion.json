  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill to medium heat."
    },
    {
      "step": 2,
      "text": "Arrange the sliced potatoes and red onion in a grill-safe pan or foil packet."
    },
    {
      "step": 3,
      "text": "Melt the butter and combine it with the salt and black pepper. Pour over the vegetables and toss to coat."
    },
    {
