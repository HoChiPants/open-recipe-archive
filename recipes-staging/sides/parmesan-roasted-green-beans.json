  "id": "parmesan-roasted-green-beans",
  "name": "Parmesan-Roasted Green Beans",
  "subtitle": "Tender green beans with a crisp, savory cheese topping",
  "description": "Green beans are seasoned, roasted, and finished with shredded Parmesan for an easy vegetable side.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil-cooking-spray",
      "item": "olive oil cooking spray"
    },
    {
      "ingredient_id": "fresh-green-beans",
      "item": "fresh green beans",
      "quantity": 0.75,
      "unit": "pound",
      "preparation": "trimmed"
    },
    {
      "ingredient_id": "sea-salt-and-freshly-ground-black-pepper-to-taste",
      "item": "sea salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "parmesan-cheese",
      "item": "Parmesan cheese",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "shredded, or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F and lightly coat a baking sheet with olive oil cooking spray."
    },
    {
      "step": 2,
      "text": "Arrange the trimmed green beans on the sheet. Season with salt, pepper, and garlic powder, then toss to coat."
    },
    {
      "step": 3,
      "text": "Sprinkle the Parmesan over the beans and roast for 10 minutes, until the beans are tender and the cheese is lightly browned.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Serve hot."
    }
  ],
