      "item": "grated fresh ginger root",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "thinly-sliced-green-onion",
      "item": "thinly sliced green onion",
      "quantity": 0.25,
      "unit": "teaspoon"
