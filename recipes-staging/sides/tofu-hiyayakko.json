  "id": "tofu-hiyayakko",
  "name": "Tofu Hiyayakko",
  "subtitle": "Chilled silken tofu with ginger and savory dashi sauce",
  "description": "A simple Japanese side of cool silken tofu topped with ginger, green onion, bonito, sesame, and a lightly sweetened sauce.",
  "meal_type": "side",
  "cuisine": "Japanese",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
