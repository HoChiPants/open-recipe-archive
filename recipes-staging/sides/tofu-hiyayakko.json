      "item": "sesame seeds",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "toasted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the soy sauce, sugar, dashi granules, and water until combined."
    },
    {
      "step": 2,
      "text": "Place the silken tofu on a serving dish."
    },
    {
      "step": 3,
      "text": "Top with the ginger, green onion, bonito shavings, and sesame seeds."
    },
    {
      "step": 4,
      "text": "Confirm the bonito shavings came from fish heated to 145°F, or are opaque and easily flaked, then spoon the sauce over the tofu."
    }
  ],
