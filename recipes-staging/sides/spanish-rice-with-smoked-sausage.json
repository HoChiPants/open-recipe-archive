      "item": "smoked sausage",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into bite-sized pieces"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "uncooked-white-rice",
      "item": "uncooked white rice",
      "quantity": 1.5,
      "unit": "cups"
    },
