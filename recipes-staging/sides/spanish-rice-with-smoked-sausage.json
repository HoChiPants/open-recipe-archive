  "id": "spanish-rice-with-smoked-sausage",
  "name": "Spanish Rice with Smoked Sausage",
  "subtitle": "A savory skillet rice side with smoky sausage",
  "description": "Rice simmers with tomato sauce, aromatics, and bite-sized smoked sausage for a hearty, well-seasoned side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
