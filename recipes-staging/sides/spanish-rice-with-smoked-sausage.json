      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a large, deep skillet over medium heat. Add the onion and garlic; cook, stirring, until the onion softens.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the smoked sausage and cook, stirring, until browned and heated through. If the sausage is raw, cook until it reaches 160°F in the center."
    },
    {
      "step": 3,
      "text": "Stir in the water, uncooked white rice, tomato sauce, adobo seasoning, salt, and pepper. Bring the mixture to a boil."
    },
    {
      "step": 4,
      "text": "Reduce the heat, cover, and simmer until the rice is tender and the liquid is absorbed.",
      "timer_minutes": 20
    }
  ],
