  "id": "grilled-potato-wedges",
  "name": "Grilled Potato Wedges",
  "subtitle": "Herb-seasoned potato wedges with crisp grilled edges",
  "description": "Parboiled potato wedges are coated in rosemary, thyme, garlic, and olive oil, then finished on the grill until tender and browned.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-rosemary",
      "item": "fresh rosemary",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped, or more to taste"
    },
    {
      "ingredient_id": "fresh-thyme",
      "item": "fresh thyme",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped, or more to taste"
    },
    {
      "ingredient_id": "clove-garlic",
      "item": "clove garlic",
      "quantity": 1,
      "unit": "large",
      "preparation": "peeled and crushed"
    },
    {
      "ingredient_id": "idaho-potatoes",
      "item": "Idaho potatoes",
      "quantity": 4,
      "preparation": "each cut into 8 wedges"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper-to-taste",
      "item": "freshly ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the olive oil, rosemary, thyme, crushed garlic, and garlic salt. Let the mixture stand for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Place the potato wedges in a saucepan, cover with water, and simmer until just tender, about 9 minutes. Drain well.",
      "timer_minutes": 9
    },
    {
      "step": 3,
      "text": "Preheat a grill to medium-high heat."
    },
    {
      "step": 4,
      "text": "Toss the drained potatoes with the herb oil and black pepper until evenly coated."
    },
    {
      "step": 5,
      "text": "Grill the wedges, turning occasionally, until browned and tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
