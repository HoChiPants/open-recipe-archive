  "id": "german-red-cabbage",
  "name": "German Red Cabbage",
  "subtitle": "Sweet-tart braised cabbage with apple",
  "description": "Tender red cabbage cooked with apple, onion, cider vinegar, and lingonberry jam for a colorful sweet-tart side dish.",
  "meal_type": "side",
