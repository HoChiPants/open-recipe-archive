  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large pot over medium heat. Add the sugar and stir for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the onion and apple, then cook and stir the onion for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the red cabbage and cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the vegetable broth, cider vinegar, and salt. Cover and simmer for 30 minutes, until the cabbage is tender.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Stir in the lingonberry jam and season with salt and fresh-ground black pepper to taste."
    }
  ],
