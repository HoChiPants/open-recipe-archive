  "id": "spinach-casserole-c6a3f622",
  "name": "Spinach Casserole",
  "subtitle": "Creamy spinach topped with crisp onions",
  "description": "A simple baked side combining thawed spinach, creamy soup, softened cream cheese, and a crunchy onion topping.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 2,
      "unit": "package",
      "preparation": "10 ounce, thawed and drained"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "french-fried-onions",
      "item": "French-fried onions",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce, divided"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Lightly prepare a small casserole dish."
    },
    {
      "step": 2,
      "text": "In a bowl, combine the spinach, softened cream cheese, soup, and half of the French-fried onions until evenly mixed."
    },
    {
      "step": 3,
      "text": "Spread the mixture in the casserole dish and sprinkle the remaining onions over the top."
    },
    {
      "step": 4,
      "text": "Bake until hot throughout and the topping is crisp, about 20 minutes.",
      "timer_minutes": 20
    }
  ],
