      "item": "vegetable oil for frying",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs until smooth. Stir in the shredded and diced zucchini."
    },
    {
      "step": 2,
      "text": "Mix in the basil, Parmesan, salt, and pepper, then add the flour and stir until combined."
    },
    {
      "step": 3,
      "text": "Preheat the vegetable oil to 375°F in a suitable frying pan or pot."
    },
    {
      "step": 4,
      "text": "Prepare the fritters by dropping portions of batter into the hot oil, leaving space between them."
    },
    {
      "step": 5,
      "text": "Cook for 4 minutes, turning as needed, until golden brown and firm in the center.",
      "timer_minutes": 4
    },
    {
      "step": 6,
      "text": "Drain the fritters before serving."
    }
  ],
