  "id": "italian-zucchini-fritters",
  "name": "Italian Zucchini Fritters",
  "subtitle": "Crisp vegetable fritters with basil and Parmesan",
  "description": "Shredded and diced zucchini are folded into a seasoned egg-and-flour batter, then fried until golden and set.",
  "meal_type": "side",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
