  "instructions": [
    {
      "step": 1,
      "text": "Cover the navy beans with the water and let them stand for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Drain the beans. Place them in a saucepan with the cooking water, baking soda, and bay leaf, then simmer until tender, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Heat the oven to 300°F. Combine the beans with the bacon, onion, molasses, brown sugar, mustard powder, salt, and black pepper in a baking dish."
    },
    {
      "step": 4,
      "text": "Cover and bake for 60 minutes, stirring once during baking.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Increase the oven temperature to 350°F and bake until the beans are tender and the sauce is thick, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
