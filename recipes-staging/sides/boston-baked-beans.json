  "id": "boston-baked-beans",
  "name": "Boston Baked Beans",
  "subtitle": "Slow-baked navy beans with molasses and bacon",
  "description": "Navy beans simmer until tender, then bake with bacon, onion, molasses, brown sugar, and mustard for a rich, savory-sweet side dish.",
