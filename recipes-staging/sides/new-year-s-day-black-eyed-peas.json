  "instructions": [
    {
      "step": 1,
      "text": "Place the black-eyed peas in a large pot and cover them with water."
    },
    {
      "step": 2,
      "text": "Add the chopped ham, diced onions, salt and pepper, and garlic powder."
    },
    {
      "step": 3,
      "text": "Crush the whole tomatoes by hand or with a spoon, then add them to the pot."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a boil, reduce the heat, and simmer until the peas are tender, about 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Taste and adjust the seasoning before serving."
    }
