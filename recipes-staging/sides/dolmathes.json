  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Warm part of the olive oil in a skillet. Cook the onions until tender."
    },
    {
      "step": 3,
      "text": "Stir in the rice and cook until lightly browned."
    },
    {
      "step": 4,
      "text": "Transfer the rice mixture as needed and cook for 20 minutes, or until the rice is tender.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Stir in the lemon juice, dill, parsley, and pine nuts."
    },
    {
      "step": 6,
      "text": "Preheat the oven to 375°F if needed. Lay the grape leaves flat and place a portion of filling near each stem end. Fold in the sides and roll tightly."
    },
    {
      "step": 7,
      "text": "Arrange the rolls in a baking dish, drizzle with the remaining olive oil, and bake for 45 minutes.",
      "timer_minutes": 45
    }
  ],
