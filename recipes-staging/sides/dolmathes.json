  "id": "dolmathes",
  "name": "Dolmathes",
  "subtitle": "Herbed rice wrapped in grape leaves",
  "description": "Tender grape leaves encase a fragrant rice, onion, herb, lemon, and pine nut filling, then bake until finished.",
  "meal_type": "side",
  "cuisine": "Greek",
  "yield": {
    "quantity": 7,
