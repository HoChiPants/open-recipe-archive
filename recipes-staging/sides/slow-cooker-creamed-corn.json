  "id": "slow-cooker-creamed-corn",
  "name": "Slow Cooker Creamed Corn",
  "subtitle": "Rich, creamy corn for an easy side",
  "description": "Frozen sweet corn cooks slowly with cream, cream cheese, butter, and simple seasonings for a comforting side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 250
  },
  "ingredients": [
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "frozen-sweet-corn",
      "item": "frozen sweet corn",
      "quantity": 5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the cream cheese and butter to a slow cooker and cook until melted, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk in the heavy whipping cream, sugar, salt, and pepper until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the frozen corn, cover, and cook until hot and creamy, about 4 hours.",
      "timer_minutes": 240
    }
  ],
