      "ingredient_id": "broccoli-crowns",
      "item": "broccoli crowns",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into small pieces"
    },
    {
      "ingredient_id": "cauliflower",
      "item": "cauliflower",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "broken into small florets"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "half-and-half",
      "item": "half-and-half",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
