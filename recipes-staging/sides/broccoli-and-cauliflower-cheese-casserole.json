  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Bring salted water to a simmer. Add the broccoli and cauliflower, cook for 3 minutes until tender, then drain and transfer to a baking dish.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Melt the butter in a saucepan over medium heat. Stir in the flour and cook for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Whisk in the half-and-half and Dijon mustard. Simmer until the sauce thickens slightly."
    },
    {
      "step": 5,
      "text": "Remove from the heat and let the sauce stand for 2 minutes. Stir in the Cheddar, Parmesan, and paprika until melted, then season with salt and pepper.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Pour the cheese sauce over the vegetables. Top with the remaining Cheddar, Parmesan, and breadcrumbs."
    },
    {
      "step": 7,
      "text": "Bake until lightly browned.",
      "timer_minutes": 20
    }
  ],
