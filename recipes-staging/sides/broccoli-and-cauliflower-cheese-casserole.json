  "id": "broccoli-and-cauliflower-cheese-casserole",
  "name": "Broccoli and Cauliflower Cheese Casserole",
  "subtitle": "Tender vegetables in a creamy cheese sauce with a crisp crumb topping",
  "description": "A warm vegetable side dish combining broccoli and cauliflower with mustard-cheese sauce, finished with Cheddar, Parmesan, and breadcrumbs.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
