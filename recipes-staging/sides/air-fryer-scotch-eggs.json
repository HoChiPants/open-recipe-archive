  "id": "air-fryer-scotch-eggs",
  "name": "Air-Fryer Scotch Eggs",
  "subtitle": "Crisp sausage-wrapped eggs with bacon and herbs",
  "description": "Soft-cooked eggs are enclosed in seasoned sausage, coated in flour and panko, then air-fried until crisp and safely cooked.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 5
    },
    {
      "ingredient_id": "sausages-about-350g",
      "item": "sausages (about 350g)",
      "quantity": 6,
      "preparation": "skins removed"
    },
    {
      "ingredient_id": "rashers-unsmoked-streaky-bacon-finely-chopped",
      "item": "rashers unsmoked streaky bacon finely chopped",
      "quantity": 6
    },
    {
      "ingredient_id": "sage-leaves-finely-chopped",
      "item": "sage leaves finely chopped",
      "quantity": 8,
      "preparation": "or 2 tsp dried sage"
    },
    {
      "ingredient_id": "dried-mixed-herbs",
      "item": "dried mixed herbs",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "75g-panko-breadcrumbs",
      "item": "75g panko breadcrumbs",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "oil-spray-optional",
      "item": "oil spray (optional)",
      "optional": true
    },
    {
      "ingredient_id": "mustard-to-serve-optional",
      "item": "mustard to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to the manufacturer's instructions. Cook the eggs in boiling water for 8 minutes, then cool them in cold water and peel carefully.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Mix the sausage meat with the chopped bacon, sage, and mixed herbs. Divide the mixture into portions and flatten each into a thin round."
    },
    {
      "step": 3,
      "text": "Whisk one egg in a shallow bowl. Place the flour in a second bowl and the panko breadcrumbs in a third."
    },
    {
      "step": 4,
      "text": "Wrap each peeled egg in a sausage portion, sealing the meat completely. Roll each wrapped egg in flour, then the whisked egg, and finally the breadcrumbs."
    },
    {
      "step": 5,
      "text": "Preheat the air fryer if required. Arrange the coated eggs in the basket, spray lightly with oil if using, and cook for 20 minutes, turning once, until browned and the sausage reaches 160°F in the center.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Rest briefly and serve with mustard if desired."
    }
  ],
