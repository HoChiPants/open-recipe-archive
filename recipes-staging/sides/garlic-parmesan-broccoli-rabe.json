  "id": "garlic-parmesan-broccoli-rabe",
  "name": "Garlic Parmesan Broccoli Rabe",
  "subtitle": "Tender greens with garlic and Parmesan",
  "description": "Blanch broccoli rabe, then finish it in olive oil with garlic and Parmesan for a savory side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "broccoli-rabe",
      "item": "broccoli rabe",
      "quantity": 1,
      "unit": "pound",
      "preparation": "trimmed"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra virgin olive oil",
      "quantity": 5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer. Cut the trimmed broccoli rabe into manageable pieces and add it to the water."
    },
    {
      "step": 2,
      "text": "Cook until tender, about 5 minutes, then drain well.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Warm the olive oil and minced garlic in a skillet for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the drained broccoli rabe and stir-fry until well coated and heated through, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir in the grated Parmesan and serve warm."
    }
  ],
