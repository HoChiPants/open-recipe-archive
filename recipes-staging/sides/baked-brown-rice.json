      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Lightly coat a covered baking dish with the canola oil."
    },
    {
      "step": 2,
      "text": "Add the brown rice and salt to the dish, then pour in the boiling water. Stir briefly and spread the rice into an even layer."
    },
    {
      "step": 3,
      "text": "Cover the dish tightly and bake for 60 minutes, until the water is absorbed and the rice is tender.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Let the rice stand briefly, then fluff with a fork and serve."
    }
  ],
