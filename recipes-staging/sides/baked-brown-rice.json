  "id": "baked-brown-rice",
  "name": "Baked Brown Rice",
  "subtitle": "Tender, hands-off brown rice from the oven",
  "description": "Brown rice baked with boiling water, salt, and a little canola oil for a simple side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
