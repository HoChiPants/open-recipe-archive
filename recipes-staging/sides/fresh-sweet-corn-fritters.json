  "id": "fresh-sweet-corn-fritters",
  "name": "Fresh Sweet Corn Fritters",
  "subtitle": "Crisp fritters with tender corn and cane syrup",
  "description": "A simple sweet-savory side dish made with fresh corn, a light egg-based batter, and a crisp fried exterior.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ears-fresh-corn",
      "item": "ears fresh corn",
      "quantity": 3,
      "preparation": "kernels cut from cob"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "separated"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-pepper-to-taste",
      "item": "salt and freshly ground pepper to taste"
    },
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying",
      "quantity": 1,
      "unit": "quart",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "cane-syrup",
      "item": "cane syrup",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or as desired"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, baking powder, and corn kernels in a bowl."
    },
    {
      "step": 2,
      "text": "Whisk the eggs and heavy cream together, then season with salt and freshly ground pepper."
    },
    {
      "step": 3,
      "text": "Whisk the separated egg whites to stiff peaks. Fold them into the corn mixture, then fold in the egg-and-cream mixture until combined."
    },
    {
      "step": 4,
      "text": "Transfer the vegetable oil to a heavy pot or deep fryer and preheat it to 375°F."
    },
    {
      "step": 5,
      "text": "Fry spoonfuls of batter in batches for about 3 minutes, turning as needed, until golden brown.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Drain the fritters and serve with cane syrup as desired."
    }
  ],
