  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, quinoa, and pinch of salt in a saucepan. Bring to a simmer, cover, and cook for 20 minutes, or until the quinoa is tender.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Drain any excess liquid and set the quinoa aside."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a skillet over medium heat. Stir in the minced garlic and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the bell pepper, corn, and salt and pepper. Cook for 5 minutes, until the pepper is tender.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Season with oregano, cumin, and additional salt and pepper to taste. Stir in the quinoa and green onions, and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Serve warm."
    }
  ],
