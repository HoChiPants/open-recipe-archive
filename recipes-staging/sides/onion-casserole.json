  "id": "onion-casserole",
  "name": "Onion Casserole",
  "subtitle": "Tender sweet onions with a creamy Parmesan topping",
  "description": "A savory baked side dish combining softened sweet onions, sour cream, Parmesan, and buttery crackers.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-onions",
      "item": "sweet onions",
      "quantity": 5,
      "unit": "large",
      "preparation": "cut into 1/4 inch slices and separated into rings"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "buttery-crackers",
      "item": "buttery crackers",
      "quantity": 10
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Melt the margarine in a skillet over medium heat. Add the onion rings and cook, stirring occasionally, until tender."
    },
    {
      "step": 3,
      "text": "Combine the sour cream and grated Parmesan cheese."
    },
    {
      "step": 4,
      "text": "Transfer the tender onions to a casserole dish and spread the sour cream mixture over them. Add the buttery crackers on top."
    },
    {
      "step": 5,
      "text": "Bake until hot and lightly browned, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
