  "id": "non-edible-cinnamon-ornaments",
  "name": "Non-Edible Cinnamon Ornaments",
  "subtitle": "Fragrant shaped ornaments for seasonal decorating",
  "description": "A simple cinnamon, spice, applesauce, and glue dough formed into decorative ornaments. Do not eat.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 1,
    "unit": "dozen"
  },
  "times": {
    "prep_minutes": 60,
    "cook_minutes": 0,
    "inactive_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cloves",
      "item": "ground cloves",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "applesauce",
      "item": "applesauce",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "glue",
      "item": "glue",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 200°F. Line a baking sheet if desired."
    },
    {
      "step": 2,
      "text": "Stir the cinnamon, cloves, and nutmeg together. Combine the applesauce and glue separately, then add the mixture to the spices."
    },
    {
      "step": 3,
      "text": "Knead and shape the dough for about 3 minutes. Adjust the consistency with small amounts of cinnamon or applesauce as needed.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Roll out the dough, shape it, and cut approximately 12 ornaments."
    },
    {
      "step": 5,
      "text": "Place the ornaments on the prepared baking sheet and dry them in the 200°F oven until firm. Decorate after cooling. These ornaments are non-edible; keep them away from food and do not serve."
    }
  ],
