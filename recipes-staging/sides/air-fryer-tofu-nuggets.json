  "id": "air-fryer-tofu-nuggets",
  "name": "Air-Fryer Tofu Nuggets",
  "subtitle": "Crisp, savory tofu bites with a seasoned crumb coating",
  "description": "Extra-firm tofu is pressed, coated in a mustard-milk batter and seasoned panko, then air-fried until crisp and cooked through.",
  "meal_type": "side",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "block-extra-firm-tofu",
      "item": "block extra-firm tofu",
      "quantity": 1
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": "1 1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 125,
      "unit": "ml"
    },
    {
      "ingredient_id": "panko-breadcrumbs",
      "item": "panko breadcrumbs",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "garlic-granules",
      "item": "garlic granules",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "bouillon-powder",
      "item": "bouillon powder",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Press the tofu for 30 minutes, then cut it into bite-size nuggets.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Mix the plain flour and half of the paprika in one shallow dish."
    },
    {
      "step": 3,
      "text": "Whisk the Dijon mustard and milk together in a second dish until smooth."
    },
    {
      "step": 4,
      "text": "Combine the panko breadcrumbs, remaining paprika, garlic granules, and bouillon powder in a third dish."
    },
    {
      "step": 5,
      "text": "Preheat the air fryer according to its instructions."
    },
    {
      "step": 6,
      "text": "Dip each tofu piece in the milk mixture, then coat it thoroughly with the panko mixture."
    },
    {
      "step": 7,
      "text": "Arrange the nuggets in a single layer in the air fryer basket, working in batches if needed."
    },
    {
      "step": 8,
      "text": "Air-fry for 15 minutes, turning or shaking halfway, until crisp and cooked through.",
      "timer_minutes": 15
    },
    {
      "step": 9,
      "text": "Let the nuggets stand briefly before serving."
    }
  ],
