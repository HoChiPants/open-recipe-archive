  "id": "grilled-corn-with-cilantro-lime-butter",
  "name": "Grilled Corn with Cilantro-Lime Butter",
  "subtitle": "Charred corn finished with bright herb butter",
  "description": "Soak the unhusked corn, grill it until tender, and serve it with chilled cilantro-lime butter accented with cayenne.",
  "meal_type": "side",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-cilantro",
      "item": "fresh cilantro",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fresh-lime-juice",
      "item": "fresh lime juice",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "ears-corn-on-the-cob",
      "item": "ears corn on the cob",
      "quantity": 8,
      "preparation": "unhusked"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 3,
      "unit": "quarts",
      "preparation": "or as needed to cover"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the butter until smooth. Stir in the cilantro, lime juice, and cayenne pepper until combined."
    },
    {
      "step": 2,
      "text": "Blend the butter mixture, then chill it for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Place the unhusked corn in a container and cover it with the cold water. Soak for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Preheat a grill to medium-high heat."
    },
    {
      "step": 5,
      "text": "Transfer the soaked corn to the grill. Cook, turning occasionally, until tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Serve the grilled corn with the cilantro-lime butter."
    }
  ],
