  "id": "pan-fried-broccoli",
  "name": "Pan-Fried Broccoli",
  "subtitle": "Tender broccoli with a gentle chile kick",
  "description": "Thawed broccoli is quickly sautéed with olive oil and crushed red pepper for an easy, flavorful side.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-broccoli",
      "item": "frozen broccoli",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce, thawed"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "preparation": "to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Thaw the broccoli and drain away excess water."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet over medium heat."
    },
    {
      "step": 3,
      "text": "Add the crushed red pepper flakes and cook briefly until fragrant.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the broccoli and sauté, stirring occasionally, until hot and lightly browned.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Season with salt to taste and serve."
    }
  ],
