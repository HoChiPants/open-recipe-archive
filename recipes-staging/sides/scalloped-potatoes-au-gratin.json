  "id": "scalloped-potatoes-au-gratin",
  "name": "Scalloped Potatoes au Gratin",
  "subtitle": "Layered potatoes with ham, onion, and creamy cheese sauce",
  "description": "Thinly sliced russet potatoes are layered with ham, onion, cheese, and mushroom soup, then baked until tender and bubbling.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 135
  },
  "ingredients": [
    {
      "ingredient_id": "cream-of-mushroom-soup",
      "item": "cream of mushroom soup",
      "quantity": 2,
      "unit": "can",
      "preparation": "10.5 ounce, divided"
    },
    {
      "ingredient_id": "ham-slices",
      "item": "ham slices",
      "quantity": 1,
      "unit": "cup",
      "preparation": "cooked, or to taste, divided"
    },
    {
      "ingredient_id": "russet-potatoes",
      "item": "russet potatoes",
      "quantity": 6,
      "unit": "large",
      "preparation": "or more to taste, thinly sliced and divided"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "thinly sliced and divided"
    },
    {
      "ingredient_id": "italian-cheese-blend",
      "item": "Italian cheese blend",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "shredded, or more to taste, divided"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.33333334326744,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Transfer the soup to a bowl and mix it with the milk."
    },
    {
      "step": 3,
      "text": "Layer portions of the potatoes, ham, onion, and cheese in a baking dish, seasoning each layer with the soup mixture as directed by the divided ingredients."
    },
    {
      "step": 4,
      "text": "Finish with the remaining soup mixture and cheese."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, then continue baking for 45 minutes until the potatoes are tender and the casserole is bubbling.",
      "timer_minutes": 105
    },
    {
      "step": 6,
      "text": "Let the casserole stand for 30 minutes before serving.",
      "timer_minutes": 30
    }
  ],
