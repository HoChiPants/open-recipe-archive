  "id": "garden-green-beans",
  "name": "Garden Green Beans",
  "subtitle": "Tender green beans with Parmesan, garlic, and parsley",
  "description": "Blanch fresh green beans, then coat them in a savory garlic-Parmesan dressing and finish with parsley.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-green-beans",
      "item": "fresh green beans",
      "quantity": 1,
      "unit": "pound",
      "preparation": "trimmed"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "freshly-grated-parmesan-cheese",
      "item": "freshly grated Parmesan cheese",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the olive oil, Parmesan, vinegar, sliced garlic, salt, and pepper in a bowl."
    },
    {
      "step": 2,
      "text": "Bring a pot of water to a simmer and cook the green beans for 5 minutes, until tender-crisp.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Drain the beans and transfer them to the bowl. Toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Let the dressed beans stand for 10 minutes so the flavors blend.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Remove the sliced garlic if desired, garnish with parsley, and serve."
    }
  ],
