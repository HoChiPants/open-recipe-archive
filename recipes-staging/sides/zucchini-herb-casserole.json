  "instructions": [
    {
      "step": 1,
      "text": "Combine the rice and water in a saucepan. Bring to a simmer, cover, and cook for about 20 minutes, or until the rice is tender.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Heat the oven to 350°F. Lightly grease a baking dish."
    },
    {
      "step": 3,
      "text": "Heat the oil in a large skillet. Add the zucchini, green onions, garlic, and garlic salt; cook for about 5 minutes, stirring, until the zucchini is tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the basil, paprika, oregano, and tomatoes. Fold the vegetable mixture into the cooked rice with 1 1/2 cups of the cheese."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to the baking dish and scatter the remaining cheese over the top."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, until the cheese is melted and the casserole is hot throughout.",
      "timer_minutes": 20
    }
  ],
