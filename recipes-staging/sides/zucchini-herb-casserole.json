  "id": "zucchini-herb-casserole",
  "name": "Zucchini Herb Casserole",
  "subtitle": "A savory baked side with tender zucchini, rice, herbs, and cheddar",
  "description": "Cooked rice combines with seasoned zucchini, tomatoes, and cheddar, then bakes until the topping is melted and lightly set.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
