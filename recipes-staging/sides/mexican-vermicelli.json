  "id": "mexican-vermicelli",
  "name": "Mexican Vermicelli",
  "subtitle": "Toasted pasta simmered in tomato-seasoned stock",
  "description": "A simple Mexican-style vermicelli side dish made by browning the pasta before simmering it with onion, chicken stock, and tomato-flavored bouillon.",
  "meal_type": "side",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
