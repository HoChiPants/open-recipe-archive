    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "minced"
    },
    {
      "ingredient_id": "vermicelli-pasta",
      "item": "vermicelli pasta",
      "quantity": 7,
      "unit": "ounces"
    },
    {
      "ingredient_id": "chicken-stock",
      "item": "chicken stock",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "cubes-tomato-flavored-bouillon",
      "item": "cubes tomato-flavored bouillon",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a saucepan over medium heat and add the canola oil."
    },
    {
      "step": 2,
      "text": "Add the minced onion and stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Stir in the vermicelli and cook until golden brown.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the chicken stock and tomato-flavored bouillon cubes. Bring the mixture to 165°F, then reduce to a simmer."
    },
    {
      "step": 5,
      "text": "Simmer until the vermicelli is tender and the liquid is absorbed.",
      "timer_minutes": 11
    }
  ],
