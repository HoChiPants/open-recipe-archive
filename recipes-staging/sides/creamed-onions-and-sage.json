  "instructions": [
    {
      "step": 1,
      "text": "Cut the onions and place them in a saucepan with the salt. Simmer for about 20 minutes, until tender, then drain.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet. Add the mushrooms and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the flour and cook for 2 minutes. Gradually stir in the milk, sage, lemon zest, and lemon juice, then cook for 5 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Combine the drained onions with the sauce and transfer the mixture to a baking dish."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes. Finish with lemon zest, lemon juice, parsley, and paprika.",
      "timer_minutes": 20
    }
  ],
