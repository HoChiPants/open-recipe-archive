  "instructions": [
    {
      "step": 1,
      "text": "Rinse the gizzards and livers; trim the livers as needed."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large pot over medium heat. Add the gizzards and chopped onion and cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the livers and garlic. Cook for 3 minutes, stirring, until the chicken organs reach 165°F on a food thermometer.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Stir in the uncooked rice, then add the chicken broth, salt, black pepper, and cayenne pepper."
    },
    {
      "step": 5,
      "text": "Bring to a simmer, cover, and cook until the rice is tender and the liquid is absorbed, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Stir in the green onions and serve hot."
    }
  ],
