  "id": "southern-dirty-rice",
  "name": "Southern Dirty Rice",
  "subtitle": "Savory rice with chicken giblets and green onions",
  "description": "A seasoned rice side dish cooked with finely chopped chicken gizzards, livers, aromatics, and broth.",
  "meal_type": "side",
  "cuisine": "American",
