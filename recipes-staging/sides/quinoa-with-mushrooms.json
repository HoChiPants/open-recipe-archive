  "id": "quinoa-with-mushrooms",
  "name": "Quinoa with Mushrooms",
  "subtitle": "A savory quinoa side with tender mushrooms and Parmesan",
  "description": "Quinoa is toasted with butter, simmered in broth, and finished with sautéed mushrooms, onion, garlic, and Parmesan.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
