  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a skillet over medium heat. Add the mushrooms, onion, and garlic; cook for 5 minutes, stirring occasionally, until softened. Set aside.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan over medium heat. Add the rinsed quinoa and cook for 3 minutes, stirring, until coated and lightly toasted.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Pour in the chicken broth and bring to a simmer. If the broth contains raw poultry, cook the mixture until it reaches 165°F on a food thermometer."
    },
    {
      "step": 4,
      "text": "Cover and simmer for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir the quinoa for 2 minutes, then fold in the mushroom mixture and Parmesan. Serve warm.",
      "timer_minutes": 2
    }
  ],
