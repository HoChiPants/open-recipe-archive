  "id": "roasted-baby-eggplant-tomato-and-zucchini",
  "name": "Roasted Baby Eggplant, Tomato, and Zucchini",
  "subtitle": "Tender roasted summer vegetables with garlic",
  "description": "A simple roasted vegetable side combining eggplant, tomatoes, zucchini, onion, and garlic.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "purple-eggplants",
      "item": "purple eggplants",
      "quantity": 4,
      "unit": "small",
      "preparation": "cut into 1 1/2-inch cubes"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-pepper-to-taste",
      "item": "salt and freshly ground pepper to taste",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "roma-plum-tomatoes",
      "item": "Roma (plum) tomatoes",
      "quantity": 5,
      "preparation": "or more to taste, cut into 1 1/2-inch cubes"
    },
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 2,
      "preparation": "cut into 1 1/2-inch cubes"
    },
    {
      "ingredient_id": "onion",
      "item": "yellow onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "cut into 1 1/2-inch cubes"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 5,
      "unit": "cloves",
      "preparation": "or more to taste, peeled"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Place the cubed eggplant in a colander or bowl, season with the salt and pepper, and let it drain for 30 minutes. Pat dry if needed.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Combine the tomatoes, zucchini, onion, and garlic in a large bowl. Add the eggplant, season with the remaining salt and pepper, and stir to combine."
    },
    {
      "step": 4,
      "text": "Add the olive oil and toss until the vegetables are evenly coated."
    },
    {
      "step": 5,
      "text": "Transfer the vegetables to a baking dish or roasting pan and spread them into an even layer."
    },
    {
      "step": 6,
      "text": "Roast for 30 minutes, stirring once if needed, until the vegetables are tender.",
      "timer_minutes": 30
    }
  ],
