  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "roasted-cauliflower-rice",
  "name": "Roasted Cauliflower Rice",
  "subtitle": "Tender, lightly browned cauliflower with crisp roasted edges",
  "description": "Pulse chopped cauliflower into rice-sized pieces, coat it with avocado oil, and roast until tender and golden.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 27
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "heads-cauliflower",
      "item": "heads cauliflower",
      "quantity": 2,
      "preparation": "cut into 1/2-inch pieces"
    },
    {
      "ingredient_id": "avocado-oil",
      "item": "avocado oil",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.75,
      "unit": "teaspoon",
      "preparation": "divided"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F. Lightly coat two baking sheets with cooking spray."
    },
    {
      "step": 2,
      "text": "Working in batches, pulse the cauliflower pieces until they resemble rice. Transfer to a bowl, add the avocado oil and half the salt, and toss to coat."
    },
    {
      "step": 3,
      "text": "Spread the cauliflower in a single layer across the prepared baking sheets."
    },
    {
      "step": 4,
      "text": "Roast for 16 minutes, then stir and return to the oven for 6 minutes.",
      "timer_minutes": 16
    },
    {
      "step": 5,
      "text": "Stir again and let the cauliflower stand for 5 minutes. Toss with the remaining salt and serve.",
      "timer_minutes": 11
    }
  ],
