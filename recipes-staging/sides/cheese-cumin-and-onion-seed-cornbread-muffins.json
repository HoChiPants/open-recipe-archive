      "item": "onion seeds",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "eggs-beaten",
      "item": "eggs beaten",
      "quantity": 2
    },
    {
      "ingredient_id": "extra-mature-cheddar-grated",
      "item": "extra-mature cheddar grated",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "parmesan-finely-grated",
      "item": "parmesan finely grated",
      "quantity": 25,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and oil a 12-cup muffin tin."
    },
    {
      "step": 2,
      "text": "Whisk together the self-raising flour, polenta or cornmeal, bicarbonate of soda, mustard powder, cayenne pepper, cumin seeds, and onion seeds."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the milk and beaten eggs until smooth, then whisk in the sunflower oil."
    },
    {
      "step": 4,
      "text": "Pour the wet mixture into the dry ingredients and stir just until combined. Fold in the cheddar and Parmesan."
    },
    {
      "step": 5,
      "text": "Divide the batter among the prepared muffin cups."
    },
    {
      "step": 6,
      "text": "Bake until risen and set, about 22 minutes.",
      "timer_minutes": 22
    },
    {
      "step": 7,
      "text": "Transfer the muffins to a rack and let them cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Serve warm or at room temperature."
    }
  ],
