  "id": "cheese-cumin-and-onion-seed-cornbread-muffins",
  "name": "Cheese, Cumin, and Onion Seed Cornbread Muffins",
  "subtitle": "Savory cornmeal muffins with aged cheese and warm spices",
  "description": "Tender savory muffins combining cornmeal, cheddar, Parmesan, cumin, onion seed, and a mild cayenne finish.",
  "meal_type": "side",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "sunflower-oil-plus-extra-for-the-tin",
      "item": "sunflower oil plus extra for the tin",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "polenta-or-cornmeal",
      "item": "polenta or cornmeal",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "bicarbonate-of-soda",
      "item": "bicarbonate of soda",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
