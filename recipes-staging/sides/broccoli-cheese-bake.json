  "id": "broccoli-cheese-bake",
  "name": "Broccoli Cheese Bake",
  "subtitle": "Tender broccoli in a creamy Swiss cheese sauce",
  "description": "Blanch broccoli, fold it into a savory cheese sauce with beaten eggs, and bake until hot and fully set.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 7,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-broccoli",
      "item": "fresh broccoli",
      "quantity": 8,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "swiss-cheese",
      "item": "Swiss cheese",
      "quantity": 4,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large",
      "preparation": "beaten"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Cook the broccoli in boiling water until tender, about 6 minutes. Drain well.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Melt the butter in a saucepan. Stir in the flour, then add the onion and milk. Simmer for 1 minute, stirring, until thickened.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Season with salt and pepper. Stir in the Swiss cheese and beaten eggs until combined."
    },
    {
      "step": 5,
      "text": "Fold in the broccoli and transfer the mixture to a baking dish."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until hot and the center reaches 160°F.",
      "timer_minutes": 30
    }
  ],
