  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a heavy skillet or saucepan over medium heat. Add the onion and cook, stirring occasionally, for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the ginger-garlic paste and green chile peppers; cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the tomatoes, coriander, cumin, turmeric, and salt. Stir until combined and the tomatoes begin to soften."
    },
    {
      "step": 4,
      "text": "Add the and cubed turnips and hot water. Stir, bring to a simmer, and cook until the turnips are tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Stir in the brown sugar and serve warm."
    }
  ],
