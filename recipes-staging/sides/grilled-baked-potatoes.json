  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill."
    },
    {
      "step": 2,
      "text": "Scrub the potatoes and pierce each several times with a fork."
    },
    {
      "step": 3,
      "text": "Rub the potatoes with olive oil and season with salt."
    },
    {
      "step": 4,
      "text": "Wrap each potato in a sheet of aluminum foil and place the packets on the grill."
    },
    {
      "step": 5,
      "text": "Grill, turning occasionally, until the potatoes are tender when pierced, about 60 minutes total.",
      "timer_minutes": 15
    }
