{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "broccoli-and-cauliflower-casserole",
  "name": "Broccoli and Cauliflower Casserole",
  "subtitle": "A creamy vegetable-and-rice side with a crisp cracker topping.",
  "description": "Tender broccoli, cauliflower, and rice are combined with a cheesy sauce, topped with crushed crackers, and baked until hot and set.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 7,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "uncooked-white-rice",
      "item": "uncooked white rice",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "broccoli-florets",
      "item": "broccoli florets",
      "quantity": 10,
      "unit": "ounces"
    },
    {
      "ingredient_id": "cauliflower-florets",
      "item": "cauliflower florets",
      "quantity": 10,
      "unit": "ounces"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "processed-cheese-food",
      "item": "processed cheese food",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "fluid-ounces-milk",
      "item": "fluid ounces milk",
      "quantity": 5.375
    },
    {
      "ingredient_id": "buttery-round-crackers",
      "item": "buttery round crackers",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F; use the preheating time to prepare the casserole.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Simmer the uncooked white rice in water until tender, then drain well."
    },
    {
      "step": 3,
      "text": "Simmer the broccoli florets and cauliflower florets until tender-crisp, about 10 minutes, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Sauté the chopped onion in the butter until softened."
    },
    {
      "step": 5,
      "text": "Stir the rice and drained vegetables into the onion mixture. Add the cubed processed cheese food, condensed cream of chicken soup, and milk, stirring until evenly combined."
    },
    {
      "step": 6,
      "text": "Transfer the mixture to a baking dish and scatter the crushed buttery round crackers over the top."
    },
    {
      "step": 7,
      "text": "Bake at 350°F until bubbling, the center is fully hot, and a thermometer registers 165°F.",
      "timer_minutes": 30
    }
  ],
