{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "brazilian-white-rice",
  "name": "Brazilian White Rice",
  "subtitle": "Fluffy stovetop rice with onion and garlic",
  "description": "A simple savory rice side cooked with aromatics and hot water until tender.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "long-grain-white-rice",
      "item": "long-grain white rice",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "minced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "hot-water",
      "item": "hot water",
      "quantity": 4,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a covered saucepan over medium heat. Cook the onion until softened."
    },
    {
      "step": 2,
      "text": "Stir in the garlic and cook until golden brown."
    },
    {
      "step": 3,
      "text": "Add the rice and salt, stirring to coat the grains."
    },
    {
      "step": 4,
      "text": "Pour in the hot water and bring the mixture to a boil."
    },
    {
      "step": 5,
      "text": "Cover, reduce the heat to low, and cook until the rice is tender and the water is absorbed, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Remove from the heat and let stand covered until set, then fluff and serve."
    }
  ],
