  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil and butter in a large covered braising pan over medium heat."
    },
    {
      "step": 2,
      "text": "Add the onion wedges and brown sugar. Cook, stirring occasionally, until the onions begin to soften, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Cut the cabbage into wedges and arrange it in the pan with the bay leaves, thyme, and cinnamon stick."
    },
    {
      "step": 4,
      "text": "Stir together the cider, balsamic vinegar, cider vinegar, hot vegetable stock, and brown sugar, then pour the mixture into the pan."
    },
    {
      "step": 5,
      "text": "Cover and simmer gently until the cabbage is tender, about 50 minutes. Adjust the heat as needed to maintain a gentle simmer.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Remove the bay leaves, thyme sprigs, and cinnamon stick before serving."
    }
  ],
