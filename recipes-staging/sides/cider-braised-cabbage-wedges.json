  "id": "cider-braised-cabbage-wedges",
  "name": "Cider-Braised Cabbage Wedges",
  "subtitle": "Tender red cabbage with cider, vinegar, and warm spice",
  "description": "Red cabbage wedges are gently braised with onions, cider, vinegar, stock, and aromatic herbs for a sweet-tart winter side dish.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
