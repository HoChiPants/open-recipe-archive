  "id": "baked-sweet-potatoes",
  "name": "Baked Sweet Potatoes",
  "subtitle": "Tender oven-baked potatoes with oregano and pepper",
  "description": "Sweet potatoes are coated with olive oil and simple seasonings, then baked until tender for an easy savory side dish.",
  "meal_type": "side",
