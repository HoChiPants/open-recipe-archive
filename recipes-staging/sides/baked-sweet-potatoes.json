  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Wash and dry the sweet potatoes, then cut them into halves or similarly sized pieces."
    },
    {
      "step": 3,
      "text": "Arrange the potatoes on a baking sheet and coat them with the olive oil, dried oregano, salt, and black pepper."
    },
    {
      "step": 4,
      "text": "Bake until the potatoes are tender when pierced with a fork, about 45 minutes.",
      "timer_minutes": 45
    }
