  "instructions": [
    {
      "step": 1,
      "text": "Combine the green papaya or mooli, carrots, shallots, chilli, ginger, and garlic in a heatproof bowl. Set aside for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the cider vinegar and caster sugar together in a saucepan until the sugar dissolves and the mixture is hot.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pour the hot vinegar mixture over the reserved vegetables and aromatics, ensuring they are well coated."
    },
