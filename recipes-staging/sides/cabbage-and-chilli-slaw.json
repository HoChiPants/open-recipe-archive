  "ingredients": [
    {
      "ingredient_id": "white-cabbage-finely-sliced",
      "item": "white cabbage finely sliced",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "quantity-smoky-chilli-sauce-see-recipe-in-goes-well-with",
      "item": "quantity smoky chilli sauce (see recipe in 'Goes well with'",
      "quantity": "1/2",
      "preparation": "below)"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "spring-onions-trimmed-and-finely-sliced-on-an-angle",
      "item": "spring onions trimmed and finely sliced on an angle",
      "quantity": 8
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the finely sliced cabbage in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the smoky chilli sauce and lemon juice, then toss until the cabbage is evenly coated."
    },
    {
      "step": 3,
      "text": "Leave the dressed cabbage to set for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Toss through the sliced spring onions and serve."
    }
