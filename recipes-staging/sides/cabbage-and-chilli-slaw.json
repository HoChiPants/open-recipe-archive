  "id": "cabbage-and-chilli-slaw",
  "name": "Cabbage and Chilli Slaw",
  "subtitle": "A crisp, tangy no-cook cabbage side",
  "description": "Thinly sliced cabbage is dressed with smoky chilli sauce and lemon, then finished with angled spring onions for a bright, crunchy slaw.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
