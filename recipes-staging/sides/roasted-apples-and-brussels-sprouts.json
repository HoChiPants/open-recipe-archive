      "item": "juice from 1 lemon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Arrange the frozen Brussels sprouts on a baking sheet. Add the apples and sweet onions, drizzle with olive oil, and season with salt, pepper, and garlic powder."
    },
    {
      "step": 3,
      "text": "Toss until the vegetables and fruit are evenly coated, then spread them into an even layer."
    },
    {
      "step": 4,
      "text": "Roast for 20 minutes, until the Brussels sprouts are tender and lightly browned.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Toss with the lemon zest and lemon juice, then serve warm."
    }
  ],
