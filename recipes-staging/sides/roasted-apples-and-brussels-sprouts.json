    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-brussels-sprouts",
      "item": "frozen Brussels sprouts",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
