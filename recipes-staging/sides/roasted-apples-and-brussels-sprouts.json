  "id": "roasted-apples-and-brussels-sprouts",
  "name": "Roasted Apples and Brussels Sprouts",
  "subtitle": "A bright, savory-sweet roasted vegetable side",
  "description": "Frozen Brussels sprouts roast with apples and sweet onions, then finish with lemon zest and juice for a fresh, balanced side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
