      "quantity": 2,
      "preparation": "peeled, cored, and cut into 3/4-inch chunks"
    },
    {
      "ingredient_id": "sweet-onions",
      "item": "sweet onions",
      "quantity": 2,
      "preparation": "cut into 3/4-inch chunks"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or as needed"
    },
    {
