  "id": "campfire-baked-potatoes",
  "name": "Campfire Baked Potatoes",
  "subtitle": "Foil-wrapped potatoes cooked over an open fire",
  "description": "Butter-softened baking potatoes are wrapped in foil and cooked over a campfire until tender.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "baking-potatoes",
      "item": "baking potatoes",
      "quantity": 4,
      "unit": "medium"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sheets-heavy-duty-aluminum-foil",
      "item": "sheets heavy-duty aluminum foil",
      "quantity": 8
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Rinse and dry the potatoes, then prick each one several times with a fork."
    },
    {
      "step": 2,
      "text": "Spread softened butter over the potatoes. Wrap each potato securely in two sheets of heavy-duty aluminum foil."
    },
    {
      "step": 3,
      "text": "Place the foil packets in hot campfire coals or on a grate over the fire. Cook until the potatoes are tender when pierced with a knife, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Carefully open the packets and serve hot."
    }
  ],
