  "instructions": [
    {
      "step": 1,
      "text": "Place the sweet potatoes in a pot, cover with water, and simmer until tender, about 30 minutes. Drain well.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Heat the oven to 325°F. Mash the sweet potatoes with the cup butter, white sugar, and milk. Stir in the beaten eggs and vanilla until smooth."
    },
    {
      "step": 3,
      "text": "Spread the sweet potato mixture in a baking dish."
    },
    {
      "step": 4,
      "text": "Combine the brown sugar, coconut, pecans, and flour. Stir in the melted butter until crumbly, then scatter the topping over the sweet potatoes."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until cooked through and the center reaches 160°F or is fully set.",
      "timer_minutes": 60
    }
  ],
