{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "courgette-jam",
  "name": "Courgette Jam",
  "subtitle": "A bright, gingery vegetable spread",
  "description": "Grated courgettes cook down with jam sugar, lemon, and fresh ginger into a sweet-tart spread.",
  "meal_type": "side",
  "yield": {
    "quantity": 1.4,
    "unit": "kg"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "courgettes-grated",
      "item": "courgettes grated",
      "quantity": 1,
      "unit": "kg"
    },
    {
      "ingredient_id": "jam-sugar",
      "item": "jam sugar",
      "quantity": 750,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "thumb-sized-piece-of-ginger-peeled-and-grated",
      "item": "thumb-sized piece of ginger peeled and grated"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Chill a small plate for checking the jam's consistency later."
    },
    {
      "step": 2,
      "text": "Combine the grated courgettes and jam sugar in a large saucepan. Warm for 10 minutes, stirring until the sugar dissolves and the courgettes release their moisture.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Cook the mixture for another 10 minutes, stirring occasionally, until softened and reduced.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Juice the lemon and peel and grate the ginger."
    },
    {
      "step": 5,
      "text": "Stir the lemon juice and grated ginger into the saucepan."
    },
    {
      "step": 6,
      "text": "Simmer for 2 minutes, stirring, until evenly combined.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Preheat the cooking surface for 10 minutes if needed to maintain a gentle simmer.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Check a spoonful on the chilled plate; it should thicken as it cools."
    },
    {
      "step": 9,
      "text": "Cool slightly, then serve as a sweet-tart spread."
    }
  ],
