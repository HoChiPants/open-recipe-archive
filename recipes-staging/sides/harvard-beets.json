  "id": "harvard-beets",
  "name": "Harvard Beets",
  "subtitle": "Sweet-and-tangy glazed beets",
  "description": "Canned beets are warmed in a glossy vinegar-sugar sauce for an easy American side dish.",
  "meal_type": "side",
