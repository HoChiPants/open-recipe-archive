  "id": "savory-coconut-rice",
  "name": "Savory Coconut Rice",
  "subtitle": "Fragrant rice with ginger, turmeric, and toasted coconut",
  "description": "Tender jasmine or long-grain rice cooked in coconut milk with warm spices and finished with toasted coconut.",
  "meal_type": "side",
