  "instructions": [
    {
      "step": 1,
      "text": "Combine the rice, ginger, chili flakes, turmeric, salt, water, and coconut milk in a saucepan. Whisk until evenly combined, then add the bay leaf."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a boil, then cover and cook gently for 18 minutes, or until the liquid is absorbed and the rice is tender.",
      "timer_minutes": 18
    },
    {
      "step": 3,
      "text": "Remove from the heat and let the covered rice rest for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Discard the bay leaf, fluff the rice, and finish with the toasted coconut."
    }
  ],
