      "item": "green cabbage",
      "quantity": 4,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 2,
      "unit": "medium",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the vinegar, oil, sugar, dry mustard, poppy seeds, black pepper, salt, and hot pepper sauce until combined."
    },
    {
      "step": 2,
      "text": "Place the shredded cabbage and carrots in a large bowl and toss to distribute evenly."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the vegetables and toss until well coated."
    },
    {
      "step": 4,
      "text": "Cover and chill for 2 hours before serving.",
      "timer_minutes": 120
    }
  ],
