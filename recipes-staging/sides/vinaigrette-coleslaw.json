  "id": "vinaigrette-coleslaw",
  "name": "Vinaigrette Coleslaw",
  "subtitle": "Crisp cabbage and carrots in a tangy poppy-seed dressing",
  "description": "Shredded cabbage and carrots are tossed with a sweet-tangy vinaigrette and chilled until the flavors meld.",
  "meal_type": "side",
  "cuisine": "American",
