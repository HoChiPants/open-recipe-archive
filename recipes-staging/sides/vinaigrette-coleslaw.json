  },
  "ingredients": [
    {
      "ingredient_id": "apple-cider-vinegar",
      "item": "apple cider vinegar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
