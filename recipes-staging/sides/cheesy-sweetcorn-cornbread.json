  "instructions": [
    {
      "step": 1,
      "text": "Use the weighing scales and measuring jug to measure the ingredients. Preheat the oven and grease the 23 cm round cake tin with extra butter."
    },
    {
      "step": 2,
      "text": "In a large bowl, mix the cornmeal, flour, sugar, and baking powder."
    },
    {
      "step": 3,
      "text": "In a small bowl, whisk the melted butter, buttermilk or yogurt, and eggs with a fork."
    },
    {
      "step": 4,
      "text": "Add the sweetcorn and grated cheddar to the wet mixture, then fold it into the dry ingredients with a spatula until just combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared tin and bake until golden and the center is firm and fully set.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Wearing oven gloves, remove the cornbread and let it cool briefly before cutting into portions.",
      "timer_minutes": 10
    }
  ],
