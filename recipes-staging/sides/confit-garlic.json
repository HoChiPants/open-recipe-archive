  "id": "confit-garlic",
  "name": "Confit Garlic",
  "subtitle": "Slow-cooked garlic with thyme and olive oil",
  "description": "Whole peeled garlic cloves cook gently in olive oil with thyme until tender and spreadable.",
  "meal_type": "side",
  "yield": {
    "quantity": 1,
    "unit": "small jar"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "bulbs-of-garlic-peeled-and-left-whole-our-peeled-garlic-cloves-weighed-115g",
      "item": "bulbs of garlic peeled and left whole (our peeled garlic cloves weighed 115g)",
      "quantity": 2
    },
    {
      "ingredient_id": "thyme-sprigs",
      "item": "thyme sprigs",
      "quantity": 2
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 250,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to a low temperature. Place the garlic and thyme in a small ovenproof dish."
    },
    {
      "step": 2,
      "text": "Pour in the olive oil so the garlic is immersed, then cover the dish."
    },
    {
      "step": 3,
      "text": "Cook until the garlic is very tender and lightly colored, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Transfer the garlic and oil to a small jar, let cool, and refrigerate before serving."
    }
  ],
