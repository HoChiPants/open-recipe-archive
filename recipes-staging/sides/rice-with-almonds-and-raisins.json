  "id": "rice-with-almonds-and-raisins",
  "name": "Rice with Almonds and Raisins",
  "subtitle": "Buttery rice with sweet raisins and sliced almonds",
  "description": "A simple savory rice side dish finished with raisins and toasted almonds.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
