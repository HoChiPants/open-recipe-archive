    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "finely-chopped-onion",
      "item": "finely chopped onion",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "uncooked-white-rice",
      "item": "uncooked white rice",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "almonds",
      "item": "almonds",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium heat. Add the onion and cook until tender."
    },
    {
      "step": 2,
      "text": "Stir in the rice, raisins, chicken broth, salt, and pepper. Bring to a simmer."
    },
    {
      "step": 3,
      "text": "Cover and cook for 20 minutes, until the rice is tender, the liquid is absorbed, and the mixture reaches 165°F on a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Stir in the sliced almonds and serve."
    }
  ],
