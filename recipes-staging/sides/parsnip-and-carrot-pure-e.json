  "id": "parsnip-and-carrot-pure-e",
  "name": "Parsnip and Carrot Purée",
  "subtitle": "A smooth, buttery root-vegetable side",
  "description": "Tender parsnips and carrots are blended with butter and chives into a simple, savory purée.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "parsnips",
      "item": "parsnips",
      "quantity": 8,
      "preparation": "peeled and cut into 2 inch pieces"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 2,
      "preparation": "peeled and cut into 2-inch pieces"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 6,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "snipped-chives",
      "item": "snipped chives",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sea-salt-and-freshly-ground-black-pepper-to-taste",
      "item": "sea salt and freshly ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the parsnips and carrots in a saucepan, cover with water, and season with the salt and pepper."
    },
    {
      "step": 2,
      "text": "Bring to a boil, then cook for 20 minutes, or until the vegetables are tender.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Drain well and return the vegetables to the warm saucepan briefly to release excess moisture."
    },
    {
      "step": 4,
      "text": "Purée the vegetables until smooth, incorporating the divided butter as needed."
    },
    {
      "step": 5,
      "text": "Stir in the chives, adjust the seasoning, and serve warm."
    }
  ],
