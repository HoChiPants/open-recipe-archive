  "id": "roasted-garlic-lemon-broccoli",
  "name": "Roasted Garlic Lemon Broccoli",
  "subtitle": "Tender roasted broccoli with bright lemon",
  "description": "Broccoli florets are seasoned with garlic, olive oil, salt, and pepper, then roasted until tender and finished with lemon juice.",
  "meal_type": "side",
