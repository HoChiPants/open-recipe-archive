  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Toss the broccoli florets with the olive oil, sea salt, black pepper, and minced garlic."
    },
    {
      "step": 3,
      "text": "Spread the seasoned broccoli in a single layer on a baking sheet."
    },
    {
      "step": 4,
      "text": "Bake until tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Transfer the roasted broccoli to a serving dish."
    },
    {
      "step": 6,
      "text": "Toss with the lemon juice and serve."
    }
  ],
