  "id": "black-beans-corn-and-yellow-rice",
  "name": "Black Beans, Corn, and Yellow Rice",
  "subtitle": "A bright, hearty rice side with beans and corn",
  "description": "Tender yellow rice is combined with seasoned black beans, sweet corn, and lime for an easy side dish.",
  "meal_type": "side",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "yellow-rice-mix",
      "item": "yellow rice mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "whole-kernel-corn",
      "item": "whole kernel corn",
      "quantity": 1,
      "unit": "can",
      "preparation": "15.25 ounce, drained"
    },
    {
      "ingredient_id": "black-beans",
      "item": "black beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, rinsed and drained"
    },
    {
      "ingredient_id": "lime-juice",
      "item": "lime juice",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, yellow rice mix, and olive oil in a saucepan. Bring to a boil, then cover and cook until the rice is tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "While the rice cooks, stir together the drained corn, black beans, lime juice, and cumin."
    },
    {
      "step": 3,
      "text": "Fluff the cooked rice and fold in the bean-and-corn mixture. Serve warm."
    }
  ],
