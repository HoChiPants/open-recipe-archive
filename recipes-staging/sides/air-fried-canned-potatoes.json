  "id": "air-fried-canned-potatoes",
  "name": "Air-Fried Canned Potatoes",
  "subtitle": "Crisp, golden potatoes with minimal prep",
  "description": "Drain, dry, oil, and air-fry canned potatoes for an easy crisp-edged side dish.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
