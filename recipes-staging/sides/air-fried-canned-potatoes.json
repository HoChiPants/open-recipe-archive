  "ingredients": [
    {
      "ingredient_id": "can-peeled-potatoes-in-water",
      "item": "can peeled potatoes in water",
      "quantity": 560,
      "unit": "g"
    },
    {
      "ingredient_id": "sunflower-or-vegetable-oil",
      "item": "sunflower or vegetable oil",
      "quantity": 2,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Drain the potatoes thoroughly and pat them dry. Toss with the oil until evenly coated."
    },
    {
      "step": 2,
      "text": "Preheat the air fryer for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Arrange the potatoes in the air-fryer basket in an even layer."
    },
    {
      "step": 4,
      "text": "Air-fry for 25 minutes, shaking or turning the potatoes periodically, until golden and crisp outside.",
      "timer_minutes": 25
    }
  ],
