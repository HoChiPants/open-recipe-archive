  "ingredients": [
    {
      "ingredient_id": "seasoned-bread-crumbs",
      "item": "seasoned bread crumbs",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "eggplant",
      "item": "eggplant",
      "quantity": 1,
      "unit": "medium",
      "preparation": "peeled and sliced into 1/2 inch rounds"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the seasoned bread crumbs in a shallow dish."
    },
    {
      "step": 3,
      "text": "Coat each eggplant round with mayonnaise, then press it into the bread crumbs to cover."
    },
    {
      "step": 4,
      "text": "Arrange the coated slices in a single layer on a baking sheet. Bake for 45 minutes, checking after 20 minutes, until golden brown.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
  ],
