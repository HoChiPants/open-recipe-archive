  "id": "breaded-baked-eggplant",
  "name": "Breaded Baked Eggplant",
  "subtitle": "Tender eggplant with a crisp seasoned coating",
  "description": "Mayonnaise helps the seasoned crumbs adhere as the eggplant bakes into a simple Italian-style side dish.",
  "meal_type": "side",
  "cuisine": "Italian",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
