{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "air-fryer-parsnips",
  "name": "Air-Fryer Parsnips",
  "subtitle": "Tender roasted parsnips with sage and warm spice",
  "description": "Halved parsnips are air-fried until tender, then finished with sage, mace or nutmeg, and honey.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "parsnips-no-need-to-peel",
      "item": "parsnips (no need to peel)",
      "quantity": 750,
      "unit": "g",
      "preparation": "scrubbed, trimmed and halved or quartered lengthways"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "handful-of-sage-finely-chopped",
      "item": "handful of sage finely chopped"
    },
    {
      "ingredient_id": "ground-mace-or-nutmeg",
      "item": "ground mace or nutmeg",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 2,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to the appliance instructions."
    },
    {
      "step": 2,
      "text": "Toss the parsnips with the vegetable oil until evenly coated."
    },
    {
      "step": 3,
      "text": "Arrange the parsnips in a single layer in the air-fryer basket."
    },
    {
      "step": 4,
      "text": "Roast until tender, about 25 minutes, turning or shaking once halfway through.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Stir together the chopped sage, mace or nutmeg, and honey."
    },
    {
      "step": 6,
      "text": "Toss the roasted parsnips with the sage mixture."
    },
    {
      "step": 7,
      "text": "Return them to the basket and roast for 10 minutes more.",
      "timer_minutes": 10
    }
  ],
