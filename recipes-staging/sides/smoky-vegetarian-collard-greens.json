  "id": "smoky-vegetarian-collard-greens",
  "name": "Smoky Vegetarian Collard Greens",
  "subtitle": "Tender greens with savory smoke and gentle heat",
  "description": "Collard greens simmered in seasoned vegetable broth with onion, garlic, vinegar, and smoky spices.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "white-onion",
      "item": "white onion",
      "quantity": 0.5,
      "preparation": "diced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "bunch-collard-greens",
      "item": "bunch collard greens",
      "quantity": 1,
      "preparation": "stems removed and leaves torn into bite-size pieces"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-broth",
      "item": "vegetable broth",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "apple-cider-vinegar",
      "item": "apple cider vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "liquid-smoke-flavoring",
      "item": "liquid smoke flavoring",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "smoked-paprika",
      "item": "smoked paprika",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot over medium heat. Add the onion and garlic, and cook until softened, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Add the collard greens and red pepper flakes. Stir until the greens begin to wilt, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Pour in the vegetable broth and apple cider vinegar. Stir in the brown sugar, liquid smoke flavoring, and smoked paprika."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a gentle simmer, cover, and cook until the collards are tender, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Taste and serve warm."
    }
  ],
