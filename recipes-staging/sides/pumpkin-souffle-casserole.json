  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pumpkin-souffle-casserole",
  "name": "Pumpkin Soufflé Casserole",
  "subtitle": "A warmly spiced pumpkin bake with a tender, set center.",
  "description": "This simple pumpkin side combines a buttery egg mixture with milk, cake flour, cinnamon, and pumpkin purée, then bakes until firm.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "pumpkin-pure-e",
      "item": "pumpkin purée",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cake-flour",
      "item": "cake flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F. Sift or otherwise evenly distribute the baking powder to remove lumps."
    },
    {
      "step": 2,
      "text": "Whisk the sugar, softened butter, and eggs until smooth."
    },
    {
      "step": 3,
      "text": "Mix in the pumpkin purée until fully combined."
    },
    {
      "step": 4,
      "text": "Whisk the milk, cake flour, and baking powder in a separate bowl until smooth, then stir into the pumpkin mixture with the cinnamon."
    },
    {
      "step": 5,
      "text": "Bake at 450°F until set, about 45 minutes. Confirm the center reaches 160°F before serving.",
      "timer_minutes": 45
    }
  ],
