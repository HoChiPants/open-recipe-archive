  "id": "spelt-biscuits",
  "name": "Spelt Biscuits",
  "subtitle": "Tender, buttery biscuits with a nutty grain flavor",
  "description": "These quick American-style biscuits combine spelt flour, butter, and milk for a simple golden side.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "spelt-flour",
      "item": "spelt flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.66666668653488,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Whisk together the spelt flour, baking powder, and salt."
    },
    {
      "step": 3,
      "text": "Cut the butter into the dry ingredients until the mixture is crumbly."
    },
    {
      "step": 4,
      "text": "Stir in the milk just until a thick dough forms."
    },
    {
      "step": 5,
      "text": "Turn the dough onto a lightly floured surface, pat it to a workable thickness, and cut into biscuits."
    },
    {
      "step": 6,
      "text": "Bake until golden brown, about 15 minutes.",
      "timer_minutes": 15
    }
  ],
