  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the potatoes in simmering water until tender, about 30 minutes. Drain, transfer to a bowl, and let cool enough to handle.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Melt the 1/4 cup butter in a saucepan. Stir in the condensed soup and cook until warmed through."
    },
    {
      "step": 4,
      "text": "Whisk the potatoes, soup mixture, sour cream, Cheddar, and green onion together, then transfer to a baking dish."
    },
    {
      "step": 5,
      "text": "Combine the crushed cornflakes with the 2 tablespoons melted butter and scatter over the casserole."
    },
    {
      "step": 6,
      "text": "Bake until hot and lightly browned, about 45 minutes.",
      "timer_minutes": 45
    }
  ],
