      "item": "Cheddar cheese",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "green-onion",
      "item": "green onion",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
