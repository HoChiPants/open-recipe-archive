  "id": "cheesy-potato-casserole-94a02ec4",
  "name": "Cheesy Potato Casserole",
  "subtitle": "Tender potatoes in a creamy cheese sauce with a crisp cornflake topping.",
  "description": "A comforting potato side dish layered with mushroom sauce, sour cream, Cheddar, green onion, and a buttery cornflake crust.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 75
  },
  "ingredients": [
