  "id": "baked-breaded-cauliflower",
  "name": "Baked Breaded Cauliflower",
  "subtitle": "Crisp-coated cauliflower florets baked until tender",
  "description": "Cauliflower florets are dipped in seasoned egg, coated with panko, and baked for a crisp, savory side dish.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "panko-bread-crumbs",
      "item": "panko bread crumbs",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "head-cauliflower",
      "item": "head cauliflower",
      "quantity": 1,
      "preparation": "broken into florets"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, salt, and pepper in a bowl."
    },
    {
      "step": 3,
      "text": "Place the panko in a separate dish. Dip each cauliflower floret in the egg mixture, then coat it with panko."
    },
    {
      "step": 4,
      "text": "Arrange the coated florets on the prepared baking sheet."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, or until the cauliflower is tender.",
      "timer_minutes": 25
    }
  ],
