  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes in a saucepan, cover with water, and bring to a boil. Cook for 20 minutes, or until tender.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Drain the potatoes and return them to the warm pan briefly to dry. Mash until smooth."
    },
    {
      "step": 3,
      "text": "Melt the butter, then stir in the milk. Add the mixture to the potatoes and combine until creamy."
    }
