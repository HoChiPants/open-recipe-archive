  "id": "squash-and-zucchini-casserole",
  "name": "Squash and Zucchini Casserole",
  "subtitle": "Layered summer squash with tomatoes and Romano",
  "description": "A simple baked vegetable side layered with onions, tomatoes, butter, and Romano cheese.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
