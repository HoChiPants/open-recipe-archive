      "ingredient_id": "yellow-squash",
      "item": "yellow squash",
      "quantity": 2,
      "unit": "medium"
    },
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "vidalia-onions",
