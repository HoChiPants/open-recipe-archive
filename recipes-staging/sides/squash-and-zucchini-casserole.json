      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Arrange the yellow squash, zucchini, onions, and tomatoes in layers in a baking dish, seasoning with salt and pepper and sprinkling with some of the Romano cheese and butter."
    },
    {
      "step": 3,
      "text": "Add the remaining Romano cheese and butter over the top."
    },
    {
      "step": 4,
      "text": "Bake until the cheese is melted and the vegetables are tender.",
      "timer_minutes": 30
    }
  ],
