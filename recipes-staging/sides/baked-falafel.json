  "schema_version": "1.0.0",
  "id": "baked-falafel",
  "name": "Baked Falafel",
  "subtitle": "Herbed chickpea patties with warm spices",
  "description": "A simple vegetarian falafel made with chickpeas, herbs, aromatics, and spices, then baked until firm and lightly browned.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "x-400g-cans-chickpeas-drained-or-250g-dried-chickpeas",
      "item": "x 400g cans chickpeas drained (or 250g dried chickpeas",
      "quantity": 3,
      "preparation": "soaked in 1 litre cold water overnight, then drained)"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-coriander",
      "item": "ground coriander",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "red-onion-quartered",
      "item": "red onion quartered",
      "quantity": 1
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic cloves",
      "quantity": 3
    },
    {
      "ingredient_id": "sesame-seeds",
      "item": "sesame seeds",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1 1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "packs-parsley-stalks-only",
      "item": "packs parsley stalks only",
      "quantity": 2,
      "unit": "small"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Line a baking sheet with parchment."
    },
    {
      "step": 2,
      "text": "Pulse the chickpeas, cumin, coriander, cayenne, onion, garlic, sesame seeds, baking powder, and parsley in a food processor until finely chopped and cohesive but not smooth."
    },
    {
      "step": 3,
      "text": "Shape the mixture into evenly sized patties and arrange them on the prepared baking sheet."
    },
    {
      "step": 4,
      "text": "Bake for 20 minutes, turning once, until firm and lightly browned.",
      "timer_minutes": 20
    }
  ],
