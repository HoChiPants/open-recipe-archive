    },
    {
      "ingredient_id": "sweet-potatoes",
      "item": "sweet potatoes",
      "quantity": 3,
      "unit": "large",
      "preparation": "peeled and cut in 1-inch cubes"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk together the olive oil, honey, rosemary, salt, and pepper. Add the sweet potatoes and toss until evenly coated."
    },
    {
      "step": 3,
      "text": "Arrange the sweet potatoes in an even layer in a baking dish."
    },
    {
      "step": 4,
      "text": "Bake for 45 minutes, or until tender.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Increase the oven temperature to 450°F and bake for 15 minutes more.",
      "timer_minutes": 15
    }
  ],
