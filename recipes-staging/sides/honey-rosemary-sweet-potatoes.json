  "id": "honey-rosemary-sweet-potatoes",
  "name": "Honey-Rosemary Sweet Potatoes",
  "subtitle": "Tender roasted cubes with a fragrant herb glaze",
  "description": "Sweet potatoes are coated with honey, rosemary, olive oil, and seasonings, then baked until tender with lightly caramelized edges.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
