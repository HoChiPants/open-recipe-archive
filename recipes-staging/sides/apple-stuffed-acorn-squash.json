{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "apple-stuffed-acorn-squash",
  "name": "Apple-Stuffed Acorn Squash",
  "subtitle": "Tender squash filled with apples, raisins, and melted cheese",
  "description": "Roasted acorn squash becomes a warm, savory-sweet side with cinnamon apples, onions, raisins, brown sugar, and Cheddar.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 35,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "acorn-squash",
      "item": "acorn squash",
      "quantity": 3,
      "preparation": "halved and seeded"
    },
    {
      "ingredient_id": "stick-margarine",
      "item": "stick margarine",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "peeled",
      "item": "peeled",
      "quantity": 3,
      "unit": "cups",
      "preparation": "seeded, and chopped Granny Smith apples"
    },
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "golden-raisins",
      "item": "golden raisins",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "light-brown-sugar",
      "item": "light brown sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Arrange the squash halves in a baking dish and fill the cavities with the chopped apples."
    },
    {
      "step": 2,
      "text": "Bake for 40 minutes, until the squash is tender. Drain any excess liquid, then scoop the squash flesh and apples into a bowl, keeping the squash shells intact.",
      "timer_minutes": 40
    },
    {
      "step": 3,
      "text": "Melt the margarine in a skillet over medium heat. Add the onions and cook for 15 minutes, until softened.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Transfer the onions to the bowl. Stir in the squash mixture, Cheddar, raisins, brown sugar, and cinnamon."
    },
    {
      "step": 5,
      "text": "Spoon the filling back into the squash shells and return them to the baking dish."
    },
    {
      "step": 6,
      "text": "Bake for 15 minutes, until the cheese is melted and the filling is hot.",
      "timer_minutes": 15
    }
  ],
