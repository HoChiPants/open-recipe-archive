  "id": "prosciutto-wrapped-asparagus",
  "name": "Prosciutto-Wrapped Asparagus",
  "subtitle": "Tender asparagus with creamy cheese and savory prosciutto",
  "description": "Asparagus spears are layered with softened cheese, wrapped in prosciutto, and baked until tender.",
  "meal_type": "side",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
