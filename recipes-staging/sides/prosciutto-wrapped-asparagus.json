      "ingredient_id": "prosciutto",
      "item": "prosciutto",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "neufchatel-cheese",
      "item": "Neufchatel cheese",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "spears-fresh-asparagus",
      "item": "spears fresh asparagus",
      "quantity": 12,
      "preparation": "trimmed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Lay the prosciutto slices on a work surface and spread them with the softened Neufchatel cheese."
    },
    {
      "step": 3,
      "text": "Arrange the trimmed asparagus spears evenly over the prosciutto and cheese, then layer and wrap the prosciutto around the asparagus."
    },
    {
      "step": 4,
      "text": "Transfer the wrapped asparagus to a baking dish and bake until tender, about 15 minutes.",
      "timer_minutes": 15
    }
  ],
