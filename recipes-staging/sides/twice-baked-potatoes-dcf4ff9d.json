  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Bake the potatoes for 60 minutes, until tender.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Cook the bacon until crisp, transfer it to a plate, and drain. Heat the butter in a skillet; add the onion, mushrooms, red pepper, garlic powder, black pepper, chives, and salt. Cook until the onion softens."
    },
    {
      "step": 3,
      "text": "Halve the baked potatoes and scoop out the centers, leaving the skins intact. Combine the potato flesh with the sautéed onion mixture, sour cream, and half of the Cheddar."
    },
    {
      "step": 4,
      "text": "Spoon the filling into the potato shells. Top with the bacon, remaining Cheddar, and bread crumbs."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until the cheese has melted.",
      "timer_minutes": 15
    }
  ],
