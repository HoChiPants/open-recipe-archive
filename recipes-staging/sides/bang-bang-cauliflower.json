  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking tray."
    },
    {
      "step": 2,
      "text": "Mix the plain flour, paprika, and garlic granules in one bowl. Whisk the milk in a second bowl until smooth, and place the panko breadcrumbs in a third."
    },
    {
      "step": 3,
      "text": "Dip each cauliflower floret in the milk, coat it with the seasoned flour, dip it briefly again, then press it into the panko. Arrange the coated florets on the tray."
    },
    {
      "step": 4,
      "text": "Bake until golden brown and crisp.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Stir together the sweet chilli sauce, sriracha, lime juice, and maple syrup or honey. Toss the baked cauliflower with the sauce."
    },
    {
      "step": 6,
      "text": "Top with the toasted sesame seeds, sliced red chilli, and spring onions, then serve."
    }
  ],
