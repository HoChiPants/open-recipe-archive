  "id": "bang-bang-cauliflower",
  "name": "Bang Bang Cauliflower",
  "subtitle": "Crisp baked cauliflower with a spicy-sweet glaze",
  "description": "Small cauliflower florets are coated in seasoned crumbs, baked until golden, and finished with a bright chili sauce and fresh garnishes.",
  "meal_type": "side",
