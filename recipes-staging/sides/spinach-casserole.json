  "id": "spinach-casserole",
  "name": "Spinach Casserole",
  "subtitle": "Creamy spinach with a seasoned crumb topping",
  "description": "A simple baked side dish combining spinach, cream cheese, and seasoning beneath a crisp breadcrumb topping.",
