  "instructions": [
    {
      "step": 1,
      "text": "Prepare the frozen chopped spinach according to its package directions, then drain well."
    },
    {
      "step": 2,
      "text": "Whisk the cream cheese until smooth."
    },
    {
      "step": 3,
      "text": "Combine the spinach, cream cheese, and seasoning salt in a baking dish."
    },
    {
      "step": 4,
      "text": "Spread the mixture evenly and sprinkle the seasoned dried bread crumbs over the top."
    },
    {
      "step": 5,
      "text": "Bake at 350°F for 20 minutes, until hot throughout and the topping is lightly browned.",
