  "id": "air-fryer-potato-wedges",
  "name": "Air Fryer Potato Wedges",
  "subtitle": "Crisp seasoned wedges with tender centers",
  "description": "Unpeeled russet potatoes are seasoned with smoked paprika, oregano, and onion powder, then air-fried until browned and crisp.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "russet-potatoes-about-850g",
      "item": "Russet potatoes (about 850g)",
      "quantity": 4,
      "preparation": "unpeeled, cut into wedges"
    },
    {
      "ingredient_id": "vegetable-or-sunflower-oil",
      "item": "vegetable or sunflower oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "smoked-paprika",
      "item": "smoked paprika",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "onion-powder",
      "item": "onion powder",
      "quantity": 1,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Soak the potato wedges in cold water for 30 minutes, then drain thoroughly.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Drain again after boiling and leave the wedges to dry for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Combine the smoked paprika, dried oregano, and onion powder. Toss the wedges with the oil and seasoning mixture."
    },
    {
      "step": 4,
      "text": "Preheat the air fryer, add the wedges in a single layer, and cook until golden and crisp, turning or shaking as needed.",
      "timer_minutes": 40
    }
  ],
