  "instructions": [
    {
      "step": 1,
      "text": "Cook the thawed peas according to package directions, then set them aside."
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium heat. Add the onion and garlic; sauté for 5 minutes, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the peas, drained mushrooms, sugar, salt, thyme, and black pepper. Cook until heated through, then serve."
    }
