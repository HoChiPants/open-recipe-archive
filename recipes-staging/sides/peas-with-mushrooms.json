  "id": "peas-with-mushrooms",
  "name": "Peas with Mushrooms",
  "subtitle": "A quick buttery vegetable side",
  "description": "Thawed green peas and sliced mushrooms are seasoned with onion, garlic, thyme, and pepper for an easy savory side.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
