  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of water to a simmer, then bring it to a boil."
    },
    {
      "step": 2,
      "text": "Cook the spaghetti in the boiling water for 12 minutes, then drain.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a skillet over medium heat."
    },
    {
      "step": 4,
      "text": "Add the garlic and ground black pepper; stir for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Add the drained spaghetti and grated Pecorino Romano cheese to the skillet, then stir until the cheese melts, about 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Stir the spaghetti for 1 minute more, then serve.",
      "timer_minutes": 1
