  "instructions": [
    {
      "step": 1,
      "text": "Set the electric pressure cooker to sauté. Add the butter and let it melt."
    },
    {
      "step": 2,
      "text": "Stir in the cider vinegar, brown sugar, salt, and grated peeled apple until combined."
    },
    {
      "step": 3,
      "text": "Add the onion and red cabbage, then toss to coat. Stir in the ground cloves and ground allspice."
    },
    {
      "step": 4,
      "text": "Cook under high pressure for 3 minutes. Allow a natural release for 15 minutes, then release any remaining pressure carefully.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
