  "name": "German Red Cabbage",
  "subtitle": "Tender cabbage with apple, vinegar, and warm spices",
  "description": "Sweet-tart red cabbage braised with apple, onion, and aromatic spices for a colorful savory side.",
  "meal_type": "side",
