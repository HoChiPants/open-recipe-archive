  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of water to a simmer. Stir in the white sugar and lemon juice."
    },
    {
      "step": 2,
      "text": "Add the ears of corn, bring the water to a boil, and cook until tender, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Remove the pot from the heat and let the corn stand in the hot liquid for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Serve the corn warm."
    }
