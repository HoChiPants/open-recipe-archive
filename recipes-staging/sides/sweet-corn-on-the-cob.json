  "id": "sweet-corn-on-the-cob",
  "name": "Sweet Corn on the Cob",
  "subtitle": "Tender corn finished with a bright, lightly sweet cooking liquid",
  "description": "Simmer husked corn with sugar and lemon juice for a simple, flavorful side dish.",
  "meal_type": "side",
