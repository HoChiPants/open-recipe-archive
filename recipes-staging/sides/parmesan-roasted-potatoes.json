  "id": "parmesan-roasted-potatoes",
  "name": "Parmesan Roasted Potatoes",
  "subtitle": "Crisp-edged potatoes with savory Parmesan and thyme",
  "description": "Chunked potatoes are seasoned with olive oil, Parmesan, thyme, salt, and pepper, then roasted until golden and tender.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
