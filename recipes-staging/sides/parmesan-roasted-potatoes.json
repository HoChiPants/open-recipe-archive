      "ingredient_id": "unpeeled-potatoes",
      "item": "unpeeled potatoes",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "cut into 1-inch chunks"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
