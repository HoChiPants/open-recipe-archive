      "item": "dried thyme leaves",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Place the potatoes in a baking dish or on a baking sheet. Add the olive oil, salt, pepper, Parmesan, and thyme, then toss until evenly coated."
    },
    {
      "step": 3,
      "text": "Bake for 60 minutes, or until the potatoes are golden brown and tender.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Serve hot."
    }
  ],
