  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the bacon in a skillet for 3 minutes. Add the onion and cook for about 10 minutes, until tender.",
      "timer_minutes": 13
    },
    {
      "step": 3,
      "text": "Stir together the baked beans, ketchup, brown sugar, Worcestershire sauce, yellow mustard, jalapeño, chili powder, and mustard powder."
    },
    {
      "step": 4,
      "text": "Stir in the cooked bacon and onion, then transfer the mixture to a baking dish."
    },
    {
      "step": 5,
      "text": "Bake for 55 minutes, until thickened.",
      "timer_minutes": 55
    }
