{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cauliflower-au-gratin",
  "name": "Cauliflower au Gratin",
  "subtitle": "Tender cauliflower in a creamy Cheddar sauce",
  "description": "A comforting vegetable side baked until the sauce is bubbling and the cheese is melted.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "head-cauliflower",
      "item": "head cauliflower",
      "quantity": 1,
      "preparation": "cut into florets"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 6,
      "unit": "ounces",
      "preparation": "shredded, divided"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer. Add the cauliflower and cook for 7 minutes, or until tender. Drain well.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 3,
      "text": "Melt the butter in a saucepan over medium heat. Add the onion and cook for 5 minutes, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the flour and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Gradually add the milk, stirring until smooth. Cook until the sauce is simmering, then stir in part of the Cheddar until melted."
    },
    {
      "step": 6,
      "text": "Season with the black pepper and nutmeg. Add the cauliflower and stir to coat."
    },
    {
      "step": 7,
      "text": "Transfer the mixture to a baking dish and sprinkle with the remaining Cheddar."
    },
    {
      "step": 8,
      "text": "Bake for 25 minutes, until the cheese is melted and the gratin is bubbling.",
      "timer_minutes": 25
    }
  ],
