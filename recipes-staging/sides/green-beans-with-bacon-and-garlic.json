  "id": "green-beans-with-bacon-and-garlic",
  "name": "Green Beans with Bacon and Garlic",
  "subtitle": "Tender green beans with savory bacon and garlic",
  "description": "A simple skillet side dish that simmers trimmed green beans with bacon, garlic, and light seasoning until tender.",
  "meal_type": "side",
