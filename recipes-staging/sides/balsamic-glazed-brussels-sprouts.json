  "id": "balsamic-glazed-brussels-sprouts",
  "name": "Balsamic-Glazed Brussels Sprouts",
  "subtitle": "Roasted sprouts with balsamic, onion, and rosemary",
  "description": "Brussels sprouts and red onion roast until tender, then are finished with a warm balsamic-shallot glaze and fresh rosemary.",
  "meal_type": "side",
  "cuisine": "American",
