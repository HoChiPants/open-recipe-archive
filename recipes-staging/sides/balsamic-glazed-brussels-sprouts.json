  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Combine the Brussels sprouts and red onion. Toss with the salt, pepper, and enough of the divided olive oil to coat."
    },
    {
      "step": 3,
      "text": "Spread the vegetables in a baking dish or on a sheet pan and roast until tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "During the final 5 minutes of roasting, heat the remaining olive oil in a skillet. Sauté the shallot until tender, then add the balsamic vinegar and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Toss the roasted vegetables with the balsamic mixture and fresh rosemary before serving."
    }
  ],
