  "id": "lemon-glazed-carrots",
  "name": "Lemon-Glazed Carrots",
  "subtitle": "Tender carrots with a buttery citrus finish",
  "description": "Sliced carrots are simmered until tender, then tossed with melted butter, brown sugar, lemon juice, salt, and pepper for a bright glaze.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 2,
      "preparation": "sliced 1/4-inch thick"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the carrots in a saucepan, cover with water, and bring to a simmer. Cook for 8 minutes, or until tender.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Drain the carrots well."
    },
    {
      "step": 3,
      "text": "Melt the butter in the saucepan over low heat."
    },
    {
      "step": 4,
      "text": "Return the carrots to the pan and stir in the brown sugar, lemon juice, salt, and pepper. Cook for 2 minutes, stirring, until the butter and sugar are melted and the carrots are coated.",
      "timer_minutes": 2
    }
  ],
