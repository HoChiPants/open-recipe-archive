{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "creamy-corn-custard",
  "name": "Creamy Corn Custard",
  "subtitle": "A smooth, lightly spiced baked corn side",
  "description": "Blend part of the creamy corn mixture for a silky texture, fold in whole corn and eggs, then bake until fully set.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 35,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or as needed, divided"
    },
    {
      "ingredient_id": "corn",
      "item": "corn",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.25,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "cold-milk",
      "item": "cold milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 3
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Butter a baking dish with the divided butter."
    },
    {
      "step": 2,
      "text": "Whisk the corn, heavy whipping cream, salt, and cayenne pepper together. Warm the mixture gently, then stir in the cold milk."
    },
    {
      "step": 3,
      "text": "Transfer the corn mixture to a blender and blend until smooth. Separately whisk the egg yolks and eggs until smooth."
    },
    {
      "step": 4,
      "text": "Whisk the blended corn mixture with the eggs, then combine it with the remaining corn as directed by the mixture. Transfer the custard to the buttered dish."
    },
    {
      "step": 5,
      "text": "Bake until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Cool for 10 minutes, then serve.",
      "timer_minutes": 10
    }
  ],
