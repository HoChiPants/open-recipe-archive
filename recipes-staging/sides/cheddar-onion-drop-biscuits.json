{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cheddar-onion-drop-biscuits",
  "name": "Cheddar Onion Drop Biscuits",
  "subtitle": "Tender savory biscuits with two cheeses and onion",
  "description": "These quick drop biscuits combine sharp Cheddar, Parmesan, and dried onion in a buttery buttermilk dough, baked until lightly browned.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cold-butter",
      "item": "cold butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sharp-cheddar-cheese",
      "item": "sharp Cheddar cheese",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "parmesan-cheese",
      "item": "Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "dried-minced-onion",
      "item": "dried minced onion",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "1-buttermilk",
      "item": "1% buttermilk",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, baking powder, baking soda, and salt."
    },
    {
      "step": 3,
      "text": "Cut the cold butter into the flour mixture until coarse crumbs form."
    },
    {
      "step": 4,
      "text": "Stir in the Cheddar, Parmesan, and dried onion."
    },
    {
      "step": 5,
      "text": "Add the buttermilk and stir just until the ingredients are combined."
    },
    {
      "step": 6,
      "text": "Drop the dough into 12 portions onto a baking sheet."
    },
    {
      "step": 7,
      "text": "Bake for 15 minutes, or until lightly browned.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Serve warm."
    }
  ],
