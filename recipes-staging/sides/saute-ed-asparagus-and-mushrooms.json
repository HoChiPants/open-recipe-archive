  "id": "saute-ed-asparagus-and-mushrooms",
  "name": "Sautéed Asparagus and Mushrooms",
  "subtitle": "A quick skillet vegetable side",
  "description": "Tender asparagus and cremini mushrooms are sautéed with garlic, then finished with sea salt and black pepper.",
  "meal_type": "side",
  "cuisine": "American",
