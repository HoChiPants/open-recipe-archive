  "instructions": [
    {
      "step": 1,
      "text": "Cut the asparagus into bite-size pieces."
    },
    {
      "step": 2,
      "text": "Warm the refined coconut oil in a skillet over medium heat."
    },
    {
      "step": 3,
      "text": "Add the sliced cremini mushrooms and cook until tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the asparagus and cook until tender, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the minced garlic, season with flaky sea salt and ground black pepper, and toss to combine."
    }
  ],
