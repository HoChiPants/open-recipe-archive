    {
      "ingredient_id": "fresh-asparagus",
      "item": "fresh asparagus",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "refined-coconut-oil",
      "item": "refined coconut oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "cremini-mushrooms",
      "item": "cremini mushrooms",
      "quantity": 8,
