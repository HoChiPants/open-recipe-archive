  "instructions": [
    {
      "step": 1,
      "text": "Lightly coat the air-fryer basket or a suitable baking dish with vegetable oil."
    },
    {
      "step": 2,
      "text": "Combine the sage, thyme, sausagemeat, breadcrumbs, sherry, apricots, chestnuts, chutney, nutmeg, and mixed spice."
    },
    {
      "step": 3,
      "text": "Mix until evenly incorporated and smooth, then shape the mixture to fit the prepared basket or dish."
    },
    {
      "step": 4,
      "text": "Air-fry until browned and cooked through, 35 minutes. Check the center with a food thermometer; the stuffing must reach 160°F.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Let the stuffing stand briefly before serving."
    }
  ],
