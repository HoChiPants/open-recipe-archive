  "id": "air-fryer-stuffing",
  "name": "Air Fryer Stuffing",
  "subtitle": "Sausage stuffing with chestnuts, apricots, and herbs",
  "description": "A savory air-fryer stuffing combining seasoned sausage, fruit, chestnuts, breadcrumbs, and sweet onion chutney.",
  "meal_type": "side",
