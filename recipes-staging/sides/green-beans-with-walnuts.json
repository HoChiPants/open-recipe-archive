  "ingredients": [
    {
      "ingredient_id": "fresh-green-beans",
      "item": "fresh green beans",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "washed and trimmed"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "walnut-oil",
      "item": "walnut oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "minced"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Toss the chopped walnuts with the walnut oil and bake at 350°F for 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Cook the green beans in boiling salted water for 5 minutes, then drain well and set aside.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet over medium heat. Add the beans and cook for 4 minutes, stirring occasionally.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Season with ground black pepper and additional salt to taste. Stir in the toasted walnuts, walnut oil, and parsley, then transfer to a serving dish."
    }
  ],
