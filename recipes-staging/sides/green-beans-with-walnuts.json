  "id": "green-beans-with-walnuts",
  "name": "Green Beans With Walnuts",
  "subtitle": "Tender beans with toasted walnuts and parsley",
  "description": "Blanched green beans are finished in butter with walnut oil, toasted walnuts, parsley, and pepper.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
