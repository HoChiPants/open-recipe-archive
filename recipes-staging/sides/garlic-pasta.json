  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of water to a simmer, then add the penne and cook for 10 minutes, or until tender. Drain well.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "While the pasta cooks, warm the olive oil in a skillet over medium heat. Add the chopped garlic and cook for 12 minutes, stirring occasionally, until fragrant and lightly golden.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Stir the parsley, basil, oregano, and red pepper flakes into the garlic oil and warm briefly."
    },
    {
      "step": 4,
      "text": "Transfer the drained pasta to the skillet and toss to coat evenly. Let stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the Parmesan and toss again before serving."
    }
  ],
