  "id": "balsamic-grilled-baby-potatoes",
  "name": "Balsamic Grilled Baby Potatoes",
  "subtitle": "Tender foil-grilled potatoes with balsamic seasoning",
  "description": "Baby potatoes cook in a buttery balsamic mixture inside a foil packet, making a simple grilled side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "heavy-duty-aluminum-foil",
      "item": "heavy-duty aluminum foil"
    },
    {
      "ingredient_id": "baby-1-to-2-inch-long-potatoes",
      "item": "baby (1- to 2-inch long) potatoes",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "halved lengthwise"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "onion-powder",
      "item": "onion powder",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "cut into small chunks"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat an outdoor grill to medium-high heat."
    },
    {
      "step": 2,
      "text": "Toss the potatoes with the balsamic vinegar and olive oil. Season with the onion powder, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Lay a large sheet of heavy-duty foil on a work surface and place the potatoes in the center. Dot with the butter."
    },
    {
      "step": 4,
      "text": "Fold the foil over the potatoes and seal the edges securely to form a packet; make a second foil layer if needed to prevent leaks."
    },
    {
      "step": 5,
      "text": "Place the packet on the grill and cook for about 25 minutes, turning once, until the potatoes are tender when pierced.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Carefully open the packet, avoiding the hot steam, and serve the potatoes warm."
    }
  ],
