  "id": "glazed-rutabagas",
  "name": "Glazed Rutabagas",
  "subtitle": "Tender rutabaga in a buttery brown-sugar glaze",
  "description": "Cubed rutabaga simmers until tender in a savory-sweet glaze made with butter, brown sugar, hot water, and soy sauce.",
  "meal_type": "side",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 6,
      "unit": "tablespoons",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "hot-water",
      "item": "hot water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "rutabaga",
      "item": "rutabaga",
      "quantity": 1,
      "unit": "large",
      "preparation": "peeled and cubed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Stir in the brown sugar until combined."
    },
    {
      "step": 3,
      "text": "Add the hot water and soy sauce, then bring the mixture to a simmer."
    },
    {
      "step": 4,
      "text": "Stir in the cubed rutabaga and cover."
    },
    {
      "step": 5,
      "text": "Simmer for 45 minutes, or until the rutabaga is tender and coated with the glaze.",
      "timer_minutes": 45
    }
  ],
