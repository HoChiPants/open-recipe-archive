      "item": "fresh thyme leaves",
      "quantity": 1.5,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the pancetta and onion; stir until the pancetta is cooked and the onion softens, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the peas, wine, thyme, salt, and pepper."
    },
    {
      "step": 4,
      "text": "Cook until the peas are tender and the liquid is slightly reduced, about 5 minutes.",
      "timer_minutes": 5
    }
  ],
