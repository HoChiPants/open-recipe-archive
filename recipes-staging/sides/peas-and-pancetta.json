  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "pancetta",
      "item": "pancetta",
      "quantity": 2,
      "unit": "ounces",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "frozen-peas",
      "item": "frozen peas",
      "quantity": 1,
      "unit": "pound",
