  "id": "peas-and-pancetta",
  "name": "Peas and Pancetta",
  "subtitle": "A savory Italian-inspired pea side",
  "description": "Tender peas are cooked with crisp pancetta, onion, white wine, and fresh thyme for a quick, flavorful side dish.",
  "meal_type": "side",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
