  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "three-cheese-cauliflower-casserole",
  "name": "Three-Cheese Cauliflower Casserole",
  "subtitle": "Tender cauliflower with a creamy cheese sauce and crisp crumb topping",
  "description": "A comforting baked side dish combining tender cauliflower, creamy cheeses, and a buttery breadcrumb topping.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "head-cauliflower",
      "item": "head cauliflower",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fat-free-cream-cheese",
      "item": "fat-free cream cheese",
      "quantity": 2,
      "unit": "ounces",
      "preparation": "softened"
    },
    {
      "ingredient_id": "fat-free-milk",
      "item": "fat-free milk",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "bread-crumbs",
      "item": "bread crumbs",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Bring a pot of water to a simmer. Add the chopped cauliflower and cook for 8 minutes, or until tender. Drain well.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Whisk the softened cream cheese, milk, Parmesan, and Cheddar until smooth, then stir until evenly combined."
    },
    {
      "step": 4,
      "text": "Transfer the cauliflower to a baking dish and fold in the cheese mixture."
    },
    {
      "step": 5,
      "text": "Combine the bread crumbs with the melted butter and scatter over the cauliflower."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, until hot and lightly browned on top.",
      "timer_minutes": 20
    }
  ],
