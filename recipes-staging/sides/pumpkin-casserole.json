  "id": "pumpkin-casserole",
  "name": "Pumpkin Casserole",
  "subtitle": "A warmly spiced baked pumpkin side",
  "description": "A tender, lightly sweet pumpkin casserole with cinnamon and vanilla.",
  "meal_type": "side",
  "cuisine": "American",
