  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Melt the butter. Combine it with the pumpkin puree, evaporated milk, sugar, flour, eggs, vanilla, and cinnamon until evenly mixed."
    },
    {
      "step": 3,
      "text": "Pour the mixture into the prepared dish and bake for 60 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    }
  ],
