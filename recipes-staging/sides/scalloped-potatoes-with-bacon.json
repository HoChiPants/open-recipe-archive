  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cut the red potatoes into thick slices. Cook them with the seasoned salt until tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Stir together the mayonnaise, sour cream, onion powder, garlic powder, remaining seasoned salt, black pepper, bacon, diced red onion, American cheese, and Parmesan."
    },
    {
      "step": 4,
      "text": "Transfer the tender potatoes to a baking dish and coat with the mixture."
    },
    {
      "step": 5,
      "text": "Top with the remaining American cheese and Parmesan, then bake until hot and browned, about 40 minutes.",
      "timer_minutes": 40
    }
  ],
