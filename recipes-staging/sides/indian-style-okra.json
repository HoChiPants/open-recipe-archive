  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the chopped onion and cook until tender."
    },
    {
      "step": 3,
      "text": "Stir in the okra, cumin, ginger, coriander, black pepper, and salt."
    },
    {
      "step": 4,
      "text": "Cook the mixture for 20 minutes, stirring occasionally, until the okra is tender.",
