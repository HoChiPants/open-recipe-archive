  "id": "basic-white-rice",
  "name": "Basic White Rice",
  "subtitle": "Simple stovetop rice for everyday meals",
  "description": "White rice cooked with garlic, salt, and a little oil until tender and fluffy.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "white-rice",
      "item": "white rice",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "boiling-water",
      "item": "boiling water",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the canola oil in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Add the rice, garlic powder, and salt; stir to coat the grains."
    },
    {
      "step": 3,
      "text": "Pour in the boiling water and bring the mixture back to a boil."
    },
    {
      "step": 4,
      "text": "Reduce the heat, cover, and simmer until the rice is tender and the water is absorbed.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Remove from the heat and fluff the rice before serving."
    }
  ],
