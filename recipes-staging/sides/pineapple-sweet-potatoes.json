  "id": "pineapple-sweet-potatoes",
  "name": "Pineapple Sweet Potatoes",
  "subtitle": "Tender sweet potatoes with spiced pineapple",
  "description": "Simmered sweet potatoes are layered with crushed pineapple, brown sugar, and warm spices, then baked until glazed and tender.",
  "meal_type": "side",
