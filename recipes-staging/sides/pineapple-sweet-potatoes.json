  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare the sweet potatoes for cooking and place them in a saucepan of water."
    },
    {
      "step": 2,
      "text": "Bring the water to a simmer and cook the sweet potatoes until tender. Drain and transfer them to a baking dish."
    },
    {
      "step": 3,
      "text": "Combine the crushed pineapple, brown sugar, cinnamon, ginger, nutmeg, and cloves."
    },
    {
      "step": 4,
      "text": "Layer the sweet potatoes with the pineapple mixture in the baking dish."
    },
    {
      "step": 5,
      "text": "Bake at 350°F until heated through and lightly glazed.",
      "timer_minutes": 45
    }
  ],
