  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Combine the flour, cornmeal, baking powder, 1 teaspoon salt, sugar, and onion powder. Whisk in the 5 beaten eggs, 6 tablespoons melted butter, and buttermilk. Transfer to a baking dish and bake for 55 minutes, until set. Cool completely, then crumble.",
      "timer_minutes": 55
    },
    {
      "step": 2,
      "text": "Melt the 1 cup butter in a large skillet. Add the onion, green onions, parsley, red bell pepper, green chile peppers, garlic, white and black peppers, cayenne, oregano, thyme, basil, bay leaves, and hot pepper sauce. Cook until the vegetables are tender, about 10 minutes; remove the bay leaves.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Crumble the cooled cornbread into a large bowl. Stir in the cooked vegetable mixture and chicken broth."
    },
    {
      "step": 4,
      "text": "Whisk the 7 beaten eggs with the evaporated milk, then stir the mixture into the cornbread until evenly moistened. Transfer to a baking dish."
    },
    {
      "step": 5,
      "text": "Bake at 375°F until the center is firm and a thermometer registers 165°F, about 55 minutes. Let stand briefly before serving.",
      "timer_minutes": 55
    }
  ],
