  "id": "stir-fried-snow-peas-and-mushrooms",
  "name": "Stir-Fried Snow Peas and Mushrooms",
  "subtitle": "Crisp vegetables with toasted sesame and teriyaki",
  "description": "A quick skillet side combining tender-crisp snow peas, sliced mushrooms, sesame seeds, and teriyaki sauce.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
