      "ingredient_id": "teriyaki-sauce",
      "item": "teriyaki sauce",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat a skillet over medium heat. Add the sesame seeds and toast for 5 minutes, stirring occasionally, until lightly browned; transfer them to a small bowl.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the olive oil to the skillet, then stir in the snow peas and mushrooms."
    },
    {
      "step": 3,
      "text": "Cook the vegetables for 4 minutes, stirring frequently, until tender. Transfer them to a serving dish.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Mix the toasted sesame seeds with the teriyaki sauce and spoon the mixture over the vegetables. Serve warm."
    }
  ],
