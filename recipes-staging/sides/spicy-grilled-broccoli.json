      "item": "red pepper flakes",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "heads-broccoli",
      "item": "heads broccoli",
      "quantity": 4,
      "unit": "small",
      "preparation": "cut into broccoli steaks"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the oil, soy sauce, gochujang, honey, lime juice, and red pepper flakes in a bowl."
    },
    {
      "step": 2,
      "text": "Preheat the grill and oil the grates."
    },
    {
      "step": 3,
      "text": "Place the broccoli steaks on the grill and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Brush the broccoli with the soy sauce mixture, turn, and grill for 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Brush again, turn once more, and grill for 7 minutes, or until tender.",
      "timer_minutes": 7
    }
  ],
