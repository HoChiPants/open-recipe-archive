  "id": "spicy-grilled-broccoli",
  "name": "Spicy Grilled Broccoli",
  "subtitle": "Charred broccoli with a sweet-hot lime glaze",
  "description": "Broccoli steaks are grilled until tender and lightly charred, then finished with a savory, spicy glaze.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "plus more for grill"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "gochujang-korean-hot-pepper-paste",
      "item": "gochujang (Korean hot pepper paste)",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1,
      "unit": "tablespoon"
    },
