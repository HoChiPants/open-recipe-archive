  "id": "marinated-carrots",
  "name": "Marinated Carrots",
  "subtitle": "A tangy, colorful vegetable side",
  "description": "Tender carrots, peppers, and onion are coated in a sweet-tart tomato dressing for a make-ahead-friendly side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
