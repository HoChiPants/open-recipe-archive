    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 1,
      "preparation": "seeded and diced"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "diced"
    },
    {
      "ingredient_id": "white-vinegar",
      "item": "white vinegar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "condensed-tomato-soup",
      "item": "condensed tomato soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 0.75,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Adjust the carrots to thick slices if needed, then cook them in simmering water until tender, about 15 minutes. Drain well.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Combine the carrots, bell pepper, and onion in a large bowl."
    },
    {
      "step": 3,
      "text": "Stir the vinegar, tomato soup, and sugar together in a saucepan. Bring the mixture to a simmer for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Stir in the vegetable oil, pour the dressing over the vegetables, and toss gently to coat. Serve."
    }
  ],
