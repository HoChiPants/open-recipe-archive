  "id": "butter-roasted-cauliflower",
  "name": "Butter-Roasted Cauliflower",
  "subtitle": "Tender florets with golden, buttery edges",
  "description": "Large cauliflower florets are coated with melted butter and seasoning, then roasted until tender and lightly browned.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
