  },
  "ingredients": [
    {
      "ingredient_id": "head-cauliflower",
      "item": "head cauliflower",
      "quantity": 1,
      "preparation": "cut into large florets"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted, or more to taste"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Arrange the cauliflower florets in a baking dish or on a rimmed baking sheet."
    },
    {
      "step": 3,
      "text": "Drizzle with the melted butter and season with salt and ground black pepper. Toss to coat."
    },
    {
      "step": 4,
      "text": "Roast for 30 minutes, then continue roasting until the cauliflower is tender, about 10 minutes more.",
      "timer_minutes": 40
    }
  ],
