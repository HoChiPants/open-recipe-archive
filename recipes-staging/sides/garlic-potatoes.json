  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "garlic-potatoes",
  "name": "Garlic Potatoes",
  "subtitle": "Creamy mashed potatoes with parsley and garlic",
  "description": "Tender red potatoes are simmered with garlic, mashed with milk, and finished with fresh parsley.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "red-potatoes",
      "item": "red potatoes",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "cut into large chunks"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "halved lengthwise"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes, garlic, and salt in a pot and add enough water to cover. Bring to a simmer."
    },
    {
      "step": 2,
      "text": "Simmer until the potatoes are tender when pierced, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Drain well, return the potatoes and garlic to the pot, and cook over low heat for 2 minutes to dry slightly.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the milk and mash until smooth."
    },
    {
      "step": 5,
      "text": "Stir in the parsley and serve."
    }
  ],
