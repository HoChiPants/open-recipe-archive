  "instructions": [
    {
      "step": 1,
      "text": "Place the kidney beans in a large pot with the 1.5 quarts water, or enough water to cover them. Soak for 8 hours, then drain.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Return the beans to the pot, add fresh water as needed, and bring to a boil. Add the garlic, reduce the heat, and cook until the beans are tender.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Meanwhile, heat the oil in a large pot. Add the onion, bell pepper, salt, and black pepper; cook until softened."
    },
    {
      "step": 4,
      "text": "Stir in the rice and cook briefly, stirring, until lightly toasted.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the cooked beans, their cooking water, coconut milk, and the remaining water. Bring to a simmer."
    },
    {
      "step": 6,
      "text": "Cover and cook over low heat until the rice is tender and the liquid is absorbed.",
      "timer_minutes": 40
    }
  ],
