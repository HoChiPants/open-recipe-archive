  "id": "belizean-rice-and-beans",
  "name": "Belizean Rice and Beans",
  "subtitle": "Tender kidney beans and coconut rice for a generous table.",
  "description": "Slow-cooked kidney beans, sautéed aromatics, and coconut milk make this hearty side dish.",
