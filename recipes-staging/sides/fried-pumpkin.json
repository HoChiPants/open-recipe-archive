  "instructions": [
    {
      "step": 1,
      "text": "Cut the sugar pumpkin into pieces suitable for frying."
    },
    {
      "step": 2,
      "text": "Season the pumpkin pieces with salt and pepper, then coat them with the flour."
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet over medium heat."
    },
    {
      "step": 4,
      "text": "Add the coated pumpkin and fry, turning as needed, until golden brown and tender."
    }
