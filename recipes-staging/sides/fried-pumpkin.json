  "id": "fried-pumpkin",
  "name": "Fried Pumpkin",
  "subtitle": "Golden skillet-fried pumpkin with a light flour coating",
  "description": "Tender pumpkin pieces are seasoned, lightly coated in flour, and fried in butter until golden brown.",
  "meal_type": "side",
