  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a large pot over medium heat until crisp. Transfer it out and drain excess fat, leaving a small amount in the pot."
    },
    {
      "step": 2,
      "text": "Add the onion and bell pepper, then cook until tender."
    },
    {
      "step": 3,
      "text": "Stir in the peas, water, garlic powder, thyme, crushed bay leaf, seasoned salt, and cubed ham."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a simmer, then cover and cook until the peas are tender, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Crumble the bacon into the pot and adjust the seasoned salt if needed."
    },
    {
      "step": 6,
      "text": "Cook for 5 minutes more, remove the bay leaf, and fold in the parsley before serving.",
      "timer_minutes": 5
    }
  ],
