  "id": "grilled-artichokes",
  "name": "Grilled Artichokes",
  "subtitle": "Tender artichokes with lemon-garlic oil",
  "description": "Artichokes are briefly simmered with lemon, seasoned with garlic and pepper, then grilled until lightly charred.",
  "meal_type": "side",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
