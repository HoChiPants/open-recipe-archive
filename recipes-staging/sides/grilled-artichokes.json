    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare the artichokes for cooking and cut them as needed. Place the quartered lemon in a pot of water and bring it to a simmer."
    },
    {
      "step": 2,
      "text": "Add the artichokes and simmer for 15 minutes, until tender enough to pierce. Drain well.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Preheat the grill. Stir together the olive oil, chopped garlic, salt, and ground black pepper. Prepare the lemon and artichokes with the garlic mixture."
    },
    {
      "step": 4,
      "text": "Grill the artichokes for 10 minutes, turning as needed, until lightly charred and heated through.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Serve with the grilled lemon and garlic from the seasoning mixture."
    }
  ],
