  "id": "easy-black-beans-and-tomatoes",
  "name": "Easy Black Beans and Tomatoes",
  "subtitle": "A quick, zesty skillet side",
  "description": "Canned black beans and tomatoes are warmed with cumin, chili powder, garlic, and fresh lime for a simple savory side.",
  "meal_type": "side",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "black-beans",
      "item": "black beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, rinsed and drained"
    },
    {
      "ingredient_id": "no-salt-added-diced-tomatoes",
      "item": "no-salt-added diced tomatoes",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.5 ounce"
    },
    {
      "ingredient_id": "lime",
      "item": "lime",
      "quantity": 1,
      "unit": "small",
      "preparation": "juiced"
    },
    {
      "ingredient_id": "chili-powder",
      "item": "chili powder",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the black beans, diced tomatoes, chili powder, cumin, and garlic powder in a saucepan."
    },
    {
      "step": 2,
      "text": "Warm over medium heat, stirring occasionally, until hot and the flavors have blended, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the lime juice, taste, and adjust the listed spices if desired. Serve warm."
    }
  ],
