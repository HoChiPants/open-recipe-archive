{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "swedish-potato-and-anchovy-casserole",
  "name": "Swedish Potato and Anchovy Casserole",
  "subtitle": "Creamy layered potatoes with anchovies and a crisp crumb topping",
  "description": "A rich baked potato side dish layered with onions and anchovies, finished with cream and buttery breadcrumbs.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "onion",
      "item": "onions",
      "quantity": 2,
      "unit": "large",
      "preparation": "cut into 1/4 inch wide strips"
    },
    {
      "ingredient_id": "fillets-swedish-anchovies",
      "item": "fillets Swedish anchovies",
      "quantity": 14,
      "preparation": "or regular anchovies"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 6,
      "preparation": "peeled and cut into strips"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "dry-bread-crumbs",
      "item": "dry bread crumbs",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Use the melted butter to grease a baking dish, reserving any excess for the topping."
    },
    {
      "step": 2,
      "text": "Arrange the onions in the dish, then layer in the anchovy fillets and most of the potatoes."
    },
    {
      "step": 3,
      "text": "Pour the heavy cream evenly over the potatoes. Combine the dry bread crumbs with the remaining melted butter, then scatter the mixture over the top with the remaining potatoes."
    },
    {
      "step": 4,
      "text": "Bake until the potatoes are tender and the surface is golden brown, about 45 minutes.",
      "timer_minutes": 45
    }
  ],
