  "id": "saute-ed-beet-greens",
  "name": "Sautéed Beet Greens",
  "subtitle": "Tender greens with garlic, chile, and lemon",
  "description": "Blanch beet greens briefly, then sauté them with garlic and red pepper flakes for a bright, savory side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "bunches-beet-greens",
      "item": "bunches beet greens",
      "quantity": 2,
      "preparation": "stems removed"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemons",
      "quantity": 2,
      "preparation": "quartered"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water seasoned with some of the salt and pepper to a simmer. Add the beet greens and cook for 2 minutes, until tender.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Drain the greens, let them cool briefly, and cut them into manageable pieces."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a skillet over medium heat. Add the garlic, red pepper flakes, and remaining salt and pepper; stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the beet greens and toss to coat. Cook briefly until heated through, then adjust the seasoning."
    },
    {
      "step": 5,
      "text": "Serve with the lemon quarters."
    }
  ],
