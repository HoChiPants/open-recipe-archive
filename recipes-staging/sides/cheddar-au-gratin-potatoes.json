  "id": "cheddar-au-gratin-potatoes",
  "name": "Cheddar Au Gratin Potatoes",
  "subtitle": "Creamy baked potatoes with a golden cheese topping",
  "description": "Cubed russet potatoes are baked in a seasoned cream sauce, finished with Cheddar, and rested before serving.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 65,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "russet-potato",
      "item": "russet potato",
      "quantity": 3,
      "preparation": "peeled and cubed"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "2-reduced-fat-milk",
      "item": "2% reduced-fat milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-black-pepper-to-taste",
      "item": "salt and black pepper to taste"
    },
    {
      "ingredient_id": "grated-medium-cheddar-cheese",
      "item": "grated medium Cheddar cheese",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Grease a baking dish with the butter."
    },
    {
      "step": 2,
      "text": "Place the cubed potatoes in the prepared dish."
    },
    {
      "step": 3,
      "text": "Whisk together the heavy cream, milk, garlic, flour, salt, and black pepper. Pour the mixture over the potatoes and toss to coat."
    },
    {
      "step": 4,
      "text": "Bake until the potatoes are tender, about 20 minutes, then continue baking as needed until nearly tender.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Add the grated Cheddar over the potatoes and bake until the cheese is melted and the potatoes are fully tender.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Let the dish rest for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
