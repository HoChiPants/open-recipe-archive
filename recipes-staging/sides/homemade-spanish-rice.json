  "id": "homemade-spanish-rice",
  "name": "Homemade Spanish Rice",
  "subtitle": "Savory rice with tomatoes, chiles, and peppers",
  "description": "A simple stovetop rice side seasoned with tomatoes, green chiles, onion, bell pepper, and chili powder.",
  "meal_type": "side",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "uncooked-white-rice",
      "item": "uncooked white rice",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 0.5,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "tomatoes-and-green-chiles",
      "item": "tomatoes and green chiles",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce, diced"
    },
    {
      "ingredient_id": "chili-powder",
      "item": "chili powder",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a saucepan over medium heat. Add the rice, onion, and bell pepper, and sauté until the vegetables are tender and the rice is lightly toasted."
    },
    {
      "step": 2,
      "text": "Stir in the water and tomatoes and green chiles. Add the chili powder and salt, mixing well."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer, cover, and cook for 30 minutes, or until the rice is tender and the liquid is absorbed.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Remove from the heat, rest briefly, and fluff before serving."
    }
  ],
