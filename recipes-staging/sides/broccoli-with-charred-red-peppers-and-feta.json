  "id": "broccoli-with-charred-red-peppers-and-feta",
  "name": "Broccoli with Charred Red Peppers and Feta",
  "subtitle": "A warm vegetable side with smoky peppers and salty feta.",
  "description": "Charred peppers and golden broccoli are combined with softened onion, garlic, and crumbled feta.",
  "meal_type": "side",
  "yield": {
    "quantity": 4,
    "unit": "as a side"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "red-peppers",
      "item": "red peppers",
      "quantity": 2
    },
    {
      "ingredient_id": "head-of-broccoli",
      "item": "head of broccoli",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
