  "instructions": [
    {
      "step": 1,
      "text": "Grill the red peppers until charred. Let them cool, then remove the skins and seeds and cut into strips.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Cut the broccoli into florets."
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil in a large pan and cook the broccoli until golden brown.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the red onion and garlic, then cook until softened.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Toss in the peppers and warm through. Scatter over the feta before serving."
    }
  ],
