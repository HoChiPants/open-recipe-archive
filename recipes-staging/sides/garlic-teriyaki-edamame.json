  "id": "garlic-teriyaki-edamame",
  "name": "Garlic Teriyaki Edamame",
  "subtitle": "Edamame pods with a savory-sweet garlic glaze",
  "description": "Warm edamame in a glossy teriyaki sauce with garlic, brown sugar, rice vinegar, sesame oil, and sesame seeds.",
  "meal_type": "side",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "frozen-edamame-in-the-pod",
      "item": "frozen edamame in the pod",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "teriyaki-sauce",
      "item": "teriyaki sauce",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "rice-vinegar",
      "item": "rice vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sesame-seeds",
      "item": "sesame seeds",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, garlic, and teriyaki sauce in a saucepan and bring to a simmer."
    },
    {
      "step": 2,
      "text": "Add the frozen edamame, cover, and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the brown sugar, rice vinegar, sesame oil, and sesame seeds."
    },
    {
      "step": 4,
      "text": "Cook for 4 minutes, stirring occasionally, until the sauce thickens and coats the edamame.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
