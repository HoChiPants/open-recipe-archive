      "item": "sour cream",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded, or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "In a saucepan, bring the water, butter, onion, parsley, salt, and thyme to a simmer, stirring to combine."
    },
    {
      "step": 3,
      "text": "Warm the milk, then stir it with the potato flakes. Whisk in the sour cream and incorporate the seasoned liquid."
    },
    {
      "step": 4,
      "text": "Transfer the potato mixture to a baking dish and cover with the shredded Cheddar."
    },
    {
      "step": 5,
      "text": "Bake until the cheese is melted, about 20 minutes.",
      "timer_minutes": 20
    }
  ],
