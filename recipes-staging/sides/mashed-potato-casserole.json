  "id": "mashed-potato-casserole",
  "name": "Mashed Potato Casserole",
  "subtitle": "Creamy seasoned potatoes finished with melted Cheddar",
  "description": "A warm, savory side dish made with instant potato flakes, sour cream, herbs, and cheese, then baked until the topping melts.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
