{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cottage-cheese-perogies",
  "name": "Cottage Cheese Perogies",
  "subtitle": "Tender dumplings with a savory cottage cheese filling",
  "description": "Prepare a simple flour dough, fill it with seasoned cottage cheese, and boil the folded dumplings until tender and fully set.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "dry-curd-cottage-cheese",
      "item": "dry-curd cottage cheese",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 2
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the dry-curd cottage cheese, egg yolks, and part of the salt; set aside as the filling."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, and remaining salt. Add the cold water and vegetable oil, then mix until a smooth dough forms."
    },
    {
      "step": 3,
      "text": "Roll the dough on a lightly floured surface, cut it into rounds, and place cottage cheese filling on each piece."
    },
    {
      "step": 4,
      "text": "Fold each round over the filling and press the edges firmly closed."
    },
    {
      "step": 5,
      "text": "Bring salted water to a simmer in a large pot. Add the perogies in batches and cook for about 4 minutes, until tender and the centers reach 160°F.",
      "timer_minutes": 4
    },
    {
      "step": 6,
      "text": "Lift the cooked perogies from the water and let them drain briefly before serving."
    }
  ],
