  "id": "cheesy-celeriac-leek-and-rosemary-gratin",
  "name": "Cheesy Celeriac, Leek and Rosemary Gratin",
  "subtitle": "A creamy baked vegetable side with a crisp cheese topping",
  "description": "Thinly sliced celeriac is layered with softened rosemary-scented leeks, covered in a cream-and-milk sauce, and baked until tender beneath melted cheese.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 95
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 25,
      "unit": "g"
    },
    {
      "ingredient_id": "leeks-outer-layer-removed",
      "item": "leeks outer layer removed",
      "quantity": 2,
      "preparation": "washed of any grit and sliced into rings"
    },
    {
      "ingredient_id": "handful-rosemary-leaves-roughly-chopped",
      "item": "handful rosemary leaves roughly chopped",
      "unit": "small"
    },
    {
      "ingredient_id": "bay-leaf",
      "item": "bay leaf",
      "quantity": 1
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "celeriac-about-500g",
      "item": "celeriac (about 500g)",
      "quantity": 1,
      "preparation": "peeled, quartered and thinly sliced"
    },
    {
      "ingredient_id": "cheddar-or-gruye-re",
      "item": "cheddar or gruyère",
      "quantity": 100,
      "unit": "g",
      "preparation": "coarsely grated"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 180°C (350°F). Melt the butter in a wide pan, add the leeks, rosemary, and bay leaf, and cook gently for 20 minutes until softened.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Warm the double cream and milk together with the bay leaf until steaming, then remove the bay leaf.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Layer the softened leeks and sliced celeriac in a baking dish, seasoning each layer with the warm cream mixture as you go. Pour any remaining mixture over the top."
    },
    {
      "step": 4,
      "text": "Cover the dish and bake for 30 minutes. Uncover, scatter over the grated cheddar or gruyère, and bake for a further 30 minutes, until the celeriac is tender and the top is golden.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Rest briefly before serving."
    }
  ],
