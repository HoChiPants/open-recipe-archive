  "instructions": [
    {
      "step": 1,
      "text": "Combine the onion, lime juice, and sugar in a bowl; set aside."
    },
    {
      "step": 2,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 3,
      "text": "Arrange the cheese and sage leaves on a baking sheet. Bake until set and cooked through, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Cook the sausages in a skillet over medium heat until browned and their centers reach 160°F. Slice them."
    },
    {
      "step": 5,
      "text": "Cook the bacon with the olive oil until crisp, about 5 minutes. Cool, then crumble.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Preheat the grill."
    },
    {
      "step": 7,
      "text": "Spread the tortilla chips in a heatproof dish. Add the chicken or turkey, cranberry sauce, cheese, sausages, bacon, and sage, layering as needed."
    },
    {
      "step": 8,
      "text": "Grill until the cheese is melted, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 9,
      "text": "Top with the lime-pickled onion and serve."
    }
  ],
