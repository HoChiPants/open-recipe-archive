  "id": "christmas-nachos",
  "name": "Christmas Nachos",
  "subtitle": "Festive layered nachos with savory toppings and cranberry",
  "description": "Crisp tortilla chips are layered with cooked sausages, bacon, poultry, cranberry sauce, melted cheese, sage, and quick lime-pickled onion.",
  "meal_type": "side",
  "yield": {
    "quantity": 6,
    "unit": "servings"
