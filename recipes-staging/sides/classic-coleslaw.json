  "id": "classic-coleslaw",
  "name": "Classic Coleslaw",
  "subtitle": "Crisp cabbage and vegetables in a tangy creamy dressing",
  "description": "A simple chilled slaw combining shredded cabbage, carrots, onion, herbs, and a mustardy dressing.",
  "meal_type": "side",
  "yield": {
    "quantity": 8,
    "unit": "as a side"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "white-cabbage-or-1-2-large",
      "item": "white cabbage or 1/2 large",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "carrots-peeled",
      "item": "carrots peeled",
      "quantity": 4
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
