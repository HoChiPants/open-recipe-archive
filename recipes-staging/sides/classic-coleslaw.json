    },
    {
      "ingredient_id": "bunch-dill-chives",
      "item": "bunch dill chives",
      "quantity": "1/2",
      "unit": "small",
      "preparation": "parsley or coriander, finely chopped (optional)",
      "optional": true
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "yogurt-soured-cream-or-more-mayo",
      "item": "yogurt soured cream or more mayo",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": "1-2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "a-few-pinches-of-paprika",
      "item": "a few pinches of paprika"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Finely shred the cabbage, peel and grate the carrots, and thinly slice the red onion."
    },
    {
      "step": 2,
      "text": "Finely chop the dill chives; add the optional parsley or coriander if using."
    },
    {
      "step": 3,
      "text": "Whisk the Dijon mustard, mayonnaise, yogurt or sour cream, and white wine vinegar into a smooth dressing."
    },
    {
      "step": 4,
      "text": "Combine the vegetables and herbs in a large bowl. Add the dressing and toss until evenly coated."
    },
    {
      "step": 5,
      "text": "Sprinkle with paprika and stir briefly to distribute."
    }
  ],
