      "item": "fresh chives",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Melt the butter in an oven-safe skillet over medium heat. Add the mushrooms and season with salt; cook, stirring, until softened."
    },
    {
      "step": 3,
      "text": "Add the onion, black pepper, and cayenne. Cook until the onion begins to soften, then stir in the rice and coat the grains with butter."
    },
    {
      "step": 4,
      "text": "Pour in the divided 2 cups of chicken broth and bring the mixture to a simmer. Transfer the skillet to the oven."
    },
    {
      "step": 5,
      "text": "Bake until the rice is nearly tender and most of the liquid is absorbed.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Combine the remaining chicken broth with the 0.5 cup of heavy whipping cream. Stir this mixture into the rice."
    },
    {
      "step": 7,
      "text": "Return the skillet to the stovetop and cook, stirring, until the rice is tender and the risotto reaches 165°F.",
      "timer_minutes": 2
    },
    {
      "step": 8,
      "text": "Whisk in the 2 tablespoons of heavy whipping cream, then fold in the Parmigiano-Reggiano and chives. Adjust with salt if needed and serve."
    }
  ],
