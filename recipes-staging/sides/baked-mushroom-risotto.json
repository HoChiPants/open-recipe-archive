  "id": "baked-mushroom-risotto",
  "name": "Baked Mushroom Risotto",
  "subtitle": "Creamy oven-finished rice with mushrooms and chives",
  "description": "Mushrooms, seasoned onion, and Carnaroli rice are combined with broth, baked, then finished with cream, Parmigiano-Reggiano, and chives.",
  "meal_type": "side",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "mushrooms",
      "item": "mushrooms",
      "quantity": 3,
      "unit": "cups",
      "preparation": "diced"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "onion",
      "item": "yellow onion",
      "quantity": 0.5,
      "preparation": "diced"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "carnaroli-rice",
      "item": "carnaroli rice",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 2,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "finely-grated-parmigiano-reggiano-cheese",
      "item": "finely grated Parmigiano-Reggiano cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
