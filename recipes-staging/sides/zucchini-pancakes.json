  "id": "zucchini-pancakes",
  "name": "Zucchini Pancakes",
  "subtitle": "Savory skillet cakes with Parmesan and oregano",
  "description": "Tender zucchini pancakes with green onion, Parmesan, and a crisp golden exterior.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "grated-zucchini",
      "item": "grated zucchini",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large",
      "preparation": "slightly beaten"
    },
    {
      "ingredient_id": "green-onion",
      "item": "green onion",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "sour-cream-for-serving-optional",
      "item": "sour cream for serving (Optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Squeeze the grated zucchini firmly to remove excess moisture, then combine it with the lightly beaten eggs and chopped green onion."
    },
    {
      "step": 2,
      "text": "In a separate bowl, whisk together the flour, Parmesan, baking powder, salt, and oregano. Stir the dry mixture into the zucchini mixture until evenly combined."
    },
    {
      "step": 3,
      "text": "Heat a skillet over medium heat and add enough vegetable oil to coat the surface. Drop the batter into the skillet in small rounds and flatten lightly."
    },
    {
      "step": 4,
      "text": "Cook the pancakes for about 3 minutes per side, turning when the undersides are golden. Continue until the centers are firm and fully set.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Drain briefly and serve warm with sour cream, if desired."
    }
  ],
