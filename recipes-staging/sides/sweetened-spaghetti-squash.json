  "id": "sweetened-spaghetti-squash",
  "name": "Sweetened Spaghetti Squash",
  "subtitle": "Tender squash strands with butter and brown sugar",
  "description": "Roasted spaghetti squash is finished with butter and brown sugar for a simple, lightly sweet side dish.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "spaghetti-squash",
      "item": "spaghetti squash",
      "quantity": 1,
      "preparation": "halved lengthwise and seeded"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "cold-butter",
      "item": "cold butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Place the squash halves in a baking dish and divide the softened butter and cold butter between them."
    },
    {
      "step": 3,
      "text": "Bake until the squash is tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Scrape the squash flesh into strands, add the brown sugar, and stir to combine."
    },
    {
      "step": 5,
      "text": "Let the seasoned squash stand for 10 minutes, then serve warm.",
      "timer_minutes": 10
    }
  ],
