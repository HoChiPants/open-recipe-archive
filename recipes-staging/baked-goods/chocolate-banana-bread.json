  "id": "chocolate-banana-bread",
  "name": "Chocolate Banana Bread",
  "subtitle": "Moist banana bread with cocoa and chocolate chips",
  "description": "A tender chocolate banana loaf made with mashed bananas, cocoa powder, sour cream, and semisweet chocolate chips.",
