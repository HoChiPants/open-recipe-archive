  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare the baking pan as needed."
    },
    {
      "step": 2,
      "text": "Whisk the softened margarine, sugar, eggs, and sour cream until smooth. Stir in the mashed bananas and vanilla."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the flour, baking soda, and cocoa powder."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the wet mixture and stir just until combined. Fold in the chocolate chips."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 60 minutes, until the center is firm and a tester inserted in the middle comes out clean.",
      "timer_minutes": 60
    }
  ],
