  "id": "roast-beef-horseradish-roll-ups",
  "name": "Roast Beef Horseradish Roll-Ups",
  "subtitle": "Tangy beef tortilla spirals with spinach and Cheddar",
  "description": "Soft tortillas spread with a sharp, creamy Cheddar-horseradish filling, layered with spinach and roast beef, then chilled and sliced.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0,
    "inactive_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "fat-free-cream-cheese",
      "item": "fat-free cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "prepared-horseradish",
      "item": "prepared horseradish",
      "quantity": 3.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dijon-style-mustard",
      "item": "Dijon-style mustard",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "12-inch-flour-tortillas",
      "item": "(12 inch) flour tortillas",
      "quantity": 12
    },
    {
      "ingredient_id": "spinach-leaves",
      "item": "spinach leaves",
      "quantity": 30,
      "preparation": "washed with stems removed"
    },
    {
      "ingredient_id": "thinly-sliced-cooked-deli-roast-beef",
      "item": "thinly sliced cooked deli roast beef",
      "quantity": 1.5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "In a bowl, whisk the softened fat-free cream cheese, prepared horseradish, Dijon-style mustard, and shredded Cheddar until evenly combined."
    },
    {
      "step": 2,
      "text": "Spread the filling over each flour tortilla, leaving a narrow border around the edge."
    },
    {
      "step": 3,
      "text": "Arrange the spinach leaves and thinly sliced cooked deli roast beef over the filling."
    },
    {
      "step": 4,
      "text": "Roll each tortilla tightly into a log. Wrap and refrigerate for 4 hours to firm the rolls.",
      "timer_minutes": 240
    },
    {
      "step": 5,
      "text": "Unwrap the chilled rolls and cut each into bite-size pinwheels."
    }
  ],
