  "id": "swedish-rye-bread",
  "name": "Swedish Rye Bread",
  "subtitle": "A lightly sweet, molasses-scented rye loaf",
  "description": "A tender yeast bread combining rye flour with bread flour, brown sugar, molasses, and milk.",
