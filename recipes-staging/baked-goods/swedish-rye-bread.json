  "instructions": [
    {
      "step": 1,
      "text": "Heat the milk for 3 minutes, then let it cool until warm rather than hot. Dissolve the yeast in the warm water and let it stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir the brown sugar, melted shortening, molasses, and salt into the cooled milk. Mix in the yeast mixture, then add the rye flour and bread flour gradually until a dough forms."
    },
    {
      "step": 3,
      "text": "Knead the dough until smooth and elastic. Place it in a coated bowl, cover, and let it rise in a warm place until doubled, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Punch down the dough, rest it for 5 minutes, then shape it into loaves and transfer them to prepared pans. Cover and let rise for 45 minutes.",
      "timer_minutes": 50
    },
    {
      "step": 5,
      "text": "Heat the oven to 375°F. Bake the loaves for about 35 minutes, until golden brown and cooked through.",
      "timer_minutes": 35
    }
  ],
