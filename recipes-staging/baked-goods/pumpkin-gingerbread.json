  "id": "pumpkin-gingerbread",
  "name": "Pumpkin Gingerbread",
  "subtitle": "A warmly spiced pumpkin loaf for sharing",
  "description": "Moist pumpkin bread flavored with ginger, cinnamon, allspice, and cloves.",
  "meal_type": "baked-good",
