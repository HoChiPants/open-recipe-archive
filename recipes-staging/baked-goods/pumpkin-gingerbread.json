  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the sugar and eggs until smooth, then whisk in the water."
    },
    {
      "step": 3,
      "text": "Stir in the oil, pumpkin puree, ginger, allspice, cinnamon, and cloves until blended."
    },
    {
      "step": 4,
      "text": "Combine the flour, baking soda, salt, and baking powder in a separate bowl. Add the dry mixture to the pumpkin mixture and blend until combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake at 350°F, beginning to check at 45 minutes and continuing until the center is fully set, up to about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool before cutting and serving."
    }
  ],
