  "id": "gluten-free-bread-in-a-bread-machine",
  "name": "Gluten-Free Bread in a Bread Machine",
  "subtitle": "A simple yeast loaf made in the bread machine",
  "description": "Mix the ingredients in the machine pan, run the gluten-free cycle, and cool the finished loaf before slicing.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60,
    "inactive_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "warm-water",
      "item": "warm water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cider-vinegar",
      "item": "cider vinegar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "gluten-free-all-purpose-baking-flour",
      "item": "gluten-free all-purpose baking flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "xanthan-gum",
      "item": "xanthan gum",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour the water, eggs, oil, and vinegar into the bread-machine pan. Add the flour, xanthan gum, salt, sugar, and yeast."
    },
    {
      "step": 2,
      "text": "Select the machine's gluten-free bread setting and begin the cycle. Let the loaf bake for about 60 minutes, until set and fully baked.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Remove the pan when the cycle ends. Let the loaf cool completely before slicing.",
      "timer_minutes": 90
    }
