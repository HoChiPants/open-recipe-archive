  "id": "garlic-breadsticks",
  "name": "Garlic Breadsticks",
  "subtitle": "Crisp, buttery breadsticks with Parmesan and herbs",
  "description": "Turn split buns into quick garlic breadsticks by coating them with softened margarine and a savory Parmesan-basil topping, then baking until golden.",
  "meal_type": "baked-good",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "hot-dog-buns",
      "item": "hot dog buns",
      "quantity": 4,
      "preparation": "split"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "softened"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Stir together the Parmesan, garlic powder, and crushed basil."
    },
    {
      "step": 3,
      "text": "Arrange the split buns cut-side up on a baking sheet and spread them with the softened margarine."
    },
    {
      "step": 4,
      "text": "Sprinkle the Parmesan mixture evenly over the buns."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, or until golden brown.",
      "timer_minutes": 10
    }
  ],
