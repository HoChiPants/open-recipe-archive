      "item": "all-purpose flour",
      "quantity": 3.3333332538605,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the milk until steaming. Stir in the sugar, shortening, and salt, then let the mixture cool until warm."
    },
    {
      "step": 2,
      "text": "Stir the yeast into the warm water and let it stand for 5 minutes, until set.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the egg and yeast mixture into the cooled milk mixture. Stir in the flour until the dough is smooth."
    },
    {
      "step": 4,
      "text": "Cover the dough and let it rise in a warm place for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Turn the dough onto a lightly floured surface and shape it into 36 small balls. Place three balls in each greased muffin cup."
    },
    {
      "step": 6,
      "text": "Cover and let the shaped rolls rise for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 8,
      "text": "Bake for 15 minutes, until golden and the center reaches 160°F on a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 9,
      "text": "Serve warm."
    }
  ],
