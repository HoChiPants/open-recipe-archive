  "id": "clover-leaf-dinner-rolls",
  "name": "Clover Leaf Dinner Rolls",
  "subtitle": "Soft yeast rolls shaped into three-piece clusters",
  "description": "Tender, lightly sweet rolls with a classic clover-leaf shape for serving with dinner.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
