  "instructions": [
    {
      "step": 1,
      "text": "Add the warm water and bread machine yeast to the bread-machine pan."
    },
    {
      "step": 2,
      "text": "Add the beaten egg, salt, sugar, olive oil, rosemary, oregano, basil, and both portions of flour."
    },
    {
