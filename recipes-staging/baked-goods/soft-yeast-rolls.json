  "id": "soft-yeast-rolls",
  "name": "Soft Yeast Rolls",
  "subtitle": "Tender, lightly sweet rolls for the table",
  "description": "A simple enriched yeast dough shaped into fluffy rolls and baked until golden.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 15,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 5,
      "unit": "cups"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk, water, sugar, and salt together until hot but not boiling. Let the mixture cool until lukewarm."
    },
    {
      "step": 2,
      "text": "Stir the eggs and active dry yeast into the lukewarm milk mixture."
    },
    {
      "step": 3,
      "text": "Add enough of the flour to form a soft dough, then mix in the melted margarine and remaining flour."
    },
    {
      "step": 4,
      "text": "Knead until smooth and elastic. Cover and let rise in a warm place until doubled, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Shape the dough into 16 rolls and arrange them on a prepared baking sheet. Cover and let rise for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 7,
      "text": "Bake until golden brown, about 15 minutes.",
      "timer_minutes": 15
    }
  ],
