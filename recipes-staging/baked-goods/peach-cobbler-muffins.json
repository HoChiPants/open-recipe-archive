  "id": "peach-cobbler-muffins",
  "name": "Peach Cobbler Muffins",
  "subtitle": "Tender muffins with peaches and a cinnamon crumble",
  "description": "Peach-filled muffins topped with a buttery brown-sugar crumb for a cobbler-style finish.",
  "meal_type": "baked-good",
  "cuisine": "American",
