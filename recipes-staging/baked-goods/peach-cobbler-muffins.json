  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare muffin cups."
    },
    {
      "step": 2,
      "text": "Whisk the white sugar, vegetable oil, and eggs until blended."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the 3 cups flour, 1 teaspoon cinnamon, baking soda, and salt. Whisk into the egg mixture until combined."
    },
    {
      "step": 4,
      "text": "Fold in the chopped peaches, then divide the batter among the prepared cups."
    },
    {
      "step": 5,
      "text": "Work the brown sugar, 0.66666668653488 cup flour, softened butter, and remaining cinnamon together. Add this mixture over the batter."
    },
    {
      "step": 6,
      "text": "Bake until the muffins are set, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Cool for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
