  "id": "jalapen-o-bread",
  "name": "Jalapeño Bread",
  "subtitle": "A tender yeast loaf with Monterey Jack and fresh pepper",
  "description": "Bake a savory, lightly spicy loaf studded with chopped jalapeños and melted Monterey Jack cheese.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 55,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "monterey-jack-cheese",
      "item": "Monterey Jack cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "fresh-jalapen-o-peppers",
      "item": "fresh jalapeño peppers",
      "quantity": 6,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 0.5,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the warm water, cheese, jalapeños, salt, bread flour, sugar, and yeast in a mixing bowl. Stir until a shaggy dough forms.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Knead the dough until smooth and elastic, then place it in a lightly prepared bowl and cover."
    },
    {
      "step": 3,
      "text": "Let the dough rise in a warm place until doubled in volume.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Shape the dough into a loaf, place it in a loaf pan, cover, and let it rise again until puffy.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Preheat the oven to 375°F. Bake until the loaf is browned and sounds hollow when tapped, about 55 minutes. Cool before slicing.",
      "timer_minutes": 55
    }
  ],
