  "instructions": [
    {
      "step": 1,
      "text": "Lightly oil a Bundt or tube pan with the vegetable oil."
    },
    {
      "step": 2,
      "text": "Stir the warm water, yeast, and 1 teaspoon white sugar together. Let stand for 5 minutes, until foamy.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Combine the warmed milk, egg, 3 tablespoons white sugar, 2 tablespoons melted butter, salt, and vanilla. Stir in the yeast mixture, then add the flour gradually until a soft dough forms."
    },
    {
      "step": 4,
      "text": "Transfer the dough to a lightly floured surface and knead until smooth. Place it in an oiled bowl, cover, and let rise for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Mix the brown sugar and cinnamon in a bowl. Divide the dough into small pieces, dip each piece in the 1/2 cup melted butter, and coat with the cinnamon-sugar mixture."
    },
    {
      "step": 6,
      "text": "Arrange the coated pieces in the prepared pan. Cover and let rise for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 8,
      "text": "Bake for 35 minutes, until golden brown and the center is fully set; verify the egg-containing bread reaches 160°F.",
      "timer_minutes": 35
    },
    {
      "step": 9,
      "text": "Cool in the pan for 10 minutes, then invert onto a serving plate and serve.",
      "timer_minutes": 10
    }
  ],
