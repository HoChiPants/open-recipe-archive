  "id": "monkey-bread-from-scratch",
  "name": "Monkey Bread from Scratch",
  "subtitle": "Soft pull-apart bread with cinnamon-sugar coating",
  "description": "Make a yeasted dough, coat pieces in cinnamon sugar and butter, then bake until golden for a shareable pull-apart bread.",
  "meal_type": "baked-good",
  "cuisine": "American",
