  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare the baking pan or pans."
    },
    {
      "step": 2,
      "text": "Combine the flour, cinnamon, baking soda, and baking powder in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, mix the green tomatoes, sugar, walnuts, oil, eggs, vanilla, and salt."
    },
    {
      "step": 4,
      "text": "Stir the dry mixture into the tomato mixture just until evenly combined, then transfer the batter to the prepared pan or pans."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until the center is firm and the loaf reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool for 10 minutes before slicing.",
      "timer_minutes": 10
    }
  ],
