  "id": "green-tomato-bread",
  "name": "Green Tomato Bread",
  "subtitle": "A warmly spiced quick bread with green tomatoes and walnuts",
  "description": "Green tomatoes add moisture and gentle tang to this cinnamon-scented quick bread, finished with chopped walnuts.",
  "meal_type": "baked-good",
