  "id": "buttermilk-honey-bread",
  "name": "Buttermilk Honey Bread",
  "subtitle": "Soft, lightly sweet yeast bread",
  "description": "A tender loaf with buttermilk, honey, and a buttery crumb.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30,
    "inactive_minutes": 100
  },
  "ingredients": [
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1.5,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "room temperature"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 6.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the yeast and sugar into the warm water. Let stand for 10 minutes, until foamy.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Mix in the buttermilk, melted butter, and honey. Add the salt and enough of the flour to form a dough."
    },
    {
      "step": 3,
      "text": "Turn the dough onto a floured surface and knead for 6 minutes, adding the remaining flour as needed, until smooth.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Coat the dough lightly, cover it, and let it rise in a warm place for 60 minutes, or until doubled.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 6,
      "text": "Shape the risen dough into the desired bread portions and transfer them to a prepared baking pan."
    },
    {
      "step": 7,
      "text": "Cover and let the shaped dough rest for 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 8,
      "text": "Bake at 375°F for 30 minutes, until the bread is browned and cooked through.",
      "timer_minutes": 30
    }
  ],
