  "id": "cheddar-almond-flour-biscuits",
  "name": "Cheddar Almond Flour Biscuits",
  "subtitle": "Tender, savory biscuits with a crisp cheese edge",
  "description": "These gluten-free biscuits combine almond flour, Cheddar, eggs, and half-and-half for a quick, savory side.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "almond-flour",
      "item": "almond flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 2.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "half-and-half",
      "item": "half-and-half",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Whisk the almond flour and baking powder together in a bowl."
    },
    {
      "step": 3,
      "text": "Stir in the shredded Cheddar."
    },
    {
      "step": 4,
      "text": "In a separate bowl, beat the eggs with the half-and-half."
    },
    {
      "step": 5,
      "text": "Add the egg mixture to the dry ingredients and blend until a thick batter forms."
    },
    {
      "step": 6,
      "text": "Portion the batter into nine mounds on the baking sheet."
    },
    {
      "step": 7,
      "text": "Bake for 20 minutes, until puffed and golden with a fully set center.",
      "timer_minutes": 20
    }
  ],
