  "id": "pa-o-de-queijo",
  "name": "Pão de Queijo",
  "subtitle": "Brazilian cheese rolls with a crisp exterior and tender center",
  "description": "These gluten-free cheese rolls use tapioca starch for a chewy texture and Parmesan for savory flavor.",
  "meal_type": "baked-good",
  "cuisine": "Brazilian",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "tapioca-starch",
      "item": "tapioca starch",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "parmesan-cheese",
      "item": "Parmesan cheese",
      "quantity": 6,
      "unit": "ounces",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine the tapioca starch and salt in a bowl."
    },
    {
      "step": 3,
      "text": "Heat the oil, water, and milk until steaming, then pour the hot mixture over the starch. Stir until evenly moistened."
    },
    {
      "step": 4,
      "text": "Let the mixture cool and rest for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Mix in the shredded Parmesan and eggs until a cohesive dough forms."
    },
    {
      "step": 6,
      "text": "Shape the dough into 14 portions and arrange them on a baking sheet."
    },
    {
      "step": 7,
      "text": "Bake until puffed and lightly browned, about 20 minutes.",
      "timer_minutes": 20
    }
  ],
