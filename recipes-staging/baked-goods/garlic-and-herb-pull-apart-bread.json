      "item": "dried basil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "refrigerated-biscuit-dough",
      "item": "refrigerated biscuit dough",
      "quantity": 2,
      "unit": "can",
      "preparation": "10 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat the baking pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Stir the melted butter, garlic, parsley, rosemary, and basil together."
    },
    {
      "step": 3,
      "text": "Separate the biscuit dough into pieces and arrange them in the prepared pan."
    },
    {
      "step": 4,
      "text": "Pour the seasoned butter over the dough, distributing it as evenly as possible."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, or until the bread is cooked through.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Let the bread cool briefly, then serve warm."
    }
  ],
