  "id": "garlic-and-herb-pull-apart-bread",
  "name": "Garlic and Herb Pull-Apart Bread",
  "subtitle": "Warm biscuit pieces layered with seasoned butter",
  "description": "Tender biscuit dough is coated with garlic, parsley, rosemary, basil, and melted butter, then baked into a shareable pull-apart loaf.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
