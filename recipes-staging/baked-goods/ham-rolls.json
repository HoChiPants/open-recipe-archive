  "id": "ham-rolls",
  "name": "Ham Rolls",
  "subtitle": "Cream cheese and green onion ham roll-ups",
  "description": "A simple savory appetizer made by filling ham with softened cream cheese and green onions, then slicing it into bite-size rolls.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "slices-cooked-ham",
      "item": "slices cooked ham",
      "quantity": 5
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 5
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the green onions into thin pieces."
    },
    {
      "step": 2,
      "text": "Whisk the softened cream cheese until smooth."
    },
    {
      "step": 3,
      "text": "Lay the ham slices flat and spread them with the cream cheese. Scatter the green onions over the filling."
    },
    {
      "step": 4,
      "text": "Roll each ham slice tightly around the filling, then cut the rolls into bite-size pieces."
    }
  ],
