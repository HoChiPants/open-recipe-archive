  "instructions": [
    {
      "step": 1,
      "text": "Combine the warm water, sugar, and yeast. Let stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mix in the Romano, olive oil, salt, basil, oregano, garlic powder, onion powder, and enough bread flour to form a dough."
    },
    {
      "step": 3,
      "text": "Knead the dough for 10 minutes, adding the remaining flour as needed, until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Transfer the dough to a suitable container, cover, and let rise for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Shape the risen dough and transfer it to a baking pan. Cover and let rise for 30 minutes while the oven heats to 350°F.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Bake at 350°F for 35 minutes, until the bread is fully baked and browned.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Cool the bread for 15 minutes before serving.",
      "timer_minutes": 15
    }
  ],
