  "id": "italian-herb-bread",
  "name": "Italian Herb Bread",
  "subtitle": "Savory yeast bread with dried herbs and Romano",
  "description": "A fragrant homemade loaf seasoned with basil, oregano, garlic, onion, and Romano cheese.",
