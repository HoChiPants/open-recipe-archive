  "instructions": [
    {
      "step": 1,
      "text": "Whisk 0.5 teaspoon instant yeast with the warm water at 110°F/45°C. Stir in the whole wheat flour and let the mixture stand until thickened, then continue resting as directed by the dough schedule."
    },
    {
      "step": 2,
      "text": "Stir the remaining warm water and 0.5 teaspoon instant yeast into the flour mixture. Add the unbleached bread flour and mix until combined."
    },
    {
      "step": 3,
      "text": "Knead the dough for 12 minutes. Add the kosher salt and continue working the dough for about 7 minutes, until smooth.",
      "timer_minutes": 19
    },
    {
      "step": 4,
      "text": "Shape the dough into a round, rest it briefly, then coat it lightly and let it rise for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Cut and reshape the dough, letting it rest for 30 minutes. Shape it again, fold as needed, transfer it to a cornmeal-dusted surface, and let it rise for 2 hours.",
      "timer_minutes": 150
    },
    {
      "step": 6,
      "text": "Preheat the oven to 375°F. Transfer the risen dough to the oven and bake until golden brown, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Cool the loaf before slicing."
    }
  ],
