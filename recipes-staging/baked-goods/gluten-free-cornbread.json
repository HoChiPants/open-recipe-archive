  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Prepare the baking pan as needed."
    },
    {
      "step": 2,
      "text": "Mix the cornmeal, sugar, gluten-free flour, and baking powder in a bowl. Stir in the cream-style corn."
    },
    {
      "step": 3,
      "text": "Whisk the milk and melted butter together, then add the egg and blend until smooth."
    },
    {
      "step": 4,
      "text": "Fold the wet mixture into the cornmeal mixture until evenly combined; avoid overmixing."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 25 minutes, or until the center is firm and fully set.",
      "timer_minutes": 25
    }
  ],
