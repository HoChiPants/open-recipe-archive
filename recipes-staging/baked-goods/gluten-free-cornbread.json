  "id": "gluten-free-cornbread",
  "name": "Gluten-Free Cornbread",
  "subtitle": "Tender, lightly sweet skillet-style bread",
  "description": "A simple American cornbread made with white cornmeal, gluten-free flour, cream-style corn, and a buttery milk-based batter.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
