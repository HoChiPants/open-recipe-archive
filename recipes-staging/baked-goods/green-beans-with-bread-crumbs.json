  "instructions": [
    {
      "step": 1,
      "text": "Place the green beans and water in a pot. Bring to a simmer and cook for about 10 minutes, or until tender.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Drain the beans well. Toss them with the bread crumbs, olive oil, salt and pepper, garlic powder, oregano, and basil."
    },
    {
      "step": 3,
      "text": "Transfer the seasoned beans to a serving dish and sprinkle with the grated Parmesan."
    }
