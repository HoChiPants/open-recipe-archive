  "id": "white-bread",
  "name": "White Bread",
  "subtitle": "Tender homemade loaves with a light crumb",
  "description": "A classic yeast bread made with milk, bread flour, and a short rise-and-bake process.",
  "meal_type": "baked-good",
  "cuisine": "American",
