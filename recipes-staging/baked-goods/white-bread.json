  "instructions": [
    {
      "step": 1,
      "text": "Heat the milk until steaming. Stir in the sugar, salt, and shortening, then let the mixture cool to lukewarm."
    },
    {
      "step": 2,
      "text": "Stir the yeast into the warm water and let it stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Combine the cooled milk mixture with the yeast mixture. Add the bread flour gradually, stirring until a dough forms."
    },
    {
      "step": 4,
      "text": "Transfer the dough to a lightly floured surface and knead for 10 minutes, until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Coat a bowl with cooking spray, place the dough inside, and turn it once to coat. Cover and let rise until doubled, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Punch down the dough, divide it into portions, and let it rest briefly. Shape the portions into loaves and place them in sprayed loaf pans.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Cover the shaped loaves and let them rise until puffy, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 9,
      "text": "Bake the loaves for 35 minutes, until golden brown and baked through. Cool before slicing.",
      "timer_minutes": 35
    }
  ],
