  "instructions": [
    {
      "step": 1,
      "text": "Preheat the cooking appliance for broiling."
    },
    {
      "step": 2,
      "text": "Stir the mayonnaise, Parmesan cheese, and garlic powder together until thick."
    },
    {
      "step": 3,
      "text": "Cut the loaf lengthwise and place it cut-side up on a suitable cooking pan."
    },
    {
      "step": 4,
      "text": "Spread the mixture evenly over the cut surfaces, then transfer the bread to the preheated appliance."
    },
    {
      "step": 5,
      "text": "Cook until golden brown, beginning to check at 2 minutes and continuing only as needed.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Let the bread stand briefly, then slice and serve.",
      "timer_minutes": 3
    }
