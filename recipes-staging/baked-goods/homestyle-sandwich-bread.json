  "instructions": [
    {
      "step": 1,
      "text": "Stir 0.5 cup warm water with the sugar, yeast, and warm milk. Set aside until the yeast mixture is set."
    },
    {
      "step": 2,
      "text": "Dissolve the baking soda in 1.5 teaspoons warm water, then combine it with the warm milk, salt, and bread flour. Whisk until smooth and thick."
    },
    {
      "step": 3,
      "text": "Whisk the yeast mixture into the flour mixture until evenly combined. Prepare the baking vessel or vessels with cornmeal, transfer in the dough, and add the remaining bread flour as directed by the mixture’s consistency."
    },
    {
      "step": 4,
      "text": "Bake at 375°F for 20 minutes, then cool before slicing.",
      "timer_minutes": 20
    }
  ],
