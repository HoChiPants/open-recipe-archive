      "preparation": "shredded"
    },
    {
      "ingredient_id": "dried-italian-seasoning",
      "item": "dried Italian seasoning",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cold-whole-milk",
      "item": "cold whole milk",
      "quantity": 1,
