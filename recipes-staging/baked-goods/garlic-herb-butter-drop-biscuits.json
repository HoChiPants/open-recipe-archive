  "id": "garlic-herb-butter-drop-biscuits",
  "name": "Garlic-Herb Butter Drop Biscuits",
  "subtitle": "Tender cheddar biscuits with a savory garlic finish",
  "description": "Quick drop biscuits combining cheddar, Italian seasoning, and garlic with a buttery parsley topping.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
