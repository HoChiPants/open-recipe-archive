      "item": "garlic powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Whisk the flour, baking powder, sugar, cream of tartar, 0.33333334326744 teaspoon garlic powder, and salt in a bowl."
    },
    {
      "step": 2,
      "text": "Cut the chilled unsalted butter into the dry mixture until crumbly, then fold in the Cheddar and Italian seasoning."
    },
    {
      "step": 3,
      "text": "Stir in the cold milk just until a soft dough forms. Drop 12 portions onto a baking surface."
    },
    {
      "step": 4,
      "text": "Bake for 15 minutes, or until lightly browned.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir the melted salted butter with the parsley flakes and 0.5 teaspoon garlic powder. Brush the warm biscuits with the mixture before serving."
    }
  ],
