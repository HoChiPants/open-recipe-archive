  "id": "basil-pesto-bread-rounds",
  "name": "Basil Pesto Bread Rounds",
  "subtitle": "Crisp baguette slices with a savory pesto topping",
  "description": "Toasted baguette rounds are spread with a creamy basil-pesto mixture and baked with Parmesan until set.",
  "meal_type": "baked-good",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
