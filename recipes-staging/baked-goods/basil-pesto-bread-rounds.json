    "cook_minutes": 12
  },
  "ingredients": [
    {
      "ingredient_id": "1-pound-loaf-french-baguette",
      "item": "(1 pound) loaf French baguette",
      "quantity": 1
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "basil-pesto",
      "item": "basil pesto",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "freshly-grated-parmesan-cheese",
      "item": "freshly grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Slice the baguette into rounds and arrange them in a single layer on a baking sheet."
    },
    {
      "step": 3,
      "text": "Stir together the mayonnaise, basil pesto, minced garlic, Parmesan, and salt."
    },
    {
      "step": 4,
      "text": "Spread the pesto mixture over the bread rounds."
    },
    {
      "step": 5,
      "text": "Bake until the topping is set and the edges are lightly crisp, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Let the bread rounds cool briefly before serving."
    }
  ],
