  "id": "currant-scones",
  "name": "Currant Scones",
  "subtitle": "Tender, lightly sweet scones with citrus-scented currants",
  "description": "These American-style scones combine buttery dough, dried currants, lemon zest, and a crisp sugar topping.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "dried-currants",
      "item": "dried currants",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.25,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "chilled-unsalted-butter",
      "item": "chilled unsalted butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "cut into 1/2-inch cubes"
    },
    {
      "ingredient_id": "chilled-unsalted-butter",
      "item": "chilled unsalted butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "cut into 1/2-inch cubes"
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "coarse-sugar-crystals",
      "item": "coarse sugar crystals",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Cover the currants with hot water, let them stand until plump, then drain well."
    },
    {
      "step": 3,
      "text": "Whisk the flour, baking powder, baking soda, sugar, and salt in a large bowl."
    },
    {
      "step": 4,
      "text": "Cut the chilled cubed butter into the flour mixture until it forms coarse crumbs. Stir in the currants, buttermilk, and lemon zest just until a dough forms."
    },
    {
      "step": 5,
      "text": "Turn the dough onto a lightly floured surface and shape it into a thick round. Brush with melted butter and sprinkle with the coarse sugar crystals."
    },
    {
      "step": 6,
      "text": "Cut the round into 12 wedges and transfer them to a baking sheet."
    },
    {
      "step": 7,
      "text": "Bake until golden brown, about 18 to 20 minutes.",
      "timer_minutes": 18
    },
    {
      "step": 8,
      "text": "Cool briefly before serving."
    }
  ],
