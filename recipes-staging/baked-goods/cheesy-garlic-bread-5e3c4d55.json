  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Mix the softened butter, mayonnaise, green onions, garlic, Parmesan, and Monterey Jack until evenly combined."
    },
    {
      "step": 3,
      "text": "Place the bread halves cut side up on a baking sheet and spread the cheese mixture over them."
    },
    {
      "step": 4,
      "text": "Bake for 8 minutes, then grill briefly until the topping is bubbling and lightly browned.",
