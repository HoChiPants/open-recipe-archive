      "ingredient_id": "0-6-ounce-cakes-compressed-fresh-yeast",
      "item": "(0.6 ounce) cakes compressed fresh yeast",
      "quantity": 2
    },
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "hot-water",
      "item": "hot water",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 15,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Dissolve the fresh yeast in the warm water and let it stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Combine the hot water, sugar, salt, and shortening in a large mixing bowl. Stir until the shortening is incorporated, then let the mixture cool until lukewarm."
    },
    {
      "step": 3,
      "text": "Whisk in the dissolved yeast. Stir in the bread flour gradually until a dough forms."
    },
    {
      "step": 4,
      "text": "Knead the dough on a lightly floured surface for 15 minutes, until smooth.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Transfer the dough to a coated bowl, cover, and let it rise for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Divide and shape the risen dough into loaves or rolls. Arrange the pieces in prepared baking pans and let them rise for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 8,
      "text": "Bake for 40 minutes, until golden brown.",
      "timer_minutes": 40
    }
  ],
