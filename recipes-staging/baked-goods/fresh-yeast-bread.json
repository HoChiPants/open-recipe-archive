  "id": "fresh-yeast-bread",
  "name": "Fresh Yeast Bread",
  "subtitle": "Classic homemade bread with a tender crumb",
  "description": "A large-batch yeast bread made with fresh yeast, sugar, shortening, and bread flour, then shaped and baked until golden.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 72,
