  "id": "crab-and-sriracha-rice-paper-rolls",
  "name": "Crab and Sriracha Rice Paper Rolls",
  "subtitle": "Fresh rolls with chile-lime crab and crisp vegetables",
  "description": "Rice paper wraps filled with seasoned crab, herbs, avocado, and crunchy vegetables, finished with sesame seeds.",
  "meal_type": "baked-good",
