  "instructions": [
    {
      "step": 1,
      "text": "Mix the crabmeat, mayonnaise, lime zest and juice, and sriracha until evenly coated."
    },
    {
      "step": 2,
      "text": "Arrange the mint, coriander, carrot, cucumber, avocado, and radishes so they are ready for assembly."
    },
    {
      "step": 3,
      "text": "Dip one rice paper wrap briefly in water until pliable, then lay it flat on a clean work surface."
    },
    {
      "step": 4,
      "text": "Place some crab mixture and vegetables across the lower third of the wrap; sprinkle with sesame seeds."
    },
    {
      "step": 5,
      "text": "Fold the bottom edge over the filling, fold in the sides, and roll tightly to enclose. Repeat with the remaining wraps and filling."
    },
    {
      "step": 6,
      "text": "Serve the rolls whole or cut in half."
    }
  ],
