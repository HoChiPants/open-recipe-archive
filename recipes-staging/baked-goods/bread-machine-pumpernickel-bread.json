  "instructions": [
    {
      "step": 1,
      "text": "Add the warm water, oil, molasses, cocoa, caraway seed, and salt to the bread-machine pan."
    },
    {
      "step": 2,
      "text": "Add the bread flour, rye flour, whole wheat flour, and vital wheat gluten. Place the yeast on top of the dry ingredients."
    },
    {
      "step": 3,
      "text": "Select a standard bread cycle and start the machine. Bake until the loaf is risen and firm, about 225 minutes.",
      "timer_minutes": 225
    },
    {
      "step": 4,
      "text": "Remove the loaf from the pan and cool before slicing."
    }
