  "id": "curried-prawns-on-toasted-naan",
  "name": "Curried Prawns on Toasted Naan",
  "subtitle": "A quick spiced prawn topping with chickpeas and chutney",
  "description": "Warm curry spices with chickpeas, prawns, creamy yogurt, chutney, coriander, and toasted almonds, then serve over crisp naan.",
  "meal_type": "baked-good",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 8,
    "cook_minutes": 3
  },
  "ingredients": [
    {
      "ingredient_id": "mild-curry-powder",
      "item": "mild curry powder",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-turmeric",
      "item": "ground turmeric",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "x-400g-can-chickpeas-drained",
      "item": "x 400g can chickpeas drained",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "king-prawns",
      "item": "king prawns",
      "quantity": 60,
      "unit": "g",
      "preparation": "cooked"
    },
    {
      "ingredient_id": "fat-free-greek-yogurt",
      "item": "fat-free Greek yogurt",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "mango-chutney",
      "item": "mango chutney",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "bunch-coriander-chopped",
      "item": "bunch coriander chopped",
      "quantity": "1/2",
      "unit": "small"
    },
    {
      "ingredient_id": "garlic-naan-bread",
      "item": "garlic naan bread",
      "quantity": "1/2",
      "unit": "large"
    },
    {
      "ingredient_id": "flaked-almonds-toasted",
      "item": "flaked almonds toasted",
      "quantity": 15,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the curry powder and turmeric in a dry skillet over low heat for about 1 minute, stirring until fragrant.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Add the drained chickpeas and stir to coat with the spices."
    },
    {
      "step": 3,
      "text": "Mix the cooked prawns, yogurt, mayonnaise, mango chutney, and chopped coriander in a bowl. Fold in the spiced chickpeas."
    },
    {
      "step": 4,
      "text": "Cut the naan into serving pieces and toast until warmed and lightly crisp, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Spoon the prawn mixture over the toasted naan and scatter with the toasted flaked almonds."
    }
  ],
