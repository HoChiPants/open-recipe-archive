  "id": "cheddar-chorizo-and-tomato-scone-loaf",
  "name": "Cheddar, Chorizo, and Tomato Scone Loaf",
  "subtitle": "A savory loaf with sharp cheese, spicy chorizo, and tangy tomatoes.",
  "description": "This tender scone-style loaf combines cheddar, sun-dried tomatoes, chorizo, and spring onions for an easy savory bake.",
  "meal_type": "baked-good",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "self-raising-flour-plus-extra-for-dusting",
      "item": "self-raising flour plus extra for dusting",
      "quantity": 350,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "cold-unsalted-butter-cut-into-small-cubes",
      "item": "cold unsalted butter cut into small cubes",
      "quantity": 85,
      "unit": "g"
    },
    {
      "ingredient_id": "mature-cheddar-grated",
      "item": "mature cheddar grated",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "sun-dried-tomatoes-drained-weight",
      "item": "sun-dried tomatoes (drained weight)",
      "quantity": 100,
      "unit": "g",
      "preparation": "roughly chopped"
    },
    {
      "ingredient_id": "chorizo-finely-chopped",
      "item": "chorizo finely chopped",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "spring-onions-finely-sliced",
      "item": "spring onions finely sliced",
      "quantity": 4
    },
    {
      "ingredient_id": "200ml-milk",
      "item": "200ml milk",
      "quantity": 175,
      "unit": "ml"
    },
    {
      "ingredient_id": "egg-beaten",
      "item": "egg beaten",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Lightly flour a loaf tin or baking sheet."
    },
    {
      "step": 2,
      "text": "Rub the cold butter into the flour and baking powder until the mixture resembles coarse crumbs."
    },
    {
      "step": 3,
      "text": "Stir in the cheddar, sun-dried tomatoes, chorizo, and spring onions."
    },
    {
      "step": 4,
      "text": "Add the milk and mix just until a soft dough forms. Turn it onto a lightly floured surface and knead briefly."
    },
    {
      "step": 5,
      "text": "Shape the dough into a loaf and place it in the prepared tin or on the sheet. Brush the top with the beaten egg."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until golden brown and the center reaches 160°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Cool briefly before slicing and serving."
    }
  ],
