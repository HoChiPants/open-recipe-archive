  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "no-knead-ciabatta",
  "name": "No-Knead Ciabatta",
  "subtitle": "Open-textured Italian bread with an overnight rise",
  "description": "A rustic ciabatta made with a wet dough, long fermentation, gentle folding, and a hot bake.",
  "meal_type": "baked-good",
  "cuisine": "Italian",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35,
    "inactive_minutes": 1200
  },
  "ingredients": [
    {
      "ingredient_id": "white-bread-flour",
      "item": "white bread flour",
      "quantity": 3.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "whole-wheat-bread-flour",
      "item": "whole wheat bread flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "cornmeal",
      "item": "cornmeal",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the white bread flour, whole wheat bread flour, salt, and active dry yeast in a large bowl. Add the water and stir until a sticky, shaggy dough forms.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Cover the bowl and let the dough rest at room temperature for 18 hours.",
      "timer_minutes": 1080
    },
    {
      "step": 3,
      "text": "Use wet hands to fold the dough over itself several times. Lightly coat a work surface with the olive oil, then transfer the dough to it."
    },
    {
      "step": 4,
      "text": "Dust the dough and work surface with the flours. Divide the dough into two portions and gently shape each into a rough rectangle, taking care not to deflate it."
    },
    {
      "step": 5,
      "text": "Place the portions on a cornmeal-dusted baking surface, dust their tops with the remaining flour, and let them rest for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 7,
      "text": "Bake until the loaves are puffed and deeply golden.",
      "timer_minutes": 35
    }
  ],
