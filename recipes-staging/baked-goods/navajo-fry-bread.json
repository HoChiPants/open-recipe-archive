{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "navajo-fry-bread",
  "name": "Navajo Fry Bread",
  "subtitle": "Tender, golden fried bread for serving warm",
  "description": "A simple milk-enriched dough is shaped thick and fried until crisp and golden.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "oil-for-frying",
      "item": "oil for frying",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "warm-milk",
      "item": "warm milk",
      "quantity": 2.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the frying oil to 375°F in a deep, heavy skillet or pot, using a thermometer to monitor the temperature."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, and salt together in a large bowl."
    },
    {
      "step": 3,
      "text": "Add the warm milk and stir until a soft dough forms. Knead briefly until cohesive."
    },
    {
      "step": 4,
      "text": "Divide the dough into portions and shape each into a thick round."
    },
    {
      "step": 5,
      "text": "Fry the rounds in batches for about 3 minutes, turning as needed, until golden brown.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Transfer the fry bread to a lined plate or rack to drain, and serve warm."
    }
  ],
