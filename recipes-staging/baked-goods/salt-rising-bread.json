  "id": "salt-rising-bread",
  "name": "Salt Rising Bread",
  "subtitle": "A long-rising cornmeal bread with a tender crumb",
  "description": "Prepare a warm cornmeal mixture, combine it with flour and shortening, allow the dough to rise, then shape and bake until golden brown.",
  "meal_type": "baked-good",
