  "instructions": [
    {
      "step": 1,
      "text": "Combine the milk, cornmeal, 1 tablespoon sugar, and salt in a heatproof container. Add 2 cups warm water and keep the mixture in a warm place for about 12 hours.",
      "timer_minutes": 720
    },
    {
      "step": 2,
      "text": "Stir in 2 tablespoons sugar, 2 cups flour, and the shortening. Cover and keep warm for about 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 3,
      "text": "Mix the baking soda with 1 tablespoon warm water, then stir it into the dough mixture."
    },
    {
      "step": 4,
      "text": "Gradually add the remaining 6 cups flour, mixing until a dough forms. Knead for 10 minutes, until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Cut the dough into portions and shape each into a loaf. Place the loaves in prepared pans, cover, and keep them warm for about 5 hours.",
      "timer_minutes": 300
    },
    {
      "step": 6,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 7,
      "text": "Bake at 375°F for 10 minutes, then reduce the oven temperature to 350°F and bake for 20 minutes, until golden brown.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Transfer the loaves to a rack and cool before serving."
    }
  ],
