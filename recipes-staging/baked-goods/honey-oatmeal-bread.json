  "id": "honey-oatmeal-bread",
  "name": "Honey Oatmeal Bread",
  "subtitle": "Soft oat bread with a light honey finish",
  "description": "A gently sweet yeast bread made with rolled oats, honey, and bread flour, finished with an oat topping.",
  "meal_type": "baked-good",
  "cuisine": "American",
