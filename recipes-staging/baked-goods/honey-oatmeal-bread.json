      "item": "rolled oats",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir 1 cup rolled oats, 0.5 cup honey, butter, and salt into the boiling water. Let the mixture cool for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Dissolve the active dry yeast in the warm water and let it stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Mix the yeast mixture into the cooled oat mixture, then add the bread flour. Stir until a dough forms."
    },
    {
      "step": 4,
      "text": "Knead the dough on a lightly floured surface for 20 minutes, until smooth.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Place the dough in a coated bowl, cover it, and let it rise for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Shape the dough and place it in prepared baking pan or pans. Let it rise for 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Heat the oven to 350°F. Brush the top with the warmed honey and sprinkle with 2 tablespoons rolled oats."
    },
    {
      "step": 8,
      "text": "Bake for 30 minutes, until golden brown.",
      "timer_minutes": 30
    },
    {
      "step": 9,
      "text": "Cool the bread before slicing."
    }
  ],
