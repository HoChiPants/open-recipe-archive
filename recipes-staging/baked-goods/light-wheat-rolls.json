{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "light-wheat-rolls",
  "name": "Light Wheat Rolls",
  "subtitle": "Soft homemade rolls with whole-wheat flavor",
  "description": "Tender wheat rolls made with yeast, butter, and a blend of whole wheat and all-purpose flours.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 15,
    "inactive_minutes": 140
  },
  "ingredients": [
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 2,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted and cooled"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "whole-wheat-flour",
      "item": "whole wheat flour",
      "quantity": 2.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Dissolve the yeast in the warm water and let it stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the sugar, salt, cooled melted butter, beaten egg, whole wheat flour, and all-purpose flour until a dough forms."
    },
    {
      "step": 3,
      "text": "Knead the dough on a lightly floured surface for 8 minutes, until smooth.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Place the dough in a lightly coated bowl, cover, and let it rise for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Punch down the dough, cover again, and let it rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cut the dough into 24 pieces and shape each piece into a roll."
    },
    {
      "step": 7,
      "text": "Arrange the rolls in a prepared baking pan, brush with melted butter, cover, and let rise for 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 8,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 9,
      "text": "Bake for 15 minutes, until golden brown and the centers are fully set.",
      "timer_minutes": 15
    },
    {
      "step": 10,
      "text": "Brush the warm rolls with the remaining melted butter before serving."
    }
  ],
