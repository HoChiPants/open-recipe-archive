  },
  "ingredients": [
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "sourdough-starter",
      "item": "sourdough starter",
      "quantity": 1,
      "unit": "cup"
    },
    {
