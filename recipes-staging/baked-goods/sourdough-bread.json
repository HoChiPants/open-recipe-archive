  "id": "sourdough-bread",
  "name": "Sourdough Bread",
  "subtitle": "A straightforward loaf with a chewy crumb and crisp crust.",
  "description": "Mix sourdough starter, yeast, and salt with warm water and flour, then shape and bake until deeply browned.",
  "meal_type": "baked-good",
