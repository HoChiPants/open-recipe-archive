      "unit": "teaspoons"
    },
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 2.6666669845581,
      "unit": "cups"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1.5,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the warm water, sourdough starter, salt, and yeast in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the bread flour and mix until a shaggy dough forms. Knead until the dough is smooth and elastic."
    },
    {
      "step": 3,
      "text": "Shape the dough into a loaf and place it in a suitable baking pan or on a lined sheet."
    },
    {
      "step": 4,
      "text": "Bake at 350°F until the loaf is well browned and sounds hollow when tapped, about 180 minutes. Cool before slicing.",
      "timer_minutes": 180
    }
  ],
