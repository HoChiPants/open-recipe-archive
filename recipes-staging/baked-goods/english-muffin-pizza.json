  "id": "english-muffin-pizza",
  "name": "English Muffin Pizza",
  "subtitle": "Crisp muffin halves with sauce, cheese, and savory toppings",
  "description": "English muffin halves are topped with pizza sauce, mozzarella, pepperoni, and cooked Italian sausage, then baked until the cheese melts.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
