    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "english-muffins",
      "item": "English muffins",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 ounce, split"
    },
    {
      "ingredient_id": "pizza-sauce",
      "item": "pizza sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, shredded"
    },
    {
      "ingredient_id": "pepperoni",
      "item": "pepperoni",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, sliced"
    },
    {
      "ingredient_id": "4-ounce-link-cooked-italian-sausage",
      "item": "(4 ounce) link cooked Italian sausage",
      "quantity": 1,
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Split the English muffins and arrange the halves cut-side up on a baking sheet."
    },
    {
      "step": 3,
      "text": "Spread pizza sauce over each muffin half."
    },
    {
      "step": 4,
      "text": "Top with shredded mozzarella, then add the sliced pepperoni and cooked Italian sausage."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, until the cheese is melted.",
      "timer_minutes": 10
    }
  ],
