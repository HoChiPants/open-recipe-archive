{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cheesy-hot-cross-buns",
  "name": "Cheesy Hot Cross Buns",
  "subtitle": "Savory British buns with cheddar and parmesan crosses",
  "description": "Soft yeast buns enriched with mature cheddar and finished with a simple parmesan-flour cross.",
  "meal_type": "baked-good",
  "cuisine": "British",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "strong-bread-flour-plus-extra-5-tbsp-for-crosses-and-dusting",
      "item": "strong bread flour plus extra 5 tbsp for crosses and dusting",
      "quantity": 700,
      "unit": "g"
    },
    {
      "ingredient_id": "x-7g-sachets-fast-action-dried-yeast",
      "item": "x 7g sachets fast-action dried yeast",
      "quantity": 3
    },
    {
      "ingredient_id": "warm-whole-milk",
      "item": "warm whole milk",
      "quantity": 500,
      "unit": "ml"
    },
    {
      "ingredient_id": "mature-cheddar-grated",
      "item": "mature cheddar grated",
      "quantity": 140,
      "unit": "g"
    },
    {
      "ingredient_id": "grated-parmesan-or-vegetarian-alternative",
      "item": "grated parmesan (or vegetarian alternative)",
      "quantity": 5,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour and yeast in a large bowl. Pour in the warm milk and add the grated cheddar, then mix to form a dough."
    },
    {
      "step": 2,
      "text": "Knead the dough on a lightly floured surface until smooth and elastic.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Cover and let the dough rest until puffy.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Knead briefly, divide into 12 equal pieces, and shape each into a round bun. Arrange on a lined baking tray and let them rest while preparing the crosses."
    },
    {
      "step": 5,
      "text": "Heat the oven to 400°F. Mix the reserved flour with the grated parmesan or vegetarian alternative, adding enough water to make a pipeable paste."
    },
    {
      "step": 6,
      "text": "Pipe a cross over each bun and dust the tray lightly with flour."
    },
    {
      "step": 7,
      "text": "Bake until risen and golden.",
      "timer_minutes": 25
    }
  ],
  "tags": [
