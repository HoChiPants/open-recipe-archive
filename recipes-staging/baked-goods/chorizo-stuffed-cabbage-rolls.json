  "id": "chorizo-stuffed-cabbage-rolls",
  "name": "Chorizo-Stuffed Cabbage Rolls",
  "subtitle": "Savoy cabbage parcels with rice, tomato, and herbs",
  "description": "Tender cabbage leaves wrap a smoky chorizo-and-rice filling and bake in tomato sauce until finished with parmesan.",
  "meal_type": "baked-good",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "cabbage-leaves-savoy",
      "item": "cabbage leaves (Savoy",
      "quantity": 8,
      "preparation": "Pointed or Hispi)"
    },
    {
      "ingredient_id": "cooking-chorizo-casing-removed",
      "item": "cooking chorizo casing removed",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "long-grain-rice",
      "item": "long-grain rice",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "smoked-paprika-we-used-spanish",
      "item": "smoked paprika (we used Spanish)",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "garlic-cloves-crushed-or-finely-grated",
      "item": "garlic cloves crushed or finely grated",
      "quantity": 2
    },
    {
      "ingredient_id": "bunch-of-parsley-or-coriander",
      "item": "bunch of parsley or coriander",
      "unit": "small",
      "preparation": "leaves picked and finely chopped"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "passata-rustica-or-use-regular-passata-or-finely-chopped-tomatoes",
      "item": "passata rustica (or use regular passata) or finely chopped tomatoes",
      "quantity": 680,
      "unit": "g"
    },
    {
      "ingredient_id": "parmesan-finely-grated",
      "item": "parmesan finely grated",
      "quantity": 15,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of water to a simmer. Add the cabbage leaves and cook until pliable, about 1 minute. Drain and cool briefly.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Combine the chorizo, rice, smoked paprika, garlic, and chopped parsley or coriander."
    },
    {
      "step": 3,
      "text": "Trim the thick central rib from each cabbage leaf. Place a portion of filling near the base, fold in the sides, and roll tightly. Repeat with the remaining leaves and filling."
    },
    {
      "step": 4,
      "text": "Preheat the oven. Pour some of the passata into a baking dish and arrange the cabbage rolls seam-side down. Cover with the remaining passata and drizzle with the olive oil."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until the filling reaches 160°F on a food thermometer and the rice is tender.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Sprinkle with the parmesan and bake until melted and lightly browned.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Serve hot with the tomato sauce from the dish."
    }
  ],
