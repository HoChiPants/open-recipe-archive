  "id": "cinnamon-cardamom-iced-biscuits",
  "name": "Cinnamon Cardamom Iced Biscuits",
  "subtitle": "Spiced biscuits with a simple decorative icing",
  "description": "Tender cinnamon-cardamom biscuits finished with a thick, set icing for serving or gifting.",
  "meal_type": "baked-good",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 50,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "plain-flour-plus-extra-for-dusting",
      "item": "plain flour plus extra for dusting",
      "quantity": 160,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-cardamom",
      "item": "ground cardamom",
      "quantity": "1/4-1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg-yolk",
      "item": "egg yolk",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "royal-icing-sugar",
      "item": "royal icing sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "few-drops-of-food-colouring-optional",
      "item": "few drops of food colouring (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cream the butter and caster sugar until smooth. Mix in the flour, cinnamon, and cardamom to form a dough, then add the egg yolk and vanilla extract."
    },
    {
      "step": 2,
      "text": "Dust the work surface with some of the extra flour. Roll out the dough and cut 12 biscuits. Arrange them on a lined baking tray and chill for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Preheat the oven to the required baking temperature."
    },
    {
      "step": 4,
      "text": "Bake the biscuits for 15 minutes, until firm and the center reaches 160°F for a safe egg endpoint.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Leave the biscuits on the tray for 5 minutes, then transfer them to a rack to cool completely.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Prepare the royal icing sugar into a thick icing and tint it with the optional food colouring, if desired."
    },
    {
      "step": 7,
      "text": "Decorate the cooled biscuits with the icing and leave them undisturbed until set, about 3 hours.",
      "timer_minutes": 180
    }
  ],
