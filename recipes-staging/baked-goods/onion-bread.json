  "id": "onion-bread",
  "name": "Onion Bread",
  "subtitle": "A soft yeast loaf with savory onion flavor",
  "description": "A tender homemade bread combining dried oregano, minced onion, and a fresh onion topping, finished with melted butter.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
