  "instructions": [
    {
      "step": 1,
      "text": "Combine the yeast, sugar, and warm water. Let the mixture stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the salt, shortening, minced onions, oregano, and enough bread flour to form a dough. Mix in the remaining flour as needed, then knead until smooth."
    },
    {
      "step": 3,
      "text": "Place the dough in a prepared pan or baking vessel, cover, and let it rise until puffy.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Shape or smooth the risen dough as needed, then let it rest while the oven heats to 375°F.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Top the dough with the onion and brush it with the melted butter."
    },
    {
      "step": 6,
      "text": "Bake at 375°F until the loaf is golden and sounds hollow when tapped, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Cool before slicing."
    }
  ],
