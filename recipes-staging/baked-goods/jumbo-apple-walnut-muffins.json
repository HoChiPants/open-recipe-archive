  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F and coat six jumbo muffin cups with nonstick cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk 1.25 cups white sugar with 0.5 cup butter, vanilla, and salt. Beat in the eggs one at a time."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine 1.75 cups flour, baking powder, and 0.5 teaspoon cinnamon. Stir this mixture into the batter alternately with the milk until just combined."
    },
    {
      "step": 4,
      "text": "Fold in the apples and walnuts, then portion the batter into the prepared cups."
    },
    {
      "step": 5,
      "text": "For the topping, rub together 1/4 cup white sugar, 3 tablespoons flour, cubed butter, and 1/2 teaspoon cinnamon until crumbly. Scatter it over the batter."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until golden brown and a tester inserted in the center comes out clean.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Let the muffins cool briefly in the pan, then transfer them to a rack to finish cooling."
    }
  ],
