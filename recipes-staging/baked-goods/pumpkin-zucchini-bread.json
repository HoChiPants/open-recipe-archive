  "id": "pumpkin-zucchini-bread",
  "name": "Pumpkin Zucchini Bread",
  "subtitle": "A warmly spiced loaf with pumpkin, zucchini, and walnuts",
  "description": "A tender quick bread combining pumpkin, grated zucchini, warm spices, and chopped walnuts.",
  "meal_type": "baked-good",
