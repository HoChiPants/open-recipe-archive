  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Whisk the pumpkin pie spice, eggs, sugar, oil, pumpkin, and vanilla until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the flour, salt, baking soda, and baking powder until just combined."
    },
    {
      "step": 4,
      "text": "Fold in the grated zucchini and chopped walnuts."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a prepared loaf pan and bake for 60 minutes, until lightly browned and a tester comes out clean.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool for 20 minutes before slicing.",
      "timer_minutes": 20
    }
  ],
