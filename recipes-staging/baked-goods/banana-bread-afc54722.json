  "id": "banana-bread-afc54722",
  "name": "Banana Bread",
  "subtitle": "A tender loaf made with ripe mashed banana",
  "description": "A simple American quick bread with a lightly sweet crumb and familiar banana flavor.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "mashed-banana",
      "item": "mashed banana",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Measure the flour and baking soda together."
    },
    {
      "step": 2,
      "text": "Whisk the sugar and softened margarine until smooth."
    },
    {
      "step": 3,
      "text": "Whisk in the eggs and mashed banana until combined."
    },
    {
      "step": 4,
      "text": "Add the flour mixture and stir just until combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a suitable loaf pan."
    },
    {
      "step": 6,
      "text": "Bake for 60 minutes, until the center is firm and the loaf is baked through.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Cool the bread completely before serving or freezing for storage."
    }
  ],
