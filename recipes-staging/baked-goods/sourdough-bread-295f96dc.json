  "id": "sourdough-bread-295f96dc",
  "name": "Sourdough Bread",
  "subtitle": "A simple naturally leavened loaf",
  "description": "Mix a lightly sweetened sourdough dough, let it ferment, then shape and bake until golden brown.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40,
    "inactive_minutes": 480
  },
  "ingredients": [
    {
      "ingredient_id": "warm-water",
      "item": "warm water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sourdough-starter",
      "item": "sourdough starter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "corn-oil",
      "item": "corn oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 6,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the warm water, sourdough starter, sugar, salt, and corn oil in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the bread flour and mix until a shaggy dough forms."
    },
    {
      "step": 3,
      "text": "Transfer the dough to a lightly oiled work surface and knead until smooth, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Place the dough in an oiled bowl, cover, and let it rise at room temperature for about 8 hours, or until noticeably expanded.",
      "timer_minutes": 480
    },
    {
      "step": 5,
      "text": "Dust the work surface with some of the bread flour, shape the dough into a loaf, and transfer it to a prepared baking pan."
    },
    {
      "step": 6,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 7,
      "text": "Bake for 40 minutes, or until the loaf is golden brown and sounds hollow when tapped.",
      "timer_minutes": 40
    },
    {
      "step": 8,
      "text": "Cool before slicing."
    }
  ],
