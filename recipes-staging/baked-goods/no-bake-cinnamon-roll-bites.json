  "id": "no-bake-cinnamon-roll-bites",
  "name": "No-Bake Cinnamon Roll Bites",
  "subtitle": "Soft bread spirals with cinnamon sugar and glaze",
  "description": "Flattened bread is spread with butter and cinnamon sugar, rolled, sliced, and finished with a simple confectioners’ sugar glaze.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "slices-white-bread",
      "item": "slices white bread",
      "quantity": 2,
      "preparation": "crusts removed"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cinnamon-sugar",
      "item": "cinnamon sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.125,
      "unit": "teaspoon",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Flatten each crustless bread slice with a rolling pin or the bottom of a glass."
    },
    {
      "step": 2,
      "text": "Spread the bread with butter, then sprinkle evenly with cinnamon sugar. Roll each slice tightly and cut into three pieces."
    },
    {
      "step": 3,
      "text": "Stir the confectioners' sugar with the water until smooth, adding only enough water to make a drizzleable glaze."
    },
    {
      "step": 4,
      "text": "Drizzle the glaze over the bread rolls and serve."
    }
  ],
