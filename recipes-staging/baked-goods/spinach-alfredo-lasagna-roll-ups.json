  "id": "spinach-alfredo-lasagna-roll-ups",
  "name": "Spinach Alfredo Lasagna Roll-Ups",
  "subtitle": "Creamy spinach-filled pasta baked with Alfredo sauce and mozzarella",
  "description": "Lasagna noodles are filled with a spinach, ricotta, Parmesan, and egg mixture, rolled, sauced, and baked until hot and set.",
  "meal_type": "baked-good",
  "cuisine": "Italian Inspired",
