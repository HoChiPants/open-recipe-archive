  "instructions": [
    {
      "step": 1,
      "text": "Bring salted water to a simmer. Add the lasagna noodles and cook for 10 minutes, or until pliable. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the olive oil and cook the spinach, green onion, and Alfredo-style pasta sauce until the vegetables are tender."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the ricotta, Parmesan, salt, egg, and half of the mozzarella."
    },
    {
      "step": 4,
      "text": "Preheat the oven to 375°F. Spread a layer of the spinach mixture over each noodle, then roll each noodle up."
    },
    {
      "step": 5,
      "text": "Spread some Alfredo sauce in a baking dish. Arrange the rolls seam-side down and cover with the remaining sauce and mozzarella."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until the cheese is melted and the center reaches 160°F or is fully set. Serve hot.",
      "timer_minutes": 30
    }
  ],
