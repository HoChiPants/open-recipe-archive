  "id": "butter-garlic-croutons",
  "name": "Butter Garlic Croutons",
  "subtitle": "Crisp, buttery bread cubes with savory garlic flavor",
  "description": "Bake seasoned bread cubes until golden and crunchy for salads, soups, or stuffing.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "slices-bread",
      "item": "slices bread",
      "quantity": 4
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet or saucepan over low heat."
    },
    {
      "step": 3,
      "text": "Cut the bread slices into cubes."
    },
    {
      "step": 4,
      "text": "Stir the garlic powder into the melted butter, then toss in the bread cubes until evenly coated."
    },
    {
      "step": 5,
      "text": "Transfer the coated bread cubes to a baking sheet and spread them in a single layer."
    },
    {
      "step": 6,
      "text": "Bake until crisp and lightly golden.",
      "timer_minutes": 10
    }
  ],
