  "id": "cloud-bread",
  "name": "Cloud Bread",
  "subtitle": "Light, airy rounds with a tender center",
  "description": "A simple baked bread alternative made by folding whipped egg whites into a smooth cream cheese mixture.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 17,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "separated"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Let the cream cheese cool for 5 minutes, then combine it with the egg yolks and mix until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the egg whites with the baking powder until stiff peaks form."
    },
    {
      "step": 4,
      "text": "Fold the whipped whites into the cream cheese mixture until just combined. Transfer the mixture to a lined baking sheet and portion into eight rounds."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, or until golden brown and the centers are firm and fully set; an egg-based center should reach 160°F.",
      "timer_minutes": 20
    }
  ],
