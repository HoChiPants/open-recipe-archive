{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "sweet-potato-rolls",
  "name": "Sweet Potato Rolls",
  "subtitle": "Soft, lightly sweet yeast rolls",
  "description": "Tender rolls made with sweet potato puree, eggs, and a short knead, then baked until lightly golden.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "canned-sweet-potato-puree",
      "item": "canned sweet potato puree",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the yeast, 1 tablespoon of the sugar, and the warm water together. Let stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mix in the remaining sugar, sweet potato puree, softened margarine, salt, and eggs."
    },
    {
      "step": 3,
      "text": "Stir in the flour until a dough forms, then knead for 3 minutes. Continue kneading until smooth.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Shape the dough into smooth rolls and lightly coat them with flour. Arrange them for rising."
    },
    {
      "step": 5,
      "text": "Let the shaped rolls rise for 60 minutes, then rest for 2 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Bake at 375°F for 20 minutes, until the rolls are set and lightly golden.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Serve warm."
    }
  ],
