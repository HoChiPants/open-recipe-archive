  "instructions": [
    {
      "step": 1,
      "text": "Stir the warm milk, warm water, yeast, and sugar together. Let stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the flour, olive oil, kosher salt, and sea salt. Mix to form a dough, adding flour as needed, then knead for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Shape the dough into a ball, cover, and let it rise until doubled, about 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Heat the oven to 475°F. Combine the feta, Monterey Jack, and mozzarella, then chill the mixture briefly."
    },
    {
      "step": 5,
      "text": "Divide the dough into 4 portions. On a floured surface, roll each into a thick oval. Transfer to a baking sheet and shape each oval into a boat with raised edges."
    },
    {
      "step": 6,
      "text": "Fill the centers with the cheese mixture and bake for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Make a well in each filling, add an egg, and return to the oven until the eggs are fully set, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 8,
      "text": "Top each bread with a butter pat, season with cayenne pepper and additional sea salt to taste, stir the butter into the hot filling, and serve."
    }
  ],
