  "id": "khachapuri",
  "name": "Khachapuri",
  "subtitle": "Georgian cheese bread with baked eggs",
  "description": "A boat-shaped yeast bread filled with a savory blend of cheeses and finished with eggs and butter.",
  "meal_type": "baked-good",
  "cuisine": "Georgian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20,
    "inactive_minutes": 65
  },
  "ingredients": [
