{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "batter-white-bread",
  "name": "Batter White Bread",
  "subtitle": "Soft homemade loaf with a tender crumb",
  "description": "A simple American yeast bread mixed as a batter, given two rises, and baked until golden.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 45,
    "inactive_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the warm water, shortening, sugar, salt, yeast, and sifted flour. Whisk for 3 minutes, then continue mixing until smooth.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Cover the mixture and let it rise in a warm place until doubled, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Prepare a loaf pan, then turn the risen dough into it and smooth the surface."
    },
    {
      "step": 4,
      "text": "Let the dough rise again for 30 minutes. Toward the end of this rise, heat the oven to 375°F.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Bake until golden brown, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Transfer the loaf from the pan and brush the top with melted butter."
    }
  ],
