  "id": "italian-flank-steak-rolls",
  "name": "Italian Flank Steak Rolls",
  "subtitle": "Thin steak rolled with parsley, Parmesan, garlic, and egg",
  "description": "Tender flank steak is filled, rolled, browned, and simmered in tomato sauce for a savory Italian-style dinner.",
