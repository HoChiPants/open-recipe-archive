  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large deep skillet over medium heat. Add the onion and cook, stirring, until tender.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Combine the salt, ground black pepper, parsley, Parmesan, garlic, chopped hard-boiled egg, and the pinch of salt and pepper."
    },
    {
      "step": 3,
      "text": "Brush the pounded flank steak with olive oil. Spread the filling over the steak, roll it tightly, and secure the rolls with toothpicks."
    },
    {
      "step": 4,
      "text": "Heat the remaining olive oil in the skillet and brown the steak rolls on all sides.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the tomato sauce, chopped tomato, and sugar. Cover and simmer until the rolls are cooked through and reach 145°F internally. Rest for 3 minutes before serving.",
      "timer_minutes": 67
    }
  ],
