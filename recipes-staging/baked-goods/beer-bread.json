  },
  "ingredients": [
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "or-bottle-beer",
      "item": "or bottle beer",
      "quantity": 1,
      "unit": "can",
      "preparation": "12 fluid ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a loaf pan."
    },
    {
      "step": 2,
      "text": "Mix the self-rising flour and white sugar in a bowl. Add the beer and stir just until the flour is incorporated."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and bake until set, about 50 minutes. Add the melted butter during the final 10 minutes of baking.",
      "timer_minutes": 50
    }
