  "id": "beer-bread",
  "name": "Beer Bread",
  "subtitle": "A quick, lightly sweet loaf with a crisp buttery top",
  "description": "Stir together a simple flour-and-beer batter, then bake it into a warm, tender loaf finished with melted butter.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
