  "id": "rhubarb-walnut-muffins",
  "name": "Rhubarb Walnut Muffins",
  "subtitle": "Tender muffins with tart rhubarb and a cinnamon finish",
  "description": "A simple American muffin recipe combining tangy rhubarb and chopped walnuts with a buttery cinnamon topping.",
  "meal_type": "baked-good",
