  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare muffin pans for 24 portions."
    },
    {
      "step": 2,
      "text": "Whisk the brown sugar, buttermilk, vegetable oil, egg, and vanilla extract until evenly blended."
    },
    {
      "step": 3,
      "text": "Combine the flour, baking soda, baking powder, and salt in a separate bowl. Fold in the diced rhubarb and chopped walnuts."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the wet mixture and stir just until no dry streaks remain."
    },
    {
      "step": 5,
      "text": "Mix the white sugar, melted butter, and cinnamon, then distribute the mixture over the batter."
    },
    {
      "step": 6,
      "text": "Bake until the muffins are set and a thermometer inserted in the center reads 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Transfer the muffins to a rack and let them cool before serving.",
      "timer_minutes": 10
    }
  ],
