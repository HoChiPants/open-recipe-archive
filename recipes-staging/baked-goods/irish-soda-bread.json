  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F and prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Whisk the all-purpose flour, whole wheat flour, rolled oats, salt, baking soda, and baking powder in a large bowl."
    },
    {
      "step": 3,
      "text": "Work the cold butter into the flour mixture with your fingers or a pastry cutter until coarse crumbs form."
    },
    {
      "step": 4,
      "text": "Whisk together the buttermilk, egg, honey, and orange zest. Add this mixture to the dry ingredients with the currants and golden raisins."
    },
    {
      "step": 5,
      "text": "Stir just until a shaggy dough forms, then turn it onto a lightly floured surface."
    },
    {
      "step": 6,
      "text": "Knead gently only until the dough holds together. Shape it into a smooth round loaf and place it on the baking sheet."
    },
    {
      "step": 7,
      "text": "Cut a shallow cross in the top of the loaf."
    },
    {
      "step": 8,
      "text": "Bake until golden brown and the center is fully set, about 45 minutes; if checked with a thermometer, the egg-containing center should reach 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 9,
      "text": "Transfer the loaf to a rack and let it cool before slicing.",
      "timer_minutes": 15
    }
  ],
