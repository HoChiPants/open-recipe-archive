  "id": "irish-soda-bread",
  "name": "Irish Soda Bread",
  "subtitle": "A rustic fruit-studded loaf with a tender crumb",
  "description": "A lightly sweetened soda bread combining whole grains, oats, citrus zest, and dried fruit in a quick, no-yeast loaf.",
  "meal_type": "baked-good",
  "cuisine": "Irish",
