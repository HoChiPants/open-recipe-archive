{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "quick-yeast-rolls",
  "name": "Quick Yeast Rolls",
  "subtitle": "Soft, lightly sweet rolls with a golden crust.",
  "description": "A simple yeast dough enriched with egg and shortening, shaped into rolls, and baked until set and golden.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "hot-water",
      "item": "hot water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the hot water, sugar, and shortening together. Let the mixture cool until warm, not hot."
    },
    {
      "step": 2,
      "text": "Mix in the yeast, flour, and salt until a soft dough forms. Cover and let rise for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Shape the dough into 8 rolls and arrange them in a baking pan. Cover and let rise for another 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Heat the oven to 425°F."
    },
    {
      "step": 5,
      "text": "Bake for about 10 minutes, until golden brown and the centers are fully set, reaching 160°F when checked with a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Serve warm."
    }
  ],
