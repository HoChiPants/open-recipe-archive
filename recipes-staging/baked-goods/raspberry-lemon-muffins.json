  "id": "raspberry-lemon-muffins",
  "name": "Raspberry Lemon Muffins",
  "subtitle": "Bright lemon muffins with tart raspberry pockets",
  "description": "Tender lemon muffins folded with frozen raspberries and finished with a light sugar topping.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "plain-yogurt",
      "item": "plain yogurt",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 2
    },
    {
      "ingredient_id": "lemon-extract",
      "item": "lemon extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "grated-lemon-zest",
      "item": "grated lemon zest",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "frozen-raspberries",
      "item": "frozen raspberries",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-sugar-for-decoration",
      "item": "white sugar for decoration",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F and prepare a 12-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Whisk the yogurt, oil, lemon juice, egg whites, lemon extract, and grated lemon zest together. In a separate bowl, stir the flour, white sugar, baking powder, and salt."
    },
    {
      "step": 3,
      "text": "Add the dry mixture to the yogurt mixture and stir just until combined. Fold in the frozen raspberries without overmixing."
    },
    {
      "step": 4,
      "text": "Divide the batter among the muffin cups and sprinkle with white sugar for decoration."
    },
    {
      "step": 5,
      "text": "Bake until lightly browned and the centers are firm and fully set; verify the center reaches 160°F with a food thermometer, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Cool the muffins before serving."
    }
  ],
