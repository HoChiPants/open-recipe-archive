{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "oat-bran-bread",
  "name": "Oat Bran Bread",
  "subtitle": "A lightly sweet, hearty loaf with oat bran",
  "description": "This simple yeast bread combines oat bran, honey, and bread flour for a tender loaf suitable for slicing and serving with meals or breakfast.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35,
    "inactive_minutes": 150
  },
  "ingredients": [
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "oat-bran",
      "item": "oat bran",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1.5,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the warm water, margarine, honey, flour, oat bran, salt, and yeast in a mixing bowl. Stir until a shaggy dough forms."
    },
    {
      "step": 2,
      "text": "Knead the dough until cohesive and smooth, then cover and let it rise until puffy, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Shape the dough into a loaf and place it in a greased loaf pan. Let it rise again until visibly expanded."
    },
    {
      "step": 4,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 5,
      "text": "Bake until the loaf is browned and sounds hollow when tapped, about 35 minutes. Cool before slicing.",
      "timer_minutes": 35
    }
  ],
