  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Melt the butter in a large skillet over medium heat. Add the onion, celery, baby carrots, and garlic; cook until tender."
    },
    {
      "step": 3,
      "text": "Combine the flour, sugar, salt, 1 teaspoon dried basil, and pepper. Stir the mixture into the vegetables."
    },
    {
      "step": 4,
      "text": "Gradually stir in the chicken broth. Simmer, stirring, until the sauce is combined and thickened.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the drained peas and diced cooked chicken, then transfer the filling to a baking dish.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Combine the buttermilk baking mix with 2 teaspoons dried basil. Stir in the milk to form a dough, then shape it into biscuits using the all-purpose flour as needed."
    },
    {
      "step": 7,
      "text": "Arrange the biscuits over the chicken mixture and bake until the topping is golden and the casserole reaches 165°F in the center.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Let stand briefly, then serve hot."
    }
  ],
