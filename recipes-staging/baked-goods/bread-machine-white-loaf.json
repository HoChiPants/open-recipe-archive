  "id": "bread-machine-white-loaf",
  "name": "Bread Machine White Loaf",
  "subtitle": "A simple sliced loaf for the bread machine",
  "description": "Combine the listed ingredients in the bread-machine pan, run a basic white-bread cycle, then cool and slice.",
  "meal_type": "baked-good",
  "yield": {
    "quantity": 1,
    "unit": "loaf (cuts into 10 slices)"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "caster-sugar-or-honey",
      "item": "caster sugar or honey",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "strong-white-bread-flour",
      "item": "strong white bread flour",
      "quantity": 350,
      "unit": "g"
    },
    {
      "ingredient_id": "fast-action-dried-yeast",
      "item": "fast-action dried yeast",
      "quantity": 1,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the olive oil and caster sugar or honey to the bread-machine pan."
    },
    {
      "step": 2,
      "text": "Add the strong white bread flour, then sprinkle the fast-action dried yeast over the top."
    },
    {
      "step": 3,
      "text": "Select the basic or white-bread cycle and let the machine bake until the loaf is set, about 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 4,
      "text": "Remove the loaf from the pan and cool it completely on a rack."
    },
    {
      "step": 5,
      "text": "Slice into 10 pieces and serve."
    }
  ],
