  "id": "rosemary-bread",
  "name": "Rosemary Bread",
  "subtitle": "A fragrant, herb-seasoned yeast loaf",
  "description": "A tender homemade loaf flavored with rosemary and Italian seasoning, finished with a golden crust.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
