  "instructions": [
    {
      "step": 1,
      "text": "Stir the white sugar into the warm water. Add the active dry yeast and stir to combine."
    },
    {
      "step": 2,
      "text": "Mix in the softened butter, rosemary, salt, and Italian seasoning. Stir in the bread flour until a dough forms."
    },
    {
      "step": 3,
      "text": "Transfer the dough to a lightly floured surface and knead until smooth, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Place the dough in an oiled bowl and turn it to coat. Cover and let rise until doubled, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Shape the risen dough and transfer it to a prepared baking pan. Add rosemary as directed by the shaping, cover, and let rise for another 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Preheat the oven to 375°F. Brush the dough with the beaten egg."
    },
    {
      "step": 7,
      "text": "Bake for about 20 minutes, until golden brown and the center is fully set; if checking with a thermometer, it should reach 160°F.",
      "timer_minutes": 20
    }
  ],
