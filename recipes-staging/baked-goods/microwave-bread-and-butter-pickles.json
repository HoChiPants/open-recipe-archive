      "item": "celery seed",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-turmeric",
      "item": "ground turmeric",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the cucumber, salt, onion, mustard seeds, sugar, vinegar, celery seed, and turmeric in a microwave-safe bowl. Mix well."
    },
    {
      "step": 2,
      "text": "Microwave the cucumber and onion mixture for 8 minutes, or until tender.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Transfer the pickles and liquid to a serving or storage container."
    },
    {
      "step": 4,
      "text": "Chill before serving."
    }
  ],
