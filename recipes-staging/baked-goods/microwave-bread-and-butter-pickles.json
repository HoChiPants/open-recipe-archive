  "id": "microwave-bread-and-butter-pickles",
  "name": "Microwave Bread and Butter Pickles",
  "subtitle": "Sweet-tangy cucumber pickles made in the microwave",
  "description": "Combine sliced cucumber and onion with a sweet, spiced vinegar mixture, microwave until tender, then chill before serving.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
