    {
      "ingredient_id": "cucumber",
      "item": "cucumber",
      "quantity": 1,
      "unit": "large",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "mustard-seeds",
      "item": "mustard seeds",
      "quantity": 0.5,
      "unit": "teaspoon"
