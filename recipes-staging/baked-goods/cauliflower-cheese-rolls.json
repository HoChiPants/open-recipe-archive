      "item": "sesame seeds",
      "quantity": "1/2",
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the cauliflower into small pieces and microwave for 5 minutes, or until tender.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Combine the milk, flour, and butter in a bowl or saucepan, then whisk until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the cauliflower, cheddar, and grated parmesan or vegetarian alternative. Set aside to cool."
    },
    {
      "step": 4,
      "text": "Preheat the oven and prepare a baking tray."
    },
    {
      "step": 5,
      "text": "Fold each filo sheet as needed to form a sturdy layer, keeping the pastry covered while working."
    },
    {
      "step": 6,
      "text": "Place some filling near one end of each sheet and roll or fold into a compact parcel."
    },
    {
      "step": 7,
      "text": "Melt the butter, brush the rolls, and arrange them on the tray."
    },
    {
      "step": 8,
      "text": "Top with za’atar and sesame seeds."
    },
    {
      "step": 9,
      "text": "Bake for 18 minutes, until the pastry is crisp and golden.",
      "timer_minutes": 18
    },
    {
      "step": 10,
      "text": "Serve warm."
    }
  ],
