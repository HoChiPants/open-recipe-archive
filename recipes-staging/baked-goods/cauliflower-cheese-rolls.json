  "id": "cauliflower-cheese-rolls",
  "name": "Cauliflower Cheese Rolls",
  "subtitle": "Crisp filo rolls with a creamy cauliflower and cheese filling",
  "description": "Tender cauliflower and cheese are enclosed in flaky filo pastry, topped with za’atar and sesame, and baked until golden.",
  "meal_type": "baked-good",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
