  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Cut the nectarines into large pieces. Toss them with the lemon juice, light brown soft sugar, cinnamon, and cornflour, then place them in a baking dish with the split vanilla pod."
    },
    {
      "step": 3,
      "text": "Roast until the fruit softens and releases its juices.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Arrange the halved scones over the fruit. Brush with melted salted butter and sprinkle with demerara sugar."
    },
    {
      "step": 5,
      "text": "Bake until the scones are golden and the fruit is bubbling.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Serve warm with clotted cream or vanilla ice cream."
    }
  ],
