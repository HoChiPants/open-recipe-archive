  "id": "nectarine-cobbler",
  "name": "Nectarine Cobbler",
  "subtitle": "Roasted nectarines under a quick scone topping",
  "description": "Tender roasted nectarines are finished with buttery scone halves and a crisp sugar topping, then served warm with cream or ice cream.",
  "meal_type": "baked-good",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
