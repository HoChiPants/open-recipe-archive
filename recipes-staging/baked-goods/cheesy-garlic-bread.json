  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Cut the French bread into thick slices."
    },
    {
      "step": 3,
      "text": "Stir together the softened butter, Parmesan cheese, garlic powder, and dried parsley."
    },
    {
      "step": 4,
      "text": "Spread the seasoned butter mixture over the bread slices and arrange them on a baking sheet."
    },
    {
      "step": 5,
