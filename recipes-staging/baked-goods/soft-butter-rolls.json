      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or more as needed, for dusting"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk for 1 minute, then stir in the butter, 1/4 cup sugar, and salt. Let the mixture cool until lukewarm.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Stir the yeast and 1 teaspoon sugar into the 110°F water. Let stand until foamy, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Combine the lukewarm milk mixture and yeast mixture. Add enough divided bread flour and the all-purpose flour to form a smooth, workable dough."
    },
    {
      "step": 4,
      "text": "Knead the dough until elastic, adding only enough remaining bread flour to prevent sticking. Shape it into a ball and coat the surface lightly."
    },
    {
      "step": 5,
      "text": "Place the dough in a prepared bowl, cover, and let rise until doubled, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Punch down the dough, divide it into 18 portions, and shape each into a roll. Arrange the rolls in a prepared baking pan, cover, and let rise for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Preheat the oven to 350°F. Brush the rolls with the beaten egg."
    },
    {
      "step": 8,
      "text": "Bake for 15 minutes, until golden and set. For food safety, the egg-containing rolls should reach at least 160°F internally.",
      "timer_minutes": 15
    }
  ],
