      "item": "active dry yeast",
      "quantity": 4.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 3.5,
      "unit": "cups",
      "preparation": "divided, or as needed"
