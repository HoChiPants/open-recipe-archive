    "prep_minutes": 20,
    "cook_minutes": 30,
    "inactive_minutes": 130
  },
  "ingredients": [
    {
      "ingredient_id": "unbleached-flour",
      "item": "unbleached flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "light-brown-sugar",
      "item": "light brown sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 1.3333300352097,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "cornmeal",
      "item": "cornmeal",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, brown sugar, salt, yeast, warm water, and olive oil. Mix until a dough forms, then knead until smooth and elastic."
    },
    {
      "step": 2,
      "text": "Cover the dough and let it rise in a warm place for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Punch down the dough, shape it into a loaf, and place it on a cornmeal-dusted peel or baking surface."
    },
    {
      "step": 4,
      "text": "Cover and let the shaped loaf rise for 40 minutes. Meanwhile, preheat the oven and pizza stone to 375°F.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Whisk the egg with the water. Brush the mixture over the loaf, then make shallow cuts across the top."
    },
    {
      "step": 6,
      "text": "Transfer the loaf to the preheated stone and bake until browned and the center reaches 160°F on a food thermometer, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Cool briefly before slicing."
    }
  ],
