  "id": "italian-bread-on-a-pizza-stone",
  "name": "Italian Bread on a Pizza Stone",
  "subtitle": "A rustic yeast loaf with a crisp, cornmeal-dusted base.",
  "description": "Mix, knead, proof, shape, and bake this simple Italian-style bread directly on a preheated pizza stone.",
  "meal_type": "baked-good",
  "cuisine": "Italian",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
