  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, yeast, and sugar. Add the beaten eggs and warm milk, then mix until a dough forms; rest briefly.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Work in the softened butter gradually and knead until the dough is smooth.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Shape the dough into a ball, cover, and leave until set and risen."
    },
    {
      "step": 4,
      "text": "Dust the work surface with flour. Divide and shape the dough into buns, arranging them in a wreath around the Camembert box."
    },
    {
      "step": 5,
      "text": "Cover the shaped wreath and leave it to rise until set.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Preheat the oven. Brush the buns with the beaten egg, keeping the Camembert in its wooden box."
    },
    {
      "step": 7,
      "text": "Mix the panko with the thyme leaves and scatter over the buns. Add the optional bay leaves if desired."
    },
    {
      "step": 8,
      "text": "Bake the wreath and Camembert until the bread is golden brown and the cheese is softened.",
      "timer_minutes": 30
    },
    {
      "step": 9,
      "text": "Cool briefly, then serve with cranberry sauce or chilli jam and the optional bay leaves.",
      "timer_minutes": 5
    }
  ],
