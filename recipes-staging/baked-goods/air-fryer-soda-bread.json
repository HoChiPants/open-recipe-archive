  "id": "air-fryer-soda-bread",
  "name": "Air Fryer Soda Bread",
  "subtitle": "A quick, lightly sweetened wholemeal loaf with an oat topping.",
  "description": "Mix a simple soda-bread dough, shape it into a round, and cook it in the air fryer until firm and baked through.",
  "meal_type": "baked-good",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "plain-flour-plus-extra-for-dusting",
      "item": "plain flour plus extra for dusting",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "wholemeal-flour",
      "item": "wholemeal flour",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "bicarbonate-of-soda",
      "item": "bicarbonate of soda",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "buttermilk-or-natural-yogurt",
      "item": "buttermilk or natural yogurt",
      "quantity": 225,
      "unit": "ml"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "porridge-oats",
      "item": "porridge oats",
      "quantity": 2,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to its bread or baking setting."
    },
    {
      "step": 2,
      "text": "Combine the plain flour, wholemeal flour, and bicarbonate of soda. In a separate bowl, mix the buttermilk or yogurt with the honey and milk."
    },
    {
      "step": 3,
      "text": "Add the wet mixture to the dry ingredients and stir just until a soft dough forms. Dust a work surface with some of the extra flour, turn out the dough, and shape it into a round."
    },
    {
      "step": 4,
      "text": "Cut a shallow cross across the top. Brush with the milk and sprinkle over the porridge oats."
    },
    {
      "step": 5,
      "text": "Place the dough in the air fryer and cook until the loaf is firm and baked through.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Cool for 3 minutes before slicing.",
      "timer_minutes": 3
    }
  ],
