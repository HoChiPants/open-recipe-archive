  "id": "mexican-style-monkey-bread",
  "name": "Mexican-Style Monkey Bread",
  "subtitle": "Pull-apart biscuit bread with cheddar, mozzarella, and jalapeño",
  "description": "Buttery biscuit pieces layered with melted cheese, jalapeños, and parsley, then baked until golden.",
  "meal_type": "baked-good",
