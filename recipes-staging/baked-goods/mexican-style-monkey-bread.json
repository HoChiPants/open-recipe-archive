    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Coat the baking pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Toss the quartered biscuit dough with the melted butter until coated."
    },
    {
      "step": 3,
      "text": "Arrange part of the dough in the prepared pan. Layer with portions of the Cheddar, jalapeños, and parsley, then repeat with the remaining dough and divided ingredients."
    },
    {
      "step": 4,
      "text": "Combine the remaining Cheddar and mozzarella, and scatter the mixture over the top."
    },
    {
      "step": 5,
      "text": "Bake until golden brown, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Let cool for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
