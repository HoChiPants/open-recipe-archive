  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the baking powder to distribute it evenly."
    },
    {
      "step": 3,
      "text": "Combine the flour, cornmeal, milk, bananas, sugar, oil, baking powder, and salt; mix until smooth."
    },
    {
      "step": 4,
      "text": "Transfer the batter to a suitable baking pan."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until set and lightly browned.",
