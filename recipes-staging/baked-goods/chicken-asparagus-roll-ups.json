  "id": "chicken-asparagus-roll-ups",
  "name": "Chicken Asparagus Roll-Ups",
  "subtitle": "Tender chicken with asparagus, provolone, and lemon-tarragon coating",
  "description": "Chicken breasts are filled with tender asparagus and provolone, then finished with a creamy lemon-mustard spread and crisp panko before baking.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
