  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 475°F."
    },
    {
      "step": 2,
      "text": "Stir together the mayonnaise, Dijon mustard, lemon juice and zest, tarragon, pepper, and salt. Set the mixture aside."
    },
    {
      "step": 3,
      "text": "Place the asparagus in a microwave-safe dish and microwave for 2 minutes, until tender. Let it cool enough to handle.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Flatten the chicken breast halves to an even thickness. Spread each with some of the mayonnaise mixture, then top with one cheese slice and four asparagus spears. Roll up and secure as needed."
    },
    {
      "step": 5,
      "text": "Coat the roll-ups with the remaining mayonnaise mixture, then cover them with panko bread crumbs."
    },
    {
      "step": 6,
      "text": "Arrange the roll-ups in a baking dish and bake for 25 minutes, until the chicken reaches 165°F in the thickest part.",
      "timer_minutes": 25
    }
  ],
