  "id": "bread-machine-pizza-dough",
  "name": "Bread Machine Pizza Dough",
  "subtitle": "Beer-enriched dough for a crisp, lightly browned crust",
  "description": "Prepare the dough in a bread machine, shape it into a pizza crust, brush with olive oil, and bake until lightly browned.",
  "meal_type": "baked-good",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "flat-beer",
      "item": "flat beer",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "yeast",
      "item": "yeast",
      "quantity": 2.25,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "for brushing"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the beer, butter, sugar, salt, flour, and yeast to the bread-machine pan in that order."
    },
    {
      "step": 2,
      "text": "Run the machine's dough cycle, allowing the dough to knead and rise."
    },
    {
      "step": 3,
      "text": "Remove the dough and shape it into a pizza crust on a baking pan."
    },
    {
      "step": 4,
      "text": "Brush the surface with the olive oil and let the shaped dough rest for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 6,
      "text": "Add desired pizza toppings if using."
    },
    {
      "step": 7,
      "text": "Bake for 24 minutes, or until lightly browned.",
      "timer_minutes": 24
    }
  ],
