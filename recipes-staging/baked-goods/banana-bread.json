  "id": "banana-bread",
  "name": "Banana Bread",
  "subtitle": "Moist spiced loaf with browned butter",
  "description": "A tender banana loaf made with very ripe bananas, warm spices, and nutty browned butter.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
