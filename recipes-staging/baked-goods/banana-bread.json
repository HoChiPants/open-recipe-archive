  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a loaf pan."
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan, then simmer it with the brown sugar for 10 minutes. Remove from the heat and let it cool for 15 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Mash the bananas in a mixing bowl. Stir in the cooled butter mixture, white sugar, egg, and vanilla."
    },
    {
      "step": 4,
      "text": "Whisk together the flour, baking soda, cinnamon, and nutmeg. Fold the dry mixture into the banana mixture just until combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 45 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Cool before slicing and serving."
    }
  ],
