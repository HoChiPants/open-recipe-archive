{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "norwegian-potato-flatbread-lefse",
  "name": "Norwegian Potato Flatbread (Lefse)",
  "subtitle": "Tender skillet-cooked flatbread made with baked potato",
  "description": "A simple Scandinavian flatbread with a soft potato-based dough, lightly sweetened and cooked until golden.",
  "meal_type": "baked-good",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 95,
    "inactive_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "russet-potato",
      "item": "russet potato",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Bake the potato until tender, about 60 minutes. Let it cool until set, then peel and mash it.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "While the potato is still warm, mix in the butter until smooth. Whisk together the cream, salt, and sugar, then stir the mixture into the potato."
    },
    {
      "step": 4,
      "text": "Stir in the flour to form a soft dough. Shape it into a log, cover, and chill for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Divide the chilled dough into 8 portions and chill them for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "On a lightly floured surface, roll each portion into a thick round."
    },
    {
      "step": 7,
      "text": "Preheat a griddle and lightly grease it with butter. Cook the rounds until golden brown, about 3 minutes, turning as needed.",
      "timer_minutes": 3
    },
    {
      "step": 8,
      "text": "Transfer the flatbreads to a plate and serve."
    }
  ],
