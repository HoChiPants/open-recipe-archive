{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "buttermilk-bread",
  "name": "Buttermilk Bread",
  "subtitle": "Soft yeast bread with a tender crumb",
  "description": "A lightly sweet buttermilk yeast bread shaped into individual portions and baked until golden.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35,
    "inactive_minutes": 125
  },
  "ingredients": [
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 2,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 5.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Dissolve the active dry yeast in the warm water and let it stand until foamy, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Warm the buttermilk and margarine together until the margarine melts. Let the mixture cool until warm, not hot."
    },
    {
      "step": 3,
      "text": "Stir the buttermilk mixture, sugar, baking soda, yeast mixture, and salt together."
    },
    {
      "step": 4,
      "text": "Add the bread flour gradually, mixing until a soft dough forms."
    },
    {
      "step": 5,
      "text": "Turn the dough onto a floured surface and knead until smooth."
    },
    {
      "step": 6,
      "text": "Place the dough in a greased bowl, cover, and let it rise until doubled."
    },
    {
      "step": 7,
      "text": "Punch down the dough, divide it into 24 portions, and shape each into a ball."
    },
    {
      "step": 8,
      "text": "Arrange the portions in greased baking pans, cover, and let them rise again until puffy."
    },
    {
      "step": 9,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 10,
      "text": "Bake until the loaves are golden brown, about 35 minutes.",
      "timer_minutes": 35
    }
  ],
