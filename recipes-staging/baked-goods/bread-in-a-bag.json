{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "bread-in-a-bag",
  "name": "Bread in a Bag",
  "subtitle": "A simple yeast loaf mixed and kneaded in a bag",
  "description": "Prepare this soft homemade loaf with a bag-based mixing and kneading method, followed by a short rise and oven bake.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 35,
    "inactive_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "warm-water",
      "item": "warm water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "rapid-rise-yeast",
      "item": "rapid rise yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "non-fat-dry-milk",
      "item": "non-fat dry milk",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place a portion of the divided flour in a large resealable bag with the warm water, sugar, and yeast. Seal, leaving room for expansion, and knead or squeeze until combined."
    },
    {
      "step": 2,
      "text": "Let the mixture stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the remaining flour, dry milk, olive oil, and salt. Seal the bag and mix until a shaggy dough forms."
    },
    {
      "step": 4,
      "text": "Turn the dough onto a lightly floured surface and knead until smooth, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Shape the dough into a loaf and place it in a prepared loaf pan. Cover and let rise for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 7,
      "text": "Bake for 35 minutes, until golden brown. Cool briefly before slicing.",
      "timer_minutes": 35
    }
  ],
