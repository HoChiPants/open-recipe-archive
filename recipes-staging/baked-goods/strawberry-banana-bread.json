  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat a loaf pan with nonstick cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking soda, cinnamon, and salt together in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the sugar and softened butter until blended. Add the sour cream, eggs, and vanilla, then mix in the mashed bananas."
    },
    {
      "step": 4,
      "text": "Fold the dry ingredients into the banana mixture just until combined, then fold in the strawberries and nuts."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 65 minutes, or until golden brown and a thermometer inserted in the center reads at least 160°F.",
      "timer_minutes": 65
    },
    {
      "step": 6,
      "text": "Cool the loaf before slicing and serving."
    }
  ],
