  "id": "strawberry-banana-bread",
  "name": "Strawberry Banana Bread",
  "subtitle": "A tender quick bread with mashed banana, strawberries, and chopped nuts.",
  "description": "This fruit-filled loaf combines ripe bananas, diced strawberries, and nuts in a lightly spiced sour-cream batter.",
  "meal_type": "baked-good",
