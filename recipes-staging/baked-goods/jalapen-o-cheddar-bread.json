{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "jalapen-o-cheddar-bread",
  "name": "Jalapeño Cheddar Bread",
  "subtitle": "A savory yeast bread with sharp cheese and fresh chile heat.",
  "description": "This tender, savory loaf combines shredded Cheddar and minced jalapeños in a lightly sweet yeast dough.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 8,
      "unit": "cups"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 4,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "jalapeno-peppers",
      "item": "jalapeno peppers",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "minced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "hot-water",
      "item": "hot water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 3,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 4,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, Cheddar, jalapeños, 1/2 cup sugar, and salt in a large bowl."
    },
    {
      "step": 2,
      "text": "Stir the remaining sugar, hot water, and yeast together. Let stand until the yeast softens and begins to foam.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir the yeast mixture and vegetable oil into the dry ingredients, adding the flour mixture gradually until a dough forms."
    },
    {
      "step": 4,
      "text": "Knead the dough until smooth.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Transfer the dough to an oiled bowl, cover, and let rise in a warm 100°F place until doubled.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Prepare the baking pans. Divide the dough, shape it into smooth loaves, and place them in the pans."
    },
    {
      "step": 7,
      "text": "Let the shaped dough rise until puffy.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Bake at 325°F until the loaves are golden and baked through.",
      "timer_minutes": 60
    },
    {
      "step": 9,
      "text": "Let the loaves rest in the pans briefly, then transfer them to a rack.",
      "timer_minutes": 10
    },
    {
      "step": 10,
      "text": "Cool completely before slicing.",
      "timer_minutes": 60
    }
  ],
