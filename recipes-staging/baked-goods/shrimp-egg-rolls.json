  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a skillet. Add the beaten egg and cook until set, about 2 minutes. Cut the egg into small pieces.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Combine the cabbage, bean sprouts, carrot, celery, and onion. Stir in the shrimp, soy sauce, garlic powder, and black pepper."
    },
    {
      "step": 3,
      "text": "Add the mixture to the skillet and cook until the vegetables soften, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the cornstarch. Combine the cornstarch and cold water, then add the slurry and cook until the filling thickens and is set.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Let the filling cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Place filling on the egg roll wrappers. Fold in the sides and roll tightly, sealing the edges with the prepared cornstarch mixture."
    },
    {
      "step": 7,
      "text": "Heat the vegetable oil for frying to 350°F."
    },
    {
      "step": 8,
      "text": "Fry the egg rolls in batches for about 4 minutes, turning as needed, until golden brown and the filling reaches 160°F with the egg fully set; the shrimp should be opaque.",
      "timer_minutes": 4
    },
    {
      "step": 9,
      "text": "Drain the egg rolls before serving."
    }
  ],
