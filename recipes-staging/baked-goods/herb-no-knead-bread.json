  "id": "herb-no-knead-bread",
  "name": "Herb No-Knead Bread",
  "subtitle": "A slow-risen loaf with fresh garden herbs",
  "description": "Mix the dough, let it rise slowly, shape it gently, and bake it in a covered pot for a crisp, golden crust.",
  "meal_type": "baked-good",
  "cuisine": "French Inspired",
  "yield": {
    "quantity": 6,
