  "instructions": [
    {
      "step": 1,
      "text": "Stir the flour, yeast, salt, rosemary, thyme, and sage together in a large bowl. Add the warm water and mix until a shaggy, sticky dough forms."
    },
    {
      "step": 2,
      "text": "Cover the bowl and leave the dough at room temperature until doubled and set, about 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 3,
      "text": "Dust a work surface and your hands with flour. Turn out the dough, fold it over itself a few times, and shape it into a round loaf."
    },
    {
      "step": 4,
      "text": "Place the loaf on a floured sheet of parchment and let it rest while the oven heats to 450°F. Preheat a covered Dutch oven or other heavy oven-safe pot."
    },
    {
      "step": 5,
      "text": "Using the parchment, lower the dough into the hot pot. Cover and bake for 30 minutes, then uncover and continue baking for about 20 minutes, until golden brown.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Transfer the loaf to a rack and cool before slicing."
    }
  ],
