  "id": "cheddar-harissa-garlic-bread",
  "name": "Cheddar Harissa Garlic Bread",
  "subtitle": "A spicy, cheesy pull-apart loaf",
  "description": "Softened butter blended with harissa and garlic coats a loaf before it is finished with melted cheddar and mozzarella.",
  "meal_type": "baked-good",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "loaf-of-white-bread-a-sourdough-boule-works-well",
      "item": "loaf of white bread (a sourdough boule works well)",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "salted-butter-softened",
      "item": "salted butter softened",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "harissa-depending-on-how-spicy-you-like-it",
      "item": "harissa (depending on how spicy you like it)",
      "quantity": "2-3",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-cloves-grated",
      "item": "garlic cloves grated",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "mature-cheddar-coarsely-grated",
      "item": "mature cheddar coarsely grated",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "grated-mozzarella",
      "item": "grated mozzarella",
      "quantity": 75,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Cut the loaf into thick slices, leaving the base intact so it can be pulled apart."
    },
    {
      "step": 3,
      "text": "Whisk the softened butter, harissa, and grated garlic until combined."
    },
    {
      "step": 4,
      "text": "Work the butter mixture into the cuts and over the surface of the loaf."
    },
    {
      "step": 5,
      "text": "Add the cheddar and mozzarella over and between the slices."
    },
    {
      "step": 6,
      "text": "Bake until the cheese is melted, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Serve warm."
    }
  ],
