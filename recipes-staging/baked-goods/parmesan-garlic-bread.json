  "id": "parmesan-garlic-bread",
  "name": "Parmesan Garlic Bread",
  "subtitle": "Herb-seasoned bread with a crisp cheese topping",
  "description": "Melted butter, garlic, herbs, and Parmesan turn a loaf of French bread into a savory baked side or snack.",
  "meal_type": "baked-good",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-rosemary",
      "item": "dried rosemary",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "1-pound-loaf-french-bread",
      "item": "(1 pound) loaf French bread",
      "quantity": 1,
      "preparation": "halved lengthwise"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Stir the melted butter with the garlic salt, rosemary, basil, thyme, garlic powder, and 1 tablespoon Parmesan."
    },
    {
      "step": 3,
      "text": "Place the bread halves cut-side up on a baking sheet and spread them evenly with the seasoned butter."
    },
    {
      "step": 4,
      "text": "Sprinkle the remaining grated Parmesan over the bread."
    },
    {
      "step": 5,
      "text": "Bake until lightly browned, about 12 minutes.",
      "timer_minutes": 12
    }
  ],
