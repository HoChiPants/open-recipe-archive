  "id": "maple-walnut-muffins",
  "name": "Maple Walnut Muffins",
  "subtitle": "Tender muffins with maple sweetness and a crisp walnut finish",
  "description": "A simple American muffin batter enriched with butter, brown sugar, maple syrup, milk, and chopped walnuts.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "real-maple-syrup",
      "item": "real maple syrup",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Prepare a 12-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, and salt together in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the softened butter and brown sugar until combined. Stir in the maple syrup and eggs, then whisk until smooth."
    },
    {
      "step": 4,
      "text": "Add the dry ingredients and milk to the wet mixture, alternating between them, and stir just until combined. Fold in the walnuts."
    },
    {
      "step": 5,
      "text": "Divide the batter among the muffin cups."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, until the muffins are set and lightly browned.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Cool the muffins before serving."
    }
  ],
