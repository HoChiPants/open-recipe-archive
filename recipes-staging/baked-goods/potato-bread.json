{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "potato-bread",
  "name": "Potato Bread",
  "subtitle": "A crisp-crusted loaf with a tender potato-rich crumb",
  "description": "A simple yeast bread made with potato flakes, butter, and bread flour, baked until deeply golden and crusty.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 3.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "instant-mashed-potato-flakes",
      "item": "instant mashed potato flakes",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "instant-yeast",
      "item": "instant yeast",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the bread flour, potato flakes, sugar, salt, and instant yeast in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the water and butter, then mix until a shaggy dough forms."
    },
    {
      "step": 3,
      "text": "Knead until the dough is smooth and elastic, then shape it into a loaf and place it in a greased pan."
    },
    {
      "step": 4,
      "text": "Bake in a preheated oven until the loaf is fully risen, deeply browned, and sounds hollow when tapped, allowing up to 180 minutes.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Cool briefly before slicing."
    }
  ],
