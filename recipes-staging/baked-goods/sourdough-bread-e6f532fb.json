  "id": "sourdough-bread-e6f532fb",
  "name": "Sourdough Bread",
  "subtitle": "Tender, lightly sweet bread with a crisp golden crust",
  "description": "A soft sourdough loaf enriched with milk, margarine, and egg, finished with chopped onion and baked until golden and fully set.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 30,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 4.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
