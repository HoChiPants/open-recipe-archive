      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, sugar, salt, yeast, and egg in a large bowl. Add the warm milk and softened margarine, then stir in the sourdough starter."
    },
    {
      "step": 2,
      "text": "Mix in the remaining flour as needed to form a workable dough. Knead for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Transfer the dough to a bowl, cover, and let it rise for 60 minutes. Prepare the baking pan, then let the dough rest for 15 minutes.",
      "timer_minutes": 75
    },
    {
      "step": 4,
      "text": "Shape the dough and transfer it to the prepared pan. Let it rise for another 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Heat the oven to 375°F. Stir the water and chopped onion together, then spread the mixture over the dough."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until golden brown and the center is fully set. Confirm with a thermometer that the bread reaches at least 190°F; this also exceeds the 160°F safe endpoint for the egg.",
      "timer_minutes": 30
    }
  ],
