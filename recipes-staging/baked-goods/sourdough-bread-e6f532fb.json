      "item": "warm milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sourdough-starter",
      "item": "sourdough starter",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
