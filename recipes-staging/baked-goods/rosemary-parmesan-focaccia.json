  "id": "rosemary-parmesan-focaccia",
  "name": "Rosemary Parmesan Focaccia",
  "subtitle": "A fragrant, chewy Italian bread with onion and a crisp, savory topping.",
  "description": "Mix a yeast dough with diced onion, olive oil, and salt, let it rise, then bake it with Parmesan and rosemary until golden brown.",
  "meal_type": "baked-good",
