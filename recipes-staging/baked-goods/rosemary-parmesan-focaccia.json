  "instructions": [
    {
      "step": 1,
      "text": "Stir the honey into the warm water, add the yeast, and let it stand until the yeast is hydrated."
    },
    {
      "step": 2,
      "text": "Mix in the onion, olive oil, salt, and enough flour to form a soft dough."
    },
    {
      "step": 3,
      "text": "Turn the dough onto a lightly floured surface and knead until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Coat the dough lightly with oil, place it in a prepared baking pan, and let it rise until puffy.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Heat the oven to 415°F."
    },
    {
      "step": 6,
      "text": "Stretch the dough evenly in the pan and make shallow dimples across the surface."
    },
    {
      "step": 7,
      "text": "Top with olive oil, kosher salt, Parmesan, and rosemary, then let the dough rest briefly.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Bake until golden brown.",
      "timer_minutes": 20
    }
  ],
