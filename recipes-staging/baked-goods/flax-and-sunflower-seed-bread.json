  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, softened butter, and honey. In a separate bowl, mix the bread flour, whole wheat bread flour, salt, and yeast."
    },
    {
      "step": 2,
      "text": "Stir the wet and dry mixtures together to form a dough. Knead until smooth, then work in the flax seeds and sunflower seeds."
    },
    {
      "step": 3,
      "text": "Cover the dough and let it rise until doubled in size.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Shape the dough into a loaf and place it in a greased loaf pan. Cover and let it rise until puffy.",
      "timer_minutes": 50
    },
    {
      "step": 5,
      "text": "Bake until the loaf is browned and sounds hollow when tapped.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool before slicing.",
      "timer_minutes": 30
    }
  ],
