  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a loaf pan for the batter."
    },
    {
      "step": 2,
      "text": "Mash part of the bananas and reserve the remaining bananas for folding in later."
    },
    {
      "step": 3,
      "text": "Whisk the mashed bananas, 1 cup sugar, and sour cream for 3 minutes. Whisk in the cooled butter, eggs, and vanilla.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "In a separate bowl, whisk together the flour, baking powder, and salt. Fold the dry mixture into the wet mixture just until combined, then fold in the reserved bananas and walnuts."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan."
    },
    {
      "step": 6,
      "text": "Stir 2 teaspoons sugar with the cinnamon, then sprinkle the mixture over the batter."
    },
    {
      "step": 7,
      "text": "Bake until golden brown, about 60 minutes; continue baking as needed to reach the stated 75-minute cook time.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Cool in the pan for 10 minutes, then let the loaf cool further before slicing.",
      "timer_minutes": 10
    }
  ],
