  "id": "sour-cream-banana-bread",
  "name": "Sour Cream Banana Bread",
  "subtitle": "Moist banana loaf with a cinnamon-walnut topping",
  "description": "A tender quick bread made with ripe bananas, sour cream, and chopped walnuts, finished with a lightly spiced sugar crust.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
