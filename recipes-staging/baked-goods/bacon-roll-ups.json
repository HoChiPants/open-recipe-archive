  "id": "bacon-roll-ups",
  "name": "Bacon Roll-Ups",
  "subtitle": "Creamy cheese and bacon wrapped around trimmed bread",
  "description": "Spread softened cream cheese on trimmed bread, roll it with bacon, and bake until lightly browned.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "1-pound-loaf-white-bread",
      "item": "(1 pound) loaf white bread",
      "quantity": 1,
      "preparation": "crusts trimmed"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "pound",
      "preparation": "sliced, cut in half"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cut the crusts from the bread and flatten or trim the slices as needed for rolling."
    },
    {
      "step": 3,
      "text": "Whisk the softened cream cheese until smooth, then spread it over the bread."
    },
    {
      "step": 4,
      "text": "Roll each bread slice tightly and wrap it with a half-slice of bacon. Arrange the roll-ups seam-side down on a baking sheet."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, or until the bacon and bread are lightly browned.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Serve warm."
    }
  ],
