  "id": "panettone-bread",
  "name": "Panettone Bread",
  "subtitle": "A tender Italian fruit-studded sweet bread",
  "description": "Enriched yeast dough with yogurt, citrus zest, currants, and raisins, finished with melted butter and confectioners' sugar.",
  "meal_type": "baked-good",
  "cuisine": "Italian",
