  "instructions": [
    {
      "step": 1,
      "text": "Combine the yeast, warm water, white sugar, and confectioners' sugar. Let stand until foamy, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Mix in the eggs, yogurt, vanilla, lemon zest, and salt."
    },
    {
      "step": 3,
      "text": "Stir in the flour to form a soft dough, then knead until smooth and elastic, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Transfer the dough to a lightly greased bowl, cover, and let rise until doubled, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 6,
      "text": "Knead in the currants and raisins, shape the dough, and place it in a suitable baking pan. Let rise for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Brush the dough with melted butter and bake at 350°F until golden brown, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Cool before serving."
    }
  ],
