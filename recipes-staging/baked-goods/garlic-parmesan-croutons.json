  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "finely minced"
    },
    {
      "ingredient_id": "8-ounce-loaf-french-bread-baguette",
      "item": "(8 ounce) loaf French bread baguette",
      "quantity": 1,
      "preparation": "cut into 1/2-inch cubes"
    },
    {
      "ingredient_id": "finely-grated-parmigiano-reggiano-cheese",
      "item": "finely grated Parmigiano-Reggiano cheese",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "italian-seasoning",
      "item": "Italian seasoning",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the olive oil and garlic together; let the mixture stand for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 2,
      "text": "Heat the oven to 300°F and prepare a baking sheet."
    },
    {
      "step": 3,
      "text": "Toss the bread cubes with the garlic oil until evenly coated. Add the Italian seasoning, paprika, black pepper, salt, cayenne, and part of the divided Parmesan; toss again."
    },
    {
      "step": 4,
      "text": "Spread the coated bread cubes in an even layer on the baking sheet."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, then turn the cubes and bake for 15 minutes more.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Sprinkle with the remaining Parmesan and let stand for 15 minutes, until the cheese is melted.",
      "timer_minutes": 15
    }
  ],
