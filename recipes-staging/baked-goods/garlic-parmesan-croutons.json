  "id": "garlic-parmesan-croutons",
  "name": "Garlic Parmesan Croutons",
  "subtitle": "Crisp, seasoned bread cubes for salads and soups",
  "description": "French bread cubes are infused with garlic oil, coated with herbs, spices, and Parmesan, then baked until crisp and golden.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
