{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-panettone",
  "name": "Chocolate Panettone",
  "subtitle": "A tall Italian sweet bread with dark chocolate and almonds",
  "description": "Make a soft enriched yeast dough, fold in dark chocolate, then top and bake until risen and fully cooked.",
  "meal_type": "baked-good",
  "cuisine": "Italian",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "sachet-fast-action-dried-yeast",
      "item": "sachet fast-action dried yeast",
      "quantity": 7,
      "unit": "g"
    },
    {
      "ingredient_id": "whole-milk-warmed-to-37c",
      "item": "whole milk warmed to 37C",
      "quantity": 160,
      "unit": "ml"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "eggs-beaten",
      "item": "eggs beaten",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "marsala-or-sherry",
      "item": "marsala or sherry",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vanilla-extract-or-paste",
      "item": "vanilla extract or paste",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "strong-white-bread-flour",
      "item": "strong white bread flour",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "vegetable-oil-for-drizzling",
      "item": "vegetable oil for drizzling"
    },
    {
      "ingredient_id": "dark-chocolate-chunks",
      "item": "dark chocolate chunks",
      "quantity": 120,
      "unit": "g"
    },
    {
      "ingredient_id": "flaked-almonds",
      "item": "flaked almonds",
      "quantity": 20
    },
    {
      "ingredient_id": "pearl-sugar-optional",
      "item": "pearl sugar (optional)",
      "quantity": "1 1/2",
      "unit": "tbsp",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the yeast into the warm milk and leave briefly to activate. Mix the sugar, beaten eggs, Marsala or sherry, and vanilla separately."
    },
    {
      "step": 2,
      "text": "Place the flour in a large bowl. Add the milk mixture and the egg mixture, then combine to form a dough."
    },
    {
      "step": 3,
      "text": "Drizzle with the vegetable oil and knead until smooth and elastic.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Cover the dough and let it rise until doubled in size.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Fold in the dark chocolate chunks, shape the dough into a round, and place it in a suitable panettone mold or deep lined tin."
    },
    {
      "step": 6,
      "text": "Cover and leave to rise again while the oven heats.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Preheat the oven. Scatter the flaked almonds, caster sugar, and optional pearl sugar over the dough."
    },
    {
      "step": 8,
      "text": "Bake until deeply risen and golden, and the center is fully cooked; a thermometer should read at least 190°F for this enriched bread.",
      "timer_minutes": 55
    },
    {
      "step": 9,
      "text": "Cool before serving."
    }
  ],
