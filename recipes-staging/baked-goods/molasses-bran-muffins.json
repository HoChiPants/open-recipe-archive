  "id": "molasses-bran-muffins",
  "name": "Molasses Bran Muffins",
  "subtitle": "Tender bran muffins with molasses and raisins",
  "description": "A simple batch of lightly sweet bran muffins with rich molasses flavor and chewy raisins.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "skim-milk",
      "item": "skim milk",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "molasses",
      "item": "molasses",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "bran-flakes-cereal",
      "item": "bran flakes cereal",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F and prepare a 12-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking soda, and salt together in a bowl."
    },
    {
      "step": 3,
      "text": "Combine the milk, molasses, beaten egg, and oil. Stir in the bran flakes cereal."
    },
    {
      "step": 4,
      "text": "Add the dry ingredients and raisins to the bran mixture, stirring just until combined."
    },
    {
      "step": 5,
      "text": "Divide the batter among the muffin cups."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, until the muffins are set in the center and an inserted thermometer reads at least 160°F.",
      "timer_minutes": 20
    }
  ],
