  "id": "dark-chocolate-marble-banana-bread",
  "name": "Dark Chocolate Marble Banana Bread",
  "subtitle": "Moist banana bread with cocoa swirls",
  "description": "A tender banana loaf combining yogurt, melted butter, and cocoa for a marbled chocolate finish.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "hot-water",
      "item": "hot water",
      "quantity": 5,
      "unit": "tablespoons"
    },
    {
