      "item": "cocoa powder",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "overripe-bananas",
      "item": "overripe bananas",
      "quantity": 2,
      "unit": "large",
      "preparation": "mashed"
    },
    {
      "ingredient_id": "greek-yogurt",
      "item": "Greek yogurt",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a loaf pan for baking."
    },
    {
      "step": 2,
      "text": "Stir the flour, baking soda, and salt together in one bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the hot water and cocoa powder until smooth."
    },
    {
      "step": 4,
      "text": "Mix the mashed bananas, Greek yogurt, melted butter, brown sugar, beaten eggs, and vanilla extract until evenly blended."
    },
    {
      "step": 5,
      "text": "Add the dry mixture to the banana mixture and fold just until combined."
    },
    {
      "step": 6,
      "text": "Transfer about half of the batter to the cocoa mixture and stir until combined."
    },
    {
      "step": 7,
      "text": "Alternate spoonfuls of plain and chocolate batter in the prepared pan, then gently swirl the two batters together."
    },
    {
      "step": 8,
      "text": "Bake for 55 minutes, until the loaf is set in the center and a tester comes out clean or with a few moist crumbs.",
      "timer_minutes": 55
    }
  ],
