  "id": "rosemary-pull-apart-dinner-rolls",
  "name": "Rosemary Pull-Apart Dinner Rolls",
  "subtitle": "Soft herb rolls for sharing",
  "description": "Tender yeast rolls flavored with fresh rosemary, shaped together for easy pull-apart serving.",
  "meal_type": "baked-good",
  "cuisine": "American",
