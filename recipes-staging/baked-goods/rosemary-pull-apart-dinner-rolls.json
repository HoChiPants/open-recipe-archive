  "instructions": [
    {
      "step": 1,
      "text": "Dissolve the yeast in the warm water and let it stand until set, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Warm the milk with the butter until the butter melts, about 4 minutes. Let the mixture cool slightly.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Combine the yeast mixture, milk mixture, 2 cups flour, honey, salt, and rosemary. Stir in the remaining flour as needed until a firm dough forms."
    },
    {
      "step": 4,
      "text": "Knead the dough for 6 minutes, then coat it with olive oil. Cover and let it rise in a warm place until doubled, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Heat the oven to 375°F. Prepare a baking pan."
    },
    {
      "step": 6,
      "text": "Shape the dough into a thick round, cut it into portions, and form each portion into a smooth ball. Arrange the balls together in the pan."
    },
    {
      "step": 7,
      "text": "Whisk the egg with 1 teaspoon milk. Brush the rolls with the egg mixture and sprinkle with coarse sea salt."
    },
    {
      "step": 8,
      "text": "Let the shaped rolls rest for 30 minutes, then bake until golden brown and the center reaches 160°F or is firm and fully set.",
      "timer_minutes": 30
    }
  ],
