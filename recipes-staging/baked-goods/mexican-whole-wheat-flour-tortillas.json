{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "mexican-whole-wheat-flour-tortillas",
  "name": "Mexican Whole Wheat Flour Tortillas",
  "subtitle": "Soft whole-wheat tortillas made on a hot skillet",
  "description": "A simple dough of whole wheat flour, shortening, salt, and boiling water rolled thin and cooked quickly for homemade tortillas.",
  "meal_type": "baked-good",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 1,
    "inactive_minutes": 80
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "whole-wheat-bread-flour",
      "item": "whole wheat bread flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "boiling-water",
      "item": "boiling water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "all-purpose-flour-for-rolling",
      "item": "all-purpose flour for rolling"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the all-purpose flour, whole wheat bread flour, and salt. Work in the shortening until evenly incorporated."
    },
    {
      "step": 2,
      "text": "Pour in the boiling water and stir until a dough forms. Knead until smooth, then cover and let rest for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Divide the dough into 18 portions, shape each into a ball, cover, and let rest for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Heat a dry skillet or griddle over medium-high heat."
    },
    {
      "step": 5,
      "text": "Lightly flour the work surface and roll each dough ball into a thin round."
    },
    {
      "step": 6,
      "text": "Cook each tortilla in the hot skillet until lightly browned in spots, then turn and cook the other side, about 30 seconds per side.",
      "timer_minutes": 1
    },
    {
      "step": 7,
      "text": "Stack the tortillas and keep covered until serving."
    }
  ],
