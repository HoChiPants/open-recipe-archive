  "id": "cheese-chive-and-ham-tear-and-share-bread",
  "name": "Cheese, Chive and Ham Tear-and-Share Bread",
  "subtitle": "Soft pull-apart rolls with savory cheese, herbs, and ham",
  "description": "A batch of enriched yeast rolls filled with cheddar, Parmesan, chives, and smoked ham, arranged for easy sharing.",
  "meal_type": "baked-good",
  "yield": {
    "quantity": 18,
    "unit": "small rolls"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 170,
      "unit": "ml"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "unsalted-butter-cut-into-cubes",
      "item": "unsalted butter cut into cubes",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "fine-sea-salt",
      "item": "fine sea salt",
      "quantity": "1 1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "english-mustard-powder",
      "item": "English mustard powder",
      "quantity": 3,
      "unit": "tsp"
    },
    {
      "ingredient_id": "strong-white-bread-flour",
      "item": "strong white bread flour",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "x-7g-sachet-fast-action-dried-yeast",
      "item": "x 7g sachet fast-action dried yeast",
      "quantity": 1
    },
    {
      "ingredient_id": "eggs-lightly-beaten",
      "item": "eggs lightly beaten",
      "quantity": 4,
      "unit": "medium",
      "preparation": "plus 1 to glaze"
    },
    {
      "ingredient_id": "oil-for-proving",
      "item": "oil for proving"
    },
    {
      "ingredient_id": "mature-cheddar-grated",
      "item": "mature cheddar grated",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "parmesan-grated",
      "item": "parmesan grated",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "bunch-of-chives-finely-chopped",
      "item": "bunch of chives finely chopped",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "smoked-ham-coarsely-chopped",
      "item": "smoked ham coarsely chopped",
      "quantity": 150,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk, sugar, and cubed butter together until the butter melts. Let the mixture cool until comfortably warm."
    },
    {
      "step": 2,
      "text": "Mix the salt, mustard powder, flour, and yeast in a large bowl. Add the warm milk mixture and three of the beaten eggs."
    },
    {
      "step": 3,
      "text": "Stir until a dough forms, then mix for 15 minutes. Knead for 10 minutes, until smooth and elastic.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Oil a bowl, place the dough inside, cover, and leave it to rise until doubled in size.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Mix the cheddar, Parmesan, chives, and ham. Divide the dough into 18 portions, fill each with some of the mixture, and pinch closed."
    },
    {
      "step": 6,
      "text": "Arrange the filled portions close together on a prepared baking tray or in a baking tin. Cover and leave briefly while the oven preheats."
    },
    {
      "step": 7,
      "text": "Brush the dough with the remaining beaten egg. Bake in the preheated oven until risen and lightly browned.",
      "timer_minutes": 25
    },
    {
      "step": 8,
      "text": "Add any reserved cheese mixture over the top and bake for 5 minutes more, until the cheese is melted and the bread is cooked through.",
      "timer_minutes": 5
    },
    {
      "step": 9,
      "text": "Cool briefly before pulling apart and serving."
    }
  ],
