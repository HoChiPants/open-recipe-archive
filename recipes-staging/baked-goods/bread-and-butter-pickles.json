  "id": "bread-and-butter-pickles",
  "name": "Bread-and-Butter Pickles",
  "subtitle": "Sweet-tangy refrigerator pickles with jalapeño heat",
  "description": "Cucumbers, onion, and peppers are salted, chilled, and covered with a spiced vinegar syrup for crisp, flavorful pickles.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
