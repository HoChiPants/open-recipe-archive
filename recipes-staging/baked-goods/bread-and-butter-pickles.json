  "instructions": [
    {
      "step": 1,
      "text": "Combine the cucumbers, onion, and jalapeño rings in a large bowl. Toss with the kosher salt and chill for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Rinse the salted vegetables with the water, then drain thoroughly.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "In a saucepan, stir together the vinegar, sugar, remaining water, garlic, mustard seed, celery seeds, peppercorns, turmeric, and cloves."
    },
    {
      "step": 4,
      "text": "Bring the vinegar mixture to a boil and cook until the sugar dissolves, about 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Add the drained vegetables and combine gently. Transfer to a clean container, cool, cover, and refrigerate before serving."
    }
  ],
