  "instructions": [
    {
      "step": 1,
      "text": "Combine the sugar, butter, salt, and hot milk. Dissolve the yeast in the warm water, then stir it into the milk mixture."
    },
    {
      "step": 2,
      "text": "Add 2 eggs and enough flour to form a soft dough. Knead until smooth and elastic, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Place the dough in a prepared bowl, cover, and let rise until doubled, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Whisk 3 eggs with the brown sugar. Stir in the melted butter, cinnamon, and vanilla, then fold in the walnuts."
    },
    {
      "step": 5,
      "text": "Roll the dough into portions, spread with the filling, shape into loaves, and place in prepared pans. Cover and let rise again for about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Preheat the oven to 350°F. Brush the shaped loaves with the remaining melted butter."
    },
    {
      "step": 7,
      "text": "Bake until browned and set, about 35 minutes. Cool in the pans for 10 minutes, then transfer to a rack and cool completely before slicing.",
      "timer_minutes": 35
    }
  ],
