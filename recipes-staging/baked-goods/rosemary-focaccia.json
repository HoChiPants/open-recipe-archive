  "id": "rosemary-focaccia",
  "name": "Rosemary Focaccia",
  "subtitle": "Herb-scented focaccia made with a bread machine",
  "description": "A chewy, olive-oil-rich focaccia finished with garlic and fresh rosemary.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20,
    "inactive_minutes": 110
  },
  "ingredients": [
    {
      "ingredient_id": "lukewarm-water",
      "item": "lukewarm water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "fresh-rosemary",
      "item": "fresh rosemary",
      "quantity": 1.5,
      "unit": "tablespoons",
      "preparation": "chopped, divided"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1.5,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the water, 2 tablespoons of the olive oil, garlic, flour, half of the rosemary, salt, and yeast to the bread machine pan in the machine's recommended order. Start the dough cycle."
    },
    {
      "step": 2,
      "text": "Let the machine mix and knead the dough, then allow it to rise until the cycle is complete, about 90 minutes.",
      "timer_minutes": 90
    },
    {
      "step": 3,
      "text": "Transfer the dough to an oiled baking pan and gently stretch it to fit. Sprinkle with the remaining rosemary and let it rest.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 5,
      "text": "Drizzle the remaining olive oil over the dough and bake until golden brown.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Cool briefly before slicing and serving.",
      "timer_minutes": 5
    }
  ],
