  "instructions": [
    {
      "step": 1,
      "text": "Heat 1 tablespoon vegetable oil in a skillet. Cook the chicken breast until the thickest part reaches 165°F; transfer it to a plate and chop or shred it."
    },
    {
      "step": 2,
      "text": "Add the remaining vegetable oil to the skillet. Stir in the green onion, red bell pepper, and cayenne, and cook until tender.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the chicken, corn, black beans, spinach, jalapeños, parsley, cumin, chili powder, and salt. Stir until the mixture is tender and well combined.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the shredded Monterey Jack cheese and remove the filling from the heat."
    },
    {
      "step": 5,
      "text": "Wrap the tortillas in a damp paper towel and microwave until pliable.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Place filling across each tortilla, fold in the sides, and roll tightly. Secure the seams as needed and arrange the rolls on a tray."
    },
    {
      "step": 7,
      "text": "Freeze the assembled rolls until firm.",
      "timer_minutes": 240
    },
    {
      "step": 8,
      "text": "Heat the deep-frying oil to 375°F. Fry the frozen rolls in batches until golden brown, then drain.",
      "timer_minutes": 10
    }
  ],
