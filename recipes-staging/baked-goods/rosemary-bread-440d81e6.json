  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, olive oil, sugar, salt, Italian seasoning, black pepper, rosemary, flour, and yeast in a bowl. Mix until a dough forms."
    },
    {
      "step": 2,
      "text": "Knead until smooth and elastic, then cover and let rise until doubled in size.",
      "timer_minutes": 90
    },
    {
      "step": 3,
      "text": "Shape the dough into a loaf, place it in a prepared pan or on a baking sheet, cover, and let rise again until puffy.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "Bake in a preheated oven for 40 minutes, or until the loaf is golden brown and sounds hollow when tapped. Cool before slicing.",
      "timer_minutes": 40
    }
  ],
