  "name": "Rosemary Bread",
  "subtitle": "A fragrant homemade loaf with savory herbs and a crisp crust.",
  "description": "This simple yeast bread combines rosemary, Italian seasoning, and black pepper for a flavorful loaf suitable for slicing and sharing.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
