  "instructions": [
    {
      "step": 1,
      "text": "Finely chop the mozzarella and rindless taleggio, then combine them with the softened butter, garlic, parsley, and optional marjoram."
    },
    {
      "step": 2,
      "text": "Cut the baguette lengthwise, then make crosswise cuts along it without cutting completely through the base."
    },
    {
      "step": 3,
      "text": "Work the cheese mixture into the cuts and across the cut surface. Sprinkle with paprika."
    },
    {
      "step": 4,
      "text": "Shape and secure the filled baguette so the mixture stays in place, then rest it for 20 minutes before serving.",
      "timer_minutes": 20
    }
  ],
