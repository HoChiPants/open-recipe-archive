      "quantity": 3,
      "preparation": "plus 1 orange, zest peeled and finely sliced into strips"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk until just lukewarm. Mix the flour, first caster sugar, and yeast in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the eggs and warm milk, then mix to form a rough dough. Knead in the cubed room-temperature butter a little at a time until the dough is smooth and elastic, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Cover and let the dough rise until doubled in size, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "For the filling, combine the light brown sugar, cocoa powder, chopped dark chocolate, chopped butter, and the zest of three oranges. Set aside."
    },
    {
      "step": 5,
      "text": "For the syrup, simmer the orange juice, the second caster sugar, and the finely sliced orange zest until thickened, about 10 minutes. Cool.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Roll the risen dough on a lightly floured surface into a large rectangle. Spread over the filling, leaving a narrow border."
    },
    {
      "step": 7,
      "text": "Roll the dough up tightly from one long side. Cut the roll lengthwise, then twist the two halves together with the cut sides facing upward."
    },
    {
      "step": 8,
      "text": "Transfer the shaped loaf to a lined loaf tin. Cover and let it rise until puffy, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 9,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 10,
      "text": "Bake until deeply browned and cooked through, about 40 minutes. Brush the hot babka with the cooled orange syrup, then cool before slicing.",
      "timer_minutes": 40
    }
  ],
