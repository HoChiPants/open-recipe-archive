  "id": "chocolate-orange-babka",
  "name": "Chocolate Orange Babka",
  "subtitle": "Twisted sweet bread with cocoa, dark chocolate, and citrus syrup",
  "description": "A rich yeast-raised loaf layered with chocolate-orange filling, twisted for a marbled interior, and finished with a glossy orange syrup.",
  "meal_type": "baked-good",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 40
  },
  "ingredients": [
