      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "mixed-stir-fry-vegetables-we-used-a-mix-of-beansprouts",
      "item": "mixed stir-fry vegetables (we used a mix of beansprouts",
      "quantity": 450,
      "unit": "g",
      "preparation": "cabbage, carrots and peppers), any large pieces finely chopped"
    },
    {
      "ingredient_id": "or-16-small-spring-roll-pastry-sheets",
      "item": "or 16 small spring roll pastry sheets",
      "quantity": 8,
      "unit": "large"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "sweet-chilli-sauce-for-dipping",
      "item": "sweet chilli sauce for dipping"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cornflour, dark soy sauce, honey, and sesame oil until smooth."
    },
    {
      "step": 2,
      "text": "Heat 1 tbsp vegetable oil in a pan. Add the mixed vegetables and cook until tender. Stir in the sauce mixture, then cook briefly until thickened. Let the filling cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Lay a pastry sheet flat. Place filling near one corner, fold in the sides, and roll tightly. Seal the edge with a little water. Repeat with the remaining filling and pastry."
    },
    {
      "step": 4,
      "text": "Brush or toss the spring rolls with 2 tbsp vegetable oil. Preheat the air fryer, then arrange the rolls in a single layer with space between them.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Air-fry until golden and crisp, turning once if needed. Serve hot with sweet chilli sauce for dipping."
    }
  ],
