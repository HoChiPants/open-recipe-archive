  "id": "air-fryer-spring-rolls",
  "name": "Air-Fryer Spring Rolls",
  "subtitle": "Crisp vegetable rolls with a sweet-savory dip",
  "description": "Vegetable-filled spring rolls are folded, lightly oiled, and air-fried until crisp. Serve with sweet chilli sauce.",
  "meal_type": "baked-good",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "dark-soy-sauce",
      "item": "dark soy sauce",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "honey",
