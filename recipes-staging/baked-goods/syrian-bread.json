{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "syrian-bread",
  "name": "Syrian Bread",
  "subtitle": "Soft, yeast-risen flatbreads baked until golden",
  "description": "A simple yeast dough shaped into rounds, rested, and baked hot for tender, lightly browned flatbreads.",
  "meal_type": "baked-good",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10,
    "inactive_minutes": 150
  },
  "ingredients": [
    {
      "ingredient_id": "1-8-cups-water",
      "item": "1⁄8 cups water",
      "quantity": 1
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1.5,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, oil, sugar, salt, flour, and yeast in a bowl. Mix until a dough forms, then knead until smooth."
    },
    {
      "step": 2,
      "text": "Cover the dough and let it rise until puffy, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Preheat the oven to 475°F."
    },
    {
      "step": 4,
      "text": "Divide the dough into 8 portions and shape each into a ball. Roll the balls into thin rounds."
    },
    {
      "step": 5,
      "text": "Let the rounds rest briefly, then bake in batches until puffed and golden brown, about 5 minutes per batch.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Cool slightly before serving."
    }
  ],
