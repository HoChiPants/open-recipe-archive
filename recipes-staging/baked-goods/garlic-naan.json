  "id": "garlic-naan",
  "name": "Garlic Naan",
  "subtitle": "Soft flatbreads with garlic butter and cilantro",
  "description": "A yeasted Indian flatbread finished with melted garlic butter and fresh cilantro.",
  "meal_type": "baked-good",
  "cuisine": "Indian",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 35,
    "cook_minutes": 15,
    "inactive_minutes": 150
  },
  "ingredients": [
    {
      "ingredient_id": "warm-water",
      "item": "warm water",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 2,
      "unit": "cups",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "plain-yogurt",
      "item": "plain yogurt",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cilantro",
      "item": "cilantro",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the warm water, sugar, and yeast. Let stand for 15 minutes, until the yeast is active.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Melt the butter with the minced garlic; reserve the mixture for finishing the naan."
    },
    {
      "step": 3,
      "text": "Stir the yeast mixture, half of the garlic butter, flour, yogurt, and salt together to form a dough."
    },
    {
      "step": 4,
      "text": "Knead the dough, adding warm water or flour as needed, for about 4 minutes, until smooth.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Cover the dough and let it rise in a warm place for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Divide the dough into 6 pieces. Shape each piece into a ball using a lightly floured surface, then rest for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Preheat a heavy skillet, griddle, or baking surface over high heat for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Stretch each dough ball into a thick oval, press chopped cilantro onto the surface, and shape as needed to hold it in place.",
      "timer_minutes": 2
    },
    {
      "step": 9,
      "text": "Cook the naan on the hot surface for about 3 minutes, turning as needed, until puffed and browned.",
      "timer_minutes": 3
    },
    {
      "step": 10,
      "text": "Brush the hot naan with the remaining garlic butter and serve."
    }
  ],
