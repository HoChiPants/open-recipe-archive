  "id": "garlic-parmesan-croutons-71541b37",
  "name": "Garlic-Parmesan Croutons",
  "subtitle": "Crisp, savory cubes for soups and salads",
  "description": "Seasoned day-old bread cubes are coated in herb-garlic butter and baked until golden.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 7,
    "unit": "servings"
  },
