      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "thick-slices-day-old-bread-with-crusts-removed",
      "item": "thick slices day-old bread with crusts removed",
      "quantity": 5,
      "preparation": "cut into cubes"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Stir the melted butter, Parmesan, oregano, thyme, garlic powder, and salt together."
    },
    {
      "step": 3,
      "text": "Add the bread cubes and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Transfer the cubes to a baking sheet and spread them in a single layer."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, or until golden brown.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Cool before serving or storing."
    }
  ],
