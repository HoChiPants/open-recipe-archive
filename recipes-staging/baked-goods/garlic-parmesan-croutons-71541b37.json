  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 5,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "oregano",
      "item": "oregano",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
