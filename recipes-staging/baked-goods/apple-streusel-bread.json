  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a loaf pan for baking."
    },
    {
      "step": 2,
      "text": "Whisk 1.5 cups flour with the baking soda, 0.5 teaspoon cinnamon, and salt."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the sugar, oil, eggs, and vanilla. Stir in the grated apples and chopped nuts."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the wet mixture and stir just until combined."
    },
    {
      "step": 5,
      "text": "For the streusel, mix the remaining flour, sugar, and cinnamon. Cut in the butter until crumbly."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and scatter the streusel evenly over the top."
    },
    {
      "step": 7,
      "text": "Bake until the bread is set in the center and a tester comes out clean, about 75 minutes.",
      "timer_minutes": 75
    },
    {
      "step": 8,
      "text": "Cool in the pan for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
