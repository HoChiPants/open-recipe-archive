  "id": "spinach-parmesan-bread",
  "name": "Spinach Parmesan Bread",
  "subtitle": "Soft pizza dough filled with garlicky spinach and melted cheese",
  "description": "A savory baked bread made by wrapping seasoned spinach, Parmesan, and mozzarella in refrigerated pizza dough.",
  "meal_type": "baked-good",
