  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Warm the olive oil in a skillet over medium heat. Add the minced garlic and garlic powder, then cook briefly until fragrant."
    },
    {
      "step": 3,
      "text": "Stir in the thawed, drained spinach, salt and pepper, and Parmesan. Cook until the mixture is heated through, then let it cool for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Unroll and shape the pizza dough into a flat rectangle. Spread the spinach mixture over it and sprinkle with the mozzarella."
    },
    {
      "step": 5,
      "text": "Fold or roll the dough around the filling, seal the edges, and shape it into a loaf. Transfer it to a baking sheet."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, or until the bread is golden brown. Let it rest briefly before slicing."
    }
  ],
