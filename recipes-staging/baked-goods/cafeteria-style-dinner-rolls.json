  "instructions": [
    {
      "step": 1,
      "text": "Stir 1 tablespoon sugar into the warm water. Add the yeast and let stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Mix in the milk, eggs, salt, remaining sugar, flour, and shortening to form a dough."
    },
    {
      "step": 3,
      "text": "Transfer the dough to a work surface and let it rest until set, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "Knead the melted butter into the dough for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Roll the dough out thick on a floured surface, cut it into portions, and shape each into a roll."
    },
    {
      "step": 6,
      "text": "Arrange the rolls, chill them for the remaining inactive time, and heat the oven to 400°F."
    },
    {
      "step": 7,
      "text": "Bake until golden brown, about 12 minutes.",
      "timer_minutes": 12
    }
  ],
