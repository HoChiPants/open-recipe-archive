{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "lavash-cracker-bread",
  "name": "Lavash Cracker Bread",
  "subtitle": "Thin, crisp yeast bread for snacking or serving with dips",
  "description": "A simple whole-wheat and all-purpose flour dough is rested, rolled thin, cut, and baked at high heat until lightly browned and crisp.",
  "meal_type": "baked-good",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 15,
    "inactive_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "lukewarm-water",
      "item": "lukewarm water",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "whole-wheat-flour",
      "item": "whole wheat flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "25-ounce-envelope-active-dry-yeast",
      "item": "(.25 ounce) envelope active dry yeast",
      "quantity": 1
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the lukewarm water, whole wheat flour, yeast, and all-purpose flour together. Combine the whole wheat flour, all-purpose flour, and salt, then mix into the dough."
    },
    {
      "step": 2,
      "text": "Add enough lukewarm water and flour to form a workable dough. Knead for 10 minutes, adding flour as needed.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Transfer the dough to a bowl, cover, and let it rise for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Shape the dough into a log, cut it into portions, shape the portions, and let them rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Transfer the dough to the work surface and preheat the oven to 500°F."
    },
    {
      "step": 6,
      "text": "Roll each portion very thin and prepare the pieces for baking. Transfer them to a baking surface."
    },
    {
      "step": 7,
      "text": "Bake for about 3 minutes, until lightly browned, then transfer to a rack to cool.",
      "timer_minutes": 3
    },
    {
      "step": 8,
      "text": "Bake the remaining pieces in batches as needed."
    }
  ],
