  "id": "crusty-dutch-oven-bread",
  "name": "Crusty Dutch Oven Bread",
  "subtitle": "A simple yeast loaf with a crisp crust",
  "description": "Make a rustic loaf with a short knead, two rises, and a hot Dutch oven bake.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 55,
    "inactive_minutes": 105
  },
  "ingredients": [
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the bread flour, water, and salt. Add the active dry yeast and let the mixture stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mix until combined, then knead for about 10 minutes, until the dough is smooth.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Cover the dough and let it rise for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "Turn the dough onto a lightly floured surface using a little bread flour and active dry yeast as specified, then let it rest for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Shape the dough into a smooth round and let it rise for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Heat the oven to 450°F with a Dutch oven inside."
    },
    {
      "step": 7,
      "text": "Spray the Dutch oven with cooking spray. Cut a shallow slash across the dough and transfer it to the hot pot."
    },
    {
      "step": 8,
      "text": "Bake for 10 minutes, reduce the oven to 375°F, and continue baking for 20 minutes, until the loaf is deeply browned.",
      "timer_minutes": 20
    },
    {
      "step": 9,
      "text": "Cool the bread for 30 minutes before slicing.",
      "timer_minutes": 30
    }
  ],
