{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-chip-scones",
  "name": "Chocolate Chip Scones",
  "subtitle": "Tender orange-scented scones with semisweet chocolate",
  "description": "Quick British-style scones made with chilled butter, orange juice, and miniature semisweet chocolate chips.",
  "meal_type": "baked-good",
  "cuisine": "British",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 5,
      "unit": "tablespoons",
      "preparation": "chilled and cubed"
    },
    {
      "ingredient_id": "miniature-semisweet-chocolate-chips",
      "item": "miniature semisweet chocolate chips",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "orange-juice",
      "item": "orange juice",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, sugar, baking powder, and salt in a bowl."
    },
    {
      "step": 3,
      "text": "Cut in the chilled butter until the mixture is crumbly, then stir in the chocolate chips."
    },
    {
      "step": 4,
      "text": "Add the orange juice and mix just until a dough forms."
    },
    {
      "step": 5,
      "text": "Turn the dough onto a lightly floured surface and shape it into a thick round."
    },
    {
      "step": 6,
      "text": "Cut the round into 12 portions and transfer them to a baking sheet."
    },
    {
      "step": 7,
      "text": "Bake for 12 minutes, or until golden brown.",
      "timer_minutes": 12
    },
    {
      "step": 8,
      "text": "Cool briefly before serving."
    }
  ],
