  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill or broiler."
    },
    {
      "step": 2,
      "text": "Combine the cheddar, mayonnaise, green onions, salt, garlic salt, and black pepper in a bowl."
    },
    {
      "step": 3,
      "text": "Arrange the split English muffins on a grill-safe pan and spread the cheese mixture over them. Cut into bite-size pieces if desired."
    },
    {
      "step": 4,
      "text": "Grill until the topping is hot and lightly browned, about 5 minutes.",
      "timer_minutes": 5
    }
