  "instructions": [
    {
      "step": 1,
      "text": "Add the warm water, softened butter, honey, salt, coffee granules, cocoa powder, sugar, bread flour, whole wheat flour, and yeast to the bread-machine pan in the order listed."
    },
    {
      "step": 2,
      "text": "Select the basic or wheat bread cycle and start the machine. Let the loaf bake for the full cycle, about 180 minutes.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Remove the pan when the cycle ends. Cool the loaf before slicing."
