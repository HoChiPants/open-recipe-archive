  "id": "baker-s-clay",
  "name": "Baker's Clay",
  "subtitle": "Simple baked dough ornaments",
  "description": "Shape this sturdy salt dough into ornaments, bake until dry, then cool and decorate.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "ornaments"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the flour, water, and salt in a bowl to form a dough."
    },
    {
      "step": 3,
      "text": "Knead the dough until smooth."
    },
    {
      "step": 4,
      "text": "Lightly flour a work surface, roll or press the dough until thick, and cut out the ornaments."
    },
    {
      "step": 5,
      "text": "Transfer the shapes to a baking sheet and add any desired surface details or hanging holes."
    },
    {
      "step": 6,
      "text": "Bake for 60 minutes, or until firm and dry.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Cool completely before garnishing or decorating."
    }
  ],
