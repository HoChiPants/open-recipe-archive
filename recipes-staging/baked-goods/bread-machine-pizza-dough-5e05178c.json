  "instructions": [
    {
      "step": 1,
      "text": "Add the warm water, olive oil, sugar, salt, flour, garlic, oregano, basil, pepper, cilantro, paprika, and yeast to the bread-machine pan in the listed order."
    },
    {
      "step": 2,
      "text": "Select the machine’s dough cycle and let it mix and rise until the cycle is complete."
    },
    {
      "step": 3,
      "text": "Transfer the dough to a lightly floured surface, rest it for 30 minutes, then divide and shape it into pizza crusts.",
      "timer_minutes": 30
    },
