  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "anadama-bread",
  "name": "Anadama Bread",
  "subtitle": "Molasses-cornmeal yeast loaf",
  "description": "A lightly sweet, sturdy yeast bread with cornmeal and molasses.",
  "meal_type": "baked-good",
  "cuisine": "New England",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30,
    "inactive_minutes": 100
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornmeal",
      "item": "cornmeal",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "molasses",
      "item": "molasses",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "warm-water-110-degrees-f",
      "item": "warm water (110 degrees F)",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "In a small saucepan, cook the water and cornmeal over medium heat, stirring, until thickened, about 5 minutes. Remove from the heat; stir in the butter and molasses. Let cool until lukewarm.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Dissolve the active dry yeast in the warm water (110 degrees F). Let stand until foamy, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Combine the cornmeal mixture and yeast mixture. Stir in the salt and part of the all-purpose flour to make a soft dough; add the remaining flour as needed."
    },
    {
      "step": 4,
      "text": "Knead on a lightly floured surface until smooth, about 8 minutes. Place in a greased bowl, cover, and let rise until doubled, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Preheat the oven to 375°F. Shape the dough into a loaf and place it in a greased loaf pan. Cover and let rise until nearly doubled, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Bake until golden brown and the loaf sounds hollow when tapped, about 30 minutes. Cool before slicing.",
      "timer_minutes": 30
    }
  ],
