      "item": "fresh blueberries",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Prepare a 16-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Whisk the sugar and softened butter for 3 minutes. Stir in the eggs, then combine with the oil.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Whisk in the sour cream, milk, and lemon zest until smooth."
    },
    {
      "step": 4,
      "text": "In a separate bowl, whisk together the flour, baking powder, baking soda, and salt."
    },
    {
      "step": 5,
      "text": "Stir the dry mixture into the wet mixture until combined, then fold in the blueberries."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared muffin pan and bake for 30 minutes, until the muffins are set and lightly browned.",
      "timer_minutes": 30
    }
  ],
