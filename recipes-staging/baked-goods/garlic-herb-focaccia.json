  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Stir the yeast and sugar into the very warm water, then add the flour, 1 tablespoon olive oil, salt, and pepper; mix until a soft dough forms and work it until cohesive."
    },
    {
      "step": 2,
      "text": "Coat a baking pan with some of the measured olive oil, place the dough in it, and press or stretch it evenly across the pan."
    },
    {
      "step": 3,
      "text": "Combine the remaining olive oil with the crushed garlic. Let the dough rest in the pan for 30 minutes, until set and slightly puffy.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Mix the Parmesan, parsley, onion powder, and herbes de Provence. Drizzle the garlic oil over the dough, then scatter the cheese mixture over the surface and season with salt and pepper."
    },
    {
      "step": 5,
      "text": "Bake until golden brown, about 25 minutes. Cool for 5 minutes, then cut into portions.",
      "timer_minutes": 25
    }
  ],
