{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "almond-flour-keto-bread",
  "name": "Almond Flour Keto Bread",
  "subtitle": "A tender, savory loaf with a simple almond-flour base.",
  "description": "This low-carbohydrate loaf combines almond flour, eggs, and leavening for a sliceable bread suitable for serving warm or cooled.",
  "meal_type": "baked-good",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 7,
      "unit": "large",
      "preparation": "at room temperature"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted and cooled"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "blanched-almond-flour",
      "item": "blanched almond flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "xanthan-gum",
      "item": "xanthan gum",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sea-salt",
      "item": "sea salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat a loaf pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk the eggs for 3 minutes, until smooth. Blend in the cooled melted butter and olive oil.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the almond flour, baking powder, xanthan gum, and sea salt."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the egg mixture and stir until the batter is thick and smooth."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 45 minutes, until set and cooked through.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Cool before slicing."
    }
  ],
