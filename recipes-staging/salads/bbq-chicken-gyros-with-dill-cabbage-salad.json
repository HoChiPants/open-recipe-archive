  "instructions": [
    {
      "step": 1,
      "text": "Mix the full-fat Greek yogurt, 125 ml olive oil, large lemon, garlic cloves, ground coriander, ground cumin, smoked paprika, dried oregano, cayenne pepper, ground cinnamon, and black pepper. Coat the chicken thigh fillets, cover, and refrigerate for 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 2,
      "text": "Toss the white cabbage with the dill, lemon, and 3 tbsp olive oil. Fold in the tomatoes and red onion, then set aside."
    },
    {
      "step": 3,
      "text": "Preheat a grill or oven to high heat. Arrange the chicken on a suitable tray or grill and cook for about 20 minutes, turning as needed, until the thickest pieces reach 165°F.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Transfer the chicken to a board and rest for 15 minutes before slicing.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Serve the chicken with the dill-cabbage salad and chips."
    }
  ],
