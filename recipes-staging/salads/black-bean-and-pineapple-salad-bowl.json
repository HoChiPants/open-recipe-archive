  "instructions": [
    {
      "step": 1,
      "text": "Place the sliced onion in a bowl and squeeze over the lime juice. Toss and let stand briefly while preparing the remaining ingredients."
    },
    {
      "step": 2,
      "text": "Add the avocado, red pepper, coriander, and optional chilli. Toss gently to coat with the lime and onion mixture."
    },
    {
      "step": 3,
      "text": "Fold in the drained black beans and pineapple."
    },
    {
      "step": 4,
      "text": "Divide between two bowls and drizzle with the optional olive oil."
    }
