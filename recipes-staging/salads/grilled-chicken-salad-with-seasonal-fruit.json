  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill to medium-high heat."
    },
    {
      "step": 2,
      "text": "Grill the chicken for about 8 minutes, turning as needed, until the thickest piece reaches 165°F on a food thermometer. Rest briefly, then slice.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Meanwhile, toast the pecans in a dry skillet over medium heat for about 8 minutes, stirring occasionally; cool slightly.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Whisk the vinegar, sugar, oil, onion, mustard, salt, and white pepper until smooth."
    },
    {
      "step": 5,
      "text": "Arrange the torn lettuce on a serving platter or individual plates. Add the pecans and strawberries, top with sliced chicken, and serve with the dressing."
    }
  ],
