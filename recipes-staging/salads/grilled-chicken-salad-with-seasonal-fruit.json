  "id": "grilled-chicken-salad-with-seasonal-fruit",
  "name": "Grilled Chicken Salad with Seasonal Fruit",
  "subtitle": "Tender grilled chicken with berries, pecans, and crisp lettuce",
  "description": "A fresh salad combining grilled chicken, toasted pecans, sliced strawberries, and a tangy mustard dressing.",
  "meal_type": "salad",
  "cuisine": "American",
