  "id": "california-roll-salad",
  "name": "California Roll Salad",
  "subtitle": "A crisp salad with seasoned rice, avocado, cucumber, and crab",
  "description": "Toss shredded lettuce, cucumber, avocado, and imitation crab with tender seasoned rice and a wasabi-sesame dressing.",
  "meal_type": "salad",
  "yield": {
    "quantity": 6,
    "unit": "servings"
