  "instructions": [
    {
      "step": 1,
      "text": "Combine the rice, water, soy sauce, and rice wine vinegar in a saucepan. Cook until the rice is tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Let the cooked rice cool until set."
    },
    {
      "step": 3,
      "text": "Arrange the lettuce, cucumber, avocado, and imitation crabmeat in a large bowl."
    },
    {
      "step": 4,
      "text": "Stir the cooled rice, then mix it with the wasabi powder, mayonnaise, soy sauce, rice wine vinegar, sugar, and sesame oil."
    },
    {
      "step": 5,
      "text": "Toss the seasoned rice and dressing with the salad ingredients, then serve."
    }
  ],
