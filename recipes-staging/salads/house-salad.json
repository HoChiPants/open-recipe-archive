  "instructions": [
    {
      "step": 1,
      "text": "Place the romaine, iceberg, artichoke hearts, red onion, and pimento peppers in a large salad bowl."
    },
    {
      "step": 2,
      "text": "Whisk the olive oil, red wine vinegar, salt, black pepper, and Parmesan cheese in a separate bowl until combined."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the vegetables and toss until the leaves are evenly coated."
    },
    {
      "step": 4,
      "text": "Serve immediately."
