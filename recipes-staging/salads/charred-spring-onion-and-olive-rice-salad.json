      "item": "olive oil",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "mixed-grains-and-rice-or-3-x-250g-pouches",
      "item": "mixed grains and rice (or 3 x 250g pouches)",
      "quantity": 750,
      "unit": "g",
      "preparation": "cooked"
    },
    {
      "ingredient_id": "sherry-or-red-wine-vinegar",
      "item": "sherry or red wine vinegar",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
