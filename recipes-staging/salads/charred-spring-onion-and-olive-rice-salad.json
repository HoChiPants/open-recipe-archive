  "id": "charred-spring-onion-and-olive-rice-salad",
  "name": "Charred Spring Onion and Olive Rice Salad",
  "subtitle": "A warm grain salad with charred onions, olives, and toasted almonds",
  "description": "Combine cooked grains and rice with tangy vinegar, sundried tomatoes, celery, olives, and charred spring onions. Finish with toasted almonds and optional Manchego shavings.",
  "meal_type": "salad",
  "yield": {
    "quantity": 8,
    "unit": "as a side"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "spanish-green-olives-drained",
      "item": "Spanish green olives drained",
      "quantity": 100,
      "unit": "g",
      "preparation": "pitted"
    },
    {
      "ingredient_id": "bunch-spring-onions-150g",
      "item": "bunch spring onions (150g)"
    },
    {
