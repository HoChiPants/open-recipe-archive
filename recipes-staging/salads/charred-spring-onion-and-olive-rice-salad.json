      "item": "celery sticks",
      "quantity": 2,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "manchego-shavings-or-vegetarian-alternative-optional",
      "item": "manchego shavings or vegetarian alternative (optional)",
      "quantity": 50,
      "unit": "g",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the grill. Toss the pitted olives with the olive oil and grill briefly until lightly charred."
    },
    {
      "step": 2,
      "text": "Grill the spring onions for about 10 minutes, turning as needed, until tender and charred. Cut into bite-size pieces.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Warm the cooked grains and rice under the grill or in a suitable pan for about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Mix the vinegar with the sliced sundried tomatoes."
    },
    {
      "step": 5,
      "text": "Combine the warm grains, vinegar mixture, olives, spring onions, toasted almonds, and chopped celery."
    },
    {
      "step": 6,
      "text": "Stir in the optional Manchego shavings or vegetarian alternative, then serve."
    }
  ],
