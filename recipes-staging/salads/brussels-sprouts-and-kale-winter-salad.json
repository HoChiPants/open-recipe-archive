      "item": "pomegranate seeds to serve (optional)",
      "quantity": 50,
      "unit": "g",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the shredded Brussels sprouts and kale in a large bowl. Add the clementine segments."
    },
    {
      "step": 2,
      "text": "Whisk the olive oil, clementine zest and juice, vinegar, honey or maple syrup, and Dijon mustard until blended."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the vegetables and toss thoroughly. Let the salad stand for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Fold in the pine nuts, then top with the optional pomegranate seeds and serve."
    }
  ],
