  "id": "brussels-sprouts-and-kale-winter-salad",
  "name": "Brussels Sprouts and Kale Winter Salad",
  "subtitle": "A crisp seasonal salad with citrus dressing",
  "description": "Shredded Brussels sprouts and kale are tossed with clementines, toasted pine nuts, and a bright honey-mustard dressing.",
  "meal_type": "salad",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
