  "id": "tomato-mozzarella-salad",
  "name": "Tomato Mozzarella Salad",
  "subtitle": "Sliced tomatoes and mozzarella with basil and balsamic dressing",
  "description": "Arrange tomatoes and mozzarella with fresh basil, then finish with a simple balsamic dressing and olive oil.",
  "meal_type": "salad",
  "cuisine": "Italian",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
