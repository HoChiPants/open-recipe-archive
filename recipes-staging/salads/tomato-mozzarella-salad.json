      "item": "ground black pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "basil",
      "item": "fresh basil",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "minced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Arrange the sliced tomatoes and mozzarella on a serving platter."
    },
    {
      "step": 2,
      "text": "Whisk the balsamic vinegar, salt, and black pepper together. Drizzle in the olive oil while whisking to combine."
    },
    {
      "step": 3,
      "text": "Spoon the dressing over the tomatoes and mozzarella, sprinkle with the minced basil, and serve."
    }
  ],
