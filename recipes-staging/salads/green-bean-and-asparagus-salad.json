  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Toss the green beans with 1 tablespoon olive oil, spread them evenly on a baking sheet, and roast for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Coat the asparagus with 1 tablespoon olive oil, add it to the baking sheet with the green beans, and roast until the vegetables are tender, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Transfer the roasted vegetables to a bowl and add the red onion, cherry tomatoes, and parsley."
    },
    {
      "step": 5,
      "text": "Season with kosher salt and ground black pepper, then toss with the remaining olive oil to taste."
    }
  ],
