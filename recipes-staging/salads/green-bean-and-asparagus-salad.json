  "id": "green-bean-and-asparagus-salad",
  "name": "Green Bean and Asparagus Salad",
  "subtitle": "Roasted vegetables with tomatoes, onion, and parsley",
  "description": "Tender roasted green beans and asparagus are tossed with fresh vegetables, parsley, olive oil, and simple seasoning.",
