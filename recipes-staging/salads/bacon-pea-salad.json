  "id": "bacon-pea-salad",
  "name": "Bacon Pea Salad",
  "subtitle": "A creamy salad with crisp bacon, peas, celery, and Cheddar",
  "description": "Tender peas, crunchy vegetables, cheese, and bacon are tossed in a lightly sweet mayonnaise dressing.",
  "meal_type": "salad",
