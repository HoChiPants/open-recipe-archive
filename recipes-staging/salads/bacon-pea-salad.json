  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a skillet over medium heat for 10 minutes, turning as needed, until crisp. Drain on paper towels, then crumble.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the mayonnaise, honey, white sugar, salt, and pepper in a bowl until smooth."
    },
    {
      "step": 3,
      "text": "Combine the peas, celery, Cheddar, onion, and crumbled bacon in a large bowl."
    },
    {
      "step": 4,
      "text": "Add the dressing and toss until the ingredients are evenly coated."
    },
    {
      "step": 5,
      "text": "Serve immediately."
    }
  ],
