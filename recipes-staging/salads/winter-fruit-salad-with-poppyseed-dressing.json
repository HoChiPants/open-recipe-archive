  "id": "winter-fruit-salad-with-poppyseed-dressing",
  "name": "Winter Fruit Salad with Poppyseed Dressing",
  "subtitle": "Crisp greens and seasonal fruit with a tangy-sweet dressing",
  "description": "Romaine, apple, pear, cranberries, Swiss cheese, and cashews come together in a bright salad finished with homemade poppyseed dressing.",
  "meal_type": "salad",
  "cuisine": "American",
