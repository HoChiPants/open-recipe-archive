  "instructions": [
    {
      "step": 1,
      "text": "Whisk the sugar, lemon juice, diced onion, mustard, and salt in a bowl until combined."
    },
    {
      "step": 2,
      "text": "Gradually whisk in the vegetable oil until the dressing is thick and emulsified."
    },
    {
      "step": 3,
      "text": "Stir in the poppy seeds."
    },
    {
      "step": 4,
      "text": "Combine the romaine, Swiss cheese, cashews, cranberries, apple, and pear in a large salad bowl."
    },
    {
      "step": 5,
      "text": "Pour the dressing over the salad and toss gently to coat evenly. Serve immediately."
    }
  ],
