    "inactive_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "bunch-broccoli",
      "item": "bunch broccoli",
      "quantity": 1,
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "sunflower-seeds",
      "item": "sunflower seeds",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "diced"
    },
    {
