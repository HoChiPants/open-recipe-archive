      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-vinegar",
      "item": "white vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a skillet over medium heat. Cook the bacon until crisp, about 10 minutes. Drain and cool for 10 minutes, then crumble.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "In a large bowl, combine the broccoli, crumbled bacon, sunflower seeds, and diced red onion."
    },
    {
      "step": 3,
      "text": "Whisk the mayonnaise, sugar, and vinegar together in a small bowl."
    },
    {
      "step": 4,
      "text": "Pour the dressing over the broccoli mixture and toss until evenly coated."
    },
    {
      "step": 5,
      "text": "Cover and chill for 20 minutes before serving.",
      "timer_minutes": 20
    }
  ],
