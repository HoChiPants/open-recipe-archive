  "id": "broccoli-salad-with-bacon",
  "name": "Broccoli Salad with Bacon",
  "subtitle": "A crisp, creamy salad with savory bacon and sunflower seeds",
  "description": "Chopped broccoli, bacon, onion, and sunflower seeds are tossed with a sweet-tangy mayonnaise dressing and chilled before serving.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
