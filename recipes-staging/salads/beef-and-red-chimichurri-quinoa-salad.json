  "instructions": [
    {
      "step": 1,
      "text": "Whisk the parsley, shallot, vinegar, roasted pepper, chilli, oregano, garlic, and olive oil together in a bowl."
    },
    {
      "step": 2,
      "text": "Add the spicy greens, sweetcorn, tomatoes, quinoa, and sliced cooked beef. Toss until evenly coated."
    },
    {
      "step": 3,
      "text": "Spoon the salad into bowls and serve with the avocado sauce."
    },
    {
      "step": 4,
      "text": "Use only beef that was previously cooked and safely chilled. If preparing a whole beef cut yourself, verify 145°F at the center and rest it for 3 minutes before slicing."
