  "instructions": [
    {
      "step": 1,
      "text": "Place the cooked shrimp, green onions, and celery in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the mayonnaise, lemon juice, lime juice, dill, and black pepper. Toss gently until evenly coated."
    },
    {
      "step": 3,
      "text": "Serve immediately or chill until ready to serve."
    }
