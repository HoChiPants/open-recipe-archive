  "id": "strawberry-and-spinach-salad-with-honey-balsamic-vinaigrette",
  "name": "Strawberry and Spinach Salad with Honey Balsamic Vinaigrette",
  "subtitle": "Fresh spinach, berries, pecans, and Gorgonzola",
  "description": "A crisp, colorful salad paired with a sweet-tangy honey balsamic dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
