  },
  "ingredients": [
    {
      "ingredient_id": "bunch-fresh-spinach",
      "item": "bunch fresh spinach",
      "quantity": 1
    },
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 1,
      "unit": "cup",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "crumbled-gorgonzola-cheese",
      "item": "crumbled Gorgonzola cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
