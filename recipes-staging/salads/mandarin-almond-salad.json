  "id": "mandarin-almond-salad",
  "name": "Mandarin Almond Salad",
  "subtitle": "Crisp romaine with citrus, scallions, and sweet almonds",
  "description": "A bright green salad layered with juicy mandarin oranges, crunchy candied almonds, and a tangy red wine vinaigrette.",
  "meal_type": "salad",
