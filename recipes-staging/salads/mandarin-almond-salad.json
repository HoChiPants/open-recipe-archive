  "instructions": [
    {
      "step": 1,
      "text": "Place the romaine, drained mandarin oranges, and sliced green onions in a large salad bowl."
    },
    {
      "step": 2,
      "text": "Heat the 2 tablespoons sugar and sliced almonds in a skillet, stirring until the sugar melts and coats the almonds. Transfer the mixture to a plate and let it cool completely.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the red wine vinegar, olive oil, 1 tablespoon sugar, crushed red pepper flakes, and black pepper until combined."
    },
    {
      "step": 4,
      "text": "Toss the salad with the dressing, then add the cooled almond mixture and serve."
    }
  ],
