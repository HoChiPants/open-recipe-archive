  "id": "balela-salad",
  "name": "Balela Salad",
  "subtitle": "A bright, herb-filled bean salad with a tangy dressing",
  "description": "Combine beans, fresh herbs, vegetables, and a sharp lemon-vinegar dressing for a colorful salad served chilled or at room temperature.",
  "meal_type": "salad",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 0
  },
  "ingredients": [
