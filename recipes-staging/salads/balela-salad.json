      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "In a large bowl, combine the garbanzo beans, black beans, mint, parsley, onion, grape tomatoes, and salt and pepper."
    },
    {
      "step": 2,
      "text": "Transfer the jalapeno pepper, garlic, olive oil, lemon juice, apple cider vinegar, and salt and pepper to a blender."
    },
    {
      "step": 3,
      "text": "Blend until the dressing is combined."
    },
    {
      "step": 4,
      "text": "Pour the dressing over the bean mixture and toss to coat."
    },
    {
      "step": 5,
      "text": "Add the black beans, jalapeno pepper, and additional salt and pepper as needed; toss gently to combine."
    }
  ],
