      "item": "garbanzo beans",
      "quantity": 2,
      "unit": "can",
      "preparation": "15 ounce, drained and rinsed"
    },
    {
      "ingredient_id": "black-beans",
      "item": "black beans",
      "quantity": 2,
      "unit": "can",
      "preparation": "15 ounce, drained and rinsed"
    },
    {
      "ingredient_id": "packed-chopped-fresh-mint",
      "item": "(packed) chopped fresh mint",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "packed-chopped-fresh-parsley",
      "item": "(packed) chopped fresh parsley",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "grape-tomatoes",
      "item": "grape tomatoes",
      "quantity": 1,
      "unit": "pint",
      "preparation": "halved"
    },
    {
      "ingredient_id": "jalapeno-pepper",
      "item": "jalapeno pepper",
      "quantity": 1,
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
