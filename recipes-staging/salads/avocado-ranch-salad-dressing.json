  "instructions": [
    {
      "step": 1,
      "text": "Combine the salt, dried parsley, dried dill weed, onion powder, and garlic powder in a small bowl."
    },
    {
      "step": 2,
      "text": "In another bowl, whisk the avocado, mayonnaise, sour cream, buttermilk, and vinegar until smooth."
    },
    {
      "step": 3,
      "text": "Add the seasoning mixture and stir until evenly incorporated."
    }
