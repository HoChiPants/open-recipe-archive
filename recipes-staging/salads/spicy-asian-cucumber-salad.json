      "item": "hot chili oil",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Toss the prepared cucumbers with the salt and let them drain for 30 minutes. Rinse briefly if needed, then drain well.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Whisk the soy sauce, sugar, garlic, rice vinegar, toasted sesame oil, hot chili oil, and red pepper flakes until combined."
    },
    {
      "step": 3,
      "text": "Add the drained cucumbers to the dressing and stir until evenly coated."
    },
    {
      "step": 4,
      "text": "Chill before serving."
    }
  ],
