  "id": "spicy-asian-cucumber-salad",
  "name": "Spicy Asian Cucumber Salad",
  "subtitle": "Crisp cucumbers with a savory chili dressing",
  "description": "A refreshing cucumber salad balanced with soy, vinegar, garlic, toasted sesame oil, and chili heat.",
  "meal_type": "salad",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "cucumber",
      "item": "cucumbers",
      "quantity": 3,
      "unit": "large",
      "preparation": "sliced lengthwise, seeds scooped out, and cut into 1/2-inch thick half rounds"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "rice-vinegar",
      "item": "rice vinegar",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 1.5,
      "unit": "teaspoons",
      "preparation": "toasted"
    },
    {
