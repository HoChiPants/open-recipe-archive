  "id": "sugared-toasted-almond-salad-topping",
  "name": "Sugared Toasted Almond Salad Topping",
  "subtitle": "Crisp, caramelized almonds for salads",
  "description": "Sliced almonds coated in golden sugar add a sweet crunch to green salads and other dishes.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "almonds",
      "item": "almonds",
      "quantity": 1,
      "unit": "cup",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Spread the almonds and sugar in a dry skillet."
    },
    {
      "step": 2,
      "text": "Cook over medium heat, stirring often, until the sugar melts and the almonds are golden brown."
    },
    {
      "step": 3,
      "text": "Transfer the almonds to a heatproof plate or tray, separating them as much as possible."
    },
    {
      "step": 4,
      "text": "Let cool completely before using or storing.",
      "timer_minutes": 30
    }
  ],
