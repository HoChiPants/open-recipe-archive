  "instructions": [
    {
      "step": 1,
      "text": "Combine the water and quinoa in a saucepan. Bring to a simmer, cover, and cook until the quinoa is tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Remove the quinoa from the heat and let it cool until set."
    },
    {
      "step": 3,
      "text": "Bring the cooking liquid to a simmer, add the kale, and cook briefly until tender. Transfer the kale to a bowl."
    },
    {
      "step": 4,
      "text": "Add the cooled quinoa, kale, avocado, cucumber, bell pepper, red onion, feta, and black pepper to the bowl."
    },
    {
      "step": 5,
      "text": "Whisk the olive oil, lemon juice, Dijon mustard, and sea salt together. Pour the dressing over the salad and toss gently."
    }
  ],
