      "item": "slices cooked bacon",
      "quantity": 4,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "minced"
    },
