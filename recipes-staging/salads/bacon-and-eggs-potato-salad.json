  "id": "bacon-and-eggs-potato-salad",
  "name": "Bacon and Eggs Potato Salad",
  "subtitle": "A chilled potato salad with peas, bacon, eggs, and mustard dressing.",
  "description": "Tender red potatoes are folded with a creamy mustard dressing, vegetables, chopped eggs, and bacon, then chilled before serving.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
