      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the quartered red potatoes and salt in a pot, cover with water, and bring to a simmer."
    },
    {
      "step": 2,
      "text": "Cook until the potatoes are tender, about 10 minutes. Drain and let them cool until set.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Combine the potatoes, mayonnaise, peas, chopped eggs, bacon, onion, mustard, salt, and black pepper in a large bowl."
    },
    {
      "step": 4,
      "text": "Fold until evenly coated, then cover and chill for 60 minutes before serving.",
      "timer_minutes": 60
    }
  ],
