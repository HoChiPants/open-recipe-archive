  "id": "cucumber-salad-with-thai-sweet-chili-vinaigrette",
  "name": "Cucumber Salad With Thai Sweet Chili Vinaigrette",
  "subtitle": "A crisp, lightly sweet cucumber salad served chilled.",
  "description": "Thinly sliced cucumber and green onion are coated in a tangy sweet-chili dressing, then chilled so the flavors meld.",
  "meal_type": "salad",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "rice-vinegar",
      "item": "rice vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "thai-sweet-chili-sauce",
      "item": "Thai sweet chili sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "granulated-garlic",
      "item": "granulated garlic",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "cucumber",
      "item": "cucumber",
      "quantity": 1,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "green-onion",
      "item": "green onion",
      "quantity": 1,
      "preparation": "thinly sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the rice vinegar, Thai sweet chili sauce, sesame oil, white sugar, and granulated garlic until combined."
    },
    {
      "step": 2,
      "text": "Season the dressing with salt to taste."
    },
    {
      "step": 3,
      "text": "Add the cucumber and green onion to a bowl, pour over the dressing, and toss to coat evenly."
    },
    {
      "step": 4,
      "text": "Cover and chill for 60 minutes before serving.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Toss once more and serve cold."
    }
  ],
