  "instructions": [
    {
      "step": 1,
      "text": "Cook the macaroni in boiling water until tender, then drain well."
    },
    {
      "step": 2,
      "text": "Place the eggs in a saucepan, cover with water, and bring to a boil. Reduce to a simmer and cook until firm, about 20 minutes. Cool, peel, and cut the eggs.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Whisk together the mayonnaise, sour cream, ground mustard, sweet pickle juice, and celery seed. Season with the salt, ground black pepper, and green bell pepper."
    },
    {
      "step": 4,
      "text": "Combine the macaroni, eggs, dressing, celery, red onion, pimento-stuffed green olives, sweet pickle, carrots, and green bell pepper. Stir until evenly coated."
    },
    {
      "step": 5,
      "text": "Chill before serving."
    }
