  "instructions": [
    {
      "step": 1,
      "text": "Cook the macaroni with the salt in boiling water until tender. Drain well.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Toss the hot macaroni with the Italian-style salad dressing and let it stand for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir in the sour cream, mayonnaise, onion, celery, garlic powder, salt, pepper, and drained tuna. Confirm the tuna is opaque and flakes easily."
    },
    {
      "step": 4,
      "text": "Cover and refrigerate until thoroughly chilled, about 25 hours.",
      "timer_minutes": 1500
    }
