  "id": "salad-with-artichokes",
  "name": "Salad with Artichokes",
  "subtitle": "Crisp greens with tangy artichoke dressing",
  "description": "A quick salad combining mixed greens, tender artichokes, sliced red onion, Parmesan, and a savory vinaigrette.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
