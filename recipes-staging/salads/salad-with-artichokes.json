      "item": "grated Parmesan cheese",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the mixed salad greens, drained artichoke hearts, and sliced red onion in a large bowl."
    },
    {
      "step": 2,
      "text": "Whisk the vegetable oil, red wine vinegar, seasoned salt, garlic powder, and black pepper until combined."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the salad and toss until the greens are evenly coated."
    },
    {
      "step": 4,
      "text": "Sprinkle with the grated Parmesan cheese and serve."
    }
  ],
