    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "mixed-salad-greens",
      "item": "mixed salad greens",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "artichoke-hearts-in-water",
      "item": "artichoke hearts in water",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce, drained"
    },
