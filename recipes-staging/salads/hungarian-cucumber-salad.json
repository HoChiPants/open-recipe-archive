  "id": "hungarian-cucumber-salad",
  "name": "Hungarian Cucumber Salad",
  "subtitle": "Crisp cucumbers with dill, onion, and tangy dressing",
  "description": "A refreshing no-cook salad combining thinly sliced cucumbers and onions with dill, vinegar, oil, and simple seasoning.",
  "meal_type": "salad",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "seedless-english-cucumbers",
      "item": "seedless English cucumbers",
      "quantity": 2,
      "unit": "large",
      "preparation": "sliced thin"
    },
    {
      "ingredient_id": "extra-large-onions",
      "item": "extra large onions",
      "quantity": 1,
      "preparation": "sliced thin"
    },
    {
      "ingredient_id": "fresh-dill",
      "item": "fresh dill",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "white-vinegar",
      "item": "white vinegar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sliced cucumbers, onions, and chopped dill in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the vinegar and vegetable oil, then toss until the vegetables are evenly coated."
    },
    {
      "step": 3,
      "text": "Season with salt and black pepper to taste, and toss again before serving."
    }
  ],
