  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Spread the chopped walnuts on a baking sheet and bake for 10 minutes. Cool briefly.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the cranberries, balsamic vinegar, chopped red onion, sugar, and mustard until smooth."
    },
    {
      "step": 4,
      "text": "Gradually whisk in the vegetable oil, then season with salt and pepper to taste."
    },
    {
      "step": 5,
      "text": "Toss the mixed greens and sliced apples with the vinaigrette. Add the toasted walnuts and serve."
    }
  ],
