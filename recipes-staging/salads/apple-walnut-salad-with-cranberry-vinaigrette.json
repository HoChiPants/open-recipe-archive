  "id": "apple-walnut-salad-with-cranberry-vinaigrette",
  "name": "Apple Walnut Salad with Cranberry Vinaigrette",
  "subtitle": "Crisp greens and apples with a tart cranberry dressing",
  "description": "A fresh salad combining sliced apples, toasted walnuts, mixed greens, and a tangy cranberry-balsamic vinaigrette.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
