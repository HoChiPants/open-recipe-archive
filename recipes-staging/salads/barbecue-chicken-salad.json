  "instructions": [
    {
      "step": 1,
      "text": "Heat a grill to medium-high. Grill the chicken, turning as needed, until it reaches 165°F at the thickest part; allow it to rest for 10 minutes, then slice.",
      "timer_minutes": 6
    },
    {
      "step": 2,
      "text": "In a large serving bowl, toss together the red leaf lettuce, green leaf lettuce, tomato, cilantro, corn, and black beans. Scatter the French fried onions over the salad."
    },
    {
      "step": 3,
      "text": "Stir the Ranch dressing and barbeque sauce together until smooth. Toss the sliced chicken with the barbeque sauce, then arrange it over the salad and serve with the dressing."
    }
  ],
