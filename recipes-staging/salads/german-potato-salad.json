  "id": "german-potato-salad",
  "name": "German Potato Salad",
  "subtitle": "Warm potatoes with bacon, onion, and tangy vinegar dressing",
  "description": "Tender potatoes are tossed with crisp bacon, sautéed onion, and a warm sweet-tart vinegar dressing, then finished with parsley.",
  "meal_type": "salad",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 3,
      "unit": "cups",
      "preparation": "diced peeled"
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 4
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "diced"
    },
    {
      "ingredient_id": "white-vinegar",
      "item": "white vinegar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "tablespoons",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the diced potatoes in a saucepan with the water and bring to a simmer. Cook for 10 minutes, until tender, then let them cool slightly.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Cook the bacon in a skillet over medium heat for about 12 minutes, until crisp. Transfer it to a plate and prepare it by crumbling or chopping.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Cook the diced onion in the bacon drippings for 8 minutes, until softened.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Stir in the vinegar, water, sugar, salt, and pepper. Bring the dressing to a boil."
    },
    {
      "step": 5,
      "text": "Add the potatoes and bacon, and cook for 4 minutes, stirring gently to coat.",
      "timer_minutes": 4
    },
    {
      "step": 6,
      "text": "Garnish with the chopped parsley and serve warm."
    }
  ],
