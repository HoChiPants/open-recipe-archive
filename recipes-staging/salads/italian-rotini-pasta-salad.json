  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer and add the salt. Stir in the rotini and cook for 8 minutes, until tender.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Drain the pasta and set it aside to cool."
    },
    {
      "step": 3,
      "text": "Whisk the mayonnaise, red wine vinegar, garlic, salt, black pepper, yellow bell pepper, and black olives until combined. Stir in the basil."
    },
    {
      "step": 4,
      "text": "Add the pasta, tomatoes, yellow bell pepper, black olives, and black pepper to the dressing; stir until evenly coated."
    },
    {
      "step": 5,
      "text": "Cover and chill for 3 hours, then stir before serving.",
      "timer_minutes": 180
    }
  ],
