  "id": "arugula-beet-salad",
  "name": "Arugula Beet Salad",
  "subtitle": "Roasted beets with peppery greens and walnuts",
  "description": "Tender roasted beets are tossed with arugula, walnuts, and balsamic vinegar for a simple salad.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "beets",
      "item": "beets",
      "quantity": 3,
      "unit": "large",
      "preparation": "peeled and cut into cubes"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "coarse-salt",
      "item": "coarse salt",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "divided"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "divided"
    },
    {
      "ingredient_id": "bunch-arugula",
      "item": "bunch arugula",
      "quantity": 1,
      "preparation": "torn"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Toss the beets with portions of the divided olive oil, salt, and pepper. Spread them on a baking sheet."
    },
    {
      "step": 3,
      "text": "Roast until the beets are tender, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "Combine the roasted beets with the remaining divided oil, salt, and pepper, then add the arugula, walnuts, and balsamic vinegar. Toss to combine."
    }
  ],
