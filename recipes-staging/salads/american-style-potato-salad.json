    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the scrubbed potatoes in a pot, cover with water, and bring to a simmer. Cook for 30 minutes, or until tender when pierced.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Drain the potatoes and let them cool until easy to handle. Cut them into bite-size pieces."
    },
    {
      "step": 3,
      "text": "Arrange the potato pieces in a bowl and sprinkle with the red wine vinegar, salt, and black pepper."
    },
    {
      "step": 4,
      "text": "Chop the hard-cooked eggs, celery, and pickle; slice the scallions. Add them and the parsley to the potatoes."
    },
    {
      "step": 5,
      "text": "Stir in the mayonnaise and Dijon-style mustard until evenly combined."
    },
    {
      "step": 6,
      "text": "Chill before serving."
    }
  ],
