  "id": "american-style-potato-salad",
  "name": "American-Style Potato Salad",
  "subtitle": "Tender potatoes with crisp vegetables, eggs, and tangy dressing",
  "description": "A creamy potato salad balanced with vinegar, mustard, pickles, and fresh herbs.",
  "meal_type": "salad",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "red-boiling-potatoes",
      "item": "red boiling potatoes",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "scrubbed"
    },
    {
      "ingredient_id": "red-wine-vinegar",
      "item": "red wine vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
