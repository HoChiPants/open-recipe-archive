  "id": "potato-salad-with-mayonnaise-dressing",
  "name": "Potato Salad with Mayonnaise Dressing",
  "subtitle": "A chilled American salad with tender potatoes, eggs, and creamy dressing.",
  "description": "Boiled potatoes are cooled, combined with chopped eggs and onion, then dressed with mayonnaise and celery salt before chilling.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 35,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "yukon-gold-potatoes",
      "item": "Yukon Gold potatoes",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "scrubbed"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "hard-boiled-eggs",
      "item": "hard-boiled eggs",
      "quantity": 4,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "sweet-onion",
      "item": "sweet onion",
      "quantity": 1,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "celery-salt",
      "item": "celery salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the scrubbed potatoes in a large pot, add the salt, and cover with water. Bring to a boil and cook until tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Drain the potatoes and let them cool until easy to handle, then cut them into bite-size pieces."
    },
    {
      "step": 3,
      "text": "Combine the potatoes, chopped eggs, diced onion, mayonnaise, celery salt, and black pepper. Toss gently until evenly coated."
    },
    {
      "step": 4,
      "text": "Cover and chill for at least 60 minutes, then serve cold.",
      "timer_minutes": 60
    }
  ],
