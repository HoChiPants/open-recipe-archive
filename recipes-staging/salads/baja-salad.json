  "instructions": [
    {
      "step": 1,
      "text": "Toss the romaine, tomato, avocado, cucumber, feta, red onion, corn, black beans, and salt and pepper in a large bowl."
    },
    {
      "step": 2,
      "text": "Whisk the olive oil, lemon juice, cumin, and the seasoned black beans until smooth."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the salad and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Fold in the crushed tortilla chips just before serving."
    }
