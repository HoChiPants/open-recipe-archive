  "id": "pineapple-rocket-salad",
  "name": "Pineapple Rocket Salad",
  "subtitle": "Peppery greens with pineapple and maple dressing",
  "description": "A fresh, no-cook salad combining arugula, pineapple, cilantro, and red onion with a tangy maple dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "torn-arugula-leaves",
      "item": "torn arugula leaves",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "fresh-pineapple",
      "item": "fresh pineapple",
      "quantity": 1,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "fresh-cilantro",
      "item": "fresh cilantro",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 0.25,
      "unit": "medium",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "apple-cider-vinegar",
      "item": "apple cider vinegar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the arugula, pineapple, cilantro, and red onion in a large bowl."
    },
    {
      "step": 2,
      "text": "Whisk the apple cider vinegar, olive oil, maple syrup, and salt until blended."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the salad and toss until the leaves and vegetables are evenly coated."
    }
  ],
