    "inactive_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "whole-beets",
      "item": "whole beets",
      "quantity": 1,
      "unit": "can",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "prepared-mustard",
      "item": "prepared mustard",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "diced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the beets into bite-size pieces and combine them with the diced red onion."
    },
    {
      "step": 2,
      "text": "Heat the sugar and prepared mustard together for 10 minutes, stirring until combined.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the white wine vinegar to make the dressing."
    },
    {
      "step": 4,
      "text": "Pour the dressing over the beets and onion, then transfer to the refrigerator to marinate for 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 5,
      "text": "Serve chilled."
    }
  ],
