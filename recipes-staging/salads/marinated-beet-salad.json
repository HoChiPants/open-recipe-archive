  "id": "marinated-beet-salad",
  "name": "Marinated Beet Salad",
  "subtitle": "Sweet-tangy beets with red onion",
  "description": "Canned beets and red onion soak in a warm mustard-vinegar dressing for a chilled salad.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
