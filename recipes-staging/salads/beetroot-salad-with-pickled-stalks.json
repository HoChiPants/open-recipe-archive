  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Trim the beetroot, reserving the stalks, and coat the beetroot with the olive oil in a roasting tin."
    },
    {
      "step": 2,
      "text": "Roast until tender when pierced with a knife.",
      "timer_minutes": 50
    },
    {
      "step": 3,
      "text": "Cut the reserved stalks into short lengths. Warm the white wine vinegar, caster sugar, and coriander seeds in a saucepan until the sugar dissolves, then pour over the stalks. Stir and leave to pickle.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Whisk the horseradish sauce, soured cream, honey, and lemon juice into a creamy dressing."
    },
    {
      "step": 5,
      "text": "Combine the cooked puy lentils with the wholegrain mustard and chopped mint."
    },
    {
      "step": 6,
      "text": "Cool the roasted beetroot slightly, peel if needed, and cut into wedges or bite-size pieces."
    },
    {
      "step": 7,
      "text": "Toss the beetroot and lentils with some of the pickling liquid, then arrange with the pickled stalks and spoon over the horseradish dressing."
    },
    {
      "step": 8,
      "text": "Serve with hot smoked fish, if using."
    }
  ],
