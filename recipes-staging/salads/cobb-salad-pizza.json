  "instructions": [
    {
      "step": 1,
      "text": "Stir the instant yeast with the extra virgin olive oil for shaping the dough and drizzling, then let it stand for 10 minutes, until set.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Combine the plain flour plus extra for dusting with the golden caster sugar. Add the yeast mixture and mix into a dough."
    },
    {
      "step": 3,
      "text": "Knead the dough on a lightly floured surface for 10 minutes, until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Coat the dough with the extra virgin olive oil for shaping the dough and drizzling, transfer it to a bowl, cover, and leave it for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Prepare the dough with the extra virgin olive oil for shaping the dough and drizzling, then rest it on a floured surface for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Preheat the oven and transfer the dough to an oiled baking tray. Shape it into an even base."
    },
    {
      "step": 7,
      "text": "Whisk together the extra virgin oilve oil, tomato purée, red wine vinegar, Dijon mustard, garlic cloves crushed, and dried oregano."
    },
    {
      "step": 8,
      "text": "Prepare the stilton crumbled over the dough and bake for 10 minutes, until the cheese is melted and the base is cooked.",
      "timer_minutes": 10
    },
    {
      "step": 9,
      "text": "Combine the hard-boiled eggs peeled and roughly chopped, romaine lettuce shredded, cucumber deseeded and finely cubed, tomatoes halved, red onion thinly sliced, and chicken slices shredded with the dressing."
    },
    {
      "step": 10,
      "text": "Cut the baked pizza into portions, top with the salad mixture, and finish with the handful of finely chopped parsley to serve."
    }
  ],
