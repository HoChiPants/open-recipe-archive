  "id": "apple-cranberry-salad",
  "name": "Apple-Cranberry Salad",
  "subtitle": "Crisp fruit and greens with balsamic dressing",
  "description": "Toss apples, pears, cranberries, greens, blue cheese, and walnuts with a simple mustard-balsamic dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "stone-ground-mustard",
      "item": "stone-ground mustard",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "apple",
      "item": "apple",
      "quantity": 1,
      "preparation": "diced"
    },
    {
      "ingredient_id": "pear",
      "item": "pear",
      "quantity": 1,
      "preparation": "diced"
    },
    {
      "ingredient_id": "dried-cranberries",
      "item": "dried cranberries",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "mixed-baby-greens",
      "item": "mixed baby greens",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "crumbled-blue-cheese",
      "item": "crumbled blue cheese",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the mustard and balsamic vinegar together. Add the olive oil and whisk until the dressing is set."
    },
    {
      "step": 2,
      "text": "Combine the diced apple, pear, dried cranberries, baby greens, blue cheese, and walnuts in a large bowl."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the salad and toss gently until evenly coated."
    }
  ],
