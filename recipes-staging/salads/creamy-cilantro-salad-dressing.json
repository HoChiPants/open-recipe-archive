  "instructions": [
    {
      "step": 1,
      "text": "Combine the mayonnaise, canola oil, toasted pumpkin seeds, water, vinegar, Cotija, roasted Anaheim peppers, garlic, salt, and black pepper in a blender. Blend for 1 minute, or until smooth.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Add the cilantro and blend briefly until incorporated."
    },
    {
      "step": 3,
      "text": "Transfer the dressing to a container, cover, and refrigerate for 60 minutes before serving.",
      "timer_minutes": 60
    }
