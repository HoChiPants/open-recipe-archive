  "instructions": [
    {
      "step": 1,
      "text": "Whisk the olive oil, Dijon mustard, and lemon juice together to make the dressing."
    },
    {
      "step": 2,
      "text": "Bring a pan of water to a simmer. Add the asparagus and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the green beans, broccoli, and peas, then cook for 4 minutes, until tender-crisp.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Drain the vegetables well. Toss them with the radishes, cabbage, spring onions, and chopped mint."
    },
    {
      "step": 5,
      "text": "Add the dressing, toss to coat, and serve."
    }
  ],
