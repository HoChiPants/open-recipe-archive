  "id": "green-vegetable-salad",
  "name": "Green Vegetable Salad",
  "subtitle": "Blanched vegetables with lemon-mustard dressing",
  "description": "A crisp salad of seasonal green vegetables, fresh herbs, radishes, and cabbage tossed with a bright lemon dressing.",
  "meal_type": "salad",
  "yield": {
    "quantity": 8,
    "unit": "(or 4-6 with leftovers)"
