  "instructions": [
    {
      "step": 1,
      "text": "If the ramen product contains actual chicken, cook that chicken to 165°F measured with a food thermometer before adding it."
    },
    {
      "step": 2,
      "text": "Whisk the olive oil, sugar, vinegar, and broken ramen noodles until combined."
    },
    {
      "step": 3,
      "text": "Combine the ramen mixture with the broccoli slaw, almonds, raisins, green onions, and bell pepper."
    },
    {
      "step": 4,
      "text": "Fold gently until the ingredients are evenly coated, then serve."
    }
