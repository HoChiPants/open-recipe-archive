  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Toss the courgettes with the olive oil and roast until tender and lightly browned.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Roast the pumpkin seeds for 5 minutes, then sauté them for 20 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Let the courgettes cool until set."
    },
    {
      "step": 5,
      "text": "Combine the chicory or radicchio, rocket, tomatoes, spring onions, and cherries in a large bowl."
    },
    {
      "step": 6,
      "text": "Whisk the molasses, extra virgin olive oil, lime juice, and Dijon mustard into a dressing."
    },
    {
      "step": 7,
      "text": "Add the parsley and feta to the salad, then fold in the courgettes and pumpkin seeds."
    },
    {
      "step": 8,
      "text": "Pour over the dressing and toss gently before serving."
    }
  ],
