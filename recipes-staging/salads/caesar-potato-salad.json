  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Arrange the bacon on a baking sheet and cook until crisp, about 10 minutes. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Place the potatoes in a pot, cover with water, and bring to a simmer. Cook until tender, about 8 minutes, then drain.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Transfer the potatoes to a baking sheet. Toss with the olive oil and cracked black pepper, then bake until tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Combine the potatoes, bacon, Caesar dressing, and diced green onions. Toss gently and serve."
    }
  ],
