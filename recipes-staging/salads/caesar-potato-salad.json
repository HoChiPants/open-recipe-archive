  "id": "caesar-potato-salad",
  "name": "Caesar Potato Salad",
  "subtitle": "Roasted potatoes with bacon, greens, and creamy Caesar dressing",
  "description": "Tender baby red potatoes are lightly roasted, then combined with crisp bacon, green onions, and Caesar dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
