  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer and add the salt. Add the seashell pasta and cook for 10 minutes, or until tender. Drain well and let cool briefly.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk together the brown sugar, creamy salad dressing, lemon juice, distilled white vinegar, and salt."
    },
    {
      "step": 3,
      "text": "Combine the pasta, dressing, celery, green bell pepper, onion, and cooked chicken. If preparing chicken from raw, cook it to an internal temperature of 165°F before cutting it into pieces."
    },
    {
      "step": 4,
      "text": "Chill the salad until cold. Stir in the cashew halves just before serving."
    }
  ],
