  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Spread the pecan halves on a baking sheet and toast for 10 minutes, until lightly browned.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the raspberry vinegar, Dijon mustard, sugar, salt, and black pepper in a small bowl. Gradually whisk in the olive oil to make the dressing."
    },
    {
      "step": 3,
      "text": "Combine the salad greens, dried cranberries, red onion, feta, and toasted pecans in a large bowl."
    },
    {
      "step": 4,
      "text": "Add the dressing and toss gently to coat. Serve immediately."
    }
  ],
