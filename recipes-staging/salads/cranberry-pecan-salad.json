  "id": "cranberry-pecan-salad",
  "name": "Cranberry Pecan Salad",
  "subtitle": "Mixed greens with toasted pecans, cranberries, and feta",
  "description": "A crisp green salad with sweet-tart cranberries, toasted pecans, red onion, feta, and a raspberry-mustard dressing.",
  "meal_type": "salad",
