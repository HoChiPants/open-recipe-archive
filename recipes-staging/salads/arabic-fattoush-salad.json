  "instructions": [
    {
      "step": 1,
      "text": "Preheat a skillet over medium heat and add the vegetable oil."
    },
    {
      "step": 2,
      "text": "Fry the torn pita pieces, turning as needed, until golden brown. Transfer them to a plate."
    },
    {
      "step": 3,
      "text": "Combine the cucumber, tomatoes, parsley, mint, onion, olive oil, lemon juice, sumac, garlic, salt, and pepper in a large bowl."
    },
    {
      "step": 4,
      "text": "Add the fried pita and toss gently to distribute."
    },
    {
      "step": 5,
      "text": "Crumble the feta over the salad and serve."
    }
