  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Toss the carrots, courgette, and broccoli stalks with the rapeseed oil, then arrange them in a roasting pan."
    },
    {
      "step": 2,
      "text": "Roast until the vegetables are tender and lightly browned. Add the cherry tomatoes and spring onions for the final 4 minutes, then set the roasted vegetables aside.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Whisk the cider vinegar, Dijon mustard, saffron, caster sugar, and extra virgin rapeseed oil until combined. Stir in the shallot."
    },
    {
      "step": 4,
      "text": "Combine the roasted vegetables with the plum tomatoes, olives, cucumber, and basil. Toss with the dressing and serve."
    }
  ],
