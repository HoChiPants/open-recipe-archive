  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Toss the carrots, red onion, garlic, paprika, and olive oil together in a roasting pan."
    },
    {
      "step": 3,
      "text": "Roast for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the swede and sliced chorizo, then roast until the vegetables are tender and the chorizo reaches 160°F internally.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Meanwhile, prepare the bulgur wheat according to its package directions."
    },
    {
      "step": 6,
      "text": "Toss the cooked bulgur with the lemon juice and parsley."
    },
    {
      "step": 7,
      "text": "Top with the roasted vegetables and chorizo. Drizzle with extra olive oil and serve with lemon wedges and optional salad leaves."
    }
  ],
