  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil in a pan over medium-high heat. Add the garlic and sliced scallops; stir-fry for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Add the prawns and cook for about 2 minutes, stirring, until the scallops are opaque and the prawns are opaque and fully cooked.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Transfer the seafood to a bowl and let it cool."
    },
    {
      "step": 4,
      "text": "Stir together the tomato juice, oyster sauce, soy sauce, rice vinegar, and lemon juice."
    },
    {
      "step": 5,
      "text": "Combine the cooled seafood with the tomato mixture, celery, and avocado. Chill for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Garnish with chopped coriander and serve."
    }
  ],
