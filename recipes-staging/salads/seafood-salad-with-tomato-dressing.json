  "id": "seafood-salad-with-tomato-dressing",
  "name": "Seafood Salad with Tomato Dressing",
  "subtitle": "Chilled scallops and prawns with avocado and celery",
  "description": "Cooked seafood is cooled, dressed with seasoned tomato juice, and chilled with avocado, celery, and coriander.",
  "meal_type": "salad",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
