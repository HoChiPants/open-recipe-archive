  "id": "crab-salad",
  "name": "Crab Salad",
  "subtitle": "A quick creamy salad with sautéed vegetables and imitation crabmeat.",
  "description": "Tender onion and bell pepper are folded with warmed imitation crabmeat and mayonnaise for a simple chilled or room-temperature salad.",
  "meal_type": "salad",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 0.5,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "imitation-crabmeat",
      "item": "imitation crabmeat",
      "quantity": 12,
      "unit": "ounces"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the onion and green bell pepper; cook until tender, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir in the imitation crabmeat and sauté until heated through, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a bowl and fold in the mayonnaise until combined."
    },
    {
      "step": 5,
      "text": "Serve."
    }
  ],
