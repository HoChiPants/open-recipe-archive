  "instructions": [
    {
      "step": 1,
      "text": "Blend the dill, parsley, chives, tarragon, mayonnaise, olive oil, lemon juice, buttermilk, garlic, and anchovies until smooth."
    },
    {
      "step": 2,
      "text": "Coat the chicken fillets lightly with vegetable oil. Heat a barbecue or griddle until hot."
    },
    {
      "step": 3,
      "text": "Griddle the chicken until browned and cooked through, turning as needed; check the thickest part with a food thermometer for 165°F.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Rest the chicken for 5 minutes, then slice.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Combine the quinoa, lettuce, celery, cucumber, avocado, and sliced chicken. Add the dressing and toss gently."
    },
    {
      "step": 6,
      "text": "Scatter the snipped salad cress over the salad and serve."
    }
  ],
