  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Cook the puy lentils in boiling water until tender, about 40 minutes, then drain.",
      "timer_minutes": 40
    },
    {
      "step": 2,
      "text": "Blend or finely mix the ginger, coriander, garam masala, ground coriander, ground cumin, garlic, lemon juice, yogurt, and turmeric until smooth. Coat the chicken thighs with the mixture and set aside."
    },
    {
      "step": 3,
      "text": "Toss the onions, peppers, and cauliflower with the oil, then spread them in a roasting dish. Arrange the coated chicken on top."
    },
    {
      "step": 4,
      "text": "Roast until the vegetables are tender and the chicken is cooked through, about 35 minutes. Check the thickest part of the chicken with a thermometer; it should reach 165°F.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Warm the remaining oil with the cumin seeds for about 5 minutes, then combine with the drained lentils and any remaining yogurt mixture as appropriate.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Serve the roast chicken and vegetables with the lentils, finishing with the reserved coriander leaves. Rest the chicken briefly before serving."
    }
  ],
