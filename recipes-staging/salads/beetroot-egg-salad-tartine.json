  "instructions": [
    {
      "step": 1,
      "text": "Place the eggs in a saucepan, cover with water, and cook until hard-boiled, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Cool the eggs, peel them, and chop them with the beetroot and cornichons."
    },
    {
      "step": 3,
      "text": "Stir together the Greek yogurt and mayonnaise, then combine with the chopped beetroot mixture."
    },
    {
      "step": 4,
      "text": "Fold in the sliced spring onions, chopped cornichons, and dill."
    },
    {
      "step": 5,
      "text": "Spoon the mixture over the bread and scatter with mixed seeds and extra dill."
    },
    {
      "step": 6,
      "text": "Serve with the spinach and rocket salad, if using."
    }
  ],
