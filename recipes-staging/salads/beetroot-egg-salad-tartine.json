  "id": "beetroot-egg-salad-tartine",
  "name": "Beetroot Egg Salad Tartine",
  "subtitle": "A colorful open sandwich with creamy egg and beetroot salad",
  "description": "A single-serving tartine topped with chopped eggs, cooked beetroot, tangy yogurt, mayonnaise, herbs, and seeds.",
  "meal_type": "salad",
