      "item": "ground black pepper to taste",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill to medium heat."
    },
    {
      "step": 2,
      "text": "Grill the corn in its husks for 15 minutes, turning occasionally, until tender and lightly charred.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Let the corn cool enough to handle, then remove the husks and cut the kernels from the cobs."
    },
    {
      "step": 4,
      "text": "Combine the lime juice, chili powder, cotija, cilantro, mayonnaise, and black pepper in a bowl."
    },
    {
      "step": 5,
      "text": "Add the corn and salt, then toss until evenly coated. Adjust the lime and seasoning to taste."
    }
  ],
