  "id": "mexican-corn-salad",
  "name": "Mexican Corn Salad",
  "subtitle": "Grilled corn tossed with lime, cotija, cilantro, and chili",
  "description": "Grilled corn is cooled, cut from the cob, and mixed with a creamy lime dressing, cotija cheese, and cilantro.",
  "meal_type": "salad",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
