      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "crumbled-cotija-cheese",
      "item": "crumbled cotija cheese",
      "quantity": 5,
      "unit": "ounces"
    },
    {
      "ingredient_id": "packed-chopped-fresh-cilantro",
      "item": "packed chopped fresh cilantro",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
