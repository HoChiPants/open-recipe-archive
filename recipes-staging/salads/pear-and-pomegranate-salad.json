  "id": "pear-and-pomegranate-salad",
  "name": "Pear and Pomegranate Salad",
  "subtitle": "Crisp greens with fruit and a tangy dressing",
  "description": "Toss leafy greens and pear with pomegranate seeds, then finish with a simple pomegranate-mustard dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "green-leaf-lettuce",
      "item": "green leaf lettuce",
      "quantity": 3,
      "unit": "cups",
      "preparation": "rinsed and torn"
    },
    {
      "ingredient_id": "bartlett-or-anjou-pear",
      "item": "Bartlett or Anjou pear",
      "quantity": 1
    },
    {
      "ingredient_id": "pomegranate-seeds",
      "item": "pomegranate seeds",
      "quantity": 0.33333331346512,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "pomegranate-juice",
      "item": "pomegranate juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "prepared-dijon-style-mustard",
      "item": "prepared Dijon-style mustard",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.5,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the vegetable oil, pomegranate juice, lemon juice, prepared Dijon-style mustard, honey, and ground black pepper to taste into a smooth dressing."
    },
    {
      "step": 2,
      "text": "Cut the pear into bite-size pieces and combine it with the green leaf lettuce, pomegranate seeds, and pomegranate juice."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the salad, toss gently until coated, and serve."
    }
  ],
