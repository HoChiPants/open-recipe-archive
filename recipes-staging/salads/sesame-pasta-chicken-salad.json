  "instructions": [
    {
      "step": 1,
      "text": "Warm the sesame seeds, light soy sauce, and sesame oil in a saucepan until the mixture reaches a simmer. Remove from the heat."
    },
    {
      "step": 2,
      "text": "Cook the bow tie pasta in boiling water until tender, about 10 minutes. Drain and cool.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk together the sesame seed mixture, vegetable oil, remaining light soy sauce, rice vinegar, sesame oil, sugar, ginger, and black pepper."
    },
    {
      "step": 4,
      "text": "Toss the cooled pasta and shredded chicken with the dressing until coated. Fold in the cilantro and green onion, then serve."
    }
  ],
