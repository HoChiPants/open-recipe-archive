      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Arrange the apples and mixed leaves in a serving bowl."
    },
    {
      "step": 2,
      "text": "Add the feta and lemon zest to the bowl."
    },
    {
      "step": 3,
      "text": "Whisk the lemon juice, olive oil, and honey together to make a dressing."
    },
    {
      "step": 4,
      "text": "Drizzle the dressing over the salad, add the pul biber if using, and toss gently before serving."
    }
