  "id": "apple-and-feta-salad",
  "name": "Apple and Feta Salad",
  "subtitle": "Crisp apples, greens, and feta with a bright honey dressing",
  "description": "A fresh side salad combining sliced apples, mixed leaves, creamy feta, and a lightly spiced lemon-honey dressing.",
  "meal_type": "salad",
  "yield": {
    "quantity": 4,
    "unit": "as a side"
