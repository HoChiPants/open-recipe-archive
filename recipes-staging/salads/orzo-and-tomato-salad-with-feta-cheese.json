  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water seasoned with salt and pepper to a boil. Add the orzo and cook for 10 minutes, or until tender.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Drain the orzo and let it cool briefly."
    },
    {
      "step": 3,
      "text": "Combine the orzo, feta, tomato, olives, parsley, and dill in a large bowl."
    },
    {
      "step": 4,
      "text": "Whisk the lemon juice with the olive oil, then pour the dressing over the salad and toss to coat."
    },
    {
      "step": 5,
      "text": "Adjust the seasoning with salt and pepper, then chill before serving."
    }
  ],
