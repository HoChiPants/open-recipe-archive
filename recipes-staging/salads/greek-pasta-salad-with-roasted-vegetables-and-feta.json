  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Toss the peppers, eggplant, and squash with the olive oil, salt, and black pepper. Spread the vegetables in a baking dish or on a sheet pan."
    },
    {
      "step": 3,
      "text": "Roast until lightly browned, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "While the vegetables roast, cook the pasta with salt in boiling water until tender, about 12 minutes. Drain.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Drain the soaked sun-dried tomatoes. Combine them with the arugula, basil, and cooked pasta."
    },
    {
      "step": 6,
      "text": "Stir together the olive oil, balsamic vinegar, garlic, and feta cheese, then toss with the pasta mixture and roasted vegetables."
    },
    {
      "step": 7,
      "text": "Season with the peppers and salt, then chill before serving."
    }
  ],
