    },
    {
      "ingredient_id": "chili-sauce",
      "item": "chili sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "avocados",
      "item": "avocados",
      "quantity": 2,
      "preparation": "halved lengthwise and pitted"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
