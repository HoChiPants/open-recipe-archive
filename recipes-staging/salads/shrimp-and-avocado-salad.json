  "id": "shrimp-and-avocado-salad",
  "name": "Shrimp and Avocado Salad",
  "subtitle": "Creamy chili shrimp tucked into avocado halves",
  "description": "Combine seasoned cooked shrimp with a creamy chili dressing, then serve in lettuce-lined avocado halves with simple garnishes.",
  "meal_type": "salad",
  "cuisine": "British",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "salad-shrimp",
      "item": "salad shrimp",
      "quantity": 1,
      "unit": "cup",
      "preparation": "cooked"
    },
    {
      "ingredient_id": "fresh-chives",
      "item": "fresh chives",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 1,
