      "item": "Bibb lettuce leaves"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "pimento-peppers",
      "item": "pimento peppers",
      "preparation": "sliced, for garnish"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the mayonnaise, Worcestershire sauce, chili sauce, and chives together until smooth."
    },
    {
      "step": 2,
      "text": "Fold in the cooked shrimp, add the lemon juice, and season with salt to taste."
    },
    {
      "step": 3,
      "text": "Arrange Bibb lettuce leaves on serving plates and place the avocado halves on top."
    },
    {
      "step": 4,
      "text": "Spoon the shrimp mixture into the avocado halves, then sprinkle with paprika and garnish with sliced pimento peppers."
    }
  ],
