  "instructions": [
    {
      "step": 1,
      "text": "Bring the water and 2 tablespoons salt to a simmer in a large pot."
    },
    {
      "step": 2,
      "text": "Add the cauliflower and cook for 3 minutes, until just tender.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Drain the cauliflower, spread it out to cool, and let it stand for 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Stir together the mayonnaise, celery, crumbled bacon, onion, pickles, mustard, and turmeric."
    },
    {
      "step": 5,
      "text": "Fold in the cooled cauliflower and diced eggs, then season with salt and pepper."
    },
    {
      "step": 6,
      "text": "Cover and chill for 20 minutes before serving.",
      "timer_minutes": 20
    }
  ],
