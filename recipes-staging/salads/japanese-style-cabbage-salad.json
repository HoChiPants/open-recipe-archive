  "id": "japanese-style-cabbage-salad",
  "name": "Japanese-Style Cabbage Salad",
  "subtitle": "Crunchy cabbage salad with sesame dressing",
  "description": "A crisp cabbage salad with green onions, almonds, toasted sesame, and a tangy ginger dressing.",
  "meal_type": "salad",
