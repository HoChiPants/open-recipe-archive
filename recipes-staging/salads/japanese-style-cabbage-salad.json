  "instructions": [
    {
      "step": 1,
      "text": "Place the shredded cabbage, green onions, almond slivers, and toasted sesame seeds in a large bowl."
    },
    {
      "step": 2,
      "text": "Whisk the sesame oil, rice vinegar, sugar, garlic, ginger, salt, and black pepper until blended."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the cabbage mixture and toss until evenly coated. Serve immediately."
    }
