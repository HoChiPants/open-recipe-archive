  "instructions": [
    {
      "step": 1,
      "text": "Place the thawed corn, diced peppers, chopped onion, cucumber, and tomato in a bowl."
    },
    {
      "step": 2,
      "text": "Add the mayonnaise and stir gently until the vegetables are evenly coated."
    },
    {
      "step": 3,
      "text": "Season with salt and freshly ground black pepper to taste, then mix again."
    },
    {
      "step": 4,
      "text": "Chill the salad until ready to serve."
    }
