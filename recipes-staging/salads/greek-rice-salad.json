  "instructions": [
    {
      "step": 1,
      "text": "Combine the brown rice and water in a saucepan. Bring to a boil, then cover and cook until the rice is tender, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 2,
      "text": "While the rice cooks, toss the diced avocado with the lemon juice and lemon zest."
    },
    {
      "step": 3,
      "text": "In a large bowl, combine the tomatoes, cucumber, feta, red onion, olives, mint, olive oil, garlic, salt, and pepper."
    },
    {
      "step": 4,
      "text": "Add the avocado mixture and toss gently until combined."
    },
    {
      "step": 5,
      "text": "Fold in the cooked rice. Chill the salad before serving.",
      "timer_minutes": 10
    }
  ],
