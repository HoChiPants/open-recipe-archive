  "id": "tomato-salad-dressing",
  "name": "Tomato Salad Dressing",
  "subtitle": "A tangy, creamy dressing with celery seed and mustard",
  "description": "Blend tomato soup with oil, vinegar, sugar, and seasonings for a sweet-tart dressing served chilled.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "condensed-tomato-soup",
      "item": "condensed tomato soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "vinegar",
      "item": "vinegar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "dry-mustard-powder",
      "item": "dry mustard powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "celery-seeds",
      "item": "celery seeds",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "coarsely-ground-black-pepper",
      "item": "coarsely ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk together the tomato soup, oil, sugar, vinegar, mustard, salt, celery seeds, pepper, and garlic powder until smooth."
    },
    {
      "step": 2,
      "text": "Stir in the cornstarch, adding only as much as needed to reach the desired consistency."
    },
    {
      "step": 3,
      "text": "Chill the dressing before serving."
    }
  ],
