  "id": "cucumber-pasta-salad",
  "name": "Cucumber Pasta Salad",
  "subtitle": "A crisp, tangy pasta salad with dill and sliced vegetables",
  "description": "Bow tie pasta is tossed with cucumber, onion, dill, and a sweet-tangy mustard dressing, then chilled before serving.",
  "meal_type": "salad",
  "cuisine": "American",
