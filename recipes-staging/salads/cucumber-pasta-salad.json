  "instructions": [
    {
      "step": 1,
      "text": "Bring the water and salt to a simmer. Add the bow tie pasta and simmer for 12 minutes, or until cooked through.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Cool the pasta in water, then drain well."
    },
    {
      "step": 3,
      "text": "Combine the cooled pasta, cucumber, onion, and dried dill in a large bowl."
    },
    {
      "step": 4,
      "text": "Whisk together the white vinegar, white sugar, water, vegetable oil, prepared mustard, salt, and ground black pepper."
    },
    {
      "step": 5,
      "text": "Pour the dressing over the pasta mixture and toss to coat."
    },
    {
      "step": 6,
      "text": "Cover and chill for 120 minutes before serving.",
      "timer_minutes": 120
    }
  ],
