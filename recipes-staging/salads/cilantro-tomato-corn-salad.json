      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare the corn by loosening and folding back the husks while keeping the ears covered."
    },
    {
      "step": 2,
      "text": "Place the ears in their husks in a microwave-safe dish and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Let the corn cool enough to handle, then remove the husks and cut the kernels from the cobs."
    },
    {
      "step": 4,
      "text": "Stir the kernels with the melted butter, tomatoes, jalapeño, red onion, garlic, and cilantro."
    },
    {
      "step": 5,
      "text": "Blend in the salt, pepper, and lemon-herb seasoning, adjusting the seasoning to taste."
    },
    {
      "step": 6,
      "text": "Chill the salad before serving."
    }
  ],
