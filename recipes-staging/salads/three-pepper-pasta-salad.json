  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer and season it with the salt. Add the pasta and cook for 10 minutes, or until tender. Drain well.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Blend the olive oil, white wine vinegar, fresh basil leaves, grated Parmesan cheese, ground black pepper, and part of the julienned peppers until smooth."
    },
    {
      "step": 3,
      "text": "Toss the drained pasta with the blended dressing, remaining peppers, chopped tomato, and drained olives."
    },
    {
      "step": 4,
      "text": "Fold in the cubed mozzarella and serve."
    }
  ],
