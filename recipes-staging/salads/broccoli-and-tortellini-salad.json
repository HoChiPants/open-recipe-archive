  "id": "broccoli-and-tortellini-salad",
  "name": "Broccoli and Tortellini Salad",
  "subtitle": "A creamy, crunchy salad with raisins and sunflower seeds",
  "description": "Tender cheese tortellini, fresh broccoli, crisp bacon, and sweet raisins come together with a tangy mayonnaise dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
