  "instructions": [
    {
      "step": 1,
      "text": "Transfer the bacon to a preheated skillet and cook until crisp. Drain and set aside.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Bring water to a simmer, add the tortellini, and cook for 10 minutes, or until tender. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir together the mayonnaise, sugar, and cider vinegar."
    },
    {
      "step": 4,
      "text": "Combine the bacon, tortellini, broccoli, raisins, sunflower seeds, and red onion. Add the dressing and toss to coat."
    },
    {
      "step": 5,
      "text": "Transfer the salad to a serving bowl."
    }
  ],
