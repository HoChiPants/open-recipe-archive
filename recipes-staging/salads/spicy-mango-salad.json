{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "spicy-mango-salad",
  "name": "Spicy Mango Salad",
  "subtitle": "Sweet mango with lime, herbs, and chili",
  "description": "A bright, chilled mango salad dressed with lime juice, olive oil, chili flakes, cilantro, and shallots.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "mangos",
      "item": "mangos",
      "quantity": 4,
      "unit": "medium",
      "preparation": "peeled, seeded, and cubed"
    },
    {
      "ingredient_id": "fresh-lime-juice",
      "item": "fresh lime juice",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "fresh-cilantro",
      "item": "fresh cilantro",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "shallots",
      "item": "shallots",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the cubed mangos in a serving bowl."
    },
    {
      "step": 2,
      "text": "Whisk the lime juice and olive oil together in a small bowl."
    },
    {
      "step": 3,
      "text": "Stir in the red pepper flakes, cilantro, shallots, salt, and black pepper."
    },
    {
      "step": 4,
      "text": "Pour the dressing over the mangos and toss gently to coat."
    },
    {
      "step": 5,
      "text": "Cover and refrigerate for 30 minutes before serving.",
      "timer_minutes": 30
    }
  ],
