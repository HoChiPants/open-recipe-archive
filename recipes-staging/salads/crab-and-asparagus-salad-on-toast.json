  "id": "crab-and-asparagus-salad-on-toast",
  "name": "Crab and Asparagus Salad on Toast",
  "subtitle": "Lemony crab salad with crisp asparagus ribbons",
  "description": "A fresh crab and herb salad layered with tangled asparagus and rocket over toasted sourdough.",
  "meal_type": "salad",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 3
  },
  "ingredients": [
    {
      "ingredient_id": "asparagus-spears",
      "item": "asparagus spears",
      "quantity": 4,
      "preparation": "woody ends trimmed"
    },
    {
      "ingredient_id": "lemon-zested-and-juiced",
      "item": "lemon zested and juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "handful-flat-leaf-parsley-leaves",
      "item": "handful flat-leaf parsley leaves",
      "unit": "small",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "capers-drained-and-chopped",
      "item": "capers drained and chopped",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "gherkin-chopped",
      "item": "gherkin chopped",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "good-quality-thick-mayonnaise",
      "item": "good-quality thick mayonnaise",
      "quantity": 6,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "white-crabmeat",
      "item": "white crabmeat",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "slices-of-sourdough",
      "item": "slices of sourdough",
      "quantity": 4,
      "unit": "small"
    },
    {
      "ingredient_id": "handfuls-rocket-about-50g",
      "item": "handfuls rocket (about 50g)",
      "quantity": 4,
      "unit": "small"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Use a vegetable peeler to shave the trimmed asparagus spears lengthwise into thin ribbons."
    },
    {
      "step": 2,
      "text": "Whisk the lemon zest and juice with the olive oil, then set aside."
    },
    {
      "step": 3,
      "text": "Mix the parsley, capers, gherkin, mayonnaise, and crabmeat until evenly combined."
    },
    {
      "step": 4,
      "text": "Toast the sourdough slices until crisp, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Toss the asparagus ribbons and rocket with the lemon dressing."
    },
    {
      "step": 6,
      "text": "Top the toast with the crab mixture, asparagus, and rocket, then serve."
    }
  ],
