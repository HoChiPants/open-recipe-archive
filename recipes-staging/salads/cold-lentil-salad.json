  "id": "cold-lentil-salad",
  "name": "Cold Lentil Salad",
  "subtitle": "Tender lentils with roasted garlic and fresh vegetables",
  "description": "A bright, hearty salad combining cooled lentils, roasted garlic, tomatoes, herbs, and balsamic dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
