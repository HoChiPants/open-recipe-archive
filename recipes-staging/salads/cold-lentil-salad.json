  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Trim the tops from the garlic bulbs, place them in a baking dish, and drizzle with the divided teaspoon of olive oil. Cover the dish and bake for 30 minutes, until softened. Cool, then squeeze the garlic from the skins and mash or chop it.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Place the lentils in a saucepan and add enough water to cover. Bring to a simmer and cook for about 15 minutes, until tender. Stir occasionally, then cool and drain well.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Combine the cooled lentils, prepared garlic, tomatoes, parsley, and green onions in a large bowl."
    },
    {
      "step": 4,
      "text": "Whisk the balsamic vinegar, olive oil, salt, and pepper together. Pour over the lentil mixture and fold gently until evenly coated."
    },
    {
      "step": 5,
      "text": "Adjust the seasoning and serve cold."
    }
  ],
