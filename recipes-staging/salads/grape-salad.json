    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "seedless-green-grapes",
      "item": "seedless green grapes",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "seedless-red-grapes",
      "item": "seedless red grapes",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "7-ounce-jar-marshmallow-creme",
      "item": "(7 ounce) jar marshmallow creme",
      "quantity": 1
    },
    {
      "ingredient_id": "slivered-almonds",
      "item": "slivered almonds",
      "quantity": 1,
      "unit": "package",
      "preparation": "6 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Wash and dry the green and red grapes, then place them in a large bowl."
    },
    {
      "step": 2,
      "text": "Whisk the softened cream cheese and marshmallow creme until smooth."
    },
    {
      "step": 3,
      "text": "Fold the dressing into the grapes until evenly coated, then fold in the almonds."
    },
    {
      "step": 4,
      "text": "Cover and refrigerate until set and chilled.",
      "timer_minutes": 60
    }
  ],
