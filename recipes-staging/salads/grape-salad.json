  "id": "grape-salad",
  "name": "Grape Salad",
  "subtitle": "Chilled grapes in a creamy marshmallow dressing",
  "description": "A cool fruit salad combining green and red grapes with a smooth cream cheese dressing and crunchy almonds.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
