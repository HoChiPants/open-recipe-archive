  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Toss the broccoli and onion with 1 tablespoon sesame oil, spread on a baking tray, and roast until tender.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Cook the brown rice according to the pack instructions, then let it cool slightly."
    },
    {
      "step": 4,
      "text": "Whisk the remaining sesame oil with the soy sauce, rice wine vinegar, and honey."
    },
    {
      "step": 5,
      "text": "Combine the rice, roasted vegetables, avocado, and coriander in a bowl. Add the dressing and toss gently."
    },
    {
      "step": 6,
      "text": "Scatter over the toasted sesame seeds and sliced chilli before serving."
    }
  ],
