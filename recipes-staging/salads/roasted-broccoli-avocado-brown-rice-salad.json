  "id": "roasted-broccoli-avocado-brown-rice-salad",
  "name": "Roasted Broccoli, Avocado & Brown Rice Salad",
  "subtitle": "A warm, sesame-dressed rice salad with crisp vegetables and creamy avocado.",
  "description": "Roast broccoli and onion, then toss them with cooled brown rice, avocado, herbs, and a sweet-savoury sesame dressing.",
  "meal_type": "salad",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
