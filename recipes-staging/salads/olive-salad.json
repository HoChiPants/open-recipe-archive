  "id": "olive-salad",
  "name": "Olive Salad",
  "subtitle": "A tangy, herb-seasoned olive and artichoke salad",
  "description": "A bright no-cook salad combining mixed olives, marinated artichokes, onion, and a simple vinegar-oil dressing.",
  "meal_type": "salad",
