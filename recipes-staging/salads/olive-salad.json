  "instructions": [
    {
      "step": 1,
      "text": "Combine the red wine vinegar, olive oil, dried minced garlic, celery seed, dried oregano, dried basil, and black pepper in a bowl; whisk until blended."
    },
    {
      "step": 2,
      "text": "Add the black olives, green olives, artichoke hearts, and chopped red onion. Toss until evenly coated, allowing the artichoke marinade to join the dressing."
    },
    {
      "step": 3,
      "text": "Cover and chill before serving so the flavors can meld."
    }
  ],
