  "schema_version": "1.0.0",
  "id": "vegan-black-bean-and-sweet-potato-salad",
  "name": "Vegan Black Bean and Sweet Potato Salad",
  "subtitle": "Roasted sweet potatoes with lime-dressed black beans",
  "description": "Tender roasted sweet potatoes, black beans, red onion, and cilantro come together in a bright lime dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-potatoes",
      "item": "sweet potatoes",
      "quantity": 1,
      "unit": "pound",
      "preparation": "peeled and cut into 3/4-inch cubes"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "coarse-salt-and-ground-black-pepper-to-taste",
      "item": "coarse salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "freshly-squeezed-lime-juice",
      "item": "freshly squeezed lime juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "black-beans",
      "item": "black beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.5 ounce, rinsed and drained"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 0.5,
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "fresh-cilantro",
      "item": "fresh cilantro",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Toss the sweet potatoes with part of the olive oil, cumin, red pepper flakes, salt, and pepper until evenly coated."
    },
    {
      "step": 3,
      "text": "Spread the sweet potatoes on a baking sheet and roast until tender, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "Whisk the remaining olive oil with the lime juice. Season the black beans with red pepper flakes, salt, and pepper."
    },
    {
      "step": 5,
      "text": "Combine the roasted sweet potatoes, dressed black beans, red onion, and cilantro. Toss to coat and serve."
    }
  ],
