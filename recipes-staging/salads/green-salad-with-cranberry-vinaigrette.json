  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Spread the sliced almonds in an even layer on a baking sheet and toast for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Combine the cranberries, red wine vinegar, water, Dijon mustard, garlic, salt, and pepper. Blend until smooth, then blend in the olive oil."
    },
    {
      "step": 3,
      "text": "Toss the salad greens, red onion, blue cheese, and toasted almonds with the vinaigrette until evenly coated. Serve immediately."
    }
  ],
