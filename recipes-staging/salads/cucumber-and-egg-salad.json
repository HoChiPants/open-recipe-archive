  "id": "cucumber-and-egg-salad",
  "name": "Cucumber and Egg Salad",
  "subtitle": "Creamy salad with crisp cucumbers and dill pickles",
  "description": "Chopped hard-cooked eggs, cucumbers, and dill pickles folded with mayonnaise for a cool, crunchy salad.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "seedless-cucumbers",
      "item": "seedless cucumbers",
      "quantity": 4,
      "unit": "small"
    },
    {
      "ingredient_id": "dill-pickles",
      "item": "dill pickles",
      "quantity": 4,
      "unit": "small"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the eggs in a saucepan, cover with water, and bring to a simmer. Cook until hard-set, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Transfer the eggs to cool briefly, then peel and chop them. Cut the cucumbers and dill pickles into bite-size pieces."
    },
    {
      "step": 3,
      "text": "Combine the eggs, cucumbers, dill pickles, and mayonnaise in a bowl, mixing until evenly coated."
    },
    {
      "step": 4,
      "text": "Cover and chill the salad for 60 minutes before serving.",
      "timer_minutes": 60
    }
  ],
