  "id": "bavette-steak-with-chips-and-tarragon-mushroom-sauce",
  "name": "Bavette Steak with Chips and Tarragon Mushroom Sauce",
  "subtitle": "Seared steak with crisp chips and creamy mushroom sauce",
  "description": "A hearty steak dinner pairing bavette with homemade chips, a tarragon-scented mushroom sauce, and fresh watercress.",
  "meal_type": "salad",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
