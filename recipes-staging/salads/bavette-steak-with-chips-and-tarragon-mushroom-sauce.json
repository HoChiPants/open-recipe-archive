  "instructions": [
    {
      "step": 1,
      "text": "Let the bavette steak stand at room temperature for 1 hour, then pat it dry and season with the sea salt flakes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Simmer the potato chips for 10 minutes, then cook them for about 6 minutes more, until tender. Drain and set aside.",
      "timer_minutes": 16
    },
    {
      "step": 3,
      "text": "Melt the knob of butter for frying in a pan. Sauté the shallots and garlic for 5 minutes, then add the mushrooms and cook for 2 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Whisk in the double cream and chopped tarragon leaves, reserving the stems. Cook until the sauce is thickened, then transfer it to a bowl and keep warm."
    },
    {
      "step": 5,
      "text": "Preheat the cooking oil for the chips and sauté the reserved potato chips until crisp and golden. Drain well.",
      "timer_minutes": 6
    },
    {
      "step": 6,
      "text": "Heat the knob of butter for frying in a separate pan. Cook the seasoned bavette steak for 4 minutes, or until a thermometer reads 145°F at the thickest point.",
      "timer_minutes": 4
    },
    {
      "step": 7,
      "text": "Transfer the steak to a board and rest it for at least 3 minutes before slicing.",
      "timer_minutes": 3
    },
    {
      "step": 8,
      "text": "Serve the sliced steak with the chips, tarragon mushroom sauce, and watercress."
    }
  ],
