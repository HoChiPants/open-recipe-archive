  "instructions": [
    {
      "step": 1,
      "text": "Whisk the rice vinegar, soy sauce, lime zest and juice, sesame oil, brown sugar, garlic, and red pepper flakes until the sugar dissolves."
    },
    {
      "step": 2,
      "text": "Cook the soba noodles in boiling water for 5 minutes, or until tender. Drain well, then cut them into shorter lengths if needed.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Toss the warm noodles with the dressing. Fold in the carrot, cilantro, and peanuts."
    },
    {
      "step": 4,
      "text": "Cover and refrigerate the salad for 60 minutes before serving.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Stir once more and serve chilled."
    }
  ],
