  "id": "bacon-ranch-macaroni-salad",
  "name": "Bacon Ranch Macaroni Salad",
  "subtitle": "A chilled pasta salad with crisp bacon and creamy ranch dressing",
  "description": "Tender elbow macaroni is tossed with bacon, Cheddar, finely diced vegetables, mayonnaise, and ranch seasoning, then chilled until ready to serve.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20,
    "inactive_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 6
    },
    {
      "ingredient_id": "elbow-macaroni",
      "item": "elbow macaroni",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, cut into small cubes"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 0.5,
      "unit": "small",
      "preparation": "diced very small"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 0.5,
      "unit": "small",
      "preparation": "diced very small"
    },
    {
      "ingredient_id": "ranch-salad-dressing-mix",
      "item": "ranch salad dressing mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon until crisp. Transfer it to a plate to cool, then crumble or chop it into small pieces.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir the mayonnaise and ranch salad dressing mix together until evenly combined."
    },
    {
      "step": 3,
      "text": "Cook the elbow macaroni in simmering boiling water for 8 minutes, or until tender. Drain, rinse under cool water, and drain thoroughly again.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Combine the cooled macaroni, bacon, Cheddar, onion, bell pepper, and dressing. Mix until evenly coated."
    },
    {
      "step": 5,
      "text": "Cover and refrigerate for 4 hours before serving.",
      "timer_minutes": 240
    }
  ],
