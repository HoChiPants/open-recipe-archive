  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Combine the water and quinoa in a saucepan. Bring to a simmer, cover, and cook until the quinoa is tender, about 20 minutes. Let it cool and set.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Toss the sweet potatoes with the olive oil and spread them on a baking sheet. Roast until tender, about 25 minutes, then cool.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Combine the broccoli, yellow bell pepper, red bell pepper, cucumber, and salt and ground black pepper to taste in a large bowl."
    },
    {
      "step": 5,
      "text": "Stir the cooled quinoa and sweet potatoes into the vegetables."
    },
    {
      "step": 6,
      "text": "Whisk the extra-virgin olive oil, maple syrup, lemon, lime, and additional salt and ground black pepper to taste into a dressing. Toss with the salad."
    },
    {
      "step": 7,
      "text": "Prepare the salad for serving and garnish with the cilantro."
    }
  ],
