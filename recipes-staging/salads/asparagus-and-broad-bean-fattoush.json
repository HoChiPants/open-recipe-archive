  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Coat the torn flatbread with olive oil, spread it on a baking tray, and bake for 12 minutes, until crisp. Set aside to cool.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Cut the asparagus into pieces, reserving the ends. Prepare the cucumber, spring onions, and parsley as specified."
    },
    {
      "step": 3,
      "text": "Heat the oven or a pan as needed for the asparagus. Cook the asparagus ends with the chopped parsley stalks for 7 minutes, until crisp and tender.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Combine the garlic, lemon zest and juice, dried mint, sumac, red wine vinegar, and tomatoes. Stir in the cooled flatbread and let the mixture stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Bring water to a simmer. Add the asparagus pieces, broad beans, and tomatoes, and cook for 2 minutes. Transfer them out and let them cool briefly.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Add the asparagus, broad beans, radishes, tomatoes, cucumber, spring onions, and parsley leaves to the flatbread mixture. Toss to coat."
    },
    {
      "step": 7,
      "text": "Top with the crisp asparagus ends and finish with the reserved pinch of sumac. Serve."
    }
  ],
