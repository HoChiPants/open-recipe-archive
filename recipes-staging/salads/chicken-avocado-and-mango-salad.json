      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "chili-garlic-sauce",
      "item": "chili garlic sauce",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "shredded",
      "item": "shredded",
      "quantity": 4,
      "unit": "cups",
      "preparation": "cooked chicken"
    },
    {
      "ingredient_id": "mangos",
      "item": "mangos",
      "quantity": 2,
      "unit": "medium",
      "preparation": "peeled, seeded and diced"
    },
    {
      "ingredient_id": "avocados",
      "item": "avocados",
      "quantity": 2,
      "preparation": "peeled, pitted and diced"
    },
    {
      "ingredient_id": "spring-lettuce-mix",
      "item": "spring lettuce mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the brown sugar, water, and chili garlic sauce in a small saucepan. Warm gently, stirring until the sugar dissolves; do not boil."
    },
    {
      "step": 2,
      "text": "Transfer the dressing to a bowl and stir in the lime juice. Set aside to cool."
    },
    {
      "step": 3,
      "text": "Place the chicken, mangos, avocados, and spring lettuce mix in a large bowl."
    },
    {
      "step": 4,
      "text": "Add the dressing and toss gently until the salad is evenly coated. Serve immediately."
    }
  ],
