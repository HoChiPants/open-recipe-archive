  "id": "chicken-avocado-and-mango-salad",
  "name": "Chicken, Avocado and Mango Salad",
  "subtitle": "A bright, sweet-spicy salad with tender chicken and fresh fruit.",
  "description": "Make a quick lime-chili dressing, then toss it with chicken, mango, avocado, and spring lettuce for a fresh salad.",
  "meal_type": "salad",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
