  "id": "creamy-tuna-salad",
  "name": "Creamy Tuna Salad",
  "subtitle": "A cool, crisp tuna salad with a smooth dressing",
  "description": "Cream cheese and mayonnaise coat flaky tuna, carrot, and bell pepper for an easy lunch salad.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "ounces",
      "preparation": "softened, or as needed"
    },
    {
      "ingredient_id": "solid-white-tuna-packed-in-water",
      "item": "solid white tuna packed in water",
      "quantity": 2,
      "unit": "can",
      "preparation": "5 ounce, drained and flaked"
    },
    {
      "ingredient_id": "carrot",
      "item": "carrot",
      "quantity": 0.5,
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "red-bell-pepper",
      "item": "red bell pepper",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper-to-taste",
      "item": "freshly ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the mayonnaise and softened cream cheese until smooth."
    },
    {
      "step": 2,
      "text": "Fold in the drained, flaked tuna, carrot, diced red bell pepper, and black pepper until evenly combined."
    },
    {
      "step": 3,
      "text": "The canned tuna requires no cooking. If using uncooked fish in another preparation, cook it to 145°F, or until opaque and easily flaked."
    }
  ],
