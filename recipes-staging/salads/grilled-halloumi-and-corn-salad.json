  "id": "grilled-halloumi-and-corn-salad",
  "name": "Grilled Halloumi and Corn Salad",
  "subtitle": "Charred corn and golden halloumi with avocado, tomatoes, and lime",
  "description": "A bright vegetarian salad combining smoky grilled corn and halloumi with fresh vegetables, herbs, and citrus dressing.",
  "meal_type": "salad",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
