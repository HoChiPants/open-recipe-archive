  "instructions": [
    {
      "step": 1,
      "text": "Put the red onion, avocado, cherry tomatoes, and coriander in a large bowl."
    },
    {
      "step": 2,
      "text": "Whisk the lime juice with the olive oil to make a dressing, then toss it with the vegetables."
    },
    {
      "step": 3,
      "text": "Preheat a barbecue or grill to medium-high heat. Brush the corn with a little oil and sprinkle with the smoked paprika."
    },
    {
      "step": 4,
      "text": "Grill the corn and halloumi, turning occasionally, until the corn is charred and the halloumi is browned, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Cut the kernels from the cobs and add them to the bowl with the halloumi. Toss gently and serve."
    }
  ],
