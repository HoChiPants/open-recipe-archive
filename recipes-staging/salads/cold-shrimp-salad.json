  "instructions": [
    {
      "step": 1,
      "text": "Combine the shrimp, green and red bell peppers, garlic, onion, cilantro, avocado, salt and pepper, and chili pepper flakes in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the olive oil and toss gently until the ingredients are evenly coated."
    },
    {
      "step": 3,
      "text": "Cover and refrigerate for 60 minutes. Keep the salad chilled until serving.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Serve cold."
    }
