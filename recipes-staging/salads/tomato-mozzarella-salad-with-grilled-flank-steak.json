  },
  "ingredients": [
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 2,
      "unit": "medium",
      "preparation": "diced"
    },
    {
      "ingredient_id": "4-ounce-ball-fresh-mozzarella",
      "item": "(4 ounce) ball fresh mozzarella",
      "quantity": 1,
      "preparation": "cut into 1-inch cubes"
    },
    {
      "ingredient_id": "coarsely-chopped-fresh-basil",
      "item": "coarsely chopped fresh basil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
