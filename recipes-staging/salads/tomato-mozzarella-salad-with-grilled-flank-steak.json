      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced, divided"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 41,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "flank-steak",
      "item": "flank steak",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "butter-lettuce-mix",
      "item": "butter lettuce mix",
      "quantity": 1,
      "unit": "bag",
      "preparation": "6.5 ounce"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the tomatoes, mozzarella, basil, half the garlic, and part of the divided olive oil in a bowl. Toss gently, cover, and chill for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Preheat an outdoor grill to medium-high heat."
    },
    {
      "step": 3,
      "text": "Coat the flank steak with the remaining garlic and olive oil, then season with salt and black pepper."
    },
    {
      "step": 4,
      "text": "Grill the steak for about 5 minutes per side, or until a thermometer inserted into the thickest part reads 145°F.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Transfer the steak to a cutting board and let it rest for 3 minutes before slicing.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Toss the butter lettuce mix with the remaining olive oil and balsamic vinegar."
    },
    {
      "step": 7,
      "text": "Arrange the lettuce and chilled tomato-mozzarella mixture on plates, top with sliced steak, and serve."
    }
  ],
