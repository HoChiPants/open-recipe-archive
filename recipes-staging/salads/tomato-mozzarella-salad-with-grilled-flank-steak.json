  "id": "tomato-mozzarella-salad-with-grilled-flank-steak",
  "name": "Tomato-Mozzarella Salad with Grilled Flank Steak",
  "subtitle": "A fresh tomato and basil salad with sliced grilled steak",
  "description": "Juicy tomatoes, mozzarella, basil, and crisp lettuce accompany simply grilled flank steak with balsamic dressing.",
  "meal_type": "salad",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
