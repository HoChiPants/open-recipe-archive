  "instructions": [
    {
      "step": 1,
      "text": "Place the eggs in a saucepan, cover with water, and bring to a simmer. Cook for 12 minutes, then cool, peel, and cut them.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Cook the bacon until crisp, then drain and crumble or cut it into pieces."
    },
    {
      "step": 3,
      "text": "Stir the cider vinegar, water, white sugar, and salt together to make the dressing."
    },
    {
      "step": 4,
      "text": "Wash and dry the spinach, then arrange it in a serving bowl with the sliced mushrooms and eggs."
    },
    {
      "step": 5,
      "text": "Add the bacon, drizzle with the dressing, and garnish as desired before serving."
    }
  ],
