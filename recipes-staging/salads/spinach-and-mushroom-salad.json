  "id": "spinach-and-mushroom-salad",
  "name": "Spinach and Mushroom Salad",
  "subtitle": "Fresh spinach with mushrooms, bacon, eggs, and tangy dressing",
  "description": "A hearty spinach salad layered with sliced mushrooms, crisp bacon, eggs, and a lightly sweet cider-vinegar dressing.",
  "meal_type": "salad",
