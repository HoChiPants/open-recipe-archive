  "id": "chicken-fiesta-salad",
  "name": "Chicken Fiesta Salad",
  "subtitle": "Seasoned chicken with beans, corn, salsa, and crisp greens",
  "description": "A hearty salad combining fajita-seasoned chicken, colorful vegetables, beans, corn, and salsa over mixed greens.",
  "meal_type": "salad",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 2,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "dry-fajita-seasoning",
      "item": "dry fajita seasoning",
      "quantity": 1,
      "unit": "packet",
      "preparation": "1.27 ounce, divided"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "black-beans",
      "item": "black beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, rinsed and drained"
    },
    {
      "ingredient_id": "mexican-style-corn",
      "item": "Mexican-style corn",
      "quantity": 1,
      "unit": "can",
      "preparation": "11 ounce"
    },
    {
      "ingredient_id": "salsa",
      "item": "salsa",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "mixed-salad-greens",
      "item": "mixed salad greens",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomato",
      "quantity": 1,
      "preparation": "cut into wedges"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Divide the fajita seasoning. Coat the chicken with half of it and set aside."
    },
    {
      "step": 2,
      "text": "Preheat a grill or grill pan over medium-high heat for 8 minutes. Lightly oil the cooking surface with the vegetable oil.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Grill the chicken until browned and the thickest part reaches 165°F on a food thermometer, turning as needed. Rest briefly, then slice."
    },
    {
      "step": 4,
      "text": "Combine the black beans, Mexican-style corn, salsa, and remaining fajita seasoning."
    },
    {
      "step": 5,
      "text": "Toss the mixed greens with the onion and arrange on serving plates. Top with the bean-corn mixture and sliced chicken, then garnish with tomato wedges."
    }
  ],
