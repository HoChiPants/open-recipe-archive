      "item": "green bell pepper",
      "quantity": 1,
      "preparation": "seeded and cut into strips"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the sliced carrots in boiling water until tender, about 5 minutes. Drain well.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk the tomato soup, sugar, vinegar, canola oil, mustard, and Worcestershire sauce until blended."
    },
    {
      "step": 3,
      "text": "Combine the carrots, celery, green onion, and bell pepper. Pour over the dressing and toss gently to coat."
    },
    {
      "step": 4,
      "text": "Cover and chill for 4 hours before serving.",
      "timer_minutes": 240
    }
