  "id": "marinated-carrot-salad",
  "name": "Marinated Carrot Salad",
  "subtitle": "Tender carrots in a tangy tomato dressing",
  "description": "A chilled salad combining tender carrots, crisp vegetables, and a sweet-tangy dressing.",
