  "id": "napa-cabbage-ramen-crunch-salad",
  "name": "Napa Cabbage Ramen Crunch Salad",
  "subtitle": "Crisp cabbage salad with toasted ramen, seeds, and almonds",
  "description": "A fresh napa cabbage salad tossed with green onions, crunchy baked toppings, and a sweet-tangy soy dressing.",
  "meal_type": "salad",
  "cuisine": "Asian Inspired",
