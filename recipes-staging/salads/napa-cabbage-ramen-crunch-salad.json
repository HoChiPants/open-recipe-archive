  "instructions": [
    {
      "step": 1,
      "text": "Whisk the sugar, vinegar, and soy sauce together. Chill the dressing for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 3,
      "text": "Combine the crushed ramen noodles, sesame seeds, and almonds, then transfer the mixture to a baking sheet."
    },
    {
      "step": 4,
      "text": "Bake for 15 minutes, until lightly browned.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Let the toasted mixture cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Combine the cabbage, green onions, and cooled ramen mixture in a large bowl."
    },
    {
      "step": 7,
      "text": "Add the dressing and toss until evenly coated."
    }
  ],
