  "instructions": [
    {
      "step": 1,
      "text": "Place the beets in a pot and cook until tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Add the carrots and potatoes, bring to a simmer, and cook until all the vegetables are tender."
    },
    {
      "step": 3,
      "text": "Drain the vegetables and chill them thoroughly for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 4,
      "text": "Peel and dice the beets, carrots, and potatoes, then transfer them to a large bowl."
    },
    {
      "step": 5,
      "text": "Stir in the onion, peas, dill pickles, olive oil, salt, and ground black pepper."
    },
    {
      "step": 6,
      "text": "Garnish with the parsley and serve chilled."
    }
  ],
