  "id": "bacon-ranch-parmesan-pasta-salad",
  "name": "Bacon Ranch Parmesan Pasta Salad",
  "subtitle": "Chilled bow-tie pasta with crisp bacon and vegetables",
  "description": "A creamy pasta salad combining ranch dressing, bacon, fresh vegetables, and shredded Parmesan.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
