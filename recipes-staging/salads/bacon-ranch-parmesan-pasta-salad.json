    "inactive_minutes": 150
  },
  "ingredients": [
    {
      "ingredient_id": "farfalle-bow-tie-pasta",
      "item": "farfalle (bow tie) pasta",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 6
    },
    {
      "ingredient_id": "prepared-ranch-dressing",
      "item": "prepared ranch dressing",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
      "preparation": "diced"
    },
    {
      "ingredient_id": "carrot",
      "item": "carrot",
      "quantity": 1,
      "preparation": "peeled and diced"
    },
    {
      "ingredient_id": "stalk-celery",
      "item": "stalk celery",
      "quantity": 1,
      "preparation": "diced"
    },
    {
      "ingredient_id": "parmesan-cheese",
      "item": "Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer. Add the farfalle and cook for 12 minutes, or until tender.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Drain the pasta, let it cool, transfer it to a bowl, and chill."
    },
    {
      "step": 3,
      "text": "Cook the bacon for about 10 minutes, or until crisp. Drain, cool, and cut it into pieces.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Combine the bacon, ranch dressing, red onion, carrot, celery, and Parmesan in a large bowl."
    },
    {
      "step": 5,
      "text": "Add the chilled pasta and stir until evenly coated."
    },
    {
      "step": 6,
      "text": "Chill the pasta salad for 2 hours before serving.",
      "timer_minutes": 120
    }
  ],
