      "item": "red chilli finely chopped",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sliced chicory, iceberg lettuce, and chopped parsley in a serving bowl."
    },
    {
      "step": 2,
      "text": "Whisk the olive oil and white wine vinegar together to make the dressing."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the greens and toss to coat. Add the cubed gorgonzola and finely chopped red chili, then toss gently."
    },
    {
      "step": 4,
      "text": "Serve immediately."
    }
  ],
