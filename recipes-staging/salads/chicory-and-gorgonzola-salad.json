  "id": "chicory-and-gorgonzola-salad",
  "name": "Chicory and Gorgonzola Salad",
  "subtitle": "Crisp greens with blue cheese and chili",
  "description": "A quick salad combining bitter chicory, crisp iceberg lettuce, parsley, tangy dressing, creamy gorgonzola, and fresh chili.",
  "meal_type": "salad",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
