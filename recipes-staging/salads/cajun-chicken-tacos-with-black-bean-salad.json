  "instructions": [
    {
      "step": 1,
      "text": "Toss the chicken with the Cajun spice mix and olive oil until evenly coated."
    },
    {
      "step": 2,
      "text": "Heat the cooking surface, add the chicken, and cook for about 8 minutes, turning as needed, until opaque throughout and the thickest piece reaches 165°F on a food thermometer.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Shred or pull the cooked chicken into bite-size pieces."
    },
    {
      "step": 4,
      "text": "Mix the black beans, sweetcorn, cucumber, avocado, coriander, and lime juice. Stir in the chopped chilli if using."
    },
    {
      "step": 5,
      "text": "Warm the soft tacos, fill them with the chicken, and serve with the black bean salad.",
      "timer_minutes": 2
    }
  ],
