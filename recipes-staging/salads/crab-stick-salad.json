  "id": "crab-stick-salad",
  "name": "Crab Stick Salad",
  "subtitle": "Chilled rice noodle salad with creamy dill dressing",
  "description": "Rice noodles, crisp vegetables, and crab sticks are tossed with a creamy yogurt dressing and chilled for a refreshing salad.",
  "meal_type": "salad",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "rice-noodles",
      "item": "rice noodles",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "cucumber-diced",
      "item": "cucumber diced",
      "quantity": 1
    },
    {
