      "item": "natural yogurt",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "of-garlic-granules",
      "item": "of garlic granules",
      "unit": "pinch"
    },
    {
      "ingredient_id": "bunch-dill-finely-chopped",
      "item": "bunch dill finely chopped",
      "unit": "small"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the rice noodles in boiling water and let them stand for 15 minutes, or until tender. Drain and cool completely.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Combine the mayonnaise, natural yogurt, garlic granules, and dill."
    },
    {
      "step": 3,
      "text": "Add the cooled noodles, cucumber, radishes, and crab sticks to the dressing. Toss gently to combine."
    },
    {
      "step": 4,
      "text": "Confirm the crab sticks are a ready-to-eat cooked product; if not, cook them according to the package directions until opaque before adding. Chill the salad before serving."
    }
  ],
