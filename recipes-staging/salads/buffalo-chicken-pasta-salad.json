  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer and add the salt. Stir in the rotini, then cook for about 8 minutes, or until tender. Drain and set aside.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Whisk together the blue cheese dressing, mayonnaise, buffalo wing sauce, salt, black pepper, red bell pepper, and green bell pepper."
    },
    {
      "step": 3,
      "text": "Add the pasta, diced cooked chicken, red onion, and the dressing mixture to a large bowl. Stir until evenly coated. If reheating the chicken, heat it to 165°F."
    },
    {
      "step": 4,
      "text": "Cover and chill for 60 minutes before serving.",
      "timer_minutes": 60
    }
  ],
