  "instructions": [
    {
      "step": 1,
      "text": "Use only leftover grilled chicken that was fully cooked to 165°F before chilling."
    },
    {
      "step": 2,
      "text": "Whisk 1 cup mayonnaise with the ground black pepper, garlic powder, and celery salt until smooth."
    },
    {
      "step": 3,
      "text": "Combine the chopped chicken, sliced celery, salted cashews, and dried cranberries in a bowl."
    },
    {
      "step": 4,
      "text": "Stir in the seasoned mayonnaise and 4 tablespoons mayonnaise until the mixture is evenly coated."
    },
    {
      "step": 5,
      "text": "Place lettuce and sliced tomato on four toasted bread slices. Add the chicken salad, top with the remaining toast, and serve."
    }
  ],
