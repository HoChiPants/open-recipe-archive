  "instructions": [
    {
      "step": 1,
      "text": "Place the sliced potatoes in a pot, cover with water, and bring to a simmer. Cook until tender, about 15 minutes, then drain.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Whisk the mayonnaise, cider vinegar, vegetable oil, sugar, parsley, salt, and black pepper into a smooth dressing."
    },
    {
      "step": 3,
      "text": "Toss the warm potatoes and chopped onion with the dressing until evenly coated."
    },
    {
      "step": 4,
      "text": "Cover and refrigerate for at least 60 minutes before serving.",
      "timer_minutes": 60
    }
  ],
