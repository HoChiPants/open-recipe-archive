  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer and cook the tortellini for 8 minutes, or until tender. Drain and cool.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Combine the cooled tortellini with the bell pepper, broccoli, carrots, olives, garlic, and olive oil."
    },
    {
      "step": 3,
      "text": "Whisk the mayonnaise, pesto, milk, Parmesan, and vinegar in a bowl until smooth."
    },
    {
      "step": 4,
      "text": "Pour the dressing over the tortellini mixture and toss to coat."
    },
    {
      "step": 5,
      "text": "Serve the salad over the spinach leaves."
    }
  ],
