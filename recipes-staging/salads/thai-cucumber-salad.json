  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "thai-cucumber-salad",
  "name": "Thai Cucumber Salad",
  "subtitle": "Crisp cucumbers with sweet-tangy dressing and peanuts",
  "description": "Salted cucumbers are tossed with rice vinegar, jalapeño, cilantro, and peanuts for a refreshing Thai-style salad.",
  "meal_type": "salad",
  "cuisine": "Thai",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "cucumber",
      "item": "cucumbers",
      "quantity": 3,
      "unit": "large",
      "preparation": "peeled, halved lengthwise, seeded, and cut into 1/4-inch slices"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "rice-wine-vinegar",
      "item": "rice wine vinegar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "jalapeno-peppers",
      "item": "jalapeno peppers",
      "quantity": 2,
      "unit": "medium",
      "preparation": "seeded and chopped"
    },
    {
      "ingredient_id": "cilantro",
      "item": "cilantro",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "peanuts",
      "item": "peanuts",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Toss the sliced cucumbers with the salt and let them stand in a colander for 30 minutes. Drain well, then drain again if excess liquid remains.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Whisk the sugar and rice wine vinegar in a large bowl until combined."
    },
    {
      "step": 3,
      "text": "Add the cucumbers, jalapeños, and cilantro to the dressing and toss to coat."
    },
    {
      "step": 4,
      "text": "Fold in the chopped peanuts and serve."
    }
  ],
