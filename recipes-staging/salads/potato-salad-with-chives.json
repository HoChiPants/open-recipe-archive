  "id": "potato-salad-with-chives",
  "name": "Potato Salad with Chives",
  "subtitle": "Creamy potato salad with fresh chives",
  "description": "Tender new potatoes are coated in a tangy sour-cream and mayonnaise dressing with fresh chives.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "new-potatoes",
      "item": "new potatoes",
      "quantity": 1.75,
      "unit": "pounds",
      "preparation": "halved"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-chives",
      "item": "fresh chives",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the halved potatoes in a saucepan and cover with cold water. Bring to a simmer and cook until tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Drain the potatoes and let them cool briefly."
    },
    {
      "step": 3,
      "text": "Stir together the sour cream, mayonnaise, and chopped chives. Season with salt and freshly ground black pepper."
    },
    {
      "step": 4,
      "text": "Fold the potatoes into the dressing until evenly coated. Garnish with fresh chives and serve."
    }
  ],
