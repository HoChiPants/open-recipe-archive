      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Simmer the beets in water until tender, about 30 minutes. Drain and let cool.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Simmer the potatoes and carrots separately or together until tender, about 20 minutes. Drain and cool.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Peel and cut the cooled beets, potatoes, and carrots into bite-size pieces."
    },
    {
      "step": 4,
      "text": "Combine the vegetables with the diced dill pickles and chopped green onions."
    },
    {
      "step": 5,
      "text": "Whisk the vegetable oil, champagne vinegar, and salt together, then pour over the salad and toss to coat."
    },
    {
      "step": 6,
      "text": "Chill for 60 minutes before serving.",
      "timer_minutes": 60
    }
  ],
