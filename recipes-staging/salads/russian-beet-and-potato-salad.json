  "id": "russian-beet-and-potato-salad",
  "name": "Russian Beet and Potato Salad",
  "subtitle": "A chilled salad of tender vegetables, pickles, and dill",
  "description": "Boiled beets, potatoes, and carrots are combined with diced pickles, green onions, and a simple oil-vinegar dressing, then chilled before serving.",
  "meal_type": "salad",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
