      "preparation": "chopped"
    },
    {
      "ingredient_id": "4-ounce-jar-diced-pimento-peppers",
      "item": "(4 ounce) jar diced pimento peppers",
      "quantity": 1,
      "preparation": "drained"
    },
    {
      "ingredient_id": "mustard-seed",
