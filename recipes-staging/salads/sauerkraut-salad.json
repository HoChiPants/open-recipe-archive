  "id": "sauerkraut-salad",
  "name": "Sauerkraut Salad",
  "subtitle": "A crisp, tangy vegetable salad with a sweet cider dressing",
  "description": "Combine sauerkraut and chopped vegetables with mustard seed, then coat with a gently heated sugar-and-vinegar dressing for a bright, crunchy salad.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
