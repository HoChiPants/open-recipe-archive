      "item": "vegetable oil",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cider-vinegar",
      "item": "cider vinegar",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sauerkraut, onion, celery, bell pepper, carrots, pimento peppers, and mustard seed in a large bowl."
    },
    {
      "step": 2,
      "text": "Place the sugar, vegetable oil, and cider vinegar in a saucepan. Heat gently, stirring, until the sugar dissolves and the dressing reaches a simmer."
    },
    {
      "step": 3,
      "text": "Pour the warm dressing over the sauerkraut mixture and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Serve the salad."
    }
  ],
