      "ingredient_id": "chili-powder",
      "item": "chili powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stack the basil leaves, roll them tightly, and slice into thin ribbons. Cut the watermelon into cubes if needed."
    },
    {
      "step": 2,
      "text": "Combine the watermelon and basil in a serving bowl. Drizzle with the lemon juice."
    },
    {
      "step": 3,
      "text": "Mix the kosher salt and chili powder, then sprinkle over the watermelon. Toss gently to coat."
    },
    {
      "step": 4,
      "text": "Cover and chill for 30 minutes before serving.",
      "timer_minutes": 30
    }
  ],
