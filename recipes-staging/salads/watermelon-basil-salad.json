  "id": "watermelon-basil-salad",
  "name": "Watermelon Basil Salad",
  "subtitle": "Chilled watermelon with lemon and chili",
  "description": "A refreshing fruit salad combining sweet watermelon, fresh basil, bright lemon juice, and a lightly spicy seasoning.",
  "meal_type": "salad",
  "cuisine": "American",
