  "id": "tomato-watermelon-salad",
  "name": "Tomato Watermelon Salad",
  "subtitle": "A crisp fruit-and-tomato salad with feta and mint",
  "description": "Juicy watermelon and tomatoes are paired with sweet onion, feta, and mint, then finished with a bright balsamic dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "seedless-watermelon",
      "item": "seedless watermelon",
      "quantity": 1,
      "unit": "large",
      "preparation": "cut into 1-inch cubes"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 4,
      "preparation": "cut into 1-inch dice"
    },
    {
      "ingredient_id": "crumbled-feta-cheese",
      "item": "crumbled feta cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sweet-onion",
      "item": "sweet onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "mint-leaves",
      "item": "mint leaves",
      "quantity": 12,
      "preparation": "sliced thinly"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-balsamic-vinegar",
      "item": "white balsamic vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "coarse-salt",
      "item": "coarse salt",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the olive oil, white balsamic vinegar, coarse salt, and ground black pepper together in a small bowl."
    },
    {
      "step": 2,
      "text": "Place the watermelon, tomatoes, sweet onion, mint leaves, and crumbled feta cheese in a large serving bowl."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the salad and toss gently until the ingredients are evenly coated."
    }
  ],
