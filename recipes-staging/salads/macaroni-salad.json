  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water and the salt to a simmer."
    },
    {
      "step": 2,
      "text": "Add the macaroni and cook in boiling water for 8 minutes, or until tender. Drain, cool, and drain again.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Stir together the mayonnaise, minced onion, parsley, mustard, vinegar, sugar, and celery seed."
    },
    {
      "step": 4,
      "text": "Fold in the cooled macaroni and chopped eggs until evenly coated."
    },
    {
      "step": 5,
      "text": "Cover and chill for 30 minutes before serving.",
      "timer_minutes": 30
    }
  ],
