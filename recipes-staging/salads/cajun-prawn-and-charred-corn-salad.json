  "id": "cajun-prawn-and-charred-corn-salad",
  "name": "Cajun Prawn and Charred Corn Salad",
  "subtitle": "Spiced prawns with sweet corn, avocado, and lime",
  "description": "A crisp salad combining charred corn, Cajun-seasoned prawns, fresh vegetables, and a bright lime-honey dressing.",
  "meal_type": "salad",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
