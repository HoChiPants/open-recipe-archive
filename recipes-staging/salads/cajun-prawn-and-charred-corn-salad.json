      "ingredient_id": "corn-kernels",
      "item": "corn kernels",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "raw-king-prawns-peeled-and-deveined",
      "item": "raw king prawns peeled and deveined",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "cajun-spice-blend",
      "item": "Cajun spice blend",
      "quantity": "1/2",
      "unit": "tbsp"
    },
    {
