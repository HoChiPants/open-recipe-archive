  "instructions": [
    {
      "step": 1,
      "text": "Heat 1 tablespoon of the sunflower oil in a large skillet over medium-high heat. Add the corn and cook for about 5 minutes, stirring occasionally, until charred. Transfer to a bowl and let cool briefly.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Toss the prawns with the Cajun spice blend and half of the chopped red pepper."
    },
    {
      "step": 3,
      "text": "Add the remaining sunflower oil to the skillet, then cook the seasoned prawns with the corn for about 4 minutes, turning once, until the prawns are opaque and cooked through.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Whisk the lime juice and honey with the jalapeño, if using, and the remaining red pepper."
    },
    {
      "step": 5,
      "text": "Add the avocado, spring onions, coriander, and romaine lettuce to the dressing; toss to coat."
    },
    {
      "step": 6,
      "text": "Fold in the warm corn and prawns, then serve."
    }
  ],
