  "instructions": [
    {
      "step": 1,
      "text": "Mix the garlic, 3 tablespoons olive oil, one lemon's juice, cumin, coriander, smoked paprika, cinnamon, chilli powder, oregano, and 1 tablespoon yogurt. Coat the chicken thoroughly and set aside for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Stir the tahini, one lemon's juice, 200 g yogurt, and cumin seeds together to make the dressing."
    },
    {
      "step": 3,
      "text": "Combine the cabbage, onions, cucumber, tomatoes, and lettuce. Toss with the remaining lemon juice and 2 tablespoons olive oil."
    },
    {
      "step": 4,
      "text": "Heat a large skillet or grill pan over medium-high heat. Cook the chicken for about 5 minutes per side, or until the thickest part reaches 165°F and the meat is cooked through.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Rest the chicken briefly, then slice it. Serve over the salad with the tahini dressing, adding the optional pittas, flatbreads, and pickled chillies."
    }
  ],
