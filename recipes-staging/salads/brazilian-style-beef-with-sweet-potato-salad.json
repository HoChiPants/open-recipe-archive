  "instructions": [
    {
      "step": 1,
      "text": "Mix the lime zest and juice, tamarind paste, cumin, chopped coriander, and smoked paprika. Coat the steaks with half of the mixture and set aside while preparing the vegetables."
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a large covered pan. Add the whole onion, sweet potato, pepper, courgette, and bay leaf. Cook gently, covered, until the vegetables are tender, about 20 minutes, turning the onion occasionally.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Remove the bay leaf. Slice the cooked onion and return it to the pan with the drained beans and the remaining lime-tamarind mixture. Warm through and season as needed."
    },
    {
      "step": 4,
      "text": "Cook the steaks in a hot grill pan or barbecue until browned and cooked to preference. For food safety, use a thermometer to reach 145°F, then rest for 3 minutes."
    },
    {
      "step": 5,
      "text": "Serve the steaks with the warm sweet potato and bean salad."
    }
  ],
