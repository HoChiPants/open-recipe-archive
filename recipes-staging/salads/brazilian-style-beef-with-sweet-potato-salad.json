  "id": "brazilian-style-beef-with-sweet-potato-salad",
  "name": "Brazilian-Style Beef with Sweet Potato Salad",
  "subtitle": "Spiced fillet steak with warm vegetables and beans",
  "description": "Tamarind, lime, cumin, and smoked paprika season tender beef served with a warm sweet potato, vegetable, and bean salad.",
  "meal_type": "salad",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
