  "id": "baked-feta-and-bean-salad",
  "name": "Baked Feta and Bean Salad",
  "subtitle": "Warm feta, beans, crisp vegetables, and a tangy green dressing",
  "description": "A hearty salad combining grilled honeyed feta with beans, asparagus, pepper, fresh mint, and leafy greens.",
  "meal_type": "salad",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
