  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill."
    },
    {
      "step": 2,
      "text": "Place the feta on a grill-safe tray. Coat it with the olive oil and honey, then sprinkle with the fennel seeds and chilli flakes."
    },
    {
      "step": 3,
      "text": "Grill the feta until warmed and lightly browned, about 10 minutes. Set it aside to cool slightly.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Combine the asparagus, green pepper, drained beans, salad leaves, and chopped mint in a large bowl."
    },
    {
      "step": 5,
      "text": "Whisk the apple cider vinegar, green aïoli, and mustard together to make the dressing."
    },
    {
      "step": 6,
      "text": "Toss the salad with the dressing, transfer it to a serving dish, and top with the feta. Serve with toasted ciabatta if desired."
    }
  ],
