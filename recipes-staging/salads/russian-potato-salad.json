  "id": "russian-potato-salad",
  "name": "Russian Potato Salad",
  "subtitle": "A creamy potato salad with peas, pickles, eggs, and turkey hot dogs",
  "description": "Tender potatoes, chopped vegetables, peas, eggs, and turkey hot dogs are folded with mayonnaise for a hearty chilled salad.",
  "meal_type": "salad",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 5,
      "unit": "large"
    },
    {
      "ingredient_id": "turkey-hot-dogs",
      "item": "turkey hot dogs",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 5
    },
    {
      "ingredient_id": "dill-pickles",
      "item": "dill pickles",
      "quantity": 5,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "bunch-green-onions",
      "item": "bunch green onions",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "baby-peas",
      "item": "baby peas",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, drained"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes in a pot, cover with water, and bring to a simmer. Cook for 20 minutes, or until tender; drain and cool.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "In a separate pot, simmer the turkey hot dogs and eggs for 10 minutes. Heat the turkey hot dogs to 165°F, and cook the eggs until the whites and yolks are fully set, reaching 160°F if checked with a thermometer. Cool.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Cut the cooled potatoes and turkey hot dogs into bite-size pieces. Chop the cooled eggs."
    },
    {
      "step": 4,
      "text": "Combine the potatoes, turkey hot dogs, eggs, dill pickles, green onions, and drained baby peas."
    },
    {
      "step": 5,
      "text": "Fold in the mayonnaise, season with salt, and mix gently until combined."
    }
  ],
