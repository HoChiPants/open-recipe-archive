  "id": "apple-and-penne-slaw-with-walnuts",
  "name": "Apple and Penne Slaw with Walnuts",
  "subtitle": "A crisp, creamy pasta salad with fruit and chickpeas",
  "description": "Wholewheat penne, apples, celery, chickpeas, raisins, and walnuts are tossed with a tangy yogurt dressing and served over lettuce.",
  "meal_type": "salad",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
