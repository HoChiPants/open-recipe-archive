  ],
  "instructions": [
    {
      "step": 1,
      "text": "Simmer the penne for 12 minutes, or until tender. Drain and let it cool briefly.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Whisk the yogurt, apple cider vinegar, mustard powder, and chopped spring onions together."
    },
    {
      "step": 3,
      "text": "Toss the penne with the chopped celery, drained chickpeas, and raisins."
    },
    {
      "step": 4,
      "text": "Core and chop the apples, then fold them into the pasta mixture with the dressing."
    },
    {
      "step": 5,
      "text": "Arrange the lettuce leaves on plates. Spoon over the slaw and scatter with the broken walnuts."
    }
  ],
