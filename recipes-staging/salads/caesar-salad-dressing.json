  "id": "caesar-salad-dressing",
  "name": "Caesar Salad Dressing",
  "subtitle": "A savory, tangy dressing with garlic and anchovies",
  "description": "A quick creamy dressing combining garlic, anchovies, Parmesan, mayonnaise, and white wine vinegar.",
  "meal_type": "salad",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
