    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "garlic",
      "item": "garlic clove",
      "quantity": 1
    },
    {
      "ingredient_id": "anchovies-in-oil",
      "item": "anchovies in oil",
      "quantity": 2
    },
    {
      "ingredient_id": "parmesan",
      "item": "parmesan",
      "quantity": 15,
      "unit": "g"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 5,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mince or finely mash the garlic clove and anchovies together."
    },
    {
      "step": 2,
      "text": "Stir in the Parmesan, mayonnaise, and white wine vinegar until combined."
    },
    {
      "step": 3,
      "text": "Continue stirring until the dressing is smooth and evenly blended."
    },
    {
      "step": 4,
      "text": "Transfer to a bowl and use as a salad dressing."
    }
  ],
