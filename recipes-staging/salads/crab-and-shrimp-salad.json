  "id": "crab-and-shrimp-salad",
  "name": "Crab and Shrimp Salad",
  "subtitle": "A chilled seafood salad with dill dressing",
  "description": "Flaked crab and chopped shrimp combine with crisp vegetables in a creamy dill dressing for a simple chilled salad.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
