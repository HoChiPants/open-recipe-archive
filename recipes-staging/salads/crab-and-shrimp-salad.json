      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "For this no-cook salad, use ready-to-eat cooked shellfish; shellfish should be opaque and fully cooked."
    },
    {
      "step": 2,
      "text": "Combine the crabmeat, shrimp, onion, bell pepper, celery, salt, and pepper in a bowl."
    },
    {
      "step": 3,
      "text": "Stir the mayonnaise, dill, and Worcestershire sauce together until combined."
    },
    {
      "step": 4,
      "text": "Fold the dressing into the seafood mixture until evenly coated."
    },
    {
      "step": 5,
      "text": "Cover and chill for 60 minutes before serving.",
      "timer_minutes": 60
    }
  ],
