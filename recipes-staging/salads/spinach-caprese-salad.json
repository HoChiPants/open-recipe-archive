      "item": "extra-virgin olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Arrange the baby spinach leaves on a serving platter or divide between two plates."
    },
    {
      "step": 2,
      "text": "Add the sliced tomato and sliced mozzarella, arranging them over the spinach."
    },
    {
      "step": 3,
      "text": "Scatter the chopped basil over the salad."
    },
    {
      "step": 4,
      "text": "Combine the balsamic vinegar and olive oil, then drizzle the dressing over the salad before serving."
    }
