  "id": "spinach-caprese-salad",
  "name": "Spinach Caprese Salad",
  "subtitle": "A bright salad of spinach, tomato, mozzarella, and basil",
  "description": "Layer fresh vegetables and mozzarella over spinach, then finish with a simple balsamic-oil dressing.",
  "meal_type": "salad",
