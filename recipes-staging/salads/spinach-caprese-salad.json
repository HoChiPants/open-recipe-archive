      "ingredient_id": "baby-spinach-leaves",
      "item": "baby spinach leaves",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomato",
      "quantity": 1,
      "unit": "large",
      "preparation": "sliced 3/4 inch thick"
    },
    {
      "ingredient_id": "ball-of-fresh-mozzarella-cheese",
      "item": "ball of fresh mozzarella cheese",
      "quantity": 1,
