  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water seasoned with salt and pepper to a simmer. Add the potatoes and cook until tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Drain the potatoes, let them cool enough to handle, and cut them into bite-size pieces."
    },
    {
      "step": 3,
      "text": "Whisk the lemon juice, Italian-style salad dressing, minced green bell pepper, and salt and pepper together."
    },
    {
      "step": 4,
      "text": "Combine the potatoes, cucumber, red onion, and feta in a large bowl. Add the dressing and toss to coat."
    },
    {
      "step": 5,
      "text": "Serve the salad with the pita wedges."
    }
  ],
