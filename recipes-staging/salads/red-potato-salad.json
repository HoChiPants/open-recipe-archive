  "id": "red-potato-salad",
  "name": "Red Potato Salad",
  "subtitle": "A creamy salad with tender potatoes, eggs, celery, and green onions.",
  "description": "Boiled red potatoes and eggs are folded with crisp vegetables and a tangy mayonnaise dressing, then chilled before serving.",
  "meal_type": "salad",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "unpeeled-red-potatoes",
      "item": "unpeeled red potatoes",
      "quantity": 3,
      "unit": "pounds"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "celery",
      "item": "celery",
      "quantity": 1,
      "unit": "cup",
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the unpeeled red potatoes in a pot, cover with water, and add the salt. Bring to a simmer and cook for about 20 minutes, until tender when pierced.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Drain the potatoes, let them cool enough to handle, and cut them into bite-size pieces."
    },
    {
      "step": 3,
      "text": "Place the eggs in a saucepan, cover with water, and bring to a boil. Cook for 12 minutes, then cool, peel, and chop them.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Whisk the mayonnaise, sliced green onions, milk, distilled white vinegar, salt, and ground black pepper until combined."
    },
    {
      "step": 5,
      "text": "Combine the potatoes, eggs, and sliced celery in a large bowl. Add the dressing and fold gently until evenly coated."
    },
    {
      "step": 6,
      "text": "Cover and chill for 2 hours before serving.",
      "timer_minutes": 120
    }
  ],
