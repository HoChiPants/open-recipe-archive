  "id": "egg-salad-with-olives",
  "name": "Egg Salad with Olives",
  "subtitle": "A creamy, peppery salad with briny olive flavor",
  "description": "Chopped hard-cooked eggs are folded with seasoned mayonnaise and pimento-stuffed green olives for an easy salad or sandwich filling.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 8
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "pimento-stuffed-green-olives",
      "item": "pimento-stuffed green olives",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the eggs in a saucepan, cover with water, and bring to a boil. Boil until hard-cooked, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Cool the eggs briefly, peel them, and cut them into small pieces."
    },
    {
      "step": 3,
      "text": "Combine the eggs, mayonnaise, black pepper, and paprika. Stir until smooth, then fold in the chopped olives."
    },
    {
      "step": 4,
      "text": "Chill before serving."
    }
  ],
