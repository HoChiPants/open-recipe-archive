  "instructions": [
    {
      "step": 1,
      "text": "Combine the chicken, celery, green grapes, red grapes, dried cranberries, and dried chives in a large bowl."
    },
    {
      "step": 2,
      "text": "Whisk the honey, Dijon mustard, mayonnaise, salt, and black pepper in a separate bowl until smooth."
    },
    {
      "step": 3,
      "text": "Fold the dressing into the chicken mixture until evenly coated. Use fully cooked chicken; if the chicken is not fully cooked, heat it to 165°F before cooling and mixing."
    }
  ],
