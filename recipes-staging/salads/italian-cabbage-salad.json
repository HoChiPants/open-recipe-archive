    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 7,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "tarragon-vinegar",
      "item": "tarragon vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "head-green-cabbage",
      "item": "head green cabbage",
      "quantity": 0.5,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 0.5,
      "preparation": "thinly sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the tarragon vinegar, lemon juice, sugar, salt, and black pepper. Gradually whisk in the canola oil until combined."
    },
    {
      "step": 2,
      "text": "Place the sliced cabbage and red onion in a large bowl."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the vegetables and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Cover and refrigerate for 60 minutes before serving.",
      "timer_minutes": 60
    }
  ],
