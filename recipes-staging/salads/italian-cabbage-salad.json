  "id": "italian-cabbage-salad",
  "name": "Italian Cabbage Salad",
  "subtitle": "Crisp cabbage and onion in a bright vinaigrette",
  "description": "A make-ahead salad of thinly sliced cabbage and red onion tossed with a tangy, lightly sweet dressing.",
  "meal_type": "salad",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
