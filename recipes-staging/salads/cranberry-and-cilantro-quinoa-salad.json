  "instructions": [
    {
      "step": 1,
      "text": "Bring the water to a simmer in a saucepan. Add the rinsed quinoa, cover, and simmer for 20 minutes, or until the water is absorbed and the quinoa is tender.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Transfer the quinoa to a bowl and chill thoroughly."
    },
    {
      "step": 3,
      "text": "Stir in the red onion, carrots, dried cranberries, red and yellow bell peppers, cilantro, almonds, lime juice, curry powder, salt, and pepper."
    },
    {
      "step": 4,
      "text": "Chill the salad before serving."
    }
