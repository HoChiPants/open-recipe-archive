      "item": "feta cheese",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "cut into 1/4-inch cubes"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the olive oil, white balsamic vinegar, and kosher salt in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the grape tomatoes, arugula, and red onion; toss until evenly coated."
    },
    {
      "step": 3,
      "text": "Gently stir in the watermelon and feta cheese, then serve."
    }
