  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "white-balsamic-vinegar",
      "item": "white balsamic vinegar",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "grape-tomatoes",
      "item": "grape tomatoes",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "halved"
    },
