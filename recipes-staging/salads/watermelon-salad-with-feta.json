  "id": "watermelon-salad-with-feta",
  "name": "Watermelon Salad with Feta",
  "subtitle": "A crisp fruit-and-greens salad with tangy cheese",
  "description": "Juicy watermelon, tomatoes, arugula, and red onion are dressed with white balsamic vinaigrette and finished with feta.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
