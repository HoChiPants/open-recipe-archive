      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Chop the hard-cooked eggs, reserving a small portion if desired for garnish."
    },
    {
      "step": 2,
      "text": "In a large bowl, stir together the mayonnaise, chives, mustard, celery salt, paprika, kosher salt, and black pepper."
    },
    {
      "step": 3,
      "text": "Fold in the chopped eggs until evenly coated. Serve chilled."
    }
  ],
