      "item": "low-fat mayonnaise",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-chives",
      "item": "fresh chives",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "celery-salt",
      "item": "celery salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
