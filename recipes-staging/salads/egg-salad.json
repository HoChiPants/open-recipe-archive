  "id": "egg-salad",
  "name": "Egg Salad",
  "subtitle": "Chopped eggs folded with a creamy chive-mustard dressing.",
  "description": "A simple chilled egg salad for sandwiches, wraps, or a bed of greens.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
