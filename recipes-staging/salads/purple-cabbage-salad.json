  "id": "purple-cabbage-salad",
  "name": "Purple Cabbage Salad",
  "subtitle": "A crisp salad with citrus, cranberries, and toasted pine nuts",
  "description": "Shredded cabbage, mandarin oranges, green onion, and cranberries are tossed with a sweet-tart dressing and toasted pine nuts.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "red-cabbage",
      "item": "red cabbage",
      "quantity": 2.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "mandarin-oranges",
      "item": "mandarin oranges",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce, drained"
    },
    {
      "ingredient_id": "green-onion",
      "item": "green onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "sweetened-dried-cranberries",
      "item": "sweetened dried cranberries",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "pine-nuts",
      "item": "pine nuts",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "vinegar",
      "item": "vinegar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "pinches"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the cabbage, drained mandarin oranges, green onion, and dried cranberries in a large bowl."
    },
    {
      "step": 2,
      "text": "Heat the pine nuts for 2 minutes, until lightly browned. Remove from the heat and let cool.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Whisk together the canola oil, vinegar, sugar, and salt."
    },
    {
      "step": 4,
      "text": "Stir the cooled pine nuts into the cabbage mixture, then pour over the dressing and toss to coat."
    }
  ],
