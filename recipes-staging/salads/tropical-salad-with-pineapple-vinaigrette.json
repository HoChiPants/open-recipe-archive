  "instructions": [
    {
      "step": 1,
      "text": "Arrange the bacon for cooking and preheat the cooking appliance as directed; cook the bacon for about 10 minutes, or until crisp. Drain well and crumble.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the pineapple juice, red wine vinegar, olive oil, pepper, and salt together to make the vinaigrette."
    },
    {
      "step": 3,
      "text": "Combine the chopped romaine, diced pineapple, crumbled bacon, chopped macadamia nuts, and green onions in a large salad bowl."
    },
    {
      "step": 4,
      "text": "Toss the salad with enough vinaigrette to coat it evenly."
    },
    {
      "step": 5,
      "text": "Top with the toasted macadamia nuts and toasted coconut, then serve."
    }
  ],
