  "instructions": [
    {
      "step": 1,
      "text": "Cook the penne or farfalle in boiling water until tender. Drain well and leave to cool."
    },
    {
      "step": 2,
      "text": "Whisk the yogurt, mustard, honey, crushed garlic, lemon zest, and olive oil into a smooth dressing."
    },
    {
      "step": 3,
      "text": "Combine the chopped tomatoes, spinach, and basil in a large bowl. Add the cooled pasta and dressing, then toss to coat."
    },
    {
      "step": 4,
      "text": "Top with the cooked bacon rashers and serve."
    }
  ],
