  "id": "hot-chicken-salad",
  "name": "Hot Chicken Salad",
  "subtitle": "A warm baked chicken salad with creamy dressing and a crisp cereal topping.",
  "description": "Combine cooked chicken with vegetables, almonds, cheese, and a tangy creamy dressing, then bake until hot and lightly crisp on top.",
  "meal_type": "salad",
