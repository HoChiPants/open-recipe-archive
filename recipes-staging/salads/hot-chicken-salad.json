  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Combine the diced chicken, celery, almonds, mayonnaise, sour cream, shredded cheese, lemon juice, and onion in a baking dish."
    },
    {
      "step": 3,
      "text": "Spread the mixture evenly, then cover the surface with the crushed cornflakes cereal."
    },
    {
      "step": 4,
      "text": "Bake for 45 minutes, until hot throughout and the topping is lightly crisp.",
      "timer_minutes": 45
    }
  ],
