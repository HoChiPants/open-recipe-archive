  "instructions": [
    {
      "step": 1,
      "text": "Place the black beans, corn, green onions, jalapenos, bell pepper, avocado, pimentos, tomatoes, and cilantro in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the lime juice and Italian salad dressing, then toss gently until evenly coated."
    },
    {
      "step": 3,
      "text": "Season with the garlic salt and mix briefly to distribute it."
    },
    {
      "step": 4,
      "text": "Cover and chill until ready to serve."
    }
