  "id": "wilted-spinach-salad",
  "name": "Wilted Spinach Salad",
  "subtitle": "Fresh spinach with warm bacon-and-vinegar dressing",
  "description": "Tender spinach and sliced green onions are tossed with crisp bacon, hard-boiled eggs, and a warm, tangy dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6
    },
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "bunches-fresh-spinach",
      "item": "bunches fresh spinach",
      "quantity": 2,
      "preparation": "rinsed and dried"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 4,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-vinegar",
      "item": "white vinegar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "red-wine-vinegar",
      "item": "red wine vinegar",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the 6 eggs in a saucepan, cover with water, and bring to a boil. Cook for 12 minutes, then cool, peel, and slice.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Cook the bacon in a skillet until crisp. Drain, reserving the rendered fat in the skillet, and cut the bacon into pieces."
    },
    {
      "step": 3,
      "text": "Combine the spinach and green onions in a large bowl."
    },
    {
      "step": 4,
      "text": "Warm the reserved bacon fat over medium heat. Whisk in the 2 eggs, white sugar, white vinegar, and red wine vinegar."
    },
    {
      "step": 5,
      "text": "Cook, whisking constantly, for 1 minute, until the dressing thickens and reaches 160°F.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Pour the warm dressing over the spinach and onions, add the bacon, and toss to coat."
    },
    {
      "step": 7,
      "text": "Garnish with the sliced eggs and serve immediately."
    }
  ],
