  "instructions": [
    {
      "step": 1,
      "text": "Stir together the tamari, curry powder, cumin, grated garlic, and honey. Coat the chicken thoroughly and leave to marinate for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Mix the peanut butter, sweet chilli sauce, and lime juice until smooth."
    },
    {
      "step": 3,
      "text": "Heat a lightly oiled pan over medium heat. Cook the chicken for about 6 minutes, turning as needed, until the thickest part reaches 165°F.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Let the chicken rest briefly, then slice it."
    },
    {
      "step": 5,
      "text": "Arrange the lettuce, cucumber, shallot, coriander, and pomegranate seeds on two plates. Add the chicken and spoon over the peanut dressing."
    }
  ],
