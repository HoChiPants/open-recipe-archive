  "id": "rainbow-beef-salad",
  "name": "Rainbow Beef Salad",
  "subtitle": "Grilled sirloin with crisp vegetables and lime dressing",
  "description": "Tender grilled sirloin tops a colorful salad of lettuce, vegetables, avocado, sesame, and a bright lime dressing.",
  "meal_type": "salad",
