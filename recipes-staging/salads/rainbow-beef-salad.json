  "instructions": [
    {
      "step": 1,
      "text": "Combine the ginger, garlic, chillies, lime juice, sesame oil, and soy sauce in a bowl. Reserve some sliced chilli for finishing."
    },
    {
      "step": 2,
      "text": "Coat the steaks with part of the dressing and set aside while preparing the salad."
    },
    {
      "step": 3,
      "text": "Arrange the lettuces, radishes, carrots, cucumber ribbons, spring onions, and avocado on a serving platter."
    },
    {
      "step": 4,
      "text": "Heat a barbecue or grill. Cook the steaks for 3 minutes per side, or until the center reaches 145°F.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Transfer the steaks to a board and rest for 5 minutes. Slice thinly against the grain.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Top the salad with the sliced beef, drizzle with the remaining dressing, and scatter over the reserved chilli and sesame seeds."
    }
  ],
