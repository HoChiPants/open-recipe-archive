  "id": "summer-corn-salad",
  "name": "Summer Corn Salad",
  "subtitle": "Sweet corn, tomatoes, basil, and onion with a light vinegar dressing",
  "description": "Boiled corn and fresh vegetables are tossed with basil and a simple olive oil–vinegar dressing, then chilled for serving.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "ears-corn",
      "item": "ears corn",
      "quantity": 6,
      "preparation": "husked and cleaned"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 3,
      "unit": "large",
      "preparation": "diced"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "diced"
    },
    {
      "ingredient_id": "basil",
      "item": "fresh basil",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-vinegar",
      "item": "white vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a boil and season the water with salt and pepper to taste."
    },
    {
      "step": 2,
      "text": "Add the ears corn and cook in the boiling water for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Drain the corn, let it cool enough to handle, and cut the kernels from the cobs."
    },
    {
      "step": 4,
      "text": "Whisk the olive oil and white vinegar together."
    },
    {
      "step": 5,
      "text": "Combine the corn kernels, tomatoes, onion, and fresh basil in a bowl. Pour over the dressing and toss to coat."
    },
    {
      "step": 6,
      "text": "Chill the salad before serving."
    }
  ],
