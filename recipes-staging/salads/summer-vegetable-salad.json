  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer. Add the husked corn and simmer for 5 minutes, or until tender.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Drain the corn and let it cool completely, then cut the kernels from the cobs."
    },
    {
      "step": 3,
      "text": "Combine the corn kernels, avocados, tomatoes, black beans, cilantro, red onion, and jalapeno in a large bowl."
    },
    {
      "step": 4,
      "text": "Whisk the olive oil with the lime zest and juice. Pour over the salad and toss gently to coat."
    },
    {
      "step": 5,
      "text": "Cover and chill for 60 minutes before serving.",
      "timer_minutes": 60
    }
  ],
