  "id": "summer-vegetable-salad",
  "name": "Summer Vegetable Salad",
  "subtitle": "A crisp corn, bean, avocado, and tomato salad with lime dressing.",
  "description": "Tender corn and fresh vegetables are combined with black beans, cilantro, and a bright lime-oil dressing, then chilled before serving.",
  "meal_type": "salad",
  "cuisine": "American",
