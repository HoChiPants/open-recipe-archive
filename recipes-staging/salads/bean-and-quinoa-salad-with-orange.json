  "instructions": [
    {
      "step": 1,
      "text": "Prepare the quinoa and sliced celery, keeping them ready for cooking."
    },
    {
      "step": 2,
      "text": "Preheat the cooking vessel for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the frozen soya beans and cook for 7 minutes, until heated through.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Drain thoroughly, then combine with the olive oil, apple cider vinegar, spring onions, parsley, and mint."
    },
    {
      "step": 5,
      "text": "Add the orange segments and crumbled feta, toss gently, and serve."
    },
    {
      "step": 6,
      "text": "Chill before serving if a colder salad is preferred."
    }
  ],
