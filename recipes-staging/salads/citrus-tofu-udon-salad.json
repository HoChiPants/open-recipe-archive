  "instructions": [
    {
      "step": 1,
      "text": "Toss the tofu cubes with the cornflour until evenly coated."
    },
    {
      "step": 2,
      "text": "Combine the lemon and lime zest and juice with the soy sauce, sesame oil, and crispy chilli oil."
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil in a skillet over medium-high heat. Add the tofu and cook for about 6 minutes, turning occasionally, until crisp on several sides. Set aside briefly to cool.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Cook the udon noodles according to the pack directions, then drain and loosen."
    },
    {
      "step": 5,
      "text": "Combine the noodles, red pepper, spring onion, sugar snaps, carrot, and coriander in a bowl."
    },
    {
      "step": 6,
      "text": "Add the tofu and dressing, then toss until evenly coated. Serve immediately."
    }
  ],
