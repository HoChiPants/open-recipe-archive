  "id": "sweet-tangy-salad-dressing",
  "name": "Sweet-Tangy Salad Dressing",
  "subtitle": "A balanced oil-and-vinegar dressing with onion and savory seasoning.",
  "description": "Mix this quick dressing ahead and chill it so the flavors meld before serving.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 28,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ketchup",
      "item": "ketchup",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the vinegar, sugar, ketchup, salt, Worcestershire sauce, and chopped onion in a bowl. Stir until the sugar is mostly dissolved."
    },
    {
      "step": 2,
      "text": "Whisk in the vegetable oil until the dressing is evenly blended."
    },
    {
      "step": 3,
      "text": "Cover and chill before serving; stir again if the dressing separates."
    }
  ],
