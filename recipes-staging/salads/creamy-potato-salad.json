  "instructions": [
    {
      "step": 1,
      "text": "Place the peeled potatoes in a pot, cover with water, and add the salt. Bring to a simmer and cook until tender when pierced.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Drain the potatoes and let them cool until manageable, then cut them into bite-size pieces."
    },
    {
      "step": 3,
      "text": "Stir together the mayonnaise, celery, onion, vinegar, mustard, salt, and black pepper."
    },
    {
      "step": 4,
      "text": "Fold the potatoes into the dressing until evenly coated. Gently stir in the chopped eggs and paprika."
    },
    {
      "step": 5,
      "text": "Chill before serving."
    }
  ],
