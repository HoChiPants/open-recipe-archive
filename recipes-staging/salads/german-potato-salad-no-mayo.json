  "id": "german-potato-salad-no-mayo",
  "name": "German Potato Salad (No Mayo)",
  "subtitle": "Warm potatoes with tangy broth, onion, bacon, and dill",
  "description": "Tender potatoes are dressed with a warm vinegar-broth mixture, onion, bacon, oil, and fresh dill for a savory salad without mayonnaise.",
  "meal_type": "salad",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "red-potatoes",
      "item": "red potatoes",
      "quantity": 10,
      "preparation": "peeled and roughly chopped, or more to taste"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "white-vinegar",
      "item": "white vinegar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "oil",
      "item": "oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "diced"
    },
    {
      "ingredient_id": "slices-cooked-bacon",
      "item": "slices cooked bacon",
      "quantity": 6,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fresh-dill",
      "item": "fresh dill",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes in a saucepan, season with salt and pepper, and simmer until tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Drain the potatoes and return them to the saucepan or a serving bowl."
    },
    {
      "step": 3,
      "text": "Combine the chicken broth and vinegar in the saucepan and bring to a simmer."
    },
    {
      "step": 4,
      "text": "Add the onion and cook until softened, about 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Stir in the oil, chopped bacon, and dill, then pour the warm mixture over the potatoes and toss gently."
    },
    {
      "step": 6,
      "text": "If the broth contains poultry pieces, heat the mixture until those pieces reach 165°F before serving."
    },
    {
      "step": 7,
      "text": "Adjust the seasoning and serve warm or at room temperature."
    }
  ],
