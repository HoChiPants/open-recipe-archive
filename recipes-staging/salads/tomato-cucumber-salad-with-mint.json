  "id": "tomato-cucumber-salad-with-mint",
  "name": "Tomato Cucumber Salad with Mint",
  "subtitle": "A crisp, herb-flecked salad with a tangy-sweet dressing.",
  "description": "Cucumbers, tomatoes, red onion, and fresh mint are chilled with a simple vinegar dressing, then finished with olive oil and seasoning.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "red-wine-vinegar",
      "item": "red wine vinegar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cucumber",
      "item": "cucumbers",
      "quantity": 2,
      "unit": "large",
      "preparation": "peeled, seeded, and cut into 1/2-inch slices"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 3,
      "unit": "large",
      "preparation": "seeded and chopped"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 0.66666668653488,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fresh-mint",
      "item": "fresh mint",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the red wine vinegar, sugar, and 1 teaspoon salt with some of the salt and pepper to taste until the sugar dissolves."
    },
    {
      "step": 2,
      "text": "Add the cucumbers and toss to coat. Cover and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Combine the tomatoes, red onion, mint, and olive oil in a serving bowl. Add the chilled cucumbers and dressing, toss gently, and adjust with the remaining salt and pepper to taste."
    }
  ],
