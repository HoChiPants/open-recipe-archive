  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill."
    },
    {
      "step": 2,
      "text": "Transfer the red potatoes to the grill and coat them with 2 tablespoons of olive oil."
    },
    {
      "step": 3,
      "text": "Grill for 30 minutes, turning as needed, until tender.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Cut the grilled potatoes into bite-size pieces.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Whisk the 0.5 cup olive oil, vinegar, salt, pepper, garlic, and sugar until smooth."
    },
    {
      "step": 6,
      "text": "Combine the potatoes, bacon, green onions, and parsley with the dressing, tossing until evenly coated."
    },
    {
      "step": 7,
      "text": "Let the salad stand for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
