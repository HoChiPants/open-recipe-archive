  "id": "spinach-watermelon-salad",
  "name": "Spinach Watermelon Salad",
  "subtitle": "A crisp salad with sweet melon and tangy feta",
  "description": "Toss peppery greens, fresh vegetables, watermelon, and feta with a simple white balsamic dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "white-balsamic-vinegar",
      "item": "white balsamic vinegar",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "arugula",
      "item": "arugula",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baby-spinach-leaves",
      "item": "baby spinach leaves",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "thinly-sliced-red-onion",
      "item": "thinly sliced red onion",
      "quantity": 1,
      "unit": "cup"
