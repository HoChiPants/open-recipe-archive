  "instructions": [
    {
      "step": 1,
      "text": "Whisk the olive oil, white balsamic vinegar, and kosher salt until the dressing is set."
    },
    {
      "step": 2,
      "text": "Combine the arugula, baby spinach, red onion, and halved grape tomatoes in a large bowl."
    },
    {
      "step": 3,
      "text": "Coat the salad mixture with the dressing, then add the feta and watermelon. Toss gently and serve."
    }
  ],
