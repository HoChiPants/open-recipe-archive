  "id": "broccoli-caesar-salad",
  "name": "Broccoli Caesar Salad",
  "subtitle": "Tender broccoli with a savory lemon dressing and crisp crostini",
  "description": "Boiled long-stemmed broccoli is coated in a creamy anchovy-parmesan dressing and finished with crushed crostini.",
  "meal_type": "salad",
  "yield": {
    "quantity": 4,
    "unit": "servings"
