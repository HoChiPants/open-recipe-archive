  "instructions": [
    {
      "step": 1,
      "text": "Mash the garlic clove and anchovies together in a small bowl."
    },
    {
      "step": 2,
      "text": "Stir in the mayonnaise, lemon, grated parmesan, and Dijon mustard to make the dressing."
    },
    {
      "step": 3,
      "text": "Boil the long-stemmed broccoli for 4 minutes, until tender.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Drain the broccoli and transfer it to a serving dish."
    },
    {
      "step": 5,
      "text": "Spoon over the dressing, drizzle with the olive oil, and top with extra parmesan and crushed crostini. Serve with extra olive oil."
    }
  ],
