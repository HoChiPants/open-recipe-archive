  "id": "romaine-and-mandarin-orange-salad",
  "name": "Romaine and Mandarin Orange Salad",
  "subtitle": "Crisp romaine with citrus, bacon, almonds, and poppy seed dressing",
  "description": "A fresh romaine salad layered with sweet mandarin segments, crisp bacon, toasted almonds, and a tangy homemade dressing.",
  "meal_type": "salad",
