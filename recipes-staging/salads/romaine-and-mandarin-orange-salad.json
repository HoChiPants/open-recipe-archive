  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a preheated skillet over medium heat until crisp, then drain it and crumble when cool enough to handle.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Blend the vinegar, sugar, onion, mustard powder, and salt until smooth. Gradually blend in the vegetable oil, then stir in the poppy seeds."
    },
    {
      "step": 3,
      "text": "Combine the romaine and drained mandarin segments in a serving bowl. Add the dressing and toss to coat."
    },
    {
      "step": 4,
      "text": "Top the salad with the crumbled bacon and toasted almonds, then serve."
    }
  ],
