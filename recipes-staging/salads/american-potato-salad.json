  "id": "american-potato-salad",
  "name": "American Potato Salad",
  "subtitle": "Creamy chilled potato salad with eggs and crisp vegetables",
  "description": "A classic-style potato salad with tender red potatoes, hard-cooked eggs, and a simple mayonnaise dressing.",
  "meal_type": "salad",
  "cuisine": "American",
