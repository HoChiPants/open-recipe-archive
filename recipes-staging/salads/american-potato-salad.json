  "instructions": [
    {
      "step": 1,
      "text": "Place the red potatoes in a large pot, cover with water, and bring to a simmer. Cook until tender, about 20 minutes; drain and cool enough to handle.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Cook the eggs until hard-cooked, about 12 minutes. Cool, peel, and chop.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Cut the cooled potatoes into bite-size pieces and place in a large bowl with the chopped eggs."
    },
    {
      "step": 4,
      "text": "In a separate bowl, stir together the mayonnaise, diced onion, green onions, bell pepper, celery, salt, and black pepper."
    },
    {
      "step": 5,
      "text": "Fold the dressing into the potatoes and eggs until evenly coated. Cover and chill for at least 2 hours before serving.",
      "timer_minutes": 120
    }
  ],
