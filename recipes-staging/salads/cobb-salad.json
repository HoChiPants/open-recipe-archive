  "id": "cobb-salad",
  "name": "Cobb Salad",
  "subtitle": "A quick salad with chicken, bacon, egg, avocado, and tomatoes",
  "description": "Combine crisp lettuce and fresh toppings with sliced cooked chicken, bacon, and set eggs, then finish with a sharp mustard dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
