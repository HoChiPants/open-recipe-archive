      "preparation": "cooked, sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the eggs in a saucepan of simmering water and cook for 7 minutes, until the centers are fully set. Cool, peel, and set aside.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Grill the bacon for about 5 minutes, turning as needed, until cooked and crisp. Cool briefly, then chop or leave in pieces.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the olive oil, cider vinegar, and Dijon mustard until thick and combined."
    },
    {
      "step": 4,
      "text": "Cut the lettuces and arrange them with the avocado, tomatoes, and sliced cooked chicken."
    },
    {
      "step": 5,
      "text": "Quarter the cooled eggs, add them with the bacon, and drizzle the dressing over the salad."
    }
  ],
