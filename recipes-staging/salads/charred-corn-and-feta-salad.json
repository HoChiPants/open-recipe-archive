  "instructions": [
    {
      "step": 1,
      "text": "Thinly slice the red onion. If using canned sweetcorn, drain it thoroughly; if using cobs, use the stripped kernels.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Heat a large frying pan over medium-high heat. Add the neutral oil and butter, then add the corn.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Cook the corn, stirring occasionally, until browned and lightly charred.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Combine the onion, charred corn, chives, parsley, and feta in a serving bowl."
    },
    {
      "step": 5,
      "text": "Whisk the olive oil and lemon juice together, pour over the salad, and toss gently before serving."
    }
  ],
