  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Arrange the bacon in a single layer on a baking tray, then add the torn bread and toss it with the olive oil."
    },
    {
      "step": 2,
      "text": "Bake the bacon and bread for 10 minutes, until the bread is crisp and the bacon is cooked. Cut the bacon into bite-size pieces.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the tomatoes to the tray and continue baking for 15 minutes, until they are softened and just set.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Whisk the mayonnaise, vinegar, shallot, chopped capers, lemon zest and juice, honey, and chopped basil into a smooth dressing."
    },
    {
      "step": 5,
      "text": "Combine the warm bacon and tomatoes with the rocket and dressing. Toss with the toasted bread, garnish with extra basil leaves, and serve."
    }
  ],
