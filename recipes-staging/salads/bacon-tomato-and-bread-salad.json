  "id": "bacon-tomato-and-bread-salad",
  "name": "Bacon, Tomato, and Bread Salad",
  "subtitle": "A crisp, savory salad with basil dressing",
  "description": "Toasted crusty bread, bacon, juicy tomatoes, peppery rocket, and a bright caper dressing make a hearty salad.",
  "meal_type": "salad",
  "yield": {
    "quantity": 6,
    "unit": "servings"
