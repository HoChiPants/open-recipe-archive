      "ingredient_id": "couscous",
      "item": "couscous",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "hot-low-salt-vegetable-stock-from-a-cube-is-fine",
      "item": "hot low salt vegetable stock (from a cube is fine)",
      "quantity": 200,
