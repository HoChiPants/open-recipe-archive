  "instructions": [
    {
      "step": 1,
      "text": "Place the couscous in a heatproof bowl and pour over the hot vegetable stock. Cover and leave for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Slice the spring onions and red pepper, and dice the cucumber."
    },
    {
      "step": 3,
      "text": "Fluff the couscous with a fork, then mix in the vegetables, cubed feta, pesto, and pine nuts. Serve."
    }
  ],
