  "id": "couscous-salad",
  "name": "Couscous Salad",
  "subtitle": "A quick Mediterranean salad with vegetables, feta, pesto, and pine nuts.",
  "description": "Steamed couscous is combined with crisp vegetables, creamy feta, pesto, and pine nuts for a simple two-serving salad.",
  "meal_type": "salad",
  "cuisine": "Mediterranean",
  "yield": {
