  "instructions": [
    {
      "step": 1,
      "text": "Whisk the olive oil, white vinegar, white sugar, and soy sauce until the sugar is incorporated."
    },
    {
      "step": 2,
      "text": "Combine the sliced bok choy, green onions, toasted almonds, and chow mein noodles in a large bowl."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the salad and toss until evenly coated. Serve immediately."
    }
