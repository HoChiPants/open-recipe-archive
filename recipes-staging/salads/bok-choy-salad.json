  "id": "bok-choy-salad",
  "name": "Bok Choy Salad",
  "subtitle": "Crisp bok choy with a tangy soy dressing",
  "description": "A fresh salad combining sliced baby bok choy, green onions, toasted almonds, and chow mein noodles with a sweet-and-tangy dressing.",
  "meal_type": "salad",
  "cuisine": "Chinese",
