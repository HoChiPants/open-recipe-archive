  "instructions": [
    {
      "step": 1,
      "text": "Combine the cucumber, cherry tomatoes, sundried tomatoes, artichoke hearts, guindilla peppers, parsley, and red wine vinegar in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the drained chickpeas and chopped lettuce, then toss gently to distribute the ingredients."
    },
    {
      "step": 3,
      "text": "Fold in the feta cubes. Drizzle with the reserved sundried-tomato oil and extra virgin olive oil before serving."
    }
