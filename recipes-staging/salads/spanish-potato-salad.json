  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes in a pot, cover with water, and season with salt and pepper. Bring to a simmer and cook until tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Drain the potatoes and let them cool for 10 minutes, then cut them into thick slices.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the olive oil and red wine vinegar together. Stir in the crushed garlic, then coat the sliced potatoes with the dressing."
    },
    {
      "step": 4,
      "text": "Fold in the bell pepper, olives, shallot, and parsley. Season with salt and pepper, and serve with lemon wedges."
    }
  ],
