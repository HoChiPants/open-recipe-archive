  "instructions": [
    {
      "step": 1,
      "text": "Add the maple syrup, balsamic vinegar, lemon juice, garlic, mustard, salt, basil, and pepper to a blender. Blend until smooth."
    },
    {
      "step": 2,
      "text": "With the blender running, gradually pour in the olive oil and continue blending until the dressing becomes thick."
    }
