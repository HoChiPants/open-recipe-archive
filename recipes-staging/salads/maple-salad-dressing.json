  "id": "maple-salad-dressing",
  "name": "Maple Salad Dressing",
  "subtitle": "A tangy-sweet dressing blended with maple and balsamic vinegar",
  "description": "Blend the seasoned acidic mixture, then incorporate olive oil until the dressing is smooth and thick.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
