  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Place the chicken in a baking dish and cook for 30 minutes, until the thickest part reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Transfer the chicken to a plate, let it cool, then cut or shred it into bite-size pieces."
    },
    {
      "step": 3,
      "text": "Bring water seasoned with some of the seasoned salt to a simmer. Stir in the elbow macaroni and cook for about 8 minutes, until tender. Drain and cool.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Combine the cooled chicken and macaroni with the pineapple chunks, raisins, celery, apple, and carrot."
    },
    {
      "step": 5,
      "text": "Stir in the mayonnaise, white sugar, and remaining seasoned salt until evenly coated."
    },
    {
      "step": 6,
      "text": "Cover and chill for 30 minutes before serving.",
      "timer_minutes": 30
    }
  ],
