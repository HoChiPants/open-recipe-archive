  "id": "feta-chicken-salad",
  "name": "Feta Chicken Salad",
  "subtitle": "Creamy chicken salad with feta and crisp vegetables",
  "description": "A cool, creamy salad combining diced chicken, crunchy vegetables, feta, and dill.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "chicken",
      "item": "chicken",
      "quantity": 3,
      "unit": "cups",
      "preparation": "diced cooked"
    },
    {
      "ingredient_id": "stalks-celery",
      "item": "stalks celery",
      "quantity": 2,
      "unit": "large",
      "preparation": "diced"
    },
    {
      "ingredient_id": "red-bell-pepper",
      "item": "red bell pepper",
      "quantity": 1,
      "unit": "medium",
      "preparation": "seeded and diced"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 0.5,
      "unit": "medium",
      "preparation": "diced"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "feta-cheese",
      "item": "feta cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "4 ounce, crumbled"
    },
    {
      "ingredient_id": "dried-dill-weed",
      "item": "dried dill weed",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the diced cooked chicken, celery, red bell pepper, and red onion in a large bowl."
    },
    {
      "step": 2,
      "text": "Whisk the mayonnaise, sour cream, feta cheese, and dill in a separate bowl until blended."
    },
    {
      "step": 3,
      "text": "Fold the dressing into the chicken mixture until evenly coated."
    },
    {
      "step": 4,
      "text": "Season with salt and ground black pepper to taste."
    },
    {
      "step": 5,
      "text": "Cover and chill before serving."
    }
  ],
