  "id": "japanese-tofu-salad",
  "name": "Japanese Tofu Salad",
  "subtitle": "Chilled tofu with savory ginger dressing",
  "description": "Pressed tofu, fresh vegetables, and herbs are coated in a warm soy-ginger dressing, then served chilled.",
  "meal_type": "salad",
  "cuisine": "Japanese",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 35,
    "cook_minutes": 5,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "firm-tofu",
      "item": "firm tofu",
      "quantity": 1,
      "unit": "package",
      "preparation": "14 ounce, drained"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "mirin-sweetened-rice-wine",
      "item": "mirin (sweetened rice wine)",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "rice-vinegar",
      "item": "rice vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "fresh-ginger",
      "item": "fresh ginger",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "minced"
    },
    {
