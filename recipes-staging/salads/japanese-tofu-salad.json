  "instructions": [
    {
      "step": 1,
      "text": "Transfer the drained tofu to a plate, cover it, and press under a weight for 60 minutes to remove excess moisture.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Whisk the soy sauce, mirin, rice vinegar, sesame oil, and sesame seeds in a bowl."
    },
    {
      "step": 3,
      "text": "Heat the vegetable oil in a skillet over medium heat. Add the garlic and ginger and stir for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir the whisked dressing into the skillet and remove from the heat."
    },
    {
      "step": 5,
      "text": "Cut the pressed tofu into pieces and combine it with the tomato, red onion, and cilantro."
    },
    {
      "step": 6,
      "text": "Coat the salad with the dressing, chill for at least 1 hour, and finish with the dressing's sesame oil and sesame seeds.",
      "timer_minutes": 60
    }
  ],
