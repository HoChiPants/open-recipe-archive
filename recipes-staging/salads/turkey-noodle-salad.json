  "instructions": [
    {
      "step": 1,
      "text": "Whisk the peanut butter, soy sauce, sriracha, sesame oil, and lime zest and juice into a smooth dressing."
    },
    {
      "step": 2,
      "text": "Prepare the rice vermicelli noodles according to their package directions, then drain and rinse under cold water."
    },
    {
      "step": 3,
      "text": "Add the carrots to boiling water for 5 minutes, then drain and cool them.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Toss the cooled noodles with the sesame oil, adding extra if needed to prevent sticking."
    },
    {
      "step": 5,
      "text": "Combine the noodles, carrots, cucumber, shredded cooked turkey, spring onions, coriander, peanuts, and chilli in a large bowl."
    },
    {
      "step": 6,
      "text": "Add the dressing and toss until evenly coated. Serve chilled or at room temperature."
    },
    {
      "step": 7,
      "text": "If reheating leftover turkey before using, heat it to 165°F and cool it promptly before assembling the salad."
    }
  ],
