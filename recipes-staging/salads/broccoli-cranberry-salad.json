      "ingredient_id": "dried-cranberries",
      "item": "dried cranberries",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the mayonnaise, sugar, and vinegar until smooth. Chill the dressing while preparing the salad."
    },
    {
      "step": 2,
      "text": "Cook the bacon in a skillet over medium heat until crisp, about 10 minutes. Drain on paper towels and crumble or break into small pieces.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Combine the broccoli, red onion, sunflower kernels, and dried cranberries in a large bowl."
    },
    {
      "step": 4,
      "text": "Add the bacon and dressing, then toss until evenly combined."
    }
  ],
