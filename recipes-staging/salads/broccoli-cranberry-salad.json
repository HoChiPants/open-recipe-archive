      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "red-wine-vinegar",
      "item": "red wine vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "strips-bacon",
      "item": "strips bacon",
      "quantity": 6
    },
    {
