  "id": "broccoli-cranberry-salad",
  "name": "Broccoli Cranberry Salad",
  "subtitle": "A crisp broccoli salad with creamy dressing, bacon, and dried fruit",
  "description": "Fresh broccoli, onion, sunflower kernels, cranberries, and bacon are tossed with a tangy-sweet mayonnaise dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
