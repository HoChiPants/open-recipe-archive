  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer."
    },
    {
      "step": 2,
      "text": "Add the mini penne and cook for 7 minutes, or until tender.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Drain the pasta and transfer it to a large bowl."
    },
    {
      "step": 4,
      "text": "Stir in the chicken, green bell pepper, Parmesan, red onion, and chopped hard-boiled eggs."
    },
    {
      "step": 5,
      "text": "Add the Caesar dressing and mix until evenly coated."
    },
    {
      "step": 6,
      "text": "Cover and chill for 2 hours before serving.",
      "timer_minutes": 120
    }
