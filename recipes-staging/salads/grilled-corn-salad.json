  "id": "grilled-corn-salad",
  "name": "Grilled Corn Salad",
  "subtitle": "Charred corn with crisp vegetables and cilantro",
  "description": "Tender grilled corn is combined with bell pepper, tomatoes, red onion, and cilantro for a fresh, colorful salad served chilled.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
