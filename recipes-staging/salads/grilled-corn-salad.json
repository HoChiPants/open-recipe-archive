    "prep_minutes": 20,
    "cook_minutes": 10,
    "inactive_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "ears-freshly-shucked-corn",
      "item": "ears freshly shucked corn",
      "quantity": 6
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 1,
      "unit": "medium",
      "preparation": "diced"
    },
    {
      "ingredient_id": "roma-plum-tomatoes",
      "item": "Roma (plum) tomatoes",
      "quantity": 2,
      "unit": "medium",
      "preparation": "diced"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "bunch-fresh-cilantro",
      "item": "bunch fresh cilantro",
      "quantity": 0.5,
      "preparation": "chopped, or more to taste"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill to medium-high heat."
    },
    {
      "step": 2,
      "text": "Season the corn with salt and pepper, then grill for 10 minutes, turning occasionally, until tender.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Let the corn cool enough to handle, then cut the kernels from the cobs."
    },
    {
      "step": 4,
      "text": "Combine the corn, bell pepper, tomatoes, red onion, cilantro, and olive oil in a large bowl. Season with additional salt and pepper to taste."
    },
    {
      "step": 5,
      "text": "Chill the salad for 30 minutes before serving.",
      "timer_minutes": 30
    }
  ],
