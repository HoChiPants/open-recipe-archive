  "instructions": [
    {
      "step": 1,
      "text": "Mix the smoked paprika, oregano, chipotle paste, cinnamon, crushed garlic, lime zest and juice, and olive oil. Coat the chicken in the mixture and marinate for up to 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 2,
      "text": "Stir the yogurt, honey, 1 teaspoon chipotle paste, and 1/2 teaspoon smoked paprika together. Set aside."
    },
    {
      "step": 3,
      "text": "Heat a grill or barbecue. Brush the corn and lettuce with oil. Grill the chicken, corn, and lettuce, turning as needed, until the chicken reaches 165°F in the thickest part and the corn and lettuce are charred. Allow about 10 minutes for the vegetables.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Transfer the grilled vegetables to a board. Cut the corn from the cobs and chop the lettuce."
    },
    {
      "step": 5,
      "text": "Warm a little oil in a pan and fry the tortilla wraps until crisp. Drain, cool briefly, and cut into strips."
    },
    {
      "step": 6,
      "text": "Combine the beans, tomatoes, avocado, corn, lettuce, and coriander. Top with the chicken and tortilla strips, spoon over the dressing, and serve with lime wedges."
    }
  ],
