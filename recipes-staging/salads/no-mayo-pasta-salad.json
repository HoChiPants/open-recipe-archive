  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer, add both types of rotini, and cook for 8 minutes or until tender.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Drain the pasta and let it cool until set."
    },
    {
      "step": 3,
      "text": "Place the cooled pasta in a large bowl with the tomatoes, cucumber, and onion."
    },
    {
      "step": 4,
      "text": "Stir the ranch and Italian-style dressings together, then pour them over the salad and toss until evenly coated."
    }
