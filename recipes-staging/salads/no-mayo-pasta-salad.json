  "id": "no-mayo-pasta-salad",
  "name": "No-Mayo Pasta Salad",
  "subtitle": "Rotini with fresh vegetables and creamy dressing",
  "description": "A colorful chilled pasta salad combining two rotini varieties, chopped vegetables, and two prepared dressings.",
  "meal_type": "salad",
