  "id": "turkey-salad",
  "name": "Turkey Salad",
  "subtitle": "A chilled turkey salad with eggs, pickles, and creamy dressing",
  "description": "Combine cooked turkey, chopped sweet pickles, eggs, and a creamy mustard-mayonnaise dressing, then chill before serving.",
