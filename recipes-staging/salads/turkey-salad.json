  "instructions": [
    {
      "step": 1,
      "text": "Place the eggs in a saucepan, cover with water, and bring to a boil. Cook until fully set and the center reaches 160°F, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Cool the eggs, peel them, and chop them."
    },
    {
      "step": 3,
      "text": "Combine the chopped eggs, cooked turkey, sweet pickles, mustard-mayonnaise blend, and mayonnaise in a large bowl. Mix until evenly coated."
    },
    {
      "step": 4,
      "text": "Cover and refrigerate for 3 hours before serving.",
      "timer_minutes": 180
    }
