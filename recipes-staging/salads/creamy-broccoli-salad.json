  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "creamy-broccoli-salad",
  "name": "Creamy Broccoli Salad",
  "subtitle": "A crisp, tangy salad with bacon and mozzarella",
  "description": "Fresh broccoli, mozzarella, onion, and bacon are tossed with a smooth sweet-tart mayonnaise dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 8
    },
    {
      "ingredient_id": "fresh-broccoli",
      "item": "fresh broccoli",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into florets"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 0.5,
      "unit": "small",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Arrange the bacon on a baking sheet and cook until crisp, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Drain the bacon, let it cool, and crumble it."
    },
    {
      "step": 3,
      "text": "Combine the bacon, broccoli, mozzarella, and red onion in a large bowl."
    },
    {
      "step": 4,
      "text": "Whisk the mayonnaise, sugar, and vinegar until smooth. Pour over the broccoli mixture and toss to coat."
    }
  ],
