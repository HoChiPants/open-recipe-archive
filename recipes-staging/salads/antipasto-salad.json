  "instructions": [
    {
      "step": 1,
      "text": "In a large bowl, combine the salami, provolone, tomatoes, drained artichokes, and roasted red peppers, cutting the peppers into bite-size pieces if needed."
    },
    {
      "step": 2,
      "text": "Add the Kalamata olives, green olives, olive oil, red wine vinegar, and black pepper. Toss until evenly coated."
    },
    {
      "step": 3,
      "text": "Fold in the mozzarella and basil leaves gently to keep the cheese intact."
    },
    {
