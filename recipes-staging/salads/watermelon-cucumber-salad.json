  "id": "watermelon-cucumber-salad",
  "name": "Watermelon Cucumber Salad",
  "subtitle": "A crisp fruit-and-vegetable salad with lime, mint, and feta",
  "description": "Sweet watermelon and cool cucumber are tossed with lime-seasoned onion, olive oil, feta, and fresh mint for a bright salad.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "halved and sliced into thin half-moons"
    },
    {
      "ingredient_id": "lime-juice",
      "item": "lime juice",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "seedless-watermelon",
      "item": "seedless watermelon",
      "quantity": 1,
      "preparation": "cut into cubes"
    },
    {
      "ingredient_id": "baby-cucumbers",
      "item": "baby cucumbers",
      "quantity": 3,
      "preparation": "seeded and cut into cubes"
    },
    {
      "ingredient_id": "crumbled-feta-cheese",
      "item": "crumbled feta cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "mint-leaves",
      "item": "mint leaves",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "sliced thinly"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the red onion and lime juice in a bowl; let stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the extra-virgin olive oil."
    },
    {
      "step": 3,
      "text": "Add the watermelon, cucumbers, and feta, then toss gently to coat with the lime mixture."
    },
    {
      "step": 4,
      "text": "Fold in the mint and serve."
    }
  ],
