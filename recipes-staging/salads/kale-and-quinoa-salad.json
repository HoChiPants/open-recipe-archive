  "instructions": [
    {
      "step": 1,
      "text": "Bring the water to a simmer in a saucepan. Stir in the quinoa, cover, and cook for 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Remove the quinoa from the heat and let it stand, covered, for 5 minutes. Cool for 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 3,
      "text": "Whisk the olive oil, lemon juice, Dijon mustard, minced garlic, black pepper, and sea salt into a dressing."
    },
    {
      "step": 4,
      "text": "Place the chopped kale in a large bowl and gently massage it until slightly softened."
    },
    {
      "step": 5,
      "text": "Add the cooled quinoa, pecans, currants, and feta to the kale. Pour over the dressing and toss to combine."
    }
  ],
