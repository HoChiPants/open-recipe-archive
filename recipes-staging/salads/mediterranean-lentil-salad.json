  "instructions": [
    {
      "step": 1,
      "text": "Rinse the lentils and place them in a saucepan with the carrots, red onion, garlic, bay leaf, and thyme. Add enough water to cover."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a boil, then reduce the heat and simmer until the lentils are tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Drain the lentils and remove the bay leaf. Transfer the mixture to a bowl."
    },
    {
      "step": 4,
      "text": "Stir in the lemon juice, celery, parsley, salt, pepper, and olive oil until evenly combined."
    },
    {
      "step": 5,
      "text": "Serve warm or at room temperature."
    }
  ],
