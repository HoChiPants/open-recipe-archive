  "id": "mediterranean-lentil-salad",
  "name": "Mediterranean Lentil Salad",
  "subtitle": "Tender lentils with crisp vegetables and lemon dressing",
  "description": "A bright, herby lentil salad combining tender legumes, fresh vegetables, parsley, and a simple lemon-olive oil dressing.",
  "meal_type": "salad",
