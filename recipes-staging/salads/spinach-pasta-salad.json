  "id": "spinach-pasta-salad",
  "name": "Spinach Pasta Salad",
  "subtitle": "Farfalle with spinach, feta, olives, and lemon dressing",
  "description": "A bright, savory pasta salad combining tender farfalle, fresh spinach, feta, olives, onion, and a garlicky lemon dressing.",
  "meal_type": "salad",
