      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Boil the farfalle with the garlic salt until tender, following the package’s cooking time. Drain well.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Place the spinach, feta, red onion, olives, and drained pasta in a large bowl."
    },
    {
      "step": 3,
      "text": "Whisk together the dressing, garlic, lemon juice, remaining garlic salt, and black pepper."
    },
    {
      "step": 4,
      "text": "Pour the dressing over the salad and toss until the spinach and pasta are evenly coated."
    }
  ],
