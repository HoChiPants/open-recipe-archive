      "item": "black olives",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, drained and chopped"
    },
    {
      "ingredient_id": "italian-style-salad-dressing",
      "item": "Italian-style salad dressing",
      "quantity": 1,
      "unit": "cup"
    },
    {
