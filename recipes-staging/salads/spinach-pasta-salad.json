  "ingredients": [
    {
      "ingredient_id": "farfalle-pasta",
      "item": "farfalle pasta",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 ounce"
    },
    {
      "ingredient_id": "baby-spinach",
      "item": "baby spinach",
      "quantity": 10,
      "unit": "ounces",
      "preparation": "rinsed and torn into bite-size piece"
    },
    {
      "ingredient_id": "crumbled-feta-cheese-with-basil-and-tomato",
      "item": "crumbled feta cheese with basil and tomato",
