      "ingredient_id": "baby-spinach-leaves",
      "item": "baby spinach leaves",
      "quantity": 8,
      "unit": "cups"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 0.5,
      "unit": "medium",
      "preparation": "sliced and separated into rings"
    },
    {
      "ingredient_id": "mandarin-oranges",
      "item": "mandarin oranges",
      "quantity": 1,
      "unit": "can",
      "preparation": "11 ounce, drained"
    },
    {
