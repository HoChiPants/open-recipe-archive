  "id": "spinach-mandarin-salad",
  "name": "Spinach Mandarin Salad",
  "subtitle": "A crisp salad with citrus, cranberries, almonds, and feta",
  "description": "Fresh spinach combines with bright mandarin oranges, dried cranberries, crunchy almonds, feta, and balsamic vinaigrette for a quick salad.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
