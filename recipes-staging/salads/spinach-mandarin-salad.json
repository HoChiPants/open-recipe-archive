      "item": "balsamic vinaigrette salad dressing",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the spinach in a large salad bowl and add the balsamic vinaigrette. Stir or whisk the dressing first if needed."
    },
    {
      "step": 2,
      "text": "Add the onion, mandarin oranges, cranberries, almonds, and feta."
    },
    {
      "step": 3,
      "text": "Toss gently until evenly combined, then serve immediately."
    }
  ],
