  "ingredients": [
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
      "unit": "cup",
      "preparation": "sliced, cut lengthwise"
    },
    {
      "ingredient_id": "lime-juice",
      "item": "lime juice",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "watermelon",
      "item": "watermelon",
      "quantity": 15,
      "unit": "cups",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "english-cucumber",
      "item": "English cucumber",
      "quantity": 3,
      "unit": "cups",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "feta-cheese",
      "item": "feta cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, crumbled"
    },
    {
