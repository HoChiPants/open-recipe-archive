      "item": "cracked black pepper"
    },
    {
      "ingredient_id": "sea-salt",
      "item": "sea salt"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the sliced red onion in a bowl and add the lime juice. Toss to coat."
    },
    {
      "step": 2,
      "text": "Combine the watermelon, cucumber, feta, and cilantro in a large serving bowl."
    },
    {
      "step": 3,
      "text": "Add the lime-seasoned onion, then season with sea salt and cracked black pepper. Toss gently to combine."
    },
    {
      "step": 4,
      "text": "Serve immediately."
    }
  ],
