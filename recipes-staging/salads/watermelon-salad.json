  "id": "watermelon-salad",
  "name": "Watermelon Salad",
  "subtitle": "A crisp, tangy salad with feta and cilantro",
  "description": "Juicy watermelon, cucumber, lime-seasoned onion, feta, and cilantro combine for a bright salad served chilled or at room temperature.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
