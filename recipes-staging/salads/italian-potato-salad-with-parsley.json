  "id": "italian-potato-salad-with-parsley",
  "name": "Italian Potato Salad with Parsley",
  "subtitle": "Tender potatoes tossed with parsley, garlic, and a bright vinegar dressing.",
  "description": "A simple Italian-style potato salad with green onions, parsley, olive oil, and a gentle chile heat.",
  "meal_type": "salad",
  "cuisine": "Italian",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "yukon-gold-potatoes",
      "item": "Yukon Gold potatoes",
      "quantity": 25,
      "unit": "ounces"
    },
    {
      "ingredient_id": "rock-salt",
      "item": "rock salt",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "peeled and slightly crushed"
    },
    {
      "ingredient_id": "green-onions-white-part-only",
      "item": "green onions (white part only)",
      "quantity": 2,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "very-finely-chopped-flat-leaf-parsley",
      "item": "very finely chopped flat-leaf parsley",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes in a pot, cover with water, and add the rock salt. Bring to a simmer."
    },
    {
      "step": 2,
      "text": "Cook until the potatoes are tender, about 10 minutes. Drain and let cool until easy to handle.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the white wine vinegar with 3 tablespoons of the olive oil. Add the crushed garlic and let the dressing stand briefly."
    },
    {
      "step": 4,
      "text": "Cut the cooled potatoes into bite-size pieces and place them in a bowl with the green onions and parsley."
    },
    {
      "step": 5,
      "text": "Remove the garlic from the dressing if desired, then toss the potatoes with the dressing and remaining olive oil. Season with salt, pepper, and red pepper flakes."
    }
  ],
