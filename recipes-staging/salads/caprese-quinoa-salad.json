  "id": "caprese-quinoa-salad",
  "name": "Caprese Quinoa Salad",
  "subtitle": "Quinoa, tomatoes, mozzarella, and basil with balsamic dressing",
  "description": "A fresh Italian-style salad combining cooked quinoa, crisp vegetables, basil, tomatoes, and buffalo mozzarella.",
  "meal_type": "salad",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "as a side or 2 as a main"
  },
