    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "extra virgin olive oil",
      "quantity": 6,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 2,
