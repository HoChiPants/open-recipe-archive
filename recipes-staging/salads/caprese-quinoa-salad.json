  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the olive oil and balsamic vinegar together in a large bowl. Add the sliced tomatoes and toss gently."
    },
    {
      "step": 2,
      "text": "Stir the cooked quinoa, shredded spinach, diced cucumber, and torn basil into the bowl."
    },
    {
      "step": 3,
      "text": "Add the sliced buffalo mozzarella and combine gently with the salad."
    },
    {
      "step": 4,
      "text": "Let the salad rest briefly before serving."
    }
  ],
