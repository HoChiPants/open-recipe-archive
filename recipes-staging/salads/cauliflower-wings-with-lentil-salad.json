  "id": "cauliflower-wings-with-lentil-salad",
  "name": "Cauliflower Wings with Lentil Salad",
  "subtitle": "Crisp-spiced cauliflower with lentils and lime yogurt dressing",
  "description": "Yogurt-coated cauliflower is baked, finished with a hot honey glaze, and served over lentils and salad leaves with a bright lime dressing.",
  "meal_type": "salad",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 30
  },
