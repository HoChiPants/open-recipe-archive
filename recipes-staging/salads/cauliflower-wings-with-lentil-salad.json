  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to a moderate-high setting and grease a baking sheet with some of the olive oil."
    },
    {
      "step": 2,
      "text": "Whisk the flour, paprika, and yogurt until smooth. Coat the cauliflower florets in the mixture and arrange them on the prepared sheet."
    },
    {
      "step": 3,
      "text": "Bake the cauliflower until tender and browned.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Mix the hot sauce and honey, coat the baked cauliflower, and return it to the oven's top heat until glazed and lightly charred.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Whisk the olive oil, honey, and lime zest and juice. Toss the dressing with the salad leaves and cooked lentils, then serve with the cauliflower."
    }
  ],
