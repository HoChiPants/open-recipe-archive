  "id": "shredded-apple-carrot-salad",
  "name": "Shredded Apple Carrot Salad",
  "subtitle": "A crisp salad with toasted sesame and bright lemon dressing",
  "description": "Shredded carrots and tart apple are tossed with parsley, toasted sesame seeds, and a tangy lemon-vinegar dressing.",
  "meal_type": "salad",
  "cuisine": "American",
