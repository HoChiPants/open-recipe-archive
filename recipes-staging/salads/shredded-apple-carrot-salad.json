  "instructions": [
    {
      "step": 1,
      "text": "Preheat a dry skillet over medium heat. Add the sesame seeds and cook for 5 minutes, stirring occasionally, until lightly browned. Transfer to a plate to cool.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Combine the carrots, shredded apple, parsley, toasted sesame seeds, and apple cider vinegar in a large bowl."
    },
    {
      "step": 3,
      "text": "Whisk together the lemon juice, apple cider vinegar, sugar, garlic, salt, and black pepper. Gradually whisk in the safflower oil."
    },
    {
      "step": 4,
      "text": "Pour the dressing over the salad and toss until evenly coated."
    }
  ],
