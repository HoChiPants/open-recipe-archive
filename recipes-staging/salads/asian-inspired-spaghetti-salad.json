  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a boil and cook the spaghetti for 12 minutes, or until tender. Drain well.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Transfer the drained spaghetti to a large bowl and toss with the olive oil."
    },
    {
      "step": 3,
      "text": "Whisk together the soy sauce, white sugar, rice vinegar, toasted sesame seeds, sweet chili sauce, and sesame oil."
    },
    {
      "step": 4,
      "text": "Add the green onions, red bell pepper, and sugar snap peas to the spaghetti. Pour in the dressing and toss until evenly coated."
    },
    {
      "step": 5,
      "text": "Chill the salad for 30 minutes, then toss once more and serve.",
      "timer_minutes": 30
    }
  ],
