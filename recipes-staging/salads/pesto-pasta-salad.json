  "instructions": [
    {
      "step": 1,
      "text": "Cook the farfalle pasta until tender, then transfer it to a large bowl and let it set briefly."
    },
    {
      "step": 2,
      "text": "Toast the pine nuts in the olive oil for 5 minutes, watching closely so they do not over-brown.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the pesto, basil leaves, lemon juice and zest, and the cherry tomatoes, sweetcorn, peas, and rocket to the pasta. Toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Top with the shaved parmesan or vegetarian alternative and serve."
    }
  ],
