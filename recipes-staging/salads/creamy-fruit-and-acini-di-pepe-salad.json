  "instructions": [
    {
      "step": 1,
      "text": "Whisk pineapple juice, sugar, beaten eggs, flour, lemon juice, and 1 teaspoon salt in a saucepan until smooth."
    },
    {
      "step": 2,
      "text": "Cook the mixture over medium heat, stirring continuously, until thickened and the egg mixture reaches 160°F."
    },
    {
      "step": 3,
      "text": "Remove the dressing from the heat, stir in the vegetable oil, and cool completely.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Bring a pot of salted water to a simmer, add the acini di pepe, and cook for 7 minutes or until tender. Drain and cool.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Combine the cooled pasta, mandarin oranges, pineapple tidbits, crushed pineapple, and cooled dressing. Fold in the thawed whipped topping."
    },
    {
      "step": 6,
      "text": "Cover and refrigerate for at least 8 hours. Fold in the marshmallows and coconut just before serving.",
      "timer_minutes": 480
    },
    {
      "step": 7,
      "text": "Serve chilled."
    }
  ],
