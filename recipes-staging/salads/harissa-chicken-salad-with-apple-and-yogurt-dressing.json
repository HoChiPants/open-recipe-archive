  "instructions": [
    {
      "step": 1,
      "text": "Stir the garlic granules, smoked paprika, 1 tablespoon olive oil, the juice of 1/2 lemon, and harissa paste together. Coat the chicken thighs with the mixture and set aside while the cooking surface heats."
    },
    {
      "step": 2,
      "text": "Cook the coated chicken thighs on the preheated cooking surface until charred and the thickest part reaches 165°F, about 16 minutes total. Rest briefly, then slice.",
      "timer_minutes": 16
    },
    {
      "step": 3,
      "text": "Whisk the dill, parsley, Greek yogurt, the juice of the remaining 1/2 lemon, and 2 tablespoons olive oil until smooth."
    },
    {
      "step": 4,
      "text": "Combine the pea shoots, rocket, sliced apple, feta, dried cranberries, and chopped walnuts. Arrange the sliced chicken over the salad and spoon the dressing over it."
    }
  ],
