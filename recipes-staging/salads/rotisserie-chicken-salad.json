  "instructions": [
    {
      "step": 1,
      "text": "In a large bowl, combine the chopped chicken, onion, eggs, relish, Dijon mustard, paprika, red pepper flakes, salt, and black pepper."
    },
    {
      "step": 2,
      "text": "Stir in the mayonnaise until evenly coated, adjusting the amount to taste."
    },
    {
      "step": 3,
      "text": "Serve immediately, or keep covered and refrigerated until serving."
    }
