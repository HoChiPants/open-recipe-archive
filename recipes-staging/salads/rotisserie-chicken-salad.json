  "name": "Rotisserie Chicken Salad",
  "subtitle": "Creamy chicken salad with relish, eggs, and mustard",
  "description": "A savory, lightly spiced chicken salad with sweet-hot relish and chopped eggs.",
  "meal_type": "salad",
