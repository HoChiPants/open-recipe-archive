  "id": "corn-tomato-salad",
  "name": "Corn Tomato Salad",
  "subtitle": "A chilled salad of sweet corn, fresh vegetables, and tangy dressing.",
  "description": "Tender corn is cooled, combined with crisp vegetables, and finished with a balsamic-garlic dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
