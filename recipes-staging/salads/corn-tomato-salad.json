  "instructions": [
    {
      "step": 1,
      "text": "Place the cleaned corn in a pot of water, bring to a simmer, and cook for 5 minutes, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Transfer the corn to a plate and let it cool for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Cut the kernels from the cooled ears and place them in a large bowl with the bell pepper, onion, and tomato."
    },
    {
      "step": 4,
      "text": "Whisk together the olive oil, balsamic vinegar, garlic, and black pepper, then pour over the vegetables and toss to coat."
    },
    {
      "step": 5,
      "text": "Refrigerate the salad for 15 minutes before serving.",
      "timer_minutes": 15
    }
  ],
