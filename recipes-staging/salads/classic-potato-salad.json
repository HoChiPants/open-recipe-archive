  "id": "classic-potato-salad",
  "name": "Classic Potato Salad",
  "subtitle": "Creamy potato salad with eggs, pickles, and onion",
  "description": "Tender potatoes and chopped eggs are folded into a creamy, sweet-pickle dressing for a chilled American-style salad.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 15,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 5,
      "unit": "pounds",
      "preparation": "peeled and chopped"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 10
    },
    {
      "ingredient_id": "24-ounce-jar-sweet-pickles",
      "item": "(24 ounce) jar sweet pickles",
      "quantity": 1,
      "preparation": "drained and chopped"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes in a pot, cover with water, and bring to a simmer. Cook until tender, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Drain the potatoes and chill them for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Place the eggs in a pot, cover with water, and cook at a simmer for 15 minutes. Cool, peel, and chop them.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Stir together the chopped eggs, sweet pickles, mayonnaise, and onion until blended."
    },
    {
      "step": 5,
      "text": "Add the chilled potatoes and fold gently until coated."
    },
    {
      "step": 6,
      "text": "Chill the salad for 30 minutes, then serve.",
      "timer_minutes": 30
    }
  ],
