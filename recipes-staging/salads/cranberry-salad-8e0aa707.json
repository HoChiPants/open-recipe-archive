  "instructions": [
    {
      "step": 1,
      "text": "Cut the cranberries until finely chopped, then combine them with the sugar. Cover and chill for 12 hours.",
      "timer_minutes": 720
    },
    {
      "step": 2,
      "text": "Whisk the heavy whipping cream until thick and fluffy."
    },
    {
      "step": 3,
      "text": "Combine the chilled cranberry mixture with the drained pineapple."
    },
    {
      "step": 4,
      "text": "Fold in the whipped cream, pecans, and miniature marshmallows until evenly mixed."
    },
    {
      "step": 5,
      "text": "Chill the salad until ready to serve."
    }
  ],
