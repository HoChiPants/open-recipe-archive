  "id": "broccoli-salad-139fde90",
  "name": "Broccoli Salad",
  "subtitle": "A crisp broccoli salad with bacon, raisins, and almonds",
  "description": "Fresh broccoli, onion, dried fruit, and almonds are tossed with a creamy sweet-tart dressing and crisp bacon.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 0.5,
      "unit": "pound"
    },
    {
      "ingredient_id": "heads-fresh-broccoli",
      "item": "heads fresh broccoli",
      "quantity": 2
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "almonds",
      "item": "almonds",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a skillet over medium heat until crisp, about 10 minutes. Drain, cool, and crumble.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Cut the broccoli into bite-size florets and finely chop the red onion."
    },
    {
      "step": 3,
      "text": "Combine the broccoli, onion, raisins, almonds, and crumbled bacon in a large bowl."
    },
    {
      "step": 4,
      "text": "Whisk the mayonnaise, sugar, and vinegar together until smooth."
    },
    {
      "step": 5,
      "text": "Pour the dressing over the salad and stir until evenly coated."
    },
    {
      "step": 6,
      "text": "Serve immediately or chill until ready to serve."
    }
  ],
