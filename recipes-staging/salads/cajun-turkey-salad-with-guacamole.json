  "instructions": [
    {
      "step": 1,
      "text": "Warm the oil in a large skillet and toast the sesame seeds briefly until fragrant."
    },
    {
      "step": 2,
      "text": "Add the turkey, Cajun seasoning, and sliced red pepper. Stir-fry for 5 minutes, or until the turkey reaches 165°F at the thickest point.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Toss the cooked turkey and pepper with the herb salad, then portion into four servings."
    },
    {
      "step": 4,
      "text": "Top with guacamole and tortilla chips. Chill for 30 minutes before serving.",
      "timer_minutes": 30
    }
  ],
