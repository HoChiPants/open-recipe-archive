  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of water and the salt to a simmer. Add the rotini and cook for 10 minutes, or until tender. Drain well.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the vegetable oil, lime juice, chili powder, cumin, remaining salt, and crushed garlic into a dressing."
    },
    {
      "step": 3,
      "text": "Toss the hot pasta with the dressing, then let it cool until set."
    },
    {
      "step": 4,
      "text": "Stir in the corn, black beans, green and red bell peppers, and cilantro."
    },
    {
      "step": 5,
      "text": "Garnish with the chopped tomatoes and additional cilantro from the measured amount, then serve."
    }
  ],
