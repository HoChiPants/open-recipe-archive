  "id": "easy-arugula-salad",
  "name": "Easy Arugula Salad",
  "subtitle": "Peppery greens with tomatoes, avocado, and Parmesan",
  "description": "A fresh salad combining tender arugula, juicy tomatoes, creamy avocado, toasted-tasting pine nuts, and a light oil-and-vinegar dressing.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "young-arugula-leaves",
      "item": "young arugula leaves",
      "quantity": 4,
      "unit": "cups",
      "preparation": "rinsed and dried"
    },
    {
      "ingredient_id": "cherry-tomatoes",
      "item": "cherry tomatoes",
      "quantity": 1,
      "unit": "cup",
      "preparation": "halved"
    },
    {
      "ingredient_id": "pine-nuts",
      "item": "pine nuts",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "grapeseed-oil-or-olive-oil",
      "item": "grapeseed oil or olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
