      "item": "salt to taste"
    },
    {
      "ingredient_id": "avocado",
      "item": "avocado",
      "quantity": 1,
      "unit": "large",
      "preparation": "peeled, pitted and sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the arugula, tomatoes, pine nuts, and Parmesan in a large bowl."
    },
    {
      "step": 2,
      "text": "Whisk the oil, rice vinegar, and salt together, then pour the dressing over the salad and toss gently."
    },
    {
      "step": 3,
      "text": "Add the sliced avocado and fold gently to combine. Serve immediately."
    }
  ],
