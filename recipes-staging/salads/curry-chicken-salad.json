  "id": "curry-chicken-salad",
  "name": "Curry Chicken Salad",
  "subtitle": "A quick chicken salad with celery and warm curry flavor",
  "description": "Combine cooked chicken and crisp celery with a lightly curried mayonnaise dressing for an easy salad served chilled or at room temperature.",
  "meal_type": "salad",
