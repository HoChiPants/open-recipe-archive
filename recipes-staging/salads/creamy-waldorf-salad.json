  "instructions": [
    {
      "step": 1,
      "text": "Toss the chopped apples with the lemon juice."
    },
    {
      "step": 2,
      "text": "Add the celery, walnuts, raisins, and halved grapes to the apples."
    },
    {
      "step": 3,
      "text": "Whisk the whipped cream and mayonnaise together until smooth."
    },
    {
      "step": 4,
      "text": "Fold the dressing into the fruit mixture, then stir in the nutmeg."
    },
    {
      "step": 5,
      "text": "Cover and refrigerate for 60 minutes before serving.",
      "timer_minutes": 60
    }
