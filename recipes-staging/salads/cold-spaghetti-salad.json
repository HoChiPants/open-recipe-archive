    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of water to a simmer, add the spaghetti, and cook for 10 minutes, or until tender. Drain well.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "If the pepperoni sausage is uncooked, cook it separately and verify with a food thermometer that it reaches 160°F before proceeding."
    },
    {
      "step": 3,
      "text": "Transfer the drained spaghetti to a large bowl. Add the salad dressing and red wine vinegar, tossing to coat."
    },
    {
      "step": 4,
      "text": "Fold in the Parmesan, tomatoes, onion, sausage, mushrooms, olives, and seasoning mix. Stir until evenly combined."
    },
    {
      "step": 5,
      "text": "Cover and chill for 3 hours before serving.",
      "timer_minutes": 180
    }
  ],
