  "id": "cold-spaghetti-salad",
  "name": "Cold Spaghetti Salad",
  "subtitle": "A chilled pasta salad with tomatoes, olives, mushrooms, and Parmesan",
  "description": "Toss tender spaghetti with a tangy dressing, vegetables, cheese, and chopped sausage, then chill before serving.",
  "meal_type": "salad",
  "cuisine": "Italian Inspired",
