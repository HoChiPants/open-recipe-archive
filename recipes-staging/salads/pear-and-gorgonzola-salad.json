  "id": "pear-and-gorgonzola-salad",
  "name": "Pear and Gorgonzola Salad",
  "subtitle": "Grilled pears with port dressing and toasted walnuts",
  "description": "A composed salad of grilled pears, sharp Gorgonzola, toasted walnuts, and greens dressed with a smooth port reduction.",
  "meal_type": "salad",
