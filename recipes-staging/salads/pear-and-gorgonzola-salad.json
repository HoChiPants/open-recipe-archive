  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Arrange the sliced pears in a single layer and grill for 5 minutes, turning as needed. Cool until set.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Transfer the port wine to a saucepan and simmer until reduced and concentrated."
    },
    {
      "step": 3,
      "text": "Preheat as needed for finishing the dressing. Add the shallots, garlic, Dijon mustard, and balsamic vinegar to the reduced port wine; prepare until smooth."
    },
    {
      "step": 4,
      "text": "Prepare and transfer the salad greens to a serving bowl. Add the grilled pears, crumbled Gorgonzola cheese, and toasted walnuts, then toss gently with the dressing."
    }
  ],
