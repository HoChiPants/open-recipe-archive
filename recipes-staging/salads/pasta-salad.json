  "instructions": [
    {
      "step": 1,
      "text": "Cook the pasta in boiling water for 12 minutes, or until tender. Drain well.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Whisk the salad dressing and seasoning mix until smooth."
    },
    {
