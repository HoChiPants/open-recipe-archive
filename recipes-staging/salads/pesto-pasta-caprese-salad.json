  "id": "pesto-pasta-caprese-salad",
  "name": "Pesto Pasta Caprese Salad",
  "subtitle": "Tender pasta with pesto, tomatoes, mozzarella, and basil",
  "description": "A simple Italian-inspired pasta salad combining pesto-coated rotini with juicy tomatoes, fresh mozzarella, and shredded basil.",
  "meal_type": "salad",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "rotini-pasta",
      "item": "rotini pasta",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "pesto",
      "item": "pesto",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "granulated-garlic",
      "item": "granulated garlic",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "grape-tomatoes",
      "item": "grape tomatoes",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "halved"
    },
    {
      "ingredient_id": "small-pearlini-fresh-mozzarella-balls",
      "item": "small (pearlini) fresh mozzarella balls",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "leaves-fresh-basil-leaves",
      "item": "leaves fresh basil leaves",
      "quantity": 2,
      "preparation": "finely shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer and season it with the salt."
    },
    {
      "step": 2,
      "text": "Add the rotini and simmer for about 8 minutes, or until tender. Drain well.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "In a bowl, stir together the pesto, olive oil, granulated garlic, black pepper, and salt to taste."
    },
    {
      "step": 4,
      "text": "Add the drained pasta and toss until evenly coated."
    },
    {
      "step": 5,
      "text": "Fold in the halved tomatoes, mozzarella balls, and shredded basil. Serve."
    }
  ],
