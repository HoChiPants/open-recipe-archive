  "instructions": [
    {
      "step": 1,
      "text": "Combine the finely ground cranberries and sugar. Cover and refrigerate for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Beat the whipped cream to soft peaks."
    },
    {
      "step": 3,
      "text": "Drain any excess liquid from the cranberries, then combine them with the pineapple, marshmallows, pecans, and whipped cream."
    },
    {
      "step": 4,
      "text": "Transfer the salad to a serving bowl, cover, and refrigerate for 1 hour before serving.",
      "timer_minutes": 60
    }
  ],
