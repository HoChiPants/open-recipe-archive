  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of salted water to a simmer. Add the rotini and cook for 10 minutes, or until tender; drain well.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk together 1 cup of the dressing, Parmesan, parsley, garlic, and salt and pepper to taste."
    },
    {
      "step": 3,
      "text": "Combine the drained pasta with the bell pepper, zucchini, onion, salami, pepperoni, mozzarella, artichoke hearts, olives, and broccoli."
    },
    {
      "step": 4,
      "text": "Pour in the prepared dressing mixture and the remaining 1 cup dressing; toss until evenly coated."
    },
    {
      "step": 5,
      "text": "Cover and chill for 15 minutes. Garnish with the quartered tomato before serving.",
      "timer_minutes": 15
    }
  ],
