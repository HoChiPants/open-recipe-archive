  "instructions": [
    {
      "step": 1,
      "text": "Cut the tomatoes into bite-size pieces and place them in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the red onion, sea salt, and dried oregano; toss gently."
    },
    {
      "step": 3,
      "text": "Let the tomato mixture stand for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Add the green bell pepper, cucumber, black olives, and olive oil, and toss to combine."
    },
    {
      "step": 5,
      "text": "Cut the feta into pieces and arrange it over the salad before serving."
    }
