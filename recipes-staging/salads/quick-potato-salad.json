  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water seasoned with some of the salt and pepper to a simmer. Add the diced potatoes and cook until tender, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Drain the potatoes and let excess moisture evaporate briefly."
    },
    {
      "step": 3,
      "text": "Place the potatoes, eggs, cucumber, tomato, celery, onion, and green onion in a bowl. Add the mayonnaise and mustard."
    },
    {
      "step": 4,
      "text": "Fold the mixture together until evenly coated, then adjust the salt and pepper to taste."
    }
