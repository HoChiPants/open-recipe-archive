  "id": "candied-walnut-and-gorgonzola-salad",
  "name": "Candied Walnut and Gorgonzola Salad",
  "subtitle": "Sweet, crisp, and tangy green salad",
  "description": "Mixed greens, dried cranberries, Gorgonzola, and candied walnuts tossed with a simple raspberry vinaigrette.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
