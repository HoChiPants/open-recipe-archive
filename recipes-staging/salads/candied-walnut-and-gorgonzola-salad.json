  "instructions": [
    {
      "step": 1,
      "text": "Preheat a dry skillet over medium heat. Add the walnut halves and sugar, stirring often until the sugar melts and coats the walnuts, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Transfer the candied walnuts to a plate and let them cool briefly."
    },
    {
      "step": 3,
      "text": "Combine the mixed greens, dried cranberries, Gorgonzola, raspberry vinaigrette, white vinegar, and olive oil in a large bowl; toss to coat."
    },
    {
      "step": 4,
      "text": "Add the candied walnuts, toss gently, and serve."
    }
  ],
