  "instructions": [
    {
      "step": 1,
      "text": "Cook the rotelli pasta in boiling water until tender, then drain and cool."
    },
    {
      "step": 2,
      "text": "Stir together the creamy salad dressing, Italian-style salad dressing, and Parmesan cheese."
    },
    {
      "step": 3,
      "text": "Combine the pasta, salami, bell pepper, olives, and red onion with the dressing mixture."
    },
