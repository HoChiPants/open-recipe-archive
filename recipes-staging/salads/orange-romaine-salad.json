  "id": "orange-romaine-salad",
  "name": "Orange Romaine Salad",
  "subtitle": "Crisp romaine with citrus and honey dressing",
  "description": "A bright salad combining crunchy romaine and thinly sliced oranges with a tangy, lightly sweet dressing.",
  "meal_type": "salad",
  "cuisine": "American",
