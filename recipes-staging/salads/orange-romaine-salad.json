  "instructions": [
    {
      "step": 1,
      "text": "Combine the red wine vinegar, honey, salt, pepper, and green onion in a bowl. Blend in the vegetable oil until the dressing is combined."
    },
    {
      "step": 2,
      "text": "Add the romaine and toss until evenly coated with the dressing."
    },
    {
      "step": 3,
      "text": "Add the orange slices, toss gently, and serve."
    }
  ],
