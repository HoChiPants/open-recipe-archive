  "instructions": [
    {
      "step": 1,
      "text": "Stir the mayonnaise, garlic powder, and black pepper together in a bowl."
    },
    {
      "step": 2,
      "text": "Add the drained tuna and peas, and fold gently until evenly coated."
    },
    {
      "step": 3,
      "text": "Canned tuna is ready to eat; if using uncooked fish instead, cook it to 145°F, or until opaque and easily flaked, before combining."
    }
