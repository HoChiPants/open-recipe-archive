  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Heat a skillet over medium heat and cook the sliced onion for 7 minutes, until softened.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Transfer the onion to a baking dish. Add the olive oil, eggplant, bell pepper, and salt and pepper; toss to coat."
    },
    {
      "step": 3,
      "text": "Cook the vegetables for 5 minutes, then stir in the tomato, garlic, parsley, and additional salt and pepper as needed.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Bake at 350°F for 30 minutes, until the vegetables are tender.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Let the salad cool for 60 minutes, then chill before serving.",
      "timer_minutes": 60
    }
  ],
