  "instructions": [
    {
      "step": 1,
      "text": "If the chicken is not fully cooked, cook it to an internal temperature of 165°F, then cool and drain it."
    },
    {
      "step": 2,
      "text": "Whisk the mayonnaise, sugar, and vinegar until smooth."
    },
    {
      "step": 3,
      "text": "Combine the chicken, celery, grapes, onion, dill, salt, and pepper. Fold in the dressing."
    },
    {
      "step": 4,
      "text": "Spoon the salad into the split croissants."
    },
    {
      "step": 5,
      "text": "Chill the filled croissants for 30 minutes before serving.",
