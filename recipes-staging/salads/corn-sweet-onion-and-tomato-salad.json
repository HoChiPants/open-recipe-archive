  "instructions": [
    {
      "step": 1,
      "text": "Drain the corn. Combine it with the tomatoes, sweet onions, green onions, and cilantro in a large bowl."
    },
    {
      "step": 2,
      "text": "Stir together the lime juice, rice vinegar, and kosher salt to taste."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the vegetables and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Cover and chill for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Stir before serving."
    }
  ],
