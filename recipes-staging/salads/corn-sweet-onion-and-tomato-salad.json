  "id": "corn-sweet-onion-and-tomato-salad",
  "name": "Corn, Sweet Onion, and Tomato Salad",
  "subtitle": "A bright, chilled vegetable salad with lime and cilantro",
  "description": "Corn, tomatoes, onions, and cilantro are tossed with lime juice, vinegar, and salt, then chilled for a refreshing side dish.",
  "meal_type": "salad",
  "yield": {
    "quantity": 8,
    "unit": "servings"
