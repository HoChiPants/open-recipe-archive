  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grill. Arrange the feta in a baking dish and coat with the olive oil, garlic, thyme, chillies, and orange zest."
    },
    {
      "step": 2,
      "text": "Bake the feta until heated through and set. Let it rest briefly in the dish with the aromatics.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Prepare the courgettes and green beans for grilling, then grill until tender and lightly marked.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Toast the breadcrumbs and hazelnuts together until crisp and golden."
    },
    {
      "step": 5,
      "text": "Arrange the grilled vegetables on a serving platter. Add the feta, scatter over the breadcrumb mixture, and finish with the extra virgin olive oil to serve."
    }
  ],
