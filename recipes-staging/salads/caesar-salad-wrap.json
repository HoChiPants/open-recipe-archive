  "id": "caesar-salad-wrap",
  "name": "Caesar Salad Wrap",
  "subtitle": "A crisp romaine wrap with creamy Caesar dressing and chicken",
  "description": "Combine a savory Caesar-style dressing with chopped romaine, giardiniera, and sliced leftover chicken, then roll everything in flour tortillas.",
  "meal_type": "salad",
