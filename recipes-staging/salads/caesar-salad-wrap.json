  "instructions": [
    {
      "step": 1,
      "text": "Mash the garlic and anchovies together until thick and well combined. Use only fully cooked leftover chicken; if reheating it, heat to 165°F."
    },
    {
      "step": 2,
      "text": "Stir the mayonnaise, grated Parmesan, Dijon mustard, and giardiniera pickling liquid into the garlic-anchovy mixture. Fold in the chopped giardiniera."
    },
    {
      "step": 3,
      "text": "Spread the dressing over the flour tortillas. Divide the sliced chicken and chopped romaine between them."
    },
    {
      "step": 4,
      "text": "Add the remaining giardiniera, roll the tortillas tightly, and serve."
    }
  ],
