  "id": "broccoli-cauliflower-salad",
  "name": "Broccoli-Cauliflower Salad",
  "subtitle": "A crisp vegetable salad with bacon and a sweet-tangy dressing.",
  "description": "Fresh broccoli and cauliflower are tossed with bacon, sunflower seeds, onion, and a creamy vinegar dressing for a crunchy side salad.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 12
    },
    {
      "ingredient_id": "head-cauliflower",
      "item": "head cauliflower",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "head-fresh-broccoli",
      "item": "head fresh broccoli",
      "quantity": 1,
      "preparation": "diced"
    },
    {
      "ingredient_id": "sunflower-seeds",
      "item": "sunflower seeds",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 0.5,
      "preparation": "diced"
    },
    {
      "ingredient_id": "creamy-salad-dressing",
      "item": "creamy salad dressing",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon until crisp, then drain and crumble it."
    },
    {
      "step": 2,
      "text": "Combine the cauliflower, broccoli, sunflower seeds, red onion, and crumbled bacon in a large bowl."
    },
    {
      "step": 3,
      "text": "Whisk the creamy salad dressing, white wine vinegar, and white sugar until smooth."
    },
    {
      "step": 4,
      "text": "Pour the dressing over the salad and toss until evenly coated."
    },
    {
      "step": 5,
      "text": "Chill until ready to serve."
    }
  ],
