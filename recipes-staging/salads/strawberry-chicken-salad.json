  "instructions": [
    {
      "step": 1,
      "text": "Whisk the mayonnaise, lemon juice, honey, and poppy seeds until smooth."
    },
    {
      "step": 2,
      "text": "Add the cooked chicken, strawberries, pecans, celery, green onions, and parsley. Fold gently until evenly coated."
    },
    {
      "step": 3,
      "text": "Season with salt and ground black pepper to taste, then serve."
    }
