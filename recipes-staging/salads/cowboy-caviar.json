  "id": "cowboy-caviar",
  "name": "Cowboy Caviar",
  "subtitle": "A bright bean, corn, and vegetable salad for scooping",
  "description": "Toss beans, corn, chopped vegetables, avocado, and herbs with a simple lime dressing, then serve with tortilla chips.",
  "meal_type": "salad",
