  "instructions": [
    {
      "step": 1,
      "text": "Combine the black beans, sweetcorn, tomatoes, red onion, and pepper in a large bowl."
    },
    {
      "step": 2,
      "text": "Whisk the olive oil with the lime juice, or red wine vinegar, until blended."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the salad and toss gently. Fold in the avocado and coriander if using."
    },
    {
      "step": 4,
      "text": "Serve immediately with tortilla chips."
    }
