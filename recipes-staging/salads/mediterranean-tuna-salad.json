  "id": "mediterranean-tuna-salad",
  "name": "Mediterranean Tuna Salad",
  "subtitle": "A bright, herb-flecked tuna salad with lemon and olive oil.",
  "description": "Toss tuna with red onion and parsley, then dress it with lemon, olive oil, and seasoning for a quick no-mayo salad.",
  "meal_type": "salad",
  "cuisine": "Mediterranean Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
