      "ingredient_id": "chunk-light-tuna-in-water",
      "item": "chunk light tuna in water",
      "quantity": 2,
      "unit": "can",
      "preparation": "5 ounce, drained"
    },
    {
      "ingredient_id": "finely-chopped-red-onion",
      "item": "finely chopped red onion",
      "quantity": 0.25,
