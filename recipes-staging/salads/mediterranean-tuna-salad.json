      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Confirm the tuna is cooked to 145°F, or is opaque and flakes easily, before using."
    },
    {
      "step": 2,
      "text": "Whisk the lemon juice, lemon zest, salt, and black pepper with the olive oil."
    },
    {
      "step": 3,
      "text": "Combine the drained tuna, red onion, and parsley in a bowl. Add the dressing and toss gently until evenly coated."
    }
