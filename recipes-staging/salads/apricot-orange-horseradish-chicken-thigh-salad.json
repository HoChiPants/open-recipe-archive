  "id": "apricot-orange-horseradish-chicken-thigh-salad",
  "name": "Apricot-Orange Horseradish Chicken Thigh Salad",
  "subtitle": "Glazed chicken over a crisp, colorful salad",
  "description": "Juicy air-fried chicken thighs are coated in a tangy apricot-orange glaze and served with crunchy vegetables, pecans, pomegranate, and a honey-cider dressing.",
  "meal_type": "salad",
