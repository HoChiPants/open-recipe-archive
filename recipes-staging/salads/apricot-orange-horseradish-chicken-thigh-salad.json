  "instructions": [
    {
      "step": 1,
      "text": "Mix the apricot jam, the zest and juice of the orange, and horseradish. Coat the chicken thighs with the mixture and set aside to marinate.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Toast the pecans in a dry pan over medium heat until fragrant, then cool and roughly chop.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Combine the radishes, carrots, spring onions, pomegranate seeds, and parsley in a large bowl."
    },
    {
      "step": 4,
      "text": "Whisk the extra virgin olive oil, orange juice, honey, cider vinegar, and horseradish into a dressing. Toss it with the salad."
    },
    {
      "step": 5,
      "text": "Preheat the air fryer according to the manufacturer's instructions. Lightly coat the basket with olive oil spray and arrange the chicken thighs skin-side up in a single layer."
    },
    {
      "step": 6,
      "text": "Air-fry the chicken for 8 minutes, then turn and cook for 12 minutes more, or until the thickest part reaches 165°F.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Slice or serve the chicken over the salad and scatter with the toasted pecans."
    }
  ],
