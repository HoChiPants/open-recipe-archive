  "id": "spinach-go-zleme-style-tortillas",
  "name": "Spinach Gözleme-Style Tortillas",
  "subtitle": "Crisp folded tortillas with lemony spinach and feta-style cheese",
  "description": "Fold seasoned spinach, onion, dill, and salad cheese into wholemeal tortillas, then cook until crisp. Serve with a fresh cucumber-pomegranate salad and tzatziki.",
  "meal_type": "salad",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
