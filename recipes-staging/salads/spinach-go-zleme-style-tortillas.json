  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a skillet. Cook the red onion for 5 minutes, then add the garlic and stir for 3 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the spinach and cook for 5 minutes, until wilted. Stir in the lemon zest and juice and the chopped dill, then combine with the onion and garlic.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Mix in the crumbled salad cheese. Divide the filling among the tortillas, fold them over, and brush the edges with beaten egg to seal."
    },
    {
      "step": 4,
      "text": "Heat a clean skillet and cook the folded tortillas for about 5 minutes, turning as needed, until crisp and the egg is fully set at the center, reaching 160°F.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Toss the cucumber with the pomegranate seeds and remaining lemon juice. Serve the gözleme-style tortillas with the salad, tzatziki, and extra dill."
    }
  ],
