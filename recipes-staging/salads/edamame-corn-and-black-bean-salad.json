  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cilantro, vinegar, grapeseed oil, lime juice, garlic, sugar, and 0.25 teaspoon salt in a bowl to make the dressing."
    },
    {
      "step": 2,
      "text": "Bring a pot of water seasoned with the remaining 0.5 teaspoon salt to a simmer. Add the edamame and cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the corn, then drain the edamame and corn well."
    },
    {
      "step": 4,
      "text": "Combine the warm vegetables with the black beans, tomatoes, and green onions. Toss with the dressing."
    },
    {
      "step": 5,
      "text": "Cover and chill for 2 hours before serving.",
      "timer_minutes": 120
    }
  ],
