  "id": "broccoli-cashew-salad",
  "name": "Broccoli Cashew Salad",
  "subtitle": "A crisp broccoli salad with bacon, raisins, and cashews",
  "description": "Fresh broccoli, savory bacon, sweet raisins, and crunchy cashews are tossed in a tangy mayonnaise dressing and chilled before serving.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cider-vinegar",
      "item": "cider vinegar",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-broccoli",
      "item": "fresh broccoli",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "broken into florets"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "roasted-cashews",
      "item": "roasted cashews",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 0.25,
      "preparation": "finely chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon until crisp, about 10 minutes. Drain, cool, and crumble it.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the mayonnaise, cider vinegar, and white sugar in a large bowl until smooth."
    },
    {
      "step": 3,
      "text": "Add the bacon, broccoli florets, raisins, roasted cashews, and red onion. Stir until evenly coated."
    },
    {
      "step": 4,
      "text": "Cover and chill for 2 hours before serving.",
      "timer_minutes": 120
    }
  ],
