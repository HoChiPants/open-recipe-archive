      "item": "russet potatoes",
      "quantity": 3
    },
    {
      "ingredient_id": "1-2-inch-cubes-roast-beef",
      "item": "1/2-inch cubes roast beef",
      "quantity": 2,
      "unit": "cups"
    },
    {
