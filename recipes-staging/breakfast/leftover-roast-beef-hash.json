  "id": "leftover-roast-beef-hash",
  "name": "Leftover Roast Beef Hash",
  "subtitle": "A skillet-style hash with tender potatoes and vegetables",
  "description": "Microwave the potatoes until tender, then combine them with roast beef and vegetables for a quick, savory hash.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
