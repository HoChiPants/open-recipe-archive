      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes in a microwave-safe dish and microwave for 8 minutes, or until tender.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Cut the tender potatoes into bite-size pieces and combine them with the roast beef, onion, bell pepper, and mushrooms."
    },
    {
      "step": 3,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 4,
      "text": "Coat a baking dish with the vegetable oil and transfer the hash mixture to it."
    },
    {
      "step": 5,
      "text": "Cook for 5 minutes, then prepare or portion the hash as desired.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "If the roast beef was not previously cooked, verify that it reaches 145°F and rest it for 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
