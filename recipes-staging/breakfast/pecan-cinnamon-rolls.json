  "instructions": [
    {
      "step": 1,
      "text": "Stir the warm water, yeast, and 1 teaspoon sugar together. Let stand until foamy, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Combine the warm milk, 0.66666668653488 cup sugar, 0.66666668653488 cup melted butter, eggs, and salt. Stir in the yeast mixture, then add 6 cups flour and mix until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Turn the dough onto a floured surface and knead with the remaining flour until soft and elastic, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Place the dough in a buttered bowl, cover, and let rise in a warm place until doubled, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Coat baking pans with 0.5 cup melted butter and sprinkle with 0.33333334326744 cup sugar and the pecans."
    },
    {
      "step": 6,
      "text": "Mix 1.5 cups sugar with the cinnamon. Roll the dough into a large rectangle, brush with the remaining 0.5 cup melted butter, and cover with the cinnamon sugar."
    },
    {
      "step": 7,
      "text": "Roll the dough tightly from one long side, cut it into 18 pieces, and arrange the pieces in the prepared pans. Cover and let rise until puffy, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 9,
      "text": "Bake until golden brown and cooked through, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 10,
      "text": "Whisk the confectioners' sugar, 0.66666668653488 cup melted butter, vanilla extract, and maple-flavored extract until smooth. Spread over the warm rolls."
    }
  ],
