  "id": "blood-orange-cardamom-aebleskiver",
  "name": "Blood Orange Cardamom Aebleskiver",
  "subtitle": "Citrusy Danish-style pancake bites with warm cardamom",
  "description": "Light, round pancake bites flavored with blood orange, cardamom, and buttermilk, finished with a dusting of icing sugar.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-cardamom",
      "item": "ground cardamom",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "eggs-separated",
      "item": "eggs separated",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "blood-orange-zested",
      "item": "blood orange zested",
      "quantity": 1
    },
    {
      "ingredient_id": "blood-orange-juice",
      "item": "blood orange juice",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "butter-melted-and-cooled",
      "item": "butter melted and cooled",
      "quantity": 50,
      "unit": "g",
      "preparation": "plus extra for greasing"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "icing-sugar-to-dust",
      "item": "icing sugar to dust"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, baking powder, and cardamom together in a bowl."
    },
    {
      "step": 2,
      "text": "In a separate bowl, whisk the buttermilk, egg yolks, orange zest, orange juice, and cooled melted butter until smooth."
    },
    {
      "step": 3,
      "text": "Stir the wet mixture into the dry ingredients until just combined."
    },
    {
      "step": 4,
      "text": "Whisk the egg whites with the caster sugar until stiff peaks form, then fold them gently into the batter."
    },
    {
      "step": 5,
      "text": "Heat an aebleskiver pan over medium heat and grease the wells with butter."
    },
    {
      "step": 6,
      "text": "Fill each well about three-quarters full. Cook until the bottoms are set and lightly browned, about 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 7,
      "text": "Turn each pancake bite with a skewer or fork and continue cooking, turning as needed, until browned and cooked through."
    },
    {
      "step": 8,
      "text": "Serve warm with icing sugar dusted over the top."
    }
  ],
