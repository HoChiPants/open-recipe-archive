  "id": "bran-fruit-loaf-cake",
  "name": "Bran Fruit Loaf Cake",
  "subtitle": "A simple fruit-studded loaf with a tender crumb",
  "description": "Soaked bran, dried fruit, almonds, flour, and brown sugar combine into an easy loaf cake for breakfast or snacking.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0,
    "inactive_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "all-bran",
      "item": "All-Bran",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "mixed-dried-fruit-i-tend-to-use-apricots-and-prunes-for-a-juicier-cake-and-almonds-if-desired",
      "item": "mixed dried fruit (I tend to use apricots and prunes for a juicier cake) and almonds (if desired)",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "or-1-cup-soft-brown-sugar-depending-on-desired-sweetness",
      "item": "or 1 cup soft brown sugar (depending on desired sweetness)",
      "quantity": "1/2",
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a loaf pan."
    },
    {
      "step": 2,
      "text": "Combine the All-Bran and milk; let stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the self-raising flour and brown sugar. Cut the dried fruit and almonds into smaller pieces, then stir them into the mixture."
    },
    {
      "step": 4,
      "text": "Add enough of the soaked bran mixture to make a thick batter, then transfer the batter to the prepared loaf pan."
    },
    {
      "step": 5,
      "text": "Bake until the loaf is set in the center, about 60 minutes. Let it cool before slicing.",
      "timer_minutes": 60
    }
  ],
