  "id": "ham-and-egg-muffins",
  "name": "Ham and Egg Muffins",
  "subtitle": "Individual baked egg cups with spinach, pepper, ham, and feta",
  "description": "These savory egg muffins combine vegetables, diced ham, and feta in a convenient breakfast portion.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6,
      "unit": "large"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "thawed and drained"
    },
    {
      "ingredient_id": "red-bell-pepper",
      "item": "red bell pepper",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fully-cooked-ham",
      "item": "fully cooked ham",
      "quantity": 7,
      "unit": "ounces",
      "preparation": "diced"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "crumbled-feta-cheese",
      "item": "crumbled feta cheese",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Coat a 12-cup muffin pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, egg whites, water, salt, and pepper in a bowl. Stir in the spinach, bell pepper, feta, and diced ham."
    },
    {
      "step": 3,
      "text": "Divide the mixture evenly among the prepared muffin cups."
    },
    {
      "step": 4,
      "text": "Bake for about 25 minutes, until the centers are firm and fully set; verify the egg mixture reaches 160°F.",
      "timer_minutes": 25
    }
  ],
