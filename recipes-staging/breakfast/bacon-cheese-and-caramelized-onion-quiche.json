  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Cook the bacon for 10 minutes, then drain and cool for 10 minutes before crumbling.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Fit the pie crust into a 9-inch pie dish. Brush it with the beaten egg, prick the bottom, and blind-bake for 15 minutes. Remove any weights and bake 5 minutes more.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet over medium heat. Add the onion and stir for 5 minutes, then continue cooking until tender and caramelized, about 40 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "Whisk the 2 eggs, sour cream, softened cream cheese, and Cheddar until combined. Mix in the salt and pepper."
    },
    {
      "step": 5,
      "text": "Spread the caramelized onion in the crust, add the cheese mixture, and scatter the bacon over the top."
    },
    {
      "step": 6,
      "text": "Bake until the center is firm and reaches 160°F on a food thermometer, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Cool the quiche for 10 minutes before slicing.",
      "timer_minutes": 10
    }
  ],
