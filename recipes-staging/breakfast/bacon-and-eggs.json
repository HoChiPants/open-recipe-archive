  "id": "bacon-and-eggs",
  "name": "Bacon and Eggs",
  "subtitle": "Crisp bacon with simply seasoned eggs",
  "description": "A straightforward breakfast of bacon and fully set eggs seasoned to taste.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
