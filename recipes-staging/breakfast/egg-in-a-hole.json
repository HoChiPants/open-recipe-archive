  "id": "egg-in-a-hole",
  "name": "Egg in a Hole",
  "subtitle": "Crisp toast with a skillet-cooked egg",
  "description": "Bread toasted in bacon grease surrounds an egg cooked in its center, finished with simple seasoning.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "bacon-grease",
      "item": "bacon grease",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "slice-bread",
      "item": "slice bread",
      "quantity": 1
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the bacon grease in a skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Cut a hole from the center of the bread and place the bread in the skillet; cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Crack the egg into the opening and season with salt and ground black pepper to taste."
    },
    {
      "step": 4,
      "text": "Cook until the egg white is set and the center is firm, reaching 160°F on a food thermometer."
    },
    {
      "step": 5,
      "text": "Turn the bread and egg, then cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
