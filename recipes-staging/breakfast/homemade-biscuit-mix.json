  "id": "homemade-biscuit-mix",
  "name": "Homemade Biscuit Mix",
  "subtitle": "A make-ahead dry mix for quick biscuits",
  "description": "Combine flour, leavening, sugar, salt, and oil to create a ready-to-use biscuit mix.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
