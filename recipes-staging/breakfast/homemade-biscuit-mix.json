  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 10,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1.25,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "In a large bowl, whisk together the flour, baking powder, sugar, and salt."
    },
    {
      "step": 2,
      "text": "Add the vegetable oil and mix until evenly incorporated and the mixture has a consistent crumbly texture."
    },
    {
      "step": 3,
      "text": "Transfer the biscuit mix to a clean, airtight container."
    }
  ],
