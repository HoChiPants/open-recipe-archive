  "id": "chia-almond-overnight-oats",
  "name": "Chia-Almond Overnight Oats",
  "subtitle": "A cool, creamy make-ahead breakfast with berries and toasted almonds.",
  "description": "Combine oats, chia seeds, almond milk, and vanilla, then layer with berries, almond yogurt, and toasted almonds for a simple chilled breakfast.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "jumbo-porridge-oats",
      "item": "jumbo porridge oats",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "chia-seeds",
      "item": "chia seeds",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "unsweetened-almond-milk-plus-8-tbsp",
      "item": "unsweetened almond milk plus 8 tbsp",
      "quantity": 600,
      "unit": "ml"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "punnet-raspberries",
      "item": "punnet raspberries",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "almond-yogurt",
      "item": "almond yogurt",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "punnet-blueberries",
      "item": "punnet blueberries",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "flaked-almonds-toasted",
      "item": "flaked almonds toasted",
      "quantity": 20,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the jumbo porridge oats, chia seeds, unsweetened almond milk plus 8 tbsp, and vanilla extract together in a bowl."
    },
    {
      "step": 2,
      "text": "Let the mixture stand for 10 minutes, then stir in the raspberries and almond yogurt.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Chill until cold and thickened."
    },
    {
      "step": 4,
      "text": "Spoon into serving dishes and top with the blueberries and flaked almonds toasted."
    }
  ],
