      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Line a baking sheet with parchment."
    },
    {
      "step": 2,
      "text": "Whisk the flour, 1/2 cup sugar, baking powder, baking soda, and salt in a bowl."
    },
    {
      "step": 3,
      "text": "Cut in the butter until the mixture resembles coarse crumbs."
    },
    {
      "step": 4,
      "text": "Stir in the milk, vanilla, and most of the beaten eggs until a shaggy dough forms. Fold in the frozen blueberries gently."
    },
    {
      "step": 5,
      "text": "Turn the dough onto a lightly floured surface, shape it into a round, and cut it into 10 wedges. Transfer to the baking sheet."
    },
    {
      "step": 6,
      "text": "Brush the tops with the remaining beaten egg and sprinkle with 2 tablespoons sugar."
    },
    {
      "step": 7,
      "text": "Bake until golden brown, about 15 minutes.",
      "timer_minutes": 15
    }
  ],
