  "id": "blueberry-scones",
  "name": "Blueberry Scones",
  "subtitle": "Tender scones with bright berry flavor",
  "description": "A simple American-style scone with frozen blueberries, a lightly sweet crust, and a tender crumb.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
