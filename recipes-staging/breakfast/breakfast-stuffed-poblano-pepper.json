  "id": "breakfast-stuffed-poblano-pepper",
  "name": "Breakfast Stuffed Poblano Pepper",
  "subtitle": "Roasted poblano filled with eggs, vegetables, and melted cheese",
  "description": "A single roasted poblano pepper filled with tender scrambled eggs, fresh vegetables, herbs, and a cheesy topping.",
  "meal_type": "breakfast",
