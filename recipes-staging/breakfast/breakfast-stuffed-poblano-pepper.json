  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Coat the poblano with olive oil and season with salt and pepper. Place it in a baking dish and roast until tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Whisk the eggs and milk in a bowl. Fold in the tomato, mushroom, green onion, and cilantro; season with salt and pepper."
    },
    {
      "step": 4,
      "text": "Melt the butter in a skillet over medium heat. Add the egg mixture and stir for about 5 minutes, until the eggs are set and reach 160°F.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Fill the roasted pepper with the eggs and top with the shredded cheese."
    },
    {
      "step": 6,
      "text": "Bake until the cheese is melted, about 5 minutes.",
      "timer_minutes": 5
    }
  ],
