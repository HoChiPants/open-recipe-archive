  "instructions": [
    {
      "step": 1,
      "text": "Lightly coat a small heatproof air-fryer-safe dish with the oil, then crack in the eggs."
    },
    {
      "step": 2,
      "text": "Preheat the air fryer for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Place the dish in the air fryer and cook the eggs for 8 minutes, or until the whites and centers are firm and fully set.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Carefully remove the dish and serve the eggs hot."
    }
