  "id": "air-fryer-fried-eggs",
  "name": "Air Fryer Fried Eggs",
  "subtitle": "Set whites and fully cooked centers with minimal effort",
  "description": "Eggs cooked in a lightly oiled dish in the air fryer for a simple breakfast or side.",
  "meal_type": "breakfast",
