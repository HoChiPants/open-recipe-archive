{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "green-chile-cheese-casserole",
  "name": "Green Chile Cheese Casserole",
  "subtitle": "A layered baked casserole with green chiles, eggs, and two cheeses.",
  "description": "Green chiles, shredded cheese, and an egg-based custard bake together before being topped with enchilada sauce and more cheese.",
  "meal_type": "breakfast",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "whole-green-chiles",
      "item": "whole green chiles",
      "quantity": 2,
      "unit": "can",
      "preparation": "7 ounce, drained"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "pound",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 1.5,
      "unit": "can",
      "preparation": "5 ounce"
    },
    {
      "ingredient_id": "monterey-jack-cheese",
      "item": "Monterey Jack cheese",
      "quantity": 1,
      "unit": "pound",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "green-enchilada-sauce",
      "item": "green enchilada sauce",
      "quantity": 2,
      "unit": "can",
      "preparation": "10 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Arrange the drained green chiles in the dish. Layer in the Cheddar and Monterey Jack cheeses, reserving some of both cheeses for the topping."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, flour, and evaporated milk until smooth, then pour the mixture over the layered chiles and cheese."
    },
    {
      "step": 4,
      "text": "Bake for 30 minutes, until the center is set and reaches 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Top with the reserved Cheddar and Monterey Jack cheeses, then add the remaining green chiles and pour the enchilada sauce over the casserole."
    },
    {
      "step": 6,
      "text": "Bake until the topping is melted and the center remains fully set, about 15 minutes.",
      "timer_minutes": 15
    }
  ],
