  "id": "chocolate-overnight-oats",
  "name": "Chocolate Overnight Oats",
  "subtitle": "A creamy cocoa oat breakfast with berries",
  "description": "Mix oats with yogurt, cocoa, sweetener, and milk, then finish with raspberries for a simple chocolate breakfast.",
