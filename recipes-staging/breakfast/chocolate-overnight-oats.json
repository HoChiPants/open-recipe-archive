  "instructions": [
    {
      "step": 1,
      "text": "Measure the oats, yogurt, cocoa powder, sweetener, and milk. Set out the jam jars or serving containers."
    },
    {
      "step": 2,
      "text": "Divide the oats between the jars. Add the yogurt, cocoa powder, and sweetener, using the listed spoons to measure."
    },
    {
      "step": 3,
      "text": "Pour in the milk and stir each jar until the mixture is evenly combined."
    },
    {
      "step": 4,
      "text": "Top with the raspberries and add the remaining sweetener as a drizzle."
    }
