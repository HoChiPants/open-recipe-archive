  "id": "almond-flour-pancakes",
  "name": "Almond Flour Pancakes",
  "subtitle": "Tender pancakes with almond flour and blueberries",
  "description": "A simple breakfast batter made with almond flour, almond milk, eggs, and maple syrup, cooked in a skillet and served with blueberries.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "almond-milk",
      "item": "almond milk",
      "quantity": 60,
      "unit": "ml"
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "almond-flour",
