      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "blueberries-to-serve",
      "item": "blueberries to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs, almond milk, maple syrup, almond flour, baking powder, and vanilla extract into a smooth batter."
    },
    {
      "step": 2,
      "text": "Preheat a skillet over medium heat."
    },
    {
      "step": 3,
      "text": "Add portions of batter to the skillet and cook until the surfaces are set.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Turn the pancakes and cook until lightly browned and cooked through.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Prepare the remaining pancakes in the same way."
    },
    {
      "step": 6,
      "text": "Serve with blueberries."
    }
  ],
