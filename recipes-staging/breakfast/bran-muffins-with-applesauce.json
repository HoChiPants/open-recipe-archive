  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F and prepare a 12-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Whisk the brown sugar, applesauce, canola oil, egg, vanilla, and salt in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, mix the whole wheat flour, wheat bran, ground flax, baking soda, and baking powder."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the wet mixture, pour in the milk, and stir just until combined."
    },
    {
      "step": 5,
      "text": "Divide the batter among the muffin cups."
    },
    {
      "step": 6,
      "text": "Bake for 13 minutes, until the centers are fully set and a thermometer inserted into a muffin reads 160°F.",
      "timer_minutes": 13
    }
  ],
