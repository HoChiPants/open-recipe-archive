  "id": "apple-crisp-in-a-mug",
  "name": "Apple Crisp in a Mug",
  "subtitle": "A warm, single-serving apple crisp with an oat topping",
  "description": "Prepare a cinnamon oat crumble, layer it with sweetened sliced apple in a mug, and microwave until tender. Let it cool briefly before serving.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "oats",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 4,
      "unit": "dashes",
      "preparation": "divided"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "apple",
      "item": "apple",
      "quantity": 0.5,
      "preparation": "peeled, cored, and thinly sliced"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the softened butter, white sugar, and brown sugar in a bowl. Stir in the flour, oats, half of the cinnamon, and salt until a crumbly mixture forms."
    },
    {
      "step": 2,
      "text": "Microwave the mixture briefly until lightly set. Transfer it to a plate, shape it into a thin crumble, and microwave again briefly until firm."
    },
    {
      "step": 3,
      "text": "In a microwave-safe mug, combine the sliced apple, remaining white sugar, remaining cinnamon, brown sugar, and water. Add the prepared crumble."
    },
    {
      "step": 4,
      "text": "Microwave for 1 minute, or until the apple is tender and the center is hot. Cool for 1 minute before eating.",
      "timer_minutes": 1
    }
  ],
