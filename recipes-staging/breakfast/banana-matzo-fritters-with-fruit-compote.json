  "instructions": [
    {
      "step": 1,
      "text": "Combine the apricots, figs, raisins, apple rings, cloves, cinnamon stick, star anise, and teabag in a saucepan with water. Bring to a boil, then simmer until the fruit is tender and the liquid is thickened.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Remove the teabag and whole spices. Let the compote cool, then chill until cold.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Whisk the matzo meal, ground cinnamon, and eggs until combined. Stir in the mashed banana and rest the batter until thick."
    },
    {
      "step": 4,
      "text": "Heat the frying oil in a skillet over medium heat. Spoon in the batter and shape into small fritters."
    },
    {
      "step": 5,
      "text": "Fry for about 3 minutes per side, turning once, until browned and the centers are firm and reach 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Serve the fritters with the fruit compote, Greek yogurt, and honey."
    }
  ],
