  "id": "banana-matzo-fritters-with-fruit-compote",
  "name": "Banana Matzo Fritters with Fruit Compote",
  "subtitle": "Cinnamon-scented fritters with warm spiced fruit",
  "description": "Crisp banana and matzo fritters served with a gently spiced dried-fruit compote, yogurt, and honey.",
  "meal_type": "breakfast",
