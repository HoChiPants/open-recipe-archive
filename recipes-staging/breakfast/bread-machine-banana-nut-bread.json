  "id": "bread-machine-banana-nut-bread",
  "name": "Bread Machine Banana Nut Bread",
  "subtitle": "A tender banana loaf with chopped walnuts",
  "description": "A simple bread-machine loaf combining mashed bananas, walnuts, and pantry baking ingredients for a lightly sweet breakfast bread.",
  "meal_type": "breakfast",
