  "instructions": [
    {
      "step": 1,
      "text": "Place the softened margarine, milk, eggs, and mashed bananas in the bread-machine pan."
    },
    {
      "step": 2,
      "text": "Whisk the flour, sugar, baking powder, baking soda, and salt together, then add the mixture to the pan.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Select the machine's cake or quick-bread cycle and start it. Add the chopped walnuts when the machine's signal indicates additions, if applicable."
    },
    {
      "step": 4,
      "text": "Bake through the full cycle, until the loaf is firm and a tester inserted in the center comes out clean."
    },
    {
      "step": 5,
      "text": "Let the loaf cool in the pan briefly, then transfer it to a rack and cool before slicing."
    }
  ],
