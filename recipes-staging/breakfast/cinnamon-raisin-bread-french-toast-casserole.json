  "id": "cinnamon-raisin-bread-french-toast-casserole",
  "name": "Cinnamon Raisin Bread French Toast Casserole",
  "subtitle": "A warm, custardy breakfast bake with cinnamon-raisin bread.",
  "description": "Cubed cinnamon-raisin bread is soaked in a sweet vanilla custard, rested, topped with butter and cinnamon, and baked until set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cinnamon-raisin-bread",
      "item": "cinnamon raisin bread",
      "quantity": 5,
      "unit": "cups",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "softened, cut into chunks"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Grease a baking dish with the softened butter, reserving the butter chunks for topping."
    },
    {
      "step": 2,
      "text": "Place the cubed cinnamon raisin bread in the prepared dish."
    },
    {
      "step": 3,
      "text": "Whisk the milk, eggs, white sugar, and vanilla extract until blended. Pour the custard evenly over the bread."
    },
    {
      "step": 4,
      "text": "Let the bread stand for 10 minutes so it absorbs the custard. Scatter the butter chunks over the top and sprinkle with ground cinnamon.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 45
    }
  ],
