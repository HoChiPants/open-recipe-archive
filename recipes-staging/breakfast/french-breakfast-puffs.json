  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a 12-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, salt, and nutmeg together."
    },
    {
      "step": 3,
      "text": "Beat 0.5 cup sugar with the shortening, then whisk in the egg and milk."
    },
    {
      "step": 4,
      "text": "Stir the dry mixture into the shortening mixture just until combined. Divide the batter among the prepared cups."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, until puffed and the centers are fully set; verify an egg-containing center reaches 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Combine 0.5 cup sugar with the cinnamon. Brush the warm puffs with melted margarine and coat them in the cinnamon sugar."
    },
    {
      "step": 7,
      "text": "Serve warm."
    }
  ],
