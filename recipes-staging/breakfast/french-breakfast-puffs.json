  "id": "french-breakfast-puffs",
  "name": "French Breakfast Puffs",
  "subtitle": "Tender cinnamon-nutmeg breakfast muffins",
  "description": "Lightly spiced muffins baked until set, then finished with melted margarine and cinnamon sugar.",
  "meal_type": "breakfast",
  "cuisine": "French",
