      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "8-ounce-loaf-french-bread",
      "item": "(8 ounce) loaf French bread",
      "quantity": 1,
      "preparation": "cut into small cubes"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "granny-smith-apples",
      "item": "Granny Smith apples",
      "quantity": 3,
      "preparation": "peeled, cored, and cut into small dice"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, half-and-half, milk, white sugar, vanilla extract, and brown sugar in a bowl. Stir in the bread cubes and let them soak for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet over medium heat. Add the white sugar, apples, and brown sugar; cook until the butter is melted and the mixture is combined."
    },
    {
      "step": 4,
      "text": "Add the cinnamon and cook the apples for about 7 minutes, keeping them firm.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Transfer the soaked bread mixture to the prepared dish and distribute the apples over it."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, until the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 45
    }
  ],
