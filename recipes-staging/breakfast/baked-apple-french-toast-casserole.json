  "id": "baked-apple-french-toast-casserole",
  "name": "Baked Apple French Toast Casserole",
  "subtitle": "Custardy bread with cinnamon apples",
  "description": "Cubed French bread soaks in a vanilla egg mixture, then bakes with buttery diced apples and cinnamon sugar until set.",
  "meal_type": "breakfast",
  "cuisine": "French Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "half-and-half",
      "item": "half-and-half",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
