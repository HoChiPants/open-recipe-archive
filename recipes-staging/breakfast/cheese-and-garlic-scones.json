{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cheese-and-garlic-scones",
  "name": "Cheese and Garlic Scones",
  "subtitle": "Savory cheddar scones with fresh garlic",
  "description": "Tender, savory scones combining sharp Cheddar and garlic, baked until lightly golden.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Combine the flour and salt in a bowl. Rub in the butter until the mixture resembles coarse crumbs."
    },
    {
      "step": 3,
      "text": "Stir in the Cheddar and garlic, then add the milk and mix just until a dough forms."
    },
    {
      "step": 4,
      "text": "Turn the dough onto a lightly floured surface and knead briefly until combined."
    },
    {
      "step": 5,
      "text": "Pat or roll the dough into a thick round and cut it into 8 scones."
    },
    {
      "step": 6,
      "text": "Transfer the scones to a baking sheet and bake for 20 minutes, until lightly golden.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Cool briefly before serving."
    }
  ],
