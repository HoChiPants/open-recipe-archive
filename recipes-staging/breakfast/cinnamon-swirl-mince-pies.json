{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cinnamon-swirl-mince-pies",
  "name": "Cinnamon Swirl Mince Pies",
  "subtitle": "Flaky pastry cups with spiced mincemeat",
  "description": "Twelve small puff-pastry pies layered with cinnamon sugar and filled with mincemeat, then chilled and baked until golden.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "sheet-of-all-butter-puff-pastry",
      "item": "sheet of all-butter puff pastry",
      "quantity": 320,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": "1 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "butter-for-the-tin",
      "item": "butter for the tin (optional)",
      "preparation": "melted",
      "optional": true
    },
    {
      "ingredient_id": "jar-mincemeat-check-the-label-if-you-re-vegetarian",
      "item": "jar mincemeat (check the label if you're vegetarian)",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "egg-beaten",
      "item": "egg beaten",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a 12-cup tin, brushing it with the melted butter if using."
    },
    {
      "step": 2,
      "text": "Roll or shape the puff pastry into a broad sheet. Sprinkle evenly with the caster sugar and cinnamon, then roll the pastry into a thick log."
    },
    {
      "step": 3,
      "text": "Cut the log into 12 thick rounds and press each round into a tin cup to form a pastry shell."
    },
    {
      "step": 4,
      "text": "Fill the shells with the mincemeat and top or cover as appropriate with the remaining pastry."
    },
    {
      "step": 5,
      "text": "Chill the assembled pies for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Brush the pastry with the beaten egg and bake for 25 minutes, until golden and any exposed egg is fully set; verify the egg reaches 160°F.",
      "timer_minutes": 25
    }
  ],
