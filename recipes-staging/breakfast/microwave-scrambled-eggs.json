{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "microwave-scrambled-eggs",
  "name": "Microwave Scrambled Eggs",
  "subtitle": "Quick, soft-set eggs for two",
  "description": "Whisk eggs with milk and salt, then microwave in short intervals until fluffy and fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.125,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Crack the eggs into a microwave-safe bowl. Add the milk and salt, then whisk until evenly combined."
    },
    {
      "step": 2,
      "text": "Microwave on high for 1 minute. Stir well, breaking up the partially set egg.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Continue microwaving in 30-second intervals, stirring after each, until the eggs are fluffy and the center is firm and fully set, or reaches 160°F on a food thermometer."
    },
    {
      "step": 4,
      "text": "Let stand briefly, then serve."
    }
  ],
