  "id": "breakfast-naans",
  "name": "Breakfast Naans",
  "subtitle": "Warm naan with creamy chutney, egg, and avocado",
  "description": "A quick breakfast pairing warm naan and seasoned cream cheese with fried eggs, avocado, lime, chile, and coriander.",
  "meal_type": "breakfast",
  "yield": {
