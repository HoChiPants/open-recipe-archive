  "instructions": [
    {
      "step": 1,
      "text": "Warm the naan breads in a dry skillet or under a preheated grill until heated through.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Whisk the eggs in a bowl. Heat the oil in a nonstick skillet, add the eggs, and cook until fully set and at least 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Mix the low-fat cream cheese with the mango chutney, then spread it over the warm naan breads."
    },
    {
      "step": 4,
      "text": "Top with the avocado, lime juice, green chilli, coriander leaves, and cooked eggs. Serve warm."
    }
  ],
