  "instructions": [
    {
      "step": 1,
      "text": "Toast the bread until crisp and arrange two slices in each serving bowl."
    },
    {
      "step": 2,
      "text": "Combine the milk, sugar, and vanilla extract in a saucepan over medium heat. Stir until the sugar dissolves and the mixture reaches a gentle simmer."
    },
    {
      "step": 3,
      "text": "Pour the hot milk over the toast and finish each serving with ground cinnamon."
    }
