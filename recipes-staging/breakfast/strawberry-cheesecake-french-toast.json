  "instructions": [
    {
      "step": 1,
      "text": "Keep the oven at 100°F to hold finished toast warm. Whisk the water and cornstarch in a saucepan until smooth, then add the mashed fresh strawberries and half of the white sugar. Cook over medium heat, stirring, until thickened, about 5 minutes. Set aside.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk the cream cheese, vanilla extract, remaining white sugar, and half of the whipped cream until smooth."
    },
    {
      "step": 3,
      "text": "Whisk the milk and eggs in a shallow dish."
    },
    {
      "step": 4,
      "text": "Spread the cream-cheese mixture over the bread slices and sandwich the slices together."
    },
    {
      "step": 5,
      "text": "Dip each sandwich in the egg mixture, turning to coat without soaking through."
    },
    {
      "step": 6,
      "text": "Melt the butter in a skillet over medium heat. Cook the sandwiches in batches until golden brown, about 3 minutes per side and fully set in the center, reaching 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 7,
      "text": "Transfer cooked French toast to the warm oven while finishing the remaining batches."
    },
    {
      "step": 8,
      "text": "Serve with the strawberry sauce, sliced fresh strawberries, remaining whipped cream, and confectioners' sugar for dusting."
    }
  ],
