  "id": "strawberry-cheesecake-french-toast",
  "name": "Strawberry Cheesecake French Toast",
  "subtitle": "Creamy stuffed French toast with warm strawberry sauce",
  "description": "Diagonal bread slices are filled with vanilla cream cheese, dipped in egg custard, and skillet-cooked until golden. Serve with strawberry sauce, sliced berries, whipped cream, and confectioners' sugar.",
  "meal_type": "breakfast",
  "cuisine": "American",
