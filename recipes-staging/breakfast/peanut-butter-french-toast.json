  "id": "peanut-butter-french-toast",
  "name": "Peanut Butter French Toast",
  "subtitle": "Cinnamon-scented toast with a nutty custard coating",
  "description": "Bread is dipped in a peanut butter, cinnamon, and vanilla egg mixture, then cooked in oil until browned and fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "slices-bread",
      "item": "slices bread",
      "quantity": 4
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the milk, eggs, peanut butter, sugar, vanilla, and cinnamon until evenly combined."
    },
    {
      "step": 2,
      "text": "Preheat a skillet over medium heat and add the vegetable oil."
    },
    {
      "step": 3,
      "text": "Dip the bread slices in the egg mixture, turning to coat both sides."
    },
    {
      "step": 4,
      "text": "Cook the coated bread in the skillet for about 4 minutes, turning as needed, until browned and the center reaches 160°F and is fully set.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
