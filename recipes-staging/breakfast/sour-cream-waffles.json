  "id": "sour-cream-waffles",
  "name": "Sour Cream Waffles",
  "subtitle": "Tender, lightly tangy waffles for a relaxed breakfast",
  "description": "A simple waffle batter combining sour cream and yogurt for a soft interior and golden, crisp edges.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "plain-yogurt",
      "item": "plain yogurt",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-vinegar",
      "item": "white vinegar",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a waffle iron according to the appliance instructions."
    },
    {
      "step": 2,
      "text": "Whisk the water, sour cream, yogurt, and vinegar together until evenly combined."
    },
    {
      "step": 3,
      "text": "In a separate bowl, stir together the flour, baking powder, baking soda, and salt."
    },
    {
      "step": 4,
      "text": "Whisk the beaten eggs into the wet mixture, then add the dry ingredients and blend just until smooth."
    },
    {
      "step": 5,
      "text": "Cook the batter in the preheated waffle iron in batches until the waffles are golden brown."
    }
  ],
