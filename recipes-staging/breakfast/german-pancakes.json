  "instructions": [
    {
      "step": 1,
      "text": "Combine the eggs, sugar, flour, and milk in a bowl. Whisk until the batter is smooth."
    },
    {
      "step": 2,
      "text": "Preheat a lightly greased skillet over medium heat."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the skillet and shape it into an even layer."
    },
    {
      "step": 4,
      "text": "Cook until the pancake is set and lightly browned, turning as needed for even cooking.",
