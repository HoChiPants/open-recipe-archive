  "id": "blueberry-cream-muffins",
  "name": "Blueberry Cream Muffins",
  "subtitle": "Tender muffins with sour cream and berries",
  "description": "Moist blueberry muffins made with sour cream and a lightly sweetened batter.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "blueberries",
      "item": "blueberries",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F and prepare muffin pans for 24 muffins."
    },
    {
      "step": 2,
      "text": "Whisk the eggs and sugar until blended. Stir in the oil, vanilla, and sour cream."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the flour, salt, and baking soda. Add the dry mixture to the wet mixture and stir just until combined."
    },
    {
      "step": 4,
      "text": "Fold in the blueberries, then divide the batter among the prepared muffin cups."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, until the tops are set and a tester comes out clean. The centers should be fully set.",
      "timer_minutes": 20
    }
  ],
