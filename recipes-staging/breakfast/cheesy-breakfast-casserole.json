  },
  "ingredients": [
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "pound",
      "preparation": "sliced, diced"
    },
    {
      "ingredient_id": "sweet-onion",
      "item": "sweet onion",
      "quantity": 1,
