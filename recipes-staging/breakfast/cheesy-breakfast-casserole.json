  "id": "cheesy-breakfast-casserole",
  "name": "Cheesy Breakfast Casserole",
  "subtitle": "Bacon, potatoes, eggs, and three cheeses baked until set",
  "description": "A hearty breakfast casserole combining crisp bacon, tender hash browns, eggs, and a blend of creamy and shredded cheeses.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
