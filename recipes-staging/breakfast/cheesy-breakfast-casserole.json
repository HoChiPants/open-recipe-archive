      "item": "eggs",
      "quantity": 9,
      "unit": "large",
      "preparation": "lightly beaten"
    },
    {
      "ingredient_id": "frozen-shredded-hash-brown-potatoes",
      "item": "frozen shredded hash brown potatoes",
      "quantity": 4,
      "unit": "cups",
      "preparation": "thawed"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "small-curd-cottage-cheese",
      "item": "small curd cottage cheese",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "swiss-cheese",
      "item": "Swiss cheese",
      "quantity": 1.25,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the diced bacon, chopped onion, and hash brown potatoes together in a skillet for 10 minutes, stirring occasionally. Drain, then transfer the bacon and onion mixture to a baking dish.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir together the beaten eggs, hash brown potatoes, Cheddar, cottage cheese, and Swiss cheese, then transfer the mixture to the baking dish."
    },
    {
      "step": 4,
      "text": "Bake at 350°F for 50 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 50
    },
    {
      "step": 5,
      "text": "Let the casserole rest for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
