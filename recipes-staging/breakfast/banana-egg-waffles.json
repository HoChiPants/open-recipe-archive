  "id": "banana-egg-waffles",
  "name": "Banana Egg Waffles",
  "subtitle": "Tender waffles with banana, peanut butter, and chocolate",
  "description": "A simple waffle batter combining mashed banana, beaten eggs, melted peanut butter, oats, and chocolate chips.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "banana",
      "item": "bananas",
      "quantity": 3,
      "preparation": "mashed"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "oats",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "chocolate-chips",
      "item": "chocolate chips",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the waffle iron and lightly coat it with cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk the beaten eggs, mashed bananas, and vanilla extract until smooth. Stir in the melted peanut butter until incorporated."
    },
    {
      "step": 3,
      "text": "Fold in the oats and chocolate chips."
    },
    {
      "step": 4,
      "text": "Cook the batter in the waffle iron until the waffles are golden brown and the centers are fully set, about 3 minutes per batch.",
      "timer_minutes": 3
    }
  ],
