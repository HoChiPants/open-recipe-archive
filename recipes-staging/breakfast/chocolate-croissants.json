{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-croissants",
  "name": "Chocolate Croissants",
  "subtitle": "Laminated pastries filled with bittersweet chocolate",
  "description": "Make a yeast-based laminated dough, layer it with butter, fill it with chocolate, and bake until crisp, golden, and fully set.",
  "meal_type": "breakfast",
  "cuisine": "French Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 25,
    "inactive_minutes": 300
  },
  "ingredients": [
    {
      "ingredient_id": "warm-water-100-degrees-f-or-38-degrees-c",
      "item": "warm water (100 degrees F or 38 degrees C)",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 0.5,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "granulated-white-sugar",
      "item": "granulated white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "unbleached-bread-flour",
      "item": "unbleached bread flour",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "room temperature, cut into pieces"
    },
    {
      "ingredient_id": "unsalted-european-style-butter",
      "item": "unsalted European-style butter",
      "quantity": 1,
      "unit": "stick"
    },
    {
      "ingredient_id": "bittersweet-chocolate",
      "item": "bittersweet chocolate",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "coarse-sea-salt-to-taste",
      "item": "coarse sea salt to taste",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the warm water and yeast; let stand for 10 minutes. Mix in the sugar, bread flour, kosher salt, and room-temperature butter until a dough forms.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Knead until smooth, cover, and let rise at room temperature until puffy, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Shape the European-style butter into a thin, even rectangle. Roll the dough into a larger rectangle, enclose the butter, and seal the edges."
    },
    {
      "step": 4,
      "text": "Roll the dough into a long rectangle, fold it in thirds, cover, and chill for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Repeat the rolling and three-folding process, chilling for 15 minutes as needed to keep the butter firm.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Roll the dough into a thick rectangle, cut it into six pieces, and shape each around chopped bittersweet chocolate."
    },
    {
      "step": 7,
      "text": "Arrange the pastries on a lined baking sheet, cover, and let rise until visibly puffy, about 90 minutes.",
      "timer_minutes": 90
    },
    {
      "step": 8,
      "text": "Whisk the egg with the water and brush the mixture over the pastries. Sprinkle with coarse sea salt to taste."
    },
    {
      "step": 9,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 10,
      "text": "Bake for 25 minutes, until deeply golden, the egg wash is fully set, and the pastry center reaches at least 160°F on a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 11,
      "text": "Transfer to a rack and cool for 60 minutes before serving.",
      "timer_minutes": 60
    }
  ],
