  "id": "corned-beef-hash",
  "name": "Corned Beef Hash",
  "subtitle": "Crisp potato hash with corned beef and salsa",
  "description": "Tender potatoes, chopped corned beef, green onions, garlic, butter, and roasted tomato salsa come together in a hearty skillet breakfast.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "peeled and quartered"
    },
    {
      "ingredient_id": "corned-beef",
      "item": "corned beef",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "cooked, finely chopped"
    },
    {
      "ingredient_id": "bunch-green-onions",
      "item": "bunch green onions",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "roasted-tomato-salsa",
      "item": "roasted tomato salsa",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes in a saucepan, season with salt and pepper, cover with water, and bring to a simmer. Cook until tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Drain the potatoes, let them cool briefly, and cut them into bite-size pieces."
    },
    {
      "step": 3,
      "text": "Warm a large skillet over medium heat. Add the corned beef and green onions, season with salt and pepper, and stir to combine."
    },
    {
      "step": 4,
      "text": "Add the garlic and butter. Stir for 2 minutes, until the butter melts and the garlic is fragrant.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Fold in the potatoes and salsa. Cook for 5 minutes, then turn or stir the hash and cook for 5 minutes more, until browned and heated through.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Remove from the heat and let the hash stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
