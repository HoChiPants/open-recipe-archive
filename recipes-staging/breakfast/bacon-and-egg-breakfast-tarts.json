  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Prepare the pie crust mix with the two portions of cold water according to the package directions, then divide and shape it into four tart shells."
    },
    {
      "step": 3,
      "text": "Place the shells in tart or muffin cups and bake until lightly set, about 10 minutes. Cool for 5 minutes, then reduce the oven temperature to 350°F.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Divide the Canadian-style bacon and shredded Cheddar among the crusts."
    },
    {
      "step": 5,
      "text": "Beat the eggs with the milk, nutmeg, and black pepper. Pour the mixture into the crusts, leaving a little room at the top."
    },
    {
      "step": 6,
      "text": "Bake for about 20 minutes, until the centers are firm and a thermometer inserted into the filling reaches 160°F.",
      "timer_minutes": 20
    }
  ],
