  "id": "greek-yogurt-pancakes",
  "name": "Greek Yogurt Pancakes",
  "subtitle": "Tender pancakes with a tangy yogurt base",
  "description": "A simple breakfast batter made with Greek yogurt, egg, flour, and baking soda, cooked on a hot skillet until set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "greek-yogurt",
      "item": "Greek yogurt",
      "quantity": 6,
      "unit": "ounces"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the Greek yogurt until smooth, then whisk in the egg."
    },
    {
      "step": 2,
      "text": "Combine the flour and baking soda in a separate bowl. Stir the dry mixture into the yogurt mixture just until a batter forms."
    },
    {
      "step": 3,
      "text": "Preheat a skillet or griddle over medium heat."
    },
    {
      "step": 4,
      "text": "Divide the batter into four pancakes on the heated surface.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Cook, turning once, until browned and the centers are firm and fully set, about 3 minutes total.",
      "timer_minutes": 3
    }
  ],
