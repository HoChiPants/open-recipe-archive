  "id": "honey-nut-granola",
  "name": "Honey Nut Granola",
  "subtitle": "Crisp oat-and-nut clusters with warm cinnamon",
  "description": "A simple baked granola combining oats, nuts, sunflower seeds, honey, and vanilla for a lightly spiced breakfast topping or snack.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
