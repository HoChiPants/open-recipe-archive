  },
  "ingredients": [
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "almonds",
      "item": "almonds",
      "quantity": 1,
