      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Combine the oats, sliced almonds, chopped pecans, and sunflower seeds in a large bowl."
    },
    {
      "step": 3,
      "text": "Stir together the canola oil, honey, cinnamon, and vanilla extract, then pour over the oat mixture and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Spread the mixture in an even layer on a baking sheet."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, until lightly browned.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Let the granola cool completely before serving."
    }
  ],
