  "instructions": [
    {
      "step": 1,
      "text": "Add the milk, melted butter, water, beaten egg, flour, pudding mix, white sugar, salt, and yeast to a bread machine. Run the dough cycle, ensuring the dough is kneaded for about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Let the dough complete its rise. Turn it onto a lightly prepared work surface and roll it into a rectangle."
    },
    {
      "step": 3,
      "text": "Spread the softened butter over the dough. Mix the brown sugar and cinnamon, then distribute the mixture with the walnuts and raisins across the surface."
    },
    {
      "step": 4,
      "text": "Roll the dough into a log from one long side. Cut it into 24 pieces and arrange them in a baking pan. Let the rolls rise until puffy."
    },
    {
      "step": 5,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 6,
      "text": "Bake the rolls for about 20 minutes, until browned and the center is fully set; verify with a thermometer that the egg-containing dough reaches 160°F.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Stir the confectioners' sugar, softened butter, milk, and vanilla extract into a smooth icing. Spread it over the warm rolls."
    }
  ],
