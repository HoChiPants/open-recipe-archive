  "id": "zucchini-apple-muffins",
  "name": "Zucchini Apple Muffins",
  "subtitle": "Tender muffins with shredded zucchini and apple",
  "description": "A simple batch of lightly spiced muffins combining zucchini and apple for a moist breakfast bake.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
