      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Coat 24 muffin cups with cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk the sugar, oil, eggs, and vanilla until smooth."
    },
    {
      "step": 3,
      "text": "In a separate bowl, stir together the flour, cinnamon, baking soda, and baking powder."
    },
    {
      "step": 4,
      "text": "Fold the dry mixture into the wet mixture, then fold in the shredded zucchini and apple until just combined."
    },
    {
      "step": 5,
      "text": "Divide the batter among the prepared muffin cups."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until the muffins are set and a tester inserted in the center comes out clean.",
      "timer_minutes": 25
    }
  ],
