      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a loaf tin, greasing it with the optional butter."
    },
    {
      "step": 2,
      "text": "Combine the cereal, sugar, dried fruits, and milk. Leave the mixture to stand for 60 minutes so the cereal softens.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Stir the flour and baking powder into the soaked mixture until evenly combined."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared tin and bake for 60 minutes, until the loaf is set.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Cool the loaf before removing it from the tin and slicing."
    }
  ],
