  "id": "cereal-fruit-loaf",
  "name": "Cereal Fruit Loaf",
  "subtitle": "A tender loaf made with soaked cereal and dried fruit",
  "description": "Soaked cereal and dried fruit give this simple breakfast loaf a moist texture and lightly sweet flavor.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 1,
    "unit": "loaf"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "all-bran-or-shreddies-or-use-other-cereal-you-have-at-home",
      "item": "All-Bran or Shreddies (or use other cereal you have at home)",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "white-caster-sugar",
      "item": "white caster sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "dried-fruits-sultanas",
      "item": "dried fruits (sultanas",
      "quantity": 150,
      "unit": "g",
      "preparation": "raisins, or from a bag of mixed dried fruit)"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "butter-for-the-tin",
      "item": "butter for the tin (optional)",
      "optional": true
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 100,
      "unit": "g"
    },
    {
