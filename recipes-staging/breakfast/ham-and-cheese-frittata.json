  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven grill or broiler. Whisk the eggs and milk together, then set aside."
    },
    {
      "step": 2,
      "text": "Melt the butter in an oven-safe skillet over medium heat. Add the potatoes, onion, and garlic; stir and cook until the potatoes are tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Add the water as needed during cooking, and season with salt and ground black pepper to taste."
    },
    {
      "step": 4,
      "text": "Pour in the egg mixture and add the ham. Cook until the eggs begin to set around the edges, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Top with the shredded Cheddar and place the skillet under the grill or broiler until the center is firm and reaches 160°F, about 5 minutes.",
      "timer_minutes": 5
    }
  ],
