  "instructions": [
    {
      "step": 1,
      "text": "Place the baby spinach in a large serving bowl."
    },
    {
      "step": 2,
      "text": "Add the bananas, strawberries, drained mandarin oranges, dried cranberries, and pine nuts."
    },
    {
      "step": 3,
      "text": "Pour over the poppy seed salad dressing and toss gently until evenly coated. Serve immediately."
    }
