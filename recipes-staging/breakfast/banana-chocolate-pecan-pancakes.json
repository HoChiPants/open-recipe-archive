  "id": "banana-chocolate-pecan-pancakes",
  "name": "Banana Chocolate Pecan Pancakes",
  "subtitle": "Tender pancakes with banana, chocolate, and toasted pecan flavor",
  "description": "A simple American pancake batter folded with diced banana, semisweet chocolate chips, and chopped pecans, then cooked on a lightly greased surface.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
