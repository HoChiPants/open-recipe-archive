  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, baking powder, baking soda, and salt together in a bowl."
    },
    {
      "step": 2,
      "text": "In a separate bowl, whisk the milk, melted butter, eggs, sugar, and vanilla until blended."
    },
    {
      "step": 3,
      "text": "Add the wet mixture to the dry ingredients and stir just until combined. Fold in the banana, chocolate chips, and pecans."
    },
    {
      "step": 4,
      "text": "Preheat a griddle or skillet over medium heat and coat it lightly with cooking spray."
    },
    {
      "step": 5,
      "text": "Cook the pancakes in batches, using about 1/4 cup batter for each. Turn when bubbles form and the edges look set; cook the second side until golden and the centers are fully set."
    }
  ],
