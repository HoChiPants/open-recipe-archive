  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the eggs and sugar together, then whisk in the vegetable oil."
    },
    {
      "step": 3,
      "text": "Whisk the applesauce and sour cream together in a separate bowl."
    },
    {
      "step": 4,
      "text": "Combine the flour, cinnamon, baking soda, and baking powder."
    },
    {
      "step": 5,
      "text": "Stir the applesauce mixture into the egg mixture, then add the dry ingredients and mix just until combined. Stir in the raisins."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and bake at 350°F for 60 minutes, or until the center is firm and a tester comes out clean.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Cool before slicing and serving."
    }
  ],
