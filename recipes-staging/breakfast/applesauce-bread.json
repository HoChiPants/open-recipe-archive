  "id": "applesauce-bread",
  "name": "Applesauce Bread",
  "subtitle": "A moist cinnamon loaf with raisins and applesauce",
  "description": "A lightly spiced, tender applesauce bread sweetened with sugar and finished with raisins.",
  "meal_type": "breakfast",
