  "instructions": [
    {
      "step": 1,
      "text": "Boil the potato rounds for 6 minutes, until just tender, then drain. Microwave the chopped spinach for 3 minutes and set aside.",
      "timer_minutes": 6
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in an ovenproof skillet. Cook the sliced onion for 10 minutes, stirring occasionally, until softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the grated garlic, ground coriander, cumin, mustard seeds, and turmeric. Stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the potatoes, spinach, and tomatoes. Cook for 3 minutes, stirring gently.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Whisk the eggs with the chopped chilli and coriander, then pour over the skillet mixture."
    },
    {
      "step": 6,
      "text": "Preheat the grill. Grill the frittata for about 5 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Mix the mango chutney and Greek yogurt with the coriander and ground coriander. Cut the frittata into wedges and serve with the sauce."
    }
  ],
