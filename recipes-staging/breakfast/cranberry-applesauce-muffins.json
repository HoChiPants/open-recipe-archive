  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a 12-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Combine the applesauce, vegetable oil, and beaten egg in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, mix the flour, sugar, baking soda, cinnamon, and salt."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the applesauce mixture and stir just until combined."
    },
    {
      "step": 5,
      "text": "Fold in the chopped cranberries and pecans."
    },
    {
      "step": 6,
      "text": "Divide the batter among the muffin cups."
    },
    {
      "step": 7,
      "text": "Bake for 30 minutes, until the muffins are set and a tester inserted in the center comes out clean.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Cool in the pan for 2 minutes before serving.",
      "timer_minutes": 2
    }
  ],
