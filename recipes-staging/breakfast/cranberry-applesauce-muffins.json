  "id": "cranberry-applesauce-muffins",
  "name": "Cranberry Applesauce Muffins",
  "subtitle": "Tender muffins with tart cranberries and pecans",
  "description": "Applesauce keeps these lightly spiced muffins moist, while cranberries add brightness and pecans provide crunch.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "unsweetened-applesauce",
      "item": "unsweetened applesauce",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
