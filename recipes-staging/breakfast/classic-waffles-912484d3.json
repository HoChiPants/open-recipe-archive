    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat and prepare the waffle iron according to its instructions."
    },
    {
      "step": 2,
      "text": "Stir together the flour, baking powder, sugar, and salt."
    },
    {
      "step": 3,
      "text": "Add the milk, eggs, and vegetable oil, then combine until the batter is evenly mixed."
    },
    {
      "step": 4,
      "text": "Pour the batter into the prepared waffle iron and cook until golden brown, repeating with the remaining batter."
    }
