  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, 2 tsp sugar, baking powder, and bicarbonate of soda in a bowl. Add the buttermilk, melted butter, and egg, then whisk just until combined."
    },
    {
      "step": 2,
      "text": "Prepare the plums by cutting them into pieces. Cook them with the 2 tbsp sugar, vanilla seeds, star anise, and lemon juice until softened and syrupy. Remove the star anise and let the compote cool slightly."
    },
    {
      "step": 3,
      "text": "Preheat the waffle maker and lightly oil it."
    },
    {
      "step": 4,
      "text": "Cook the batter in batches until the waffles are golden, crisp, fully set, and reach 160°F in the center.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Whisk the amaretto liqueur and double cream to soft peaks."
    },
    {
      "step": 6,
      "text": "Serve the waffles with the plum compote, amaretto cream, and toasted flaked almonds."
    }
  ],
