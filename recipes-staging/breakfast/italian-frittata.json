  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "In an oven-safe skillet, stir the salami, artichoke hearts, cherry tomatoes, and mushrooms for 4 minutes. Transfer the salami and vegetables to a plate.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Whisk the eggs, milk, green onions, garlic, dried basil, onion powder, salt, and pepper until combined."
    },
    {
      "step": 4,
      "text": "Return the salami and vegetables to the skillet, then pour in the egg mixture. Sprinkle with the Parmesan and mozzarella."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 20
    }
  ],
