  "instructions": [
    {
      "step": 1,
      "text": "Combine the paprika roasties, cabbage, cumin seeds, and crushed garlic. Mash lightly until the mixture holds together, then shape it into patties."
    },
    {
      "step": 2,
      "text": "Preheat a large skillet over medium heat. Add the olive oil and sauté the patties for 4 minutes, turning carefully as they brown.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Continue cooking the patties until hot throughout and crisp on both sides, about 10 minutes total.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Transfer the patties to plates and serve with the lemon-juiced avocado and chilli flakes."
    }
  ],
