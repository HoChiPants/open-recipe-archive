  "id": "potato-and-cabbage-patties",
  "name": "Potato and Cabbage Patties",
  "subtitle": "Crisp leftover vegetables with avocado and lemon",
  "description": "Seasoned roast potatoes and cabbage are shaped into patties, sautéed until crisp, and served with lemony avocado.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
