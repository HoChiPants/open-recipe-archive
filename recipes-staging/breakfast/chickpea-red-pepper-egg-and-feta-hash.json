      "item": "cumin seeds",
      "quantity": "1 1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "roasted-red-peppers-from-a-jar",
      "item": "roasted red peppers from a jar",
      "quantity": 4,
      "preparation": "torn into chunks"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": "2-4"
    },
    {
      "ingredient_id": "feta-crumbled",
      "item": "feta crumbled",
