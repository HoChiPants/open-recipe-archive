  "id": "chickpea-red-pepper-egg-and-feta-hash",
  "name": "Chickpea, Red Pepper, Egg and Feta Hash",
  "subtitle": "A savory skillet hash with bright herbs and lemon",
  "description": "Tender chickpeas and peppers are topped with eggs, feta, mint, and lemon for a quick vegetarian breakfast.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "olive-or-rapeseed-oil",
      "item": "olive or rapeseed oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
