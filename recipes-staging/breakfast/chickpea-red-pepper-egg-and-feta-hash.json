      "item": "handful mint leaves chopped",
      "unit": "small"
    },
    {
      "ingredient_id": "flatbreads-to-serve-optional",
      "item": "flatbreads to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm a large skillet over medium heat and add the oil."
    },
    {
      "step": 2,
      "text": "Add the onion and cook, stirring occasionally, until softened and lightly golden.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Stir in the chickpeas, cumin seeds, and roasted red peppers, then spread the mixture evenly across the skillet."
    },
    {
      "step": 4,
      "text": "Make 2 to 4 shallow wells and crack an egg into each one. Cover and cook until the whites and centers are fully set; verify the eggs reach 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Scatter the feta, lemon zest, and chopped mint over the hash. Serve with flatbreads if desired."
    }
  ],
