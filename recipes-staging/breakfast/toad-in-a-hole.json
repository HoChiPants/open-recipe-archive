  "id": "toad-in-a-hole",
  "name": "Toad in a Hole",
  "subtitle": "Cheesy egg-filled toast for breakfast",
  "description": "Bread is buttered, filled with Cheddar, toasted, and finished with an egg cooked in the center.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bread",
      "item": "slices bread",
      "quantity": 6
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6
    },
    {
      "ingredient_id": "slices-cheddar-cheese",
      "item": "slices Cheddar cheese",
      "quantity": 6
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill."
    },
    {
      "step": 2,
      "text": "Cut a hole from the center of each bread slice."
    },
    {
      "step": 3,
      "text": "Butter the bread, place a Cheddar slice over each piece, and grill until the bread is toasted and the cheese is softened."
    },
    {
      "step": 4,
      "text": "Place the toasted bread in a suitable cooking pan and crack one egg into each center hole."
    },
    {
      "step": 5,
      "text": "Cook until the eggs are fully set in the center and reach 160°F."
    }
  ],
