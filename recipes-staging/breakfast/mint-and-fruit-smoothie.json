      "ingredient_id": "red-seedless-grapes",
      "item": "red seedless grapes",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "frozen"
    },
    {
      "ingredient_id": "unsweetened-applesauce",
      "item": "unsweetened applesauce",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "fresh-lime-juice",
      "item": "fresh lime juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
