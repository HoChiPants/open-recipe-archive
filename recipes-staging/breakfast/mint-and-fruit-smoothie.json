  "id": "mint-and-fruit-smoothie",
  "name": "Mint and Fruit Smoothie",
  "subtitle": "A cool, bright blend of berries, pineapple, lime, and mint",
  "description": "Frozen grapes and strawberries give this fruit smoothie a chilled texture, while applesauce, pineapple, lime, and mint add balanced sweetness and freshness.",
  "meal_type": "breakfast",
  "cuisine": "American",
