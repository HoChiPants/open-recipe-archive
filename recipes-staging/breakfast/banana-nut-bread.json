  "id": "banana-nut-bread",
  "name": "Banana Nut Bread",
  "subtitle": "Moist banana bread with chopped walnuts",
  "description": "A generously sized loaf-style quick bread made with mashed bananas, walnuts, and a lightly sweet batter.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
