      "item": "walnuts",
      "quantity": 2,
      "unit": "cups",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare the baking pan or pans."
    },
    {
      "step": 2,
      "text": "Combine the flour, baking powder, and salt in a bowl."
    },
    {
      "step": 3,
      "text": "Whisk the vegetable oil and sugar until smooth. Stir in the whisked eggs."
    },
    {
      "step": 4,
      "text": "Mix the mashed bananas with the lemon juice, then add them to the oil mixture."
    },
    {
      "step": 5,
      "text": "Add the dry ingredients and combine just until the batter comes together. Fold in the walnuts."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan or pans and bake for 60 minutes, until the center is fully set and a tester comes out clean.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Cool before slicing and serving."
    }
  ],
