  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease a 9-by-13-inch baking pan with the teaspoon of butter."
    },
    {
      "step": 2,
      "text": "Whisk the pumpkin puree, eggs, water, tablespoon of vanilla extract, and pumpkin pie spice until evenly blended."
    },
    {
      "step": 3,
      "text": "Stir the yellow cake mix and baking soda together, then fold them into the pumpkin mixture until no dry pockets remain."
    },
    {
      "step": 4,
      "text": "Spread the batter in the prepared pan."
    },
    {
      "step": 5,
      "text": "Mix the melted butter with 0.5 cup brown sugar, the flour, and white sugar to make a crumbly topping. Scatter it over the batter."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until the center is firm and fully set; verify with a food thermometer that it reaches 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "While the cake bakes, combine the remaining brown sugar, heavy whipping cream, remaining white sugar, and teaspoon of vanilla extract in a small saucepan. Warm gently, stirring until smooth."
    },
    {
      "step": 8,
      "text": "Drizzle the glaze over the warm cake, cool briefly, and cut into 12 servings."
    }
  ],
