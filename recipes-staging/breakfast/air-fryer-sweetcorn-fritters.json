  "id": "air-fryer-sweetcorn-fritters",
  "name": "Air-Fryer Sweetcorn Fritters",
  "subtitle": "Crisp-edged fritters with herbs and spring onion",
  "description": "Savory sweetcorn fritters mixed with herbs and spices, then cooked in an air fryer until golden and set.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 12
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 175,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1 1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "smoked-paprika",
      "item": "smoked paprika",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "eggs-beaten",
      "item": "eggs beaten",
      "quantity": 2
    },
    {
      "ingredient_id": "bunch-of-parsley-finely-chopped",
      "item": "bunch of parsley finely chopped",
      "quantity": "1/2",
      "unit": "small"
    },
    {
      "ingredient_id": "spring-onions-finely-chopped",
      "item": "spring onions finely chopped",
      "quantity": 4
    },
    {
      "ingredient_id": "sweetcorn-see-tip-below",
      "item": "sweetcorn (see tip below)",
      "quantity": 500,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the flour, baking powder, garlic powder, and smoked paprika in a bowl."
    },
    {
      "step": 2,
      "text": "Whisk the milk and beaten eggs until smooth, then stir into the dry ingredients to form a thick batter."
    },
    {
      "step": 3,
      "text": "Fold in the parsley, spring onions, and sweetcorn until evenly distributed."
    },
    {
      "step": 4,
      "text": "Preheat the air fryer until set for cooking.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Arrange spoonfuls of batter in the air-fryer basket with space between them, and cook for 12 minutes, turning halfway, until golden and the centers are firm and reach 160°F.",
      "timer_minutes": 12
    },
    {
      "step": 6,
      "text": "Serve warm."
    }
  ],
