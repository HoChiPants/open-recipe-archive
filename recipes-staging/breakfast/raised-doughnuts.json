  ],
  "instructions": [
    {
      "step": 1,
      "text": "Dissolve the yeast and 1 teaspoon sugar in the warm water. Let stand until foamy, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Warm the milk with the shortening until the shortening melts. Remove from the heat and stir in the remaining sugar and salt. Let cool until lukewarm."
    },
    {
      "step": 3,
      "text": "Whisk the eggs into the cooled milk mixture, then stir in the yeast mixture."
    },
    {
      "step": 4,
      "text": "Gradually add the sifted flour, mixing until a soft dough forms. Knead on a lightly floured surface until smooth, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Place the dough in a greased bowl, cover, and let rise in a warm place until doubled, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Roll the dough on a floured surface to a thick sheet. Cut into doughnut shapes and arrange on a lightly floured surface."
    },
    {
      "step": 7,
      "text": "Cover and let the shaped doughnuts rise for about 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Heat the frying oil to 350°F. Fry the doughnuts in batches for about 2 minutes, turning once, until golden brown.",
      "timer_minutes": 2
    },
    {
      "step": 9,
      "text": "Transfer the doughnuts to a rack or paper towels to drain."
    },
    {
      "step": 10,
      "text": "Stir the sifted confectioners' sugar with the warm water and vanilla until smooth. Dip or drizzle the glaze over the warm doughnuts."
    }
  ],
