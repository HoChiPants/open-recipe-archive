  "id": "raised-doughnuts",
  "name": "Raised Doughnuts",
  "subtitle": "Light, yeast-raised doughnuts with a simple vanilla glaze",
  "description": "Prepare a soft yeast dough, let it rise, cut it into rounds, fry until golden, and finish with a quick vanilla glaze.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 60,
    "cook_minutes": 15,
    "inactive_minutes": 105
  },
  "ingredients": [
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 2,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
