      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "warm-water-100-to-110-degrees-f-40-to-45-degrees-c",
      "item": "warm water (100 to 110 degrees F/40 to 45 degrees C)",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
