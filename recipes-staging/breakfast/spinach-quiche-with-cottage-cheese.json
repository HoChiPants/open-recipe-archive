  "id": "spinach-quiche-with-cottage-cheese",
  "name": "Spinach Quiche with Cottage Cheese",
  "subtitle": "A savory spinach and cheese egg bake with a crisp topping",
  "description": "Thawed spinach, cottage cheese, Cheddar, and eggs bake into a tender, savory quiche finished with crushed croutons.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed"
    },
    {
      "ingredient_id": "bunch-green-onions",
      "item": "bunch green onions",
      "quantity": 1,
      "preparation": "finely chopped (white parts only)"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "cottage-cheese",
      "item": "cottage cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "croutons",
      "item": "croutons",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Drain the thawed spinach thoroughly."
    },
    {
      "step": 3,
      "text": "Stir together the spinach, green onions, beaten eggs, cottage cheese, and Cheddar cheese."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish and bake for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Sprinkle the crushed croutons over the top, then bake for 15 minutes more, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 15
    }
  ],
