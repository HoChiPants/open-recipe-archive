  "id": "pumpkin-pancakes",
  "name": "Pumpkin Pancakes",
  "subtitle": "Tender spiced pancakes with pumpkin puree",
  "description": "A simple American breakfast of lightly spiced pumpkin pancakes cooked on a hot griddle.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "pumpkin-puree",
      "item": "pumpkin puree",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, sugar, baking powder, cinnamon, and nutmeg in a bowl."
    },
    {
      "step": 2,
      "text": "Whisk the milk and pumpkin puree until smooth, then mix in the beaten egg and vegetable oil."
    },
    {
      "step": 3,
      "text": "Stir the wet mixture into the dry ingredients just until combined and thick; avoid overmixing."
    },
    {
      "step": 4,
      "text": "Preheat a lightly oiled griddle or skillet to 350°F."
    },
    {
      "step": 5,
      "text": "Portion the batter onto the hot surface and cook until the pancakes are set enough to turn, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Turn and cook until puffed and fully set in the center, about 1 minute; the egg-containing batter should reach 160°F.",
      "timer_minutes": 1
    },
    {
      "step": 7,
      "text": "Serve warm."
    }
  ],
