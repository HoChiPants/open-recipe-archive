  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the bananas, eggs, applesauce, honey, and vanilla extract in a bowl, mashing and stirring until smooth."
    },
    {
      "step": 3,
      "text": "In a separate bowl, mix the oats, flax seeds, cinnamon, baking powder, salt, walnuts, and raisins."
    },
    {
      "step": 4,
      "text": "Stir the dry mixture into the banana mixture until evenly combined."
    },
    {
      "step": 5,
      "text": "Portion the batter onto a prepared baking sheet, spacing the cookies apart."
    },
    {
      "step": 6,
      "text": "Bake until the cookies are set.",
      "timer_minutes": 15
    }
  ],
