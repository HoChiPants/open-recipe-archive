  "id": "oatmeal-breakfast-cookies",
  "name": "Oatmeal Breakfast Cookies",
  "subtitle": "Soft banana-oat cookies with raisins and walnuts",
  "description": "A simple batch of lightly sweetened oatmeal cookies combining ripe bananas, applesauce, raisins, and chopped walnuts.",
  "meal_type": "breakfast",
  "cuisine": "American",
