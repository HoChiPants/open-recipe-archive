  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to a low temperature to keep the pancakes warm."
    },
    {
      "step": 2,
      "text": "Mix the cornmeal, flour, baking powder, beaten eggs, buttermilk, cooled melted butter, sweetcorn, and chopped spring onions into a thick batter."
    },
    {
      "step": 3,
      "text": "Heat a little oil in a frying pan over medium heat. Cook the bacon in the pan or a separate pan until browned and cooked through, then keep warm."
    },
    {
      "step": 4,
      "text": "Spoon the batter into the pan to form pancakes and cook until set underneath and browned, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Turn the pancakes and cook the second side for about 3 minutes, until cooked through.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Serve the pancakes with the bacon, extra spring onions, and maple syrup."
    }
  ],
