  "id": "air-fryer-sweet-potato-hash",
  "name": "Air Fryer Sweet Potato Hash",
  "subtitle": "Crisp sweet potato and bacon hash with smoky seasoning",
  "description": "Small cubes of sweet potato and bacon cook quickly in the air fryer for a savory breakfast or side dish.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-potato",
      "item": "sweet potato",
      "quantity": 2,
      "unit": "large",
      "preparation": "cut into small cubes"
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 2,
      "preparation": "cut into small pieces"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "smoked-paprika",
      "item": "smoked paprika",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sea-salt",
      "item": "sea salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-dill-weed",
      "item": "dried dill weed",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 400°F."
    },
    {
      "step": 2,
      "text": "In a bowl, toss the sweet potato, bacon, olive oil, smoked paprika, sea salt, black pepper, and dill until evenly coated."
    },
    {
      "step": 3,
      "text": "Spread the mixture in the air-fryer basket in an even layer."
    },
    {
      "step": 4,
      "text": "Cook, stirring once about halfway through, until the sweet potatoes are tender and browned and the bacon is crisp.",
      "timer_minutes": 15
    }
  ],
