  "id": "loaded-breakfast-skillet",
  "name": "Loaded Breakfast Skillet",
  "subtitle": "Crisp bacon, tender potatoes, eggs, and melted Cheddar in one pan.",
  "description": "A hearty American breakfast skillet built from bacon, seasoned potatoes, eggs, and cheese.",
  "meal_type": "breakfast",
