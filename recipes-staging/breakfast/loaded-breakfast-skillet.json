  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a large skillet over medium heat until browned and crisp, about 10 minutes. Drain, reserving the bacon and leaving the drippings in the skillet.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the onion to the skillet and cook in the bacon drippings until softened, about 5 minutes. Stir in the potatoes and coat them with the drippings.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pour in the water, cover, and cook until the potatoes are tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Stir in the green onions, garlic, and smoked paprika. Season with kosher salt and freshly ground pepper."
    },
    {
      "step": 5,
      "text": "Make four wells in the potato mixture and crack an egg into each. Season the eggs, scatter the reserved bacon and Cheddar over the skillet, cover, and cook until the egg centers are fully set and reach 160°F, about 5 minutes. Serve hot.",
      "timer_minutes": 5
    }
  ],
