  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk until just warm to the touch. Melt the 6 tablespoons butter, then stir it into the milk. Add the yeast and let the mixture stand briefly."
    },
    {
      "step": 2,
      "text": "Mix the one-third cup sugar and salt into the milk mixture. Add the eggs and flour, stirring until a dough forms."
    },
    {
      "step": 3,
      "text": "Knead the dough for 8 minutes, until smooth.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Coat a bowl with cooking spray, place the dough inside, and cover. Let it rise for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Divide the dough into 16 portions and shape each into a roll. Arrange them on a prepared baking surface and let them rest for 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 7,
      "text": "Stir the softened butter, one-half cup sugar, and two-thirds cup flour into a topping. Mix in the egg yolks, then prepare the topping for the rolls."
    },
    {
      "step": 8,
      "text": "Place the topping on the shaped rolls and bake for 20 minutes, until lightly browned and the centers are fully set, reaching at least 160°F.",
      "timer_minutes": 20
    }
  ],
