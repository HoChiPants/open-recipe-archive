  "id": "pan-dulces",
  "name": "Pan Dulces",
  "subtitle": "Soft Mexican sweet rolls with a buttery sugar topping",
  "description": "Make a yeasted, lightly sweet dough, shape it into individual rolls, and finish with a simple butter-sugar topping before baking.",
  "meal_type": "breakfast",
  "cuisine": "Mexican",
