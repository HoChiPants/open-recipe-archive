  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour and salt in a bowl. In a separate bowl, whisk the milk, eggs, and 2 tablespoons melted butter. Gradually whisk the wet mixture into the flour until smooth."
    },
    {
      "step": 2,
      "text": "Cover and chill the batter for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Heat a lightly buttered skillet over medium heat. Pour in a thin layer of batter, swirl to coat, and cook until the surface is set and the underside is lightly browned, about 1 minute. Continue with the remaining batter, buttering the skillet as needed. Cook each crêpe until no wet egg remains and the center is fully set, reaching 160°F.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Preheat the oven to 350°F. Melt some of the divided butter in a skillet, then stir in the garlic, thyme, and cream cheese. Add the shredded chicken and stir for 5 minutes, until the filling is evenly coated and hot.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Fill each crêpe with the chicken mixture, fold, and arrange in a baking dish. Brush or dot with the remaining divided butter."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, until heated through. Stir or whisk any remaining cream cheese into the filling if needed, then finish with the parsley.",
      "timer_minutes": 10
    }
  ],
