  "id": "savory-chicken-cre-pes",
  "name": "Savory Chicken Crêpes",
  "subtitle": "Tender crêpes with creamy garlic-herb chicken filling",
  "description": "Thin French-style crêpes are filled with creamy garlic-herb chicken, folded, and briefly baked until hot.",
  "meal_type": "breakfast",
  "cuisine": "French",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30,
    "inactive_minutes": 60
  },
  "ingredients": [
