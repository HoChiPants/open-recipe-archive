  "id": "eggs-florentine",
  "name": "Eggs Florentine",
  "subtitle": "A savory skillet breakfast with spinach and mushrooms",
  "description": "Sautéed mushrooms, garlic, and spinach folded into seasoned eggs with cream cheese for a rich, quick breakfast.",
  "meal_type": "breakfast",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "mushrooms",
      "item": "mushrooms",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "fresh-spinach",
      "item": "fresh spinach",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6,
      "unit": "large",
      "preparation": "slightly beaten"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "cut into small pieces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a skillet over medium heat with the butter."
    },
    {
      "step": 2,
      "text": "Add the mushrooms and garlic. Stir for 1 minute, then add the spinach and cook for 3 minutes, until wilted.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Stir in the beaten eggs and season with salt and ground black pepper. Cook, stirring gently, until the eggs are firm and reach 160°F or have a fully set center."
    },
    {
      "step": 4,
      "text": "Whisk the cream cheese until smooth, about 5 minutes, then incorporate it into the finished eggs.",
      "timer_minutes": 5
    }
  ],
