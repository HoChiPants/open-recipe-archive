      "item": "buttermilk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "very-ripe-bananas",
      "item": "very ripe bananas",
      "quantity": 6,
      "preparation": "mashed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Grease loaf pans as needed."
    },
    {
      "step": 2,
      "text": "Whisk the sugar and softened margarine until smooth. Stir in the vanilla extract and eggs."
    },
    {
      "step": 3,
      "text": "Combine the flour, baking soda, and salt in a separate bowl."
    },
    {
      "step": 4,
      "text": "Blend the buttermilk into the sugar mixture, then gradually combine it with the dry ingredients until just mixed."
    },
    {
      "step": 5,
      "text": "Fold in the mashed bananas and transfer the batter to the prepared loaf pans."
    },
    {
      "step": 6,
      "text": "Bake at 325°F for 60 minutes, or until a tester inserted in the center comes out clean and the loaf is set.",
      "timer_minutes": 60
    }
  ],
