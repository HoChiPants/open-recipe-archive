  "id": "banana-bread-ac266ce3",
  "name": "Banana Bread",
  "subtitle": "Moist, classic banana bread with buttermilk",
  "description": "A simple American quick bread combining mashed ripe bananas, buttermilk, and a lightly sweet batter.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
