    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
