  "instructions": [
    {
      "step": 1,
      "text": "Stir the yogurt with the garlic, freshly ground black pepper, 0.25 teaspoon salt, cayenne, and dill. Let it stand at room temperature while preparing the other components."
    },
    {
      "step": 2,
      "text": "Melt the butter in a small skillet over medium heat. Add the Aleppo chili flakes, smoked paprika, and cumin; stir until fragrant, then remove from the heat."
    },
    {
      "step": 3,
      "text": "Combine the parsley, jalapeño, olive oil, and a pinch of salt. Set aside."
    },
    {
      "step": 4,
      "text": "Bring a saucepan of water to a gentle simmer and add the white vinegar. Crack the eggs into the water and cook until the whites are firm and the centers reach 160°F, about 3 minutes. Transfer the eggs with a slotted spoon and season with sea salt.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Divide the yogurt between two bowls. Top with the eggs, drizzle with the spiced butter, and spoon over the parsley-jalapeño mixture."
    }
  ],
