  "id": "cream-cheese-danish-bake",
  "name": "Cream Cheese Danish Bake",
  "subtitle": "Layered pastry with a lemon-vanilla cream cheese center",
  "description": "Crescent dough surrounds a sweet cream cheese filling, then finishes with a simple milk-and-sugar glaze.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "refrigerated-crescent-roll-dough",
      "item": "refrigerated crescent roll dough",
      "quantity": 2,
      "unit": "can",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, diced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "softened"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease a baking dish and press one can of crescent dough evenly across the bottom."
    },
    {
      "step": 2,
      "text": "Beat the diced cream cheese with the white sugar, lemon juice, vanilla extract, sour cream, and confectioners' sugar until smooth. Spread the mixture over the dough."
    },
    {
      "step": 3,
      "text": "Cover the filling with the remaining crescent dough, sealing the edges as evenly as possible."
    },
    {
      "step": 4,
      "text": "Bake for 30 minutes, until the pastry is puffed and golden and the center is fully set.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Stir the confectioners' sugar, milk, and softened butter into a smooth glaze. Let the pastry cool briefly, then spread the glaze over the top before serving."
    }
  ],
