  "id": "biscuit-hash-brown-breakfast-casserole",
  "name": "Biscuit Hash Brown Breakfast Casserole",
  "subtitle": "A savory baked breakfast with crisp hash browns, bacon, biscuits, eggs, and cheddar.",
  "description": "Layer biscuit pieces, hash brown patties, and bacon in a buttered baking dish, then cover with a cheesy egg mixture and bake until fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "refrigerated-biscuit-dough",
      "item": "refrigerated biscuit dough",
      "quantity": 1,
      "unit": "can",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "frozen-hash-brown-patties",
      "item": "frozen hash brown patties",
      "quantity": 8,
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 8
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Grease a baking dish with the butter."
    },
    {
      "step": 2,
      "text": "Arrange the bacon and frozen hash brown patties in a baking pan and heat for 8 minutes. Drain the bacon.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Cut the refrigerated biscuit dough into pieces. Arrange the dough and hash brown patties in the prepared dish, then layer in the bacon."
    },
    {
      "step": 4,
      "text": "Whisk the eggs and milk together, stir in the Cheddar cheese, and pour the mixture evenly over the layers."
    },
    {
      "step": 5,
      "text": "Bake for 35 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Let the casserole cool for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
