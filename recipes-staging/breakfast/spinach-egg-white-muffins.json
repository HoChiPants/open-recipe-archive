{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "spinach-egg-white-muffins",
  "name": "Spinach Egg White Muffins",
  "subtitle": "Savory baked egg-white cups with spinach and Cheddar",
  "description": "A simple breakfast of seasoned egg whites, spinach, and sharp Cheddar baked in individual portions.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed and drained"
    },
    {
      "ingredient_id": "4-ounce-cartons-liquid-egg-whites",
      "item": "(4 ounce) cartons liquid egg whites",
      "quantity": 2
    },
    {
      "ingredient_id": "reduced-fat-sharp-cheddar-cheese",
      "item": "reduced-fat sharp Cheddar cheese",
      "quantity": 6,
      "unit": "ounces",
      "preparation": "shredded, or more to taste"
    },
    {
      "ingredient_id": "hot-sauce",
      "item": "hot sauce",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Coat 10 muffin cups with cooking spray."
    },
    {
      "step": 2,
      "text": "Stir together the drained spinach, egg whites, Cheddar, hot sauce, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Divide the mixture among the prepared muffin cups."
    },
    {
      "step": 4,
      "text": "Bake for 25 minutes, or until the centers are fully set and register 160°F on a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Let the muffins rest briefly, then serve warm."
    }
  ],
