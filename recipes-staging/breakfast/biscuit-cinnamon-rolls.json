  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and grease a baking dish with butter for greasing."
    },
    {
      "step": 2,
      "text": "Mix the white sugar, 2 tablespoons brown sugar, and ground cinnamon for the filling. Stir the vanilla extract into the melted butter."
    },
    {
      "step": 3,
      "text": "Separate the refrigerated biscuit dough, flatten each piece, and arrange the pieces into a connected sheet or overlapping layer as needed for rolling."
    },
    {
      "step": 4,
      "text": "Brush the dough with the melted butter, sprinkle evenly with the cinnamon-sugar mixture, and roll it into a log."
    },
    {
      "step": 5,
      "text": "Cut the log into 20 pieces and place them in the prepared dish."
    },
    {
      "step": 6,
      "text": "Bake for 15 minutes, until the rolls are puffed and lightly golden.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Whisk the confectioners' sugar, remaining 2 tablespoons brown sugar, and milk into a glaze. Drizzle it over the warm rolls before serving."
    }
  ],
