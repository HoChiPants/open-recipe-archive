  "id": "biscuit-cinnamon-rolls",
  "name": "Biscuit Cinnamon Rolls",
  "subtitle": "Quick swirled rolls with cinnamon sugar and vanilla glaze",
  "description": "Refrigerated biscuit dough is filled with cinnamon sugar, rolled and sliced, then baked until golden and finished with a simple milk glaze.",
  "meal_type": "breakfast",
  "cuisine": "American",
