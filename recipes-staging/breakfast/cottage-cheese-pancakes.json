  "instructions": [
    {
      "step": 1,
      "text": "Blend the cottage cheese, oats, eggs, milk, baking powder, and optional vanilla extract and maple syrup until smooth."
    },
    {
      "step": 2,
      "text": "Heat a skillet over medium heat and add the oil or butter."
    },
    {
      "step": 3,
      "text": "Cook the batter in pancakes, adding enough for each pancake to form an even round. Cook for about 3 minutes, until the surface is set and the center reaches 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Turn the pancakes and cook for about 2 minutes, until golden brown and fully cooked. Repeat with the remaining batter.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Serve with poached egg and roasted tomatoes, or with fresh berries and maple syrup."
    }
  ],
