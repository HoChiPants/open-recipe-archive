  "id": "cottage-cheese-pancakes",
  "name": "Cottage Cheese Pancakes",
  "subtitle": "Tender oat pancakes for a simple breakfast",
  "description": "Blend a protein-rich pancake batter, cook it until set and golden, and serve with fruit or savory breakfast toppings.",
  "meal_type": "breakfast",
