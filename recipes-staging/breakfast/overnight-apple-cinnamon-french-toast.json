  "id": "overnight-apple-cinnamon-french-toast",
  "name": "Overnight Apple Cinnamon French Toast",
  "subtitle": "A warm, make-ahead breakfast casserole with apples and maple syrup",
  "description": "Layer bread and apple filling with cinnamon butter, soak it in vanilla custard overnight, then bake until fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
