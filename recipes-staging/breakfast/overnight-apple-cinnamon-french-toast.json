  "instructions": [
    {
      "step": 1,
      "text": "Stir the melted butter, brown sugar, and cinnamon together until smooth. Transfer the mixture to a baking dish and spread it over the bottom."
    },
    {
      "step": 2,
      "text": "Layer the apple pie filling and bread in the dish, arranging the bread to cover the filling."
    },
    {
      "step": 3,
      "text": "Whisk the milk, eggs, and vanilla extract together. Pour the custard evenly over the bread."
    },
    {
      "step": 4,
      "text": "Cover and refrigerate overnight, or for at least 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 5,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 6,
      "text": "Bake for 65 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 65
    },
    {
      "step": 7,
      "text": "Let the casserole rest briefly, then cut into portions.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Add the maple syrup and grill for 2 minutes, watching closely. Top with any remaining apple pie filling and serve.",
      "timer_minutes": 2
    }
  ],
