  "id": "bacon-and-banana-stuffed-french-toast-croissants",
  "name": "Bacon and Banana Stuffed French Toast Croissants",
  "subtitle": "Crisp croissants filled with bacon and banana",
  "description": "Golden croissants stuffed with smoky bacon and sliced banana, coated in maple egg custard, and served with a dusting of icing sugar and maple syrup.",
  "meal_type": "breakfast",
  "cuisine": "French",
  "yield": {
