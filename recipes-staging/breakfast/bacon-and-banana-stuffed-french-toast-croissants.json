  "instructions": [
    {
      "step": 1,
      "text": "Split each croissant horizontally, keeping the halves connected if possible. Fill with the bacon and sliced banana."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, milk, and 2 teaspoons maple syrup in a shallow dish."
    },
    {
      "step": 3,
      "text": "Preheat a large skillet over medium heat and melt the butter. Dip each filled croissant briefly into the egg mixture, turning to coat."
    },
    {
      "step": 4,
      "text": "Cook the croissants in the skillet until browned on both sides and the custard is fully set, reaching 160°F in the center.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Serve immediately with icing sugar and the remaining maple syrup."
    }
  ],
