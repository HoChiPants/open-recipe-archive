  "id": "cinnamon-roll-pancakes",
  "name": "Cinnamon Roll Pancakes",
  "subtitle": "Fluffy pancakes with a warm cinnamon-sugar swirl",
  "description": "Tender cinnamon pancakes cooked with a buttery brown-sugar swirl and served with optional maple syrup and toffee or caramel yogurt.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 145,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "cinnamon",
      "item": "cinnamon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "butter-melted",
      "item": "butter melted",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 140,
      "unit": "ml"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "maple-syrup-plus-extra-to-serve-optional",
      "item": "maple syrup plus extra to serve (optional)",
      "quantity": 1,
      "unit": "tbsp",
      "optional": true
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "toffee-or-caramel-yogurt-to-serve-optional",
      "item": "toffee or caramel yogurt to serve (optional)",
      "quantity": 6,
      "unit": "tbsp",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the self-raising flour, baking powder, golden caster sugar, cinnamon, and light brown soft sugar in a bowl."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, melted butter, and milk until smooth. Add to the dry ingredients and stir just until combined."
    },
    {
      "step": 3,
      "text": "Stir together the cinnamon, golden caster sugar, melted butter, light brown soft sugar, and optional maple syrup until melted and smooth. Transfer the mixture to a small piping bag or spoon it into a drizzle-ready container."
    },
    {
      "step": 4,
      "text": "Preheat a nonstick skillet or griddle over medium heat and brush with the vegetable oil."
    },
    {
      "step": 5,
      "text": "Cook the batter in pancakes, adding a little cinnamon mixture in a spiral or drizzle to each one. Cook for about 3 minutes, until set underneath, then turn and cook until browned and cooked through.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Serve warm with the optional maple syrup and toffee or caramel yogurt."
    }
  ],
