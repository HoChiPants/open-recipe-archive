  "instructions": [
    {
      "step": 1,
      "text": "Preheat a skillet over medium heat and add the vegetable oil."
    },
    {
      "step": 2,
      "text": "Add the cold cooked rice and egg, spreading them into an even layer. Cook for 3 minutes, until the egg begins to set.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir and break up the rice, then cook for 2 minutes more, until the egg is fully set and reaches 160°F.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the green onions and soy sauce. Serve hot."
    }
