  "id": "polish-apple-pancakes",
  "name": "Polish Apple Pancakes",
  "subtitle": "Tender cinnamon pancakes with diced apples",
  "description": "A simple skillet breakfast made from a lightly sweet cinnamon batter folded with apples and finished with confectioners' sugar.",
  "meal_type": "breakfast",
  "cuisine": "Polish",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
