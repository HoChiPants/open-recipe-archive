      "item": "confectioners' sugar",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the milk, flour, eggs, white sugar, cinnamon, baking soda, salt, and confectioners' sugar until smooth. Fold in the diced apples."
    },
    {
      "step": 2,
      "text": "Preheat a skillet over medium heat and coat it with vegetable oil."
    },
    {
      "step": 3,
      "text": "Cook spoonfuls of batter in the oiled skillet until browned and set, turning once during cooking, about 5 minutes total.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Prepare a mixture of white sugar and confectioners' sugar, then dust the warm pancakes with it before serving."
    }
  ],
