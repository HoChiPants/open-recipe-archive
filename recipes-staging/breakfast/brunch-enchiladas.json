  "id": "brunch-enchiladas",
  "name": "Brunch Enchiladas",
  "subtitle": "Make-ahead tortillas with ham, vegetables, eggs, and melted cheese",
  "description": "Fill flour tortillas with savory ham, vegetables, and cheese, then soak them in a seasoned egg mixture and bake until fully set.",
  "meal_type": "breakfast",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 50,
    "inactive_minutes": 490
  },
  "ingredients": [
    {
      "ingredient_id": "ham",
      "item": "ham",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cooked, chopped"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "green-bell-peppers",
      "item": "green bell peppers",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 3,
      "unit": "cups",
      "preparation": "shredded, divided"
    },
    {
      "ingredient_id": "7-inch-flour-tortillas",
      "item": "(7 inch) flour tortillas",
      "quantity": 10
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 5,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "half-and-half-cream",
      "item": "half-and-half cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "hot-pepper-sauce",
      "item": "hot pepper sauce",
      "quantity": 1,
      "unit": "dash"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the ham, green onions, green bell peppers, hot pepper sauce, and part of the Cheddar cheese."
    },
    {
      "step": 2,
      "text": "Divide the filling among the tortillas, roll them snugly, and arrange them seam-side down in a baking dish."
    },
    {
      "step": 3,
      "text": "Whisk the beaten eggs, half-and-half cream, milk, all-purpose flour, garlic powder, and hot pepper sauce until smooth. Pour the mixture evenly over the rolled tortillas."
    },
    {
      "step": 4,
      "text": "Cover and refrigerate for 8 hours or overnight.",
      "timer_minutes": 480
    },
    {
      "step": 5,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 6,
      "text": "Bake the chilled enchiladas until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Scatter the remaining Cheddar cheese over the top and return the dish to the oven until the cheese melts.",
      "timer_minutes": 3
    },
    {
      "step": 8,
      "text": "Let stand for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
