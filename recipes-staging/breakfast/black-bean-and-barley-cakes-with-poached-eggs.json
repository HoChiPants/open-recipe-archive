  "id": "black-bean-and-barley-cakes-with-poached-eggs",
  "name": "Black Bean and Barley Cakes with Poached Eggs",
  "subtitle": "Savory bean cakes with warm tomatoes and eggs",
  "description": "Seasoned black beans and barley form crisp-edged cakes, served with tomatoes, seeds, and poached eggs.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
