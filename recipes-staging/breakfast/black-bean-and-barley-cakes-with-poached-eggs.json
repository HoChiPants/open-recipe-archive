  "instructions": [
    {
      "step": 1,
      "text": "Mash the black beans with the oats, coriander, cumin seeds, thyme, bouillon powder, and sunflower seeds. Stir in the chopped spring onion whites, barley, and 1 egg to form a firm mixture."
    },
    {
      "step": 2,
      "text": "Shape the mixture into four cakes. Heat the rapeseed oil in a large nonstick skillet and cook the cakes for about 7 minutes, turning once, until browned and heated through.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Add the cherry tomatoes to the skillet and cook for about 4 minutes, turning occasionally, until softened.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Meanwhile, poach the remaining 4 eggs in gently boiling water until the whites are set and each egg reaches 160°F in the center.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Serve the cakes with the poached eggs and tomatoes, scattering over the sliced spring onion greens."
    }
  ],
