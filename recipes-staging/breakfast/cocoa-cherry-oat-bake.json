      "item": "blanched hazelnuts",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "fat-free-yogurt-and-sugar-free-cherry-compote",
      "item": "fat-free yogurt and sugar-free cherry compote",
      "preparation": "to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Cover the dried cherries with boiling water and let them stand for 10 minutes. Drain well.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Combine the oats, cocoa powder, cocoa nibs, chia seeds, and baking powder. Stir in the hazelnut milk and vanilla, then fold in the cherries and hazelnuts."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared dish and bake for 30 minutes, until the center is firm and fully set.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Serve warm, with fat-free yogurt and sugar-free cherry compote if desired."
    }
  ],
