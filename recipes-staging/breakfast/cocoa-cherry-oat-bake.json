  "id": "cocoa-cherry-oat-bake",
  "name": "Cocoa Cherry Oat Bake",
  "subtitle": "A warm, fruit-filled oat breakfast with cocoa and hazelnuts.",
  "description": "Dried cherries, cocoa, oats, chia, and hazelnut milk bake into a tender breakfast casserole with a nutty finish.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "dried-cherries",
      "item": "dried cherries",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "chia-seeds",
