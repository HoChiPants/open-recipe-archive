      "unit": "tbsp"
    },
    {
      "ingredient_id": "cocoa-nibs",
      "item": "cocoa nibs",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
