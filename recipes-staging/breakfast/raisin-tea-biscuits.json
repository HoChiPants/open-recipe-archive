  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "raisin-tea-biscuits",
  "name": "Raisin Tea Biscuits",
  "subtitle": "Tender raisin biscuits for breakfast or tea",
  "description": "Lightly sweet biscuits with raisins, made from a simple butter-and-milk dough and baked until golden.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour and baking powder together, then stir in the raisins."
    },
    {
      "step": 3,
      "text": "Whisk the milk and eggs in a separate bowl."
    },
    {
      "step": 4,
      "text": "Whisk the softened butter, sugar, and salt for 1 minute. Add the milk mixture and whisk until combined.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Add the dry mixture and stir just until a thick dough forms."
    },
    {
      "step": 6,
      "text": "Shape the dough and cut it into 24 biscuits."
    },
    {
      "step": 7,
      "text": "Transfer the biscuits to a baking sheet and bake for 10 minutes, until golden brown.",
      "timer_minutes": 10
    }
  ],
