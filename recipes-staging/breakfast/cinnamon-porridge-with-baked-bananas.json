  "id": "cinnamon-porridge-with-baked-bananas",
  "name": "Cinnamon Porridge with Baked Bananas",
  "subtitle": "Warm oat porridge with citrusy banana and yogurt",
  "description": "Creamy cinnamon porridge topped with softened orange-scented banana, yogurt, and toasted seeds.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 8
  },
  "ingredients": [
    {
      "ingredient_id": "porridge-oats",
      "item": "porridge oats",
      "quantity": 80,
      "unit": "g"
    },
    {
      "ingredient_id": "semi-skimmed-milk",
      "item": "semi-skimmed milk",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "ripe-banana-120g",
      "item": "ripe banana (120g)",
      "quantity": 1,
      "unit": "large",
      "preparation": "halved lengthways and cut in half"
    },
    {
      "ingredient_id": "orange-zested-and-juiced",
      "item": "orange zested and juiced",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "plain-bio-yogurt",
      "item": "plain bio yogurt",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "three-seed-mix",
      "item": "three-seed mix",
      "quantity": 2,
      "unit": "tsp",
      "preparation": "toasted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the porridge oats, semi-skimmed milk, and ground cinnamon in a microwave-safe bowl. Microwave for 5 minutes, or until thickened, stirring once halfway through.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Place the prepared banana in a microwave-safe dish with the orange zest and juice. Microwave for 2 minutes, until softened and warmed through.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Divide the porridge between two bowls. Top with the yogurt and banana, then sprinkle with the toasted three-seed mix."
    }
  ],
