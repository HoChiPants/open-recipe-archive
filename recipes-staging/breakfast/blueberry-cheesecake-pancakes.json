  "id": "blueberry-cheesecake-pancakes",
  "name": "Blueberry Cheesecake Pancakes",
  "subtitle": "Pancakes with warm berries, sweet cream cheese, and biscuit crunch",
  "description": "Layer pancakes or crêpes with sweetened cream cheese, maple-warmed blueberries, biscuit crumbs, and optional nuts for a quick breakfast or brunch treat.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-or-frozen-blueberries",
      "item": "fresh or frozen blueberries",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar-to-taste",
      "item": "icing sugar to taste",
      "quantity": "1/2-1",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "pancakes-or-cre-pes-see-recipe",
      "item": "pancakes or crêpes (see recipe",
      "quantity": 4,
      "preparation": "below)"
    },
    {
      "ingredient_id": "caramelised-biscuits-or-ginger-nuts",
      "item": "caramelised biscuits or ginger nuts",
      "quantity": 4,
      "preparation": "crushed"
    },
    {
      "ingredient_id": "nuts-pecans-or-almonds-work-well",
      "item": "nuts (pecans or almonds work well)",
      "quantity": 50,
      "unit": "g",
      "preparation": "roughly chopped or crushed (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the blueberries with the maple syrup for 3 minutes, until softened and juicy.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Stir the cream cheese with the icing sugar until smooth and lightly sweetened."
    },
    {
      "step": 3,
      "text": "Spread the sweetened cream cheese over the pancakes or crêpes. Spoon over the warm blueberries, then finish with crushed biscuits and the optional nuts."
    }
  ],
