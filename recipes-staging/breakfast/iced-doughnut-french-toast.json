  "id": "iced-doughnut-french-toast",
  "name": "Iced Doughnut French Toast",
  "subtitle": "Spiced doughnuts with a crisp, buttery finish",
  "description": "Soak iced ring doughnuts in a lightly spiced custard, then cook them in butter until browned and fully set. Serve with a sweet topping of your choice.",
  "meal_type": "breakfast",
  "cuisine": "French",
