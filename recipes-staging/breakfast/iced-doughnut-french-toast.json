  "instructions": [
    {
      "step": 1,
      "text": "Whisk the milk, beaten eggs, cinnamon, nutmeg, ginger, orange zest, vanilla, and brown sugar in a shallow bowl."
    },
    {
      "step": 2,
      "text": "Cut the doughnuts in half and dip the cut sides briefly into the custard, turning to coat without oversoaking."
    },
    {
      "step": 3,
      "text": "Melt the butter in a large skillet over medium heat."
    },
    {
      "step": 4,
      "text": "Cook the doughnuts in batches for about 3 minutes per side, adding a little brown sugar to the pan for the final 2 minutes so it caramelizes lightly. Cook until browned and the custard is firm and reaches 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Serve warm with your choice of maple syrup, jam, chocolate spread, chopped nuts, or icing sugar."
    }
  ],
