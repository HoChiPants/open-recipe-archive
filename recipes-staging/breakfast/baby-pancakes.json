  "id": "baby-pancakes",
  "name": "Baby Pancakes",
  "subtitle": "Small banana pancakes with cinnamon",
  "description": "Tender banana pancakes made with a simple egg-and-flour batter and lightly cooked in butter and oil.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 17,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "bananas-peeled",
      "item": "bananas peeled",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mash the peeled bananas in a bowl until smooth."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, self-raising flour, and cinnamon together, then stir in the mashed bananas until combined."
    },
    {
      "step": 3,
      "text": "Heat the butter and oil in a skillet over medium heat."
    },
    {
      "step": 4,
      "text": "Cook small spoonfuls of batter until the pancakes are set, about 2 minutes, turning once as needed.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
