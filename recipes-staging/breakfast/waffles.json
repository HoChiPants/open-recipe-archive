    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 4,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "separated"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the waffle iron according to its instructions."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, baking powder, and salt. Stir in the milk and vegetable oil until smooth, then mix in the egg yolks."
    },
    {
      "step": 3,
      "text": "Whisk the egg whites to soft peaks and fold them gently into the batter."
    },
    {
      "step": 4,
      "text": "Cook the batter in the preheated waffle iron until the waffles are golden and cooked through, about 15 minutes total.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
