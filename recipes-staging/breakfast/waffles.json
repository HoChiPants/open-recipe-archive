  "id": "waffles",
  "name": "Waffles",
  "subtitle": "Light, crisp waffles for a simple breakfast",
  "description": "A straightforward waffle batter made with separated eggs for a tender, airy texture.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
