  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a boil. Cook the fettuccini for 10 minutes, or until tender, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "While the pasta cooks, heat the olive oil in a large pan. Cook the onion and garlic until softened."
    },
    {
      "step": 3,
      "text": "Stir in the canned tomatoes, tomato paste, mushrooms, mussels, and fresh tomatoes. Add the basil, oregano, and tarragon."
    },
    {
      "step": 4,
      "text": "Simmer the mixture for 10 minutes, stirring occasionally, until the mussels are opaque and cooked through; if they are shell-on, discard any shells that remain closed.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir in the olives and simmer for 5 minutes more.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Serve the mussel sauce over the drained fettuccini."
    }
  ],
