  "id": "five-ingredient-monkey-bread",
  "name": "Five-Ingredient Monkey Bread",
  "subtitle": "Cinnamon-coated biscuit pieces baked in a buttery sugar glaze",
  "description": "Tender biscuit pieces are coated with cinnamon sugar, layered in a pan, and baked beneath a simple margarine-sugar glaze.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "refrigerated-biscuit-dough",
      "item": "refrigerated biscuit dough",
      "quantity": 3,
      "unit": "package",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Stir 0.75 cup white sugar with the cinnamon in a bowl."
    },
    {
      "step": 3,
      "text": "Cut the biscuit dough into small pieces and toss them in the cinnamon-sugar mixture."
    },
    {
      "step": 4,
      "text": "Arrange the coated dough pieces in the prepared pan."
    },
    {
      "step": 5,
      "text": "Combine the margarine and the remaining 0.75 cup white sugar, then pour the mixture over the dough."
    },
    {
      "step": 6,
      "text": "Bake until puffed and cooked through.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Cool briefly, then invert the bread onto a serving plate."
    }
  ],
