{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "norwegian-waffles",
  "name": "Norwegian Waffles",
  "subtitle": "Tender, lightly sweet waffles for a cozy breakfast",
  "description": "A simple waffle batter with vanilla and a delicate sweetness, cooked until golden and ready to serve warm.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 3.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a waffle iron according to its settings."
    },
    {
      "step": 2,
      "text": "Whisk together the flour and baking powder in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the eggs and sugar. Whisk in the milk, melted shortening, salt, and vanilla."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the wet mixture and stir just until combined."
    },
    {
      "step": 5,
      "text": "Pour enough batter into the preheated waffle iron to cover the cooking surface. Close and cook until golden brown, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Repeat with the remaining batter and serve warm."
    }
  ],
