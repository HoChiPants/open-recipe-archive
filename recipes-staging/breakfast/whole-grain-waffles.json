  "instructions": [
    {
      "step": 1,
      "text": "Preheat the waffle iron according to its instructions."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, milk, applesauce, and vanilla together, then mix in the canola oil."
    },
    {
      "step": 3,
      "text": "Combine both flours, flax meal, wheat germ, baking powder, sugar, and salt in a separate bowl. Stir the dry mixture into the wet mixture until smooth."
    },
    {
      "step": 4,
      "text": "Cook the batter in the preheated waffle iron until the waffles are golden brown."
    }
