  "id": "air-fryer-poached-eggs",
  "name": "Air-Fryer Poached Eggs",
  "subtitle": "Tender eggs prepared in individual ramekins",
  "description": "Poach eggs in an air fryer for an easy breakfast with set whites and gently cooked centers.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 2,
    "cook_minutes": 12
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-or-sunflower-oil",
      "item": "vegetable or sunflower oil",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly oil two heatproof ramekins and crack one egg into each."
    },
    {
      "step": 2,
      "text": "Preheat the air fryer for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Place the ramekins in the basket and cook until the whites are set and each egg reaches 160°F in the center.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Carefully remove the ramekins and drain any excess liquid before serving."
    }
  ],
