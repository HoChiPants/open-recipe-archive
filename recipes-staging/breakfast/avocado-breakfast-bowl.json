  "id": "avocado-breakfast-bowl",
  "name": "Avocado Breakfast Bowl",
  "subtitle": "Quinoa, eggs, avocado, and feta for a savory start",
  "description": "A warm quinoa bowl topped with eggs, diced avocado, and feta.",
