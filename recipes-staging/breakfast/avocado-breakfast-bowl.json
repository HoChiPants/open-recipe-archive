  "instructions": [
    {
      "step": 1,
      "text": "Combine the water and quinoa in a saucepan. Bring to a simmer, cover, and cook for 15 minutes, or until the quinoa is tender.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Meanwhile, warm the olive oil in a skillet and cook the eggs until the whites are set. Season with the pinch of salt and pepper, seasoned salt, and ground black pepper."
    },
    {
      "step": 3,
      "text": "Divide the quinoa between two bowls. Top with the eggs, diced avocado, and crumbled feta."
    }
