  "instructions": [
    {
      "step": 1,
      "text": "Bring the water and salt to a simmer in a saucepan."
    },
    {
      "step": 2,
      "text": "Whisk in the hominy grits. Continue whisking for 1 minute to prevent lumps.",
      "timer_minutes": 1
    },
    {
