  "id": "breakfast-grits",
  "name": "Breakfast Grits",
  "subtitle": "Creamy cheddar grits for a warm, savory breakfast",
  "description": "Tender hominy grits finished with sharp Cheddar, butter, and black pepper.",
  "meal_type": "breakfast",
