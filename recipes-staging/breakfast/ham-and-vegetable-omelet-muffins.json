  "id": "ham-and-vegetable-omelet-muffins",
  "name": "Ham and Vegetable Omelet Muffins",
  "subtitle": "Portable baked egg cups with savory ham and vegetables",
  "description": "These individual egg muffins combine cooked ham, peppers, and onion in a lightly seasoned breakfast bake.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 8
    },
    {
      "ingredient_id": "ham",
      "item": "ham",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "cooked, crumbled"
    },
    {
      "ingredient_id": "red-bell-pepper",
      "item": "red bell pepper",
      "quantity": 1,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a muffin tin for baking."
    },
    {
      "step": 2,
      "text": "Whisk the eggs with the water, salt, and pepper until blended. Stir in the ham, bell pepper, and onion."
    },
    {
      "step": 3,
      "text": "Divide the mixture among the muffin cups."
    },
    {
      "step": 4,
      "text": "Bake for 20 minutes, until the centers are fully set and reach 160°F on a food thermometer.",
      "timer_minutes": 20
    }
  ],
