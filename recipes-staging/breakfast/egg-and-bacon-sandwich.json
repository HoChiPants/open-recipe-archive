  "id": "egg-and-bacon-sandwich",
  "name": "Egg and Bacon Sandwich",
  "subtitle": "Crisp bacon, eggs, and maple syrup between toasted bread",
  "description": "A sweet-savory breakfast sandwich combining crisp bacon, set eggs, dipped bread, and maple syrup.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
