  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a skillet over medium heat until crisp. Transfer it to a plate and drain briefly."
    },
    {
      "step": 2,
      "text": "Dip the bread slices in the beaten eggs, coating both sides."
    },
    {
      "step": 3,
      "text": "Cook the coated bread in the skillet until browned on both sides, then set aside."
    },
    {
      "step": 4,
      "text": "Beat the remaining eggs and sauté them in the skillet until fully set and at least 160°F."
    },
    {
      "step": 5,
      "text": "Assemble two sandwiches with the egg, bacon, and cooked bread. Serve with maple syrup."
    }
  ],
