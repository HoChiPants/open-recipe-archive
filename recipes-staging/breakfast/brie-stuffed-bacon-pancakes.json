  "instructions": [
    {
      "step": 1,
      "text": "Heat a large skillet or griddle and cook the bacon until crisp. Transfer it to a plate and keep it warm.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, caster sugar, beaten eggs, and milk until the batter is smooth."
    },
    {
      "step": 3,
      "text": "Heat a little sunflower oil and salted butter in the skillet over medium heat."
    },
    {
      "step": 4,
      "text": "Cook the batter in pancakes, adding brie and cheddar to each before shaping and turning. Cook until golden on both sides, the cheese is melted, and the centers are fully set; for an egg-safety check, they should reach 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Rest the pancakes briefly, then serve with the crisp bacon and extra butter."
    }
  ],
