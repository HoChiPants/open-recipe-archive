  "id": "brie-stuffed-bacon-pancakes",
  "name": "Brie-Stuffed Bacon Pancakes",
  "subtitle": "Savory pancakes with melted brie and cheddar",
  "description": "Crisp bacon and creamy, melted cheeses turn fluffy American pancakes into a hearty breakfast.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "(2 pancakes per serving)"
  },
