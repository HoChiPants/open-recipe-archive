  "id": "chia-and-oat-breakfast-scones",
  "name": "Chia and Oat Breakfast Scones",
  "subtitle": "Tender baked scones with yogurt and sliced strawberries",
  "description": "Small wholemeal spelt scones enriched with chia and oats, served with Greek yogurt and fresh strawberries.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
