  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and lightly grease four ramekins with some of the rapeseed oil."
    },
    {
      "step": 2,
      "text": "Stir the milk, lemon juice, vanilla extract, and remaining oil together."
    },
    {
      "step": 3,
      "text": "Combine the spelt flour, chia seeds, oats, and baking powder in a bowl."
    },
    {
      "step": 4,
      "text": "Add the wet mixture to the dry ingredients and stir just until combined."
    },
    {
      "step": 5,
      "text": "Divide the mixture among the ramekins and bake until firm.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Let the scones cool briefly, then prepare the strawberries and spoon the yogurt into serving portions."
    },
    {
      "step": 7,
      "text": "Serve the scones with the yogurt and sliced strawberries."
    }
  ],
