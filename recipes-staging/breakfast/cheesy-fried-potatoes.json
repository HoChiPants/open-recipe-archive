  "id": "cheesy-fried-potatoes",
  "name": "Cheesy Fried Potatoes",
  "subtitle": "Crisp potatoes with bacon, eggs, and melted Cheddar",
  "description": "A hearty American breakfast skillet combining golden potatoes, bacon, eggs, and shredded Cheddar.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
