      "item": "Cheddar cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a skillet over medium heat until crisp. Transfer it to a plate, leaving the drippings in the skillet."
    },
    {
      "step": 2,
      "text": "Add the butter to the skillet. Stir in the onion and potatoes, and cook until the potatoes are golden brown and tender.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Stir the eggs into the potatoes. Add the bacon, salt and pepper, and Cheddar."
    },
    {
      "step": 4,
      "text": "Cook, stirring gently, until the eggs are fully set and reach 160°F, and the cheese is melted."
    }
  ],
