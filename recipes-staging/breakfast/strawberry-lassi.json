  "id": "strawberry-lassi",
  "name": "Strawberry Lassi",
  "subtitle": "A cool strawberry yogurt drink",
  "description": "Blend ripe strawberries with sugar, milk, yogurt, and cardamom, then serve chilled over ice.",
  "meal_type": "breakfast",
  "cuisine": "Indian",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
