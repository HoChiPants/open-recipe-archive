  },
  "ingredients": [
    {
      "ingredient_id": "ripe-strawberries",
      "item": "ripe strawberries",
      "quantity": 9,
      "preparation": "rinsed"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "milk",
