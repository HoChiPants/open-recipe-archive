  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the rinsed strawberries into pieces."
    },
    {
      "step": 2,
      "text": "Place the strawberries and sugar in a blender and blend until smooth."
    },
    {
      "step": 3,
      "text": "Add the milk and yogurt; blend for 1 minute until creamy.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Pour into three serving glasses over the ice cubes and sprinkle with ground cardamon."
    }
