  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking soda, and baking powder together in a bowl."
    },
    {
      "step": 3,
      "text": "Beat 1 cup white sugar and 0.5 cup butter until smooth. Add 1 egg, sour cream, and vanilla; mix until combined. Stir in the dry ingredients to form the batter."
    },
    {
      "step": 4,
      "text": "Beat the cream cheese, 0.5 cup white sugar, and 1 egg until smooth."
    },
    {
      "step": 5,
      "text": "Combine the pecans, brown sugar, 0.33333334326744 cup flour, and 0.33333334326744 cup butter to make the topping."
    },
    {
      "step": 6,
      "text": "Spread half the batter in a baking pan, add the cream cheese mixture, and cover with the remaining batter. Sprinkle the pecan topping over it."
    },
    {
      "step": 7,
      "text": "Bake until the cake is set and the center reaches 160°F, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Cool before slicing and serving."
    }
  ],
