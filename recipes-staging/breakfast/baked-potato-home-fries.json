  "instructions": [
    {
      "step": 1,
      "text": "Prepare the potatoes, then microwave them for 5 minutes until partially tender. Continue cooking until tender, then let them cool and set before cutting into cubes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium heat and cook the chopped onion for about 5 minutes, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the potato cubes and season with salt and ground black pepper. Cook, turning occasionally, until browned and crisp.",
      "timer_minutes": 15
    }
