  "id": "baked-potato-home-fries",
  "name": "Baked Potato Home Fries",
  "subtitle": "Crisp skillet potatoes with tender onion",
  "description": "Partially cook baking potatoes, cool and cube them, then brown them in butter with chopped onion for a simple breakfast side.",
  "meal_type": "breakfast",
