  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven for the tofu, following the temperature appropriate to the tofu preparation."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet. Add the onions and cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the pepper, chilli, tomatoes, tomato purée, bouillon powder, oregano, smoked paprika, and chickpeas. Stir well."
    },
    {
      "step": 4,
      "text": "Simmer uncovered for about 20 minutes, stirring as needed, until the mixture has thickened.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Prepare the tofu in the preheated oven according to the intended serving preparation."
    },
    {
      "step": 6,
      "text": "Mix the soya yogurt with the grated garlic and chill until serving."
    },
    {
      "step": 7,
      "text": "Spoon the chickpea mixture into bowls. Add the tofu, garlic yogurt, and parsley, then sprinkle with the extra smoked paprika."
    }
  ],
