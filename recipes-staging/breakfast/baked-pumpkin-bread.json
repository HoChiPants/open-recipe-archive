  "id": "baked-pumpkin-bread",
  "name": "Baked Pumpkin Bread",
  "subtitle": "A warmly spiced loaf with a tender pumpkin crumb.",
  "description": "This simple pumpkin quick bread combines brown sugar, buttermilk, and warming spices in a single loaf suitable for breakfast or snacks.",
  "meal_type": "breakfast",
