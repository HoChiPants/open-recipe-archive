      "unit": "tablespoons",
      "preparation": "softened"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, baking soda, salt, cinnamon, and nutmeg."
    },
    {
      "step": 3,
      "text": "Stir the pumpkin, brown sugar, buttermilk, softened butter, and egg together until smooth."
    },
    {
      "step": 4,
      "text": "Combine the wet mixture with the dry ingredients, stirring just until no dry flour remains."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a prepared loaf pan."
    },
    {
      "step": 6,
      "text": "Bake for 60 minutes, until the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    }
  ],
