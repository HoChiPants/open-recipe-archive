  "id": "almond-butter-banana-porridge",
  "name": "Almond Butter & Banana Porridge",
  "subtitle": "Creamy oat porridge with bananas, raisins, and almond butter",
  "description": "A warm, filling porridge finished with sliced bananas, toasted almonds, and almond butter.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "whole-almonds-sliced-or-flaked",
      "item": "whole almonds sliced or flaked",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "quaker-rolled-oats",
      "item": "Quaker Rolled Oats",
      "quantity": 160,
      "unit": "g"
    },
    {
      "ingredient_id": "l-unsweetened-almond-milk",
      "item": "l unsweetened almond milk",
      "quantity": 1.2
    },
    {
      "ingredient_id": "sultanas-or-raisins",
      "item": "sultanas or raisins",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "cinnamon",
      "item": "cinnamon (optional)",
      "quantity": "1/4",
      "unit": "tsp",
      "optional": true
    },
    {
      "ingredient_id": "bananas-sliced",
      "item": "bananas sliced",
      "quantity": 2
    },
    {
      "ingredient_id": "almond-butter-stirred",
      "item": "almond butter stirred",
      "quantity": 4,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Toast the almonds in a dry saucepan over medium heat for about 3 minutes, stirring until lightly golden. Transfer to a plate.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Combine the oats, almond milk, sultanas or raisins, and cinnamon in the saucepan."
    },
    {
      "step": 3,
      "text": "Cook over medium heat for about 6 minutes, stirring often, until thick and smooth.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Divide the porridge among four bowls. Top with banana slices, almond butter, and toasted almonds, then serve."
    }
  ],
