  "instructions": [
    {
      "step": 1,
      "text": "Preheat a skillet over medium heat. Add the diced bacon and chopped onion, and cook until the bacon is browned and the onion is tender. Drain well."
    },
    {
      "step": 2,
      "text": "Cut the bagels into bite-size pieces and arrange them in a baking dish."
    },
    {
      "step": 3,
      "text": "Scatter the cooked bacon and onion, shredded Cheddar, and Parmesan over the bagel pieces."
    },
    {
      "step": 4,
      "text": "Whisk together the beaten eggs, milk, parsley, and pepper. Pour the mixture evenly over the casserole."
    },
    {
      "step": 5,
      "text": "Cover and refrigerate for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 6,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 7,
      "text": "Bake uncovered for 30 minutes, then add the Cheddar and Parmesan. Continue baking until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
