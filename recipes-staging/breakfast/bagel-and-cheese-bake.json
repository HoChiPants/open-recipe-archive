  "id": "bagel-and-cheese-bake",
  "name": "Bagel and Cheese Bake",
  "subtitle": "A make-ahead breakfast casserole with bacon, onions, and two cheeses.",
  "description": "Cubed bagels soak overnight in a savory egg custard before baking into a hearty, set breakfast casserole.",
  "meal_type": "breakfast",
  "cuisine": "American",
