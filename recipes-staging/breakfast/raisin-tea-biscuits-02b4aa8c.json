  "id": "raisin-tea-biscuits-02b4aa8c",
  "name": "Raisin Tea Biscuits",
  "subtitle": "Tender biscuits with plump raisins",
  "description": "Soft, lightly sweet biscuits studded with soaked raisins and finished with a simple egg wash.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "hot-water",
      "item": "hot water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "tablespoons"
    },
