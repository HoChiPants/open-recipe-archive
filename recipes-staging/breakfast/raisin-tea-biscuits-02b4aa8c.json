  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Cover the raisins with the hot water and let them stand for 10 minutes. Drain well.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk together the flour, sugar, baking powder, and salt. Cut in the cold butter until the mixture is crumbly."
    },
    {
      "step": 4,
      "text": "Stir in the milk and drained raisins just until a soft dough forms."
    },
    {
      "step": 5,
      "text": "Turn the dough onto a lightly floured surface, pat it into a thick round, and cut it into 8 biscuits."
    },
    {
      "step": 6,
      "text": "Whisk the egg with the water and brush the mixture over the biscuits."
    },
    {
      "step": 7,
      "text": "Bake for 15 minutes, until golden brown and the center reaches at least 160°F.",
      "timer_minutes": 15
    }
  ],
