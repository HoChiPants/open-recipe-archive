  "id": "strawberry-french-toast-casserole",
  "name": "Strawberry French Toast Casserole",
  "subtitle": "An overnight baked breakfast with berries and cream cheese",
  "description": "Bread, cream cheese, and strawberries soak in a maple egg custard overnight, then bake until set and golden. Serve with a warm strawberry sauce.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 75,
    "inactive_minutes": 480
  },
  "ingredients": [
    {
      "ingredient_id": "slices-home-style-white-bread",
      "item": "slices home-style white bread",
      "quantity": 12,
      "preparation": "cut into 1-inch cubes, divided"
    },
    {
      "ingredient_id": "cold-cream-cheese",
      "item": "cold cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, cut into 1-inch cubes"
    },
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "half-and-half",
      "item": "half-and-half",
      "quantity": 2,
      "unit": "cups"
    },
    {
