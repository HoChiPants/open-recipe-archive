      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grease a baking dish and spread half of the bread cubes over the bottom. Scatter the cream cheese and 1.5 cups sliced strawberries over the bread, then cover with the remaining bread cubes."
    },
    {
      "step": 2,
      "text": "Whisk the half-and-half, eggs, and maple syrup until smooth. Pour the custard evenly over the casserole, pressing the bread down gently so it is moistened."
    },
    {
      "step": 3,
      "text": "Cover and refrigerate for 8 hours or overnight.",
      "timer_minutes": 480
    },
    {
      "step": 4,
      "text": "Let the casserole stand at room temperature for 45 minutes. Heat the oven to 350°F.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Bake covered for 30 minutes, then uncover and continue baking until golden brown and the center is fully set, reaching at least 160°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "While the casserole bakes, stir the sugar, water, and cornstarch together in a saucepan. Bring to a simmer and cook until thickened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Stir in the remaining sliced strawberries and cook for 10 minutes. Add the butter and stir until melted.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Serve the warm strawberry sauce over the casserole."
    }
  ],
