  "id": "raspberry-banana-bread",
  "name": "Raspberry Banana Bread",
  "subtitle": "A tender quick bread with berries, banana, and warm spice",
  "description": "Thawed raspberries and ripe banana add fruit flavor and moisture to this lightly spiced loaf.",
  "meal_type": "breakfast",
  "cuisine": "American",
