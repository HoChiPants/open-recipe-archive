  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Drain the thawed raspberries as needed and mash the banana."
    },
    {
      "step": 3,
      "text": "Whisk the raspberries, banana, sugar, eggs, and oil for 3 minutes, until set.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "In a separate bowl, combine the flour, cinnamon, baking soda, salt, and nutmeg."
    },
    {
      "step": 5,
      "text": "Stir the dry mixture into the fruit mixture just until combined, then stir in the lemon extract."
    },
    {
      "step": 6,
      "text": "Transfer the batter to a prepared loaf pan."
    },
    {
      "step": 7,
      "text": "Bake for 60 minutes, until the loaf is set in the center.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Cool for 10 minutes before slicing.",
      "timer_minutes": 10
    }
  ],
