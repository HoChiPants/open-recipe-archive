      "item": "green onions",
      "quantity": 3,
      "preparation": "minced"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded, divided"
    },
    {
