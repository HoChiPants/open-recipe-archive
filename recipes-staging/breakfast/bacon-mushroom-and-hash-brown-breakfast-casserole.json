  "id": "bacon-mushroom-and-hash-brown-breakfast-casserole",
  "name": "Bacon, Mushroom, and Hash Brown Breakfast Casserole",
  "subtitle": "A savory baked breakfast layered with crisp potatoes, bacon, mushrooms, and eggs.",
  "description": "Crisp the bacon and hash browns, sauté the mushrooms, then layer everything with cheese and an egg-milk mixture for a hearty breakfast casserole.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 65
  },
  "ingredients": [
