      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F and coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Cook the bacon in a skillet until crisp, then transfer it to a plate. Add the hash brown potatoes to the skillet and cook for 25 minutes. Stir in the butter and cook for 10 minutes, until lightly browned; season with salt and pepper.",
      "timer_minutes": 35
    },
    {
      "step": 3,
      "text": "Transfer the potatoes to the baking dish. Cook the mushrooms in the skillet for 10 minutes, then layer them over the potatoes with the bacon and green onions.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Sprinkle on part of the Cheddar cheese. Whisk the eggs, milk, and 1 teaspoon salt until smooth, then pour the mixture into the dish. Top with the remaining cheese."
    },
    {
      "step": 5,
      "text": "Bake for 40 minutes, until the center is fully set and reaches 160°F on a food thermometer. Serve hot.",
      "timer_minutes": 40
    }
  ],
