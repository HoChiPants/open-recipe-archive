  "id": "baked-beans-on-toast-with-poached-eggs-and-pancetta",
  "name": "Baked Beans on Toast with Poached Eggs and Pancetta",
  "subtitle": "Smoky beans and set eggs over crisp wholemeal toast",
  "description": "A quick skillet breakfast combining tomatoey cannellini beans, smoky paprika, poached eggs, toast, and optional crisp pancetta.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
