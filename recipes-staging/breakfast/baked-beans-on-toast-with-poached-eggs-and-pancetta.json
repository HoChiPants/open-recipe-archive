  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a wide skillet over medium heat. Add the onion and cook until softened and lightly browned, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Add the crushed garlic and smoked paprika; cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Stir in the cannellini beans, chopped tomatoes, soft brown sugar, and Worcestershire sauce. Simmer until the mixture thickens, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Toast the wholemeal bread and crisp the optional pancetta or bacon while the beans cook."
    },
    {
      "step": 5,
      "text": "Make two spaces in the beans and crack in the eggs. Cover and simmer for about 3 minutes, or until the whites and yolks are fully set and the centers reach 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Spoon the beans and eggs over the toast and top with the crisp pancetta or bacon."
    }
  ],
