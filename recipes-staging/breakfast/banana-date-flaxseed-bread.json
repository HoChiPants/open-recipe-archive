      "item": "dates",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped pitted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a loaf pan."
    },
    {
      "step": 2,
      "text": "Process the 0.5 cup flax seed until finely ground, then set it aside."
    },
    {
      "step": 3,
      "text": "Whisk the white sugar and eggs until blended. Stir in the bananas and vegetable oil."
    },
    {
      "step": 4,
      "text": "Combine the ground flax seed, all-purpose flour, baking powder, baking soda, salt, and remaining flax seed in a separate bowl."
    },
    {
      "step": 5,
      "text": "Stir the dry mixture into the wet mixture just until combined. Fold in the dates."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and bake at 350°F until the center is firm and set, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Cool the bread before slicing."
    }
  ],
