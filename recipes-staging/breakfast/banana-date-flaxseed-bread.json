      "quantity": 2
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flax-seed",
      "item": "flax seed",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
