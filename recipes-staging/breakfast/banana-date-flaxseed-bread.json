  "id": "banana-date-flaxseed-bread",
  "name": "Banana Date Flaxseed Bread",
  "subtitle": "A tender loaf with bananas, dates, and flaxseed",
  "description": "Make a moist, lightly sweet breakfast bread by combining mashed bananas, flaxseed, and dates in a simple batter, then baking until set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "flax-seed",
      "item": "flax seed",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "banana",
      "item": "bananas",
      "quantity": 3,
      "preparation": "mashed"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
