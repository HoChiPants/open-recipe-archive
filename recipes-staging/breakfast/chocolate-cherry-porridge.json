  "instructions": [
    {
      "step": 1,
      "text": "Place the cherries, caster sugar if desired, and lemon juiced in a saucepan. Warm gently until the cherries soften.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir the cornflour with a little of the cherry mixture until smooth, then return it to the pan and stir until thickened."
    },
    {
      "step": 3,
      "text": "In a separate saucepan, combine the porridge oats and milled seed mix. Stir in the cocoa powder, maple syrup, and semi-skimmed milk."
    },
    {
      "step": 4,
      "text": "Cook the oat mixture over medium heat, stirring, until thickened.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Divide the porridge between bowls. Top with the cherries, Danone Skyr Plain Yoghurt, and pistachios or walnuts finely chopped."
    }
  ],
