  "id": "chocolate-cherry-porridge",
  "name": "Chocolate Cherry Porridge",
  "subtitle": "Creamy cocoa oats with warm cherry topping",
  "description": "A quick breakfast combining cocoa porridge, lemony cherries, yogurt, and chopped nuts.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
