  "instructions": [
    {
      "step": 1,
      "text": "Whisk the egg whites and egg in a bowl. Stir in both cheeses, salt, red pepper flakes, garlic powder, nutmeg, black pepper, and red bell pepper."
    },
    {
      "step": 2,
      "text": "Preheat a skillet and add the olive oil. Cook the mushrooms and green onions for 5 minutes, stirring, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the spinach and cook for 2 minutes, then stir in the tomato.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Pour the egg mixture over the vegetables and cook for 15 minutes, or until the center is firm and fully set; verify with a thermometer that it reaches 160°F.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Cut the omelet into portions and serve."
    }
  ],
