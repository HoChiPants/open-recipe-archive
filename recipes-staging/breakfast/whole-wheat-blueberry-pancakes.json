{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "whole-wheat-blueberry-pancakes",
  "name": "Whole Wheat Blueberry Pancakes",
  "subtitle": "Tender pancakes with blueberries in every bite",
  "description": "A simple American breakfast made with whole wheat flour, fresh blueberries, and a lightly sweetened batter.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "whole-wheat-flour",
      "item": "whole wheat flour",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup",
      "preparation": "plus more if necessary"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "artificial-sweetener",
      "item": "artificial sweetener",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "blueberries",
      "item": "blueberries",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the whole wheat flour and baking powder in a bowl. In a separate bowl, whisk the milk, egg, artificial sweetener, and salt until combined."
    },
    {
      "step": 2,
      "text": "Add the wet mixture to the dry ingredients and stir just until incorporated. If the batter is too thick to pour, add more milk as necessary. Fold in the blueberries."
    },
    {
      "step": 3,
      "text": "Preheat a lightly coated griddle or skillet over medium heat."
    },
    {
      "step": 4,
      "text": "Pour the batter into pancakes and cook until bubbles form and the undersides are golden brown. Turn and cook until golden brown on the other side and the centers are fully set.",
      "timer_minutes": 10
    }
  ],
