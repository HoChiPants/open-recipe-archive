  "id": "air-fryer-breakfast-fry-up",
  "name": "Air-Fryer Breakfast Fry-Up",
  "subtitle": "A compact full breakfast cooked in one air fryer",
  "description": "A single-serving breakfast with sausage, bacon, hash browns, egg, mushrooms, tomato, and a buttered English muffin, plus optional baked beans.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
