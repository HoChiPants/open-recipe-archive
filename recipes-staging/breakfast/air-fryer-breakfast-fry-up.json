      "item": "400g can or 200g can baked beans (optional)",
      "quantity": "1/2",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to the appliance instructions."
    },
    {
      "step": 2,
      "text": "Split the English muffin and spread the softened butter over the cut sides."
    },
    {
      "step": 3,
      "text": "Toss the mushrooms with the olive oil. Arrange the mushrooms, tomato halves, sausages, hash browns, bacon, muffin, and egg in the air fryer or suitable heatproof dishes as space allows."
    },
    {
      "step": 4,
      "text": "Cook, turning or stirring items as needed, until the mushrooms are tender, the hash browns and bacon are browned, and the sausage reaches 160°F internally.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Cook the egg until the white and yolk are fully set and the center reaches 160°F."
    },
    {
      "step": 6,
      "text": "Warm the optional baked beans separately for 2 minutes, then serve with the cooked breakfast.",
      "timer_minutes": 2
    }
  ],
