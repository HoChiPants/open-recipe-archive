  "instructions": [
    {
      "step": 1,
      "text": "Heat the shortening in a large skillet over medium-high heat."
    },
    {
      "step": 2,
      "text": "Add the cubed potatoes and cook, turning occasionally, until golden brown and tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Stir together the salt, black pepper, garlic powder, and paprika. Sprinkle the mixture over the potatoes and toss to coat."
    },
    {
      "step": 4,
      "text": "Serve hot."
    }
