  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "apricot-and-seed-overnight-chia",
  "name": "Apricot and Seed Overnight Chia",
  "subtitle": "Creamy chia pudding with roasted apricots and warm blueberry compote",
  "description": "Chia seeds and mixed seeds soak in almond milk, then pair with vanilla-roasted apricots and lemony blueberries for a make-ahead breakfast.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "chia-seeds",
      "item": "chia seeds",
      "quantity": 8,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "unsweetened-almond-milk",
      "item": "unsweetened almond milk",
      "quantity": 350,
      "unit": "ml"
    },
    {
      "ingredient_id": "mixed-seeds",
      "item": "mixed seeds",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "fresh-apricots-halved-and-stoned",
      "item": "fresh apricots halved and stoned",
      "quantity": 8
    },
    {
      "ingredient_id": "vanilla-bean-paste",
      "item": "vanilla bean paste",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "blueberries",
      "item": "blueberries",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-zested-and-juiced",
      "item": "lemon zested and juiced",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "honey-to-serve-optional",
      "item": "honey to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the chia seeds, almond milk, and mixed seeds together. Transfer to four serving containers and refrigerate until thickened."
    },
    {
      "step": 2,
      "text": "Preheat the oven. Arrange the halved apricots in a baking dish and coat with the vanilla bean paste."
    },
    {
      "step": 3,
      "text": "Roast the apricots until softened.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Simmer the blueberries with the lemon zest and juice until they begin to break down.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Spoon the blueberry mixture and roasted apricots over the chia pudding. Drizzle with honey if desired."
    }
  ],
