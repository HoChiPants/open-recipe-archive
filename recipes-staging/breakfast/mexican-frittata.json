  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Coat an oven-safe skillet or baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet. Add the bell pepper, onion, and black pepper; cook for 5 minutes, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the milk, egg whites, eggs, salt, remaining black pepper, and cumin until combined. Stir in the cooked vegetables."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared skillet or baking dish and bake for 30 minutes, until the center is firm and fully set and reaches 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cut into portions and serve with the salsa."
    }
  ],
