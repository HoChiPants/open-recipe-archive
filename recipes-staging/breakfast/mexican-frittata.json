  "id": "mexican-frittata",
  "name": "Mexican Frittata",
  "subtitle": "A tender baked egg dish with peppers, onion, and salsa",
  "description": "Sautéed vegetables fold into a seasoned egg mixture, then bake until fully set and serve with salsa.",
  "meal_type": "breakfast",
