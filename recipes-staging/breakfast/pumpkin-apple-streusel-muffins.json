  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare muffin cups for 18 muffins."
    },
    {
      "step": 2,
      "text": "For the streusel, whisk together 2 tablespoons flour, 1/4 cup sugar, and cinnamon. Work in the butter until coarse crumbs form; set aside."
    },
    {
      "step": 3,
      "text": "Whisk the pumpkin, oil, and beaten eggs in a separate bowl."
    },
    {
      "step": 4,
      "text": "Combine 2 1/2 cups flour, pumpkin pie spice, baking soda, and salt. Stir the dry mixture into the pumpkin mixture just until combined, then fold in the chopped apple."
    },
    {
      "step": 5,
      "text": "Divide the batter among the muffin cups and sprinkle with the streusel."
    },
    {
      "step": 6,
      "text": "Bake for 35–40 minutes, until the tops are set and a tester inserted in the center comes out clean.",
      "timer_minutes": 35
    }
  ],
