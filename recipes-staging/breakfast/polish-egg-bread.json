  "id": "polish-egg-bread",
  "name": "Polish Egg Bread",
  "subtitle": "A rich, lightly sweet yeast bread for a crowd",
  "description": "Tender egg bread made with milk, butter, sugar, and a long rise, yielding generous portions for breakfast or brunch.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 35,
    "inactive_minutes": 150
  },
  "ingredients": [
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 5,
      "unit": "packages"
    },
    {
      "ingredient_id": "lukewarm-water",
      "item": "lukewarm water",
      "quantity": 2,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 1,
      "unit": "quart"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "cut into pieces"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "superfine-sugar",
      "item": "superfine sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 10,
      "preparation": "room temperature"
    },
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 5,
      "unit": "pounds"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Dissolve the yeast in part of the lukewarm water and let it stand until set and lightly foamy.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Warm the milk, then stir in the remaining water, butter, both quantities of salt, and sugar. Continue stirring until the butter melts, then cool the mixture to lukewarm."
    },
    {
      "step": 3,
      "text": "Stir the yeast mixture into the milk mixture. Whisk the eggs until combined, then stir them in."
    },
    {
      "step": 4,
      "text": "Gradually combine the liquid mixture with the bread flour to form a soft dough. Transfer it to a floured work surface and knead until smooth and elastic."
    },
    {
      "step": 5,
      "text": "Place the dough in a prepared bowl, cover it, and let it rise until doubled.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Divide and shape the dough into portions, then transfer them to prepared baking pans. Cover and let them rise again.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Heat the oven to 325°F."
    },
    {
      "step": 8,
      "text": "Bake until deeply golden and the center is firm, reaching at least 160°F on a food thermometer.",
      "timer_minutes": 35
    },
    {
      "step": 9,
      "text": "Cool before serving."
    }
  ],
