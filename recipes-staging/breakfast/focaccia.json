  "instructions": [
    {
      "step": 1,
      "text": "Whisk the yeast into the warm water. In a separate bowl, combine the semolina flour with the divided bread flour."
    },
    {
      "step": 2,
      "text": "Add the yeast mixture, salt, 2 teaspoons minced rosemary, and part of the divided olive oil to the flours. Stir until a shaggy dough forms."
    },
    {
      "step": 3,
      "text": "Knead for 3 minutes, then work in the 1 teaspoon olive oil. Continue kneading, adding the remaining flour as needed, until the dough is smooth, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Coat the dough with olive oil, cover, and let it rise in a warm place until doubled, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Oil a baking pan. Transfer the dough to it, turn to coat, and gently stretch it to fit. Let it rest for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Stretch the dough again if needed, cover, and let it rise for 45 minutes. Meanwhile, preheat the oven to 475°F.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Press dimples across the dough. Top with the remaining olive oil, minced rosemary, salt, and coarse sea salt."
    },
    {
      "step": 8,
      "text": "Bake until golden brown, about 15 minutes. Brush with the remaining olive oil, transfer to a rack, and cool briefly before serving.",
      "timer_minutes": 15
    }
  ],
