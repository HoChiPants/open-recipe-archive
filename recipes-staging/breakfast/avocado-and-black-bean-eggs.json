  "instructions": [
    {
      "step": 1,
      "text": "Heat the rapeseed oil in a skillet over medium heat. Add the chilli and garlic; cook briefly until fragrant."
    },
    {
      "step": 2,
      "text": "Stir in the black beans, cherry tomatoes, and cumin seeds. Simmer until hot and slightly thickened."
    },
    {
      "step": 3,
      "text": "Make two spaces in the bean mixture and crack in the eggs. Cover and cook until the whites and centers are fully set, reaching 160°F on a food thermometer."
    },
    {
      "step": 4,
      "text": "Top with the sliced avocado and chopped coriander. Serve with lime wedges."
    }
  ],
