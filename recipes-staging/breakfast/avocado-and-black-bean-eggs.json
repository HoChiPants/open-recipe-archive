  "id": "avocado-and-black-bean-eggs",
  "name": "Avocado and Black Bean Eggs",
  "subtitle": "Spiced beans, eggs, avocado, and lime",
  "description": "A quick skillet breakfast combining gently spiced tomato-black beans with eggs, fresh avocado, coriander, and lime.",
  "meal_type": "breakfast",
