  "id": "scrambled-eggs-with-tomatoes",
  "name": "Scrambled Eggs with Tomatoes",
  "subtitle": "Soft eggs with sweet-tangy tomatoes",
  "description": "A quick breakfast combining beaten eggs with lightly cooked tomatoes, sugar, salt, and a dash of soy sauce.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large",
      "preparation": "beaten"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 2,
      "preparation": "coarsely chopped"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 1,
      "unit": "dash"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat a skillet over medium heat. Add the coarsely chopped tomatoes and cook for 3 minutes, stirring occasionally.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Stir in the sugar, salt to taste, and soy sauce."
    },
    {
      "step": 3,
      "text": "Add the beaten eggs and cook for 1 minute, stirring gently, until the eggs are fully set and reach 160°F on a food thermometer.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Serve immediately."
    }
  ],
