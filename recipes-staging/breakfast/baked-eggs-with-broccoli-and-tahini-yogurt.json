      "item": "tahini",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-clove-crushed",
      "item": "garlic clove crushed",
      "quantity": "1/2",
      "unit": "small"
    },
    {
      "ingredient_id": "squeeze-of-lemon-juice",
      "item": "squeeze of lemon juice"
    },
    {
      "ingredient_id": "thick-greek-yogurt",
      "item": "thick Greek yogurt",
      "quantity": 6,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the tahini, lemon juice, crushed garlic, and sumac until smooth. Fold in the Greek yogurt."
    },
    {
      "step": 2,
      "text": "Preheat the oven. Arrange the broccoli in a baking dish and add the sumac, olive oil, and crushed garlic."
    },
    {
      "step": 3,
      "text": "Bake the broccoli for 4 minutes, then crack in the eggs and sprinkle with sumac and the optional chilli flakes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Return the dish to the oven and bake for 6 minutes, or until the egg whites and yolks are fully set and the center reaches 160°F.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Drizzle with the remaining olive oil and serve with the tahini yogurt and bread."
    }
  ],
