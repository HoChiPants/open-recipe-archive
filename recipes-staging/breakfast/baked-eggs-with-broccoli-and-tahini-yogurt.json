  "id": "baked-eggs-with-broccoli-and-tahini-yogurt",
  "name": "Baked Eggs with Broccoli and Tahini Yogurt",
  "subtitle": "Sumac-seasoned eggs with lemony tahini yogurt and bread",
  "description": "Long-stem broccoli and eggs bake together until set, then serve with a creamy tahini-yogurt sauce and bread.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "long-stem-broccoli",
      "item": "long-stem broccoli",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "olive-oil-plus-a-drizzle",
      "item": "olive oil plus a drizzle",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-clove-crushed",
      "item": "garlic clove crushed",
      "quantity": "1/2",
      "unit": "small"
    },
    {
