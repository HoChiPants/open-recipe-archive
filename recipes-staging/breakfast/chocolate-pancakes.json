  "instructions": [
    {
      "step": 1,
      "text": "Whisk the self-raising flour, cocoa powder, baking powder, caster sugar, and icing sugar in a bowl."
    },
    {
      "step": 2,
      "text": "In a separate bowl, whisk the eggs until smooth. Gradually whisk in the whole milk, then stir in the dark chocolate chips."
    },
    {
      "step": 3,
      "text": "Combine the wet and dry mixtures to make a smooth batter."
    },
    {
      "step": 4,
      "text": "Heat a frying pan over medium heat with some of the vegetable oil and unsalted butter."
    },
    {
      "step": 5,
      "text": "Add portions of batter to the pan, shaping each into a pancake.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Cook until bubbles form and the underside is set, then turn and cook the other side until set.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Repeat with the remaining batter, adding more oil and butter as needed."
    },
    {
      "step": 8,
      "text": "Whisk the double cream, icing sugar, and vanilla paste until thick."
    },
    {
      "step": 9,
      "text": "Serve the pancakes with the vanilla cream and optional mixed berries and maple syrup."
    }
  ],
