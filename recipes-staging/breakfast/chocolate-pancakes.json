  "id": "chocolate-pancakes",
  "name": "Chocolate Pancakes",
  "subtitle": "Rich cocoa pancakes with a creamy berry topping",
  "description": "Tender cocoa pancakes studded with dark chocolate chips, served with vanilla cream and optional berries and maple syrup.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 16,
    "unit": "pancakes (serves 4-6)"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
