  "id": "apple-cranberry-punch",
  "name": "Apple Cranberry Punch",
  "subtitle": "A chilled, sparkling fruit punch for a crowd",
  "description": "Combine apple, cranberry, and orange juices, then finish with ginger ale and fresh apple slices for a simple brunch beverage.",
  "meal_type": "breakfast",
