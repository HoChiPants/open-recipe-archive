  "id": "zucchini-and-summer-squash-pie",
  "name": "Zucchini and Summer Squash Pie",
  "subtitle": "A savory vegetable pie with Parmesan",
  "description": "Sliced zucchini, yellow squash, onion, and tomato bake with an egg-based batter for a simple savory pie.",
  "meal_type": "breakfast",
  "cuisine": "American",
