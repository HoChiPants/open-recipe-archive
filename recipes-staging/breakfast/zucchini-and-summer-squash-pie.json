  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, vegetable oil, and salt and pepper until combined."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the baking powder and all-purpose baking mix, then stir into the egg mixture."
    },
    {
      "step": 4,
      "text": "Fold in the zucchini, yellow squash, and onion. Add the tomato, then sprinkle in the Parmesan and adjust the seasoning."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to the prepared dish and bake for 35 minutes, until golden brown and the center is fully set at 160°F.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Serve warm."
    }
  ],
