{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "asparagus-and-mushroom-frittata",
  "name": "Asparagus and Mushroom Frittata",
  "subtitle": "A tender baked egg dish with spring vegetables and two cheeses.",
  "description": "Sautéed asparagus and mushrooms are folded into thyme-seasoned eggs, baked until set, and finished with a lightly browned cheese topping.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "fresh-asparagus",
      "item": "fresh asparagus",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "trimmed and cut into 1 inch pieces"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fresh-mushrooms",
      "item": "fresh mushrooms",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "fresh-thyme",
      "item": "fresh thyme",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "freshly-grated-parmesan-cheese",
      "item": "freshly grated Parmesan cheese",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Melt the butter in an ovenproof skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the asparagus and olive oil. Cook, stirring occasionally, until tender, about 10 minutes. Add the mushrooms and cook for 5 minutes more.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Whisk the eggs, water, and thyme together, then pour the mixture over the vegetables. Cook until the edges begin to set, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Transfer the skillet to the oven and bake for 15 minutes, until the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Sprinkle the mozzarella and Parmesan over the frittata. Broil until the cheese is lightly browned, then serve."
    }
  ],
