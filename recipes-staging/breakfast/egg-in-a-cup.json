  "id": "egg-in-a-cup",
  "name": "Egg in a Cup",
  "subtitle": "A quick egg breakfast with buttery crackers",
  "description": "Soft-cooked eggs are served over buttered saltine crackers and seasoned simply with salt and pepper.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 1,
    "cook_minutes": 3
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "saltine-crackers",
      "item": "saltine crackers",
      "quantity": 15
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "softened"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a small pot of water to a simmer."
    },
    {
      "step": 2,
      "text": "Add the eggs and cook for 3 minutes, or until the whites are set and the centers reach 160°F for a fully cooked egg.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "While the eggs cook, prepare two cups with the saltine crackers and softened butter."
    },
    {
      "step": 4,
      "text": "Transfer the eggs to the cups, combine with the crackers and butter, and season with salt and pepper."
    }
  ],
