    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs, pumpkin puree, cinnamon, and nutmeg in a shallow dish until combined."
    },
    {
      "step": 2,
      "text": "Preheat a skillet over medium heat and melt the butter."
    },
    {
      "step": 3,
      "text": "Dip the bread slices in the egg mixture, turning to coat both sides without soaking them excessively."
    },
    {
      "step": 4,
      "text": "Cook the coated bread in the skillet for about 3 minutes per side, turning once, until golden and the center is firm and reaches 160°F.",
      "timer_minutes": 3
    }
  ],
