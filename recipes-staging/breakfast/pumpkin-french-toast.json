  "id": "pumpkin-french-toast",
  "name": "Pumpkin French Toast",
  "subtitle": "Warmly spiced toast for an easy breakfast",
  "description": "Whole wheat bread is dipped in a pumpkin-and-spice egg mixture, then cooked in butter until golden and fully set.",
  "meal_type": "breakfast",
  "cuisine": "French",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
