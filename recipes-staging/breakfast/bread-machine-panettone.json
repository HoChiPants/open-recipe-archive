  "instructions": [
    {
      "step": 1,
      "text": "Add the warm water, butter, eggs, and vanilla extract to the bread-machine pan."
    },
    {
      "step": 2,
      "text": "Add the bread flour, white sugar, dry milk powder, salt, and bread machine yeast. Select a sweet-bread or comparable 3-hour cycle."
    },
    {
      "step": 3,
      "text": "Add the chopped dried mixed fruit when the machine signals the add-in stage, or about 10 minutes after kneading begins.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Let the cycle finish, then cool the panettone before slicing."
    }
