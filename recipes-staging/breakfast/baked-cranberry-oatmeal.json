  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the milk, brown sugar, cinnamon, nutmeg, and cloves in a saucepan. Heat gently, stirring, until the sugar dissolves and the mixture is fragrant."
    },
    {
      "step": 3,
      "text": "Mix the rolled oats, chopped apples, dried cranberries, and walnuts in a baking dish."
    },
    {
      "step": 4,
      "text": "Pour the warm milk mixture over the oat mixture and stir to distribute it evenly."
    },
    {
      "step": 5,
      "text": "Bake for 35 minutes, until lightly browned.",
      "timer_minutes": 35
    }
