  "instructions": [
    {
      "step": 1,
      "text": "Put the chopped tomatoes, chilli, ginger, star anise, sugar, and vinegar in a saucepan. Bring to a simmer and cook for 30 minutes, stirring occasionally, until thick. Transfer to a bowl and remove the star anise.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Mash the avocado with the lime juice. Toss the sliced red onion with the lime mixture and leave while you cook the filling."
    },
    {
      "step": 3,
      "text": "Heat a skillet with the oil for 4 minutes. Add the chorizo and halloumi and cook for 5 minutes, turning as needed. Continue sautéing for 10 minutes until the chorizo is cooked through and the halloumi is browned.",
      "timer_minutes": 19
    },
    {
      "step": 4,
      "text": "Split the baguette and warm or toast it for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Spread the avocado over the baguette. Add the onion, chorizo, halloumi, tomato jam, and coriander, then cut into portions and serve."
    }
  ],
