  "instructions": [
    {
      "step": 1,
      "text": "Mix the tomatoes, lime juice, coriander, onion, jalapeños, pepper, and avocado in a bowl. Set aside."
    },
    {
      "step": 2,
      "text": "Whisk the eggs with the cumin and chipotle paste."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a skillet. Cook the chorizo until browned, then add the pepper and cook until tender and lightly golden.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Lower the heat, add the eggs, and stir gently until fully set and at least 160°F in the center. Remove from the heat."
    },
    {
      "step": 5,
      "text": "Warm the tortillas briefly, then divide the egg mixture, cheese, and avocado mixture among them. Fold in the sides and roll tightly.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Serve with hot sauce and soured cream, if using."
    }
  ],
