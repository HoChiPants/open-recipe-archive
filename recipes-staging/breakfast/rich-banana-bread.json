  "id": "rich-banana-bread",
  "name": "Rich Banana Bread",
  "subtitle": "Moist banana loaf with sour cream and walnuts",
  "description": "A tender banana bread combining melted butter, sour cream, sliced bananas, and chopped walnuts in a lightly sweet loaf.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
