  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a loaf pan."
    },
    {
      "step": 2,
      "text": "Stir the white sugar and melted butter until smooth. Add the eggs and vanilla extract, then mix well."
    },
    {
      "step": 3,
      "text": "Combine the all-purpose flour, baking soda, and salt in a separate bowl."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the butter mixture and stir until just combined. Fold in the sour cream, walnuts, and sliced bananas."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 60 minutes, until the center is firm and fully set.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool the loaf in the pan for 10 minutes, then serve.",
      "timer_minutes": 10
    }
  ],
