  "id": "breakfast-fried-rice",
  "name": "Breakfast Fried Rice",
  "subtitle": "Crisp bacon, vegetables, and egg folded through savory rice",
  "description": "Cooked rice is tossed with bacon, set egg, peas, onion, green onions, and soy sauce for a hearty breakfast skillet.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "uncooked-white-rice",
      "item": "uncooked white rice",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 6
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "onion",
      "item": "yellow onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "frozen-peas",
      "item": "frozen peas",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 4,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 1.5,
      "unit": "tablespoons",
      "preparation": "divided"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, rice, and part of the soy sauce in a saucepan. Bring to a simmer, cover, and cook until the rice is tender, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Meanwhile, cook the bacon in a large skillet until crisp, about 10 minutes. Transfer it to a plate and reserve.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Pour the beaten eggs into the skillet and cook until set and fully cooked, about 3 minutes. For food safety, the eggs should reach 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Stir in the chopped onion, peas, green onions, and the remaining soy sauce. Cook until the onion is tender, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the cooked rice and bacon. Stir-fry until evenly combined and heated through, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
