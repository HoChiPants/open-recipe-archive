{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "buttermilk-cinnamon-rolls",
  "name": "Buttermilk Cinnamon Rolls",
  "subtitle": "Soft rolls with a cinnamon-sugar center",
  "description": "Yeasted buttermilk rolls filled with buttery cinnamon and brown sugar, then baked until golden.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 2,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1.5,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Dissolve the yeast in the warm water and let it stand until foamy.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Warm the buttermilk and vegetable oil gently, then combine them with the yeast mixture and melted butter."
    },
    {
      "step": 3,
      "text": "Mix the flour, salt, and baking soda. Stir the dry mixture into the wet ingredients until a dough forms."
    },
    {
      "step": 4,
      "text": "Knead the dough until smooth, then let it rest.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Combine the butter, brown sugar, and cinnamon to make the filling."
    },
    {
      "step": 6,
      "text": "Roll the dough into a rectangle and spread the filling evenly over it."
    },
    {
      "step": 7,
      "text": "Roll the dough into a log, cut it into 15 pieces, and arrange the pieces in a baking dish."
    },
    {
      "step": 8,
      "text": "Chill the shaped rolls.",
      "timer_minutes": 30
    },
    {
      "step": 9,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 10,
      "text": "Bake the rolls until golden brown.",
      "timer_minutes": 25
    },
    {
      "step": 11,
      "text": "Let the rolls cool briefly before serving.",
      "timer_minutes": 3
    }
  ],
