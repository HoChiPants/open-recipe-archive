{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-crumpets",
  "name": "Chocolate Crumpets",
  "subtitle": "Yeasted cocoa crumpets for breakfast or tea",
  "description": "Tender chocolate crumpets cooked in rings until set, then finished under the grill.",
  "meal_type": "breakfast",
  "cuisine": "British",
  "yield": {
    "quantity": 8,
    "unit": "crumpets"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "fast-action-dried-yeast",
      "item": "fast-action dried yeast",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vegetable-oil-plus-extra-for-the-pan",
      "item": "vegetable oil plus extra for the pan",
      "quantity": 2,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk until hot but not boiling. Mix the flour and cocoa powder in a bowl."
    },
    {
      "step": 2,
      "text": "Stir the warm milk, yeast, sugar, and oil into the dry ingredients until smooth."
    },
    {
      "step": 3,
      "text": "Cover the bowl and leave the batter to stand for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Stir the risen batter until thick and even. Heat a lightly oiled heavy frying pan with crumpet rings in place."
    },
    {
      "step": 5,
      "text": "Pour the batter into the rings and cook until the tops are set, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Heat the grill. Transfer the crumpets from the pan, sprinkle with the remaining golden caster sugar, and grill until golden brown."
    }
  ],
