  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking dish for the casserole."
    },
    {
      "step": 2,
      "text": "Combine the whisked eggs, cheese, bacon, bread, bell pepper, green onions, milk, garlic, salt, and pepper."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to the prepared baking dish."
    },
    {
      "step": 4,
      "text": "Bake for 25 minutes, until the center is firm and fully set; verify that the egg mixture reaches 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Let the casserole rest briefly, then serve."
