  "id": "olie-bollen",
  "name": "Olie Bollen",
  "subtitle": "Dutch fried dough with apple and raisins",
  "description": "A lightly sweet yeast batter folded with apple and raisins, fried until golden, and finished with sugar.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
