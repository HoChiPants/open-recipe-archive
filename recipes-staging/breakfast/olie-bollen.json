  "instructions": [
    {
      "step": 1,
      "text": "Dissolve the yeast in the lukewarm water and let it stand until foamy. Mix the flour, white sugar, and salt in a large bowl."
    },
    {
      "step": 2,
      "text": "Stir in the yeast mixture, beaten eggs, and milk until a thick batter forms. Fold in the apple and raisins."
    },
    {
      "step": 3,
      "text": "Cover the bowl and let the batter rise in a warm place for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Heat the vegetable oil to 350°F in a deep, heavy pot. Working in batches, drop rounded portions of batter into the oil and fry for about 2 minutes, turning as needed, until golden brown and cooked through; the center should be firm and reach 160°F.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Drain on paper towels, then dust with white sugar for decoration and serve warm."
    }
  ],
