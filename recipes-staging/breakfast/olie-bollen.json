      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 2,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "lukewarm-water-110-degrees-f-to-115-degrees-f",
      "item": "lukewarm water (110 degrees F to 115 degrees F)",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
