  "id": "swedish-tea-ring",
  "name": "Swedish Tea Ring",
  "subtitle": "A cinnamon-raisin yeast bread finished with almond glaze.",
  "description": "Form a lightly sweetened yeast dough into a ring with a cinnamon, brown sugar, and raisin filling, then bake and drizzle with a simple almond glaze.",
  "meal_type": "breakfast",
