  "instructions": [
    {
      "step": 1,
      "text": "Warm the 1 cup milk until steaming but not boiling. Remove from the heat and stir in the room-temperature butter, white sugar, and salt. Cool until lukewarm."
    },
    {
      "step": 2,
      "text": "Stir in the yeast, beaten egg, and enough bread flour to form a soft dough. Knead until smooth and elastic, then place in a lightly greased bowl."
    },
    {
      "step": 3,
      "text": "Cover and let the dough rise in a warm place until doubled, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Roll the dough into a large rectangle. Spread with the softened butter, then sprinkle evenly with the cinnamon, brown sugar, and raisins."
    },
    {
      "step": 5,
      "text": "Roll the rectangle into a log from a long side. Join the ends to form a ring and place it on a baking sheet."
    },
    {
      "step": 6,
      "text": "Make evenly spaced cuts around the ring, slicing nearly through the log, and turn the cut sections slightly outward. Cover and let rise until puffy, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 8,
      "text": "Bake for 20 minutes, until golden and the center is fully set.",
      "timer_minutes": 20
    },
    {
      "step": 9,
      "text": "Whisk the sifted confectioners' sugar with the almond extract and enough milk to make a pourable glaze. Drizzle over the warm ring."
    }
  ],
