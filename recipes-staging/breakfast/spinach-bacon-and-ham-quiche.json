  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Cook the bacon until crisp, then drain and crumble or chop it."
    },
    {
      "step": 2,
      "text": "Cook the thawed spinach, drain it well, and let it cool."
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a skillet. Add the onion and mushrooms; cook for 2 minutes, then stir in the ham and bacon.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Combine the cooled spinach with the sour cream and half-and-half. Season with salt and pepper."
    },
    {
      "step": 5,
      "text": "Arrange the spinach mixture in the two pie crusts. Combine the Monterey Jack, Cheddar, and Parmesan, and sprinkle the cheese mixture over the fillings."
    },
    {
      "step": 6,
      "text": "Whisk the eggs with the remaining half-and-half and dried parsley; season with salt and pepper. Pour the custard evenly into the crusts."
    },
    {
      "step": 7,
      "text": "Bake for 40 minutes, until golden brown and the centers are firm and reach 160°F.",
      "timer_minutes": 40
    },
    {
      "step": 8,
      "text": "Let the quiches rest for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
