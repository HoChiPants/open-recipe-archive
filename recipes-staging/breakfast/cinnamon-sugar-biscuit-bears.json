  "id": "cinnamon-sugar-biscuit-bears",
  "name": "Cinnamon-Sugar Biscuit Bears",
  "subtitle": "Shaped biscuits with buttery cinnamon-sugar coating",
  "description": "Biscuit dough is shaped, baked until set, and finished with melted butter and cinnamon sugar.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "refrigerated-biscuit-dough",
      "item": "refrigerated biscuit dough",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare the oven and baking pan according to the biscuit dough package directions."
    },
    {
      "step": 2,
      "text": "Stir the white sugar and ground cinnamon together in a shallow bowl."
    },
    {
      "step": 3,
      "text": "Separate the biscuit dough and shape the pieces into bear forms."
    },
    {
      "step": 4,
      "text": "Arrange the shaped dough on the prepared pan."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, or until the biscuits are set and cooked through.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Brush or dip the warm biscuits with melted butter, then coat them with the cinnamon-sugar mixture."
    }
  ],
