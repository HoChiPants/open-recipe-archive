  "id": "halloumi-and-zucchini-frittata",
  "name": "Halloumi and Zucchini Frittata",
  "subtitle": "Herbed eggs with browned halloumi",
  "description": "A compact Greek-style frittata combining tender zucchini, fresh herbs, and sliced halloumi.",
  "meal_type": "breakfast",
  "cuisine": "Greek",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 1,
      "unit": "large",
      "preparation": "grated and squeezed dry"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "fresh-mint",
      "item": "fresh mint",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "fresh-dill",
      "item": "fresh dill",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "halloumi-cheese",
      "item": "halloumi cheese",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in an oven-safe skillet over medium heat. Add the zucchini, season with salt and pepper, and cook until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the mint and dill. Whisk the eggs with salt and pepper, then pour them into the skillet and stir gently to distribute the zucchini.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Cook until the bottom begins to set, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Preheat the broiler. Arrange the sliced halloumi over the eggs, then broil until the cheese is browned and the frittata is fully set in the center, about 5 minutes. Confirm the center reaches 160°F with a food thermometer.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
  ],
