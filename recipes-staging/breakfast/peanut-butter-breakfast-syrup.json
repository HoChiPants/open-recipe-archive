  "id": "peanut-butter-breakfast-syrup",
  "name": "Peanut Butter Breakfast Syrup",
  "subtitle": "A warm, creamy topping for pancakes and waffles",
  "description": "A quick stovetop syrup combining peanut butter, milk, sugar, and vanilla.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
