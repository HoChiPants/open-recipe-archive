      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the milk, sugar, and peanut butter in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Cook, stirring frequently, until the mixture reaches a gentle simmer and the sugar dissolves."
    },
    {
      "step": 3,
      "text": "Remove from the heat, stir in the vanilla extract, and serve warm.",
      "timer_minutes": 3
    }
