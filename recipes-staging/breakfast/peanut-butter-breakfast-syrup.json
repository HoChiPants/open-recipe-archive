  "ingredients": [
    {
      "ingredient_id": "skim-milk",
      "item": "skim milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "natural-peanut-butter",
