  "id": "egg-in-the-hole-toast",
  "name": "Egg-in-the-Hole Toast",
  "subtitle": "Buttery toast with a set egg center",
  "description": "Bread is cut to hold an egg, browned in butter, and finished until the egg is fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
