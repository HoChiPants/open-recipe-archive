      "item": "egg",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut a hole from the center of the bread. Brush or coat the bread with the melted butter."
    },
    {
      "step": 2,
      "text": "Preheat a skillet over medium heat, then cook the bread and cut-out piece until golden brown, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Turn the bread, crack the egg into the opening, and season with salt."
    },
    {
      "step": 4,
      "text": "Cook until the egg begins to set, about 1 minute, then transfer to a preheated oven and continue cooking until the center is firm and reaches 160°F.",
      "timer_minutes": 4
    }
  ],
