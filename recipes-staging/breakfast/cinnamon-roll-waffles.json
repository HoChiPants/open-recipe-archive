  "instructions": [
    {
      "step": 1,
      "text": "Preheat the waffle iron according to its instructions."
    },
    {
      "step": 2,
      "text": "Whisk the flour, white sugar, baking powder, and salt in a bowl. In a separate bowl, whisk the warm milk, melted butter, beaten eggs, and vanilla extract."
    },
    {
      "step": 3,
      "text": "Stir the wet mixture into the dry mixture just until combined. In another bowl, combine the brown sugar, melted butter, and cinnamon for the swirl."
    },
    {
      "step": 4,
      "text": "Whisk the confectioners' sugar, softened cream cheese, softened butter, vanilla extract, and salt until smooth."
    },
    {
      "step": 5,
      "text": "Add batter to the preheated iron, spoon the cinnamon mixture over it, and cook for about 5 minutes, until golden and the center is fully set. For a temperature check, the batter should reach 160°F.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Serve the waffles warm with the cream cheese icing."
    }
  ],
