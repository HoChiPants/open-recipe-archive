  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium heat. Add the onion and cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the tomatoes and mushrooms; cook for 3 minutes, then continue until the mushrooms are tender, about 3 minutes more.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Stir in the spinach and cook until just wilted, about 1 minute. Spread the vegetables in the prepared dish.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Whisk the heavy cream, eggs, salt, pepper, and nutmeg together. Mix in the vegetables and half of the Gouda, then scatter the remaining cheese over the top."
    },
    {
      "step": 6,
      "text": "Bake for about 25 minutes, until the center is firm and reaches 160°F on a food thermometer. Rest briefly before serving.",
      "timer_minutes": 25
    }
  ],
