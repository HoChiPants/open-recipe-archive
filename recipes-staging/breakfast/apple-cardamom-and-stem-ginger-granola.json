  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a baking tray. Chop the nuts and dried apple as specified; prepare the cardamom and seeds."
    },
    {
      "step": 2,
      "text": "Stir together the oil, maple syrup, honey, chopped stem ginger with its syrup, and vanilla."
    },
    {
      "step": 3,
      "text": "Combine the oats, nuts, seeds, cardamom, cinnamon, and chopped apple with the syrup mixture until evenly coated."
    },
    {
      "step": 4,
      "text": "Spread the mixture over the prepared tray and bake for 30 minutes, stirring after 10 minutes and again as needed for even browning.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Let the granola cool completely, then stir in the raisins or dried cranberries and store in a sealed jar."
    }
  ],
