{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "italian-easter-bread",
  "name": "Italian Easter Bread",
  "subtitle": "A lightly sweet, anise-scented braided bread for spring celebrations.",
  "description": "Enriched yeast dough is shaped into braided loaves, decorated with colorful dragees, and baked until golden with a fully set center.",
  "meal_type": "breakfast",
  "cuisine": "Italian",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20,
    "inactive_minutes": 85
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "rapid-rise-yeast",
      "item": "rapid rise yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "anise-extract",
      "item": "anise extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter-at-room-temperature",
      "item": "butter at room temperature",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "colored-candy-decorating-dragees",
      "item": "colored candy decorating dragees",
      "quantity": 0.5,
      "unit": "tablespoon",
      "preparation": "or as desired"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine 2 cups of the flour with the sugar, salt, and yeast. Warm the milk with the anise extract to 110°F."
    },
    {
      "step": 2,
      "text": "Stir the warm milk mixture into the dry ingredients. Add the butter and 2 eggs, then mix in enough of the remaining flour to form a soft dough."
    },
    {
      "step": 3,
      "text": "Knead the dough on a lightly floured surface until smooth, about 8 minutes. Let it rest for 10 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Divide the dough into three portions. Roll each into a thick rope, braid the ropes, and shape the braid into a ring or loaf as desired."
    },
    {
      "step": 5,
      "text": "Place the shaped dough on a prepared baking sheet, cover, and let it rise until puffy, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Brush the dough with the beaten egg and add the colored candy decorating dragees."
    },
    {
      "step": 7,
      "text": "Heat the oven to 350°F. Bake until golden and the center is fully set and reaches at least 160°F, about 20–25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 8,
      "text": "Transfer the bread to a rack and cool before serving."
    }
  ],
