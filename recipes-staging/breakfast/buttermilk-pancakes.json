    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 1.125,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a griddle or skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Combine the flour, salt, and baking soda in a bowl."
    },
    {
      "step": 3,
      "text": "Add the egg, buttermilk, and melted butter. Stir just until combined; the batter should remain thick."
    },
    {
      "step": 4,
      "text": "Cook portions of batter on the preheated surface until lightly browned, then turn and cook the other side until lightly browned and the centers are firm and fully set, reaching 160°F when checked with a food thermometer.",
      "timer_minutes": 2
    }
  ],
