  "id": "buttermilk-pancakes",
  "name": "Buttermilk Pancakes",
  "subtitle": "Tender pancakes with a lightly browned finish",
  "description": "A simple buttermilk batter cooked on a preheated griddle until puffed, browned, and fully set.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
