  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, white sugar, 2 teaspoons cinnamon, vanilla, cloves, nutmeg, and brown sugar. Whisk in the pumpkin puree until smooth."
    },
    {
      "step": 3,
      "text": "Arrange the bread cubes in the dish and coat them evenly with the pumpkin mixture."
    },
    {
      "step": 4,
      "text": "Stir together the remaining brown sugar, ¼ teaspoon cinnamon, flour, and softened butter. Sprinkle the mixture over the bread."
    },
    {
      "step": 5,
      "text": "Bake for about 30 minutes, until golden brown and the center is firm and reaches 160°F.",
      "timer_minutes": 30
    }
  ],
