  "id": "pumpkin-french-toast-bake",
  "name": "Pumpkin French Toast Bake",
  "subtitle": "A warmly spiced baked breakfast casserole",
  "description": "Thick bread cubes are coated in pumpkin-spiced custard and finished with a buttery brown-sugar topping.",
  "meal_type": "breakfast",
  "cuisine": "American",
