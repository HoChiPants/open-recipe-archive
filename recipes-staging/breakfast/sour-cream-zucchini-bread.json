  "id": "sour-cream-zucchini-bread",
  "name": "Sour Cream Zucchini Bread",
  "subtitle": "Moist, tender loaves with shredded zucchini and walnuts",
  "description": "A simple American quick bread combining sour cream, zucchini, and chopped walnuts in a lightly sweet batter.",
  "meal_type": "breakfast",
