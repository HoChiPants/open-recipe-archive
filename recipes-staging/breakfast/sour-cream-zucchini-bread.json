  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare the baking pan or pans."
    },
    {
      "step": 2,
      "text": "Whisk the sugar and vegetable oil together. Whisk in the eggs, then stir in the vanilla extract and sour cream until combined."
    },
    {
      "step": 3,
      "text": "In a separate bowl, prepare the flour, baking soda, salt, and baking powder mixture."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the wet mixture and stir just until combined. Fold in the zucchini and walnuts."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan or pans."
    },
    {
      "step": 6,
      "text": "Bake for 60 minutes, until the center is fully set. A thermometer inserted in the center should read at least 160°F.",
      "timer_minutes": 60
    }
  ],
