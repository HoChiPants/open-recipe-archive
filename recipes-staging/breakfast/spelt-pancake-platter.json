  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, egg yolks, and milk until smooth. Whisk the egg whites separately to soft peaks, then fold them into the batter."
    },
    {
      "step": 2,
      "text": "Preheat a lightly oiled frying pan over medium heat. Cook the pancakes in batches for about 3 minutes per side, until set throughout; egg-based pancakes should reach 160°F or have a firm, fully set center.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Arrange the pancakes on a platter with the cooked flaked salmon, soft cheese, cucumber, lemon wedges, and sliced red onion."
    },
    {
      "step": 4,
      "text": "Add the yogurt, banana, and berries. Finish with the capers, dill, and spring onions, plus the optional walnuts, mixed seeds, cinnamon, and maple syrup."
    },
    {
      "step": 5,
      "text": "Serve immediately."
    }
  ],
