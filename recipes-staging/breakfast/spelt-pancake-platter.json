  "id": "spelt-pancake-platter",
  "name": "Spelt Pancake Platter",
  "subtitle": "Soft pancakes with savory salmon and fresh fruit toppings",
  "description": "A shared breakfast platter pairing tender spelt pancakes with salmon, creamy cheese, cucumber, citrus, yogurt, fruit, and optional garnishes.",
