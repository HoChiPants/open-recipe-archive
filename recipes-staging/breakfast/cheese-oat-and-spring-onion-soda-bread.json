  "id": "cheese-oat-and-spring-onion-soda-bread",
  "name": "Cheese, Oat and Spring Onion Soda Bread",
  "subtitle": "A savory quick bread with cheddar and fresh spring onions",
  "description": "This tender soda bread combines rolled oats, sharp cheddar, and spring onions for a flavorful loaf that needs no yeast.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 65
  },
  "ingredients": [
    {
      "ingredient_id": "rolled-oats-plus-extra-for-the-topping",
      "item": "rolled oats plus extra for the topping",
      "quantity": 120,
      "unit": "g"
    },
    {
      "ingredient_id": "plain-flour-plus-extra-for-dusting",
      "item": "plain flour plus extra for dusting",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "bicarbonate-of-soda",
      "item": "bicarbonate of soda",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "mature-cheddar-grated",
      "item": "mature cheddar grated",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "spring-onions-chopped",
      "item": "spring onions chopped",
      "quantity": 4
    },
    {
      "ingredient_id": "buttermilk-plus-a-little-extra-optional",
      "item": "buttermilk plus a little extra (optional)",
      "quantity": 350,
      "unit": "ml",
      "optional": true
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": "1/2",
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F and lightly dust a baking surface with flour."
    },
    {
      "step": 2,
      "text": "Mix the oats, flour, and bicarbonate of soda in a large bowl. Stir in the grated cheddar and chopped spring onions."
    },
    {
      "step": 3,
      "text": "Combine the buttermilk and Dijon mustard, then add the mixture to the dry ingredients. Stir until a shaggy dough forms, adding the optional extra buttermilk only if needed."
    },
    {
      "step": 4,
      "text": "Turn the dough onto a lightly floured surface and knead briefly until it holds together. Shape it into a thick round and transfer it to the prepared surface."
    },
    {
      "step": 5,
      "text": "Cut a shallow cross into the top and scatter over the extra oats."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, or until firm and browned.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Cool before slicing and serving."
    }
  ],
