      "ingredient_id": "ripe-avocado",
      "item": "ripe avocado",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "chilli-flakes-optional",
      "item": "chilli flakes",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "juice-of-1-2-lemon",
      "item": "juice of 1/2 lemon"
    },
    {
