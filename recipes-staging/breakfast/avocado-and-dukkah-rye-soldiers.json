  "id": "avocado-and-dukkah-rye-soldiers",
  "name": "Avocado and Dukkah Rye Soldiers",
  "subtitle": "Creamy avocado toast with a seasoned egg for dipping",
  "description": "A quick vegetarian breakfast of lemony avocado, cream cheese rye toast, dukkah, and a cooked egg.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
