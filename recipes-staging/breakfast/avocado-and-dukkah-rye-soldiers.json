      "ingredient_id": "dukkhah",
      "item": "dukkhah",
      "quantity": "1/2",
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mash the avocado with the chilli flakes and lemon juice until smooth."
    },
    {
      "step": 2,
      "text": "Cook the egg in simmering water for about 5 minutes, or until the white is set and the center reaches 160°F; drain and cool briefly.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Toast the rye bread, spread it with cream cheese, and cut it into soldiers."
    },
    {
      "step": 4,
      "text": "Top the avocado with dukkah and serve with the egg and rye soldiers."
    }
  ],
