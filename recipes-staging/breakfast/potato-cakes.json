  "id": "potato-cakes",
  "name": "Potato Cakes",
  "subtitle": "Crisp-edged cakes with melted Cheddar",
  "description": "Seasoned mashed potatoes are shaped into cakes, cooked in butter, and finished with shredded Cheddar.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "mashed-potatoes",
      "item": "mashed potatoes",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the mashed potatoes, beaten egg, flour, salt, and garlic salt until evenly combined. Shape the mixture into two cakes."
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium heat. Add the cakes and cook for 10 minutes, turning once, until browned and the centers are firm and fully set.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Top with the shredded Cheddar, cover briefly if needed, and cook until the cheese melts and the cakes reach a fully set center.",
      "timer_minutes": 10
    }
  ],
