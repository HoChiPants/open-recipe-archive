  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F and prepare a 12-cup muffin pan with liners or a light coating of oil."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, milk, vegetable oil, brown sugar, white sugar, vanilla, and mashed bananas in a large bowl until blended."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the oats, whole wheat flour, all-purpose flour, baking powder, baking soda, salt, cinnamon, nutmeg, and walnuts."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the banana mixture and stir just until no dry streaks remain; divide the batter among the muffin cups."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, until the tops are set and a tester comes out clean. Cool briefly before serving.",
      "timer_minutes": 20
    }
  ],
