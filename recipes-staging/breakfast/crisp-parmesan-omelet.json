  "id": "crisp-parmesan-omelet",
  "name": "Crisp Parmesan Omelet",
  "subtitle": "A tender omelet with a golden cheese crust",
  "description": "Eggs are folded around a crisp layer of savory grated cheese for a quick single-serving breakfast.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "freshly-grated-parmigiano-reggiano-cheese",
      "item": "freshly grated Parmigiano-Reggiano cheese",
      "quantity": 1,
      "unit": "ounce",
      "preparation": "or a little less"
    },
    {
      "ingredient_id": "kosher-salt-and-freshly-ground-black-pepper-to-taste",
      "item": "kosher salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Beat the eggs with the water until blended. Stir in the salt, black pepper, and cayenne."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a nonstick ovenproof skillet over medium heat. Sprinkle about half of the cheese evenly across the pan and cook until it begins to melt and turn golden."
    },
    {
      "step": 3,
      "text": "Pour the egg mixture over the cheese, then scatter the remaining cheese over the top. Cook until the underside is golden brown and the center is set to 160°F.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Fold the omelet in half and transfer it to a plate.",
      "timer_minutes": 1
    }
  ],
