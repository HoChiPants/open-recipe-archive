{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "basic-cre-pes",
  "name": "Basic Crêpes",
  "subtitle": "Thin French-style pancakes for sweet or savory fillings",
  "description": "A simple batter of eggs, milk, water, flour, salt, and melted butter cooks into tender, lightly browned crêpes.",
  "meal_type": "breakfast",
  "cuisine": "French",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs, milk, water, and salt until combined. Add the flour and melted butter, then whisk until smooth."
    },
    {
      "step": 2,
      "text": "Preheat a nonstick skillet over medium heat."
    },
    {
      "step": 3,
      "text": "Pour a thin layer of batter into the skillet and cook until the underside is set and lightly browned, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Flip the crêpe and cook until set, about 1 minute. Repeat with the remaining batter and serve.",
      "timer_minutes": 1
    }
  ],
