  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in an oven-safe skillet over medium heat. Add the bell pepper, onion, and half of the black pepper; cook for 5 minutes, stirring, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk the eggs and milk in a bowl until smooth. Stir in the spinach, ham, mozzarella, feta, salt, remaining black pepper, and sautéed vegetables."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to the skillet and bake until the center is firm and fully set, about 10 minutes. Confirm the center reaches 160°F with a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Cut into wedges and serve."
    }
  ],
