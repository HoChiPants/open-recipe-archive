  "id": "spinach-frittata",
  "name": "Spinach Frittata",
  "subtitle": "A savory baked egg dish with spinach, ham, peppers, and cheese.",
  "description": "Sautéed vegetables are folded with spinach, ham, and cheeses in a seasoned egg mixture, then baked until fully set.",
