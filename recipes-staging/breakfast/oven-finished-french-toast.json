  "id": "oven-finished-french-toast",
  "name": "Oven-Finished French Toast",
  "subtitle": "Custardy slices with a crisp, buttery finish",
  "description": "Dip thick French bread in spiced custard, brown it in butter, then finish it in the oven until set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-allspice",
      "item": "ground allspice",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "1-inch-thick-slices-french-bread",
      "item": "(1 inch thick) slices French bread",
      "quantity": 6
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, milk, vanilla, cinnamon, allspice, and salt in a shallow dish."
    },
    {
      "step": 3,
      "text": "Melt the butter in an oven-safe skillet over medium heat. Coat each bread slice in the egg mixture, turning to moisten both sides."
    },
    {
      "step": 4,
      "text": "Cook the coated slices in the skillet for 3 minutes, turning as needed to brown them.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Transfer the skillet to the oven and bake for 15 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 15
    }
  ],
