      "item": "apple cored and very thinly sliced",
      "quantity": 1
    },
    {
      "ingredient_id": "berries-and-maple-syrup",
      "item": "berries and maple syrup",
      "preparation": "or ice cream, to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to its pancake or baking setting. Lightly oil a small heatproof tin."
    },
    {
      "step": 2,
      "text": "Combine the self-raising flour, baking powder, and caster sugar. Whisk the egg and milk together, then add them to the dry ingredients and stir just until combined."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared tin and arrange the thinly sliced apple over the surface."
    },
    {
      "step": 4,
      "text": "Air-fry for 4 minutes, then continue cooking until puffed, golden, and fully set in the center, about 15 minutes total. Confirm the center reaches 160°F.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Serve with the berries and maple syrup, or ice cream, if desired."
    }
  ],
