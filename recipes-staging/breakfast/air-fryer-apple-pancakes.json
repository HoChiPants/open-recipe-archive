  "id": "air-fryer-apple-pancakes",
  "name": "Air-Fryer Apple Pancakes",
  "subtitle": "Tender pancakes with thin apple slices",
  "description": "A quick air-fryer breakfast with lightly sweetened pancake batter and fresh apple.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "neutral-oil-for-the-tin",
      "item": "neutral oil for the tin"
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 200,
      "unit": "ml"
    },
    {
