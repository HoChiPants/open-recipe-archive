      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a skillet until crisp. Drain, cool slightly, and crumble."
    },
    {
      "step": 2,
      "text": "Heat the oven to 325°F."
    },
    {
      "step": 3,
      "text": "Toss the melted butter with the croutons, then spread them in a baking dish and top with the Cheddar."
    },
    {
      "step": 4,
      "text": "Beat the eggs with the milk, diced bell pepper, mustard, salt, and pepper until combined."
    },
    {
      "step": 5,
      "text": "Pour the egg mixture over the croutons and cheese, then scatter the bacon over the top."
    },
    {
      "step": 6,
      "text": "Bake until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Let the casserole rest before serving.",
      "timer_minutes": 10
    }
  ],
