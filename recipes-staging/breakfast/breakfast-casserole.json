  "id": "breakfast-casserole",
  "name": "Breakfast Casserole",
  "subtitle": "A savory baked casserole with bacon, croutons, peppers, and Cheddar",
  "description": "Buttered croutons, crisp bacon, vegetables, and cheese are baked in a seasoned egg-and-milk mixture until fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
