  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Arrange the tomatoes, thickly sliced onion, unpeeled garlic, and sliced jalapeños on a grill-safe tray."
    },
    {
      "step": 2,
      "text": "Grill until charred and softened, about 8 minutes. Peel the garlic, then blend it with the grilled vegetables, chipotle pepper, lime juice, and the small handful of coriander until smooth.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Heat 1 tbsp vegetable oil in a large skillet. Add the blended sauce and cook until hot and slightly thickened.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the corn tortilla chips and toss gently until coated and warmed, keeping some texture."
    },
    {
      "step": 5,
      "text": "Heat the remaining 2 tbsp vegetable oil in a skillet and cook the eggs until the whites are fully set and the centers reach 160°F."
    },
    {
      "step": 6,
      "text": "Top the chilaquiles with queso fresco or feta, chopped coriander, diced avocado, and sliced red onion. Serve immediately."
    }
  ],
