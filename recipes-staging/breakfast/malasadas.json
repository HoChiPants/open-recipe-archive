  "id": "malasadas",
  "name": "Malasadas",
  "subtitle": "Soft fried dough finished with sugar",
  "description": "Yeasted dough enriched with eggs, butter, and evaporated milk, fried until golden and coated in sugar.",
  "meal_type": "breakfast",
