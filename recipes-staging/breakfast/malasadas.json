  "instructions": [
    {
      "step": 1,
      "text": "Dissolve the yeast and 1 teaspoon sugar in the warm water. Set aside."
    },
    {
      "step": 2,
      "text": "Whisk the eggs until thick. Combine the flour, 1/2 cup sugar, melted butter, evaporated milk, 1 cup water, and salt in a large bowl."
    },
    {
      "step": 3,
      "text": "Add the yeast mixture and eggs. Whisk until the dough is smooth, then prepare it for frying."
    },
    {
      "step": 4,
      "text": "Heat the vegetable oil to 375°F in a deep, heavy pot."
    },
    {
      "step": 5,
      "text": "Fry portions of the dough in batches until golden brown, turning as needed for even cooking."
    },
    {
      "step": 6,
      "text": "Drain briefly, then coat the warm malasadas with the remaining sugar."
    }
  ],
