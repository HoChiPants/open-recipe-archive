  "id": "crab-breakfast-casserole",
  "name": "Crab Breakfast Casserole",
  "subtitle": "A savory baked egg casserole with crab, cheese, and crisp croutons.",
  "description": "Combine crabmeat, eggs, cheese, and seasoned croutons for a simple make-ahead-style breakfast casserole with a browned Parmesan topping.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
