      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Lightly grease a casserole dish."
    },
    {
      "step": 2,
      "text": "Stir together the beaten eggs and milk. Fold in the seasoned croutons, Cheddar, dried onion, dried parsley, and Parmesan."
    },
    {
      "step": 3,
      "text": "Gently stir in the crabmeat, then season with salt and pepper."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared dish and bake for 60 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Let the casserole rest briefly, then serve warm."
    }
  ],
