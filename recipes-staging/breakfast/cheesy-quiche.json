  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet over medium heat. Add the diced onion and cook for 5 minutes, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the eggs, heavy cream, basil, oregano, salt, and black pepper until combined."
    },
    {
      "step": 4,
      "text": "Place the pie crust in a 9-inch pie dish. Spread the cooked onion over the crust, then pour in the egg mixture."
    },
    {
      "step": 5,
      "text": "Sprinkle the mozzarella and Cheddar evenly over the filling."
    },
    {
      "step": 6,
      "text": "Bake for 40 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Let the quiche cool briefly before slicing and serving."
    }
  ],
