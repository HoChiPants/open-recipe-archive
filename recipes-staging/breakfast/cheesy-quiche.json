  "id": "cheesy-quiche",
  "name": "Cheesy Quiche",
  "subtitle": "A savory egg custard with herbs, onion, and two cheeses",
  "description": "Sautéed onion and seasoned cream-infused eggs fill a pastry crust beneath a melted mozzarella and Cheddar topping.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "diced"
    },
    {
