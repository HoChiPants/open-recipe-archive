  "id": "peanut-butter-banana-quesadilla",
  "name": "Peanut Butter Banana Quesadilla",
  "subtitle": "Warm tortillas with creamy peanut butter and banana",
  "description": "A quick breakfast quesadilla with a lightly browned tortilla exterior and a soft banana filling.",
  "meal_type": "breakfast",
