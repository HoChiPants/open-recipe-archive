  "instructions": [
    {
      "step": 1,
      "text": "Spread the peanut butter over the tortillas, leaving a small edge clear. Arrange the sliced banana on one half of each tortilla, then fold the tortillas over the filling."
    },
    {
      "step": 2,
      "text": "Preheat a skillet over medium heat and coat it lightly with cooking spray. Cook the folded quesadillas until lightly browned, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Cut each quesadilla into portions and serve warm."
    }
