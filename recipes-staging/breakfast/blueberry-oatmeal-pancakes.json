  "id": "blueberry-oatmeal-pancakes",
  "name": "Blueberry Oatmeal Pancakes",
  "subtitle": "Tender oat pancakes with blueberries",
  "description": "A simple breakfast stack made with oat-based batter, warm cinnamon, and blueberries.",
