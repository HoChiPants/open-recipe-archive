  "instructions": [
    {
      "step": 1,
      "text": "Prepare the rolled oats for the batter, then combine them with the cinnamon, baking powder, and salt."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, honey, almond milk, coconut oil, and vanilla until blended. Stir the wet mixture into the oat mixture, then fold in the blueberries."
    },
    {
      "step": 3,
      "text": "Preheat a skillet with the remaining coconut oil over medium heat. Portion the batter into pancakes and cook until the edges are set and the centers are firm, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Turn the pancakes and cook until browned and fully set, about 3 minutes more; the centers should reach 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Serve the pancakes warm."
    }
  ],
