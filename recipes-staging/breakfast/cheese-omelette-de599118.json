  "id": "cheese-omelette-de599118",
  "name": "Cheese Omelette",
  "subtitle": "A quick, tender omelette with mature cheddar",
  "description": "A simple single-serving omelette cooked in butter and olive oil, finished with finely grated mature cheddar.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": "1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "mature-cheddar-finely-grated",
      "item": "mature cheddar finely grated",
      "quantity": 15,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs until evenly combined."
    },
    {
      "step": 2,
      "text": "Heat the olive oil and butter in a nonstick skillet over medium heat until the butter melts and the pan is hot.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Pour in the eggs and cook until nearly set, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Scatter the grated cheddar over the eggs, then fold the omelette in half and cook until the center is firm and fully set, reaching 160°F."
    }
  ],
