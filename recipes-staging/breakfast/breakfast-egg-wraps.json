  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "breakfast-egg-wraps",
  "name": "Breakfast Egg Wraps",
  "subtitle": "Savory egg wraps with mushrooms, tomatoes, oats, and parsley",
  "description": "Tender egg wraps filled with sautéed mushrooms and cherry tomatoes, with oats and parsley for added texture and flavor.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 7
  },
  "ingredients": [
    {
      "ingredient_id": "pack-closed-cup-mushrooms",
      "item": "pack closed cup mushrooms",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "rapeseed-oil-plus-2-drops",
      "item": "rapeseed oil plus 2 drops",
      "quantity": 4,
      "unit": "tsp"
    },
    {
      "ingredient_id": "cherry-tomatoes-halved",
      "item": "cherry tomatoes halved",
      "quantity": 320,
      "unit": "g",
      "preparation": "or 8 tomatoes, cut into wedges"
    },
    {
      "ingredient_id": "generous-handfuls-parsley-finely-chopped",
      "item": "generous handfuls parsley finely chopped",
      "quantity": 2
    },
    {
      "ingredient_id": "porridge-oats-40g",
      "item": "porridge oats (40g)",
      "quantity": 8,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 10
    },
    {
      "ingredient_id": "english-mustard-powder-made-up-with-water",
      "item": "English mustard powder made up with water",
      "quantity": 4,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the mushrooms into slices. Whisk the eggs with the parsley, oats, and prepared mustard mixture."
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a large nonstick skillet. Add the mushrooms and cook, stirring, for 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Stir in the halved cherry tomatoes and cook for 2 minutes, until warmed through.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Heat a clean nonstick skillet. Pour in the egg mixture in batches to make thin wraps, cooking each until the center is firm and fully set, or reaches 160°F on a food thermometer.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Spoon the mushroom and tomato mixture onto the wraps, fold or roll, and serve."
    }
  ],
