  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "french-toast",
  "name": "French Toast",
  "subtitle": "Cinnamon-vanilla toast for two",
  "description": "Bread slices are dipped in a cinnamon-spiced egg mixture, then cooked until golden and set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "slices-bread",
      "item": "slices bread",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the egg, milk, cinnamon, vanilla extract, and salt in a shallow bowl until combined."
    },
    {
      "step": 2,
      "text": "Preheat a skillet or griddle over medium heat."
    },
    {
      "step": 3,
      "text": "Dip both sides of each bread slice into the egg mixture, coating without oversaturating."
    },
    {
      "step": 4,
      "text": "Cook the slices until lightly browned on both sides and the centers are fully set, reaching 160°F on a food thermometer."
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
