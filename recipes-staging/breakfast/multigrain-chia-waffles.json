  "id": "multigrain-chia-waffles",
  "name": "Multigrain Chia Waffles",
  "subtitle": "Crisp-edged waffles with whole grains and chia",
  "description": "A hearty waffle batter combining whole wheat flour, oats, flax, chia, applesauce, and almond milk.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "almond-milk",
      "item": "almond milk",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "unsweetened-applesauce",
      "item": "unsweetened applesauce",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "chia-seeds",
      "item": "chia seeds",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
