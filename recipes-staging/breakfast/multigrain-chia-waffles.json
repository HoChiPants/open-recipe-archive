      "item": "rolled oats",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flax-seed-meal",
      "item": "flax seed meal",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 4,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a waffle iron according to its settings and lightly coat it with cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk the almond milk, applesauce, beaten egg, chia seeds, vanilla extract, and flax seed meal in a bowl. Let stand for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Whisk in the whole wheat flour, rolled oats, baking powder, white sugar, and salt until smooth."
    },
    {
      "step": 4,
      "text": "Add enough batter to the preheated iron for one waffle. Cook for about 5 minutes, or until crisp and the center is fully set; repeat with the remaining batter.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Serve the waffles warm."
    }
  ],
