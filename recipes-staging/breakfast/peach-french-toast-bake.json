  "id": "peach-french-toast-bake",
  "name": "Peach French Toast Bake",
  "subtitle": "A make-ahead breakfast casserole with peaches and cinnamon.",
  "description": "Layer day-old French bread with peaches and a brown sugar butter sauce, soak it overnight in vanilla egg custard, then bake until golden and fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 540,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "peaches",
      "item": "peaches",
      "quantity": 1,
      "unit": "can",
      "preparation": "29 ounce, sliced, drained"
    },
    {
      "ingredient_id": "3-4-inch-thick-slices-day-old-french-bread",
      "item": "(3/4 inch thick) slices day-old French bread",
      "quantity": 12
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 5
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the packed brown sugar, butter, and water together in a saucepan over medium heat until smooth. Pour the mixture into a baking dish."
    },
    {
      "step": 2,
      "text": "Arrange half of the French bread over the sauce, add the peaches, and cover with the remaining bread."
    },
    {
      "step": 3,
      "text": "Whisk the eggs and vanilla extract together, then pour evenly over the bread. Sprinkle with the ground cinnamon."
    },
    {
      "step": 4,
      "text": "Preheat the oven for 10 minutes. Cover and chill the assembled dish for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 5,
      "text": "Let the chilled casserole stand at room temperature for 30 minutes, then preheat the oven to 350°F.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until golden brown and the center reaches 160°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Serve warm."
    }
  ],
