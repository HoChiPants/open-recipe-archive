  "id": "chocolate-porridge",
  "name": "Chocolate Porridge",
  "subtitle": "Creamy oat porridge with dates and cacao",
  "description": "Blend oats, dates, and milk for a naturally sweet base, then cook with cacao until thick. Add optional yogurt and maple syrup at serving.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "porridge-oats",
      "item": "porridge oats",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "dates-stoned",
      "item": "dates stoned",
      "quantity": 4
    },
    {
      "ingredient_id": "milk-any-will-work",
      "item": "milk any will work",
      "quantity": "500-600",
      "unit": "ml"
    },
    {
      "ingredient_id": "cacao-or-good-quality-cocoa-powder",
      "item": "cacao or good quality cocoa powder",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "yogurt-and-maple-syrup",
      "item": "yogurt and maple syrup",
      "preparation": "to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Blend the oats, dates, and milk until the mixture is thick and smooth."
    },
    {
      "step": 2,
      "text": "Preheat a saucepan over medium heat, then add the blended mixture and cacao powder."
    },
    {
      "step": 3,
      "text": "Stir continuously until the porridge is thick and heated through, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Serve warm with yogurt and maple syrup, if desired."
    }
  ],
