  "id": "raisin-loaf",
  "name": "Raisin Loaf",
  "subtitle": "A tender loaf filled with golden and dark raisins",
  "description": "A lightly sweet quick bread with vanilla flavor and two kinds of raisins, suitable for breakfast or slicing with tea.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
