    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a loaf pan for baking."
    },
    {
      "step": 2,
      "text": "Beat the margarine and white sugar until blended and creamy."
    },
    {
      "step": 3,
      "text": "Whisk in the eggs one at a time."
    },
    {
      "step": 4,
      "text": "Whisk in the milk and vanilla extract."
    },
    {
      "step": 5,
      "text": "In a separate bowl, combine the all-purpose flour, baking powder, and salt."
    },
    {
      "step": 6,
      "text": "Stir the dry mixture into the wet mixture just until combined, then fold in the golden raisins and raisins."
    },
    {
      "step": 7,
      "text": "Transfer the batter to the prepared pan and smooth the surface."
    },
    {
      "step": 8,
      "text": "Bake for 60 minutes, until the center is firm and fully set.",
      "timer_minutes": 60
    },
    {
      "step": 9,
      "text": "Cool the loaf in the pan for 10 minutes, then remove it and cool completely on a rack.",
      "timer_minutes": 10
    },
    {
      "step": 10,
      "text": "Slice and serve."
    }
  ],
