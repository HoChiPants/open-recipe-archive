  "id": "american-blueberry-pancakes",
  "name": "American Blueberry Pancakes",
  "subtitle": "Tender pancakes filled with fresh blueberries",
  "description": "A simple breakfast batter cooked into fluffy blueberry pancakes and served with warm syrup.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "pancakes"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "knob-butter",
      "item": "knob butter"
    },
    {
      "ingredient_id": "pack-blueberry",
      "item": "pack blueberry",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "sunflower-oil-or-a-little-butter-for-cooking",
      "item": "sunflower oil or a little butter for cooking"
    },
    {
      "ingredient_id": "golden-or-maple-syrup",
      "item": "golden or maple syrup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the self-raising flour and baking powder together in a bowl."
    },
    {
      "step": 2,
      "text": "Whisk the egg and milk together, then gradually combine them with the dry ingredients to make a thick batter."
    },
    {
      "step": 3,
      "text": "Melt the knob butter and stir it into the batter with the blueberries."
    },
    {
      "step": 4,
      "text": "Preheat a skillet or griddle over medium heat and lightly coat it with sunflower oil or a little butter for cooking."
    },
    {
      "step": 5,
      "text": "Cook the pancakes in batches, using enough batter for one pancake each. Turn them when bubbles form and the undersides are golden; cook the second side until golden and the centers are fully set."
    },
    {
      "step": 6,
      "text": "Warm the golden or maple syrup for 3 minutes, then serve it with the pancakes.",
      "timer_minutes": 3
    }
  ],
