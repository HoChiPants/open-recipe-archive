  "id": "smoked-salmon-frittata",
  "name": "Smoked Salmon Frittata",
  "subtitle": "A savory egg bake with salmon, olives, and cream cheese",
  "description": "A rich, savory frittata combining smoked salmon, olives, onion, and creamy cheese in a tender baked egg base.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
