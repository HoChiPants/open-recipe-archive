  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Warm the olive oil in an oven-safe skillet over medium heat. Add the onion, salt and pepper, and pepper smoked salmon; cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the remaining olive oil, pepper smoked salmon, and black olives."
    },
    {
      "step": 4,
      "text": "Whisk the eggs, milk, heavy cream, and cream cheese until combined, then stir in the onion, salmon, and olive mixture."
    },
    {
      "step": 5,
      "text": "Transfer the skillet to the oven and bake for 20 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Cut into wedges and serve."
    }
  ],
