  "id": "basic-omelette",
  "name": "Basic Omelette",
  "subtitle": "A simple, tender egg breakfast",
  "description": "Cook beaten eggs in a buttered, oiled skillet until fully set, then fold and serve warm.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "eggs-beaten",
      "item": "eggs beaten",
      "quantity": 3
    },
    {
      "ingredient_id": "sunflower-oil",
      "item": "sunflower oil",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the sunflower oil and butter in a skillet over medium heat until the butter melts."
    },
    {
      "step": 2,
      "text": "Pour in the beaten eggs and cook, gently drawing the setting edges toward the center so uncooked egg flows underneath.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Continue cooking until the center is firm and reaches 160°F, then fold the omelette in half."
    },
    {
      "step": 4,
      "text": "Serve immediately."
    }
  ],
