  "id": "pineapple-and-banana-pancakes",
  "name": "Pineapple and Banana Pancakes",
  "subtitle": "Warm fruit pancakes with yogurt and maple syrup",
  "description": "Tender American-style pancakes folded with pineapple and banana, served with Greek yogurt and maple syrup.",
