  "instructions": [
    {
      "step": 1,
      "text": "Cut the pineapple and banana into small pieces."
    },
    {
      "step": 2,
      "text": "Combine the flour, baking powder, cinnamon, and sugar in a bowl."
    },
    {
      "step": 3,
      "text": "Whisk the egg and milk together, then stir into the dry ingredients until just combined."
    },
    {
      "step": 4,
      "text": "Fold in the pineapple and banana. Rest the batter for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Heat a lightly oiled frying pan over medium heat."
    },
    {
      "step": 6,
      "text": "Cook spoonfuls of batter in batches until bubbles form and the undersides are golden. Turn and cook until golden and the centers are fully set, reaching 160°F."
    },
    {
      "step": 7,
      "text": "Serve with Greek yogurt and maple syrup."
    }
  ],
