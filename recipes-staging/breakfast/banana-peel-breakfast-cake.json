  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and butter a cake tin."
    },
    {
      "step": 2,
      "text": "Cut the bananas, including their peels, into pieces. Blend or process the banana and peel with the walnuts until smooth."
    },
    {
      "step": 3,
      "text": "Whisk 125 g softened salted butter, the sugar, and 3 tbsp smooth peanut butter for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Whisk in the beaten eggs, vanilla, yogurt, and banana mixture."
    },
    {
      "step": 5,
      "text": "Combine the flour, baking powder, and bicarbonate of soda, then fold into the wet mixture with the remaining walnuts."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared tin and bake for 60 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Cool in the tin for 15 minutes, then transfer to a rack and cool completely.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Whisk 100 g softened salted butter, the honey, and 3 tbsp smooth peanut butter until smooth. Spread over the cooled cake."
    }
  ],
