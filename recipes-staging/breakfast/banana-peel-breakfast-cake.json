  "id": "banana-peel-breakfast-cake",
  "name": "Banana Peel Breakfast Cake",
  "subtitle": "A tender banana cake with a honey-peanut butter finish",
  "description": "A moist banana cake made with very ripe bananas and their peels, finished with a simple honey-peanut butter topping.",
  "meal_type": "breakfast",
  "yield": {
