{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "french-toast-waffles",
  "name": "French Toast Waffles",
  "subtitle": "Crisp, custardy brioche waffles with maple flavor",
  "description": "Brioche pieces are soaked in a lightly sweetened egg mixture, then cooked in a waffle iron until golden.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "inch-thick-pieces-brioche",
      "item": "inch thick pieces brioche",
      "quantity": "4 1/2"
    },
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the waffle iron according to its standard setting."
    },
    {
      "step": 2,
      "text": "Whisk the milk, eggs, maple syrup, vanilla, and salt until combined."
    },
    {
      "step": 3,
      "text": "Cut the brioche into the specified pieces and transfer them to the egg mixture. Turn to coat, then let stand for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Lightly coat the preheated waffle iron with cooking spray. Arrange the soaked brioche inside without overcrowding."
    },
    {
      "step": 5,
      "text": "Cook until golden brown, about 5 minutes, and repeat with the remaining pieces.",
      "timer_minutes": 5
    }
  ],
