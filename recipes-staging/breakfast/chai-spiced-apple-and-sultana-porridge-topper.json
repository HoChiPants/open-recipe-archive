  "id": "chai-spiced-apple-and-sultana-porridge-topper",
  "name": "Chai-Spiced Apple and Sultana Porridge Topper",
  "subtitle": "Warm fruit with aromatic spices for creamy oats",
  "description": "Cook apples and sultanas with lemon, sugar, and chai spices, then spoon the mixture over thickened porridge.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
