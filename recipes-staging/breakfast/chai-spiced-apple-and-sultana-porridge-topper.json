  "instructions": [
    {
      "step": 1,
      "text": "Combine the sultanas, apples, lemon juice, sugar, ginger, cinnamon, nutmeg, cardamom pods, and cloves in a saucepan."
    },
    {
      "step": 2,
      "text": "Cook over medium heat for 15 minutes, stirring occasionally, until the apples soften and the fruit mixture becomes syrupy. Remove the whole spices and let the mixture cool slightly.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Combine the porridge oats and milk in a clean saucepan and cook over medium heat for 10 minutes, stirring often, until thickened.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Whisk the porridge until smooth, divide among four bowls, and top with the spiced apple mixture. Add a drizzle of double cream if using."
    }
  ],
