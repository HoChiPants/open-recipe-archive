  "id": "baked-oats",
  "name": "Baked Oats",
  "subtitle": "Warm banana oats with fruit or chocolate",
  "description": "A simple oat breakfast baked in ramekins with banana, eggs, and your choice of fruit or chocolate.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
