      "preparation": "plus extra to serve"
    },
    {
      "ingredient_id": "flavourless-oil-for-the-ramekins",
      "item": "flavourless oil for the ramekins"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to the recipe's baking temperature and lightly oil four ramekins."
    },
    {
      "step": 2,
      "text": "Combine the porridge oats, baking powder, banana, maple syrup or honey, eggs, and spice or cinnamon until smooth."
    },
    {
      "step": 3,
      "text": "Fold in the chocolate chips, blueberries, or raspberries, then divide the mixture among the ramekins."
    },
    {
      "step": 4,
      "text": "Bake for 25 minutes, until the centers are fully set or reach 160°F when checked with a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Serve with the reserved chocolate chips, blueberries, or raspberries."
    }
  ],
