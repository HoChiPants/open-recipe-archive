  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk to 110°F (45°C). Crumble in the yeast and let it stand until softened.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Mix in the room-temperature butter, eggs, 2 tablespoons sugar, cardamom, and salt. Add the flour gradually and mix until a dough forms."
    },
    {
      "step": 3,
      "text": "Knead the dough until firm, adding only as much flour as needed. Cover and let it rise until expanded.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Whisk the softened butter and 1/2 cup sugar, then stir in the cinnamon until combined. Set aside."
    },
    {
      "step": 5,
      "text": "Roll the dough into a thick rectangle and spread it with the cinnamon filling. Roll it up and cut into 15 thick pieces."
    },
    {
      "step": 6,
      "text": "Arrange the pieces in a baking pan, cover, and let them rest while the oven heats to 425°F.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Bake until golden brown, about 10 minutes. Let the pastries cool briefly before serving.",
      "timer_minutes": 10
    }
  ],
