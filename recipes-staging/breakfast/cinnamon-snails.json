  "id": "cinnamon-snails",
  "name": "Cinnamon Snails",
  "subtitle": "Soft cardamom rolls with a buttery cinnamon filling",
  "description": "Yeast-raised pastries rolled with cinnamon butter and baked until golden.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
