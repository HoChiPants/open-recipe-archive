{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "sourdough-buttermilk-pancakes",
  "name": "Sourdough Buttermilk Pancakes",
  "subtitle": "Tender pancakes with a lightly tangy crumb",
  "description": "These pancakes combine sourdough starter and buttermilk for a fluffy, gently tangy breakfast.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sourdough-starter",
      "item": "sourdough starter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the egg and sugar in a bowl. Add the sourdough starter, flour, and buttermilk, and stir just until combined."
    },
    {
      "step": 2,
      "text": "Stir in the baking soda until evenly distributed."
    },
    {
      "step": 3,
      "text": "Preheat a griddle or skillet over medium heat and coat it with cooking spray."
    },
    {
      "step": 4,
      "text": "Cook the pancakes for about 4 minutes, until bubbles form and the edges look set. Turn and cook for about 3 minutes more, until browned and the centers are fully set or register 160°F on a food thermometer.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
