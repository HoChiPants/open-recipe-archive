{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "blueberry-lemon-croissant-bake",
  "name": "Blueberry Lemon Croissant Bake",
  "subtitle": "A warm, custardy bake with citrus curd and berries",
  "description": "Layer torn croissants with lemon curd and blueberries, then bake them in a milk-enriched custard until set and golden.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 8,
    "unit": "as dessert or 6 as brunch"
  },
  "times": {
    "prep_minutes": 12,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "croissants-leftover-stale-croissants-work-well",
      "item": "croissants (leftover stale croissants work well)",
      "quantity": 6,
      "unit": "large"
    },
    {
      "ingredient_id": "ready-made-custard",
      "item": "ready-made custard",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "lemon-curd",
      "item": "lemon curd",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "fresh-or-frozen-blueberries",
      "item": "fresh or frozen blueberries",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar-to-serve-optional",
      "item": "icing sugar to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to the baking temperature specified for the dish.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Cut the croissants into large pieces and arrange them in a baking dish."
    },
    {
      "step": 3,
      "text": "Whisk the ready-made custard with the milk until smooth, then whisk the lemon curd separately until loosened."
    },
    {
      "step": 4,
      "text": "Layer the lemon curd and blueberries among the croissant pieces, then pour the custard mixture evenly over everything."
    },
    {
      "step": 5,
      "text": "Bake for 40 minutes, until golden brown and the center is fully set; confirm an egg-based casserole reaches 165°F with a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Let the bake rest for 10 minutes, then dust with icing sugar if desired.",
      "timer_minutes": 10
    }
  ],
