      "item": "bananas",
      "quantity": 6,
      "preparation": "halved lengthwise"
    },
    {
      "ingredient_id": "whipped-heavy-cream",
      "item": "whipped heavy cream",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, confectioners' sugar, and salt in a bowl. Add the eggs, milk, melted butter, and vanilla extract; whisk until smooth."
    },
    {
      "step": 2,
      "text": "Warm a crepe pan or nonstick skillet over medium heat. Pour in a thin layer of batter, swirl to coat, and cook until the surface is set. Turn and finish briefly; repeat with the remaining batter."
    },
    {
      "step": 3,
      "text": "Melt the remaining butter in a skillet. Add the packed brown sugar, ground cinnamon, and ground nutmeg, then cook until lightly browned."
    },
    {
      "step": 4,
      "text": "Stir in the half-and-half cream, add the bananas cut-side down, and cook until warmed and coated.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Whisk the whipped heavy cream with the remaining pinch of ground cinnamon and the confectioners' sugar mixture until thickened."
    },
    {
      "step": 6,
      "text": "Serve the crepes with the warm bananas and cinnamon cream."
    }
  ],
