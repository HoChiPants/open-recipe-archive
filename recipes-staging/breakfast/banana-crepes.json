  "id": "banana-crepes",
  "name": "Banana Crepes",
  "subtitle": "Thin French crepes with warm bananas and cinnamon cream",
  "description": "Tender crepes are filled or topped with buttery cinnamon bananas and a lightly sweetened cream mixture.",
  "meal_type": "breakfast",
  "cuisine": "French",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
