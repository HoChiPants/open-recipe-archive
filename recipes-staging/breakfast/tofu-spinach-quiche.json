      "item": "(9 inch) unbaked pie crust",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Blend the tofu, milk, salt, and pepper until smooth, adding more milk if needed."
    },
    {
      "step": 3,
      "text": "In a bowl, combine the spinach, Cheddar, Swiss cheese, onion, and garlic. Stir in the blended tofu mixture."
    },
    {
      "step": 4,
      "text": "Pour the filling into the unbaked pie crust and bake until the center is firm and fully set, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Let the quiche stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
