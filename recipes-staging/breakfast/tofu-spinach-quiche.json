    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "8-ounce-container-tofu",
      "item": "(8 ounce) container tofu",
      "quantity": 1
    },
    {
      "ingredient_id": "1-milk",
      "item": "1% milk",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "or more if needed"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
