  "id": "tofu-spinach-quiche",
  "name": "Tofu Spinach Quiche",
  "subtitle": "A savory crust-baked filling with spinach and two cheeses",
  "description": "A creamy tofu-based quiche filling mixed with spinach, onion, garlic, and shredded Cheddar and Swiss cheeses.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
