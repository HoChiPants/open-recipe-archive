  "instructions": [
    {
      "step": 1,
      "text": "Soak the salted cod as needed to remove excess salt, then simmer it in fresh water until cooked through and easily flaked. Cool briefly, remove any bones, and shred."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a large skillet over medium heat."
    },
    {
      "step": 3,
      "text": "Add the onion, garlic, spring onions, and half of the scotch bonnet pepper. Cook until softened, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Stir in the shredded cod, remaining scotch bonnet pepper, thyme, allspice, red pepper, and green pepper. Cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the tomato and cook until the mixture is combined and lightly softened, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Gently fold in the drained ackee so the pieces remain intact."
    },
    {
      "step": 7,
      "text": "Simmer gently for 5 minutes, until hot throughout. Confirm the fish reaches 145°F and flakes easily before serving.",
      "timer_minutes": 5
    }
  ],
