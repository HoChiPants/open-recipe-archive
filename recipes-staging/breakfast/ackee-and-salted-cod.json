  "id": "ackee-and-salted-cod",
  "name": "Ackee and Salted Cod",
  "subtitle": "Savory ackee with peppers, aromatics, and tender salted cod",
  "description": "A Caribbean-style skillet dish combining flaky salted cod, ackee, peppers, tomato, and warm spices.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
