  "id": "cherry-chocolate-loaf",
  "name": "Cherry Chocolate Loaf",
  "subtitle": "A tender fruit-and-chocolate loaf with a simple drizzle",
  "description": "Cherries, dark chocolate, and walnuts are folded into a rich yogurt batter, baked until set, and finished with a light powdered-sugar glaze.",
  "meal_type": "breakfast",
  "cuisine": "American",
