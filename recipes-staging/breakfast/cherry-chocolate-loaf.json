  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease a loaf pan with the teaspoon of butter."
    },
    {
      "step": 2,
      "text": "Whisk the flour, kosher salt, baking powder, and baking soda together."
    },
    {
      "step": 3,
      "text": "Beat the softened butter with the white sugar and powdered sugar until smooth. Add the eggs one at a time, then mix in the yogurt and vanilla."
    },
    {
      "step": 4,
      "text": "Cut the pitted cherries as needed. Toss them with the chocolate chunks and walnuts."
    },
    {
      "step": 5,
      "text": "Fold the dry ingredients into the butter mixture, then gently incorporate the cherry mixture until evenly combined."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and smooth the surface."
    },
    {
      "step": 7,
      "text": "Bake for 60 minutes, or until the center is firm and a tester comes out clean.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Let the loaf rest for 15 minutes in the pan, then cool for 20 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 9,
      "text": "Stir the baking powder, white sugar, powdered sugar, and milk into a smooth drizzle, adding more milk as needed. Finish the cooled loaf with the mixture before serving."
    }
  ],
