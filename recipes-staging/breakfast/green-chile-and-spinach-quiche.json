  "id": "green-chile-and-spinach-quiche",
  "name": "Green Chile and Spinach Quiche",
  "subtitle": "A savory, cheesy egg bake with spinach and mild green chiles.",
  "description": "Two pie crusts hold a creamy spinach-and-chile filling enriched with cottage cheese and shredded Colby-Monterey Jack.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 12
    },
    {
      "ingredient_id": "colby-monterey-jack-cheese",
      "item": "Colby-Monterey Jack cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, shredded"
    },
    {
      "ingredient_id": "small-curd-cottage-cheese",
      "item": "small curd cottage cheese",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed and drained"
    },
    {
      "ingredient_id": "green-chilies",
      "item": "green chilies",
      "quantity": 2,
      "unit": "can",
      "preparation": "4 ounce, chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "9-inch-unbaked-pie-crusts",
      "item": "(9 inch) unbaked pie crusts",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, salt, and cottage cheese until combined; set aside."
    },
    {
      "step": 3,
      "text": "Whisk the eggs until smooth, then whisk in the flour mixture."
    },
    {
      "step": 4,
      "text": "Stir in the shredded cheese, spinach, green chiles, and melted butter."
    },
    {
      "step": 5,
      "text": "Divide the filling between the two unbaked pie crusts."
    },
    {
      "step": 6,
      "text": "Reduce the oven temperature to 350°F and bake for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Continue baking until lightly browned, the centers are firm, and the internal temperature reaches 160°F, about 20 minutes more.",
      "timer_minutes": 20
    }
  ],
