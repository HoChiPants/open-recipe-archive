  "id": "make-ahead-french-toast",
  "name": "Make-Ahead French Toast",
  "subtitle": "Overnight custard-soaked bread with a pecan topping",
  "description": "Prepare this breakfast casserole the night before, then bake it until puffed, golden, and fully set.",
