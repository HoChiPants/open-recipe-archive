  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs, milk, half-and-half cream, and vanilla extract until combined."
    },
    {
      "step": 2,
      "text": "Arrange the French bread slices in a baking dish and pour the egg mixture over them. Cover and refrigerate for 790 minutes.",
      "timer_minutes": 790
    },
    {
      "step": 3,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 4,
      "text": "Combine the melted butter, light brown sugar, maple syrup, and chopped pecans. Spread the mixture over the soaked bread."
    },
    {
      "step": 5,
      "text": "Bake for 40 minutes, until golden and the center is firm and fully set; verify an egg casserole reaches 160°F with a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Let stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
