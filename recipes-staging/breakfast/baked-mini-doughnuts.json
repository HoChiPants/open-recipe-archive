  "id": "baked-mini-doughnuts",
  "name": "Baked Mini Doughnuts",
  "subtitle": "Tender nutmeg doughnuts with cinnamon sugar",
  "description": "Small oven-baked doughnuts made with a buttery nutmeg batter and finished in cinnamon sugar.",
  "meal_type": "breakfast",
