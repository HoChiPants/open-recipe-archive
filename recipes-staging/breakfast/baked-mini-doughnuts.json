  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a mini doughnut pan for baking."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, nutmeg, and salt in one bowl. Stir the milk and vanilla together separately."
    },
    {
      "step": 3,
      "text": "Beat the softened butter with the first portion of white sugar until smooth. Whisk in the egg."
    },
    {
      "step": 4,
      "text": "Stir the dry ingredients into the butter mixture in batches, alternating with the milk mixture, until smooth. Portion the batter into the prepared pan."
    },
    {
      "step": 5,
      "text": "Bake for 12 minutes, or until the doughnuts are lightly set and the centers are firm. Confirm the egg-containing centers reach 160°F.",
      "timer_minutes": 12
    },
    {
      "step": 6,
      "text": "Combine the second portion of white sugar with the cinnamon. While the doughnuts are warm, coat them in the cinnamon sugar."
    }
  ],
