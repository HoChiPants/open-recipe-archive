      "item": "of ground allspice",
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Cut the pineapple into bite-size pieces, then toss it with the maple syrup and pinch of ground allspice in a small baking dish."
    },
    {
      "step": 2,
      "text": "Roast the pineapple until tender and lightly caramelized, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Whisk the eggs, coconut milk, vanilla extract, and desiccated coconut in a shallow dish."
    },
    {
      "step": 4,
      "text": "Soak the brioche slices in the egg mixture for 2 minutes, turning once so both sides are coated.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Melt the butter in a skillet over medium heat. Cook the soaked brioche until golden on both sides and the centers are fully set, reaching 160°F on a food thermometer."
    },
    {
      "step": 6,
      "text": "Serve the French toast with the roasted pineapple and plain or coconut yogurt."
    }
  ],
