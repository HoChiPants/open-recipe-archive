  "id": "coconut-french-toast-with-spiced-roasted-pineapple",
  "name": "Coconut French Toast with Spiced Roasted Pineapple",
  "subtitle": "Crisp coconut-coated toast with warm maple pineapple",
  "description": "Coconut milk and desiccated coconut enrich thick brioche slices, served with roasted pineapple and yogurt.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "coconut-milk",
      "item": "coconut milk",
      "quantity": 150,
      "unit": "ml"
    },
    {
