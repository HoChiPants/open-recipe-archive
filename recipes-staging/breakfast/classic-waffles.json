      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 4,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "warm-milk",
      "item": "warm milk",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, salt, baking powder, and sugar in a bowl."
    },
    {
      "step": 2,
      "text": "Preheat the waffle maker according to its instructions."
    },
    {
      "step": 3,
      "text": "Whisk the eggs in a separate bowl, then stir in the warm milk, melted butter, and vanilla."
    },
    {
      "step": 4,
      "text": "Pour the liquid mixture into the dry ingredients and whisk just until combined. Let the batter stand briefly until set."
    },
    {
      "step": 5,
      "text": "Cook the batter in the preheated waffle maker until the waffles are golden and crisp."
    },
    {
      "step": 6,
      "text": "Serve warm."
    }
  ],
