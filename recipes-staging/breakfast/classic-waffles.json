  "id": "classic-waffles",
  "name": "Classic Waffles",
  "subtitle": "Light, crisp waffles for breakfast or brunch",
  "description": "A simple American waffle batter made with warm milk, melted butter, vanilla, and pantry staples.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
