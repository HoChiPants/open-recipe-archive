  "instructions": [
    {
      "step": 1,
      "text": "Place the grated beetroot in a sieve or clean cloth and drain for 30 minutes, pressing out as much liquid as possible.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large frying pan. Cook the sliced onion until softened, then add the grated potatoes and cook for about 10 minutes. Transfer to a bowl and let cool.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Mix the cooled potato mixture with the beetroot, flour, and 1 egg. Season as appropriate, then shape into four flat rösti."
    },
    {
      "step": 4,
      "text": "Blend or finely chop the Greek yogurt with the dill, parsley, cumin, and capers until smooth. Reserve extra dill for serving."
    },
    {
      "step": 5,
      "text": "Heat the butter in a frying pan and cook the rösti in batches, turning once, until browned and cooked through.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Bring a wide pan of water to a gentle simmer, add the white wine vinegar, and poach the remaining eggs until the whites are set and the yolks reach a safe cooked endpoint of 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 7,
      "text": "Top the rösti with smoked salmon, green yogurt, and poached eggs. Finish with the reserved dill and serve immediately."
    }
  ],
