  "id": "beetroot-ro-sti-with-green-yogurt-and-smoked-salmon",
  "name": "Beetroot Rösti with Green Yogurt and Smoked Salmon",
  "subtitle": "Crisp beetroot-potato cakes with herbed yogurt and eggs",
  "description": "Serve crisp beetroot and potato rösti with green herb yogurt, smoked salmon, capers, and poached eggs.",
  "meal_type": "breakfast",
