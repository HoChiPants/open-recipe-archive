  "id": "almond-poppy-seed-muffins",
  "name": "Almond Poppy Seed Muffins",
  "subtitle": "Tender almond-scented muffins with lemon zest and poppy seeds.",
  "description": "Light breakfast muffins made with buttermilk, almond extract, lemon zest, and folded egg whites.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.3333333730698,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1.125,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large",
      "preparation": "separated, divided"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "freshly-grated-lemon-zest",
      "item": "freshly grated lemon zest",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "poppy-seeds",
      "item": "poppy seeds",
      "quantity": 2.5,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a 12-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Stir together the flour, baking powder, baking soda, and salt."
    },
    {
      "step": 3,
      "text": "Beat the butter with most of the sugar until smooth. Beat in the egg yolks, almond extract, and lemon zest."
    },
    {
      "step": 4,
      "text": "Add the flour mixture and buttermilk alternately, mixing only until combined. Fold in the poppy seeds."
    },
    {
      "step": 5,
      "text": "Whisk the egg whites with the remaining sugar to stiff peaks, then gently fold into the batter."
    },
    {
      "step": 6,
      "text": "Divide the batter among the prepared muffin cups."
    },
    {
      "step": 7,
      "text": "Bake until the muffins are golden and the centers are firm and fully set, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Cool briefly in the pan, then transfer the muffins to a rack."
    }
  ],
