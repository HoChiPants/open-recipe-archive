  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Lightly grease a baking dish with part of the divided butter."
    },
    {
      "step": 2,
      "text": "Combine the flour, 2 tablespoons white sugar, baking powder, and salt. Stir in the milk and melted portion of the divided butter to form a soft dough, adding flour as needed."
    },
    {
      "step": 3,
      "text": "Roll the dough into a rectangle on a lightly floured surface. Spread with the softened 3 tablespoons butter, then cover with the white sugar, brown sugar, and cinnamon."
    },
    {
      "step": 4,
      "text": "Roll the rectangle into a log from one long side and cut it into nine pieces. Arrange the pieces in the prepared dish."
    },
    {
      "step": 5,
      "text": "Bake until the rolls are puffed and lightly browned, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Beat the confectioners' sugar, softened cream cheese, softened 0.25 cup butter, and vanilla extract until smooth. Stir in the cinnamon, then spread the icing over the warm rolls."
    }
  ],
