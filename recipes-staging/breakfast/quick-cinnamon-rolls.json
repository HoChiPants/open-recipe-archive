  "id": "quick-cinnamon-rolls",
  "name": "Quick Cinnamon Rolls",
  "subtitle": "Soft rolls with cinnamon filling and cream cheese icing",
  "description": "Make tender, lightly sweetened rolls with a buttery cinnamon center and smooth cream cheese icing.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
