{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "creamy-scrambled-eggs-with-mozzarella-and-basil",
  "name": "Creamy Scrambled Eggs with Mozzarella and Basil",
  "subtitle": "Soft, cheesy eggs finished with fresh basil",
  "description": "Sour cream and mozzarella make these scrambled eggs rich and tender, while basil adds a fresh finish.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "basil",
      "item": "fresh basil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "minced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs and sour cream until smooth. Stir in the shredded mozzarella, then season with salt and pepper."
    },
    {
      "step": 2,
      "text": "Melt the butter in a nonstick skillet over medium-low heat."
    },
    {
      "step": 3,
      "text": "Pour in the egg mixture and cook, stirring gently and frequently, until the eggs are fully set and reach 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Fold in the minced basil and serve immediately."
    }
  ],
