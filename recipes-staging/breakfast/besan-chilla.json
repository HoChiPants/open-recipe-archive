  "id": "besan-chilla",
  "name": "Besan Chilla",
  "subtitle": "Savory chickpea-flour pancakes with fresh vegetables",
  "description": "Seasoned chickpea-flour pancakes cooked with onion, tomato, chili, ginger, and coriander, then served with chutney and tamarind yogurt.",
  "meal_type": "breakfast",
  "cuisine": "Indian",
  "yield": {
    "quantity": 3,
    "unit": "(depending on size)"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
