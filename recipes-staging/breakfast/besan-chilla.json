      "item": "grated ginger",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "handful-of-coriander-finely-chopped",
      "item": "handful of coriander finely chopped",
      "unit": "small"
    },
    {
      "ingredient_id": "vegetable-oil-or-ghee",
      "item": "vegetable oil or ghee",
      "quantity": 1,
      "unit": "tbsp",
      "preparation": "as needed"
    },
    {
      "ingredient_id": "mango-chutney-and-tamarind-yogurt",
      "item": "mango chutney and tamarind yogurt"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the gram flour with ajwain, garam masala, cumin, and turmeric."
    },
    {
      "step": 2,
      "text": "Mix in the onion, tomato, chili, ginger, and coriander, working the mixture into a thick batter."
    },
    {
      "step": 3,
      "text": "Preheat a skillet with some of the oil or ghee."
    },
    {
      "step": 4,
      "text": "Add a portion of batter to the hot skillet and spread it into a pancake."
    },
    {
      "step": 5,
      "text": "Cook for 2 minutes, turn, and sauté for 2 minutes more, until cooked through.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Repeat with the remaining batter and serve with mango chutney and tamarind yogurt."
    }
  ],
