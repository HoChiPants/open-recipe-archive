      "item": "gram (chickpea) flour",
      "quantity": 120,
      "unit": "g"
    },
    {
      "ingredient_id": "ajwain-carom-seeds",
      "item": "ajwain (carom seeds)",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "garam-masala",
      "item": "garam masala",
      "quantity": "3/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": "3/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-turmeric",
      "item": "ground turmeric",
      "quantity": "1/8",
      "unit": "tsp"
    },
    {
      "ingredient_id": "onion-finely-chopped",
      "item": "onion finely chopped",
      "quantity": 1,
      "unit": "small"
    },
