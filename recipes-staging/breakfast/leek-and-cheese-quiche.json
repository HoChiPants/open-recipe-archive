    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 450°F. Melt the butter in a skillet, add the leeks, and cook until tender."
    },
    {
      "step": 2,
      "text": "Stir the Swiss cheese, Romano cheese, and flour together. Place the thawed crust in a 9-inch pie dish and fill it with the leeks."
    },
    {
      "step": 3,
      "text": "Whisk the cream and eggs together, season with salt and pepper, and pour the mixture over the leeks. Sprinkle the cheese mixture over the top and arrange the tomato slices on it."
    },
    {
      "step": 4,
      "text": "Bake at 450°F for 15 minutes. Reduce the oven to 325°F and continue baking for about 30 minutes, until lightly browned and the center is fully set; verify the egg mixture reaches 160°F.",
      "timer_minutes": 30
    }
  ],
