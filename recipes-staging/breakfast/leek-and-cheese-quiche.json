  "id": "leek-and-cheese-quiche",
  "name": "Leek and Cheese Quiche",
  "subtitle": "A savory, creamy tart for breakfast or brunch",
  "description": "Tender leeks and two cheeses fill a custard-set pie crust, finished with thin tomato slices.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "leeks",
      "item": "leeks",
      "quantity": 2,
      "unit": "cups",
      "preparation": "sliced"
    },
    {
