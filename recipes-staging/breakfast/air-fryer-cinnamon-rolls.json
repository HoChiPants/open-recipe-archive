  "instructions": [
    {
      "step": 1,
      "text": "Combine the plain flour, bread flour, yeast, caster sugar, and light brown sugar in a mixing bowl."
    },
    {
      "step": 2,
      "text": "Warm the milk with 25 g butter until the butter melts. Let it cool slightly, then mix in the egg and 1 tsp vanilla extract."
    },
    {
      "step": 3,
      "text": "Add the liquid to the dry ingredients and knead for 10 minutes, until smooth. Cover and leave to rise until set, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Mix the cinnamon with the softened butter and remaining light brown sugar to make the filling."
    },
    {
      "step": 5,
      "text": "Roll the dough on a lightly floured surface into a rectangle. Spread over the filling, roll up from one long side, and cut into six pieces."
    },
    {
      "step": 6,
      "text": "Arrange the rolls in the air-fryer basket or a suitable pan, cover, and leave for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Preheat the air fryer according to the appliance instructions. Air-fry the rolls until golden and the center is fully set, about 17 minutes.",
      "timer_minutes": 17
    },
    {
      "step": 8,
      "text": "Cool briefly. Whisk the soft cheese, 40 g softened butter, icing sugar, and 1/2 tsp vanilla extract until smooth, then spread over the warm rolls."
    },
    {
      "step": 9,
      "text": "Serve warm."
    }
  ],
