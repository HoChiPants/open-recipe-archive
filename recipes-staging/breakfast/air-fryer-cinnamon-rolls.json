  "id": "air-fryer-cinnamon-rolls",
  "name": "Air Fryer Cinnamon Rolls",
  "subtitle": "Soft spirals with cinnamon filling and vanilla cheese icing",
  "description": "Yeasted cinnamon rolls shaped for the air fryer and finished with a smooth vanilla topping.",
  "meal_type": "breakfast",
  "yield": {
