  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a loaf pan."
    },
    {
      "step": 2,
      "text": "Zest and juice the lemon. Whisk the lemon, confectioners' sugar, white sugar, melted butter, eggs, and sour cream until smooth; stir in the milk."
    },
    {
      "step": 3,
      "text": "Whisk the flour, baking powder, and salt separately. Add the dry mixture to the wet mixture and stir just until combined."
    },
    {
      "step": 4,
      "text": "Fold in the frozen blueberries, transfer the batter to the pan, and bake for 60 minutes, until the center is fully set and reaches at least 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Cool the loaf in the pan for 10 minutes, then remove it and let it cool completely before slicing and serving.",
      "timer_minutes": 10
    }
  ],
