  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Prepare a baking dish for the casserole."
    },
    {
      "step": 2,
      "text": "Combine the ham, asparagus, onion, red bell peppers, and black pepper in the prepared dish."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, milk, flour, Parmesan, tarragon, and salt until smooth. Pour the mixture over the ham and vegetables."
    },
    {
      "step": 4,
      "text": "Bake for 20 minutes, until the center is nearly set.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Sprinkle the Parmesan and Cheddar over the top, then bake for 5 minutes more, until the cheeses melt and the egg center is firm and fully set.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Let the bake rest for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
