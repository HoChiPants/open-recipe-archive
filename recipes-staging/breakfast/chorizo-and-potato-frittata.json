  "id": "chorizo-and-potato-frittata",
  "name": "Chorizo and Potato Frittata",
  "subtitle": "A skillet frittata with hearty potatoes, greens, and chorizo",
  "description": "Chorizo, potatoes, peas, and spinach are folded into eggs and baked until firm for a filling breakfast or brunch dish.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying",
      "quantity": "1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "chorizo-sliced-into-rounds",
      "item": "chorizo sliced into rounds",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "frozen-peas",
      "item": "frozen peas",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "canned-potatoes-drained-and-cut-in-half-if-large",
      "item": "canned potatoes drained and cut in half if large",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "spinach",
      "item": "spinach",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and place an oven-safe skillet on the stovetop."
    },
    {
      "step": 2,
      "text": "Heat the oil in the skillet, add the chorizo, and cook for 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Add the peas and potatoes, stirring to coat them in the chorizo oil. Add the spinach and cook until wilted."
    },
    {
      "step": 4,
      "text": "Whisk the eggs, pour them into the skillet, and cook until the edges begin to set."
    },
    {
      "step": 5,
      "text": "Transfer the skillet to the oven and cook for 7 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 7
    }
  ],
