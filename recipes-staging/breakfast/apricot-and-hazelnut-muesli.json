  "id": "apricot-and-hazelnut-muesli",
  "name": "Apricot and Hazelnut Muesli",
  "subtitle": "Toasted oats with fruit, seeds, and blueberries",
  "description": "A crisp oat-and-hazelnut muesli mixed with dried fruit and served with oat milk and fresh blueberries.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "porridge-oats",
      "item": "porridge oats",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "blanched-hazelnuts-halved",
      "item": "blanched hazelnuts halved",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "pumpkin-seeds",
      "item": "pumpkin seeds",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": "1 1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "sulphur-free-dried-apricots-chopped",
      "item": "sulphur-free dried apricots chopped",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "apple-fruit-crisps-or-dried-apple",
      "item": "apple fruit crisps or dried apple",
      "quantity": 20,
      "unit": "g"
    },
    {
      "ingredient_id": "fortified-oat-milk",
      "item": "fortified oat milk",
      "quantity": 600,
      "unit": "ml"
    },
    {
      "ingredient_id": "blueberries",
      "item": "blueberries",
      "quantity": 240,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Toast the porridge oats, halved hazelnuts, pumpkin seeds, and cinnamon together in a dry skillet over medium heat for about 5 minutes, stirring frequently, until fragrant and lightly colored.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Transfer the toasted mixture to a bowl and stir in the chopped apricots and apple crisps or dried apple."
    },
    {
      "step": 3,
      "text": "Divide the muesli among six bowls. Pour over the fortified oat milk and top with the blueberries."
    }
  ],
