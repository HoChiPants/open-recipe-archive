{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "country-gravy",
  "name": "Country Gravy",
  "subtitle": "A savory sausage-and-bacon gravy for breakfast plates",
  "description": "Browned sausage and bacon enrich a simple milk gravy finished with green onion and cayenne.",
  "meal_type": "breakfast",
  "cuisine": "Southern",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "breakfast-sausage-links",
      "item": "breakfast sausage links",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "casings removed and meat broken up"
    },
    {
      "ingredient_id": "strips-bacon",
      "item": "strips bacon",
      "quantity": 4,
      "preparation": "sliced crosswise"
    },
    {
      "ingredient_id": "green-onions-light-parts-only",
      "item": "green onions (light parts only)",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "packed-all-purpose-flour",
      "item": "packed all-purpose flour",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "cold-milk",
      "item": "cold milk",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the sausage and bacon, then cook for 10 minutes, breaking up the sausage, until browned and the sausage reaches 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the green onions and cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Stir in the flour, salt, and black pepper. Cook for 3 minutes, stirring constantly.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Gradually whisk in the cold milk until smooth, then whisk for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir in the cayenne and adjust the salt and black pepper."
    },
    {
      "step": 7,
      "text": "Simmer for 15 minutes, stirring occasionally, until thickened.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Garnish with the green onions and cayenne, then serve hot."
    }
  ],
