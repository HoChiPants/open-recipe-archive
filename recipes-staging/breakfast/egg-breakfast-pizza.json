  "id": "egg-breakfast-pizza",
  "name": "Egg Breakfast Pizza",
  "subtitle": "Savory breakfast pizzas with sausage, eggs, vegetables, bacon, and Cheddar",
  "description": "Two crusts are layered with seasoned egg, sausage, vegetables, bacon, creamy celery sauce, and cheese, then baked until browned and fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "ground-sausage",
      "item": "ground sausage",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "12-inch-prepared-pizza-crusts",
      "item": "(12 inch) prepared pizza crusts",
      "quantity": 2
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 12
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "condensed-cream-of-celery-soup",
      "item": "condensed cream of celery soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "bacon-bits",
      "item": "bacon bits",
      "quantity": 1,
      "unit": "can",
      "preparation": "3 ounce"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "minced"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 1,
      "unit": "small",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 4,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Cook the ground sausage with the minced onion until the sausage reaches 160°F; drain well."
    },
    {
      "step": 2,
      "text": "Place the prepared crusts on baking sheets and bake for 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Whisk the eggs, milk, salt and pepper, and chopped green bell pepper together. Cook the mixture until the eggs are firm and reach 160°F."
    },
    {
      "step": 4,
      "text": "Spread the condensed cream of celery soup over the crusts. Distribute the cooked egg mixture, sausage, and bacon bits over the top, then cover with the shredded Cheddar cheese."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until the cheese is golden brown and the center is fully set. Cut into portions and serve hot.",
      "timer_minutes": 30
    }
  ],
