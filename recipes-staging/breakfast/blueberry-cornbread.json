  "id": "blueberry-cornbread",
  "name": "Blueberry Cornbread",
  "subtitle": "Tender cornbread studded with blueberries",
  "description": "A lightly sweet baked cornbread with a soft crumb and bursts of blueberry.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "cornmeal",
      "item": "cornmeal",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 3,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "blueberries",
      "item": "blueberries",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Whisk the cornmeal, flour, sugar, baking powder, and salt in a bowl."
    },
    {
      "step": 3,
      "text": "Whisk the milk and eggs together, then stir them into the dry ingredients until combined."
    },
    {
      "step": 4,
      "text": "Fold in the blueberries."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a baking pan."
    },
    {
      "step": 6,
      "text": "Bake until the cornbread is set and lightly browned, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
