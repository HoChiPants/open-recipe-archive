  ],
  "instructions": [
    {
      "step": 1,
      "text": "Break the matzo cracker into pieces, soak briefly in water, then drain well."
    },
    {
      "step": 2,
      "text": "Whisk the egg with the salt and pepper. Combine with the drained matzo and let the mixture stand until set."
    },
    {
      "step": 3,
      "text": "Preheat a skillet over medium heat and add the vegetable oil."
    },
    {
      "step": 4,
      "text": "Transfer the matzo mixture to the skillet and cook for 1 minute. Turn or stir and cook for 1 minute more, until the egg is fully set or reaches 160°F.",
