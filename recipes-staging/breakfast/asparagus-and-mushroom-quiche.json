  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Cook the bacon until done, then drain and set aside."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet. Add the onion and stir until softened. Add the mushrooms and cook until tender."
    },
    {
      "step": 3,
      "text": "Bring salted water to a boil, add the asparagus, and cook for 2 minutes. Drain and cool.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Brush the inside of the unbaked pie shell with the lightly beaten egg white. Place the bacon, onion, asparagus, and feta in the shell."
    },
    {
      "step": 5,
      "text": "Add the Cheddar and remaining feta. Whisk the eggs, half-and-half, salt, and pepper until smooth, then pour the mixture into the shell."
    },
    {
      "step": 6,
      "text": "Bake until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Let the quiche cool briefly before slicing and serving."
    }
  ],
