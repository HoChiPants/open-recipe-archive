      "item": "slices bacon",
      "quantity": 5
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "cut into 1/2-inch pieces"
    },
    {
      "ingredient_id": "portobello-mushrooms",
      "item": "portobello mushrooms",
      "quantity": 1,
      "unit": "cup",
      "preparation": "stem and ribs removed, cut into 1-inch pieces"
    },
    {
