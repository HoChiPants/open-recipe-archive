  "id": "asparagus-and-mushroom-quiche",
  "name": "Asparagus and Mushroom Quiche",
  "subtitle": "A savory vegetable quiche with bacon and two cheeses",
  "description": "Tender asparagus and mushrooms are combined with bacon, eggs, cream, and cheese in an 8-inch pastry shell, then baked until fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 55
  },
  "ingredients": [
