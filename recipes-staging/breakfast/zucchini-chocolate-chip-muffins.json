  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a 12-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Stir together the flour, sugar, baking soda, cinnamon, and salt."
    },
    {
      "step": 3,
      "text": "Whisk the oil, milk, lightly beaten egg, lemon juice, and vanilla until combined."
    },
    {
      "step": 4,
      "text": "Add the wet mixture to the dry ingredients and stir just until incorporated."
    },
    {
      "step": 5,
      "text": "Fold in the zucchini, chocolate chips, and walnuts."
    },
    {
      "step": 6,
      "text": "Divide the batter among the muffin cups."
    },
    {
      "step": 7,
      "text": "Bake for 25 minutes, until the centers are fully set and reach 160°F when checked with a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 8,
      "text": "Cool the muffins before serving."
    }
  ],
