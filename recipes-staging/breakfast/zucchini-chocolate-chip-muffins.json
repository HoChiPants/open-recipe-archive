  "id": "zucchini-chocolate-chip-muffins",
  "name": "Zucchini Chocolate Chip Muffins",
  "subtitle": "Tender muffins with shredded zucchini, chocolate chips, and walnuts",
  "description": "A simple American breakfast bake combining cinnamon-spiced batter with zucchini, chocolate chips, and chopped walnuts.",
  "meal_type": "breakfast",
