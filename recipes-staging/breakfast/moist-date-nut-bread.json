  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a loaf pan as needed."
    },
    {
      "step": 2,
      "text": "Combine the dates and butter in a mixing bowl. Pour in the boiling water and stir until the butter melts."
    },
    {
      "step": 3,
      "text": "Stir in the brown sugar and egg until combined."
    },
    {
      "step": 4,
      "text": "In a separate bowl, combine the flour, baking soda, baking powder, and salt. Add the dry mixture to the date mixture and stir just until incorporated."
    },
    {
      "step": 5,
      "text": "Fold in the walnuts, then transfer the batter to the prepared loaf pan."
    },
    {
      "step": 6,
      "text": "Bake for 50 minutes, until the center is firm and reaches at least 160°F on a food thermometer.",
      "timer_minutes": 50
    },
    {
      "step": 7,
      "text": "Let the bread cool for 30 minutes before slicing.",
      "timer_minutes": 30
    }
  ],
