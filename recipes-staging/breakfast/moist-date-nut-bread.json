  "id": "moist-date-nut-bread",
  "name": "Moist Date Nut Bread",
  "subtitle": "A tender loaf filled with dates and walnuts",
  "description": "A simple American quick bread with sweet dates, brown sugar, and chopped walnuts.",
  "meal_type": "breakfast",
