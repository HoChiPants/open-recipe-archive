      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "unbleached-all-purpose-flour",
      "item": "unbleached all-purpose flour",
      "quantity": 0.75,
      "unit": "cup"
    },
