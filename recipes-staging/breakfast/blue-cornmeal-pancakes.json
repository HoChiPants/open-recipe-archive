      "preparation": "toasted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the blue cornmeal, salt, and sugar together. Add the boiling water and mix until combined; let the mixture stand briefly to soften the cornmeal."
    },
    {
      "step": 2,
      "text": "Stir in the beaten egg, milk, and melted butter. In a separate bowl, combine the flour and baking powder, then fold them into the cornmeal mixture until just blended."
    },
    {
      "step": 3,
      "text": "Preheat a lightly buttered skillet or griddle over medium heat."
    },
    {
      "step": 4,
      "text": "Cook the pancakes in batches, turning once, until browned and cooked through. The centers should be firm and reach 160°F when checked with a thermometer."
    },
    {
      "step": 5,
      "text": "Serve warm with the toasted pine nuts."
    }
  ],
