  "id": "blue-cornmeal-pancakes",
  "name": "Blue Cornmeal Pancakes",
  "subtitle": "Tender pancakes with toasted pine nuts",
  "description": "Blue cornmeal gives these breakfast pancakes a hearty texture, while toasted pine nuts add a crisp finish.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "blue-cornmeal",
      "item": "blue cornmeal",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "boiling-water",
