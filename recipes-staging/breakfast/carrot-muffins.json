  "id": "carrot-muffins",
  "name": "Carrot Muffins",
  "subtitle": "Tender muffins with carrots, sultanas, and nuts",
  "description": "Simple carrot muffins combining warm spice, dried fruit, and chopped nuts in a lightly sweet batter.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 12,
    "unit": "muffins"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "flour",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "cinnamon",
      "item": "cinnamon",
      "quantity": "1 1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "sultanas",
      "item": "sultanas",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "nuts",
      "item": "nuts",
      "quantity": 50,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a 12-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Microwave the margarine until melted. Stir in the carrots and sugar."
    },
    {
      "step": 3,
      "text": "Whisk together the flour, cinnamon, and baking powder in a separate bowl."
    },
    {
      "step": 4,
      "text": "Whisk the eggs, then add them to the margarine mixture. Fold in the dry ingredients, sultanas, and nuts until just combined."
    },
    {
      "step": 5,
      "text": "Divide the batter among the muffin cups."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, until the muffins are risen and set in the center.",
      "timer_minutes": 20
    }
  ],
