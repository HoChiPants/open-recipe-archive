  "id": "cinnamon-roll-monkey-bread",
  "name": "Cinnamon Roll Monkey Bread",
  "subtitle": "Warm pull-apart cinnamon bites with icing",
  "description": "Pieces of cinnamon roll dough are buttered, coated in cinnamon sugar, baked until golden, and finished with the included icing.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "refrigerated-cinnamon-roll-dough-with-icing",
      "item": "refrigerated cinnamon roll dough with icing",
      "quantity": 1,
      "unit": "package",
      "preparation": "12.4 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Mix the white sugar and ground cinnamon in a bowl."
    },
    {
      "step": 3,
      "text": "Separate the cinnamon roll dough and cut it into bite-size pieces."
    },
    {
      "step": 4,
      "text": "Coat the dough pieces with melted butter, then toss them in the cinnamon-sugar mixture."
    },
    {
      "step": 5,
      "text": "Arrange the coated pieces in a baking pan and bake until golden brown, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Let the bread cool for 5 minutes, then drizzle with the icing from the package.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Serve warm."
    }
  ],
