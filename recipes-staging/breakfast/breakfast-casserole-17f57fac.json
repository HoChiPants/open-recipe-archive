  "id": "breakfast-casserole-17f57fac",
  "name": "Breakfast Casserole",
  "subtitle": "A savory baked egg dish with vegetables and veggie sausage",
  "description": "Sautéed mushrooms, peppers, onion, and veggie sausage are folded into a cheddar-and-chive egg mixture and baked until fully set.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "chestnut-mushrooms-sliced",
      "item": "chestnut mushrooms sliced",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "vegetable-oil-plus-extra-for-the-tin",
      "item": "vegetable oil plus extra for the tin (optional)",
      "quantity": "1 1/2",
      "unit": "tbsp",
      "optional": true
    },
    {
      "ingredient_id": "veggie-sausages-sliced-into-bite-sized-pieces",
      "item": "veggie sausages sliced into bite-sized pieces",
      "quantity": 6
    },
    {
      "ingredient_id": "red-onion-finely-sliced",
      "item": "red onion finely sliced",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "red-peppers-deseeded-and-sliced",
      "item": "red peppers deseeded and sliced",
      "quantity": 2
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 8
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "cheddar-grated",
      "item": "cheddar grated",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "chives-finely-sliced",
      "item": "chives finely sliced",
      "quantity": 10,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease the baking tin with the optional extra oil, if using."
    },
    {
      "step": 2,
      "text": "Cook the sliced mushrooms in a skillet for 10 minutes, then add the vegetable oil and heat for 2 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Add the veggie sausage pieces, red onion, and peppers. Sauté until the vegetables are tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Whisk the eggs and whole milk together, then stir in the cheddar and chives."
    },
    {
      "step": 5,
      "text": "Combine the cooked vegetables and veggie sausages with the egg mixture, transfer to the prepared tin, and bake for 30 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Let the casserole cool briefly before serving."
    }
  ],
