      "item": "onion sliced",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "potato-leftover-boiled-or-roasted-potatoes-are-fine",
      "item": "potato (leftover boiled or roasted potatoes are fine)",
      "quantity": 1,
      "unit": "medium",
      "preparation": "cooked, cubed"
    },
    {
      "ingredient_id": "medium-curry-powder",
      "item": "medium curry powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "nigella-seeds",
      "item": "nigella seeds",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "eggs-whisked",
      "item": "eggs whisked",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "natural-yogurt-or-raita",
      "item": "natural yogurt or raita",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "good-squeeze-chilli-sauce-optional",
      "item": "good squeeze chilli sauce (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the vegetable oil in a nonstick skillet over medium heat. Add the sliced onion and cubed potato; cook until the onion softens and the potato is hot.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the curry powder and nigella seeds, and cook briefly until fragrant.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Whisk the eggs in a bowl. Pour them into the skillet and gently stir once to distribute the filling."
    },
    {
      "step": 4,
      "text": "Cook until the base is set, then fold the omelette and continue cooking until the center is firm and reaches 160°F.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Serve with the natural yogurt or raita and the optional chilli sauce."
    }
  ],
