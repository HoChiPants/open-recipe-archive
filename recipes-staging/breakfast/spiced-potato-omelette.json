  "id": "spiced-potato-omelette",
  "name": "Spiced Potato Omelette",
  "subtitle": "A quick skillet omelette with curried potatoes and onion",
  "description": "Cooked potato, onion, curry powder, and nigella seeds fill a softly set omelette, served with yogurt or raita and optional chilli sauce.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25
  },
  "ingredients": [
