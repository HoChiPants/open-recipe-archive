  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Cook the bacon in a skillet over medium heat until crisp, about 10 minutes. Drain and crumble it.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the milk, eggs, seasoned salt, and ground black pepper until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the bacon, Cheddar cheese, onion, and green bell pepper until evenly combined.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Arrange the sliced potatoes and mushrooms in a baking dish, then pour the egg mixture over them."
    },
    {
      "step": 5,
      "text": "Bake for 35 minutes, then continue baking for about 30 minutes, until the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
