  "id": "bacon-breakfast-casserole",
  "name": "Bacon Breakfast Casserole",
  "subtitle": "A savory egg bake with bacon, potatoes, vegetables, and Cheddar",
  "description": "Crisp bacon and sliced potatoes anchor this hearty breakfast casserole, finished with eggs, vegetables, mushrooms, and melted Cheddar.",
  "meal_type": "breakfast",
  "cuisine": "American",
