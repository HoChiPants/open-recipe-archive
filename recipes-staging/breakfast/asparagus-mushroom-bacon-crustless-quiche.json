  "id": "asparagus-mushroom-bacon-crustless-quiche",
  "name": "Asparagus Mushroom Bacon Crustless Quiche",
  "subtitle": "A savory, vegetable-filled egg bake with Swiss cheese",
  "description": "Bacon, asparagus, and mushrooms are folded into a creamy Swiss cheese custard and baked until fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 6,
      "unit": "ounces",
      "preparation": "diced"
    },
    {
      "ingredient_id": "asparagus",
      "item": "asparagus",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "cut into 1-inch pieces"
    },
    {
      "ingredient_id": "baby-bella-cremini-mushrooms",
      "item": "baby bella (cremini) mushrooms",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "swiss-cheese",
      "item": "Swiss cheese",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper-to-taste",
      "item": "freshly ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Prepare a baking dish for the quiche."
    },
    {
      "step": 2,
      "text": "Cook the diced bacon in a skillet over medium heat until browned and cooked through, about 10 minutes. Drain, reserving the bacon.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the asparagus and mushrooms to the skillet and cook with the bacon until the vegetables are tender, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Transfer the bacon and vegetables to the prepared dish and sprinkle the Swiss cheese over them."
    },
    {
      "step": 5,
      "text": "Whisk together the cream, eggs, salt, and black pepper, then pour the mixture into the dish."
    },
    {
      "step": 6,
      "text": "Bake for about 30 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Serve warm."
    }
  ],
