      "item": "⁄4 tsp chilli flakes (optional)",
      "quantity": 1,
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and set an oven-safe skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Combine the grated potato and cheddar. In a separate bowl, mix the beaten egg, flour, and sliced spring onions, then stir into the potato mixture."
    },
    {
      "step": 3,
      "text": "Add the oil to the skillet, spread in the potato mixture, and sauté until the underside is browned and the mixture is partly cooked.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Transfer the skillet to the preheated oven and cook until the hash brown is set.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Make a space in the hash brown, crack in the egg, and scatter over the remaining cheddar. Bake until the egg white and yolk are fully set and the center reaches 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Finish with the chilli flakes, if using, and the remaining sliced spring onions."
    }
  ],
