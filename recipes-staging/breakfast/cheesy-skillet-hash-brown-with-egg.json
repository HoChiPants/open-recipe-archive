  "id": "cheesy-skillet-hash-brown-with-egg",
  "name": "Cheesy Skillet Hash Brown with Egg",
  "subtitle": "A crisp potato skillet finished with melted cheddar and a set egg",
  "description": "Coarsely grated potato, cheddar, spring onions, and egg cook together in one skillet for a compact savory breakfast.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
