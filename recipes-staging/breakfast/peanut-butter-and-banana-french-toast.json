  "id": "peanut-butter-and-banana-french-toast",
  "name": "Peanut Butter and Banana French Toast",
  "subtitle": "A warm, fruit-filled breakfast sandwich with crisp, buttery edges.",
  "description": "Peanut butter, banana, and egg-soaked bread are cooked together in a skillet until golden and fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "dash"
    },
    {
      "ingredient_id": "creamy-peanut-butter",
      "item": "creamy peanut butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "slices-bread",
      "item": "slices bread",
      "quantity": 2
    },
    {
      "ingredient_id": "banana",
      "item": "banana",
      "quantity": 1,
      "unit": "small",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the egg and vanilla extract in a shallow dish."
    },
    {
      "step": 2,
      "text": "Spread peanut butter over the bread, arrange the banana slices on one piece, and close the sandwich."
    },
    {
      "step": 3,
      "text": "Warm a skillet over medium heat and melt the butter. Dip the sandwich in the egg mixture, turning to coat both sides."
    },
    {
      "step": 4,
      "text": "Cook until golden brown, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Turn the sandwich and cook for about 2 minutes more, until browned and the center is firm and fully set; for a measured check, the egg should reach 160°F.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Serve warm."
    }
  ],
