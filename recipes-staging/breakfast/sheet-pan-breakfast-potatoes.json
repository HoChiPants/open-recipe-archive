  "id": "sheet-pan-breakfast-potatoes",
  "name": "Sheet Pan Breakfast Potatoes",
  "subtitle": "Crisp-edged potatoes with peppers and onion",
  "description": "Roasted baby potatoes and colorful vegetables seasoned with garlic, salt, pepper, and olive oil, then finished under the grill for extra browning.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "baby-red-potatoes",
      "item": "baby red potatoes",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "onion",
      "item": "yellow onion",
      "quantity": 1,
      "unit": "medium",
      "preparation": "diced"
    },
    {
      "ingredient_id": "bell-pepper",
      "item": "bell pepper",
      "quantity": 1,
      "unit": "medium",
      "preparation": "diced"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Halve the baby potatoes; leave very small potatoes whole."
    },
    {
      "step": 2,
      "text": "Arrange the potatoes, diced onion, and diced bell pepper on a sheet pan. Add the olive oil, garlic powder, salt, and black pepper, then toss to coat evenly."
    },
    {
      "step": 3,
      "text": "Spread the vegetables into an even layer and roast until the potatoes are tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Switch to the grill and cook for about 5 minutes, until the edges are browned.",
      "timer_minutes": 5
    }
  ],
