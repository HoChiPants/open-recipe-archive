  "id": "campfire-skillet-breakfast",
  "name": "Campfire Skillet Breakfast",
  "subtitle": "A hearty one-pan breakfast with crisp bacon, potatoes, eggs, and cheese.",
  "description": "Cook bacon with potatoes and onion, then finish the skillet with set eggs and melted Cheddar.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 17
  },
  "ingredients": [
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "potatoes",
      "item": "potatoes",
      "quantity": 4,
      "unit": "cups",
      "preparation": "peeled and cubed"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the bacon in a large skillet until set and lightly crisp."
    },
    {
      "step": 2,
      "text": "Stir in the potatoes and onion, coating them with the bacon drippings."
    },
    {
      "step": 3,
      "text": "Cook for 12 minutes, stirring occasionally, until the potatoes are tender.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Pour in the beaten eggs and stir for 2 minutes, until fully set; egg dishes should reach 160°F or have a firm center.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Sprinkle the shredded Cheddar over the skillet and serve when melted."
    }
  ],
