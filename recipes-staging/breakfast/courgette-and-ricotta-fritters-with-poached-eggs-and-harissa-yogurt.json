  "instructions": [
    {
      "step": 1,
      "text": "Combine the grated courgettes, ricotta, lemon zest, lightly beaten eggs, grated parmesan or vegetarian alternative, and flour. Stir until evenly mixed, then leave the batter to set for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Stir the Greek yogurt and rose harissa together, then set aside."
    },
    {
      "step": 3,
      "text": "Preheat the oven and a frying pan. Heat the olive oil in the pan and cook spoonfuls of batter until golden brown, about 4 minutes per side.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Transfer the fritters to the oven for 10 minutes. If using, cook the pancetta in the pan for 3 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Bring water to a gentle simmer, add the white wine vinegar, and poach the large eggs until the whites are set and the centers reach 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Serve the fritters with harissa yogurt, the pancetta if using, poached eggs, and torn dill and parsley."
    }
  ],
