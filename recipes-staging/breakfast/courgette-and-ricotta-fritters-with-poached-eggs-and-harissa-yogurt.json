  "id": "courgette-and-ricotta-fritters-with-poached-eggs-and-harissa-yogurt",
  "name": "Courgette and Ricotta Fritters with Poached Eggs and Harissa Yogurt",
  "subtitle": "Crisp courgette fritters with creamy yogurt and poached eggs",
  "description": "A savory breakfast of ricotta-filled courgette fritters served with harissa yogurt, optional pancetta, poached eggs, and fresh herbs.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
