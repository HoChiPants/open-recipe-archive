  "id": "chorizo-and-sweet-potato-breakfast-tortillas",
  "name": "Chorizo and Sweet Potato Breakfast Tortillas",
  "subtitle": "Roasted sweet potato, chorizo, and egg wraps",
  "description": "Warm flour tortillas filled with roasted sweet potatoes, savory chorizo, scrambled eggs, and fresh avocado, onion, lime, coriander, and hot sauce.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
