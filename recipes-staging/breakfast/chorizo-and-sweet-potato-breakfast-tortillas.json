  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Toss the cubed sweet potatoes with the olive oil, spread them on a roasting tray, and roast until tender, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 2,
      "text": "Cook the chorizo in a skillet over medium heat until browned and cooked through, about 12 minutes; verify it reaches 160°F with a food thermometer.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Whisk the eggs, add them to the skillet with the chorizo, and cook until fully set and at least 160°F."
    },
    {
      "step": 4,
      "text": "Warm the tortillas briefly, then divide the sweet potatoes, chorizo, and eggs among them.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Top with avocado, red onion, and coriander. Serve with lime wedges and hot sauce."
    }
  ],
