  "id": "chocolate-granola",
  "name": "Chocolate Granola",
  "subtitle": "Cocoa granola with maple sweetness and toasted almonds",
  "description": "A crisp, lightly spiced chocolate granola made with rolled oats, cocoa, maple syrup, and almonds.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
