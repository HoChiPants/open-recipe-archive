  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 250°F."
    },
    {
      "step": 2,
      "text": "Whisk the brown sugar, maple syrup, oil, vanilla, salt, cayenne, and cocoa powder in a large bowl until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the oats and chopped almonds until evenly coated."
    },
    {
      "step": 4,
      "text": "Spread the mixture in an even layer on a parchment-lined baking sheet."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Turn off the oven and leave the granola inside for 60 minutes to dry and crisp.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Remove the granola and let it cool completely before breaking it into clusters and storing it."
    }
  ],
