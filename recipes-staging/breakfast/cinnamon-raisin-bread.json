  "id": "cinnamon-raisin-bread",
  "name": "Cinnamon Raisin Bread",
  "subtitle": "Tender yeast bread with a cinnamon-sugar swirl",
  "description": "A richly flavored raisin bread layered with cinnamon sugar and baked until lightly browned.",
