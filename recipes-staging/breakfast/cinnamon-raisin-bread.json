  "instructions": [
    {
      "step": 1,
      "text": "Warm the 1.5 cups milk with the warm water, then let the mixture cool to lukewarm. Stir in the yeast and rest for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Combine the raisins, eggs, 1 cup of the sugar, softened margarine, and salt. Stir in the yeast mixture and the 2 tablespoons milk."
    },
    {
      "step": 3,
      "text": "Add the flour gradually, mixing until a dough forms. Knead until smooth and elastic."
    },
    {
      "step": 4,
      "text": "Transfer the dough to a lightly floured surface or bowl, cover, and let rise for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Deflate the dough and let it rest until set enough to handle."
    },
    {
      "step": 6,
      "text": "Divide the dough into portions and roll each into a thick rectangle. Combine the remaining sugar with the cinnamon."
    },
    {
      "step": 7,
      "text": "Brush the rectangles with milk, sprinkle with the cinnamon-sugar mixture, then roll each up. Cut and shape the portions into loaves."
    },
    {
      "step": 8,
      "text": "Transfer the shaped loaves to prepared pans, cover, and let rise for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 9,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 10,
      "text": "Bake for 45 minutes, or until lightly browned.",
      "timer_minutes": 45
    },
    {
      "step": 11,
      "text": "Brush the hot loaves with melted butter, then cool before slicing."
    }
  ],
