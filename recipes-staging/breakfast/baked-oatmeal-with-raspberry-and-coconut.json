      "item": "desiccated coconut",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "walnuts-roughly-chopped",
      "item": "walnuts roughly chopped",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "raspberries",
      "item": "raspberries",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "plant-based-milk-we-used-oat",
      "item": "plant-based milk (we used oat)",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "agave-syrup",
      "item": "agave syrup",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and lightly coat a small baking dish with the melted coconut oil and desiccated coconut."
    },
    {
      "step": 2,
      "text": "Combine the oats, remaining desiccated coconut, cinnamon, walnuts, and raspberries in the prepared dish."
    },
    {
      "step": 3,
      "text": "Stir the plant-based milk and agave syrup together, then pour over the oat mixture. Gently spread the raspberries through the mixture."
    },
    {
      "step": 4,
      "text": "Bake for 25 minutes, or until the top is golden brown and the center is fully set.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
