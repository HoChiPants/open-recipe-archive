  "id": "baked-oatmeal-with-raspberry-and-coconut",
  "name": "Baked Oatmeal with Raspberry and Coconut",
  "subtitle": "A warm oat bake with berries, coconut, and walnuts.",
  "description": "Combine oats, raspberries, coconut, cinnamon, and walnuts with plant-based milk and agave, then bake until golden and tender.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "coconut-oil-melted",
      "item": "coconut oil melted",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
