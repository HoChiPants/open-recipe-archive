      "preparation": "peeled, cored and chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a loaf pan and set it aside."
    },
    {
      "step": 2,
      "text": "Whisk the sugar and butter until smooth, then whisk in the eggs."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the flour, baking soda, cinnamon, salt, and cloves."
    },
    {
      "step": 4,
      "text": "Stir the dry mixture into the butter mixture until just combined. Fold in the chopped apples."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 60 minutes, until the loaf is set in the center.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool the bread in the pan for 15 minutes, then cool it completely before slicing.",
      "timer_minutes": 15
    }
  ],
