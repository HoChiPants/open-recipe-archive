  "id": "apple-cinnamon-bread",
  "name": "Apple Cinnamon Bread",
  "subtitle": "A warmly spiced loaf with tender chopped apples",
  "description": "A simple American quick bread combining apples, cinnamon, and cloves in a tender, lightly sweet loaf.",
  "meal_type": "breakfast",
  "cuisine": "American",
