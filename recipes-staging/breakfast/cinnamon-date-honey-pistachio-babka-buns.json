  "id": "cinnamon-date-honey-pistachio-babka-buns",
  "name": "Cinnamon-Date, Honey & Pistachio Babka Buns",
  "subtitle": "Twisted sweet buns with cinnamon-date filling and a honey glaze",
  "description": "Soft enriched buns filled with spiced dates and pistachios, baked until set, then finished with a simple honey syrup.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 7,
    "unit": "servings"
  },
