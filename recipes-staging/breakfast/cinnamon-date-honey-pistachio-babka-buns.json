  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk until just lukewarm. Stir in the yeast and golden caster sugar, then leave for 10 minutes, until set and lightly foamy.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Mix the flour with the beaten egg and the yeast mixture. Knead for 6 minutes, gradually working in the softened butter, until the dough is smooth.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Oil a bowl, add the dough, cover, and leave to prove for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "Meanwhile, simmer the pitted dates with enough water to soften them for 30 minutes. Drain if needed and mash or blend until thick; stir in the cinnamon.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Roll the dough on a lightly floured surface into a rectangle. Spread with the date mixture and scatter over the chopped pistachios. Roll up, cut into seven pieces, and twist or shape them into buns."
    },
    {
      "step": 6,
      "text": "Oil the tin, arrange the buns inside, cover, and leave to rise for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Heat the oven to 350°F. Brush the buns with the beaten egg-and-salt glaze and bake for 20 minutes, until browned and the center is fully set; verify with a thermometer that the egg-containing center reaches 160°F.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "While the buns bake, heat the caster sugar with the honey until dissolved. Brush the hot buns with the syrup, then cool briefly before serving."
    }
  ],
