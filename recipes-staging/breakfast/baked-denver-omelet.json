  "id": "baked-denver-omelet",
  "name": "Baked Denver Omelet",
  "subtitle": "A savory oven-baked egg dish with ham, peppers, and cheese.",
  "description": "Sautéed onion, green pepper, and ham are combined with seasoned eggs, milk, and Cheddar, then baked until fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.5,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "green-bell-pepper",
      "item": "green bell pepper",
      "quantity": 0.5,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "ham",
      "item": "ham",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped cooked"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 8
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Melt the butter in an oven-safe skillet over medium heat. Add the onion, green bell pepper, and salt and pepper; cook, stirring, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the chopped cooked ham and cook briefly to warm it."
    },
    {
      "step": 4,
      "text": "Whisk the eggs and milk in a bowl, then stir in the shredded Cheddar cheese."
    },
    {
      "step": 5,
      "text": "Pour the egg mixture over the vegetables and ham. Transfer the skillet to the oven if needed."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Serve warm."
    }
  ],
