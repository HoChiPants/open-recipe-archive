  "instructions": [
    {
      "step": 1,
      "text": "Whisk the buttermilk, melted butter, vanilla extract, and egg in a bowl."
    },
    {
      "step": 2,
      "text": "Mix the plain flour, salt, caster sugar, baking powder, and bicarbonate of soda separately."
    },
    {
      "step": 3,
      "text": "Whisk the wet mixture into the dry ingredients until smooth."
    },
    {
      "step": 4,
      "text": "Preheat the waffle maker and lightly oil it."
    },
    {
      "step": 5,
      "text": "Cook the batter in the waffle maker until golden brown, about 2 minutes per batch; use a thermometer to confirm the center reaches 160°F or cook until fully firm.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Serve with the berries, Greek yogurt, and honey, or the listed alternative accompaniments."
    }
  ],
