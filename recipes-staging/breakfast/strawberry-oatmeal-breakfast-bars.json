  "id": "strawberry-oatmeal-breakfast-bars",
  "name": "Strawberry Oatmeal Breakfast Bars",
  "subtitle": "Jammy berries beneath a buttery oat crumble",
  "description": "Fresh strawberries are layered with a lightly spiced oat mixture and baked until golden, then cooled for clean slices.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 0.5,
      "preparation": "juiced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "old-fashioned-rolled-oats",
      "item": "old-fashioned rolled oats",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
