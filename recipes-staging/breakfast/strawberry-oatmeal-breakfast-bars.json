      "item": "whole wheat flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "packed-light-brown-sugar",
      "item": "packed light brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
