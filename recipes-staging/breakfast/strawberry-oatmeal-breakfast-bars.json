      "item": "unsalted butter",
      "quantity": 8,
      "unit": "tablespoons",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Prepare a baking pan for the bars."
    },
    {
      "step": 2,
      "text": "Trim and slice the strawberries. Toss them with the lemon juice, white sugar, cornstarch, and half of the brown sugar; set aside until lightly thickened."
    },
    {
      "step": 3,
      "text": "Stir the oats, both flours, remaining brown sugar, salt, and ginger together. Mix in the melted butter until evenly moistened and crumbly."
    },
    {
      "step": 4,
      "text": "Press part of the oat mixture into the prepared pan. Spread the strawberry mixture over it, then scatter the remaining oat mixture on top."
    },
    {
      "step": 5,
      "text": "Bake until the topping is golden brown and the strawberry filling is bubbling, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Cool completely, about 60 minutes, then cut into bars and serve.",
      "timer_minutes": 60
    }
  ],
