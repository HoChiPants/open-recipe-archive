  "instructions": [
    {
      "step": 1,
      "text": "Blend the softened butter with 0.66666668653488 cup flour. Shape the mixture into a flat block and chill it until firm."
    },
    {
      "step": 2,
      "text": "Combine the remaining flour with the yeast. Warm the milk with the sugar and salt, then cool the mixture to 115°F."
    },
    {
      "step": 3,
      "text": "Pour the warm milk mixture into the flour mixture. Add the eggs, lemon extract, and almond extract, then stir for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Knead in enough of the divided flour to make a firm dough. Cover and let it rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cut and shape the dough into a rectangle. Enclose the chilled butter block, then fold and roll the dough to laminate it."
    },
    {
      "step": 6,
      "text": "Repeat the folding and rolling, resting the dough as needed; chill for 30 minutes between folds.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Make another fold, chill the dough for 30 minutes, and complete the final shaping.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Roll and cut the dough into pieces. Add fruit preserves, fold each piece around the filling, and transfer the pastries to a prepared baking surface. Let them rise for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 9,
      "text": "Heat the oven to 450°F. Brush the pastries with the beaten egg white."
    },
    {
      "step": 10,
      "text": "Bake for 10 minutes, until golden brown and the centers are fully set, reaching at least 160°F on a food thermometer.",
      "timer_minutes": 10
    }
  ],
