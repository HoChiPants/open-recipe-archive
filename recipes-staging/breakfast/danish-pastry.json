  "id": "danish-pastry",
  "name": "Danish Pastry",
  "subtitle": "Layered pastries with fruit preserves",
  "description": "A yeasted, butter-layered pastry filled with fruit preserves and baked until crisp, golden, and fully set.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 60,
    "cook_minutes": 10,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 2,
      "unit": "cups",
      "preparation": "softened"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 8,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 4.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
