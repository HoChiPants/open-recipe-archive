  "id": "banana-bread-66378951",
  "name": "Banana Bread",
  "subtitle": "Moist loaf with ripe bananas and vanilla",
  "description": "A simple American quick bread made with very ripe bananas, sweetened batter, and a tender crumb.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "very-ripe-bananas",
      "item": "very ripe bananas",
      "quantity": 5
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 300°F and prepare the baking pan or pans."
    },
    {
      "step": 2,
      "text": "Stir the bananas and eggs together until evenly combined."
    },
    {
      "step": 3,
      "text": "Whisk the shortening and sugar until blended, then stir in the vanilla."
    },
    {
      "step": 4,
      "text": "Whisk the flour, baking soda, and salt together in a separate bowl."
    },
    {
      "step": 5,
      "text": "Blend the banana mixture into the shortening mixture, then add the dry ingredients and stir just until the batter is set and evenly combined."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan or pans and bake for 60 minutes, until set in the center.",
      "timer_minutes": 60
    }
  ],
