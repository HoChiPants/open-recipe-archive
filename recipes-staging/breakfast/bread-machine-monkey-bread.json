  "id": "bread-machine-monkey-bread",
  "name": "Bread Machine Monkey Bread",
  "subtitle": "Soft cinnamon-raisin pull-apart bread",
  "description": "A sweet pull-apart bread made with a bread-machine dough, cinnamon sugar, raisins, and brown sugar glaze.",
