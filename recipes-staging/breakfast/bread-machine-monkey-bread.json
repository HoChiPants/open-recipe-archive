  "instructions": [
    {
      "step": 1,
      "text": "Add the water and 2 tablespoons softened margarine to the bread-machine pan. Add the flour, cinnamon, salt, and white sugar, then place the yeast on top. Run the dough cycle and let the dough rest until set."
    },
    {
      "step": 2,
      "text": "Preheat the oven to 375°F. Prepare a baking pan."
    },
    {
      "step": 3,
      "text": "Melt the 1 cup margarine with the packed brown sugar, stirring with the raisins until smooth."
    },
    {
      "step": 4,
      "text": "Cut the dough into small pieces. Coat the pieces with the white sugar and packed brown sugar, then layer them in the prepared pan."
    },
    {
      "step": 5,
      "text": "Pour the margarine mixture over the dough and bake for 25 minutes, until golden brown.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Cool briefly, then serve warm."
    }
  ],
