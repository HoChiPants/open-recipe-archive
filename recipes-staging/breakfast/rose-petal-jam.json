  "id": "rose-petal-jam",
  "name": "Rose Petal Jam",
  "subtitle": "Floral jam with bright lemon flavor",
  "description": "Rose petals, lemon, sugar, and pectin cook into a fragrant spread for toast, pastries, or breakfast breads.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 32,
