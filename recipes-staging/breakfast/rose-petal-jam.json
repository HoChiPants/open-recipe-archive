    "inactive_minutes": 1440
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-rose-petals",
      "item": "fresh rose petals",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "white base trimmed off"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "juice-of-2-lemons",
      "item": "juice of 2 lemons",
      "quantity": 0.33000001311302,
      "unit": "cup"
    },
    {
