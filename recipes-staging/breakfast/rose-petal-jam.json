      "preparation": "1.75 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the rose petals, lemon juice, and half of the sugar. Toss until evenly coated, cover, and refrigerate for 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 2,
      "text": "Place the water and remaining sugar in a saucepan. Bring to a boil, stirring until the sugar dissolves.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Add the macerated petals and cook until the mixture has reduced and the petals are tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the pectin and cook for 1 minute, stirring continuously.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Transfer the hot jam to clean containers and let it cool before covering and refrigerating."
    }
  ],
