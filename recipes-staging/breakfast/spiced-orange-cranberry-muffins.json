  "id": "spiced-orange-cranberry-muffins",
  "name": "Spiced Orange Cranberry Muffins",
  "subtitle": "Tender muffins with citrus, warm spices, cranberries, and chocolate",
  "description": "A lightly spiced muffin with orange zest and juice, dried cranberries, chopped chocolate, and a simple orange icing.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
