  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a 12-cup muffin tin. Melt the butter and let it cool for about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the flour, bicarbonate of soda, caster sugar, cinnamon, nutmeg, and icing sugar in a large bowl. Stir in the pearl sugar if using."
    },
    {
      "step": 3,
      "text": "In another bowl, whisk the melted butter, yogurt, vanilla, and eggs. Mix in the orange zest and juice."
    },
    {
      "step": 4,
      "text": "Add the wet mixture to the dry ingredients and stir just until combined. Fold in the chopped chocolate and cranberries."
    },
    {
      "step": 5,
      "text": "Divide the batter among the muffin cups and bake for 30 minutes, until risen and a thermometer inserted in the center reads 160°F or the centers are firm and fully set.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool the muffins in the tin for 5 minutes, then transfer them to a rack and cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Stir the remaining icing sugar with enough orange juice to make a drizzle. Spoon it over the cooled muffins and finish with pearl sugar if using."
    },
    {
      "step": 8,
      "text": "Let the icing set before serving."
    }
  ],
