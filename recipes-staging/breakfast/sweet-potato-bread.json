  "id": "sweet-potato-bread",
  "name": "Sweet Potato Bread",
  "subtitle": "A warmly spiced loaf with a nutty finish",
  "description": "Mashed sweet potato, cinnamon, nutmeg, and pecans make a tender, gently spiced bread with a sweet sugar topping.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 125
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-potato",
      "item": "sweet potato",
      "quantity": 1
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 1.6666667461395,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
