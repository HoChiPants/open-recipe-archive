      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Bake the sweet potato for 60 minutes, then cool until set. Peel and mash the flesh.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Whisk the white sugar, canola oil, and brown sugar. Beat in the eggs."
    },
    {
      "step": 3,
      "text": "Stir together the sifted flour, cinnamon, and nutmeg. Gradually whisk in the water, then mix in the mashed sweet potato."
    },
    {
      "step": 4,
      "text": "Fold in the chopped pecans. Heat the oven to 320°F and coat a baking pan with cooking spray."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the pan and bake for 60 minutes, until the center is fully set or reaches 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Warm the white sugar, brown sugar, and butter together for 5 minutes. Combine with the pecans and transfer the mixture over the baked bread.",
      "timer_minutes": 5
    }
  ],
