  "id": "banana-coconut-and-cardamom-bread",
  "name": "Banana, Coconut and Cardamom Bread",
  "subtitle": "A fragrant loaf with ripe banana and warm cardamom",
  "description": "A tender, lightly spiced banana loaf enriched with coconut oil or butter and yogurt.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "coconut-oil-or-butter",
      "item": "coconut oil or butter",
      "quantity": 125,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "very-ripe-bananas",
      "item": "very ripe bananas",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "unit": "medium"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "coconut-yogurt-or-natural-yogurt",
      "item": "coconut yogurt or natural yogurt",
      "quantity": 2,
      "unit": "tbsp",
      "preparation": "plus extra to serve"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "seeds-from-12-cardamom-pods-crushed",
      "item": "seeds from 12 cardamom pods crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F (180°C). Grease a loaf tin with some of the coconut oil or butter and prepare it for the batter."
    },
    {
      "step": 2,
      "text": "Melt the coconut oil or butter with the yogurt in the microwave until fluid, then let it cool briefly."
    },
    {
      "step": 3,
      "text": "Mash the bananas in a bowl. Whisk in the eggs, sugar, and melted yogurt mixture until smooth."
    },
    {
      "step": 4,
      "text": "Combine the flour, baking powder, and crushed cardamom seeds, then fold the dry mixture into the banana mixture just until combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared tin and bake until the loaf is risen, firm in the center, and a thermometer inserted into the center reads at least 160°F because it contains eggs.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Leave the loaf in the tin for 10 minutes, then cool before slicing. Serve with extra yogurt.",
      "timer_minutes": 10
    }
  ],
