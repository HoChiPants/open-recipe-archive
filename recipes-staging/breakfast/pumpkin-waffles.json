  "instructions": [
    {
      "step": 1,
      "text": "Preheat the waffle iron according to its instructions."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, brown sugar, baking powder, 2 teaspoons cinnamon, allspice, ginger, salt, and white sugar."
    },
    {
      "step": 3,
      "text": "Stir the milk, pumpkin, and egg yolks into the dry mixture, then blend in the melted butter until smooth."
    },
    {
      "step": 4,
      "text": "Beat the egg whites with the remaining white sugar until soft peaks form. Fold the whites into the batter in two additions."
    },
    {
      "step": 5,
      "text": "Cook the batter in the preheated waffle iron until the waffles are browned and release easily."
    },
    {
      "step": 6,
      "text": "For the sauce, stir together the brown sugar, 1 teaspoon cinnamon, white sugar, and cornstarch in a saucepan. Add the cider and lemon juice, stirring until smooth."
    },
    {
      "step": 7,
      "text": "Bring the sauce to a boil and cook for 2 minutes, stirring. Stir in the 2 tablespoons butter until melted.",
      "timer_minutes": 2
    },
    {
      "step": 8,
      "text": "Serve the waffles warm with the apple cider sauce."
    }
  ],
