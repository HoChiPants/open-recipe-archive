  "instructions": [
    {
      "step": 1,
      "text": "Mash the bananas in a bowl until smooth."
    },
    {
      "step": 2,
      "text": "Add the oats, cinnamon, maple syrup, milk, and nut butter. Stir until evenly combined and creamy."
    },
    {
