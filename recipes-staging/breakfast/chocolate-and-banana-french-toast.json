      "item": "icing sugar or extra maple syrup",
      "preparation": "to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Slice the banana and prepare the chopped chocolate. Cut a pocket into each bread slice without cutting through the edges, then fill the pockets with banana and chocolate."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, double cream, maple syrup, vanilla extract, and optional icing sugar or extra maple syrup in a shallow dish."
    },
    {
      "step": 3,
      "text": "Melt the butter in a frying pan over medium heat. Dip each filled bread slice into the egg mixture, coating both sides without soaking it through."
    },
    {
      "step": 4,
      "text": "Cook the coated slices in the butter until golden brown, turning as needed. Cook until the centers are firm and reach 160°F.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Serve immediately with ground cinnamon and optional icing sugar or extra maple syrup."
    }
  ],
