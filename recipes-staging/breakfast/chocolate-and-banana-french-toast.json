  "id": "chocolate-and-banana-french-toast",
  "name": "Chocolate and Banana French Toast",
  "subtitle": "Crisp stuffed toast with warm banana and chocolate",
  "description": "Bread filled with banana and milk chocolate is dipped in vanilla custard, pan-cooked in butter, and finished with cinnamon and a sweet topping.",
  "meal_type": "breakfast",
  "cuisine": "French",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
