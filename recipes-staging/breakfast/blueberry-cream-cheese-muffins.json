  "id": "blueberry-cream-cheese-muffins",
  "name": "Blueberry Cream Cheese Muffins",
  "subtitle": "Tender muffins with cream cheese and fresh blueberries",
  "description": "Soft, lightly sweet muffins combining whipped cream cheese, table cream, and blueberries.",
