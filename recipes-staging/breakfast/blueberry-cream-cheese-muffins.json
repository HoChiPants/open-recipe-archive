  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Coat a 12-cup muffin pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, baking powder, baking soda, and salt."
    },
    {
      "step": 3,
      "text": "Beat the sugar, whipped cream cheese, table cream, eggs, and both measures of vegetable oil until combined."
    },
    {
      "step": 4,
      "text": "Fold the dry mixture into the cream cheese mixture until smooth, then stir in the blueberries."
    },
    {
      "step": 5,
      "text": "Divide the batter among the prepared muffin cups."
    },
    {
      "step": 6,
      "text": "Bake for 15 minutes, until golden brown.",
      "timer_minutes": 15
    }
  ],
