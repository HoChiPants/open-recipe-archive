  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Warm the olive oil in an oven-safe skillet over medium heat. Add the sweet potato and cook until tender.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Transfer the sweet potato to a plate. Add the sausage to the skillet and cook until browned.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Return the sweet potato to the skillet. Add the onion, red bell pepper, green onion, salt, and pepper; cook until the vegetables are tender.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the mushrooms and kale, and cook until the kale softens.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Whisk the eggs, water, and dried thyme with the salt and pepper. Stir the sausage mixture into the egg mixture, then return everything to the skillet."
    },
    {
      "step": 7,
      "text": "Bake until the center is firm and fully set and a thermometer inserted into the center reads 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 8,
      "text": "Let the bake rest briefly, then garnish with the onion and green onion.",
      "timer_minutes": 5
    }
  ],
