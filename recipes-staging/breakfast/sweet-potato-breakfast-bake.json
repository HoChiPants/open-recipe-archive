  "id": "sweet-potato-breakfast-bake",
  "name": "Sweet Potato Breakfast Bake",
  "subtitle": "A savory vegetable and sausage egg bake",
  "description": "Sweet potato, sausage, vegetables, kale, and seasoned eggs come together in a simple oven-finished breakfast.",
