      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "complete-buttermilk-pancake-mix",
      "item": "complete buttermilk pancake mix",
      "quantity": 3.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "mini-chocolate-chips",
      "item": "mini chocolate chips",
      "quantity": 0.5,
      "unit": "cup"
