    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F and prepare a baking sheet with cooking spray."
    },
    {
      "step": 2,
      "text": "Stir the complete buttermilk pancake mix and water together until combined. Let the batter rest for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Pour the batter onto the prepared baking sheet and scatter the mini chocolate chips, bananas, strawberries, and blueberries over the top."
    },
    {
      "step": 4,
      "text": "Bake until the pancake is set, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Switch to the grill or broiler setting and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Cool for 2 minutes, then cut into portions and serve.",
      "timer_minutes": 2
    }
  ],
