  "id": "buttermilk-baking-sheet-pancakes",
  "name": "Buttermilk Baking Sheet Pancakes",
  "subtitle": "A fruit-and-chocolate-chip pancake baked in one pan",
  "description": "Mix the batter, top it with fruit and mini chocolate chips, then bake and briefly grill until set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
