  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "brown-sugar-banana-bread",
  "name": "Brown Sugar Banana Bread",
  "subtitle": "Moist banana loaf with warm cinnamon flavor",
  "description": "A simple, tender banana bread sweetened with brown sugar and finished with cinnamon and vanilla.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "ripe-bananas",
      "item": "ripe bananas",
      "quantity": 4,
      "preparation": "cut into chunks"
    },
    {
      "ingredient_id": "light-brown-sugar",
      "item": "light brown sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "jumbo-egg",
      "item": "jumbo egg",
      "quantity": 1
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "cinnamon",
      "item": "cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a loaf pan for the batter."
    },
    {
      "step": 2,
      "text": "Mash the banana chunks until mostly smooth."
    },
    {
      "step": 3,
      "text": "Beat the softened butter and light brown sugar together for 2 minutes. Add the egg and mix until combined.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the mashed bananas, milk, cinnamon, and vanilla until evenly blended."
    },
    {
      "step": 5,
      "text": "Whisk the flour, baking powder, baking soda, and salt in a separate bowl.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Add the dry mixture to the banana mixture and stir just until smooth. Transfer the batter to the prepared pan."
    },
    {
      "step": 7,
      "text": "Bake for 40 minutes, until lightly browned and the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    }
  ],
