  "instructions": [
    {
      "step": 1,
      "text": "Combine 1 cup brown sugar, 0.5 cup butter, and 2 tablespoons light corn syrup; cook until thickened."
    },
    {
      "step": 2,
      "text": "Spread the caramel mixture in a prepared baking dish and scatter over half of the chopped pecans."
    },
    {
      "step": 3,
      "text": "Arrange the bread slices over the pecans, then top with the remaining pecans."
    },
    {
      "step": 4,
      "text": "Whisk the eggs, milk, cinnamon, vanilla, nutmeg, and salt until smooth. Pour evenly over the bread."
    },
    {
      "step": 5,
      "text": "Cover and refrigerate for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 6,
      "text": "Let the assembled dish stand at room temperature for 30 minutes, then heat the oven to 350°F.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Bake for 45 minutes, until lightly browned and the center is fully set; verify with a thermometer that the egg mixture reaches 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Combine 0.5 cup brown sugar, 0.25 cup butter, and 1 tablespoon light corn syrup; cook until thickened and prepare as a finishing sauce for the baked French toast."
    }
  ],
