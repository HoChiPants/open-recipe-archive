  "id": "blackberry-and-apple-oat-bake",
  "name": "Blackberry and Apple Oat Bake",
  "subtitle": "Warm baked oats with spiced apples, berries, and pecans",
  "description": "A fruit-filled oat bake infused with cinnamon and cardamom, finished with milk or yogurt and maple syrup.",
