  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a suitable baking dish."
    },
    {
      "step": 2,
      "text": "Warm the semi-skimmed milk with the cinnamon sticks and bashed cardamom pods. Simmer for 12 minutes, then remove from the heat and let it stand for 15 minutes. Strain out the spices.",
      "timer_minutes": 27
    },
    {
      "step": 3,
      "text": "Combine the oats, vanilla extract, baking powder, beaten egg, chopped pecans, and blackberries. Stir in the spiced milk and cubed apples."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared dish and bake for 35 minutes, until the center is fully set and reaches 160°F.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Serve warm with milk or fat-free yogurt and maple syrup."
    }
  ],
