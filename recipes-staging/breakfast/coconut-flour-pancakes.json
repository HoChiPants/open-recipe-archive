  "id": "coconut-flour-pancakes",
  "name": "Coconut Flour Pancakes",
  "subtitle": "Light pancakes with warm berry topping",
  "description": "Tender coconut flour pancakes served with maple-sweetened warm berries.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
