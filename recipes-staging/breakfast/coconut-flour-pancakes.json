  "instructions": [
    {
      "step": 1,
      "text": "Whisk the egg whites to stiff peaks."
    },
    {
      "step": 2,
      "text": "In a separate bowl, whisk the coconut flour, baking powder, cinnamon, milk, maple syrup, and egg yolks until smooth."
    },
    {
      "step": 3,
      "text": "Fold the whipped egg whites into the batter."
    },
    {
      "step": 4,
      "text": "Preheat a nonstick pan over medium heat."
    },
    {
      "step": 5,
      "text": "Add portions of batter to the pan and cook until the bottoms are set and golden.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Turn the pancakes and cook until golden and fully set in the centers."
    },
    {
      "step": 7,
      "text": "Prepare the topping by microwaving the maple syrup and frozen berries until warm.",
      "timer_minutes": 2
    },
    {
      "step": 8,
      "text": "Serve the pancakes with the warm berries."
    }
  ],
