  "id": "cranberry-scones",
  "name": "Cranberry Scones",
  "subtitle": "Tender orange-cranberry scones with walnuts",
  "description": "A lightly spiced scone dough studded with tart cranberries, orange zest, and walnuts, baked until golden and fully set.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chilled and diced"
    },
    {
      "ingredient_id": "fresh-cranberries",
      "item": "fresh cranberries",
      "quantity": 1,
      "unit": "cup",
      "preparation": "roughly chopped"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-zest-of-one-orange",
      "item": "grated zest of one orange",
      "quantity": 1
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "half-and-half-cream",
      "item": "half-and-half cream",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Stir together the flour, brown sugar, baking powder, nutmeg, salt, and white sugar. Cut in the chilled butter until the mixture is crumbly."
    },
    {
      "step": 3,
      "text": "Toss the cranberries, orange zest, and walnuts with the flour mixture."
    },
    {
      "step": 4,
      "text": "Whisk the half-and-half with the egg, then add it to the dry ingredients. Combine just until a dough forms."
    },
    {
      "step": 5,
      "text": "Transfer the dough to a lightly floured surface and knead briefly. Shape it into a round, then cut it into 12 wedges."
    },
    {
      "step": 6,
      "text": "Transfer the wedges to a baking sheet and bake for 20 minutes, until golden brown and the center is fully set; verify the egg-containing dough reaches 160°F.",
      "timer_minutes": 20
    }
  ],
