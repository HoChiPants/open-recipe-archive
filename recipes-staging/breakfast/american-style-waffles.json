  "id": "american-style-waffles",
  "name": "American-Style Waffles",
  "subtitle": "Crisp-edged waffles with a tender center",
  "description": "A simple American-style waffle batter made with flour, milk, eggs, butter, and vanilla, cooked until golden in a preheated waffle iron.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
