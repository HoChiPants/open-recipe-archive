  "instructions": [
    {
      "step": 1,
      "text": "Preheat the waffle iron according to its instructions."
    },
    {
      "step": 2,
      "text": "Whisk the plain flour, salt, baking powder, and caster sugar together in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the eggs. Stir in the warm milk, butter melted, and vanilla extract."
    },
    {
      "step": 4,
      "text": "Pour the wet mixture into the dry mixture and whisk until just combined."
    },
    {
      "step": 5,
      "text": "Prepare the waffle iron as needed, add enough batter to cover the plates, and cook until the waffle is golden and set.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Repeat with the remaining batter and serve warm."
    }
  ],
