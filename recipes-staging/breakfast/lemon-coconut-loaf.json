{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "lemon-coconut-loaf",
  "name": "Lemon Coconut Loaf",
  "subtitle": "A tender loaf with bright lemon and coconut flavor",
  "description": "Bake a lemon-scented coconut loaf, then finish it with a simple lemon glaze.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1,
      "preparation": "juiced and zested"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.75,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease and prepare a loaf pan."
    },
    {
      "step": 2,
      "text": "Cream the softened butter with the white sugar until smooth. Beat in the eggs one at a time, then mix in the lemon zest and juice."
    },
    {
      "step": 3,
      "text": "Whisk the flour, baking powder, and salt in a separate bowl. Add the dry mixture to the butter mixture alternately with the milk, mixing just until combined."
    },
    {
      "step": 4,
      "text": "Fold in the flaked coconut and transfer the batter to the prepared pan."
    },
    {
      "step": 5,
      "text": "Bake until the loaf is set and a tester comes out clean, about 65 minutes.",
      "timer_minutes": 65
    },
    {
      "step": 6,
      "text": "Cool the loaf in the pan for 10 minutes, then transfer it to a rack to cool completely.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Whisk the confectioners' sugar with the lemon juice, adding more juice as needed for a pourable glaze."
    },
    {
      "step": 8,
      "text": "Drizzle the glaze over the cooled loaf, let it set briefly, and slice."
    }
  ],
