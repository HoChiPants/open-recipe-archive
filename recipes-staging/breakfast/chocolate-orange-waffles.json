  "instructions": [
    {
      "step": 1,
      "text": "Preheat the waffle iron according to its instructions."
    },
    {
      "step": 2,
      "text": "Whisk the eggs and milk together in a mixing bowl."
    },
    {
      "step": 3,
      "text": "Add the sifted self-raising flour, sifted cocoa powder, and caster sugar; whisk until smooth."
    },
    {
      "step": 4,
      "text": "Stir in the melted butter, orange essence, orange zest, and roughly chopped dark chocolate."
    },
    {
      "step": 5,
      "text": "Cook the batter in the preheated waffle iron until the waffles are set and cooked through, about 6 minutes per batch.",
      "timer_minutes": 6
    },
    {
      "step": 6,
      "text": "Serve with segmented maple syrup, grated chocolate, and whipped cream."
    }
  ],
