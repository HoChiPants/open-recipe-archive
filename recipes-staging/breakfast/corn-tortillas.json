{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "corn-tortillas",
  "name": "Corn Tortillas",
  "subtitle": "Soft, pliable tortillas made with masa harina",
  "description": "Make fresh corn tortillas by mixing, resting, shaping, and griddling a simple masa dough.",
  "meal_type": "breakfast",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 10,
    "inactive_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "masa-harina",
      "item": "masa harina",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "hot-tap-water",
      "item": "hot tap water",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "about 130 degrees F (55 degrees C)"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the masa harina, hot water, and salt. Stir until a dough forms, then knead until smooth, adding the remaining hot water as needed for a soft, workable dough."
    },
    {
      "step": 2,
      "text": "Cover the dough and let it rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Divide the dough into 10 equal portions. Press each portion between sheets of plastic or parchment until thin and round."
    },
    {
      "step": 4,
      "text": "Heat a dry skillet or griddle over medium-high heat."
    },
    {
      "step": 5,
      "text": "Cook the tortillas in batches until set and lightly browned in spots, about 1 minute per side, turning as needed.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Transfer cooked tortillas to a clean towel, fold the towel over them, and keep covered for 15 minutes before serving.",
      "timer_minutes": 15
    }
  ],
