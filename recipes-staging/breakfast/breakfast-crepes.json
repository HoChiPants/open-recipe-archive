{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "breakfast-crepes",
  "name": "Breakfast Crepes",
  "subtitle": "Thin, tender crepes for a simple morning meal",
  "description": "A basic French-style crepe batter cooked in a skillet until lightly set and ready to serve.",
  "meal_type": "breakfast",
  "cuisine": "French",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, milk, and salt until smooth. Add the egg and whisk until fully combined."
    },
    {
      "step": 2,
      "text": "Preheat a skillet over medium heat and coat its surface with melted fat."
    },
    {
      "step": 3,
      "text": "Pour in enough batter to make a thin crepe, tilting the skillet to spread it into a smooth layer."
    },
    {
      "step": 4,
      "text": "Cook until the edges are set and the underside is lightly browned, then turn and cook the other side. The center should be fully set and reach 160°F."
    },
    {
      "step": 5,
      "text": "Let each crepe rest briefly before serving.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Serve warm."
    }
  ],
  "tags": [
    "breakfast",
    "crepes",
    "french"
  ],
