  "id": "egg-and-spinach-casserole",
  "name": "Egg and Spinach Casserole",
  "subtitle": "A savory baked egg dish with spinach and two cheeses",
  "description": "Combine eggs, spinach, cottage cheese, Cheddar, and onion for a hearty casserole that bakes until golden and fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed and drained"
    },
    {
      "ingredient_id": "small-curd-cottage-cheese",
      "item": "small curd cottage cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce, shredded"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Whisk the beaten eggs with the onion and flour until evenly blended."
    },
    {
      "step": 3,
      "text": "Stir in the spinach, cottage cheese, Cheddar, melted butter, salt, and pepper until combined."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared baking dish."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, until golden brown and the center is firm and fully set. Confirm the center reaches 160°F with a food thermometer.",
      "timer_minutes": 45
    }
  ],
