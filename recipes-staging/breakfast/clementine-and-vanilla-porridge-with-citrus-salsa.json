  "instructions": [
    {
      "step": 1,
      "text": "Peel and separate the clementines. Combine them with the chopped grapefruit and mint leaves, then chill until serving."
    },
    {
      "step": 2,
      "text": "Combine the porridge oats and vanilla extract, and cook until the porridge is thick.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Transfer the porridge to four bowls and top with the yogurt, citrus salsa, sunflower seeds, and broken walnuts."
    }
