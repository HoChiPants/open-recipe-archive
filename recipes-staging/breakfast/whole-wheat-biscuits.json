  "id": "whole-wheat-biscuits",
  "name": "Whole Wheat Biscuits",
  "subtitle": "Tender, lightly sweetened biscuits with a hearty wheat flavor",
  "description": "A simple batch of buttermilk biscuits combining all-purpose and whole wheat flour for a tender, rustic breakfast bake.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "whole-wheat-flour",
      "item": "whole wheat flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 4,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 450°F. Combine both flours, baking powder, sugar, and salt in a bowl."
    },
    {
      "step": 2,
      "text": "Cut the butter into the dry mixture until the texture is crumbly, then stir in the buttermilk to form a soft dough."
    },
    {
      "step": 3,
      "text": "Turn the dough onto a lightly floured surface and knead briefly. Pat it into a thick round and cut out 12 biscuits."
    },
    {
      "step": 4,
      "text": "Arrange the biscuits on a baking surface and bake until lightly browned, about 12 minutes.",
      "timer_minutes": 12
    }
  ],
