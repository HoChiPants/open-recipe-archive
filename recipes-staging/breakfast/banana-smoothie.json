  "instructions": [
    {
      "step": 1,
      "text": "Add the banana, milk, vanilla extract, egg, and sugar to a blender."
    },
    {
      "step": 2,
      "text": "Blend until smooth. If the egg is not pasteurized, transfer the mixture to a saucepan and heat, stirring, until it reaches 160°F on a food thermometer."
    },
    {
      "step": 3,
      "text": "Pour into a glass and sprinkle with ground cinnamon."
    }
