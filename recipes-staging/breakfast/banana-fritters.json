      "item": "confectioners' sugar for dusting",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, white sugar, baking powder, salt, cinnamon, nutmeg, and confectioners' sugar in a bowl."
    },
    {
      "step": 2,
      "text": "Mash the bananas separately. Beat the eggs, milk, and melted margarine until smooth, then mix in the bananas."
    },
    {
      "step": 3,
      "text": "Stir the flour mixture into the wet mixture just until a thick batter forms."
    },
    {
      "step": 4,
      "text": "Heat the frying oil to 375°F."
    },
    {
      "step": 5,
      "text": "Fry spoonfuls of batter in batches until golden and cooked through, turning as needed; the full cooking operation takes about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Drain the fritters and dust them with confectioners' sugar before serving."
    }
  ],
