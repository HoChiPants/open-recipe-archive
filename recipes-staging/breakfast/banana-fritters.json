      "quantity": 2
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "melted"
    },
    {
      "ingredient_id": "oil-for-frying",
      "item": "oil for frying",
      "quantity": 1,
      "unit": "quart"
    },
    {
