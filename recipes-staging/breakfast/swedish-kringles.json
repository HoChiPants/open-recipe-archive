  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Cut 0.5 cup butter into 1 cup flour until crumbly, then mix in 1 tablespoon water, or enough to form a dough."
    },
    {
      "step": 2,
      "text": "Shape the dough into two long strips on a baking sheet and set aside."
    },
    {
      "step": 3,
      "text": "Heat 1 cup water with the remaining butter until the butter melts. Stir in the remaining flour and cook, stirring, until smooth."
    },
    {
      "step": 4,
      "text": "Whisk in the eggs one at a time, then stir in 1 teaspoon almond extract. Spread the mixture over the dough strips."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until puffed and the center is firm and fully set.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Combine the confectioners' sugar, heavy cream, softened butter, and remaining almond extract until smooth. Spread the glaze over the warm pastries before serving."
    }
  ],
