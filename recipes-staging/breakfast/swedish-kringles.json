  "id": "swedish-kringles",
  "name": "Swedish Kringles",
  "subtitle": "A tender almond pastry with a simple cream glaze",
  "description": "Layer a buttery flour pastry with a cooked almond batter, bake until firm, and finish with a smooth confectioners’ sugar glaze.",
  "meal_type": "breakfast",
