      "item": "jam and clotted cream to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a baking sheet."
    },
    {
      "step": 2,
      "text": "Combine the flour and baking powder. Rub in the cubed butter until the mixture resembles fine crumbs, then stir in the sugar."
    },
    {
      "step": 3,
      "text": "Warm the milk, then stir in the vanilla and lemon juice."
    },
    {
      "step": 4,
      "text": "Pour the warm milk mixture into the dry ingredients and fold gently until a soft dough forms."
    },
    {
      "step": 5,
      "text": "Turn the dough onto a floured surface, knead briefly until smooth, and pat it to an even thickness. Cut out eight scones and place them on the baking sheet."
    },
    {
      "step": 6,
      "text": "Brush the tops with the beaten egg and chill the shaped scones for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Bake for 10 minutes, until risen and golden with a fully set center; if checked with a thermometer, the egg-containing center should reach 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Serve with jam and clotted cream."
    }
  ],
