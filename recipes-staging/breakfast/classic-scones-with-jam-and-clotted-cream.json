  "id": "classic-scones-with-jam-and-clotted-cream",
  "name": "Classic Scones with Jam and Clotted Cream",
  "subtitle": "Tender British scones for a simple cream tea",
  "description": "Light, buttery scones served warm with jam and clotted cream.",
  "meal_type": "breakfast",
  "cuisine": "British",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
