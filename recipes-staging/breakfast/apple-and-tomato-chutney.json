  "id": "apple-and-tomato-chutney",
  "name": "Apple and Tomato Chutney",
  "subtitle": "A tangy, spiced fruit-and-tomato relish",
  "description": "Apples, tomatoes, onions, vinegar, raisins, and curry spices cook slowly into a thick chutney.",
  "meal_type": "breakfast",
  "cuisine": "Indian",
  "yield": {
    "quantity": 75,
