  "instructions": [
    {
      "step": 1,
      "text": "Place the apples and water in a large saucepan and simmer for 25 minutes, until the apples are tender.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Add the tomatoes, onions, malt vinegar, sugar, raisins, curry powder, salt, mustard seed, cayenne, and garlic; stir until evenly combined and the sugar dissolves."
    },
    {
      "step": 3,
      "text": "Keep the mixture at a gentle simmer for 3 hours, stirring occasionally, until thick.",
      "timer_minutes": 180
    }
  ],
