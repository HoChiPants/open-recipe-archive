      "item": "apples",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "peeled, cored and sliced"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "tomato",
