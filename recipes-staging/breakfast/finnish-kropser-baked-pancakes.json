  "id": "finnish-kropser-baked-pancakes",
  "name": "Finnish Kropser Baked Pancakes",
  "subtitle": "A tender oven-baked pancake for sharing",
  "description": "A simple Finnish-style baked pancake made with a lightly sweetened batter and buttered pan.",
  "meal_type": "breakfast",
  "yield": {
