    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Stir together the sugar, salt, and flour in a mixing bowl."
    },
    {
      "step": 3,
      "text": "Add the eggs and milk, then whisk until the batter is smooth."
    },
    {
      "step": 4,
      "text": "Prepare the butter and stir it into the batter."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a suitable baking dish and bake for 30 minutes, until puffed and the center is firm and fully set.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cut into portions and serve."
    }
  ],
