  "id": "overnight-cinnamon-rolls",
  "name": "Overnight Cinnamon Rolls",
  "subtitle": "Soft cinnamon rolls prepared the night before",
  "description": "A make-ahead yeast dough is filled with cinnamon, brown sugar, raisins, and pecans, then baked and finished with a simple vanilla glaze.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
