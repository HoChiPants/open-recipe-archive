  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk with the butter until the butter melts. Let the mixture cool to about 110°F, then stir in the yeast and rest for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mix in the white sugar, 2 cups of the flour, salt, and eggs. Add enough of the remaining flour to form a soft dough, then knead with the light corn syrup until smooth, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Coat the dough lightly with the light corn syrup, cover, and let it rise in a warm place until doubled, about 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Prepare a baking dish. Combine the brown sugar, ground cinnamon, raisins, pecans, and a portion of the confectioners' sugar for the filling."
    },
    {
      "step": 5,
      "text": "Roll the dough into a rectangle, spread the filling over it, and roll it up from one long side. Cut into 12 pieces and arrange them in the prepared dish. Cover and refrigerate overnight, about 9 1/2 hours.",
      "timer_minutes": 570
    },
    {
      "step": 6,
      "text": "Heat the oven to 375°F and let the rolls stand at room temperature for about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Bake for 30 minutes, until browned and the center is fully set, reaching at least 160°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Stir the light corn syrup with the vanilla extract. Whisk in the sifted confectioners' sugar and half-and-half cream until thick, then spread the glaze over the warm rolls."
    }
  ],
