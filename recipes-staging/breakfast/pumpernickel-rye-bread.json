  "id": "pumpernickel-rye-bread",
  "name": "Pumpernickel Rye Bread",
  "subtitle": "A dark, hearty loaf with rye, cocoa, coffee, and caraway",
  "description": "Make a richly flavored rye loaf by combining the seasoned flours with sweetened yeast water, kneading until cohesive, proofing, shaping, and baking.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
