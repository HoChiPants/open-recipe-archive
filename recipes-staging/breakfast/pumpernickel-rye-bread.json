  "instructions": [
    {
      "step": 1,
      "text": "Stir the warm water, vegetable oil, molasses, and active dry yeast together. Let stand briefly until the yeast is moistened."
    },
    {
      "step": 2,
      "text": "Combine the bread flour, rye flour, whole wheat flour, vital wheat gluten, salt, dry milk powder, instant coffee powder, cocoa powder, and caraway seed."
    },
    {
      "step": 3,
      "text": "Add the dry mixture to the liquid mixture and knead until a cohesive, elastic dough forms."
    },
    {
      "step": 4,
      "text": "Shape the dough into a loaf and place it in a prepared loaf pan or on a baking surface."
    },
    {
      "step": 5,
      "text": "Cover and let rise until visibly puffy, allowing about 60 minutes for the shaped loaf.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Preheat the oven to the temperature appropriate for a standard loaf of rye bread."
    },
    {
      "step": 7,
      "text": "Bake for 45 minutes, until the loaf is firm and fully baked through.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Cool the bread completely before slicing."
    }
  ],
