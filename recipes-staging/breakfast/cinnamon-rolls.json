  "instructions": [
    {
      "step": 1,
      "text": "Mix the flour, yeast, 1 tsp cinnamon, caster sugar, warm milk, eggs, and softened butter into a dough. Knead until smooth, then chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Combine the brown sugar and 2 tbsp cinnamon for the filling. Whisk the room-temperature butter until thick and spreadable."
    },
    {
      "step": 3,
      "text": "Roll the dough on a lightly floured surface into a rectangle. Spread with the butter, scatter over the cinnamon sugar, drizzle with the golden syrup, and fold or roll to enclose the filling."
    },
    {
      "step": 4,
      "text": "Chill the shaped dough for 30 minutes, then cut it into 12 firm pieces and arrange them in a buttered tin.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Leave the rolls to rise for 60 minutes. Preheat the oven while they finish rising.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Bake until risen and golden, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Warm the remaining golden syrup until boiling, then cool it slightly and brush it over the baked rolls."
    },
    {
      "step": 8,
      "text": "Whisk the soft cheese, icing sugar, vanilla, and remaining caster sugar until smooth. Spread over the cooled rolls."
    }
  ],
