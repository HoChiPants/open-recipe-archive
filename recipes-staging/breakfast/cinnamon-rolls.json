  "id": "cinnamon-rolls",
  "name": "Cinnamon Rolls",
  "subtitle": "Soft spirals with cinnamon filling and cream-cheese topping",
  "description": "Tender enriched rolls layered with cinnamon sugar, baked until golden, and finished with a smooth vanilla cream-cheese topping.",
  "meal_type": "breakfast",
