  "instructions": [
    {
      "step": 1,
      "text": "Cook the rice in boiling water according to the package directions until tender. Drain if needed and set aside."
    },
    {
      "step": 2,
      "text": "Heat a little oil in a large skillet or saucepan. Cook the chopped tomatoes for 7 minutes, until softened.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Add the garlic, spring onions, chopped chillies, oregano, cumin, and pickled chillies. Cook for 2 minutes, stirring.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the black beans and lime juice, then add the cooked rice. Mix until hot and evenly coated."
    },
    {
      "step": 5,
      "text": "Stir in the coriander and season to taste. Keep the rice mixture warm while frying the eggs."
    },
    {
      "step": 6,
      "text": "Heat extra oil in a skillet and fry the eggs until the whites are fully set and the centers reach 160°F for food safety."
    },
    {
      "step": 7,
      "text": "Divide the rice and beans among four servings. Top each with a fried egg and serve with the optional avocado and soured cream."
    }
  ],
