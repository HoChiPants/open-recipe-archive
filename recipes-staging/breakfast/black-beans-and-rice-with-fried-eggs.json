  "id": "black-beans-and-rice-with-fried-eggs",
  "name": "Black Beans and Rice with Fried Eggs",
  "subtitle": "A savory rice-and-bean breakfast topped with eggs and fresh garnishes.",
  "description": "Cook rice with a spiced tomato and black bean mixture, then finish each serving with a fried egg, lime, coriander, and optional toppings.",
  "meal_type": "breakfast",
