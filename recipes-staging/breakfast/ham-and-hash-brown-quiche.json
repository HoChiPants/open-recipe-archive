  "id": "ham-and-hash-brown-quiche",
  "name": "Ham and Hash Brown Quiche",
  "subtitle": "A crisp potato crust filled with ham, vegetables, cheese, and eggs.",
  "description": "A savory breakfast quiche with a buttery hash brown crust and a fully set egg filling.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-hash-brown-potatoes",
      "item": "frozen hash brown potatoes",
      "quantity": 3,
      "unit": "cups",
      "preparation": "thawed"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
