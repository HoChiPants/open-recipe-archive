      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Press the thawed hash brown potatoes into the bottom and up the sides of a pie dish to form a crust. Brush with the melted butter."
    },
    {
      "step": 2,
      "text": "Bake the potato crust for 25 minutes, then reduce the oven temperature to 350°F.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Combine the ham, Cheddar cheese, onion, and green bell pepper, then spread the mixture over the baked crust."
    },
    {
      "step": 4,
      "text": "Whisk the eggs, milk, salt, and ground black pepper until combined. Pour the egg mixture evenly over the filling."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until the center is firm and reaches 160°F on a food thermometer. Rest briefly before serving.",
      "timer_minutes": 30
    }
  ],
