  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, salt, and baking soda in a bowl."
    },
    {
      "step": 3,
      "text": "Cut in the shortening until the mixture is crumbly."
    },
    {
      "step": 4,
      "text": "Whisk the milk and sour cream together, then stir them into the dry mixture just until a dough forms."
    },
    {
      "step": 5,
      "text": "Turn the dough onto a lightly floured surface and knead briefly until cohesive."
    },
    {
      "step": 6,
      "text": "Pat or roll the dough to a suitable thickness and cut into six biscuits."
    },
    {
      "step": 7,
      "text": "Transfer the biscuits to a baking sheet and bake for 10 minutes, until lightly browned.",
      "timer_minutes": 10
    }
  ],
