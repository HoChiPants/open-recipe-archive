  "id": "sour-cream-biscuits",
  "name": "Sour Cream Biscuits",
  "subtitle": "Tender, quick biscuits with a lightly tangy crumb",
  "description": "Mix a simple flour-based dough with sour cream and milk, then bake until lightly browned.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
