  "id": "yeast-waffles",
  "name": "Yeast Waffles",
  "subtitle": "Crisp-edged waffles with a light, fermented batter",
  "description": "Prepare the yeast batter ahead, let it rest, then finish it with eggs and baking soda before cooking until golden brown.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15,
    "inactive_minutes": 500
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "warm-water-110-degrees-f-45-degrees-c",
      "item": "warm water (110 degrees F/45 degrees C)",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "unbleached-all-purpose-flour",
      "item": "unbleached all-purpose flour",
      "quantity": 3,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "slightly beaten"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk and keep the water at 110°F (45°C). Stir the yeast into the warm water and let it stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Combine the milk, yeast mixture, melted butter, salt, sugar, and sifted flour. Whisk until smooth."
    },
    {
      "step": 3,
      "text": "Cover the batter and let it rest for the inactive time."
    },
    {
      "step": 4,
      "text": "Preheat the waffle iron. Stir the beaten eggs and baking soda into the rested batter, then whisk until evenly combined."
    },
    {
      "step": 5,
      "text": "Cook the batter in the preheated waffle iron until the waffles are golden brown."
    }
  ],
