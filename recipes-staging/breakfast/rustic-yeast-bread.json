  "id": "rustic-yeast-bread",
  "name": "Rustic Yeast Bread",
  "subtitle": "A simple crusty loaf with a tender interior",
  "description": "Mix, rest, shape, and bake this straightforward yeast bread for a generous batch of homemade loaves.",
