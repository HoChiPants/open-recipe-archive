  "instructions": [
    {
      "step": 1,
      "text": "Stir the warm water, yeast, and salt together. Let stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Mix in the flour until a rough, cohesive dough forms. Cover and let it rest at room temperature for 5 hours.",
      "timer_minutes": 300
    },
    {
      "step": 3,
      "text": "Shape the dough as desired and place it on a surface dusted with cornmeal. Cover and let rise until set, about 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Heat the oven to 425°F."
    },
    {
      "step": 5,
      "text": "Bake the dough for 20 minutes, until golden brown.",
