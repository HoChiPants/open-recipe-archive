  ],
  "instructions": [
    {
      "step": 1,
      "text": "Juice half of the orange and slice it. Combine the orange pieces and juice with the raspberries and goji berries in a small saucepan."
    },
    {
      "step": 2,
      "text": "Simmer the raspberries and goji berries for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Warm the porridge oats and milk together until hot and creamy."
    },
    {
      "step": 4,
      "text": "Divide the oats between two bowls. Top with the raspberry mixture, orange, almond butter, banana, and chia seeds."
    }
  ],
