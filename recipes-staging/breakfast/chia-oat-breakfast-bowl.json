  "id": "chia-oat-breakfast-bowl",
  "name": "Chia & Oat Breakfast Bowl",
  "subtitle": "Warm oats with berries, fruit, and almond butter",
  "description": "A simple bowl combining warm oat porridge with simmered raspberries, citrus, banana, goji berries, chia seeds, and almond butter.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
