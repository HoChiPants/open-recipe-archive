      "unit": "tsp",
      "preparation": "toasted"
    },
    {
      "ingredient_id": "handful-of-mint-leaves",
      "item": "handful of mint leaves (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the thawed fruit, oats, and soya yogurt in a bowl or blender; mix until smooth."
    },
    {
      "step": 2,
      "text": "Divide the mixture among six serving bowls. Add the almond butter and chopped dark chocolate, then sprinkle with the toasted seed mix."
    },
    {
      "step": 3,
      "text": "Chill until ready to serve, then garnish with mint leaves if using."
    }
  ],
