  "id": "black-forest-breakfast-bowl",
  "name": "Black Forest Breakfast Bowl",
  "subtitle": "A cool, chocolate-fruit oat bowl with creamy soya yogurt.",
  "description": "Thawed dark-fruit mix, oats, and soya yogurt form a smooth base, finished with almond butter, dark chocolate, toasted seeds, and optional mint.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "bag-black-forest-frozen-fruit-mix-thawed",
      "item": "bag black forest frozen fruit mix thawed",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "porridge-oats",
      "item": "porridge oats",
      "quantity": 180,
      "unit": "g"
    },
    {
      "ingredient_id": "fortified-soya-yogurt",
      "item": "fortified soya yogurt",
      "quantity": 800,
      "unit": "g"
    },
    {
      "ingredient_id": "almond-butter",
      "item": "almond butter",
      "quantity": 6,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "85-dark-chocolate-chopped",
      "item": "85% dark chocolate chopped",
      "quantity": 15,
      "unit": "g"
    },
    {
      "ingredient_id": "three-seed-mix",
      "item": "three-seed mix",
