  "id": "cake-mix-cinnamon-rolls",
  "name": "Cake-Mix Cinnamon Rolls",
  "subtitle": "Soft cinnamon rolls with a pecan-sugar topping",
  "description": "A yeast-raised dough made with cake mix is rolled around cinnamon sugar, cut into spirals, and finished with a buttery pecan topping.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20,
    "inactive_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "warm-water",
      "item": "warm water",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 3,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "white-cake-mix",
      "item": "white cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "15.25 ounce"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped, or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour the warm water into a large bowl. Stir in the yeast and let it stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the cake mix and 2 cups of the flour; stir until combined. Add the remaining flour gradually and knead for 8 minutes, until the dough is smooth.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Coat the dough lightly, cover it, and let it rise in a warm place for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Roll the dough into a large rectangle. Spread with the softened butter, then sprinkle evenly with the brown sugar and cinnamon. Roll it up and cut into 16 pieces."
    },
    {
      "step": 5,
      "text": "Preheat the oven to 375°F. Arrange the rolls in a prepared baking pan."
    },
    {
      "step": 6,
      "text": "Mix the melted butter, cake mix, white sugar, brown sugar, and pecans. Spoon or spread the topping over the rolls."
    },
    {
      "step": 7,
      "text": "Let the assembled rolls rest for 30 minutes, then bake for 20 minutes, until golden brown.",
      "timer_minutes": 20
    }
  ],
