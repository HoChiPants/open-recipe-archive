  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "potato-brunch-casserole",
  "name": "Potato Brunch Casserole",
  "subtitle": "Creamy potatoes layered with cheese, bacon, and onion",
  "description": "Tender potatoes are combined with melted cheese, mayonnaise, bacon, and onion, then baked until hot and lightly browned.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "new-potatoes",
      "item": "new potatoes",
      "quantity": 4,
      "unit": "pounds",
      "preparation": "skinned, cut into 1-inch cubes"
    },
    {
      "ingredient_id": "processed-cheese-food",
      "item": "processed cheese food",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "bacon",
      "item": "bacon",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cooked crisp and chopped"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "finely chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the cubed potatoes in a pot, cover with water, and bring to a simmer. Cook until tender, then drain."
    },
    {
      "step": 3,
      "text": "Transfer the potatoes to a large bowl. Stir in the cubed cheese and warm gently, stirring until the cheese melts."
    },
    {
      "step": 4,
      "text": "Fold in the mayonnaise, chopped bacon, and onion, mixing until evenly combined."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to a baking dish and bake for 50 minutes, until hot throughout and bubbling at the edges.",
      "timer_minutes": 50
    }
  ],
