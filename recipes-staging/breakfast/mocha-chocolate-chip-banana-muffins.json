  "id": "mocha-chocolate-chip-banana-muffins",
  "name": "Mocha Chocolate Chip Banana Muffins",
  "subtitle": "Tender banana muffins with coffee and chocolate",
  "description": "Banana muffins flavored with instant coffee, vanilla, and semisweet chocolate chips.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
