  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare muffin cups for 18 muffins."
    },
    {
      "step": 2,
      "text": "Dissolve the coffee granules in the water. Mash the bananas."
    },
    {
      "step": 3,
      "text": "Beat the margarine, sugar, dissolved coffee, and vanilla for 2 minutes. Beat in the egg and mashed bananas.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Whisk together the flour, salt, baking powder, and baking soda, then fold the mixture into the wet ingredients until just combined."
    },
    {
      "step": 5,
      "text": "Fold in the chocolate chips and divide the batter among the muffin cups."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until the centers are firm and a thermometer inserted into a muffin registers 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Cool the muffins before serving."
    }
  ],
