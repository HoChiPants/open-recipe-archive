  "id": "brioche-350c4d17",
  "name": "Brioche",
  "subtitle": "Soft, buttery yeast bread for breakfast or brunch",
  "description": "Make a rich, tender brioche with a slow butter-enriched dough, two rises, and a glossy egg-washed crust.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "strong-white-flour",
      "item": "strong white flour",
      "quantity": 450,
      "unit": "g"
    },
    {
      "ingredient_id": "fine-sea-salt",
      "item": "fine sea salt",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "dried-active-yeast",
      "item": "dried active yeast",
      "quantity": 7,
      "unit": "g"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "eggs-at-room-temperature",
      "item": "eggs at room temperature",
      "quantity": 4,
      "preparation": "beaten, plus 1 for egg wash"
    },
    {
      "ingredient_id": "salted-butter-cubed-and-softened",
      "item": "salted butter cubed and softened",
      "quantity": 190,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, salt, sugar, and dried active yeast in a large bowl. Warm the milk until just lukewarm."
    },
    {
      "step": 2,
      "text": "Add the warm milk and beaten eggs to the flour mixture. Mix until a rough dough forms, then knead for 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Add the softened butter a little at a time, kneading after each addition until fully incorporated and the dough is smooth and elastic.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Cover the dough and let it rise until doubled in volume, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Deflate the dough, cover it again, and let it rise until puffy, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Turn the dough onto a lightly floured surface, divide and shape it into a loaf or individual portions, then place it in a prepared pan."
    },
    {
      "step": 7,
      "text": "Cover and let the shaped dough become visibly puffy. Brush the surface with the reserved egg wash."
    },
    {
      "step": 8,
      "text": "Heat the oven to 375°F. Bake until deeply golden and the center is fully baked, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 9,
      "text": "Cool the brioche in the pan for 20 minutes before serving.",
      "timer_minutes": 20
    }
  ],
