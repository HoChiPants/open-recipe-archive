  "id": "leftover-pizza-breakfast-casserole",
  "name": "Leftover Pizza Breakfast Casserole",
  "subtitle": "A savory baked egg casserole with pizza, mozzarella, and herbs.",
  "description": "Combine leftover pizza with seasoned eggs, cheese, onion, and garlic, then bake until the casserole is fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
