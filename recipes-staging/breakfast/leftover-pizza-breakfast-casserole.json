  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Coat a baking dish with cooking spray and add the pizza squares."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, milk, mozzarella, onion, melted butter, garlic, oregano, and salt in a bowl. Pour the mixture over the pizza."
    },
    {
      "step": 3,
      "text": "Top with Parmesan and red pepper flakes."
    },
    {
      "step": 4,
      "text": "Bake for 45 minutes, then let the casserole stand for 20 minutes, until the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 45
    }
  ],
