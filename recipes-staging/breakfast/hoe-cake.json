  "id": "hoe-cake",
  "name": "Hoe Cake",
  "subtitle": "A crisp-edged cornmeal-style breakfast bake",
  "description": "A simple savory breakfast cake baked with milk, self-rising flour, and garlic salt in a shortening-greased pan.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 2,
      "unit": "pinches"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Transfer the shortening to a baking pan and place it in the oven to heat."
    },
    {
      "step": 2,
      "text": "Whisk the self-rising flour and milk together until a thick batter forms. Stir in the garlic salt."
    },
    {
      "step": 3,
      "text": "Carefully remove the hot pan, pour in the batter, and bake until golden brown.",
      "timer_minutes": 20
    }
  ],
