  "instructions": [
    {
      "step": 1,
      "text": "Stir the packed brown sugar, melted butter, and light corn syrup together until smooth. Spread the mixture in the bottom of a baking dish and scatter the chopped pecans over it."
    },
    {
      "step": 2,
      "text": "Arrange the French bread slices in a single layer over the pecans, overlapping if needed."
    },
    {
      "step": 3,
      "text": "Whisk the orange zest, orange juice, milk, white sugar, cinnamon, vanilla, egg whites, and eggs until blended. Pour evenly over the bread."
    },
    {
      "step": 4,
      "text": "Cover and refrigerate for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 6,
      "text": "Bake uncovered for 35 minutes, until golden brown and the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Dust with the confectioners' sugar for serving."
    }
  ],
