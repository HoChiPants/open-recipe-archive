  "id": "orange-pecan-french-toast",
  "name": "Orange Pecan French Toast",
  "subtitle": "A make-ahead breakfast bake with citrus and toasted pecans",
  "description": "Bread slices soak in a lightly spiced orange custard, then bake over a buttery pecan topping until golden and set.",
