  "id": "spinach-and-mushroom-egg-casserole",
  "name": "Spinach and Mushroom Egg Casserole",
  "subtitle": "A savory baked breakfast with spinach, mushrooms, and melted cheese",
  "description": "Combine eggs, cheeses, vegetables, and a seasoned flour mixture, then bake until the center is fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 10
    },
    {
      "ingredient_id": "cottage-cheese",
      "item": "cottage cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "monterey-jack-cheese",
      "item": "Monterey Jack cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce, shredded"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed, drained and squeezed dry"
    },
    {
      "ingredient_id": "mushrooms",
      "item": "mushrooms",
      "quantity": 2,
      "unit": "can",
      "preparation": "4.5 ounce, sliced, drained"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease a baking dish with the 1 teaspoon butter."
    },
    {
      "step": 2,
      "text": "Whisk the eggs in a large bowl. Stir in the cottage cheese, shredded Monterey Jack, melted butter, spinach, and mushrooms."
    },
    {
      "step": 3,
      "text": "In a separate bowl, mix the flour, baking powder, and salt. Add this mixture to the egg mixture and stir until evenly combined."
    },
    {
      "step": 4,
      "text": "Pour the mixture into the prepared dish and bake for 35 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 35
    }
  ],
