{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "blackberry-and-white-chocolate-porridge-topper",
  "name": "Blackberry and White Chocolate Porridge Topper",
  "subtitle": "Creamy oats with blackberry compote and seeds",
  "description": "A warm, lightly sweet porridge topped with soft lemony blackberries, melted white chocolate, and mixed seeds.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "blackberries",
      "item": "blackberries",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "white-chocolate-roughly-chopped",
      "item": "white chocolate roughly chopped",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "mixed-seeds",
      "item": "mixed seeds",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "porridge-oats",
      "item": "porridge oats",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 400,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the blackberries, lemon juice, and caster sugar in a saucepan. Heat for 6 minutes, stirring occasionally, until softened and syrupy.",
      "timer_minutes": 6
    },
    {
      "step": 2,
      "text": "Remove the blackberry mixture from the heat and let it cool slightly."
    },
    {
      "step": 3,
      "text": "Put the porridge oats and milk in a saucepan. Heat gently for about 10 minutes, stirring often, until thickened.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir the chopped white chocolate into the hot porridge until melted and smooth."
    },
    {
      "step": 5,
      "text": "Divide the porridge among four bowls. Spoon over the blackberry mixture and finish with the mixed seeds."
    }
  ],
