  "instructions": [
    {
      "step": 1,
      "text": "Crumble the drained tofu into a bowl. Toss it with 0.5 teaspoon salt, black pepper, onion powder, garlic powder, ground turmeric, and 1 tablespoon fresh lemon juice."
    },
    {
      "step": 2,
      "text": "Heat 2 tablespoons olive oil in a large skillet over medium-high heat. Add the seasoned tofu and cooked hash brown potatoes; cook until the tofu is heated through and the potatoes are browned, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "For the salsa, heat 1 tablespoon olive oil in a skillet over medium heat. Add the red onion, jalapeno peppers, garlic, and the remaining 0.5 teaspoon salt. Cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the tomatoes and cumin. Cook until the tomatoes soften, about 5 minutes. Stir in 1 tablespoon fresh lemon juice and 0.25 cup fresh cilantro, then remove from the heat.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Warm the drained, rinsed black beans in a small saucepan over medium heat for 2 minutes. Season the tofu and potatoes with any remaining black pepper to taste.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Divide the tofu, hash brown potatoes, black beans, and salsa among three bowls. Top with the avocado, 1 teaspoon fresh lemon juice, and 0.25 cup fresh cilantro. Serve with hot sauce."
    }
  ],
