{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "leftover-potato-pancakes",
  "name": "Leftover Potato Pancakes",
  "subtitle": "Crisp-edged pancakes made from mashed potatoes and Cheddar",
  "description": "Combine seasoned mashed potatoes with cheese, egg, and flour, then cook the formed pancakes in butter until golden and fully set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "mashed-potatoes",
      "item": "mashed potatoes",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large",
      "preparation": "beaten"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": "1/2",
      "unit": "cup",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the mashed potatoes, shredded Cheddar, salt, and beaten egg until evenly combined."
    },
    {
      "step": 2,
      "text": "Add the flour and stir until the mixture holds together; use the stated amount as needed for a workable consistency."
    },
    {
      "step": 3,
      "text": "Divide the mixture into five portions and shape each into a flat pancake."
    },
    {
      "step": 4,
      "text": "Melt the butter in a skillet over medium heat, then cook the pancakes for about 2 to 3 minutes per side, until golden brown and the centers are fully set, reaching 160°F.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Serve hot."
    }
  ],
