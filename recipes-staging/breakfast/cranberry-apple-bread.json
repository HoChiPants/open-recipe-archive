  "id": "cranberry-apple-bread",
  "name": "Cranberry Apple Bread",
  "subtitle": "A tender fruit-and-nut quick bread",
  "description": "Chopped apple, cranberries, cinnamon, and walnuts come together in a lightly sweet loaf for breakfast or snacking.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
