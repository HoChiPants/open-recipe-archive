      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease a standard loaf pan."
    },
    {
      "step": 2,
      "text": "Stir the apple, sugar, oil, and egg together in a large bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the flour, baking powder, baking soda, and cinnamon."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the apple mixture and stir just until combined. Fold in the cranberries and walnuts."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and smooth the top."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, or until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 45
    }
  ],
