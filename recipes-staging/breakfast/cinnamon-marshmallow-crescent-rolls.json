{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cinnamon-marshmallow-crescent-rolls",
  "name": "Cinnamon Marshmallow Crescent Rolls",
  "subtitle": "Warm crescent pastries with a cinnamon-sugar center",
  "description": "Crescent dough wraps marshmallows coated in butter and cinnamon sugar, then bakes into golden, hollow-centered rolls.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "refrigerated-crescent-dinner-rolls",
      "item": "refrigerated crescent dinner rolls",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "marshmallows",
      "item": "marshmallows",
      "quantity": 8,
      "unit": "large"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Unroll the crescent dough and separate it into 8 triangles."
    },
    {
      "step": 3,
      "text": "Mix the sugar and cinnamon in a shallow dish."
    },
    {
      "step": 4,
      "text": "Dip each marshmallow in melted butter, then coat it with the cinnamon-sugar mixture."
    },
    {
      "step": 5,
      "text": "Place one coated marshmallow on the wide end of each dough triangle. Wrap the dough around it completely and pinch the seams closed."
    },
    {
      "step": 6,
      "text": "Arrange the filled rolls on a baking sheet with the seams underneath."
    },
    {
      "step": 7,
      "text": "Bake for 15 minutes, or until golden brown. Serve warm.",
      "timer_minutes": 15
    }
  ],
