  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large ovenproof skillet. Cook the onion until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the crushed garlic and chilli flakes; cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Stir in the tomatoes and sundried tomato pesto, then simmer for 10 minutes to thicken.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Fold in the spinach and cook until wilted, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Heat the grill and make eight wells in the sauce. Crack an egg into each well, dot with ricotta, and scatter over the grated parmesan."
    },
    {
      "step": 6,
      "text": "Grill until the egg whites and yolks are fully set and the center reaches 160°F, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Scatter with basil and serve with crusty bread or focaccia."
    }
  ],
