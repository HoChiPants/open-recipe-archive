  "id": "blueberry-turnovers",
  "name": "Blueberry Turnovers",
  "subtitle": "Flaky pastries with a bright berry filling",
  "description": "Crescent-roll pastries filled with fresh blueberries, finished with confectioners' sugar and vanilla frosting.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "refrigerated-crescent-rolls",
      "item": "refrigerated crescent rolls",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "fresh-blueberries",
      "item": "fresh blueberries",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "prepared-vanilla-frosting",
      "item": "prepared vanilla frosting",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Separate the crescent rolls and arrange the pieces on a baking sheet. Place blueberries in the center of each piece and sprinkle with confectioners' sugar."
    },
    {
      "step": 3,
      "text": "Fold the dough over the filling and press the edges closed. Bake until the pastries are puffed and lightly golden, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Cool the turnovers for 5 minutes. Dust with the remaining confectioners' sugar and add the prepared vanilla frosting before serving.",
      "timer_minutes": 5
    }
  ],
