  "id": "onion-quiche",
  "name": "Onion Quiche",
  "subtitle": "A savory baked egg tart with sweet onion and Swiss cheese.",
  "description": "Sautéed onion, cream, eggs, and Swiss cheese fill an unbaked crust for a simple savory quiche.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "diced"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 0.33300000429153,
      "unit": "cup"
    },
    {
      "ingredient_id": "swiss-cheese",
      "item": "Swiss cheese",
      "quantity": 0.33300000429153,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "9-inch-unbaked-pie-crust",
      "item": "(9 inch) unbaked pie crust",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium heat, add the diced onion, and cook until softened."
    },
    {
      "step": 3,
      "text": "Whisk the eggs and heavy cream together, then stir in the shredded Swiss cheese."
    },
    {
      "step": 4,
      "text": "Spread the cooked onion in the unbaked pie crust and pour the egg mixture over it."
    },
    {
      "step": 5,
      "text": "Bake until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
