  "id": "cream-cheese-banana-bread",
  "name": "Cream Cheese Banana Bread",
  "subtitle": "Tender banana loaf with a cinnamon-pecan topping",
  "description": "A moist, lightly spiced banana bread enriched with cream cheese and finished with a crunchy pecan topping.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "mashed-bananas",
      "item": "mashed bananas",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a loaf pan for baking."
    },
    {
      "step": 2,
      "text": "Combine the all-purpose flour, baking powder, and baking soda in a bowl."
    },
    {
      "step": 3,
      "text": "Whisk the softened margarine and cream cheese until smooth. Add the white sugar and brown sugar, then mix in the eggs one at a time."
    },
    {
      "step": 4,
      "text": "Stir in the mashed bananas and vanilla extract. Add the dry ingredients and combine just until a batter forms."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan. Mix the pecans, brown sugar, and ground cinnamon, then scatter the mixture over the batter."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, or until the loaf is set in the center. Cool before slicing.",
      "timer_minutes": 45
    }
  ],
