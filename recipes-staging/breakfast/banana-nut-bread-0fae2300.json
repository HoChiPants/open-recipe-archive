  "id": "banana-nut-bread-0fae2300",
  "name": "Banana Nut Bread",
  "subtitle": "A quick, tender loaf with mashed bananas and pecans",
  "description": "Cake mix, pudding mix, bananas, and pecans combine for an easy sweet bread baked until set.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "serving-cooking-spray",
      "item": "serving cooking spray",
      "quantity": 1
    },
    {
      "ingredient_id": "yellow-cake-mix",
      "item": "yellow cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "ripe-bananas",
      "item": "ripe bananas",
      "quantity": 2,
      "preparation": "mashed"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "instant-vanilla-pudding-mix",
      "item": "instant vanilla pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.5 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Coat a baking pan with the cooking spray."
    },
    {
      "step": 2,
      "text": "Combine the cake mix, pecans, mashed bananas, water, oil, pudding mix, and eggs in a bowl. Stir until evenly mixed."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and spread it into an even layer."
    },
    {
      "step": 4,
      "text": "Bake for 45 minutes, until the bread is set in the center and a tester comes out clean.",
      "timer_minutes": 45
    }
  ],
