  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "russian-blini",
  "name": "Russian Blini",
  "subtitle": "Thin, tender pancakes for a savory or sweet breakfast",
  "description": "A light skillet pancake made with a rested milk-and-egg batter, finished with butter and served warm.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 4.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 5,
      "unit": "large"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.33333334326744,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "citric-acid-powder",
      "item": "citric acid powder",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "boiling-water",
      "item": "boiling water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.66666668653488,
      "unit": "cup",
      "preparation": "divided"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the milk and eggs together. In a separate bowl, whisk the sugar and salt; combine the baking soda with the citric acid powder."
    },
    {
      "step": 2,
      "text": "Blend the flour into the milk mixture, then whisk in the sugar mixture, the soda mixture, and the vegetable oil until smooth."
    },
    {
      "step": 3,
      "text": "Gradually whisk in the boiling water. Let the batter rest for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Melt part of the divided butter and warm a skillet over medium heat. Lightly butter the pan."
    },
    {
      "step": 5,
      "text": "Pour in enough batter to form a thin pancake and cook until the surface is set and the underside is lightly browned, about 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Transfer the blini to a plate, butter lightly, and repeat with the remaining batter and butter. Fold or stack and serve warm."
    }
  ],
