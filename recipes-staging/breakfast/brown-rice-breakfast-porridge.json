{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "brown-rice-breakfast-porridge",
  "name": "Brown Rice Breakfast Porridge",
  "subtitle": "Warm rice porridge with blueberries and cinnamon",
  "description": "Cooked brown rice simmers with milk, dried blueberries, honey, and cinnamon, then is enriched with egg, butter, and vanilla.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "brown-rice",
      "item": "brown rice",
      "quantity": 1,
      "unit": "cup",
      "preparation": "cooked"
    },
    {
      "ingredient_id": "2-low-fat-milk",
      "item": "2% low-fat milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "dried-blueberries",
      "item": "dried blueberries",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "cinnamon",
      "item": "cinnamon",
      "quantity": 1,
      "unit": "dash"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the brown rice, milk, dried blueberries, honey, and cinnamon in a saucepan. Bring the mixture to a gentle simmer and cook for 20 minutes, stirring occasionally.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Whisk the egg in a bowl. Gradually whisk in some of the hot rice mixture, then return the egg mixture to the saucepan and stir continuously."
    },
    {
      "step": 3,
      "text": "Heat the porridge for 2 minutes, stirring, until the egg reaches 160°F and the center is fully set.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the butter and vanilla extract, then serve warm."
    }
  ],
