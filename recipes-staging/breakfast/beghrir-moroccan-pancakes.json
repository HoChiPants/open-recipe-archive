  "id": "beghrir-moroccan-pancakes",
  "name": "Beghrir (Moroccan Pancakes)",
  "subtitle": "Tender, lacy pancakes with honey-butter topping",
  "description": "Yeasted semolina pancakes are blended smooth, rested, cooked until set, and served with warm honey butter.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35,
    "inactive_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "warm-water-115-degrees-f-46-degrees-c",
      "item": "warm water (115 degrees F/46 degrees C)",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "semolina-flour",
      "item": "semolina flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "orange-flower-water",
      "item": "orange-flower water",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the warm water, yeast, sugar, and orange-flower water together; let stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the milk, both flours, eggs, baking powder, and salt. Blend for about 1 minute, until smooth.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Cover the batter and let it rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Warm a lightly prepared skillet over medium heat. Stir the batter, then cook pancakes in batches until bubbles form and the centers are fully set; cook only one side."
    },
    {
      "step": 5,
      "text": "Meanwhile, warm the butter, honey, and orange-flower water together for about 2 minutes, stirring until melted and combined. Serve over the pancakes.",
      "timer_minutes": 2
    }
  ],
