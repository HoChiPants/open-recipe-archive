{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "potato-latkes",
  "name": "Potato Latkes",
  "subtitle": "Crisp potato pancakes with savory and sweet toppings",
  "description": "Grated potatoes and onion form crisp pancakes fried in oil and served with the listed toppings.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 12,
    "unit": "large or 24 small"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "maris-piper-potatoes-peeled",
      "item": "Maris Piper potatoes peeled",
      "quantity": 4
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "medium"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "plain-flour-or-matzoh-meal",
      "item": "plain flour or matzoh meal",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vegetable",
      "item": "vegetable",
      "preparation": "peanut or canola oil for frying"
    },
    {
      "ingredient_id": "soured-cream",
      "item": "soured cream"
    },
    {
      "ingredient_id": "smoked-salmon",
      "item": "smoked salmon"
    },
    {
      "ingredient_id": "finely-chopped-chives",
      "item": "finely chopped chives"
    },
    {
      "ingredient_id": "apple-sauce",
      "item": "apple sauce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grate the peeled potatoes and onion. Let the mixture stand so the liquid separates.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Drain the mixture thoroughly, then let it drain for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Combine the eggs with the flour or matzoh meal. Add the drained potato mixture and stir to coat."
    },
    {
      "step": 4,
      "text": "Heat a skillet with peanut or canola oil over medium-high heat. Add portions of the mixture and flatten into pancakes."
    },
    {
      "step": 5,
      "text": "Fry in batches for about 2 minutes per side, turning when browned. Continue until crisp and the centers are fully set, reaching 160°F.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Serve with soured cream, smoked salmon, chives, apple sauce, or a combination of the listed accompaniments."
    }
  ],
