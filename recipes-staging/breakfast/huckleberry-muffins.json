  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F and prepare a muffin tin."
    },
    {
      "step": 2,
      "text": "Whisk the sugar and butter until smooth. Whisk in the milk, egg, and vanilla extract."
    },
    {
      "step": 3,
      "text": "Combine the sifted flour, baking powder, and salt, then stir the dry mixture into the wet mixture until just combined."
    },
    {
      "step": 4,
      "text": "Toss the huckleberries with the 1 tablespoon flour and fold them into the batter. Portion the batter into the prepared tin."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until the centers are fully set and reach 160°F.",
      "timer_minutes": 15
    }
  ],
