  "id": "huckleberry-muffins",
  "name": "Huckleberry Muffins",
  "subtitle": "Tender fruit muffins with a buttery crumb",
  "description": "Bake a batch of lightly sweet muffins studded with huckleberries for breakfast or a snack.",
  "meal_type": "breakfast",
