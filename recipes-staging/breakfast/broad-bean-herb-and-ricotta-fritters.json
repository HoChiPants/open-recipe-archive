  "id": "broad-bean-herb-and-ricotta-fritters",
  "name": "Broad Bean, Herb and Ricotta Fritters",
  "subtitle": "Tender fritters with fresh herbs and lemon",
  "description": "Make crisp-edged fritters from broad beans, ricotta, herbs, and lemon, then serve with soft-boiled eggs and olive oil.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "broad-beans-in-pods",
      "item": "broad beans in pods",
      "quantity": 600,
      "unit": "g",
      "preparation": "or 200g podded weight (or use frozen)"
    },
    {
      "ingredient_id": "ricotta",
      "item": "ricotta",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "chilli-flakes-plus-a-pinch-to-serve-optional",
      "item": "chilli flakes plus a pinch to serve (optional)",
      "quantity": "1/4",
      "unit": "tsp",
      "optional": true
    },
    {
      "ingredient_id": "few-sprigs-of-mint-chopped",
      "item": "few sprigs of mint chopped",
      "preparation": "plus a few leaves to serve"
    },
    {
      "ingredient_id": "few-sprigs-of-dill-chopped",
      "item": "few sprigs of dill chopped",
      "preparation": "plus a few leaves to serve"
    },
    {
      "ingredient_id": "few-sprigs-of-parsley-chopped",
      "item": "few sprigs of parsley chopped",
      "preparation": "plus a few leaves to serve"
    },
    {
      "ingredient_id": "lemon-zested",
      "item": "lemon zested",
      "quantity": 1
    },
    {
      "ingredient_id": "drizzle-of-olive-oil-for-frying",
      "item": "drizzle of olive oil for frying"
    },
    {
      "ingredient_id": "drizzle-of-extra-virgin-olive-oil-to-serve",
      "item": "drizzle of extra virgin olive oil to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Simmer the broad beans in boiling water for 6 minutes. Drain, cool briefly, and remove the outer skins if needed.",
      "timer_minutes": 6
    },
    {
      "step": 2,
      "text": "Simmer two of the eggs for 6 minutes, then cool them in cold water and peel.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Mix the broad beans with the ricotta, remaining eggs, flour, baking powder, chilli flakes, chopped mint, dill, parsley, and lemon zest until thick."
    },
    {
      "step": 4,
      "text": "Heat the olive oil for frying in a skillet over medium heat. Add spoonfuls of batter and cook in batches until golden brown and the centers are fully set, about 3 minutes per side; use a thermometer to confirm the egg-containing fritters reach 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Serve the fritters with the peeled eggs, reserved herbs, a pinch of chilli flakes if desired, and extra virgin olive oil."
    }
  ],
