  "id": "cheese-blintzes",
  "name": "Cheese Blintzes",
  "subtitle": "Tender crepes with a citrus-scented cheese filling",
  "description": "Fill lightly cooked crepes with sweetened ricotta and cream cheese, fold them, then bake until set and golden.",
  "meal_type": "breakfast",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
