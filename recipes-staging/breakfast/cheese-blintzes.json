  "instructions": [
    {
      "step": 1,
      "text": "Blend the milk, flour, cold water, eggs, vegetable oil, white sugar, salt, vanilla extract, and part of the powdered sugar until smooth, about 2 minutes. Let the batter rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Whisk the ricotta, cream cheese, egg, remaining powdered sugar, lemon zest, and pinch of salt until combined. Chill the filling while the batter rests."
    },
    {
      "step": 3,
      "text": "Preheat a lightly greased skillet over medium heat. Spray or coat it with cooking spray, add enough batter to make a thin crepe, and cook for about 1 minute, until set. Transfer it to a plate and repeat with the remaining batter.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Preheat the oven to 325°F. Place a portion of filling near the lower center of each crepe, fold in the sides, then fold it over to enclose the filling."
    },
    {
      "step": 5,
      "text": "Melt butter in an oven-safe skillet or baking dish over medium heat. Cook the folded blintzes for about 1 minute per side, until golden brown, then transfer them to the prepared dish.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Bake until the blintzes are firm and the filling reaches 160°F in the center.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Cool for 10 minutes and dust with the remaining powdered sugar, adding more as needed.",
      "timer_minutes": 10
    }
  ],
