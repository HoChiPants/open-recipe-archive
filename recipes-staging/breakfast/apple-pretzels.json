{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "apple-pretzels",
  "name": "Apple Pretzels",
  "subtitle": "Soft baked pretzels with spiced apple filling",
  "description": "Yeasted pretzels filled with finely diced cinnamon-apple mixture and finished with sugar and caramel sauce.",
  "meal_type": "breakfast",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 105,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "strong-white-bread-flour-plus-extra-for-dusting",
      "item": "strong white bread flour plus extra for dusting",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "sachet-fast-action-dried-yeast",
      "item": "sachet fast-action dried yeast",
      "quantity": 7,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar-plus-5-tbsp",
      "item": "golden caster sugar plus 5 tbsp",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "butter-melted",
      "item": "butter melted",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "oil-for-proving",
      "item": "oil for proving"
    },
    {
      "ingredient_id": "1-2-dessert-apples-cored",
      "item": "1/2 dessert apples cored",
      "quantity": "1-1",
      "preparation": "peeled and finely diced"
    },
    {
      "ingredient_id": "cinnamon",
      "item": "cinnamon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "grating-of-nutmeg",
      "item": "grating of nutmeg"
    },
    {
      "ingredient_id": "bicarbonate-of-soda",
      "item": "bicarbonate of soda",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "egg-lightly-beaten",
      "item": "egg lightly beaten",
      "quantity": 1
    },
    {
      "ingredient_id": "caramel-sauce-to-serve",
      "item": "caramel sauce to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, yeast, and 40 g of the sugar. Stir in the melted butter and enough water to form a dough."
    },
    {
      "step": 2,
      "text": "Knead for 15 minutes, until smooth. Place in an oiled bowl, cover, and leave to prove for 60 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Mix the diced apples with the cinnamon and nutmeg."
    },
    {
      "step": 4,
      "text": "Divide the dough into 8 pieces. Flatten each piece, add apple filling, seal, and shape into pretzels."
    },
    {
      "step": 5,
      "text": "Bring water and the bicarbonate of soda to a simmer. Dip each pretzel briefly, then transfer to a lined baking tray."
    },
    {
      "step": 6,
      "text": "Brush with the beaten egg and leave for 20 minutes, until set.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Preheat the oven and sprinkle the pretzels with the remaining sugar."
    },
    {
      "step": 8,
      "text": "Bake for 25 minutes, until golden and the egg coating is fully set; if checking with a thermometer, the center should reach 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 9,
      "text": "Serve warm with caramel sauce."
    }
  ],
