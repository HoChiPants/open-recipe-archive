  "id": "beetroot-grape-and-apple-relish",
  "name": "Beetroot, Grape and Apple Relish",
  "subtitle": "A bright sweet-tart relish for cheese and savory plates",
  "description": "Cooked beetroot, apple, grapes, and chilli simmer with brown sugar and balsamic vinegar to make a colorful, spoonable relish.",
  "meal_type": "other",
  "yield": {
    "quantity": 1,
    "unit": "x 300g jar"
  },
