    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "beetroot-chopped",
      "item": "beetroot chopped",
      "quantity": 4,
      "unit": "small",
      "preparation": "cooked"
    },
    {
      "ingredient_id": "apple-peeled-and-finely-chopped",
      "item": "apple peeled and finely chopped",
      "quantity": 1,
      "unit": "medium"
    },
    {
      "ingredient_id": "red-grapes-halved",
      "item": "red grapes halved",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "finely-chopped-red-chilli",
      "item": "finely chopped red chilli",
      "quantity": 1
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 3,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the beetroot, apple, grapes, chilli, sugar, and balsamic vinegar in a saucepan."
    },
    {
      "step": 2,
      "text": "Bring to a gentle simmer and cook for 35 minutes, stirring occasionally, until the fruit is tender and the mixture is thick and relish-like.",
      "timer_minutes": 35
    },
    {
      "step": 3,
      "text": "Remove from the heat and cool completely before serving or transferring to a clean jar for short-term refrigeration."
    }
  ],
