  "id": "coconut-pancake-syrup",
  "name": "Coconut Pancake Syrup",
  "subtitle": "A warm coconut topping for pancakes",
  "description": "A sweet coconut syrup with shredded coconut, made for spooning over pancakes or other breakfast foods.",
  "meal_type": "other",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "coconut-milk",
      "item": "coconut milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "13.5 ounce"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "light-corn-syrup",
      "item": "light corn syrup",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sweetened-coconut",
      "item": "sweetened coconut",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the coconut milk, cornstarch, light corn syrup, and sweetened coconut until smooth."
    },
    {
      "step": 2,
      "text": "Preheat a saucepan over medium heat, then transfer in the mixture and add the white sugar."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer, stirring until the syrup thickens.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Remove from the heat and let cool for 30 minutes before serving.",
      "timer_minutes": 30
    }
  ],
