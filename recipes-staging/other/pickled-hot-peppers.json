  "id": "pickled-hot-peppers",
  "name": "Pickled Hot Peppers",
  "subtitle": "Tangy mixed peppers with onion and garlic",
  "description": "A sharp, colorful pepper condiment prepared with a vinegar brine and chilled until infused.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 80,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 25,
    "inactive_minutes": 720
  },
  "ingredients": [
    {
      "ingredient_id": "banana-peppers",
      "item": "banana peppers",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "cut into 1 inch pieces"
    },
    {
      "ingredient_id": "jalapeno-peppers",
      "item": "jalapeno peppers",
      "quantity": 1,
      "unit": "pound",
      "preparation": "cut into 1 inch pieces"
    },
    {
      "ingredient_id": "serrano-peppers",
      "item": "serrano peppers",
      "quantity": 0.25,
      "unit": "pound",
      "preparation": "cut into 1 inch pieces"
    },
    {
      "ingredient_id": "vinegar",
      "item": "vinegar",
      "quantity": 6,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "medium",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the banana peppers, jalapeno peppers, serrano peppers, and water in a large saucepan. Bring to a gentle simmer, then cook until the peppers begin to soften.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Combine the vinegar, remaining water, onion, and garlic in a separate saucepan. Bring the mixture to a boil.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Transfer the peppers to a clean heatproof container. Pour the hot vinegar mixture over them, making sure the peppers are covered."
    },
    {
      "step": 4,
      "text": "Simmer the covered pepper mixture gently for 15 minutes, then remove it from the heat.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Cool briefly, cover, and refrigerate for at least 12 hours before serving.",
      "timer_minutes": 720
    },
    {
      "step": 6,
      "text": "Serve chilled as a condiment. Keep refrigerated."
    }
  ],
