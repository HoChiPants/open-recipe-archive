  "id": "chicory-blue-cheese-and-pine-nut-tartlets",
  "name": "Chicory, Blue Cheese and Pine Nut Tartlets",
  "subtitle": "Caramelized chicory layered with creamy cheese on puff pastry",
  "description": "These savory tartlets pair balsamic-roasted chicory with crème fraîche, blue cheese, and toasted pine nuts in crisp puff pastry.",
  "meal_type": "other",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "red-or-white-chicory-or-a-mixture",
      "item": "red or white chicory (or a mixture)",
      "quantity": 4,
      "preparation": "halved lengthways"
    },
    {
      "ingredient_id": "balsamic-vinegar",
      "item": "balsamic vinegar",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "rosemary-sprigs",
      "item": "rosemary sprigs",
      "quantity": 2
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "x-275g-ready-rolled-puff-pastry-sheets",
      "item": "x 275g ready-rolled puff pastry sheets",
      "quantity": 2
    },
    {
      "ingredient_id": "cre-me-frai-che",
      "item": "crème fraîche",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "vegetarian-soft-blue-cheese-such-as-dovedale-blue",
      "item": "vegetarian soft blue cheese such as dovedale blue",
      "quantity": 150,
      "unit": "g",
      "preparation": "crumbled (see tip)"
    },
    {
      "ingredient_id": "pine-nuts",
      "item": "pine nuts",
      "quantity": 4,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Toss the halved chicory with balsamic vinegar, olive oil, and rosemary, then arrange it in a roasting dish and sprinkle with the sugar."
    },
    {
      "step": 2,
      "text": "Roast until tender, about 20 minutes. Remove the rosemary and let the chicory cool.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Shape the puff pastry sheets into tartlet bases and cut them to fit the tartlet tins."
    },
    {
      "step": 4,
      "text": "Prepare the tartlet bases, then spread each with crème fraîche. Top with the roasted chicory and crumbled blue cheese."
    },
    {
      "step": 5,
      "text": "Bake until the pastry is crisp and the cheese is melted, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Scatter with pine nuts and bake for 5 minutes more. Cool for 10 minutes before serving.",
      "timer_minutes": 15
    }
  ],
