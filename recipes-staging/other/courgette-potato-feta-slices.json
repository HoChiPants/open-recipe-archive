  "id": "courgette-potato-feta-slices",
  "name": "Courgette, Potato & Feta Slices",
  "subtitle": "A savory layered bake with fresh mint",
  "description": "Thinly sliced potatoes and courgettes are layered with feta and mint, bound with beaten eggs, baked until firm, chilled, and cut into slices.",
  "meal_type": "other",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "new-potatoes-thinly-sliced",
      "item": "new potatoes thinly sliced",
      "quantity": 350,
      "unit": "g"
    },
    {
      "ingredient_id": "courgettes-about-900g",
      "item": "courgettes (about 900g)",
      "quantity": 4,
      "preparation": "trimmed and thinly sliced"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "block-of-feta-crumbled-vegetarian",
      "item": "block of feta crumbled (vegetarian",
      "quantity": 200,
      "unit": "g",
      "preparation": "if needed)"
    },
    {
      "ingredient_id": "bunch-of-mint-leaves-picked-and-chopped",
      "item": "bunch of mint leaves picked and chopped",
      "unit": "small"
    },
    {
      "ingredient_id": "eggs-beaten",
      "item": "eggs beaten",
      "quantity": 8
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking dish with the olive oil."
    },
    {
      "step": 2,
      "text": "Arrange the sliced potatoes and courgettes in layers in the dish. Bake for 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Combine the crumbled feta with the chopped mint, then distribute the mixture over the vegetables."
    },
    {
      "step": 4,
      "text": "Pour the beaten eggs evenly over the layered vegetables and cheese."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, or until the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool, chill until firm, and cut into slices to serve."
    }
  ],
