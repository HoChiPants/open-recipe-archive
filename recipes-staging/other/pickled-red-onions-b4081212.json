  "id": "pickled-red-onions-b4081212",
  "name": "Pickled Red Onions",
  "subtitle": "Bright, tangy onions for everyday meals",
  "description": "Thinly sliced red onions are warmed with a lightly sweetened vinegar brine, then rested and chilled until crisp and tangy.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10,
    "inactive_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "red-onions",
      "item": "red onions",
      "quantity": 2,
      "unit": "medium",
      "preparation": "thinly sliced into half-moons"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "sea-salt",
      "item": "sea salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "black-peppercorns",
      "item": "black peppercorns",
      "quantity": 5
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the sliced onions in a clean heatproof container."
    },
    {
      "step": 2,
      "text": "Combine the vinegar, salt, sugar, and peppercorns in a saucepan."
    },
    {
      "step": 3,
      "text": "Warm the vinegar mixture over medium heat until the salt and sugar dissolve; do not boil."
    },
    {
      "step": 4,
      "text": "Pour the warm brine over the onions, ensuring they are covered."
    },
    {
      "step": 5,
      "text": "Let the onions stand at room temperature for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cover and refrigerate for 60 minutes before serving.",
      "timer_minutes": 60
    }
  ],
