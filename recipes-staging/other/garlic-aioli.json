{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "garlic-aioli",
  "name": "Garlic Aioli",
  "subtitle": "A bright, hand-mixed garlic and olive oil condiment",
  "description": "Pounded garlic, lemon, and olive oil make a smooth, intensely savory sauce that can be loosened with water to your preferred texture.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "cloves-fresh-garlic",
      "item": "cloves fresh garlic",
      "quantity": 4,
      "unit": "large",
      "preparation": "peeled and sliced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or other course-grain salt"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "light",
      "item": "light",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "extra-virgin olive oil"
    },
    {
      "ingredient_id": "water-to-adjust-texture",
      "item": "water to adjust texture",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or more as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the sliced garlic and salt in a mortar and pound until a smooth paste forms.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mix in the lemon juice."
    },
    {
      "step": 3,
      "text": "Add the olive oil gradually, stirring continuously until the mixture becomes thick and emulsified."
    },
    {
      "step": 4,
      "text": "Stir in water as needed to adjust the texture, then taste and add more lemon juice if desired."
    }
  ],
  "tags": [
