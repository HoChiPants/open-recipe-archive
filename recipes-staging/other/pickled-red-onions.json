      "item": "red onions",
      "quantity": 3,
      "unit": "medium"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "or to taste"
    },
    {
