      "item": "whole black peppercorns",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Slice the red onions thinly and pack them into a heatproof container with the garlic, jalapeno, bay leaves, and red pepper flakes."
    },
    {
      "step": 2,
      "text": "Combine the vinegar, water, sugar, kosher salt, and peppercorns in a saucepan. Bring to a simmer and cook until the sugar and salt dissolve.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Pour the hot brine over the onions, ensuring they are covered. Let the container cool briefly, then cover and refrigerate."
    },
    {
      "step": 4,
      "text": "Chill for at least 8 hours before serving.",
      "timer_minutes": 480
    }
  ],
