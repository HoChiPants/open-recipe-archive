  "id": "pickled-red-onions",
  "name": "Pickled Red Onions",
  "subtitle": "Tangy, lightly spicy refrigerator pickles",
  "description": "Thin red onions are steeped in a warm, seasoned vinegar brine and chilled until crisp and flavorful.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
