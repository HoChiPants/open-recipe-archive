  "instructions": [
    {
      "step": 1,
      "text": "Heat a large skillet over medium heat. Add the bacon and cook, stirring occasionally, for 10 minutes. Transfer the bacon to a cutting board and chop it finely.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the butter to the skillet. Stir in the onions and salt, then cook for 10 minutes, stirring occasionally.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Mix in the brown sugar, sherry vinegar, thyme leaves, black pepper, cayenne, and balsamic vinegar. Return the bacon to the skillet and add the water."
    },
    {
      "step": 4,
      "text": "Cook the mixture over medium heat, stirring often, until thick and jam-like, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Stir together the remaining sherry vinegar, thyme leaves, balsamic vinegar, and olive oil. Prepare and serve the bacon jam with the mixture."
    }
  ],
