  "name": "Bacon Jam",
  "subtitle": "Sweet, tangy, and savory skillet condiment",
  "description": "Slow-cooked bacon and onions combine with brown sugar, vinegar, and herbs for a rich spreadable condiment.",
  "meal_type": "other",
