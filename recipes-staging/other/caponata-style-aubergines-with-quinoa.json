  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Toss the celery, peppers, raisins, and aubergines with half the oil, then roast until the vegetables are tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Meanwhile, warm the remaining oil in a large pan. Cook the onions until softened, then add the garlic, tomatoes, balsamic vinegar, capers, and olives. Simmer until thickened."
    },
    {
      "step": 3,
      "text": "Stir the roasted vegetables into the tomato mixture and fold in the parsley."
    },
    {
      "step": 4,
      "text": "Simmer the quinoa with the vegetable bouillon until tender and the liquid is absorbed, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Serve the caponata-style vegetables over the quinoa and scatter with the toasted almonds or pine nuts."
    }
  ],
