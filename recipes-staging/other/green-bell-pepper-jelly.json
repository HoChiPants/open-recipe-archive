{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "green-bell-pepper-jelly",
  "name": "Green Bell Pepper Jelly",
  "subtitle": "A bright, sweet-tart pepper condiment",
  "description": "Chopped green bell pepper is cooked with sugar and vinegar, thickened with liquid pectin, and rested until set.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 28,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 6.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "finely-chopped-green-bell-pepper",
      "item": "finely chopped green bell pepper",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "liquid-pectin",
      "item": "liquid pectin",
      "quantity": 3,
      "unit": "ounces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sugar, green bell pepper, and vinegar in a saucepan. Bring the mixture to a boil and cook for 6 minutes, stirring occasionally.",
      "timer_minutes": 6
    },
    {
      "step": 2,
      "text": "Stir in the liquid pectin until evenly incorporated."
    },
    {
      "step": 3,
      "text": "Return the mixture to a boil, then reduce the heat and simmer for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Transfer the hot jelly to clean containers and let it rest undisturbed until set, about 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 5,
      "text": "Cool fully before serving or refrigerating."
    }
  ],
