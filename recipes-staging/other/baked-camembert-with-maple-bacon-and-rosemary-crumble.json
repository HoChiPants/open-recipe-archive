  "id": "baked-camembert-with-maple-bacon-and-rosemary-crumble",
  "name": "Baked Camembert with Maple Bacon and Rosemary Crumble",
  "subtitle": "Warm, melty cheese with a crisp savory-sweet topping",
  "description": "Camembert is baked until soft, then finished with maple-glazed bacon and rosemary. Serve warm with crackers or toasted baguettes.",
  "meal_type": "other",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "camembert",
      "item": "camembert",
      "quantity": 290,
      "unit": "g"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "sprigs-rosemary",
      "item": "sprigs rosemary",
      "quantity": 3
    },
    {
      "ingredient_id": "rashers-smoked-streaky-bacon-finely-chopped",
      "item": "rashers smoked streaky bacon finely chopped",
      "quantity": 4
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "crackers-or-toasted-baguettes",
      "item": "crackers or toasted baguettes"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Unwrap the camembert and place it in a small ovenproof dish."
    },
    {
      "step": 2,
      "text": "Strip the rosemary leaves from the sprigs. Cut the rosemary and bacon as specified, reserving the rosemary for the topping."
    },
    {
      "step": 3,
      "text": "Cut the top of the camembert and tuck in some rosemary. Bake until the cheese is soft and molten, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Meanwhile, heat the vegetable oil and cook the bacon with the rosemary until the bacon is cooked through, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the maple syrup and cook the topping for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Spoon the bacon topping over the baked camembert and serve immediately with crackers or toasted baguettes."
    }
  ],
