      "item": "guacamole salsa and pickled jalapeños",
      "preparation": "to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Warm the olive oil in a large ovenproof skillet or frying pan, then cook the onion, garlic, and chopped coriander stems until softened."
    },
    {
      "step": 2,
      "text": "Stir in the chipotle paste and chopped tomatoes. Simmer until the sauce thickens slightly, then transfer about half to a bowl."
    },
    {
      "step": 3,
      "text": "Nestle the chicken breasts in the remaining sauce, cover, and cook for 15 minutes or until the thickest part reaches 165°F. Remove, rest briefly, and shred.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Mix the shredded chicken and sweetcorn with enough reserved sauce to make a moist filling. Spoon it into the tortillas, roll them up, and arrange them seam-side down in the pan."
    },
    {
      "step": 5,
      "text": "Cover the tortillas with the remaining sauce and cheddar. Bake until hot and the cheese is melted and lightly browned.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Scatter over the coriander leaves and serve with guacamole, salsa, and pickled jalapeños."
    }
  ],
