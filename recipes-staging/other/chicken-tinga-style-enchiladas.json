  "id": "chicken-tinga-style-enchiladas",
  "name": "Chicken Tinga-Style Enchiladas",
  "subtitle": "Chipotle chicken, sweetcorn, and cheddar wrapped in tortillas",
  "description": "Tender chicken and sweetcorn are folded into a smoky tomato sauce, rolled in tortillas, baked with cheddar, and served with fresh accompaniments.",
  "meal_type": "other",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
