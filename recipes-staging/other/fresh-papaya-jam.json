    "inactive_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "mashed-ripe-papaya",
      "item": "mashed ripe papaya",
      "quantity": 5,
      "unit": "cups"
    },
    {
      "ingredient_id": "orange-juice",
      "item": "orange juice",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "dry-pectin",
      "item": "dry pectin",
      "quantity": 1.3333333730698,
      "unit": "package",
      "preparation": "1.75 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the mashed papaya, orange juice, and dry pectin in a large pot. Bring the mixture to a simmer over medium heat, stirring frequently."
    },
    {
      "step": 2,
      "text": "Add the white sugar and stir until fully dissolved. Bring the mixture to a boil, then simmer for 1 minute while stirring.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Remove from the heat and transfer to clean heat-safe containers. Cool, cover, and refrigerate until chilled and set."
    },
    {
      "step": 4,
      "text": "Serve chilled."
    }
  ],
