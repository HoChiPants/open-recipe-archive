  "id": "fresh-papaya-jam",
  "name": "Fresh Papaya Jam",
  "subtitle": "Bright tropical jam for toast and desserts",
  "description": "Cook mashed ripe papaya with orange juice, pectin, and sugar until set, then chill before serving.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 64,
    "unit": "servings"
  },
  "times": {
