  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven and cook the sweet potato fries according to the package directions, until crisp, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Meanwhile, warm the olive oil in a large saucepan. Add the red onions, roasted peppers, garlic, and red chilli; cook for 12 minutes until softened.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Stir in the smoked paprika, cumin, chipotle paste, tomato purée, and sugar. Cook for 3 minutes, stirring frequently.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the chopped tomatoes and black beans. Simmer for about 35 minutes, stirring occasionally, until the chilli thickens.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Mix the red wine vinegar with the sugar. Arrange the fries on plates and spoon over the chilli."
    },
    {
      "step": 6,
      "text": "Finish with feta, pickled red onions, avocado if using, coriander, and the lime wedges."
    }
