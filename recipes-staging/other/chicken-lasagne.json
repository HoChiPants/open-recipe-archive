  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Warm the olive oil in a large oven-safe pot or skillet, then cook the chicken thighs for 5 minutes, turning as needed.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the onion and cook for 10 minutes. Stir in the garlic and dried mixed herbs, then add the chopped tomatoes and ketchup.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Bring the tomato mixture to a simmer. Cover and cook until the chicken is tender and reaches 165°F at the thickest point.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "Transfer the chicken to a plate, shred it, and stir it back into the tomato sauce."
    },
    {
      "step": 5,
      "text": "Melt the butter in a saucepan. Whisk in the flour and cook briefly, then gradually whisk in the milk. Simmer, stirring, until smooth and thickened."
    },
    {
      "step": 6,
      "text": "Spread a little white sauce in a baking dish. Layer lasagne sheets, chicken-tomato sauce, white sauce, pesto, and mozzarella, repeating until the ingredients are used. Finish with white sauce, mozzarella, and Parmesan."
    },
    {
      "step": 7,
      "text": "Bake until bubbling, browned, and fully set in the center.",
      "timer_minutes": 35
    },
    {
      "step": 8,
      "text": "Rest for 10 minutes, then cut into portions and serve with the optional basil leaves and green salad.",
      "timer_minutes": 10
    }
  ],
