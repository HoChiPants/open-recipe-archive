  "instructions": [
    {
      "step": 1,
      "text": "Cook the macaroni until tender, then drain."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a pan. Add the cherry tomatoes and cook for 8 minutes, stirring occasionally, until softened.",
