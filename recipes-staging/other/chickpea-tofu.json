  "schema_version": "1.0.0",
  "id": "chickpea-tofu",
  "name": "Chickpea Tofu",
  "subtitle": "A firm, sliceable chickpea-based tofu alternative",
  "description": "Cooked chickpea flour sets into a smooth, versatile tofu-style block.",
  "meal_type": "other",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "gram-chickpea-flour",
      "item": "gram (chickpea) flour",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-turmeric",
      "item": "ground turmeric (optional)",
      "quantity": "1/4",
      "unit": "tsp",
      "optional": true
    },
    {
      "ingredient_id": "flavourless-oil-for-the-tin",
      "item": "flavourless oil for the tin (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the chickpea flour and optional turmeric with water until smooth and lump-free."
    },
    {
      "step": 2,
      "text": "Preheat the mixture while whisking until it thickens, then continue cooking for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Lightly oil a tin if using oil, then transfer the hot mixture into it and smooth the surface."
    },
    {
      "step": 4,
      "text": "Let the mixture cool until smooth and firm, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Chill or rest until fully set, about 2 hours, then cut into pieces.",
      "timer_minutes": 120
    }
  ],
