  "id": "spiced-pickled-beets",
  "name": "Spiced Pickled Beets",
  "subtitle": "Tender beets in a warm, sweet-spiced vinegar brine",
  "description": "Beets are simmered with cinnamon and cloves, packed into jars, processed in boiling water, and cooled for serving as a tangy condiment.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
