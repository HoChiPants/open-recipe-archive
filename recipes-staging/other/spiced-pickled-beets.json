  "instructions": [
    {
      "step": 1,
      "text": "Combine the vinegar, sugar, water, cinnamon, salt, and cloves; stir until the sugar dissolves."
    },
    {
      "step": 2,
      "text": "Add the beets and simmer until tender.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Prepare the canning jars, lids, and rings."
    },
    {
      "step": 4,
      "text": "Transfer the hot beets and cooking liquid to the prepared jars."
    },
    {
      "step": 5,
      "text": "Arrange the filled jars in water, keeping the jars covered as directed for processing."
    },
    {
      "step": 6,
      "text": "Bring the water to a boil and process the jars at a boil.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Transfer the jars out of the water and let them cool completely."
    }
  ],
