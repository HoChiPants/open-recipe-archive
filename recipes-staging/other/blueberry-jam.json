{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "blueberry-jam",
  "name": "Blueberry Jam",
  "subtitle": "A bright, fruit-forward spread with vanilla and lemon",
  "description": "Cook blueberries with sugar, vanilla, and lemon until thick and spoonable, then cool in jars for serving.",
  "meal_type": "other",
  "yield": {
    "quantity": 2,
    "unit": "x 500ml jars"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "blueberries-washed",
      "item": "blueberries washed",
      "quantity": 800,
      "unit": "g"
    },
    {
      "ingredient_id": "sugar",
      "item": "granulated sugar",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-pod-split-lengthways",
      "item": "vanilla pod split lengthways",
      "quantity": 1
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": 1,
      "unit": "large"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the blueberries, sugar, split vanilla pod, and lemon juice in a large saucepan."
    },
    {
      "step": 2,
      "text": "Warm over medium heat, stirring until the sugar dissolves and the berries begin to release their juices."
    },
    {
      "step": 3,
      "text": "Simmer gently, stirring occasionally, until the mixture thickens and reaches a jam-like consistency.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Remove the vanilla pod and spoon the hot jam into clean 500 ml jars."
    },
    {
      "step": 5,
      "text": "Let the jars cool completely before covering and serving."
    }
  ],
