  "id": "german-style-quark",
  "name": "German-Style Quark",
  "subtitle": "Creamy cultured dairy spread made in the oven",
  "description": "Bake whole-milk buttermilk with cream, drain it into a thick curd, and whisk until smooth.",
  "meal_type": "other",
  "cuisine": "German",
  "yield": {
    "quantity": 28,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 135,
    "inactive_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "whole-milk-buttermilk",
      "item": "whole-milk buttermilk",
      "quantity": 0.5,
      "unit": "gallon"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 200°F."
    },
    {
      "step": 2,
      "text": "Transfer the buttermilk to an oven-safe baking dish and combine it with the heavy whipping cream."
    },
    {
      "step": 3,
      "text": "Cook until the mixture forms a thick curd, about 120 minutes.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Transfer the buttermilk curds to a cheesecloth-lined strainer and drain for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Whisk the drained mixture until smooth, then prepare for serving."
    }
  ],
