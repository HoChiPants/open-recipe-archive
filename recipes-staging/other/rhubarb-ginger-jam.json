  "id": "rhubarb-ginger-jam",
  "name": "Rhubarb Ginger Jam",
  "subtitle": "A tart, warmly spiced fruit spread",
  "description": "Rhubarb and fresh ginger cook with sugar and lemon into a thick, bright jam for toast, pastries, or spooning over desserts.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "rhubarb",
      "item": "rhubarb",
      "quantity": 4,
      "unit": "cups",
      "preparation": "diced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "fresh-ginger-root",
      "item": "fresh ginger root",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "minced"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "half-pint-canning-jars-with-lids-and-rings",
      "item": "half-pint canning jars with lids and rings",
      "quantity": 3
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the rhubarb, sugar, ginger, and lemon juice together. Let stand for 20 minutes so the rhubarb releases some of its juices.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Prepare the jars, lids, and rings by boiling them for 5 minutes. Handle the hot equipment carefully.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Cook the rhubarb mixture over medium heat, stirring occasionally, until it thickens, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Simmer the jam for an additional 10 minutes, stirring as needed to prevent sticking.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer the hot jam to the prepared jars. Add the lids and rings, let cool, and refrigerate unless using a separately validated canning process."
    }
  ],
