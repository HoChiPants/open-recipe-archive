  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and bake the baking potato and grated starchy potato until tender, about 60 minutes. Cool until easy to handle.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Scoop out the baked potato and combine it with the grated potato. Brown the butter in a small pan until fragrant, then cool it slightly."
    },
    {
      "step": 3,
      "text": "Mix the potatoes with the flour, bicarbonate of soda, white pepper, beaten egg, milk, parsley, and chives. Stir in the cooled brown butter."
    },
    {
      "step": 4,
      "text": "Heat the rapeseed oil with the remaining butter in a pan. Cook small spoonfuls of batter in batches, turning once, until browned and fully set; the centers should reach 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Serve the blinis with soured cream and smoked trout. Finish with extra chives and optional dill."
    }
  ],
