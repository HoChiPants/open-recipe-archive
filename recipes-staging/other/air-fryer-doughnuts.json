{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "air-fryer-doughnuts",
  "name": "Air-Fryer Doughnuts",
  "subtitle": "Yeasted doughnuts with a simple vanilla glaze",
  "description": "Light yeasted doughnuts are shaped, proved, air-fried, and finished with a smooth vanilla icing.",
  "meal_type": "other",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "milk-lukewarm",
      "item": "milk lukewarm",
      "quantity": 125,
      "unit": "ml"
    },
    {
      "ingredient_id": "unsalted-butter-melted-and-cooled-to-lukewarm",
      "item": "unsalted butter melted and cooled to lukewarm",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "sachet-dried-fast-action-yeast",
      "item": "sachet dried fast-action yeast",
      "quantity": 7,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "plain-flour-plus-extra-for-dusting",
      "item": "plain flour plus extra for dusting",
      "quantity": 275,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon (optional)",
      "quantity": "1/2",
      "unit": "tsp",
      "optional": true
    },
    {
      "ingredient_id": "egg-beaten",
      "item": "egg beaten",
      "quantity": 1
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "flavourless-oil-for-proving",
      "item": "flavourless oil for proving"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the lukewarm milk, yeast, caster sugar, and 1 teaspoon vanilla extract. Leave for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the flour, optional cinnamon, beaten egg, and lukewarm melted butter. Mix to form a dough, then knead for 8 minutes until smooth.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Oil a bowl lightly, place the dough inside, cover, and leave to rise until doubled.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Roll the dough on a floured surface to a thick sheet and cut six doughnuts. Arrange them with space between each piece, cover, and prove until puffy.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Preheat the air fryer for 6 minutes. Air-fry the doughnuts in batches until golden and cooked through; the center should be fully set and reach 160°F.",
      "timer_minutes": 6
    },
    {
      "step": 6,
      "text": "Whisk the icing sugar, 3 tablespoons milk, and 1/4 teaspoon vanilla extract into a smooth glaze. Dip or drizzle over the warm doughnuts and leave until set."
    }
  ],
