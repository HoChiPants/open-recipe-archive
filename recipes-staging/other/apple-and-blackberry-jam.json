{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "apple-and-blackberry-jam",
  "name": "Apple and Blackberry Jam",
  "subtitle": "A bright, softly tart fruit spread",
  "description": "Cook tart apples with lemon, then add blackberries and sugar for a richly colored jam with a balanced sweet-tart flavor.",
  "meal_type": "other",
  "yield": {
    "quantity": 1.75,
    "unit": "kg"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "bramley-apples-peeled",
      "item": "Bramley apples peeled",
      "quantity": 500,
      "unit": "g",
      "preparation": "cored, quartered and cut into 2cm chunks"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "blackberries-fresh-or-frozen",
      "item": "blackberries fresh or frozen",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "sugar",
      "item": "granulated sugar",
      "quantity": 1,
      "unit": "kg"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the apples and lemon juice in a large heavy saucepan. Cook over medium heat until the apples begin to soften, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Add the blackberries and granulated sugar, stirring until the sugar dissolves."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a steady boil, then cook for 35 minutes, stirring regularly, until thick and set.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "Test a small spoonful on a chilled plate; it should wrinkle slightly when pushed. Continue cooking briefly if needed."
    },
    {
      "step": 5,
      "text": "Transfer the hot jam to clean heatproof jars, let cool, and store according to your usual jam-storage practice."
    }
  ],
