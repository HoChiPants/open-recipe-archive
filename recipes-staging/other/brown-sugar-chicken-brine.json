  "ingredients": [
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "light-brown-sugar",
      "item": "light brown sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "minced"
    },
    {
