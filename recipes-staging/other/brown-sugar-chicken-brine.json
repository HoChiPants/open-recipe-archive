      "item": "soy sauce",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the kosher salt, brown sugar, minced garlic, and cayenne in a large food-safe container."
    },
    {
      "step": 2,
      "text": "Pour in the warm water and stir until the salt and sugar dissolve."
    },
    {
      "step": 3,
      "text": "Stir in the molasses and soy sauce until evenly blended."
    },
    {
      "step": 4,
      "text": "Let the brine rest for 50 minutes before using.",
      "timer_minutes": 50
    }
