  "id": "brown-sugar-chicken-brine",
  "name": "Brown Sugar Chicken Brine",
  "subtitle": "A sweet, savory brine with gentle heat",
  "description": "Mix this brown sugar, molasses, and soy-based brine until smooth, then allow it to rest before use.",
  "meal_type": "other",
  "cuisine": "American",
