  "id": "brie-and-cranberry-filo-parcels",
  "name": "Brie and Cranberry Filo Parcels",
  "subtitle": "Crisp pastry bites with creamy cheese and tart cranberry",
  "description": "Fold filo pastry around brie and cranberry sauce, then bake until golden for a simple vegetarian appetizer.",
  "meal_type": "other",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "sheets-filo-pastry",
      "item": "sheets filo pastry",
      "quantity": 6
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 75,
      "unit": "g",
      "preparation": "melted"
    },
    {
      "ingredient_id": "cranberry-sauce-plus-extra-to-serve",
      "item": "cranberry sauce plus extra to serve",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vegetarian-brie-cut-into-18-pieces",
      "item": "vegetarian brie cut into 18 pieces",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "poppy-seeds",
      "item": "poppy seeds",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and let the filo pastry rest at room temperature while you prepare the filling."
    },
    {
      "step": 2,
      "text": "Cut the six filo sheets into 18 portions. Brush each portion with melted butter, then place a piece of brie and a little cranberry sauce in the center."
    },
    {
      "step": 3,
      "text": "Fold the pastry around the filling to form sealed parcels. Brush the tops with more melted butter and sprinkle with poppy seeds."
    },
    {
      "step": 4,
      "text": "Arrange the parcels on a baking sheet and bake until golden brown.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Serve warm with the remaining cranberry sauce.",
      "timer_minutes": 5
    }
  ],
