  "id": "sweet-sourdough-starter",
  "name": "Sweet Sourdough Starter",
  "subtitle": "A gently sweet starter for ongoing baking",
  "description": "Build this milk-fed sourdough starter over several days, stirring and feeding it as directed before using it in baked goods.",
