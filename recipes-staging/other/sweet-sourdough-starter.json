  "instructions": [
    {
      "step": 1,
      "text": "Dissolve the yeast in the warm water and let it stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mix in the undivided flour and sugar until smooth, then transfer the mixture to a suitable container.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir until combined, cover, and let the starter stand for the full inactive period. Stir it at the required intervals during this time.",
      "timer_minutes": 9970
    },
    {
      "step": 4,
      "text": "At each feeding, add the divided flour, sugar, and milk portions, stirring each addition until smooth before returning the starter to its container."
    },
    {
      "step": 5,
      "text": "Continue the scheduled stirring and feeding operations until the starter is ready to use."
    }
