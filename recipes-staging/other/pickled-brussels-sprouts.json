      "item": "garlic",
      "quantity": 5,
      "unit": "cloves",
      "preparation": "divided"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 1.25,
      "unit": "teaspoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 5,
      "unit": "cups"
    },
    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 5,
      "unit": "cups"
    },
    {
      "ingredient_id": "pickling-salt",
      "item": "pickling salt",
      "quantity": 7,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare the Brussels sprouts and jars with water and pickling salt for 15 minutes, then drain.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Boil the jars, lids, and rings in water for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pack the Brussels sprouts into the hot jars, dividing the garlic and red pepper flakes among them."
    },
    {
      "step": 4,
      "text": "Heat the water, vinegar, and pickling salt together for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Pour the hot brine over the sprouts, leaving appropriate headspace. Wipe the rims, apply the lids and rings, and process the filled jars in boiling water for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Remove the jars and let them cool completely. Allow the pickles to rest for 3 weeks before serving."
    }
  ],
