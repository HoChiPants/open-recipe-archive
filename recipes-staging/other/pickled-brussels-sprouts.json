  "id": "pickled-brussels-sprouts",
  "name": "Pickled Brussels Sprouts",
  "subtitle": "Tangy Brussels sprouts with garlic and chile",
  "description": "Brussels sprouts are briefly prepared, packed with garlic and red pepper flakes, covered with hot vinegar brine, and processed in jars for a sharp, savory condiment.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
