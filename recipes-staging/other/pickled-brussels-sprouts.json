      "ingredient_id": "brussels-sprouts",
      "item": "Brussels sprouts",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "trimmed and cut in half"
    },
    {
      "ingredient_id": "1-pint-canning-jars-with-lids-and-rings",
      "item": "1-pint canning jars with lids and rings",
      "quantity": 5
    },
    {
