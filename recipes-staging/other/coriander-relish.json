  "instructions": [
    {
      "step": 1,
      "text": "Soak the cashews in hot water for 30 minutes, then drain."
    },
    {
      "step": 2,
      "text": "Add the drained cashews to a blender with the coriander, mint, apple, green pepper, sugar, ground cumin, ginger, garlic, chilli, and lime juice."
    },
    {
      "step": 3,
      "text": "Blend until smooth, scraping down the sides as needed."
    },
    {
      "step": 4,
      "text": "Transfer to a serving bowl and serve immediately."
    }
  ],
