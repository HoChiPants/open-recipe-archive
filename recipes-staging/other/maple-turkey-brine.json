  "id": "maple-turkey-brine",
  "name": "Maple Turkey Brine",
  "subtitle": "A sweet-savory brine with maple, garlic, and herbs",
  "description": "Simmer the concentrated brine, dilute it with the remaining water, and cool completely before using it to season turkey.",
