  "instructions": [
    {
      "step": 1,
      "text": "Combine half of the water with the brown sugar, soy sauce, maple syrup, salt, garlic, bay leaves, thyme, peppercorns, and whiskey in a large pot."
    },
    {
      "step": 2,
      "text": "Stir until the brown sugar and salt are evenly dispersed."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer and cook for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Stir in the remaining water, then cool the brine completely before using."
    },
    {
      "step": 5,
      "text": "Refrigerate the cooled brine until ready to use, and keep the turkey refrigerated while brining."
    }
  ],
