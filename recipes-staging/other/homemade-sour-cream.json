  "instructions": [
    {
      "step": 1,
      "text": "Stir the milk and distilled white vinegar together in a clean bowl. Let stand for 10 minutes, until set.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the heavy cream in a separate bowl, then stir in the milk mixture."
    },
    {
      "step": 3,
      "text": "Cover and leave at room temperature for 24 hours, until thickened.",
      "timer_minutes": 1440
    },
    {
      "step": 4,
      "text": "Chill before serving."
