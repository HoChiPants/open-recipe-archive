  "instructions": [
    {
      "step": 1,
      "text": "Cover the porcini with boiling water and leave until tender. Lift them out, chop if large, and dissolve the stock cube or stock pot in the soaking liquid."
    },
    {
      "step": 2,
      "text": "Heat some of the butter in a large skillet. Cook the steaks until browned and they reach 145°F in the center; rest for 3 minutes before slicing.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Melt the remaining butter in the skillet and cook the sliced onion until softened.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Add the porcini, chestnut mushrooms, garlic, and smoked paprika. Cook until the mushrooms are tender and browned.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the prepared stock and red wine vinegar, scraping up any browned bits.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Whisk the soured cream with the English mustard, smoked paprika, and parsley. Add it to the skillet and warm gently without boiling."
    },
    {
      "step": 7,
      "text": "Slice the rested steaks and return them to the sauce briefly, or arrange them over the sauce. Serve with mashed potatoes and extra smoked paprika."
    }
  ],
