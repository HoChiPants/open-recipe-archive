  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and warm the almonds, pistachios, and hazelnuts until lightly toasted. Line a square tin with one sheet of rice paper and dust it with icing sugar."
    },
    {
      "step": 2,
      "text": "Cut the second rice-paper sheet to fit the top of the tin. Combine the honey, caster sugar, and glucose in a heavy saucepan; bring to a boil and cook until the syrup reaches 160°F for egg safety."
    },
    {
      "step": 3,
      "text": "Whisk the egg whites until foamy. Slowly pour in the hot syrup while whisking, then continue whisking until the mixture is thick and holds its shape, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the vanilla and toasted nuts. Spread the nougat evenly in the prepared tin, cover with the second rice-paper sheet, and press it smooth."
    },
    {
      "step": 5,
      "text": "Leave the slab to set for 2 hours, then dust with icing sugar and cut into squares.",
      "timer_minutes": 120
    }
  ],
