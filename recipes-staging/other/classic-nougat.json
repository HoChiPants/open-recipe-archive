  "id": "classic-nougat",
  "name": "Classic Nougat",
  "subtitle": "A chewy honey nougat packed with toasted nuts",
  "description": "Set this light, chewy confection between sheets of edible rice paper, then cut it into small squares for serving or gifting.",
  "meal_type": "other",
  "yield": {
    "quantity": 50,
    "unit": "squares"
  },
