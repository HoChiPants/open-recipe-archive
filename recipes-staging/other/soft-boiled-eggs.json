  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "cold-eggs",
      "item": "cold eggs",
      "quantity": 6,
      "unit": "large"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour the water into a saucepan and place a steamer basket above it. Bring the water to a boil."
    },
    {
      "step": 2,
      "text": "Arrange the cold eggs in the basket, cover the pan, and steam for 9 minutes.",
      "timer_minutes": 9
    },
    {
      "step": 3,
      "text": "Check that the whites are set and the yolks reach 160°F with a food thermometer. Cool the eggs under cold running water before peeling."
    }
  ],
