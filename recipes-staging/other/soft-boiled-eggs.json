  "id": "soft-boiled-eggs",
  "name": "Soft-Boiled Eggs",
  "subtitle": "Set whites with tender yolks",
  "description": "Steam chilled eggs until the whites are set and the yolks reach a safe temperature, then cool briefly for easier peeling.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
