  "id": "slovak-easter-egg-cheese",
  "name": "Slovak Easter Egg Cheese",
  "subtitle": "A firm, gently seasoned egg-and-milk cheese for holiday meals",
  "description": "Cooked eggs and milk form delicate curds that are drained, cooled, and chilled until sliceable.",
  "meal_type": "other",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20,
    "inactive_minutes": 720
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 12
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs and salt until blended."
    },
    {
      "step": 2,
      "text": "Warm the milk in a saucepan over medium heat until steaming. Gradually whisk in the egg mixture, then cook, stirring constantly, until curds form and the mixture reaches 160°F.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Pour the curds and liquid into a cheesecloth-lined colander. Gather the cloth, secure it, and let the cheese drain for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Cool the drained cheese, then refrigerate it for 2 hours before chilling it overnight, or until firm.",
      "timer_minutes": 120
    }
  ],
