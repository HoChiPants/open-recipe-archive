  "instructions": [
    {
      "step": 1,
      "text": "Put all ingredients into a large heavy-based saucepan and stir to combine."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a gentle boil over medium heat, stirring until the sugar dissolves."
    },
    {
      "step": 3,
      "text": "Reduce the heat and simmer uncovered for about 45 minutes, stirring occasionally, until the apples are tender and the chutney is thick.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "Spoon the hot chutney into clean, heatproof jars, leaving minimal headspace. Cool before sealing and refrigerate unless processed using a validated canning method."
    }
  ],
