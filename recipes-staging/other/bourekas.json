  "id": "bourekas",
  "name": "Bourekas",
  "subtitle": "Cheese-filled puff pastry with savory accompaniments",
  "description": "Crisp puff pastry parcels filled with a savory cheese mixture, finished with sesame seeds and served with eggs, harissa, and pickled cucumbers.",
  "meal_type": "other",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "crumbled-feta",
      "item": "crumbled feta",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "cottage-cheese",
      "item": "cottage cheese",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "mature-cheddar-grated",
      "item": "mature cheddar grated",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "eggs-separated-and-beaten",
      "item": "eggs separated and beaten",
      "quantity": 2
    },
    {
      "ingredient_id": "ready-rolled-puff-pastry",
      "item": "ready-rolled puff pastry",
      "quantity": 320,
      "unit": "g"
    },
    {
      "ingredient_id": "sesame-seeds",
      "item": "sesame seeds",
      "quantity": "1-2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "hard-boiled-eggs",
      "item": "hard-boiled eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "harissa",
      "item": "harissa"
    },
    {
      "ingredient_id": "pickled-cucumbers",
      "item": "pickled cucumbers",
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F and line a baking sheet with parchment."
    },
    {
      "step": 2,
      "text": "Combine the feta, cottage cheese, and grated cheddar. Separate and beat the eggs, then mix the beaten eggs into the cheese mixture until evenly combined."
    },
    {
      "step": 3,
      "text": "Unroll the puff pastry and cut it into six equal pieces. Place filling in the center of each piece, fold the pastry over, and seal the edges firmly."
    },
    {
      "step": 4,
      "text": "Arrange the pastries on the baking sheet. Brush with the beaten egg and sprinkle with sesame seeds."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, until puffed and golden brown and the filling reaches 160°F in the center.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Cool briefly, then serve with the hard-boiled eggs, harissa, and sliced pickled cucumbers."
    }
  ],
