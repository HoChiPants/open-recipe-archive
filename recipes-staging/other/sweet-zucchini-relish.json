  "instructions": [
    {
      "step": 1,
      "text": "Finely chop the zucchini, onions, and red bell pepper. Combine them with the salt, then cover and chill for 10 hours.",
      "timer_minutes": 600
    },
    {
      "step": 2,
      "text": "Combine the chilled vegetables with the sugar, vinegar, celery seed, and turmeric in a large saucepan."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer and cook for 20 minutes, stirring occasionally.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Stir the cornstarch into the relish and continue simmering for 5 minutes, until thickened.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Prepare the jars, lids, and rings according to current food-safety guidance. Keep the jars ready for filling."
    },
    {
      "step": 6,
      "text": "Bring the relish to a simmer, fill the prepared jars, and process them using a current, validated canning procedure appropriate for this relish. Cool the filled jars before handling and storage.",
      "timer_minutes": 10
    }
  ],
