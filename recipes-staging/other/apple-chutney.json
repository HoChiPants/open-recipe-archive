  "instructions": [
    {
      "step": 1,
      "text": "Place all ingredients in a large saucepan and stir to combine."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a gentle simmer over medium heat, then cook until the apples are tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Continue simmering for 15 minutes, stirring occasionally, until the chutney thickens and the flavors combine.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Cool, cover, and refrigerate for at least 2 hours before serving or storing.",
      "timer_minutes": 120
    }
