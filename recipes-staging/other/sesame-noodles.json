  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of salted water to a simmer. Add the linguine and cook for 10 minutes, or until tender. Drain and transfer to a large bowl.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Warm the soy sauce and chili sauce in a saucepan over medium heat. Stir in the garlic, sugar, safflower oil, rice vinegar, sesame oil, and sesame seeds; bring the mixture to a brief simmer until the sugar dissolves."
    },
    {
      "step": 3,
      "text": "Pour the sauce over the drained linguine and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Garnish with the sliced green onions and toasted sesame seeds, then serve."
    }
  ],
