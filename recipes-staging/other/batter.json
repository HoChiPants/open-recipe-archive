  "id": "batter",
  "name": "Batter",
  "subtitle": "A simple flour-and-water batter for frying",
  "description": "Mix self-raising flour with cold water, then fry portions in oil until golden brown.",
  "meal_type": "other",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "l-sunflower-or-vegetable-oil-for-frying",
      "item": "L sunflower or vegetable oil for frying",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the self-raising flour and cold water in a bowl until smooth."
    },
    {
      "step": 2,
      "text": "Transfer the batter to a jug or other easy-pouring container."
    },
    {
      "step": 3,
      "text": "Preheat the sunflower or vegetable oil in a frying pan over medium heat."
    },
    {
      "step": 4,
      "text": "Pour the batter into the hot oil in portions and cook, turning as needed, until golden brown.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer the fried batter to a plate and prepare the remaining portions."
    }
  ],
