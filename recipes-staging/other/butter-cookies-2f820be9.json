  "id": "butter-cookies-2f820be9",
  "name": "Butter Cookies",
  "subtitle": "Tender vanilla cookies with crisp edges",
  "description": "A simple four-ingredient cookie made by creaming softened butter with vanilla and icing sugar, then mixing in flour before baking.",
  "meal_type": "other",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "salted-butter-softened",
      "item": "salted butter softened",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 250,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter, vanilla extract, and icing sugar until smooth and well combined."
    },
    {
      "step": 3,
      "text": "Add the plain flour and whisk until the mixture is combined."
    },
    {
      "step": 4,
      "text": "Prepare a baking tray, then transfer the dough onto it."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Transfer the cookies to a rack and let them stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
