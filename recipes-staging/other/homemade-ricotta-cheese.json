  "id": "homemade-ricotta-cheese",
  "name": "Homemade Ricotta Cheese",
  "subtitle": "Fresh, creamy ricotta made with cultured dairy",
  "description": "Heat the dairy mixture until curds form, then strain it through cheesecloth for a fresh homemade cheese.",
  "meal_type": "other",
  "cuisine": "Italian",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 1,
      "unit": "gallon"
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 1,
      "unit": "quart"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "pint"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "inch-squares-cheesecloth",
      "item": "inch squares cheesecloth",
      "quantity": 18
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Line a large colander with the inch squares cheesecloth and place it over a deep bowl."
    },
    {
      "step": 2,
      "text": "Combine the whole milk, buttermilk, heavy cream, and kosher salt in a large pot. Heat gently, stirring occasionally, until the mixture reaches 190°F.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Remove from the heat and leave undisturbed until curds separate from the whey.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Transfer the curds and whey to the lined colander. Gather the cheesecloth around the curds and let the ricotta drain thoroughly.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Transfer the drained ricotta to a container and cut or portion as desired."
    }
  ],
