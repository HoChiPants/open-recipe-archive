  "id": "baked-camembert-with-garlic-and-thyme",
  "name": "Baked Camembert with Garlic and Thyme",
  "subtitle": "Warm, herb-scented cheese for sharing",
  "description": "Bake Camembert with garlic, thyme, and olive oil, then serve it warm with crusty bread.",
  "meal_type": "other",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "garlic",
      "item": "garlic cloves",
      "quantity": 8
    },
    {
      "ingredient_id": "thyme-sprigs",
      "item": "thyme sprigs",
      "quantity": 2
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "baking-camembert-with-a-cross-cut-into-the-top",
      "item": "baking camembert with a cross cut into the top",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "crusty-bread-to-serve",
      "item": "crusty bread to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Separate the garlic cloves and strip the thyme leaves from the sprigs."
    },
    {
      "step": 2,
      "text": "Place the Camembert in a small ovenproof dish, keeping the cross cut facing up."
    },
    {
      "step": 3,
      "text": "Arrange the garlic around the cheese and pour the olive oil over the garlic and cheese."
    },
    {
      "step": 4,
      "text": "Bake for 30 minutes, until the cheese is soft and the garlic is tender.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Let the dish cool for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Mash or spread the softened garlic as desired, then serve the warm Camembert with the crusty bread."
    }
  ],
