  "id": "basic-mayonnaise",
  "name": "Basic Mayonnaise",
  "subtitle": "A creamy emulsified egg-and-oil condiment",
  "description": "Whisk egg yolks with mustard, then slowly emulsify sunflower oil and finish with vinegar or lemon juice.",
  "meal_type": "other",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 2
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "sunflower-oil",
      "item": "sunflower oil",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "white-wine-vinegar-or-lemon-juice",
      "item": "white wine vinegar or lemon juice",
      "quantity": 2,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the egg yolks and Dijon mustard together in a bowl until smooth."
    },
    {
      "step": 2,
      "text": "Gradually add the sunflower oil in a thin, steady stream, whisking continuously until the mixture thickens and emulsifies."
    },
    {
      "step": 3,
      "text": "Whisk in the white wine vinegar or lemon juice until evenly combined."
    },
    {
      "step": 4,
      "text": "For raw-egg safety, use pasteurized yolks or verify with a food thermometer that the egg mixture reaches 160°F; serve once the mayonnaise is thick and smooth."
    }
  ],
