  "id": "chocolate-hot-cross-buns",
  "name": "Chocolate Hot Cross Buns",
  "subtitle": "Soft cocoa buns with chocolate pieces and a sweet cross",
  "description": "Rich, lightly spiced-style chocolate buns finished with a flour cross and apricot glaze.",
  "meal_type": "other",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "milk-warmed",
      "item": "milk warmed",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "strong-white-bread-flour-plus-extra-for-dusting",
      "item": "strong white bread flour plus extra for dusting",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "white-chocolate-chunks",
      "item": "white chocolate chunks",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "milk-chocolate-chunks",
      "item": "milk chocolate chunks",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "sachet-fast-action-dried-yeast",
      "item": "sachet fast-action dried yeast",
      "quantity": 7,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "unsalted-butter-cut-into-cubes-and-softened",
      "item": "unsalted butter cut into cubes and softened",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "apricot-jam",
      "item": "apricot jam",
      "quantity": 2,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs with the warmed milk. Set aside a small portion of the milk mixture if needed for finishing, then stir in the milk chocolate chunks."
    },
    {
      "step": 2,
      "text": "Combine the bread flour, cocoa powder, yeast, golden caster sugar, and white chocolate chunks. Add the egg mixture and knead until a rough dough forms."
    },
    {
      "step": 3,
      "text": "Work in the softened butter a little at a time, then knead for about 10 minutes until smooth and elastic.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Cover the dough and let it rise until doubled in size. Divide it into 9 portions, shape into buns, and arrange on a lined baking tray."
    },
    {
      "step": 5,
      "text": "Combine the plain flour and caster sugar with enough softened butter to make a thick paste. Pipe or press crosses over the buns."
    },
    {
      "step": 6,
      "text": "Bake until risen and set, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Warm the apricot jam and brush it over the hot buns. Cool before serving."
    }
  ],
