      "item": "pickling salt",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cider-vinegar",
      "item": "cider vinegar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "celery-seed",
      "item": "celery seed",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "mustard-seed",
      "item": "mustard seed",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the cucumbers, onions, and both bell peppers in a large bowl. Mix in the pickling salt and let the mixture stand for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Drain the vegetables thoroughly, then rinse and drain them again to remove excess salt."
    },
    {
      "step": 3,
      "text": "In a large saucepan, bring the cider vinegar, celery seed, mustard seed, and white sugar to a simmer. Stir until the sugar dissolves, then continue simmering for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the drained vegetables to the saucepan and cook gently for 10 minutes, stirring occasionally, until heated through and tender-crisp.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer the relish to clean containers, let it cool, and refrigerate. Allow the flavors to rest for 24 hours before serving.",
      "timer_minutes": 1440
    }
  ],
