  "id": "sweet-pickle-relish",
  "name": "Sweet Pickle Relish",
  "subtitle": "A crisp, tangy relish with a gently spiced finish",
  "description": "Chopped cucumbers, onions, and peppers are salted, drained, and simmered with sweetened cider vinegar for a versatile condiment.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 180,
    "unit": "servings"
  },
