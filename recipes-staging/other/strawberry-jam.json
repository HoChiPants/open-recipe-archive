{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "strawberry-jam",
  "name": "Strawberry Jam",
  "subtitle": "A bright, fruit-forward spread made on the stovetop",
  "description": "Cook hulled strawberries with sugar and lemon juice until thick and set, then cool before serving.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 40,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "hulled"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Crush the hulled strawberries to the desired texture and place them in a large saucepan."
    },
    {
      "step": 2,
      "text": "Add the sugar and lemon juice, stirring until evenly combined."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a boil over medium-high heat, stirring frequently."
    },
    {
      "step": 4,
      "text": "Reduce the heat and simmer until thickened and the mixture reaches 220°F, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Remove from the heat and let the jam stand for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Transfer the jam to clean containers, cool, and refrigerate until set, about 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 7,
      "text": "Serve chilled or at room temperature."
    }
  ],
