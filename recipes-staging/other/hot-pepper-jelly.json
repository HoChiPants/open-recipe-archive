{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "hot-pepper-jelly",
  "name": "Hot Pepper Jelly",
  "subtitle": "Sweet pepper jelly with a jalapeño kick",
  "description": "A bright, sweet-tart jelly made with bell peppers, jalapeños, vinegar, and pectin.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 15,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "finely-chopped-red-bell-peppers",
      "item": "finely chopped red bell peppers",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "finely-chopped-green-bell-peppers",
      "item": "finely chopped green bell peppers",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "finely-chopped-jalapeno-peppers",
      "item": "finely chopped jalapeno peppers",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "apple-cider-vinegar",
      "item": "apple cider vinegar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "powdered-pectin",
      "item": "powdered pectin",
      "quantity": 1,
      "unit": "package",
      "preparation": "1.75 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the chopped red peppers, green peppers, and jalapeños in a large saucepan."
    },
    {
      "step": 2,
      "text": "Stir the vinegar and powdered pectin together in the saucepan, then bring the mixture to a simmer over medium heat."
    },
    {
      "step": 3,
      "text": "Add the sugar, stirring until dissolved. Return the mixture to a simmer and cook until thickened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Remove from the heat and transfer the hot jelly to clean containers."
    },
    {
      "step": 5,
      "text": "Cool, cover, and refrigerate for at least 1 hour before serving. For shelf-stable storage, use a current tested home-canning procedure rather than improvising one.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Serve chilled or at room temperature."
    }
  ],
