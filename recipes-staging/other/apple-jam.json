  "id": "apple-jam",
  "name": "Apple Jam",
  "subtitle": "A simple, warmly spiced fruit spread",
  "description": "Soft apples cook with sugar, lemon, and cinnamon into a thick, spoonable jam.",
  "meal_type": "other",
  "yield": {
    "quantity": 2,
    "unit": "x 500g jars"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "bramley-apples-peeled",
      "item": "Bramley apples peeled",
      "quantity": 1,
      "unit": "kg",
      "preparation": "cored and chopped"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "cinnamon-stick",
      "item": "cinnamon stick",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the chopped apples and caster sugar in a large saucepan. Cook over medium heat until the apples soften and the mixture simmers.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Continue cooking the apples until tender and nearly smooth.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Stir in the lemon juice and cinnamon stick, then cook until the jam thickens.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Remove the cinnamon stick. Cool the jam briefly, transfer it to jars, and chill."
    }
  ],
