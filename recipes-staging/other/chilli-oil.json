{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chilli-oil",
  "name": "Chilli Oil",
  "subtitle": "A fragrant, savoury oil with crisp aromatics and Sichuan pepper",
  "description": "Infuse vegetable oil with shallots, garlic, ginger, chilli, and peppercorns, then finish with soy sauce and sugar for a versatile spicy condiment.",
  "meal_type": "other",
  "yield": {
    "quantity": 1,
    "unit": "x 300ml jar"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "shallots-finely-sliced-use-a-mandoline",
      "item": "shallots finely sliced (use a mandoline",
      "quantity": 3,
      "preparation": "if you have one)"
    },
    {
      "ingredient_id": "garlic-cloves-thinly-sliced",
      "item": "garlic cloves thinly sliced",
      "quantity": 6
    },
    {
      "ingredient_id": "chilli-flakes-optional",
      "item": "chilli flakes",
      "quantity": 3,
      "unit": "tsp"
    },
    {
      "ingredient_id": "sichuan-peppercorns-lightly-crushed",
      "item": "Sichuan peppercorns lightly crushed",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ginger-peeled-and-sliced-into-thin-matchsticks",
      "item": "ginger peeled and sliced into thin matchsticks",
      "quantity": 20,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "light-soy-sauce",
      "item": "light soy sauce",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "of-msg-optional",
      "item": "of MSG (optional)",
      "unit": "pinch",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Put the oil, shallots, ginger, and Sichuan peppercorns in a saucepan. Heat gently for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the garlic and cook until the aromatics are lightly golden and fragrant.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the chilli flakes, caster sugar, light soy sauce, and optional MSG. Remove from the heat and mix well."
    },
    {
      "step": 4,
      "text": "Let the oil cool, then transfer it with the aromatics to a clean 300ml jar."
    }
  ],
