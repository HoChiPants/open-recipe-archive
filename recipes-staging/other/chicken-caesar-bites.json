  "instructions": [
    {
      "step": 1,
      "text": "Stir the mayonnaise, soured cream, mustard, garlic granules, lemon juice, anchovies, parmesan, and chopped chives together."
    },
    {
      "step": 2,
      "text": "Fold in the cooked chicken until evenly coated."
    },
    {
      "step": 3,
      "text": "Spoon the mixture onto the crispbreads or melba toasts."
    },
    {
      "step": 4,
      "text": "Finish with the cooked chopped bacon and extra chives, then serve."
    }
