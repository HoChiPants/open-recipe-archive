  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour with enough water to make a soft dough. Knead briefly, divide into two pieces, roll out on a floured surface, and set aside."
    },
    {
      "step": 2,
      "text": "Mix the yogurt with the chilli powder, garlic, lime zest, and lime juice. Coat the onion, pepper, and chicken in the mixture."
    },
    {
      "step": 3,
      "text": "Heat a large pan over medium-high heat and cook the chicken mixture for about 10 minutes, turning and stirring, until the chicken reaches 165°F internally and the vegetables are tender.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Heat the oil in a separate pan. Cook the rolled dough pieces for about 1 minute per side, until lightly browned and cooked through.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Fill the warm wraps with the chicken mixture, avocado, and coriander. Fold and serve."
    }
  ],
