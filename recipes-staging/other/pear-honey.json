  "id": "pear-honey",
  "name": "Pear Honey",
  "subtitle": "A smooth pear-and-pineapple fruit spread",
  "description": "Cook chopped pears with pineapple juice and sugar until thick, glossy, and spreadable.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 64,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "peeled",
      "item": "peeled",
      "quantity": 8,
      "unit": "cups",
      "preparation": "cored and chopped pears"
    },
    {
      "ingredient_id": "unsweetened-pineapple-juice",
      "item": "unsweetened pineapple juice",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 8,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the chopped pears, pineapple juice, and sugar in a large heavy pot. Stir until evenly mixed."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a boil over medium-high heat, stirring frequently.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Reduce the heat and cook uncovered, stirring occasionally, until the fruit breaks down and the mixture becomes thick and spreadable.",
      "timer_minutes": 180
    },
    {
      "step": 4,
      "text": "Remove from the heat and let the pear honey cool before serving or refrigerating."
    }
  ],
