  "id": "homemade-jewelry-cleaner",
  "name": "Homemade Jewelry Cleaner",
  "subtitle": "A warm foil-lined soak for cleaning suitable metal jewelry.",
  "description": "A quick cleaning solution made with warm water, foil, salt, baking soda, and dish detergent.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 1,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sheet-aluminum-foil",
      "item": "sheet aluminum foil",
      "quantity": 1
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "dish-detergent",
      "item": "dish detergent",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the water until hot, then carefully pour it into a heat-safe bowl lined with the sheet aluminum foil.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Stir in the salt, baking soda, and dish detergent until combined."
    },
    {
      "step": 3,
      "text": "Place suitable metal jewelry in the foil-lined solution and let it soak. Avoid using this cleaner on delicate stones, pearls, or jewelry with porous finishes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Remove the jewelry carefully, rinse well with clean water, and dry completely. Let the solution cool before handling or discarding it."
    }
  ],
