  "instructions": [
    {
      "step": 1,
      "text": "Combine the pomegranate juice, lemon juice, and sugar in a large saucepan. Bring the mixture to a simmer, stirring until the sugar dissolves."
    },
    {
      "step": 2,
      "text": "Stir in the liquid pectin and return the mixture to a boil."
    },
    {
      "step": 3,
      "text": "Simmer for 5 minutes, stirring as needed.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Transfer the hot jelly to clean containers. Let it rest until set, then cool completely and refrigerate.",
