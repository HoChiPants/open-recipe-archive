{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "brown-butter-frosting",
  "name": "Brown Butter Frosting",
  "subtitle": "A smooth, nutty frosting for cakes and cupcakes",
  "description": "Brown butter gives this simple frosting a warm, toasted flavor, while milk adjusts it to a spreadable consistency.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the butter in a saucepan over medium heat until melted and lightly browned, about 5 minutes. Remove from the heat and let it cool briefly.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk the confectioners' sugar into the butter until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the milk and vanilla extract."
    },
    {
      "step": 4,
      "text": "Whisk until the frosting is smooth and thick, adding more milk as needed to reach a spreadable consistency."
    }
  ],
