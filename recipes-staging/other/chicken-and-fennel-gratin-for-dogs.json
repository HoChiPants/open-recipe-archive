{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chicken-and-fennel-gratin-for-dogs",
  "name": "Chicken and Fennel Gratin for Dogs",
  "subtitle": "A tender chicken and vegetable bake with a crisp topping",
  "description": "Chicken thighs simmer with fennel, celery, carrot, and sage in a lightly thickened stock, then finish with crushed dog biscuits and parmesan.",
  "meal_type": "other",
  "yield": {
    "quantity": 1,
    "unit": "large or 2 small gratins"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "fennel-bulb-halved",
      "item": "fennel bulb halved",
      "quantity": 1,
      "preparation": "cored and finely sliced"
    },
    {
      "ingredient_id": "celery-stick-finely-diced",
      "item": "celery stick finely diced",
      "quantity": 1
    },
    {
      "ingredient_id": "carrot-cut-into-5mm-dice",
      "item": "carrot cut into 5mm dice",
      "quantity": 1
    },
    {
      "ingredient_id": "garlic-clove-finely-chopped",
      "item": "garlic clove finely chopped (optional)",
      "quantity": 1,
      "optional": true
    },
    {
      "ingredient_id": "buckwheat-flour-or-brown-rice-flour",
      "item": "buckwheat flour or brown rice flour",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "salt-free-chicken-or-vegetable-stock-or-water",
      "item": "salt-free chicken or vegetable stock or water",
      "quantity": 600,
      "unit": "ml"
    },
    {
      "ingredient_id": "skinless-chicken-thighs-you-can-cook-with-the-bone-in-if-you-like",
      "item": "skinless chicken thighs you can cook with the bone in if you like",
      "quantity": 4,
      "preparation": "but make sure you remove every trace of bone once cooked)"
    },
    {
      "ingredient_id": "sage-leaves-roughly-chopped",
      "item": "sage leaves roughly chopped",
      "quantity": "4-6"
    },
    {
      "ingredient_id": "few-dog-biscuits-crushed",
      "item": "few dog biscuits crushed"
    },
    {
      "ingredient_id": "few-gratings-parmesan",
      "item": "few gratings parmesan"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Warm the olive oil in a pan, add the fennel and chicken thighs, and cook for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the celery, carrot, and optional garlic. Stir in the flour, then gradually add the stock or water, keeping the chicken in the pan."
    },
    {
      "step": 3,
      "text": "Cook until the chicken is cooked through and reaches 165°F at the thickest part, about 15 minutes. Remove the chicken, discard any bones, and shred the meat.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Simmer the pan liquid until thickened, then return the shredded chicken to the pan and stir in the sage."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to one large or two small gratin dishes. Scatter the crushed dog biscuits and parmesan over the top, then bake until warmed through and lightly gratinated, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Cool completely before serving to the dog."
    }
  ],
