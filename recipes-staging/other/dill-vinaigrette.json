  "id": "dill-vinaigrette",
  "name": "Dill Vinaigrette",
  "subtitle": "Tangy herb dressing for salads and vegetables",
  "description": "A quick oil-and-vinegar dressing seasoned with dill, mustard, garlic, onion, and pepper.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
