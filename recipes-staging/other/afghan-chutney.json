  "id": "afghan-chutney",
  "name": "Afghan Chutney",
  "subtitle": "A bright, spicy coriander dip",
  "description": "Combine fresh green chillies, coriander, garlic, citrus, sugar, and vinegar for a sharp, herbaceous chutney served as a dip.",
  "meal_type": "other",
  "yield": {
    "quantity": 4,
    "unit": "as a dip"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "green-chillies-sliced",
      "item": "green chillies sliced",
      "quantity": 2
    },
    {
      "ingredient_id": "bunch-of-coriander-chopped",
      "item": "bunch of coriander chopped",
      "quantity": 25,
      "unit": "g"
    },
    {
      "ingredient_id": "garlic-cloves-finely-grated",
      "item": "garlic cloves finely grated",
      "quantity": 3
    },
    {
      "ingredient_id": "lemons-or-limes",
      "item": "lemons or limes",
      "quantity": 2,
      "preparation": "juiced"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": "1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 110,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sliced chillies, chopped coriander, and grated garlic in a bowl."
    },
    {
      "step": 2,
      "text": "Stir the caster sugar and distilled white vinegar together until the sugar dissolves."
    },
    {
      "step": 3,
      "text": "Mix the vinegar mixture and citrus juice into the herb mixture until evenly combined."
    },
    {
      "step": 4,
      "text": "Chill the chutney briefly, then serve as a dip."
    }
  ],
