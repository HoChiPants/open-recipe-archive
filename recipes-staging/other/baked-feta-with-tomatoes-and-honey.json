  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and place the feta, tomatoes, and sliced onion in a baking dish."
    },
    {
      "step": 2,
      "text": "Whisk the olive oil, crushed garlic, herbs, and honey together, then pour the mixture over the feta and tomatoes."
    },
    {
      "step": 3,
      "text": "Bake until the tomatoes are softened and beginning to burst and the feta is hot.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "Finish with extra olive oil and a drizzle of honey. Serve with green salad and crusty bread."
    }
