  "id": "citrus-gift-tags",
  "name": "Citrus Gift Tags",
  "subtitle": "Handmade tags with painted citrus prints",
  "description": "Create simple gift tags by using a cut citrus fruit as a stamp, then finish each card with a message and hanging loop.",
  "meal_type": "other",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
