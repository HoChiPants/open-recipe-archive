    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "clementine-orange-or-other-citrus-fruit",
      "item": "clementine orange or other citrus fruit",
      "quantity": 1
    },
    {
      "ingredient_id": "paint-brush",
      "item": "paint brush"
    },
    {
      "ingredient_id": "acrylic-paint",
      "item": "acrylic paint"
    },
    {
      "ingredient_id": "card",
      "item": "card"
    },
    {
      "ingredient_id": "hole-punch",
      "item": "hole punch"
    },
    {
