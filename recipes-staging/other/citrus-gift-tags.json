    },
    {
      "ingredient_id": "stencil-optional",
      "item": "stencil (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the citrus fruit to expose a flat cut surface."
    },
    {
      "step": 2,
      "text": "Apply acrylic paint to the cut surface with the paint brush."
    },
    {
      "step": 3,
      "text": "Press the painted fruit onto the card to make one or more prints."
    },
    {
      "step": 4,
      "text": "Set the printed card aside until the paint is dry."
    },
    {
      "step": 5,
      "text": "Cut the card into gift-tag shapes."
    },
    {
      "step": 6,
      "text": "Punch a hole near the top of each tag and thread through string or ribbon."
    },
    {
      "step": 7,
      "text": "Write a message by hand, or use the optional stencil with a felt tip or permanent marker."
    }
  ],
