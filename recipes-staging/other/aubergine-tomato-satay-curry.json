  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large pot. Add the aubergines and cook until softened, about 9 minutes.",
      "timer_minutes": 9
    },
    {
      "step": 2,
      "text": "Add the diced onion and cook until tender, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Stir in the garlic purée, ginger purée, curry powder, and turmeric. Cook briefly until fragrant."
    },
    {
      "step": 4,
      "text": "Add the cherry tomatoes, soy sauce, honey or agave, coconut milk, and peanut butter. Stir until combined."
    },
    {
      "step": 5,
      "text": "Simmer uncovered until the curry thickens, about 20 minutes, stirring occasionally.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Cool completely before freezing if storing for later. Reheat thoroughly before serving."
    },
    {
      "step": 7,
      "text": "Stir in the chopped coriander and lime juice."
    },
    {
      "step": 8,
      "text": "Serve with the steamed basmati rice and crispy onions."
    }
  ],
