  "id": "christmas-crinkle-cookies",
  "name": "Christmas Crinkle Cookies",
  "subtitle": "Chocolate-orange cookies with a crisp sugar coating",
  "description": "Tender spiced chocolate cookies rolled in sugar and baked until firm, with orange zest adding brightness.",
  "meal_type": "other",
  "yield": {
    "quantity": 30,
    "unit": "cookies"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cocoa-powder-sieved",
      "item": "cocoa powder sieved",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 60,
      "unit": "ml"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 180,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "oranges-zested",
      "item": "oranges zested",
      "quantity": 2
    },
    {
      "ingredient_id": "mixed-spice",
      "item": "mixed spice",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "cinnamon",
      "item": "cinnamon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 50,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Reserve a little of the caster sugar and icing sugar for coating. Mix the remaining sugars with the cocoa powder, oil, eggs, and orange zest until smooth."
    },
    {
      "step": 2,
      "text": "Whisk the plain flour, baking powder, mixed spice, and cinnamon together, then stir into the cocoa mixture to form a soft dough."
    },
    {
      "step": 3,
      "text": "Cover and chill the dough until firm.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Preheat the oven to a moderate baking temperature and line a baking sheet."
    },
    {
      "step": 5,
      "text": "Shape the dough into about 30 balls. Roll each in the reserved caster sugar, then the icing sugar, and arrange on the baking sheet with space between them."
    },
    {
      "step": 6,
      "text": "Bake until the cookies are puffed and firm at the edges.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Cool on the baking sheet briefly, then transfer to a rack to finish cooling."
    }
  ],
