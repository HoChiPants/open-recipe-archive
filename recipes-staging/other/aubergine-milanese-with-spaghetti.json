  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Cut the aubergine into slices."
    },
    {
      "step": 2,
      "text": "Arrange the flour, beaten eggs, and breadcrumbs mixed with the finely grated Grana Padano in separate shallow dishes. Coat each aubergine slice in flour, egg, and breadcrumb mixture."
    },
    {
      "step": 3,
      "text": "Heat some of the olive oil in a pan. Sauté the coated aubergine for 3 minutes, turning once, then transfer it to a baking tray and bake until tender, about 20 minutes.",
      "timer_minutes": 23
    },
    {
      "step": 4,
      "text": "Warm the remaining olive oil with the crushed garlic. Add the chopped tomatoes and simmer until thickened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Cook the spaghetti until tender, then drain and coat it with the tomato sauce."
    },
    {
      "step": 6,
      "text": "Serve the spaghetti with the baked aubergine, shaved Grana Padano, and rocket salad."
    }
  ],
