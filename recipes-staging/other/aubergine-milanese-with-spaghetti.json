  "id": "aubergine-milanese-with-spaghetti",
  "name": "Aubergine Milanese with Spaghetti",
  "subtitle": "Crisp breaded aubergine with tomato spaghetti",
  "description": "Breaded aubergine is browned and baked until tender, then served with spaghetti in a simple tomato and garlic sauce.",
  "meal_type": "other",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
