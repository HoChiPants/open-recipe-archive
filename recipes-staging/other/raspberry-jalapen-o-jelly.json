  "instructions": [
    {
      "step": 1,
      "text": "Combine the raspberries, bell pepper, jalapeño, sugar, and vinegar in a saucepan."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a full boil and boil for 5 minutes, stirring as needed.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the liquid pectin and continue heating until evenly blended."
    },
    {
      "step": 4,
      "text": "Transfer the hot jelly to clean containers, let cool, then chill before serving."
    }
