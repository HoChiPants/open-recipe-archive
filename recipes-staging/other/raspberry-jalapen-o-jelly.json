  "id": "raspberry-jalapen-o-jelly",
  "name": "Raspberry Jalapeño Jelly",
  "subtitle": "Sweet raspberry jelly with a fresh pepper kick",
  "description": "A bright, sweet-tart jelly combining raspberries, peppers, vinegar, and liquid pectin.",
