  "id": "sweet-red-bean-paste",
  "name": "Sweet Red Bean Paste",
  "subtitle": "A smooth, lightly sweetened bean paste for desserts and snacks.",
  "description": "Tender red beans are cooked until soft, drained, and finished with sugar until thick enough to shape or spread.",
  "meal_type": "other",
  "cuisine": "Asian",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 115
  },
  "ingredients": [
    {
      "ingredient_id": "dried-red-beans",
      "item": "dried red beans",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Rinse the dried red beans and place them in a pot with enough water to cover generously."
    },
    {
      "step": 2,
      "text": "Bring to a simmer, cook for 5 minutes, then drain and discard the cooking water.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Return the beans to the pot, cover with fresh water, and simmer until very tender, about 100 minutes.",
      "timer_minutes": 100
    },
    {
      "step": 4,
      "text": "Drain thoroughly, return the beans to the pot, and stir in the white sugar."
    },
    {
      "step": 5,
      "text": "Cook over low heat, stirring frequently, until the mixture thickens and can be shaped or spread.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Transfer to a clean container and cool before using."
    }
  ],
