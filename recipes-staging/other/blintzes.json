      "item": "butter",
      "quantity": 20,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, beaten eggs, sunflower oil, and milk until smooth. Chill the batter for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Stir the ricotta, soft cheese, 1 tablespoon golden caster sugar, vanilla, and 1 tablespoon icing sugar until smooth. Chill until needed."
    },
    {
      "step": 3,
      "text": "Put the blueberries, remaining golden caster sugar, lemon juice, and remaining icing sugar in a saucepan. Warm over medium heat for about 10 minutes, stirring occasionally, until the berries soften and the mixture sets slightly. Cool.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Melt the butter in a frying pan over medium heat. Add enough batter to coat the base, swirling the pan to make a thin pancake. Cook until set, then turn or cook the top briefly. Repeat with the remaining batter."
    },
    {
      "step": 5,
      "text": "Spoon the chilled cheese filling onto each pancake and fold into parcels. Heat a little extra sunflower oil in the pan, add the blintzes, and cook for about 2 minutes per side until lightly browned.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Transfer the blintzes to plates and serve with the blueberry topping."
    }
  ],
