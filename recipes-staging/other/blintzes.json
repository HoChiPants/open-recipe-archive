  "id": "blintzes",
  "name": "Blintzes",
  "subtitle": "Tender filled pancakes with ricotta and blueberries",
  "description": "Make thin pancakes, fill them with a chilled ricotta mixture, and serve with warm blueberries and lemon.",
  "meal_type": "other",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 55,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "eggs-beaten",
      "item": "eggs beaten",
      "quantity": 3,
      "unit": "medium"
    },
    {
      "ingredient_id": "sunflower-oil-plus-extra-for-frying",
      "item": "sunflower oil plus extra for frying",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "milk-any-kind",
      "item": "milk (any kind)",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "ricotta-cheese",
      "item": "ricotta cheese",
      "quantity": 250,
      "unit": "g"
    },
    {
