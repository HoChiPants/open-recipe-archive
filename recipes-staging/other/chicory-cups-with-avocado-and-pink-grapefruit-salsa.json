      "item": "chicory heads",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Peel and segment the grapefruit, removing excess pith, then cut the segments into small pieces."
    },
    {
      "step": 2,
      "text": "Peel and dice the avocado. Combine it with the grapefruit, chopped chilli, coriander, olive oil, and lime juice, stirring gently to keep the avocado intact."
    },
    {
      "step": 3,
      "text": "Separate the chicory heads into individual leaves and arrange the leaves as cups."
    },
    {
      "step": 4,
      "text": "Spoon the avocado and grapefruit salsa into the chicory leaves and serve immediately."
    }
  ],
