  "id": "almond-orange-mandelbrot",
  "name": "Almond-Orange Mandelbrot",
  "subtitle": "Crisp twice-baked almond cookies with orange and dark chocolate",
  "description": "A firm, sliceable cookie made with ground almonds, matzo meal, orange zest, dark chocolate, and chopped almonds, then baked twice for a crisp finish.",
  "meal_type": "other",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "ground-almonds",
      "item": "ground almonds",
      "quantity": 180,
      "unit": "g"
    },
    {
      "ingredient_id": "fine-matzo-meal",
      "item": "fine matzo meal",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "sunflower-oil",
      "item": "sunflower oil",
      "quantity": 60,
      "unit": "ml"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "orange-zested",
      "item": "orange zested",
      "quantity": 1
    },
    {
      "ingredient_id": "dark-chocolate-roughly-chopped-into-1cm-pieces",
      "item": "dark chocolate roughly chopped into 1cm pieces",
      "quantity": 90,
      "unit": "g"
    },
    {
      "ingredient_id": "blanched-almonds-roughly-chopped",
      "item": "blanched almonds roughly chopped",
      "quantity": 80,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and line a baking sheet with parchment."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, caster sugar, and orange zest for 4 minutes, until thickened. Whisk in the sunflower oil.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Combine the ground almonds, fine matzo meal, and chopped blanched almonds. Stir in the chocolate, then mix the dry ingredients into the egg mixture to form a firm dough."
    },
    {
      "step": 4,
      "text": "Shape the dough into two evenly sized logs on the prepared sheet."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, until set and lightly browned. Cool on the sheet for 10 minutes.",
      "timer_minutes": 55
    },
    {
      "step": 6,
      "text": "Slice the logs into even pieces and arrange them cut-side up on the sheet."
    },
    {
      "step": 7,
      "text": "Bake for 15 minutes, turn the pieces, and bake for another 15 minutes, until firm and crisp.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Cool completely before serving."
    }
  ],
