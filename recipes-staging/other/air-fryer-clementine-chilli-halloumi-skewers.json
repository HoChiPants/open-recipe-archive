  "instructions": [
    {
      "step": 1,
      "text": "Mix the clementine zest and juice, marmalade, triple sec if using, chilli flakes, and oil in a bowl."
    },
    {
      "step": 2,
      "text": "Cut the halloumi into skewer-sized pieces and toss with the marinade. Cover and chill for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Thread the halloumi onto skewers and preheat the air fryer according to the manufacturer's instructions."
    },
    {
      "step": 4,
      "text": "Arrange the skewers in the air-fryer basket in a single layer. Cook for 5 minutes, then continue cooking as needed until golden and 8 minutes total.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Serve hot with sweet chilli sauce or sriracha mayo."
    }
