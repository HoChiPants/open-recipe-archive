{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cheese-grissini",
  "name": "Cheese Grissini",
  "subtitle": "Crisp Italian breadsticks with cheese and poppy seeds",
  "description": "Thin, savory breadsticks made with grated cheese, olive oil, and poppy seeds.",
  "meal_type": "other",
  "cuisine": "Italian",
  "yield": {
    "quantity": 35,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "strong-white-bread-flour",
      "item": "strong white bread flour",
      "quantity": 350,
      "unit": "g"
    },
    {
      "ingredient_id": "fine-sea-salt",
      "item": "fine sea salt",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "sachet-fast-action-yeast",
      "item": "sachet fast-action yeast",
      "quantity": 7,
      "unit": "g"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "grana-padano-finely-grated",
      "item": "Grana Padano finely grated",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "poppy-seeds",
      "item": "poppy seeds",
      "quantity": 2,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, salt, yeast, and grated Grana Padano. Add the olive oil and mix until a dough forms."
    },
    {
      "step": 2,
      "text": "Knead the dough for 10 minutes, until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Cover and leave the dough to rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Divide and roll the dough into thin, even breadsticks. Transfer them to a prepared baking sheet."
    },
    {
      "step": 5,
      "text": "Preheat the oven and finish the breadsticks with poppy seeds and the remaining grated cheese."
    },
    {
      "step": 6,
      "text": "Bake for 15 minutes, until crisp and lightly golden.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Cool on the baking sheet, then serve."
    }
  ],
