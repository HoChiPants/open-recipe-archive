{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "clementine-curd",
  "name": "Clementine Curd",
  "subtitle": "Bright citrus spread with a smooth, buttery finish",
  "description": "A sweet-tart clementine and lemon curd for toast, pastries, or desserts.",
  "meal_type": "other",
  "yield": {
    "quantity": 2,
    "unit": "x 324ml jars"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "eggs-plus-3-egg-yolks",
      "item": "eggs plus 3 egg yolks",
      "quantity": 3,
      "preparation": "lightly beaten"
    },
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 80,
      "unit": "g"
    },
    {
      "ingredient_id": "fresh-clementine-juice-from-about-6-clementines",
      "item": "fresh clementine juice (from about 6 clementines)",
      "quantity": 150,
      "unit": "ml",
      "preparation": "plus 2 tsp clementine zest"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "cold-unsalted-butter-cubed",
      "item": "cold unsalted butter cubed",
      "quantity": 100,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly beat the eggs plus 3 egg yolks in a bowl. Whisk the cornflour and caster sugar together until smooth."
    },
    {
      "step": 2,
      "text": "Gradually whisk the sugar mixture into the eggs, then stir in the clementine juice and zest, lemon juice, and cold cubed butter."
    },
    {
      "step": 3,
      "text": "Cook the mixture gently in a saucepan, stirring constantly, for 25 minutes, until thickened and set. Verify that the curd reaches 160°F and has a firm, fully set consistency.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Transfer the curd to two clean jars and let it cool before using."
    }
  ],
