  "id": "ashkenazi-charoset",
  "name": "Ashkenazi Charoset",
  "subtitle": "A sweet apple-and-walnut mixture with citrus and spice",
  "description": "Chopped apples and toasted walnuts are combined with cinnamon, citrus, sweetener, and wine or grape juice.",
  "meal_type": "other",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "walnut-halves",
      "item": "walnut halves",
      "quantity": 160,
      "unit": "g"
    },
    {
      "ingredient_id": "apples-such-as-pink-lady-or-royal-gala",
      "item": "apples such as Pink Lady or Royal Gala",
      "quantity": 3
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": "1 1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "honey-or-silan",
      "item": "honey or silan",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "grated-orange-zest",
      "item": "grated orange zest",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "60ml-sweet-red-wine-or-grape-juice",
      "item": "60ml sweet red wine or grape juice",
      "quantity": 50,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Toast the walnut halves for 10 minutes, then let them cool and chop them.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Core and finely chop the apples."
    },
    {
      "step": 4,
      "text": "Stir together the cinnamon, lemon juice, honey or silan, orange zest, and sweet red wine or grape juice."
    },
    {
      "step": 5,
      "text": "Combine the chopped walnuts and apples with the seasoned liquid, then transfer to a serving bowl."
    }
  ],
