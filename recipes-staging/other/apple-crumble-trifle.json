  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven for baking the crumble. Whisk the egg yolks, 100 g caster sugar, and cornflour until smooth."
    },
    {
      "step": 2,
      "text": "Heat 300 ml double cream, the whole milk, and the zest of two oranges until steaming. Gradually whisk the hot mixture into the yolks, then return it to the pan and cook, stirring, until thick and the custard reaches 160°F. Cool.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Cook the apples with the orange juice, the remaining orange zest, 1 tbsp caster sugar, and 3 tbsp dark brown soft sugar until tender. Transfer to a dish and cool.",
      "timer_minutes": 13
    },
    {
      "step": 4,
      "text": "Rub the plain flour, 75 g dark brown soft sugar, cinnamon, and cold butter together to make coarse crumbs. Spread on a tray and bake until crisp, about 15 minutes. Cool completely.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Beat 600 ml double cream with the vanilla bean paste and the remaining dark brown soft sugar until soft peaks form."
    },
    {
      "step": 6,
      "text": "Loosen the 200 g canned caramel. Stir the second 200 g canned caramel until smooth."
    },
    {
      "step": 7,
      "text": "Layer the cake cubes, custard, caramel apples, and caramel in a large trifle dish, repeating as needed."
    },
    {
      "step": 8,
      "text": "Top with the vanilla cream and scatter over the crumble. Finish with extra orange zest and serve."
    }
  ],
