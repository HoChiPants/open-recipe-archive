  "id": "butter-biscuits",
  "name": "Butter Biscuits",
  "subtitle": "Crisp, buttery biscuits finished with chocolate",
  "description": "A simple butter biscuit dough flavored with lemon zest, chilled, cut, baked, and finished with a set chocolate coating.",
  "meal_type": "other",
  "yield": {
    "quantity": 35,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 12
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 165,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "dark-chocolate-milk-chocolate-or-white-chocolate",
      "item": "dark chocolate milk chocolate or white chocolate",
      "quantity": 100,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the butter, icing sugar, and lemon zest until smooth."
    },
    {
      "step": 2,
      "text": "Add the plain flour, milk, and chocolate, then mix until a dough forms."
    },
    {
      "step": 3,
      "text": "Chill the dough for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Preheat the oven and prepare baking trays."
    },
    {
      "step": 5,
      "text": "Dust a work surface and cutter with plain flour. Roll out the dough and cut into biscuits."
    },
    {
      "step": 6,
      "text": "Transfer the biscuits to the prepared trays and bake for 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Melt the chocolate in the microwave, then cool until set."
    }
  ],
