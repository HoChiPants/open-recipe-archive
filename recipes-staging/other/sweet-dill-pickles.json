  },
  "ingredients": [
    {
      "ingredient_id": "32-ounce-jars-dill-pickles",
      "item": "(32 ounce) jars dill pickles",
      "quantity": 2
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 4,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "pickling-spice",
      "item": "pickling spice",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Drain the pickles and cut them into bite-size pieces. Place them in a clean, heatproof container and add the divided sugar in stages as directed below."
    },
    {
      "step": 2,
      "text": "Combine the remaining divided sugar with the vinegar, water, and pickling spice in a saucepan. Bring the mixture to a simmer, stirring until the sugar dissolves."
    },
    {
      "step": 3,
      "text": "Pour the hot syrup over the pickles and stir gently to coat. Let the mixture cool, cover it, and refrigerate for at least 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 4,
      "text": "Stir before serving and keep refrigerated."
    }
  ],
