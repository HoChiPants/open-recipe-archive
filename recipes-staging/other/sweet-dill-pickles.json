  "id": "sweet-dill-pickles",
  "name": "Sweet Dill Pickles",
  "subtitle": "A tangy, lightly sweet refrigerator pickle",
  "description": "Dill pickles are marinated in a warm sweet-and-sour spice syrup, then chilled until the flavor settles.",
  "meal_type": "other",
  "cuisine": "American",
