  "instructions": [
    {
      "step": 1,
      "text": "Cook the brown basmati rice according to the package directions, or simmer it in water for about 20 minutes until tender. Drain if needed and keep warm.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a large pot. Add the ginger, curry leaves, and chopped red chillies; cook briefly until aromatic."
    },
    {
      "step": 3,
      "text": "Add the butternut squash and baby potatoes. Cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the garlic, garam masala, and Chinese five-spice. Add the tomatoes, cauliflower, and vegetable bouillon powder, mixing well."
    },
    {
      "step": 5,
      "text": "Cover and simmer until the vegetables begin to soften.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Add the French beans and continue simmering until all the vegetables are tender.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Stir in the coconut yogurt, fresh coriander, and lime juice. Warm gently without boiling, then serve with the rice."
    }
  ],
