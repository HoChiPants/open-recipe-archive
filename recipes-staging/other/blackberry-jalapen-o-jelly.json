  "instructions": [
    {
      "step": 1,
      "text": "Prepare the jars, lids, and rings, and keep the jars warm. Bring the blackberry juice and minced jalapeños to a simmer in a large pot."
    },
    {
      "step": 2,
      "text": "Mix the sugar and powdered pectin together. Stir the mixture into the simmering juice until evenly incorporated."
    },
    {
      "step": 3,
      "text": "Bring the mixture back to a full simmer, stirring frequently, and simmer for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Ladle the hot jelly into the prepared jars, leaving appropriate space at the top. Wipe the rims, fit the lids, and secure the rings."
    },
    {
      "step": 5,
      "text": "Process the filled jars using the established procedure for the jars and jelly, then let them rest undisturbed until set.",
      "timer_minutes": 1440
    },
    {
      "step": 6,
      "text": "Cool the jars completely, then chill the jelly before serving."
    }
  ],
