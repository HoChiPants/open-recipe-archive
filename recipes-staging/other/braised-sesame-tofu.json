  "id": "braised-sesame-tofu",
  "name": "Braised Sesame Tofu",
  "subtitle": "Gochujang-glazed tofu with green beans and rice",
  "description": "Golden tofu simmers with a savory sesame-chili sauce and green beans, then finishes with lime and spring onions.",
  "meal_type": "other",
