  "instructions": [
    {
      "step": 1,
      "text": "Cut the tofu into thick pieces. Stir together the soy sauce, mirin, gochujang, garlic, sesame seeds, and half the spring onions."
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a skillet over medium-high heat. Cook the tofu for 5 minutes, turning as needed, until golden brown.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the sauce and green beans. Cover and simmer for 10 minutes, until the beans are tender and the sauce has thickened.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the lime juice and remaining spring onions. Serve with the cooked brown rice."
    }
  ],
