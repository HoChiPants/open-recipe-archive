  },
  "ingredients": [
    {
      "ingredient_id": "slices-stale-bread",
      "item": "slices stale bread",
      "quantity": 15
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cut the stale bread into cubes."
    },
    {
      "step": 3,
      "text": "Toss the bread with the melted butter and garlic salt until evenly coated."
    },
    {
      "step": 4,
      "text": "Transfer the seasoned bread to a baking sheet and spread it in an even layer."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, or until crisp and lightly browned.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Cool before serving or storing."
    }
  ],
