  "id": "homemade-croutons",
  "name": "Homemade Croutons",
  "subtitle": "Crisp, buttery bread cubes with garlic seasoning",
  "description": "Bake stale bread with melted butter and garlic salt until crisp for a simple salad or soup topping.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
