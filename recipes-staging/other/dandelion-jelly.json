{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "dandelion-jelly",
  "name": "Dandelion Jelly",
  "subtitle": "Bright floral jelly with lemon",
  "description": "A sweet, lightly floral jelly made by infusing dandelion petals, then setting the strained liquid with pectin, lemon juice, and sugar.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 40,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 50,
    "inactive_minutes": 1440
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 3.25,
      "unit": "cups",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "lightly-packed-dandelion-petals",
      "item": "lightly packed dandelion petals",
      "quantity": 4,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "powdered-fruit-pectin",
      "item": "powdered fruit pectin",
      "quantity": 1,
      "unit": "package",
      "preparation": "1.75 ounce"
    },
    {
      "ingredient_id": "yellow-food-coloring",
      "item": "yellow food coloring",
      "quantity": 1,
      "unit": "drop"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 4.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring the water to a simmer in a large pot. Add half of the dandelion petals and simmer for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Strain the infusion, pressing the petals gently to extract the liquid. Discard the spent petals."
    },
    {
      "step": 3,
      "text": "Return the infused liquid to the pot. Stir in the lemon juice, pectin, and food coloring."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a simmer, then add the sugar and stir until dissolved."
    },
    {
      "step": 5,
      "text": "Return to a full boil and cook for 1 minute, stirring constantly.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Pour the hot jelly into clean containers, leaving appropriate headspace if using containers intended for canning."
    },
    {
      "step": 7,
      "text": "Cool, cover, and refrigerate for 24 hours or until set.",
      "timer_minutes": 1440
    }
  ],
