  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vinegar",
      "item": "vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk and vinegar separately until heated through."
    },
    {
      "step": 2,
      "text": "Combine the warmed liquids and stir for 2 minutes, until curds begin to form.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Let the mixture stand until set, then transfer the curds to a bowl."
    },
    {
      "step": 4,
      "text": "Cool for 15 minutes. Stir in the salt to taste and serve.",
      "timer_minutes": 15
    }
  ],
