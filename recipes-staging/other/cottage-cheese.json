  "id": "cottage-cheese",
  "name": "Cottage Cheese",
  "subtitle": "A quick fresh curd made with milk and vinegar",
  "description": "Warm milk, separate the curds with vinegar, then cool and season for a simple homemade cottage cheese.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
