  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "air-fryer-roasted-garlic",
  "name": "Air Fryer Roasted Garlic",
  "subtitle": "Tender, caramelized garlic cloves made in the air fryer.",
  "description": "A whole head of garlic is seasoned, wrapped in foil, and cooked until soft enough to squeeze from the skins.",
  "meal_type": "other",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "head-garlic",
      "item": "head garlic",
      "quantity": 1
    },
    {
      "ingredient_id": "aluminum-foil",
      "item": "aluminum foil"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 380°F."
    },
    {
      "step": 2,
      "text": "Slice off the top of the head garlic to expose the cloves. Set it on a piece of aluminum foil."
    },
    {
      "step": 3,
      "text": "Drizzle the exposed cloves with extra-virgin olive oil, then season with salt and ground black pepper."
    },
    {
      "step": 4,
      "text": "Wrap the garlic tightly in the foil and place it in the air-fryer basket."
    },
    {
      "step": 5,
      "text": "Cook until the cloves are soft and lightly browned, about 20 minutes. Let cool slightly before opening the foil and squeezing out the garlic.",
      "timer_minutes": 20
    }
  ],
