  "instructions": [
    {
      "step": 1,
      "text": "Combine the plums, chives, chopped coriander, chilli, lime zest and juice, and caster sugar. Mix well and set aside."
    },
    {
      "step": 2,
      "text": "Toss the pork with the brown sugar, cumin, Tajín, ground coriander, grated garlic, and lime juice."
    },
    {
      "step": 3,
      "text": "Preheat the air fryer, then cook the pork for 18 minutes, turning once, until a thermometer inserted into the thickest pieces reads 145°F. Rest for 3 minutes.",
      "timer_minutes": 18
    },
    {
      "step": 4,
      "text": "Fill the warmed corn tacos with the pork and salsa. Serve with soured cream, lime wedges, and extra coriander leaves."
    }
