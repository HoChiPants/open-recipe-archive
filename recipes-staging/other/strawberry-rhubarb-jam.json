  "id": "strawberry-rhubarb-jam",
  "name": "Strawberry-Rhubarb Jam",
  "subtitle": "A bright, fruit-forward spread made without added pectin.",
  "description": "Rhubarb and strawberries cook with sugar and lemon juice into a thick, tangy-sweet jam portioned into small jars.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 60,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 20,
    "inactive_minutes": 1440
  },
  "ingredients": [
    {
      "ingredient_id": "rhubarb",
      "item": "rhubarb",
      "quantity": 4.5,
      "unit": "cups",
      "preparation": "cut into 1/2-inch pieces"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 6,
      "unit": "cups"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 4.5,
      "unit": "cups",
      "preparation": "halved"
    },
    {
      "ingredient_id": "4-ounce-canning-jars-with-lids-and-rings",
      "item": "4-ounce canning jars with lids and rings",
      "quantity": 20
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the rhubarb and sugar in a large pot. Let stand until the fruit releases some liquid and the sugar begins to dissolve.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Stir in the lemon juice and strawberries, then bring the mixture to a simmer over medium heat."
    },
    {
      "step": 3,
      "text": "Cook, stirring often, until the fruit softens and the mixture thickens into jam.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "While the jam cooks, prepare the jars, lids, and rings by boiling them for 5 minutes. Keep them hot until needed.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Transfer the hot jam to the prepared jars, leaving the lids and rings ready for use. Allow the filled jars to cool."
    },
    {
      "step": 6,
      "text": "Cover the cooled jars and refrigerate for 24 hours before serving or storing.",
      "timer_minutes": 1440
    }
  ],
