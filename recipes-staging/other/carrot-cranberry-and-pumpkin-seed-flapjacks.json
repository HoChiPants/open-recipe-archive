  "id": "carrot-cranberry-and-pumpkin-seed-flapjacks",
  "name": "Carrot, Cranberry and Pumpkin Seed Flapjacks",
  "subtitle": "Chewy oat bars with bright fruit and seed crunch",
  "description": "A simple tray-baked oat bar combining grated carrot, dried cranberries, and pumpkin seeds, finished with syrup and optional sprinkles.",
  "meal_type": "other",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "butter-plus-extra-for-the-tin",
      "item": "butter plus extra for the tin",
      "quantity": 220,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-brown-soft-sugar",
      "item": "dark brown soft sugar",
      "quantity": 170,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-syrup-plus-extra-for-drizzling",
      "item": "golden syrup plus extra for drizzling",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "porridge-oats",
      "item": "porridge oats",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "pumpkin-seeds",
      "item": "pumpkin seeds",
      "quantity": 5,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "dried-cranberries",
      "item": "dried cranberries",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "carrot-about-150g",
      "item": "carrot (about 150g)",
      "quantity": 1,
      "unit": "large",
      "preparation": "coarsely grated"
    },
    {
      "ingredient_id": "festive-sprinkles-of-your-choice",
      "item": "festive sprinkles of your choice",
      "preparation": "to decorate (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease a baking tin with some of the extra butter."
    },
    {
      "step": 2,
      "text": "Melt the butter, dark brown sugar, and golden syrup together in a saucepan, stirring until smooth."
    },
    {
      "step": 3,
      "text": "Mix the oats, pumpkin seeds, dried cranberries, and grated carrot in a bowl. Pour in the warm butter mixture and stir until evenly combined."
    },
    {
      "step": 4,
      "text": "Press the mixture firmly and evenly into the prepared tin."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, until set and lightly browned.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Leave to cool briefly, then cut into 14 portions while still slightly warm. Cool completely in the tin.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Drizzle with the extra golden syrup and add the optional sprinkles before serving."
    }
  ],
