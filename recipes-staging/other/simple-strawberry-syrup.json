  "id": "simple-strawberry-syrup",
  "name": "Simple Strawberry Syrup",
  "subtitle": "A bright fruit syrup for drinks, desserts, and breakfast dishes",
  "description": "Cook strawberries with a simple sugar syrup until thick, then chill before serving.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
