  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "strawberry",
      "item": "strawberries",
      "quantity": 2,
      "unit": "cups",
      "preparation": "quartered"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the water and white sugar in a saucepan over medium heat, stirring until the sugar dissolves."
    },
    {
      "step": 2,
      "text": "Add the strawberries and bring the mixture to a gentle simmer."
    },
    {
      "step": 3,
      "text": "Simmer for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Continue simmering until the syrup thickens, about 10 minutes more.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Remove from the heat and chill before serving."
    }
  ],
