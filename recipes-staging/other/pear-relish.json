  "id": "pear-relish",
  "name": "Pear Relish",
  "subtitle": "A sweet-tangy relish with peppers and mustard",
  "description": "Tender pears combine with onion, peppers, vinegar, mustard, and sugar for a bright, chunky relish.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 192,
