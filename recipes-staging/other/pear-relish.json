  "instructions": [
    {
      "step": 1,
      "text": "Cook the pears for 20 minutes, until tender. Drain, cool, and cut them into pieces.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Combine the pears, onions, green bell peppers, and jalapeno peppers in a large pot."
    },
    {
      "step": 3,
      "text": "Stir together the vinegar, sugar, mustard, and salt, then add the mixture to the pot."
    },
    {
      "step": 4,
      "text": "Bring the relish to a simmer and cook for 60 minutes, stirring occasionally, until thickened.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Prepare the jars, lids, and rings according to their use instructions."
    },
    {
      "step": 6,
      "text": "Spoon the simmering relish into the prepared jars, then seal with the lids and rings."
    },
    {
      "step": 7,
      "text": "Process the filled jars in boiling water for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "Let the jars rest undisturbed for 24 hours, then prepare and cool them for storage.",
      "timer_minutes": 1440
    }
  ],
