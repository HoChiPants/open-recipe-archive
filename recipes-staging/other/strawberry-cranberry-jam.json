  "id": "strawberry-cranberry-jam",
  "name": "Strawberry-Cranberry Jam",
  "subtitle": "A bright, tart fruit spread for toast and pastries",
  "description": "Strawberries and cranberries cook with pectin and sugar into a vivid, sweet-tart jam.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 96,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "strawberry",
      "item": "strawberries",
      "quantity": 2.5,
      "unit": "quarts",
      "preparation": "coarsely chopped"
    },
    {
      "ingredient_id": "fresh-or-frozen-cranberries",
      "item": "fresh or frozen cranberries",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 ounce, coarsely chopped"
    },
    {
      "ingredient_id": "powdered-fruit-pectin",
      "item": "powdered fruit pectin",
      "quantity": 2,
      "unit": "package",
      "preparation": "2 ounce"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 5,
      "unit": "pounds"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Coarsely chop the strawberries and cranberries."
    },
    {
      "step": 2,
      "text": "Combine the fruit, pectin, and margarine in a large pot. Bring the mixture to a full boil, stirring frequently, and boil for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the sugar until dissolved. Return the mixture to a full boil and cook for 1 minute, stirring constantly.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Remove from the heat, skim off any foam, and portion the hot jam into clean heat-safe containers. Let cool before serving."
    }
  ],
