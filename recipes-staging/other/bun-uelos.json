  "id": "bun-uelos",
  "name": "Buñuelos",
  "subtitle": "Crisp cinnamon-sugar pastries",
  "description": "Make a soft cinnamon-scented dough, shape it into thin pastries, fry until set, and finish with cinnamon sugar.",
  "meal_type": "other",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 18,
    "unit": "pastries"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 10
  },
  "ingredients": [
    {
