      "item": "caster sugar",
      "quantity": 4,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the flour, 1/2 teaspoon cinnamon, baking powder, and 25 g sugar. Work in the softened butter, then add the vanilla extract and knead for 5 minutes, until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Cover the dough and let it rest for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Divide the dough into 18 portions and roll each on a lightly floured surface into a thin pastry."
    },
    {
      "step": 4,
      "text": "Mix 1 teaspoon cinnamon with 4 tablespoons sugar in a small bowl."
    },
    {
      "step": 5,
      "text": "Heat the vegetable oil in a deep pan. Fry the pastries in batches until set and lightly golden, about 3 minutes per batch. Drain briefly.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Toss or sprinkle the warm pastries with the cinnamon sugar and serve."
    }
  ],
