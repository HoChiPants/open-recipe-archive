  "id": "bacon-jam-e5bd848f",
  "name": "Bacon Jam",
  "subtitle": "A smoky-sweet bacon spread with coffee, maple, and bourbon.",
  "description": "Slow-cooked bacon, onion, and brown sugar combine with coffee, vinegar, maple syrup, and bourbon for a thick, savory-sweet condiment.",
  "meal_type": "other",
  "yield": {
    "quantity": 2,
    "unit": "jars"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "smoked-bacon-lardons",
      "item": "smoked bacon lardons",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "white-onion-finely-sliced",
      "item": "white onion finely sliced",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "garlic-cloves-crushed",
      "item": "garlic cloves crushed",
      "quantity": 2
    },
    {
      "ingredient_id": "light-brown-sugar",
      "item": "light brown sugar",
      "quantity": 85,
      "unit": "g"
    },
    {
      "ingredient_id": "cider-vinegar",
      "item": "cider vinegar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "bourbon-whiskey",
      "item": "bourbon whiskey",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "freshly-brewed-strong-black-coffee",
      "item": "freshly brewed strong black coffee",
      "quantity": 100,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Sauté the bacon lardons in a large pan for 10 minutes. Transfer them out of the pan, leaving the rendered fat behind.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Add the sliced onion, brown sugar, and bacon to the pan and cook for 20 minutes, stirring occasionally.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Stir in the crushed garlic, cider vinegar, bourbon, maple syrup, and coffee."
    },
    {
      "step": 4,
      "text": "Cook for 30 minutes, stirring as needed, until the mixture is thick and jam-like.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cool slightly, then cut or prepare the jam to the desired texture before transferring it to jars."
    }
  ],
