{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "caramel-cornflake-brownies",
  "name": "Caramel Cornflake Brownies",
  "subtitle": "Fudgy brownies with a crisp caramel topping",
  "description": "Rich chocolate brownies are finished with buttery caramel-coated cornflakes and chilled until firm.",
  "meal_type": "other",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-plus-extra-for-the-tin",
      "item": "unsalted butter plus extra for the tin",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-chocolate-roughly-chopped",
      "item": "dark chocolate roughly chopped",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 280,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 120,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 30,
      "unit": "g"
    },
    {
      "ingredient_id": "instant-coffee-granules",
      "item": "instant coffee granules",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 85,
      "unit": "g"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "cornflakes",
      "item": "cornflakes",
      "quantity": 100,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grease and line a suitable brownie tin with the extra butter."
    },
    {
      "step": 2,
      "text": "Melt the 250 g butter with the chopped chocolate until smooth, then set aside briefly."
    },
    {
      "step": 3,
      "text": "Whisk the eggs and caster sugar until thickened. Stir in the melted chocolate mixture."
    },
    {
      "step": 4,
      "text": "Mix the flour, cocoa powder, and coffee granules into the batter until just combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared tin and bake until set.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Cool the brownies in the tin."
    },
    {
      "step": 7,
      "text": "Melt the 85 g butter with the light brown soft sugar, then cook until combined.",
      "timer_minutes": 7
    },
    {
      "step": 8,
      "text": "Add the cream and cook, stirring, until the caramel is smooth.",
      "timer_minutes": 5
    },
    {
      "step": 9,
      "text": "Stir in the cornflakes until evenly coated, then spread the mixture over the cooled brownies."
    },
    {
      "step": 10,
      "text": "Chill until firm before cutting into 16 servings.",
      "timer_minutes": 240
    }
  ],
  "tags": [
