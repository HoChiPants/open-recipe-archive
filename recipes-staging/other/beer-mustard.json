  "instructions": [
    {
      "step": 1,
      "text": "Combine the brown and yellow mustard seeds, beer, and brown sugar in a nonreactive bowl. Cover and refrigerate for 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 2,
      "text": "Transfer the soaked seed mixture to a blender or food processor. Add the garlic, vinegar, salt, and pepper, then blend to a coarse or smooth texture as desired."
    },
    {
      "step": 3,
      "text": "Pour the mustard into a saucepan and bring it to a boil. Cook for 5 minutes, stirring frequently.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Cool, transfer to a clean container, cover, and refrigerate for 14 days before serving to allow the flavor to develop."
    },
    {
      "step": 5,
      "text": "Stir before serving and keep refrigerated."
    }
  ],
