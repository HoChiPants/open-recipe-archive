  "id": "beer-mustard",
  "name": "Beer Mustard",
  "subtitle": "A sharp, malty mustard condiment",
  "description": "Whole mustard seeds soak in dark beer, then are blended with vinegar, garlic, sugar, and spices for a coarse, tangy spread.",
  "meal_type": "other",
