      "item": "icing sugar for dusting"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare six muffin wells."
    },
    {
      "step": 2,
      "text": "Stir the flaxseed, water, and Linwoods Sprouted Flax together. Let stand for 5 minutes to thicken.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Mix the 100 ml maple syrup, 80 g almond butter, 1 tsp almond extract, soy yoghurt, and 50 ml plant milk into the flax mixture."
    },
    {
      "step": 4,
      "text": "Fold in the self-raising flour and salt until just combined."
    },
    {
      "step": 5,
      "text": "Stir the remaining almond butter and almond extract with the 30 g maple syrup and 30 ml plant milk until thick, then add the ground almonds."
    },
    {
      "step": 6,
      "text": "Divide the batter among the muffin wells. Add the almond mixture, top with flaked almonds, and bake until risen and set.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Cool the muffins, then dust with icing sugar for dusting."
    }
  ],
