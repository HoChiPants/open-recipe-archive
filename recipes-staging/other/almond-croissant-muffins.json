  "id": "almond-croissant-muffins",
  "name": "Almond Croissant Muffins",
  "subtitle": "Tender vegan muffins with almond flavor and a crisp topping",
  "description": "These almond muffins combine a flax-based batter with a rich almond mixture and finish with flaked almonds and a light dusting of icing sugar.",
  "meal_type": "other",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
