  "id": "chicken-wing-dippers",
  "name": "Chicken Wing Dippers",
  "subtitle": "Crisp baked wings for dipping",
  "description": "Coat split chicken wings with a light cornflour and baking-powder mixture, chill briefly, then bake until crisp and safely cooked.",
  "meal_type": "other",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-wings-wing-tips-removed-and-wings-split-into-two-pieces",
      "item": "chicken wings wing tips removed and wings split into two pieces",
      "quantity": 1,
      "unit": "kg"
    },
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "sunflower-oil",
      "item": "sunflower oil",
      "quantity": 1,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Toss the chicken wings with the cornflour and baking powder until evenly coated. Chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Preheat the oven. Lightly oil a baking tray with the sunflower oil."
    },
    {
      "step": 3,
      "text": "Arrange the coated wings in a single layer on the tray, leaving space between pieces."
    },
    {
      "step": 4,
      "text": "Bake for 30 minutes, turning if needed, until browned and the thickest pieces reach 165°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Transfer the wings to a serving dish and serve with dipping sauces."
    }
  ],
