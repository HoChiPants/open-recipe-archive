  "instructions": [
    {
      "step": 1,
      "text": "To make the pastry, rub the cold butter and lard into the flour until crumbly. Add the milk plus a splash and mix to form a smooth dough. Wrap and rest for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 2,
      "text": "Alternatively, use the ready-made shortcrust pastry. Roll the pastry on a lightly floured surface until thick enough to line a tart tin, then press it into the tin and trim the edge. Chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat the oven to 375°F. Line the pastry shell and bake until lightly colored and firm."
    },
    {
      "step": 4,
      "text": "Prepare the beans; double pod the broad beans if desired.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Whisk the milk, double cream, and eggs together. Stir in the tarragon, cheddar, spinach, and beans."
    },
    {
      "step": 6,
      "text": "Pour the filling into the pastry shell. Bake for about 30 minutes, until the center is firm and the quiche reaches 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Cool briefly before slicing and serving."
    }
  ],
