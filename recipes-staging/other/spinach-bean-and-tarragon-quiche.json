  "id": "spinach-bean-and-tarragon-quiche",
  "name": "Spinach, Bean and Tarragon Quiche",
  "subtitle": "A savory quiche with greens, beans, cheddar, and herbs",
  "description": "A crisp pastry shell filled with creamy egg custard, spinach, beans, cheddar, and fresh tarragon.",
  "meal_type": "other",
  "yield": {
    "quantity": 6,
    "unit": "servings"
