  "instructions": [
    {
      "step": 1,
      "text": "Place the cinnamon, bay leaves, Sichuan peppercorns, star anise, pork, garlic, ginger, dark soy sauce, and light soy sauce in a covered ovenproof pot."
    },
    {
      "step": 2,
      "text": "Cook the covered pork at a low heat for about 60 minutes, until tender and at least 145°F in the thickest part. Rest for 3 minutes before handling.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Whisk the buckwheat flour, baking powder, and milk until smooth. Let the batter stand while the pork finishes."
    },
    {
      "step": 4,
      "text": "Transfer the pork to a plate and cut or shred it into bite-size pieces. Remove the whole spices and reserve the ginger."
    },
    {
      "step": 5,
      "text": "Warm the cooked pork with the ginger, orange juice, honey, and remaining soy sauces. Simmer until the mixture is thick and glossy."
    },
    {
      "step": 6,
      "text": "Heat a skillet over medium heat and melt a little butter. Cook small spoonfuls of batter in batches until set and browned on both sides."
    },
    {
      "step": 7,
      "text": "Serve the pancakes topped with the glazed pork and the coriander, sliced spring onions, and chopped chillis."
    }
  ],
