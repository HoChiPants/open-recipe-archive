  "id": "chorizo-croquetas-with-aioli",
  "name": "Chorizo Croquetas with Aioli",
  "subtitle": "Crisp golden croquetas with a creamy garlic sauce",
  "description": "A savory chorizo and Manchego filling is shaped, crumbed, fried, and served with homemade aioli.",
  "meal_type": "other",
  "yield": {
    "quantity": 25,
