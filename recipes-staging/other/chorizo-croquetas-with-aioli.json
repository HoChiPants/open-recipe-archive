  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium heat. Add the onion and cook until softened, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Stir in the flour and chorizo. Cook for 4 minutes, stirring frequently.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Warm the milk, then add it gradually while stirring until smooth. Continue cooking until the mixture is thick and set, about 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Stir in the Manchego and parsley. Transfer the filling to a shallow dish and chill for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "For the aioli, whisk the garlic and egg yolks. Gradually whisk in the extra virgin olive oil until emulsified, then add the lemon juice. Chill until serving. For people at higher risk from foodborne illness, use pasteurized egg yolks."
    },
    {
      "step": 6,
      "text": "Shape the chilled filling into 25 croquetas. Dip each in the beaten eggs, then coat thoroughly with the breadcrumbs."
    },
    {
      "step": 7,
      "text": "Heat the groundnut oil for frying. Fry the croquetas in batches for about 3 minutes, turning as needed, until golden and the centers reach 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 8,
      "text": "Drain briefly and serve warm with the aioli."
    }
  ],
