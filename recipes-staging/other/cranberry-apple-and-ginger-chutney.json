  "instructions": [
    {
      "step": 1,
      "text": "Combine the cranberries, raisins, water, brown sugar, white sugar, cinnamon, ginger, and cloves in a cooking vessel. Bring to a simmer."
    },
    {
      "step": 2,
      "text": "Preheat the cooking appliance for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the onion, apple, and celery to the simmered cranberry mixture."
    },
    {
      "step": 4,
      "text": "Cook the mixture until the fruit and vegetables are tender and the chutney is cohesive."
    },
    {
      "step": 5,
      "text": "Transfer the chutney to a serving or storage container and let it cool for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Cover and chill for 8 hours before serving.",
      "timer_minutes": 480
    }
