  "instructions": [
    {
      "step": 1,
      "text": "Trim the squash and cut the long neck into four thick rounds. Combine the chopped chili and grated garlic."
    },
    {
      "step": 2,
      "text": "Heat the garlic-infused oil in a large skillet. Add the squash rounds and cook for 10 minutes, turning occasionally.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Continue cooking for 15 minutes, turning as needed, until the squash is tender throughout.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Prepare the parsley, rocket, buns, mayonnaise, and tomato for assembly."
    },
    {
      "step": 5,
      "text": "Spread the mayonnaise over the buns. Fill with the squash, tomato, parsley, and rocket, then serve."
    }
