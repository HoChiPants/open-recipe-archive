  "id": "chicken-broth",
  "name": "Chicken Broth",
  "subtitle": "A long-simmered poultry broth with aromatic vegetables",
  "description": "Chicken carcasses, vegetables, and spices are gently simmered to make a clear, savory broth, then strained and chilled.",
  "meal_type": "other",
  "yield": {
    "quantity": 2,
    "unit": "litres"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 510
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-carcasses-with-the-wings",
      "item": "chicken carcasses with the wings",
      "quantity": 4,
      "preparation": "or use 2kg wings"
    },
    {
      "ingredient_id": "onions-halved",
      "item": "onions halved",
      "quantity": 2
    },
    {
      "ingredient_id": "carrots-cut-into-chunks",
      "item": "carrots cut into chunks",
      "quantity": 4
    },
    {
      "ingredient_id": "leek-cut-into-chunks",
      "item": "leek cut into chunks",
      "quantity": 1
    },
    {
      "ingredient_id": "celery-stick-cut-into-chunks",
      "item": "celery stick cut into chunks",
      "quantity": 1
    },
    {
      "ingredient_id": "peppercorns",
      "item": "peppercorns",
      "quantity": 5
    },
    {
      "ingredient_id": "allspice-berries",
      "item": "allspice berries",
      "quantity": 3
    },
    {
      "ingredient_id": "parsley",
      "item": "parsley",
      "quantity": 80,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Prepare the carrots, leek, and celery, and halve the onions."
    },
    {
      "step": 2,
      "text": "Place the chicken carcasses with the wings in a large pot with the vegetables, peppercorns, allspice berries, and parsley. Add enough water to cover."
    },
    {
      "step": 3,
      "text": "Bring the pot to a simmer. Heat the broth and chicken to at least 165°F, measured with a food thermometer, then maintain a gentle simmer."
    },
    {
      "step": 4,
      "text": "Simmer for 6 hours, skimming the surface as needed.",
      "timer_minutes": 360
    },
    {
      "step": 5,
      "text": "Transfer the broth through a fine strainer into a clean container, discarding the solids."
    },
    {
      "step": 6,
      "text": "Chill promptly, then refrigerate until ready to use."
    }
  ],
