  "id": "chocolate-coconut-truffles",
  "name": "Chocolate Coconut Truffles",
  "subtitle": "No-bake chocolate and coconut bites",
  "description": "A simple mixture of melted butter, condensed milk, chocolate, biscuit crumbs, and coconut, chilled briefly and rolled into bite-size truffles.",
  "meal_type": "other",
  "yield": {
    "quantity": 1,
    "unit": "24 truffles"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "tin-condensed-milk",
      "item": "tin condensed milk",
      "quantity": 1
    },
    {
      "ingredient_id": "digestive-biscuits-crushed-into-crumbs",
      "item": "digestive biscuits crushed into crumbs",
      "quantity": 20
    },
    {
      "ingredient_id": "desiccated-coconut-plus-extra-for-dusting",
      "item": "desiccated coconut plus extra for dusting",
      "quantity": 5,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "drinking-chocolate-i-use-cadbury",
      "item": "drinking chocolate (I use Cadbury",
      "quantity": 5,
      "unit": "tbsp",
      "preparation": "not instant)"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 75,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter gently in a saucepan."
    },
    {
      "step": 2,
      "text": "Stir in the condensed milk, coconut, and drinking chocolate until combined."
    },
    {
      "step": 3,
      "text": "Add the biscuit crumbs and mix into a cohesive mixture."
    },
    {
      "step": 4,
      "text": "Chill for 20 minutes, or until firm enough to shape.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Roll the mixture into about 24 balls and coat them in the extra coconut."
    }
  ],
