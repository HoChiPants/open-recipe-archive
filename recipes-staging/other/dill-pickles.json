  "instructions": [
    {
      "step": 1,
      "text": "Wash the cucumbers and jars. Place the cucumbers in the jars and let them stand for 2 hours, then drain.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Combine the water, vinegar, sugar, pickling salt, and spice bundle in a large pot. Bring to a simmer and cook for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Place the jars, lids, and rings in boiling water for 5 minutes, then handle with clean utensils.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Arrange one head of dill and one garlic clove in each jar. Pack the cucumbers into the jars."
    },
    {
      "step": 5,
      "text": "Pour the hot brine over the cucumbers, leaving the jars suitable for refrigerated storage. Close with the lids and rings."
    },
    {
      "step": 6,
      "text": "Cool the jars, then refrigerate for at least 2 hours before serving. Keep refrigerated.",
      "timer_minutes": 120
    }
  ],
