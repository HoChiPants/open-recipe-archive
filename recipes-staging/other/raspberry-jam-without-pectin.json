  "id": "raspberry-jam-without-pectin",
  "name": "Raspberry Jam Without Pectin",
  "subtitle": "A simple stovetop fruit spread",
  "description": "Raspberries, sugar, and lemon juice cook into a bright, naturally thickened jam.",
  "meal_type": "other",
  "cuisine": "American",
