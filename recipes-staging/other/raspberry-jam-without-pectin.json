  "ingredients": [
    {
      "ingredient_id": "mashed-raspberries",
      "item": "mashed raspberries",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "freshly-squeezed-lemon-juice",
      "item": "freshly squeezed lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the mashed raspberries in a saucepan and bring them to a simmer over medium heat."
    },
    {
      "step": 2,
      "text": "Cook the raspberries for 4 minutes, stirring occasionally.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Stir in the white sugar and freshly squeezed lemon juice until evenly combined."
    },
    {
      "step": 4,
      "text": "Return the mixture to a simmer and cook for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Continue simmering for 10 minutes, stirring as needed, until the jam thickens.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Transfer the jam to a heatproof container and let it rest for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 7,
      "text": "Cool completely before serving or storing."
    }
  ],
