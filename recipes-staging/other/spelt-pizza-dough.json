{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "spelt-pizza-dough",
  "name": "Spelt Pizza Dough",
  "subtitle": "A gently fermented dough for homemade pizza",
  "description": "Mix sprouted spelt flour with yeast, honey, water, oil, and salt, then ferment, portion, and rest before shaping.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0,
    "inactive_minutes": 140
  },
  "ingredients": [
    {
      "ingredient_id": "sprouted-spelt-flour",
      "item": "sprouted spelt flour",
      "quantity": 3,
      "unit": "cups",
      "preparation": "or as needed, divided"
    },
    {
      "ingredient_id": "warm-water-100-to-105-degrees-f-38-to-41-degrees-c",
      "item": "warm water (100 to 105 degrees F/38 to 41 degrees C)",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "plus more for drizzling"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the warm water, honey, and yeast in a large bowl. Let stand until the yeast is hydrated and lightly foamy.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Stir in the olive oil, salt, and enough of the divided flour to form a shaggy dough."
    },
    {
      "step": 3,
      "text": "Work the dough until it is cohesive and smooth, adding flour as needed.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Transfer the dough to a bowl, drizzle with olive oil, and turn to coat. Cover and let rise until noticeably puffy.",
      "timer_minutes": 90
    },
    {
      "step": 5,
      "text": "Turn the dough onto a lightly floured surface, using the reserved flour, and divide it into four portions. Shape each portion into a ball."
    },
    {
      "step": 6,
      "text": "Drizzle the dough portions with olive oil, cover, and let rest before stretching into pizza crusts.",
      "timer_minutes": 45
    }
  ],
