  "id": "puff-pastry-cases",
  "name": "Puff Pastry Cases",
  "subtitle": "Light, crisp shells for savory or sweet fillings",
  "description": "Bake layered puff pastry into hollow cases that can be filled after cooling.",
  "meal_type": "other",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "block-all-butter-puff-pastry",
      "item": "block all-butter puff pastry",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "plain-flour-for-dusting",
      "item": "plain flour for dusting"
    },
    {
      "ingredient_id": "egg-beaten",
      "item": "egg beaten",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to the temperature specified for the pastry. Lightly dust the work surface with flour and roll out the puff pastry."
    },
    {
      "step": 2,
      "text": "Cut twelve pastry rounds. Cut smaller rounds from the centers of half of them, then stack the rings over the full rounds to form raised sides."
    },
    {
      "step": 3,
      "text": "Transfer the pastry cases to a baking sheet and brush the exposed pastry with the beaten egg."
    },
    {
      "step": 4,
      "text": "Bake until puffed and golden brown, and until the egg wash is fully set; verify the egg wash reaches 160°F.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Cool the pastry cases before filling or serving."
    }
  ],
