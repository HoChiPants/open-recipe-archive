  "id": "chocolate-orange-crinkle-biscuits",
  "name": "Chocolate Orange Crinkle Biscuits",
  "subtitle": "Cocoa biscuits with orange zest and a sugar-crackled finish",
  "description": "Small chocolate-orange biscuits rolled in sugar before baking for a fudgy center and crinkled coating.",
  "meal_type": "other",
  "yield": {
    "quantity": 35,
    "unit": "mini biscuits"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cocoa-powder-sieved",
      "item": "cocoa powder sieved",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 230,
      "unit": "g"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 60,
      "unit": "ml"
    },
    {
      "ingredient_id": "oranges-zested",
      "item": "oranges zested",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 180,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "few-drops-of-orange-food-colouring-or-use-red-and-yellow",
      "item": "few drops of orange food colouring or use red and yellow"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 40,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs until combined, then whisk in the caster sugar, vegetable oil, orange zest, and food colouring."
    },
    {
      "step": 2,
      "text": "Stir together the cocoa powder, plain flour, and baking powder. Add the dry mixture to the egg mixture and stir until a dough forms."
    },
    {
      "step": 3,
      "text": "Cover the dough and chill it.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Preheat the oven and prepare baking trays."
    },
    {
      "step": 5,
      "text": "Place the caster sugar and icing sugar in separate shallow dishes."
    },
    {
      "step": 6,
      "text": "Shape the chilled dough into small balls, roll each first in caster sugar and then generously in icing sugar, and arrange them on the trays with space between them."
    },
    {
      "step": 7,
      "text": "Bake for 10 minutes, until the biscuits are firm and fully set in the center.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Transfer the biscuits to a rack and let them cool before serving."
    }
  ],
