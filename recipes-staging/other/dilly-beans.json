  "instructions": [
    {
      "step": 1,
      "text": "Prepare clean heat-safe containers and set them aside."
    },
    {
      "step": 2,
      "text": "Bring the water to a boil for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Combine the boiling water with the pickling salt, vinegar, and pickling spice; return the mixture to a simmer."
    },
    {
      "step": 4,
      "text": "Place dill, mustard seed, chile peppers, garlic, and alum in the containers. Pack in the green beans, keeping them upright and snug."
    },
    {
      "step": 5,
      "text": "Pour the hot brine over the beans until fully covered. Let the filled containers stand for 10 minutes, then cover and refrigerate.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Chill for 24 hours before serving.",
      "timer_minutes": 1440
    }
  ],
