  "instructions": [
    {
      "step": 1,
      "text": "Combine the chopped bell peppers, green tomatoes, onions, and cabbage in a large bowl. Mix in the salt, cover, and refrigerate for 8 hours or overnight.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Drain the vegetables thoroughly, rinse them with the cold water, and drain again."
    },
    {
      "step": 3,
      "text": "In a large pot, combine the sugar, vinegar, cold water, mustard seed, turmeric, and celery seed."
    },
    {
      "step": 4,
      "text": "Bring the seasoned vinegar mixture to a simmer, then add the drained vegetables."
    },
    {
      "step": 5,
      "text": "Simmer gently for 10 minutes, stirring occasionally.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Cool the relish, transfer it to clean containers, cover, and refrigerate before serving."
    }
  ],
