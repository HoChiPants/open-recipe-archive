  "instructions": [
    {
      "step": 1,
      "text": "Bring water to a simmer in a pot. Cook the penne for 11 minutes, or until boiling-water tender, then drain.",
      "timer_minutes": 11
    },
    {
      "step": 2,
      "text": "While the pasta cooks, melt the butter in a saucepan. Add the Parmesan and Gorgonzola and cook until melted."
    },
    {
      "step": 3,
      "text": "Whisk the heavy cream into the cheese mixture until smooth. Stir in the drained penne and warm pear until heated through."
    },
    {
      "step": 4,
      "text": "Add the toasted walnuts, season with ground black pepper, and serve."
    }
  ],
