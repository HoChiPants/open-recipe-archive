  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of salted water to a simmer. Add the penne and cook until tender, about 10 minutes; drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the butter and olive oil in a large skillet. Add the onion and stir for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir in the bell pepper, mushrooms, garlic, cayenne, and salt and pepper. Cook until the vegetables begin to soften."
    },
    {
      "step": 4,
      "text": "Add the shrimp and cook until opaque, firm, and fully cooked, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Whisk the Alfredo sauce, Romano, and cream into the skillet. Simmer until thickened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Add the drained penne and toss to coat. Stir in the parsley and serve."
    }
  ],
