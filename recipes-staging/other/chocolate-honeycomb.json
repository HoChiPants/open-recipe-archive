{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-honeycomb",
  "name": "Chocolate Honeycomb",
  "subtitle": "Crisp caramelized honeycomb coated in chocolate",
  "description": "Make a bubbly sugar-and-syrup candy, let it set, then finish the pieces with melted chocolate.",
  "meal_type": "other",
  "yield": {
    "quantity": 20,
    "unit": "cm sheet of honeycomb"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter-for-the-tin",
      "item": "butter for the tin"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-syrup",
      "item": "golden syrup",
      "quantity": 5,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "bicarbonate-of-soda",
      "item": "bicarbonate of soda",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "dark-or-milk-chocolate-broken-into-chunks",
      "item": "dark or milk chocolate broken into chunks",
      "quantity": 150,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Butter a 20 cm square tin and line it with baking parchment."
    },
    {
      "step": 2,
      "text": "Put the sugar and golden syrup in a large saucepan. Heat gently until melted, then boil without stirring until the mixture is deep golden and bubbling.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Remove from the heat and quickly stir in the bicarbonate of soda. Pour into the prepared tin and leave undisturbed until firm.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Break the set honeycomb into pieces. Melt the chocolate gently, then dip or drizzle it over the pieces and allow the coating to set.",
      "timer_minutes": 60
    }
  ],
