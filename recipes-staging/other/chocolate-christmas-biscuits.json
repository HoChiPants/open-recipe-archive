  "id": "chocolate-christmas-biscuits",
  "name": "Chocolate Christmas Biscuits",
  "subtitle": "Cocoa biscuits finished with festive decorations",
  "description": "Tender chocolate biscuits cut into shapes, baked until set, cooled, and decorated with melted chocolate or piping icing, sugar pearls, and sprinkles.",
  "meal_type": "other",
  "yield": {
    "quantity": 50,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 270,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 120,
      "unit": "g"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "chocolate-or-piping-icing",
      "item": "chocolate or piping icing",
      "preparation": "melted, sugar pearls, sprinkles"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the plain flour, cocoa powder, and icing sugar in a bowl."
    },
    {
      "step": 2,
      "text": "Add the butter and eggs, then knead until a smooth dough forms."
    },
    {
      "step": 3,
      "text": "Chill the dough for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Preheat the oven and prepare baking sheets."
    },
    {
      "step": 5,
      "text": "Lightly flour the work surface, roll out the dough, and cut it into shapes."
    },
    {
      "step": 6,
      "text": "Arrange the biscuits on the prepared sheets and bake for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Cool completely before decorating with melted chocolate or piping icing, sugar pearls, and sprinkles."
    }
  ],
