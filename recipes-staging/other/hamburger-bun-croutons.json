  "id": "hamburger-bun-croutons",
  "name": "Hamburger Bun Croutons",
  "subtitle": "Crisp, seasoned bread cubes for salads and soups",
  "description": "Turn leftover hamburger buns into savory baked croutons with olive oil and dried herbs.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "hamburger-buns",
      "item": "hamburger buns",
      "quantity": 4,
      "preparation": "cut into 1-inch cubes"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-thyme",
      "item": "ground thyme",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "coarsely-ground-black-pepper-to-taste",
      "item": "coarsely ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the bun cubes in a bowl, drizzle with enough olive oil to coat, and toss thoroughly."
    },
    {
      "step": 3,
      "text": "Add the garlic powder, oregano, thyme, basil, salt, and pepper; toss again until the seasoning is evenly distributed."
    },
    {
      "step": 4,
      "text": "Spread the seasoned cubes in a single layer on a baking sheet."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, or until crisp and lightly browned.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Let the croutons cool before using or storing."
    }
  ],
