  "id": "creamed-sweetcorn-rigatoni-with-chorizo-crumbs",
  "name": "Creamed Sweetcorn Rigatoni with Chorizo Crumbs",
  "subtitle": "Sweetcorn pasta with crisp, citrusy chorizo topping",
  "description": "Rigatoni is coated in a creamy sweetcorn and mozzarella sauce, then finished with crisp chorizo breadcrumbs and lemon.",
  "meal_type": "other",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
