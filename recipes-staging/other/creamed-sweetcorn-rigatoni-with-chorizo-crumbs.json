  "instructions": [
    {
      "step": 1,
      "text": "Cook the chorizo in a large skillet over medium heat until browned and crisp. Transfer it to a plate, leaving the rendered fat in the skillet."
    },
    {
      "step": 2,
      "text": "Add the panko to the skillet and stir for 1 minute, until golden. Toss with the lemon zest, lemon juice, and crispy onions, if using, then set aside.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Melt the butter in the skillet. Add the chopped onion and cook for 5 minutes, until softened.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the sweetcorn kernels and cook for 10 minutes, stirring occasionally, until tender.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Cook the rigatoni until al dente, then drain."
    },
    {
      "step": 6,
      "text": "Stir the double cream into the sweetcorn mixture and cook for 5 minutes. Add the mozzarella and stir until melted.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Combine the rigatoni with the creamed sweetcorn sauce and serve topped with the chorizo breadcrumbs.",
      "timer_minutes": 1
    }
  ],
