  "id": "slow-cooker-shredded-beef",
  "name": "Slow Cooker Shredded Beef",
  "subtitle": "Tender seasoned beef for tacos and burritos",
  "description": "Boneless beef chuck cooks slowly with taco seasoning and sliced onion until tender enough to shred.",
  "meal_type": "other",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 480
  },
  "ingredients": [
    {
      "ingredient_id": "4-pound-boneless-beef-chuck-roast",
      "item": "(4 pound) boneless beef chuck roast",
      "quantity": 1
    },
    {
      "ingredient_id": "taco-seasoning",
      "item": "taco seasoning",
      "quantity": 2,
      "unit": "package",
      "preparation": "1 ounce"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "halved and sliced"
    },
    {
      "ingredient_id": "seasoned-salt",
      "item": "seasoned salt",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the beef chuck roast in a slow cooker and sprinkle it with the taco seasoning."
    },
    {
      "step": 2,
      "text": "Arrange the sliced onion over the beef, cover, and cook on low for 8 hours, until the beef is tender and reaches at least 145°F internally; let it rest for 3 minutes.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Shred the beef in the slow cooker and season with the seasoned salt to taste."
    }
  ],
