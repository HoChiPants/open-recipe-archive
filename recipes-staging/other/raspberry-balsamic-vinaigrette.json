  "instructions": [
    {
      "step": 1,
      "text": "Combine the raspberries and sugar in a bowl. Let stand for 10 minutes, until the berries soften and release some juice.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Mash the raspberries with a fork, then transfer them to a mixing bowl or jar."
    },
    {
      "step": 3,
      "text": "Add the balsamic vinegar, honey, and salt. Whisk until combined."
    },
