  "id": "dried-apricot-jam",
  "name": "Dried Apricot Jam",
  "subtitle": "A bright fruit spread with vanilla and lemon",
  "description": "Dried apricots are softened, blended, and cooked with pectin, sugar, vanilla, and lemon juice into a thick homemade jam.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 144,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 20,
    "inactive_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "dried-apricots",
      "item": "dried apricots",
      "quantity": 4.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "boiling-water",
      "item": "boiling water",
      "quantity": 4.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "powdered-fruit-pectin",
      "item": "powdered fruit pectin",
      "quantity": 1,
      "unit": "package",
      "preparation": "1.75 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 7,
      "unit": "cups"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the dried apricots and boiling water in a bowl. Let stand for 30 minutes, until softened.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Blend the softened apricots with their liquid and the vanilla extract until smooth."
    },
    {
      "step": 3,
      "text": "In a saucepan, combine the powdered fruit pectin with the required boiling water and bring to a boil. Boil for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the sugar and lemon juice, then simmer for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Combine the apricot mixture and pectin mixture. Bring the jam to a simmer and cook for 10 minutes, stirring as needed.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Transfer the hot jam to heat-safe containers and let stand for 60 minutes. Cool before serving or storing.",
      "timer_minutes": 60
    }
  ],
