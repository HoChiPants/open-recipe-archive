{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cranberry-citrus-jam",
  "name": "Cranberry Citrus Jam",
  "subtitle": "Tart cranberry jam with bright orange and warm spice",
  "description": "A vibrant cranberry spread flavored with orange zest, citrus juice, star anise, cinnamon, and cloves.",
  "meal_type": "other",
  "yield": {
    "quantity": 650,
    "unit": "ml, or 3 x 228ml jars"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-cranberries",
      "item": "fresh cranberries",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "oranges-zested-and-juiced",
      "item": "oranges zested and juiced",
      "quantity": 2
    },
    {
      "ingredient_id": "star-anise",
      "item": "star anise",
      "quantity": 1
    },
    {
      "ingredient_id": "cinnamon-stick",
      "item": "cinnamon stick",
      "quantity": 1
    },
    {
      "ingredient_id": "2-cloves",
      "item": "2 cloves",
      "quantity": 2,
      "unit": "cloves"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "edible-glitter-optional",
      "item": "edible glitter (optional)",
      "quantity": 2,
      "unit": "tsp",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place a small plate in the freezer to chill for testing the jam."
    },
    {
      "step": 2,
      "text": "Combine the cranberries, orange zest and juice, star anise, cinnamon stick, cloves, and sugar in a saucepan."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer over medium heat, stirring until the sugar dissolves."
    },
    {
      "step": 4,
      "text": "Cook for 35 minutes, stirring occasionally, until the cranberries break down and the mixture is thick.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Remove the pan from the heat and let the jam cool briefly."
    },
    {
      "step": 6,
      "text": "Test a small spoonful on the chilled plate; it should wrinkle slightly when pushed. If needed, return the pan to the heat and cook for 5 minutes more.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Remove the whole spices. Stir in the edible glitter, if using, and let the jam cool.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Transfer the jam to clean jars and allow it to cool completely before covering."
    }
  ],
