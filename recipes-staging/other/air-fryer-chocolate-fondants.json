{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "air-fryer-chocolate-fondants",
  "name": "Air Fryer Chocolate Fondants",
  "subtitle": "Individual warm chocolate cakes with soft centers",
  "description": "Rich chocolate fondants baked in ramekins in the air fryer and served with ice cream or cream.",
  "meal_type": "other",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 100,
      "unit": "g",
      "preparation": "diced plus 20g melted for the moulds"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": "1 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "dark-chocolate-broken-into-pieces",
      "item": "dark chocolate broken into pieces",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "plain-flour-sifted",
      "item": "plain flour sifted",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "ice-cream-or-double-cream-to-serve",
      "item": "ice cream or double cream to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Brush four moulds with the melted portion of the butter, then dust with cocoa powder. Shake out the excess."
    },
    {
      "step": 2,
      "text": "Melt the diced butter and dark chocolate together in the microwave in short intervals, stirring between each, until smooth. Let cool briefly."
    },
    {
      "step": 3,
      "text": "Whisk the eggs and brown sugar for 4 minutes, until thickened. Fold in the cooled chocolate mixture and sifted flour.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Divide the batter among the prepared moulds. Chill for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Preheat the air fryer. Cook the fondants for 10 minutes, until the edges are set and the center reaches 160°F for egg safety.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Rest briefly, then serve with ice cream or double cream."
    }
  ],
  "tags": [
    "air-fryer",
    "chocolate",
    "dessert",
    "individual-cakes"
  ],
  "seasons": [
    "year-round"
  ],
  "allergens": [
    "milk",
    "eggs",
    "wheat"
  ],
  "equipment": [
    "air fryer",
    "microwave",
    "four small moulds or ramekins",
    "whisk"
  ],
