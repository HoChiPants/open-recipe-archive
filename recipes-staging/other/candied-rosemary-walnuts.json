  "id": "candied-rosemary-walnuts",
  "name": "Candied Rosemary Walnuts",
  "subtitle": "Crisp caramel-coated walnuts with fresh rosemary",
  "description": "A simple sweet-and-herbal nut treat for gifting or snacking.",
  "meal_type": "other",
  "yield": {
    "quantity": 4,
    "unit": "small bags"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil-for-the-baking-sheet-optional",
      "item": "vegetable oil for the baking sheet (optional)",
      "optional": true
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "walnut-halves",
      "item": "walnut halves",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "finely-chopped-rosemary",
      "item": "finely chopped rosemary",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly oil a baking sheet if desired and set it aside."
    },
    {
      "step": 2,
      "text": "Place the caster sugar in a dry skillet over medium heat. Stir as it melts until it forms an even amber caramel."
    },
    {
      "step": 3,
      "text": "Add the walnut halves and finely chopped rosemary. Stir promptly until the nuts are evenly coated."
    },
    {
      "step": 4,
      "text": "Transfer the coated walnuts to the prepared baking sheet, separate them as much as possible, and let them cool completely."
    },
    {
      "step": 5,
      "text": "Break apart any joined pieces and divide the walnuts among four small bags."
    }
  ],
