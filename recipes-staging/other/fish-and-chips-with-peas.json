  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer or oven according to its cooking instructions. Lightly oil the racks with rapeseed oil."
    },
    {
      "step": 2,
      "text": "Cut the potatoes into thick chips, place them in the malt vinegar, and add enough water to cover. Bring to a boil, then cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Drain the potatoes and let them steam dry. Toss with the cornflour and 45 ml rapeseed oil, then arrange on the prepared racks."
    },
    {
      "step": 4,
      "text": "Cook the potatoes for 10 minutes, turning as needed.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Heat the olive oil and panko breadcrumbs for 4 minutes, until lightly browned. Stir in the lemon zest and parsley.",
      "timer_minutes": 4
    },
    {
      "step": 6,
      "text": "Place the plain flour in one dish and whisk the beaten eggs with the Dijon mustard in another. Coat each fish fillet in flour, then egg, then the toasted breadcrumbs."
    },
    {
      "step": 7,
      "text": "Arrange the fish on the racks with the potatoes and cook for 15 minutes, or until the fish reaches 145°F, is opaque, and flakes easily.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Mix the cornichons, their pickling liquid, dill, and mayonnaise to make the sauce. Chill until serving."
    },
    {
      "step": 9,
      "text": "Boil the peas for 2 minutes, drain, and cool for 5 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 10,
      "text": "Melt the butter with the lemon zest and juice for 1 minute. Stir in the peas and mint.",
      "timer_minutes": 1
    },
    {
      "step": 11,
      "text": "Serve the fish and chips with the mint peas, dill sauce, and lemon wedges."
    }
  ],
