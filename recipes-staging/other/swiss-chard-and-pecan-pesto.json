  "instructions": [
    {
      "step": 1,
      "text": "Heat half of the olive oil in a large skillet over medium heat. Add the Swiss chard, garlic, and basil; stir until the greens are wilted, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Transfer the wilted greens to a food processor. Add the remaining olive oil, pecans, sea salt, and Parmesan cheese; process until mostly smooth."
    },
    {
      "step": 3,
      "text": "Add the lemon juice and process briefly to combine."
    },
    {
      "step": 4,
      "text": "Season with sea salt and ground black pepper to taste."
    }
  ],
