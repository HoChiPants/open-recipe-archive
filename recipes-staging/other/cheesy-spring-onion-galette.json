  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Dust the work surface with flour and roll the pastry into a rough round."
    },
    {
      "step": 3,
      "text": "Stir together the crème fraîche, egg, Parmesan, lemon zest and juice, garlic, thyme leaves, and black pepper."
    },
    {
      "step": 4,
      "text": "Place the pastry on a lined baking sheet and spread the filling over the center, leaving a border."
    },
    {
      "step": 5,
      "text": "Arrange the spring onions over the filling, drizzle with olive oil, and fold the pastry edge inward."
    },
    {
      "step": 6,
      "text": "Scatter extra Parmesan over the galette and bake for 35 minutes, until the pastry is cooked through and the center reaches 160°F or is firm and fully set.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Cut into portions and serve with the green salad."
    }
  ],
