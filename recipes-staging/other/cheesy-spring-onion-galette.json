  "id": "cheesy-spring-onion-galette",
  "name": "Cheesy Spring Onion Galette",
  "subtitle": "A rustic pastry tart with lemony cheese filling and spring onions.",
  "description": "Crisp shortcrust pastry surrounds a savory crème fraîche, Parmesan, and herb filling topped with tender spring onions.",
  "meal_type": "other",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
