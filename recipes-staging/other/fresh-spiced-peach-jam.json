    {
      "ingredient_id": "and-chopped-fresh-peaches",
      "item": "and chopped fresh peaches",
      "quantity": 6,
      "unit": "cups",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "cups"
    },
    {
