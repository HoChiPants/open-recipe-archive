  "id": "fresh-spiced-peach-jam",
  "name": "Fresh Spiced Peach Jam",
  "subtitle": "A warm, cinnamon-scented peach spread",
  "description": "Peaches simmer with sugar, lemon, and gentle spices until thick and spoonable.",
  "meal_type": "other",
  "cuisine": "American",
