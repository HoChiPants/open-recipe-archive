    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the peeled, chopped peaches in a large saucepan. Add the sugar, lemon juice, cinnamon, nutmeg, and allspice, then stir to combine."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a gentle simmer over medium heat, stirring regularly so the sugar dissolves and the fruit cooks evenly.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Continue simmering until the jam thickens and the peaches are tender, stirring frequently during the final 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Transfer the hot jam to clean heat-safe containers, let it cool, cover, and refrigerate for 12 hours before serving. Do not use a home-canning process.",
      "timer_minutes": 720
    }
  ],
