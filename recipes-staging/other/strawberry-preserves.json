  "id": "strawberry-preserves",
  "name": "Strawberry Preserves",
  "subtitle": "Bright, sweet fruit spread",
  "description": "Strawberries simmer with sugar, vinegar, and a pinch of salt until thick and glossy, then cool for serving.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 40,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "hulled"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 5,
      "unit": "cups"
    },
    {
      "ingredient_id": "vinegar",
      "item": "vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the strawberries, sugar, vinegar, and salt in a heavy saucepan."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a simmer and cook at 220°F for 20 minutes, stirring occasionally, until thickened.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Transfer the preserves to heat-safe containers and let them cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Chill before serving."
    }
  ],
