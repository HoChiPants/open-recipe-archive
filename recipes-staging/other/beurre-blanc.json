  "id": "beurre-blanc",
  "name": "Beurre blanc",
  "subtitle": "A silky butter sauce with wine and shallot",
  "description": "A classic French sauce made by reducing wine, vinegar, and shallot, then whisking in cold butter until smooth and thick.",
  "meal_type": "other",
  "cuisine": "French",
  "yield": {
    "quantity": 175,
    "unit": "ml"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "dry-white-wine-such-as-sauvignon-blanc",
      "item": "dry white wine (such as sauvignon blanc)",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": 50,
      "unit": "ml"
    },
    {
      "ingredient_id": "shallot-finely-chopped",
      "item": "shallot finely chopped",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "cold-unsalted-butter-cut-into-cubes",
      "item": "cold unsalted butter cut into cubes",
      "quantity": 200,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the wine, vinegar, and shallot in a saucepan."
    },
    {
      "step": 2,
      "text": "Simmer until the liquid is reduced to a small, concentrated amount, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Transfer the reduction to a clean pan or bowl and return it to low heat."
    },
    {
      "step": 4,
      "text": "Whisk in the cold butter a few cubes at a time, adding more as each portion is nearly incorporated."
    },
    {
      "step": 5,
      "text": "Continue whisking until the sauce is smooth, thick, and emulsified. Serve warm."
    }
  ],
