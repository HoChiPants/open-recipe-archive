  "instructions": [
    {
      "step": 1,
      "text": "Coat the scored chicken with the Greek yogurt and the first measures of curry powder, turmeric, and ground coriander."
    },
    {
      "step": 2,
      "text": "Heat part of the ghee or oil in a large ovenproof pan. Sauté the chicken for 5 minutes, then transfer it to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Preheat the oven to 400°F.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Add the bay leaves, cinnamon sticks, and cardamom pods to the pan. Add the onions, garlic, and ginger, and stir until softened and fragrant.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Add the remaining ghee or oil, then stir in the second measures of curry powder, cumin, coriander, turmeric, and the chilli powder.",
      "timer_minutes": 4
    },
    {
      "step": 6,
      "text": "Return the chicken to the pan and turn it through the spiced onion mixture."
    },
    {
      "step": 7,
      "text": "Roast until tender and the thickest part reaches 165°F, allowing about 15 minutes for the roasting stage and additional time as needed for the safe endpoint.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Serve with the sliced green chillies and chopped coriander."
    }
  ],
