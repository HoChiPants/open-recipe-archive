  "id": "basil-pesto-c8c11d52",
  "name": "Basil Pesto",
  "subtitle": "A bright, nutty herb sauce",
  "description": "Blend fresh basil with toasted nuts, cheese, garlic, and olive oil for a versatile pesto.",
  "meal_type": "other",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "pine-nuts-or-cashews",
      "item": "pine nuts or cashews",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "bunch-of-basil-leaves-picked",
      "item": "bunch of basil leaves picked",
      "unit": "large"
    },
    {
      "ingredient_id": "parmesan-or-vegetarian-alternative",
      "item": "parmesan or vegetarian alternative",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "garlic-clove-chopped",
      "item": "garlic clove chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 100,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Toast the pine nuts or cashews in a dry skillet over medium heat for 3–5 minutes, stirring, until lightly golden. Cool briefly.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the basil, cheese, garlic, and toasted nuts to a food processor. Pulse until coarsely chopped."
    },
    {
      "step": 3,
      "text": "With the processor running, gradually add the olive oil and blend until the pesto reaches the desired consistency."
    }
  ],
