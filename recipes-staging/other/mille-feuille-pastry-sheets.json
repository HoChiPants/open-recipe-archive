  "id": "mille-feuille-pastry-sheets",
  "name": "Mille Feuille Pastry Sheets",
  "subtitle": "Crisp, sugared layers ready for filling",
  "description": "Bake thawed puff pastry under parchment and foil until crisp, then cool and divide into serving-size sheets.",
  "meal_type": "other",
  "cuisine": "French",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-puff-pastry-dough",
      "item": "frozen puff pastry dough",
      "quantity": 1,
      "unit": "package",
      "preparation": "17.5 ounce, thawed"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "or as needed for dusting"
    },
    {
      "ingredient_id": "sheets-aluminum-foil",
      "item": "sheets aluminum foil",
      "quantity": 3
    },
    {
      "ingredient_id": "sheet-parchment-paper",
      "item": "sheet parchment paper",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Line a baking sheet with the parchment paper."
    },
    {
      "step": 2,
      "text": "Transfer the thawed puff pastry dough to the lined sheet and prepare it into an even sheet. Prick the surface all over with a fork."
    },
    {
      "step": 3,
      "text": "Dust the pastry with the white sugar. Cover it with the parchment paper and the three sheets of aluminum foil."
    },
    {
      "step": 4,
      "text": "Bake for 15 minutes. Adjust the parchment and foil covering as needed to shield the pastry, then continue baking until crisp and browned, about 10 minutes more.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer the pastry to a work surface and let it cool. Remove the foil and parchment, then cut the pastry into serving-size sheets."
    }
  ],
