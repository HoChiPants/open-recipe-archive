  "id": "apple-rhubarb-jam",
  "name": "Apple-Rhubarb Jam",
  "subtitle": "A cinnamon-scented fruit spread",
  "description": "Cook diced rhubarb and apples with sugar, water, cinnamon, and pectin until thickened, then cool and chill before serving.",
  "meal_type": "other",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "rhubarb",
      "item": "rhubarb",
      "quantity": 3,
      "unit": "cups",
      "preparation": "diced"
    },
    {
      "ingredient_id": "apples",
      "item": "apples",
      "quantity": 3,
      "unit": "cups",
      "preparation": "diced peeled"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "dry-pectin",
      "item": "dry pectin",
      "quantity": 1,
      "unit": "package",
      "preparation": "2 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the rhubarb, apples, sugar, water, and cinnamon in a large saucepan. Let the mixture stand for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Bring the fruit mixture to a simmer over medium heat, stirring occasionally."
    },
    {
      "step": 3,
      "text": "Stir in the dry pectin and return the mixture to a simmer. Cook for 5 minutes, stirring frequently.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Continue simmering until the fruit is tender and the jam reaches a thick, spreadable consistency, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Remove from the heat and let the jam rest for 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 6,
      "text": "Cool completely, then chill before serving."
    }
  ],
