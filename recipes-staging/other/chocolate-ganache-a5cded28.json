  "id": "chocolate-ganache-a5cded28",
  "name": "Chocolate Ganache",
  "subtitle": "A smooth dark chocolate cream topping",
  "description": "Rich ganache made by combining chopped dark chocolate with sweetened hot cream, then whisking until smooth and thick.",
  "meal_type": "other",
  "yield": {
    "quantity": 500,
    "unit": "g"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "dark-chocolate-roughly-chopped",
      "item": "dark chocolate roughly chopped",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 2,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the roughly chopped chocolate in a heatproof bowl."
    },
    {
      "step": 2,
      "text": "Heat the cream and sugar together until the sugar has melted and the mixture is hot."
    },
    {
      "step": 3,
      "text": "Pour the hot cream mixture over the chocolate and whisk until smooth."
    },
    {
      "step": 4,
      "text": "Transfer the ganache to a clean bowl and whisk until thickened and set."
    }
  ],
