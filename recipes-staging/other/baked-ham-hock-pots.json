  "id": "baked-ham-hock-pots",
  "name": "Baked Ham Hock Pots",
  "subtitle": "Creamy ham, potato, and cheddar bakes",
  "description": "Individual bakes combine cooked ham hock and potatoes with seasoned cream, chives, egg, and mature cheddar. Serve hot with crusty bread.",
  "meal_type": "other",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "egg-beaten",
      "item": "egg beaten",
      "quantity": 1
    },
    {
      "ingredient_id": "handful-of-chives-finely-chopped",
      "item": "handful of chives finely chopped",
      "unit": "large"
    },
    {
      "ingredient_id": "generous-grating-of-nutmeg",
      "item": "generous grating of nutmeg"
    },
    {
      "ingredient_id": "ham-hock-chopped",
      "item": "ham hock chopped",
      "quantity": 100,
      "unit": "g",
      "preparation": "cooked"
    },
    {
      "ingredient_id": "canned-potatoes-cut-into-smaller-chunks-if-large",
      "item": "canned potatoes cut into smaller chunks if large",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "mature-cheddar-grated",
      "item": "mature cheddar grated",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "crusty-bread-to-serve",
      "item": "crusty bread to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare four individual ovenproof pots or dishes."
    },
    {
      "step": 2,
      "text": "Whisk the double cream, beaten egg, chives, and nutmeg together. Stir in the chopped ham hock and potatoes, then divide the mixture among the prepared pots."
    },
    {
      "step": 3,
      "text": "Top each pot with the grated mature cheddar."
    },
    {
      "step": 4,
      "text": "Bake for 17 minutes, until set. Check the center reaches 160°F for egg safety.",
      "timer_minutes": 17
    },
    {
      "step": 5,
      "text": "Serve hot with crusty bread."
    }
  ],
