  "id": "crisp-cereal-oat-cookies",
  "name": "Crisp Cereal Oat Cookies",
  "subtitle": "Chewy cookies with coconut, oats, cereal, and chocolate chips",
  "description": "A buttery cookie dough studded with crunchy cereal, oats, coconut, and semisweet chocolate chips.",
  "meal_type": "dessert",
