  "id": "birthday-cupcakes",
  "name": "Birthday Cupcakes",
  "subtitle": "Vanilla cupcakes with buttercream and sprinkles",
  "description": "Light vanilla cupcakes topped with a simple buttercream and colorful sprinkles.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
