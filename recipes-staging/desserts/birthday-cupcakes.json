  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and line a 12-hole cupcake pan."
    },
    {
      "step": 2,
      "text": "Beat 180 g softened butter with the caster sugar until pale. Add the beaten eggs gradually, mixing between additions."
    },
    {
      "step": 3,
      "text": "Fold in the self-raising flour, baking powder, and 1 tsp vanilla extract, then fold in the sprinkles."
    },
    {
      "step": 4,
      "text": "Divide the batter among the liners and bake for 20 minutes, until risen and firm in the centers. If checking temperature, the centers should reach 160°F.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Transfer the cupcakes to a rack and cool for 5 minutes before decorating.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Beat 200 g softened butter until smooth. Gradually whisk in the sifted icing sugar, then mix in 1 tsp vanilla extract."
    },
    {
      "step": 7,
      "text": "Spread or pipe the frosting over the cooled cupcakes and finish with the extra sprinkles."
    }
  ],
