  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Prepare a baking pan."
    },
    {
      "step": 3,
      "text": "Combine the sifted flour, baking powder, and salt in a bowl."
    },
    {
      "step": 4,
      "text": "Whisk the brown sugar, softened butter, and vanilla until smooth, then whisk in the egg."
    },
    {
      "step": 5,
      "text": "Stir in the dry ingredients and chopped walnuts just until combined."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and spread it evenly."
    },
    {
      "step": 7,
      "text": "Bake for 30 minutes, until the center is firm and fully set; confirm with a thermometer at 160°F if needed.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Cool completely in the pan, then cut into 20 servings."
    }
  ],
