  "id": "brown-sugar-brownies",
  "name": "Brown Sugar Brownies",
  "subtitle": "Chewy brownies with brown sugar and walnuts",
  "description": "A simple American dessert with a soft, chewy texture, buttery brown-sugar flavor, and chopped walnuts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
