  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Grease and flour a cake pan."
    },
    {
      "step": 2,
      "text": "Whisk the flour and baking soda together."
    },
    {
      "step": 3,
      "text": "Beat the 1/2 cup butter and white sugar until light. Add the eggs one at a time, then mix in the vanilla and mashed bananas."
    },
    {
      "step": 4,
      "text": "Add the flour mixture alternately with the buttermilk, mixing just until combined. Fold in the chopped pecans."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and spread it evenly."
    },
    {
      "step": 6,
      "text": "Bake at 350°F for 25 minutes, or until the center is fully set.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Cool the cake completely before frosting."
    },
    {
      "step": 8,
      "text": "Whisk the softened butter and confectioners' sugar until smooth. Gradually whisk in the heavy whipping cream until spreadable."
    },
    {
      "step": 9,
      "text": "Transfer the frosting to the cooled cake, spread it evenly, and decorate with the pecan halves."
    }
  ],
