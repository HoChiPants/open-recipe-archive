  "id": "banana-nut-cake",
  "name": "Banana Nut Cake",
  "subtitle": "Moist banana cake with pecans and a simple cream frosting",
  "description": "A tender banana cake folded with chopped pecans, cooled, frosted, and finished with pecan halves.",
  "meal_type": "dessert",
  "cuisine": "American",
