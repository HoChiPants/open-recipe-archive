  "id": "ice-cream-cake",
  "name": "Ice Cream Cake",
  "subtitle": "A chilled layered dessert with chocolate topping",
  "description": "Ice cream sandwiches form the base of this simple frozen cake, finished with whipped topping, chocolate fudge, and grated candy.",
  "meal_type": "dessert",
