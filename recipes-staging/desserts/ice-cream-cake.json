      "ingredient_id": "ice-cream-sandwiches",
      "item": "ice cream sandwiches",
      "quantity": 16
    },
    {
      "ingredient_id": "16-ounce-container-frozen-non-dairy-whipped-topping",
      "item": "(16 ounce) container frozen non-dairy whipped topping",
      "quantity": 1
    },
    {
      "ingredient_id": "12-ounce-jar-chocolate-fudge-topping",
      "item": "(12 ounce) jar chocolate fudge topping",
      "quantity": 1,
      "preparation": "room temperature"
    },
    {
      "ingredient_id": "1-5-ounce-bar-chocolate-candy-bar",
      "item": "(1.5 ounce) bar chocolate candy bar",
      "quantity": 1,
      "preparation": "grated"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Unwrap the ice cream sandwiches, place them in a large bowl, and whisk until softened and spreadable."
    },
    {
      "step": 2,
      "text": "Transfer the frozen non-dairy whipped topping and room-temperature chocolate fudge topping to the bowl, then prepare a cohesive mixture with the softened sandwiches."
    },
    {
      "step": 3,
      "text": "Spread the mixture in a serving dish or pan. Add the chocolate fudge topping and grated chocolate candy bar over the top."
    },
    {
      "step": 4,
      "text": "Freeze until firm, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Prepare the frozen non-dairy whipped topping for serving and use it to finish the cake."
    }
  ],
