      "item": "few mint leaves to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Crush the digestive biscuits and combine them with the ground almonds and melted butter. Press the mixture into the base of a cake pan."
    },
    {
      "step": 2,
      "text": "Bake the crust for 15 minutes, then transfer it out of the oven to cool briefly.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Whisk the soft cheese and granulated sugar until smooth. Beat in the vanilla extract and eggs until combined, then whisk in the soured cream."
    },
    {
      "step": 4,
      "text": "Transfer the filling over the crust and distribute the blackberries through it."
    },
    {
      "step": 5,
      "text": "Bake for 50 minutes, until firm in the center or registering 160°F on a food thermometer. Cool the cheesecake, then cool it fully before serving.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Serve with the remaining blackberries and mint leaves."
    }
  ],
