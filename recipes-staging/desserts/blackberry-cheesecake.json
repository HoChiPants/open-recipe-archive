  "id": "blackberry-cheesecake",
  "name": "Blackberry Cheesecake",
  "subtitle": "A creamy baked cheesecake with a berry-studded filling.",
  "description": "A buttery biscuit-and-almond base supports a soft cheese filling enriched with sour cream, eggs, vanilla, and blackberries.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 80
  },
  "ingredients": [
    {
      "ingredient_id": "digestive-biscuits",
      "item": "digestive biscuits",
      "quantity": 150,
      "unit": "g"
    },
    {
