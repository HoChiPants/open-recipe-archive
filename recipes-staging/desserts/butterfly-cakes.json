  "id": "butterfly-cakes",
  "name": "Butterfly Cakes",
  "subtitle": "Light cupcakes with vanilla buttercream wings",
  "description": "Bake tender vanilla cakes, fill or decorate them with optional jam, and finish with piped buttercream shaped into butterfly wings.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 110,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 110,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 110,
      "unit": "g"
    },
    {
