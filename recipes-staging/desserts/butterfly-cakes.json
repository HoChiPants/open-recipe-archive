      "item": "baking powder",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "milk-plus-2-tbsp-if-needed",
      "item": "milk plus 2 tbsp if needed",
      "quantity": 1,
      "unit": "tbsp",
      "preparation": "to loosen the buttercream"
    },
    {
      "ingredient_id": "strawberry-jam",
      "item": "strawberry jam (optional)",
      "optional": true
    },
    {
      "ingredient_id": "sprinkles",
      "item": "sprinkles (optional)",
      "optional": true
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-paste",
      "item": "vanilla paste",
      "quantity": 2,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a 10-hole cupcake tin with paper cases."
    },
    {
      "step": 2,
      "text": "Whisk the 110 g softened butter and caster sugar until light. Beat in the eggs and vanilla extract, then mix in the self-raising flour, baking powder, and 1 tbsp milk to form a smooth batter."
    },
    {
      "step": 3,
      "text": "Divide the batter among the cases and bake until golden brown.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Cool the cakes completely before decorating."
    },
    {
      "step": 5,
      "text": "Whisk the 150 g softened butter until smooth. Gradually add the icing sugar and vanilla paste, beating until creamy. Add the milk as needed to loosen the buttercream."
    },
    {
      "step": 6,
      "text": "Cut a small round from the top of each cake, halve the removed piece, and set the halves aside as wings. Add optional strawberry jam, then pipe or spoon buttercream into the opening and position the cake pieces as butterfly wings."
    },
    {
      "step": 7,
      "text": "Finish with optional sprinkles."
    }
  ],
