  "id": "chewy-maple-cookies",
  "name": "Chewy Maple Cookies",
  "subtitle": "Soft cookies with maple syrup and coconut",
  "description": "Maple-sweetened cookies with brown sugar and flaked coconut, baked until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "real-maple-syrup",
      "item": "real maple syrup",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F and prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Whisk the brown sugar and shortening until blended. Mix in the egg, maple syrup, and vanilla."
    },
    {
      "step": 3,
      "text": "Stir the flour, baking powder, and salt together, then add them to the wet mixture and mix just until combined."
    },
    {
      "step": 4,
      "text": "Fold in the coconut and portion the dough onto the prepared sheet."
    },
    {
      "step": 5,
      "text": "Bake for 12 minutes, until the cookies are set and the center reaches 160°F.",
      "timer_minutes": 12
    }
  ],
