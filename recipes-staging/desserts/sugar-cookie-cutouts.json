  "id": "sugar-cookie-cutouts",
  "name": "Sugar Cookie Cutouts",
  "subtitle": "Tender, chilled cookies with a crisp decorative finish",
  "description": "Roll, cut, and decorate this buttery sugar-cookie dough for a batch of shaped cookies.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "colored-sugar-for-decoration",
      "item": "colored sugar for decoration",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Beat the softened butter, white sugar, and heavy whipping cream until smooth and blended."
    },
    {
      "step": 2,
      "text": "Mix in the eggs and vanilla extract."
    },
    {
      "step": 3,
      "text": "Whisk together the all-purpose flour and baking powder, then gradually stir the dry mixture into the wet mixture to form a dough."
    },
    {
      "step": 4,
      "text": "Cover and chill the dough until firm, about 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Heat the oven to 350°F and prepare baking sheets."
    },
    {
      "step": 6,
      "text": "Roll the chilled dough on a lightly floured surface, cut into shapes, and transfer the pieces to the prepared sheets."
    },
    {
      "step": 7,
      "text": "Sprinkle with white sugar and colored sugar for decoration."
    },
    {
      "step": 8,
      "text": "Bake until the cookies are set and lightly colored at the edges, about 14 minutes.",
      "timer_minutes": 14
    },
    {
      "step": 9,
      "text": "Cool the cookies on the sheets briefly, then transfer them to a rack to cool completely."
    },
    {
      "step": 10,
      "text": "Prepare and serve or store the cooled cookies."
    }
  ],
