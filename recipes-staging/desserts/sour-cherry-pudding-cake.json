  "id": "sour-cherry-pudding-cake",
  "name": "Sour Cherry Pudding Cake",
  "subtitle": "A tender baked cake layered with tart cherries",
  "description": "A simple American dessert combining a smooth cake batter with almond-scented sour cherries and a lightly browned finish.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "tart-red-cherries",
      "item": "tart red cherries",
      "quantity": 3,
      "unit": "cups",
      "preparation": "pitted"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Stir the flour, one cup of white sugar, milk, and baking powder together until smooth."
    },
    {
      "step": 3,
      "text": "In a separate bowl, stir the remaining white sugar with the pitted cherries and almond extract."
    },
    {
      "step": 4,
      "text": "Transfer the batter to a baking dish and distribute the cherry mixture over it."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until lightly browned and the center is fully set.",
      "timer_minutes": 30
    }
  ],
