  "instructions": [
    {
      "step": 1,
      "text": "Whisk the pudding mix with 3 cups milk until thickened. Fold in the thawed whipped topping.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Cover the bottom of a baking dish with chocolate graham crackers. Spread half the pudding mixture over them, then repeat with another cracker layer and the remaining pudding. Finish with a final cracker layer."
    },
    {
      "step": 3,
      "text": "Combine the remaining milk, cocoa powder, sugar, and butter in a saucepan. Bring to a boil and cook for 1 minute, stirring until smooth.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Remove from the heat and stir in the vanilla extract. Spread the warm frosting over the top cracker layer."
    },
    {
      "step": 5,
      "text": "Refrigerate until set, about 2 hours, then cut and serve.",
      "timer_minutes": 120
    }
  ],
