  "id": "no-bake-chocolate-eclair-cake",
  "name": "No-Bake Chocolate Eclair Cake",
  "subtitle": "Creamy pudding and chocolate cracker layers with a simple cocoa topping",
  "description": "A chilled layered dessert made with vanilla pudding, whipped topping, chocolate graham crackers, and a quick cocoa frosting.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
