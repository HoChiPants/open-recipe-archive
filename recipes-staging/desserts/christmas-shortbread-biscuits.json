  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "christmas-shortbread-biscuits",
  "name": "Christmas Shortbread Biscuits",
  "subtitle": "Buttery festive biscuits with chocolate, spice, and fruit",
  "description": "Crisp, buttery shortbread biscuits topped with melted chocolate, crystallised ginger or cranberries, and nuts.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 275,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-mixed-spice-ground-cinnamon-or-ground-cardamom-optional",
      "item": "ground mixed spice ground cinnamon or ground cardamom (optional)",
      "quantity": 1,
      "unit": "tsp",
      "optional": true
    },
    {
      "ingredient_id": "salted-butter-cut-into-cubes",
      "item": "salted butter cut into cubes",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "egg-yolks-beaten-freeze-the-extra-whites-to-use-in-another-recipe",
      "item": "egg yolks beaten (freeze the extra whites to use in another recipe)",
      "quantity": 2
    },
    {
      "ingredient_id": "white-chocolate-roughly-chopped",
      "item": "white chocolate roughly chopped",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "crystallised-ginger-chopped",
      "item": "crystallised ginger chopped",
      "quantity": 15,
      "unit": "g",
      "preparation": "or dried cranberries, chopped"
    },
    {
      "ingredient_id": "dark-chocolate-roughly-chopped",
      "item": "dark chocolate roughly chopped",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "flaked-almonds-or-shelled-pistachios",
      "item": "flaked almonds or shelled pistachios",
      "quantity": 15,
      "unit": "g",
      "preparation": "thinly sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, sugar, and optional spice. Rub in the cubed butter until the mixture resembles fine crumbs, then stir in the beaten egg yolks to form a dough."
    },
    {
      "step": 2,
      "text": "Shape the dough into a compact log or flat slab, wrap, and chill.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Heat the oven to 350°F and line a baking sheet. Slice or shape the chilled dough into about 20 biscuits and arrange them on the sheet."
    },
    {
      "step": 4,
      "text": "Bake until lightly golden, fully set, and at least 160°F in the center.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer the biscuits to a rack and let them cool completely.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Melt the white and dark chocolate separately over simmering water or in short microwave intervals, stirring until smooth."
    },
    {
      "step": 7,
      "text": "Spread or drizzle the chocolates over the cooled biscuits. Add the chopped ginger or cranberries and the sliced almonds or pistachios."
    },
    {
      "step": 8,
      "text": "Leave the biscuits undisturbed until the chocolate is set, then serve or store in an airtight container."
    }
  ],
