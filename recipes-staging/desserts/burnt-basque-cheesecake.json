  "id": "burnt-basque-cheesecake",
  "name": "Burnt Basque Cheesecake",
  "subtitle": "A deeply browned, creamy Spanish-style cheesecake",
  "description": "A simple cheesecake with a dark caramelized surface and rich, smooth center.",
  "meal_type": "dessert",
  "cuisine": "Spanish",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "butter-for-the-tin",
      "item": "butter for the tin"
    },
    {
      "ingredient_id": "soft-cheese",
      "item": "soft cheese",
      "quantity": 800,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "soured-cream",
      "item": "soured cream",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "medium"
    },
    {
      "ingredient_id": "vanilla",
      "item": "vanilla",
      "quantity": 2,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and butter the inside of the tin."
    },
    {
      "step": 2,
      "text": "Beat the soft cheese until smooth. Add the caster sugar and whisk until evenly combined."
    },
    {
      "step": 3,
      "text": "Mix in the plain flour, soured cream, eggs, and vanilla until the batter is smooth."
    },
    {
      "step": 4,
      "text": "Pour the batter into the prepared tin and bake for 30 minutes, until the top is deeply browned and the center reaches 160°F or is fully set.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Let the cheesecake cool, then chill it for at least 60 minutes before serving.",
      "timer_minutes": 60
    }
  ],
