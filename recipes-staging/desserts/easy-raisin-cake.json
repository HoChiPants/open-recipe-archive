  "id": "easy-raisin-cake",
  "name": "Easy Raisin Cake",
  "subtitle": "A warmly spiced cake with plump raisins and walnuts",
  "description": "A simple American dessert made by simmering raisins, enriching them with butter, and folding the mixture into a spiced flour batter with walnuts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
