  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the raisins and water in a saucepan and simmer for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Remove from the heat and stir in the butter and baking soda. Let the mixture cool briefly."
    },
    {
      "step": 4,
      "text": "Combine the salt, sugar, cinnamon, nutmeg, and flour in a mixing bowl."
    },
    {
      "step": 5,
      "text": "Add the raisin mixture and walnuts to the dry ingredients, stirring just until combined."
    },
    {
      "step": 6,
      "text": "Spread the batter in a suitable baking pan and bake at 350°F for 35 minutes, or until the center is firm and a tester comes out clean.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Cool before cutting and serving."
    }
  ],
