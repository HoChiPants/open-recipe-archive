  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "vanilla-wafers",
      "item": "vanilla wafers",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 ounce, crushed"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Whisk the butter until smooth. Add the white sugar and continue whisking until smooth."
    },
    {
      "step": 3,
      "text": "Add the eggs and mix until incorporated."
    },
    {
      "step": 4,
      "text": "Stir in the milk and crushed vanilla wafers, then combine with the flaked coconut and chopped pecans."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a prepared baking pan and bake for 120 minutes, until the center is firm and fully set.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Cool before serving."
    }
  ],
