  "id": "vanilla-wafer-cake",
  "name": "Vanilla Wafer Cake",
  "subtitle": "A tender cake with coconut and pecans",
  "description": "Crushed vanilla wafers, coconut, and pecans add texture and flavor to this gently baked cake.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
