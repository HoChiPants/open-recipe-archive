  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking pan for the batter."
    },
    {
      "step": 2,
      "text": "Whisk 1 cup white sugar and the butter until well combined."
    },
    {
      "step": 3,
      "text": "Whisk in the flour, sour cream, beaten eggs, vanilla extract, baking powder, baking soda, and salt to form a smooth batter."
    },
    {
      "step": 4,
      "text": "Combine the remaining white sugar with the walnuts and cinnamon."
    },
    {
      "step": 5,
      "text": "Transfer half the batter to the prepared pan and spread it evenly. Add the walnut mixture, then cover with the remaining batter."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, until the center is firm and a tester comes out clean.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Cool in the pan for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
