  "id": "walnut-sour-cream-coffee-cake",
  "name": "Walnut Sour Cream Coffee Cake",
  "subtitle": "Tender coffee cake with a cinnamon-walnut topping",
  "description": "A rich sour-cream cake layered with cinnamon, sugar, and chopped walnuts, then baked until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
