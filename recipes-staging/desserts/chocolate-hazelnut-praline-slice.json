  "id": "chocolate-hazelnut-praline-slice",
  "name": "Chocolate Hazelnut Praline Slice",
  "subtitle": "A chilled chocolate slice with crisp caramelized hazelnuts",
  "description": "A rich chocolate slice layered with hazelnut praline, finished with cocoa and crème fraîche.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-plus-extra-for-the-tin",
      "item": "unsalted butter plus extra for the tin",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-chocolate",
      "item": "dark chocolate",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "cocoa-powder-for-dusting",
      "item": "cocoa powder for dusting"
    },
    {
      "ingredient_id": "cre-me-frai-che-to-serve",
      "item": "crème fraîche to serve"
    },
    {
      "ingredient_id": "sunflower-oil-for-the-tin",
      "item": "sunflower oil for the tin"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "whole-blanched-hazelnuts",
      "item": "whole blanched hazelnuts",
      "quantity": 100,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grease and line a slice tin with the extra butter and sunflower oil."
    },
    {
      "step": 2,
      "text": "Heat the caster sugar in a pan until it melts into a golden caramel. Add the hazelnuts, coat them, then spread the mixture on parchment and leave until set.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Break the set hazelnut praline into pieces and set aside some for finishing."
    },
    {
      "step": 4,
      "text": "Melt the butter and dark chocolate together over a pan of gently simmering water, or in short microwave intervals, stirring until smooth."
    },
    {
      "step": 5,
      "text": "Whisk the double cream to soft peaks. Fold it into the melted chocolate mixture, then stir in the praline pieces."
    },
    {
      "step": 6,
      "text": "Spread the mixture evenly in the prepared tin and chill until smooth and set."
    },
    {
      "step": 7,
      "text": "Dust with cocoa powder, scatter with the remaining hazelnut praline, and cut into slices. Serve with crème fraîche."
    }
  ],
