{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "coconut-buttercream-cake-icing",
  "name": "Coconut Buttercream Cake Icing",
  "subtitle": "Smooth buttercream with coconut and pecans",
  "description": "A creamy coconut buttercream for finishing cakes, with extra coconut and pecans scattered over the top.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "vegetable-shortening",
      "item": "vegetable shortening",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 3,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "sweetened-flaked-coconut",
      "item": "sweetened flaked coconut",
      "quantity": 1,
      "unit": "package",
      "preparation": "7 ounce, divided"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened butter and shortening until smooth."
    },
    {
      "step": 2,
      "text": "Whisk in the vanilla extract."
    },
    {
      "step": 3,
      "text": "Gradually whisk in the sifted confectioners' sugar."
    },
    {
      "step": 4,
      "text": "Add the milk and stir until the icing reaches a spreadable consistency."
    },
    {
      "step": 5,
      "text": "Fold in the portion of coconut intended for the icing."
    },
    {
      "step": 6,
      "text": "Transfer the icing to the cake and spread evenly. Finish with the remaining coconut and the chopped pecans."
    }
  ],
