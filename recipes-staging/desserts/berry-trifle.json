  "id": "berry-trifle",
  "name": "Berry Trifle",
  "subtitle": "Layers of cake, berries, and vanilla cream",
  "description": "A chilled layered dessert combining cubed pound cake, mixed berries, praline liqueur, and a soft vanilla pudding topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
