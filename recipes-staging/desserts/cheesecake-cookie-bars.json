      "item": "lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Combine the flour, walnuts, butter, and brown sugar until crumbly, then press the mixture evenly into a baking pan."
    },
    {
      "step": 2,
      "text": "Bake the crust for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Beat the softened cream cheese with the white sugar until smooth. Add the eggs, milk, lemon juice, and vanilla extract, and mix until fully combined."
    },
    {
      "step": 4,
      "text": "Pour the filling over the warm crust and spread it evenly."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, until the center is fully set.",
      "timer_minutes": 25
    }
  ],
