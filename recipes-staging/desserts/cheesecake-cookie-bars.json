  "id": "cheesecake-cookie-bars",
  "name": "Cheesecake Cookie Bars",
  "subtitle": "A buttery nut crust topped with creamy lemon cheesecake.",
  "description": "Bake a simple brown-sugar cookie crust, add a smooth cream cheese filling, and finish until set for sliceable dessert bars.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
