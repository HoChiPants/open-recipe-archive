  "id": "lemon-lime-cheesecake",
  "name": "Lemon-Lime Cheesecake",
  "subtitle": "A chilled citrus cheesecake with a buttery crumb crust",
  "description": "A creamy lemon-lime cheesecake baked over a graham crust, cooled, chilled, and finished with whipped cream topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
