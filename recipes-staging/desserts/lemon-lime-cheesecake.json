  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Mix the graham crumbs with the melted butter, then press the mixture evenly into the base of a prepared cheesecake pan."
    },
    {
      "step": 2,
      "text": "Beat the softened cream cheese, granulated sugar, whipping cream, and icing sugar until smooth. Mix in the lemon zest, lemon juice, lime zest and juice, and vanilla."
    },
    {
      "step": 3,
      "text": "Blend in the flour, then add the eggs and mix just until incorporated. Pour the filling over the crust."
    },
    {
      "step": 4,
      "text": "Bake for 40 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Let the cheesecake cool, then refrigerate for at least 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 6,
      "text": "Whisk the reserved cream-cheese mixture until stiff peaks form, then transfer it to the chilled cheesecake and spread or pipe as desired."
    }
  ],
