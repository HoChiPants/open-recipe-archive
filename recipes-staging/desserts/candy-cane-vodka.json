  "name": "Candy Cane Vodka",
  "subtitle": "A simple peppermint-infused vodka for festive sipping",
  "description": "Crushed candy canes dissolve into vodka during chilling, creating a sweet peppermint drink.",
  "meal_type": "dessert",
