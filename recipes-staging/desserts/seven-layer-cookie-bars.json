{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "seven-layer-cookie-bars",
  "name": "Seven-Layer Cookie Bars",
  "subtitle": "Layered chocolate, coconut, and walnut dessert bars",
  "description": "A buttery crumb base is topped with condensed milk, chocolate, walnuts, and coconut, then baked and cooled for clean-cut bars.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "graham-cracker-crumbs",
      "item": "graham cracker crumbs",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "coconut",
      "item": "coconut",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "white-chocolate-chips",
      "item": "white chocolate chips",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Combine the graham cracker crumbs with the melted butter, then press the mixture evenly into a baking pan."
    },
    {
      "step": 2,
      "text": "Pour the sweetened condensed milk over the crumb layer. Scatter the semisweet chocolate chips, chopped walnuts, shredded coconut, and white chocolate chips evenly over the top."
    },
    {
      "step": 3,
      "text": "Bake until the layers are set and the edges are lightly browned, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Cool completely before cutting into 24 bars."
    }
  ],
