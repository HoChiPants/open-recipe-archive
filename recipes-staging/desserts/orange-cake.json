  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a cake pan with the all-purpose flour as directed by your pan-preparation method."
    },
    {
      "step": 2,
      "text": "Whisk the milk, 0.5 cup orange juice, beaten eggs, and 1.5 teaspoons grated orange zest together."
    },
    {
      "step": 3,
      "text": "Combine the flour, salt, and baking powder in a separate bowl. Combine the superfine sugar and confectioners' sugar separately."
    },
    {
      "step": 4,
      "text": "Add the milk mixture and vegetable oil to the dry ingredients, then stir until combined and the batter is set."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake at 350°F until set, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Cool the cake completely before frosting."
    },
    {
      "step": 7,
      "text": "Whisk the softened butter, 2 tablespoons orange juice, and 1 teaspoon grated orange zest until smooth. Gradually whisk in the confectioners' sugar and continue whisking until smooth."
    },
    {
      "step": 8,
      "text": "Whisk in the vanilla extract and any remaining orange juice and zest mixture until the frosting is smooth, then spread it over the cooled cake."
    }
  ],
