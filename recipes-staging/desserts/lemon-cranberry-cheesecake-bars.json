  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "lemon-cranberry-cheesecake-bars",
  "name": "Lemon Cranberry Cheesecake Bars",
  "subtitle": "Creamy lemon filling with a tart cranberry layer",
  "description": "Oat crumble forms the base for a smooth lemon cheesecake filling and cranberry topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "whole-berry-cranberry-sauce",
      "item": "whole berry cranberry sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "16 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir together the flour, oats, and 0.75 cup brown sugar. Cut in the softened butter until the mixture forms coarse crumbs."
    },
    {
      "step": 3,
      "text": "Press the crumb mixture into the bottom of a baking pan and bake for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Whisk the cream cheese and sweetened condensed milk until smooth, then stir in the lemon juice."
    },
    {
      "step": 5,
      "text": "Stir together the cranberry sauce, 1 tablespoon brown sugar, and cornstarch. Whisk in the remaining cream cheese until combined."
    },
    {
      "step": 6,
      "text": "Spread the lemon filling over the baked crust and add the cranberry mixture over the top. Bake for 40 minutes, until the center is set.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Cool completely before cutting into bars and serving."
    }
  ],
