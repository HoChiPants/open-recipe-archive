{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "hot-cross-buns",
  "name": "Hot Cross Buns",
  "subtitle": "Spiced fruit buns with a golden cross",
  "description": "Soft yeast buns flavored with cinnamon, dried fruit, citrus peel, and a light apricot glaze.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "unsalted-butter-cut-into-cubes",
      "item": "unsalted butter cut into cubes",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "strong-white-bread-flour-plus-140g-for-the-crosses-and-extra-for-dusting",
      "item": "strong white bread flour plus 140g for the crosses and extra for dusting",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 85,
      "unit": "g"
    },
    {
      "ingredient_id": "sachet-fast-action-dried-yeast",
      "item": "sachet fast-action dried yeast",
      "quantity": 7,
      "unit": "g"
    },
    {
      "ingredient_id": "eggs-beaten",
      "item": "eggs beaten",
      "quantity": 2
    },
    {
      "ingredient_id": "vegetable-or-sunflower-oil-for-the-bowl",
      "item": "vegetable or sunflower oil for the bowl"
    },
    {
      "ingredient_id": "mixed-dried-fruit",
      "item": "mixed dried fruit",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "mixed-citrus-peel",
      "item": "mixed citrus peel",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "apricot-jam",
      "item": "apricot jam",
      "quantity": 2,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk with the butter until the butter melts. Let the mixture cool slightly."
    },
    {
      "step": 2,
      "text": "Mix the flour, cinnamon, sugar, and yeast in a large bowl. Stir in the warm milk mixture and beaten eggs to form a dough."
    },
    {
      "step": 3,
      "text": "Knead the dough on a lightly floured surface until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Oil a clean bowl, place the dough inside, cover, and leave it to rise until doubled in size.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Knead in the dried fruit and citrus peel. Divide the dough into buns and shape each piece into a smooth round."
    },
    {
      "step": 6,
      "text": "Arrange the buns on a prepared baking tray, cover, and leave them to rise.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Prepare a smooth paste from the reserved flour and butter, then use it to pipe or press crosses over the buns."
    },
    {
      "step": 8,
      "text": "Heat the oven and brush the buns with beaten egg."
    },
    {
      "step": 9,
      "text": "Bake until golden brown.",
      "timer_minutes": 25
    },
    {
      "step": 10,
      "text": "Warm the apricot jam and brush it over the hot buns."
    },
    {
      "step": 11,
      "text": "Cool briefly before serving.",
      "timer_minutes": 10
    }
  ],
