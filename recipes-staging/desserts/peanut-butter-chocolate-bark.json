  "id": "peanut-butter-chocolate-bark",
  "name": "Peanut Butter Chocolate Bark",
  "subtitle": "A crisp, creamy chocolate confection with peanut butter swirls.",
  "description": "Melt the chocolates and peanut butter, layer them in a prepared pan, then chill until firm for easy cutting.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "white-chocolate-chips",
      "item": "white chocolate chips",
      "quantity": 16,
      "unit": "ounces"
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "semi-sweet-chocolate-chips",
      "item": "semi-sweet chocolate chips",
      "quantity": 8,
      "unit": "ounces"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Coat a flat pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Melt the white chocolate chips and peanut butter together, stirring until smooth."
    },
    {
      "step": 3,
      "text": "In a separate heatproof bowl, melt the semi-sweet chocolate chips. Stir in the vanilla extract."
    },
    {
      "step": 4,
      "text": "Spread the white chocolate mixture in the prepared pan, then add the semi-sweet chocolate mixture and gently swirl the layers."
    },
    {
      "step": 5,
      "text": "Refrigerate until set, about 30 minutes, then cut or break into pieces.",
      "timer_minutes": 30
    }
  ],
