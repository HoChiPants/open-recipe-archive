  "id": "apple-oatmeal-cookies",
  "name": "Apple Oatmeal Cookies",
  "subtitle": "Soft cookies with apple, oats, cinnamon, and walnuts",
  "description": "These lightly spiced oatmeal cookies combine diced apple and chopped walnuts in a tender, simple dough.",
  "meal_type": "dessert",
