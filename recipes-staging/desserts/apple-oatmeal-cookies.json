  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare baking sheets."
    },
    {
      "step": 2,
      "text": "Stir together the flour, baking powder, cinnamon, nutmeg, and salt."
    },
    {
      "step": 3,
      "text": "Whisk the sugar and shortening until blended. Whisk in the eggs one at a time."
    },
    {
      "step": 4,
      "text": "Stir the dry mixture into the shortening mixture until a dough forms, then fold in the walnuts, oats, and diced apple."
    },
    {
      "step": 5,
      "text": "Portion the dough onto the prepared baking sheets, leaving space between cookies."
    },
    {
      "step": 6,
      "text": "Bake until the cookies are set.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Let the cookies cool on the baking sheets before serving."
    }
  ],
