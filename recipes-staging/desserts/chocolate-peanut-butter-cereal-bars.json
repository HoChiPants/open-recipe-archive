{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-peanut-butter-cereal-bars",
  "name": "Chocolate Peanut Butter Cereal Bars",
  "subtitle": "Crisp cereal bars with a smooth chocolate topping",
  "description": "A no-bake dessert made with a warm peanut butter syrup, crispy rice cereal, and a two-chip chocolate topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 5,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "light-corn-syrup",
      "item": "light corn syrup",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "crispy-rice-cereal",
      "item": "crispy rice cereal",
      "quantity": 6,
      "unit": "cups"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butterscotch-chips",
      "item": "butterscotch chips",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sugar and corn syrup in a saucepan and heat until the mixture comes to a boil.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Remove from the heat and stir in the peanut butter until smooth."
    },
    {
      "step": 3,
      "text": "Add the crispy rice cereal and fold until evenly coated."
    },
    {
      "step": 4,
      "text": "Press the mixture evenly into a prepared pan."
    },
    {
      "step": 5,
      "text": "Microwave the peanut butter, semisweet chocolate chips, and butterscotch chips in short intervals, stirring between each, until smooth."
    },
    {
      "step": 6,
      "text": "Spread the topping over the cereal mixture and let it stand until set. Cut into bars."
    }
  ],
