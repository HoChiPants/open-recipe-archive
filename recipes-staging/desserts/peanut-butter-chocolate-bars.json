{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "peanut-butter-chocolate-bars",
  "name": "Peanut Butter Chocolate Bars",
  "subtitle": "A chilled peanut butter base finished with a smooth chocolate layer",
  "description": "Press a sweet peanut butter mixture into a pan, cover it with melted chocolate, and chill until firm before cutting into bars.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "creamy-peanut-butter",
      "item": "creamy peanut butter",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "chocolate-chips",
      "item": "chocolate chips",
      "quantity": 1,
      "unit": "bag",
      "preparation": "12 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the confectioners' sugar, peanut butter, melted margarine, brown sugar, and vanilla until evenly blended."
    },
    {
      "step": 2,
      "text": "Press the mixture into an even layer in a suitable pan."
    },
    {
      "step": 3,
      "text": "Melt the chocolate chips gently over simmering water, stirring until smooth."
    },
    {
      "step": 4,
      "text": "Spread the melted chocolate over the peanut butter layer."
    },
    {
      "step": 5,
      "text": "Chill until firm, about 30 minutes, then cut into 24 bars.",
      "timer_minutes": 30
    }
  ],
