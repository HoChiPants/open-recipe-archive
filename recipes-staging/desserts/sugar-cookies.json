{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "sugar-cookies",
  "name": "Sugar Cookies",
  "subtitle": "Soft, simple cookies with crisp edges",
  "description": "A straightforward batch of buttery sugar cookies mixed, shaped, and baked until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Stir together the flour, baking soda, and baking powder in a bowl."
    },
    {
      "step": 3,
      "text": "Whisk the softened butter and sugar until smooth, then whisk in the egg and vanilla extract."
    },
    {
      "step": 4,
      "text": "Blend the dry mixture into the butter mixture until a dough forms."
    },
    {
      "step": 5,
      "text": "Shape the dough into individual cookies and arrange them on a baking sheet."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, until the cookies are set and the centers reach 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Let the cookies cool before serving."
    }
  ],
