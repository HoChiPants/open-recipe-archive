  "instructions": [
    {
      "step": 1,
      "text": "Simmer 1 cup water with the cinnamon sticks, cloves, and anise seed for 15 minutes. Strain and reserve the spiced water.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Heat the 2 tablespoons water with the divided sugar in a saucepan, stirring until the sugar dissolves. Cook until the caramel reaches 310°F and turns golden brown."
    },
    {
      "step": 3,
      "text": "Pour the caramel into the baking dish and tilt to coat the bottom. Let it set."
    },
    {
      "step": 4,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 5,
      "text": "Tear the bread into pieces and combine it with the evaporated milk. Let stand for 10 minutes, stirring once or twice, until softened.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Whisk together the remaining sugar, eggs, vanilla extract, salt, melted butter, and reserved spiced water. Fold in the soaked bread."
    },
    {
      "step": 7,
      "text": "Transfer the mixture to the caramel-coated dish and place it in a larger pan. Add boiling water to the larger pan to form a water bath."
    },
    {
      "step": 8,
      "text": "Bake for 60 minutes, or until the center is firm and reaches 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 9,
      "text": "Cool, then chill for at least 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 10,
      "text": "Unmold or spoon onto plates and serve."
    }
  ],
