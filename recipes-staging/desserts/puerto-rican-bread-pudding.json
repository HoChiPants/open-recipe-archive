  "id": "puerto-rican-bread-pudding",
  "name": "Puerto Rican Bread Pudding",
  "subtitle": "A spiced custard pudding with a caramelized finish",
  "description": "Day-old bread is soaked with evaporated milk, eggs, infused spices, and butter, then baked until fully set and chilled before serving.",
  "meal_type": "dessert",
  "cuisine": "Puerto Rican",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
