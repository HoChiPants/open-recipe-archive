  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "coffee-pecan-squares",
  "name": "Coffee Pecan Squares",
  "subtitle": "A tender coffee cake with pecans and vanilla icing.",
  "description": "Bake a coffee-flavored pecan cake, cool it, and finish with a smooth vanilla icing before cutting into squares.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 225,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "instant-coffee-granules",
      "item": "instant coffee granules",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "pecans-plus-8-for-the-topping",
      "item": "pecans plus 8 for the topping",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "light-muscovado-sugar",
      "item": "light muscovado sugar",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "self-raising-flour-if-you-have-rye-flour",
      "item": "self-raising flour (if you have rye flour",
      "quantity": 225,
      "unit": "g",
      "preparation": "you can swap in 25g of it)"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": "1/2",
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grease a baking tin with some of the 225 g softened butter. Preheat the oven."
    },
    {
      "step": 2,
      "text": "Prepare the coffee granules with boiling water, then let the mixture cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Set aside 8 pecans for topping and prepare the remaining pecans. Cut them if needed."
    },
    {
      "step": 4,
      "text": "Whisk the 225 g softened butter with the muscovado sugar, then whisk in the eggs and the cooled coffee mixture."
    },
    {
      "step": 5,
      "text": "Fold in the self-raising flour and baking powder, then add the prepared pecans."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the greased tin and bake until the center is set and a tester comes out clean.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Whisk the 100 g softened butter, remaining coffee granules, muscovado sugar, icing sugar, and vanilla extract until smooth."
    },
    {
      "step": 8,
      "text": "Transfer the icing to the cooled cake, spread it evenly, and top with the reserved pecans."
    },
    {
      "step": 9,
      "text": "Cut into 12 squares and serve."
    }
  ],
