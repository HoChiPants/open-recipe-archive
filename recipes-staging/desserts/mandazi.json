  "id": "mandazi",
  "name": "Mandazi",
  "subtitle": "Cardamom-scented fried dough",
  "description": "Soft, lightly sweetened dough is rested, cut into portions, and fried until golden and fully set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "warm-milk",
      "item": "warm milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "fine-white-sugar",
      "item": "fine white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "medium"
    },
    {
      "ingredient_id": "instant-yeast",
      "item": "instant yeast",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cardamom",
      "item": "ground cardamom",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3.5,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying",
      "quantity": 2,
      "unit": "quarts",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the warm milk, vegetable oil, sugar, egg, yeast, salt, and cardamom together. Add the sifted flour gradually and mix until a soft dough forms."
    },
    {
      "step": 2,
      "text": "Knead the dough until smooth and pliable. Cover and let it rest in a warm place until noticeably expanded, about 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Knead briefly, then roll the dough into a thick sheet. Cut it into 18 pieces."
    },
    {
      "step": 4,
      "text": "Heat the frying oil over medium heat. Fry the pieces in batches, turning as needed, until golden brown and the centers reach 160°F on a food thermometer.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Transfer the cooked mandazi to a paper towel-lined plate and serve warm or at room temperature."
    }
  ],
