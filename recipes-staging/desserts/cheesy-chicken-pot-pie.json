  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the chicken stock, green peas, celery, and carrots in a saucepan. Bring to a simmer."
    },
    {
      "step": 2,
      "text": "Whisk the cornstarch and milk into the stock mixture. Cook, stirring, until thickened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the cooked shredded chicken and Cheddar cheese."
    },
    {
      "step": 4,
      "text": "Line a 9-inch pie dish with half the pastry. Add the filling, cover with the remaining pastry, and cut vents in the top."
    },
    {
      "step": 5,
      "text": "Preheat the oven for 60 minutes, then set it to 325°F.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Bake the pie until golden brown and the filling reaches 165°F in the center, about 40 minutes.",
      "timer_minutes": 40
    }
  ],
