  "id": "cheesy-chicken-pot-pie",
  "name": "Cheesy Chicken Pot Pie",
  "subtitle": "A savory chicken-and-vegetable pie with a creamy cheese filling",
  "description": "Chicken, vegetables, and Cheddar are bound in a thickened sauce, enclosed in pastry, and baked until golden and safely heated through.",
  "meal_type": "dessert",
