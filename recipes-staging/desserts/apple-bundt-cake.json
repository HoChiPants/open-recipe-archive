  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a Bundt pan with flour so the baked cake releases easily."
    },
    {
      "step": 2,
      "text": "Toss the diced apples with 1 tablespoon white sugar and the cinnamon; set aside. Whisk the flour, baking powder, and salt together in a separate bowl."
    },
    {
      "step": 3,
      "text": "Whisk the remaining white sugar, vegetable oil, orange juice, vanilla, and eggs until smooth."
    },
    {
      "step": 4,
      "text": "Stir the dry mixture into the wet mixture just until combined, then fold in the walnuts."
    },
    {
      "step": 5,
      "text": "Transfer about half the batter to the pan, add the apple mixture, and cover with the remaining batter."
    },
    {
      "step": 6,
      "text": "Bake for 60 minutes, until the center is fully set. Remove from the oven and cool in the pan for 10 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Turn the cake out onto a rack and cool completely, about 20 minutes. Dust with the confectioners' sugar before serving.",
      "timer_minutes": 20
    }
  ],
