  "id": "apple-bundt-cake",
  "name": "Apple Bundt Cake",
  "subtitle": "Cinnamon apples and walnuts in a tender orange-scented cake.",
  "description": "A straightforward Bundt cake layered with cinnamon apples, chopped walnuts, and a light confectioners' sugar finish.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
