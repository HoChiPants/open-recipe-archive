  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a cake pan for baking."
    },
    {
      "step": 2,
      "text": "Whisk the flour, salt, baking soda, baking powder, ginger, and cinnamon together."
    },
    {
      "step": 3,
      "text": "Melt the unsalted butter with the coconut oil, then let the mixture cool slightly."
    },
    {
      "step": 4,
      "text": "Whisk the eggs with the white sugar and confectioners' sugar for 3 minutes, until smooth. Whisk in the melted fats.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Stir in the carrots, drained pineapple, pecans, and walnuts. Add the dry ingredients and mix just until combined."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and bake for 45 minutes, until the center is fully set.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Cool the cake completely, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 8,
      "text": "Whisk the cream cheese, softened butter, and vanilla extract until smooth. Add the confectioners' sugar and whisk until smooth."
    },
    {
      "step": 9,
      "text": "Transfer the frosting to the cooled cake and spread evenly. Chill before serving."
    }
  ],
