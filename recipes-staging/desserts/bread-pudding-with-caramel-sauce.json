  "id": "bread-pudding-with-caramel-sauce",
  "name": "Bread Pudding with Caramel Sauce",
  "subtitle": "Warm, custardy bread pudding with a simple caramel finish",
  "description": "Cubed Italian bread absorbs a rich rum-vanilla custard before baking until set, then gets served with a smooth caramel sauce.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 85,
    "inactive_minutes": 80
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 8
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "rum",
      "item": "rum",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "loaf-italian-bread",
      "item": "loaf Italian bread",
      "quantity": 1,
      "preparation": "cut into 1-inch cubes"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vinegar",
      "item": "vinegar",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs until smooth. Whisk in the milk, rum, vanilla, salt, sugar, and half of the heavy cream.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Fold in the bread cubes and let them stand for 60 minutes, turning once or twice so the custard absorbs evenly.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "For the sauce, heat the remaining sugar, water, and vinegar in a saucepan until the sugar dissolves and the mixture turns amber, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Remove the caramel from the heat and carefully stir in the remaining heavy cream. Cool briefly, then stir until smooth and set aside.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Heat the oven to 350°F. Coat a baking dish with the butter and arrange the soaked bread mixture inside."
    },
    {
      "step": 6,
      "text": "Place the baking dish in a larger roasting pan. Pour boiling water into the outer pan to reach about halfway up the baking dish."
    },
    {
      "step": 7,
      "text": "Bake until the center is firm and reaches 160°F on a food thermometer, about 75 minutes.",
      "timer_minutes": 75
    },
    {
      "step": 8,
      "text": "Cool the pudding briefly, portion it, and serve with the caramel sauce."
    }
  ],
