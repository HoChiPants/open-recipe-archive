  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 300°F. Whisk the flour, salt, cinnamon, cloves, and baking soda together in a bowl."
    },
    {
      "step": 2,
      "text": "Beat 1/2 cup butter with 2 cups brown sugar until blended. Mix in the beaten eggs, then add the dry mixture and applesauce. Stir in the raisins, dates, and walnuts."
    },
    {
      "step": 3,
      "text": "Transfer the batter to a prepared baking pan and bake until set, about 120 minutes. Cool the cake completely.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "For the icing, heat the remaining 1/2 cup butter with 1 cup brown sugar. Simmer for 2 minutes, then stir in the milk and let the mixture cool for 5 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Whisk in the vanilla and sifted confectioners' sugar until smooth. Spread the icing over the cooled cake and let it set before serving."
    }
  ],
