  "id": "chocolate-gingerbread-cake",
  "name": "Chocolate Gingerbread Cake",
  "subtitle": "Spiced cake with cocoa glaze and candied orange",
  "description": "A tender gingerbread-style cake enriched with honey, nuts, candied orange, and a simple cocoa glaze.",
  "meal_type": "dessert",
