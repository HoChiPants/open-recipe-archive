  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease the cake tin with butter."
    },
    {
      "step": 2,
      "text": "Cream the 150 g caster sugar with the softened butter. Beat in the egg yolks, then mix in the honey and gingerbread spice."
    },
    {
      "step": 3,
      "text": "Whisk the egg whites to stiff peaks. Combine the flour, baking powder, walnuts, almonds, and candied orange; fold the dry mixture and egg whites into the batter in alternating additions."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared tin and bake until set, about 50 minutes.",
      "timer_minutes": 50
    },
    {
      "step": 5,
      "text": "For the glaze, combine the 100 g butter, 100 g caster sugar, and cocoa in a saucepan. Bring to a gentle simmer, stirring, and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Warm the cognac briefly, stir it into the glaze, and spread the glaze over the cooled cake. Finish with gingerbread spice and let the topping set."
    }
  ],
