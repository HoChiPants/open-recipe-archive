  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a 12-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking soda, baking powder, and salt in one bowl."
    },
    {
      "step": 3,
      "text": "Beat the white sugar, brown sugar, and softened unsalted butter until combined. Mix in the egg and mashed bananas, then add the buttermilk."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the wet mixture and stir just until combined. Fold in the chocolate chips."
    },
    {
      "step": 5,
      "text": "Divide the batter among the prepared cups and bake for 20 minutes, until the centers are firm and reach 160°F.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Cool the cupcakes completely, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Beat the cream cheese and softened butter until smooth. Add the vanilla, then gradually beat in the confectioners' sugar until smooth."
    },
    {
      "step": 8,
      "text": "Transfer the frosting to the cooled cupcakes and serve."
    }
  ],
