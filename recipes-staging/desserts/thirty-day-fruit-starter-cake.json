  "instructions": [
    {
      "step": 1,
      "text": "Transfer the starter to a large nonreactive container. Add the sliced peaches with their juice and part of the divided sugar; stir well and let stand at room temperature as the starter develops."
    },
    {
      "step": 2,
      "text": "At the next stages, add the pineapple with its juice and then the drained cherries, stirring in the remaining divided sugar at each addition. Cut the fruit into smaller pieces as needed, and let the mixture rest until the fruit is fully incorporated and the starter is set."
    },
    {
      "step": 3,
      "text": "Drain the finished fruit mixture, reserving 2 cups of the starter for the cake."
    },
    {
      "step": 4,
      "text": "Heat the oven to 325°F. Grease the baking pans and dust them with the all-purpose flour for dusting."
    },
    {
      "step": 5,
      "text": "Combine the yellow cake mix, eggs, vegetable oil, and instant vanilla pudding mix until smooth."
    },
    {
      "step": 6,
      "text": "Fold in the reserved starter, golden raisins, chopped walnuts, and flaked coconut. Transfer the batter to the prepared pans."
    },
    {
      "step": 7,
      "text": "Bake for about 55 minutes, until the cake is set in the center and a tester comes out clean. Cool before serving.",
      "timer_minutes": 55
    }
  ],
