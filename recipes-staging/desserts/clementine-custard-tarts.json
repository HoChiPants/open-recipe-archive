  "id": "clementine-custard-tarts",
  "name": "Clementine Custard Tarts",
  "subtitle": "Crisp pastry filled with bright citrus custard",
  "description": "Bake individual puff-pastry shells, fill them with clementine custard, and finish with a light dusting of sugar if desired.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "clementines-3-zested",
      "item": "clementines 3 zested",
      "quantity": 6,
      "preparation": "all juiced (you’ll need about 240ml)"
    },
    {
      "ingredient_id": "sheet-ready-rolled-puff-pastry",
      "item": "sheet ready-rolled puff pastry",
      "quantity": 320,
      "unit": "g"
    },
    {
      "ingredient_id": "plain-flour-for-dusting",
      "item": "plain flour for dusting"
    },
    {
      "ingredient_id": "eggs-plus-3-egg-yolks-freeze-the-extra-whites-to-make-meringues",
      "item": "eggs plus 3 egg yolks (freeze the extra whites to make meringues)",
      "quantity": 2
    },
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 450,
      "unit": "ml"
    },
    {
      "ingredient_id": "icing-sugar-for-dusting",
      "item": "icing sugar for dusting (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Lightly flour the work surface and prepare a 12-cup tart or muffin tin."
    },
    {
      "step": 2,
      "text": "Cut the puff pastry into 12 pieces, shape each piece into a cup in the tin, and chill briefly."
    },
    {
      "step": 3,
      "text": "Bake the pastry shells until puffed and golden, about 20 minutes. Cool slightly.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Whisk the eggs, egg yolks, cornflour, caster sugar, and clementine juice until smooth."
    },
    {
      "step": 5,
      "text": "Warm the milk gently for about 10 minutes, then gradually whisk it into the egg mixture.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Pour the custard into the pastry shells and bake until the centers are fully set and reach 160°F, about 22 minutes.",
      "timer_minutes": 22
    },
    {
      "step": 7,
      "text": "Cool the tarts, then dust with icing sugar if using."
    }
  ],
