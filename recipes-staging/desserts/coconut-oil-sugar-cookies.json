  "id": "coconut-oil-sugar-cookies",
  "name": "Coconut Oil Sugar Cookies",
  "subtitle": "Tender sugar cookies with coconut oil",
  "description": "Simple sugar cookies made with softened butter, coconut oil, and vanilla.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "coconut-oil",
      "item": "coconut oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 3
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, and baking soda together in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the sugar, softened butter, and coconut oil until smooth. Whisk in the egg yolks and vanilla."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the wet mixture and combine until a dough forms."
    },
    {
      "step": 5,
      "text": "Shape the dough into 16 cookies and arrange them on a baking sheet."
    },
    {
      "step": 6,
      "text": "Bake for 12 minutes, until the cookies are set in the center; if checking with a thermometer, ensure the egg-containing centers reach 160°F.",
      "timer_minutes": 12
    }
  ],
