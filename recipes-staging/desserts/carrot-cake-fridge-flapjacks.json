  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven and grease a baking tin with some of the butter."
    },
    {
      "step": 2,
      "text": "Simmer the pitted dates in water until boiling, then cook until softened. Drain if needed."
    },
    {
      "step": 3,
      "text": "Melt the remaining butter with the honey over low heat, stirring until smooth."
    },
    {
      "step": 4,
      "text": "Combine the carrots, oats, cranberries, apricots, walnuts, seeds, mixed spice, and cinnamon. Stir in the melted butter mixture and dates until evenly combined."
    },
    {
      "step": 5,
      "text": "Press the mixture firmly into the prepared tin and bake until set.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Cool completely, then chill until firm, about 3 hours."
    },
    {
      "step": 7,
      "text": "Whisk the soft cheese, sieved icing sugar, orange zest, and enough orange juice to make a smooth topping."
    },
    {
      "step": 8,
      "text": "Spread the topping over the chilled flapjack, cut into 12 portions, and serve."
    }
  ],
