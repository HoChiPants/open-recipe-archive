  "id": "carrot-cake-fridge-flapjacks",
  "name": "Carrot Cake Fridge Flapjacks",
  "subtitle": "Chilled oat squares with fruit, nuts, and citrus topping",
  "description": "A chewy baked oat slice packed with carrots and dried fruit, finished with a soft cheese and orange topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
