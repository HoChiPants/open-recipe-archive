  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Coat a baking dish with cooking spray."
    },
    {
      "step": 2,
      "text": "Cut the loquats as needed and combine them with the lemon juice, sugar, and cornstarch in a saucepan."
    },
    {
      "step": 3,
      "text": "Cook the fruit mixture over medium heat, stirring, until it simmers; continue for 2 minutes, until thickened.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Transfer the thickened fruit to the prepared baking dish."
    },
    {
      "step": 5,
      "text": "Whisk the flour, brown sugar, vanilla, cinnamon, and salt together. Cut in the cold butter until coarse crumbs form."
    },
    {
      "step": 6,
      "text": "Scatter the crumble mixture evenly over the fruit."
    },
    {
      "step": 7,
      "text": "Bake until the topping is thick and golden and the filling is bubbling, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 8,
      "text": "Let the crumble rest for 20 minutes before serving.",
      "timer_minutes": 20
    }
  ],
