  "id": "loquat-crumble",
  "name": "Loquat Crumble",
  "subtitle": "Warm fruit baked beneath a cinnamon crumble",
  "description": "Tender loquats are thickened with lemon and sugar, then topped with a buttery cinnamon mixture and baked until golden.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
