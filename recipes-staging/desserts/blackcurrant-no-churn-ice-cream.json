  "id": "blackcurrant-no-churn-ice-cream",
  "name": "Blackcurrant No-Churn Ice Cream",
  "subtitle": "Bright blackcurrant ice cream with a creamy, simple finish",
  "description": "Cook blackcurrants with lemon, fold the thickened fruit into a condensed milk and cream mixture, then freeze until firm.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 1.5,
    "unit": "litres"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "blackcurrants-fresh-or-frozen-400g-defrosted-if-frozen",
      "item": "blackcurrants fresh or frozen (400g defrosted if frozen)",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-zested-and-juiced",
      "item": "lemon zested and juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 600,
      "unit": "ml"
    },
    {
      "ingredient_id": "can-condensed-milk",
      "item": "can condensed milk",
      "quantity": 397,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Put the blackcurrants, lemon zest, and lemon juice in a saucepan. Simmer for 8 minutes, until the fruit has softened and the mixture has thickened.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Preheat the oven if needed for the chosen serving preparation."
    },
    {
      "step": 3,
      "text": "Whip the double cream with the condensed milk until thickened."
    },
    {
      "step": 4,
      "text": "Stir the cooled blackcurrant mixture into the cream mixture until evenly combined."
    },
    {
      "step": 5,
      "text": "Transfer to a freezer-safe container and freeze for 6 hours, or until set.",
      "timer_minutes": 360
    },
    {
      "step": 6,
      "text": "Let stand briefly, then serve with blackcurrants.",
      "timer_minutes": 30
    }
  ],
