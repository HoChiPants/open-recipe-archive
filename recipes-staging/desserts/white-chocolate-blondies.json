  "id": "white-chocolate-blondies",
  "name": "White Chocolate Blondies",
  "subtitle": "Chewy bars with white and semisweet chocolate",
  "description": "Rich, chewy blondies combining melted white chocolate with semisweet chocolate chips.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "white-chocolate",
      "item": "white chocolate",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a square baking pan for the batter."
    },
    {
      "step": 2,
      "text": "Combine the flour and salt in a bowl."
    },
    {
      "step": 3,
      "text": "Warm the white chocolate, butter, white sugar, and semisweet chocolate chips together over simmering water, stirring until smooth. Let the mixture cool until set."
    },
    {
      "step": 4,
      "text": "Whisk the eggs, then mix in the white sugar and vanilla extract."
    },
    {
      "step": 5,
      "text": "Combine the cooled chocolate mixture with the egg mixture. Stir in the flour mixture, then fold in the white chocolate and semisweet chocolate chips."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and bake for 25 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Cool completely before cutting into bars."
    }
  ],
