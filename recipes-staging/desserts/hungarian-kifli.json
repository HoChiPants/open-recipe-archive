  "id": "hungarian-kifli",
  "name": "Hungarian Kifli",
  "subtitle": "Walnut-filled crescent pastries",
  "description": "Tender cream-cheese pastries filled with a walnut meringue and finished with confectioners' sugar.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 10,
    "inactive_minutes": 540
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 9,
      "unit": "ounces"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 3
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 3
    },
    {
      "ingredient_id": "ground-walnuts",
      "item": "ground walnuts",
      "quantity": 8,
      "unit": "ounces"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar-for-decoration",
      "item": "confectioners' sugar for decoration",
      "quantity": 0.33333000540733,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cream cheese and butter until smooth. Mix in the egg yolks and vanilla extract."
    },
    {
      "step": 2,
      "text": "Stir together the all-purpose flour, salt, and baking powder, then add the mixture to the bowl and combine into a dough."
    },
    {
      "step": 3,
      "text": "Cover and chill the dough for 9 hours."
    },
    {
      "step": 4,
      "text": "Whisk the egg whites with the white sugar to soft peaks, then continue whisking until stiff peaks form. Fold in the ground walnuts until the filling is set."
    },
    {
      "step": 5,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 6,
      "text": "On a surface dusted with all-purpose flour, shape the dough into a thick sheet and cut it into portions."
    },
    {
      "step": 7,
      "text": "Place filling on each portion, shape into crescents, and transfer to a baking sheet."
    },
    {
      "step": 8,
      "text": "Bake until lightly browned and the centers are fully set, reaching 160°F if checked with a food thermometer.",
      "timer_minutes": 12
    },
    {
      "step": 9,
      "text": "Cool and dust with the white sugar and confectioners' sugar for decoration."
    }
  ],
