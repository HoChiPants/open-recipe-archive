  "id": "cranberry-bars",
  "name": "Cranberry Bars",
  "subtitle": "Tangy cranberry dessert bars with an oat topping",
  "description": "Cooked cranberries form a bright filling between a buttery cake-mix base and a lightly spiced oat topping.",
  "meal_type": "dessert",
  "cuisine": "American",
