  "id": "coconut-pecan-caramel-cream-pie",
  "name": "Coconut-Pecan Caramel Cream Pie",
  "subtitle": "A chilled pie with toasted coconut, pecans, and caramel.",
  "description": "Two baked crusts are filled with a smooth caramel cream mixture, finished with toasted coconut and pecans, and chilled until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 10,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "9-inch-pie-shells",
      "item": "(9 inch) pie shells",
      "quantity": 2,
      "preparation": "baked"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "12-ounce-container-frozen-whipped-topping",
      "item": "(12 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "12-ounce-jar-caramel-ice-cream-topping",
      "item": "(12 ounce) jar caramel ice cream topping",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a skillet over medium heat. Add the coconut and pecans; cook, stirring, until the coconut is lightly browned. Remove from the heat and cool completely.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the softened cream cheese with the caramel topping until smooth. Add the condensed milk and whisk until fully combined."
    },
    {
      "step": 3,
      "text": "Fold in the thawed whipped topping until the filling is smooth and evenly blended."
    },
    {
      "step": 4,
      "text": "Divide the filling between the baked pie shells. Top with the cooled coconut mixture and drizzle with the remaining caramel topping."
    },
    {
      "step": 5,
      "text": "Refrigerate the pies until firm before slicing.",
      "timer_minutes": 60
    }
  ],
