  "instructions": [
    {
      "step": 1,
      "text": "Cover the cashews with boiling water and leave to soften. Let the vegan soft cheese stand at room temperature for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Preheat the oven. Combine the porridge oats, 75 g caster sugar, and 4 tbsp melted coconut oil, then press the mixture into the base of a lined cake tin."
    },
    {
      "step": 3,
      "text": "Bake the base for 25 minutes, then let it cool.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Drain the cashews. Whisk them with 175 g coconut cream, the vegan soft cheese, cornflour, vanilla bean paste, maple syrup, 50 g melted coconut oil, and lemon juice until smooth."
    },
    {
      "step": 5,
      "text": "Pour the filling over the cooled base and bake until set, about 60 minutes. Cool, then chill for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 6,
      "text": "Microwave the raspberries with 2 tbsp caster sugar for 1 minute, then stir to make a topping.",
      "timer_minutes": 1
    },
    {
      "step": 7,
      "text": "Spread the raspberry topping over the chilled cheesecake and finish with the chopped pistachios and candied clementine peel."
    }
  ],
