  "id": "baked-vegan-cheesecake-with-raspberries-and-clementine",
  "name": "Baked Vegan Cheesecake with Raspberries and Clementine",
  "subtitle": "Creamy cashew cheesecake with berry topping and citrus garnish",
  "description": "A baked oat-based vegan cheesecake layered with a smooth cashew filling, raspberry topping, pistachios, and candied clementine peel.",
  "meal_type": "dessert",
