  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the flour, salt, and baking soda together."
    },
    {
      "step": 3,
      "text": "Whisk the brown sugar, oil, egg, vanilla, and milk until smooth. Stir in the flour mixture just until combined, then fold in the rhubarb and 1/2 cup sliced almonds."
    },
    {
      "step": 4,
      "text": "Spread the batter in the prepared pan."
    },
    {
      "step": 5,
      "text": "Mix the white sugar, melted butter, and remaining sliced almonds; scatter over the batter."
    },
    {
      "step": 6,
      "text": "Bake until the center is firm and fully set and a tester comes out clean, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
