  "id": "salted-peanut-cookies",
  "name": "Salted Peanut Cookies",
  "subtitle": "Chewy brown sugar cookies with roasted peanut crunch",
  "description": "A simple American cookie combining brown sugar, vanilla, and salted peanuts in a tender, crisp-edged bake.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salted-peanuts",
      "item": "salted peanuts",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the brown sugar, shortening, eggs, and vanilla until smooth, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk together the flour, salt, and baking soda."
    },
    {
      "step": 4,
      "text": "Stir the dry mixture into the sugar mixture until a dough forms, then fold in the salted peanuts."
    },
    {
      "step": 5,
      "text": "Portion the dough onto baking sheets, leaving space between portions."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, until golden brown. Cool briefly on the sheets before serving.",
      "timer_minutes": 10
    }
  ],
