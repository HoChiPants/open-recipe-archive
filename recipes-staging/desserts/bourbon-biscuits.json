{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "bourbon-biscuits",
  "name": "Bourbon biscuits",
  "subtitle": "Chocolate biscuits with a creamy cocoa filling",
  "description": "Bake crisp cocoa biscuits, then sandwich them with a smooth cocoa buttercream and finish with a light sugar sprinkle.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "soft-unsalted-butter",
      "item": "soft unsalted butter",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar-plus-extra-for-sprinkling",
      "item": "golden caster sugar plus extra for sprinkling",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-syrup",
      "item": "golden syrup",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "egg-lightly-beaten",
      "item": "egg lightly beaten",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "plain-flour-plus-extra-for-dusting",
      "item": "plain flour plus extra for dusting",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "unsalted-butter-softened",
      "item": "unsalted butter softened",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar-sifted",
      "item": "icing sugar sifted",
      "quantity": 360,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "pink-food-colouring",
      "item": "pink food colouring"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Beat 125 g soft butter with the caster sugar and golden syrup until smooth. Beat in the lightly beaten egg."
    },
    {
      "step": 2,
      "text": "Mix in the flour, 50 g cocoa powder, and baking powder to form a dough. Wrap and freeze for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Heat the oven to 350°F. Dust the work surface with flour and roll out the dough. Cut into approximately 50 biscuits, rerolling scraps as needed."
    },
    {
      "step": 4,
      "text": "Arrange the biscuits on lined baking trays, sprinkle with extra caster sugar, and bake for 10 minutes, until firm and the centers are fully set; if checked, they should reach 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Cool the biscuits completely on the trays or a rack."
    },
    {
      "step": 6,
      "text": "Beat the softened butter until creamy. Gradually beat in the sifted icing sugar and 4 tbsp cocoa powder until smooth. Tint with pink food colouring as desired."
    },
    {
      "step": 7,
      "text": "Spread or pipe the filling onto half of the cooled biscuits, then top with the remaining biscuits."
    }
  ],
