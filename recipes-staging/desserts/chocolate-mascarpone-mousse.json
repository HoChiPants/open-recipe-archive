  "id": "chocolate-mascarpone-mousse",
  "name": "Chocolate Mascarpone Mousse",
  "subtitle": "A quick chocolate dessert with a creamy mascarpone base",
  "description": "Mascarpone, cream, vanilla, and melted chocolate chips combine into a smooth chilled mousse.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
