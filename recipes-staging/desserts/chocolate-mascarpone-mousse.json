  "ingredients": [
    {
      "ingredient_id": "8-ounce-container-mascarpone-cheese",
      "item": "(8 ounce) container mascarpone cheese",
      "quantity": 1
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "chocolate-chips",
      "item": "chocolate chips",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the mascarpone cheese, heavy whipping cream, and vanilla extract until smooth."
    },
    {
      "step": 2,
      "text": "Add the chocolate chips and heat gently over simmering water, stirring until melted.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Fold the melted chocolate mixture into the mascarpone mixture until evenly combined."
    },
    {
      "step": 4,
      "text": "Divide among serving dishes and chill until set.",
      "timer_minutes": 120
    }
