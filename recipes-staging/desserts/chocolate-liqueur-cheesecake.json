  "id": "chocolate-liqueur-cheesecake",
  "name": "Chocolate Liqueur Cheesecake",
  "subtitle": "A chilled, creamy cheesecake with dark chocolate flavor.",
  "description": "A no-bake chocolate cheesecake built on a biscuit-and-butter base, with soft cheese, mascarpone, cocoa, and chocolate liqueur.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 2
  },
  "ingredients": [
    {
      "ingredient_id": "chocolate-digestive-biscuits",
      "item": "chocolate digestive biscuits",
      "quantity": 260,
      "unit": "g"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 125,
      "unit": "g",
      "preparation": "melted"
    },
    {
      "ingredient_id": "dark-chocolate-chopped",
      "item": "dark chocolate chopped",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "full-fat-soft-cheese-at-room-temperature",
      "item": "full fat soft cheese at room temperature",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "mascarpone-at-room-temperature",
      "item": "mascarpone at room temperature",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder-sieved",
      "item": "cocoa powder sieved"
    },
    {
      "ingredient_id": "baileys-chocolate-liqueur-plus-more-to-serve",
      "item": "Baileys Chocolate Liqueur plus more to serve",
      "quantity": 50,
      "unit": "ml"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "dark-chocolate-grated-to-serve",
      "item": "dark chocolate grated to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Crush the chocolate digestive biscuits into fine crumbs. Stir in the melted butter, then press the mixture firmly into the base of a lined cheesecake tin. Chill while preparing the filling."
    },
    {
      "step": 2,
      "text": "Melt the chopped dark chocolate with the chocolate liqueur in the microwave in short bursts, stirring between each, until smooth. Set aside to cool slightly.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Beat the soft cheese, mascarpone, icing sugar, and sieved cocoa powder until smooth. Mix in the cooled chocolate mixture."
    },
    {
      "step": 4,
      "text": "Whip the double cream to soft peaks, then fold it gently into the chocolate mixture until evenly combined."
    },
    {
      "step": 5,
      "text": "Spoon the filling over the biscuit base and smooth the surface. Chill until set, about 6 hours.",
      "timer_minutes": 360
    },
    {
      "step": 6,
      "text": "Serve with additional chocolate liqueur and grated dark chocolate."
    }
  ],
