  "id": "blueberry-dumplings",
  "name": "Blueberry Dumplings",
  "subtitle": "Tender dumplings simmered with sweet blueberries",
  "description": "A simple American dessert of milk-rich dumplings cooked in a sweet blueberry sauce.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 4,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lard",
      "item": "lard",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.66000002622604,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "blueberries",
      "item": "blueberries",
      "quantity": 1,
      "unit": "pint"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, baking powder, and salt. Work in the lard until evenly distributed, then stir in the milk to form a soft dough."
    },
    {
      "step": 2,
      "text": "Bring the water and sugar to a simmer in a pot, stirring until the sugar dissolves. Add the blueberries and return the mixture to a gentle simmer."
    },
    {
      "step": 3,
      "text": "Drop spoonfuls of dough into the simmering blueberry mixture. Cover and simmer until the dumplings are cooked through and the sauce has thickened.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Serve warm with the blueberry sauce."
    }
  ],
