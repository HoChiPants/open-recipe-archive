{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-pudding",
  "name": "Chocolate Pudding",
  "subtitle": "Smooth cocoa pudding for four",
  "description": "A simple stovetop pudding made with cocoa, milk, and vanilla.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the sugar, cocoa powder, cornstarch, and salt in a saucepan until evenly combined."
    },
    {
      "step": 2,
      "text": "Gradually whisk in the milk until smooth."
    },
    {
      "step": 3,
      "text": "Cook over medium heat, whisking frequently, until the mixture thickens and reaches a gentle boil.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Remove from the heat and stir in the vanilla extract."
    },
    {
      "step": 5,
      "text": "Transfer the pudding to serving dishes and chill until set."
    }
  ],
