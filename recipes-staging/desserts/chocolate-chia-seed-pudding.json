    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "hazelnut-flavor-instant-coffee-powder",
      "item": "hazelnut flavor instant coffee powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "chia-seeds",
      "item": "chia seeds",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 2,
      "unit": "teaspoons",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk together the cocoa powder, brown sugar, and hazelnut flavor instant coffee powder in a bowl."
    },
    {
      "step": 2,
      "text": "Stir in the chia seeds, then gradually add the milk and mix until evenly combined."
    },
    {
      "step": 3,
      "text": "Let the mixture stand for 20 minutes, stirring once or twice as it begins to thicken.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Stir in the honey, adjusting to taste, then cover and refrigerate for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Stir before serving."
    }
  ],
