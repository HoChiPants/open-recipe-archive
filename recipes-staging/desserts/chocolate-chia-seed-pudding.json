  "id": "chocolate-chia-seed-pudding",
  "name": "Chocolate Chia Seed Pudding",
  "subtitle": "A chilled cocoa pudding with a hazelnut-coffee note",
  "description": "Combine cocoa, brown sugar, coffee powder, chia seeds, milk, and honey, then chill until thick and spoonable.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
