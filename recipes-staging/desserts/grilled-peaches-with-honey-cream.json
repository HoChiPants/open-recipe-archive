  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Lightly coat the peach halves with vegetable oil."
    },
    {
      "step": 2,
      "text": "Grill the peaches for 5 minutes, turning as needed, until lightly marked and tender.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the cream cheese with the honey until smooth and evenly combined.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Serve the warm peaches topped with the honey cream and chopped nuts."
    }
