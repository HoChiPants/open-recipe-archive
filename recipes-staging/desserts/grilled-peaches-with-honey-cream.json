  "id": "grilled-peaches-with-honey-cream",
  "name": "Grilled Peaches with Honey Cream",
  "subtitle": "Warm fruit with a cool, nutty topping",
  "description": "Grilled peach halves are finished with honey cream cheese and chopped nuts for a simple summer dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "peaches",
      "item": "peaches",
      "quantity": 4,
      "preparation": "halved and pitted"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "clover-honey",
      "item": "clover honey",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "soft-cream-cheese-with-honey-and-nuts",
      "item": "soft cream cheese with honey and nuts",
      "quantity": 1,
      "unit": "cup"
    },
