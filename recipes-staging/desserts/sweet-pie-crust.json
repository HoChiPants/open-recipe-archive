  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour and sugar in a mixing bowl."
    },
    {
      "step": 2,
      "text": "Cut the chilled butter into the flour mixture until the mixture forms coarse crumbs."
    },
    {
      "step": 3,
      "text": "Add the ice water and mix just until the dough begins to hold together."
    },
    {
      "step": 4,
      "text": "Knead the dough briefly until cohesive, taking care not to overwork it."
    },
    {
      "step": 5,
      "text": "Chill the dough before rolling and using it for a pie crust.",
      "timer_minutes": 30
    }
