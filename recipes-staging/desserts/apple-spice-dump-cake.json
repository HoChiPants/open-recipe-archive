  "id": "apple-spice-dump-cake",
  "name": "Apple Spice Dump Cake",
  "subtitle": "A warmly spiced apple dessert with a crisp pecan topping",
  "description": "Apple pie filling, spiced cake mix, butter, and pecans bake together into an easy, bubbling fruit dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "apple-pie-filling",
      "item": "apple pie filling",
      "quantity": 2,
      "unit": "can",
      "preparation": "21 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-allspice",
      "item": "ground allspice",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "spice-cake-mix",
      "item": "spice cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Transfer the apple pie filling to a baking dish."
    },
    {
      "step": 2,
      "text": "Whisk the sugar, cinnamon, nutmeg, allspice, and cake mix together until evenly combined."
    },
    {
      "step": 3,
      "text": "Sprinkle the cake mixture over the apple filling, then distribute the butter and chopped pecans over the top."
    },
    {
      "step": 4,
      "text": "Bake for 45 minutes, until the topping is golden and the filling is bubbling at the edges.",
      "timer_minutes": 45
    }
  ],
