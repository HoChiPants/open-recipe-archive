  "id": "air-fryer-apple-crumble",
  "name": "Air-Fryer Apple Crumble",
  "subtitle": "Soft spiced apples under a crisp oat topping",
  "description": "A quick fruit crumble with buttery oat topping, served warm with a choice of creamy accompaniment.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "bramley-apples-peeled",
      "item": "Bramley apples peeled",
      "quantity": 600,
      "unit": "g",
      "preparation": "cored and roughly chopped"
    },
    {
      "ingredient_id": "ground-cinnamon-or-ginger",
      "item": "ground cinnamon or ginger",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "dried-berries-cherries-or-sultanas-optional",
      "item": "dried berries cherries or sultanas (optional)",
      "quantity": 2,
      "unit": "tbsp",
      "optional": true
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "demerara-sugar",
      "item": "demerara sugar",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "porridge-oats",
      "item": "porridge oats",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "cream-custard-or-vanilla-ice-cream",
      "item": "cream custard or vanilla ice cream",
      "preparation": "to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to the appliance instructions."
    },
    {
      "step": 2,
      "text": "Toss the apples with the cinnamon or ginger, caster sugar, optional dried fruit, and half of the demerara sugar. Place the mixture in an air-fryer-safe baking dish."
    },
    {
      "step": 3,
      "text": "Cook the apples until softened.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Stir the butter, flour, remaining demerara sugar, and oats together until coarse crumbs form."
    },
    {
      "step": 5,
      "text": "Scatter the crumble mixture over the apples and cook until golden brown.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Serve warm with cream, custard, or vanilla ice cream."
    }
  ],
