  "id": "peach-cobbler-8437c960",
  "name": "Peach Cobbler",
  "subtitle": "A warm, fruit-filled cobbler with a tender baked topping",
  "description": "Melted butter, sweet peaches, and a simple milk-based batter bake together into an easy American dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "peaches-with-juice",
      "item": "peaches with juice",
      "quantity": 1,
      "unit": "can",
      "preparation": "29 ounce, sliced"
    },
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Pour the melted butter into a baking dish."
    },
    {
      "step": 2,
      "text": "Combine the self-rising flour, white sugar, and salt. Stir in the milk until a smooth batter forms."
    },
    {
      "step": 3,
      "text": "Pour the batter over the butter without stirring, then distribute the peaches and their juice over the top."
    },
    {
      "step": 4,
      "text": "Bake for 35 minutes, or until lightly browned.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
