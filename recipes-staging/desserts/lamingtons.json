  "id": "lamingtons",
  "name": "Lamingtons",
  "subtitle": "Coconut-coated chocolate sponge squares",
  "description": "Bake a light sponge, chill it until firm, then coat squares in chocolate icing and unsweetened coconut.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
