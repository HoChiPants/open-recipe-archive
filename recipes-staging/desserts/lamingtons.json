  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Prepare a baking pan with the all-purpose flour as directed by the recipe setup."
    },
    {
      "step": 2,
      "text": "Whisk the all-purpose flour, baking powder, salt, and cocoa powder together in a bowl."
    },
    {
      "step": 3,
      "text": "Beat the white sugar and room-temperature unsalted butter until combined, then add the eggs one at a time and mix in the vanilla extract."
    },
    {
      "step": 4,
      "text": "Add the dry mixture and milk gradually, mixing just until a batter forms. Transfer the batter to the prepared pan."
    },
    {
      "step": 5,
      "text": "Bake until the sponge is firm and set, about 30 minutes. Cool for 5 minutes, then transfer it for chilling until firm, about 8 hours.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Combine the confectioners' sugar and cocoa powder. Stir in the warm milk and melted unsalted butter to make a coating."
    },
    {
      "step": 7,
      "text": "Cut the chilled sponge into squares. Dip each square in the coating, then roll it in the dessicated unsweetened coconut."
    },
    {
      "step": 8,
      "text": "Transfer the coated squares to a rack or tray and let the coating set before serving."
    }
  ],
