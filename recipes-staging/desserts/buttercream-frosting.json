{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "buttercream-frosting",
  "name": "Buttercream Frosting",
  "subtitle": "Smooth, vanilla-scented frosting for cakes and cupcakes",
  "description": "A rich butter-based frosting finished with vanilla and milk for a smooth, spreadable texture.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened butter until smooth and creamy."
    },
    {
      "step": 2,
      "text": "Add the salt and confectioners' sugar, then mix until incorporated."
    },
    {
      "step": 3,
      "text": "Blend in the beaten egg yolks and vanilla extract."
    },
    {
      "step": 4,
      "text": "Warm the egg-containing mixture gently, stirring constantly, until it reaches 160°F on a food thermometer."
    },
    {
      "step": 5,
      "text": "Add the remaining confectioners' sugar and milk, then blend until smooth."
    }
  ],
