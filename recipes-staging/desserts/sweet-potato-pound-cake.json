  "id": "sweet-potato-pound-cake",
  "name": "Sweet Potato Pound Cake",
  "subtitle": "A tender spiced cake with bright orange glaze",
  "description": "Mashed sweet potatoes add moisture and gentle sweetness to this warmly spiced pound cake, finished with a simple orange topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
