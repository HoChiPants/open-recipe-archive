  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare the baking pan with the all-purpose flour as needed."
    },
    {
      "step": 2,
      "text": "Beat the white sugar, softened butter, and sifted confectioners' sugar until smooth and creamy."
    },
    {
      "step": 3,
      "text": "Blend in the cooked and mashed sweet potatoes and vanilla extract, then add the large eggs and mix until incorporated."
    },
    {
      "step": 4,
      "text": "Whisk the all-purpose flour, baking powder, ground cinnamon, baking soda, ground nutmeg, and salt together. Add the dry mixture to the wet mixture and stir just until combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake at 350°F until set and a tester comes out clean.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool the cake in the pan for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Stir the confectioners' sugar, white sugar, orange juice, and grated orange zest until smooth, adding the orange juice and zest as needed for a pourable glaze. Spoon it over the cooled cake."
    }
  ],
