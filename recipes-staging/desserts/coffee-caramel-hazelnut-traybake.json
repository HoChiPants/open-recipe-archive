  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease and line the baking tin with the extra butter."
    },
    {
      "step": 2,
      "text": "Combine the hazelnuts, self-raising flour, and baking powder."
    },
    {
      "step": 3,
      "text": "Whisk the 200 g softened butter and brown sugar until combined. Whisk in the 200 g caramel, coffee, vanilla, and eggs, then incorporate the dry mixture."
    },
    {
      "step": 4,
      "text": "Spread the batter in the prepared tin and bake for 35 minutes, or until the center is firm and fully set.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Cool the traybake completely in the tin."
    },
    {
      "step": 6,
      "text": "Whisk the 75 g softened butter, icing sugar, 200 g caramel, and coffee until smooth."
    },
    {
      "step": 7,
      "text": "Chill the frosting until firm, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Transfer the frosting to the cooled bake and spread it evenly. Cut into rectangles or small squares."
    },
    {
      "step": 9,
      "text": "Prepare for serving as desired."
    }
  ],
