  "id": "coffee-caramel-hazelnut-traybake",
  "name": "Coffee Caramel Hazelnut Traybake",
  "subtitle": "A nutty coffee bake with caramel frosting",
  "description": "A soft hazelnut traybake layered with coffee-caramel frosting and cut into bars or small squares.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "rectangles or 32 small squares"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 35
  },
  "ingredients": [
