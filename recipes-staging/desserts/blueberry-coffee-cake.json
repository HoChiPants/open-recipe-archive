  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Coat a baking pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Combine the packed brown sugar, 0.66666668653488 cup all-purpose flour, and cinnamon. Cut in 0.5 cup softened butter until crumbly; set aside."
    },
    {
      "step": 3,
      "text": "Whisk 2 cups all-purpose flour with the baking powder and salt."
    },
    {
      "step": 4,
      "text": "Whisk the remaining 0.5 cup softened butter with the white sugar until smooth. Add the egg and vanilla extract and mix well."
    },
    {
      "step": 5,
      "text": "Add the dry ingredients and milk alternately, mixing just until combined."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and scatter the fresh blueberries over it. Sprinkle with the crumb mixture."
    },
    {
      "step": 7,
      "text": "Bake for 60 minutes, or until golden brown and the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Cool for 30 minutes so the cake can set, then dust with the confectioners' sugar for dusting and serve.",
      "timer_minutes": 30
    }
  ],
