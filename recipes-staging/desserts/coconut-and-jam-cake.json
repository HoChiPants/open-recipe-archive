  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "coconut-and-jam-cake",
  "name": "Coconut and Jam Cake",
  "subtitle": "A tender coconut cake finished with strawberry jam",
  "description": "A simple baked coconut cake with a sweet strawberry-jam topping and a final sprinkle of coconut.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 12,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "margarine-butter",
      "item": "margarine/butter",
      "quantity": 4,
      "unit": "oz"
    },
    {
      "ingredient_id": "sugar-white",
      "item": "sugar (white)",
      "quantity": 4,
      "unit": "oz"
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 4,
      "unit": "oz"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "desiccated-coconut",
      "item": "desiccated coconut",
      "quantity": 80,
      "unit": "g"
    },
    {
      "ingredient_id": "heaped-tbsp-strawberry-jam",
      "item": "heaped tbsp strawberry jam",
      "quantity": 2
    },
    {
      "ingredient_id": "desiccated-coconut",
      "item": "desiccated coconut",
      "quantity": 40,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Beat the margarine or butter with the sugar until smooth and creamy. Beat in the eggs and vanilla extract."
    },
    {
      "step": 2,
      "text": "Fold in the self-raising flour and 80 g desiccated coconut to make a thick batter. Spread it evenly in a prepared cake pan."
    },
    {
      "step": 3,
      "text": "Bake until risen, lightly golden, and firm in the center, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Cool the cake in the pan for 15 minutes, then spread with the strawberry jam and sprinkle with the remaining desiccated coconut.",
      "timer_minutes": 15
    }
  ],
