  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Combine the flour, baking powder, baking soda, and salt; set aside."
    },
    {
      "step": 2,
      "text": "Whisk 1 cup butter, the shortening, 2 cups brown sugar, and 1 cup white sugar until blended."
    },
    {
      "step": 3,
      "text": "Blend in the mashed bananas and eggs, then whisk in 2 teaspoons vanilla."
    },
    {
      "step": 4,
      "text": "Add the flour mixture and milk in alternating additions, mixing until combined. Fold in the pecans."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared baking pan and bake for 60 minutes, until set.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "For the glaze, preheat as needed and combine 1/2 cup butter, 1/4 cup brown sugar, 1/4 cup white sugar, 1 teaspoon vanilla, and the heavy cream. Stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 7,
      "text": "Transfer the glaze over the cake and cool for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
