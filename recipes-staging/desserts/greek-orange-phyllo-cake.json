  "instructions": [
    {
      "step": 1,
      "text": "Combine 2 cups white sugar, water, and ground cinnamon in a saucepan. Add the halved orange, bring to a simmer, and cook for 8 minutes. Set the syrup aside to cool.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 3,
      "text": "Separate the phyllo dough sheets and let them dry briefly, then cut or tear them into small pieces."
    },
    {
      "step": 4,
      "text": "Prepare the oranges by removing their zest and juice as needed for the batter."
    },
    {
      "step": 5,
      "text": "Whisk the remaining white sugar, orange zest and juice, eggs, Greek yogurt, olive oil, and baking powder until smooth."
    },
    {
      "step": 6,
      "text": "Fold the cut phyllo into the batter until evenly coated, then transfer the mixture to a prepared baking dish."
    },
    {
      "step": 7,
      "text": "Bake until deeply golden and set, about 45–60 minutes; the center should be firm and reach 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Pour the cooled syrup evenly over the hot cake and let it stand until absorbed and set.",
      "timer_minutes": 60
    },
    {
      "step": 9,
      "text": "Cut into portions and serve."
    }
  ],
