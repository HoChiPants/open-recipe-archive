  "id": "bananas-in-caramel-sauce",
  "name": "Bananas in Caramel Sauce",
  "subtitle": "Warm bananas with a buttery cream caramel",
  "description": "Tender bananas served with a smooth caramel sauce made from butter, sugar, and cream.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
