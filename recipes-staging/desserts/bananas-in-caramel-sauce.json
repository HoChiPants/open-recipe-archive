  "instructions": [
    {
      "step": 1,
      "text": "Warm the butter and heavy cream together in a skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Stir in the superfine sugar until melted, then whisk until the sauce is smooth."
    },
    {
      "step": 3,
      "text": "Continue heating the sauce for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the bananas and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Serve the bananas with the caramel sauce."
    }
