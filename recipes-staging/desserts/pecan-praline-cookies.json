  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Arrange the graham crackers in a single layer on a baking sheet."
    },
    {
      "step": 3,
      "text": "Combine the brown sugar, butter, and cream of tartar until evenly mixed. Add the chopped pecans."
    },
    {
      "step": 4,
      "text": "Spread the pecan mixture over the graham crackers."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Cool on the baking sheet for 3 minutes, then transfer and separate into servings.",
      "timer_minutes": 3
    }
  ],
