  "id": "pecan-praline-cookies",
  "name": "Pecan Praline Cookies",
  "subtitle": "Crisp crackers with a buttery pecan topping",
  "description": "A simple baked dessert made by coating graham crackers with brown sugar, butter, cream of tartar, and chopped pecans.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 35,
    "unit": "servings"
  },
