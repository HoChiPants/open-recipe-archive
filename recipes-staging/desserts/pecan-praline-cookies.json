    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "graham-crackers",
      "item": "graham crackers",
      "quantity": 35
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
