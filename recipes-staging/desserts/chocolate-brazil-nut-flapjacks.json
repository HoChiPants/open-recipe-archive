      "item": "brazil nuts roughly chopped",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "cocktail-cherries-roughly-chopped-optional",
      "item": "cocktail cherries roughly chopped (optional)",
      "quantity": 75,
      "unit": "g",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease a baking tin with a little extra butter."
    },
    {
      "step": 2,
      "text": "Warm the butter, golden syrup, and brown sugar together until the sugar is dissolved. Stir in the melted chocolate."
    },
    {
      "step": 3,
      "text": "Mix in the cocoa powder, oats, chopped Brazil nuts, and optional cherries until evenly coated."
    },
    {
      "step": 4,
      "text": "Press the mixture firmly into the prepared tin and bake for 25 minutes, until set.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Cool in the tin, then cut into 12 portions."
    }
  ],
