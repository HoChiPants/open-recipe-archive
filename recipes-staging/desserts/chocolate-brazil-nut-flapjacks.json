      "item": "light brown soft sugar",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-chocolate-melted",
      "item": "dark chocolate melted",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 30,
      "unit": "g"
    },
    {
      "ingredient_id": "porridge-oats",
      "item": "porridge oats",
      "quantity": 300,
      "unit": "g"
    },
    {
