  "id": "chocolate-brazil-nut-flapjacks",
  "name": "Chocolate Brazil Nut Flapjacks",
  "subtitle": "Chewy oat bars with dark chocolate and crunchy nuts",
  "description": "A simple baked oat bar combining golden syrup, dark chocolate, cocoa, Brazil nuts, and optional cherries.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "salted-butter-plus-extra-for-the-tin",
      "item": "salted butter plus extra for the tin",
      "quantity": 150,
      "unit": "g"
    },
    {
