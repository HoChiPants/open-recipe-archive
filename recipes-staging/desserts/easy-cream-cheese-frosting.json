  "id": "easy-cream-cheese-frosting",
  "name": "Easy Cream Cheese Frosting",
  "subtitle": "A smooth, tangy topping for cakes and cupcakes",
  "description": "Whisk softened cream cheese, butter, vanilla, and confectioners' sugar into a smooth frosting.",
  "meal_type": "dessert",
