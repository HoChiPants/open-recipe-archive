  "id": "apple-pie",
  "name": "Apple Pie",
  "subtitle": "Spiced apples baked in a double crust",
  "description": "A classic American pie filled with cinnamon-spiced apples, lemon, and nutmeg beneath a milk-brushed pastry crust.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
