  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Stir together the white sugar, flour, cinnamon, nutmeg, lemon zest, and lemon juice."
    },
    {
      "step": 3,
      "text": "Fit the bottom pastry into a 9-inch pie plate. Add the sliced apples and distribute the sugar mixture over them."
    },
    {
      "step": 4,
      "text": "Add the remaining white sugar, then the lemon zest, lemon juice, and butter."
    },
    {
      "step": 5,
      "text": "Cover with the top pastry, seal the edges, and cut vents in the crust. Brush the top with milk."
    },
    {
      "step": 6,
      "text": "Bake at 425°F for 50 minutes, until the crust is browned and the filling is bubbling.",
      "timer_minutes": 50
    }
  ],
