  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the cherry pie filling, dark chocolate cake mix, eggs, and almond extract together until evenly combined."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a baking dish and bake for 40 minutes, until the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "Let the cake cool for 5 minutes, spread the prepared chocolate frosting over the top, and allow it to cool for 30 minutes before serving.",
      "timer_minutes": 35
    }
