{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-cream-custard",
  "name": "Chocolate Cream Custard",
  "subtitle": "Silky chocolate custard with whipped cream",
  "description": "A simple chocolate custard made by combining melted chocolate and cream with tempered egg yolks, then finishing it with whipped cream.",
  "meal_type": "dessert",
  "cuisine": "French Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "light-cream",
      "item": "light cream",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "4-ounce-bar-sweet-baking-chocolate",
      "item": "(4 ounce) bar sweet baking chocolate",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 2,
      "preparation": "lightly beaten"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "whipped-cream",
      "item": "whipped cream",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the light cream, chopped chocolate, and sugar in a saucepan over low heat, stirring until the chocolate is melted and the mixture is smooth."
    },
    {
      "step": 2,
      "text": "Whisk the egg yolks and vanilla in a heatproof bowl. Gradually whisk in the warm chocolate mixture to temper the yolks."
    },
    {
      "step": 3,
      "text": "Return the mixture to the saucepan and cook over low heat, stirring constantly, until thickened and it reaches 160°F."
    },
    {
      "step": 4,
      "text": "Divide the custard among four servings and top with whipped cream."
    }
  ],
