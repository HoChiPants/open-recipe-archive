  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the butter, sugar, and sour cream until smooth. Whisk in the eggs and almond extract."
    },
    {
      "step": 3,
      "text": "Combine the flour, baking powder, baking soda, and salt, then incorporate the dry mixture into the wet mixture until just combined."
    },
    {
      "step": 4,
      "text": "Transfer half of the batter to a baking pan. Spoon the cranberry sauce over it, add the remaining batter, and gently swirl the layers together."
    },
    {
      "step": 5,
      "text": "Bake for 55 minutes, or until golden brown.",
      "timer_minutes": 55
    }
  ],
