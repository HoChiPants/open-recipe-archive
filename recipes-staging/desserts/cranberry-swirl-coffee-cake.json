  "id": "cranberry-swirl-coffee-cake",
  "name": "Cranberry Swirl Coffee Cake",
  "subtitle": "Tender sour-cream cake with cranberry ribbons",
  "description": "A buttery coffee cake layered with cranberry sauce and baked until golden brown.",
  "meal_type": "dessert",
  "cuisine": "American",
