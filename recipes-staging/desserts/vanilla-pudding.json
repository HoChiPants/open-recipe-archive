  "id": "vanilla-pudding",
  "name": "Vanilla Pudding",
  "subtitle": "Smooth stovetop custard with vanilla",
  "description": "A simple vanilla pudding thickened with cornstarch and chilled until firm.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the sugar, cornstarch, and salt together in a saucepan."
    },
    {
      "step": 2,
      "text": "Gradually whisk in the milk until smooth."
    },
    {
      "step": 3,
      "text": "Cook over medium heat, whisking constantly, until the mixture thickens and begins to bubble."
    },
    {
      "step": 4,
      "text": "Remove from the heat and stir in the vanilla extract for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Transfer the pudding to serving dishes and chill until firm."
    }
  ],
