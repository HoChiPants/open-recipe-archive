  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the sweetened condensed milk and lemon juice until smooth."
    },
    {
      "step": 2,
      "text": "Fold in the drained crushed pineapple and thawed whipped topping until evenly combined."
    },
    {
      "step": 3,
      "text": "Spoon the filling into the prepared graham cracker crust and smooth the top."
    },
    {
      "step": 4,
      "text": "Refrigerate until set, about 2 hours.",
      "timer_minutes": 120
    }
