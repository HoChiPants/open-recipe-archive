  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "vidalia-onion-pie",
  "name": "Vidalia Onion Pie",
  "subtitle": "Savory onion custard in baked pastry shells",
  "description": "Sweet onions are softened in butter, folded into a seasoned sour-cream and egg filling, then baked with Parmesan until lightly browned.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "vidalia-onions",
      "item": "Vidalia onions",
      "quantity": 6,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "hot-sauce",
      "item": "hot sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "9-inch-pie-shells",
      "item": "(9 inch) pie shells",
      "quantity": 2,
      "preparation": "baked"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Cook the sliced Vidalia onions with the butter over medium heat until softened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Combine the sour cream and beaten eggs. Stir in the hot sauce, salt, and pepper, then fold in the softened onions."
    },
    {
      "step": 4,
      "text": "Divide the filling between the two baked pie shells. Mix the Parmesan with the paprika and sprinkle it over the pies."
    },
    {
      "step": 5,
      "text": "Bake at 375°F for 20 minutes, then reduce the oven temperature to 350°F and continue baking for 40 minutes, until lightly browned and the centers are fully set.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Let the pies cool for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
