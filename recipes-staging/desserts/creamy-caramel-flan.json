{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "creamy-caramel-flan",
  "name": "Creamy Caramel Flan",
  "subtitle": "A smooth baked custard with a crisp caramel topping",
  "description": "Caramelized sugar surrounds a creamy vanilla custard that chills until firm and slices cleanly.",
  "meal_type": "dessert",
  "cuisine": "Italian",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60,
    "inactive_minutes": 540
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 5,
      "unit": "large"
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "12 fluid ounce"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Place the sugar in a saucepan over medium heat and cook until melted and amber, swirling the pan as needed."
    },
    {
      "step": 2,
      "text": "Immediately pour the caramel into a round baking dish and tilt to coat the bottom. Let it set."
    },
    {
      "step": 3,
      "text": "Beat the softened cream cheese until smooth. Whisk in the eggs, then add the condensed milk, evaporated milk, and vanilla; mix until smooth."
    },
    {
      "step": 4,
      "text": "Pour the custard over the set caramel. Place the dish in a larger pan and add boiling water around it to create a water bath."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until the center is fully set or reaches 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Remove the dish from the water bath and let the flan cool for 60 minutes. Cover and refrigerate for 9 hours, then loosen the edges and invert onto a serving plate.",
      "timer_minutes": 60
    }
  ],
