  "id": "butterscotch-marshmallow-brownies",
  "name": "Butterscotch Marshmallow Brownies",
  "subtitle": "Chewy brownies with toasted marshmallows and chocolate chips",
  "description": "A simple pan of chewy brownies combining butterscotch, chocolate, brown sugar, and miniature marshmallows.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "butterscotch-chips",
      "item": "butterscotch chips",
      "quantity": 1,
      "unit": "cup"
    },
    {
