  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "In a microwave-safe bowl, combine the butterscotch chips, unsalted butter, and semisweet chocolate chips. Microwave for 2 minutes, then stir until melted and let cool until set.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir the packed brown sugar, eggs, and vanilla extract into the cooled mixture."
    },
    {
      "step": 4,
      "text": "Add the all-purpose flour, baking powder, and salt, and stir until combined. Fold in the miniature marshmallows and semisweet chocolate chips."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 20 minutes, until the center is firm and fully set.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Cool as needed for clean slicing, then cut into 24 servings."
    }
  ],
