{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pecan-pralines-695e7ca7",
  "name": "Pecan Pralines",
  "subtitle": "Tender pecan candies with a buttery finish",
  "description": "A small-batch candy made by cooking sugars and evaporated milk to the firm-ball stage, then folding in pecans, butter, and vanilla.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "pecan-halves",
      "item": "pecan halves",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Line a work surface or tray with parchment paper."
    },
    {
      "step": 2,
      "text": "Combine the brown sugar, white sugar, and evaporated milk in a saucepan. Bring the mixture to a simmer, then cook, monitoring with a candy thermometer, until it reaches 240°F."
    },
    {
      "step": 3,
      "text": "Remove from the heat and stir in the pecan halves, butter, and vanilla extract."
    },
    {
      "step": 4,
      "text": "Whisk until the mixture thickens, then drop it in 20 portions onto the parchment."
    },
    {
      "step": 5,
      "text": "Let the pralines cool for 5 minutes, then leave them undisturbed until firm. Cool completely before serving.",
      "timer_minutes": 5
    }
  ],
