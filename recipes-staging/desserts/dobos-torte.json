  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Grease the baking surfaces with the shortening."
    },
    {
      "step": 2,
      "text": "Whisk the egg whites with 1 cup of white sugar, then add the confectioners' sugar and continue whisking to soft peaks."
    },
    {
      "step": 3,
      "text": "Whisk the egg yolks with the milk, lemon zest, salt, and 1½ teaspoons vanilla extract. Fold this mixture into the whites, then fold in the sifted flour."
    },
    {
      "step": 4,
      "text": "Spread the batter into thin, even layers and bake each layer for 9 minutes, until set and the center reaches 160°F. Cool the layers before assembling.",
      "timer_minutes": 9
    },
    {
      "step": 5,
      "text": "Whisk the butter with the cocoa powder. Add the milk, 1 tablespoon vanilla extract, and remaining confectioners' sugar, whisking until smooth. Add the remaining white sugar and whisk until the filling is even."
    },
    {
      "step": 6,
      "text": "Stack the cooled layers with cocoa filling between them. Coat the top and sides with the remaining filling, then chill for 90 minutes.",
      "timer_minutes": 90
    },
    {
      "step": 7,
      "text": "Melt the remaining white sugar and confectioners' sugar until smooth. Spread the caramel over a prepared layer, cool it until firm, and place it on the cake."
    },
    {
      "step": 8,
      "text": "Chill the assembled cake until firm, then slice and serve."
    }
  ],
