  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine the cubed bread and milk; let stand for 5 minutes, until the bread softens.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the beaten egg, softened butter, raisins, dried mixed fruit, brown sugar, nutmeg, and cinnamon until evenly combined."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish and spread it into an even layer."
    },
    {
      "step": 5,
      "text": "Bake for 35 minutes, until firm and the center is fully set or reaches 160°F.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Cut into portions and serve."
    }
  ],
