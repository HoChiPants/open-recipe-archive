{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cinnamon-walnut-slice-cookies",
  "name": "Cinnamon Walnut Slice Cookies",
  "subtitle": "Tender cinnamon cookies with a walnut topping",
  "description": "A simple butter-rich cookie slab finished with cinnamon, walnuts, and a lightly glazed egg-white topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large",
      "preparation": "separated, divided"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "finely-chopped-walnuts",
      "item": "finely chopped walnuts",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Beat the softened butter and white sugar until smooth. Beat in the egg yolk."
    },
    {
      "step": 3,
      "text": "Combine the flour and cinnamon, then mix them into the butter mixture to form a dough."
    },
    {
      "step": 4,
      "text": "Transfer the dough to a baking sheet and press it into an even layer."
    },
    {
      "step": 5,
      "text": "Whisk the egg white with the water, then brush the mixture over the dough."
    },
    {
      "step": 6,
      "text": "Sprinkle the chopped walnuts evenly over the top."
    },
    {
      "step": 7,
      "text": "Bake for about 30 minutes, until the center is fully set and the egg-containing mixture reaches 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Cut into 24 pieces while warm, then cool completely."
    }
  ],
