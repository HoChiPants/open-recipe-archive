  "id": "sour-cream-cut-out-cookies",
  "name": "Sour Cream Cut-Out Cookies",
  "subtitle": "Tender rolled cookies with a lightly browned finish",
  "description": "A simple American sugar cookie made with sour cream, rolled thin, cut into shapes, and baked until lightly browned.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the butter, white sugar, and sour cream until combined. Whisk in the egg."
    },
    {
      "step": 3,
      "text": "Stir together the baking soda and salt, then mix them into the wet ingredients."
    },
    {
      "step": 4,
      "text": "Stir in the flour until a dough forms, then knead briefly until smooth."
    },
    {
      "step": 5,
      "text": "Roll out the dough, cut into shapes, and transfer the cookies to a baking sheet."
    },
    {
      "step": 6,
      "text": "Bake for 8 minutes, or until lightly browned and the centers are set.",
      "timer_minutes": 8
    },
    {
      "step": 7,
      "text": "Cool the cookies before serving."
    }
  ],
