  "id": "salmon-and-potato-pie",
  "name": "Salmon and Potato Pie",
  "subtitle": "A savory baked pie with creamy potato filling",
  "description": "Tender potatoes, salmon, onion, garlic, and thyme are enclosed in pastry and baked until golden and fully cooked.",
  "meal_type": "dessert",
  "cuisine": "French",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 65
  },
  "ingredients": [
    {
      "ingredient_id": "9-inch-unbaked-pie-crusts",
      "item": "(9 inch) unbaked pie crusts",
      "quantity": 2
    },
    {
      "ingredient_id": "potatoes",
