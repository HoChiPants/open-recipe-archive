      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "red-salmon",
      "item": "red salmon",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce, undrained"
    },
    {
      "ingredient_id": "dried-thyme",
      "item": "dried thyme",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Place one crust in a 9-inch pie dish."
    },
    {
      "step": 2,
      "text": "Cover the potatoes with salted water, bring to a simmer, and cook for about 15 minutes, until tender. Drain, cool briefly, and cut into chunks.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Warm the butter in a skillet and cook the onion and garlic until softened."
    },
    {
      "step": 4,
      "text": "Combine the potatoes, onion, garlic, salmon with its liquid, and thyme. Add milk as needed to make a moist filling, then season with salt and pepper."
    },
    {
      "step": 5,
      "text": "Spoon the filling into the crust. Cover with the second crust, trim and seal the edges, and cut vents in the top."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, until the crust is golden and the salmon filling reaches 145°F or is opaque and flakes easily when checked with a thermometer or fork.",
      "timer_minutes": 45
    }
  ],
