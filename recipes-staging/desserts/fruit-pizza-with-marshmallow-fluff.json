  "id": "fruit-pizza-with-marshmallow-fluff",
  "name": "Fruit Pizza with Marshmallow Fluff",
  "subtitle": "Soft cookie crust with a creamy marshmallow topping",
  "description": "A baked sugar-cookie base is cooled, topped with a marshmallow and cream cheese mixture, and chilled before serving.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "refrigerated-sugar-cookie-dough",
      "item": "refrigerated sugar cookie dough",
      "quantity": 1,
      "unit": "package",
      "preparation": "18 ounce"
    },
    {
      "ingredient_id": "7-ounce-jar-marshmallow-creme",
      "item": "(7 ounce) jar marshmallow creme",
      "quantity": 1
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Press the sugar cookie dough into an even layer in a baking pan."
    },
    {
      "step": 3,
      "text": "Bake until the crust is lightly browned, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Let the crust cool completely."
    },
    {
      "step": 5,
      "text": "Whisk the marshmallow creme and softened cream cheese until smooth."
    },
    {
      "step": 6,
      "text": "Transfer the mixture to the cooled crust, spread evenly, and chill before serving."
    }
  ],
