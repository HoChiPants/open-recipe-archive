  "id": "italian-sesame-cookies",
  "name": "Italian Sesame Cookies",
  "subtitle": "Anise-scented cookies with a crisp sesame coating",
  "description": "Tender butter cookies flavored with anise and finished with sesame seeds for a lightly nutty crust.",
  "meal_type": "dessert",
  "cuisine": "Italian",
  "yield": {
    "quantity": 60,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "room temperature"
    },
    {
      "ingredient_id": "anise-extract",
      "item": "anise extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "sesame-seeds",
      "item": "sesame seeds",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the butter and sugar until smooth. Add the room-temperature egg and anise extract, then whisk until combined."
    },
    {
      "step": 3,
      "text": "In a separate bowl, stir together the flour, baking powder, and salt."
    },
    {
      "step": 4,
      "text": "Gradually stir the dry mixture into the butter mixture to form a soft dough."
    },
    {
      "step": 5,
      "text": "Shape the dough into small balls. Dip or lightly coat each one with milk, then roll in the sesame seeds."
    },
    {
      "step": 6,
      "text": "Arrange the cookies on baking sheets and bake for 20 minutes, until lightly golden and the centers are fully set.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Transfer the cookies to a rack and let them cool before serving."
    }
  ],
