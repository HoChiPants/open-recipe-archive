{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "holiday-eggnog-pie",
  "name": "Holiday Eggnog Pie",
  "subtitle": "A creamy custard pie with warm eggnog flavor",
  "description": "A simple eggnog custard baked in a deep-dish crust until fully set, then cooled for clean slices.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "eggnog",
      "item": "eggnog",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted and cooled slightly"
    },
    {
      "ingredient_id": "9-inch-unbaked-deep-dish-pie-crust",
      "item": "(9 inch) unbaked deep dish pie crust",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the sugar and flour. Whisk in the eggnog, beaten eggs, and vanilla until smooth, then stir in the melted, slightly cooled butter."
    },
    {
      "step": 3,
      "text": "Pour the filling into the unbaked deep-dish pie crust."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, or until the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Cool the pie before serving."
    }
  ],
