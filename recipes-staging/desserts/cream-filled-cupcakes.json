  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F and prepare cupcake pans for 36 cupcakes."
    },
    {
      "step": 2,
      "text": "Whisk the flour, white sugar, cocoa powder, baking soda, and teaspoon of salt in a large bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the eggs, 1 cup milk, water, oil, and 1 teaspoon vanilla. Add this mixture to the dry ingredients and stir until evenly combined."
    },
    {
      "step": 4,
      "text": "Divide the batter among the prepared cups and bake until the cupcakes are set.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Cool the cupcakes completely before filling."
    },
    {
      "step": 6,
      "text": "Whisk the butter and shortening until smooth. Blend in the confectioners' sugar and pinch of salt, then whisk in the remaining milk and vanilla until smooth."
    },
    {
      "step": 7,
      "text": "Transfer the filling to a piping bag or similar tool. Make a small opening in each cooled cupcake and pipe in the filling."
    },
    {
      "step": 8,
      "text": "Cover or serve the filled cupcakes once assembled."
    }
  ],
