  "id": "microwave-chocolate-fudge",
  "name": "Microwave Chocolate Fudge",
  "subtitle": "A quick, nut-studded chocolate confection",
  "description": "Melt chocolate with sweetened condensed milk, then fold in vanilla, walnuts, and marshmallows before chilling until firm.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "miniature-marshmallows",
      "item": "miniature marshmallows",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Line a suitable pan or container for setting the fudge. Combine the chocolate chips and sweetened condensed milk in a microwave-safe bowl."
    },
    {
      "step": 2,
      "text": "Microwave for 3 minutes, stirring as needed, until the mixture is smooth.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir in the vanilla extract, chopped walnuts, and miniature marshmallows until evenly distributed."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared container and chill until firm."
    }
  ],
