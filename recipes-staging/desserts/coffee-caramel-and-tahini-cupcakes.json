  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a 12-cup cupcake tin with paper liners."
    },
    {
      "step": 2,
      "text": "Toast the cardamom seeds, then grind them finely. Whisk the flour and baking powder together, and toss in the chopped dates and ground cardamom."
    },
    {
      "step": 3,
      "text": "Beat the softened butter and brown sugar until light and smooth. Beat in one teaspoon of vanilla bean paste, then add the eggs one at a time.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Warm the milk gently, stir in the coffee granules until dissolved, and let it cool briefly."
    },
    {
      "step": 5,
      "text": "Fold the dry mixture into the butter mixture in batches, alternating with the coffee milk. Fold in the dates without overmixing."
    },
    {
      "step": 6,
      "text": "Divide the batter among the liners and bake until risen and set in the centers.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Transfer the cupcakes to a rack and cool completely before decorating.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Beat the room-temperature butter and tahini until smooth. Add the remaining vanilla bean paste and icing sugar, then whisk until fluffy.",
      "timer_minutes": 10
    },
    {
      "step": 9,
      "text": "Chill the frosting briefly if needed, then cut a small center from each cupcake. Fill or top the cakes with caramel and pipe on the tahini frosting.",
      "timer_minutes": 30
    }
  ],
