  "id": "portzelky-new-year-s-cookies",
  "name": "Portzelky (New Year's Cookies)",
  "subtitle": "Fried raisin cookies dusted with sugar",
  "description": "Yeasted cookies studded with raisins, fried until lightly browned, and finished with confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20,
    "inactive_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lukewarm-water",
      "item": "lukewarm water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "lukewarm-milk",
      "item": "lukewarm milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying",
      "quantity": 1,
      "unit": "quart"
    },
    {
      "ingredient_id": "confectioners-sugar-for-dusting",
      "item": "confectioners' sugar for dusting",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sugar, lukewarm water, yeast, and lukewarm milk. Let the yeast stand in the water for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Prepare the raisins, then stir them into the yeast mixture. Whisk in the eggs and salt."
    },
    {
      "step": 3,
      "text": "Whisk in the flour until the batter is smooth, adding the remaining flour as needed for a thick, workable consistency."
    },
    {
      "step": 4,
      "text": "Transfer the batter to a suitable container, cover, and let it stand for 60 minutes, until set.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Heat the frying oil to 375°F, checking the temperature with a thermometer."
    },
    {
      "step": 6,
      "text": "Prepare the cooking area for frying. Fry portions of the batter in batches until lightly browned and the centers are fully set."
    },
    {
      "step": 7,
      "text": "Drain the cookies, then dust them with confectioners' sugar mixed with the white sugar."
    }
  ],
