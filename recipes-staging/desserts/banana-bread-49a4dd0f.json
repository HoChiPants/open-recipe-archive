  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease the loaf tin with the extra butter."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter, caster sugar, beaten eggs, self-raising flour, and icing sugar until combined. Fold in the baking powder, mashed bananas, and dried banana chips."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared tin and bake for 50 minutes, or until cooked through.",
      "timer_minutes": 50
    },
    {
      "step": 4,
      "text": "Shape or trim the cooled loaf as needed, then leave it to cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Combine the caster sugar and icing sugar, and add the mixture to the loaf with the remaining dried banana chips for decoration."
    }
  ],
