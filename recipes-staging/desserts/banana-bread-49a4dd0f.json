  "id": "banana-bread-49a4dd0f",
  "name": "Banana Bread",
  "subtitle": "A simple loaf with ripe banana flavor",
  "description": "A tender banana loaf finished with icing sugar and dried banana chips.",
  "meal_type": "dessert",
  "cuisine": "British",
  "yield": {
    "quantity": 8,
