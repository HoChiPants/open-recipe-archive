  "id": "chocolate-fairy-cakes",
  "name": "Chocolate Fairy Cakes",
  "subtitle": "Small chocolate cakes with a smooth cocoa icing",
  "description": "Light chocolate fairy cakes topped with a simple cocoa buttercream.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
