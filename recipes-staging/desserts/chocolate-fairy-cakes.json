  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a 12-cup cake tin with paper cases."
    },
    {
      "step": 2,
      "text": "Whisk the caster sugar and unsalted butter softened until light. Beat in the eggs and vanilla paste until combined."
    },
    {
      "step": 3,
      "text": "Combine the self-raising flour, 2 tbsp cocoa powder, and baking powder, then fold into the wet mixture with 2 tbsp milk until smooth."
    },
    {
      "step": 4,
      "text": "Divide the batter among the cases and bake until risen and set.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Transfer the cakes to a rack and cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Whisk the butter, icing sugar, and 40 g cocoa powder until smooth. Add 2–3 tbsp milk gradually to make a spreadable icing, then top the cooled cakes.",
      "timer_minutes": 10
    }
  ],
