  "id": "gingerbread-biscotti",
  "name": "Gingerbread Biscotti",
  "subtitle": "Twice-baked cookies with molasses and warm spices",
  "description": "Crisp, aromatic biscotti flavored with ginger, cinnamon, cloves, and nutmeg.",
  "meal_type": "dessert",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
