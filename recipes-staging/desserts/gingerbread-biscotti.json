      "item": "ground nutmeg",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F and prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Whisk the sugar, eggs, vegetable oil, and molasses until smooth."
    },
    {
      "step": 3,
      "text": "Stir the all-purpose flour, whole wheat flour, ginger, baking powder, cinnamon, cloves, and nutmeg together. Add the dry mixture to the wet mixture and stir until a dough forms."
    },
    {
      "step": 4,
      "text": "Shape the dough into a thick log on the prepared sheet and transfer it to the oven."
    },
    {
      "step": 5,
      "text": "Bake until the log is thick and set, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Cool until set, then cut the log into thick slices and return them to the baking sheet."
    },
    {
      "step": 7,
      "text": "Bake the slices for 7 minutes, or until crisp.",
      "timer_minutes": 7
    }
  ],
