{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "brandy-or-rum-balls",
  "name": "Brandy or Rum Balls",
  "subtitle": "Chocolate-and-walnut confections rolled in sugar",
  "description": "A simple no-bake dessert made by combining melted chocolate, brandy, wafer crumbs, and walnuts, then coating the portions in confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 60,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "5 ounce"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "brandy",
      "item": "brandy",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-wafers",
      "item": "vanilla wafers",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce, crushed very fine"
    },
    {
      "ingredient_id": "finely-chopped-walnuts",
      "item": "finely chopped walnuts",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "confectioners-sugar-for-rolling",
      "item": "confectioners' sugar for rolling",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the evaporated milk and chocolate chips in a microwave-safe bowl. Microwave until simmering, then stir until smooth."
    },
    {
      "step": 2,
      "text": "Stir in the brandy, crushed vanilla wafers, and finely chopped walnuts until a firm mixture forms."
    },
    {
      "step": 3,
      "text": "Shape the mixture into small balls, making about 60 portions."
    },
    {
      "step": 4,
      "text": "Roll each ball in the confectioners' sugar until coated."
    }
  ],
