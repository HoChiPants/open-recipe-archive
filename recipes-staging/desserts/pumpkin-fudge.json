  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pumpkin-fudge",
  "name": "Pumpkin Fudge",
  "subtitle": "Creamy pumpkin fudge with warm cinnamon flavor",
  "description": "Cook a pumpkin-spiced sugar mixture to the soft-ball stage, blend in white chocolate and marshmallow creme, then chill until firm for slicing.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 25,
    "inactive_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "canned-pumpkin",
      "item": "canned pumpkin",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "white-chocolate-chips",
      "item": "white chocolate chips",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "marshmallow-creme",
      "item": "marshmallow creme",
      "quantity": 7,
      "unit": "ounces"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "room temperature"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare and coat a square baking pan. Set it aside."
    },
    {
      "step": 2,
      "text": "Combine the white sugar and evaporated milk in a saucepan. Bring the mixture to a simmer, stirring as needed."
    },
    {
      "step": 3,
      "text": "Stir in the canned pumpkin and ground cinnamon, then return the mixture to a simmer."
    },
    {
      "step": 4,
      "text": "Cook until the mixture reaches 238°F, maintaining the temperature for about 18 minutes.",
      "timer_minutes": 18
    },
    {
      "step": 5,
      "text": "Remove from the heat and let the mixture cool for 5 minutes. Add the white chocolate chips and stir for 5 minutes, until set and smooth.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Whisk in the marshmallow creme, room-temperature butter, and vanilla extract until melted and evenly combined."
    },
    {
      "step": 7,
      "text": "Transfer the fudge mixture to the prepared pan and cool until firm, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Cut into 16 pieces and transfer to a serving dish."
    }
  ],
