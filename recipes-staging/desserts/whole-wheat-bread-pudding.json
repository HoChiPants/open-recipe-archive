  "id": "whole-wheat-bread-pudding",
  "name": "Whole Wheat Bread Pudding",
  "subtitle": "A warm baked dessert with apple and raisins",
  "description": "Whole wheat bread absorbs a cinnamon-vanilla custard, with chopped apple and raisins throughout, then bakes until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "slices-day-old-whole-wheat-bread",
      "item": "slices day-old whole wheat bread",
      "quantity": 6
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "apple",
      "item": "apple",
      "quantity": 1,
      "unit": "large",
      "preparation": "peeled and chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "low-fat-milk",
      "item": "low-fat milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Coat a baking dish with the melted butter."
    },
    {
      "step": 2,
      "text": "Tear or cut the bread into pieces and arrange it in the prepared dish."
    },
    {
      "step": 3,
      "text": "Combine the raisins and chopped apple, then scatter them over the bread."
    },
    {
      "step": 4,
      "text": "Whisk the beaten eggs, milk, sugar, cinnamon, and vanilla until smooth."
    },
    {
      "step": 5,
      "text": "Pour the custard evenly over the bread mixture, pressing gently so the bread is moistened."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 45
    }
  ],
