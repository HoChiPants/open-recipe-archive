  "id": "plum-kuchen",
  "name": "Plum Kuchen",
  "subtitle": "A tender plum cake with a cinnamon crumb topping",
  "description": "A simple baked dessert layered with halved Italian plums and a sweet cinnamon topping.",
  "meal_type": "dessert",
