{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "greek-rice-pudding",
  "name": "Greek Rice Pudding",
  "subtitle": "Creamy rice pudding with vanilla and cinnamon",
  "description": "A simple stovetop pudding made with tender short-grain rice, milk, sugar, and warm cinnamon.",
  "meal_type": "dessert",
  "cuisine": "Greek",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 40,
    "inactive_minutes": 270
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "uncooked-short-grain-white-rice",
      "item": "uncooked short-grain white rice",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the water and rice in a saucepan. Bring to a simmer and cook until the rice is tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Stir in the milk and sugar."
    },
    {
      "step": 3,
      "text": "Mix the cornstarch with the milk mixture until smooth, then continue cooking until the pudding reaches a boil and thickens."
    },
    {
      "step": 4,
      "text": "Remove from the heat and stir in the vanilla extract."
    },
    {
      "step": 5,
      "text": "Divide among serving dishes and sprinkle with cinnamon."
    },
    {
      "step": 6,
      "text": "Cool, cover, and refrigerate until thoroughly chilled.",
      "timer_minutes": 270
    }
  ],
