  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare the cake pans."
    },
    {
      "step": 2,
      "text": "Beat the softened butter with the brown sugar and white sugar until smooth. Add the eggs, 2 teaspoons vanilla, baking soda, and salt; whisk until combined."
    },
    {
      "step": 3,
      "text": "Stir in the flour just until incorporated, then fold in the chocolate chips. Divide the dough between the prepared pans and shape it into even layers."
    },
    {
      "step": 4,
      "text": "Bake until the layers are set, about 20 minutes. Cool completely in the pans or on a rack before assembling.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "For the frosting, whisk the melted butter, milk, 1 teaspoon vanilla, confectioners' sugar, and cocoa powder until smooth."
    },
    {
      "step": 6,
      "text": "Place one cooled cookie layer on a serving plate, spread with frosting, and top with the second layer. Frost the top and sides, then transfer the cake for setting before slicing."
    }
  ],
