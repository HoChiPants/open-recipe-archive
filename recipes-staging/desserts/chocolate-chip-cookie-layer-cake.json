  "id": "chocolate-chip-cookie-layer-cake",
  "name": "Chocolate Chip Cookie Layer Cake",
  "subtitle": "Soft cookie layers with chocolate frosting",
  "description": "Bake chocolate chip cookie layers, cool them completely, and stack them with a smooth cocoa frosting for a celebratory dessert.",
  "meal_type": "dessert",
