  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Prepare the yellow cake mix according to its package directions, then transfer the batter to a suitable deep cake pan or oven-safe bowl."
    },
    {
      "step": 3,
      "text": "Bake until the cake is set and a tester inserted in the center comes out clean, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Cool the cake in the pan for 15 minutes, then let it cool completely for about 3 hours before decorating.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Tint a portion of the vanilla frosting with the red food coloring, then frost and decorate the cooled cake with the remaining frosting."
    },
    {
      "step": 6,
      "text": "Slice and serve."
    }
  ],
