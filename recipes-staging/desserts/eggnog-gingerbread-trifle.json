  "id": "eggnog-gingerbread-trifle",
  "name": "Eggnog Gingerbread Trifle",
  "subtitle": "Layered gingerbread, eggnog pudding, and cranberry cream",
  "description": "Bake a gingerbread cake, layer it with eggnog pudding and vanilla-sweetened whipped cream, then finish with cranberries and cookie crumbs.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25,
    "inactive_minutes": 420
  },
  "ingredients": [
    {
