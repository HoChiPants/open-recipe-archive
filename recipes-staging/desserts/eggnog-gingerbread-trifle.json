  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare the gingerbread cake mix with the water and egg according to the package directions, then spread the batter in a baking pan."
    },
    {
      "step": 2,
      "text": "Bake until the cake is set and the center reaches 160°F, about 25 minutes. Cool completely, about 60 minutes, then cut or crumble into pieces.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Whisk the instant vanilla pudding mix with the eggnog for 2 minutes. Chill until thickened.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Beat the heavy cream with the white sugar and vanilla extract until stiff peaks form."
    },
    {
      "step": 5,
      "text": "Layer cake pieces, eggnog pudding, and whipped cream in a trifle dish; repeat the layers as needed."
    },
    {
      "step": 6,
      "text": "Cover and chill for at least 6 hours.",
      "timer_minutes": 360
    },
    {
      "step": 7,
      "text": "Top with the chopped dried cranberries and gingersnap cookie crumbs before serving."
    }
  ],
