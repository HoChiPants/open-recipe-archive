    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Combine the peaches, 2 tablespoons melted butter, a pinch each of cinnamon and nutmeg, and cook until warmed and the butter is fully melted."
    },
    {
      "step": 2,
      "text": "Stir the cornstarch and water together until smooth. Add the mixture to the peaches and cook, stirring, until the fruit mixture is set and thickened."
    },
    {
      "step": 3,
      "text": "Whisk the milk, sugar, flour, baking powder, and salt until smooth."
    },
    {
      "step": 4,
      "text": "Melt the remaining butter in a baking dish. Pour the batter over the melted butter, then distribute the peach mixture over the top. Sprinkle with the remaining cinnamon and nutmeg."
    },
    {
      "step": 5,
      "text": "Bake until the cobbler is golden and the center is set.",
      "timer_minutes": 60
    }
  ],
