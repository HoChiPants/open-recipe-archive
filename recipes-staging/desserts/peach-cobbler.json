  "id": "peach-cobbler",
  "name": "Peach Cobbler",
  "subtitle": "Tender fruit beneath a golden baked topping",
  "description": "Canned peaches are gently thickened with warm spices, layered with a simple batter, and baked until golden and set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
