  "id": "carrot-cake-bars",
  "name": "Carrot Cake Bars",
  "subtitle": "Tender, cinnamon-scented bars with a soft carrot crumb",
  "description": "A simple American dessert made with carrot purée, warm spices, and a lightly sweet cake batter, baked into easy-to-serve bars.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "4-ounce-jars-carrot-baby-food",
      "item": "(4 ounce) jars carrot baby food",
      "quantity": 3
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking pan for the batter."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking soda, cinnamon, and salt together in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the sugar, oil, and eggs until smooth. Stir in the carrot baby food."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the wet mixture and stir just until combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and spread it evenly."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, until the center is firm and fully set; an instant-read thermometer should register at least 160°F.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Cool before cutting into bars."
    }
  ],
