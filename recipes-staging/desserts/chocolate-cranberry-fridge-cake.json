    },
    {
      "ingredient_id": "fresh-bay-leaves",
      "item": "fresh bay leaves (optional)",
      "quantity": 2,
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly coat a pudding basin with the sunflower oil. Line it if needed for easier release."
    },
    {
      "step": 2,
      "text": "Melt the dark chocolate, butter, and golden syrup together over low heat, stirring until smooth. If using, melt the white chocolate separately or add it to the mixture as it softens."
    },
    {
      "step": 3,
      "text": "Break the biscuits into bite-size pieces and stir them into the melted chocolate mixture with the dried cranberries, glacé cherries, and sea salt flakes."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared basin and press it down firmly. Add the optional bay leaves as a garnish if desired."
    },
    {
      "step": 5,
      "text": "Chill until firm and set, about 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 6,
      "text": "Unmold, slice, and serve chilled."
    }
  ],
