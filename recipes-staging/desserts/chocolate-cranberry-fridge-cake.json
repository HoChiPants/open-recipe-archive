  "id": "chocolate-cranberry-fridge-cake",
  "name": "Chocolate Cranberry Fridge Cake",
  "subtitle": "A chilled chocolate dessert with festive fruit and spiced biscuits",
  "description": "A sliceable no-bake cake made with melted chocolate, buttery syrup, crisp spiced biscuits, dried cranberries, and glacé cherries.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
