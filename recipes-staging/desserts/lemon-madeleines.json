  "id": "lemon-madeleines",
  "name": "Lemon Madeleines",
  "subtitle": "Tender French cakes with bright lemon flavor",
  "description": "Small shell-shaped French cakes made with lemon zest and juice, chilled briefly for a defined texture, then dusted with confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "French",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 5,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 0.5,
      "preparation": "juiced and zested"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "confectioners-sugar-for-dusting",
      "item": "confectioners' sugar for dusting",
      "quantity": 0.33333334326744,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs and white sugar until blended. Stir in the melted butter, flour, baking powder, lemon, and vanilla extract to form a smooth batter."
    },
    {
      "step": 2,
      "text": "Cover the batter and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Heat the oven to 375°F. Prepare a madeleine pan with melted butter and flour."
    },
    {
      "step": 4,
      "text": "Fill the pan wells with the chilled batter, leaving room for the cakes to rise."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, until the madeleines are set and lightly golden at the edges.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Cool briefly, then remove the madeleines from the pan and dust with the confectioners' sugar."
    }
  ],
