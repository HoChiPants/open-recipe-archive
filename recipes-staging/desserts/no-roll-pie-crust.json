  "id": "no-roll-pie-crust",
  "name": "No-Roll Pie Crust",
  "subtitle": "A simple press-in crust for homemade pies",
  "description": "Mix this tender oil-based dough directly in the pie plate, press it into shape, and bake until lightly golden.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 8
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "In a pie plate, combine the flour, sugar, and salt."
    },
    {
      "step": 3,
      "text": "Add the oil and milk, then stir until a cohesive dough forms."
    },
    {
      "step": 4,
      "text": "Press the dough evenly over the bottom and up the sides of the pie plate."
    },
    {
      "step": 5,
      "text": "Bake until golden brown, about 10 minutes.",
      "timer_minutes": 10
    }
  ],
