  "id": "cashew-butter-cookies",
  "name": "Cashew Butter Cookies",
  "subtitle": "Tender cookies with toasted cashew flavor",
  "description": "Soft, lightly crisp cookies made with cashew butter, brown sugar, and vanilla.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cashew-butter",
      "item": "cashew butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "firmly-packed-brown-sugar",
      "item": "firmly packed brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking soda, and salt in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the softened butter, white sugar, vanilla, cashew butter, and brown sugar until smooth."
    },
    {
      "step": 4,
      "text": "Whisk in the egg and milk until fully incorporated."
    },
    {
      "step": 5,
      "text": "Add the dry ingredients to the butter mixture and stir until a cohesive dough forms."
    },
    {
      "step": 6,
      "text": "Shape the dough into 24 portions and arrange them on baking sheets."
    },
    {
      "step": 7,
      "text": "Bake until golden brown and the centers are fully set.",
      "timer_minutes": 14
    }
  ],
