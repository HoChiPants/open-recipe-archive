  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and butter the tin. Melt the chopped dark chocolate gently in the microwave, stirring until smooth and just warm."
    },
    {
      "step": 2,
      "text": "Beat the softened butter with 50 g caster sugar and the light brown sugar. Mix in the eggs and yolks, then fold in the flour, cocoa powder, baking powder, milk, and Greek yogurt. Stir in the melted chocolate."
    },
    {
      "step": 3,
      "text": "Spread the brownie batter in the prepared tin and set aside while preparing the meringue."
    },
    {
      "step": 4,
      "text": "Whisk the egg whites until foamy. Gradually add 100 g caster sugar, then whisk in the cornflour until stiff, glossy peaks form."
    },
    {
      "step": 5,
      "text": "Spread or pipe the meringue over the brownie batter. Bake for 45 minutes, then continue cooking for 30 minutes, until the meringue is crisp and the brownie center is fully set; verify the egg-containing center reaches 160°F.",
      "timer_minutes": 75
    },
    {
      "step": 6,
      "text": "Cool the cake completely, then cut the berries as needed."
    },
    {
      "step": 7,
      "text": "Whip the double cream with the icing sugar to soft peaks. Spread it over the cooled cake, arrange the berries on top, and finish with optional chocolate shavings."
    }
  ],
