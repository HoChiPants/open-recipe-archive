  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Mix the flour, 0.5 teaspoon salt, and white sugar. Cut in the chilled butter until coarse crumbs form, then add the ice water and mix just until a dough forms."
    },
    {
      "step": 3,
      "text": "Shape the dough into a disk, roll it out on a lightly floured surface, and fit it into a pie pan. Trim or crimp the edge as needed."
    },
    {
      "step": 4,
      "text": "Whisk the beaten eggs with both syrups, brown sugar, melted butter, and the pinch of salt. Stir in the finely crushed and quartered pecans."
    },
    {
      "step": 5,
      "text": "Pour the filling into the crust and arrange the pecan halves over the top."
    },
    {
      "step": 6,
      "text": "Bake at 350°F until the filling is firm and reaches 160°F in the center.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Cool completely before cutting and serving.",
      "timer_minutes": 30
    }
  ],
