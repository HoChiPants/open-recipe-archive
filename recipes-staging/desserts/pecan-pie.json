  "id": "pecan-pie",
  "name": "Pecan Pie",
  "subtitle": "A classic nut-filled pie with a crisp pastry crust",
  "description": "Prepare a chilled butter pastry, fill it with a sweet pecan custard, and bake until firm. Cool before slicing.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
