  "id": "bananas-foster-e7e629a7",
  "name": "Bananas Foster",
  "subtitle": "Warm caramelized bananas with rum and vanilla ice cream",
  "description": "Sauté bananas in a buttery brown-sugar sauce, finish with rum and banana liqueur, and serve over vanilla ice cream.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "banana",
      "item": "bananas",
      "quantity": 2,
      "preparation": "peeled and halved lengthwise and crosswise"
    },
    {
      "ingredient_id": "fluid-ounces-rum",
      "item": "fluid ounces rum",
      "quantity": 2
    },
    {
      "ingredient_id": "fluid-ounce-banana-liqueur",
      "item": "fluid ounce banana liqueur",
      "quantity": 1
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 2,
      "unit": "pinches"
    },
    {
      "ingredient_id": "scoops-vanilla-ice-cream",
      "item": "scoops vanilla ice cream",
      "quantity": 2
    },
    {
      "ingredient_id": "sprigs-of-mint",
      "item": "sprigs of mint",
      "quantity": 2,
      "unit": "small"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the unsalted butter and packed brown sugar in a skillet over medium heat until smooth and bubbling, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Arrange the bananas in the skillet and cook until warmed and lightly caramelized, turning carefully as needed."
    },
    {
      "step": 3,
      "text": "Remove the skillet from the heat. Add the rum and banana liqueur, then return it to low heat. Ignite the alcohol with a long lighter if flambéing; keep the pan away from your face and let the flame go out completely."
    },
    {
      "step": 4,
      "text": "Stir in the ground cinnamon and cook until the sauce is glossy and the bananas are tender, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Divide the vanilla ice cream between serving dishes, spoon the hot bananas and sauce over it, and garnish with the sprigs of mint."
    }
  ],
