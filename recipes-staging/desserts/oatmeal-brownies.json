  "id": "oatmeal-brownies",
  "name": "Oatmeal Brownies",
  "subtitle": "Chewy oat bars with chocolate, raisins, and walnuts",
  "description": "A chewy, lightly crisp-edged dessert bar combining oats, chocolate chips, raisins, and walnuts in a brown-sugar batter.",
  "meal_type": "dessert",
  "cuisine": "American",
