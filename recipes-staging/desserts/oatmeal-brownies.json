  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking soda, baking powder, and salt together."
    },
    {
      "step": 3,
      "text": "Beat the room-temperature butter with both sugars until combined. Whisk in the eggs, one at a time, then stir in the vanilla."
    },
    {
      "step": 4,
      "text": "Fold in the oats, flour mixture, chocolate chips, raisins, and chopped walnuts until evenly distributed."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a prepared baking pan and spread it into an even layer."
    },
    {
      "step": 6,
      "text": "Bake at 350°F until golden brown, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Cool for 5 minutes before cutting into 12 servings.",
      "timer_minutes": 5
    }
  ],
