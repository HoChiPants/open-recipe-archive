  "id": "apple-crisp-with-pie-filling",
  "name": "Apple Crisp with Pie Filling",
  "subtitle": "A quick baked dessert with spiced apples and crumbly topping",
  "description": "Canned apple filling is warmed with cinnamon and nutmeg, then covered with a buttery brown-sugar flour topping and baked until golden.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "apple-pie-filling",
      "item": "apple pie filling",
      "quantity": 1,
      "unit": "can",
      "preparation": "21 ounce"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Spread the apple pie filling in a baking dish and sprinkle it with the cinnamon and nutmeg."
    },
    {
      "step": 3,
      "text": "Whisk the margarine and brown sugar together. Cut in the flour until the mixture forms a crumbly topping."
    },
    {
      "step": 4,
      "text": "Scatter the topping over the filling and bake for 20 minutes, until the topping is lightly browned and the filling is hot.",
      "timer_minutes": 20
    }
  ],
