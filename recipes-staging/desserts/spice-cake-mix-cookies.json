  "id": "spice-cake-mix-cookies",
  "name": "Spice Cake Mix Cookies",
  "subtitle": "Soft cookies with raisins and walnuts",
  "description": "A quick batch of warmly spiced cookies made with cake mix, raisins, and chopped walnuts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
