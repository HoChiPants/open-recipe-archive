    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "spice-cake-mix",
      "item": "spice cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Combine the cake mix, beaten eggs, and vegetable oil until a thick dough forms."
    },
    {
      "step": 3,
      "text": "Fold in the raisins and chopped walnuts."
    },
    {
      "step": 4,
      "text": "Portion the dough onto the prepared baking sheet, leaving space between portions."
    },
    {
      "step": 5,
      "text": "Bake for 12 minutes, until the cookies are set.",
      "timer_minutes": 12
    }
  ],
