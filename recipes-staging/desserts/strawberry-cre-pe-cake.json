  "id": "strawberry-cre-pe-cake",
  "name": "Strawberry Crêpe Cake",
  "subtitle": "Layered crêpes with strawberry jam and mascarpone cream",
  "description": "Tender crêpes are layered with warm strawberry jam and lightly sweetened mascarpone cream, then chilled until sliceable.",
  "meal_type": "dessert",
