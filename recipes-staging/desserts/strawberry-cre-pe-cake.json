  "instructions": [
    {
      "step": 1,
      "text": "Blend the milk, flour, eggs, oil, 2 tablespoons sugar, 1/2 teaspoon vanilla, and salt until smooth. Chill the batter for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Warm the strawberry jam with the water until spreadable; keep it ready for assembly."
    },
    {
      "step": 3,
      "text": "Preheat a nonstick skillet over medium heat. Melt enough butter to coat the surface."
    },
    {
      "step": 4,
      "text": "Pour in a thin layer of batter, swirl to cover the pan, and cook until the crêpe is set and lightly browned, about 1 minute. Transfer to a plate and repeat, buttering the pan as needed.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Let the crêpes cool for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Whisk the heavy cream, mascarpone, 3 tablespoons sugar, and remaining vanilla until stiff peaks form."
    },
    {
      "step": 7,
      "text": "Stack the crêpes, spreading a thin layer of jam and mascarpone cream between each one. Finish with the remaining cream."
    },
    {
      "step": 8,
      "text": "Chill the assembled cake until firm, then slice and serve."
    }
  ],
