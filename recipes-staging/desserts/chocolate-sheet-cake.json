  "id": "chocolate-sheet-cake",
  "name": "Chocolate Sheet Cake",
  "subtitle": "A soft chocolate cake with two simple finishes",
  "description": "Bake a tender chocolate sheet cake, cool it, then finish it with a smooth cheese frosting and chocolate topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "eggs-whites-and-yolks-separated",
      "item": "eggs whites and yolks separated",
      "quantity": 6
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 6,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 6,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "sunflower-oil",
      "item": "sunflower oil",
      "quantity": 6,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "soft-cheese",
      "item": "soft cheese",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar-or-more-to-taste",
      "item": "icing sugar or more to taste",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-chocolate",
      "item": "dark chocolate",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 100,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a sheet cake pan."
    },
    {
      "step": 2,
      "text": "Whisk the egg yolks with the icing sugar until light. Mix in the flour, baking powder, cocoa powder, and sunflower oil."
    },
    {
      "step": 3,
      "text": "Beat the egg whites until they form stiff peaks, then fold them gently into the batter."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared pan and bake until risen and set, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cool the cake completely before decorating."
    },
    {
      "step": 6,
      "text": "Whisk the softened butter, soft cheese, and icing sugar or more to taste until smooth. Spread over the cooled cake."
    },
    {
      "step": 7,
      "text": "Melt the dark chocolate with the butter until boiling, then whisk in the icing sugar. Spread or drizzle over the frosted cake."
    },
    {
      "step": 8,
      "text": "Let the topping set before slicing.",
      "timer_minutes": 120
    }
  ],
