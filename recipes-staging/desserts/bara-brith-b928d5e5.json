  "id": "bara-brith-b928d5e5",
  "name": "Bara brith",
  "subtitle": "Tea-soaked fruit loaf with warm spice",
  "description": "A moist British fruit bread made with black tea, citrus zest, muscovado sugar, and mixed spice.",
  "meal_type": "dessert",
  "cuisine": "British",
  "yield": {
    "quantity": 10,
    "unit": "slices"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 85
  },
  "ingredients": [
    {
      "ingredient_id": "mixed-dried-fruit",
      "item": "mixed dried fruit",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "light-muscovado-sugar",
      "item": "light muscovado sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "orange-zested",
      "item": "orange zested",
      "quantity": 1
    },
    {
      "ingredient_id": "hot-black-tea",
      "item": "hot black tea",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 350,
      "unit": "g"
    },
    {
      "ingredient_id": "mixed-spice",
      "item": "mixed spice",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg-beaten",
      "item": "egg beaten",
      "quantity": 1
    },
    {
      "ingredient_id": "butter-plus-extra-for-the-tin-and-to-serve-optional",
      "item": "butter plus extra for the tin and to serve (optional)",
      "quantity": 50,
      "unit": "g",
      "preparation": "softened",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the dried fruit, sugar, and orange zest in a bowl. Stir in the hot tea and mix well."
    },
    {
      "step": 2,
      "text": "Preheat the oven and grease a loaf tin with some of the softened butter."
    },
    {
      "step": 3,
      "text": "Whisk together the flour and mixed spice, then add the tea-soaked fruit mixture, beaten egg, and softened butter."
    },
    {
      "step": 4,
      "text": "Whisk until the batter is evenly combined, then transfer it to the prepared tin."
    },
    {
      "step": 5,
      "text": "Bake for 85 minutes, until the loaf is firm and fully set in the center; verify with a food thermometer that the egg-containing center reaches 160°F.",
      "timer_minutes": 85
    },
    {
      "step": 6,
      "text": "Cool in the tin for 10 minutes, then remove and cool enough to slice.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Serve sliced, with additional butter if desired."
    }
  ],
