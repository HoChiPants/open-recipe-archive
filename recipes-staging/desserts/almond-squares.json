  "schema_version": "1.0.0",
  "id": "almond-squares",
  "name": "Almond Squares",
  "subtitle": "Buttery almond bars with a lightly browned top",
  "description": "A simple pan-baked almond dessert cut into twelve squares.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "almond-paste",
      "item": "almond paste",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "almonds",
      "item": "almonds",
      "quantity": 2.5,
      "unit": "ounces",
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the butter, white sugar, egg, almond paste, and almond extract until combined. Stir in the flour just until a dough forms."
    },
    {
      "step": 3,
      "text": "Transfer the dough to the prepared pan and spread it evenly. Scatter the sliced almonds over the top."
    },
    {
      "step": 4,
      "text": "Bake until lightly browned and the center is firm and fully set, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Cool, then cut into 12 squares."
    }
  ],
