  "id": "blueberry-cream-cheese-pound-cake",
  "name": "Blueberry Cream Cheese Pound Cake",
  "subtitle": "A tender cake with blueberries and vanilla cream cheese flavor",
  "description": "A simple blueberry pound cake made with yellow cake mix, cream cheese, and fresh blueberries.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 45,
    "inactive_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "yellow-cake-mix",
      "item": "yellow cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, room temperature"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "blueberries",
      "item": "blueberries",
      "quantity": 1.25,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Prepare a suitable cake pan for baking."
    },
    {
      "step": 2,
      "text": "Combine the yellow cake mix and sugar in a bowl."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, room-temperature cream cheese, and vanilla until smooth. Add the oil and whisk until incorporated."
    },
    {
      "step": 4,
      "text": "Add the wet mixture to the dry ingredients and whisk for 4 minutes, until evenly blended.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Gently stir in the blueberries, then transfer the batter to the prepared pan."
    },
    {
      "step": 6,
      "text": "Bake at 325°F for 45 minutes, until the cake is set and a tester inserted in the center comes out clean.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Cool in the pan for 10 minutes, then let the cake cool completely before serving.",
      "timer_minutes": 10
    }
  ],
