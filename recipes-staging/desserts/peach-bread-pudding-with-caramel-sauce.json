      "item": "rum",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Prepare a baking dish and set it aside."
    },
    {
      "step": 2,
      "text": "Cut the peaches into bite-size pieces. Combine them with the light corn syrup."
    },
    {
      "step": 3,
      "text": "Whisk the condensed milk and eggs together. Stir in the hot water, melted butter, cinnamon, and vanilla until combined."
    },
    {
      "step": 4,
      "text": "Fold in the bread pieces and peaches. Transfer the mixture to the prepared baking dish."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "While the pudding bakes, combine the remaining butter, brown sugar, and light corn syrup in a saucepan. Cook over medium heat for about 4 minutes, stirring, until thickened; stir in the rum.",
      "timer_minutes": 4
    },
    {
      "step": 7,
      "text": "Let the pudding cool for 10 minutes, then serve with the caramel sauce. Cool any remaining sauce before storing.",
      "timer_minutes": 10
    }
  ],
