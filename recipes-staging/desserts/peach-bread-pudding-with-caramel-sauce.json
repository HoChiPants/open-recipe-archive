  "id": "peach-bread-pudding-with-caramel-sauce",
  "name": "Peach Bread Pudding with Caramel Sauce",
  "subtitle": "Soft peach bread pudding with a warm buttery topping",
  "description": "A custardy bread pudding combining peaches, cinnamon, and vanilla, served with a quick brown-sugar caramel sauce.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 70,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-peaches",
      "item": "fresh peaches",
      "quantity": 2,
      "unit": "cups",
      "preparation": "peeled, pitted and halved"
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "preparation": "lightly beaten"
    },
    {
      "ingredient_id": "hot-water",
      "item": "hot water",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "french-bread",
      "item": "French bread",
      "quantity": 4,
      "unit": "cups",
      "preparation": "torn into small pieces"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "light-corn-syrup",
      "item": "light corn syrup",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
