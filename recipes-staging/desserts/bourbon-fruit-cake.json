  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 275°F. Prepare a tube or Bundt pan for baking."
    },
    {
      "step": 2,
      "text": "Combine the golden raisins and halved candied cherries with 2 cups bourbon. Cover and soak for 48 hours.",
      "timer_minutes": 2880
    },
    {
      "step": 3,
      "text": "Drain the soaked fruit, reserving the bourbon as directed for finishing."
    },
    {
      "step": 4,
      "text": "Whisk together the flour, nutmeg, and baking powder."
    },
    {
      "step": 5,
      "text": "Beat the butter with the white sugar and brown sugar until light. Beat in the egg yolks, then incorporate the flour mixture and 1 cup bourbon."
    },
    {
      "step": 6,
      "text": "Fold in the drained fruit and chopped pecans."
    },
    {
      "step": 7,
      "text": "Beat the egg whites with the white sugar until set, then fold them gently into the batter."
    },
    {
      "step": 8,
      "text": "Transfer the batter to the prepared pan and bake at 275°F until deeply browned and the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 300
    },
    {
      "step": 9,
      "text": "Let the cake stand for 5 hours, then cool it in the pan for 15 minutes before turning it out.",
      "timer_minutes": 315
    },
    {
      "step": 10,
      "text": "Cool completely, brush or moisten the cake with bourbon, cover, and chill until ready to serve."
    },
    {
      "step": 11,
      "text": "Transfer the chilled cake to a serving plate."
    }
  ],
