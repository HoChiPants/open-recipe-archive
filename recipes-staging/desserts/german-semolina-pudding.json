  "id": "german-semolina-pudding",
  "name": "German Semolina Pudding",
  "subtitle": "A warm, gently thickened milk pudding",
  "description": "A simple dessert made by simmering semolina with sweetened milk until creamy and thick.",
  "meal_type": "dessert",
  "yield": {
