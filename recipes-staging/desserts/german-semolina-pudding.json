  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the milk and sugar in a saucepan and warm over medium heat until steaming."
    },
    {
      "step": 2,
      "text": "Gradually whisk in the semolina, then bring the mixture to a gentle simmer."
    },
    {
      "step": 3,
      "text": "Cook, stirring frequently, until thickened, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Transfer the pudding to serving dishes and serve warm."
    }
