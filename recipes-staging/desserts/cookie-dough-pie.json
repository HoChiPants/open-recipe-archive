{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cookie-dough-pie",
  "name": "Cookie Dough Pie",
  "subtitle": "A chilled, chocolate-filled cookie dough dessert baked until golden.",
  "description": "A rich cookie dough crust surrounds chocolate spread, chips, and mini chocolate pieces for a sliceable dessert.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butter-at-room-temperature",
      "item": "butter at room temperature",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-muscovado-sugar",
      "item": "light brown muscovado sugar",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "plain-flour-plus-extra-for-dusting",
      "item": "plain flour plus extra for dusting",
      "quantity": 325,
      "unit": "g"
    },
    {
      "ingredient_id": "bicarbonate-of-soda",
      "item": "bicarbonate of soda",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "milk-chocolate-chips",
      "item": "milk chocolate chips",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "splash-of-milk",
      "item": "splash of milk (optional)",
      "optional": true
    },
    {
      "ingredient_id": "chocolate-hazelnut-spread",
      "item": "chocolate hazelnut spread",
      "quantity": 350,
      "unit": "g"
    },
    {
      "ingredient_id": "white-chocolate-chips",
      "item": "white chocolate chips",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "multipack-8-kinder-mini-chocolate-bars",
      "item": "multipack (8) Kinder Mini chocolate bars",
      "quantity": 100,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grease and lightly flour a pie tin. Beat the butter and sugar until smooth, then whisk in the eggs and vanilla extract."
    },
    {
      "step": 2,
      "text": "Mix in the flour and bicarbonate of soda, then fold in the milk chocolate chips and white chocolate chips. Add the optional milk only if needed to make a workable dough."
    },
    {
      "step": 3,
      "text": "Cover and chill the dough until thick, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Press about two-thirds of the dough into the prepared tin, covering the base and sides. Chill the lined tin until firm, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Stir the chocolate hazelnut spread with the remaining chocolate chips, white chocolate chips, and chopped mini chocolate bars. Spread the filling over the dough."
    },
    {
      "step": 6,
      "text": "Flatten the remaining dough and place it over the filling, sealing the edges. Smooth the surface and chill until firm, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Heat the oven and bake the pie for about 50 minutes, until golden brown and the center is fully set or reaches 160°F on a food thermometer.",
      "timer_minutes": 50
    },
    {
      "step": 8,
      "text": "Cool completely, then chill before slicing."
    }
  ],
