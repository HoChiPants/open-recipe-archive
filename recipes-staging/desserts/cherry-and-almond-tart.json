  "id": "cherry-and-almond-tart",
  "name": "Cherry and Almond Tart",
  "subtitle": "A buttery tart with lemon-scented almond filling and cherries.",
  "description": "Bake a crisp pastry shell with a tender almond filling and scattered cherries, then finish with a light dusting of sugar.",
  "meal_type": "dessert",
  "cuisine": "Italian",
