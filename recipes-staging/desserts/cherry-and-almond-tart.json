  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease a tart pan with butter."
    },
    {
      "step": 2,
      "text": "Mix the butter, caster sugar, flour, and egg or egg yolk until a dough forms. Press it evenly into the prepared pan, covering the base and sides."
    },
    {
      "step": 3,
      "text": "Beat the room-temperature butter with the caster sugar until smooth. Add the eggs one at a time, then mix in the lemon zest and ground almonds."
    },
    {
      "step": 4,
      "text": "Spread the almond mixture over the pastry and arrange the cherries across the surface."
    },
    {
      "step": 5,
      "text": "Bake for about 45 minutes, or until golden brown and the center is fully set or reaches 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Cool the tart, then dust with icing sugar if desired."
    }
  ],
