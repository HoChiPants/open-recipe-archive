  "instructions": [
    {
      "step": 1,
      "text": "Cover the dates with boiling water and leave them to soften for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Drain the dates well. Grease a suitable tin with some of the softened butter."
    },
    {
      "step": 3,
      "text": "Blend the dates, softened butter, first measure of sugar, eggs, vanilla, flour, bicarbonate of soda, and mixed spice until smooth."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared tin and cook in the air fryer for 20 minutes, until the center is firm and fully set.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Whisk the second measure of sugar, 25 g butter, and 200 ml double cream together over heat for 3 minutes to make the sauce, then transfer it and rest for 2 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Whisk the double cream intended for serving, if using. Serve the warm pudding with the sauce and ice cream or cream."
    }
  ],
