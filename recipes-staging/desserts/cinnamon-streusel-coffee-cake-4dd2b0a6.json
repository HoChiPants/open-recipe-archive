  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease and line a baking pan."
    },
    {
      "step": 2,
      "text": "Mix 0.75 cup brown sugar, 0.333 cup flour, and 1.5 teaspoons cinnamon for the streusel; set aside."
    },
    {
      "step": 3,
      "text": "Combine 1 cup brown sugar, 1 cup flour, 2 teaspoons cinnamon, and 0.25 teaspoon salt. Work in 0.5 cup softened butter until crumbly; set aside."
    },
    {
      "step": 4,
      "text": "Whisk 3.5 cups flour, baking powder, and 0.25 teaspoon salt in a bowl."
    },
    {
      "step": 5,
      "text": "Beat 1.5 cups white sugar and 1 cup softened butter for 3 minutes. Add the eggs one at a time, whisking after each.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Add the flour mixture alternately with the milk, mixing just until combined. Fold in the sour cream and vanilla extract."
    },
    {
      "step": 7,
      "text": "Spread half the batter in the pan. Add a cinnamon-sugar layer, top with the remaining batter, and finish with the reserved streusel."
    },
    {
      "step": 8,
      "text": "Bake until golden and the center is fully set, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 9,
      "text": "Cool in the pan for 30 minutes before slicing.",
      "timer_minutes": 30
    }
  ],
