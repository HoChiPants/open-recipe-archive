  "instructions": [
    {
      "step": 1,
      "text": "Chop the dates, golden raisins, raisins, candied citrus peel, candied cherries, and almonds into small pieces. Combine them with the dried currants and set aside."
    },
    {
      "step": 2,
      "text": "Preheat the oven to 275°F. Prepare the baking pans as needed."
    },
    {
      "step": 3,
      "text": "Whisk together the flour, baking powder, baking soda, salt, allspice, cinnamon, nutmeg, and cloves."
    },
    {
      "step": 4,
      "text": "Beat the butter until smooth. Add the vanilla extract, almond extract, and white sugar, then beat in the egg yolks and molasses."
    },
    {
      "step": 5,
      "text": "Blend the dry mixture into the butter mixture, adding the grape juice and coffee as needed to form a thick batter."
    },
    {
      "step": 6,
      "text": "Beat the egg whites until they hold a firm, fully set foam, then fold them into the batter. Stir in the prepared fruit and almonds."
    },
    {
      "step": 7,
      "text": "Transfer the batter to the prepared pans and bake at 275°F until deeply browned and the center is fully set, reaching at least 160°F on a food thermometer; bake for about 4½ hours total.",
      "timer_minutes": 270
    },
    {
      "step": 8,
      "text": "Cool in the pans for 5 minutes, then transfer to a rack and cool completely before serving.",
      "timer_minutes": 5
    }
  ],
