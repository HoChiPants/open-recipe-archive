      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the chocolate in a saucepan and heat for about 2 minutes, stirring as needed, until melted.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Add the sugar, butter, and salt, then stir to combine."
    },
    {
      "step": 3,
      "text": "Whisk in the heavy cream until smooth and heat the mixture until it reaches a boil."
    },
    {
      "step": 4,
      "text": "Remove from the heat, stir in the vanilla extract, and serve warm."
    }
