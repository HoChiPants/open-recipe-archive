  "id": "hot-fudge-sauce",
  "name": "Hot Fudge Sauce",
  "subtitle": "Rich chocolate sauce for spooning over desserts",
  "description": "A warm, glossy chocolate sauce made with unsweetened chocolate, cream, butter, and vanilla.",
  "meal_type": "dessert",
  "cuisine": "American",
