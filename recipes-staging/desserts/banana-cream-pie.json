  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Combine 0.66666668653488 cup white sugar, cornstarch, and salt in a saucepan. Stir in the milk and beaten egg yolks."
    },
    {
      "step": 3,
      "text": "Cook over medium heat, whisking constantly, until the custard thickens and reaches 160°F."
    },
    {
      "step": 4,
      "text": "Remove from the heat and whisk in the butter and 1 tablespoon vanilla extract. Transfer the custard to the cooled crust."
    },
    {
      "step": 5,
      "text": "Arrange the sliced banana over the custard."
    },
    {
      "step": 6,
      "text": "Whisk the egg whites with the cream of tartar and 0.5 cup white sugar until stiff peaks form. Whisk in 0.25 teaspoon vanilla extract."
    },
    {
      "step": 7,
      "text": "Spread the meringue over the banana layer, sealing it to the crust edges."
    },
    {
      "step": 8,
      "text": "Bake until the meringue is lightly browned and the center is fully set, verifying it reaches 160°F, about 15 minutes.",
      "timer_minutes": 15
    }
  ],
