  "id": "lemon-cupcakes",
  "name": "Lemon Cupcakes",
  "subtitle": "Tender cupcakes with lemon cream topping",
  "description": "Bright lemon cupcakes finished with a lightly sweetened whipped cream topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 20,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "at room temperature"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "large",
      "preparation": "at room temperature"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 1,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 2.5,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "chilled-heavy-cream",
      "item": "chilled heavy cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 1.5,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Prepare cupcake pans with liners."
    },
    {
      "step": 2,
      "text": "Whisk together the self-rising flour and salt. In a separate bowl, beat the unsalted butter, white sugar, and confectioners' sugar until blended."
    },
    {
      "step": 3,
      "text": "Beat in the eggs one at a time, then mix in the lemon zest, vanilla extract, and fresh lemon juice."
    },
    {
      "step": 4,
      "text": "Add the flour mixture in portions, alternating with the divided whole milk and divided fresh lemon juice. Whisk just until the batter is combined."
    },
    {
      "step": 5,
      "text": "Fill the liners and bake for 17 minutes, until the centers are set. Cool for 10 minutes, then finish cooling before topping.",
      "timer_minutes": 17
    },
    {
      "step": 6,
      "text": "Whisk the chilled heavy cream until set. Add the white sugar, lemon zest, fresh lemon juice, and confectioners' sugar; continue whisking for 5 minutes, until soft peaks form.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Transfer the lemon cream to the cooled cupcakes and chill before serving."
    }
  ],
