  "id": "whipped-cream-cake",
  "name": "Whipped Cream Cake",
  "subtitle": "A tender cake with cream-whipped batter",
  "description": "A simple American cake built with whipped cream, eggs, and lightly leavened flour for a soft crumb.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "cake-flour",
      "item": "cake flour",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.3329999446869,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the cake flour, baking powder, and salt together."
    },
    {
      "step": 3,
      "text": "Whip the heavy cream and white sugar until stiff peaks form."
    },
    {
      "step": 4,
      "text": "Whisk the eggs with the vanilla extract in a separate bowl."
    },
    {
      "step": 5,
      "text": "Fold the egg mixture and dry ingredients into the whipped cream until combined."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and bake for 25 minutes, until set.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Cool in the pan for 10 minutes, then transfer to a rack and cool completely.",
      "timer_minutes": 10
    }
  ],
