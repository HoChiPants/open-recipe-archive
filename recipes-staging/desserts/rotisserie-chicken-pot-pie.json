  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Fit one pie crust into a 9-inch pie dish and set the other aside."
    },
    {
      "step": 2,
      "text": "Shred the rotisserie chicken."
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet over medium heat. Add the onion and cook for 5 minutes, until tender.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the flour, salt, and pepper, then cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Gradually add the chicken broth and milk. Cook for 5 minutes, stirring, until thickened.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir in the shredded chicken and thawed mixed vegetables until combined."
    },
    {
      "step": 7,
      "text": "Pour the filling into the crust and cover with the remaining crust. Seal the edges and prepare the top for baking."
    },
    {
      "step": 8,
      "text": "Bake for 30 minutes, until golden brown and the center reaches 165°F on a food thermometer. Serve hot.",
      "timer_minutes": 30
    }
  ],
