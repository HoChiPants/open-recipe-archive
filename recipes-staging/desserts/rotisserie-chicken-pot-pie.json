  "id": "rotisserie-chicken-pot-pie",
  "name": "Rotisserie Chicken Pot Pie",
  "subtitle": "Creamy chicken and vegetables in a flaky double crust",
  "description": "A savory chicken pot pie filled with vegetables in a simple creamy sauce and baked until golden.",
  "meal_type": "dessert",
