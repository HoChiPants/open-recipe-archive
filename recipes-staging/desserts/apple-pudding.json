  "id": "apple-pudding",
  "name": "Apple Pudding",
  "subtitle": "Warm cinnamon apples with a buttery topping",
  "description": "Tender apples are baked with brown sugar, cinnamon, caramel, and a simple buttery flour topping, then served warm with ice cream.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "braeburn-apples",
      "item": "Braeburn apples",
      "quantity": "1 1/4",
      "unit": "kg"
    },
    {
      "ingredient_id": "light-brown-sugar",
      "item": "light brown sugar",
      "quantity": 175,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "caramel-sauce",
      "item": "caramel sauce",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "butter-melted",
      "item": "butter melted",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-ice-cream-to-serve",
      "item": "vanilla ice cream to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Peel, core, and slice the apples. Toss them with the brown sugar and cinnamon, then cook for 5 minutes until slightly softened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Mix the flour and baking powder, then stir in the melted butter to form a rough topping."
    },
    {
      "step": 4,
      "text": "Arrange the apples in a baking dish and drizzle over the caramel sauce. Scatter the topping evenly over the fruit."
    },
    {
      "step": 5,
      "text": "Bake for 50 minutes, until the apples are tender and the topping is set and lightly browned.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Serve warm with vanilla ice cream."
    }
  ],
