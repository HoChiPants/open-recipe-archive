  "id": "lemon-cheese-cake",
  "name": "Lemon Cheese Cake",
  "subtitle": "A tender lemon cake with a rich citrus topping",
  "description": "A simple American dessert combining a pudding-enriched yellow cake base with a buttery lemon filling.",
  "meal_type": "dessert",
  "cuisine": "American",
