  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Grease a baking pan and prepare the yellow cake mix with the all-purpose flour, milk, pudding mix, eggs, and vegetable oil until smooth."
    },
    {
      "step": 2,
      "text": "Transfer the batter to the prepared pan and bake until the cake is set, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Let the cake cool while preparing the lemon topping."
    },
    {
      "step": 4,
      "text": "Combine the white sugar, butter, fresh lemon juice, egg yolks, all-purpose flour, and grated lemon zest in a saucepan."
    },
    {
      "step": 5,
      "text": "Cook over medium heat, stirring continuously, until the mixture thickens. Use a food thermometer to verify that the egg mixture reaches 160°F."
    },
    {
      "step": 6,
      "text": "Spread the lemon filling over the cooled cake and refrigerate until set.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Slice and serve chilled."
    }
  ],
