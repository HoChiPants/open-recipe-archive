  "id": "creamy-cheesecake",
  "name": "Creamy Cheesecake",
  "subtitle": "A smooth lemon-scented cheesecake with a crisp graham crust.",
  "description": "A straightforward baked cheesecake with vanilla, lemon zest, and a firm creamy center.",
  "meal_type": "dessert",
  "cuisine": "American",
