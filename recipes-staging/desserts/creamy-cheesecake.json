  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the cream cheese until smooth."
    },
    {
      "step": 3,
      "text": "Add the eggs, white sugar, vanilla extract, and grated lemon zest, then whisk until evenly combined."
    },
    {
      "step": 4,
      "text": "Transfer the filling to the prepared graham cracker crust."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, until the center is firm and fully set.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Add the cream cheese as specified in the preparation sequence."
    }
  ],
