  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven and prepare a traybake tin. Whisk the eggs, soured cream, coffee, and olive oil together."
    },
    {
      "step": 2,
      "text": "Combine the flour, cocoa, bicarbonate of soda, baking powder, both sugars, and malt powder if using. Stir into the wet mixture until smooth."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the tin and bake until risen and set.",
      "timer_minutes": 22
    },
    {
      "step": 4,
      "text": "Cool the cake in the tin for 20 minutes, then leave it to cool completely before decorating.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Cook the cherries with the brown sugar, lemon juice, cornflour, and one portion of scraped vanilla seeds until thickened. Cool before using.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Warm the 200 ml double cream with the chopped dark and milk chocolate, stirring until smooth. Whisk briefly until set, then cool.",
      "timer_minutes": 1
    },
    {
      "step": 7,
      "text": "Whisk the remaining double cream with the kirsch, the second portion of vanilla seeds, and icing sugar until soft peaks form.",
      "timer_minutes": 4
    },
    {
      "step": 8,
      "text": "Spread the chocolate cream over the cooled cake, add the cherry mixture, and finish with the whipped cream. Scatter with the toasted chopped hazelnuts and serve."
    }
  ],
