  "id": "chocolate-vanilla-pecan-dessert",
  "name": "Chocolate-Vanilla Pecan Dessert",
  "subtitle": "A layered dessert with a buttery pecan crust and creamy pudding topping.",
  "description": "Bake a pecan crust, layer it with sweetened cream cheese and thick vanilla-chocolate pudding, then finish with whipped topping and crisp chocolate pieces.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "finely-chopped-pecans",
      "item": "finely chopped pecans",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "16-ounce-container-frozen-whipped-topping",
      "item": "(16 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed, divided"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "instant-chocolate-pudding-mix",
      "item": "instant chocolate pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.9 ounce"
    },
    {
      "ingredient_id": "instant-vanilla-pudding-mix",
      "item": "instant vanilla pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.4 ounce"
    },
    {
      "ingredient_id": "1-45-ounce-bars-milk-chocolate-with-crispy-rice",
      "item": "(1.45 ounce) bars milk chocolate with crispy rice",
      "quantity": 2,
      "preparation": "crumbled"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Combine the pecans, flour, and melted butter, then press the mixture evenly into a baking dish."
    },
    {
      "step": 2,
      "text": "Bake the crust for 25 minutes, then let it cool completely.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Beat the softened cream cheese with the confectioners' sugar until smooth. Fold in half of the whipped topping and spread the mixture over the cooled crust."
    },
    {
      "step": 4,
      "text": "Whisk the milk with both pudding mixes until thick. Spread the pudding over the cream-cheese layer."
    },
    {
      "step": 5,
      "text": "Top with the remaining whipped topping and the crumbled milk chocolate pieces."
    }
  ],
