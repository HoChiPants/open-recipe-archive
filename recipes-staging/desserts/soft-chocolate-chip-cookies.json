  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the baking soda, salt, and flour in a bowl."
    },
    {
      "step": 3,
      "text": "Whisk the butter, shortening, brown sugar, white sugar, vanilla extract, and egg until combined."
    },
    {
      "step": 4,
      "text": "Add the flour mixture and combine into a dough."
    },
    {
      "step": 5,
      "text": "Stir in the chocolate chips."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, until golden brown and the centers are fully set.",
      "timer_minutes": 10
    }
