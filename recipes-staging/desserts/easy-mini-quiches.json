{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "easy-mini-quiches",
  "name": "Easy Mini Quiches",
  "subtitle": "Bite-size savory egg cups with bacon, onion, parsley, and cheese.",
  "description": "Small baked quiches made with a bacon-and-onion filling, shredded cheese, parsley, eggs, and baking mix.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 6,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "buttermilk-baking-mix",
      "item": "buttermilk baking mix",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 1.5,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "american-cheese",
      "item": "American cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare mini muffin tins for 24 portions."
    },
    {
      "step": 2,
      "text": "Cook the chopped bacon and onion together for 5 minutes, until tender. Let the mixture cool until set.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the eggs in a bowl. Stir in the cooled bacon mixture, baking mix, parsley, and shredded cheese until combined."
    },
    {
      "step": 4,
      "text": "Divide the mixture among the prepared tins and bake for 15 minutes, until lightly browned and the centers are fully set.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Cool briefly before serving."
    }
  ],
