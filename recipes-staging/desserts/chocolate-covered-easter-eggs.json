  "id": "chocolate-covered-easter-eggs",
  "name": "Chocolate-Covered Easter Eggs",
  "subtitle": "Two filling variations with a smooth chocolate shell",
  "description": "Shape a sweet cream cheese and peanut butter mixture into coconut and cocoa eggs, then coat them in chocolate and chill until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 0,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 2.5,
      "unit": "pounds"
    },
    {
      "ingredient_id": "creamy-peanut-butter",
      "item": "creamy peanut butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "semisweet-chocolate-pieces",
      "item": "semisweet chocolate pieces",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "shortening-or-vegetable-oil",
      "item": "shortening or vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Beat the softened butter, vanilla, cream cheese, and peanut butter until smooth."
    },
    {
      "step": 2,
      "text": "Gradually stir in the confectioners' sugar until a firm mixture forms."
    },
    {
      "step": 3,
      "text": "Divide the mixture into two portions. Blend flaked coconut into one portion and cocoa powder into the other."
    },
    {
      "step": 4,
      "text": "Shape the portions into small egg-shaped pieces and arrange them on a lined tray."
    },
    {
      "step": 5,
      "text": "Chill the shaped eggs until firm.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Melt the semisweet chocolate pieces over gently simmering water, stirring until smooth."
    },
    {
      "step": 7,
      "text": "Stir in the shortening or vegetable oil until the coating is smooth and thick enough to coat."
    },
    {
      "step": 8,
      "text": "Dip or coat the chilled eggs with the chocolate mixture, then return them to the tray."
    },
    {
      "step": 9,
      "text": "Chill until the chocolate is set."
    }
  ],
