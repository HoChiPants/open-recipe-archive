    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the sweetened condensed milk and key lime juice together until evenly combined."
    },
    {
      "step": 2,
      "text": "Fold in the thawed whipped topping until the filling is smooth."
    },
    {
      "step": 3,
      "text": "Spoon the filling into the prepared graham cracker pie crust and smooth the surface."
    },
    {
      "step": 4,
      "text": "Refrigerate until set and thoroughly chilled, about 60 minutes.",
      "timer_minutes": 60
    }
