    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "light-brown-sugar",
      "item": "light brown sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "quick-cooking-tapioca",
      "item": "quick-cooking tapioca",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "rhubarb",
      "item": "rhubarb",
      "quantity": 3,
      "unit": "cups",
      "preparation": "diced"
    },
    {
      "ingredient_id": "fresh-blueberries",
      "item": "fresh blueberries",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "pastry-for-a-9-inch-double-crust-pie",
      "item": "pastry for a 9-inch double crust pie",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Stir the white sugar, light brown sugar, tapioca, and salt together. Add the diced rhubarb and blueberries, tossing until evenly coated."
    },
    {
      "step": 3,
      "text": "Fit half of the pastry into a 9-inch pie dish and spoon in the fruit mixture."
    },
    {
      "step": 4,
      "text": "Cut the remaining pastry into strips or shapes and arrange it over the filling, sealing the edges to the bottom crust."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes at 400°F. Lower the oven to 350°F and continue baking for 30 minutes, until the crust is golden brown.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool the pie completely before slicing.",
      "timer_minutes": 120
    }
  ],
