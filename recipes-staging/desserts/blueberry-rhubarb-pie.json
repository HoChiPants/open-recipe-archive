  "id": "blueberry-rhubarb-pie",
  "name": "Blueberry Rhubarb Pie",
  "subtitle": "A bright berry-and-rhubarb pie with a crisp double crust",
  "description": "Sweet blueberries and tangy rhubarb bake into a fruit-filled pastry pie.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
