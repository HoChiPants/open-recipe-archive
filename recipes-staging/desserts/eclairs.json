  "id": "eclairs",
  "name": "Eclairs",
  "subtitle": "Crisp pastry filled with vanilla cream and chocolate glaze",
  "description": "Bake light choux pastry, fill it with vanilla pudding cream, and finish with a smooth chocolate glaze.",
  "meal_type": "dessert",
  "cuisine": "French",
