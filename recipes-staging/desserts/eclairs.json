  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 450°F. Bring the water and 0.5 cup butter to a simmer in a saucepan."
    },
    {
      "step": 2,
      "text": "Add the flour and salt all at once. Stir vigorously until the mixture forms a cohesive dough and pulls from the pan."
    },
    {
      "step": 3,
      "text": "Remove from the heat and beat in the eggs one at a time until smooth. Pipe or spoon nine portions onto a baking sheet."
    },
    {
      "step": 4,
      "text": "Bake for 15 minutes at 450°F, then reduce the oven to 325°F and continue baking until puffed, dry, and fully set; the pastry should reach at least 160°F internally. Cool completely.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Whisk the cold milk with the pudding mix until thick. Separately whip the heavy cream with 0.25 cup confectioners' sugar and 1 teaspoon vanilla extract to soft peaks, then fold it into the pudding."
    },
    {
      "step": 6,
      "text": "Split the cooled pastries, fill them with the vanilla cream, and arrange them for glazing."
    },
    {
      "step": 7,
      "text": "Melt the chocolate with 2 tablespoons butter. Stir in 1 cup confectioners' sugar and 1 teaspoon vanilla extract, then add the hot water gradually until smooth."
    },
    {
      "step": 8,
      "text": "Spread the glaze over the filled eclairs and let it set before serving."
    }
  ],
