  "id": "moon-cake",
  "name": "Moon Cake",
  "subtitle": "A chilled pastry dessert with vanilla cream and chocolate syrup",
  "description": "Bake a light pastry base, cool it completely, then layer it with a smooth vanilla cream topping and finish with chocolate syrup.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 35,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "instant-vanilla-pudding-mix",
      "item": "instant vanilla pudding mix",
      "quantity": 2,
      "unit": "package",
      "preparation": "3.4 ounce"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "8-ounce-container-frozen-whipped-topping",
      "item": "(8 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "chocolate-syrup",
      "item": "chocolate syrup",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Simmer the water and margarine together until the margarine melts."
    },
    {
      "step": 2,
      "text": "Stir in the flour until a cohesive dough forms. Remove from the heat, then beat in the eggs one at a time until smooth."
    },
    {
      "step": 3,
      "text": "Spread the dough evenly in a baking pan and bake for 25 minutes, until puffed and set; the center should be fully cooked and reach 160°F if checked with a thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Cool the baked base completely. Beat the pudding mix, milk, and cream cheese together until smooth."
    },
    {
      "step": 5,
      "text": "Spread the cream mixture over the cooled base, top with the thawed whipped topping, drizzle with chocolate syrup, and chill before serving."
    }
  ],
