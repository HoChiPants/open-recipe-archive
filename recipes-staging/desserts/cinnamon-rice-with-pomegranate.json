  "id": "cinnamon-rice-with-pomegranate",
  "name": "Cinnamon Rice with Pomegranate",
  "subtitle": "Creamy spiced rice topped with fruit and walnuts",
  "description": "Tender brown basmati rice gently cooked with cinnamon, vanilla, and bay leaf, then finished with pomegranate seeds and chopped walnuts.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "brown-basmati-rice",
      "item": "brown basmati rice",
      "quantity": 120,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "semi-skimmed-milk",
      "item": "semi-skimmed milk",
      "quantity": 670,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "bay-leaf",
      "item": "bay leaf",
      "quantity": 1
    },
    {
      "ingredient_id": "heaped-tbsp-pomegranate-seeds-18g",
      "item": "heaped tbsp pomegranate seeds (18g)",
      "quantity": 1
    },
    {
      "ingredient_id": "walnut-halves-roughly-chopped",
      "item": "walnut halves roughly chopped",
      "quantity": 4
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the rice in a saucepan and warm it gently, stirring in the cinnamon."
    },
    {
      "step": 2,
      "text": "Add the milk, vanilla extract, and bay leaf. Bring to a gentle simmer, then cook until the rice is tender, about 40 minutes, stirring occasionally.",
      "timer_minutes": 40
    },
    {
      "step": 3,
      "text": "Remove from the heat and let the rice cool for 5 minutes. Discard the bay leaf.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Spoon into serving dishes and top with the pomegranate seeds and chopped walnut halves."
    }
  ],
