  "id": "congo-squares",
  "name": "Congo Squares",
  "subtitle": "Chewy brown sugar bars with walnuts and chocolate chips",
  "description": "A simple baked dessert combining buttery brown sugar batter with chopped walnuts and semi-sweet chocolate chips.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "packed-light-brown-sugar",
      "item": "packed light brown sugar",
      "quantity": 2.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "semi-sweet-chocolate-chips",
      "item": "semi-sweet chocolate chips",
      "quantity": 6,
      "unit": "ounces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Combine the packed light brown sugar and melted butter, then let the mixture cool slightly."
    },
    {
      "step": 3,
      "text": "Whisk the eggs in a large bowl. In a separate bowl, combine the all-purpose flour, baking powder, and salt."
    },
    {
      "step": 4,
      "text": "Add the cooled sugar mixture to the eggs, then stir in the dry ingredients until combined."
    },
    {
      "step": 5,
      "text": "Fold in the chopped walnuts and semi-sweet chocolate chips."
    },
    {
      "step": 6,
      "text": "Transfer the batter to a prepared baking pan and bake for 30 minutes, until the center is firm and fully set or reaches 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Cool, then cut into squares and serve."
    }
  ],
