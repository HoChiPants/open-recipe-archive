  "instructions": [
    {
      "step": 1,
      "text": "Whisk the four large eggs with 1 cup white sugar and 1 cup light brown sugar. Whisk in the milk, 0.75 cup heavy cream, cooled melted butter, vanilla, and 0.5 teaspoon salt."
    },
    {
      "step": 2,
      "text": "Cut the sourdough and brioche into bite-size pieces and place them in a baking dish. Pour the custard over the bread, stir to coat, and let stand for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Heat the oven to 325°F. Sprinkle the bread with 2 tablespoons white sugar, 2 tablespoons light brown sugar, and the cinnamon."
    },
    {
      "step": 4,
      "text": "Bake for 55 minutes, until the center is firm and reaches 160°F. Cool for 20 minutes.",
      "timer_minutes": 55
    },
    {
      "step": 5,
      "text": "For the sauce, whisk the large egg with 0.5 cup heavy cream. Cook 1 cup white sugar, 1 cup light brown sugar, and 0.5 cup butter until smooth and combined."
    },
    {
      "step": 6,
      "text": "Gradually whisk the hot sugar mixture into the egg mixture. Return it to low heat and cook, stirring, until thickened and at least 160°F; do not boil.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Stir in the bourbon and 0.25 teaspoon salt. Serve the warm sauce over the bread pudding."
    }
  ],
