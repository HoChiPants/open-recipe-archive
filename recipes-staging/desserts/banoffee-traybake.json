  "id": "banoffee-traybake",
  "name": "Banoffee Traybake",
  "subtitle": "A soft banana bake with chocolate and caramel",
  "description": "Bake a tender banana-and-chocolate traybake, then finish it with caramel and optional banana chips.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 200,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
