  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and butter the baking tin."
    },
    {
      "step": 2,
      "text": "Beat the softened butter, bananas, and brown sugar until smooth. Add the eggs and vanilla, then mix until combined."
    },
    {
      "step": 3,
      "text": "Fold in the flour, yogurt, and chopped chocolate until no dry streaks remain."
    },
    {
      "step": 4,
      "text": "Spread the batter evenly in the prepared tin and bake for 30 minutes, until risen and a skewer inserted in the center comes out clean.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Leave the traybake in the tin for 10 minutes, then transfer it to a rack and let it cool.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Cut into 12 pieces, spread or drizzle with caramel, and top with banana chips if using."
    }
  ],
