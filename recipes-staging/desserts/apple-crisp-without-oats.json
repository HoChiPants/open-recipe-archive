  "id": "apple-crisp-without-oats",
  "name": "Apple Crisp Without Oats",
  "subtitle": "A cinnamon apple dessert with a tender flour topping",
  "description": "Sliced apples are layered with a simple flour mixture, cinnamon sugar, and melted butter, then baked until tender and set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "apples",
      "item": "apples",
      "quantity": 8
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Combine the flour, 1 cup sugar, baking powder, and egg to form a thick mixture."
    },
    {
      "step": 3,
      "text": "Cut the apples into slices and toss them with the cinnamon."
    },
    {
      "step": 4,
      "text": "Transfer the apples to a baking dish and spread the flour mixture over them."
    },
    {
      "step": 5,
      "text": "Mix the remaining sugar with the cinnamon, sprinkle it over the top, and drizzle with the melted butter."
    },
    {
      "step": 6,
      "text": "Bake for 60 minutes, until the apples are tender and the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Serve warm."
    }
  ],
