{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "apple-and-cinnamon-muffins",
  "name": "Apple and Cinnamon Muffins",
  "subtitle": "Tender muffins with spiced apples and sultanas",
  "description": "Bake a batch of fruit-filled muffins with diced apples, warm spice, and a light brown-sugar topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "min for prepping the apple"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "cinnamon-or-ginger",
      "item": "cinnamon or ginger",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "eating-apples-cored-and-diced",
      "item": "eating apples cored and diced",
      "quantity": 2,
      "unit": "small"
    },
    {
      "ingredient_id": "sultanas",
      "item": "sultanas",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "soft-brown-sugar-for-apples",
      "item": "soft brown sugar for apples",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "of-soft-brown-sugar-for-sprinkling-on-muffins-before-placing-in-oven",
      "item": "of soft brown sugar for sprinkling on muffins before placing in oven",
      "unit": "pinch"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "drops"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "medium"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 125,
      "unit": "ml"
    },
    {
      "ingredient_id": "semi-skimmed-milk-or-thin-plain-yogurt",
      "item": "semi-skimmed milk or thin plain yogurt",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "golden-caster-sugar-or-soft-light-brown-sugar",
      "item": "golden caster sugar or soft light brown sugar",
      "quantity": 175,
      "unit": "g"
    },
    {
      "ingredient_id": "self-raising-flour-or-same-quantity-plain-flour-and-3-tsp-baking-powder",
      "item": "self-raising flour (or same quantity plain flour and 3 tsp baking powder)",
      "quantity": 400,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a 10-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Combine the diced apples, sultanas, cinnamon or ginger, and the soft brown sugar for apples.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the eggs with the golden caster sugar or soft light brown sugar. Add the oil, milk or yogurt, and vanilla extract, then whisk until combined.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the self-raising flour and mix just until the batter is smooth."
    },
    {
      "step": 5,
      "text": "Fold the apple mixture into the batter and divide it among the muffin cups."
    },
    {
      "step": 6,
      "text": "Sprinkle each muffin with a pinch of the soft brown sugar for sprinkling on muffins before placing in oven."
    },
    {
      "step": 7,
      "text": "Bake for 25 minutes, until the muffins are firm.",
      "timer_minutes": 25
    },
    {
      "step": 8,
      "text": "Cool briefly before serving.",
      "timer_minutes": 15
    }
  ],
