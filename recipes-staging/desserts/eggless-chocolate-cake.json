  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Sift together the flour, cocoa powder, baking soda, and salt. Stir in the sugar."
    },
    {
      "step": 3,
      "text": "Add the water, vegetable oil, and vanilla extract, mixing until the batter is smooth."
    },
    {
      "step": 4,
      "text": "Pour the batter into the prepared pan and bake at 350°F for 60 minutes, or until the cake is set in the center.",
      "timer_minutes": 60
    }
