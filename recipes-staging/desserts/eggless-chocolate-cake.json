  "id": "eggless-chocolate-cake",
  "name": "Eggless Chocolate Cake",
  "subtitle": "A simple cocoa cake without eggs",
  "description": "A tender chocolate cake made with cocoa, vanilla, and pantry staples.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
