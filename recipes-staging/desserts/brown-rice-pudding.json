      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the water and brown rice in a covered saucepan. Bring to a boil, then cook until the rice is tender.",
      "timer_minutes": 45
    },
    {
      "step": 2,
      "text": "Stir in the divided milk, sugar, and salt. Continue cooking until the mixture thickens.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Gradually whisk some of the hot pudding into the beaten egg, then return the mixture to the saucepan. Stir in the raisins and remaining milk."
    },
    {
      "step": 4,
      "text": "Cook gently, stirring constantly, until the pudding reaches 160°F and remains thick.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Remove from the heat and stir in the butter and vanilla extract. Serve warm."
    }
  ],
