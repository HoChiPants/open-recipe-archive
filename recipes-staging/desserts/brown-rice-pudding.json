  "id": "brown-rice-pudding",
  "name": "Brown Rice Pudding",
  "subtitle": "Creamy rice pudding with raisins",
  "description": "A warm, lightly sweet pudding made with brown rice, milk, raisins, and vanilla.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "uncooked-brown-rice",
      "item": "uncooked brown rice",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "low-fat-milk",
