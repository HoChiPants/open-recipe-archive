  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, golden icing sugar, cinnamon, and cloves. Rub in the cold butter chopped, then mix in the egg yolk to form a dough. Chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Heat the oven and roll the dough thinly. Cut rounds, fit them into eight small tart tins, and trim the edges."
    },
    {
      "step": 3,
      "text": "Prick the pastry bases and bake until golden brown, about 10 minutes. Continue baking for 8 minutes, then cool the shells.",
      "timer_minutes": 18
    },
    {
      "step": 4,
      "text": "Whisk the cornflour with the clementine, orange, and lemon juices and the golden caster sugar. Cook, stirring, until thickened. Remove from the heat, beat in the butter cut into small pieces and the egg yolks, then return to gentle heat until the filling reaches 160°F and is fully set. Cool slightly."
    },
    {
      "step": 5,
      "text": "Fill the pastry shells with the citrus mixture."
    },
    {
      "step": 6,
      "text": "Whisk the egg whites to soft peaks. Gradually add the caster sugar and continue beating until the meringue is thick and glossy."
    },
    {
      "step": 7,
      "text": "Spoon or pipe the meringue over the pies, covering the filling. Toast under the grill for about 1 minute, watching closely, and serve.",
      "timer_minutes": 1
    }
  ],
