{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "boondi-laddu",
  "name": "Boondi Laddu",
  "subtitle": "Saffron-cardamom sweets with pistachios and pine nuts",
  "description": "Fried gram-flour pearls are combined with saffron syrup, cardamom, and nuts, then shaped into festive Indian sweets.",
  "meal_type": "dessert",
  "cuisine": "Indian",
  "yield": {
    "quantity": 8,
    "unit": "; makes 14-16"
  },
  "times": {
    "prep_minutes": 35,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "saffron-strands",
      "item": "saffron strands",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "green-cardamom-pods-seeds-only",
      "item": "green cardamom pods seeds only",
      "quantity": 8
    },
    {
      "ingredient_id": "caster-sugar-plus-1-tsp",
      "item": "caster sugar plus 1 tsp",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "gram-flour-optional",
      "item": "gram flour",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "litre-sunflower-oil-or-500g-ghee",
      "item": "litre sunflower oil or 500g ghee",
      "quantity": 1,
      "preparation": "for deep-frying, plus extra for your hands"
    },
    {
      "ingredient_id": "pistachios",
      "item": "pistachios",
      "quantity": 2,
      "unit": "tbsp",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "pine-nuts-chopped",
      "item": "pine nuts chopped",
      "quantity": 1,
      "unit": "tbsp",
      "preparation": "or dried melon seeds (char magaz)"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 225,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Soak the saffron strands in a little warm water for 60 minutes. Crush the cardamom seeds.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Whisk the gram flour with enough water to make a smooth, thick batter that falls easily from a spoon."
    },
    {
      "step": 3,
      "text": "Heat the sunflower oil or ghee in a deep pan for frying. Hold a perforated spoon over the pan and pour in batter, allowing small droplets to fall into the hot fat."
    },
    {
      "step": 4,
      "text": "Fry the boondi until cooked through and lightly colored, then transfer it to drain. Repeat with the remaining batter."
    },
    {
      "step": 5,
      "text": "Combine both caster sugar entries with water in a saucepan and heat until the syrup reaches a thick consistency.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Stir in the soaked saffron and cook for 1 minute. Add the fried boondi, crushed cardamom, pistachios, and pine nuts or dried melon seeds; mix until coated and the mixture begins to set.",
      "timer_minutes": 1
    },
    {
      "step": 7,
      "text": "Let the mixture cool for about 2 hours, until comfortable to handle and firm enough to hold its shape.",
      "timer_minutes": 120
    },
    {
      "step": 8,
      "text": "Grease your hands with the reserved frying fat. Press portions of the mixture together and roll into compact laddus."
    },
    {
      "step": 9,
      "text": "Serve at room temperature."
    }
  ],
