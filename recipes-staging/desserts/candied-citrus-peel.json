  "id": "candied-citrus-peel",
  "name": "Candied Citrus Peel",
  "subtitle": "Tender, syrup-glazed orange peel",
  "description": "Blanch orange peel, simmer it in a simple sugar syrup, and dry until lightly candied.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45,
    "inactive_minutes": 480
  },
  "ingredients": [
    {
      "ingredient_id": "orange-peel",
      "item": "orange peel",
      "quantity": 1,
      "unit": "cup",
      "preparation": "cut into strips"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the orange peel and water in a saucepan. Bring to a boil and cook for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Drain the peel thoroughly."
    },
    {
      "step": 3,
      "text": "Return the white sugar and water to the saucepan. Bring to a boil, stirring until the sugar dissolves."
    },
    {
      "step": 4,
      "text": "Add the peel and simmer gently for 15 minutes, until glossy and tender.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Transfer the peel to a rack or parchment-lined tray and separate the strips."
    },
    {
      "step": 6,
      "text": "Let the peel dry at room temperature for 8 hours, or until lightly tacky and candied.",
      "timer_minutes": 480
    }
  ],
