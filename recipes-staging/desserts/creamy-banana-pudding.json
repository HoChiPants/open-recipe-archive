  "id": "creamy-banana-pudding",
  "name": "Creamy Banana Pudding",
  "subtitle": "A chilled layered dessert with bananas, cream, and vanilla wafers.",
  "description": "Combine a vanilla pudding base with whipped cream, lemon-coated bananas, and vanilla wafers, then chill until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "instant-vanilla-pudding-mix",
      "item": "instant vanilla pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.4 ounce"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "banana",
      "item": "bananas",
      "quantity": 3,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-wafers",
      "item": "vanilla wafers",
      "quantity": 36
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the sweetened condensed milk and cold water together. Add the instant vanilla pudding mix and whisk until smooth."
    },
    {
      "step": 2,
      "text": "Chill the pudding mixture for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whip the heavy cream to stiff peaks, then whisk it into the chilled pudding mixture until evenly combined."
    },
    {
      "step": 4,
      "text": "Toss the sliced bananas with the lemon juice."
    },
    {
      "step": 5,
      "text": "Layer the pudding mixture, bananas, and vanilla wafers in a serving dish, finishing with the remaining ingredients."
    },
    {
      "step": 6,
      "text": "Chill the assembled pudding for 20 minutes before serving.",
      "timer_minutes": 20
    }
  ],
