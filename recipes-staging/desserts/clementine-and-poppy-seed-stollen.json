  "instructions": [
    {
      "step": 1,
      "text": "Set the sultanas aside. Lightly oil a large bowl and prepare a lined baking tray."
    },
    {
      "step": 2,
      "text": "Mix the flour, yeast, caster sugar, cardamom, nutmeg, cinnamon, poppy seeds, and clementine zest."
    },
    {
      "step": 3,
      "text": "Warm the milk, then whisk in the vanilla and egg. Add the mixture to the dry ingredients and combine to form a dough.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Knead in the sultanas, cherries, and marzipan until evenly distributed. Cover and let the dough rest for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Knead briefly, then shape the dough into a loaf. Place it on the prepared tray, cover, and leave to rise for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Heat the oven and bake for about 25 minutes, until golden brown and the center is fully set.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Brush the warm loaf with melted butter, then coat it with icing sugar. Cool and dust with more icing sugar before serving."
    }
  ],
