{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "caterpillar-cake",
  "name": "Caterpillar Cake",
  "subtitle": "A bright lime-and-coconut celebration cake",
  "description": "A lime-scented coconut sponge shaped into caterpillar segments, coated with green buttercream, and finished with playful candy and chocolate details.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "caster-sugar-plus-1-tbsp",
      "item": "caster sugar plus 1 tbsp",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 80,
      "unit": "g"
    },
    {
      "ingredient_id": "desiccated-coconut-blitzed-in-a-food-processor-until-fine",
      "item": "desiccated coconut blitzed in a food processor until fine",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "limes-zested",
      "item": "limes zested",
      "quantity": 2
    },
    {
      "ingredient_id": "unsalted-butter-softened",
      "item": "unsalted butter softened",
      "quantity": 350,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "icing-sugar-sifted",
      "item": "icing sugar sifted",
      "quantity": 700,
      "unit": "g"
    },
    {
      "ingredient_id": "limes-juiced-use-the-zested-limes",
      "item": "limes juiced (use the zested limes)",
      "quantity": 2
    },
    {
      "ingredient_id": "green-food-colouring-gel",
      "item": "green food colouring gel"
    },
    {
      "ingredient_id": "strawberry-flavoured-laces",
      "item": "strawberry-flavoured laces"
    },
    {
      "ingredient_id": "white-chocolate",
      "item": "white chocolate",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "liquorice-allsorts-and-laces",
      "item": "liquorice allsorts and laces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grease and line the cake tin with the extra butter. Whisk the eggs and caster sugar until thick and pale, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Fold in the flour, finely blitzed coconut, and lime zest. Transfer the batter to the tin and bake until risen and set, about 16 minutes.",
      "timer_minutes": 16
    },
    {
      "step": 3,
      "text": "Cool the cake completely, then cut and arrange it into connected caterpillar segments."
    },
    {
      "step": 4,
      "text": "Beat the softened butter until smooth. Gradually add the sifted icing sugar, then beat in the lime juice. Tint the buttercream green with food colouring gel."
    },
    {
      "step": 5,
      "text": "Cover the cake segments with the green buttercream and shape the frosting into an even caterpillar body."
    },
    {
      "step": 6,
      "text": "Melt the white chocolate, pipe or spoon small portions onto a lined surface, and chill until set, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Decorate the cake with the strawberry-flavoured laces, liquorice allsorts and laces, and set white-chocolate details."
    }
  ],
