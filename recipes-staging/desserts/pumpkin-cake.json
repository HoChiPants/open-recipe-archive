  "id": "pumpkin-cake",
  "name": "Pumpkin Cake",
  "subtitle": "A warmly spiced cake with pumpkin and walnuts",
  "description": "A tender pumpkin cake flavored with cinnamon, nutmeg, allspice, and cloves, with chopped walnuts throughout.",
  "meal_type": "dessert",
