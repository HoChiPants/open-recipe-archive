  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a cake pan."
    },
    {
      "step": 2,
      "text": "Blend the eggs, pumpkin puree, and vanilla extract until combined."
    },
    {
      "step": 3,
      "text": "In a separate bowl, mix the white sugar, all-purpose flour, baking soda, nutmeg, allspice, cinnamon, cloves, and salt."
    },
    {
      "step": 4,
      "text": "Stir the pumpkin mixture into the dry ingredients until combined, then fold in the walnuts."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake at 350°F until set, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
