{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "flourless-peanut-butter-chocolate-chip-cookies",
  "name": "Flourless Peanut Butter Chocolate Chip Cookies",
  "subtitle": "Soft-centered cookies with crisp edges and chocolate chips",
  "description": "A simple flourless cookie made by blending peanut butter, sugars, egg, vanilla, and baking soda, then folding in chocolate chips before baking.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the peanut butter, white sugar, and packed brown sugar until smooth. Stir in the egg, vanilla extract, and baking soda until evenly combined."
    },
    {
      "step": 3,
      "text": "Stir in the semisweet chocolate chips."
    },
    {
      "step": 4,
      "text": "Portion the dough into 12 cookies on a baking sheet, leaving space between them."
    },
    {
      "step": 5,
      "text": "Bake for 8 minutes, until the cookies are set at the edges and the centers are fully set; if checked, the egg-containing centers should reach 160°F.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Cool the cookies on the baking sheet until firm enough to handle."
    }
  ],
