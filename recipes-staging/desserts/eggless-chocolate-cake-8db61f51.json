  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Measure the baking soda and baking powder. Whisk them with the flour, 2 cups white sugar, and cocoa powder."
    },
    {
      "step": 3,
      "text": "Combine the water, vegetable oil, vinegar, and vanilla extract. Add the liquid mixture to the dry ingredients and whisk until smooth."
    },
    {
      "step": 4,
      "text": "Transfer the batter to a baking pan and bake until set, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Cool the cake for 30 minutes, then sprinkle with the remaining white sugar.",
      "timer_minutes": 30
    }
