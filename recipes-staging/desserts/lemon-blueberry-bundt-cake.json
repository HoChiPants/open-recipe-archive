  "id": "lemon-blueberry-bundt-cake",
  "name": "Lemon-Blueberry Bundt Cake",
  "subtitle": "A bright, berry-filled cake with lemon glaze",
  "description": "A tender lemon Bundt cake studded with blueberries and finished with a simple lemon glaze.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "lemon-cake-mix",
      "item": "lemon cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "15.25 ounce, divided"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "neufchatel-cheese",
      "item": "Neufchatel cheese",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "freshly-squeezed-lemon-juice",
      "item": "freshly squeezed lemon juice",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "at room temperature"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "blueberries",
      "item": "blueberries",
      "quantity": 1,
      "unit": "cup",
      "preparation": "fresh or frozen"
    },
    {
      "ingredient_id": "powdered-sugar",
      "item": "powdered sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "or more as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat a Bundt pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Reserve part of the divided cake mix for the blueberries. Beat the remaining mix with the milk, softened Neufchatel cheese, freshly squeezed lemon juice, eggs, and lemon zest for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Toss the blueberries with the reserved cake mix, then fold them into the batter."
    },
    {
      "step": 4,
      "text": "Pour the batter into the prepared pan and bake until the cake is set and a tester comes out clean, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Cool the cake in the pan for 30 minutes, then turn it out onto a serving plate.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Stir the powdered sugar with the lemon juice until smooth, adding more lemon juice as needed. Drizzle the glaze over the cooled cake."
    }
  ],
