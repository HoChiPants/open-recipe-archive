  "id": "honey-cinnamon-popcorn",
  "name": "Honey Cinnamon Popcorn",
  "subtitle": "Sweet, lightly spiced stovetop popcorn",
  "description": "Freshly popped corn is coated with honey, cinnamon, and salt for a quick sweet snack or dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "coconut-oil",
      "item": "coconut oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "popcorn-kernels",
      "item": "popcorn kernels",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the coconut oil in a large covered pot over medium heat."
    },
    {
      "step": 2,
      "text": "Add the popcorn kernels, cover, and cook for about 5 minutes, shaking the pot occasionally, until the popping slows.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Transfer the popcorn to a large bowl. Add the honey, salt to taste, and ground cinnamon, then toss until evenly coated."
    }
  ],
