  "id": "chocolate-peanut-butter-cornflake-cookies",
  "name": "Chocolate Peanut Butter Cornflake Cookies",
  "subtitle": "A crisp, no-bake chocolate treat",
  "description": "Chocolate and peanut butter coat cornflakes for a quick, crunchy cookie-style dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "chocolate-chips",
      "item": "chocolate chips",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cornflakes",
      "item": "cornflakes",
      "quantity": 3,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Line a tray or plate with parchment paper."
    },
    {
      "step": 2,
      "text": "Warm the chocolate chips and peanut butter together, stirring for 3 minutes, until melted and smooth.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the cornflakes and gently stir until evenly coated."
    },
    {
      "step": 4,
      "text": "Spoon the mixture into 12 portions on the prepared tray."
    },
    {
      "step": 5,
      "text": "Chill until set, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
