{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "caramel-popcorn-balls",
  "name": "Caramel Popcorn Balls",
  "subtitle": "Chewy caramel-coated popcorn shaped for sharing",
  "description": "Freshly popped popcorn is folded with a buttery brown-sugar caramel, then shaped into individual balls while warm.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 5,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "unpopped-popcorn",
      "item": "unpopped popcorn",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "packed-light-brown-sugar",
      "item": "packed light brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "light-corn-syrup",
      "item": "light corn syrup",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 0.66666698455811,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm part of the oil in a large covered pot over medium heat. Add the popcorn, cover, and shake the pot occasionally until popping slows. Transfer the popcorn to a large bowl, discarding unpopped kernels.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Combine the brown sugar, corn syrup, butter, and sweetened condensed milk in a saucepan. Bring the mixture to a simmer and cook until it reaches 240°F."
    },
    {
      "step": 3,
      "text": "Remove the caramel from the heat and stir in the vanilla extract."
    },
    {
      "step": 4,
      "text": "Pour the hot caramel over the popcorn and fold gently until evenly coated."
    },
    {
      "step": 5,
      "text": "Lightly coat your hands with the remaining oil. While the mixture is warm, shape it into 15 balls and set them aside to cool until firm."
    }
  ],
  "tags": [
    "snack",
    "dessert",
    "american",
    "popcorn"
  ],
  "seasons": [
    "year-round"
  ],
  "dietary": [
    "vegetarian"
  ],
  "allergens": [
    "milk"
  ],
  "equipment": [
    "large covered pot",
    "large mixing bowl",
    "saucepan",
    "candy or food thermometer"
  ],
