  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Beat the softened butter, cream cheese, and white sugar until smooth. Mix in the flour to form a firm dough."
    },
    {
      "step": 3,
      "text": "Shape the dough into small portions and press them into the cups of a mini muffin pan to form shells."
    },
    {
      "step": 4,
      "text": "Whisk the melted butter, eggs, vanilla, brown sugar, and honey until combined. Stir in the pecans."
    },
    {
      "step": 5,
      "text": "Fill each pastry shell with the pecan mixture."
    },
    {
      "step": 6,
      "text": "Bake until lightly browned, checking at 15 minutes and allowing up to 20 minutes as needed.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Cool the cups before serving."
    }
  ],
