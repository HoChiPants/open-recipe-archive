  "id": "pecan-filled-pastry-cups",
  "name": "Pecan-Filled Pastry Cups",
  "subtitle": "Tender pastry shells with a honeyed pecan filling",
  "description": "Small cream-cheese pastry cups filled with buttery brown sugar, honey, and chopped pecans, then baked until lightly browned.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
