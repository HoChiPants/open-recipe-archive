  "id": "banana-pudding-ice-cream",
  "name": "Banana Pudding Ice Cream",
  "subtitle": "Creamy banana ice cream with vanilla wafer pieces",
  "description": "A custard-style frozen dessert combining ripe mashed bananas, brown sugar, and crushed vanilla wafers.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
