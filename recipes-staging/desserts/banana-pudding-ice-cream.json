  "instructions": [
    {
      "step": 1,
      "text": "Warm the half-and-half, brown sugar, white sugar, and salt in a saucepan over medium heat, stirring until the sugars dissolve.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Gradually whisk some of the warm mixture into the beaten eggs, then return the mixture to the saucepan."
    },
    {
      "step": 3,
      "text": "Cook gently, stirring constantly, until the custard thickens and reaches 160°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Remove from the heat and whisk in the heavy cream and vanilla extract."
    },
    {
      "step": 5,
      "text": "Stir in the mashed bananas and crushed vanilla wafers.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Cool the mixture, then chill it for at least 2 hours."
    },
    {
      "step": 7,
      "text": "Churn the chilled mixture in an ice-cream maker according to the machine instructions, then freeze until firm."
    }
  ],
