  "id": "fresh-peach-cake",
  "name": "Fresh Peach Cake",
  "subtitle": "A tender cake layered with cinnamon-sugared peaches.",
  "description": "Make a simple butter cake, top it with seasoned fresh peaches, and bake until set for an easy fruit dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "at room temperature"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fresh-peaches",
      "item": "fresh peaches",
      "quantity": 4,
      "preparation": "peeled, pitted, and sliced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking pan for the cake."
    },
    {
      "step": 2,
      "text": "Beat the 0.75 cup sugar and room-temperature butter until smooth and creamy."
    },
    {
      "step": 3,
      "text": "Add the eggs one at a time, mixing after each addition."
    },
    {
      "step": 4,
      "text": "Combine the flour, baking powder, and salt, then mix the dry ingredients into the butter mixture until a batter forms."
    },
    {
      "step": 5,
      "text": "Spread the batter evenly in the prepared pan."
    },
    {
      "step": 6,
      "text": "Stir the 2 tablespoons sugar with the cinnamon. Toss the sliced peaches with the mixture, then arrange them over the batter."
    },
    {
      "step": 7,
      "text": "Bake for 50 minutes, or until the center is firm and a tester comes out clean.",
      "timer_minutes": 50
    },
    {
      "step": 8,
      "text": "Cool the cake in the pan, then transfer it to a serving dish and slice."
    }
  ],
