  "id": "arctic-roll",
  "name": "Arctic Roll",
  "subtitle": "Vanilla cream and strawberry sponge roll",
  "description": "A light vanilla sponge wrapped around frozen vanilla cream and a bright strawberry filling.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 35,
    "cook_minutes": 20
  },
  "ingredients": [
