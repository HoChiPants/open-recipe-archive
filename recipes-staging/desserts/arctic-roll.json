  "instructions": [
    {
      "step": 1,
      "text": "Line a shallow roll tin with baking paper and grease it with the butter. Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the 3 eggs and 100 g golden caster sugar for 3 minutes, until thick. Fold in the plain flour, baking powder, and vanilla extract. Spread the batter in the tin and bake until risen and springy.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Turn the sponge onto sugar-dusted baking paper, trim the edges, and roll it up while warm. Leave it to cool, then unroll.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "For the frozen filling, whisk the separated egg yolks with the icing sugar and seeds scraped from the vanilla pod. Whip the double cream to stiff peaks, then fold it into the yolk mixture. Whisk the egg whites until firm and fold them through."
    },
    {
      "step": 5,
      "text": "Spread the frozen filling in a neat log on baking paper and freeze until firm. Prepare the strawberry mixture by simmering the strawberries, lemon juice, and 200 g golden caster sugar until thickened; cool completely.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Spread the cooled strawberry mixture over the sponge, place the frozen filling along one edge, and roll the sponge around it. Wrap and freeze until set.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Slice the roll and dust with icing sugar before serving."
    }
  ],
