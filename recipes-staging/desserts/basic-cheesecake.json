{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "basic-cheesecake",
  "name": "Basic Cheesecake",
  "subtitle": "A creamy baked cheesecake with a spiced walnut crumb crust.",
  "description": "Prepare a buttery graham cracker crust, fill it with a smooth cream cheese mixture, and bake until fully set before chilling.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "graham-cracker-crumbs",
      "item": "graham cracker crumbs",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 5,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "finely-chopped-walnuts",
      "item": "finely chopped walnuts",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 3,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the graham cracker crumbs, melted butter, finely chopped walnuts, brown sugar, ground cinnamon, ground nutmeg, and white sugar until evenly moistened."
    },
    {
      "step": 3,
      "text": "Press the crumb mixture into the bottom of the prepared cheesecake pan."
    },
    {
      "step": 4,
      "text": "Bake the crust for 10 minutes, then cool it completely.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Whisk the cream cheese, white sugar, brown sugar, sour cream, and heavy cream until smooth. Mix in the all-purpose flour and vanilla extract, then whisk in the eggs just until incorporated."
    },
    {
      "step": 6,
      "text": "Transfer the filling to the cooled crust and bake for 70 minutes, until the center is firm and fully set or reaches 160°F.",
      "timer_minutes": 70
    },
    {
      "step": 7,
      "text": "Chill the cheesecake for 6 hours before serving.",
      "timer_minutes": 360
    }
  ],
