  "id": "white-cake",
  "name": "White Cake",
  "subtitle": "A light, tender cake with vanilla-almond flavor",
  "description": "A classic white cake made with whipped egg whites, butter, milk, and gentle vanilla-almond notes.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "cake-flour",
      "item": "cake flour",
      "quantity": 2.75,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 4,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 4
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare the cake pan or pans as needed."
    },
    {
      "step": 2,
      "text": "Combine the sifted cake flour, baking powder, and salt."
    },
    {
      "step": 3,
      "text": "Whisk the egg whites with part of the sugar until soft peaks form, then continue adding the remaining sugar until incorporated."
    },
    {
      "step": 4,
      "text": "Beat the butter until smooth. Gradually whisk in the sugar, then add the milk, vanilla extract, and almond extract until smooth."
    },
    {
      "step": 5,
      "text": "Mix the dry ingredients into the butter mixture, then gently fold in the whipped egg whites until evenly combined."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan or pans and bake at 350°F until lightly golden and a tester comes out clean, about 35 minutes. The center should be firm and fully set, reaching 160°F if checked with a thermometer.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Cool in the pan for 10 minutes, then transfer the cake to a rack and cool completely before serving.",
      "timer_minutes": 35
    }
  ],
