  "id": "devil-s-food-brownie-cake",
  "name": "Devil's Food Brownie Cake",
  "subtitle": "Rich chocolate cake with a smooth ganache topping",
  "description": "A dense, chocolate-forward dessert combining brownie and devil's food cake mixes, finished with a simple semisweet chocolate topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 50,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "nonstick-cooking-spray",
      "item": "nonstick cooking spray"
    },
    {
      "ingredient_id": "fudge-brownie-mix",
      "item": "fudge brownie mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18 ounce"
    },
    {
      "ingredient_id": "devil-s-food-cake-mix",
      "item": "devil's food cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "15.25 ounce"
    },
    {
      "ingredient_id": "cold-brewed-coffee",
      "item": "cold brewed coffee",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "oil",
      "item": "oil",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1,
      "unit": "package",
      "preparation": "6 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat a cake pan with nonstick cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk the fudge brownie mix, devil's food cake mix, cold brewed coffee, oil, and eggs until the batter is smooth and fully combined."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and bake until the center is set and a tester comes out with moist crumbs.",
      "timer_minutes": 50
    },
    {
      "step": 4,
      "text": "Cool the cake in the pan for 10 minutes, then let it cool completely for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Warm the heavy whipping cream for 3 minutes without boiling. Pour it over the semisweet chocolate chips and stir until melted and smooth.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Spread the chocolate topping over the cooled cake and serve."
    }
  ],
