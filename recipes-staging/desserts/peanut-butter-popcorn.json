  "id": "peanut-butter-popcorn",
  "name": "Peanut Butter Popcorn",
  "subtitle": "A quick sweet-and-salty popcorn treat",
  "description": "Melted marshmallows, brown sugar, margarine, and peanut butter coat freshly popped popcorn for an easy dessert or snack.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "microwave-popcorn",
      "item": "microwave popcorn",
      "quantity": 2,
      "unit": "package",
      "preparation": "3.5 ounce, popped"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "marshmallows",
      "item": "marshmallows",
      "quantity": 20,
      "unit": "large"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Transfer the popped popcorn to a large microwave-safe bowl."
    },
    {
      "step": 2,
      "text": "Add the margarine, brown sugar, and marshmallows. Microwave until the mixture is melted, about 5 minutes, stirring as needed.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the peanut butter until smooth."
    },
    {
      "step": 4,
      "text": "Stir the coating through the popcorn and brown sugar mixture until evenly combined."
    }
  ],
