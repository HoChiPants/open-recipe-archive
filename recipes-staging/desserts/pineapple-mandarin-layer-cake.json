  "id": "pineapple-mandarin-layer-cake",
  "name": "Pineapple Mandarin Layer Cake",
  "subtitle": "A chilled fruit-filled cake with creamy vanilla topping",
  "description": "Bake a yellow cake, split it into layers, and fill it with a creamy mixture of pineapple, mandarin oranges, pudding, and whipped topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 35,
    "cook_minutes": 25,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "yellow-cake-mix",
      "item": "yellow cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 8,
      "unit": "ounces"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "pineapple-with-juice",
      "item": "pineapple with juice",
      "quantity": 1,
      "unit": "can",
      "preparation": "20 ounce, crushed"
    },
    {
      "ingredient_id": "mandarin-oranges",
      "item": "mandarin oranges",
      "quantity": 2,
      "unit": "can",
      "preparation": "8 ounce, drained"
    },
    {
      "ingredient_id": "instant-vanilla-pudding-mix",
      "item": "instant vanilla pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.5 ounce"
    },
    {
      "ingredient_id": "8-ounce-container-frozen-whipped-topping",
      "item": "(8 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare and bake the yellow cake mix as directed on the package, using two round cake pans. Bake until set, about 25 minutes; cool completely.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Beat the cream cheese with the confectioners' sugar until smooth. Stir in the crushed pineapple with its juice, drained mandarin oranges, and instant vanilla pudding mix."
    },
    {
      "step": 3,
      "text": "Fold in the thawed whipped topping until evenly combined."
    },
    {
      "step": 4,
      "text": "Cut each cooled cake layer horizontally to make four layers. Transfer one layer to a serving plate and spread with part of the filling. Repeat with the remaining cake layers and filling, ending with filling on top."
    },
    {
      "step": 5,
      "text": "Garnish with the reserved pineapple and mandarin oranges, then chill before serving.",
      "timer_minutes": 30
    }
  ],
