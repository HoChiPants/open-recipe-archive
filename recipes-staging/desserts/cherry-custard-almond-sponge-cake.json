  "id": "cherry-custard-almond-sponge-cake",
  "name": "Cherry Custard Almond Sponge Cake",
  "subtitle": "Almond sponge layered with cherries and custard cream",
  "description": "A tender almond sponge paired with thickened cherries and a lightly sweetened custard-cream filling.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 35
  },
  "ingredients": [
