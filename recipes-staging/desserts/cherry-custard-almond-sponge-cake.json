  "instructions": [
    {
      "step": 1,
      "text": "Grease the tins with extra softened butter and preheat the oven."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter, 220 g golden caster sugar, and the icing sugar until light and smooth, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Beat in the eggs. Fold in the flour, ground almonds, and baking powder, then mix in the milk until just combined."
    },
    {
      "step": 4,
      "text": "Divide the batter between the prepared tins and bake until firm.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Let the sponges cool briefly before assembling.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Cook the cherries with the remaining golden caster sugar, vanilla bean paste, lemon juice, and optional liqueur; simmer with some of the softened butter until thickened."
    },
    {
      "step": 7,
      "text": "Whisk the double cream, custard, and icing sugar until thickened, then fold in the cherry mixture.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Layer the cooled sponges with the cherry custard cream. Finish with the remaining cherries and dust with icing sugar before serving."
    }
  ],
