  "id": "bread-and-butter-pudding-toast",
  "name": "Bread and Butter Pudding Toast",
  "subtitle": "Custard-soaked brioche with caramelized sugar",
  "description": "Brioche is soaked in a creamy egg mixture, cooked until golden, finished with melted sugar, and served with softly whipped crème fraîche.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "brioche-loaf",
      "item": "brioche loaf",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 120,
      "unit": "g"
    },
    {
      "ingredient_id": "irish-cream-liqueur",
      "item": "Irish cream liqueur",
      "quantity": 75,
      "unit": "ml"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "cre-me-frai-che",
      "item": "crème fraîche",
      "quantity": 250,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare the brioche and cut it into slices or manageable pieces."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, whole milk, and Irish cream liqueur together. Soak the brioche in the mixture, then arrange it in the desired shape."
    },
    {
      "step": 3,
      "text": "Preheat the oven and melt the unsalted butter. Brush or spoon the butter over the brioche, then cook with the golden caster sugar until golden brown, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Transfer the remaining golden caster sugar over the top and grill for 1 minute, until melted.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Cool briefly. Whisk the crème fraîche to soft peaks and serve alongside the toast."
    }
  ],
