  "id": "peach-cobbler-a8fb998a",
  "name": "Peach Cobbler",
  "subtitle": "A warm, cinnamon-scented peach dessert with a tender baked topping.",
  "description": "Fresh peaches are layered with a simple cinnamon batter and baked until golden and bubbling.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "fresh-peaches",
      "item": "fresh peaches",
      "quantity": 4,
      "unit": "cups",
      "preparation": "peeled, pitted, and sliced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Pour the melted butter into a baking dish."
    },
    {
      "step": 2,
      "text": "Toss the peaches with 2 tablespoons of white sugar, then arrange them evenly over the butter."
    },
    {
      "step": 3,
      "text": "Stir together the remaining white sugar, flour, milk, cinnamon, baking powder, and salt until combined."
    },
    {
      "step": 4,
      "text": "Pour the batter evenly over the peaches without stirring."
    },
    {
      "step": 5,
      "text": "Bake until the topping is golden brown and the peaches are bubbling.",
      "timer_minutes": 45
    }
  ],
