  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the melted butter and chocolate chips, stirring until smooth."
    },
    {
      "step": 3,
      "text": "Whisk together the flour, brown sugar, and white sugar. Stir in the chocolate mixture, then the beaten eggs and vanilla."
    },
    {
      "step": 4,
      "text": "Fold in the pecans and coconut. Transfer the filling to the deep-dish pie crust."
    },
    {
      "step": 5,
      "text": "Bake until the center is firm and fully set, about 35 minutes; continue up to 40 minutes if needed. For a thermometer check, the center should reach 160°F.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Cool before slicing and serving."
    }
  ],
