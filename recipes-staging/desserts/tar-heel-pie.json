  "id": "tar-heel-pie",
  "name": "Tar Heel Pie",
  "subtitle": "A rich chocolate-pecan pie with coconut",
  "description": "A deep-dish pie filled with melted chocolate, brown sugar, pecans, and coconut, baked until set.",
  "meal_type": "dessert",
  "cuisine": "American",
