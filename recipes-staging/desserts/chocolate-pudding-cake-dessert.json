  "id": "chocolate-pudding-cake-dessert",
  "name": "Chocolate Pudding Cake Dessert",
  "subtitle": "Layered chocolate cake, pudding, cream, and toffee",
  "description": "A chilled layered dessert combining baked chocolate cake, coffee-enhanced pudding, whipped topping, and crushed toffee.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
