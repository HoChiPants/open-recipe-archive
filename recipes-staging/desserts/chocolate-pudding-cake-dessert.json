      "quantity": 6,
      "preparation": "frozen and crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease a baking dish."
    },
    {
      "step": 2,
      "text": "Mix the cake mix, water, eggs, and vegetable oil until evenly combined. Transfer the batter to the prepared dish."
    },
    {
      "step": 3,
      "text": "Bake for 30 minutes, or until the cake is set. Cool completely, then crumble or cut it into pieces.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Whisk the pudding mix and milk until thickened. Stir in the brewed coffee."
    },
    {
      "step": 5,
      "text": "Layer the cake pieces, pudding mixture, thawed whipped topping, and crushed toffee in the serving dish, repeating as needed and finishing with the topping and toffee."
    },
    {
      "step": 6,
      "text": "Chill until ready to serve."
    }
  ],
