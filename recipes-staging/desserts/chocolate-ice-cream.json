{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-ice-cream",
  "name": "Chocolate Ice Cream",
  "subtitle": "Rich no-churn chocolate ice cream",
  "description": "A creamy chocolate ice cream made with dark chocolate, cocoa, condensed milk, and whipped cream, finished with optional sea salt.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "dark-chocolate-at-least-70-cocoa-solids",
      "item": "dark chocolate (at least 70% cocoa solids)",
      "quantity": 200,
      "unit": "g",
      "preparation": "chopped into small pieces"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 500,
      "unit": "ml"
    },
    {
      "ingredient_id": "can-sweetened-condensed-milk",
      "item": "can sweetened condensed milk",
      "quantity": 340,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "organic-cocoa-powder-sifted",
      "item": "organic cocoa powder sifted",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "milk-chocolate-chips",
      "item": "milk chocolate chips",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "sea-salt-flakes-to-serve-optional",
      "item": "sea salt flakes to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the chopped dark chocolate and milk chocolate chips in a microwave-safe bowl. Microwave in short intervals, stirring between each, until melted and smooth. Cool slightly."
    },
    {
      "step": 2,
      "text": "Whisk the double cream, condensed milk, and vanilla extract for 3 minutes, until thickened.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Whisk the cooled melted chocolate with the sifted cocoa powder until smooth, then fold it into the whipped cream mixture."
    },
    {
      "step": 4,
      "text": "Transfer to a freezer-safe container and freeze until firm, about 6 hours.",
      "timer_minutes": 360
    },
    {
      "step": 5,
      "text": "Serve with optional sea salt flakes."
    }
  ],
  "tags": [
    "dessert",
    "chocolate",
    "ice-cream",
    "no-churn",
    "make-ahead"
  ],
  "seasons": [
    "year-round"
  ],
  "dietary": [
    "vegetarian"
  ],
  "allergens": [
    "milk"
  ],
  "equipment": [
    "microwave-safe bowl",
    "electric whisk",
    "freezer-safe container"
  ],
