  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Toss the chopped green tomatoes with the tablespoon of salt. Let stand for 10 minutes, then drain well.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the flour, baking soda, cinnamon, nutmeg, and the remaining salt together."
    },
    {
      "step": 4,
      "text": "Whisk the sugar and butter until blended, then whisk in the eggs."
    },
    {
      "step": 5,
      "text": "Stir the dry ingredients into the butter mixture until combined. Fold in the raisins, walnuts, and drained tomatoes."
    },
    {
      "step": 6,
      "text": "Transfer the batter to a prepared baking pan and bake at 350°F until set, about 40 minutes.",
      "timer_minutes": 40
    }
  ],
