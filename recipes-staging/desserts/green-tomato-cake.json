  "id": "green-tomato-cake",
  "name": "Green Tomato Cake",
  "subtitle": "A warmly spiced cake with tangy tomatoes, raisins, and walnuts",
  "description": "Chopped green tomatoes add moisture and gentle tartness to this spiced cake, finished with raisins and walnuts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
