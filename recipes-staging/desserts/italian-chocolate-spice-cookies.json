  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the white sugar, eggs, butter, vanilla extract, and confectioners' sugar until blended."
    },
    {
      "step": 3,
      "text": "Stir together the flour, larger measure of cocoa powder, baking powder, baking soda, salt, walnuts, cloves, allspice, cinnamon, and nutmeg."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the wet mixture and stir in the milk to form a firm dough."
    },
    {
      "step": 5,
      "text": "Shape the dough into small rounds and arrange them on baking sheets."
    },
    {
      "step": 6,
      "text": "Bake for 12 minutes, until firm and the centers are fully set.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Let the cookies rest briefly, then cool completely."
    },
    {
      "step": 8,
      "text": "Combine the confectioners' sugar, smaller measure of cocoa powder, white sugar, and milk to make a glaze."
    },
    {
      "step": 9,
      "text": "Transfer the cooled cookies to a serving surface and garnish with the glaze."
    }
  ],
