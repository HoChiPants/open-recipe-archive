  "id": "vegan-chocolate-chip-cookies",
  "name": "Vegan Chocolate Chip Cookies",
  "subtitle": "Soft, chewy cookies with chocolate chips",
  "description": "A simple dairy-free and egg-free cookie dough made with coconut oil, almond milk, and brown sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "coconut-oil",
      "item": "coconut oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "almond-milk",
      "item": "almond milk",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegan-chocolate-chips",
      "item": "vegan chocolate chips",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Whisk the coconut oil and brown sugar together for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the almond milk and vanilla extract together for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "In a separate bowl, whisk together the all-purpose flour, baking soda, baking powder, and salt."
    },
    {
      "step": 5,
      "text": "Add the almond milk mixture and dry ingredients to the sugar mixture, then combine into a dough."
    },
    {
      "step": 6,
      "text": "Fold in the vegan chocolate chips."
    },
    {
      "step": 7,
      "text": "Portion and shape the dough on the prepared baking sheet."
    },
    {
      "step": 8,
      "text": "Bake for 8 minutes, until golden brown.",
      "timer_minutes": 8
    }
  ],
