  "id": "apple-crumble-pie",
  "name": "Apple Crumble Pie",
  "subtitle": "Tender cinnamon apples beneath a buttery crumb topping",
  "description": "A classic baked apple dessert with a spiced fruit filling and crisp crumble topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
