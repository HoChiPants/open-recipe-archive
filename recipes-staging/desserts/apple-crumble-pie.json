    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 6,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Place the pie crust in a deep-dish pie plate if needed."
    },
    {
      "step": 2,
      "text": "Combine ½ cup white sugar with the cinnamon. Toss with the sliced apples, then arrange the filling in the crust."
    },
    {
      "step": 3,
      "text": "Combine the remaining white sugar and flour. Cut in the butter until the mixture forms coarse crumbs, then scatter it over the apples."
    },
    {
      "step": 4,
      "text": "Bake until the topping is lightly browned and the filling is tender.",
      "timer_minutes": 40
    }
  ],
