  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter, white sugar, and packed brown sugar until smooth. Whisk in the eggs until fully incorporated."
    },
    {
      "step": 3,
      "text": "In a separate bowl, prepare the all-purpose flour, baking soda, and salt. Stir the dry mixture into the butter mixture until a firm dough forms."
    },
    {
      "step": 4,
      "text": "Stir in the chopped black walnuts. Shape the dough into portions and arrange them on baking sheets."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, until the cookies are set with a firm, fully cooked center reaching 160°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Prepare the baked cookies for serving after they have cooled enough to handle."
    }
  ],
