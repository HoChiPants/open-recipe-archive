  "id": "black-walnut-cookies",
  "name": "Black Walnut Cookies",
  "subtitle": "Chewy brown-sugar cookies with chopped black walnuts",
  "description": "A straightforward drop-cookie dough combining butter, two sugars, and black walnuts for a crisp-edged, tender dessert.",
  "meal_type": "dessert",
