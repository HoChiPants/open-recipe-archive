  "schema_version": "1.0.0",
  "id": "brown-sugar-pie",
  "name": "Brown Sugar Pie",
  "subtitle": "A simple, rich pie with caramel-like brown sugar flavor.",
  "description": "A French-style dessert combining brown sugar, evaporated milk, butter, and vanilla in a gently simmered filling baked until set.",
  "meal_type": "dessert",
  "cuisine": "French",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Combine the flour and brown sugar in a mixing bowl."
    },
    {
      "step": 3,
      "text": "Stir in the evaporated milk, butter, salt, and vanilla extract until evenly blended."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a pie dish and bring it to a gentle simmer as directed by the preparation method."
    },
    {
      "step": 5,
      "text": "Bake at 400°F for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Reduce the oven temperature to 350°F and continue baking for 25 minutes, until the center is firm and fully set.",
      "timer_minutes": 25
    }
  ],
