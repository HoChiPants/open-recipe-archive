      "item": "white chocolate",
      "quantity": 175,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Lightly oil the baking tin or baking sheets."
    },
    {
      "step": 2,
      "text": "Warm the butter, muscovado sugar, and golden syrup together until melted and smooth."
    },
    {
      "step": 3,
      "text": "Stir in the flour, chopped stem ginger, flaked almonds, and orange zest."
    },
    {
      "step": 4,
      "text": "Spoon the mixture into 12 spaced portions, leaving room for them to spread."
    },
    {
      "step": 5,
      "text": "Bake until golden and bubbling at the edges.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Leave the biscuits on the tin for about 2 minutes, then transfer them to a rack while still firm enough to handle.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Melt the dark chocolate and white chocolate separately in short microwave bursts, stirring between bursts until smooth."
    },
    {
      "step": 8,
      "text": "Spread the melted chocolate over the flat underside of each cooled biscuit, using either chocolate or both for a marbled finish."
    },
    {
      "step": 9,
      "text": "Let the chocolate set before serving."
    }
  ],
