  "id": "almond-orange-and-ginger-florentines",
  "name": "Almond, Orange and Ginger Florentines",
  "subtitle": "Crisp almond biscuits with citrus, ginger, and chocolate",
  "description": "Thin, lacy biscuits combine toasted almonds, orange zest, and stem ginger with dark and white chocolate bases.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "flavourless-oil-for-the-tin",
      "item": "flavourless oil for the tin"
    },
    {
      "ingredient_id": "butter",
      "item": "salted butter",
      "quantity": 50,
      "unit": "g"
    },
    {
