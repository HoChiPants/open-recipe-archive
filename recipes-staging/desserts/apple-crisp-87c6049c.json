  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Combine the plain flour, rolled oats, flaked almonds or chopped pecans, light muscovado sugar, and ground cinnamon. Rub in the cubed butter until coarse crumbs form, then chill the topping briefly."
    },
    {
      "step": 3,
      "text": "Toss the sliced apples with the golden caster sugar, lemon zest, and lemon juice until evenly coated. Spread the fruit in the baking dish and cover with the chilled topping."
    },
    {
      "step": 4,
      "text": "Bake until the topping is crisp and the apples are tender, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Serve warm with vanilla ice cream or custard."
    }
  ],
