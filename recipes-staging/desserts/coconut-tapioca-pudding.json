{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "coconut-tapioca-pudding",
  "name": "Coconut Tapioca Pudding",
  "subtitle": "Creamy coconut pudding with tender tapioca pearls",
  "description": "A lightly sweet coconut pudding thickened with quick-cooking tapioca and egg, finished with vanilla.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "quick-cooking-pearl-tapioca",
      "item": "quick cooking pearl tapioca",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "coconut-milk",
      "item": "coconut milk",
      "quantity": 2,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the tapioca, coconut milk, and salt in a saucepan. Heat over medium heat, stirring frequently, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the sugar and continue heating until the mixture reaches a gentle simmer."
    },
    {
      "step": 3,
      "text": "Whisk the egg in a bowl until smooth. Whisk a small amount of the hot tapioca mixture into the egg to temper it."
    },
    {
      "step": 4,
      "text": "Stir the tempered egg mixture back into the saucepan. Simmer, stirring constantly, until thickened and the pudding reaches 160°F with a fully set center.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Let the pudding stand for 10 minutes, then stir in the vanilla extract and serve.",
      "timer_minutes": 10
    }
  ],
