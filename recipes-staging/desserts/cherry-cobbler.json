  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Spread the cherry pie filling evenly in a baking dish. Sprinkle the yellow cake mix over the filling, followed by the brown sugar."
    },
    {
      "step": 3,
      "text": "Scatter the butter pieces evenly over the top."
    },
    {
      "step": 4,
      "text": "Bake for 45 minutes, until the topping is golden brown and the filling is bubbling.",
      "timer_minutes": 45
    }
