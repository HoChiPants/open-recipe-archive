  "id": "cherry-cobbler",
  "name": "Cherry Cobbler",
  "subtitle": "A quick fruit dessert with a crisp golden topping",
  "description": "Cherry pie filling is layered with cake mix, brown sugar, and butter, then baked until golden and bubbling.",
  "meal_type": "dessert",
