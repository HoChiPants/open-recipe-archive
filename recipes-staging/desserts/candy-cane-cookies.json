{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "candy-cane-cookies",
  "name": "Candy Cane Cookies",
  "subtitle": "Twisted two-color cookies for holiday plates",
  "description": "A buttery cookie dough is divided, tinted red and green, twisted into candy-cane shapes, and baked until set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "large cookies"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 14
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 170,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 115,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vanilla-bean-paste",
      "item": "vanilla bean paste",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "green-and-red-gel-food-colourings",
      "item": "green and red gel food colourings"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare baking trays."
    },
    {
      "step": 2,
      "text": "Whisk the butter and sugar until smooth and creamy."
    },
    {
      "step": 3,
      "text": "Mix in the flour, milk, and vanilla bean paste to form a dough."
    },
    {
      "step": 4,
      "text": "Divide the dough into portions, tinting portions with the green and red gel food colourings. Leave one portion plain if desired."
    },
    {
      "step": 5,
      "text": "Roll the colored and plain dough into thin ropes, pair contrasting ropes, twist them together, and curve each piece into a candy-cane shape."
    },
    {
      "step": 6,
      "text": "Arrange the shaped cookies on the prepared trays, leaving space between them."
    },
    {
      "step": 7,
      "text": "Bake for 14 minutes, until set.",
      "timer_minutes": 14
    },
    {
      "step": 8,
      "text": "Cool the cookies on the trays before serving."
    }
  ],
