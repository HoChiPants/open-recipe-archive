  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking pan for the bars."
    },
    {
      "step": 2,
      "text": "Combine the 2 cups flour, oats, brown sugar, baking soda, and salt. Stir in the melted butter until a crumbly mixture forms."
    },
    {
      "step": 3,
      "text": "Press part of the crumb mixture into the prepared pan and bake for 18 minutes.",
      "timer_minutes": 18
    },
    {
      "step": 4,
      "text": "Meanwhile, combine the caramel topping and the remaining 1/2 cup flour in a saucepan. Bring to a gentle simmer and cook for 5 minutes, stirring.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Arrange the apples and walnuts over the baked base. Pour the warm caramel mixture over them, then cover with the remaining crumb mixture."
    },
    {
      "step": 6,
      "text": "Bake until the top is golden brown, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Cool before cutting into bars."
    }
  ],
