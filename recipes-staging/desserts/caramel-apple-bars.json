  "id": "caramel-apple-bars",
  "name": "Caramel Apple Bars",
  "subtitle": "Oat-and-apple dessert bars with a caramel layer",
  "description": "A chewy oat base supports sliced apples, walnuts, and a warm caramel topping, finished with a golden crumb layer.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
