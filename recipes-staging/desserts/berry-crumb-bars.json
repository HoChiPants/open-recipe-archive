  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine 1 cup sugar, baking powder, flour, shortening, egg, salt, and cinnamon until a crumbly dough forms."
    },
    {
      "step": 3,
      "text": "Press about two-thirds of the mixture into the bottom of a baking pan."
    },
    {
      "step": 4,
      "text": "Stir the raspberries with 1/2 cup sugar and cornstarch, then spread the filling over the crust."
    },
    {
      "step": 5,
      "text": "Scatter the remaining crumb mixture over the berries."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, until the center is firm and fully set.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Cool before cutting into bars."
    }
  ],
