  "id": "berry-crumb-bars",
  "name": "Berry Crumb Bars",
  "subtitle": "Raspberry-filled bars with a tender crumb topping",
  "description": "A simple shortcrust-style dessert layered with raspberries and finished with a cinnamon crumb topping.",
  "meal_type": "dessert",
