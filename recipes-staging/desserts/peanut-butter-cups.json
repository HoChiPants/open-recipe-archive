  "id": "peanut-butter-cups",
  "name": "Peanut Butter Cups",
  "subtitle": "Chocolate shells with a crisp, creamy peanut butter center",
  "description": "Make layered chocolate cups with a crunchy peanut butter filling, then freeze until firm.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "milk-chocolate-chips",
      "item": "milk chocolate chips",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "crunchy-peanut-butter",
      "item": "crunchy peanut butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "graham-cracker-crumbs",
      "item": "graham cracker crumbs",
      "quantity": 0.66666668653488,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the milk chocolate chips and shortening; heat until melted, stirring until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Coat the bottoms and sides of prepared cup wells with the melted chocolate. Chill until set."
    },
    {
      "step": 3,
      "text": "Combine the butter and crunchy peanut butter; heat until melted and stir together.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Stir in the confectioners' sugar and graham cracker crumbs to make the filling."
    },
    {
      "step": 5,
      "text": "Prepare the remaining melted chocolate, adding the reserved chocolate chips as needed, and stir until smooth."
    },
    {
      "step": 6,
      "text": "Transfer the peanut butter filling into the chilled chocolate cups and cover with the melted chocolate."
    },
    {
      "step": 7,
      "text": "Freeze until firm.",
      "timer_minutes": 120
    }
  ],
