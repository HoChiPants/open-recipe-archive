    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "yellow-cake-mix",
      "item": "yellow cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "15.25 ounce"
    },
    {
      "ingredient_id": "mandarin-orange-segments",
      "item": "mandarin orange segments",
      "quantity": 1,
      "unit": "can",
      "preparation": "11 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "pineapple-with-juice",
      "item": "pineapple with juice",
      "quantity": 1,
      "unit": "can",
      "preparation": "20 ounce, crushed"
    },
    {
      "ingredient_id": "8-ounce-container-frozen-whipped-topping",
      "item": "(8 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "instant-vanilla-pudding-mix",
      "item": "instant vanilla pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.5 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a cake pan for the batter."
    },
    {
      "step": 2,
      "text": "Combine the cake mix, mandarin orange segments, eggs, vegetable oil, and pineapple with juice. Mix until evenly blended."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and bake at 350°F until set, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "Cool the cake in the pan for 30 minutes, until set.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Whisk the pineapple with juice and instant vanilla pudding mix until smooth, then fold in the thawed whipped topping."
    },
    {
      "step": 6,
      "text": "Spread the topping over the cooled cake before serving."
    }
  ],
