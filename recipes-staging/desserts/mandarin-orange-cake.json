  "id": "mandarin-orange-cake",
  "name": "Mandarin Orange Cake",
  "subtitle": "A moist citrus cake with pineapple topping",
  "description": "A simple yellow cake enriched with mandarin oranges and finished with a creamy pineapple topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
