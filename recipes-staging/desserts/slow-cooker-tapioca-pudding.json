  "instructions": [
    {
      "step": 1,
      "text": "Stir the milk, sugar, tapioca, and lightly beaten eggs together in a slow cooker."
    },
    {
      "step": 2,
      "text": "Cook until the tapioca is tender, the pudding is thick, and the center reaches 160°F and is fully set, about 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Serve warm or chilled."
    }
