  "id": "cinnamon-apple-cake",
  "name": "Cinnamon Apple Cake",
  "subtitle": "A tender apple cake with a cinnamon-sugar finish",
  "description": "A simple American cake combining chopped apples, cream cheese, and cinnamon sugar in a warmly spiced dessert.",
  "meal_type": "dessert",
