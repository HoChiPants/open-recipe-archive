  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat a cake pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk 1.5 cups white sugar, cream cheese, butter, and vanilla extract until smooth. Whisk in the eggs one at a time."
    },
    {
      "step": 3,
      "text": "Whisk the flour, baking powder, and salt together, then stir the dry mixture into the cream cheese mixture until just combined."
    },
    {
      "step": 4,
      "text": "Stir in the chopped apples. Combine 0.25 cup white sugar with the ground cinnamon."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and sprinkle the cinnamon-sugar mixture over the top."
    },
    {
      "step": 6,
      "text": "Bake for 75 minutes, until the center is firm and fully set or reaches 160°F on a food thermometer.",
      "timer_minutes": 75
    },
    {
      "step": 7,
      "text": "Cool the cake in the pan for 45 minutes before serving.",
      "timer_minutes": 45
    }
  ],
