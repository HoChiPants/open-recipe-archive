  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease and line the cake tins with some of the cubed butter reserved for the tins."
    },
    {
      "step": 2,
      "text": "Melt the cubed butter with the chopped chocolate and brown sugar until smooth. Let the mixture cool slightly, then beat in the eggs."
    },
    {
      "step": 3,
      "text": "Whisk together the flour, cocoa powder, baking powder, bicarbonate of soda, salt, ginger, cinnamon, and nutmeg. Fold the dry mixture into the chocolate mixture, adding the milk to make a thick batter."
    },
    {
      "step": 4,
      "text": "Divide the batter between the prepared tins and bake until risen and set, about 30 minutes. Cool in the tins for 5 minutes, then transfer to a rack and cool completely.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Beat the softened butter until smooth. Gradually whisk in the icing sugar, then add the vanilla, ginger, cinnamon, and nutmeg. Continue beating until thick and creamy."
    },
    {
      "step": 6,
      "text": "Trim the cooled cakes if needed, spread with some of the buttercream, stack, and cover the cake with the remaining buttercream."
    }
  ],
