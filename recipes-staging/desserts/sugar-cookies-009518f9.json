  "id": "sugar-cookies-009518f9",
  "name": "Sugar Cookies",
  "subtitle": "Tender, lightly browned cookies with a crisp sugar finish",
  "description": "Mix a buttery dough, chill it, roll and cut it, then bake until lightly browned.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20,
    "inactive_minutes": 125
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cream-of-tartar",
      "item": "cream of tartar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "granulated-sugar-for-decoration",
      "item": "granulated sugar for decoration",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened butter, sifted confectioners' sugar, cream of tartar, and granulated sugar for decoration until smooth."
    },
    {
      "step": 2,
      "text": "Whisk in the egg, vanilla extract, and almond extract until blended."
    },
    {
      "step": 3,
      "text": "Combine the all-purpose flour, baking soda, and cream of tartar, then blend the dry mixture into the butter mixture to form a dough."
    },
    {
      "step": 4,
      "text": "Chill the dough for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Preheat the oven to 375°F and prepare baking sheets."
    },
    {
      "step": 6,
      "text": "Roll out the chilled dough on a lightly floured surface, cut into cookies, and transfer them to the prepared sheets."
    },
    {
      "step": 7,
      "text": "Bake in batches until lightly browned and the centers are set, about 8 minutes per batch.",
      "timer_minutes": 8
    },
    {
      "step": 8,
      "text": "Cool the cookies on the baking sheets for 5 minutes.",
      "timer_minutes": 5
    }
  ],
