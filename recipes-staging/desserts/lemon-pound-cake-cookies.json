  "schema_version": "1.0.0",
  "id": "lemon-pound-cake-cookies",
  "name": "Lemon Pound Cake Cookies",
  "subtitle": "Soft, buttery cookies with bright lemon flavor",
  "description": "Tender lemon cookies made with a simple butter-based dough and baked until lightly set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "salted-sweet-cream-butter",
      "item": "salted sweet cream butter",
      "quantity": 0.66666668653488,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "lemon-extract",
      "item": "lemon extract",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter and sugar until combined and smooth."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk together the flour and baking powder."
    },
    {
      "step": 4,
      "text": "Whisk the eggs and lemon extract into the butter mixture, then stir in the dry ingredients until a dough forms."
    },
    {
      "step": 5,
      "text": "Portion the dough onto a baking sheet and bake at 400°F until the cookies are lightly set, about 12 minutes.",
      "timer_minutes": 12
    }
  ],
