{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "classic-caramels",
  "name": "Classic Caramels",
  "subtitle": "Soft, buttery candies with vanilla warmth",
  "description": "Cook a simple sugar-and-cream mixture to the firm stage, then cool and cut into individual caramels.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 117,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "corn-syrup",
      "item": "corn syrup",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Butter a suitable pan and set it aside."
    },
    {
      "step": 2,
      "text": "Combine the sugar, corn syrup, cream, and butter in a heavy saucepan. Whisk until evenly blended."
    },
    {
      "step": 3,
      "text": "Cook the mixture over medium heat, stirring frequently, until it reaches 242°F and a firm caramel stage."
    },
    {
      "step": 4,
      "text": "Remove from the heat and stir in the vanilla extract."
    },
    {
      "step": 5,
      "text": "Pour into the prepared pan and chill until firm."
    },
    {
      "step": 6,
      "text": "Cut the chilled caramel into pieces and serve."
    }
  ],
