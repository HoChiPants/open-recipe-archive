  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Place the peaches in a baking dish and toss with the lemon zest and juice."
    },
    {
      "step": 2,
      "text": "Beat the room-temperature butter with 1.25 cups sugar until combined and creamy, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the flour and oats, then mix for about 5 minutes. Add the milk and stir for about 4 minutes, until the mixture is thick.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Spread the thick topping mixture over the peaches."
    },
    {
      "step": 5,
      "text": "Sprinkle the remaining 0.25 cup sugar over the topping and moisten it with the cold water as needed."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, then cool for 30 minutes before serving.",
      "timer_minutes": 45
    }
  ],
