  "id": "peach-cobbler-ce4a898e",
  "name": "Peach Cobbler",
  "subtitle": "A warm fruit dessert with an oat-topped crust",
  "description": "Juicy peaches are layered beneath a tender oat topping, then baked until golden and rested before serving.",
  "meal_type": "dessert",
  "cuisine": "American",
