{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "bay-leaf-creams",
  "name": "Bay Leaf Creams",
  "subtitle": "Silky set creams with bay-infused citrus syrup",
  "description": "A make-ahead dessert combining a gently set cream mixture with a bright lime and bay-leaf syrup.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "gelatine-leaves",
      "item": "gelatine leaves",
      "quantity": 3
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "fresh-bay-leaves",
      "item": "fresh bay leaves",
      "quantity": 4
    },
    {
      "ingredient_id": "golden-granulated-sugar",
      "item": "golden granulated sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "fresh-bay-leaves",
      "item": "fresh bay leaves",
      "quantity": 4
    },
    {
      "ingredient_id": "lime-juiced",
      "item": "lime juiced",
      "quantity": "1/2"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Soak the gelatine leaves in cold water until softened. Remove and squeeze out excess water."
    },
    {
      "step": 2,
      "text": "Put the double cream, milk, golden caster sugar, and four bay leaves in a saucepan. Warm gently, whisking, until the sugar dissolves; do not boil.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Remove the pan from the heat, take out the bay leaves, and whisk in the softened gelatine until fully dissolved."
    },
    {
      "step": 4,
      "text": "Pour the cream mixture into eight serving dishes and chill until set."
    },
    {
      "step": 5,
      "text": "For the syrup, heat the golden granulated sugar with the remaining bay leaves and the lime juice until the sugar dissolves and the mixture simmers."
    },
    {
      "step": 6,
      "text": "Simmer briefly until lightly syrupy, then remove from the heat and cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Remove the bay leaves. Spoon the cooled syrup over the set creams before serving."
    }
  ],
