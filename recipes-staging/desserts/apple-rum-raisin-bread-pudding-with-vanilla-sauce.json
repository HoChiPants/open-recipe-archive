  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease a baking dish with the first tablespoon of butter."
    },
    {
      "step": 2,
      "text": "Cook the apple, raisins, rum, and pinch of cinnamon with the bread cubes until the apple softens, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Melt the 1/4 cup butter, then stir in the brown sugar, white sugar, milks, and tablespoon of cinnamon for about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Whisk the eggs with the 1/2 teaspoon vanilla. Gradually whisk in the warm milk mixture."
    },
    {
      "step": 5,
      "text": "Combine the apple-bread mixture with the custard and transfer it to the prepared dish."
    },
    {
      "step": 6,
      "text": "Bake until lightly browned and the center is fully set, reaching 160°F on a food thermometer, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "For the sauce, whisk the 3 tablespoons milk with the cornstarch until smooth."
    },
    {
      "step": 8,
      "text": "Warm the remaining tablespoon of butter, then stir in the remaining milk and white sugar. Bring the mixture to a simmer."
    },
    {
      "step": 9,
      "text": "Whisk in the cornstarch mixture and cook until thickened. Stir in the remaining rum and vanilla extract."
    },
    {
      "step": 10,
      "text": "Let the pudding rest for 5 minutes, then serve with the warm sauce.",
      "timer_minutes": 5
    }
  ],
