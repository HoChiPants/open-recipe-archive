    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 4
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla",
      "item": "vanilla"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the egg whites with the white sugar until the mixture reaches soft peaks."
    },
    {
      "step": 2,
      "text": "Whisk in the vanilla, then whisk in the sour cream until evenly combined."
    },
    {
      "step": 3,
      "text": "For food safety, use pasteurized egg whites for this no-cook preparation. If heat-treating the egg mixture instead, bring it to 160°F before chilling."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a freezer-safe container and freeze until partially set.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Stir the partially frozen mixture for 30 minutes, then return it to the freezer until firm.",
      "timer_minutes": 30
    }
  ],
