  "id": "vanilla-sour-cream-ice-cream",
  "name": "Vanilla Sour Cream Ice Cream",
  "subtitle": "A simple frozen dessert with tangy richness and vanilla flavor.",
  "description": "Whisked egg whites, sugar, sour cream, and vanilla form a light mixture that is frozen and stirred for a smooth texture.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
