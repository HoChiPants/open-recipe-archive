  "id": "spiced-biscuit-spread-cake",
  "name": "Spiced Biscuit-Spread Cake",
  "subtitle": "A soft cinnamon cake with creamy spread frosting and caramel crunch.",
  "description": "A tender yogurt cake layered with biscuit spread frosting, caramel, and crushed biscuits.",
