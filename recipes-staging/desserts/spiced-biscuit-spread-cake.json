  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a cake tin with parchment."
    },
    {
      "step": 2,
      "text": "Beat the room-temperature butter and brown sugar for 2 minutes until creamy.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Mix in the biscuit spread, yogurt, eggs, vanilla, and cinnamon. Add the flour and whisk for 2 minutes, until combined.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared tin and bake for 30 minutes, until set in the center.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cool the cake in the tin for 15 minutes, then transfer it to a rack to cool completely.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Beat the unsalted butter and icing sugar until smooth, then blend in the biscuit spread."
    },
    {
      "step": 7,
      "text": "Warm the caramel briefly in the microwave until loosened, taking care with the hot container."
    },
    {
      "step": 8,
      "text": "Spread the frosting over the cooled cake. Spoon over the caramel and finish with the crushed biscuits."
    }
  ],
