  "id": "chocolate-orange-rice-pudding",
  "name": "Chocolate & Orange Rice Pudding",
  "subtitle": "Creamy rice pudding with dark chocolate and citrus",
  "description": "A softly spiced rice pudding enriched with dark chocolate, orange zest, and vanilla.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "short-grain-pudding-rice",
      "item": "short-grain pudding rice",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "litres-semi-skimmed-milk-plus-a-splash",
      "item": "litres semi-skimmed milk plus a splash",
      "quantity": 1.4
    },
    {
      "ingredient_id": "70-dark-chocolate-chunks",
      "item": "70% dark chocolate chunks",
      "quantity": 100,
      "unit": "g",
      "preparation": "plus extra to serve"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "orange-extract",
      "item": "orange extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "unwaxed-orange-zested",
      "item": "unwaxed orange zested",
      "quantity": 1,
      "preparation": "plus extra to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk in a saucepan until it reaches a gentle simmer."
    },
    {
      "step": 2,
      "text": "Stir in the rice, sugar, and cinnamon. Cook gently, stirring regularly, until the rice is tender and the mixture is thick and creamy.",
      "timer_minutes": 35
    },
    {
      "step": 3,
      "text": "Remove from the heat and mix in the chocolate, orange extract, vanilla extract, and orange zest until smooth."
    },
    {
      "step": 4,
      "text": "Spoon into serving dishes and finish with the reserved chocolate and orange zest."
    }
  ],
