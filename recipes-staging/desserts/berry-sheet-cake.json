      "preparation": "currants, raspberries or strawberries"
    },
    {
      "ingredient_id": "icing-sugar-for-dusting",
      "item": "icing sugar for dusting"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease a sheet cake tin with butter. Dust it with some of the flour, then tap out the excess."
    },
    {
      "step": 2,
      "text": "Whisk the eggs and granulated sugar until blended and slightly thickened."
    },
    {
      "step": 3,
      "text": "Stir together the flour and baking powder, then mix them into the egg mixture with the whipping cream until a smooth batter forms."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared tin and spread it evenly. Scatter the berries over the surface."
    },
    {
      "step": 5,
      "text": "Bake until the cake is set and lightly golden and the center is fully cooked, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Cool the cake in the tin, then dust with icing sugar and serve."
    }
  ],
