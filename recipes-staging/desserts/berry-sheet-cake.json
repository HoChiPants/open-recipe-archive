  "id": "berry-sheet-cake",
  "name": "Berry Sheet Cake",
  "subtitle": "A tender cream-based cake with plenty of berries",
  "description": "Bake a simple sheet cake with fresh berries, then cool and finish with a light dusting of icing sugar.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
