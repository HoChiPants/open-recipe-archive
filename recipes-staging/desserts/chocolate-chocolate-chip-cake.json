  "id": "chocolate-chocolate-chip-cake",
  "name": "Chocolate Chocolate Chip Cake",
  "subtitle": "A rich chocolate cake studded with mini semi-sweet chips.",
  "description": "A simple chocolate cake made with pudding mix, sour cream, vanilla, and chocolate chips for a moist crumb.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "chocolate-cake-mix",
      "item": "chocolate cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "instant-chocolate-pudding-mix",
      "item": "instant chocolate pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.9 ounce"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "hot-water",
      "item": "hot water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "mini-semi-sweet-chocolate-chips",
      "item": "mini semi-sweet chocolate chips",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a cake pan."
    },
    {
      "step": 2,
      "text": "Whisk the cake mix, pudding mix, vegetable oil, eggs, hot water, sour cream, and vanilla until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the chocolate chips until evenly distributed."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared pan and bake for 60 minutes, until the center is firm and fully set.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Cool the cake before serving."
    }
  ],
