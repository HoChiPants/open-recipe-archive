  "id": "grilled-pineapple",
  "name": "Grilled Pineapple",
  "subtitle": "Sweet pineapple with a buttery pepper glaze",
  "description": "Pineapple rings rest in a lightly spicy honey-butter coating before grilling until warm and marked.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
