      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the pineapple rings in a shallow dish."
    },
    {
      "step": 2,
      "text": "Stir together the melted butter, honey, hot pepper sauce, and salt. Pour over the pineapple and turn to coat evenly."
    },
    {
      "step": 3,
      "text": "Let the coated pineapple stand for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Preheat the grill."
    },
    {
      "step": 5,
      "text": "Grill the pineapple, turning as needed, for about 3 minutes or until heated through and marked.",
      "timer_minutes": 3
    }
  ],
