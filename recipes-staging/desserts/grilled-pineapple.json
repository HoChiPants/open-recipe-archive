    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-pineapple",
      "item": "fresh pineapple",
      "quantity": 1,
      "preparation": "peeled, cored and cut into 1 inch rings"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "hot-pepper-sauce",
      "item": "hot pepper sauce",
      "quantity": 1,
      "unit": "dash"
