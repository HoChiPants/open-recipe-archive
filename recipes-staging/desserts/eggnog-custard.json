  "id": "eggnog-custard",
  "name": "Eggnog Custard",
  "subtitle": "Warm, nutmeg-scented baked custards for two",
  "description": "A simple baked custard combining eggnog, beaten egg, sugar, and nutmeg.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "eggnog",
      "item": "eggnog",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 2,
      "unit": "pinches"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the eggnog and white sugar together, then whisk in the beaten egg until smooth."
    },
    {
      "step": 3,
      "text": "Divide the mixture between two small ovenproof dishes and sprinkle the ground nutmeg over the tops."
    },
    {
      "step": 4,
      "text": "Place the dishes in a baking pan and bake until the centers are set and a thermometer reads 160°F, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Cool briefly before serving."
    }
  ],
