  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and lightly oil the cake tin."
    },
    {
      "step": 2,
      "text": "Whisk the oil, yogurt, beaten egg, and brown sugar together. Stir in the flour, baking powder, cinnamon, nutmeg, cloves, and grated carrot until combined."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the tin and bake for 30 minutes, until the center is firm and a thermometer reads at least 160°F. Cool until set.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Whisk the softened butter, icing sugar, and cinnamon for 5 minutes, then beat in the melted chocolate until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Crumble the cooled cake and mix it with enough frosting to form a cohesive mixture. Shape it into 12 balls and chill until firm.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Melt the remaining chocolate until smooth. Dip the ends of the lollipop sticks into the chocolate, insert them into the cake balls, and coat each pop."
    },
    {
      "step": 7,
      "text": "Decorate with the red sugar-coated chocolates and halved pretzels, then leave the coating to set."
    }
  ],
