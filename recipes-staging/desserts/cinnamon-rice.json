  "id": "cinnamon-rice",
  "name": "Cinnamon Rice",
  "subtitle": "Tender rice with cinnamon, sugar, and raisins",
  "description": "A simple warm rice dessert lightly sweetened with cinnamon and studded with raisins.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
