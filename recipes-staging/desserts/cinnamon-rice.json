    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the rice, water, milk, raisins, and margarine in a saucepan. Bring the mixture to a boil over medium-high heat."
    },
    {
      "step": 2,
      "text": "Reduce the heat to low, cover, and cook until the rice is tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Stir together the cinnamon and sugar. Add the mixture to the cooked rice and stir to combine before serving."
    }
  ],
