  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat a baking pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk the white cake mix with ¾ cup milk, vegetable oil, and eggs until combined, about 2 minutes. Mix in the melted butter and vanilla extract.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and bake until set, about 35 minutes. Cool completely.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "Beat the softened cream cheese with the divided confectioners' sugar, lemon juice, and lemon zest until smooth. Whip in the heavy cream until stiff peaks form, then gently fold in the remaining cream mixture as needed for a smooth filling."
    },
    {
      "step": 5,
      "text": "Cut the cooled cake into layers or pieces. Spread the lemon cream between the layers and over the top."
    },
    {
      "step": 6,
      "text": "Chill for 4 hours. Dust with additional confectioners' sugar before serving.",
      "timer_minutes": 240
    }
  ],
