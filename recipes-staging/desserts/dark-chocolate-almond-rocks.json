  "id": "dark-chocolate-almond-rocks",
  "name": "Dark Chocolate Almond Rocks",
  "subtitle": "Crunchy almond clusters coated in dark chocolate",
  "description": "Toast crushed almonds, coat them in melted dark chocolate, and chill the mixture into bite-size clusters.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 8,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "almonds",
      "item": "almonds",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "crushed into chunks"
    },
    {
      "ingredient_id": "dark-chocolate-chips-50-cacao",
      "item": "dark chocolate chips (50% cacao)",
      "quantity": 7,
      "unit": "ounces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the crushed almonds in a dry skillet over medium heat until lightly toasted, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Melt the chocolate chips in a heatproof bowl set over gently simmering water, stirring until smooth, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir the toasted almonds into the melted chocolate until evenly coated. Drop 20 spoonfuls onto parchment and chill until set, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Serve once firm."
    }
  ],
