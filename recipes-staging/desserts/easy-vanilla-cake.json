      "item": "vegetable oil",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat a cake pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk the flour, sugar, baking powder, and salt in a mixing bowl."
    },
    {
      "step": 3,
      "text": "Add the eggs, milk, oil, and vanilla extract. Stir until the batter is smooth."
    },
    {
      "step": 4,
      "text": "Pour the batter into the prepared pan and bake for 45 minutes, until the center is firm and fully set.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Let the cake rest in the pan for 5 minutes, then remove it and cool completely before cutting.",
      "timer_minutes": 5
    }
  ],
