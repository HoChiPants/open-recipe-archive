    "inactive_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "8-ounce-container-frozen-whipped-topping",
      "item": "(8 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "instant-vanilla-pudding-mix",
      "item": "instant vanilla pudding mix",
      "quantity": 2,
      "unit": "package",
      "preparation": "3.5 ounce"
    },
    {
      "ingredient_id": "graham-cracker-squares",
      "item": "graham cracker squares",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "prepared-chocolate-frosting",
      "item": "prepared chocolate frosting",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the milk, thawed whipped topping, and instant vanilla pudding mix until evenly combined and thickened."
    },
    {
      "step": 2,
      "text": "Cover the bottom of a dish with graham cracker squares. Spread over half of the pudding mixture, add another layer of graham crackers, and cover with the remaining pudding mixture."
    },
    {
      "step": 3,
      "text": "Finish with a final layer of graham cracker squares. Refrigerate for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Spread the prepared chocolate frosting over the chilled top, then refrigerate until fully set, about 3½ hours.",
      "timer_minutes": 210
    }
  ],
