  "id": "e-clair-cake",
  "name": "Éclair Cake",
  "subtitle": "A chilled vanilla pudding and chocolate dessert",
  "description": "Layer graham crackers with a creamy vanilla filling, then finish with chocolate frosting and chill until set.",
  "meal_type": "dessert",
  "cuisine": "French",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
