  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the flour, sugar, cocoa powder, baking soda, baking powder, cinnamon, and salt in a mixing bowl."
    },
    {
      "step": 3,
      "text": "Add the oil and eggs, then mix until the batter is combined."
    },
    {
      "step": 4,
      "text": "Fold in the grated zucchini and chopped walnuts."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a prepared baking pan and spread it evenly."
    },
    {
      "step": 6,
      "text": "Bake at 350°F for about 60 minutes, until the center is fully set.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Cool before cutting and serving."
    }
