  "id": "strawberry-muffins",
  "name": "Strawberry Muffins",
  "subtitle": "Tender muffins filled with fresh chopped strawberries",
  "description": "Simple American-style muffins with a lightly sweet crumb and bursts of strawberry.",
  "meal_type": "dessert",
  "cuisine": "American",
