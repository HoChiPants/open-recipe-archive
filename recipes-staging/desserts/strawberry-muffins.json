      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F and prepare a muffin pan."
    },
    {
      "step": 2,
      "text": "Whisk the milk, canola oil, and egg together in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the flour, sugar, baking powder, and salt. Stir in the chopped strawberries."
    },
    {
      "step": 4,
      "text": "Fold the milk mixture into the dry mixture just until combined; avoid overmixing."
    },
    {
      "step": 5,
      "text": "Divide the batter among the prepared muffin cups."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until the centers are firm and fully set.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Let the muffins cool in the pan for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
