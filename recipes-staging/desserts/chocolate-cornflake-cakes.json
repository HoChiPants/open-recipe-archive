  "instructions": [
    {
      "step": 1,
      "text": "Prepare 15 small paper cases or a tray with the butter."
    },
    {
      "step": 2,
      "text": "Warm the butter, golden syrup, and chopped chocolate together, stirring until smooth and melted."
    },
    {
