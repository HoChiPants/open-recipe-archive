  "id": "uncooked-banana-pudding",
  "name": "Uncooked Banana Pudding",
  "subtitle": "A creamy layered banana dessert with crisp wafer cookies",
  "description": "Combine a tangy vanilla pudding mixture with sliced bananas and wafer cookies for an easy chilled-style dessert assembled without cooking.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 8,
      "unit": "ounces"
    },
    {
      "ingredient_id": "8-ounce-container-frozen-whipped-topping",
      "item": "(8 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "instant-vanilla-pudding-mix",
      "item": "instant vanilla pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "5 ounce"
    },
    {
      "ingredient_id": "vanilla-wafer-cookies",
      "item": "vanilla wafer cookies",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "banana",
      "item": "bananas",
      "quantity": 4,
      "unit": "medium",
      "preparation": "peeled and sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the milk, sour cream, thawed whipped topping, and pudding mix until smooth and fully combined."
    },
    {
      "step": 2,
      "text": "Arrange a layer of vanilla wafer cookies in a serving dish. Add a layer of the pudding mixture, then arrange sliced bananas over it."
    },
    {
      "step": 3,
      "text": "Repeat the cookie, pudding, and banana layers until the ingredients are used. Serve once assembled."
    }
  ],
