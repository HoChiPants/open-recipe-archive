  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the all-purpose flour, white sugar, baking powder, and salt in a bowl. Cut in the unsalted butter until the mixture is crumbly."
    },
    {
      "step": 3,
      "text": "Whisk the cream and beaten egg together, then stir them into the flour mixture to form a batter."
    },
    {
      "step": 4,
      "text": "Spread the batter in the prepared baking pan and arrange the sliced apples over the top."
    },
    {
      "step": 5,
      "text": "Whisk the brown sugar, flour, and cinnamon together. Cut in the cold unsalted butter until crumbly, then scatter the topping over the apples."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until golden brown and the center is fully set; if checked with a thermometer, it should reach 160°F.",
      "timer_minutes": 25
    }
  ],
