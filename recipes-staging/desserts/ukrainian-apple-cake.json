  "id": "ukrainian-apple-cake",
  "name": "Ukrainian Apple Cake",
  "subtitle": "A tender cake layered with sliced apples and cinnamon crumble",
  "description": "A simple apple cake with a buttery base, fresh apples, and a crisp brown-sugar topping.",
  "meal_type": "dessert",
  "cuisine": "Ukrainian",
