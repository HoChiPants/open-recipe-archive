  "id": "peanut-butter-cookies-0f3fd05b",
  "name": "Peanut Butter Cookies",
  "subtitle": "Tender cookies with a crisp sugared finish",
  "description": "A simple American cookie made with peanut butter, brown sugar, and vanilla, shaped into rounds and rolled in sugar before baking.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.25,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "white-sugar-for-rolling",
      "item": "white sugar for rolling",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine the sifted flour, baking soda, and salt; set aside."
    },
    {
      "step": 3,
      "text": "Whisk the butter, peanut butter, white sugar, and packed brown sugar until smooth. Whisk in the egg and vanilla extract."
    },
    {
      "step": 4,
      "text": "Blend in the flour mixture until combined, then shape the dough into portions."
    },
    {
      "step": 5,
      "text": "Roll the portions in the white sugar for rolling and arrange them on a baking sheet."
    },
    {
      "step": 6,
      "text": "Bake for 12 minutes, until set and the egg-containing dough reaches 160°F at the center.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Cool the cookies before serving."
    }
  ],
