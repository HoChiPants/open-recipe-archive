  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a 12-cup muffin tin with paper cases."
    },
    {
      "step": 2,
      "text": "Combine the light brown sugar, self raising flour, 50 g cocoa powder, and baking powder."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, vegetable oil, and 4 tbsp milk together, then whisk into the dry ingredients until smooth."
    },
    {
      "step": 4,
      "text": "Fold in the chopped dark chocolate, zest from the two oranges, and orange gel food colouring."
    },
    {
      "step": 5,
      "text": "Divide the batter evenly among the cases."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, until risen and the centers are fully set; a thermometer should read at least 160°F if checked.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Cool the cupcakes completely before decorating."
    },
    {
      "step": 8,
      "text": "Beat the softened butter and icing until smooth. Whisk in the zest from the additional orange and orange gel food colouring."
    },
    {
      "step": 9,
      "text": "Stir the remaining cocoa powder, baking powder, and 2 tbsp milk into the frosting until combined, then whisk in the remaining icing and orange mixture until smooth."
    },
    {
      "step": 10,
      "text": "Pipe or spread the frosting over the cooled cupcakes."
    },
    {
      "step": 11,
      "text": "Garnish with extra chopped dark chocolate, orange zest, and orange gel food colouring."
    }
  ],
