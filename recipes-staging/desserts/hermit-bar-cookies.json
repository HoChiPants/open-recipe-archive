  "id": "hermit-bar-cookies",
  "name": "Hermit Bar Cookies",
  "subtitle": "Spiced molasses bars with raisins",
  "description": "Soft, warmly spiced cookie bars made with molasses, coffee, and raisins.",
  "meal_type": "dessert",
  "cuisine": "American",
