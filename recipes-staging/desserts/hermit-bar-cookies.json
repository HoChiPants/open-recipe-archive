  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the sugar and shortening until smooth. Stir in the molasses and egg."
    },
    {
      "step": 3,
      "text": "Dissolve the baking soda in the warm coffee, then stir it into the molasses mixture."
    },
    {
      "step": 4,
      "text": "Combine the flour, cinnamon, cloves, and salt. Stir the dry mixture into the wet mixture, then fold in the raisins."
    },
    {
      "step": 5,
      "text": "Shape the dough into an even slab in the prepared baking pan."
    },
    {
      "step": 6,
      "text": "Bake until set, about 15 minutes; the center should be firm and reach 160°F.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Cut the slab into bars while warm, then cool before serving.",
      "timer_minutes": 5
    }
  ],
