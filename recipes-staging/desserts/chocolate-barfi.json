  "id": "chocolate-barfi",
  "name": "Chocolate Barfi",
  "subtitle": "Cardamom-saffron milk fudge with a chocolate coating",
  "description": "A rich Indian milk-based sweet flavored with cardamom and saffron, chilled until set, coated in dark chocolate, and finished with rose or pistachio garnish.",
  "meal_type": "dessert",
  "cuisine": "Indian",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 220,
      "unit": "ml"
    },
    {
      "ingredient_id": "butter",
      "item": "salted butter",
      "quantity": 70,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 120,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-cardamom",
      "item": "ground cardamom",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "strands-of-saffron",
      "item": "strands of saffron",
      "quantity": 10
    },
    {
      "ingredient_id": "whole-milk-powder",
      "item": "whole milk powder",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-chocolate",
      "item": "dark chocolate",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "mini-edible-dried-roses-or-rose-petals-and-chopped-pistachios",
      "item": "mini edible dried roses or rose petals and chopped pistachios",
      "preparation": "to decorate"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Line or lightly grease a shallow dish or tray."
    },
    {
      "step": 2,
      "text": "Warm the whole milk, salted butter, and whole milk powder in a saucepan, stirring until the butter melts and the mixture is smooth."
    },
    {
      "step": 3,
      "text": "Stir in the caster sugar, ground cardamom, and saffron. Continue cooking and stirring until the mixture thickens, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Spread the mixture evenly in the prepared dish and smooth the surface. Chill until firm, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Melt the dark chocolate gently in a microwave in short intervals, stirring between intervals, until smooth."
    },
    {
      "step": 6,
      "text": "Cut the chilled barfi into pieces and coat each piece with the melted chocolate."
    },
    {
      "step": 7,
      "text": "Decorate with the dried roses or rose petals and chopped pistachios. Allow the coating to set before serving.",
      "timer_minutes": 60
    }
  ],
