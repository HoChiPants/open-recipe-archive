  "id": "lavender-shortbread-cookies",
  "name": "Lavender Shortbread Cookies",
  "subtitle": "Buttery cookies scented with lavender, mint, and lemon",
  "description": "A crisp, tender shortbread combining floral lavender with fresh mint and bright lemon zest.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "finely-chopped-fresh-lavender",
      "item": "finely chopped fresh lavender",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fresh-mint-leaves",
      "item": "fresh mint leaves",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "grated-lemon-zest",
      "item": "grated lemon zest",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened butter, white sugar, and sifted confectioners' sugar until blended."
    },
    {
      "step": 2,
      "text": "Combine the lavender, mint, and lemon zest, then stir into the butter mixture."
    },
    {
      "step": 3,
      "text": "Combine the flour, cornstarch, and salt. Add the dry mixture to the butter mixture and mix until a thick dough forms."
    },
    {
      "step": 4,
      "text": "Chill the dough until firm.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 6,
      "text": "On a lightly floured surface, shape the dough and cut it into cookies."
    },
    {
      "step": 7,
      "text": "Prepare a baking sheet and transfer the cookies to it."
    },
    {
      "step": 8,
      "text": "Bake until set and lightly colored.",
      "timer_minutes": 20
    },
    {
      "step": 9,
      "text": "Transfer the cookies to a rack to cool."
    }
  ],
