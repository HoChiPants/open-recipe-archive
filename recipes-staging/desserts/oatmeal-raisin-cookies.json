  "id": "oatmeal-raisin-cookies",
  "name": "Oatmeal Raisin Cookies",
  "subtitle": "Tender cookies with oats, raisins, and warm spices",
  "description": "A simple batch of soft oatmeal cookies combining brown sugar, rolled oats, raisins, cinnamon, and nutmeg.",
