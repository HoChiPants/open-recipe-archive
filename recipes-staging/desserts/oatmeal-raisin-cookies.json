  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare baking sheets."
    },
    {
      "step": 2,
      "text": "Whisk the canola oil, brown sugar, eggs, and vanilla until combined."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the flour, baking soda, salt, cinnamon, and nutmeg."
    },
    {
      "step": 4,
      "text": "Stir the dry mixture into the wet mixture until combined, then fold in the oats and raisins."
    },
    {
      "step": 5,
      "text": "Portion the dough onto the prepared baking sheets, leaving space between portions."
    },
    {
      "step": 6,
      "text": "Bake for 12 minutes, until lightly browned.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Cool the cookies on the baking sheets for 5 minutes, then transfer them to a rack to cool.",
      "timer_minutes": 5
    }
  ],
