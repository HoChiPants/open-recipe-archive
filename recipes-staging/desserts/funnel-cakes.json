  "id": "funnel-cakes",
  "name": "Funnel Cakes",
  "subtitle": "Crisp, golden fried cakes finished with sugar",
  "description": "A simple egg-and-milk batter is fried into lacy funnel cakes, drained, and dusted with confectioners' sugar.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.3333333730698,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying",
      "quantity": 1,
      "unit": "quart"
    },
    {
      "ingredient_id": "confectioners-sugar-for-dusting",
      "item": "confectioners' sugar for dusting",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil to 375°F in a deep, heavy pot."
    },
    {
      "step": 2,
      "text": "Whisk the egg and milk together. In a separate bowl, combine the salt, white sugar, sifted flour, and baking powder."
    },
    {
      "step": 3,
      "text": "Whisk the wet mixture into the dry mixture until smooth."
    },
    {
      "step": 4,
      "text": "Pour portions of batter through a funnel into the hot oil, moving in overlapping circles to form cakes."
    },
    {
      "step": 5,
      "text": "Fry until golden brown and the batter reaches 160°F at the center, turning as needed."
    },
    {
      "step": 6,
      "text": "Drain the cakes, then dust them with confectioners' sugar."
    }
  ],
