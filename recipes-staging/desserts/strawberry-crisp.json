  "id": "strawberry-crisp",
  "name": "Strawberry Crisp",
  "subtitle": "A warm baked fruit dessert with an oat topping",
  "description": "Halved strawberries are sweetened and baked beneath a buttery oat crumble until bubbling and golden.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 6,
      "unit": "cups",
      "preparation": "halved"
    },
    {
      "ingredient_id": "all-purpose-white-flour",
      "item": "all-purpose white flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Toss the strawberries with the all-purpose white flour, 1 tablespoon white sugar, vanilla extract, and all-purpose flour. Transfer the fruit mixture to a baking dish."
    },
    {
      "step": 3,
      "text": "Combine the all-purpose white flour, 1.25 cups white sugar, butter, rolled oats, and salt to taste until a crumbly topping forms."
    },
    {
      "step": 4,
      "text": "Scatter the topping evenly over the strawberries."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, until the fruit is bubbling and the topping is golden.",
      "timer_minutes": 45
    }
  ],
