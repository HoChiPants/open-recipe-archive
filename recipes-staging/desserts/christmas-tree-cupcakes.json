{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "christmas-tree-cupcakes",
  "name": "Christmas Tree Cupcakes",
  "subtitle": "Festive cupcakes with green tree frosting",
  "description": "Bake vanilla cupcakes, top them with green buttercream shaped into trees, and finish with fondant stars and colorful decorations.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-softened",
      "item": "unsalted butter softened",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "vanilla-bean-paste",
      "item": "vanilla bean paste",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 175,
      "unit": "g"
    },
    {
      "ingredient_id": "gold-or-white-fondant",
      "item": "gold or white fondant",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "edible-gold-lustre-dust-or-spray-if-using-white-fondant",
      "item": "edible gold lustre dust or spray (if using white fondant)"
    },
    {
      "ingredient_id": "edible-sugar-balls-mini-chocolate",
      "item": "edible sugar balls mini chocolate",
      "preparation": "beans, or multicoloured sprinkles (for baubles)"
    },
    {
      "ingredient_id": "unsalted-butter-softened",
      "item": "unsalted butter softened",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar-sifted",
      "item": "icing sugar sifted",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-bean-paste",
      "item": "vanilla bean paste",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "green-food-colouring-preferably-oil-based",
      "item": "green food colouring (preferably oil-based)"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a 12-cupcake pan with cases."
    },
    {
      "step": 2,
      "text": "Beat the 150 g softened butter with the golden caster sugar until light. Add the eggs and 1 tsp vanilla bean paste, then mix in the self-raising flour until just combined."
    },
    {
      "step": 3,
      "text": "Divide the batter among the cases and bake until risen and set, about 15 minutes. Cool in the pan for 5 minutes, then transfer to a rack.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Roll out the fondant and cut small star shapes. If using white fondant, add the edible gold lustre dust or spray. Set aside for about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Beat the 300 g softened butter until smooth. Gradually add the sifted icing sugar and 1 tsp vanilla bean paste, then whisk until combined. Tint the frosting green with the food colouring.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Pipe the green frosting into tree shapes on the cooled cupcakes. Decorate with fondant stars and the edible sugar balls, mini chocolate beans, or multicoloured sprinkles."
    }
  ],
