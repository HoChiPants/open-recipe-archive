{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "vanilla-marshmallows",
  "name": "Vanilla Marshmallows",
  "subtitle": "Soft homemade marshmallows with a light vanilla finish",
  "description": "A fluffy confection made with gelatin, whipped egg whites, and hot sugar syrup, finished with confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20,
    "inactive_minutes": 470
  },
  "ingredients": [
    {
      "ingredient_id": "confectioners-sugar-for-dusting",
      "item": "confectioners' sugar for dusting",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "light-corn-syrup",
      "item": "light corn syrup",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.25,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "unflavored-gelatin",
      "item": "unflavored gelatin",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly dust a prepared pan with some of the confectioners' sugar."
    },
    {
      "step": 2,
      "text": "Combine the white sugar, corn syrup, and part of the water in a saucepan. Heat, stirring as needed, until the syrup reaches 265°F.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Bloom the gelatin in the remaining water, then warm it over simmering water until dissolved. Carefully combine it with the hot syrup."
    },
    {
      "step": 4,
      "text": "Beat the egg whites to soft peaks. With the mixer running, slowly add the hot syrup and gelatin mixture; verify the mixture reaches at least 160°F, then continue beating until thick and fluffy."
    },
    {
      "step": 5,
      "text": "Stir in the vanilla extract, transfer the mixture to the prepared pan, and smooth the surface. Dust the top with the remaining confectioners' sugar."
    },
    {
      "step": 6,
      "text": "Let stand at room temperature until fully set, then cut into 18 servings and dust the cut sides with confectioners' sugar.",
      "timer_minutes": 470
    }
  ],
