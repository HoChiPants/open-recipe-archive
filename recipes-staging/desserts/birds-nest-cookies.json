      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 4,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cream the softened 1 cup butter with 0.5 cup white sugar until smooth. Separate the eggs; whisk the yolks into the butter mixture and reserve the whites."
    },
    {
      "step": 3,
      "text": "Stir in the flour until a dough forms, then mix in the chopped pecans."
    },
    {
      "step": 4,
      "text": "Shape the dough into 18 portions. Dip each portion in the reserved egg whites, then coat with white sugar."
    },
    {
      "step": 5,
      "text": "Transfer the portions to a baking sheet and press an indentation into the center of each to form a nest."
    },
    {
      "step": 6,
      "text": "Bake for 8 minutes. Remove briefly, reinforce the indentations if needed, and return to the oven for 6 minutes, until lightly browned.",
      "timer_minutes": 14
    },
    {
      "step": 7,
      "text": "Cool the cookies completely."
    },
    {
      "step": 8,
      "text": "Blend 0.25 cup softened butter, shortening, warm water, and vanilla extract. Gradually combine the white sugar and confectioners' sugar until smooth; use the mixture to fill or pipe into the cooled cookie centers."
    }
  ],
