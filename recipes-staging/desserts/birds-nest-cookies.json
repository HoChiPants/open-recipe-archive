  "id": "birds-nest-cookies",
  "name": "Birds' Nest Cookies",
  "subtitle": "Pecan cookies with vanilla icing",
  "description": "Tender pecan cookies are baked in two stages, cooled, and finished with a smooth vanilla icing.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
