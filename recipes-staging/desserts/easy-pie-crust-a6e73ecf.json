  "id": "easy-pie-crust-a6e73ecf",
  "name": "Easy Pie Crust",
  "subtitle": "A simple oil-based crust for sweet or savory fillings",
  "description": "Mix a few pantry staples into a tender dough, shape it into a crust, and use it with your preferred pie filling.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "fluid-ounces-cold-milk",
      "item": "fluid ounces cold milk",
      "quantity": 3
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour and salt together in a mixing bowl."
    },
    {
      "step": 2,
      "text": "Add the vegetable oil and cold milk, then stir until the ingredients form a cohesive dough."
    },
    {
      "step": 3,
      "text": "Knead the dough briefly until smooth, taking care not to overwork it."
    },
    {
      "step": 4,
      "text": "Shape the dough into a round, then roll or press it into a pie crust."
    },
    {
      "step": 5,
      "text": "Use the crust with the intended pie filling."
    }
  ],
