{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cinnamon-rolls-from-frozen-bread-dough",
  "name": "Cinnamon Rolls From Frozen Bread Dough",
  "subtitle": "Soft rolls with cinnamon, brown sugar, and walnut filling",
  "description": "Thawed frozen bread dough becomes a pan of spiraled cinnamon rolls, finished with a simple vanilla glaze.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25,
    "inactive_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "melted, divided"
    },
    {
      "ingredient_id": "1-pound-loaf-frozen-bread-dough",
      "item": "(1 pound) loaf frozen bread dough",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.66666668653488,
      "unit": "cup",
      "preparation": "sifted, or as needed"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "dash"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the brown sugar, walnuts, and cinnamon together."
    },
    {
      "step": 2,
      "text": "Roll the thawed dough into a rectangle. Brush it with part of the melted butter, then cover it with the cinnamon-sugar mixture."
    },
    {
      "step": 3,
      "text": "Starting at one long edge, roll the dough into a log and cut it into 20 pieces."
    },
    {
      "step": 4,
      "text": "Butter a baking pan with the remaining melted butter and arrange the rolls cut-side up. Cover and let them rise until puffy, about 90 minutes.",
      "timer_minutes": 90
    },
    {
      "step": 5,
      "text": "Heat the oven to 350°F. Whisk the heavy whipping cream until smooth, then pour it over the risen rolls."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, or until golden brown.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Mix the confectioners' sugar, milk, and vanilla until smooth, adding more milk if needed. Drizzle the glaze over the warm rolls and finish with the ground cinnamon."
    }
  ],
