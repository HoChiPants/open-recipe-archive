{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "heavenly-hash",
  "name": "Heavenly Hash",
  "subtitle": "A chilled rice, fruit, and marshmallow dessert",
  "description": "Tender rice combines with pineapple, cherries, marshmallows, and sweetened whipped cream for a cool, airy dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20,
    "inactive_minutes": 145
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "uncooked-white-rice",
      "item": "uncooked white rice",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "pineapple",
      "item": "pineapple",
      "quantity": 2,
      "unit": "cups",
      "preparation": "crushed, drained"
    },
    {
      "ingredient_id": "miniature-marshmallows",
      "item": "miniature marshmallows",
      "quantity": 1,
      "unit": "package",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "4-ounce-jar-maraschino-cherries",
      "item": "(4 ounce) jar maraschino cherries",
      "quantity": 1,
      "preparation": "halved"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring the water to a simmer in a saucepan. Stir in the rice, cover, and cook gently for 20 minutes, or until tender.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Let the cooked rice cool completely."
    },
    {
      "step": 3,
      "text": "Combine the cooled rice, drained pineapple, marshmallows, and halved cherries in a large bowl."
    },
    {
      "step": 4,
      "text": "Whisk the heavy cream until thickened. Fold in the confectioners' sugar."
    },
    {
      "step": 5,
      "text": "Whisk the sweetened cream into the rice mixture until evenly combined."
    },
    {
      "step": 6,
      "text": "Cover and chill for 2 hours before serving.",
      "timer_minutes": 120
    }
  ],
