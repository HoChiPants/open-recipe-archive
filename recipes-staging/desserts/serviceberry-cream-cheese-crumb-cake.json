  "id": "serviceberry-cream-cheese-crumb-cake",
  "name": "Serviceberry Cream Cheese Crumb Cake",
  "subtitle": "A berry-filled cake with oat crumble and a creamy center",
  "description": "A layered dessert with a cinnamon oat crumb base, gently simmered serviceberries, and a cream cheese topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 70,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-serviceberries",
      "item": "fresh serviceberries",
      "quantity": 5,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "4 ounce, diced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking pan for the cake."
    },
    {
      "step": 2,
      "text": "Whisk the brown sugar, 1.5 cups all-purpose flour, rolled oats, cinnamon, and white sugar. Stir in the vegetable oil until a crumbly mixture forms; reserve some for the topping if needed and press the remainder into the pan. Let the base rest until set.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Bake the base until firm.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Cool the base briefly. Simmer the serviceberries with the water until softened, then stir in the lemon juice and continue cooking until thickened.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Whisk the remaining brown sugar, 2 tablespoons all-purpose flour, and white sugar. Stir this mixture for 3 minutes, then whisk in the diced cream cheese until smooth.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Spread the berry mixture over the cooled base, add the cream cheese mixture, and finish with the reserved crumb mixture."
    },
    {
      "step": 7,
      "text": "Bake until the center is firm and the top is set.",
      "timer_minutes": 40
    },
    {
      "step": 8,
      "text": "Cool before slicing and serving."
    }
  ],
