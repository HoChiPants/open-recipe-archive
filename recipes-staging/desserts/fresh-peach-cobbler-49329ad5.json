  "id": "fresh-peach-cobbler-49329ad5",
  "name": "Fresh Peach Cobbler",
  "subtitle": "A warm, fruit-filled dessert with a tender baked topping",
  "description": "Peaches and a lightly spiced batter bake together in melted butter until golden and bubbling.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "peaches",
      "item": "peaches",
      "quantity": 2,
      "unit": "large",
      "preparation": "peeled and sliced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.75,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Pour the melted butter into a baking dish."
    },
    {
      "step": 2,
      "text": "Toss the sliced peaches with half of the sugar and set aside."
    },
    {
      "step": 3,
      "text": "Whisk the flour, baking powder, salt, nutmeg, and remaining sugar in a bowl. Stir in the milk until combined."
    },
    {
      "step": 4,
      "text": "Pour the batter over the butter, then distribute the peaches over the top."
    },
    {
      "step": 5,
      "text": "Bake until golden brown and bubbling, about 45 minutes.",
      "timer_minutes": 45
    }
  ],
