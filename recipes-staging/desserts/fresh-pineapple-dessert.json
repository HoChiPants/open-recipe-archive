  "id": "fresh-pineapple-dessert",
  "name": "Fresh Pineapple Dessert",
  "subtitle": "Juicy pineapple with toasted coconut",
  "description": "Fresh pineapple is paired with brown sugar and lightly toasted coconut for a quick fruit dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-pineapple",
      "item": "fresh pineapple",
      "quantity": 1
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill."
    },
    {
      "step": 2,
      "text": "Cut the pineapple into manageable sections, remove the core, and cut into serving pieces."
    },
    {
      "step": 3,
      "text": "Let the cut pineapple rest briefly, then arrange it for serving."
    },
    {
      "step": 4,
      "text": "Combine the brown sugar and flaked coconut, and sprinkle the mixture over the pineapple."
    },
    {
      "step": 5,
      "text": "Grill the flaked coconut mixture until lightly toasted, about 5 minutes, and serve with the pineapple.",
      "timer_minutes": 5
    }
  ],
