{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "bath-buns",
  "name": "Bath Buns",
  "subtitle": "Soft British sweet buns with sugar and aromatic seeds",
  "description": "Tender enriched buns finished with sugar pearls and caraway or fennel seeds, served with clotted cream and jam.",
  "meal_type": "dessert",
  "cuisine": "British",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "unit": "medium"
    },
    {
      "ingredient_id": "strong-white-flour-plus-extra-for-dusting",
      "item": "strong white flour plus extra for dusting",
      "quantity": 600,
      "unit": "g"
    },
    {
      "ingredient_id": "unsalted-butter-softened",
      "item": "unsalted butter softened",
      "quantity": 120,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 80,
      "unit": "g"
    },
    {
      "ingredient_id": "sachet-fast-action-dried-yeast",
      "item": "sachet fast-action dried yeast",
      "quantity": 7,
      "unit": "g"
    },
    {
      "ingredient_id": "sunflower-oil-for-proving",
      "item": "sunflower oil for proving"
    },
    {
      "ingredient_id": "clotted-cream-and-jam",
      "item": "clotted cream and jam",
      "preparation": "to serve"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "caraway-or-fennel-seeds",
      "item": "caraway or fennel seeds",
      "quantity": "1 1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "white-sugar-pearls",
      "item": "white sugar pearls",
      "quantity": 2,
      "unit": "tbsp",
      "preparation": "or 3 white sugar cubes, crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk until hot but not boiling. Whisk in the eggs and set aside to cool slightly.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Rub the softened butter into the flour. Stir in the 80 g sugar and yeast, then mix in the warm milk mixture to form a dough."
    },
    {
      "step": 3,
      "text": "Knead until smooth, about 15 minutes. Place in an oiled bowl, cover, and leave to rise until doubled, about 1 hour.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Divide the dough into 12 pieces and shape into buns. Arrange on a floured baking tray, cover, and leave to rise for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Heat the oven to 200°F. Whisk the remaining 40 g sugar with the sugar pearls and seeds."
    },
    {
      "step": 6,
      "text": "Brush the buns with the sugar mixture and bake until golden brown, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Cool the buns before serving with clotted cream and jam."
    }
  ],
