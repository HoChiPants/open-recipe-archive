      "item": "mozzarella cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Fit the pastry into a 9-inch pie dish and bake for 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 2,
      "text": "Break the smoked salmon into small pieces and distribute it over the warm crust."
    },
    {
      "step": 3,
      "text": "Whisk the cream cheese, dill, and mozzarella together. In a separate bowl, whisk the eggs, milk, salt, and pepper."
    },
    {
      "step": 4,
      "text": "Layer the cheese mixture over the salmon, then pour the egg mixture into the crust."
    },
    {
      "step": 5,
      "text": "Bake for 50 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Cool for 5 minutes before slicing and serving.",
      "timer_minutes": 5
    }
  ],
