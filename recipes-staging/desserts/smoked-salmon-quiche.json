  "id": "smoked-salmon-quiche",
  "name": "Smoked Salmon Quiche",
  "subtitle": "A savory egg pie with salmon, dill, and cheese",
  "description": "A creamy smoked salmon quiche baked in a pastry crust until the center is fully set.",
  "meal_type": "dessert",
