  "schema_version": "1.0.0",
  "id": "easy-yogurt-cake",
  "name": "Easy Yogurt Cake",
  "subtitle": "A simple container-measured cake with vanilla and yogurt.",
  "description": "Mix the batter, pour it into a prepared pan, and bake until set for a tender everyday dessert.",
  "meal_type": "dessert",
  "cuisine": "French Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "5-ounce-container-plain-yogurt",
      "item": "(5 ounce) container plain yogurt",
      "quantity": 1
    },
    {
      "ingredient_id": "yogurt-container-vegetable-oil",
      "item": "yogurt container vegetable oil",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "yogurt-containers-white-sugar",
      "item": "yogurt containers white sugar",
      "quantity": "1 1/2"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "yogurt-containers-all-purpose-flour",
      "item": "yogurt containers all-purpose flour",
      "quantity": "1 3/4"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking pan for the batter."
    },
    {
      "step": 2,
      "text": "Combine the yogurt, oil, sugar, eggs, and vanilla. Whisk until smooth."
    },
    {
      "step": 3,
      "text": "Add the flour, baking powder, and salt. Stir just until a thick, uniform batter forms."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared pan and bake for about 25 to 30 minutes, until the center is firm and a tester comes out clean.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cool briefly before slicing and serving."
    }
  ],
