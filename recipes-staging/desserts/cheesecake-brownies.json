  "id": "cheesecake-brownies",
  "name": "Cheesecake Brownies",
  "subtitle": "Fudgy brownies with a smooth cream cheese layer",
  "description": "A simple layered brownie dessert finished with a lightly sweetened cream cheese swirl.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "brownie-mix",
      "item": "brownie mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a baking pan according to the brownie mix directions."
    },
    {
      "step": 2,
      "text": "Stir the brownie mix with the water, vegetable oil, and 2 large eggs until combined."
    },
    {
      "step": 3,
      "text": "Spread the brownie batter in the prepared pan."
    },
    {
      "step": 4,
      "text": "Whisk the cream cheese, remaining egg, and white sugar until smooth."
    },
    {
      "step": 5,
      "text": "Spoon the cream cheese mixture over the brownie batter and gently swirl or spread it across the surface."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Cool until set, then cut into 24 servings."
    }
  ],
