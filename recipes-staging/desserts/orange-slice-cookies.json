  "id": "orange-slice-cookies",
  "name": "Orange Slice Cookies",
  "subtitle": "Chewy oat cookies with bright citrus candy",
  "description": "A large batch of lightly browned oatmeal cookies studded with orange-flavored jelly candies.",
  "meal_type": "dessert",
  "cuisine": "American",
