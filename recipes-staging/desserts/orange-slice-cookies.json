  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Prepare baking sheets for the cookies."
    },
    {
      "step": 3,
      "text": "Whisk the white sugar, packed brown sugar, and shortening until combined."
    },
    {
      "step": 4,
      "text": "Add the eggs and vanilla extract, then whisk until blended."
    },
    {
      "step": 5,
      "text": "Stir in the all-purpose flour, baking powder, baking soda, and salt."
    },
    {
      "step": 6,
      "text": "Stir in the quick cooking oats and orange-flavored fruit slice jelly candies to form a dough."
    },
    {
      "step": 7,
      "text": "Shape the dough into cookies and transfer them to the prepared baking sheets."
    },
    {
      "step": 8,
      "text": "Bake for 12 minutes, until lightly browned.",
      "timer_minutes": 12
    },
    {
      "step": 9,
      "text": "Cool the cookies before serving."
    }
  ],
