  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Prepare a baking pan for the batter."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter and white sugar until blended. Add the eggs, water, and vanilla extract, then mix until smooth."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk together the all-purpose flour, unsweetened cocoa powder, baking soda, ground cinnamon, and ground nutmeg. Add the dry mixture to the wet mixture and stir just until combined."
    },
    {
      "step": 4,
      "text": "Fold in the apples and semisweet chocolate chips. Transfer the batter to the prepared pan and spread it evenly."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, or until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool the cake before slicing and serving."
    }
  ],
