  "id": "chocolate-chip-apple-cake",
  "name": "Chocolate Chip Apple Cake",
  "subtitle": "A warmly spiced apple cake with chocolate chips",
  "description": "A tender cocoa-kissed cake combining finely diced apples, cinnamon, nutmeg, and semisweet chocolate chips.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 75
  },
  "ingredients": [
