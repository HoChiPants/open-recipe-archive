{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "easy-custard-cake-filling",
  "name": "Easy Custard Cake Filling",
  "subtitle": "A smooth vanilla custard for layered cakes",
  "description": "A lightly sweetened microwave custard that cools into a creamy cake filling.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the milk in a microwave-safe bowl and microwave for 4 minutes, or until boiling.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Whisk the white sugar, all-purpose flour, and salt together. Gradually whisk the mixture into the hot milk."
    },
    {
      "step": 3,
      "text": "Microwave for 5 minutes, whisking until the mixture thickens.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Whisk the eggs in a separate bowl. Gradually whisk in some of the hot milk mixture, then whisk the egg mixture back into the bowl until smooth."
    },
    {
      "step": 5,
      "text": "Microwave for 2 minutes, whisking as needed, until thickened and the custard reaches 160°F or has a firm, fully set center.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Let the custard cool briefly, then stir in the vanilla extract. Cover and chill for 30 minutes before using.",
      "timer_minutes": 30
    }
  ],
