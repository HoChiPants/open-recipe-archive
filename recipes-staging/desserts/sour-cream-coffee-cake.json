  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking soda, and baking powder together."
    },
    {
      "step": 3,
      "text": "Beat the cup of butter with the white sugar until smooth. Add the eggs, sour cream, and vanilla, then whisk until blended."
    },
    {
      "step": 4,
      "text": "Add the dry ingredients to the wet mixture and stir just until a smooth batter forms."
    },
    {
      "step": 5,
      "text": "Combine the walnuts, confectioners' sugar, cinnamon, and melted butter to make the topping."
    },
    {
      "step": 6,
      "text": "Transfer half the batter to the pan, layer with half the topping, then spread in the remaining batter and finish with the remaining topping."
    },
    {
      "step": 7,
      "text": "Bake for 60 minutes, or until the center is fully set; an inserted thermometer should read at least 160°F.",
      "timer_minutes": 60
    }
  ],
