  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, baking soda, and sea salt together."
    },
    {
      "step": 2,
      "text": "Beat the softened butter, white sugar, and brown sugar until smooth. Add the egg and vanilla, then whisk until blended."
    },
    {
      "step": 3,
      "text": "Mix in the dry ingredients, then fold in the miniature semisweet chocolate chips."
    },
    {
      "step": 4,
      "text": "Shape the cookie dough into 24 portions and refrigerate for 120 minutes.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Preheat the oven to 350°F and prepare 24 cupcake wells."
    },
    {
      "step": 6,
      "text": "Whisk the three eggs, then combine them with the yellow cake mix, water, and canola oil. Mix for 2 minutes, or until smooth.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Fill the cupcake wells with batter, place one chilled cookie-dough portion in each, and cover with the remaining batter."
    },
    {
      "step": 8,
      "text": "Bake for 20 minutes, until the centers are firm and a thermometer inserted into the cake portion registers 160°F.",
      "timer_minutes": 20
    },
    {
      "step": 9,
      "text": "Cool the cupcakes for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
