  "id": "cookie-dough-cupcakes",
  "name": "Cookie Dough Cupcakes",
  "subtitle": "Vanilla cupcakes with a chocolate-chip cookie dough center",
  "description": "Bake tender yellow cupcakes around a chilled brown-sugar cookie dough filling for a fun dessert with contrasting textures.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
