{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "rolled-sugar-cookies",
  "name": "Rolled Sugar Cookies",
  "subtitle": "Chilled, cut-out cookies with crisp edges",
  "description": "A simple American sugar-cookie dough is chilled, rolled, cut into shapes, and baked until lightly browned.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 60,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the sugar and softened butter until smooth. Whisk in the eggs and vanilla extract."
    },
    {
      "step": 2,
      "text": "Stir together the flour, baking powder, and salt, then gradually combine with the butter mixture to form a dough."
    },
    {
      "step": 3,
      "text": "Chill the dough for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Preheat the oven to 400°F and prepare baking sheets."
    },
    {
      "step": 5,
      "text": "On a lightly floured surface, roll out the chilled dough and cut it into shapes. Transfer the cutouts to the prepared sheets."
    },
    {
      "step": 6,
      "text": "Bake for 8 minutes, or until lightly browned.",
      "timer_minutes": 8
    },
    {
      "step": 7,
      "text": "Transfer the cookies to a rack and let them cool before serving."
    }
  ],
