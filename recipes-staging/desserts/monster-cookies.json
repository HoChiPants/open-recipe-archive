  "id": "monster-cookies",
  "name": "Monster Cookies",
  "subtitle": "Peanut butter, oats, and chocolate chips in a classic homemade cookie.",
  "description": "A large-batch American cookie made by combining a peanut butter dough with oats and semisweet chocolate chips, then baking until lightly browned.",
  "meal_type": "dessert",
