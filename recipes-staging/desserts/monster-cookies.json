  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Beat the peanut butter and softened butter until smooth. Add the packed brown sugar and white sugar, and mix until combined."
    },
    {
      "step": 3,
      "text": "Add the eggs one at a time, mixing after each addition. Stir in the vanilla extract."
    },
    {
      "step": 4,
      "text": "Mix in the rolled oats and baking soda until a cohesive dough forms. Fold in the semisweet chocolate chips."
    },
    {
      "step": 5,
      "text": "Portion the dough onto baking sheets, leaving space between portions. Bake for 15 minutes, or until lightly browned.",
      "timer_minutes": 15
    }
  ],
