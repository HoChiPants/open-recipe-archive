    "inactive_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.33000001311302,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 2,
      "unit": "cups",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grease a baking sheet with some of the butter."
    },
    {
      "step": 2,
      "text": "Combine the brown sugar, white sugar, water, and remaining butter in a saucepan."
    },
    {
      "step": 3,
      "text": "Simmer, stirring as needed, until the syrup reaches 240°F on a food thermometer. Handle the hot syrup carefully.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Stir in the chopped pecans, then continue stirring until the mixture thickens slightly."
    },
    {
      "step": 5,
      "text": "Drop spoonfuls onto the prepared baking sheet and let cool until firm.",
      "timer_minutes": 40
    }
  ],
