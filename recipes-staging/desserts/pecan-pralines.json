  "id": "pecan-pralines",
  "name": "Pecan Pralines",
  "subtitle": "Buttery pecan candies with a crisp finish",
  "description": "A simple stovetop candy made by cooking sugars with butter and water, then folding in chopped pecans and cooling until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
