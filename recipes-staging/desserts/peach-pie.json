  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the peaches with half of the cup of sugar and the salt. Let stand for 30 minutes, then drain the accumulated juices into a saucepan.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Add the lemon juice to the peach juices and simmer briefly. Remove from the heat and let cool while preparing the filling."
    },
    {
      "step": 4,
      "text": "Whisk the remaining cup sugar with the flour and cornstarch. Stir the mixture into the peaches with the cayenne and cinnamon, coating the fruit evenly."
    },
    {
      "step": 5,
      "text": "Line a 10-inch pie plate with half of the pastry. Add the peach filling and dot it with the butter."
    },
    {
      "step": 6,
      "text": "Cut the remaining pastry into strips or shapes, arrange it over the filling, and seal and crimp the edges."
    },
    {
      "step": 7,
      "text": "Whisk the cream with the remaining tablespoon sugar and brush it over the pastry."
    },
    {
      "step": 8,
      "text": "Bake until the crust is golden and the filling is bubbling, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 9,
      "text": "Cool the pie before slicing and serving."
    }
  ],
