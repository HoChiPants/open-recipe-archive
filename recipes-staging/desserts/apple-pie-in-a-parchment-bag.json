  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Stir 1 cup flour and white sugar together. Cut in the unsalted butter until crumbly, then add the cold water and mix until a thick dough forms, adding more water as needed."
    },
    {
      "step": 3,
      "text": "Shape the dough into a disk, wrap or cover it, and chill briefly while preparing the filling."
    },
    {
      "step": 4,
      "text": "Stir the apples with brown sugar, 2 tablespoons flour, cinnamon, nutmeg, ginger, and lemon juice."
    },
    {
      "step": 5,
      "text": "Combine the remaining flour, softened butter, and superfine sugar until a crumbly topping forms."
    },
    {
      "step": 6,
      "text": "Roll or press the dough into a thick round. Sprinkle the graham cracker crumbs over the center, leaving a border, and pile the apple mixture on top."
    },
    {
      "step": 7,
      "text": "Add the crumb topping, then shape the pastry around the filling as a covered pie."
    },
    {
      "step": 8,
      "text": "Place the pie on one parchment piece and cover it with the second. Fold and crimp the parchment edges into a sealed packet, then transfer it to a baking sheet."
    },
    {
      "step": 9,
      "text": "Bake the sealed packet for 60 minutes, until the apples are tender and the crust is set.",
      "timer_minutes": 60
    },
    {
      "step": 10,
      "text": "Open the packet carefully, cool the pie for 20 minutes, and serve.",
      "timer_minutes": 20
    }
  ],
