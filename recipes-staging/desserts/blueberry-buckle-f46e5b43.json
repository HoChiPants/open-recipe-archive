  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Grease a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter and 1.5 cups white sugar until smooth. Whisk in the eggs."
    },
    {
      "step": 3,
      "text": "Combine 4 cups flour, baking powder, and salt. Stir the dry mixture into the batter alternately with the milk until combined."
    },
    {
      "step": 4,
      "text": "Fold in the fresh blueberries and spread the batter in the prepared pan."
    },
    {
      "step": 5,
      "text": "Combine 1.3333333730698 cups white sugar, 1 cup flour, and cinnamon. Cut in the cold butter until coarse crumbs form, then scatter the topping over the batter."
    },
    {
      "step": 6,
      "text": "Bake at 375°F until the center is firm and a tester comes out clean, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Cool before slicing and serving."
    }
  ],
