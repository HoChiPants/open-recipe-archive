  "id": "chocolate-sandwich-cookie-bark",
  "name": "Chocolate Sandwich Cookie Bark",
  "subtitle": "Creamy white chocolate bark with crunchy cookie pieces",
  "description": "A simple no-bake candy made by coating broken chocolate sandwich cookies in melted white chocolate, then chilling until firm and cutting into pieces.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 50,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "chocolate-sandwich-cookies-with-creme-filling",
      "item": "chocolate sandwich cookies with creme filling",
      "quantity": 1,
      "unit": "package",
      "preparation": "20 ounce"
    },
    {
      "ingredient_id": "white-chocolate",
      "item": "white chocolate",
      "quantity": 2,
      "unit": "package",
      "preparation": "18.5 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Break the chocolate sandwich cookies into bite-size pieces and set aside some pieces for the topping."
    },
    {
      "step": 2,
      "text": "Place the white chocolate and the cookie pieces in a microwave-safe bowl. Microwave in short intervals, stirring between each, until the chocolate is smooth and the cookies are coated."
    },
    {
      "step": 3,
      "text": "Fold in the remaining cookie pieces, if any, then transfer the mixture to a lined tray and spread it into an even layer."
    },
    {
      "step": 4,
      "text": "Chill until set, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Cut or break the bark into serving pieces."
    }
  ],
