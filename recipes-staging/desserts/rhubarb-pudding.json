  "id": "rhubarb-pudding",
  "name": "Rhubarb Pudding",
  "subtitle": "A warm, tender bake with tart rhubarb and a caramel-like sauce",
  "description": "A simple baked pudding that combines chopped rhubarb with a sweet brown-sugar sauce.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "rhubarb",
      "item": "rhubarb",
      "quantity": 2,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "boiling-water",
      "item": "boiling water",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter-or-margarine",
      "item": "butter or margarine",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, white sugar, baking powder, and brown sugar together in a bowl."
    },
    {
      "step": 3,
      "text": "Stir in the milk, then fold in the chopped rhubarb to make a thick batter."
    },
    {
      "step": 4,
      "text": "Transfer the batter to a baking dish and spread it evenly."
    },
    {
      "step": 5,
      "text": "Combine the white sugar, brown sugar, boiling water, and butter or margarine; stir until the butter melts and the mixture is boiling."
    },
    {
      "step": 6,
      "text": "Pour the hot mixture over the batter without stirring."
    },
    {
      "step": 7,
      "text": "Bake for 50 minutes, until the pudding is set in the center.",
      "timer_minutes": 50
    }
  ],
