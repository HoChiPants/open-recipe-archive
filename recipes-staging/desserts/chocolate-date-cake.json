  "id": "chocolate-date-cake",
  "name": "Chocolate Date Cake",
  "subtitle": "A moist chocolate cake with dates, walnuts, and chocolate chips",
  "description": "Dates add softness and natural sweetness to this tender chocolate cake, finished with walnuts and semisweet chocolate chips.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
