    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "dates",
      "item": "dates",
      "quantity": 1,
      "unit": "cup",
      "preparation": "pitted and chopped"
    },
    {
      "ingredient_id": "boiling-water",
      "item": "boiling water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
