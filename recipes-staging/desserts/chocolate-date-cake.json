      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1,
      "unit": "cup",
      "preparation": "divided"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the dates and boiling water; let the mixture cool."
    },
    {
      "step": 2,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 3,
      "text": "Whisk together the flour, baking soda, salt, and cocoa powder."
    },
    {
      "step": 4,
      "text": "Beat the sugar and butter until blended. Add the eggs and mix until smooth."
    },
    {
      "step": 5,
      "text": "Add the dry ingredients and cooled date mixture, mixing just until combined. Fold in part of the chocolate chips and the walnuts."
    },
    {
      "step": 6,
      "text": "Transfer the batter to a prepared baking pan and scatter the remaining chocolate chips over the top."
    },
    {
      "step": 7,
      "text": "Bake until the center is firm and set, about 45 minutes.",
      "timer_minutes": 45
    }
  ],
