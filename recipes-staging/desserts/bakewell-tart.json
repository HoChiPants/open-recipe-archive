  "id": "bakewell-tart",
  "name": "Bakewell Tart",
  "subtitle": "Jam-filled almond tart with crisp pastry",
  "description": "A British pastry tart layered with raspberry jam and almond filling, finished with flaked almonds and icing sugar.",
  "meal_type": "dessert",
