  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a tart pan."
    },
    {
      "step": 2,
      "text": "Mix the flour, salt, and 2 tablespoons icing sugar. Rub in the cold butter until crumbly, then mix in the beaten egg yolks to form a dough."
    },
    {
      "step": 3,
      "text": "Chill the dough for 30 minutes, then roll it out on a lightly floured surface and use it to line the pan.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Spread the raspberry jam over the pastry base and bake until the crust is lightly set.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Beat the softened salted butter with the caster sugar. Mix in the ground almonds, almond extract, and beaten eggs until combined."
    },
    {
      "step": 6,
      "text": "Spread the almond mixture over the jam, scatter the flaked almonds on top, and bake until firm and the center reaches 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Cool the tart, then dust it with the remaining icing sugar. Serve with cream or custard if desired."
    }
  ],
