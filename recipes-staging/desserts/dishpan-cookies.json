  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the brown sugar, white sugar, vanilla, vegetable oil, and eggs until blended."
    },
    {
      "step": 3,
      "text": "Add the flour, oats, baking soda, and salt, and stir just until combined."
    },
    {
      "step": 4,
      "text": "Fold in the cornflakes, chopped pecans, and coconut."
    },
    {
      "step": 5,
      "text": "Portion the dough onto baking sheets, leaving space between portions."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, until the cookies are set and lightly browned.",
      "timer_minutes": 10
    }
