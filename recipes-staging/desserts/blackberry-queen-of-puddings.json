  "id": "blackberry-queen-of-puddings",
  "name": "Blackberry Queen of Puddings",
  "subtitle": "A baked breadcrumb custard with blackberry jam and soft meringue",
  "description": "A warm baked pudding layered with lime-scented breadcrumbs, blackberries, jam, and a browned meringue topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
