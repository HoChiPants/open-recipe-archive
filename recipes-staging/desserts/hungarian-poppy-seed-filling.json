{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "hungarian-poppy-seed-filling",
  "name": "Hungarian Poppy Seed Filling",
  "subtitle": "A rich, gently sweet filling for baked pastries",
  "description": "Cooked poppy seeds combine with sweetened milk and beaten eggs to make a spoonable filling for pastries and other desserts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "poppy-seeds",
      "item": "poppy seeds",
      "quantity": 0.5,
      "unit": "pound"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grind or finely prepare the poppy seeds. Combine the milk, margarine, white sugar, and salt in a saucepan."
    },
    {
      "step": 2,
      "text": "Heat the milk mixture over medium heat, stirring until the margarine melts and the sugar dissolves. Add the poppy seeds and cook, stirring frequently, for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Gradually whisk some of the hot mixture into the beaten eggs, then return the egg mixture to the saucepan. Cook gently, stirring constantly, until thickened and the mixture reaches 160°F."
    },
    {
      "step": 4,
      "text": "Remove from the heat and cool completely before using as a filling.",
      "timer_minutes": 30
    }
  ],
