  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter, 0.5 cup light brown sugar, 0.25 cup white sugar, and 0.5 teaspoon vanilla. Add the large egg and whisk for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir in 1.25 cups flour, 0.5 teaspoon salt, baking soda, and chocolate chips until combined. Set aside."
    },
    {
      "step": 4,
      "text": "Whisk the melted butter, 1 cup white sugar, and 1 teaspoon vanilla. Add the eggs and whisk until blended."
    },
    {
      "step": 5,
      "text": "Stir in the cocoa powder, 0.5 cup flour, baking powder, and 0.125 teaspoon salt until combined."
    },
    {
      "step": 6,
      "text": "Layer portions of both mixtures on the prepared sheet, keeping the portions separate enough to form individual cookies."
    },
    {
      "step": 7,
      "text": "Bake for 20 minutes, or until the centers are fully set and an inserted food thermometer reads 160°F.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "Cool the cookies before serving."
    }
  ],
