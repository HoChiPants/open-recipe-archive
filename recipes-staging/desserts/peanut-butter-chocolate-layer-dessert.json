  "id": "peanut-butter-chocolate-layer-dessert",
  "name": "Peanut Butter Chocolate Layer Dessert",
  "subtitle": "A chilled dessert with a crumb crust and creamy pudding layers",
  "description": "Build a simple graham cracker crust, add peanut butter and cream cheese filling, then finish with chocolate-vanilla pudding, peanuts, and grated chocolate.",
  "meal_type": "dessert",
