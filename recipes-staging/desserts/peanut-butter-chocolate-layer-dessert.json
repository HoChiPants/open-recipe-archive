  "instructions": [
    {
      "step": 1,
      "text": "Combine the graham cracker crumbs, white sugar, and melted butter. Press the mixture evenly into a 9-by-13-inch dish."
    },
    {
      "step": 2,
      "text": "Beat the cream cheese, peanut butter, and confectioners' sugar until smooth. Fold in half of the thawed whipped topping, then spread the mixture over the crust."
    },
    {
      "step": 3,
      "text": "Whisk the vanilla and chocolate pudding mixes with the milk until thickened. Fold in the remaining whipped topping and spread over the cream cheese layer."
    },
    {
      "step": 4,
      "text": "Top with the chopped peanuts and grated semisweet chocolate."
    },
    {
      "step": 5,
      "text": "Cover and chill until firm, about 4 hours, then cut into servings.",
      "timer_minutes": 240
    }
  ],
