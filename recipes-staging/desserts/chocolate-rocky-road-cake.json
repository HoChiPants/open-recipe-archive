  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven and grease a cake tin with some of the softened butter. Line the base if desired.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Whisk the softened butter, oil, yogurt, milk, cooled coffee mixture, eggs, and brown sugar until combined."
    },
    {
      "step": 3,
      "text": "Add the flour, baking powder, and cocoa powder, then whisk just until the batter is smooth."
    },
    {
      "step": 4,
      "text": "Pour the batter into the prepared tin and bake for 55 minutes, until firm. Cool completely in the tin.",
      "timer_minutes": 55
    },
    {
      "step": 5,
      "text": "Break the biscuits into pieces. Melt the cubed butter, chopped chocolate, and golden syrup together, stirring until smooth."
    },
    {
      "step": 6,
      "text": "Stir the biscuit pieces, marshmallows, and chosen extras into the chocolate mixture. Spread it over the cooled cake and add the reserved topping ingredients."
    },
    {
      "step": 7,
      "text": "Chill for 2 hours, or until the topping is set. Remove from the tin and cut into portions.",
      "timer_minutes": 120
    }
  ],
