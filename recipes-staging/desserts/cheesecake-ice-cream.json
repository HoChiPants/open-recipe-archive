  "id": "cheesecake-ice-cream",
  "name": "Cheesecake Ice Cream",
  "subtitle": "A smooth, tangy frozen dessert with vanilla and citrus notes.",
  "description": "Blend softened cream cheese with milk, sugar, triple sec, vanilla, and salt for a creamy cheesecake-inspired ice cream.",
  "meal_type": "dessert",
  "cuisine": "American",
