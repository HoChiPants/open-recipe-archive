  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened cream cheese until smooth and pliable."
    },
    {
      "step": 2,
      "text": "Add the milk, sugar, triple sec, vanilla extract, and salt; whisk until evenly combined."
    },
    {
      "step": 3,
      "text": "Blend the mixture until completely smooth, then freeze for 60 minutes.",
