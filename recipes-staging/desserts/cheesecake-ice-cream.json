  "ingredients": [
    {
      "ingredient_id": "lowfat-1-milk",
      "item": "lowfat 1% milk",
      "quantity": 1,
      "unit": "quart"
    },
    {
      "ingredient_id": "reduced-fat-cream-cheese",
      "item": "reduced fat cream cheese",
      "quantity": 2,
