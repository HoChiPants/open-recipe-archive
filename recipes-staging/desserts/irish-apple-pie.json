  "instructions": [
    {
      "step": 1,
      "text": "Combine the all-purpose flour, cake flour, 1 tablespoon white sugar, and salt. Cut in the cold butter and shortening until the mixture forms coarse crumbs."
    },
    {
      "step": 2,
      "text": "Mix the sour cream with 1/8 teaspoon lemon juice, then stir it into the flour mixture until a dough forms. Shape the dough into a disk, wrap it, and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 4,
      "text": "Roll out the chilled dough and use part of it to line a pie dish. Roll the remaining dough into a top crust."
    },
    {
      "step": 5,
      "text": "Arrange the sliced apples in the crust. Stir together the remaining white sugar, 2 tablespoons all-purpose flour, and nutmeg, then sprinkle over the apples. Drizzle with the remaining lemon juice."
    },
    {
      "step": 6,
      "text": "Cover with the top crust, trim and seal the edges, and cut vents in the surface. Brush with the beaten egg."
    },
    {
      "step": 7,
      "text": "Bake for 45 minutes, until the crust is golden brown and the filling is bubbling with the center set.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Cool before slicing."
    }
  ],
