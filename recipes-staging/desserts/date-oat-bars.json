  "id": "date-oat-bars",
  "name": "Date Oat Bars",
  "subtitle": "Layered oat bars with a tender date center",
  "description": "A simple American dessert made with a buttery oat mixture and a cooked date filling, baked until lightly browned.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "quick-cooking-oats",
      "item": "quick cooking oats",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dates",
      "item": "dates",
      "quantity": 2,
      "unit": "cups",
      "preparation": "pitted and chopped"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the dates with the water, white sugar, and baking soda until softened and thickened; set aside."
    },
    {
      "step": 3,
      "text": "Mix the oats, flour, brown sugar, butter, and salt until evenly combined. Reserve part of this mixture for the topping."
    },
    {
      "step": 4,
      "text": "Press the remaining oat mixture into the bottom of a baking pan and spread the date filling over it."
    },
    {
      "step": 5,
      "text": "Cover evenly with the reserved oat mixture, then bake at 350°F until the top is golden and the layers are set.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Cool before cutting into 24 bars."
    }
  ],
