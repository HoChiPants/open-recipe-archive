  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Toss the peaches with the first white sugar, brown sugar, cinnamon, nutmeg, lemon juice, and cornstarch; spread the mixture in a baking dish."
    },
    {
      "step": 2,
      "text": "Bake the peaches for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Meanwhile, whisk the flour, the second white sugar, the second brown sugar, baking powder, and salt. Cut in the chilled butter until coarse crumbs form, then stir in the boiling water just until combined."
    },
    {
      "step": 4,
      "text": "Spoon the topping over the hot peaches. Mix the remaining white sugar with the remaining cinnamon and sprinkle over the surface."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until the topping is golden and the fruit is bubbling. Cool briefly before serving.",
      "timer_minutes": 30
    }
  ],
