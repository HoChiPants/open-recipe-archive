  "id": "fried-banana-balls",
  "name": "Fried Banana Balls",
  "subtitle": "Crisp, cinnamon-scented banana bites",
  "description": "Mashed ripe bananas are folded into a lightly spiced batter, fried until golden, and finished with confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "very-ripe-bananas",
      "item": "very ripe bananas",
      "quantity": 4
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "oil-for-frying",
      "item": "oil for frying",
      "quantity": 2,
      "unit": "cups",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, baking powder, and salt together in a bowl."
    },
    {
      "step": 2,
      "text": "Mash the bananas with the white sugar, vanilla, and cinnamon until mostly smooth. Stir in the flour mixture to make a thick batter."
    },
    {
      "step": 3,
      "text": "Heat the frying oil in a deep, heavy pan over medium-high heat until hot. Carefully drop rounded spoonfuls of batter into the oil in batches, leaving space between them."
    },
    {
      "step": 4,
      "text": "Fry for about 3 minutes, turning as needed, until the balls are evenly golden brown. Transfer them to a paper-lined plate to drain.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Dust the warm banana balls with confectioners' sugar and serve."
    }
  ],
