  "id": "buttercream-icing-e9fa32ae",
  "name": "Buttercream Icing",
  "subtitle": "Smooth icing for filling, covering, and piping",
  "description": "A quick buttercream made by whipping softened butter with sifted icing sugar, then adding citrus zest, vanilla, coloring, or cocoa as desired.",
  "meal_type": "dessert",
  "cuisine": "British",
  "yield": {
    "quantity": 12,
    "unit": "cupcakes/fill and cover a 20cm cake"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "icing-sugar-sifted",
      "item": "icing sugar sifted",
      "quantity": 600,
      "unit": "g"
    },
    {
      "ingredient_id": "unsalted-or-salted-butter-softened",
      "item": "unsalted or salted butter softened",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "finely-grated-lemon-zest",
      "item": "finely grated lemon zest"
    },
    {
      "ingredient_id": "finely-grated-orange-zest",
      "item": "finely grated orange zest"
    },
    {
      "ingredient_id": "a-dash-of-vanilla-extract",
      "item": "a dash of vanilla extract"
    },
    {
      "ingredient_id": "few-drops-food-colouring",
      "item": "few drops food colouring"
    },
    {
      "ingredient_id": "cocoa-powder-to-taste",
      "item": "cocoa powder to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened butter and sifted icing sugar together until smooth, pale, and creamy."
    },
    {
      "step": 2,
      "text": "Mix in the lemon zest, orange zest, vanilla extract, food colouring, or cocoa powder according to preference, then use immediately."
    }
  ],
