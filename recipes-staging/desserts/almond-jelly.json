  "id": "almond-jelly",
  "name": "Almond Jelly",
  "subtitle": "A chilled almond-scented milk gelatin dessert",
  "description": "A lightly sweet, firm-set dessert that is chilled, then cut into portions.",
  "meal_type": "dessert",
  "cuisine": "Chinese",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
