  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "25-ounce-envelopes-unflavored-gelatin-powder",
      "item": "(.25 ounce) envelopes unflavored gelatin powder",
      "quantity": 2
    },
    {
