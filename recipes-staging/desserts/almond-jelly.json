      "item": "almond extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour 1 cup water into a bowl, sprinkle the gelatin evenly over it, and let it stand until softened."
    },
    {
      "step": 2,
      "text": "Bring the remaining 1 cup water to a simmer in a saucepan. Add the softened gelatin, milk, sugar, and almond extract; stir over low heat until the gelatin and sugar dissolve.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pour the mixture into a shallow dish and refrigerate until firm.",
      "timer_minutes": 180
    },
    {
      "step": 4,
      "text": "Cut the chilled jelly into portions and serve."
    }
  ],
