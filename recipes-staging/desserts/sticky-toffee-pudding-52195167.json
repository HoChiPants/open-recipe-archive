  "instructions": [
    {
      "step": 1,
      "text": "Combine the dates, raisins, and rum in a saucepan. Warm for 5 minutes, then remove from the heat and cool.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Butter a large pudding basin and prepare a covered steamer or deep pot with a rack and enough simmering water to reach halfway up the basin."
    },
    {
      "step": 3,
      "text": "Beat the softened butter and 50 g muscovado sugar until combined. Gradually whisk in the beaten eggs."
    },
    {
      "step": 4,
      "text": "Fold in the self-raising flour, mixed spice, cinnamon, milk, and cooled fruit mixture until evenly combined."
    },
    {
      "step": 5,
      "text": "Spoon the batter into the prepared basin, cover securely, and steam for 2 hours, replenishing the water as needed. The center should be firm and set.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "For the sauce, heat 75 g muscovado sugar, treacle, golden syrup, 75 g butter, and double cream in a saucepan for about 5 minutes, stirring until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Turn out the pudding and serve warm with the toffee sauce and vanilla custard or ice cream."
    }
  ],
