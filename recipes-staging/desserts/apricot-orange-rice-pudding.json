  "id": "apricot-orange-rice-pudding",
  "name": "Apricot & Orange Rice Pudding",
  "subtitle": "Creamy rice pudding with citrus and dried apricots",
  "description": "A simple stovetop rice pudding finished with orange, apricots, fromage frais, honey, and toasted almonds.",
  "meal_type": "dessert",
  "cuisine": "British",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 16
  },
  "ingredients": [
    {
      "ingredient_id": "pudding-rice",
      "item": "pudding rice",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "skimmed-milk",
      "item": "skimmed milk",
      "quantity": 600,
      "unit": "ml"
    },
    {
      "ingredient_id": "big-pinch-ground-nutmeg",
      "item": "big pinch ground nutmeg"
    },
    {
      "ingredient_id": "clear-honey-plus-extra-to-serve",
      "item": "clear honey plus extra to serve",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "ready-to-eat-dried-apricot-roughly-chopped",
      "item": "ready-to-eat dried apricot roughly chopped",
      "quantity": 140,
      "unit": "g"
    },
    {
      "ingredient_id": "zest-and-juice-1-orange",
      "item": "zest and juice 1 orange"
    },
    {
      "ingredient_id": "reduced-fat-fromage-frais",
      "item": "reduced-fat fromage frais",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "handful-toasted-sliced-almonds",
      "item": "handful toasted sliced almonds"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the pudding rice and skimmed milk in a saucepan. Bring to a gentle simmer and cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir the rice mixture, then add the ground nutmeg and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir in the honey, chopped apricots, orange zest, and orange juice. Cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Remove from the heat and fold in the fromage frais. Spoon into bowls."
    },
    {
      "step": 5,
      "text": "Serve with extra honey, orange zest or juice, and toasted sliced almonds."
    }
  ],
