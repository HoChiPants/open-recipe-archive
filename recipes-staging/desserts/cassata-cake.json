  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Prepare the cake flour mixture with the baking powder and salt."
    },
    {
      "step": 2,
      "text": "Separate the eggs. Beat the yolks with 1.25 cups white sugar until thick, then blend in the cold water and 1 teaspoon vanilla extract. Fold in the flour mixture.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Whip the egg whites with the cream of tartar until stiff peaks form, then fold them gently into the batter. Transfer to the prepared cake pan and bake until set, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Cool the cake in the pan for 10 minutes, then cool it completely on a rack.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Beat the ricotta with the remaining confectioners' sugar, remaining white sugar, and cinnamon until smooth. Mix in the remaining vanilla extract, semi-sweet chocolate, bittersweet chocolate, and candied lemon peel. Chill the filling."
    },
    {
      "step": 6,
      "text": "Warm the remaining white sugar, water, and light rum together until the sugar dissolves. Cool the syrup.",
      "timer_minutes": 1
    },
    {
      "step": 7,
      "text": "Cut the cooled cake into layers or pieces that fit the serving dish. Brush or spoon the syrup over the cake, add ricotta filling between the layers, and finish with cake."
    },
    {
      "step": 8,
      "text": "Cover and chill the assembled cake for 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 9,
      "text": "Melt the remaining bittersweet chocolate with the heavy whipping cream and cubed butter, stirring until smooth. Cool briefly, then spread or drizzle the glaze over the chilled cake."
    }
  ],
