      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "pint"
    },
    {
      "ingredient_id": "cherry-pie-filling",
      "item": "cherry pie filling",
      "quantity": 1,
      "unit": "can",
      "preparation": "21 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Arrange the ladyfingers in the bottom of a serving dish or baking pan, shaping them to fit as needed."
    },
    {
      "step": 2,
      "text": "Whisk the softened cream cheese and heavy whipping cream until combined. Add the vanilla extract and white sugar, then continue whisking until smooth."
    },
    {
      "step": 3,
      "text": "Spread part of the cream-cheese mixture over the ladyfingers. Add another layer of ladyfingers and the remaining cream mixture, then spoon the cherry pie filling over the top."
    },
    {
      "step": 4,
      "text": "Cover and chill before serving."
    }
  ],
