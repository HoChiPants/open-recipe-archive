  "id": "ladyfinger-cheesecake",
  "name": "Ladyfinger Cheesecake",
  "subtitle": "A chilled layered dessert with cherry topping",
  "description": "Arrange ladyfingers with a smooth sweet cream-cheese filling and cherry pie topping, then chill until ready to serve.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
