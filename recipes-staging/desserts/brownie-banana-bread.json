  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "brownie-banana-bread",
  "name": "Brownie Banana Bread",
  "subtitle": "A chocolate-rich banana loaf with a brownie-like crumb",
  "description": "Mashed ripe bananas and cocoa enrich this simple chocolate loaf, while melted dark chocolate gives it a dense, fudgy texture.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-cut-into-pieces",
      "item": "unsalted butter cut into pieces",
      "quantity": 125,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "dark-chocolate-chopped-into-small-chunks",
      "item": "dark chocolate chopped into small chunks",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "ripe-bananas-peeled-and-mashed",
      "item": "ripe bananas peeled and mashed",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease a loaf tin with some of the butter."
    },
    {
      "step": 2,
      "text": "Melt the butter and dark chocolate together gently, using a simmering-water setup or short microwave intervals. Stir until smooth, then cool until set."
    },
    {
      "step": 3,
      "text": "Whisk the sugar and eggs in a bowl until well combined."
    },
    {
      "step": 4,
      "text": "Combine the self-raising flour and cocoa powder separately, then add them to the egg mixture."
    },
    {
      "step": 5,
      "text": "Fold in the melted chocolate mixture and mashed bananas until just combined."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared tin and bake for 50 minutes, or until set in the center.",
      "timer_minutes": 50
    },
    {
      "step": 7,
      "text": "Leave the loaf to cool in the tin for 10 minutes before removing it.",
      "timer_minutes": 10
    }
  ],
