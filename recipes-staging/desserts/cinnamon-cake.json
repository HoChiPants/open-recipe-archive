  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Stir together the flour, baking powder, 1 teaspoon cinnamon, and salt."
    },
    {
      "step": 3,
      "text": "Whisk 1 1/3 cups sugar, shortening, and 1 1/2 teaspoons vanilla until combined. Add the eggs and whisk for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the flour mixture and milk alternately, whisking just until the batter is smooth."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 45 minutes, until the center is firm and fully set or reaches 160°F on a food thermometer.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "While the cake bakes, combine the remaining sugar, water, butter, remaining cinnamon, and remaining vanilla in a saucepan. Heat gently, stirring, until the butter melts and the mixture is smooth."
    },
    {
      "step": 7,
      "text": "Cool the cake for 10 minutes, then spread or pour the warm topping over it. Let it stand for 30 minutes before serving.",
      "timer_minutes": 30
    }
  ],
