      "item": "miniature marshmallows",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Place the chopped sweet potatoes in a baking dish. Pour the caramel topping over them, then add the brown sugar and butter."
    },
    {
      "step": 3,
      "text": "Bake until the sweet potatoes are tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Scatter the miniature marshmallows over the sweet potatoes and return the dish to the oven until the marshmallows are melted, about 10 minutes.",
      "timer_minutes": 10
    }
  ],
