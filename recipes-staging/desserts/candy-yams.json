  "id": "candy-yams",
  "name": "Candy Yams",
  "subtitle": "Tender sweet potatoes with caramel and toasted marshmallows",
  "description": "Chopped sweet potatoes bake with caramel topping, brown sugar, and butter, then finish under a layer of melted miniature marshmallows.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-potato",
      "item": "sweet potato",
      "quantity": 4,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "12-ounce-jar-caramel-topping",
      "item": "(12 ounce) jar caramel topping",
      "quantity": 1
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.125,
      "unit": "cup"
    },
