  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chinese-sweet-bun-dough",
  "name": "Chinese Sweet Bun Dough",
  "subtitle": "Soft, lightly sweetened yeast dough for sesame-topped buns",
  "description": "A tender enriched dough made with milk, eggs, oil, and sugar, shaped into individual buns and finished with sesame seeds.",
  "meal_type": "dessert",
  "cuisine": "Chinese",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20,
    "inactive_minutes": 150
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "warm-milk-110-degrees-f-45-degrees-c",
      "item": "warm milk (110 degrees F/45 degrees C)",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "bread-flour",
      "item": "bread flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten (divided)"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "sesame-seeds-for-garnish-divided",
      "item": "sesame seeds for garnish (divided)",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the sugar into the warm milk. Stir in the yeast and let stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Mix the flour, most of the beaten eggs, oil, and salt with the yeast mixture until a dough forms."
    },
    {
      "step": 3,
      "text": "Knead the dough for 10 minutes, until smooth. Place it in a lightly oiled bowl, cover, and let rise until doubled, about 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 4,
      "text": "Knead the risen dough briefly, then divide it into 12 pieces and shape each into a bun.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Arrange the buns on a baking sheet, cover, and let rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 7,
      "text": "Whisk the remaining beaten egg with the water. Brush the buns with the egg mixture and sprinkle with the sesame seeds."
    },
    {
      "step": 8,
      "text": "Bake until puffed and golden, about 20 minutes. Serve warm.",
      "timer_minutes": 20
    }
  ],
