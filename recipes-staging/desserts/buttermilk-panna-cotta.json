  "id": "buttermilk-panna-cotta",
  "name": "Buttermilk Panna Cotta",
  "subtitle": "A silky chilled dessert with bright lemon flavor",
  "description": "Gelatin-set cream and buttermilk create a smooth, lightly tangy panna cotta scented with lemon and vanilla.",
  "meal_type": "dessert",
  "cuisine": "Italian",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0,
    "inactive_minutes": 300
  },
  "ingredients": [
    {
      "ingredient_id": "25-ounce-envelope-unflavored-gelatin",
      "item": "(.25 ounce) envelope unflavored gelatin",
      "quantity": 1
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "strips-lemon-peel",
      "item": "strips lemon peel",
      "quantity": 3
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.5,
      "unit": "pinch"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Sprinkle the gelatin over the cold water in a small bowl and let it stand for 10 minutes to soften.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the heavy cream and white sugar in a saucepan. Add the lemon peel and fresh lemon juice, then warm the mixture until hot but not boiling.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Remove the saucepan from the heat. Whisk in the softened gelatin, kosher salt, and vanilla extract until the gelatin dissolves completely."
    },
    {
      "step": 4,
      "text": "Stir in the buttermilk, then remove the lemon peel and whisk until smooth."
    },
    {
      "step": 5,
      "text": "Pour the mixture into serving dishes and let it cool."
    },
    {
      "step": 6,
      "text": "Cover and refrigerate until fully set.",
      "timer_minutes": 300
    }
  ],
