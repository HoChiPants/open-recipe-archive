  "instructions": [
    {
      "step": 1,
      "text": "Whisk the soft cheese, butter, and 30 g soft light brown sugar until smooth. Mix in the salt and vanilla, then add the flour and combine into a dough. Chill until firm, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Combine the caster sugar, remaining soft light brown sugar, cinnamon, raisins, and walnuts for the filling."
    },
    {
      "step": 3,
      "text": "Heat the oven to 350°F. Lightly flour the work surface and roll the dough out evenly. Spread with apricot jam, then scatter over the filling."
    },
    {
      "step": 4,
      "text": "Cut the dough into wedges, roll each wedge from the wide end to the point, and arrange the pastries on a baking sheet. Brush with the beaten egg mixture."
    },
    {
      "step": 5,
      "text": "Sprinkle with the reserved caster sugar and cinnamon. Chill the shaped pastries until firm, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until lightly browned and the center is fully set, reaching 160°F on a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Cool before serving."
    }
  ],
