      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "cook-and-serve-vanilla-pudding-not-instant",
      "item": "cook-and-serve vanilla pudding (not instant)",
      "quantity": 1,
      "unit": "package",
      "preparation": "3 ounce"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
