  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Combine the flour, cook-and-serve vanilla pudding, baking powder, and salt. Add the milk, softened butter, and egg; whisk for 2 minutes until smooth, then transfer the batter to a pie dish.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Drain the peaches. Mix 1 tablespoon white sugar with the cinnamon. Whisk the cream cheese until smooth, then whisk in the remaining white sugar."
    },
    {
      "step": 3,
      "text": "Arrange the peaches over the batter and sprinkle with the cinnamon-sugar mixture. Spoon the cream cheese mixture over the peaches and spread gently."
    },
    {
      "step": 4,
      "text": "Bake until golden brown and the center is fully set, reaching 160°F when checked with a food thermometer, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Cool, then chill until set, at least 20 minutes and preferably until thoroughly chilled. Serve cold.",
      "timer_minutes": 20
    }
  ],
