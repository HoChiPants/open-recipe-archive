  "id": "peaches-and-cream-pie",
  "name": "Peaches and Cream Pie",
  "subtitle": "A chilled peach pie with a creamy cheese topping",
  "description": "A tender pudding-based pie layered with spiced peaches and a smooth cream cheese mixture, then baked and chilled until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30,
    "inactive_minutes": 140
  },
  "ingredients": [
