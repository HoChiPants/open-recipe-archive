{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "coconut-caramels",
  "name": "Coconut Caramels",
  "subtitle": "Soft coconut sweets with a buttery finish",
  "description": "Rich, chewy caramels flavored with coconut and vanilla, cut into individual pieces for serving or gifting.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-plus-extra-for-the-tin",
      "item": "unsalted butter plus extra for the tin",
      "quantity": 85,
      "unit": "g"
    },
    {
      "ingredient_id": "coconut-cream",
      "item": "coconut cream",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "golden-granulated-sugar",
      "item": "golden granulated sugar",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-syrup",
      "item": "golden syrup",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "desiccated-coconut",
      "item": "desiccated coconut",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "flavourless-oil-such-as-sunflower",
      "item": "flavourless oil such as sunflower",
      "preparation": "for cutting"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grease a suitable tin with some of the butter. Combine the remaining butter with the coconut cream, vanilla extract, and desiccated coconut."
    },
    {
      "step": 2,
      "text": "Place the sugar and golden syrup in a heavy saucepan and heat, stirring, until the sugar dissolves."
    },
    {
      "step": 3,
      "text": "Stir in the coconut cream mixture and simmer until the caramel is set.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Transfer the caramel to the prepared tin and leave it to cool completely."
    },
    {
      "step": 5,
      "text": "Lightly oil a knife, then cut the cooled caramel into 20 pieces, re-oiling the blade as needed."
    }
  ],
