  "id": "blueberry-upside-down-cake",
  "name": "Blueberry Upside-Down Cake",
  "subtitle": "A tender lemon-almond cake baked over juicy blueberries",
  "description": "Fresh blueberries form a bright fruit layer beneath a buttery cake flavored with lemon, almond, and slivered almonds.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
