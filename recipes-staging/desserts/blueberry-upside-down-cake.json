  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a cake pan for baking."
    },
    {
      "step": 2,
      "text": "Combine the blueberries with 0.5 cup sugar, 2 tablespoons all-purpose flour, and 2 tablespoons lemon zest. Transfer the mixture to the prepared pan."
    },
    {
      "step": 3,
      "text": "Whisk the remaining sugar with the butter until smooth. Whisk in the eggs, 1 tablespoon lemon zest, and almond extract."
    },
    {
      "step": 4,
      "text": "Stir the flour and baking powder together. Add them to the butter mixture alternately with the milk, mixing just until combined."
    },
    {
      "step": 5,
      "text": "Add the slivered almonds and gently incorporate them into the batter. Spread the batter over the blueberries."
    },
    {
      "step": 6,
      "text": "Bake until the cake is set and a tester inserted into the center comes out clean, about 70 minutes.",
      "timer_minutes": 70
    },
    {
      "step": 7,
      "text": "Let the cake rest for 10 minutes, then invert it onto a serving plate and serve.",
      "timer_minutes": 10
    }
  ],
