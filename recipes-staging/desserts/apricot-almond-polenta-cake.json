  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 180°C/350°F. Butter a 23cm round cake tin and line the base with baking paper."
    },
    {
      "step": 2,
      "text": "Melt the 50g butter with the granulated sugar in a small pan over medium heat, stirring until smooth. Spread the mixture in the prepared tin and arrange the apricot halves over it."
    },
    {
      "step": 3,
      "text": "Beat the cubed room-temperature butter with the caster sugar until light. Gradually beat in the lightly beaten eggs, then mix in the lemon zest and almond extract."
    },
    {
      "step": 4,
      "text": "Whisk the plain flour, fine ground polenta, baking powder, and ground almonds together. Add them to the butter mixture in batches, alternating with the milk, and mix just until combined."
    },
    {
      "step": 5,
      "text": "Spread the batter over the apricots and bake until golden and a skewer inserted into the center comes out clean, about 50 minutes.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Cool the cake in the tin for 15 minutes, then invert it onto a serving plate and remove the paper.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Warm the apricot jam to glaze and brush it over the warm cake. Cool briefly and serve with crème fraîche or cream."
    }
  ],
