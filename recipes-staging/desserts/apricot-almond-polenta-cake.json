  "id": "apricot-almond-polenta-cake",
  "name": "Apricot Almond Polenta Cake",
  "subtitle": "A tender almond cake layered with caramelized apricots",
  "description": "Fresh apricots bake over an almond-polenta sponge, finished with apricot jam and served with crème fraîche or cream.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
