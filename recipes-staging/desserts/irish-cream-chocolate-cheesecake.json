      "item": "Irish cream liqueur",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Reserve a small amount of the chocolate cookie crumbs for finishing, if desired."
    },
    {
      "step": 2,
      "text": "Combine the chocolate cookie crumbs, confectioners' sugar, unsweetened cocoa powder, and white sugar. Stir in melted butter until evenly moistened."
    },
    {
      "step": 3,
      "text": "Press the crumb mixture firmly into the bottom of a cheesecake pan. Bake for 10 minutes, then set aside while preparing the filling.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Increase the oven temperature to 450°F. Beat the cream cheese, white sugar, unsweetened cocoa powder, flour, sour cream, Irish cream liqueur, and confectioners' sugar until smooth."
    },
    {
      "step": 5,
      "text": "Add the eggs and whisk just until incorporated; avoid overmixing."
    },
    {
      "step": 6,
      "text": "Pour the filling over the crust and bake at 450°F for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Reduce the oven to 250°F and continue baking for 60 minutes, until the center is firm and fully set and the internal temperature reaches 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Cool the cheesecake completely, then chill it for at least 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 9,
      "text": "Smooth the top and finish with the reserved chocolate cookie crumbs before serving."
    }
  ],
