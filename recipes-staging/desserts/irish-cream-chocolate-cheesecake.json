  "id": "irish-cream-chocolate-cheesecake",
  "name": "Irish Cream Chocolate Cheesecake",
  "subtitle": "A rich chocolate cheesecake with a creamy liqueur finish",
  "description": "A cocoa cookie crust supports a smooth chocolate cheesecake filling flavored with Irish cream liqueur. Bake it gently, cool it fully, and chill before serving.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 80,
    "inactive_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "chocolate-cookie-crumbs",
      "item": "chocolate cookie crumbs",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
