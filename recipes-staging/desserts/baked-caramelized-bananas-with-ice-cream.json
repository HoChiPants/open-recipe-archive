  "id": "baked-caramelized-bananas-with-ice-cream",
  "name": "Baked Caramelized Bananas with Ice Cream",
  "subtitle": "Warm rum-glazed bananas with toasted pecans",
  "description": "Bananas bake in a buttery caramel-style glaze, then are finished with toasted pecans and ice cream.",
  "meal_type": "dessert",
