  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Stir together the brown sugar, maple syrup, and rum or whisky in a small bowl."
    },
    {
      "step": 3,
      "text": "Arrange the bananas cut-side up in a baking dish and spoon the glaze over them."
    },
    {
      "step": 4,
      "text": "Bake until the bananas are tender and the glaze is bubbling and caramelized.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Serve the warm bananas with ice cream and sprinkle with the toasted chopped pecans."
    }
