  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Spread the cherry pie filling evenly in a baking dish."
    },
    {
      "step": 3,
      "text": "Sprinkle the dry cake mix over the filling, then drizzle the melted butter evenly over the top."
    },
    {
      "step": 4,
      "text": "Bake until the filling is bubbling and the topping is lightly golden and set, about 30 minutes.",
