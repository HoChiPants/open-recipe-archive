  "id": "apple-parfait-with-cinnamon-toffee-sauce",
  "name": "Apple Parfait with Cinnamon Toffee Sauce",
  "subtitle": "Layered apple dessert with creamy parfait and spiced toffee",
  "description": "Cooked apples, a light cream parfait, biscuit crumbs, and warm cinnamon toffee combine in a make-ahead dessert for eight.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
