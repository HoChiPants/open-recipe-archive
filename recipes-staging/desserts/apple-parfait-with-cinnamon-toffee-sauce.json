  "instructions": [
    {
      "step": 1,
      "text": "Simmer the apples with the demerara sugar, brandy, and apple juice until tender. Set aside to cool and thicken.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Whisk the eggs until firm and pale. Separately, boil the caster sugar with enough of the prepared sugar mixture to form a hot syrup, then simmer briefly.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Gradually whisk the hot syrup into the eggs, continuing until the mixture is firm. Cool completely."
    },
    {
      "step": 4,
      "text": "Whisk 150 ml double cream to stiff peaks, then fold it into the cooled egg mixture. Combine with the prepared apples and transfer to serving glasses or a container."
    },
    {
      "step": 5,
      "text": "For the sauce, heat the dark brown soft sugar, butter, remaining cream, remaining apple juice, and cinnamon until smooth and gently simmering."
    },
    {
      "step": 6,
      "text": "Serve the parfait with crushed digestive biscuits and the cinnamon toffee sauce."
    }
  ],
