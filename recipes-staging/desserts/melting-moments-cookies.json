{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "melting-moments-cookies",
  "name": "Melting Moments Cookies",
  "subtitle": "Tender, buttery cookies with a delicate crumb",
  "description": "A simple American cookie made with butter, confectioners' sugar, flour, and cornstarch, chilled before shaping and baking.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the butter until smooth. Add the confectioners' sugar and whisk until smooth and well combined."
    },
    {
      "step": 2,
      "text": "Whisk together the all-purpose flour and cornstarch, then gradually combine the dry mixture with the butter mixture to form a dough."
    },
    {
      "step": 3,
      "text": "Cover and chill the dough until firm, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Preheat the oven to 300°F."
    },
    {
      "step": 5,
      "text": "Lightly flour your hands or work surface as needed. Shape the dough into 36 cookies and arrange them on a baking sheet."
    },
    {
      "step": 6,
      "text": "Bake for about 20 minutes, until lightly browned.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Transfer the cookies to a rack and let them cool for 5 minutes.",
      "timer_minutes": 5
    }
  ],
