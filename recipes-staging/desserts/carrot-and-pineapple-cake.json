  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven and oil the tin."
    },
    {
      "step": 2,
      "text": "Stir the flour, bicarbonate of soda, cinnamon, mixed spice, and brown sugar together in a large bowl."
    },
    {
      "step": 3,
      "text": "Whisk the oil, eggs, milk, and vanilla until blended, then mix into the dry ingredients."
    },
    {
      "step": 4,
      "text": "Fold in the grated carrot, pineapple, and walnuts if using. Transfer the batter to the prepared tin."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until the center is fully set and a thermometer inserted into the cake reads at least 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Leave the cake in the tin for 5 minutes, then transfer it to a rack and cool completely.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Beat the butter until smooth. Gradually incorporate the icing sugar, then beat in the vanilla and soft cheese until smooth."
    },
    {
      "step": 8,
      "text": "Spread the frosting over the cooled cake and finish with the optional pineapple flowers."
    }
  ],
