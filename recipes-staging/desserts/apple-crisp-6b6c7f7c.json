  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Arrange the sliced apples in a baking dish."
    },
    {
      "step": 2,
      "text": "Combine the melted butter, flour, sugar, oats, and half of the cinnamon. Sprinkle the mixture evenly over the apples."
    },
    {
      "step": 3,
      "text": "Top with the butter pieces and remaining cinnamon."
    },
    {
      "step": 4,
      "text": "Bake for 50 minutes, until the topping is lightly browned and the apples are tender.",
