  "instructions": [
    {
      "step": 1,
      "text": "Cook the apples with 75 g caster sugar over medium heat until tender. Cool completely.",
      "timer_minutes": 25
    },
    {
      "step": 2,
      "text": "Warm the milk, 200 ml cream, and vanilla in a saucepan until steaming. Whisk the egg yolks, 50 g caster sugar, and cornflour together."
    },
    {
      "step": 3,
      "text": "Gradually whisk the hot dairy into the yolk mixture, return it to the pan, and stir over medium-low heat until thick. Cook until the custard reaches 160°F, then transfer to a bowl and cool.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Mix the orange juice, 1 tbsp caster sugar, and 3 tbsp whisky. Cut the sponge into pieces and coat it evenly with the mixture."
    },
    {
      "step": 5,
      "text": "Spread the sponge with raspberry jam. Layer the sponge, cooked apples, and raspberries in a serving dish, then chill."
    },
    {
      "step": 6,
      "text": "Whisk the remaining cream with 50 g caster sugar, the orange zest, and 1 1/2 tbsp whisky until thick. Spoon it over the chilled trifle."
    }
  ],
