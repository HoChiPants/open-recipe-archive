  "instructions": [
    {
      "step": 1,
      "text": "Rub the cold butter into the plain flour until crumbly. Knead in the first 70 g icing sugar and the egg to form a dough. Wrap and rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Preheat the oven and prepare the pastry tin. Roll out the dough, line the tin, and shape the edges."
    },
    {
      "step": 3,
      "text": "Bake the pastry base until golden brown, about 20 minutes. Cool.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Prepare the chocolate sponge: separate or otherwise prepare the five eggs, then whisk them with the butter, the second 70 g icing sugar, and the sugar until thick. Continue whisking to stiff peaks where applicable."
    },
    {
      "step": 5,
      "text": "Combine the 130 g plain flour, cocoa powder, and cocoa powder for sprinkling. Whisk into the egg mixture, then fold gently to retain the air."
    },
    {
      "step": 6,
      "text": "Transfer the sponge mixture to the prepared tin and bake for 12 minutes, until set. For the egg-based center, confirm it is fully set or reaches 160°F.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Prepare the cocoa mixture as needed, then cool the sponge for 5 minutes. Shape or trim it to fit the pastry base.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Whisk the blueberries, sugar, lemon juice, and cassis together, then simmer until softened. Stir in the gelatine leaves and continue until the mixture sets when cooled."
    },
    {
      "step": 9,
      "text": "Whisk the first 500 ml double cream with 2 tbsp icing sugar, then combine it with the blueberry mixture until firm."
    },
    {
      "step": 10,
      "text": "Cut or arrange the sponge and blueberry layer as needed for assembly. Prepare the remaining cream by whisking it with 2 tbsp icing sugar and chill until firm."
    },
    {
      "step": 11,
      "text": "Layer the pastry, sponge, blueberry filling, and cream. Finish with the raspberry liqueur and add the blueberries to decorate."
    }
  ],
