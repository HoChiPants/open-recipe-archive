  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "berry-nice-cream-cake",
  "name": "Berry Nice Cream Cake",
  "subtitle": "A chilled vegan cake layered with berries, bananas, and nuts",
  "description": "A creamy frozen berry dessert with a date-and-walnut layer and fresh berries to finish.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "raw-cashews",
      "item": "raw cashews",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "ripe-bananas",
      "item": "ripe bananas",
      "quantity": 2
    },
    {
      "ingredient_id": "medjool-dates",
      "item": "medjool dates",
      "quantity": 10,
      "preparation": "pitted"
    },
    {
      "ingredient_id": "vanilla-pod-seeds-scraped-out-or-1-2-teaspoon-vanilla-extract",
      "item": "vanilla pod seeds scraped out (or 1/2 teaspoon vanilla extract)",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "unsweetened-soy-milk",
      "item": "unsweetened soy milk",
      "quantity": 60,
      "unit": "ml"
    },
    {
      "ingredient_id": "frozen-blueberries-plus-extra-to-serve",
      "item": "frozen blueberries plus extra to serve",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "soy-milk-nd-more-to-thin-as-needed",
      "item": "soy milk nd more to thin as needed",
      "quantity": 240,
      "unit": "ml"
    },
    {
      "ingredient_id": "medjool-dates",
      "item": "medjool dates",
      "quantity": 5,
      "preparation": "pitted"
    },
    {
      "ingredient_id": "raw-walnuts",
      "item": "raw walnuts",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "blackberries-to-serve-optional",
      "item": "blackberries to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Soak the cashews in water for 4 hours, then drain well.",
      "timer_minutes": 240
    },
    {
      "step": 2,
      "text": "Slice the bananas and freeze them until solid, about 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 3,
      "text": "Blend the cashews, frozen bananas, 10 pitted dates, vanilla, 60 ml soy milk, and 200 g blueberries until smooth. Add the specified additional soy milk as needed to reach a thick, spoonable consistency."
    },
    {
      "step": 4,
      "text": "Spread the mixture into a lined cake tin and smooth the surface. Freeze for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Blend the 5 pitted dates, soy milk, blueberries, and walnuts until smooth, thinning with the specified soy milk as needed. Whisk in the vanilla until evenly combined.",
      "timer_minutes": 180
    },
    {
      "step": 6,
      "text": "Spread the berry-walnut mixture over the frozen base and return the cake to the freezer until set."
    },
    {
      "step": 7,
      "text": "Top with extra blueberries and optional blackberries before serving."
    }
  ],
