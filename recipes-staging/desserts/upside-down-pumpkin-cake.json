  "id": "upside-down-pumpkin-cake",
  "name": "Upside-Down Pumpkin Cake",
  "subtitle": "A spiced pumpkin cake with a buttery pecan topping",
  "description": "A simple baked pumpkin dessert layered with cake mix, pecans, and melted butter, then inverted for serving.",
  "meal_type": "dessert",
  "cuisine": "American",
