  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Blend the pumpkin, cinnamon, cloves, salt, sugar, eggs, and evaporated milk until smooth. Transfer the mixture to a baking dish."
    },
    {
      "step": 3,
      "text": "Combine the cake mix and chopped pecans, then spread them over the pumpkin mixture. Drizzle the melted butter evenly over the top."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, until the center is fully set and reaches 160°F. Cool briefly, then invert onto a serving plate.",
      "timer_minutes": 60
    }
  ],
