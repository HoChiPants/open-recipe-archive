  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and dust a square baking pan with white spelt flour."
    },
    {
      "step": 2,
      "text": "Whisk the salted butter softened with 60 g caster sugar and the light muscovado sugar until smooth."
    },
    {
      "step": 3,
      "text": "Mix in 1 tsp baking powder and 150 g white spelt flour, then stir in the porridge oats to form a crumbly dough."
    },
    {
      "step": 4,
      "text": "Melt the butter with 150 g caster sugar, 70% dark chocolate, and milk chocolate in short microwave intervals, stirring until smooth."
    },
    {
      "step": 5,
      "text": "Stir the cocoa powder, 50 g white spelt flour, and ⁄2 tsp baking powder into the melted chocolate mixture."
    },
    {
      "step": 6,
      "text": "Press half of the oat dough into the prepared pan, spread the chocolate mixture over it, and cover with the remaining dough."
    },
    {
      "step": 7,
      "text": "Bake until golden brown and set.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Cool completely in the pan."
    },
    {
      "step": 9,
      "text": "Melt the remaining 70% dark chocolate and milk chocolate in short microwave intervals, stirring until smooth, then spread over the cooled bars."
    },
    {
      "step": 10,
      "text": "Let the topping set before cutting into 16 bars.",
      "timer_minutes": 10
    }
  ],
