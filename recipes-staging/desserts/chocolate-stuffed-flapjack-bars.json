  "id": "chocolate-stuffed-flapjack-bars",
  "name": "Chocolate-Stuffed Flapjack Bars",
  "subtitle": "Chewy oat bars with a rich chocolate center",
  "description": "A layered bake combining buttery oats with a chocolate middle, finished with a simple chocolate topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
