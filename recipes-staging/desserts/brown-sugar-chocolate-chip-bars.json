      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Whisk the flour, baking powder, and salt together."
    },
    {
      "step": 2,
      "text": "Warm the shortening, stir in the brown sugar until combined, and let the mixture cool."
    },
    {
      "step": 3,
      "text": "Whisk the eggs and cooled sugar mixture until smooth, then stir in the vanilla."
    },
    {
      "step": 4,
      "text": "Add the dry ingredients and stir just until combined. Fold in the chocolate chips and walnuts."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a baking pan and bake for 30 minutes, until golden brown and the center is firm and fully set, or reaches 160°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool before cutting into bars."
    }
  ],
