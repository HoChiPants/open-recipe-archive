  "id": "brown-sugar-chocolate-chip-bars",
  "name": "Brown Sugar Chocolate Chip Bars",
  "subtitle": "Chewy bars with chocolate chips and walnuts",
  "description": "A simple brown sugar bar dessert baked until golden and set, with semisweet chocolate and chopped walnuts throughout.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 35,
    "unit": "servings"
  },
