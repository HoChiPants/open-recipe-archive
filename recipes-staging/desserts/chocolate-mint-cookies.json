  "id": "chocolate-mint-cookies",
  "name": "Chocolate Mint Cookies",
  "subtitle": "Rich chocolate cookies finished with mint candies",
  "description": "A chewy chocolate cookie dough is chilled, baked, and topped with chocolate-covered mint candies that soften into a smooth finish.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 40,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10,
    "inactive_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1.25,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "chocolate-covered-thin-mints",
      "item": "chocolate covered thin mints",
      "quantity": 3,
      "unit": "package",
      "preparation": "4.5 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter, brown sugar, and water together in a saucepan. Remove from the heat and stir in the semisweet chocolate chips until smooth; let cool briefly.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk in the eggs. Stir in the flour, baking soda, and salt until a soft dough forms."
    },
    {
      "step": 3,
      "text": "Cover and chill the dough until firm, about 50 minutes.",
      "timer_minutes": 50
    },
    {
      "step": 4,
      "text": "Heat the oven to 350°F and prepare baking sheets."
    },
    {
      "step": 5,
      "text": "Shape the dough into portions and arrange them on the prepared sheets with space between each."
    },
    {
      "step": 6,
      "text": "Bake until the cookies are set, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Place a chocolate-covered thin mint on each hot cookie and return the sheets to the oven briefly.",
      "timer_minutes": 1
    },
    {
      "step": 8,
      "text": "Remove from the oven and gently spread the softened candies over the cookies. Cool before serving."
    }
  ],
