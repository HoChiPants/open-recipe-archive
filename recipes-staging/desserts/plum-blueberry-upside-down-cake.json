  "id": "plum-blueberry-upside-down-cake",
  "name": "Plum Blueberry Upside-Down Cake",
  "subtitle": "A fruit-topped cake with a tender vanilla crumb",
  "description": "Sliced plums and blueberries bake beneath a simple vanilla cake, then become the topping when the cake is inverted.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
