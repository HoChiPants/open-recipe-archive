  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Melt 3 tablespoons margarine in a suitable baking pan. Stir in the brown sugar, spread the mixture evenly, and arrange the sliced plums and blueberries over it."
    },
    {
      "step": 3,
      "text": "Whisk the remaining margarine with the white sugar until combined. Add the egg and vanilla extract and whisk until smooth."
    },
    {
      "step": 4,
      "text": "In a separate bowl, combine the flour, baking powder, and salt. Add the dry mixture to the margarine mixture alternately with the milk, stirring just until a smooth batter forms."
    },
    {
      "step": 5,
      "text": "Pour the batter over the fruit and spread it evenly. Bake for 40 minutes, until the center is fully set and reaches 160°F when checked with a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Cool the cake in the pan for 15 minutes, then invert it onto a serving plate.",
      "timer_minutes": 15
    }
  ],
