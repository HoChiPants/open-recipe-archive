      "item": "white chocolate chips",
      "quantity": 40,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter and dark chocolate with the white chocolate chips until smooth, then cool slightly."
    },
    {
      "step": 2,
      "text": "Preheat the air fryer."
    },
    {
      "step": 3,
      "text": "Whisk the eggs and caster sugar until thickened."
    },
    {
      "step": 4,
      "text": "Add the melted chocolate mixture, plain flour, cocoa powder, and white chocolate chips; fold until combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a suitable baking pan and cook in the air fryer for 35 minutes, until set with a firm, fully cooked center.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Cool before slicing and serving."
    }
  ],
