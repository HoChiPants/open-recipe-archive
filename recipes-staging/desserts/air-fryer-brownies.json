    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-chocolate-roughly-chopped",
      "item": "dark chocolate roughly chopped",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
