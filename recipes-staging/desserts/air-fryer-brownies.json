  "id": "air-fryer-brownies",
  "name": "Air Fryer Brownies",
  "subtitle": "Rich chocolate brownies with white chocolate chips",
  "description": "A simple air-fryer brownie with a smooth chocolate base and sweet white chocolate pieces.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
  "times": {
