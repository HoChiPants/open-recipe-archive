      "item": "soured cream",
      "quantity": 80,
      "unit": "g"
    },
    {
      "ingredient_id": "fresh-cherries-stoned-and-halved",
      "item": "fresh cherries stoned and halved",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 45,
      "unit": "g"
    },
    {
      "ingredient_id": "cold-salted-butter-cubed",
      "item": "cold salted butter cubed",
      "quantity": 35,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 20,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and butter the cake tin."
    },
    {
      "step": 2,
      "text": "Rub the plain flour and cold cubed butter together, then stir in the 20 g sugar to make the crumble topping."
    },
    {
      "step": 3,
      "text": "Beat the softened butter with the 220 g sugar for 5 minutes, until light and creamy.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Gradually whisk in the beaten eggs."
    },
    {
      "step": 5,
      "text": "Fold in the self-raising flour, baking powder, ground almonds, soured cream, and half of the cherries until the batter is smooth."
    },
    {
      "step": 6,
      "text": "Spread the batter in the prepared tin and bake for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Scatter the remaining cherries and crumble mixture over the cake, then bake for a further 50 minutes, until risen and set.",
      "timer_minutes": 50
    },
    {
      "step": 8,
      "text": "Cool the cake in the tin before serving."
    },
    {
      "step": 9,
      "text": "Whisk the soured cream until thick and serve alongside the cake."
    }
  ],
