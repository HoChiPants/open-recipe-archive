  "id": "cherry-crumble-cake",
  "name": "Cherry Crumble Cake",
  "subtitle": "Soft almond cake with a buttery cherry topping",
  "description": "A tender cherry and almond cake finished with a crisp crumble layer, suited to dessert or afternoon serving.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 35,
    "cook_minutes": 80
  },
  "ingredients": [
    {
      "ingredient_id": "salted-butter-softened",
      "item": "salted butter softened",
      "quantity": 180,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 220,
      "unit": "g"
    },
    {
