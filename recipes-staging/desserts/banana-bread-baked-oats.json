  "id": "banana-bread-baked-oats",
  "name": "Banana Bread Baked Oats",
  "subtitle": "Warm spiced oats with banana and peanut butter",
  "description": "A soft baked oat dish combining mashed banana, warm spices, protein powder, and peanut butter, finished with yogurt and berries.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "oat-flour",
      "item": "oat flour",
      "quantity": 240,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-whey-protein",
      "item": "vanilla whey protein",
      "quantity": 60,
      "unit": "g"
    },
    {
