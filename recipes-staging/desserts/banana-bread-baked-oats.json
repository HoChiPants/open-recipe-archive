      "item": "egg beaten",
      "quantity": 1
    },
    {
      "ingredient_id": "flavourless-oil-for-the-dish",
      "item": "flavourless oil for the dish"
    },
    {
      "ingredient_id": "smooth-peanut-butter",
      "item": "smooth peanut butter",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "yogurt-berries-and-peanut-butter",
      "item": "yogurt berries and peanut butter"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F (175°C). Lightly coat a baking dish with the flavourless oil."
    },
    {
      "step": 2,
      "text": "Stir the oat flour, vanilla whey protein, baking powder, cinnamon, and mixed spice together."
    },
    {
      "step": 3,
      "text": "Mix the mashed bananas, milk, and beaten egg, then combine with the dry ingredients until evenly moistened."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared dish and spoon the smooth peanut butter over the surface, gently swirling it in."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, until golden brown and the center is fully set; verify an egg-containing center reaches 160°F (71°C).",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Let the baked oats cool briefly, then serve with yogurt, berries, and peanut butter."
    }
  ],
