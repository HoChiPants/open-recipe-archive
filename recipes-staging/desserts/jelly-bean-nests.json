  "id": "jelly-bean-nests",
  "name": "Jelly Bean Nests",
  "subtitle": "Crisp noodle treats shaped into simple nests",
  "description": "A quick no-bake dessert made by folding chow mein noodles into a buttery marshmallow mixture, then chilling them until firm.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "miniature-marshmallows",
      "item": "miniature marshmallows",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "chow-mein-noodles",
      "item": "chow mein noodles",
      "quantity": 4,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a large saucepan over low heat. Add the miniature marshmallows and stir until smooth and fully melted."
    },
    {
      "step": 2,
      "text": "Remove from the heat and fold in the chow mein noodles until evenly coated."
    },
    {
      "step": 3,
      "text": "Spoon the mixture into 12 portions on a lined tray. Shape each portion into a nest with a shallow center."
    },
    {
      "step": 4,
      "text": "Chill for 60 minutes, or until firm.",
      "timer_minutes": 60
    }
  ],
