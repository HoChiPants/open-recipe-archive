  "id": "bbq-s-mores",
  "name": "BBQ S'mores",
  "subtitle": "Warm chocolate and marshmallow biscuit sandwiches",
  "description": "A simple barbecue dessert made by warming chocolate and marshmallows between crisp tea biscuits.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
