    {
      "ingredient_id": "rich-tea-biscuits",
      "item": "rich tea biscuits",
      "quantity": 12
    },
    {
      "ingredient_id": "thin-squares-milk-chocolate",
      "item": "thin squares milk chocolate",
      "quantity": 6
    },
    {
      "ingredient_id": "marshmallows-mixture-of-pink-and-white",
      "item": "marshmallows mixture of pink and white",
      "quantity": 6
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place six biscuits on a heat-safe surface. Top each with one chocolate square and one marshmallow, then cover with the remaining biscuits."
    },
    {
      "step": 2,
      "text": "Cook the assembled s'mores on the barbecue until the chocolate softens and the marshmallows are warmed through.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Let cool briefly, then serve."
    }
  ],
