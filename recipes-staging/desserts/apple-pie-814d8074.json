  "id": "apple-pie-814d8074",
  "name": "Apple Pie",
  "subtitle": "Tart apples under a crisp lattice crust",
  "description": "A classic double-crust apple pie with Granny Smith apples and a buttery brown-sugar sauce.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "double-crust-pie-pastry",
      "item": "double-crust pie pastry",
      "quantity": 1,
      "unit": "package",
      "preparation": "14.1 ounce, thawed"
    },
    {
      "ingredient_id": "granny-smith-apples",
      "item": "Granny Smith apples",
      "quantity": 8,
      "preparation": "peeled, cored and sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Melt the butter in a saucepan over medium heat, stir in the flour, and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Add the brown sugar and water. Bring the mixture to a simmer, then cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Fit one pastry round into a pie dish and trim the edge. Cut the remaining pastry into strips for a lattice top."
    },
    {
      "step": 4,
      "text": "Arrange the sliced apples in the crust. Weave the pastry strips over the apples and fold or crimp the edges to seal."
    },
    {
      "step": 5,
      "text": "Pour the warm brown-sugar sauce evenly over the lattice and apples."
    },
    {
      "step": 6,
      "text": "Bake at 425°F for 15 minutes. Reduce the oven temperature to 350°F and continue baking for 45 minutes, until the apples are tender and the crust is golden.",
      "timer_minutes": 45
    }
  ],
