  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F (180°C). Oil the cake tins and line their bases if desired."
    },
    {
      "step": 2,
      "text": "Whisk 200 g softened butter with 200 g light muscovado sugar, then whisk in the eggs.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Fold in the flours, bicarbonate of soda, cinnamon, mixed spice, grated carrots, and raisins or sultanas until evenly combined."
    },
    {
      "step": 4,
      "text": "Divide the batter between the prepared tins and bake until risen and set in the center.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cool the cakes in the tins briefly, then transfer them to a rack and cool completely.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Stir the 75 g light muscovado sugar with the pecans, cook until set, then cool and cut the mixture into small pieces.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Whisk 150 g softened butter with the icing sugar until smooth. Beat in the soft cheese and lemon zest until smooth, then chill until firm enough to spread.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Spread the frosting between and over the cooled cakes. Finish with the chopped pecan mixture and serve."
    }
  ],
