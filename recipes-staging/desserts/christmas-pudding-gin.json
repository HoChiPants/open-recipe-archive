  "instructions": [
    {
      "step": 1,
      "text": "Combine the gin, cinnamon, cloves, allspice berries, coriander seeds, vanilla pod, sultanas, figs or dates, lemon zest, orange zest, and sugar in a clean sealable jar."
    },
    {
      "step": 2,
      "text": "Seal and leave at room temperature for 48 hours, turning the jar occasionally so the sugar dissolves and the flavors infuse.",
      "timer_minutes": 2880
    },
    {
      "step": 3,
      "text": "Strain the infused gin into a clean bottle, pressing the fruit gently to extract the liquid."
    },
    {
      "step": 4,
      "text": "Add the amaretto and brandy, seal, and shake gently to combine. Serve chilled or over ice."
    }
  ],
