  "id": "christmas-pudding-gin",
  "name": "Christmas Pudding Gin",
  "subtitle": "A spiced, fruit-infused gin for holiday pours",
  "description": "Gin infused with baking spices, dried fruit, citrus zest, sugar, and vanilla, then rounded with amaretto and brandy.",
  "meal_type": "dessert",
