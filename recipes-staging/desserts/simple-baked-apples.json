  "id": "simple-baked-apples",
  "name": "Simple Baked Apples",
  "subtitle": "Warm spiced apples with raisins and walnuts",
  "description": "Tender sliced apples bake with warm spices, dried fruit, walnuts, and a lightly thickened milk mixture for a comforting dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "apples",
      "item": "apples",
      "quantity": 6,
      "preparation": "peeled, cored and sliced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cloves",
      "item": "ground cloves",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Whisk the sugar, flour, cinnamon, nutmeg, and cloves together. Add the apples and toss until evenly coated."
    },
    {
      "step": 3,
      "text": "Mix in the raisins and walnuts, then spread the fruit mixture in the prepared dish."
    },
    {
      "step": 4,
      "text": "Pour the milk evenly over the apples and bake until the apples are tender and the mixture is bubbling.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Let the baked apples cool briefly before serving."
    }
  ],
