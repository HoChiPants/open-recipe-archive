  "instructions": [
    {
      "step": 1,
      "text": "Drain the peaches for 8 minutes, then cut them into bite-size pieces.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Warm a dry skillet over medium heat. Add the flaked almonds and toast until lightly golden; set aside to cool."
    },
    {
      "step": 3,
      "text": "Place the frozen raspberries and peaches in serving glasses or bowls."
    },
    {
      "step": 4,
      "text": "Whisk the double cream until it holds soft peaks.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Top the fruit with scoops of vanilla ice cream and whipped cream. Finish with the toasted almonds and serve."
    }
