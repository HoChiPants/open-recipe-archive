  "id": "peach-and-raspberry-sundae",
  "name": "Peach and Raspberry Sundae",
  "subtitle": "Peaches, berries, cream, and almonds over vanilla ice cream",
  "description": "A simple fruit sundae layered with peaches, raspberries, whipped cream, vanilla ice cream, and toasted almonds.",
  "meal_type": "dessert",
