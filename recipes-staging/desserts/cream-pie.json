{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cream-pie",
  "name": "Cream Pie",
  "subtitle": "A smooth, cinnamon-dusted baked custard pie",
  "description": "A simple cream-and-egg filling bakes into a tender, lightly spiced dessert in a pastry shell.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "9-inch-pie-shell",
      "item": "(9 inch) pie shell",
      "quantity": 1
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "half-and-half-cream",
      "item": "half-and-half cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the sugar, half-and-half, flour, heavy whipping cream, and melted butter until smooth. Whisk in the egg until fully combined."
    },
    {
      "step": 3,
      "text": "Pour the filling into the pie shell and sprinkle the cinnamon over the surface."
    },
    {
      "step": 4,
      "text": "Bake for 70 minutes, until the center is firm and fully set; an egg-based filling should reach 160°F when checked with a food thermometer.",
      "timer_minutes": 70
    }
  ],
