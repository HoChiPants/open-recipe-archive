  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Combine the apples, cranberries, ground cinnamon, 1/2 teaspoon mixed spice, and 75 g caster sugar in a baking dish."
    },
    {
      "step": 3,
      "text": "Rub the flour and cubed cold butter together until the mixture forms coarse crumbs. Stir in 50 g caster sugar and 1/2 teaspoon mixed spice."
    },
    {
      "step": 4,
      "text": "Scatter the crumble mixture evenly over the fruit."
    },
    {
      "step": 5,
      "text": "Bake until the fruit is bubbling and the topping is golden, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Let the crumble cool briefly before serving."
    }
  ],
