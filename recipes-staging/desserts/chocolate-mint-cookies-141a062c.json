  "id": "chocolate-mint-cookies-141a062c",
  "name": "Chocolate Mint Cookies",
  "subtitle": "Rich chocolate cookies with a cool mint finish",
  "description": "A tender chocolate cookie dough is chilled, baked, and finished with melted mint candy for a smooth topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
