      "item": "chocolate mint wafer candies",
      "quantity": 36
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter, brown sugar, and water together in a saucepan over low heat. Stir in the semisweet chocolate chips and 18 mint wafer candies until smooth. Remove from the heat and cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk in the eggs. Stir in the flour, baking soda, and salt until a soft dough forms. Cover and chill for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Heat the oven to 350°F. Shape the dough into 18 portions and arrange them on baking sheets."
    },
    {
      "step": 4,
      "text": "Bake until the cookies are set, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Place the remaining 18 mint wafer candies on the hot cookies. Let stand for 5 minutes, then spread the softened candy over the tops. Cool before serving.",
      "timer_minutes": 5
    }
  ],
