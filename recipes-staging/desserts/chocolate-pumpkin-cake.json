{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-pumpkin-cake",
  "name": "Chocolate Pumpkin Cake",
  "subtitle": "A tender chocolate cake with pumpkin and cream cheese frosting",
  "description": "Combine chocolate cake mix, pumpkin, and eggs, bake until set, then finish with a smooth cream cheese frosting.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "chocolate-cake-mix",
      "item": "chocolate cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "15.25 ounce"
    },
    {
      "ingredient_id": "pumpkin",
      "item": "pumpkin",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "16-ounce-container-cream-cheese-frosting",
      "item": "(16 ounce) container cream cheese frosting",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Use the vegetable oil to coat the baking pan."
    },
    {
      "step": 2,
      "text": "Mix the chocolate cake mix, pumpkin, and eggs for about 3 minutes, until evenly combined.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and place it in the oven."
    },
    {
      "step": 4,
      "text": "Bake until the cake is set and a tester comes out with only a few moist crumbs, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Cool the cake in the pan for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Whisk the cream cheese frosting until smooth, then spread it over the cooled cake."
    }
  ],
