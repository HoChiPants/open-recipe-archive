  "id": "rhubarb-pudding-51a0ff3a",
  "name": "Rhubarb Pudding",
  "subtitle": "A tender baked pudding with tart rhubarb and a sweet syrupy finish.",
  "description": "A simple American dessert combining a lightly sweetened batter, sliced rhubarb, and boiling water before baking until set.",
  "meal_type": "dessert",
  "cuisine": "American",
