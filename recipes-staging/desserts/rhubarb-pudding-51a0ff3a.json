  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, 0.5 cup sugar, baking powder, and salt together."
    },
    {
      "step": 3,
      "text": "Whisk the egg, melted butter, and milk until smooth, then stir in the dry mixture to form a batter."
    },
    {
      "step": 4,
      "text": "Place the sliced rhubarb in a baking dish and sprinkle with 2 cups sugar."
    },
    {
      "step": 5,
      "text": "Pour the boiling water over the rhubarb mixture, then spread the batter over the top."
    },
    {
      "step": 6,
      "text": "Bake for 40 minutes, until the pudding is set in the center and the egg-containing portion reaches 160°F.",
      "timer_minutes": 40
    }
  ],
