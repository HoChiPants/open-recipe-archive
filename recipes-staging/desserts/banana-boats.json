  "id": "banana-boats",
  "name": "Banana Boats",
  "subtitle": "Warm bananas filled with melty chocolate and marshmallows",
  "description": "A quick baked-style dessert of bananas warmed with semisweet chocolate chips and miniature marshmallows.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
