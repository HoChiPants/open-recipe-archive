  "ingredients": [
    {
      "ingredient_id": "banana",
      "item": "bananas",
      "quantity": 2
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "miniature-marshmallows",
      "item": "miniature marshmallows",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare a heat-safe cooking surface or dish."
    },
    {
      "step": 2,
      "text": "Cut a lengthwise slit in each banana without cutting completely through."
    },
    {
      "step": 3,
      "text": "Fill the slits with the chocolate chips and miniature marshmallows."
    },
    {
      "step": 4,
      "text": "Cook the filled bananas for 5 minutes, until the chocolate is melted and the marshmallows are softened.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
