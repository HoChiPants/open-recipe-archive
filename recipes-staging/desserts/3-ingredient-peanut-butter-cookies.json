  "id": "3-ingredient-peanut-butter-cookies",
  "name": "3-Ingredient Peanut Butter Cookies",
  "subtitle": "Simple peanut butter cookies with three ingredients",
  "description": "Make a basic dough from peanut butter, sugar, and one egg, shape it into cookies, and bake until firm and set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "In a bowl, blend the peanut butter and white sugar until smooth."
    },
    {
      "step": 3,
      "text": "Beat in the egg until fully combined."
    },
    {
      "step": 4,
      "text": "Scoop the dough and place portions on a lined baking sheet; press lightly to desired shape."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, until cookies are firm and the centers are fully set; if checking for safety, cook to 160°F in the center for egg safety.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Cool the cookies on a rack."
    }
  ],
