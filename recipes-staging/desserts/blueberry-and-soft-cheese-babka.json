  "id": "blueberry-and-soft-cheese-babka",
  "name": "Blueberry and Soft Cheese Babka",
  "subtitle": "A braided sweet loaf with blueberry filling and creamy cheese",
  "description": "An enriched yeast loaf layered with thick blueberry filling and soft cheese, then twisted and baked until golden.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "strong-white-bread-flour-plus-extra-for-dusting",
      "item": "strong white bread flour plus extra for dusting",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "sachet-fast-action-dried-yeast",
      "item": "sachet fast-action dried yeast",
      "quantity": 7,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": "3 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "dried-blueberries",
      "item": "dried blueberries (optional)",
      "quantity": 50,
      "unit": "g",
      "optional": true
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "eggs-beaten",
      "item": "eggs beaten",
      "quantity": 2
    },
    {
      "ingredient_id": "unsalted-butter-cut-into-cubes-and-softened",
      "item": "unsalted butter cut into cubes and softened",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "soft-cheese-at-room-temperature",
      "item": "soft cheese at room temperature",
      "quantity": 275,
      "unit": "g"
    },
    {
      "ingredient_id": "sunflower-oil-for-the-bowl-and-tin",
      "item": "sunflower oil for the bowl and tin"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "blueberries",
      "item": "blueberries",
      "quantity": 350,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the flour, yeast, 3 1/2 tablespoons sugar, and dried blueberries, if using. Add the milk and beaten eggs, then mix to form a dough."
    },
    {
      "step": 2,
      "text": "Knead the dough until smooth, about 10 minutes. Work in the softened butter, followed by the soft cheese, until incorporated.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Place the dough in an oiled bowl, cover, and leave to rise until puffy. Oil a loaf tin."
    },
    {
      "step": 4,
      "text": "Cook the blueberries, 225 g sugar, dried blueberries if using, and lemon juice until thickened, about 20 minutes. Cool until set.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Roll the dough into a rectangle. Spread with the cooled blueberry mixture and soft cheese, leaving a small border."
    },
    {
      "step": 6,
      "text": "Roll the dough up tightly, cut it lengthwise, and twist the two pieces together with the cut sides facing up. Transfer to the prepared tin."
    },
    {
      "step": 7,
      "text": "Cover and leave to rise for 30 minutes. Heat the oven to the recipe’s baking temperature.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Bake until deeply golden and cooked through, about 70 minutes total.",
      "timer_minutes": 70
    },
    {
      "step": 9,
      "text": "Brush the hot loaf with honey, cool for 30 minutes, then slice.",
      "timer_minutes": 30
    }
  ],
