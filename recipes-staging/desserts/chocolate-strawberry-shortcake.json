  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Layer the flour, one-third cup sugar, cocoa powder, baking powder, baking soda, and salt in a mixing bowl, then whisk to combine."
    },
    {
      "step": 2,
      "text": "Cut the butter into the dry mixture until it forms coarse crumbs. Pour in the milk and stir just until a dough forms."
    },
    {
      "step": 3,
      "text": "Layer the dough in a baking pan and bake until set, about 15 minutes. Cool completely before assembling.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Toss the sliced strawberries with the remaining sugar and let them stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Prepare the thawed whipped topping for spreading. Layer the cooled shortcake with the strawberries and whipped topping, then drizzle with chocolate syrup."
    }
  ],
