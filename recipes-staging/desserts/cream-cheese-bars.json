{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cream-cheese-bars",
  "name": "Cream Cheese Bars",
  "subtitle": "Layered cake-base bars with a smooth cream cheese topping",
  "description": "A two-layer dessert made with a buttery cake-mix base and a sweet cream cheese filling.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "yellow-cake-mix",
      "item": "yellow cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "15.25 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large",
      "preparation": "beaten"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large",
      "preparation": "beaten"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 3.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Stir together the cake mix, melted butter, and beaten egg until a dough forms. Press the mixture evenly into a baking pan."
    },
    {
      "step": 2,
      "text": "Bake the base at 350°F for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Beat the softened cream cheese with the two beaten eggs until smooth, then mix in the confectioners' sugar. Spread the filling over the hot base."
    },
    {
      "step": 4,
      "text": "Reduce the oven to 300°F and bake for 35 minutes, until the center is firm and fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Cool completely before cutting into bars."
    }
  ],
