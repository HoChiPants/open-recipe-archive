  "id": "crushed-pineapple-sour-cream-pie",
  "name": "Crushed Pineapple Sour Cream Pie",
  "subtitle": "A chilled pineapple pie with a creamy vanilla filling",
  "description": "A simple dessert made with crushed pineapple, vanilla pudding, sugar, and sour cream in a baked pie crust.",
  "meal_type": "dessert",
  "cuisine": "American",
