  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the pineapple with its juice, pudding mix, and sugar in a bowl."
    },
    {
      "step": 2,
      "text": "Whisk the sour cream until smooth, then add it to the pineapple mixture and whisk for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Transfer the filling to the baked pie crust and smooth the surface."
    },
    {
      "step": 4,
      "text": "Chill the pie for at least 1 hour, then garnish before serving if desired.",
      "timer_minutes": 60
    }
  ],
