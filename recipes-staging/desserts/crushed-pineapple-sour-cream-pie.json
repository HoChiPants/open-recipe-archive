  },
  "ingredients": [
    {
      "ingredient_id": "9-inch-pie-crust",
      "item": "(9 inch) pie crust",
      "quantity": 1,
      "preparation": "baked"
    },
    {
      "ingredient_id": "pineapple-with-juice",
      "item": "pineapple with juice",
      "quantity": 1,
      "unit": "can",
      "preparation": "8 ounce, crushed"
    },
    {
