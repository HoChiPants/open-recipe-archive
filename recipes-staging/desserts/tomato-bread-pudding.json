{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "tomato-bread-pudding",
  "name": "Tomato Bread Pudding",
  "subtitle": "A savory-sweet baked pudding with basil and buttered bread",
  "description": "Tomato puree, brown sugar, basil, and cubed bread bake together into a tender, lightly crisp pudding.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "tomato-puree",
      "item": "tomato puree",
      "quantity": 1,
      "unit": "can",
      "preparation": "14.25 ounce"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "slices-white-bread",
      "item": "slices white bread",
      "quantity": 10,
      "preparation": "cubed"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Lightly coat a baking dish."
    },
    {
      "step": 2,
      "text": "Combine the water and tomato puree, then stir in the brown sugar, dried basil, and salt. Let the mixture stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Toss the cubed bread with the melted butter and transfer it to the prepared dish."
    },
    {
      "step": 4,
      "text": "Pour the tomato mixture evenly over the bread."
    },
    {
      "step": 5,
      "text": "Bake until the pudding is set and the top is lightly browned, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Let rest for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
