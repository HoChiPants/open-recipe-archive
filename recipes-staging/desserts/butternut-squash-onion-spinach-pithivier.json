{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "butternut-squash-onion-spinach-pithivier",
  "name": "Butternut Squash, Onion & Spinach Pithivier",
  "subtitle": "A savory pastry centerpiece with spiced vegetables and toasted pine nuts.",
  "description": "Roasted squash, softened onions, spinach, and ras el hanout are enclosed in vegan puff pastry, brushed with dairy-free milk, and baked until golden.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 60,
    "cook_minutes": 95
  },
  "ingredients": [
    {
      "ingredient_id": "butternut-squash-halved-lengthways",
      "item": "butternut squash halved lengthways",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "onions-thinly-sliced",
      "item": "onions thinly sliced",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "spinach",
      "item": "spinach",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "fat-garlic-cloves-thinly-sliced",
      "item": "fat garlic cloves thinly sliced",
      "quantity": 3
    },
    {
      "ingredient_id": "ras-el-hanout",
      "item": "ras el hanout",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "block-vegan-puff-pastry",
      "item": "block vegan puff pastry",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "plain-flour-for-dusting",
      "item": "plain flour for dusting"
    },
    {
      "ingredient_id": "pine-nuts",
      "item": "pine nuts",
      "quantity": 50,
      "unit": "g",
      "preparation": "toasted"
    },
    {
      "ingredient_id": "dairy-free-milk",
      "item": "dairy-free milk",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and roast the halved squash cut-side down until tender, about 45 minutes. Cool, then scoop out the flesh and discard the skin.",
      "timer_minutes": 45
    },
    {
      "step": 2,
      "text": "Cook the sliced onions with the olive oil over medium heat until softened and caramelised, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Wilt the spinach with the sliced garlic, then cool and squeeze out excess liquid."
    },
    {
      "step": 4,
      "text": "Combine the squash, onions, spinach, garlic, and ras el hanout. Taste and adjust the seasoning only if needed."
    },
    {
      "step": 5,
      "text": "Toast the pine nuts and set them aside to cool."
    },
    {
      "step": 6,
      "text": "Dust the work surface with flour. Roll the pastry into two rounds, one slightly larger than the other, and chill the rounds for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Place the smaller pastry round on a lined baking sheet. Mound the filling in the centre, leaving a clear border, and scatter over the toasted pine nuts."
    },
    {
      "step": 8,
      "text": "Cover with the larger pastry round, press the edges together to seal, and trim and shape the border. Brush with the dairy-free milk and cut a small vent in the top."
    },
    {
      "step": 9,
      "text": "Bake until the pastry is golden brown and crisp, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 10,
      "text": "Rest for 5 minutes before slicing and serving.",
      "timer_minutes": 5
    }
  ],
