  "id": "coconut-drops",
  "name": "Coconut Drops",
  "subtitle": "Cinnamon-scented coconut and raisin drop cookies",
  "description": "Tender drop cookies combining shredded coconut, raisins, warm cinnamon, and vanilla.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
