      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F and prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Cream the butter and sugar, then stir in the beaten egg and vanilla extract."
    },
    {
      "step": 3,
      "text": "Combine the sifted flour, baking powder, and cinnamon. Stir the dry mixture into the butter mixture."
    },
    {
      "step": 4,
      "text": "Fold in the shredded coconut and raisins until evenly distributed."
    },
    {
      "step": 5,
      "text": "Drop rounded portions of dough onto the prepared sheet, leaving space between them."
    },
    {
      "step": 6,
      "text": "Bake for 8 minutes, until lightly browned and the centers are fully set; verify the egg-containing centers reach 160°F.",
      "timer_minutes": 8
    }
  ],
