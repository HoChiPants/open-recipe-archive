  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 4,
