  "id": "berry-chocolate-loaded-cookies",
  "name": "Berry Chocolate Loaded Cookies",
  "subtitle": "Jam-filled cookies with milk and white chocolate",
  "description": "Soft cookies combine brown and caster sugars with two kinds of chocolate and a raspberry-jam center.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 13,
    "unit": "servings"
  },
  "times": {
