  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened butter, light brown soft sugar, and golden caster sugar until smooth and creamy. Beat in the egg and yolk, then mix in the almond and vanilla extracts."
    },
    {
      "step": 2,
      "text": "Combine the plain flour, baking powder, bicarbonate of soda, and salt. Add the dry mixture to the butter mixture and stir until a dough forms. Fold in the chopped milk chocolate and grated white chocolate."
    },
    {
      "step": 3,
      "text": "Divide the dough into 13 portions. Flatten each portion, place raspberry jam in the center, and enclose the filling completely. Arrange the filled dough portions on prepared baking trays with space between them."
    },
    {
      "step": 4,
      "text": "Chill the shaped cookies until set.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Preheat the oven to the recipe's baking temperature. Bake the chilled cookies until spread, lightly colored, and fully set in the centers; for egg safety, verify that the centers reach 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool the cookies on the trays briefly, then transfer them to a rack to cool completely."
    }
  ],
