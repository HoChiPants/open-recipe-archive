{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cranberry-orange-madeleines",
  "name": "Cranberry-Orange Madeleines",
  "subtitle": "Tender citrus cakes with tart cranberry pieces",
  "description": "Small shell-shaped cakes flavored with orange, ginger, vanilla, and cranberries, served plain or with crème fraîche.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "caster-sugar-plus-an-extra-1-tbsp",
      "item": "caster sugar plus an extra 1 tbsp",
      "quantity": 120,
      "unit": "g"
    },
    {
      "ingredient_id": "light-muscovado-sugar",
      "item": "light muscovado sugar",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vanilla-bean-paste",
      "item": "vanilla bean paste",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "unsalted-butter-melted",
      "item": "unsalted butter melted",
      "quantity": 150,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "plain-flour-plus-extra-for-dusting",
      "item": "plain flour plus extra for dusting",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "orange-zested-and-juiced-you-ll-need-4-tsp-juice",
      "item": "orange zested and juiced (you’ll need 4 tsp juice)",
      "quantity": 1
    },
    {
      "ingredient_id": "fresh-or-frozen-cranberries-defrosted-if-frozen",
      "item": "fresh or frozen cranberries (defrosted if frozen)",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "cre-me-frai-che-to-serve",
      "item": "crème fraîche to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs and muscovado sugar for 3 minutes. Add the caster sugar and whisk for 5 minutes, until thick.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk in the vanilla and melted butter. Fold in the flour, baking powder, and ginger until smooth, then fold in the orange zest and 4 teaspoons juice."
    },
    {
      "step": 3,
      "text": "Cover the batter and chill for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 4,
      "text": "Heat the oven to 400°F. Butter and flour a madeleine tin, shaking out the excess flour."
    },
    {
      "step": 5,
      "text": "Spoon the chilled batter into the molds, filling each about three-quarters full, and add the cranberries.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, until risen and set. Cool briefly in the tin, then transfer to a rack.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Serve warm or at room temperature with crème fraîche, if desired."
    }
  ],
