  "id": "crystallized-ginger",
  "name": "Crystallized Ginger",
  "subtitle": "Tender ginger slices coated in sparkling sugar",
  "description": "Cooked ginger becomes tender and candy-coated in this simple sweet preserve-style dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
