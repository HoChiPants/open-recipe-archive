  "ingredients": [
    {
      "ingredient_id": "fresh-young-ginger-root",
      "item": "fresh young ginger root",
      "quantity": 10,
      "unit": "ounces",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the peeled ginger into thin, even slices."
    },
    {
      "step": 2,
      "text": "Place the ginger in a saucepan with the sugar and water, stirring to coat."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer and cook until the ginger is tender and the syrup thickens and crystallizes around the slices.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Transfer the coated ginger to a tray and let it cool before serving or storing."
    }
  ],
