  "id": "cranberry-clementine-polenta-cake-with-cinnamon-cream",
  "name": "Cranberry Clementine Polenta Cake with Cinnamon Cream",
  "subtitle": "A citrusy polenta cake studded with cranberries and served with softly whipped cream.",
  "description": "A tender cranberry cake combining polenta and clementine zest, finished with cinnamon-scented cream.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "salted-butter-softened",
      "item": "salted butter softened",
      "quantity": 250,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "polenta",
      "item": "polenta",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "clementines-zested",
      "item": "clementines zested",
      "quantity": 4
    },
    {
      "ingredient_id": "fresh-or-frozen-cranberries-defrosted-if-frozen",
      "item": "fresh or frozen cranberries (defrosted if frozen)",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "double-or-whipping-cream",
      "item": "double or whipping cream",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "cinnamon",
      "item": "cinnamon",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "clementine-juice",
      "item": "clementine juice",
      "quantity": 3,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease the cake tin with some of the butter."
    },
    {
      "step": 2,
      "text": "Beat the softened butter and caster sugar until light and creamy, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Beat in the eggs one at a time, then mix in the self-raising flour, polenta, and clementine zest."
    },
    {
      "step": 4,
      "text": "Fold in the cranberries and clementine juice until the batter is smooth and evenly combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared tin and bake until risen, golden, and fully set in the center.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool the cake in the tin for 15 minutes, then transfer it to a serving plate.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Whisk the cream with the cinnamon and icing sugar to soft peaks. Chill until ready to serve, then spoon over the cooled cake."
    }
  ],
