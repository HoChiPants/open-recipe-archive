  "id": "pink-lemonade-pie",
  "name": "Pink Lemonade Pie",
  "subtitle": "A chilled citrus pie with a creamy, tangy filling",
  "description": "Combine lemonade concentrate and sweetened condensed milk, fold in whipped topping, and chill the filling in prepared graham cracker crusts for an easy dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "frozen-pink-lemonade-concentrate",
      "item": "frozen pink lemonade concentrate",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce, thawed"
    },
    {
      "ingredient_id": "8-ounce-container-frozen-whipped-topping",
      "item": "(8 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "8-inch-prepared-graham-cracker-crusts",
      "item": "(8 inch) prepared graham cracker crusts",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the sweetened condensed milk and thawed pink lemonade concentrate together until smooth."
    },
    {
      "step": 2,
      "text": "Gently fold in the thawed whipped topping until evenly combined."
    },
    {
      "step": 3,
      "text": "Divide the filling between the prepared graham cracker crusts and smooth the tops."
    },
    {
      "step": 4,
      "text": "Refrigerate until firm, about 2 hours, then slice and serve.",
      "timer_minutes": 120
    }
  ],
