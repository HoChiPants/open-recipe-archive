  "id": "coconut-custard-pies",
  "name": "Coconut Custard Pies",
  "subtitle": "Two simple pies with a sweet coconut filling",
  "description": "A smooth buttermilk and coconut custard baked in unbaked pie crusts until golden and set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 5
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "9-inch-unbaked-pie-crusts",
      "item": "(9 inch) unbaked pie crusts",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the eggs and sugar until smooth. Blend in the buttermilk and melted butter, then stir in the coconut and vanilla."
    },
    {
      "step": 3,
      "text": "Divide the filling between the two unbaked pie crusts."
    },
    {
      "step": 4,
      "text": "Bake for 50 minutes, until golden brown and the centers are fully set; a thermometer should read at least 160°F.",
      "timer_minutes": 50
    }
  ],
