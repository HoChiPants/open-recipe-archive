  "id": "chocolate-truffles",
  "name": "Chocolate Truffles",
  "subtitle": "Rich chocolate bites with a choice of festive coatings",
  "description": "A simple ganache-based confection shaped into small truffles and finished with cocoa, sprinkles, lustre powder, icing sugar, or chopped nuts.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 35,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "dark-chocolate-chopped",
      "item": "dark chocolate chopped",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "milk-chocolate-chopped",
      "item": "milk chocolate chopped",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder-sprinkles",
      "item": "cocoa powder sprinkles",
      "preparation": "lustre powder, icing sugar, chopped nuts, for coating"
    },
    {
      "ingredient_id": "flavourless-oil-such-as-sunflower",
      "item": "flavourless oil (such as sunflower)",
      "preparation": "for shaping"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the chopped dark chocolate, milk chocolate, cream, and butter in a heatproof bowl. Melt gently, stirring until smooth and combined.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk until glossy, then chill the mixture for 7 hours, or until firm enough to shape.",
      "timer_minutes": 420
    },
    {
      "step": 3,
      "text": "Prepare the coating choices in shallow bowls or plates."
    },
    {
      "step": 4,
      "text": "Lightly coat your hands with the flavourless oil and portion the chilled mixture into evenly sized balls."
    },
    {
      "step": 5,
      "text": "Roll each truffle in the chosen coating until evenly covered."
    },
    {
      "step": 6,
      "text": "Freeze the coated truffles briefly until firm, then arrange for serving or gifting."
    }
  ],
