      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter, packed brown sugar, and white sugar until blended. Add the sifted flour and stir in the chopped walnuts to form the crust mixture."
    },
    {
      "step": 3,
      "text": "Press the crust mixture evenly into a baking pan."
    },
    {
      "step": 4,
      "text": "Bake the crust for 15 minutes, then cool briefly.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Whisk the cream cheese, packed brown sugar, and white sugar until smooth. Stir in the milk, lemon juice, vanilla extract, and egg until combined."
    },
    {
      "step": 6,
      "text": "Transfer the filling over the crust and spread it evenly."
    },
    {
      "step": 7,
      "text": "Bake for 30 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Cool before cutting into bars."
    }
  ],
