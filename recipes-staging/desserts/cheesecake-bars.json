  "id": "cheesecake-bars",
  "name": "Cheesecake Bars",
  "subtitle": "Creamy baked filling over a walnut crust",
  "description": "These bars combine a buttery walnut crust with a smooth lemon-vanilla cheesecake layer.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup",
      "preparation": "sifted"
    },
    {
