{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "nectarine-pie",
  "name": "Nectarine Pie",
  "subtitle": "Tender fruit in a lightly spiced cream filling",
  "description": "Blanched nectarines are sliced, coated with a cinnamon-cream mixture, and baked in an unbaked pie shell until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "nectarines",
      "item": "nectarines",
      "quantity": 5
    },
    {
      "ingredient_id": "9-inch-unbaked-pie-shell",
      "item": "(9 inch) unbaked pie shell",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Whisk together the white sugar, all-purpose flour, and ground cinnamon. Add the heavy whipping cream and almond extract, whisking until smooth."
    },
    {
      "step": 3,
      "text": "Place the nectarines in boiling water briefly, then transfer them out and cut them into slices."
    },
    {
      "step": 4,
      "text": "Whisk the sliced nectarines with the cream mixture, then arrange the filling in the unbaked pie shell."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, until the filling is set and the center is fully firm.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Cool briefly, then serve."
    }
  ],
