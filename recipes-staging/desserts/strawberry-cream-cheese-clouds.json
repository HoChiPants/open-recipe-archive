{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "strawberry-cream-cheese-clouds",
  "name": "Strawberry Cream Cheese Clouds",
  "subtitle": "Pastry shells with strawberries and whipped cream cheese",
  "description": "Baked puff pastry shells filled with smooth vanilla cream cheese, whipped cream, and sweetened fresh strawberries.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "puff-pastry-shells",
      "item": "puff pastry shells",
      "quantity": 2,
      "unit": "package",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bake the puff pastry shells according to package directions, about 20 minutes, then cool completely.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Cut the strawberries and toss them with 1 tablespoon white sugar. Let stand until slightly syrupy."
    },
    {
      "step": 3,
      "text": "Whisk the cream cheese, 0.5 cup white sugar, and vanilla extract until smooth."
    },
    {
      "step": 4,
      "text": "Add the heavy cream and whisk for 3 minutes, or until stiff peaks form.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Fill the cooled pastry shells with the cream cheese mixture and top with the strawberries."
    },
    {
      "step": 6,
      "text": "Chill until set, then serve."
    }
  ],
