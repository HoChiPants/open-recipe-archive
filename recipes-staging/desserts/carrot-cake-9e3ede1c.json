  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, sugar, baking soda, cinnamon, salt, and nutmeg."
    },
    {
      "step": 3,
      "text": "Add the carrots, drained mandarin oranges, oil, eggs, vanilla, and orange zest. Whisk for 2 minutes, until smooth.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Transfer the batter to a prepared baking pan."
    },
    {
      "step": 5,
      "text": "Bake for about 50 minutes, until the center is firm and fully set; if checked, it should reach 160°F.",
      "timer_minutes": 50
    }
  ],
