  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Stir the graham cracker crumbs, 3 tablespoons white sugar, and melted butter until evenly moistened. Press the mixture into a pie pan and bake for 5 minutes, then cool.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk the eggs with the key lime juice, sweetened condensed milk, salt, and cream of tartar until smooth. Pour the filling into the cooled crust."
    },
    {
      "step": 3,
      "text": "Bake for 15 minutes, until the center is fully set or reaches 160°F on a food thermometer. Cool completely.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Whisk the heavy whipping cream with the cream of tartar and white sugar until stiff peaks form. Fold in the key lime juice and lime, then spread the topping over the cooled pie."
    },
    {
      "step": 5,
      "text": "Freeze the pie until firm, about 4 hours. Garnish with the sliced lime and serve.",
      "timer_minutes": 240
    }
  ],
