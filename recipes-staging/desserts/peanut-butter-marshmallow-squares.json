{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "peanut-butter-marshmallow-squares",
  "name": "Peanut Butter Marshmallow Squares",
  "subtitle": "A chewy no-bake-style bar with coconut and walnuts",
  "description": "Melt a rich butterscotch-peanut butter mixture, fold in marshmallows and toppings, then chill until firm for slicing.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butterscotch-chips",
      "item": "butterscotch chips",
      "quantity": 1,
      "unit": "package",
      "preparation": "11 ounce"
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "miniature-marshmallows",
      "item": "miniature marshmallows",
      "quantity": 3.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare a pan for the squares."
    },
    {
      "step": 2,
      "text": "Combine the butterscotch chips, peanut butter, and butter in a saucepan over simmering heat."
    },
    {
      "step": 3,
      "text": "Stir for 5 minutes, until the mixture is melted and smooth.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the marshmallows, coconut, and walnuts until evenly combined."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to the prepared pan and spread it evenly."
    },
    {
      "step": 6,
      "text": "Chill for 60 minutes, until set.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Cut into squares and serve."
    }
  ],
