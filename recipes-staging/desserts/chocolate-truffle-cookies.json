  "instructions": [
    {
      "step": 1,
      "text": "Melt the chopped unsweetened chocolate, 1 cup of semisweet chocolate chips, butter, and cocoa powder together in the microwave until smooth and simmering; stir frequently. Let cool briefly."
    },
    {
      "step": 2,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 3,
      "text": "Beat the eggs and sugar for 2 minutes, until thick. Stir in the melted chocolate mixture and vanilla.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Combine the flour, baking powder, and salt, then stir the dry mixture into the chocolate batter until just combined."
    },
    {
      "step": 5,
      "text": "Fold in the remaining 1 cup of semisweet chocolate chips. Chill the dough until firm."
    },
    {
      "step": 6,
      "text": "Shape the chilled dough into 36 portions and transfer them to baking sheets."
    },
    {
      "step": 7,
      "text": "Bake at 350°F for 11 minutes. Cool on the baking sheets for 5 minutes before serving.",
      "timer_minutes": 11
    }
  ],
