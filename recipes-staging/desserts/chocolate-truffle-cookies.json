  "id": "chocolate-truffle-cookies",
  "name": "Chocolate Truffle Cookies",
  "subtitle": "Rich chocolate cookies with a soft, fudgy center",
  "description": "A deeply chocolatey cookie made with melted chocolate, cocoa, and chocolate chips, chilled before baking for a tender truffle-like texture.",
  "meal_type": "dessert",
  "cuisine": "American",
