  "id": "tea-cookies",
  "name": "Tea Cookies",
  "subtitle": "Tender walnut cookies finished with confectioners' sugar",
  "description": "A simple butter cookie with vanilla and chopped walnuts, chilled before baking and dusted with sugar while warm.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "confectioners-sugar-for-dusting",
      "item": "confectioners' sugar for dusting",
      "quantity": 0.33333334326744,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened butter and 0.5 cup confectioners' sugar until smooth. Whisk in the vanilla."
    },
    {
      "step": 2,
      "text": "Combine the flour, salt, and baking powder, then blend the dry mixture into the butter mixture. Stir in the chopped walnuts."
    },
    {
      "step": 3,
      "text": "Chill the dough for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Cut the chilled dough into portions and transfer them to a baking sheet."
    },
    {
      "step": 5,
      "text": "Bake at 375°F for 12 minutes, until firm.",
      "timer_minutes": 12
    },
    {
      "step": 6,
      "text": "Shape or arrange the warm cookies as needed, then dust them with the confectioners' sugar for dusting."
    }
  ],
