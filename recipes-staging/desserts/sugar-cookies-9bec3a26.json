  "id": "sugar-cookies-9bec3a26",
  "name": "Sugar Cookies",
  "subtitle": "Tender cut-out cookies with crisp edges",
  "description": "A simple American sugar-cookie dough chilled for easy rolling, cut into shapes, and baked until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter-flavored-shortening",
      "item": "butter flavored shortening",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "light-corn-syrup",
      "item": "light corn syrup",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the sugar and shortening together until blended. Add the eggs, corn syrup, and vanilla, then whisk until smooth."
    },
    {
      "step": 3,
      "text": "Combine the flour, baking powder, baking soda, and salt. Add the dry mixture to the wet mixture and stir until a dough forms."
    },
    {
      "step": 4,
      "text": "Chill the dough for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "On a lightly floured surface, shape or roll the dough, using a little corn syrup as needed for handling. Flour a cutter and cut the dough into portions."
    },
    {
      "step": 6,
      "text": "Bake the cookies at 375°F for 10 minutes, or until set. Cool before serving.",
      "timer_minutes": 10
    }
  ],
