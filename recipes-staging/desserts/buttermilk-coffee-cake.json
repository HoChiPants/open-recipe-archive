      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the flour, sugar, baking powder, and baking soda together in a mixing bowl."
    },
    {
      "step": 3,
      "text": "Cut the room-temperature butter into the dry mixture until evenly distributed and crumbly."
    },
    {
      "step": 4,
      "text": "Stir together the buttermilk, eggs, and vanilla, then add this mixture to the bowl and stir until combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 35 minutes, until lightly browned and set in the center.",
      "timer_minutes": 35
    }
  ],
