      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
