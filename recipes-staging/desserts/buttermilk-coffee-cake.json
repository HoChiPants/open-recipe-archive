  "id": "buttermilk-coffee-cake",
  "name": "Buttermilk Coffee Cake",
  "subtitle": "A tender, lightly sweet cake for breakfast or dessert",
  "description": "A simple cake made with buttermilk, vanilla, and a buttery crumb-like batter, baked until lightly golden and set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
