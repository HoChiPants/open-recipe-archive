    "inactive_minutes": 164
  },
  "ingredients": [
    {
      "ingredient_id": "refrigerated-sliceable-sugar-cookies",
      "item": "refrigerated sliceable sugar cookies",
      "quantity": 1,
      "unit": "package",
      "preparation": "16.5 ounce, sliced"
    },
    {
      "ingredient_id": "philadelphia-cream-cheese",
      "item": "PHILADELPHIA Cream Cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla",
      "item": "vanilla",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "assorted-cut-up-fruit-kiwi",
      "item": "assorted cut-up fruit (kiwi",
      "quantity": 4,
      "unit": "cups",
      "preparation": "strawberries, blueberries, drained canned mandarin oranges)"
    },
    {
      "ingredient_id": "apricot-preserves",
      "item": "apricot preserves",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "pressed through sieve to remove lumps"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Arrange the sliced cookies in a single layer on a baking sheet, overlapping them slightly to form a round crust."
    },
    {
      "step": 3,
      "text": "Press and shape the slices into an even circle."
    },
    {
      "step": 4,
      "text": "Bake for 14 minutes, then cool completely.",
      "timer_minutes": 14
    },
    {
      "step": 5,
      "text": "Whisk the softened cream cheese with the sugar and vanilla until smooth."
    },
    {
      "step": 6,
      "text": "Transfer the cream cheese mixture to the cooled crust and spread it evenly."
    },
    {
      "step": 7,
      "text": "Arrange the cut-up fruit over the cream cheese layer."
    },
    {
      "step": 8,
      "text": "Combine the strained apricot preserves with the water, then brush or drizzle the mixture over the fruit."
    },
    {
      "step": 9,
      "text": "Chill for 2 hours before serving.",
      "timer_minutes": 120
    }
  ],
