  "id": "fruit-pizza",
  "name": "Fruit Pizza",
  "subtitle": "A chilled sugar-cookie dessert topped with cream cheese and fresh fruit",
  "description": "Bake a sugar-cookie crust, spread it with a sweet cream cheese layer, arrange fruit on top, and finish with an apricot glaze before chilling.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
