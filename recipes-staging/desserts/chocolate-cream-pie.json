  "id": "chocolate-cream-pie",
  "name": "Chocolate Cream Pie",
  "subtitle": "A chilled chocolate custard pie with a light whipped topping",
  "description": "A baked crust filled with rich chocolate custard, chilled until set, and finished with thawed whipped topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 3,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "9-inch-pie-crust",
      "item": "(9 inch) pie crust",
      "quantity": 1,
      "preparation": "baked"
    },
    {
      "ingredient_id": "frozen-whipped-topping",
      "item": "frozen whipped topping",
      "quantity": 1,
      "unit": "cup",
      "preparation": "thawed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the sugar and beaten egg yolks together in a bowl until blended."
    },
    {
      "step": 2,
      "text": "Combine the cocoa powder, cornstarch, and salt, then stir in the milk until smooth. Prepare the cornstarch as needed to eliminate lumps."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a saucepan and cook over medium heat, stirring constantly, until it reaches a boil and the custard reaches at least 160°F.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Remove from the heat and stir in the butter and vanilla extract."
    },
    {
      "step": 5,
      "text": "Pour the custard into the baked 9-inch pie crust and cool until set."
    },
    {
      "step": 6,
      "text": "Chill the pie until firm, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 7,
      "text": "Spread the thawed whipped topping over the chilled pie and whisk it smooth if needed before serving."
    }
  ],
