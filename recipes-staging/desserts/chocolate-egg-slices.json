  "id": "chocolate-egg-slices",
  "name": "Chocolate Egg Slices",
  "subtitle": "A crisp cocoa base with a set chocolate filling and chocolate-egg topping.",
  "description": "Bake a cocoa shortbread base, cover it with a rich chocolate-and-egg mixture, then finish with halved mini chocolate eggs.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 20,
    "unit": "slices"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 35
  },
  "ingredients": [
