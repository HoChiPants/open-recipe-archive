    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking tin."
    },
    {
      "step": 2,
      "text": "Whisk the soft butter and 80 g caster sugar until smooth. Fold in the plain flour and sieved cocoa to make a dough."
    },
    {
      "step": 3,
      "text": "Press the dough evenly into the tin and chill.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Bake the base until firm.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Melt the butter and dark chocolate together over simmering water or in short microwave intervals, stirring until smooth."
    },
    {
      "step": 6,
      "text": "Whisk the eggs with 50 g caster sugar, then fold in the cocoa and melted chocolate mixture."
    },
    {
      "step": 7,
      "text": "Pour the filling over the baked base and arrange the halved mini chocolate eggs on top."
    },
    {
      "step": 8,
      "text": "Bake until the filling is set and reaches 160°F in the center.",
      "timer_minutes": 15
    },
    {
      "step": 9,
      "text": "Cool completely before cutting into slices."
    }
  ],
