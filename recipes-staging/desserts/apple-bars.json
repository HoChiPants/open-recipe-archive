  "schema_version": "1.0.0",
  "id": "apple-bars",
  "name": "Apple Bars",
  "subtitle": "Tender cinnamon bars with tart apples and walnuts",
  "description": "A simple American dessert combining cinnamon, diced apples, and chopped walnuts in a buttery bar batter.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "peeled",
      "item": "peeled",
      "quantity": 1,
      "unit": "cup",
      "preparation": "cored, and diced tart apples (such as Granny Smith)"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, cinnamon, and baking soda together."
    },
    {
      "step": 3,
      "text": "Stir the sugar and melted butter together, then mix in the egg."
    },
    {
      "step": 4,
      "text": "Add the dry ingredients and stir until combined. Fold in the diced apples and walnuts."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a baking pan and spread it evenly."
    },
    {
      "step": 6,
      "text": "Bake for 40 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Cool before cutting into bars."
    }
  ],
