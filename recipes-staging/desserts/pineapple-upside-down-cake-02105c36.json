  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat a round cake pan with the melted unsalted butter, then distribute the brown sugar evenly over the bottom."
    },
    {
      "step": 2,
      "text": "Arrange the quartered pineapple slices over the sugar and fill the spaces with the frozen cranberries."
    },
    {
      "step": 3,
      "text": "Beat the softened unsalted butter with the white sugar until smooth. Add the eggs one at a time, beating after each addition, then mix in the baking powder, vanilla extract, almond extract, ground cinnamon, and salt."
    },
    {
      "step": 4,
      "text": "Add the flour and milk in alternating portions, mixing just until the batter is smooth. Spread it evenly over the fruit."
    },
    {
      "step": 5,
      "text": "Bake until the cake is golden and the center is fully set, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Let the cake cool in the pan for 20 minutes, loosen the edges, and invert it onto a serving plate.",
      "timer_minutes": 20
    }
  ],
