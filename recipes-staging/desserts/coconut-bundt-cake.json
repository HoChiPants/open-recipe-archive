  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Prepare a Bundt pan and set it aside."
    },
    {
      "step": 2,
      "text": "Whisk together the flour and baking powder. In a separate bowl, beat 1 cup softened butter with the sour cream until combined."
    },
    {
      "step": 3,
      "text": "Beat in the white sugar, then add the eggs one at a time. Mix in the coconut extract and vanilla extract."
    },
    {
      "step": 4,
      "text": "Stir in the flour mixture, 2 cups flaked coconut, and white chocolate chips until just combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake at 325°F for 60 minutes, or until the center is set and a tester comes out clean.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Let the cake rest for 10 minutes, then cool it completely before frosting.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Beat the cream cheese and ¼ cup softened butter with the vanilla extract until smooth. Add the confectioners' sugar and beat until creamy."
    },
    {
      "step": 8,
      "text": "Stir in the coconut extract and spread the frosting over the cooled cake. Finish with the toasted flaked coconut."
    }
  ],
