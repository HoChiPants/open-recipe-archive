  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease a cake tin with coconut oil and line the base."
    },
    {
      "step": 2,
      "text": "Whisk the plain flour, cocoa powder, baking powder, bicarbonate of soda, ground nutmeg, fine sea salt, golden caster sugar, light brown soft sugar, and instant coffee powder in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the coconut oil, coconut cream, vanilla extract, and eggs. Stir in the grated beetroot, then add the dry mixture and mix just until combined."
    },
    {
      "step": 4,
      "text": "Fold in the grated dark chocolate, transfer the batter to the tin, and bake until set and a skewer inserted in the center comes out clean.",
      "timer_minutes": 50
    },
    {
      "step": 5,
      "text": "Cool the cake completely in the tin or on a rack before frosting."
    },
    {
      "step": 6,
      "text": "Whisk the mascarpone, honey, icing sugar, vanilla bean paste, and double cream until smooth."
    },
    {
      "step": 7,
      "text": "Spread the frosting over the cooled cake and finish with the remaining grated dark chocolate."
    }
  ],
