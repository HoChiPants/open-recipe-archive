      "item": "unsalted butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine the flour, 1 tablespoon sugar, and salt. Cut in the chilled cubed butter until the mixture is crumbly, then mix in the vanilla and cold water until a dough forms."
    },
    {
      "step": 3,
      "text": "Shape the dough into a disk, wrap it, and chill for 60 minutes, or until firm.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Whisk the softened butter, 1/4 cup sugar, and cinnamon until evenly combined."
    },
    {
      "step": 5,
      "text": "On a lightly floured surface, roll the chilled dough out and cut it into 20 equal rectangles."
    },
    {
      "step": 6,
      "text": "Place cinnamon filling on 10 rectangles, leaving a border. Top with the remaining rectangles and press the edges firmly to seal."
    },
    {
      "step": 7,
      "text": "Transfer the pastries to a baking sheet and bake at 375°F for 30 minutes, until golden brown.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Cool for 15 minutes before serving.",
      "timer_minutes": 15
    }
  ],
