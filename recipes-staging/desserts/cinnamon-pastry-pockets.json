  "id": "cinnamon-pastry-pockets",
  "name": "Cinnamon Pastry Pockets",
  "subtitle": "Flaky hand pies with a buttery cinnamon-sugar center",
  "description": "Make tender pastry pockets filled with cinnamon butter and sugar, then bake until golden and crisp.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25,
    "inactive_minutes": 75
  },
  "ingredients": [
