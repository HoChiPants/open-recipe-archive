  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Place the butter in a baking dish and let it melt in the oven."
    },
    {
      "step": 2,
      "text": "Stir the white sugar and self-rising flour together, then mix in the milk to form a batter."
    },
    {
      "step": 3,
      "text": "Pour the batter over the melted butter without stirring. Spoon the sliced peaches and their syrup evenly over the batter."
    },
    {
      "step": 4,
      "text": "Bake for 45 minutes, until the topping is golden and set. Rest for 5 minutes before serving.",
      "timer_minutes": 45
    }
  ],
