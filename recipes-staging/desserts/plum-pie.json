  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Grease a pie dish."
    },
    {
      "step": 2,
      "text": "Mix 3 cups flour, 0.75 cup white sugar, baking powder, and 0.125 teaspoon salt. Cut in 0.66666698455811 cup butter until crumbly."
    },
    {
      "step": 3,
      "text": "Whisk the eggs with vanilla, milk, and 0.5 teaspoon lemon zest. Stir into the flour mixture just until combined, then set aside briefly."
    },
    {
      "step": 4,
      "text": "For the topping, combine 0.5 cup flour, 0.25 cup packed brown sugar, 0.5 teaspoon cinnamon, 0.25 teaspoon salt, chopped hazelnuts, and 1 teaspoon lemon zest. Work in 3 tablespoons butter until crumbly; set aside."
    },
    {
      "step": 5,
      "text": "Toss the sliced plums with 1 cup white sugar, 0.25 cup flour, 1 teaspoon cinnamon, and nutmeg until evenly coated."
    },
    {
      "step": 6,
      "text": "Press the dough into the prepared dish and shape it into an even crust. Add the plum mixture and scatter the topping over it."
    },
    {
      "step": 7,
      "text": "Bake until the topping is golden brown and the filling is bubbling, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Cool until set, then serve."
    }
  ],
