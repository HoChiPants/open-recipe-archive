{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "almond-milk-chocolate-pudding",
  "name": "Almond Milk Chocolate Pudding",
  "subtitle": "A smooth chilled cocoa pudding made on the stovetop.",
  "description": "Cocoa, almond milk, and cornstarch cook into a simple chocolate pudding with a silky finish.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "unsweetened-almond-milk",
      "item": "unsweetened almond milk",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sugar, cocoa powder, cornstarch, and salt in a saucepan. Slowly whisk in the almond milk until no lumps remain."
    },
    {
      "step": 2,
      "text": "Set the pan over medium heat and stir continuously until the pudding thickens and begins to bubble, about 5 to 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Remove from the heat. Stir in the butter until melted, then mix in the vanilla extract."
    },
    {
      "step": 4,
      "text": "Divide the pudding among serving dishes and chill until cooled and set.",
      "timer_minutes": 30
    }
  ],
