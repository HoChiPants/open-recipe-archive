  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Stir in the brown sugar, light corn syrup, water, and sweetened condensed milk until combined."
    },
    {
