  "id": "soft-sugar-cookies",
  "name": "Soft Sugar Cookies",
  "subtitle": "Tender buttermilk cookies with a lightly sweet finish",
  "description": "A simple rolled or dropped sugar cookie dough made with shortening, buttermilk, and vanilla, then baked until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "buttermilk",
      "item": "buttermilk",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the shortening and white sugar until smooth and well combined."
    },
    {
      "step": 2,
      "text": "Stir in the egg, buttermilk, and vanilla extract."
    },
    {
      "step": 3,
      "text": "Combine the all-purpose flour, baking soda, and salt in a separate bowl. Measure and prepare the baking soda as part of this dry mixture."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the wet mixture and stir just until a dough forms. Add the white sugar and baking soda as directed by the prepared mixture, without overmixing."
    },
    {
      "step": 5,
      "text": "Chill the dough before baking.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 7,
      "text": "Portion the dough onto a baking sheet and bake at 400°F for about 9 minutes, until the cookies are set and the center reaches at least 160°F.",
      "timer_minutes": 9
    }
  ],
