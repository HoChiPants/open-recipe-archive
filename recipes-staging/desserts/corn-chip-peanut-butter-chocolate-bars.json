  "id": "corn-chip-peanut-butter-chocolate-bars",
  "name": "Corn Chip Peanut Butter Chocolate Bars",
  "subtitle": "A crisp, chewy chocolate-topped candy bar",
  "description": "Corn chips are coated with a warm sugar syrup and peanut butter mixture, then finished with melted milk chocolate and cooled until firm.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "corn-chips",
      "item": "corn chips",
      "quantity": 10.5,
      "unit": "ounces"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "light-corn-syrup",
      "item": "light corn syrup",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "creamy-peanut-butter",
      "item": "creamy peanut butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "1-55-ounce-bars-milk-chocolate",
      "item": "(1.55 ounce) bars milk chocolate",
      "quantity": 11
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Spread the corn chips in a baking pan."
    },
    {
      "step": 2,
      "text": "Combine the white sugar and light corn syrup in a saucepan and heat, stirring, until the mixture is smooth and hot."
    },
    {
      "step": 3,
      "text": "Stir in the creamy peanut butter until smooth, then pour the mixture over the corn chips and gently coat them."
    },
    {
      "step": 4,
      "text": "Melt the milk chocolate bars until smooth and spread the chocolate over the coated chips."
    },
    {
      "step": 5,
      "text": "Cool until firm, then cut or break into 18 servings."
    }
  ],
