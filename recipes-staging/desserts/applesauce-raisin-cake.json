  "id": "applesauce-raisin-cake",
  "name": "Applesauce Raisin Cake",
  "subtitle": "A warmly spiced cake with applesauce, raisins, and walnuts",
  "description": "A tender, lightly spiced dessert cake enriched with applesauce and studded with raisins and chopped walnuts.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-cloves",
      "item": "ground cloves",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "applesauce",
      "item": "applesauce",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Measure the flour, then whisk it with the baking soda, cinnamon, cloves, and nutmeg."
    },
    {
      "step": 3,
      "text": "Beat the butter and sugar together until blended. Add the eggs and whisk until incorporated."
    },
    {
      "step": 4,
      "text": "Mix the flour mixture into the butter mixture alternately with the applesauce, blending just until combined."
    },
    {
      "step": 5,
      "text": "Fold in the walnuts and raisins, then transfer the batter to the prepared pan."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, or until the center is firm and fully set; a thermometer inserted in the center should read at least 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Cool the cake before slicing."
    }
  ],
