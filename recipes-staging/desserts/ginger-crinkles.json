  "id": "ginger-crinkles",
  "name": "Ginger Crinkles",
  "subtitle": "Soft-spiced molasses cookies with sugar-crackled tops",
  "description": "Chewy ginger cookies with warm cinnamon, molasses, and a light coating of sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
