  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Combine the flour, baking soda, cinnamon, ginger, and salt in a bowl."
    },
    {
      "step": 2,
      "text": "Mix the oil and 1 cup sugar until blended. Beat in the egg, then mix in the molasses."
    },
    {
      "step": 3,
      "text": "Add the dry mixture and stir just until a dough forms."
    },
    {
      "step": 4,
      "text": "Shape the dough into portions and roll each in the remaining sugar. Place on a baking sheet."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until the cookies are set in the center and reach at least 160°F for egg safety.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Cool briefly on the baking sheet before serving."
    }
  ],
