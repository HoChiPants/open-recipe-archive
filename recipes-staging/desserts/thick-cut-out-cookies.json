  "id": "thick-cut-out-cookies",
  "name": "Thick Cut-Out Cookies",
  "subtitle": "Tender rolled cookies with a simple vanilla glaze",
  "description": "Rich, sturdy cut-out cookies shaped from chilled dough, baked until set, and finished with a smooth vanilla glaze.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 72,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20,
    "inactive_minutes": 65
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2.125,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "cups",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 6
    },
    {
