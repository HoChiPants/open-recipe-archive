      "item": "hot water or as needed",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the white sugar, softened butter, and 1 cup of the confectioners' sugar until smooth."
    },
    {
      "step": 2,
      "text": "Whisk in the eggs and egg yolks, then mix in 1.5 teaspoons vanilla extract."
    },
    {
      "step": 3,
      "text": "Combine the flour, baking powder, and salt separately. Stir the dry mixture into the butter mixture until a dough forms."
    },
    {
      "step": 4,
      "text": "Divide and flatten the dough, cover, and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Preheat the oven to 375°F and prepare baking sheets."
    },
    {
      "step": 6,
      "text": "Roll the chilled dough on a lightly floured surface and cut out shapes."
    },
    {
      "step": 7,
      "text": "Transfer the shapes to the prepared sheets, working in batches as needed."
    },
    {
      "step": 8,
      "text": "Bake for 10 minutes, until the centers are fully set; an egg-containing cookie should reach 160°F if checked with a thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 9,
      "text": "Cool the cookies on the sheets for 5 minutes, then transfer them to a rack.",
      "timer_minutes": 5
    },
    {
      "step": 10,
      "text": "Whisk the remaining confectioners' sugar with the vegetable oil and 0.5 teaspoon vanilla extract until smooth. Add the hot water gradually until the glaze reaches a spreadable consistency."
    },
    {
      "step": 11,
      "text": "Transfer the glaze to the cooled cookies and let it set before serving."
    }
  ],
