  "id": "chocolate-stout-cake",
  "name": "Chocolate Stout Cake",
  "subtitle": "Rich chocolate cake with a creamy cheese frosting",
  "description": "A moist chocolate cake made with stout and finished with a smooth soft-cheese frosting.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-cubed",
      "item": "unsalted butter cubed",
      "quantity": 225,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
