  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease a cake tin with some of the butter."
    },
    {
      "step": 2,
      "text": "Melt the butter with the Guinness. Whisk the cocoa powder and caster sugar in a large bowl, then stir in the warm butter mixture."
    },
    {
      "step": 3,
      "text": "Whisk together the eggs, soured cream, and vanilla paste. Add them to the chocolate mixture, then stir in the plain flour and bicarbonate of soda until just combined."
    },
    {
      "step": 4,
      "text": "Pour the batter into the prepared tin and bake until risen and set.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Leave the cake in the tin for 10 minutes, then transfer it to a rack and cool completely.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "For the frosting, whisk the full-fat soft cheese, icing sugar, and cornflour until smooth. Add the double cream and whisk to soft peaks."
    },
    {
      "step": 7,
      "text": "Spread the frosting over the cooled cake, dust with icing sugar, and serve."
    }
  ],
