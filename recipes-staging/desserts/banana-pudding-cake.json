      "item": "walnuts",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the yellow cake mix and instant banana pudding mix together. Add the eggs, water, vegetable oil, and mashed bananas; whisk for 4 minutes, until evenly combined.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and bake until the center is fully set, about 55 minutes.",
      "timer_minutes": 55
    },
    {
      "step": 4,
      "text": "Cool the cake for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Whisk the confectioners' sugar, milk, and vanilla extract until smooth."
    },
    {
      "step": 6,
      "text": "Spread the glaze over the cooled cake and finish with the chopped walnuts."
    }
  ],
