  "id": "banana-pudding-cake",
  "name": "Banana Pudding Cake",
  "subtitle": "A moist banana cake with a simple vanilla glaze",
  "description": "A tender banana-flavored cake finished with a smooth confectioners’ sugar glaze and chopped walnuts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "yellow-cake-mix",
      "item": "yellow cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "instant-banana-pudding-mix",
      "item": "instant banana pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.5 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
