  "id": "christmas-cookies",
  "name": "Christmas Cookies",
  "subtitle": "Decorated buttery biscuits for the holiday season",
  "description": "Tender vanilla biscuits finished with icing, edible balls, and ribbon for hanging or serving.",
  "meal_type": "dessert",
  "cuisine": "British",
  "yield": {
    "quantity": 20,
    "unit": "biscuits"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 12
  },
  "ingredients": [
    {
      "ingredient_id": "icing-sugar-sieved",
      "item": "icing sugar sieved",
      "quantity": 140,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg-yolk",
      "item": "egg yolk",
      "quantity": 1
    },
    {
      "ingredient_id": "butter-cut-into-small-cubes",
      "item": "butter cut into small cubes",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "plain-flour-sieved",
      "item": "plain flour sieved",
      "quantity": 375,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar-sieved",
      "item": "icing sugar sieved",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "edible-food-colouring-optional",
      "item": "edible food colouring optional",
      "optional": true
    },
    {
      "ingredient_id": "edible-gold-and-silver-balls",
      "item": "edible gold and silver balls"
    },
    {
      "ingredient_id": "approx-2m-thin-ribbon-cut-into-10cm-lengths",
      "item": "approx 2m thin ribbon cut into 10cm lengths"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir together the 140 g icing sugar, vanilla extract, egg yolk, butter, and optional food colouring until combined."
    },
    {
      "step": 2,
      "text": "Mix in the plain flour to form a firm dough. Shape it into a disc, wrap, and chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat the oven and line baking trays. Roll out the dough, cut into biscuits, and make a small hole in each for hanging if desired."
    },
    {
      "step": 4,
      "text": "Bake for 12 minutes, until lightly colored and the centers are firm and fully set, reaching 160°F internally for egg safety.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Cool the biscuits completely on the trays or a rack."
    },
    {
      "step": 6,
      "text": "Combine the 200 g icing sugar with enough water to make a thick icing. Tint with optional food colouring if desired."
    },
    {
      "step": 7,
      "text": "Decorate with the icing and edible gold and silver balls. Thread the ribbon through the holes once the icing has set."
    }
  ],
