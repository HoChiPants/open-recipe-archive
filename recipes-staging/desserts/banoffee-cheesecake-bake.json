  "instructions": [
    {
      "step": 1,
      "text": "Grease the tin with some melted butter. Preheat the oven to 320°F (160°C)."
    },
    {
      "step": 2,
      "text": "Stir the crushed biscuits with the melted butter, ground cinnamon, cinnamon, and cocoa. Press the mixture firmly into the base of the tin."
    },
    {
      "step": 3,
      "text": "Arrange the chopped bananas over the biscuit base."
    },
    {
      "step": 4,
      "text": "Beat the soft cheese, mascarpone, brown sugar, caster sugar, vanilla, eggs, and flour until smooth. Pour the mixture over the bananas and spoon the 100 g caramel over the surface.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until the center is firm and reaches 160°F (71°C) on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool the bake completely, then transfer it to a serving dish."
    },
    {
      "step": 7,
      "text": "Whisk the double cream with the icing sugar to soft peaks. Spread or pipe it over the cooled bake, drizzle with the remaining caramel, and dust with cocoa."
    },
    {
      "step": 8,
      "text": "Add the optional banana chips and cut into portions."
    }
  ],
