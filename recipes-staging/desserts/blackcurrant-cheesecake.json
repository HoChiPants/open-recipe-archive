  "id": "blackcurrant-cheesecake",
  "name": "Blackcurrant Cheesecake",
  "subtitle": "A creamy baked cheesecake with bright blackcurrant swirls.",
  "description": "A biscuit-based cheesecake layered with soft cheese filling and blackcurrants, then baked and chilled until set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-melted",
      "item": "unsalted butter melted",
      "quantity": 140,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "digestive-biscuits",
      "item": "digestive biscuits",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 275,
      "unit": "g"
    },
    {
      "ingredient_id": "fresh-or-frozen-blackcurrants-brought-to-room-temperature-for-1-hr-before-using",
      "item": "fresh or frozen blackcurrants (brought to room temperature for 1 hr before using",
      "quantity": 100,
      "unit": "g",
      "preparation": "if frozen)"
    },
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "full-fat-soft-cheese",
      "item": "full-fat soft cheese",
      "quantity": 900,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "soured-cream",
      "item": "soured cream",
      "quantity": 200,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease a cheesecake tin with extra butter."
    },
    {
      "step": 2,
      "text": "Crush the digestive biscuits, stir in the melted butter, and press the mixture firmly into the tin. Chill until set, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Combine the cornflour and plain flour. Prepare the blackcurrants with the golden caster sugar, heating briefly as directed until the mixture is ready.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Whisk the soft cheese until smooth, then add the sugar, flour mixture, vanilla, eggs, and soured cream. Beat until evenly combined."
    },
    {
      "step": 5,
      "text": "Transfer the filling to the chilled biscuit base. Add the blackcurrant mixture and gently swirl it through the surface."
    },
    {
      "step": 6,
      "text": "Bake until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Cool the cheesecake, then chill for at least 3 hours before serving.",
      "timer_minutes": 180
    }
  ],
