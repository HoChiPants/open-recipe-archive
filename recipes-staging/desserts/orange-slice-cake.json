  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 250°F. Prepare the flour for mixing."
    },
    {
      "step": 2,
      "text": "Whisk the white sugar and confectioners' sugar until smooth. Add the eggs, then mix in the softened butter, buttermilk, and baking soda."
    },
    {
      "step": 3,
      "text": "Add the flour, dates, chopped orange slice candy, and orange juice. Stir until combined, then add the remaining flour and shredded coconut and stir into a cohesive batter."
    },
    {
      "step": 4,
      "text": "Transfer the batter to a baking vessel and bake for 180 minutes, or until the center is firm and fully set.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Combine the white sugar, orange slice candy, orange juice, and confectioners' sugar to prepare the finishing mixture."
    },
    {
      "step": 6,
      "text": "Prepare and apply the finishing mixture to the baked cake before serving."
    }
  ],
