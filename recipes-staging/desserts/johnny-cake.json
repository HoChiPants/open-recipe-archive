  "id": "johnny-cake",
  "name": "Johnny Cake",
  "subtitle": "A tender cornmeal cake with a lightly sweet crumb",
  "description": "Mix cornmeal, milk, creamed shortening, sugar, egg, and dry ingredients into a batter, then bake until fully set.",
  "meal_type": "dessert",
