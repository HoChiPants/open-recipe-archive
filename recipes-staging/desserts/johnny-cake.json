  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Combine the cornmeal with 0.5 cup milk. Separately, whisk together the cake flour, baking powder, and salt."
    },
    {
      "step": 3,
      "text": "Whisk the shortening and white sugar until blended. Add the egg and the remaining 1 cup milk, then stir until smooth."
    },
    {
      "step": 4,
      "text": "Stir the dry ingredients into the shortening mixture, then blend in the cornmeal mixture to form a batter."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake at 350°F for 45 minutes, or until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Cool briefly, then serve."
    }
  ],
