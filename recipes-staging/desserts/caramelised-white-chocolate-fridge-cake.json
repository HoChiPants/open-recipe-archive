  "id": "caramelised-white-chocolate-fridge-cake",
  "name": "Caramelised White Chocolate Fridge Cake",
  "subtitle": "A crisp, chewy no-bake chocolate slice with dried fruit and cherries.",
  "description": "Melted chocolate binds biscuits, fruit, and rice pops into a chilled cake finished with chocolate and optional sweets.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "pieces"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 8
  },
  "ingredients": [
    {
      "ingredient_id": "butter-plus-extra-for-the-tin",
      "item": "butter plus extra for the tin",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "blonde-white-chocolate-or-if-you-can-t-find-it",
      "item": "blonde white chocolate (or if you can’t find it",
      "quantity": 400,
      "unit": "g",
      "preparation": "use 500g regular white chocolate in total), broken into pieces"
    },
    {
      "ingredient_id": "white-chocolate-broken-into-pieces",
      "item": "white chocolate broken into pieces",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "mixed-dried-fruit",
      "item": "mixed dried fruit",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "rich-tea-biscuits-roughly-broken-up-into-pieces",
      "item": "rich tea biscuits roughly broken up into pieces",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "glace-cherries-halved",
      "item": "glacé cherries halved",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "rice-pops",
      "item": "rice pops",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "milk-chocolate",
      "item": "milk chocolate",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "bright-red-and-green-sweets-and-gold-sugared-almonds",
      "item": "bright red and green sweets and gold sugared almonds",
      "preparation": "to decorate (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grease a square tin with the extra butter and line it with baking paper."
    },
    {
      "step": 2,
      "text": "Melt the 50g butter, blonde white chocolate, 100g white chocolate, double cream, and milk chocolate together over low heat, stirring until smooth; allow about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Fold in the dried fruit, broken biscuits, glacé cherries, and rice pops until evenly coated."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared tin and press it into an even layer. Chill until firm, about 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Melt the remaining white chocolate until smooth, drizzle or spread it over the chilled cake, and add the optional sweets and sugared almonds."
    },
    {
      "step": 6,
      "text": "Cut into 16 pieces and serve."
    }
  ],
