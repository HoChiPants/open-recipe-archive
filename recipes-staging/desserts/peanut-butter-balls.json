    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "maple-flavored-extract",
      "item": "maple flavored extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the butter, peanut butter, confectioners' sugar, vanilla extract, and maple flavored extract together until evenly combined."
    },
    {
      "step": 2,
      "text": "Shape the mixture into 30 balls and arrange them on a lined tray."
    },
    {
      "step": 3,
      "text": "Melt the semisweet chocolate chips until smooth, then coat the peanut butter balls in the chocolate."
    },
    {
      "step": 4,
      "text": "Chill the coated balls for 15 minutes, then serve.",
      "timer_minutes": 15
    }
  ],
