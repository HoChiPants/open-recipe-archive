  "id": "peanut-butter-balls",
  "name": "Peanut Butter Balls",
  "subtitle": "Chocolate-coated bites with a smooth peanut butter center",
  "description": "Sweet peanut butter balls dipped in melted semisweet chocolate and chilled until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
