  "id": "champorado",
  "name": "Champorado",
  "subtitle": "Creamy coconut chocolate rice pudding",
  "description": "A warm, thick rice pudding made with glutinous rice, coconut milk, cocoa, sugar, and salt.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "glutinous-sweet-rice",
      "item": "glutinous sweet rice",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "light-coconut-milk",
      "item": "light coconut milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "thick-coconut-milk",
      "item": "thick coconut milk",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the rice, light coconut milk, and thick coconut milk in a saucepan."
    },
    {
      "step": 2,
      "text": "Bring to a gentle simmer and cook for 10 minutes, stirring occasionally.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the cocoa powder, sugar, and salt until evenly combined."
    },
    {
      "step": 4,
      "text": "Continue cooking gently for 10 minutes, stirring often, until the rice is tender and the mixture is thick.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer to serving bowls and serve warm."
    }
  ],
