{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "banana-traybake-with-cream-cheese-frosting",
  "name": "Banana Traybake with Cream Cheese Frosting",
  "subtitle": "Moist banana squares with a cinnamon cream cheese topping",
  "description": "A simple banana cake baked in a tray, cooled, and finished with a smooth cream cheese frosting.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 20,
    "unit": "squares"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "ripe-bananas-2-medium",
      "item": "ripe bananas (2 medium)",
      "quantity": 300,
      "unit": "g",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "flavourless-oil-like-sunflower-or-grapeseed",
      "item": "flavourless oil like sunflower or grapeseed",
      "quantity": 125,
      "unit": "ml"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "wholemeal-or-rye-flour",
      "item": "wholemeal or rye flour",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "cinnamon",
      "item": "cinnamon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 3,
      "unit": "tsp"
    },
    {
      "ingredient_id": "white-chocolate-chips-or-chopped-walnuts-optional",
      "item": "white chocolate chips or chopped walnuts (optional)",
      "quantity": 100,
      "unit": "g",
      "optional": true
    },
    {
      "ingredient_id": "unsalted-butter-softened",
      "item": "unsalted butter softened",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar-sieved",
      "item": "icing sugar sieved",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "full-fat-cream-cheese",
      "item": "full-fat cream cheese",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "pinch-cinnamon",
      "item": "pinch cinnamon",
      "unit": "large"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a traybake pan."
    },
    {
      "step": 2,
      "text": "Whisk the golden caster sugar, peeled bananas, eggs, and oil until blended."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk together the wholemeal or rye flour, plain flour, cinnamon, baking powder, and pinch cinnamon."
    },
    {
      "step": 4,
      "text": "Stir the dry mixture into the banana mixture until just combined, then fold in the optional white chocolate chips or chopped walnuts."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 40 minutes, or until firm.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Cool the cake completely in the pan or on a rack."
    },
    {
      "step": 7,
      "text": "Whisk the softened butter and sieved icing sugar until smooth, then fold in the cream cheese and whisk until creamy."
    },
    {
      "step": 8,
      "text": "Transfer the frosting to the cooled cake, spread it evenly, and finish with the cinnamon."
    },
    {
      "step": 9,
      "text": "Cut into squares and serve."
    }
  ],
