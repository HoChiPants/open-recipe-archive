{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "peach-crisp",
  "name": "Peach Crisp",
  "subtitle": "Warm peaches beneath a cinnamon crumb topping",
  "description": "Sliced peaches are baked with almond flavor and a buttery brown-sugar topping until tender and crisp.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-peaches",
      "item": "fresh peaches",
      "quantity": 6,
      "preparation": "peeled, pitted, and sliced"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Arrange the sliced peaches in a baking dish and toss with the almond extract."
    },
    {
      "step": 3,
      "text": "Stir the flour, white sugar, brown sugar, cinnamon, and salt together. Cut in the butter until coarse crumbs form."
    },
    {
      "step": 4,
      "text": "Scatter the crumb mixture over the peaches."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, until the peaches are tender and the topping is browned.",
      "timer_minutes": 45
    }
  ],
