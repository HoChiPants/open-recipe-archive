  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and line 24 cupcake wells."
    },
    {
      "step": 2,
      "text": "Beat the cake mix, water, oil, eggs, shortening, lemon juice, and lemon zest for 2 minutes. Divide the batter among the wells.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Bake for 22 minutes, or until lightly browned and the centers are set. Cool completely.",
      "timer_minutes": 22
    },
    {
      "step": 4,
      "text": "Beat the remaining shortening, butter, lemon juice, and 2 cups confectioners' sugar until smooth. Set aside as the filling."
    },
    {
      "step": 5,
      "text": "Melt the chopped white chocolate and let it cool slightly."
    },
    {
      "step": 6,
      "text": "Beat the softened cream cheese and 1/2 cup softened butter until smooth. Mix in the melted white chocolate and vanilla."
    },
    {
      "step": 7,
      "text": "Gradually whisk in 4 cups confectioners' sugar, orange juice, and lemon zest until smooth."
    },
    {
      "step": 8,
      "text": "Cut a small center from each cooled cupcake, fill with the lemon mixture, and replace the tops. Frost the cupcakes."
    }
  ],
