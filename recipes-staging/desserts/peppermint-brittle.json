  "id": "peppermint-brittle",
  "name": "Peppermint Brittle",
  "subtitle": "Creamy white chocolate with crisp peppermint",
  "description": "A simple chilled candy made by combining melted white chocolate with crushed peppermint candy.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "white-chocolate",
      "item": "white chocolate",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "peppermint-candy-canes",
      "item": "peppermint candy canes",
      "quantity": 30,
      "unit": "small"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Line a flat tray or pan with parchment paper."
    },
    {
      "step": 2,
      "text": "Break the white chocolate into a microwave-safe bowl and microwave until melted, stirring between intervals.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Crush the peppermint candy canes, reserving some pieces for the surface if desired."
    },
    {
      "step": 4,
      "text": "Stir the crushed peppermint into the melted chocolate, then spread the mixture evenly on the prepared tray."
    },
    {
      "step": 5,
      "text": "Refrigerate until firm, about 1 hour, then break or cut into pieces.",
      "timer_minutes": 60
    }
  ],
