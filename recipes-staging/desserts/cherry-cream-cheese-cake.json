  "id": "cherry-cream-cheese-cake",
  "name": "Cherry Cream Cheese Cake",
  "subtitle": "A tender cream cheese cake with cherries and pecans",
  "description": "A rich, softly textured cake combining cream cheese, candied cherries, and chopped pecans.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
