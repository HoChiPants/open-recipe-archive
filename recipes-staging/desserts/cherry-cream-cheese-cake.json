  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F and prepare a cake pan."
    },
    {
      "step": 2,
      "text": "Beat the cream cheese, butter, sugar, and vanilla until smooth."
    },
    {
      "step": 3,
      "text": "Beat in the eggs one at a time."
    },
    {
      "step": 4,
      "text": "Whisk the flour, baking powder, and salt together, then incorporate the dry mixture into the batter."
    },
    {
      "step": 5,
      "text": "Toss the halved cherries with the remaining flour, then fold them into the batter with the pecans."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and add the pecans over the top."
    },
    {
      "step": 7,
      "text": "Bake for 75 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 75
    },
    {
      "step": 8,
      "text": "Cool the cake before serving."
    },
    {
      "step": 9,
      "text": "Slice and serve."
    }
  ],
