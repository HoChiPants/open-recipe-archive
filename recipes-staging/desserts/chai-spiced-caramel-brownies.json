  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Butter a baking tin."
    },
    {
      "step": 2,
      "text": "Microwave the butter and chopped chocolate in short bursts until the butter is simmering and the chocolate is nearly melted. Stir smooth, then let cool slightly."
    },
    {
      "step": 3,
      "text": "Stir the caramel into the cooled chocolate mixture."
    },
    {
      "step": 4,
      "text": "Whisk the eggs and caster sugar for 5 minutes, until thick.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Combine the flour, cocoa powder, salt, cardamom, allspice, cinnamon, cloves, and ginger."
    },
    {
      "step": 6,
      "text": "Whisk the chocolate mixture into the egg mixture. Fold in the dry ingredients until just combined."
    },
    {
      "step": 7,
      "text": "Transfer the batter to the prepared tin and bake for 30 minutes, until set.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Let the brownies stand for 5 minutes, then cut into portions and serve.",
      "timer_minutes": 5
    }
  ],
