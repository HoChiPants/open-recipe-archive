  "id": "chai-spiced-caramel-brownies",
  "name": "Chai-Spiced Caramel Brownies",
  "subtitle": "Fudgy chocolate brownies with warm chai spices and caramel.",
  "description": "Rich brownies combining dark chocolate, aromatic spices, and a caramel swirl, baked in a tin and portioned into 16 servings.",
  "meal_type": "dessert",
