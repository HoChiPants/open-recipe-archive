  "id": "brown-sugar-pavlova-with-fruit",
  "name": "Brown Sugar Pavlova with Fruit",
  "subtitle": "Crisp meringue with vanilla cream and fresh fruit",
  "description": "A brown sugar meringue topped with softly whipped vanilla cream and a colorful mix of peach, berries, pineapple, and passion fruit.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 50
  },
  "ingredients": [
