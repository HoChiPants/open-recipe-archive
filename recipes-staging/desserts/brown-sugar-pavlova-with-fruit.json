  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven for baking the pavlova and line a baking tray with parchment."
    },
    {
      "step": 2,
      "text": "Whisk the egg whites until stiff peaks form. Gradually add the light brown soft sugar and golden caster sugar, then whisk until the mixture is smooth. Whisk in 1 teaspoon vanilla extract for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Shape the meringue on the prepared tray, leaving a shallow center for the topping."
    },
    {
      "step": 4,
      "text": "Bake for 50 minutes, until the outside is set. For egg safety, verify that the center reaches 160°F and is fully set; otherwise use pasteurized egg whites. Cool completely.",
      "timer_minutes": 50
    },
    {
      "step": 5,
      "text": "Whisk the double cream with the icing sugar and remaining 1 teaspoon vanilla extract until soft peaks form."
    },
    {
      "step": 6,
      "text": "Top the cooled pavlova with the cream. Arrange the peach, raspberries, strawberries, pineapple, and passion fruit over it, then serve."
    }
  ],
