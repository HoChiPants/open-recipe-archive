  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Arrange the cod in a baking dish and spread the mashed potatoes over it. Set aside."
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan over medium heat. Whisk in the flour and cook for 5 minutes, until golden brown.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Gradually whisk in the warm milk. Stir in the garlic and cook for 5 minutes, until the sauce thickens; add more milk if needed.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Mix in the white Cheddar, spinach, onion, salt, and pepper. Pour the sauce over the cod and potatoes, then top with the yellow Cheddar."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, then continue baking for about 20 minutes, until the fish is opaque and flakes easily or reaches 145°F in the thickest pieces.",
      "timer_minutes": 50
    }
  ],
