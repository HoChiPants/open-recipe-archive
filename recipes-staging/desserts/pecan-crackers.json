  "id": "pecan-crackers",
  "name": "Pecan Crackers",
  "subtitle": "Crisp graham crackers with a buttery pecan topping",
  "description": "Graham crackers are layered with chopped pecans and covered in a simmered butter-sugar mixture before baking until crisp.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "graham-crackers",
      "item": "graham crackers",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 2,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Arrange the graham crackers in a single layer on a baking sheet and scatter the pecans over them."
    },
    {
      "step": 2,
      "text": "Heat the sugar, butter, and margarine together in a saucepan until melted and simmering. Simmer for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Pour the hot mixture evenly over the crackers and pecans."
    },
    {
      "step": 4,
      "text": "Bake for 12 minutes, then cool completely on the baking sheet before serving.",
      "timer_minutes": 12
    }
  ],
