  "instructions": [
    {
      "step": 1,
      "text": "Prepare a steamer and pudding mold. Combine the butter, brown sugar, milk, dates, raisins, currants, candied peel, and orange zest in a saucepan."
    },
    {
      "step": 2,
      "text": "Bring the fruit mixture to a simmer, then remove it from the heat and stir in the baking soda."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk together the self-rising flour, cinnamon, and salt. Stir the dry mixture into the warm fruit mixture until combined."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared pudding mold and cover it securely."
    },
    {
      "step": 5,
      "text": "Steam for 120 minutes, maintaining a steady simmer, until the pudding is firm and cooked through.",
      "timer_minutes": 120
    }
  ],
