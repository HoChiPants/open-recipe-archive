{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cookie-dough-truffles",
  "name": "Cookie Dough Truffles",
  "subtitle": "Chocolate-coated bites with a soft cookie-dough center",
  "description": "Heat-treated flour, butter, brown sugar, vanilla, and chocolate form bite-size truffles finished with a smooth chocolate coating.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 180,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 120,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-or-milk-chocolate-50g-finely-chopped",
      "item": "dark or milk chocolate 50g finely chopped",
      "quantity": 200,
      "unit": "g",
      "preparation": "the rest broken up"
    },
    {
      "ingredient_id": "white-chocolate-broken-up",
      "item": "white chocolate broken up",
      "quantity": 60,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Spread the flour in a shallow heatproof dish and heat it for 5 minutes, or until it reaches 165°F. Cool completely.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk the butter, brown sugar, and vanilla until combined. Add the cooled flour and mix into a firm dough."
    },
    {
      "step": 3,
      "text": "Fold in the 50 g finely chopped dark or milk chocolate, then shape the mixture into 30 equal balls. Chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Place the remaining broken dark or milk chocolate and the white chocolate in a microwave-safe bowl. Microwave in short bursts, stirring between each, until melted and smooth."
    },
    {
      "step": 5,
      "text": "Dip or roll the chilled truffles in the melted chocolate to coat them. Chill until the coating is set.",
      "timer_minutes": 60
    }
  ],
  "tags": [
    "cookie-dough",
    "chocolate-truffles",
    "chocolate-dessert",
    "no-bake-dessert"
  ],
