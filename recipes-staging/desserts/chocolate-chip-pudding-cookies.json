  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour and baking soda together in a bowl."
    },
    {
      "step": 3,
      "text": "Beat the softened butter, both sugars, pudding mix, and vanilla until blended and smooth."
    },
    {
      "step": 4,
      "text": "Add the eggs and whisk until fully incorporated."
    },
    {
      "step": 5,
      "text": "Stir in the flour mixture just until a dough forms, then fold in the chocolate chips and walnuts."
    },
    {
      "step": 6,
      "text": "Portion the dough onto baking sheets and bake at 375°F until the cookies are set, about 10 minutes.",
      "timer_minutes": 10
    }
  ],
