  "id": "chocolate-chip-pudding-cookies",
  "name": "Chocolate Chip Pudding Cookies",
  "subtitle": "Soft cookies with butterscotch pudding and walnuts",
  "description": "Tender American-style cookies combining brown sugar, butterscotch pudding mix, chocolate chips, and chopped walnuts.",
  "meal_type": "dessert",
  "cuisine": "American",
