  "id": "oatmeal-cinnamon-cookies",
  "name": "Oatmeal Cinnamon Cookies",
  "subtitle": "Chewy oat cookies with warm cinnamon flavor",
  "description": "Tender oatmeal cookies made with brown sugar, cinnamon, and cinnamon chips.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "oats",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "cinnamon-chips",
      "item": "cinnamon chips",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter and brown sugar until smooth. Add the eggs and vanilla extract, then whisk until combined."
    },
    {
      "step": 3,
      "text": "Mix the flour, baking soda, salt, and ground cinnamon separately. Add the dry mixture to the butter mixture and stir until incorporated."
    },
    {
      "step": 4,
      "text": "Fold in the oats and cinnamon chips to form a thick dough."
    },
    {
      "step": 5,
      "text": "Scoop the dough onto baking sheets, spacing portions apart."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, or until lightly browned. Cool before serving.",
      "timer_minutes": 10
    }
  ],
