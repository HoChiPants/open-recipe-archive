      "item": "extra blueberries blueberry compote or ice cream",
      "preparation": "to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and butter a baking tin, using the extra butter."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, egg, milk, melted butter, sugar, orange zest, and orange juice into a smooth batter."
    },
    {
      "step": 3,
      "text": "Fold in the blueberries, then pour the batter into the prepared tin."
    },
    {
      "step": 4,
      "text": "Bake for 20 minutes, until the center is firm and fully set. For a thermometer check, cook the egg mixture to 160°F.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Dust with icing sugar and serve with the optional blueberries, blueberry compote, or ice cream."
    }
  ],
