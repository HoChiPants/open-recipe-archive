  "id": "blueberry-orange-traybake-pancake",
  "name": "Blueberry Orange Traybake Pancake",
  "subtitle": "A soft citrus pancake baked with blueberries",
  "description": "Bake one fluffy, orange-scented pancake in a tin, then finish it with icing sugar and optional toppings.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
