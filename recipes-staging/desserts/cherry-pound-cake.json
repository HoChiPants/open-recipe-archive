  "id": "cherry-pound-cake",
  "name": "Cherry Pound Cake",
  "subtitle": "A tender cream-cheese cake studded with cherries",
  "description": "A classic baked dessert with a rich cream-cheese batter, almond and vanilla flavor, and pockets of bright maraschino cherries.",
  "meal_type": "dessert",
  "cuisine": "American",
