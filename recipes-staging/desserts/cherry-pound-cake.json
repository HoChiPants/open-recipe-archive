  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Combine the 2 cups flour, baking powder, and salt in a bowl. Toss the drained cherry halves with the ¼ cup flour in a separate bowl."
    },
    {
      "step": 3,
      "text": "Whisk the butter, cream cheese, and sugar until smooth. Add the eggs, vanilla extract, and almond extract, then whisk until fully blended."
    },
    {
      "step": 4,
      "text": "Whisk the dry mixture into the wet mixture until just combined. Fold in the floured cherries."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 80 minutes, until the center is firm and the cake reaches at least 160°F on a food thermometer.",
      "timer_minutes": 80
    },
    {
      "step": 6,
      "text": "Let the cake cool in the pan for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
