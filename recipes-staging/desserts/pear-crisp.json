  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Stir the rolled oats, brown sugar, 0.5 cup all-purpose flour, 1 teaspoon crystallized ginger, ground cinnamon, and white sugar together."
    },
    {
      "step": 3,
      "text": "Work the butter into the oat mixture until evenly blended and set the topping aside."
    },
    {
      "step": 4,
      "text": "In a separate bowl, stir the remaining brown sugar, 2 tablespoons all-purpose flour, 2 teaspoons crystallized ginger, and white sugar together. Add the pears and toss to coat."
    },
    {
      "step": 5,
      "text": "Transfer the pear mixture to a baking dish and spread the oat topping over it."
    },
    {
      "step": 6,
      "text": "Bake until the topping is golden brown and the pears are tender, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Serve warm with vanilla ice cream."
    }
  ],
