  "id": "pear-crisp",
  "name": "Pear Crisp",
  "subtitle": "Warm spiced pears with a crisp oat topping",
  "description": "A simple baked pear dessert layered with cinnamon, crystallized ginger, and a buttery oat topping, served with vanilla ice cream.",
  "meal_type": "dessert",
  "cuisine": "American",
