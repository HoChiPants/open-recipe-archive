  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F (180°C). Oil the cake tin and line the base with baking paper."
    },
    {
      "step": 2,
      "text": "Whisk the light brown soft sugar, vegetable or sunflower oil, and eggs until smooth."
    },
    {
      "step": 3,
      "text": "Fold in the self-raising flour, baking powder, and shelled pistachios ground. Stir in the grated courgette and the zest and juice of the limes."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared tin and bake until risen and a skewer inserted in the center comes out clean, about 50 minutes.",
      "timer_minutes": 50
    },
    {
      "step": 5,
      "text": "Cool the cake completely in the tin, then remove it and place it on a serving plate."
    },
    {
      "step": 6,
      "text": "Beat the soft cheese, icing sugar, and the zest and juice of the lime until smooth. Spread over the cooled cake and finish with the shelled pistachios roughly chopped."
    }
  ],
