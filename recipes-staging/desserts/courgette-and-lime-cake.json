  "id": "courgette-and-lime-cake",
  "name": "Courgette and Lime Cake",
  "subtitle": "A moist citrus cake with pistachios and soft-cheese icing",
  "description": "Grated courgette, lime, and pistachios give this simple cake a fresh, nutty crumb, finished with lime icing and chopped pistachios.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
