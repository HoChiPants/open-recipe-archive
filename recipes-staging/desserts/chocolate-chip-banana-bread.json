  "id": "chocolate-chip-banana-bread",
  "name": "Chocolate Chip Banana Bread",
  "subtitle": "A tender loaf with mashed banana and chocolate chips",
  "description": "A simple banana loaf combining buttery batter, ripe bananas, and chocolate chips, baked until cooked through.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-softened",
      "item": "unsalted butter softened",
      "quantity": 140,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 140,
      "unit": "g"
    },
    {
      "ingredient_id": "eggs-beaten",
      "item": "eggs beaten",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 140,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ripe-bananas-peeled-and-mashed",
      "item": "ripe bananas peeled and mashed",
      "quantity": 3
    },
    {
      "ingredient_id": "chocolate-chips",
      "item": "chocolate chips",
      "quantity": 100,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease a loaf tin with extra butter."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter and sugar until combined. Beat in the eggs and vanilla extract."
    },
    {
      "step": 3,
      "text": "Fold in the flour, baking powder, mashed bananas, and chocolate chips until just combined."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared tin and let it rest briefly."
    },
    {
      "step": 5,
      "text": "Bake for 50 minutes, or until cooked through.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Cool in the tin for 10 minutes, then cut into slices.",
      "timer_minutes": 10
    }
  ],
