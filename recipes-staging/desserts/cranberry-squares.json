  "id": "cranberry-squares",
  "name": "Cranberry Squares",
  "subtitle": "Buttery crumb bars with a tart cranberry center",
  "description": "A simple layered dessert with a tender crumb crust, cranberry filling, and golden baked topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter-or-margarine",
      "item": "butter or margarine",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "cranberry-sauce",
      "item": "cranberry sauce",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the flour, sugar, baking powder, and salt together. Cut in the butter or margarine until the mixture forms coarse crumbs."
    },
    {
      "step": 3,
      "text": "Set aside part of the crumb mixture. Stir the beaten egg into the remainder until combined."
    },
    {
      "step": 4,
      "text": "Press the egg-enriched mixture into the bottom of a baking pan, then spread the cranberry sauce evenly over it."
    },
    {
      "step": 5,
      "text": "Scatter the reserved crumbs over the cranberry layer and bake for 40 minutes, until golden brown and the center is fully set to 160°F.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Cool before cutting into squares."
    }
  ],
