  "id": "banana-oat-muffins-d3092853",
  "name": "Banana Oat Muffins",
  "subtitle": "Soft oat muffins with flexible fruit and topping options",
  "description": "A simple batch of banana-oat muffins finished with fruit and a choice of creamy or nutty toppings.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "porridge-oats",
      "item": "porridge oats",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "ripe-bananas",
      "item": "ripe bananas",
      "quantity": 2
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "milled-seeds-such-as-flaxseed-or-chia-seeds",
      "item": "milled seeds (such as flaxseed or chia seeds)",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "dates",
      "item": "dates",
      "quantity": 2,
      "preparation": "pitted"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": "50-100",
      "unit": "ml"
    },
    {
      "ingredient_id": "blueberries-raspberries",
      "item": "blueberries raspberries",
      "preparation": "sliced dates, or chopped nuts"
    },
    {
      "ingredient_id": "nut-butter-greek-style-yogurt",
      "item": "nut butter Greek-style yogurt",
      "preparation": "maple syrup, to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a 12-cup muffin tin."
    },
    {
      "step": 2,
      "text": "Mash the bananas and combine them with the oats, eggs, milled seeds, pitted dates, and baking powder."
    },
    {
      "step": 3,
      "text": "Stir in enough milk to make a thick, scoopable batter, then fold in the blueberries raspberries with the listed preparation."
    },
    {
      "step": 4,
      "text": "Divide the batter among the muffin cups and bake for 20 minutes, until the centers are fully set; if checked with a thermometer, they should reach 160°F.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Let the muffins cool in the tin for 15 minutes, then transfer them to a rack to finish cooling.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Prepare the nut butter Greek-style yogurt topping with maple syrup as listed, freeze it until firm, and serve with the muffins."
    }
  ],
