  "id": "blueberry-cream-cheese-pie",
  "name": "Blueberry Cream Cheese Pie",
  "subtitle": "A chilled pie with a buttery pecan crust and bright blueberry topping.",
  "description": "Bake a simple pecan crust, layer it with a smooth lemon cream cheese filling, and finish with cooked blueberries before chilling until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40,
    "inactive_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
