  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a cake pan."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, sugar, cocoa powder, baking soda, salt, and baking powder. Add the oil, eggs, and buttermilk; mix until combined."
    },
    {
      "step": 3,
      "text": "Stir the instant coffee powder into the hot water, then add it to the batter. Whisk for 2 minutes, until smooth.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared pan."
    },
    {
      "step": 5,
      "text": "Bake for 35 minutes, until the center is fully set.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Cool the cake in the pan for 10 minutes before serving.",
      "timer_minutes": 10
    }
