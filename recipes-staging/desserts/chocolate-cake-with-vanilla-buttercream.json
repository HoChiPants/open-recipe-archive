  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease the cake tins with oil; line the bases if needed."
    },
    {
      "step": 2,
      "text": "Whisk the flour, cocoa powder, baking powder, bicarbonate of soda, and brown sugar in a large bowl."
    },
    {
      "step": 3,
      "text": "Mix the milk with the vinegar, cooled coffee, vanilla, and eggs. Add this mixture to the dry ingredients with the oil, then whisk until smooth."
    },
    {
      "step": 4,
      "text": "Divide the batter between the prepared tins and bake until risen and fully set, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Leave the cakes in the tins for 5 minutes, then turn them out and cool completely.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "For the buttercream, whisk the room-temperature butter until smooth. Gradually beat in the icing sugar, then add the vanilla and enough milk to make a smooth, spreadable frosting."
    },
    {
      "step": 7,
      "text": "Tint portions of the buttercream with food colouring pastes if desired, then use the frosting to fill, stack, and cover the cooled cakes."
    },
    {
      "step": 8,
      "text": "Finish with the edible flowers, pastel sugared almonds, or chocolate eggs."
    }
  ],
