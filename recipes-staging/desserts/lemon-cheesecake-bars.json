  "id": "lemon-cheesecake-bars",
  "name": "Lemon Cheesecake Bars",
  "subtitle": "Tangy lemon filling over a tender crumb crust",
  "description": "Bake a creamy lemon cheesecake layer over a buttery shortbread crust, then chill and finish with confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40,
    "inactive_minutes": 165
  },
  "ingredients": [
    {
      "ingredient_id": "shortbread-cookie-crumbs",
      "item": "shortbread cookie crumbs",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cold-butter",
      "item": "cold butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 4,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Line a baking pan with parchment."
    },
    {
      "step": 2,
      "text": "Prepare the baking powder by whisking it into the 4 tablespoons of flour."
    },
    {
      "step": 3,
      "text": "Combine the shortbread crumbs, 1 cup flour, brown sugar, white sugar, and confectioners' sugar. Cut in the cold butter until the mixture forms coarse crumbs, then press it evenly into the pan."
    },
    {
      "step": 4,
      "text": "Bake the crust for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Beat the softened cream cheese with the sugars until smooth. Add the eggs and 4 tablespoons flour, then mix until combined."
    },
    {
      "step": 6,
      "text": "Blend in the lemon juice, lemon zest, and prepared baking powder mixture. Pour the filling over the warm crust."
    },
    {
      "step": 7,
      "text": "Bake for 28 minutes, until the center is fully set or reaches 160°F on a food thermometer.",
      "timer_minutes": 28
    },
    {
      "step": 8,
      "text": "Cool at room temperature for 45 minutes, then chill for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 9,
      "text": "Finish with confectioners' sugar before serving."
    }
  ],
