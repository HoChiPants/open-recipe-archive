  "instructions": [
    {
      "step": 1,
      "text": "Cut the prunes into pieces and combine them with the vodka. Set aside while preparing the batter."
    },
    {
      "step": 2,
      "text": "Preheat the oven and oil the cake tin."
    },
    {
      "step": 3,
      "text": "Whisk two eggs with 160 g caster sugar, the vanilla extract, Greek yogurt, and oil. Mix the flour, cocoa, bicarbonate of soda, and baking powder separately, then add them to the wet mixture with the coffee. Stir until smooth."
    },
    {
      "step": 4,
      "text": "Spread the chocolate batter in the prepared tin and bake for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Whisk the remaining eggs with the remaining caster sugar and vanilla extract. Beat in the curd cheese and potato flour until smooth, then fold in the prunes."
    },
    {
      "step": 6,
      "text": "Spread the curd cheese mixture over the baked base and bake for 60 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Cool the cheesecake completely before topping."
    },
    {
      "step": 8,
      "text": "Whisk together the double cream, dark chocolate, and butter over gentle heat until smooth. Preheat the mixture as needed to melt the chocolate without boiling."
    },
    {
      "step": 9,
      "text": "Add the curd cheese to the smooth chocolate mixture and spread the topping over the cooled cheesecake."
    },
    {
      "step": 10,
      "text": "Cut the pistachios and scatter them over the top before serving."
    }
  ],
