  "instructions": [
    {
      "step": 1,
      "text": "Stir the marmalade and vodka together. Toss the cake pieces with the citrus juice and layer them in a large trifle dish with the chopped canned fruit and fresh orange."
    },
    {
      "step": 2,
      "text": "Warm the custard with the milk chocolate over low heat, stirring until smooth. Spoon it over the cake and fruit, then chill until set."
    },
    {
      "step": 3,
      "text": "Melt the dark chocolate gently and let it cool slightly. Whisk the egg yolks with the tablespoon of sugar, then stir in the yogurt and melted chocolate."
    },
    {
      "step": 4,
      "text": "Whisk the egg whites to stiff peaks. For safety, heat the egg mixture gently while stirring until it reaches 160°F, then cool briefly before folding in the whites."
    },
    {
      "step": 5,
      "text": "Whip 500ml double cream and fold it into the chocolate mixture. Spread this mousse over the custard layer and chill for 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 6,
      "text": "Whip the remaining double cream with the caster sugar until thick. Fold in the citrus zest and spoon the cream over the trifle."
    },
    {
      "step": 7,
      "text": "Finish with the reserved citrus garnish and the chocolate buttons, pared orange zest, crushed biscotti, or gold sprinkles."
    }
  ],
