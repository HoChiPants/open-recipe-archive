  "id": "chewy-brownie-cookies",
  "name": "Chewy Brownie Cookies",
  "subtitle": "Fudgy cocoa cookies with chocolate chips",
  "description": "Soft-centered chocolate cookies made with brown sugar, cocoa, and semisweet chocolate chips.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
