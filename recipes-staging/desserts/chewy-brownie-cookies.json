  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the brown sugar and shortening until blended. Add the eggs, then whisk in the water and vanilla."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the flour, cocoa powder, baking soda, and salt. Stir the dry mixture into the wet mixture until just combined."
    },
    {
      "step": 4,
      "text": "Fold in the chocolate chips. Portion the dough onto prepared baking sheets."
    },
    {
      "step": 5,
      "text": "Bake for 9 minutes, until the cookies are set.",
      "timer_minutes": 9
    },
    {
      "step": 6,
      "text": "Cool the cookies on the baking sheets for 2 minutes, then transfer them to a rack to finish cooling.",
      "timer_minutes": 2
    }
  ],
