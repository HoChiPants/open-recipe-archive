  "instructions": [
    {
      "step": 1,
      "text": "Stir the muscovado sugar and caster sugar into the hot coffee until dissolved, then mix in the Marsala. Reserve a small portion for the chocolate sauce."
    },
    {
      "step": 2,
      "text": "Whisk the mascarpone, vanilla bean paste, caster sugar, and milk until smooth."
    },
    {
      "step": 3,
      "text": "Whisk the double cream to soft peaks, then fold it into the mascarpone mixture."
    },
    {
      "step": 4,
      "text": "Dip the sponge fingers briefly in the coffee mixture and arrange a layer in a serving dish."
    },
    {
      "step": 5,
      "text": "Add mascarpone cream and blackberries, then repeat the layers as needed."
    },
    {
      "step": 6,
      "text": "Stir the chopped dark chocolate into the reserved hot coffee mixture until smooth. Spoon or drizzle the sauce over the tiramisu and dust with the cocoa powder or grated dark chocolate."
    },
    {
      "step": 7,
      "text": "Chill until set, about 3 hours, then serve.",
      "timer_minutes": 180
    }
  ],
