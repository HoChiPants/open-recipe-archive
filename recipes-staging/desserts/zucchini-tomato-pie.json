  "id": "zucchini-tomato-pie",
  "name": "Zucchini Tomato Pie",
  "subtitle": "A savory baked pie with tender vegetables and Parmesan",
  "description": "Chopped zucchini, tomato, and onion are folded with Parmesan and covered in a seasoned egg batter before baking until set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
