      "item": "ground black pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Coat a pie dish with nonstick cooking spray."
    },
    {
      "step": 2,
      "text": "Combine the zucchini, tomato, onion, and Parmesan cheese in a bowl, then place the mixture in the prepared dish."
    },
    {
      "step": 3,
      "text": "Whisk the biscuit baking mix, eggs, milk, salt, and pepper until smooth. Pour the batter over the vegetables."
    },
    {
      "step": 4,
      "text": "Bake for 30 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 30
    }
  ],
