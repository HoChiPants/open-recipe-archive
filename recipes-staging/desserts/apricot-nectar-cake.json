  "id": "apricot-nectar-cake",
  "name": "Apricot Nectar Cake",
  "subtitle": "A tender citrus-apricot cake with a simple lemon glaze",
  "description": "A bright, moist cake made with apricot nectar and finished with a tart confectioners’ sugar glaze.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
