      "item": "lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Prepare a baking pan for the cake."
    },
    {
      "step": 2,
      "text": "Whisk together the cake mix, white sugar, vegetable oil, and apricot nectar. Add the eggs and whisk until the batter is smooth."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and bake for 60 minutes, or until the center is firm and a tester comes out clean.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Cool the cake in the pan for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Stir the confectioners' sugar and lemon juice together until smooth, then spread or drizzle the glaze over the warm cake."
    }
  ],
