  "id": "sweet-cornmeal-cake",
  "name": "Sweet Cornmeal Cake",
  "subtitle": "A tender cornmeal cake with coconut milk",
  "description": "A simple baked cake combining cornmeal, coconut milk, milk, and eggs for a lightly sweet dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "cornmeal",
      "item": "cornmeal",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "coconut-milk",
      "item": "coconut milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 340°F. Prepare a cake pan with the all-purpose flour."
    },
    {
      "step": 2,
      "text": "Blend the cornmeal, white sugar, milk, coconut milk, all-purpose flour, eggs, and vegetable oil until smooth."
    },
    {
      "step": 3,
      "text": "Blend in the baking powder just until incorporated."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared pan."
    },
    {
      "step": 5,
      "text": "Bake for 40 minutes, or until the center is firm and fully set. Cool before serving.",
      "timer_minutes": 40
    }
  ],
