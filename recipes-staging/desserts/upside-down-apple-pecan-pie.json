  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine the pecans, brown sugar, and melted margarine, then spread the mixture evenly over the bottom of a 9-inch pie pan."
    },
    {
      "step": 3,
      "text": "Roll or shape half of the pastry to fit the pan over the pecan mixture."
    },
    {
      "step": 4,
      "text": "Toss the apples with the white sugar, flour, cinnamon, and nutmeg. Add the apple mixture to the pastry-lined pan."
    },
    {
      "step": 5,
      "text": "Place the remaining pastry over the apples, fold and seal the edges, and transfer the pie to the oven."
    },
    {
      "step": 6,
      "text": "Bake at 375°F until the crust is golden brown.",
      "timer_minutes": 50
    },
    {
      "step": 7,
      "text": "Cool the pie in the pan for 5 minutes, then invert it onto a serving plate.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Let the inverted pie cool completely before serving.",
      "timer_minutes": 60
    }
  ],
