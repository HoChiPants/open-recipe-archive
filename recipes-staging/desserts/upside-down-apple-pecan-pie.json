  "id": "upside-down-apple-pecan-pie",
  "name": "Upside-Down Apple Pecan Pie",
  "subtitle": "A caramelized pecan topping crowns spiced apple filling.",
  "description": "An apple pie assembled upside down with pecans and brown sugar beneath the crust, then inverted after baking.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
