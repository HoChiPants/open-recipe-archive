  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Prepare the cake pans, then combine the cake flour, baking powder, and salt."
    },
    {
      "step": 2,
      "text": "Beat the room-temperature butter with 2 cups white sugar until light. Mix in the egg yolks, milk, lemon juice, and 1 teaspoon vanilla extract."
    },
    {
      "step": 3,
      "text": "Beat the egg whites to stiff peaks, gradually adding the divided 2 cups white sugar. Fold the whites into the batter, then divide it among the prepared pans."
    },
    {
      "step": 4,
      "text": "Bake the cake layers until golden brown.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Let the layers cool in their pans for 5 minutes, then remove them and cool completely.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "For the custard, combine the all-purpose flour, cornstarch, cocoa powder, salt, and the remaining measured confectioners' sugar. Whisk in the beaten large eggs."
    },
    {
      "step": 7,
      "text": "Warm the whole milk, gradually whisk it into the egg mixture, and cook while stirring until thickened and the custard reaches 160°F or has a fully set center.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Remove the custard from the heat and stir in the chopped bittersweet chocolate, 1 tablespoon butter, and 1 tablespoon vanilla extract. Transfer to a bowl and cool until set."
    },
    {
      "step": 9,
      "text": "Beat the softened butter with the sifted confectioners' sugar and cocoa powder. Add 1 teaspoon vanilla extract and hot water, beating until smooth."
    },
    {
      "step": 10,
      "text": "Place one cake layer on a serving surface and spread with custard. Repeat the cake-and-custard layers, finishing with a cake layer. Chill until firm.",
      "timer_minutes": 30
    },
    {
      "step": 11,
      "text": "For the ganache, place the semisweet chocolate chips in a bowl. Bring the heavy whipping cream to a boil, pour it over the chocolate, and whisk for 3 minutes until smooth. Stir in 2 teaspoons vanilla extract and cool until set.",
      "timer_minutes": 3
    },
    {
      "step": 12,
      "text": "Cover the chilled cake with the cocoa frosting, then spread or pour the ganache over it. Chill until firm, cut into portions, and serve.",
      "timer_minutes": 30
    }
  ],
