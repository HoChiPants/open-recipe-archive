    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "9-inch-prepared-graham-cracker-crust",
      "item": "(9 inch) prepared graham cracker crust",
      "quantity": 1
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "frozen-whipped-topping",
      "item": "frozen whipped topping",
      "quantity": 2,
      "unit": "cups",
      "preparation": "thawed"
    },
    {
      "ingredient_id": "cherry-pie-filling",
      "item": "cherry pie filling",
      "quantity": 1,
      "unit": "can",
      "preparation": "21 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened cream cheese and sugar until smooth."
    },
    {
      "step": 2,
      "text": "Fold in the thawed whipped topping until the mixture is smooth."
    },
    {
      "step": 3,
      "text": "Spread the cream cheese mixture into the prepared crust, then spoon the cherry pie filling over the top."
    },
    {
      "step": 4,
      "text": "Cover and chill for 2 hours before serving.",
      "timer_minutes": 120
    }
