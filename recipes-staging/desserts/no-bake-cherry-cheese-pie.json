  "id": "no-bake-cherry-cheese-pie",
  "name": "No-Bake Cherry Cheese Pie",
  "subtitle": "A chilled, creamy pie with cherry topping",
  "description": "A simple no-bake dessert combining sweetened cream cheese and whipped topping in a graham cracker crust, finished with cherry pie filling.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
