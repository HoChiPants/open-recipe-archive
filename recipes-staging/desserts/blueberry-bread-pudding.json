  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "For the sauce, melt the 0.5 cup white sugar with the 3 tablespoons butter over medium heat for 4 minutes. Whisk in the heavy whipping cream and cook for about 10 minutes, until thickened; transfer and let it stand.",
      "timer_minutes": 14
    },
    {
      "step": 3,
      "text": "Beat the 0.75 cup white sugar with the softened butter until smooth. Add the eggs and vanilla extract, then whisk for 3 minutes. Stir in the milk until combined.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Pour the custard over the sourdough bread cubes and let them absorb it for 5 minutes. Fold in the blueberries and transfer the mixture to a baking dish.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Combine the 2 tablespoons white sugar with the cinnamon and sprinkle over the pudding."
    },
    {
      "step": 6,
      "text": "Bake for 35 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Serve warm with the cream sauce."
    }
  ],
