  "id": "blueberry-bread-pudding",
  "name": "Blueberry Bread Pudding",
  "subtitle": "Tender bread pudding with berries and warm cream sauce",
  "description": "Sourdough cubes soak up a buttery custard, bake with fresh blueberries, and finish with cinnamon sugar and a simple cream sauce.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
