  "id": "cinnamon-custard-pie",
  "name": "Cinnamon Custard Pie",
  "subtitle": "Silky vanilla custard in crisp cinnamon pastry",
  "description": "A creamy baked custard pie layered with flaky puff pastry and warm cinnamon sugar.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "egg-yolks-freeze-the-whites-for-another-recipe",
      "item": "egg yolks (freeze the whites for another recipe)",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "custard-powder",
      "item": "custard powder",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "single-cream",
      "item": "single cream",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "vanilla-paste",
      "item": "vanilla paste",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ready-rolled-puff-pastry",
      "item": "ready-rolled puff pastry",
      "quantity": 320,
      "unit": "g"
    },
    {
      "ingredient_id": "unsalted-butter-melted",
      "item": "unsalted butter melted",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "sugar",
      "item": "granulated sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the egg yolks, caster sugar, custard powder, whole milk, and granulated sugar until smooth."
    },
    {
      "step": 2,
      "text": "Warm the single cream in a saucepan until steaming, then gradually whisk it into the yolk mixture. Return the mixture to the pan and cook over medium-low heat, stirring, until thick enough to coat a spoon."
    },
    {
      "step": 3,
      "text": "Stir in the vanilla paste and set the custard aside to cool until just warm."
    },
    {
      "step": 4,
      "text": "Preheat the oven. Fit the ready-rolled puff pastry into a pie dish, trimming or folding the edges as needed."
    },
    {
      "step": 5,
      "text": "Brush the pastry with the unsalted butter melted. Mix the granulated sugar and ground cinnamon, then sprinkle the mixture over the pastry."
    },
    {
      "step": 6,
      "text": "Pour in the custard and bake until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Cool the pie for 5 minutes before slicing.",
      "timer_minutes": 5
    }
  ],
