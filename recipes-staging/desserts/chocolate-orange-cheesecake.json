{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-orange-cheesecake",
  "name": "Chocolate Orange Cheesecake",
  "subtitle": "A rich baked cheesecake with citrus zest and chocolate.",
  "description": "A chocolate biscuit cheesecake flavored with orange zest, orange liqueur, and grated chocolate, finished with a lightly browned top.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "dark-chocolate-digestive-biscuits",
      "item": "dark chocolate digestive biscuits",
      "quantity": 200,
      "unit": "g",
      "preparation": "roughly broken"
    },
    {
      "ingredient_id": "butter-melted",
      "item": "butter melted",
      "quantity": 75,
      "unit": "g",
      "preparation": "plus extra for greasing"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "x-280g-tubs-full-fat-cream-cheese",
      "item": "x 280g tubs full-fat cream cheese",
      "quantity": 2
    },
    {
      "ingredient_id": "tub-double-cream",
      "item": "tub double cream",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 140,
      "unit": "g"
    },
    {
      "ingredient_id": "finely-grated-zest-1-5-oranges",
      "item": "finely grated zest 1.5 oranges"
    },
    {
      "ingredient_id": "orange-liqueur",
      "item": "orange liqueur",
      "quantity": 4,
      "unit": "tbsp",
      "preparation": "such as Cointreau"
    },
    {
      "ingredient_id": "orange-milk-chocolate-grated",
      "item": "orange milk chocolate grated",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "almond-milk-chocolate-grated",
      "item": "almond milk chocolate grated",
      "quantity": 50,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grease a springform cake tin with the extra butter. Combine the roughly broken biscuits with the melted butter, then press the mixture firmly over the base. Chill until set.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Preheat the oven to 325°F. Beat the eggs and egg yolks together. In a separate bowl, whisk the cream cheese, double cream, sugar, orange zest, orange liqueur, and orange milk chocolate until smooth, then mix in the beaten eggs."
    },
    {
      "step": 3,
      "text": "Pour the filling over the chilled biscuit base and bake until the cheesecake is lightly browned, the center is fully set, and an inserted thermometer reads 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Scatter the biscuit pieces, orange zest, orange milk chocolate, and almond milk chocolate over the warm cheesecake. Cool in the tin for 15 minutes, then cool completely for about 60 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Chill the cheesecake until firm, then remove it from the tin and cut into slices to serve."
    }
  ],
