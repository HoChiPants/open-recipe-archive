  "instructions": [
    {
      "step": 1,
      "text": "Add the sour cream, warm water, softened butter, beaten egg, 3 1/2 cups flour, 3 1/2 tablespoons sugar, salt, and yeast to the bread machine. Run the dough cycle, adding more flour if the dough remains excessively sticky.",
      "timer_minutes": 90
    },
    {
      "step": 2,
      "text": "Let the dough rest until doubled in size, about 90 minutes if the machine cycle does not include the full rise.",
      "timer_minutes": 90
    },
    {
      "step": 3,
      "text": "Mix the 1/4 cup sugar, 2 1/2 tablespoons melted butter, and cinnamon into a spreadable filling. Stir in the chopped pecans."
    },
    {
      "step": 4,
      "text": "Turn the dough onto a lightly floured surface and roll it into a long rectangle. Spread with the filling, roll up lengthwise, and join the ends to form a ring. Place on a greased baking sheet and let rise until puffy.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 6,
      "text": "Bake until golden brown and the center is fully set, reaching 160°F, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Cool the cake on the baking sheet for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Whisk the confectioners' sugar, 1 1/2 tablespoons melted butter, vanilla, warm water, and milk until smooth, adding liquid as needed. Drizzle over the cooled cake and sprinkle with the purple, green, and yellow sugars."
    }
  ],
