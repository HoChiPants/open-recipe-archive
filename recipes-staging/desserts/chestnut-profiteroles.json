  "instructions": [
    {
      "step": 1,
      "text": "Mix the chestnut purée with the brandy or chestnut liqueur and the optional chestnut syrup or liqueur. Chill until needed."
    },
    {
      "step": 2,
      "text": "Whisk 300 ml double cream with the vanilla extract and icing sugar until thick enough to hold its shape. Chill."
    },
    {
      "step": 3,
      "text": "Melt 85 g unsalted butter, whisk in the flour, and cook until the mixture is smooth and pulls away from the pan. Transfer to a bowl and let cool briefly."
    },
    {
      "step": 4,
      "text": "Preheat the oven and prepare a baking sheet. Whisk in the eggs gradually until the dough is smooth, then shape it into small mounds on the sheet."
    },
    {
      "step": 5,
      "text": "Bake until puffed and set, about 35 minutes. Cool completely.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Warm 100 ml double cream with the optional chestnut syrup or liqueur. Add 25 g unsalted butter and the chopped or grated dark chocolate, stirring for 10 minutes until smooth and thickened.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Cut the cooled puffs open, fill them with the chestnut mixture and whipped cream, then replace the tops. Spoon over the chocolate glaze and finish with the chopped candied chestnuts and remaining chocolate."
    }
  ],
