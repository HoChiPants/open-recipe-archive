  "id": "chestnut-profiteroles",
  "name": "Chestnut Profiteroles",
  "subtitle": "Choux pastries with chestnut cream and chocolate glaze",
  "description": "Light baked choux puffs filled with chestnut cream, candied chestnuts, and a warm dark-chocolate topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
