  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-caramel-terrine",
  "name": "Chocolate Caramel Terrine",
  "subtitle": "A frozen layered dessert with dark chocolate, mascarpone, and caramel.",
  "description": "Build this rich terrine in layers with chocolate mascarpone cream, caramel, and caramel wafers, then freeze until firm for clean slices.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "sunflower-oil-for-the-tin",
      "item": "sunflower oil for the tin"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "cocoa-powder-plus-extra-for-dusting",
      "item": "cocoa powder plus extra for dusting",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "caramel-from-a-jar-or-can",
      "item": "caramel from a jar or can",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-chocolate-finely-chopped",
      "item": "dark chocolate finely chopped",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "mascarpone",
      "item": "mascarpone",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "caramel-wafers-depending-on-the-tin-size",
      "item": "caramel wafers (depending on the tin size)",
      "quantity": "7-8",
      "preparation": "cut in half lengthways"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly oil the tin. Arrange the caramel wafers around the sides and base as needed, keeping the cut halves intact."
    },
    {
      "step": 2,
      "text": "Warm the double cream, cocoa powder, and caramel gently in a saucepan until hot and combined."
    },
    {
      "step": 3,
      "text": "Add the finely chopped dark chocolate. Whisk, then stir for 1 minute until melted and smooth.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Cool the chocolate mixture for 10 minutes, then whisk in the mascarpone for 4 minutes until smooth.",
      "timer_minutes": 14
    },
    {
      "step": 5,
      "text": "Whisk the remaining caramel with the caramel wafers as needed to make the filling layer."
    },
    {
      "step": 6,
      "text": "Spread a layer of chocolate mixture in the tin, add caramel and wafer layers, and finish with the remaining chocolate mixture."
    },
    {
      "step": 7,
      "text": "Freeze until firm, about 6 hours.",
      "timer_minutes": 360
    },
    {
      "step": 8,
      "text": "Let stand for 10 minutes, remove from the tin, and dust with cocoa powder before serving.",
      "timer_minutes": 10
    }
  ],
