  "id": "coconut-creams-with-mango-and-lime",
  "name": "Coconut Creams with Mango and Lime",
  "subtitle": "Soft coconut custards with bright citrus and fresh mango",
  "description": "A softly set coconut dessert served with tangy lime and slices of ripe mango.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "coconut-cream",
      "item": "coconut cream",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "lime-juiced",
      "item": "lime juiced",
      "quantity": "1/2",
      "preparation": "plus 4 broad strips of zest and some fine strips, to serve (optional)",
      "optional": true
    },
    {
      "ingredient_id": "fresh-coconut-chopped-then-crushed-using-a-pestle-and-mortar",
      "item": "fresh coconut chopped then crushed using a pestle and mortar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "gelatine-leaves-about-3g-for-a-soft-set",
      "item": "gelatine leaves (about 3g) for a soft set",
      "quantity": 2,
      "unit": "small",
      "preparation": "or 3 leaves if you prefer a firmer texture"
    },
    {
      "ingredient_id": "just-ripe-mango",
      "item": "just-ripe mango",
      "quantity": 1
    },
    {
      "ingredient_id": "limes-juiced",
      "item": "limes juiced",
      "quantity": 3
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Soak the gelatine leaves in cold water for 10 minutes, until pliable.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Warm the coconut cream, double cream, caster sugar, lime zest, and crushed fresh coconut in a saucepan. Heat gently for about 20 minutes without boiling.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Remove the pan from the heat. Squeeze excess water from the gelatine, add it to the hot cream mixture, and stir until dissolved."
    },
    {
      "step": 4,
      "text": "Stir in the juice from the half lime, then strain the mixture into four serving molds or glasses."
    },
    {
      "step": 5,
      "text": "Cool, cover, and chill until softly set, about 6 hours.",
      "timer_minutes": 360
    },
    {
      "step": 6,
      "text": "Peel and cut the mango. Serve the coconut creams with the mango, lime juice, and optional lime zest strips."
    }
  ],
