{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "vegan-meringues",
  "name": "Vegan Meringues",
  "subtitle": "Light, crisp treats made with whipped chickpea liquid",
  "description": "These simple egg-free meringues bake slowly until firm, then cool to a delicate crisp texture.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 90,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "chickpeas-garbanzo-beans",
      "item": "chickpeas (garbanzo beans)",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, undrained"
    },
    {
      "ingredient_id": "cream-of-tartar",
      "item": "cream of tartar",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 210°F and prepare baking sheets for the meringues."
    },
    {
      "step": 2,
      "text": "Drain the chickpeas, reserving the liquid. Use the liquid for the meringue mixture."
    },
    {
      "step": 3,
      "text": "Whisk the reserved chickpea liquid with the cream of tartar until foamy, then continue whisking to soft peaks."
    },
    {
      "step": 4,
      "text": "Add the white sugar and vanilla extract, and whisk until the mixture is smooth and holds its shape."
    },
    {
      "step": 5,
      "text": "Shape the mixture into about 25 meringues on the prepared baking sheets, taking up to 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Bake at 210°F until the meringues are firm.",
      "timer_minutes": 90
    },
    {
      "step": 7,
      "text": "Cool the meringues on the baking sheets for 15 minutes before serving.",
      "timer_minutes": 15
    }
  ],
  "tags": [
    "dessert",
    "american",
    "vegan",
    "egg-free"
  ],
  "seasons": [
    "year-round"
  ],
