  "instructions": [
    {
      "step": 1,
      "text": "Soak the sultanas in 2 tablespoons of dark rum for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Melt the butter. Split the brioche rolls lengthwise and brush the cut sides with the melted butter."
    },
    {
      "step": 3,
      "text": "Preheat the oven and prepare a baking dish."
    },
    {
      "step": 4,
      "text": "Whisk the milk, 200 ml double cream, vanilla, and eggs with 4 tablespoons of sugar until smooth."
    },
    {
      "step": 5,
      "text": "Arrange the brioche in the dish, scattering the rum-soaked sultanas between the pieces. Pour over the custard and let the bread absorb it briefly."
    },
    {
      "step": 6,
      "text": "Bake until puffed, golden, and fully set in the center; confirm with a thermometer that the egg mixture reaches 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Let the pudding cool for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Warm the remaining 3 tablespoons of sugar with the remaining 2 tablespoons of dark rum and the cream mixture to make a smooth sauce. Serve over the pudding with extra cream if desired."
    }
  ],
