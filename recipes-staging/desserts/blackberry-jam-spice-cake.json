  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare the baking pan or pans."
    },
    {
      "step": 2,
      "text": "Cream the 2 cups white sugar with the softened 1 cup butter until smooth. Add the eggs one at a time, mixing after each addition."
    },
    {
      "step": 3,
      "text": "Stir the baking soda into the water, then add it to the batter along with the blackberry jam."
    },
    {
      "step": 4,
      "text": "Whisk together the flour, cinnamon, nutmeg, cloves, and salt. Add this mixture to the batter alternately with the buttermilk, stirring just until combined."
    },
    {
      "step": 5,
      "text": "Fold in the chopped black walnuts and golden raisins. Spread the batter evenly in the prepared pan or pans."
    },
    {
      "step": 6,
      "text": "Bake until the cake is set and a tester inserted in the center comes out clean.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Cool the cake completely. Whisk the 1/2 cup butter for 2 minutes, then add the dulce de leche and confectioners sugar; beat until smooth.",
      "timer_minutes": 2
    },
    {
      "step": 8,
      "text": "Spread the frosting over the cooled cake, layer or stack the cake if using multiple layers, and serve."
    }
  ],
