  "id": "chewy-chocolate-cookies",
  "name": "Chewy Chocolate Cookies",
  "subtitle": "Soft-centered cocoa cookies with chocolate chips",
  "description": "Tender chocolate cookies with crisp edges, a chewy center, and semisweet chips throughout.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1.25,
      "unit": "cups",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and line baking sheets with parchment."
    },
    {
      "step": 2,
      "text": "Whisk the sugar and softened butter until smooth. Add the eggs and vanilla, then whisk until blended."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the flour, cocoa powder, baking soda, and salt."
    },
    {
      "step": 4,
      "text": "Gradually stir the dry mixture into the butter mixture until a dough forms. Fold in the chocolate chips."
    },
    {
      "step": 5,
      "text": "Portion the dough onto the prepared baking sheets, leaving space between cookies."
    },
    {
      "step": 6,
      "text": "Bake until the cookies are set around the edges and still soft in the centers.",
      "timer_minutes": 9
    },
    {
      "step": 7,
      "text": "Cool the cookies briefly on the baking sheets, then transfer them to a rack to cool completely."
    }
  ],
