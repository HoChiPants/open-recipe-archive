{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cheesy-potato-and-leek-pie",
  "name": "Cheesy Potato and Leek Pie",
  "subtitle": "A creamy layered pie with tender potatoes, leeks, and Cheshire cheese.",
  "description": "Thinly sliced potatoes and leeks are combined with cream and grated cheese, then baked until tender and richly set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 80
  },
  "ingredients": [
    {
      "ingredient_id": "potatoes-about-450g",
      "item": "potatoes (about 450g)",
      "quantity": 3,
      "unit": "medium",
      "preparation": "peeled and thinly sliced"
    },
    {
      "ingredient_id": "butter-for-the-dish",
      "item": "butter for the dish"
    },
    {
      "ingredient_id": "garlic-clove-crushed",
      "item": "garlic clove crushed",
      "quantity": 1
    },
    {
      "ingredient_id": "leeks-about-200g",
      "item": "leeks (about 200g)",
      "quantity": 2,
      "preparation": "trimmed, halved and sliced"
    },
    {
      "ingredient_id": "cheshire-cheese-we-used-hs-bourne",
      "item": "Cheshire cheese (we used HS Bourne)",
      "quantity": 350,
      "unit": "g",
      "preparation": "grated"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 500,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking dish by rubbing it with the butter and crushed garlic."
    },
    {
      "step": 2,
      "text": "Simmer the sliced potatoes for 3 minutes, then drain and let them cool.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Whisk together the leeks, grated Cheshire cheese, and double cream."
    },
    {
      "step": 4,
      "text": "Arrange the cooled potatoes in the prepared dish and pour the leek, cheese, and cream mixture over them."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes. Add the potatoes as needed to complete the dish, then bake for 20 minutes more, until cooked through.",
      "timer_minutes": 80
    },
    {
      "step": 6,
      "text": "Let the pie stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
