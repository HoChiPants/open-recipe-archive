  "id": "lemon-sponge-pie",
  "name": "Lemon Sponge Pie",
  "subtitle": "A light lemon custard pie with a tender sponge-like top.",
  "description": "A bright lemon filling is folded with whipped egg whites and baked in an unbaked crust until puffed and fully set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "9-inch-unbaked-pie-crust",
      "item": "(9 inch) unbaked pie crust",
      "quantity": 1
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 4,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "grated-lemon-zest",
      "item": "grated lemon zest",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.33333298563957,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 4
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter and white sugar until blended. Add the beaten egg yolks, flour, salt, milk, lemon zest, and lemon juice; whisk until smooth."
    },
    {
      "step": 3,
      "text": "Whisk the egg whites with the remaining white sugar until they form a light, stable foam. Fold the whites into the lemon mixture until just combined."
    },
    {
      "step": 4,
      "text": "Pour the filling into the unbaked pie crust."
    },
    {
      "step": 5,
      "text": "Bake at 375°F for 15 minutes, then reduce the oven to 300°F and bake for 45 minutes more. The center should be firm and fully set, reaching 160°F.",
      "timer_minutes": 60
    }
  ],
