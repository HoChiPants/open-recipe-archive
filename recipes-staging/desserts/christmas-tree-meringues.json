{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "christmas-tree-meringues",
  "name": "Christmas Tree Meringues",
  "subtitle": "Crisp green meringue treats for holiday tables",
  "description": "Pipe sweet green meringue into tree shapes, decorate as desired, and dry until firm for a light festive dessert.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 4
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "green-food-colouring",
      "item": "green food colouring"
    },
    {
      "ingredient_id": "edible-stars-and-hundreds-and-thousands-optional",
      "item": "edible stars and hundreds and thousands (optional)",
      "unit": "small",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking tray for the meringues."
    },
    {
      "step": 2,
      "text": "Whisk the egg whites with the white wine vinegar until soft peaks form."
    },
    {
      "step": 3,
      "text": "Gradually add the caster sugar and whisk until the mixture is thick. Whisk in the cornflour, remaining white wine vinegar, and green food colouring."
    },
    {
      "step": 4,
      "text": "Pipe or shape the mixture into eight tree forms on the prepared tray."
    },
    {
      "step": 5,
      "text": "Add the edible stars and hundreds and thousands (optional)."
    },
    {
      "step": 6,
      "text": "Bake for 60 minutes, until the meringues are firm and fully set; for egg safety, verify that the center reaches 160°F with a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Allow the meringues to cool before serving."
    }
  ],
