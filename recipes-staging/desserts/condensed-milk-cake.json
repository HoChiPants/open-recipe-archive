{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "condensed-milk-cake",
  "name": "Condensed Milk Cake",
  "subtitle": "A tender baked cake with a lightly sweet finish",
  "description": "A simple American dessert made with sweetened condensed milk, eggs, butter, and flour, finished with confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "confectioners-sugar-for-dusting",
      "item": "confectioners' sugar for dusting",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grease and prepare a cake pan. Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk 1 cup flour with the baking powder in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the condensed milk, eggs, and melted butter."
    },
    {
      "step": 4,
      "text": "Add the wet mixture to the flour mixture, then whisk in the remaining 3 tablespoons flour until smooth."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake until the cake is set and lightly browned, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Cool in the pan for 5 minutes, then cool further before serving.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Dust with the confectioners' sugar."
    }
  ],
