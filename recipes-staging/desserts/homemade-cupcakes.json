  "id": "homemade-cupcakes",
  "name": "Homemade Cupcakes",
  "subtitle": "Tender vanilla cupcakes for a crowd",
  "description": "A simple vanilla cupcake batter baked in individual portions.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
