  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Prepare a 24-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Combine the sifted flour, sugar, baking powder, and salt."
    },
    {
      "step": 3,
      "text": "Whisk the eggs for 2 minutes. Whisk in the milk, vegetable oil, and vanilla extract.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the liquids and fold until evenly combined."
    },
    {
      "step": 5,
      "text": "Divide the batter among the prepared muffin cups and bake until the cupcakes are set, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Transfer the cupcakes and let them cool for 5 minutes.",
      "timer_minutes": 5
    }
  ],
