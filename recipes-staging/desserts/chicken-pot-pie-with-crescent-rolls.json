  "id": "chicken-pot-pie-with-crescent-rolls",
  "name": "Chicken Pot Pie with Crescent Rolls",
  "subtitle": "Creamy chicken and vegetables under a golden pastry topping",
  "description": "A simple baked casserole combining chicken, vegetables, potatoes, and creamy soups beneath crescent rolls.",
  "meal_type": "dessert",
