  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Arrange one package of crescent rolls in the bottom of a baking dish, pressing seams together."
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet. Add the frozen vegetables and potatoes, and cook for 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Combine the cream of chicken soup, cream of mushroom soup, and milk; stir for 3 minutes until smooth.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the soup mixture and both portions of cooked chicken to the skillet. Stir to combine, season with salt and pepper, and transfer the filling to the prepared dish."
    },
    {
      "step": 5,
      "text": "Cover the filling with the remaining crescent rolls and bake for 50 minutes, until golden brown and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 50
    }
  ],
