  "id": "oatmeal-chocolate-coconut-macaroons",
  "name": "Oatmeal Chocolate Coconut Macaroons",
  "subtitle": "Chewy oat cookies with cocoa and coconut",
  "description": "A simple no-bake treat made by combining cocoa oats and coconut with a warm butter-and-milk syrup, then cooling the portions until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "quick-cooking-oats",
      "item": "quick-cooking oats",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "coconut",
      "item": "coconut",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the oats, shredded coconut, and cocoa powder together in a large bowl."
    },
    {
      "step": 2,
      "text": "Warm the sugar, butter, and milk in a saucepan, stirring until the mixture reaches a simmer and the butter is melted.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pour the hot mixture over the dry ingredients and stir until evenly coated."
    },
    {
      "step": 4,
      "text": "Spoon the mixture into 15 portions on a prepared tray and let cool until firm."
    }
  ],
