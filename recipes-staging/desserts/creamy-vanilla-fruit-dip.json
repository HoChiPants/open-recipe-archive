  "id": "creamy-vanilla-fruit-dip",
  "name": "Creamy Vanilla Fruit Dip",
  "subtitle": "A chilled, fluffy dip for fresh fruit",
  "description": "Whisked cream cheese and confectioners' sugar become a smooth vanilla dip folded with whipped topping and chilled until ready to serve.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
