    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "12-ounce-container-frozen-whipped-topping",
      "item": "(12 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened cream cheese and confectioners' sugar in a bowl until combined."
    },
    {
      "step": 2,
      "text": "Stir in the vanilla extract."
    },
    {
      "step": 3,
      "text": "Fold in the thawed frozen whipped topping until evenly incorporated."
    },
    {
      "step": 4,
      "text": "Cover and chill for 60 minutes before serving.",
