  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking pan for the squares."
    },
    {
      "step": 2,
      "text": "Combine the flour, rolled oats, 0.5 cup packed brown sugar, and 0.5 cup butter until crumbly. Press the mixture into the pan."
    },
    {
      "step": 3,
      "text": "Bake the crust until golden brown.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Whisk the egg whites and white sugar to soft peaks. Add the pumpkin puree, evaporated milk, remaining white sugar, cinnamon, salt, ginger, and cloves; mix until smooth."
    },
    {
      "step": 5,
      "text": "Pour the pumpkin mixture over the baked crust and return the pan to the oven."
    },
    {
      "step": 6,
      "text": "Bake until the filling is firm and reaches 160°F in the center.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Combine the walnuts, 0.5 cup packed brown sugar, and 2 tablespoons butter for the topping. Add the pumpkin puree and mix until combined."
    },
    {
      "step": 8,
      "text": "Cool the squares, then whisk the whipped cream and serve it alongside or on top."
    }
  ],
