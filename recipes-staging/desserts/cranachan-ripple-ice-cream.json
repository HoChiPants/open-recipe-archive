  "id": "cranachan-ripple-ice-cream",
  "name": "Cranachan Ripple Ice Cream",
  "subtitle": "Creamy whisky ice cream with toasted oats and raspberry ribbons",
  "description": "A rich honey-sweetened ice cream layered with crisp maple oats and bright raspberry ripple.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "egg-yolks-freeze-the-whites-for-another-recipe",
      "item": "egg yolks (freeze the whites for another recipe)",
      "quantity": 6
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "whisky",
      "item": "whisky",
      "quantity": 35,
      "unit": "ml"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "jumbo-oats",
      "item": "jumbo oats",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 60,
      "unit": "ml"
    },
    {
      "ingredient_id": "raspberries",
      "item": "raspberries",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 30,
      "unit": "g"
    },
    {
      "ingredient_id": "liquid-glucose",
      "item": "liquid glucose",
      "quantity": "1/2",
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the egg yolks and honey until smooth and slightly thickened."
    },
    {
      "step": 2,
      "text": "Heat the double cream and whole milk until steaming. Gradually whisk the hot mixture into the yolks, then return it to the pan and stir over low heat until thickened and it reaches 160°F.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Remove from the heat and stir in the vanilla extract, whisky, and lemon juiced. Transfer to a bowl and cool."
    },
    {
      "step": 4,
      "text": "Combine the jumbo oats and maple syrup, spread on a baking tray, and bake until golden brown.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Cool the oats, then break them into small pieces.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Mash the raspberries with the icing sugar and liquid glucose to make a ripple sauce."
    },
    {
      "step": 7,
      "text": "Churn the cooled ice cream base according to the machine instructions. Fold in most of the oat pieces, layer with the raspberry sauce and remaining oats, and freeze until scoopable."
    }
  ],
