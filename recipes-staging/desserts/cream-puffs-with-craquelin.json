  "id": "cream-puffs-with-craquelin",
  "name": "Cream Puffs with Craquelin",
  "subtitle": "French choux pastries with crisp brown-sugar tops and dark chocolate",
  "description": "Freeze a thin brown-sugar topping over piped choux, bake until puffed and crisp, then finish the cooled pastries with melted dark chocolate.",
  "meal_type": "dessert",
  "cuisine": "French",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
