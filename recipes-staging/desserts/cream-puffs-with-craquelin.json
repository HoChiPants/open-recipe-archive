      "item": "(4 ounce) bar dark chocolate",
      "quantity": 1,
      "preparation": "chopped, or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the softened butter, brown sugar, flour, and a pinch of salt into a smooth dough. Roll it thin between sheets of parchment, cut eight rounds, and freeze until firm.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Heat the cold water, unsalted butter, and remaining pinch of salt in a saucepan until the butter melts and the mixture reaches a simmer."
    },
    {
      "step": 3,
      "text": "Add the flour and stir over the heat until a smooth dough forms and pulls away from the pan. Whisk briefly, then cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Whisk in the eggs one at a time until the dough is smooth and holds a soft peak."
    },
    {
      "step": 5,
      "text": "Preheat the oven to 450°F. Pipe eight equal mounds of choux onto a lined baking sheet, place a frozen dough round on each, and bake until puffed."
    },
    {
      "step": 6,
      "text": "Reduce the oven to 350°F and continue baking until the pastries are golden and firm. Transfer them to a rack and cool completely.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Microwave the chopped chocolate in short intervals for up to 3 minutes, stirring between intervals, until melted. Spoon or drizzle it over the cooled cream puffs and let it set.",
      "timer_minutes": 3
    }
  ],
