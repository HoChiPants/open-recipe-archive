  "id": "butterscotch-pudding",
  "name": "Butterscotch Pudding",
  "subtitle": "A rich caramel custard with a silky finish",
  "description": "A smooth butterscotch pudding made with muscovado sugar, dairy, and egg yolks, served chilled with softly whipped cream and optional dark chocolate.",
  "meal_type": "dessert",
  "cuisine": "British",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": "2 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "egg-yolks-freeze-the-whites-for-another-recipe",
      "item": "egg yolks (freeze the whites for another recipe)",
      "quantity": 3
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 500,
      "unit": "ml"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "light-muscovado-sugar",
      "item": "light muscovado sugar",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "grated-dark-chocolate-to-serve-optional",
      "item": "grated dark chocolate to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cornflour and egg yolks in a bowl until smooth."
    },
    {
      "step": 2,
      "text": "Warm the milk with part of the double cream until steaming, then set aside."
    },
    {
      "step": 3,
      "text": "Melt the butter and muscovado sugar in a saucepan over medium heat, stirring until smooth and bubbling lightly.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Gradually whisk the warm dairy into the yolk mixture, then return everything to the saucepan."
    },
    {
      "step": 5,
      "text": "Cook over medium-low heat, stirring constantly, until thickened and the custard reaches 160°F.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Divide the pudding among six serving dishes and chill until set.",
      "timer_minutes": 240
    },
    {
      "step": 7,
      "text": "Whisk the remaining double cream to soft peaks and spoon it over the puddings."
    },
    {
      "step": 8,
      "text": "Finish with grated dark chocolate, if using, and serve."
    }
  ],
