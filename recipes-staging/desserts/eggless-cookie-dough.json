  "id": "eggless-cookie-dough",
  "name": "Eggless Cookie Dough",
  "subtitle": "A quick, single-serving sweet treat",
  "description": "Mix a small batch of buttery cookie dough with chocolate chips for an easy no-bake dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
