  "id": "maple-shortbread-cookies",
  "name": "Maple Shortbread Cookies",
  "subtitle": "Buttery cookies with maple flavor",
  "description": "Tender shortbread cookies made with butter, maple syrup, flour, and a touch of salt.",
  "meal_type": "dessert",
