  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the butter and maple syrup until smooth."
    },
    {
      "step": 3,
      "text": "Stir the flour and salt together, then combine them with the butter mixture to form a dough."
    },
    {
      "step": 4,
      "text": "Shape the dough into cookies and arrange them on a baking sheet."
    },
    {
      "step": 5,
      "text": "Bake until lightly browned.",
