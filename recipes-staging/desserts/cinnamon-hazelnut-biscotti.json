  "id": "cinnamon-hazelnut-biscotti",
  "name": "Cinnamon Hazelnut Biscotti",
  "subtitle": "Twice-baked cookies with warm cinnamon and toasted hazelnuts",
  "description": "Crisp, lightly sweet biscotti suited to serving with coffee or tea.",
  "meal_type": "dessert",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 40,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "hazelnuts",
      "item": "hazelnuts",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the butter and sugar until smooth. Whisk in the eggs and vanilla."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the flour, cinnamon, baking powder, and salt. Add the dry mixture to the butter mixture and stir until a dough forms. Stir in the hazelnuts."
    },
    {
      "step": 4,
      "text": "Shape the dough into logs on a baking sheet and bake until firm, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cool the logs completely, then cut them into thick slices."
    },
    {
      "step": 6,
      "text": "Arrange the slices on the baking sheet and bake for 10 minutes, turning as needed for even crisping.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Cool completely before serving."
    }
  ],
