    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 3
    },
    {
      "ingredient_id": "cream-of-tartar",
      "item": "cream of tartar",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 6,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the water, 2 tablespoons white sugar, and cornstarch together in a small saucepan. Heat, stirring, until thickened, then set aside to cool briefly.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Beat the egg whites with the cream of tartar and salt until foamy. Add the vanilla extract."
    },
    {
      "step": 3,
      "text": "Gradually add 6 tablespoons white sugar while whisking until soft peaks form."
    },
    {
      "step": 4,
      "text": "Whisk in the thickened cornstarch mixture and continue until smooth and glossy. For safety, heat the egg mixture until it reaches 160°F and the center is fully set before serving."
    },
    {
      "step": 5,
      "text": "Transfer the meringue to the dessert and let it stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
