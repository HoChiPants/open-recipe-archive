  "id": "meringue-topping",
  "name": "Meringue Topping",
  "subtitle": "Light, glossy topping for desserts",
  "description": "A fluffy French-style meringue stabilized with a lightly thickened sugar-and-cornstarch mixture.",
  "meal_type": "dessert",
  "cuisine": "French",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
