  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Lightly prepare a sheet pan."
    },
    {
      "step": 2,
      "text": "Combine the flour, white sugar, salt, and baking soda in a mixing bowl."
    },
    {
      "step": 3,
      "text": "Simmer 1 cup butter with the water in a saucepan. Pour the hot mixture into the dry ingredients and whisk until smooth."
    },
    {
      "step": 4,
      "text": "Whisk in the eggs, sour cream, and 1 teaspoon almond extract until the batter is smooth."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake until set, about 22 minutes.",
      "timer_minutes": 22
    },
    {
      "step": 6,
      "text": "Cool the cake in the pan for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Simmer 0.5 cup butter with the milk. Stir in the confectioners' sugar and 0.5 teaspoon almond extract until smooth."
    },
    {
      "step": 8,
      "text": "Transfer the frosting to the cooled cake and spread evenly. Garnish with the chopped pecans."
    }
  ],
