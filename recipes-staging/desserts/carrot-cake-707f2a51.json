  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the white sugar, vegetable oil, buttermilk, eggs, and vanilla extract until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the carrots, drained pineapple, coconut, and chopped walnuts."
    },
    {
      "step": 4,
      "text": "In a separate bowl, combine the flour, baking soda, cinnamon, and salt. Stir the dry mixture into the wet mixture just until combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a prepared baking pan and bake for 55 minutes, or until set in the center.",
      "timer_minutes": 55
    },
    {
      "step": 6,
      "text": "Cool the cake completely."
    },
    {
      "step": 7,
      "text": "Whisk the cream cheese, butter, and confectioners' sugar until smooth, then spread over the cooled cake."
    }
  ],
