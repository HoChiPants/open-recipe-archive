  "id": "cherry-winks",
  "name": "Cherry Winks",
  "subtitle": "Pecan-date cookies with cherries and a crisp cereal coating",
  "description": "Tender fruit-and-nut cookies are rolled in crushed cornflakes and finished with cherry pieces before baking.",
