  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the shortening and sugar until blended. Beat in the eggs, milk, and vanilla."
    },
    {
      "step": 3,
      "text": "Combine the sifted flour, baking powder, baking soda, and salt, then mix the dry ingredients into the shortening mixture."
    },
    {
      "step": 4,
      "text": "Stir in the chopped pecans, dates, and cherries."
    },
    {
      "step": 5,
      "text": "Shape the dough into about 30 portions. Roll each portion in the crushed cornflakes and place on a baking sheet. Top each with a quartered cherry."
    },
    {
      "step": 6,
      "text": "Bake at 375°F for 12 minutes, until the cookies are set.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Cool the cookies before serving."
    }
  ],
