  "id": "graham-cracker-cream-pie",
  "name": "Graham Cracker Cream Pie",
  "subtitle": "A chilled vanilla pudding pie with a light whipped topping",
  "description": "An easy no-bake dessert made with vanilla pudding, milk, and whipped topping in a graham cracker crust.",
  "meal_type": "dessert",
