  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour the milk into a mixing bowl and add the instant vanilla pudding mix. Whisk until combined."
    },
    {
      "step": 2,
      "text": "Let the pudding mixture stand for 10 minutes to thicken.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Fold in the thawed whipped topping until evenly blended."
    },
    {
      "step": 4,
      "text": "Spoon the filling into the prepared graham cracker crust and smooth the top."
    },
    {
      "step": 5,
      "text": "Chill for at least 90 minutes before serving.",
      "timer_minutes": 90
    }
