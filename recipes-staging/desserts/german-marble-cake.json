  "id": "german-marble-cake",
  "name": "German Marble Cake",
  "subtitle": "A tender vanilla-almond cake swirled with cocoa and rum batter",
  "description": "A classic marbled dessert made by dividing a buttery cake batter and flavoring one portion with cocoa and dark rum.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
