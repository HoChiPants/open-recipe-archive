      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare the baking pan. Prepare the flour as needed for mixing."
    },
    {
      "step": 2,
      "text": "Whisk the butter and sugar until combined and creamy."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, milk, and almond extract together, then add them to the butter mixture."
    },
    {
      "step": 4,
      "text": "Stir together the flour, baking powder, salt, and cocoa powder. Whisk the dry mixture into the wet mixture until a batter forms."
    },
    {
      "step": 5,
      "text": "Stir the cocoa powder into the portion of batter designated for the chocolate layer, then layer the batters in the prepared pan with the dark rum."
    },
    {
      "step": 6,
      "text": "Bake at 350°F for 70 minutes, or until the center is firm and a tester comes out clean.",
      "timer_minutes": 70
    },
    {
      "step": 7,
      "text": "Transfer the cake from the oven and let it cool before preparing and serving."
    }
  ],
