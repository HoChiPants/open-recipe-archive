  "id": "baked-alaska",
  "name": "Baked Alaska",
  "subtitle": "Ice cream and jam under a golden meringue",
  "description": "A simple sponge base supports raspberry-ripple ice cream and jam, finished with a crisp meringue topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 20
  },
