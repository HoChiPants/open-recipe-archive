  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and butter the tin, using the extra butter specified for the tin."
    },
    {
      "step": 2,
      "text": "Cream the softened butter and 115 g caster sugar for about 5 minutes. Whisk in the vanilla bean paste, eggs, self-raising flour, lemon zest, and enough milk to make a smooth batter.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared tin and bake for 20 minutes, until smooth and set. Cool completely.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Whisk the egg whites with the remaining caster sugar and white wine vinegar until they form stiff peaks. Continue whisking for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer the cooled sponge to a serving surface. Layer the ice cream and raspberry jam over it, then cover the dessert completely with the meringue."
    },
    {
      "step": 6,
      "text": "Bake or brown the assembled dessert until the meringue is golden and the center reaches 160°F on a food thermometer."
    },
    {
      "step": 7,
      "text": "Cut into portions and serve promptly."
    }
  ],
