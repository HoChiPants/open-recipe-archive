  "id": "chocolate-walnut-fudge",
  "name": "Chocolate Walnut Fudge",
  "subtitle": "Rich chocolate squares with chopped walnuts",
  "description": "A simple stovetop fudge set with semisweet chocolate, marshmallows, and walnuts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
