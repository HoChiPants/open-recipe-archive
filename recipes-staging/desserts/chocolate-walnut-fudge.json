      "item": "marshmallows",
      "quantity": 10,
      "unit": "large"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Line an 8-inch square pan with parchment. Melt the butter and place it in a heatproof bowl with the chocolate chips and vanilla extract."
    },
    {
      "step": 2,
      "text": "Combine the sugar, evaporated milk, and marshmallows in a saucepan. Bring to a simmer, stirring until the marshmallows dissolve, then cook for 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Pour the hot mixture over the chocolate mixture and whisk until smooth. Fold in the chopped walnuts."
    },
    {
      "step": 4,
      "text": "Spread the fudge in the prepared pan and chill until firm, about 95 minutes. Cut into squares.",
      "timer_minutes": 95
    }
  ],
