  "instructions": [
    {
      "step": 1,
      "text": "Process the figs and dates with the orange until finely chopped. Add the raisins, pecans, honey, brandy, cinnamon, cloves, allspice, nutmeg, and water; process until combined. Cover and chill for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Combine the flour, white sugar, baking powder, and salt. Cut in the cold butter and shortening until crumbly. Mix in the 0.5 cup milk, vanilla, and almond extract to form a dough."
    },
    {
      "step": 3,
      "text": "Knead the dough briefly on a lightly floured surface until smooth. Cover and chill for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Preheat the oven to 375°F. Divide the dough, roll each portion into a thick rope, and cut into pieces. Flatten or shape each piece, fill with the chilled fruit mixture, and fold the dough around the filling."
    },
    {
      "step": 5,
      "text": "Place the cookies on prepared baking sheets and bake until cooked through and the centers are fully set; an inserted thermometer should read at least 160°F because the dough contains egg.",
      "timer_minutes": 14
    },
    {
      "step": 6,
      "text": "Cool the cookies completely. Whisk the powdered sugar and remaining 0.25 cup milk until smooth, tint portions with the red and green food coloring, and spread the icing over the cookies. Finish with candy coated sprinkles and let the icing set.",
      "timer_minutes": 20
    }
  ],
