  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a skillet over medium heat. Add the onion and garlic; sauté until softened, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Stir in the rosemary, thyme, condensed soup, and evaporated milk. Heat until the sauce is smooth and hot, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Fold in the chicken, green chilies, and green beans. Transfer the mixture to a baking dish."
    },
    {
      "step": 5,
      "text": "Whisk the mashed potatoes until smooth, then mix in the Parmesan and basil. Spread the potatoes evenly over the filling."
    },
    {
      "step": 6,
      "text": "Bake until the topping is heated through and lightly browned, about 20 minutes. Confirm the center reaches 165°F with a food thermometer before serving.",
      "timer_minutes": 20
    }
  ],
