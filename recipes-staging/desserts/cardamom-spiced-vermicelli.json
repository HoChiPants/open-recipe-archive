      "item": "fine vermicelli roughly crushed",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "jaggery-or-light-muscovado-sugar",
      "item": "jaggery or light muscovado sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "coconut-milk",
      "item": "coconut milk",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "raisins-soaked-in-hot-water-for-10-mins",
      "item": "raisins soaked in hot water for 10 mins",
      "quantity": 50,
      "unit": "g",
      "preparation": "then drained"
    },
    {
      "ingredient_id": "cashews-fried-until-golden-in-1-tsp-ghee",
      "item": "cashews fried until golden in 1 tsp ghee",
      "quantity": 50,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Crush the cardamom seeds with the caster sugar and jaggery or light muscovado sugar until evenly combined."
    },
    {
      "step": 2,
      "text": "Warm the whole milk and coconut milk together in a saucepan without boiling."
    },
    {
      "step": 3,
      "text": "Heat the ghee in a wide pan. Add the crushed vermicelli and toast, stirring, for 5 minutes. Add the drained raisins and fried cashews.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Pour in the warm milk mixture and bring to a boil. Cook until the vermicelli is tender, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the cardamom-sugar mixture and the drained raisins. Simmer for 3 minutes, stirring often.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Whisk the mixture until smooth, then stir through the raisins and fold in the cashews before serving."
    }
  ],
