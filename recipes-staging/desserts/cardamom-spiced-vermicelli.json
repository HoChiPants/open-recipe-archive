  "id": "cardamom-spiced-vermicelli",
  "name": "Cardamom-Spiced Vermicelli",
  "subtitle": "A warm Indian dessert with jaggery, coconut milk, raisins, and cashews.",
  "description": "Toasted vermicelli simmers with fragrant cardamom, sweetener, and two kinds of milk, then gets finished with fruit and nuts.",
  "meal_type": "dessert",
  "cuisine": "Indian",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "green-cardamom-pods-seeds-removed",
      "item": "green cardamom pods seeds removed",
      "quantity": 10
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "l-whole-milk",
      "item": "l whole milk",
      "quantity": 1
    },
    {
      "ingredient_id": "ghee",
      "item": "ghee",
      "quantity": 75,
      "unit": "g"
    },
    {
