  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease and line a loaf pan."
    },
    {
      "step": 2,
      "text": "Cut the butternut squash into small pieces. Combine it with the brown sugar and cook gently for 8 minutes, until softened; cool briefly.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Whisk the eggs, oil, milk, vanilla, cinnamon, and nutmeg into the squash mixture."
    },
    {
      "step": 4,
      "text": "Stir the flour and baking powder together, then fold them into the wet mixture until smooth."
    },
    {
      "step": 5,
      "text": "Fold in the chopped dark chocolate and pecans. Transfer the batter to the prepared pan."
    },
    {
      "step": 6,
      "text": "Bake for 60 minutes, or until a skewer comes out clean and the center is fully set.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Let the loaf rest in the pan for 5 minutes, then transfer it to a rack and cool for 15 minutes before slicing.",
      "timer_minutes": 20
    }
  ],
