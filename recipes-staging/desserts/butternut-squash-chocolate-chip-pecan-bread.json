  "id": "butternut-squash-chocolate-chip-pecan-bread",
  "name": "Butternut Squash Chocolate Chip Pecan Bread",
  "subtitle": "A warmly spiced loaf with chocolate and toasted pecans.",
  "description": "A tender butternut squash bread combining brown sugar, cinnamon, nutmeg, dark chocolate, and pecans in a straightforward baked loaf.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 70
  },
  "ingredients": [
