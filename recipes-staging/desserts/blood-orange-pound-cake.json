  "id": "blood-orange-pound-cake",
  "name": "Blood Orange Pound Cake",
  "subtitle": "A citrus-scented cake with a bright orange glaze",
  "description": "This tender pound cake pairs blood orange zest with a simple juice glaze and optional pistachio and candied-peel decoration.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-softened",
      "item": "unsalted butter softened",
      "quantity": 150,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "eggs-at-room-temperature",
      "item": "eggs at room temperature",
      "quantity": 3,
      "unit": "medium"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 250,
      "unit": "g"
    },
