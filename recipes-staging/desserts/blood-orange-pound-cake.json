  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease the tin with the extra butter."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter and caster sugar for 8 minutes, then whisk in the eggs one at a time.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Add the flour, baking powder, bicarbonate of soda, salt, soured cream, and blood-orange zest; mix just until combined."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared tin and bake for 50 minutes, until the center is firm and fully set and a food thermometer reads at least 160°F.",
      "timer_minutes": 50
    },
    {
      "step": 5,
      "text": "Let the cake cool before removing it from the tin."
    },
    {
      "step": 6,
      "text": "Stir the sifted icing sugar with 2 to 3 tablespoons of blood orange juice to make a pourable glaze."
    },
    {
      "step": 7,
      "text": "Spread the glaze over the cooled cake and finish with the optional pistachios and candied peel."
    }
  ],
