  "id": "chocolate-pudding-layer-pie",
  "name": "Chocolate Pudding Layer Pie",
  "subtitle": "A chilled dessert with a nutty crust and creamy layers.",
  "description": "Bake a walnut crust, fill it with chocolate pudding, and finish with a soft cream-cheese topping before chilling.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "instant-chocolate-pudding-mix",
      "item": "instant chocolate pudding mix",
      "quantity": 2,
      "unit": "package",
      "preparation": "3.9 ounce"
    },
    {
      "ingredient_id": "cold-milk",
      "item": "cold milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the walnuts and flour. Work in the softened butter and stir until evenly combined."
    },
    {
      "step": 3,
      "text": "Press the mixture into a baking dish or pie pan."
    },
    {
      "step": 4,
      "text": "Bake until golden brown, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Cool the crust completely."
    },
    {
      "step": 6,
      "text": "Whisk the pudding mix with the cold milk until smooth, then let it stand for 5 minutes to set.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Whisk the cream cheese and heavy whipping cream, add the confectioners' sugar, and continue whisking until smooth and soft peaks form."
    },
    {
      "step": 8,
      "text": "Spread the pudding over the cooled crust and add the cream-cheese mixture in an even layer."
    },
    {
      "step": 9,
      "text": "Chill for at least 2 hours before serving.",
      "timer_minutes": 120
    }
  ],
