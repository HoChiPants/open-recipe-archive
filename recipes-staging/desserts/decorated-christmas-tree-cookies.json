  "id": "decorated-christmas-tree-cookies",
  "name": "Decorated Christmas Tree Cookies",
  "subtitle": "Buttery tree-shaped cookies with green icing and sprinkles",
  "description": "Cut buttery vanilla cookie dough into tree shapes, bake until lightly golden, then decorate with green icing and festive sprinkles.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "egg-yolk-use-the-white-for-the-icing",
      "item": "egg yolk (use the white for the icing",
      "quantity": 1,
      "preparation": "below)"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 4,
      "unit": "tsp"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": "175-200",
      "unit": "g"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 2
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 140,
      "unit": "g"
    },
    {
      "ingredient_id": "green-food-colouring",
      "item": "green food colouring"
    },
    {
      "ingredient_id": "red",
      "item": "red",
      "preparation": "white and green round sprinkles"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened butter and golden caster sugar until smooth. Beat in the egg yolk and vanilla extract, then mix in enough flour to form a soft dough."
    },
    {
      "step": 2,
      "text": "Chill the dough until firm.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat the oven and prepare baking trays. Roll the dough on a lightly floured surface and cut out tree shapes."
    },
    {
      "step": 4,
      "text": "Transfer the shapes to the trays and bake until set and lightly golden.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Cool the cookies completely on a rack.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Whisk the egg whites with the vinegar, then gradually add the caster sugar to make a thick icing. For safety, use pasteurized egg whites; if using raw whites, heat the icing mixture gently while whisking to 160°F, then cool before piping."
    },
    {
      "step": 7,
      "text": "Whisk in green food colouring. Pipe or spread the icing over the cooled cookies and finish with the red, white and green round sprinkles. Leave the icing to set.",
      "timer_minutes": 50
    }
  ],
