  "id": "chocolate-mint-brownies",
  "name": "Chocolate-Mint Brownies",
  "subtitle": "Layered brownies with mint cream and chocolate topping",
  "description": "Rich chocolate brownies are cooled, spread with a mint layer, finished with chocolate topping, and chilled before serving.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30,
    "inactive_minutes": 80
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "chocolate-syrup",
      "item": "chocolate syrup",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "creme-de-menthe-liqueur",
      "item": "creme de menthe liqueur",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Beat 1 cup white sugar with 0.5 cup softened butter until smooth. Add the eggs and chocolate syrup, then mix until combined."
    },
    {
      "step": 3,
      "text": "Stir in the flour just until no dry streaks remain. Transfer the batter to the prepared pan and bake for 30 minutes, until the center is firm and set.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Cool the brownies completely."
    },
    {
      "step": 5,
      "text": "Beat the confectioners' sugar, 0.5 cup softened butter, and creme de menthe liqueur until smooth. Spread over the cooled brownies and chill until set.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Melt the remaining butter with the semisweet chocolate chips until smooth, then spread the topping over the mint layer."
    },
    {
      "step": 7,
      "text": "Chill until firm, then cut into 24 servings."
    }
  ],
