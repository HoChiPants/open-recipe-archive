      "item": "peanuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened butter, white sugar, packed brown sugar, and peanut butter until smooth."
    },
    {
      "step": 2,
      "text": "Add the eggs, egg yolk, and vanilla extract; mix until incorporated."
    },
    {
      "step": 3,
      "text": "Combine the all-purpose flour, baking soda, and salt, then stir into the butter mixture until a dough forms."
    },
    {
      "step": 4,
      "text": "Stir in the chopped peanuts. Cover and chill the dough for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 6,
      "text": "Shape the chilled dough into portions and transfer them to prepared baking sheets."
    },
    {
      "step": 7,
      "text": "Bake for 15 minutes, until the centers are firm and fully set; for a temperature check, they should reach 160°F.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Cool the cookies before serving."
    }
  ],
