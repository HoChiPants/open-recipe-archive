  "id": "easy-apple-cake",
  "name": "Easy Apple Cake",
  "subtitle": "A warmly spiced cake with apples and walnut crumble",
  "description": "Cake mix, eggs, and apple pie filling form a tender base beneath a brown sugar, cinnamon, and walnut topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 45,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "yellow-cake-mix",
      "item": "yellow cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "apple-pie-filling",
      "item": "apple pie filling",
      "quantity": 1,
      "unit": "can",
      "preparation": "21 ounce"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare the baking pan with the all-purpose flour."
    },
    {
      "step": 2,
      "text": "Combine the yellow cake mix, eggs, and apple pie filling until evenly mixed. Transfer the batter to the prepared pan."
    },
    {
      "step": 3,
      "text": "Mix the packed brown sugar, all-purpose flour, butter, ground cinnamon, and walnuts to make the topping. Scatter it evenly over the batter."
    },
    {
      "step": 4,
      "text": "Bake for 40 minutes, until the center is firm and fully set or reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Cool for 15 minutes before serving.",
      "timer_minutes": 15
    }
  ],
