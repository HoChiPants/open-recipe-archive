  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Cut the pears as needed for baking and arrange them in a baking dish."
    },
    {
      "step": 2,
      "text": "Add the cassis, red wine, caster sugar, and bay leaves to the dish, coating the pears with the liquid."
    },
    {
      "step": 3,
      "text": "Bake until the pears are tender.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "Let the pears stand for 20 minutes, then cut them into serving portions.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Transfer the pears and bay leaves as directed for the sauce, bring the liquid to a boil, and add the red wine. Cook until the sauce is thick.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Serve the pears with the blackberries and thick sauce."
    }
