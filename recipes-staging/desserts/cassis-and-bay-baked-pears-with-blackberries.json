  "id": "cassis-and-bay-baked-pears-with-blackberries",
  "name": "Cassis and Bay-Baked Pears with Blackberries",
  "subtitle": "Tender pears with a dark berry-wine sauce",
  "description": "Pears bake with cassis, red wine, sugar, and bay leaves, then are served with blackberries and the thickened cooking liquid.",
  "meal_type": "dessert",
