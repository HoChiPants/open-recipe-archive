  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Prepare the flour, baking powder, and salt together, then set aside."
    },
    {
      "step": 2,
      "text": "Whisk the egg yolks and lemon extract for 5 minutes, until thick. Add the white sugar and continue preparing the mixture for 10 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Fold in the orange zest, orange juice, and the remaining white sugar, then whisk until combined."
    },
    {
      "step": 4,
      "text": "Fold in the boiling water, then incorporate the prepared dry ingredients until the batter is smooth."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the baking pan and bake at 325°F for 65 minutes, or until the center is fully set and reaches 160°F.",
      "timer_minutes": 65
    },
    {
      "step": 6,
      "text": "Cool the cake for 60 minutes. Prepare the topping by combining white sugar, orange zest, and orange juice, then add it to the cooled cake.",
      "timer_minutes": 60
    }
  ],
