  "id": "egg-yolk-sponge-cake",
  "name": "Egg-Yolk Sponge Cake",
  "subtitle": "A light citrus-scented cake with a tender crumb",
  "description": "A simple orange-and-lemon sponge cake made with egg yolks and boiling water, then finished with a citrus-sugar topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
