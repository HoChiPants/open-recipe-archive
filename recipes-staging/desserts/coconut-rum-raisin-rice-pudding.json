  "id": "coconut-rum-raisin-rice-pudding",
  "name": "Coconut Rum Raisin Rice Pudding",
  "subtitle": "Creamy coconut rice pudding with spiced rum and raisins",
  "description": "A rich rice pudding combining coconut milk, cream, warm spices from rum, and chewy raisins.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "short-grain-pudding-rice",
      "item": "short-grain pudding rice",
      "quantity": 150,
      "unit": "g"
    },
    {
