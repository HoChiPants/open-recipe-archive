      "item": "muscovado sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 100,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a heavy saucepan over medium heat. Add the rice and stir until the grains are coated and lightly warmed.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk together the golden caster sugar, coconut milk, cream, vanilla, and muscovado sugar. Pour the mixture into the saucepan and stir in the rum and raisins."
    },
    {
      "step": 3,
      "text": "Cook gently, stirring regularly, until the rice is tender and the pudding is thick and creamy.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "Remove from the heat and stir well. Serve warm with a little extra cream, or chill until firm."
    }
  ],
