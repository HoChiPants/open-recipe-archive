  "id": "oatmeal-chocolate-chip-cookies",
  "name": "Oatmeal Chocolate Chip Cookies",
  "subtitle": "Chewy cookies with oats and semisweet chocolate",
  "description": "A classic drop cookie combining brown sugar, oats, and semisweet chocolate chips for a chewy, lightly crisp treat.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
