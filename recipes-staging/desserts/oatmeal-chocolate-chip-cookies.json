  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, salt, and baking soda together in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the shortening, brown sugar, white sugar, and vanilla until combined."
    },
    {
      "step": 4,
      "text": "Whisk in the eggs one at a time, then gradually mix in the dry ingredients."
    },
    {
      "step": 5,
      "text": "Stir in the rolled oats and chocolate chips until evenly distributed."
    },
    {
      "step": 6,
      "text": "Portion the dough onto baking sheets, leaving space between portions. Bake at 350°F until the edges are set and the centers are fully cooked.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Cool the cookies on the baking sheets for 2 minutes, then transfer them to a rack to cool completely.",
      "timer_minutes": 2
    }
  ],
