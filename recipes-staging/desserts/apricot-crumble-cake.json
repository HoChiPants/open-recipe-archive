      "item": "granulated sugar",
      "quantity": 80,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease and flour the cake tin."
    },
    {
      "step": 2,
      "text": "Mix the oil or melted butter, 120 g flour, yogurt, 100 g sugar, baking powder, and egg until evenly combined."
    },
    {
      "step": 3,
      "text": "Spread the batter in the prepared tin and arrange the drained sliced apricots over the surface."
    },
    {
      "step": 4,
      "text": "Rub the cold butter into 100 g flour, then mix in 80 g sugar to make coarse crumbs. Scatter them over the apricots."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, or until the center is firm and fully set; an egg-containing cake should reach 160°F in the center.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Cool briefly before slicing and serving."
    }
  ],
