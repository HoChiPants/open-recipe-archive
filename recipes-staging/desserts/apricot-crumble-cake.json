  "id": "apricot-crumble-cake",
  "name": "Apricot Crumble Cake",
  "subtitle": "Yogurt cake with sliced apricots and a buttery crumb topping",
  "description": "A simple fruit cake layered with apricots and finished with a crisp crumble topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "oil-or-melted-butter-plus-extra-for-the-tin",
      "item": "oil or melted butter plus extra for the tin",
      "quantity": 120,
      "unit": "ml"
    },
    {
