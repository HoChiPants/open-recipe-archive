{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "flourless-hazelnut-cake",
  "name": "Flourless Hazelnut Cake",
  "subtitle": "A rich nut-based cake with whipped cream",
  "description": "Ground hazelnuts form the base of this tender flourless cake, finished with whipped cream and chopped hazelnuts.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "hazelnuts",
      "item": "hazelnuts",
      "quantity": 12,
      "unit": "ounces"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 6
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.625,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 6
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "pint"
    },
    {
      "ingredient_id": "hazelnuts",
      "item": "hazelnuts",
      "quantity": 0.125,
      "unit": "cup",
      "preparation": "chopped, for garnish"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Prepare a cake pan for the batter."
    },
    {
      "step": 2,
      "text": "Process the 12 ounces of hazelnuts until finely ground, then mix in the baking powder."
    },
    {
      "step": 3,
      "text": "Whisk the egg yolks with the white sugar until smooth and light. In a separate bowl, whisk the egg whites with the white sugar until they hold a firm foam."
    },
    {
      "step": 4,
      "text": "Fold the egg-white mixture into the yolk mixture, then fold in the ground hazelnut mixture."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and smooth the top."
    },
    {
      "step": 6,
      "text": "Bake until the cake is set in the center and a thermometer reads at least 160°F, about 60 minutes.",
      "timer_minutes": 75
    },
    {
      "step": 7,
      "text": "Cool the cake completely, then cut it into 12 servings."
    },
    {
      "step": 8,
      "text": "Whisk the heavy whipping cream until thick, and serve it with the cake. Finish with the chopped hazelnuts."
    }
  ],
