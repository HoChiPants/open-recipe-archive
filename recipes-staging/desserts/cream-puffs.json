{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cream-puffs",
  "name": "Cream Puffs",
  "subtitle": "Light pastry shells with vanilla cream and chocolate",
  "description": "Bake crisp choux pastry shells, fill them with sweetened vanilla cream, and finish with melted semisweet chocolate.",
  "meal_type": "dessert",
  "cuisine": "French",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "pint"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Simmer the water and stir in the butter until melted. Add the flour and salt, stirring until a smooth dough forms and pulls from the pan."
    },
    {
      "step": 3,
      "text": "Beat in the eggs gradually until the dough is smooth. Portion it into 12 mounds on a baking sheet."
    },
    {
      "step": 4,
      "text": "Bake at 450°F, then reduce the oven to 325°F and continue baking until the shells are firm and dry.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Turn off the oven and leave the shells inside for 20 minutes. Transfer them to a rack and cool completely.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Whisk the heavy cream to stiff peaks, then mix in the sugar and vanilla. Continue whisking until evenly combined."
    },
    {
      "step": 7,
      "text": "Melt the chocolate chips with enough of the cream to make a smooth topping, whisking until melted."
    },
    {
      "step": 8,
      "text": "Split or pierce the cooled shells, fill with the vanilla cream, top with chocolate, and serve."
    }
  ],
