  "id": "strawberries-and-cream-bread-pudding",
  "name": "Strawberries and Cream Bread Pudding",
  "subtitle": "A tender baked custard pudding with berries and cream",
  "description": "Day-old bread, fresh strawberries, and strawberry-swirled custard bake into a simple fruit dessert.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "1-ounce-slices-day-old-bread",
      "item": "(1 ounce) slices day-old bread",
      "quantity": 7,
      "preparation": "torn into small pieces"
    },
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "light-cream",
      "item": "light cream",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "strawberry-preserves",
      "item": "strawberry preserves",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Use the melted butter to coat a baking dish."
    },
    {
      "step": 2,
      "text": "Arrange the torn bread and chopped strawberries evenly in the prepared dish."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, milk, light cream, strawberry preserves, sugar, and vanilla until smooth."
    },
    {
      "step": 4,
      "text": "Pour the custard over the bread and strawberries, pressing the bread down gently so it is moistened."
    },
    {
      "step": 5,
      "text": "Bake for 40 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    }
  ],
