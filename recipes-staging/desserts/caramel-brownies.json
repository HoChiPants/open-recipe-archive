  "id": "caramel-brownies",
  "name": "Caramel Brownies",
  "subtitle": "Chewy brownies with a smooth caramel layer",
  "description": "A simple American dessert combining chocolate brownie layers, semisweet chips, and melted caramel.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "individually-wrapped-caramels",
      "item": "individually wrapped caramels",
      "quantity": 1,
      "unit": "package",
      "preparation": "14 ounce, unwrapped"
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 0.33333331346512,
      "unit": "cup"
    },
    {
      "ingredient_id": "chocolate-cake-mix",
      "item": "chocolate cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Melt the caramels with the evaporated milk over low heat, stirring until smooth."
    },
    {
      "step": 3,
      "text": "Combine the chocolate cake mix, melted butter, and evaporated milk to form a thick batter."
    },
    {
      "step": 4,
      "text": "Spread part of the batter in the prepared pan and bake briefly to set the base.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Add the chocolate chips and caramel mixture, then cover with the remaining batter."
    },
    {
      "step": 6,
      "text": "Bake until the brownies are set.",
      "timer_minutes": 18
    },
    {
      "step": 7,
      "text": "Cool completely before cutting."
    }
  ],
