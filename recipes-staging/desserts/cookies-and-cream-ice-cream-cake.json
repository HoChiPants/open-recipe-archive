  "instructions": [
    {
      "step": 1,
      "text": "Oil the tins and heat the oven to 180°C/350°F. Whisk the eggs, buttermilk, coffee, and vegetable oil together."
    },
    {
      "step": 2,
      "text": "Combine the caster sugar, light brown soft sugar, cocoa powder, plain flour, bicarbonate of soda, and baking powder. Stir the dry mixture into the wet mixture until smooth, then fold in the chopped sandwich biscuits and dark chocolate."
    },
    {
      "step": 3,
      "text": "Divide the batter between the prepared tins and bake until risen and set, about 25 minutes. Cool completely, then cut the cakes into even layers.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Whisk the softened cookie dough ice cream with part of the double cream until smooth. Spread it between the cake layers, assemble the cake, and transfer it to the freezer until firm."
    },
    {
      "step": 5,
      "text": "Whisk the remaining softened cookie dough ice cream with the remaining double cream, golden syrup, and icing sugar. Spread the mixture over the chilled cake and return it to the freezer until firm."
    },
    {
      "step": 6,
      "text": "Top with the remaining chopped chocolate sandwich biscuits and serve the cake cut into wedges."
    }
  ],
