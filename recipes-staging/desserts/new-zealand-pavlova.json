{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "new-zealand-pavlova",
  "name": "New Zealand Pavlova",
  "subtitle": "A crisp meringue shell with a tender center",
  "description": "Whipped egg whites form a light meringue that bakes into a crisp-edged pavlova with a soft, set center.",
  "meal_type": "dessert",
  "cuisine": "New Zealand",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 3
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 3,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.125,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 275°F. Line a baking sheet with parchment."
    },
    {
      "step": 2,
      "text": "Whisk the egg whites, white sugar, and distilled white vinegar until foamy. Continue whisking in the remaining white sugar until stiff peaks form."
    },
    {
      "step": 3,
      "text": "Stir together the water, cornstarch, vanilla extract, remaining distilled white vinegar, and salt. Whisk this mixture into the meringue until evenly incorporated."
    },
    {
      "step": 4,
      "text": "Transfer the meringue to the prepared baking sheet and shape it into a round, high mound."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, until the exterior is firm and the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Turn off the oven and let the pavlova cool inside before serving."
    }
  ],
