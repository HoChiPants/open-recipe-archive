  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Mix 3 tablespoons white sugar, the cinnamon, and the dark brown sugar in a shallow bowl for the coating; set aside."
    },
    {
      "step": 3,
      "text": "Beat the 1/2 cup white sugar, remaining dark brown sugar, and softened butter until blended. Add the eggs and vanilla, mixing until incorporated."
    },
    {
      "step": 4,
      "text": "Whisk the flour, baking soda, and salt together, then mix them into the butter mixture to form a dough."
    },
    {
      "step": 5,
      "text": "Shape the dough into portions and roll each in the cinnamon-sugar mixture. Transfer to baking sheets."
    },
    {
      "step": 6,
      "text": "Bake until the cookies are set, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Cool the cookies before serving."
    }
  ],
