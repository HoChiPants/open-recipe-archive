  "id": "cinnamon-sugar-butter-cookies",
  "name": "Cinnamon Sugar Butter Cookies",
  "subtitle": "Soft cookies with a warm cinnamon-sugar coating",
  "description": "Tender butter cookies rolled in cinnamon sugar and baked until lightly set.",
  "meal_type": "dessert",
  "cuisine": "American",
