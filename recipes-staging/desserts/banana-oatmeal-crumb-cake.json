  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Stir together the flour, 1 1/3 cups rolled oats, salt, and baking soda."
    },
    {
      "step": 3,
      "text": "Whisk the softened butter and 2/3 cup brown sugar until smooth. Whisk in the eggs, mashed bananas, and vanilla, then incorporate the dry mixture."
    },
    {
      "step": 4,
      "text": "Combine the remaining rolled oats and brown sugar with the melted butter, walnuts, and cinnamon to make the crumb topping."
    },
    {
      "step": 5,
      "text": "Spread the batter in the prepared pan and scatter the topping evenly over it."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, until the center is fully set.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Transfer the cake from the oven and let it cool before serving."
    }
  ],
