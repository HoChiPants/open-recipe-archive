  "instructions": [
    {
      "step": 1,
      "text": "Place the soup, stock, carrots, celery, onion, parsley, paprika, oregano, salt, and pepper in the slow cooker; stir until combined and thick."
    },
    {
      "step": 2,
      "text": "Nestle the chicken breasts into the sauce and cover."
    },
    {
      "step": 3,
      "text": "Cook on high for about 2 hours or on low for about 8 hours, until the chicken reaches 165°F in the thickest part.",
      "timer_minutes": 480
    },
    {
      "step": 4,
      "text": "Transfer the chicken to a bowl and shred it. Return it to the slow cooker with the peas and corn, stirring to distribute."
    },
    {
      "step": 5,
      "text": "Cover and cook until the frozen vegetables are hot and the filling is steaming, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
