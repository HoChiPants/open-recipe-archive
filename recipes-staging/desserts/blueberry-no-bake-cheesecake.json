  "id": "blueberry-no-bake-cheesecake",
  "name": "Blueberry No-Bake Cheesecake",
  "subtitle": "A chilled mascarpone cheesecake with fresh blueberries",
  "description": "A creamy blueberry cheesecake with a biscuit crust, citrus, and a simple mint garnish.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 180,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "digestive-biscuits",
      "item": "digestive biscuits",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "unsalted-butter-melted",
      "item": "unsalted butter melted",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "mascarpone",
      "item": "mascarpone",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "lemons-1-zested",
      "item": "lemons 1 zested",
      "quantity": 2,
      "preparation": "both juiced"
    },
    {
      "ingredient_id": "condensed-milk",
      "item": "condensed milk",
      "quantity": 350,
      "unit": "g"
    },
    {
      "ingredient_id": "blueberries",
      "item": "blueberries",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "mint-leaves-to-decorate",
      "item": "mint leaves to decorate"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Crush the digestive biscuits into fine crumbs. Combine the melted butter and vanilla extract until evenly mixed, then stir in the crumbs."
    },
    {
      "step": 2,
      "text": "Press the mixture firmly into the base of a lined cake tin and smooth the surface. Chill until firm, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Whisk the mascarpone and condensed milk until smooth. Mix in the lemon zest and juice."
    },
    {
      "step": 4,
      "text": "Fold in the blueberries, reserving some for the topping if desired, and spread the filling over the chilled crust."
    },
    {
      "step": 5,
      "text": "Top with the remaining blueberries and mint leaves to decorate. Chill until firm, about 180 minutes, then slice and serve.",
      "timer_minutes": 180
    }
  ],
