  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 300°F. Line a baking sheet with parchment and draw a 9-inch circle."
    },
    {
      "step": 2,
      "text": "Whisk the egg whites until soft peaks form. Gradually add 200 g caster sugar, then whisk in the vinegar and cornflour until glossy and firm."
    },
    {
      "step": 3,
      "text": "Spread the meringue within the circle, making a shallow center. Bake for 60 minutes, then turn off the oven and let it cool inside briefly.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Warm the milk and 115 ml whipping cream. Whisk the egg yolks with 50 g caster sugar, combine with the warm dairy, and cook gently, stirring, until the mixture reaches 160°F and thickens.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Pour the hot mixture over the finely chopped dark chocolate and stir until smooth. Add the softened butter and 100 g smooth peanut butter, then cool.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Melt the white chocolate with the cold cubed butter and remaining peanut butter; stir until smooth and let cool slightly."
    },
    {
      "step": 7,
      "text": "Cook the peanuts with the granulated sugar in a skillet for about 4 minutes, stirring until coated and lightly caramelized. Cool and break into pieces.",
      "timer_minutes": 4
    },
    {
      "step": 8,
      "text": "Whisk the double cream until soft peaks form. Fold in the cooled chocolate-peanut mixture."
    },
    {
      "step": 9,
      "text": "Place the meringue on a serving plate. Layer with the chocolate cream, peanut butter mixture, and candied peanuts."
    },
    {
      "step": 10,
      "text": "Finish with dark chocolate shavings, if using, and serve."
    }
  ],
