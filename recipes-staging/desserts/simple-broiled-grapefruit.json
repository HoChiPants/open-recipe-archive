  "id": "simple-broiled-grapefruit",
  "name": "Simple Broiled Grapefruit",
  "subtitle": "Warm grapefruit with a caramelized brown-sugar topping",
  "description": "Grapefruit halves are broiled with brown sugar until the topping melts and lightly caramelizes.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "grapefruit",
      "item": "grapefruit",
      "quantity": 2,
      "preparation": "cut in half"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 6,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the broiler. Arrange the grapefruit halves cut-side up on a broiler-safe baking sheet."
    },
    {
      "step": 2,
      "text": "Sprinkle the brown sugar evenly over the cut surfaces."
    },
    {
      "step": 3,
      "text": "Broil until the sugar is melted and lightly caramelized, watching closely.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Let cool briefly before serving."
    }
  ],
