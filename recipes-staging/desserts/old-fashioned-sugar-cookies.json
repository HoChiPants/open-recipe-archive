  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "old-fashioned-sugar-cookies",
  "name": "Old-Fashioned Sugar Cookies",
  "subtitle": "Tender, lightly sweet cookies with crisp edges",
  "description": "A classic American sugar cookie dough made with butter, cream, vanilla, and a simple leavened flour mixture, then rolled, cut, and baked.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 78,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "lightly beaten"
    },
    {
      "ingredient_id": "cream",
      "item": "cream",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Combine the sifted flour, baking powder, salt, and sugar."
    },
    {
      "step": 3,
      "text": "Cut the butter into the dry mixture until evenly incorporated.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Whisk the cream and vanilla together, then add them with the beaten egg. Mix until a dough forms.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Chill the dough for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Roll the dough on a lightly floured surface, sprinkle with sugar, and cut into cookies."
    },
    {
      "step": 7,
      "text": "Transfer the cookies to baking sheets and bake for 8 minutes, or until the centers are fully set.",
      "timer_minutes": 8
    },
    {
      "step": 8,
      "text": "Transfer the cookies to a rack and let them cool for 2 minutes.",
      "timer_minutes": 2
    }
  ],
