  "id": "potato-chip-cookies",
  "name": "Potato Chip Cookies",
  "subtitle": "Buttery cookies with a crisp, savory crunch",
  "description": "A simple American cookie combining sweet vanilla dough with crushed salted potato chips.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "cups",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "salted-potato-chips",
      "item": "salted potato chips",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare baking sheets for the cookies."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter, white sugar, and vanilla extract until combined."
    },
    {
      "step": 3,
      "text": "Add the flour and mix until a dough forms, then fold in the crushed potato chips."
    },
    {
      "step": 4,
      "text": "Portion the dough onto the prepared baking sheets, leaving space between portions."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until golden brown.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Transfer the cookies to a cooling surface before serving."
    }
  ],
