  "id": "apple-cheese-and-potato-pie",
  "name": "Apple, Cheese and Potato Pie",
  "subtitle": "A savory pie with tender apples, potatoes, cheddar, and thyme",
  "description": "A hearty baked pie combining creamy potatoes, tart apples, sharp cheddar, and a thyme-scented onion sauce in a crisp cheese pastry.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
