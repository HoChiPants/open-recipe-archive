  "instructions": [
    {
      "step": 1,
      "text": "Make the pastry by rubbing the cold butter into the plain flour plus extra for dusting until crumbly. Stir in the cheddar grated, add enough cold water to form a dough, then wrap and chill.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Heat the salted butter and vegetable oil in a large pan. Add the onions halved and finely sliced and cook until soft. Stir in half of the bunch of thyme leaves picked and the plain flour, then gradually add the vegetable stock. Simmer until thickened, about 10 minutes, and stir in the wholegrain mustard and white wine vinegar.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Cook the potatoes (we used Maris Piper) in boiling water until tender, then drain and roughly mash. Stir in the apples peeled and mature cheddar grated, followed by the onion sauce.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Heat the oven to 375°F. Transfer the filling to a pie dish. Roll out about two-thirds of the pastry on a lightly floured surface and use it to line the dish. Add the filling, roll out the remaining pastry for the lid, and place it on top. Seal and trim the edge, cut a small vent, and brush with the egg beaten. Scatter over the remaining thyme leaves picked.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Bake until the pastry is golden and the center is bubbling and fully set, reaching at least 160°F. Let the pie cool briefly before serving.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Cool for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
