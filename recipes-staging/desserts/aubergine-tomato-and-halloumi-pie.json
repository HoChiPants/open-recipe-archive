  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F (200°C). Brush the aubergine rounds with some of the oil and arrange them in a baking dish or on a tray."
    },
    {
      "step": 2,
      "text": "Heat the remaining oil in a large pan. Sauté the onion for 8 minutes, then add the garlic and coriander. Stir in the tomatoes, pomegranate molasses or balsamic vinegar, and half the mint.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Simmer the tomato mixture for 15 minutes, stirring occasionally, until thick. Stir in the remaining mint and let the filling cool slightly.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Brown the halloumi slices in a hot ovenproof pan or under a hot grill for about 5 minutes, turning as needed, until golden.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Layer the aubergine, tomato filling, halloumi, and toasted pine nuts in a pie dish. Cover with the puff pastry, trim or tuck the edges, and cut a few vents in the top."
    },
    {
      "step": 6,
      "text": "Brush the pastry with beaten egg and sprinkle with sesame seeds. Bake for 35 minutes, until deeply golden and the center reaches 160°F (71°C) and is fully set.",
      "timer_minutes": 35
    }
  ],
