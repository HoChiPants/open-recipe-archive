  "id": "aubergine-tomato-and-halloumi-pie",
  "name": "Aubergine, Tomato and Halloumi Pie",
  "subtitle": "A savory vegetable pie with crisp pastry",
  "description": "Layer roasted aubergine, tomato filling, and halloumi beneath puff pastry for a richly flavored vegetarian pie.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
