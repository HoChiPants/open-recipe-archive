  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Stir the flour and baking soda together in a bowl."
    },
    {
      "step": 2,
      "text": "Beat the butter, brown sugar, instant vanilla pudding mix, and white sugar until smooth. Whisk in the eggs and vanilla extract."
    },
    {
      "step": 3,
      "text": "Add the flour mixture and whisk just until combined. Fold in the white chocolate chips and dried cranberries."
    },
    {
      "step": 4,
      "text": "Portion the dough onto prepared baking sheets, leaving space between portions. Bake for about 10–12 minutes, until golden brown and the centers are firm and fully set.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Let the cookies cool on the baking sheets for 10 minutes before serving or transferring.",
      "timer_minutes": 10
    }
  ],
