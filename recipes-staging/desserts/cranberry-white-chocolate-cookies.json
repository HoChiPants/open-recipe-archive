  "id": "cranberry-white-chocolate-cookies",
  "name": "Cranberry White Chocolate Cookies",
  "subtitle": "Soft cookies with tart cranberries and creamy white chocolate",
  "description": "A straightforward drop-cookie recipe combining brown sugar, vanilla pudding mix, white chocolate chips, and dried cranberries.",
  "meal_type": "dessert",
