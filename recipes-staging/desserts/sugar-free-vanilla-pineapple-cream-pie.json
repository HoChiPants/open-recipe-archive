  "id": "sugar-free-vanilla-pineapple-cream-pie",
  "name": "Sugar-Free Vanilla Pineapple Cream Pie",
  "subtitle": "A chilled pineapple pie with vanilla cream and pecans",
  "description": "A simple no-bake pie made with sugar-free vanilla pudding, crushed pineapple, whipped topping, and chopped pecans in a graham cracker crust.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "9-inch-prepared-graham-cracker-crust",
      "item": "(9 inch) prepared graham cracker crust",
      "quantity": 1
    },
    {
      "ingredient_id": "sugar-free-instant-vanilla-pudding-mix",
      "item": "sugar-free instant vanilla pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1 ounce"
    },
    {
      "ingredient_id": "cold-milk",
      "item": "cold milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "pineapple",
      "item": "pineapple",
      "quantity": 1,
      "unit": "can",
      "preparation": "8 ounce, crushed, drained"
    },
    {
      "ingredient_id": "8-ounce-container-frozen-whipped-topping",
      "item": "(8 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the pudding mix and cold milk until smooth and thickened."
    },
    {
      "step": 2,
      "text": "Fold in the drained pineapple, thawed whipped topping, and chopped pecans until evenly combined."
    },
    {
      "step": 3,
      "text": "Spoon the filling into the prepared graham cracker crust and smooth the top."
    },
    {
      "step": 4,
      "text": "Refrigerate for 120 minutes, or until firm enough to slice.",
      "timer_minutes": 120
    }
  ],
