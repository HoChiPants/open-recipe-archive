  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking tray."
    },
    {
      "step": 2,
      "text": "Combine the beans, sliced sausages, passata, oregano, spring onions, and sugar."
    },
    {
      "step": 3,
      "text": "Cut the pastry into portions, place the filling in the center, and fold the pastry over it."
    },
    {
      "step": 4,
      "text": "Add the grated cheddar, fold the pastry closed, and seal the edges."
    },
    {
      "step": 5,
      "text": "Cut a small opening in each pie, brush with beaten egg, and chill the assembled pies for 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 6,
      "text": "Preheat the oven again, then bake the pies for 40 minutes until golden, with the egg wash fully set; the filling should reach 160°F if checked with a thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Cool for 5 minutes and serve with salad.",
      "timer_minutes": 5
    }
  ],
