  "id": "einkorn-banana-bread",
  "name": "Einkorn Banana Bread",
  "subtitle": "A tender loaf with cinnamon and walnuts",
  "description": "Mashed ripe bananas, melted butter, and einkorn flour make a warmly spiced quick bread for ten servings.",
  "meal_type": "dessert",
  "cuisine": "American",
