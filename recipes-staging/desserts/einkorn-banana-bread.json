  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a loaf pan."
    },
    {
      "step": 2,
      "text": "Whisk the sugar into the melted butter. Beat in the eggs, milk, and vanilla until combined."
    },
    {
      "step": 3,
      "text": "In a separate bowl, mix the sifted einkorn flour with the cinnamon, baking soda, baking powder, and salt."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the butter mixture and stir just until smooth. Fold in the mashed bananas and chopped walnuts."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake at 350°F until the center reaches 195°F.",
      "timer_minutes": 55
    },
    {
      "step": 6,
      "text": "Let the loaf cool in the pan for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
