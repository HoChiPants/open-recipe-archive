  "id": "whipped-cream-filling",
  "name": "Whipped Cream Filling",
  "subtitle": "A lightly sweetened, stabilized cream filling",
  "description": "Use this airy filling for cakes, pastries, or other desserts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
