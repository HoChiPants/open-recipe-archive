    "prep_minutes": 10,
    "cook_minutes": 1
  },
  "ingredients": [
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "pint"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "unflavored-gelatin",
      "item": "unflavored gelatin",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the gelatin into the cold water in a small heatproof container. Warm gently for about 1 minute, stirring until dissolved; let it cool slightly.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Whip the heavy cream and confectioners' sugar until soft peaks form."
    },
    {
      "step": 3,
      "text": "With the mixer running, gradually add the dissolved gelatin. Continue whipping until stiff peaks form."
    }
  ],
