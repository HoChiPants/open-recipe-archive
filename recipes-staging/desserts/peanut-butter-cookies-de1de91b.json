  "id": "peanut-butter-cookies-de1de91b",
  "name": "Peanut Butter Cookies",
  "subtitle": "Soft-centered cookies with peanut butter and chips",
  "description": "Classic American cookies combining creamy peanut butter, peanut butter chips, and a lightly sweetened dough.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 60,
    "unit": "servings"
  },
