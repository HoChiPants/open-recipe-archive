  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a 24-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Whisk the flour, white sugar, cocoa powder, baking soda, and salt in a large bowl."
    },
    {
      "step": 3,
      "text": "Stir together the water, vegetable oil, vinegar, and vanilla, then add this mixture to the dry ingredients and stir until combined."
    },
    {
      "step": 4,
      "text": "In a separate bowl, whisk the softened cream cheese, egg, white sugar, and salt until smooth; stir in the chocolate chips."
    },
    {
      "step": 5,
      "text": "Divide the cocoa batter among the muffin cups and place some of the cream cheese mixture in the center of each."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until the centers are firm and the egg-containing filling reaches 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Cool the cupcakes before serving."
    }
  ],
