  "id": "chocolate-cream-cheese-cupcakes-7af46b88",
  "name": "Chocolate Cream Cheese Cupcakes",
  "subtitle": "Tender cocoa cupcakes with a chocolate-chip cream cheese center",
  "description": "Cocoa cupcakes are filled with a lightly sweetened cream cheese mixture and baked until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 25
  },
  "ingredients": [
