  "instructions": [
    {
      "step": 1,
      "text": "Mix the flour, 2 tablespoons of the divided sugar, and salt. Cut in the shortening until crumbly, then whisk the egg with the cold water and add it to form a dough."
    },
    {
      "step": 2,
      "text": "Divide and shape the dough into portions, then chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Heat the oven to 350°F. Roll one portion of dough to fit the bottom of the baking dish, transfer it to the dish, and bake until golden brown, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Combine the peaches with the orange and lemon juices. Melt the 1/2 cup butter, then stir in the remaining 2 tablespoons divided sugar, the 2 cups sugar, cornstarch, cinnamon, and nutmeg. Mix with the peaches and transfer the filling over the baked crust."
    },
    {
      "step": 5,
      "text": "Roll the remaining dough, place it over the filling, cut vents, and brush with the melted 1 tablespoon butter. Bake for about 40 minutes, until golden brown and the center is fully set; verify the egg-containing cobbler reaches 160°F with a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Cool briefly before serving."
    }
  ],
