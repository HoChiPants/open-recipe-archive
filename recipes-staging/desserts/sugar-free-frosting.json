  "id": "sugar-free-frosting",
  "name": "Sugar-Free Frosting",
  "subtitle": "Creamy pudding-based frosting for cakes and cupcakes",
  "description": "A quick, smooth frosting made by thickening sugar-free pudding with milk, blending it with cream cheese, and folding in whipped topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "sugar-free-instant-pudding-mix",
      "item": "sugar-free instant pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1.4 ounce"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "8-ounce-container-lite-frozen-whipped-topping",
      "item": "(8 ounce) container lite frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the sugar-free instant pudding mix with the milk until combined and thickened."
    },
    {
      "step": 2,
      "text": "Beat the cream cheese until smooth, then mix in the thickened pudding mixture until evenly combined."
    },
    {
      "step": 3,
      "text": "Fold in the thawed lite frozen whipped topping until the frosting is uniform and airy."
    }
  ],
