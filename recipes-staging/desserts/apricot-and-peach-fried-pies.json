  "id": "apricot-and-peach-fried-pies",
  "name": "Apricot and Peach Fried Pies",
  "subtitle": "Crisp hand pies with a sweet dried-fruit filling",
  "description": "Tender pastry encloses a cooked apricot-and-peach filling, then fries until golden and crisp.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
