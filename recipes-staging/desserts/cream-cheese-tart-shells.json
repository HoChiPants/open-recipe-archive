  "id": "cream-cheese-tart-shells",
  "name": "Cream Cheese Tart Shells",
  "subtitle": "Tender pastry shells for sweet fillings",
  "description": "A simple cream cheese pastry pressed into tart molds and baked until lightly golden.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 20,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 3,
      "unit": "ounces",
      "preparation": "softened"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened butter and cream cheese until smooth."
    },
    {
      "step": 2,
      "text": "Stir in the flour to form a soft dough."
    },
    {
      "step": 3,
      "text": "Cover and chill the dough for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 5,
      "text": "Divide the chilled dough among 24 tart molds and press it evenly over the bottoms and sides."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, until the shells are lightly golden and set.",
      "timer_minutes": 20
    }
  ],
