  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter and sugar until blended. Add the eggs and whisk until smooth, then mix in the melted chocolate and vanilla."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the flour, baking powder, and salt. Stir the dry mixture into the chocolate mixture just until incorporated, then fold in the walnuts."
    },
    {
      "step": 4,
      "text": "Spread the batter in the prepared pan and bake for 45 minutes, until the center is firm and fully set; a thermometer should read 160°F for the egg mixture.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Let the brownies cool for 30 minutes before cutting into squares.",
      "timer_minutes": 30
    }
  ],
