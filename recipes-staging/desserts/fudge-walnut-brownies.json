  "id": "fudge-walnut-brownies",
  "name": "Fudge Walnut Brownies",
  "subtitle": "Rich chocolate squares with a walnut crunch",
  "description": "A simple batch of fudgy brownies made with melted unsweetened chocolate and coarsely chopped walnuts.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
