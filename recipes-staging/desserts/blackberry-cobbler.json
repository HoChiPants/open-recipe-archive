  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the fresh blackberries in a baking dish."
    },
    {
      "step": 3,
      "text": "Combine the yellow cake mix and softened butter until crumbly, then scatter the mixture over the blackberries."
    },
    {
      "step": 4,
      "text": "Bake for 30 minutes, until the topping is golden brown.",
