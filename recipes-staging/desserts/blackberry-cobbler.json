  "id": "blackberry-cobbler",
  "name": "Blackberry Cobbler",
  "subtitle": "A simple berry dessert with a golden crumb topping",
  "description": "Fresh blackberries bake beneath a buttery yellow cake-mix topping for an easy warm dessert.",
  "meal_type": "dessert",
  "yield": {
