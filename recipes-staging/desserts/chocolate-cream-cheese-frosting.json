  "id": "chocolate-cream-cheese-frosting",
  "name": "Chocolate Cream Cheese Frosting",
  "subtitle": "A smooth cocoa frosting with cream cheese and cinnamon.",
  "description": "Whisk together a rich chocolate frosting for cakes, cupcakes, and other desserts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk together the confectioners' sugar, cream cheese, cocoa powder, butter, vanilla extract, and cinnamon until smooth."
    },
    {
      "step": 2,
      "text": "Whisk in the milk until the frosting is smooth and spreadable."
    },
    {
      "step": 3,
      "text": "Transfer the frosting to a container or use it immediately to frost desserts."
    }
  ],
