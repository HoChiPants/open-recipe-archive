{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "basic-pie-crust-dough",
  "name": "Basic Pie Crust Dough",
  "subtitle": "A tender, all-purpose crust for homemade pies",
  "description": "A simple pastry dough made with lard, egg, and vinegar, ready to shape for pie baking.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 32,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lard",
      "item": "lard",
      "quantity": 1.6666699647903,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large",
      "preparation": "beaten"
    },
    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, salt, and baking powder in a large bowl."
    },
    {
      "step": 2,
      "text": "Cut the lard into the dry ingredients until the mixture is crumbly."
    },
    {
      "step": 3,
      "text": "Whisk the water and vinegar together, then stir in the beaten egg."
    },
    {
      "step": 4,
      "text": "Stir the liquid mixture into the flour mixture just until a dough forms."
    },
    {
      "step": 5,
      "text": "Turn the dough onto a lightly floured surface, shape it into portions for pie crusts, and transfer them to pie plates. Bake the assembled pie according to its recipe until the crust is fully set and the egg reaches 160°F."
    }
  ],
