  "instructions": [
    {
      "step": 1,
      "text": "Layer the flour, oats, baking soda, salt, brown sugar, white sugar, cranberries, white chocolate chips, and pecans in a container."
    },
    {
      "step": 2,
      "text": "Add the butter, egg, and vanilla extract, then mix until a cohesive dough forms."
    },
    {
      "step": 3,
      "text": "Portion the dough onto a baking sheet and bake until the cookies are set and the center reaches 160°F on a food thermometer."
    },
    {
      "step": 4,
      "text": "Cool briefly before serving."
