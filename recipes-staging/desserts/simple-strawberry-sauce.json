  "id": "simple-strawberry-sauce",
  "name": "Simple Strawberry Sauce",
  "subtitle": "A fresh, lightly sweetened berry topping",
  "description": "Sliced strawberries rest with sugar until juicy, then chill into a simple sauce for desserts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
