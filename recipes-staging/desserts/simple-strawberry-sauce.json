  "ingredients": [
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 2,
      "unit": "quarts",
      "preparation": "cleaned, hulled and sliced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the cleaned, hulled, sliced strawberries in a bowl."
    },
    {
      "step": 2,
      "text": "Add the white sugar and stir gently to coat the berries."
    },
    {
      "step": 3,
      "text": "Let the mixture stand until the strawberries release their juices.",
