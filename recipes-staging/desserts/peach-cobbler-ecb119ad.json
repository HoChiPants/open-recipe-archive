  "id": "peach-cobbler-ecb119ad",
  "name": "Peach Cobbler",
  "subtitle": "A warm, golden dessert with tender peaches",
  "description": "Juicy peaches are topped with a simple buttered batter and baked until golden and fully set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "peaches-in-juice",
      "item": "peaches in juice",
      "quantity": 1,
      "unit": "can",
      "preparation": "29 ounce, sliced, drained, reserving juice"
    },
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the drained peaches and their reserved juice in a baking dish."
    },
    {
      "step": 3,
      "text": "Whisk the flour and sugar together in a bowl. Stir in the egg and melted butter until combined."
    },
    {
      "step": 4,
      "text": "Spread the batter over the peaches."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, until golden brown and the center is firm and reaches 160°F.",
      "timer_minutes": 45
    }
  ],
