{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "brownie-frosting",
  "name": "Brownie Frosting",
  "subtitle": "Quick chocolate topping for brownies",
  "description": "A smooth chocolate frosting made by heating sugar, milk, and butter, then melting in chocolate chips and vanilla.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 6,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "chocolate-chips",
      "item": "chocolate chips",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "dash"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sugar, milk, and softened butter in a saucepan and heat until the mixture reaches a simmer."
    },
    {
      "step": 2,
      "text": "Remove from the heat, then add the chocolate chips and vanilla extract."
    },
    {
      "step": 3,
      "text": "Stir until the chocolate is completely melted and the frosting is smooth."
    },
    {
      "step": 4,
      "text": "Transfer the frosting to the brownies and spread as desired."
    }
  ],
