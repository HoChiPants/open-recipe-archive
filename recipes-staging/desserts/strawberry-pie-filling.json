{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "strawberry-pie-filling",
  "name": "Strawberry Pie Filling",
  "subtitle": "A glossy, lightly tart filling for a classic pie",
  "description": "Fresh strawberries are folded into a thickened berry syrup and chilled until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "mashed-strawberries",
      "item": "mashed strawberries",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "or more if needed"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "strawberry",
      "item": "strawberries",
      "quantity": 4,
      "unit": "cups",
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the sugar, cornstarch, lemon juice, and salt together in a saucepan. Stir in the mashed strawberries and water until smooth."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a simmer over medium heat, stirring frequently, and cook until thickened.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Continue simmering until the filling is fully thick and glossy.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Fold in the sliced strawberries until evenly coated."
    },
    {
      "step": 5,
      "text": "Chill the filling until set before using."
    }
  ],
