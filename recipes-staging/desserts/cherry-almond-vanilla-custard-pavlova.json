  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven and prepare a lined baking tray. Set aside the reserved lemon half."
    },
    {
      "step": 2,
      "text": "Whisk the egg whites until foamy, then gradually add the 350 g caster sugar and continue whisking until thick and glossy, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Whisk in the lemon juice, 2 tsp cornflour, and 1 tsp vanilla extract. Shape the meringue into a large round on the tray."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, then turn off the oven and leave the pavlova inside until cool.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Warm the double cream and milk. Separately whisk the egg yolks with the 100 g caster sugar, 2 tbsp cornflour, 2 tbsp vanilla extract, and icing sugar."
    },
    {
      "step": 6,
      "text": "Gradually whisk the warm dairy into the yolk mixture, return it to the pan, and cook gently, stirring, until thickened. Continue heating until the custard reaches 160°F or has a firm, fully set center.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Transfer the custard to a bowl, cover its surface, and chill until thick."
    },
    {
      "step": 8,
      "text": "Prepare the cherries with the remaining icing sugar, optional cherry liqueur, and cherry jam or compote. Let the mixture stand for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 9,
      "text": "Whisk the chilled custard until smooth. Spoon it over the cooled pavlova, then add the cherries and toasted flaked almonds."
    },
    {
      "step": 10,
      "text": "Serve immediately."
    }
  ],
