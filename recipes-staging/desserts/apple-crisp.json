  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the flour, oats, cinnamon, nutmeg, and brown sugar."
    },
    {
      "step": 3,
      "text": "Cut the butter into the dry mixture until it forms a coarse crumble."
    },
    {
      "step": 4,
      "text": "Arrange the apples in a baking dish and cover evenly with the topping."
    },
    {
      "step": 5,
      "text": "Bake until the apples are tender and the topping is browned, about 45 minutes.",
