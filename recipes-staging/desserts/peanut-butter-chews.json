  "ingredients": [
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "light-corn-syrup",
      "item": "light corn syrup",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornflakes-cereal",
      "item": "cornflakes cereal",
      "quantity": 3,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the peanut butter, light corn syrup, and white sugar together in a saucepan over medium heat, stirring until smooth and combined."
    },
    {
      "step": 2,
      "text": "Remove from the heat and fold in the cornflakes cereal until evenly coated."
    },
    {
      "step": 3,
      "text": "Portion the mixture into 12 servings and let stand until firm enough to handle."
    }
  ],
