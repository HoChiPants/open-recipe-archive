  "id": "peanut-butter-chews",
  "name": "Peanut Butter Chews",
  "subtitle": "A crisp, chewy peanut butter confection",
  "description": "Peanut butter, corn syrup, sugar, and cornflakes combine into an easy molded dessert with a crisp texture.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
