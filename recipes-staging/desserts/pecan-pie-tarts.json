  "id": "pecan-pie-tarts",
  "name": "Pecan Pie Tarts",
  "subtitle": "Individual brown-sugar pecan pastries",
  "description": "Cream-cheese pastry shells hold a buttery pecan filling and bake until lightly browned and set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 6,
      "unit": "ounces"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1.75,
      "unit": "cups",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Whisk the cream cheese and 1 cup softened butter until smooth. Blend in the flour to form a smooth dough, then shape it into tart shells."
    },
    {
      "step": 3,
      "text": "Whisk the remaining softened butter with the brown sugar. Add the eggs and vanilla extract, whisking until combined, then stir in the pecans."
    },
    {
      "step": 4,
      "text": "Fill the prepared shells with the pecan mixture."
    },
    {
      "step": 5,
      "text": "Bake until lightly browned and the center is fully set, reaching 160°F, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Cool before serving."
    }
  ],
