  "id": "raspberry-shortbread-sandwich-cookies",
  "name": "Raspberry Shortbread Sandwich Cookies",
  "subtitle": "Buttery shortbread layered with raspberry preserves and finished with cherry-topped icing.",
  "description": "Tender shortbread rounds are sandwiched with raspberry preserves, glazed with a simple milk icing, and decorated with maraschino cherries.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "cups",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "raspberry-preserves",
      "item": "raspberry preserves",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "maraschino-cherries",
      "item": "maraschino cherries",
      "quantity": 24
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 8,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Whisk the softened butter, white sugar, and confectioners' sugar until smooth."
    },
    {
      "step": 2,
      "text": "Stir in the sifted flour to form a dough. Shape it into a workable sheet and cut into rounds."
    },
    {
      "step": 3,
      "text": "Arrange the rounds on baking sheets and bake until set and lightly colored, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Cool the cookies on the baking sheets for 5 minutes, then transfer them to a rack.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Spread raspberry preserves on half of the cookies and place the remaining cookies on top."
    },
    {
      "step": 6,
      "text": "Stir the confectioners' sugar with the milk to make a smooth icing. Spoon icing over the sandwiches and top each with a maraschino cherry."
    }
  ],
