  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Prepare baking sheets for the dough."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter and packed brown sugar until smooth. Whisk in the eggs and vanilla extract."
    },
    {
      "step": 3,
      "text": "Combine the flour, baking soda, and salt separately, then stir the dry mixture into the butter mixture until just incorporated."
    },
    {
      "step": 4,
      "text": "Fold in the rolled oats, semisweet chocolate chips, vanilla baking chips, butterscotch chips, and pecans. Portion the dough onto the prepared sheets."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, until the cookies are set at the edges.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Cool the cookies on the sheets for 5 minutes before transferring them to a rack.",
      "timer_minutes": 5
    }
  ],
