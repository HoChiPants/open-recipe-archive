{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "walnut-tassies",
  "name": "Walnut Tassies",
  "subtitle": "Tender pastry cups with a brown sugar and walnut filling",
  "description": "Small cream cheese pastry shells filled with a rich walnut mixture and baked until lightly browned.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-butter",
      "item": "sweet butter",
      "quantity": 0.5,
      "unit": "pound"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 6,
      "unit": "ounces",
      "preparation": "softened"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "dark-brown-sugar",
      "item": "dark brown sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Beat the sweet butter and softened cream cheese until smooth. Mix in the flour to form a soft dough."
    },
    {
      "step": 3,
      "text": "Divide the dough into 36 portions and press each into a small cup shape in a muffin pan."
    },
    {
      "step": 4,
      "text": "Whisk the melted butter, dark brown sugar, eggs, and vanilla extract until combined, then stir in the chopped walnuts."
    },
    {
      "step": 5,
      "text": "Fill the pastry cups with the walnut mixture."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until the tops are lightly browned and the centers are fully set.",
      "timer_minutes": 25
    }
  ],
