  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking pan for the cake."
    },
    {
      "step": 2,
      "text": "Toss the raspberries with the brown sugar and set aside."
    },
    {
      "step": 3,
      "text": "Whisk the flour, white sugar, baking powder, baking soda, and salt together."
    },
    {
      "step": 4,
      "text": "Stir in the sour cream, melted butter, 1 teaspoon vanilla extract, and egg just until the batter is combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and distribute the raspberries over the top. Sprinkle with the sliced almonds."
    },
    {
      "step": 6,
      "text": "Bake for 40 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Cool the cake for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Stir the sifted confectioners' sugar with the milk and ¼ teaspoon vanilla extract until smooth. Drizzle over the cake and serve."
    }
  ],
