  "id": "raspberry-almond-coffee-cake",
  "name": "Raspberry Almond Coffee Cake",
  "subtitle": "Tender cake with berries, almonds, and a simple vanilla glaze",
  "description": "A soft sour-cream coffee cake layered with sweet raspberries, finished with sliced almonds and a light glaze.",
  "meal_type": "dessert",
