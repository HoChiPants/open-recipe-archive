  "id": "coffee-brownies",
  "name": "Coffee Brownies",
  "subtitle": "Fudgy chocolate brownies with espresso depth",
  "description": "Rich, chocolate-forward brownies with condensed milk and espresso, baked until just set and cut into squares.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-plus-extra-for-the-tin",
      "item": "unsalted butter plus extra for the tin",
      "quantity": 185,
      "unit": "g"
    },
    {
      "ingredient_id": "condensed-milk",
      "item": "condensed milk",
      "quantity": 90,
      "unit": "ml"
    },
    {
      "ingredient_id": "espresso-powder-plus-1-tsp",
      "item": "espresso powder plus 1 tsp",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "dark-chocolate-at-least-70-cocoa-solids",
      "item": "dark chocolate (at least 70% cocoa solids)",
      "quantity": 185,
      "unit": "g",
      "preparation": "broken up"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 175,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 85,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 45,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grease the baking tin with the extra butter. Preheat the oven."
    },
    {
      "step": 2,
      "text": "Stir the condensed milk, espresso powder, and cocoa powder until smooth; set aside."
    },
    {
      "step": 3,
      "text": "Melt the butter and broken chocolate together over barely simmering water, or in short microwave intervals. Stir until smooth and cool slightly."
    },
    {
      "step": 4,
      "text": "Whisk the eggs and caster sugar until well combined."
    },
    {
      "step": 5,
      "text": "Fold the cooled chocolate mixture, plain flour, cocoa powder, and espresso powder into the egg mixture until smooth."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared tin and smooth the surface. Spoon or spread the condensed-milk mixture over it as directed by the mixture's consistency."
    },
    {
      "step": 7,
      "text": "Bake until the brownies are set around the edges and slightly soft in the center, about 20–25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 8,
      "text": "Cool, then cut into 16 squares."
    }
  ],
