      "item": "dark chocolate roughly chopped",
      "quantity": 125,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking tray."
    },
    {
      "step": 2,
      "text": "Spread the cereal on the tray and toast for 10 minutes. Let it cool.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the butter, light brown soft sugar, and caster sugar for 5 minutes until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Beat in the egg and vanilla extract."
    },
    {
      "step": 5,
      "text": "Mix in the flour and bicarbonate of soda, then fold in the toasted cereal and chopped dark chocolate."
    },
    {
      "step": 6,
      "text": "Portion and shape the dough on the prepared tray, leaving space between pieces."
    },
    {
      "step": 7,
      "text": "Bake for 12 minutes, until the edges are set and the centers are firm and no longer wet.",
      "timer_minutes": 12
    },
    {
      "step": 8,
      "text": "Cool the cookies on the tray until firm enough to handle."
    }
  ],
