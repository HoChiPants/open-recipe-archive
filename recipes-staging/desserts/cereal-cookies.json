  "id": "cereal-cookies",
  "name": "Cereal Cookies",
  "subtitle": "Crisp-edged cookies with toasted cereal and dark chocolate",
  "description": "Toasted cereal, brown sugar, and dark chocolate add texture and flavor to these simple cookies.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 22
  },
  "ingredients": [
    {
      "ingredient_id": "cereal",
      "item": "cereal",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 85,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 75,
      "unit": "g"
    },
    {
