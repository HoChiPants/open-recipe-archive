  "id": "pistachio-cream-pie",
  "name": "Pistachio Cream Pie",
  "subtitle": "A chilled pistachio dessert with a nutty baked crust",
  "description": "Bake a walnut-pistachio crust, layer it with a sweet cream cheese mixture and thickened pistachio pudding, then chill before serving.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 20,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "16-ounce-container-frozen-whipped-topping",
      "item": "(16 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "instant-pistachio-pudding-mix",
      "item": "instant pistachio pudding mix",
      "quantity": 2,
      "unit": "package",
      "preparation": "3 ounce"
    },
    {
      "ingredient_id": "cold-milk",
      "item": "cold milk",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "maraschino-cherries",
      "item": "maraschino cherries",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "pistachio-nuts",
      "item": "pistachio nuts",
      "quantity": 0.125,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the flour, walnuts, softened butter, and chopped pistachio nuts until a crumbly dough forms. Press the mixture into a pie dish."
    },
    {
      "step": 3,
      "text": "Bake until lightly browned, about 30 minutes. Cool completely.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Beat the cream cheese, vanilla, confectioners' sugar, and thawed whipped topping until smooth."
    },
    {
      "step": 5,
      "text": "Transfer the cream cheese mixture to the cooled crust and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Whisk the pudding mix with the cold milk until thick, then whisk it with the cream cheese mixture until combined."
    },
    {
      "step": 7,
      "text": "Add the whipped topping, maraschino cherries, and chopped pistachio nuts, then chill until set."
    }
  ],
