  "id": "pumpkin-chocolate-chip-cookies",
  "name": "Pumpkin Chocolate Chip Cookies",
  "subtitle": "Soft pumpkin cookies with semisweet chocolate chips",
  "description": "A simple American cookie made with pumpkin puree, warm cinnamon, and semisweet chocolate chips.",
  "meal_type": "dessert",
  "cuisine": "American",
