  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine the baking powder and baking soda with the flour, cinnamon, and salt."
    },
    {
      "step": 3,
      "text": "Whisk the sugar, pumpkin puree, oil, eggs, milk, and vanilla until smooth."
    },
    {
      "step": 4,
      "text": "Stir the dry ingredients into the pumpkin mixture until combined."
    },
    {
      "step": 5,
      "text": "Fold in the chocolate chips, then transfer the dough to a baking sheet in cookie portions."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes.",
      "timer_minutes": 10
    }
  ],
