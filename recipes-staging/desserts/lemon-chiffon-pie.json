  "id": "lemon-chiffon-pie",
  "name": "Lemon Chiffon Pie",
  "subtitle": "A light, lemony pie with a softly airy filling",
  "description": "Gelatin-set lemon filling folded with whipped egg whites and chilled in a prepared graham cracker crust.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10,
    "inactive_minutes": 135
  },
  "ingredients": [
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "unflavored-gelatin",
      "item": "unflavored gelatin",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 4
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 4
    },
    {
      "ingredient_id": "9-inch-prepared-graham-cracker-crust",
      "item": "(9 inch) prepared graham cracker crust",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour the cold water into a small bowl, sprinkle in the gelatin, and let it stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk the egg yolks with half of the sugar, lemon juice, salt, and lemon zest until smooth."
    },
    {
      "step": 3,
      "text": "Stir the bloomed gelatin into the lemon mixture until evenly combined, then cool for about 15 minutes, until set.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Whisk the egg whites with the remaining sugar until soft peaks form."
    },
    {
      "step": 5,
      "text": "Fold the whipped egg whites into the set lemon mixture until no streaks remain."
    },
    {
      "step": 6,
      "text": "Spoon the filling into the prepared graham cracker crust and chill until firm, about 2 hours. Before serving, confirm the center is firm and fully set.",
      "timer_minutes": 120
    },
    {
      "step": 7,
      "text": "Whisk briefly before serving if needed to loosen the filling."
    }
  ],
