  "instructions": [
    {
      "step": 1,
      "text": "In a slow cooker, stir together 4 cups milk, sugar, and rice. Add the margarine, cover, and cook until the rice is tender, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Whisk the egg with the remaining 2 tablespoons milk, vanilla extract, almond extract, and salt."
    },
    {
      "step": 3,
      "text": "Whisk a small amount of the hot rice mixture into the egg mixture, then stir it back into the slow cooker. Continue cooking until the pudding is thickened and reaches 160°F in the center."
    },
    {
      "step": 4,
      "text": "Transfer the pudding to a serving container and chill before serving.",
      "timer_minutes": 60
    }
  ],
