  "id": "slow-cooker-rice-pudding",
  "name": "Slow Cooker Rice Pudding",
  "subtitle": "Creamy rice pudding with vanilla and almond notes",
  "description": "A gently cooked rice pudding finished with a lightly flavored egg mixture and chilled until spoonable.",
  "meal_type": "dessert",
  "cuisine": "American",
