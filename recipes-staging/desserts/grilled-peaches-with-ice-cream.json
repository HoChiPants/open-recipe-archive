  "id": "grilled-peaches-with-ice-cream",
  "name": "Grilled Peaches with Ice Cream",
  "subtitle": "Warm, caramelized fruit with a cool creamy topping",
  "description": "Grill ripe peach halves until tender and lightly marked, then serve them with scoops of ice cream.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-ripe-peaches",
      "item": "fresh ripe peaches",
      "quantity": 4
    },
    {
      "ingredient_id": "vegetable-oil-for-brushing",
      "item": "Vegetable oil for brushing"
    },
    {
      "ingredient_id": "scoops-ice-cream",
      "item": "scoops ice cream",
      "quantity": 8,
      "preparation": "such as Market Pantry Vanilla Bean or Sea Salt Caramel Pretzel Ice Cream"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill to medium-high heat."
    },
    {
      "step": 2,
      "text": "Halve the peaches, remove the pits, and cut each half as desired for grilling. Brush the cut surfaces lightly with vegetable oil."
    },
    {
      "step": 3,
      "text": "Place the peaches on the grill and cook until marked, about 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Turn the peaches and grill until tender, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Whisk the ice cream briefly only if needed to soften, then serve the grilled peaches with the scoops."
    }
  ],
