  "id": "chocolate-cookie-crust",
  "name": "Chocolate Cookie Crust",
  "subtitle": "A crisp cocoa base for chilled or baked desserts",
  "description": "Mix a simple cocoa dough, press it into an even crust, and bake until firm.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Whisk the sugar, flour, cocoa powder, and salt until evenly combined."
    },
    {
      "step": 3,
      "text": "Stir in the melted butter until a cohesive mixture forms."
    },
    {
      "step": 4,
      "text": "Press the mixture evenly into the intended baking pan to form the crust."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, until firm.",
      "timer_minutes": 10
    }
  ],
