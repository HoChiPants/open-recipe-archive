  "instructions": [
    {
      "step": 1,
      "text": "Butter and line a square baking tin. Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Mix 60 g flour, 75 g brown sugar, 1 tsp espresso powder, and 1/2 tsp cardamom. Rub in the cubed butter until coarse crumbs form; chill."
    },
    {
      "step": 3,
      "text": "Mix the remaining streusel ingredients—150 g brown sugar, 2 tbsp flour, 1/2 tsp cardamom, and 1 tsp espresso powder—in a separate bowl."
    },
    {
      "step": 4,
      "text": "Whisk the 100 g butter with the caster sugar and 50 g brown sugar until light and creamy, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Whisk in the eggs, soured cream, and vanilla until smooth."
    },
    {
      "step": 6,
      "text": "Combine 225 g flour, baking powder, 2 tsp espresso powder, and 1 tsp cardamom. Fold the dry mixture into the batter until just combined."
    },
    {
      "step": 7,
      "text": "Spread half the batter in the tin, add the dry streusel mixture, then cover with the remaining batter. Top with the chilled crumbs."
    },
    {
      "step": 8,
      "text": "Bake until risen and a skewer inserted in the center comes out clean, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 9,
      "text": "Cool in the tin for 20 minutes, then cut into squares and serve.",
      "timer_minutes": 20
    }
  ],
