  "id": "brown-sugar-pound-cake",
  "name": "Brown Sugar Pound Cake",
  "subtitle": "A rich, nut-studded cake with caramel-like sweetness",
  "description": "A tender American pound cake made with brown sugar, butter, milk, and chopped pecans.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "light-brown-sugar",
      "item": "light brown sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
