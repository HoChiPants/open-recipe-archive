      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 5
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Prepare the all-purpose flour, then combine it with the baking powder."
    },
    {
      "step": 2,
      "text": "Whisk the light brown sugar, white sugar, and butter until blended and creamy."
    },
    {
      "step": 3,
      "text": "Whisk in the eggs and vanilla extract."
    },
    {
      "step": 4,
      "text": "Whisk in the milk and flour mixture until the batter is smooth. Fold in the chopped pecans."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a prepared cake pan and bake until set in the center, about 75 minutes.",
      "timer_minutes": 75
    },
    {
      "step": 6,
      "text": "Cool the cake in the pan for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
