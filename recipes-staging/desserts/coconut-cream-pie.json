  "instructions": [
    {
      "step": 1,
      "text": "Whisk the sugar, flour, and salt in a saucepan. Gradually whisk in the milk until smooth."
    },
    {
      "step": 2,
      "text": "Cook over medium heat, stirring constantly, until the mixture thickens. Continue cooking for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Whisk the egg yolks in a bowl. Gradually whisk in some of the hot custard, then return the yolk mixture to the saucepan."
    },
    {
      "step": 4,
      "text": "Bring the custard back to a simmer and cook for 2 minutes, stirring constantly, until it reaches 160°F or has a firm, fully set center.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Remove from the heat and stir in the butter, vanilla extract, and flaked coconut."
    },
    {
      "step": 6,
      "text": "Pour the filling into the baked pie shell and chill for 4 hours, or until set.",
      "timer_minutes": 240
    }
  ],
