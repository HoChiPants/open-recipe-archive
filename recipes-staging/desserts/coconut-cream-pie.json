  "id": "coconut-cream-pie",
  "name": "Coconut Cream Pie",
  "subtitle": "Silky coconut custard in a baked pastry shell",
  "description": "A chilled pie made with coconut-studded vanilla custard and a crisp baked shell.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
