  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a square baking pan with parchment."
    },
    {
      "step": 2,
      "text": "Melt the unsalted butter in a saucepan over medium heat, cooking until golden brown and nutty, about 7 minutes. Cool slightly.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Whisk the plain flour and baking powder together."
    },
    {
      "step": 4,
      "text": "Combine the eggs, caster sugar, honey, and vanilla bean paste. Fold in the flour mixture, browned butter, and 80 ml whole milk until smooth."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 35 minutes, or until the center is firm and a tester comes out clean.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Cool the cake completely, then cut it into 20 squares."
    },
    {
      "step": 7,
      "text": "Whisk the melted unsalted butter, 120 ml whole milk, cocoa powder, and icing sugar together until smooth."
    },
    {
      "step": 8,
      "text": "Place the desiccated coconut in a shallow dish. Dip each cake square in the icing, then roll it in coconut."
    },
    {
      "step": 9,
      "text": "Set the coated squares aside for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
