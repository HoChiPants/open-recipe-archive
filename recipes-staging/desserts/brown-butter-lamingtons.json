  "id": "brown-butter-lamingtons",
  "name": "Brown Butter Lamingtons",
  "subtitle": "Tender sponge squares with cocoa icing and coconut",
  "description": "Bake a buttery sponge, cut it into squares, then dip each piece in cocoa icing and coat it with coconut.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
