      "item": "caster sugar",
      "quantity": 60,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F (180°C). Grease a cake tin with some of the oil."
    },
    {
      "step": 2,
      "text": "Mix the plain flour, 400 g caster sugar, baking powder, and 30 g cocoa powder in a bowl."
    },
    {
      "step": 3,
      "text": "Blend the carrots, eggs, and vegetable oil until smooth. Add this mixture to the dry ingredients and stir until combined.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Pour the batter into the prepared tin and bake until risen and the center is firm and fully set.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Let the cake cool in the tin briefly, then transfer it to a rack to cool completely."
    },
    {
      "step": 6,
      "text": "For the topping, heat the milk, 60 g caster sugar, and remaining cocoa powder in a saucepan, stirring until smooth."
    },
    {
      "step": 7,
      "text": "Cook and stir the topping until thickened.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Pour the warm topping over the cooled cake and spread it evenly. Let it set before serving."
    }
  ],
