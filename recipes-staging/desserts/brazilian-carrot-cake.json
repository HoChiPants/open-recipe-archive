  "id": "brazilian-carrot-cake",
  "name": "Brazilian Carrot Cake",
  "subtitle": "Tender carrot cake with a simple chocolate glaze",
  "description": "A moist carrot cake blended with eggs and oil, baked until set, then finished with a warm cocoa topping.",
  "meal_type": "dessert",
  "cuisine": "Brazilian",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil-plus-extra-for-the-tin",
      "item": "vegetable oil plus extra for the tin",
      "quantity": 250,
      "unit": "ml"
    },
