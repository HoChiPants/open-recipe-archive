  "id": "coffee-icing",
  "name": "Coffee Icing",
  "subtitle": "A smooth coffee-flavored icing for cakes and pastries",
  "description": "Whisk softened butter with brewed coffee and vanilla, then gradually incorporate confectioners' sugar until smooth and spreadable.",
