{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "strawberry-napoleons",
  "name": "Strawberry Napoleons",
  "subtitle": "Crisp pastry layered with strawberries and vanilla cream",
  "description": "Bake puff pastry until golden, then layer it with chilled vanilla pudding cream and sliced strawberries for an elegant fruit dessert.",
  "meal_type": "dessert",
  "cuisine": "French",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 15,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "instant-vanilla-pudding-and-pie-filling",
      "item": "instant vanilla pudding and pie filling",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.5 ounce"
    },
    {
      "ingredient_id": "cold-2-milk",
      "item": "cold 2% milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "non-dairy-whipped-topping",
      "item": "non-dairy whipped topping",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "thawed"
    },
    {
      "ingredient_id": "frozen-puff-pastry",
      "item": "frozen puff pastry",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "17.25 ounce, thawed"
    },
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 1,
      "unit": "pint",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Whisk the pudding mix with the cold milk until thickened. Fold in the whipped topping, then chill for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Unfold the thawed puff pastry, cut it into even rectangles, and arrange the pieces on a baking sheet. Dust with some confectioners' sugar."
    },
    {
      "step": 4,
      "text": "Bake until golden brown, about 15 minutes. Cool completely, then split or cut the pastry into layers.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Layer pastry, chilled pudding cream, and sliced strawberries, repeating as needed to form eight servings."
    },
    {
      "step": 6,
      "text": "Finish with the remaining confectioners' sugar and serve."
    }
  ],
