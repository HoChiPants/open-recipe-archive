  "id": "vanilla-cream-or-sauce",
  "name": "Vanilla Cream or Sauce",
  "subtitle": "Smooth vanilla custard for desserts",
  "description": "A lightly sweet vanilla custard that can be served as a cream or poured as a sauce.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10,
    "inactive_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 2.5,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or more as desired"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat half of the milk until simmering, about 5 minutes. Whisk the remaining milk with the cornstarch.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk the sugar and egg yolks until smooth. Gradually whisk in the hot milk, then return the mixture to the saucepan."
    },
    {
      "step": 3,
      "text": "Cook over gentle heat, whisking constantly, until thickened and the mixture reaches 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Remove from the heat and stir in the vanilla extract."
    },
    {
      "step": 5,
      "text": "Cool for 20 minutes, then refrigerate for 30 minutes before serving.",
      "timer_minutes": 50
    }
  ],
