  "instructions": [
    {
      "step": 1,
      "text": "Prepare the yellow cake mix according to the package directions."
    },
    {
      "step": 2,
      "text": "Set the cones upright in a stable baking setup and fill them with the prepared batter, leaving room for it to rise."
