  "id": "macadamia-nut-chocolate-chip-cookies",
  "name": "Macadamia Nut Chocolate Chip Cookies",
  "subtitle": "Crisp-edged cookies with toasted nuts and chocolate",
  "description": "Classic American drop cookies combining buttery brown-sugar dough, macadamias, and semisweet chocolate chips.",
  "meal_type": "dessert",
