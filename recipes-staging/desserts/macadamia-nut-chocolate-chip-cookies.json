  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter, packed dark brown sugar, and white sugar until smooth and creamy. Whisk in the egg and vanilla extract."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the sifted all-purpose flour, baking soda, and salt. Add the dry mixture to the butter mixture and blend just until combined."
    },
    {
      "step": 4,
      "text": "Stir in the chopped macadamia nuts and semisweet chocolate chips."
    },
    {
      "step": 5,
      "text": "Portion the dough onto baking sheets, leaving space between portions. Chill for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Bake for 12 minutes, until golden brown and the centers are fully set; if checked with a thermometer, they should reach 160°F.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Transfer the cookies to a rack and cool before serving."
    }
  ],
