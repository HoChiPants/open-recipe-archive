  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Fit the refrigerated pie crust into a pie dish and bake for 10 minutes, or until lightly golden. Cool for 30 minutes, then reduce the oven temperature to 375°F.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Slice the tomatoes thickly, layer them in a colander, and sprinkle with half of the kosher salt. Let them drain for 20 minutes, then pat dry.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Whisk the mayonnaise, softened cream cheese, lightly beaten egg, and half of the shredded Cheddar with the flour, garlic, cayenne, black pepper, remaining salt, and Parmesan until combined."
    },
    {
      "step": 4,
      "text": "Arrange the drained tomatoes in the cooled crust. Spread the cheese mixture over them and finish with the remaining shredded Cheddar."
    },
    {
      "step": 5,
      "text": "Bake for 35 minutes, until golden brown and the center is fully set and reaches 160°F.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Cool briefly, garnish with the sliced basil, and cut into wedges."
    }
  ],
