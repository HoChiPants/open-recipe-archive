  "id": "southern-tomato-pie",
  "name": "Southern Tomato Pie",
  "subtitle": "A savory tomato pie with a creamy cheese filling",
  "description": "Juicy tomatoes are layered in a prebaked crust with a seasoned cheese mixture, then baked until golden and set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
