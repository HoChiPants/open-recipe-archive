  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a baking tray."
    },
    {
      "step": 2,
      "text": "Melt the butter with the caster sugar, then stir in the flour to form a thick mixture. Beat in the egg gradually until smooth."
    },
    {
      "step": 3,
      "text": "Pipe or shape the mixture into a small ring on the tray and scatter over the flaked almonds."
    },
    {
      "step": 4,
      "text": "Bake for 15 minutes, then continue baking for 10 minutes until puffed, golden, and fully set. Confirm the center reaches at least 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Cool the pastry ring completely before filling.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Warm the custard with the chopped chocolate until the chocolate is melted and the mixture is smooth. Cool it until thick enough to spread."
    },
    {
      "step": 7,
      "text": "Whip the double cream with the golden caster sugar and vanilla until thick, then fold it into the cooled chocolate custard."
    },
    {
      "step": 8,
      "text": "Split the cooled pastry ring, fill it with the chocolate cream, replace the top, and dust with icing sugar to serve."
    }
  ],
