  "id": "chocolate-paris-brest",
  "name": "Chocolate Paris-Brest",
  "subtitle": "A crisp almond pastry ring with chocolate custard cream",
  "description": "Bake a golden almond pastry ring, fill it with chocolate custard cream, and finish with icing sugar.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 40
  },
