{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-peanut-butter-balls",
  "name": "Chocolate Peanut Butter Balls",
  "subtitle": "A no-bake confection with a crisp graham cracker center and chocolate coating.",
  "description": "Mix a smooth peanut butter filling with graham cracker crumbs, shape into balls, then coat in melted chocolate and chill until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "graham-cracker-crumbs",
      "item": "graham cracker crumbs",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "1-ounce-squares-semisweet-chocolate",
      "item": "(1 ounce) squares semisweet chocolate",
      "quantity": 3,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the peanut butter and confectioners' sugar together until smooth. Mix in the graham cracker crumbs."
    },
    {
      "step": 2,
      "text": "Shape the mixture into 36 small balls and arrange them on a lined tray."
    },
    {
      "step": 3,
      "text": "Melt the chocolate chips, chopped semisweet chocolate squares, and shortening together until smooth."
    },
    {
      "step": 4,
      "text": "Dip or roll the balls in the melted chocolate, then return them to the tray."
    },
    {
      "step": 5,
      "text": "Chill for 15 minutes, or until the coating is set.",
      "timer_minutes": 15
    }
  ],
