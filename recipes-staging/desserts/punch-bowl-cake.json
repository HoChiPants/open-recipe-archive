  "id": "punch-bowl-cake",
  "name": "Punch Bowl Cake",
  "subtitle": "A chilled, layered cake dessert with fruit, pudding, coconut, and whipped topping.",
  "description": "Bake a yellow cake, then layer it with vanilla pudding, fruit, coconut, whipped topping, and walnuts in a punch bowl. Chill before serving.",
  "meal_type": "dessert",
  "cuisine": "American",
