  "instructions": [
    {
      "step": 1,
      "text": "Prepare and bake the yellow cake mix according to the package directions, then cool completely and cut into pieces.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Whisk the pudding mixes with the milk until smooth and thickened."
    },
    {
      "step": 3,
      "text": "Place a layer of cake pieces in a punch bowl. Add layers of pudding, bananas, cherry pie filling, pineapple, and coconut; repeat as needed."
    },
    {
      "step": 4,
      "text": "Spread the whipped topping over the assembled dessert and sprinkle with walnuts."
    },
    {
      "step": 5,
      "text": "Cover and refrigerate until thoroughly chilled before serving.",
      "timer_minutes": 120
    }
  ],
