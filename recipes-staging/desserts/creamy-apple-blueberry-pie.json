  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Arrange the apples and blueberries in the unbaked pie crust."
    },
    {
      "step": 2,
      "text": "Mix the flour, white sugar, cinnamon, nutmeg, and salt. Stir the yogurt, egg, and vanilla extract into the mixture until smooth, then pour it over the fruit."
    },
    {
      "step": 3,
      "text": "Combine the flour, white sugar, pecans, rolled oats, and brown sugar. Cut in the butter until coarse crumbs form, then scatter the topping over the pie."
    },
    {
      "step": 4,
      "text": "Bake at 400°F for 15 minutes. Reduce the oven to 350°F and continue baking for 30 minutes, until lightly browned.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Continue baking for 15 minutes, until the topping is golden brown and the center reaches 160°F.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Cool the pie for 20 minutes before slicing.",
      "timer_minutes": 20
    }
  ],
