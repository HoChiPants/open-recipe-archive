  "id": "mincemeat-cookies",
  "name": "Mincemeat Cookies",
  "subtitle": "Tender cookies with spiced fruit and walnuts",
  "description": "A simple drop-cookie recipe combining drained mincemeat, chopped walnuts, and a lightly sweet dough.",
  "meal_type": "dessert",
