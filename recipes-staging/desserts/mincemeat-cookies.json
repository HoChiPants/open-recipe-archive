  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Beat the shortening and white sugar until blended. Add the eggs, one at a time, then mix in the vanilla extract."
    },
    {
      "step": 3,
      "text": "Whisk together the all-purpose flour, salt, and baking soda. Add the dry mixture to the shortening mixture and stir until combined."
    },
    {
      "step": 4,
      "text": "Fold in the chopped walnuts and drained prepared mincemeat until evenly distributed."
    },
    {
      "step": 5,
      "text": "Portion the dough onto baking sheets, leaving space between portions."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, until the cookies are set.",
      "timer_minutes": 10
    }
  ],
