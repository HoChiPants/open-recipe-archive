  "name": "Fruit Cake",
  "subtitle": "A rich cake packed with dried fruit and cherries",
  "description": "Simmered dried fruit and cherries are folded into a simple batter, optionally finished with almonds, and baked until golden and set.",
  "meal_type": "dessert",
