  "instructions": [
    {
      "step": 1,
      "text": "Simmer the sugar, sultanas, currants, raisins, water, cherries, and butter or margarine with the salt for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Transfer the hot fruit mixture to a mixing bowl and let it cool until warm rather than hot."
    },
    {
      "step": 3,
      "text": "Preheat the oven to 325°F and prepare a cake pan."
    },
    {
      "step": 4,
      "text": "Stir the beaten egg into the cooled fruit mixture."
    },
    {
      "step": 5,
      "text": "Combine the sieved self-raising flour with the fruit mixture, then fold in the almonds if using."
    },
    {
      "step": 6,
      "text": "Bake for 90 minutes, until golden brown and the center is fully set; verify that the center reaches 160°F.",
      "timer_minutes": 90
    },
    {
      "step": 7,
      "text": "Cool the cake in the pan before removing and serving."
    }
  ],
