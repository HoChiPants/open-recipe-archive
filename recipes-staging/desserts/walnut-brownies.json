  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "walnut-brownies",
  "name": "Walnut Brownies",
  "subtitle": "A simple cocoa brownie with chopped walnuts.",
  "description": "Rich, firm brownies made with cocoa, butter, and walnuts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.33300000429153,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the white sugar with the melted butter. Beat in the eggs."
    },
    {
      "step": 3,
      "text": "Stir in the self-rising flour, unsweetened cocoa powder, and salt just until combined. Fold in the vanilla extract and chopped walnuts."
    },
    {
      "step": 4,
      "text": "Spread the batter evenly in the prepared pan."
    },
    {
      "step": 5,
      "text": "Bake until the brownies are firm.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Cool before cutting into 12 servings."
    }
  ],
