  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Combine the blackberries, 1.5 cups sugar, cornstarch, and water in a saucepan. Cook for 5 minutes, stirring, until thickened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the flour, 0.66666668653488 cup sugar, baking powder, and salt in a bowl."
    },
    {
      "step": 4,
      "text": "Cut in the margarine until the mixture is crumbly, then stir in the milk to form a batter."
    },
    {
      "step": 5,
      "text": "Transfer the thickened blackberry mixture to a baking dish and add the batter over it."
    },
    {
      "step": 6,
      "text": "Bake until the topping is golden brown.",
      "timer_minutes": 45
    }
  ],
