  "instructions": [
    {
      "step": 1,
      "text": "Divide the chopped dark chocolate between two microwave-safe mugs. Microwave briefly until melted, stirring between intervals, then stir in the toasted hazelnuts and set aside."
    },
    {
      "step": 2,
      "text": "Melt the butter in a microwave-safe bowl for 1 minute. Stir in the milk, vanilla extract, cocoa powder, caster sugar, plain flour, and whole milk until combined.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Divide the batter between the mugs and microwave for 1 minute. Continue in short intervals until the centers are set but still moist.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Whisk the double cream until softly thickened. Spoon the salted caramel ice cream and frozen raspberries over the warm brownies, then finish with the cream and reserved chocolate-hazelnut mixture.",
      "timer_minutes": 5
    }
  ],
