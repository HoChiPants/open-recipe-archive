  "name": "Pineapple Angel Food Cake",
  "subtitle": "A light, fruit-filled cake with a creamy topping",
  "description": "Crushed pineapple and angel food cake mix bake into a tender, airy dessert finished with thawed whipped topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
