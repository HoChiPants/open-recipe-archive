  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "pineapple-with-juice",
      "item": "pineapple with juice",
      "quantity": 1,
      "unit": "can",
      "preparation": "20 ounce, crushed"
    },
