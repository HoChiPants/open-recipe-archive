  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Coat a baking pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Stir the crushed pineapple with its juice and the angel food cake mix until evenly combined."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and spread it evenly."
    },
    {
      "step": 4,
      "text": "Bake for 25 minutes, or until golden brown.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Cool the cake completely, then spread the thawed whipped topping over the surface before serving."
    }
