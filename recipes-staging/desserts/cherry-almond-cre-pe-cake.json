  "id": "cherry-almond-cre-pe-cake",
  "name": "Cherry-Almond Crêpe Cake",
  "subtitle": "Layered crêpes with almond cream and cherries",
  "description": "Stack crêpes with almond custard cream and cherry filling, then finish with toasted almonds.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 65,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "batch-of-cre-pes-see-recipe-link",
      "item": "batch of crêpes (see recipe link)",
      "quantity": 1
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 350,
      "unit": "ml"
    },
    {
      "ingredient_id": "egg-yolks-freeze-the-whites-for-another-recipe",
      "item": "egg yolks (freeze the whites for another recipe)",
      "quantity": 4
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 120,
      "unit": "g"
    },
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": 35,
      "unit": "g"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": "3/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "frozen-cherries",
      "item": "frozen cherries",
      "quantity": 275,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "cherry-brandy-liqueur-optional",
      "item": "cherry brandy liqueur (optional)",
      "quantity": 1,
      "unit": "tbsp",
      "optional": true
    },
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": 1,
      "unit": "tbsp"
    },
