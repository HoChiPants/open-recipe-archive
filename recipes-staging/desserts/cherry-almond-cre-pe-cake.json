  "instructions": [
    {
      "step": 1,
      "text": "Prepare the batch of crêpes and set it aside while making the fillings."
    },
    {
      "step": 2,
      "text": "Warm the milk in a saucepan for about 3 minutes, without boiling.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Whisk the egg yolks, sugar, 35 g cornflour, almond extract, and half of the light brown soft sugar in a bowl."
    },
    {
      "step": 4,
      "text": "Gradually whisk the warm milk into the yolk mixture, return it to the saucepan, and cook over medium-low heat, whisking, until thick and smooth. Use a thermometer to confirm the custard reaches 160°F."
    },
    {
      "step": 5,
      "text": "Transfer the custard to a shallow container, cover its surface, and chill until firm.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Whisk the double cream with the remaining light brown soft sugar until thick, then fold it into the chilled custard."
    },
    {
      "step": 7,
      "text": "Simmer the frozen cherries, sugar, light brown soft sugar, and optional cherry brandy liqueur for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Mix the 1 tablespoon cornflour with a little liquid from the cherries, stir it into the pan, and cook until thickened. Stir, then cool the filling until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 9,
      "text": "Layer the crêpes with almond cream and cherry filling, spreading each layer evenly."
    },
    {
      "step": 10,
      "text": "Top with the toasted flaked almonds and serve, adding the optional cherry brandy liqueur only as directed in the filling."
    }
  ],
