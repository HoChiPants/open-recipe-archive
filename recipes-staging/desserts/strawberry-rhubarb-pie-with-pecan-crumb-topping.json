  "id": "strawberry-rhubarb-pie-with-pecan-crumb-topping",
  "name": "Strawberry Rhubarb Pie with Pecan Crumb Topping",
  "subtitle": "A crisp-topped pie with tart rhubarb and sweet strawberries",
  "description": "A classic fruit pie combining strawberries and rhubarb beneath a cinnamon-nutmeg pecan crumb topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "chilled-butter",
      "item": "chilled butter",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "rhubarb",
      "item": "rhubarb",
      "quantity": 2,
      "unit": "cups",
      "preparation": "sliced 1/2-inch thick"
    },
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 2,
      "unit": "cups",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.66666668653488,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour and salt together. Cut in the chilled butter until the mixture resembles coarse crumbs, then add the cold water and mix until a dough forms, adding more water as needed."
    },
    {
      "step": 3,
      "text": "Shape the dough into a disk, roll it out on a lightly floured surface, and fit it into a pie dish. Fold and crimp the edge, then chill the crust while preparing the filling."
    },
    {
      "step": 4,
      "text": "Combine the flour, white sugar, cinnamon, and nutmeg for the filling. Stir in the rhubarb and strawberries, then transfer the mixture to the chilled crust."
    },
    {
      "step": 5,
      "text": "Combine the pecans with the remaining flour and white sugar. Cut in the chilled butter until crumbly, then spread the topping over the filling."
    },
    {
      "step": 6,
      "text": "Bake until the crust and topping are browned and the fruit is bubbling, about 60 minutes. Let the pie rest for 10 minutes before serving.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Serve warm or cooled."
    }
  ],
