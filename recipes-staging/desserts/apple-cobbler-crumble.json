  "id": "apple-cobbler-crumble",
  "name": "Apple Cobbler Crumble",
  "subtitle": "Tender cinnamon apples beneath a buttery crumb topping",
  "description": "A simple baked apple dessert with tart apples, warm cinnamon, and a crisp, buttery flour topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "granny-smith-apples",
      "item": "Granny Smith apples",
      "quantity": 4,
      "preparation": "cored and sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the self-rising flour, white sugar, softened butter, and ground cinnamon until a crumbly mixture forms."
    },
    {
      "step": 3,
      "text": "Layer some of the mixture in a baking dish, arrange the sliced apples over it, and cover with the remaining mixture."
    },
    {
      "step": 4,
      "text": "Bake until the apples are tender and the topping is set, about 30–35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Cool for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
