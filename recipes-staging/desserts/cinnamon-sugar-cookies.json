      "item": "ground cinnamon",
      "quantity": 2.5,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the all-purpose flour, baking soda, and salt together."
    },
    {
      "step": 2,
      "text": "Beat the butter, 0.25 cup white sugar, and packed light brown sugar until set and well combined. Mix in the egg and vanilla extract."
    },
    {
      "step": 3,
      "text": "Add the dry ingredients and combine to form a dough."
    },
    {
      "step": 4,
      "text": "Shape the dough into a log, cover, and chill for 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 5,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 6,
      "text": "Combine the remaining white sugar, packed light brown sugar, and ground cinnamon in a shallow dish."
    },
    {
      "step": 7,
      "text": "Slice the chilled dough and coat the pieces in the cinnamon-sugar mixture."
    },
    {
      "step": 8,
      "text": "Arrange the pieces for baking and bake for 15 minutes, until the cookies are fully set; if checked, the centers should reach 160°F.",
      "timer_minutes": 15
    },
    {
      "step": 9,
      "text": "Cool the cookies before serving."
    }
  ],
