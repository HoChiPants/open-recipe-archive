  "id": "cinnamon-sugar-cookies",
  "name": "Cinnamon Sugar Cookies",
  "subtitle": "Crisp-edged cookies with a cinnamon coating",
  "description": "A simple brown-sugar cookie dough is chilled, sliced, coated in cinnamon sugar, and baked until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 60,
    "unit": "servings"
  },
