  "id": "mamon-sponge-cakes",
  "name": "Mamon Sponge Cakes",
  "subtitle": "Light orange sponge cakes with a tender crumb",
  "description": "Individual Filipino-style sponge cakes flavored with orange peel, orange juice, and vanilla.",
