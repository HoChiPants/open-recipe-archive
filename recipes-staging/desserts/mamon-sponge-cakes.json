  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F and prepare the cake molds or baking vessels."
    },
    {
      "step": 2,
      "text": "Stir the flour, 1 cup white sugar, baking powder, and salt together. Add the vegetable oil, egg yolks, grated orange peel, vanilla extract, orange juice, and water; mix until smooth."
    },
    {
      "step": 3,
      "text": "In a clean bowl, whisk the egg whites with the cream of tartar. Gradually whisk in 0.5 cup white sugar until soft peaks form."
    },
    {
      "step": 4,
      "text": "Fold the egg-white mixture into the yolk batter in additions until evenly combined, taking care not to deflate it."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared molds and bake for 40 minutes, until the cakes are set in the center and reach 160°F internally.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Cool the cakes for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
