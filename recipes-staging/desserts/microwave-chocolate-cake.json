      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly coat a microwave-safe dish with nonstick cooking spray."
    },
    {
      "step": 2,
      "text": "Whisk the sugar, milk, egg, softened butter, and vanilla until combined."
    },
    {
      "step": 3,
      "text": "Stir the flour, cocoa powder, baking powder, and salt into the wet mixture until the batter is smooth."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared dish and microwave on high for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Check that the center is firm and fully set, or reaches 160°F on a food thermometer. Cool for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
