  "id": "microwave-chocolate-cake",
  "name": "Microwave Chocolate Cake",
  "subtitle": "A quick, tender chocolate cake for two",
  "description": "Mix a simple cocoa batter, microwave until fully set, and let it cool briefly before serving.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 2
  },
  "ingredients": [
    {
      "ingredient_id": "nonstick-cooking-spray",
      "item": "nonstick cooking spray"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.25,
