{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-chip-meringue",
  "name": "Chocolate Chip Meringue",
  "subtitle": "Crisp-topped meringues with semisweet chocolate",
  "description": "Light baked meringues folded with chocolate chips for a crisp, delicate dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 300°F. Line a baking sheet with parchment paper."
    },
    {
      "step": 2,
      "text": "Beat the egg whites with the white sugar and distilled white vinegar until soft peaks form. Add the vanilla extract and salt, then continue beating until the mixture forms stiff, glossy peaks."
    },
    {
      "step": 3,
      "text": "Fold in the semisweet chocolate chips until evenly distributed. Portion the meringue onto the prepared sheet."
    },
    {
      "step": 4,
      "text": "Bake for 25 minutes, until the centers are fully set and register 160°F on a food thermometer. Cool before serving.",
      "timer_minutes": 25
    }
  ],
