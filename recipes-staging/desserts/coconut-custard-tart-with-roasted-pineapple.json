  "id": "coconut-custard-tart-with-roasted-pineapple",
  "name": "Coconut Custard Tart with Roasted Pineapple",
  "subtitle": "Creamy coconut filling with warm spiced fruit",
  "description": "A crisp pastry tart filled with coconut custard and served with roasted pineapple.",
