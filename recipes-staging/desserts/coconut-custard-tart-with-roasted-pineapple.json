  "instructions": [
    {
      "step": 1,
      "text": "Rub the cold butter into the flour until crumbly. Mix in 75 g caster sugar and the egg yolks plus 1 beaten egg to form a dough; knead briefly until smooth."
    },
    {
      "step": 2,
      "text": "Shape the dough into a disk, cover, and chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Preheat the oven and lightly prepare a tart tin. Roll the dough on a lightly floured surface and use it to line the tin, trimming the edge."
    },
    {
      "step": 4,
      "text": "Prepare the pastry shell for blind baking, then bake for 25 minutes until set. Let it cool.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "For the filling, whisk the eggs plus 2 yolks with 75 g caster sugar. Warm the double cream and coconut cream, then gradually whisk the warm mixture into the eggs."
    },
    {
      "step": 6,
      "text": "Pour the custard into the cooled shell and grate over fresh nutmeg. Bake for 55 minutes, until the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 55
    },
    {
      "step": 7,
      "text": "Cool the tart, then chill it until firm."
    },
    {
      "step": 8,
      "text": "Peel, core, and cut the pineapple. Toss it with the light brown soft sugar, rum or lime juice, and the remaining grated nutmeg."
    },
    {
      "step": 9,
      "text": "Roast the pineapple for 10 minutes until tender and lightly caramelized.",
      "timer_minutes": 10
    },
    {
      "step": 10,
      "text": "Slice the chilled tart and serve with the roasted pineapple. Add toasted coconut shavings if using."
    }
  ],
