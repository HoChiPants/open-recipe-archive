  "instructions": [
    {
      "step": 1,
      "text": "Line a baking tray with parchment. Cook 200 g sugar in a dry pan over medium heat until amber, remove from the heat, stir in the bicarbonate of soda, and spread the foam thinly on the tray. Let it harden, then break into shards."
    },
    {
      "step": 2,
      "text": "Whisk the yuzu chung, lemon juice, egg, egg yolk, and 60 g sugar in a heatproof bowl. Set it over gently simmering water and whisk until thickened and at least 160°F; remove from the heat and whisk in the butter a cube at a time. Chill until set."
    },
    {
      "step": 3,
      "text": "Heat the oven to 350°F. Whisk the separated egg whites with 40 g sugar to soft peaks. In another bowl, combine the yolks, sesame paste, milk, and oil; fold in the flour and cornflour, then fold in the whites."
    },
    {
      "step": 4,
      "text": "Pour the batter into a lined baking tin and bake for 45 minutes, until the center is firm and a tester comes out clean. Cool completely and cut into pieces.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Whisk the cream, 30 g sugar, sesame paste, and yuzu chung to soft peaks. Chill briefly if needed for a spoonable consistency."
    },
    {
      "step": 6,
      "text": "Layer sponge, yuzu curd, sesame cream, and dalgona shards in six glasses. Finish with cream and brittle."
    }
  ],
