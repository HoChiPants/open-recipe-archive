  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 500°F. Cook the quince with the water, honey, and pinch of salt for 8 minutes, until tender. Transfer the fruit to a bowl and let it cool.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Fit half of the pastry into a 9-inch pie pan. Combine the white sugar, flour, cinnamon, and 0.5 teaspoon salt."
    },
    {
      "step": 3,
      "text": "Toss the cooled quince with the sugar mixture and butter, then place the filling in the crust. Cover with the remaining pastry and cut vents in the top."
    },
    {
      "step": 4,
      "text": "Set the oven to 425°F and bake for 25 minutes, until golden brown. Reduce the heat to 375°F and bake for 45 minutes more.",
      "timer_minutes": 70
    },
    {
      "step": 5,
      "text": "Cool the pie completely before serving.",
      "timer_minutes": 120
    }
  ],
