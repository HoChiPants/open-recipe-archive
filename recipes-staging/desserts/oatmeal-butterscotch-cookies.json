  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the butter, brown sugar, white sugar, and vanilla until combined. Whisk in the egg."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the flour, baking soda, salt, cinnamon, nutmeg, and oats."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the butter mixture and stir in the butterscotch chips and coconut until evenly distributed."
    },
    {
      "step": 5,
      "text": "Chill the dough for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Drop portions of dough onto baking sheets, leaving space between them. Bake for 8 to 10 minutes, until the edges are set and the centers are no longer wet; for the egg-safety endpoint, the center should reach 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Cool the cookies on the baking sheets briefly, then transfer them to a rack to finish cooling."
    }
  ],
