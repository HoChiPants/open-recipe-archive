  "id": "oatmeal-butterscotch-cookies",
  "name": "Oatmeal Butterscotch Cookies",
  "subtitle": "Chewy oat cookies with warm spice and coconut",
  "description": "A batch of chewy oatmeal cookies combining butterscotch chips, coconut, cinnamon, and nutmeg.",
