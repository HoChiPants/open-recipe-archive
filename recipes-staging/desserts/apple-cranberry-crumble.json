  "id": "apple-cranberry-crumble",
  "name": "Apple-Cranberry Crumble",
  "subtitle": "Tart fruit beneath a buttery cinnamon topping",
  "description": "A simple baked dessert combining apples, cranberries, raisins, and walnuts with a sweet, buttery crumble layer.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
