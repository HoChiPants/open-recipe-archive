    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "apples",
      "item": "apples",
      "quantity": 2,
      "preparation": "or more to taste, cut into 1-inch pieces"
    },
    {
      "ingredient_id": "fresh-cranberries",
      "item": "fresh cranberries",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 ounce"
    },
