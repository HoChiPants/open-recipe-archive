      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine the apples, cranberries, raisins, and walnuts in a baking dish. Sprinkle with part of the divided sugar and cinnamon, then toss to coat."
    },
    {
      "step": 3,
      "text": "Mix the remaining sugar with the flour, melted butter, egg, baking powder, and salt until a crumbly topping forms."
    },
    {
      "step": 4,
      "text": "Spread the topping evenly over the fruit."
    },
    {
      "step": 5,
      "text": "Bake for 50 minutes, until the fruit is bubbling and the topping is browned. Check that the egg-containing topping reaches 160°F and is fully set.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Cool for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
