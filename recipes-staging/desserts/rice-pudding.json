    "prep_minutes": 5,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "long-grain-rice",
      "item": "long grain rice",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "2-milk",
      "item": "2% milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 0.5,
      "unit": "can",
      "preparation": "12 fluid ounce"
    },
    {
