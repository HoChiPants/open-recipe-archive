      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring the water and rice to a simmer in a saucepan."
    },
    {
      "step": 2,
      "text": "Cook for 20 minutes, or until the rice is tender.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Add the 2% milk, evaporated milk, sugar, and butter."
    },
    {
      "step": 4,
      "text": "Stir and cook for 20 minutes, until the mixture thickens into a pudding.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Stir in the ground cinnamon and serve."
    }
  ],
