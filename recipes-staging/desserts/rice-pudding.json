  "id": "rice-pudding",
  "name": "Rice Pudding",
  "subtitle": "Creamy stovetop pudding with cinnamon",
  "description": "Tender long-grain rice cooked with milk, evaporated milk, sugar, and butter for a simple warm dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
