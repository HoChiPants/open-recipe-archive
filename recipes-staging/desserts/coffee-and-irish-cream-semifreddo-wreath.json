  "id": "coffee-and-irish-cream-semifreddo-wreath",
  "name": "Coffee and Irish Cream Semifreddo Wreath",
  "subtitle": "A chilled coffee dessert with creamy Irish cream flavor",
  "description": "A molded frozen dessert combining coffee, sweetened eggs, whipped cream, Irish cream liqueur, and dark chocolate.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 2
  },
  "ingredients": [
    {
      "ingredient_id": "eggs-separated",
      "item": "eggs separated",
      "quantity": 6
    },
    {
      "ingredient_id": "instant-coffee-granules",
      "item": "instant coffee granules",
      "quantity": 6,
      "unit": "tbsp",
      "preparation": "mixed with 2 tbsp boiling water"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 600,
      "unit": "ml"
    },
    {
      "ingredient_id": "irish-cream-liqueur",
      "item": "Irish cream liqueur",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "vegetable-oil-for-the-tin",
      "item": "vegetable oil for the tin"
    },
    {
      "ingredient_id": "dark-chocolate-melted",
      "item": "dark chocolate melted",
      "quantity": 100,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly oil a wreath-shaped tin. Stir the coffee granules with the boiling water and let the mixture cool briefly.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Whisk the egg yolks with part of the sugar until thick, then whisk in the coffee mixture."
    },
    {
      "step": 3,
      "text": "Whisk the egg whites with the remaining sugar until thick and glossy. Fold them into the coffee mixture."
    },
    {
      "step": 4,
      "text": "Whip the double cream and Irish cream liqueur to soft peaks, then fold into the egg mixture."
    },
    {
      "step": 5,
      "text": "Layer the semifreddo mixture in the prepared tin, adding the melted dark chocolate between layers. Transfer to the freezer until firm."
    },
    {
      "step": 6,
      "text": "Remove the wreath from the tin, cut into portions, and serve.",
      "timer_minutes": 5
    }
  ],
