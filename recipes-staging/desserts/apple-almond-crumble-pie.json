  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Dust a work surface with the flour reserved for dusting."
    },
    {
      "step": 2,
      "text": "Combine 50 g plain flour, ground almonds, 70 g sugar, and cold butter. Rub or work together until crumbly, then stir in the flaked almonds."
    },
    {
      "step": 3,
      "text": "Peel, core, and slice the apples. Toss them with 50 g sugar, mixed spice, and 2 tbsp flour until evenly coated."
    },
    {
      "step": 4,
      "text": "Roll out the pastry and use it to line a pie dish. Trim the edge and chill briefly if the pastry has softened."
    },
    {
      "step": 5,
      "text": "Fill the pastry shell with the apples and scatter the crumble mixture over the top. Cut or arrange any remaining pastry as desired, then brush with the beaten egg if using."
    },
    {
      "step": 6,
      "text": "Bake for 40 minutes, until the pastry and topping are golden, the filling is bubbling, and any egg wash is fully set. Check that the center reaches 160°F.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Serve warm with clotted cream, custard, or ice cream."
    }
  ],
