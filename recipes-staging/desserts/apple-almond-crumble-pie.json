  "id": "apple-almond-crumble-pie",
  "name": "Apple Almond Crumble Pie",
  "subtitle": "Spiced apples beneath a crisp almond topping",
  "description": "A buttery pastry pie filled with spiced apples and finished with an almond crumble layer.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
