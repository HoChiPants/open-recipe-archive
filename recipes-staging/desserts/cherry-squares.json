  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking pan for the bars."
    },
    {
      "step": 2,
      "text": "Stir 1.25 cups flour with 0.33333298563957 cup packed brown sugar. Work in 0.5 cup butter or margarine until combined, then press the mixture evenly into the pan."
    },
    {
      "step": 3,
      "text": "Bake the base for 15 minutes, until lightly browned.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Whisk the eggs. In a separate bowl, combine 1.25 cups packed brown sugar, 1 tablespoon flour, baking powder, and salt. Stir in the eggs, then fold in the coconut, walnuts, and cherries."
    },
    {
      "step": 5,
      "text": "Spread the filling over the baked base and bake for 25 minutes, until the center is firm and fully set or reaches 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Cool the bars until set, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Combine the confectioners' sugar, butter, vanilla extract, and water until smooth. Spread the icing over the cooled bars, then cut into squares."
    }
  ],
