  "id": "cherry-squares",
  "name": "Cherry Squares",
  "subtitle": "Coconut-cherry dessert bars with a simple icing",
  "description": "A buttery baked base is topped with a coconut, walnut, and cherry filling, then finished with vanilla icing and cut into squares.",
