{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "purple-yam-jam",
  "name": "Purple Yam Jam",
  "subtitle": "A smooth, creamy purple yam spread",
  "description": "Tender purple yam is mashed with butter, milks, and vanilla, then cooked into a thick, sweet dessert spread.",
  "meal_type": "dessert",
  "cuisine": "Asian",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 80,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "purple-yam-root",
      "item": "purple yam root",
      "quantity": 1,
      "unit": "pound",
      "preparation": "unpeeled"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 0.5,
      "unit": "can",
      "preparation": "12 fluid ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Simmer the unpeeled purple yam until tender, about 30 minutes or until it can be pierced easily.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Cool the yam until safe to handle, then peel and mash it until smooth."
    },
    {
      "step": 3,
      "text": "Melt the butter in a saucepan over medium heat."
    },
    {
      "step": 4,
      "text": "Stir in the sweetened condensed milk, vanilla extract, and evaporated milk."
    },
    {
      "step": 5,
      "text": "Add the mashed yam and cook, stirring frequently, until the mixture thickens, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Continue stirring for 15 minutes, then transfer the jam to a container and chill for 30 minutes before serving.",
      "timer_minutes": 45
    }
  ],
