      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "at room temperature"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.66666668653488,
      "unit": "cup",
      "preparation": "at room temperature"
    },
    {
      "ingredient_id": "vanilla",
      "item": "vanilla",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare cupcake pans for 24 portions."
    },
    {
      "step": 2,
      "text": "Process the roasted pistachios with part of the sugar until finely ground. Whisk both flours, baking powder, and salt in a separate bowl."
    },
    {
      "step": 3,
      "text": "Beat the room-temperature butter with the remaining sugar until creamy, then whisk in the eggs one at a time."
    },
    {
      "step": 4,
      "text": "Stir the milk and vanilla together. Add the dry ingredients and milk mixture alternately to the butter mixture, stirring just until combined."
    },
    {
      "step": 5,
      "text": "Fold in the pistachio-sugar mixture, divide the batter among the prepared cups, and bake until the cupcakes are set and lightly browned, about 18 minutes.",
      "timer_minutes": 18
    },
    {
      "step": 6,
      "text": "Cool the cupcakes in the pan for 5 minutes before serving or transferring them to a rack.",
      "timer_minutes": 5
    }
  ],
