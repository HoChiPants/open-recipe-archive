  "id": "pistachio-cupcakes",
  "name": "Pistachio Cupcakes",
  "subtitle": "Tender cupcakes with roasted pistachio flavor",
  "description": "These American-style cupcakes combine pistachio-scented sugar with a light, buttery cake batter for a simple dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "roasted-pistachio-nut-meats",
      "item": "roasted pistachio nut meats",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
