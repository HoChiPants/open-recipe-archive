  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Grease and flour a suitable cake pan."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, baking powder, salt, and baking soda."
    },
    {
      "step": 3,
      "text": "Beat the 3 cups sugar and 1 cup butter for 3 minutes, until light and creamy.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Whisk in the eggs, vanilla, orange juice, and zest from the two oranges."
    },
    {
      "step": 5,
      "text": "Add the dry ingredients and sour cream in portions, mixing until the batter is smooth."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and bake until set and a tester comes out clean, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Cool the cake in the pan for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "For the glaze, combine the 1 cup sugar, orange juice, and zest from the remaining orange. Simmer for 15 minutes, then stir in the 3 tablespoons butter.",
      "timer_minutes": 15
    },
    {
      "step": 9,
      "text": "Prepare the cooled cake for serving and spoon the warm glaze over it."
    }
  ],
