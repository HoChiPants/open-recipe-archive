  "id": "orange-pound-cake",
  "name": "Orange Pound Cake",
  "subtitle": "A tender citrus cake with a glossy orange finish",
  "description": "This buttery pound cake combines orange zest, juice, and sour cream for a rich crumb, then gets finished with a simple orange glaze.",
  "meal_type": "dessert",
