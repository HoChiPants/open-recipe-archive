  "instructions": [
    {
      "step": 1,
      "text": "Mix the flour and salt. Work in the softened butter, egg yolk, and enough cold water to form a dough. Stir just until cohesive, shape into a disk, and chill until firm, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Beat the second portion of softened butter with the white sugar. Mix in the beaten egg, egg yolk, and apple brandy, then stir in the ground almonds and 2 tablespoons flour until set into a thick almond filling."
    },
    {
      "step": 3,
      "text": "Roll the chilled dough on a lightly floured surface and fit it into a tart pan. Fold or crimp the edge, then chill the lined pan until firm."
    },
    {
      "step": 4,
      "text": "Heat the oven to 400°F. Spread the almond filling in the shell and arrange the sliced apples over it in overlapping layers."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, then reduce the oven to 350°F. Sprinkle with the sugar for decoration and continue baking until the apples are tender and the filling is fully set, reaching 160°F in the center.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Cool the tart. Warm the apricot jelly with the cold water until fluid, then brush it over the apples before serving.",
      "timer_minutes": 10
    }
  ],
