  "id": "chocolate-chip-cookie-mix-in-a-jar",
  "name": "Chocolate Chip Cookie Mix in a Jar",
  "subtitle": "Layered dry mix for homemade chocolate chip cookies",
  "description": "Prepare a shelf-stable jar of layered cookie mix with brown sugar, white sugar, chocolate chips, and seasoned flour.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, salt, and baking soda together in a bowl."
    },
    {
      "step": 2,
      "text": "Layer the brown sugar, white sugar, chocolate chips, and flour mixture in a clean jar, keeping the layers distinct."
    },
    {
      "step": 3,
      "text": "Seal the jar and transfer the mix for storage or gifting."
    },
    {
      "step": 4,
      "text": "When ready to bake, preheat the oven to 375°F and prepare the cookie dough according to the mix directions."
    },
    {
      "step": 5,
      "text": "Portion the prepared dough onto a baking sheet and bake for about 10 minutes, until lightly browned.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Transfer the cookies to a rack and let them cool for 2 minutes before serving.",
      "timer_minutes": 2
    }
  ],
