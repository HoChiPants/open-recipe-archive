  "id": "chocolate-pudding-shots",
  "name": "Chocolate Pudding Shots",
  "subtitle": "Creamy chocolate treats with a spirited finish",
  "description": "A quick chilled dessert made by blending chocolate pudding with Irish cream, vodka, and whipped topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "cold-milk",
      "item": "cold milk",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "instant-chocolate-pudding-mix",
      "item": "instant chocolate pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.9 ounce"
    },
    {
      "ingredient_id": "irish-cream-liqueur",
      "item": "Irish cream liqueur",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vodka",
      "item": "vodka",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "8-ounce-container-frozen-whipped-topping",
      "item": "(8 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cold milk and pudding mix for 2 minutes, until smooth.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "In a separate bowl, whisk the Irish cream, vodka, and thawed whipped topping until smooth."
    },
    {
      "step": 3,
      "text": "Stir the two mixtures together until evenly blended, then portion into 16 small serving cups."
    },
    {
      "step": 4,
      "text": "Chill until set before serving."
    }
  ],
