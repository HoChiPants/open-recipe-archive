  "id": "chewiest-brownies",
  "name": "Chewiest Brownies",
  "subtitle": "Dense chocolate brownies with a powdered-sugar finish",
  "description": "A simple batch of chewy cocoa brownies baked low and slow, cooled, cut, and dusted with confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
