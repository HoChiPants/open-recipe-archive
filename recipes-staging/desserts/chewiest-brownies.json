      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "confectioners-sugar-for-decoration",
      "item": "confectioners' sugar for decoration",
      "quantity": 0.33333334326744,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 300°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Combine the sugar, cocoa powder, flour, and salt in a bowl. Stir in the melted butter, eggs, and vanilla until the batter is thick and evenly combined."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and spread it into an even layer."
    },
    {
      "step": 4,
      "text": "Bake until set, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cool the brownies completely, then cut into 24 servings and dust with confectioners' sugar."
    }
  ],
