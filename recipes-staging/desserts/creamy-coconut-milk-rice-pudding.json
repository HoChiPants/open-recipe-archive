  "instructions": [
    {
      "step": 1,
      "text": "Combine the water and basmati rice in a pot and bring to a simmer. Cook until the rice is tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Stir in the coconut milk, raw sugar, sea salt, and whole milk. Bring the mixture back to a simmer and cook until thick, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Stir in the beaten eggs and cook for 2 minutes, stirring constantly, until the pudding reaches 160°F and the center is fully set.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the unsalted butter, vanilla extract, cinnamon, and nutmeg. Fold in the peaches and raisins."
    },
    {
      "step": 5,
      "text": "Serve warm or chilled."
    }
  ],
