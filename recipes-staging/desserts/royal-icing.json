  "schema_version": "1.0.0",
  "id": "royal-icing",
  "name": "Royal Icing",
  "subtitle": "Smooth lemon icing for decorating cookies and cakes",
  "description": "A simple powdered-sugar icing whisked with pasteurized egg whites and lemon extract until thick enough to spread or pipe.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 32,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "pasteurized-egg-whites",
      "item": "pasteurized egg whites",
      "quantity": 4
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 4,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "lemon-extract",
      "item": "lemon extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the pasteurized egg whites in a clean bowl until lightly foamy."
    },
    {
      "step": 2,
      "text": "Add the sifted confectioners' sugar and lemon extract. Whisk until the icing is thickened and smooth."
    },
    {
      "step": 3,
      "text": "Use the icing for decorating. Because this is a no-cook icing, use only the listed pasteurized egg whites; if incorporated into a cooked egg dish, heat that dish to 160°F or until the center is firm and fully set."
    }
  ],
