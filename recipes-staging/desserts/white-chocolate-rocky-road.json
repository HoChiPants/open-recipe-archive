  "id": "white-chocolate-rocky-road",
  "name": "White Chocolate Rocky Road",
  "subtitle": "A chilled bar with marshmallows, biscuits, and pecans",
  "description": "Make a rich white-chocolate rocky road, chill it until firm, and cut it into shareable squares.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "squares"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "lotus-biscoff-smooth-spread",
      "item": "Lotus Biscoff smooth spread",
      "quantity": 175,
      "unit": "g"
    },
    {
      "ingredient_id": "salted-butter-cut-into-cubes",
      "item": "salted butter cut into cubes",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "white-chocolate-roughly-chopped",
      "item": "white chocolate roughly chopped",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "lotus-biscoff-biscuits",
      "item": "Lotus Biscoff biscuits",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "mini-marshmallows-vegetarian",
      "item": "mini marshmallows (vegetarian",
      "quantity": 60,
      "unit": "g",
      "preparation": "if needed)"
    },
    {
      "ingredient_id": "pecans-roughly-chopped",
      "item": "pecans roughly chopped",
      "quantity": 80,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Line a square baking tin with parchment."
    },
    {
      "step": 2,
      "text": "Melt the spread, butter, and white chocolate together gently, stirring until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Break the biscuits into pieces and stir them into the melted mixture with the marshmallows and pecans."
    },
    {
      "step": 4,
      "text": "Press the mixture evenly into the lined tin and chill until firm.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Cut into 16 squares and serve."
    }
  ],
