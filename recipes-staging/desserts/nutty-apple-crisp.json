  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Toss the apples with the lemon juice and water, then arrange them in a baking dish."
    },
    {
      "step": 3,
      "text": "Stir together the flour, oats, brown sugar, nutmeg, and salt."
    },
    {
      "step": 4,
      "text": "Cut in the softened butter until the mixture forms coarse crumbs, then fold in the walnuts."
    },
    {
      "step": 5,
      "text": "Scatter the topping evenly over the apples and bake until lightly browned, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Serve warm or at room temperature."
    }
  ],
