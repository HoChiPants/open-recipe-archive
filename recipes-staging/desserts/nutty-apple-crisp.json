  "id": "nutty-apple-crisp",
  "name": "Nutty Apple Crisp",
  "subtitle": "Tender apples beneath a buttery oat-walnut topping",
  "description": "A straightforward baked dessert combining lemony apples with a nutty, lightly spiced crisp topping.",
