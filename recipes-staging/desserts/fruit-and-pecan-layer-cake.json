  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare cake pans for a layer cake."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter, 1.25 cups sugar, and 1.5 teaspoons vanilla until smooth and creamy."
    },
    {
      "step": 3,
      "text": "Stir together the flour, baking powder, and salt. Add the dry mixture to the butter mixture in portions, alternating with the milk, and mix until combined."
    },
    {
      "step": 4,
      "text": "Whisk the egg whites with 0.5 cup sugar until soft peaks form, then fold the meringue gently into the batter."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pans and bake for 30 minutes, until the layers are set and the center reaches at least 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool the cake layers completely before assembling."
    },
    {
      "step": 7,
      "text": "Stir the frosting with the raisins, pecans, candied cherries, and 2 teaspoons vanilla. Use this mixture between the cooled layers, then add the remaining frosting to the top and sides."
    }
  ],
