  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes in a pot, cover with water, season with salt and pepper, and simmer until tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Heat the oven to 375°F. Drain and mash the potatoes with the warm milk and butter; season to taste."
    },
    {
      "step": 3,
      "text": "Warm the olive oil in a skillet. Cook the onion until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the turkey, mushrooms, carrot, parsley, garlic, bouillon powder, thyme, and additional salt and pepper. Cook until the turkey reaches 165°F throughout, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Stir in the flour and cook for 1 minute. Transfer the filling to a baking dish and spread the mashed potatoes over it.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Bake until the topping is lightly browned and the filling is set, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
