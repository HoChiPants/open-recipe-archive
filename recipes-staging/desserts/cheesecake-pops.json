  "id": "cheesecake-pops",
  "name": "Cheesecake Pops",
  "subtitle": "Chilled cheesecake bites on sticks with a crisp coating",
  "description": "Bake a simple cheesecake, chill it until firm, shape it into pops, and finish with white coating, chocolate chips, and toasted coconut.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 55,
    "inactive_minutes": 270
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 3,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla",
      "item": "vanilla",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "lollipop-sticks",
      "item": "lollipop sticks",
      "quantity": 24
    },
    {
      "ingredient_id": "white-confectioners-coating",
      "item": "white confectioners' coating",
      "quantity": 10,
      "unit": "ounces"
    },
    {
      "ingredient_id": "miniature-semisweet-chocolate-chips",
      "item": "miniature semisweet chocolate chips"
    },
    {
      "ingredient_id": "coconut",
      "item": "coconut",
      "preparation": "toasted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Line or lightly prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Beat the softened cream cheese and sugar until smooth. Mix in the sour cream, flour, vanilla, and salt, then add the eggs and blend just until combined."
    },
    {
      "step": 3,
      "text": "Spread the batter evenly in the pan and bake for 50 minutes, until the center is fully set and reaches 160°F.",
      "timer_minutes": 50
    },
    {
      "step": 4,
      "text": "Cool the cheesecake for 60 minutes, then chill it for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Crumble the chilled cheesecake and roll it into 24 evenly sized balls. Insert a lollipop stick into each one."
    },
    {
      "step": 6,
      "text": "Chill the pops for 30 minutes, until firm.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Melt the white confectioners' coating. Dip each cheesecake pop to cover, then decorate with miniature semisweet chocolate chips and toasted coconut."
    },
    {
      "step": 8,
      "text": "Chill the coated pops until the coating is set."
    }
  ],
