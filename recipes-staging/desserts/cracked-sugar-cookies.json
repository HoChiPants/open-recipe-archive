  "id": "cracked-sugar-cookies",
  "name": "Cracked Sugar Cookies",
  "subtitle": "Tender sugar cookies with lightly cracked tops",
  "description": "A simple American sugar cookie made with butter, egg yolks, and vanilla, baked until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 3
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cream-of-tartar",
      "item": "cream of tartar",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the white sugar, butter, and cream of tartar until combined. In a separate bowl, whisk the egg yolks with the vanilla extract."
    },
    {
      "step": 3,
      "text": "Whisk the all-purpose flour, baking soda, and cream of tartar together, then stir the dry mixture into the butter mixture until a dough forms."
    },
    {
      "step": 4,
      "text": "Shape the dough into 24 portions and arrange them on a prepared baking sheet."
    },
    {
      "step": 5,
      "text": "Bake for 11 minutes, until the cookies are set and the centers are no longer wet.",
      "timer_minutes": 11
    }
  ],
