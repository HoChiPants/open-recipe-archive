  "id": "brown-sugar-maple-frosting",
  "name": "Brown Sugar-Maple Frosting",
  "subtitle": "A smooth maple frosting with caramel-like brown sugar flavor",
  "description": "This quick frosting combines melted butter, brown sugar, maple syrup, and powdered sugar for a spreadable topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 10,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "powdered-sugar",
      "item": "powdered sugar",
      "quantity": 1.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the butter in a saucepan over medium heat until melted."
    },
    {
      "step": 2,
      "text": "Add the brown sugar and 1 tablespoon of the maple syrup. Stir until the sugar melts, then mix in the milk."
    },
    {
      "step": 3,
      "text": "Remove from the heat and let the mixture cool for 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "Whisk in the powdered sugar and the remaining maple syrup until smooth."
    },
    {
      "step": 5,
      "text": "Transfer the frosting to a bowl and use as desired."
    }
  ],
