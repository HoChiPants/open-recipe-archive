  "id": "bakewell-pudding",
  "name": "Bakewell Pudding",
  "subtitle": "Raspberry and almond pastry dessert",
  "description": "A crisp puff-pastry base layered with raspberry jam and a fragrant almond filling, finished with flaked almonds and icing sugar.",
  "meal_type": "dessert",
  "cuisine": "British",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "sheet-ready-rolled-all-butter-puff-pastry",
      "item": "sheet ready-rolled all-butter puff pastry",
      "quantity": 320,
      "unit": "g"
    },
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "ground-almonds",
      "item": "ground almonds",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-zested",
      "item": "lemon zested",
      "quantity": 1
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "raspberry-jam",
      "item": "raspberry jam",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "flaked-almonds",
      "item": "flaked almonds",
      "quantity": 25,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the puff pastry to fit a suitable baking tin or dish, line it, and chill while preparing the filling."
    },
    {
      "step": 2,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 3,
      "text": "Whisk the softened butter, caster sugar, and icing sugar for about 3 minutes, until smooth.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Whisk in the eggs, ground almonds, lemon zest, and almond extract until combined."
    },
    {
      "step": 5,
      "text": "Spread the raspberry jam over the chilled pastry, then spoon the almond mixture evenly on top and scatter over the flaked almonds."
    },
    {
      "step": 6,
      "text": "Bake for 50 minutes, until puffed and golden brown. The center should be fully set and reach 160°F on a food thermometer.",
      "timer_minutes": 50
    },
    {
      "step": 7,
      "text": "Cool briefly, dust with the remaining icing sugar, and serve."
    }
  ],
