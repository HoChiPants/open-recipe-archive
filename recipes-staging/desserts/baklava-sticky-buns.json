  "id": "baklava-sticky-buns",
  "name": "Baklava Sticky Buns",
  "subtitle": "Citrus-scented buns with walnut, pistachio, and honey topping",
  "description": "Soft enriched buns layered with spiced nuts, finished with a warm honey-orange syrup.",
