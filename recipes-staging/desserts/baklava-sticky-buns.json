  "instructions": [
    {
      "step": 1,
      "text": "Mix the flour, yeast, and 3 tablespoons of light brown soft sugar. Warm the milk with 70 g unsalted butter until the butter melts and the mixture is lukewarm."
    },
    {
      "step": 2,
      "text": "Pour the milk mixture into the flour mixture and knead for 10 minutes, until smooth and elastic.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Place the dough in a lightly oiled bowl, cover, and let it rise until doubled in size, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Chop the walnuts and pistachios. Mix the softened butter with 3 tablespoons of light brown soft sugar, the orange zest, cinnamon, and allspice."
    },
    {
      "step": 5,
      "text": "Turn the dough onto a lightly floured surface and roll it into a rectangle. Spread with the spiced butter mixture and scatter over the chopped nuts."
    },
    {
      "step": 6,
      "text": "Roll the dough tightly from one long side and cut it into 12 pieces. Arrange them in a prepared baking pan, cover, and let them rise for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 8,
      "text": "Bake the buns for 30 minutes, until golden and cooked through.",
      "timer_minutes": 30
    },
    {
      "step": 9,
      "text": "Warm the remaining light brown soft sugar and honey for 5 minutes, then stir in the orange juice.",
      "timer_minutes": 5
    },
    {
      "step": 10,
      "text": "Pour the warm syrup over the baked buns, scatter with the pistachios, and serve."
    }
  ],
