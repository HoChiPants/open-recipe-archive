  "id": "caramel-pecan-cheesecake",
  "name": "Caramel-Pecan Cheesecake",
  "subtitle": "A creamy cheesecake with caramel, toasted pecans, and chocolate.",
  "description": "A baked cheesecake layered with a vanilla wafer crust, caramel, pecans, and semisweet chocolate.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "vanilla-wafer-crumbs",
      "item": "vanilla wafer crumbs",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "individually-wrapped-caramels",
      "item": "individually wrapped caramels",
      "quantity": 14,
      "unit": "ounces",
      "preparation": "unwrapped"
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "5 ounce"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 3,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Toast the chopped pecans in a dry skillet over medium heat for 6 minutes, stirring often, until set aside to cool.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Melt the butter. Combine it with the vanilla wafer crumbs and vanilla extract, then press the mixture into the bottom of a cheesecake pan."
    },
    {
      "step": 4,
      "text": "Bake the crust at 350°F for 10 minutes, then cool it.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Heat the unwrapped caramels with the evaporated milk, stirring until smooth and set aside briefly."
    },
    {
      "step": 6,
      "text": "Beat the cream cheese and white sugar until smooth. Whisk in the eggs until fully incorporated, then stir in the semisweet chocolate chips."
    },
    {
      "step": 7,
      "text": "Spread the caramel over the cooled crust and add the toasted pecans. Pour the cream cheese mixture over the layers."
    },
    {
      "step": 8,
      "text": "Bake at 350°F for 40 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 40
    },
    {
      "step": 9,
      "text": "Chill the cheesecake until set before slicing."
    }
  ],
