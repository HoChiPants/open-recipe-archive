  "id": "dark-chocolate-chip-cookie-bars",
  "name": "Dark Chocolate Chip Cookie Bars",
  "subtitle": "Chewy cookie bars with deep chocolate flavor",
  "description": "A simple pan of soft, chewy cookie bars packed with dark chocolate chips and finished with crisp edges.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "dark-brown-sugar",
      "item": "dark brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dark-chocolate-chips",
      "item": "dark chocolate chips",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking soda, salt, and baking powder together."
    },
    {
      "step": 3,
      "text": "Stir the melted butter with both sugars until combined. Whisk in the eggs and vanilla until smooth."
    },
    {
      "step": 4,
      "text": "Add the dry ingredients to the butter mixture and stir until no dry streaks remain. Fold in the dark chocolate chips."
    },
    {
      "step": 5,
      "text": "Transfer the dough to a baking pan and spread it evenly."
    },
    {
      "step": 6,
      "text": "Bake for 40 minutes, until the bars are set and lightly browned.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Cool before cutting into 24 bars."
    }
  ],
