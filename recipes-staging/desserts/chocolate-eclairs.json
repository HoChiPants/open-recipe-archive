  "instructions": [
    {
      "step": 1,
      "text": "Whisk the 300 ml milk, caster sugar, egg yolks, vanilla extract, plain flour, and cornflour until smooth."
    },
    {
      "step": 2,
      "text": "Heat the mixture gently, stirring constantly, until thick and the center reaches 160°F; chill until cold.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Heat the 125 ml milk and 100 g butter until the butter melts, then bring to a simmer."
    },
    {
      "step": 4,
      "text": "Add the 140 g plain flour and pinch of of sugar, stirring until a smooth dough forms and pulls from the pan."
    },
    {
      "step": 5,
      "text": "Transfer the dough to a bowl and beat in the eggs one at a time until glossy and pipeable."
    },
    {
      "step": 6,
      "text": "Pipe evenly sized lengths onto a baking sheet, leaving space between them."
    },
    {
      "step": 7,
      "text": "Bake until puffed, golden, and dry inside; cool completely before filling.",
      "timer_minutes": 25
    },
    {
      "step": 8,
      "text": "Whisk the double cream until thick, then fold or blend it with the chilled pastry cream."
    },
    {
      "step": 9,
      "text": "Split or pierce the cooled shells and fill them with the cream mixture."
    },
    {
      "step": 10,
      "text": "Melt the plain chocolate, 25 g butter, and icing sugar together until smooth and gently simmering."
    },
    {
      "step": 11,
      "text": "Spread the glaze over the filled eclairs and let it set before serving."
    }
  ],
