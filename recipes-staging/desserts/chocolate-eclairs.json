  "id": "chocolate-eclairs",
  "name": "Chocolate Eclairs",
  "subtitle": "Crisp choux pastries with vanilla cream and chocolate glaze",
  "description": "Bake light pastry shells, fill them with vanilla cream, and finish with a smooth chocolate topping.",
