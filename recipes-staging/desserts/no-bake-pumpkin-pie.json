  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the gelatin, cinnamon, ginger, nutmeg, and salt together in a saucepan."
    },
    {
      "step": 2,
      "text": "Stir in the condensed milk and beaten eggs. Warm over medium-low heat, stirring constantly, until the gelatin dissolves and the mixture reaches 160°F; do not boil.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Mix in the pumpkin puree until smooth, then pour the filling into the prepared graham cracker crust."
    },
    {
      "step": 4,
      "text": "Refrigerate until firm, about 3 hours, then slice and serve.",
      "timer_minutes": 180
    }
  ],
