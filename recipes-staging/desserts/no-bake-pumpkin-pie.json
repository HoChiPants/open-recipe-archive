  "id": "no-bake-pumpkin-pie",
  "name": "No-Bake Pumpkin Pie",
  "subtitle": "Spiced pumpkin filling in a chilled crumb crust",
  "description": "A cool-set pumpkin dessert with warm spices and a creamy condensed-milk filling.",
  "meal_type": "dessert",
  "cuisine": "American",
