  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking pan for the cake."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, MAGIC Baking Powder, baking soda, cinnamon, nutmeg, cloves, and salt."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, oil, and granulated sugar in a separate bowl until blended."
    },
    {
      "step": 4,
      "text": "Add the dry mixture, carrots, drained pineapple, and chopped walnuts or pecans to the egg mixture. Stir just until combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake at 350°F for 50 minutes.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Cool the cake in the pan for 10 minutes, then let it cool completely before icing.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Whisk the softened cream cheese and melted butter until smooth. Add the icing sugar, lemon juice, and grated lemon peel, and beat until creamy."
    },
    {
      "step": 8,
      "text": "Spread the icing over the completely cooled cake and serve."
    }
  ],
