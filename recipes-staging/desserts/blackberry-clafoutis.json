  "id": "blackberry-clafoutis",
  "name": "Blackberry Clafoutis",
  "subtitle": "A tender baked custard with fresh blackberries",
  "description": "Fresh blackberries baked in a lightly sweetened egg custard until set and golden.",
  "meal_type": "dessert",
  "cuisine": "French",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "6-ounce-container-fresh-blackberries",
      "item": "(6 ounce) container fresh blackberries",
      "quantity": 1,
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.875,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 7,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Butter a baking dish and add the blackberries."
    },
    {
      "step": 2,
      "text": "Stir together the milk and eggs."
    },
    {
      "step": 3,
      "text": "Combine the flour, white sugar, salt, and brown sugar until smooth, then incorporate the mixture into the milk and eggs."
    },
    {
      "step": 4,
      "text": "Pour the batter over the blackberries."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, or until the center is set.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Sprinkle with the white sugar and brown sugar, then return to the oven until golden brown."
    }
  ],
