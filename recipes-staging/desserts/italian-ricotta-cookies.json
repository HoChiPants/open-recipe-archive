  "id": "italian-ricotta-cookies",
  "name": "Italian Ricotta Cookies",
  "subtitle": "Soft ricotta cookies with vanilla icing",
  "description": "Tender ricotta cookies baked until lightly set and finished with a simple vanilla glaze.",
  "meal_type": "dessert",
  "cuisine": "Italian",
