  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare baking sheets."
    },
    {
      "step": 2,
      "text": "Whisk the softened 0.5 cup butter, white sugar, and confectioners' sugar until smooth. In a separate bowl, whisk the eggs, 1 teaspoon vanilla extract, and ricotta cheese; stir this mixture into the butter mixture."
    },
    {
      "step": 3,
      "text": "Combine the flour, baking soda, and salt, then stir the dry ingredients into the wet mixture until evenly blended."
    },
    {
      "step": 4,
      "text": "Portion the dough onto the prepared baking sheets and bake until the cookies are set.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Let the cookies cool for 5 minutes. Whisk the 2 tablespoons softened butter, confectioners' sugar, 0.25 teaspoon vanilla extract, and milk into a smooth icing, then spread it over the cooled cookies.",
      "timer_minutes": 5
    }
  ],
