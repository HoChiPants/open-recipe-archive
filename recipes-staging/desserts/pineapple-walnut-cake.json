  "id": "pineapple-walnut-cake",
  "name": "Pineapple Walnut Cake",
  "subtitle": "A moist pineapple cake with a nutty topping and warm milk glaze.",
  "description": "A simple fruit-filled cake finished with walnuts and a buttery stovetop glaze.",
  "meal_type": "dessert",
  "cuisine": "American",
