  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Whisk together the flour, 1 cup white sugar, baking soda, and salt."
    },
    {
      "step": 2,
      "text": "Stir in the pineapple with juice, eggs, and 1 teaspoon vanilla until combined. Spread the batter in a baking pan."
    },
    {
      "step": 3,
      "text": "Mix the brown sugar and walnuts, then scatter the mixture evenly over the batter."
    },
    {
      "step": 4,
      "text": "Bake until the cake is set in the center and a thermometer registers 160°F, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "While the cake bakes, heat the butter, 1/2 cup white sugar, evaporated milk, and the remaining vanilla in a saucepan. Cook until the mixture is smooth and hot."
    },
    {
      "step": 6,
      "text": "Pour the warm glaze over the baked cake and serve."
    }
  ],
