  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a cake pan for baking."
    },
    {
      "step": 2,
      "text": "Mix the packed brown sugar, pecans, cinnamon, nutmeg, and white sugar; set aside as the topping mixture."
    },
    {
      "step": 3,
      "text": "Whisk the flour, baking powder, baking soda, and salt together in a bowl."
    },
    {
      "step": 4,
      "text": "Beat the butter, white sugar, and apple butter until blended. Whisk in the eggs one at a time, then stir in the bran cereal or wheat germ and vanilla extract."
    },
    {
      "step": 5,
      "text": "Add the flour mixture and sour cream in alternating portions, whisking just until the batter is combined."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and add the topping mixture evenly over the surface."
    },
    {
      "step": 7,
      "text": "Bake for 40 minutes, until the center is firm and a tester inserted in the middle comes out clean. Cool before serving.",
      "timer_minutes": 40
    }
  ],
