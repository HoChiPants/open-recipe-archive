  "id": "apple-butter-spice-cake",
  "name": "Apple Butter Spice Cake",
  "subtitle": "A warmly spiced cake with a tender apple-butter crumb",
  "description": "Brown sugar, pecans, apple butter, and sour cream make this an aromatic, moist dessert for sharing.",
  "meal_type": "dessert",
