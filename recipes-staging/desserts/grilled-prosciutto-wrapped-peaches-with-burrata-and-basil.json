  "id": "grilled-prosciutto-wrapped-peaches-with-burrata-and-basil",
  "name": "Grilled Prosciutto-Wrapped Peaches with Burrata and Basil",
  "subtitle": "Sweet peaches with crisp prosciutto and creamy burrata",
  "description": "Grilled peach wedges pair with savory prosciutto, burrata, olive oil, basil, and a light seasoning for a simple Italian-inspired dessert.",
  "meal_type": "dessert",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 7
  },
  "ingredients": [
    {
      "ingredient_id": "ripe",
      "item": "ripe",
      "quantity": 2,
      "preparation": "sweet (but not soft) freestone peaches"
    },
    {
      "ingredient_id": "thin-slices-prosciutto",
      "item": "thin slices prosciutto",
      "quantity": 3,
      "preparation": "or more as needed, torn into ribbons"
    },
    {
      "ingredient_id": "bamboo-skewers",
      "item": "bamboo skewers",
      "quantity": 8,
      "unit": "small",
      "preparation": "soaked in water 20 minutes"
    },
    {
      "ingredient_id": "burrata-cheese",
      "item": "burrata cheese",
      "quantity": 6,
      "unit": "ounces"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra virgin olive oil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "for drizzling"
    },
    {
      "ingredient_id": "coarse-sea-salt-to-taste",
      "item": "Coarse sea salt to taste"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "Freshly ground black pepper",
      "preparation": "to taste"
    },
    {
      "ingredient_id": "finely-sliced-fresh-basil-leaves",
      "item": "finely sliced fresh basil leaves",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a grill to medium-high heat. Cut the peaches into wedges and wrap each piece with a ribbon of prosciutto."
    },
    {
      "step": 2,
      "text": "Thread the wrapped peach pieces onto the soaked skewers."
    },
    {
      "step": 3,
      "text": "Grill the skewers, turning as needed, until the peaches are warmed and lightly charred and the prosciutto is crisp, about 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Arrange the burrata on a serving platter and transfer the grilled peach skewers over or alongside it."
    },
    {
      "step": 5,
      "text": "Drizzle with olive oil, season with coarse sea salt and black pepper, and finish with the sliced basil."
    }
  ],
