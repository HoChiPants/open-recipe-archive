  "instructions": [
    {
      "step": 1,
      "text": "Combine the white sugar, white corn syrup, vanilla extract, and salt in a saucepan."
    },
    {
      "step": 2,
      "text": "Cook the mixture for 4 minutes, stirring as needed.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Stir in the peanut butter until blended, then fold in the cereal until evenly coated."
    },
    {
      "step": 4,
      "text": "Drop the mixture into about 50 portions on a prepared surface and let cool until set."
    }
