{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "mini-lemon-meringue-pies",
  "name": "Mini Lemon Meringue Pies",
  "subtitle": "Tangy lemon custard under a toasted meringue",
  "description": "Individual graham-crust pies filled with lemon custard and finished with a light almond-scented meringue.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "preparation": "separated"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "freshly-grated-lemon-zest",
      "item": "freshly grated lemon zest",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "freshly-squeezed-lemon-juice",
      "item": "freshly squeezed lemon juice",
      "quantity": 6,
      "unit": "tablespoons",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "prepared-mini-graham-cracker-pie-crusts",
      "item": "prepared mini graham cracker pie crusts",
      "quantity": 6
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Separate the eggs, keeping the whites in a clean mixing bowl and the yolks for the filling."
    },
    {
      "step": 2,
      "text": "Whisk the sugar, cornstarch, and flour in a saucepan. Gradually whisk in the water, lemon zest, and lemon juice until smooth."
    },
    {
      "step": 3,
      "text": "Cook the lemon mixture over medium heat, stirring and whisking, until thickened and set. Remove from the heat, whisk in the butter, then whisk in the egg yolks until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Divide the lemon filling among the mini graham cracker crusts."
    },
    {
      "step": 5,
      "text": "Beat the egg whites with the remaining white sugar and almond extract until stiff peaks form, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Spoon the meringue over the pies and spread it to the edges to seal."
    },
    {
      "step": 7,
      "text": "Bake until the meringue is golden brown, about 10 minutes. Cool before serving.",
      "timer_minutes": 10
    }
  ],
