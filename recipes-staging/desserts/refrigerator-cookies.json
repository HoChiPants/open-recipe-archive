  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "colored-sugar-for-decoration",
      "item": "colored sugar for decoration",
      "quantity": 0.33333334326744,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, salt, and baking soda together in a bowl."
    },
    {
      "step": 2,
      "text": "Stir the shortening, white sugar, eggs, vanilla extract, and colored sugar for decoration together until combined."
    },
    {
      "step": 3,
      "text": "Gradually mix in the flour mixture to form a dough."
    },
    {
      "step": 4,
      "text": "Shape the dough into logs, then roll the logs in white sugar and colored sugar for decoration."
    },
    {
      "step": 5,
      "text": "Chill the dough for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 6,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 7,
      "text": "Slice the chilled dough and arrange the rounds for baking."
    },
    {
      "step": 8,
      "text": "Bake for 10 minutes, until lightly browned.",
      "timer_minutes": 10
    },
    {
      "step": 9,
      "text": "Cool the cookies before serving."
    }
  ],
