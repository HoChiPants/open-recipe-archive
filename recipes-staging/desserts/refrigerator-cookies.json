  "id": "refrigerator-cookies",
  "name": "Refrigerator Cookies",
  "subtitle": "Slice-and-bake cookies with colorful sugar",
  "description": "A simple chilled cookie dough rolled in decorative sugar, sliced, and baked until lightly browned.",
  "meal_type": "dessert",
  "cuisine": "American",
