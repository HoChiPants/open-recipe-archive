  "id": "air-fryer-scones",
  "name": "Air Fryer Scones",
  "subtitle": "Tender scones for serving with jam and cream",
  "description": "Make a simple batch of British-style scones in the air fryer, then serve them with jam and clotted cream.",
  "meal_type": "dessert",
  "cuisine": "British",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 18
  },
  "ingredients": [
    {
      "ingredient_id": "self-raising-flour-plus-extra-for-dusting",
      "item": "self-raising flour plus extra for dusting",
      "quantity": 175,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "butter-cut-into-small-cubes",
      "item": "butter cut into small cubes",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "buttermilk-or-milk",
      "item": "buttermilk or milk",
      "quantity": 90,
      "unit": "ml"
    },
    {
      "ingredient_id": "milk-to-glaze",
      "item": "milk to glaze"
    },
    {
      "ingredient_id": "jam-and-clotted-cream",
      "item": "jam and clotted cream",
      "preparation": "to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to its instructions."
    },
    {
      "step": 2,
      "text": "Rub the butter into the flour and baking powder until the mixture resembles coarse crumbs. Stir in the sugar."
    },
    {
      "step": 3,
      "text": "Add the vanilla and buttermilk or milk, mixing just until a soft dough forms."
    },
    {
      "step": 4,
      "text": "Dust a work surface with flour. Pat the dough into a thick round and cut it into 8 scones."
    },
    {
      "step": 5,
      "text": "Brush the tops with milk and arrange the scones in the air-fryer basket with space between them."
    },
    {
      "step": 6,
      "text": "Air-fry for 18 minutes, or until risen and golden. Cool briefly, then serve with jam and clotted cream.",
      "timer_minutes": 18
    }
  ],
