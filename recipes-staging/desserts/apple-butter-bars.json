{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "apple-butter-bars",
  "name": "Apple Butter Bars",
  "subtitle": "Tender spiced bars with a simple vanilla glaze",
  "description": "Bake a warmly spiced apple butter batter with raisins, then finish the cooled bars with a thin confectioners’ sugar glaze.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "apple-butter",
      "item": "apple butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "apple-pie-spice",
      "item": "apple pie spice",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Lightly grease or line a baking pan suitable for 36 bars."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, baking soda, and apple pie spice."
    },
    {
      "step": 3,
      "text": "Beat the butter, packed brown sugar, and white sugar until blended. Whisk in the egg and apple butter."
    },
    {
      "step": 4,
      "text": "Add the dry mixture and stir until just combined. Fold in the raisins."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and spread it evenly."
    },
    {
      "step": 6,
      "text": "Bake until the center is firm and reaches 160°F, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Cool the bars completely in the pan."
    },
    {
      "step": 8,
      "text": "Combine the confectioners' sugar, vanilla extract, and milk with the apple butter and apple pie spice until smooth."
    },
    {
      "step": 9,
      "text": "Spread the glaze over the cooled slab, then cut into 36 bars."
    }
  ],
