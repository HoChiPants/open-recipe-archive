  "id": "peanut-butter-cookies-d07e4419",
  "name": "Peanut Butter Cookies",
  "subtitle": "Tender, lightly browned cookies with a classic peanut butter flavor",
  "description": "A straightforward American cookie made by creaming peanut butter with margarine and sugars, blending in eggs and vanilla, then baking shaped portions until lightly browned.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 54,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "creamy-peanut-butter",
      "item": "creamy peanut butter",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "packed-light-brown-sugar",
      "item": "packed light brown sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the creamy peanut butter, margarine, white sugar, and packed light brown sugar until smooth and well combined."
    },
    {
      "step": 3,
      "text": "Whisk in the eggs and vanilla extract."
    },
    {
      "step": 4,
      "text": "In a separate bowl, combine the all-purpose flour, baking powder, and baking soda. Stir this mixture into the wet ingredients to form a dough."
    },
    {
      "step": 5,
      "text": "Shape the dough into portions and prepare the specified packed light brown sugar and all-purpose flour for the shaping step. Arrange the portions on baking sheets."
    },
    {
      "step": 6,
      "text": "Bake for about 15 minutes, until lightly browned and fully set; cookies containing eggs should reach 160°F in the center if checked with a thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Cool the cookies on the baking sheets for 5 minutes before transferring them to a rack.",
      "timer_minutes": 5
    }
  ],
