  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "sweet-sticky-rice-with-mangoes",
  "name": "Sweet Sticky Rice with Mangoes",
  "subtitle": "Creamy coconut rice served with ripe mango",
  "description": "Tender glutinous rice absorbs sweet coconut milk and is paired with fresh mango and a lightly thickened coconut sauce.",
  "meal_type": "dessert",
  "cuisine": "Thai",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "uncooked-glutinous-sticky-white-rice",
      "item": "uncooked glutinous (sticky) white rice",
      "quantity": 2,
      "unit": "cups",
      "preparation": "rinsed"
    },
    {
      "ingredient_id": "coconut-milk",
      "item": "coconut milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "13.5 ounce, divided"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ripe-mangoes",
      "item": "ripe mangoes",
      "quantity": 2,
      "preparation": "peeled and cubed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Soak the rinsed rice in water for 30 minutes, then drain thoroughly.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Place the drained rice in a covered microwave-safe bowl with enough water to cook it. Microwave for 10 minutes, stir, and microwave for another 10 minutes, or until tender.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Warm part of the coconut milk with 1 cup sugar, then pour it over the hot rice and stir to combine. Cover and let the rice absorb the mixture for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Whisk the remaining coconut milk with the tablespoon of sugar, cornstarch, and salt until smooth."
    },
    {
      "step": 5,
      "text": "Bring the coconut mixture to a gentle simmer, stirring, until thickened; then let it cool.",
      "timer_minutes": 2
    },
    {
      "step": 6,
      "text": "Spoon the coconut rice onto plates, top with cubed mango, and drizzle with the cooled sauce."
    }
  ],
