  "id": "wild-blueberry-pie",
  "name": "Wild Blueberry Pie",
  "subtitle": "A classic double-crust pie with cinnamon-scented berries",
  "description": "Fresh blueberries are folded with sugar, flour, cinnamon, and almond extract, then baked beneath a buttery, milk-brushed crust.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "double-crust-pie-pastry",
      "item": "double-crust pie pastry",
      "quantity": 1,
      "unit": "package",
      "preparation": "14.1 ounce, thawed"
    },
    {
      "ingredient_id": "fresh-blueberries-preferably-wild",
      "item": "fresh blueberries (preferably wild)",
      "quantity": 5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "cut into small pieces"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Fit one pastry round into a pie dish and keep the second round ready for the top."
    },
    {
      "step": 2,
      "text": "Stir the blueberries, sugar, flour, and cinnamon together. Add the almond extract and mix until evenly distributed."
    },
    {
      "step": 3,
      "text": "Transfer the filling to the pastry-lined dish and dot the surface with the butter pieces."
    },
    {
      "step": 4,
      "text": "Cover with the remaining pastry, seal and crimp the edges, brush the top with milk, and cut several vents."
    },
    {
      "step": 5,
      "text": "Bake until the crust is golden and the filling is bubbling, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Cool before slicing so the filling can set."
    }
  ],
