  "id": "italian-biscotti",
  "name": "Italian Biscotti",
  "subtitle": "Twice-Baked Almond Cookies",
  "description": "Crisp almond biscotti flavored with anise and vanilla, baked twice for a firm texture.",
  "meal_type": "dessert",
  "cuisine": "Italian",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 12,
      "unit": "ounces"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6
    },
    {
      "ingredient_id": "anise-extract",
      "item": "anise extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 6,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "almonds",
      "item": "almonds",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the butter and white sugar until combined and creamy. Add the eggs and whisk until smooth, then stir in the anise extract and vanilla extract."
    },
    {
      "step": 3,
      "text": "Prepare the all-purpose flour, salt, and baking powder together. Stir the dry mixture into the wet mixture, then fold in the chopped almonds."
    },
    {
      "step": 4,
      "text": "Shape the dough into logs and transfer them to a baking sheet."
    },
    {
      "step": 5,
      "text": "Bake until firm.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cut the baked logs into slices."
    },
    {
      "step": 7,
      "text": "Arrange the slices on the baking sheet and bake until dry and crisp.",
      "timer_minutes": 10
    }
  ],
