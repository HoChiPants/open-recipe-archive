  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the 4 cups flour with the baking powder, baking soda, and salt."
    },
    {
      "step": 3,
      "text": "Beat the 1.3333333730698 cups sugar with the 0.5 cup butter until combined. Whisk in the eggs and vanilla extract."
    },
    {
      "step": 4,
      "text": "Add the flour mixture and buttermilk alternately, mixing just until incorporated. Fold in the blueberries."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a baking pan."
    },
    {
      "step": 6,
      "text": "Combine the 0.66666668653488 cup flour and 0.66666668653488 cup sugar. Cut in the softened butter until crumbly, then add the topping over the batter."
    },
    {
      "step": 7,
      "text": "Bake until the center is fully set and a thermometer inserted into the center reads at least 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Cool for 15 minutes before serving.",
      "timer_minutes": 15
    }
  ],
