  "id": "italian-spinach-and-sausage-pie",
  "name": "Italian Spinach and Sausage Pie",
  "subtitle": "A savory double-crust pie with spinach, sausage, and three cheeses",
  "description": "A hearty Italian-inspired pie filled with seasoned sausage, spinach, eggs, ricotta, and mozzarella beneath a golden pastry crust.",
  "meal_type": "dessert",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 8,
