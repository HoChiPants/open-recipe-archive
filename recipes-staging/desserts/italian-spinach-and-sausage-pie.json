  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Cook the sausage in a skillet over medium heat, stirring and crumbling it for about 10 minutes, until it reaches 160°F on a food thermometer. Drain and let cool briefly.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the eggs in a large bowl. Fold in the cooked sausage, mozzarella, spinach, ricotta, salt, garlic powder, and pepper."
    },
    {
      "step": 3,
      "text": "Fit one pastry crust into a pie plate. Add the filling and cover with the second crust. Trim and crimp the edges, then cut several vents in the top."
    },
    {
      "step": 4,
      "text": "Whisk the water and brush it over the pastry."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until the crust is golden and the center is firm and reaches 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Rest the pie for 10 minutes before slicing and serving.",
      "timer_minutes": 10
    }
  ],
