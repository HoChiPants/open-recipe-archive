  "id": "swedish-chocolate-balls",
  "name": "Swedish Chocolate Balls",
  "subtitle": "No-bake oat treats rolled in coconut",
  "description": "Chewy chocolate-oat balls made with coffee, vanilla, and melted baking chocolate, then chilled until firm.",
  "meal_type": "dessert",
  "cuisine": "Swedish",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "regular-rolled-oats",
      "item": "regular rolled oats",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter-or-margarine",
      "item": "butter or margarine",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "1-ounce-squares-unsweetened-baking-chocolate",
      "item": "(1 ounce) squares unsweetened baking chocolate",
      "quantity": 2,
      "preparation": "melted"
    },
    {
      "ingredient_id": "strong-coffee",
      "item": "strong coffee",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "coconut-flakes",
      "item": "coconut flakes",
      "quantity": 0.33333334326744,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the oats, sugar, and cocoa powder in a bowl. Add the softened butter or margarine and mix until the mixture is thick."
    },
    {
      "step": 2,
      "text": "Stir together the melted baking chocolate, coffee, and vanilla extract, then mix this into the oat mixture until evenly combined."
    },
    {
      "step": 3,
      "text": "Transfer the coconut flakes to a shallow dish. Shape the mixture into balls and roll each one in the coconut."
    },
    {
      "step": 4,
      "text": "Chill the balls for 120 minutes, or until firm.",
      "timer_minutes": 120
    }
  ],
