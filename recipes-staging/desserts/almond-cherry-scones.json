  "id": "almond-cherry-scones",
  "name": "Almond Cherry Scones",
  "subtitle": "Tender almond scones finished with cherries and a light sugar dusting",
  "description": "Buttery almond scones with a golden top, finished with cherries and optional raspberry jam and clotted cream.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "self-raising-flour-plus-extra-for-dusting",
      "item": "self-raising flour plus extra for dusting",
      "quantity": 350,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "cold-unsalted-butter-cut-into-cubes",
      "item": "cold unsalted butter cut into cubes",
      "quantity": 95,
      "unit": "g"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg-beaten",
      "item": "egg beaten",
      "quantity": 1
    },
    {
      "ingredient_id": "flaked-almonds",
      "item": "flaked almonds",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "raspberry-jam-and-clotted-cream",
      "item": "raspberry jam and clotted cream",
      "preparation": "to serve (optional)",
      "optional": true
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "glace-or-maraschino-cherries",
      "item": "glacé or maraschino cherries",
      "quantity": 6
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Line a baking sheet with parchment."
    },
    {
      "step": 2,
      "text": "Combine the flour, baking powder, caster sugar, and 25 g of the icing sugar. Rub in the cold butter until the mixture resembles coarse crumbs."
    },
    {
      "step": 3,
      "text": "Stir in the milk and almond extract just until a smooth, soft dough forms."
    },
    {
      "step": 4,
      "text": "Turn the dough onto a lightly floured surface and shape it into a round about 1 inch thick. Cut into 6 portions and arrange on the baking sheet."
    },
    {
      "step": 5,
      "text": "Brush the tops with the beaten egg and scatter over the flaked almonds."
    },
    {
      "step": 6,
      "text": "Bake until golden brown and the centers are fully set, reaching 160°F.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Cool on the baking sheet briefly, then transfer to a rack."
    },
    {
      "step": 8,
      "text": "Dust with the remaining icing sugar and top each scone with a cherry. Serve with the optional raspberry jam and clotted cream."
    }
  ],
