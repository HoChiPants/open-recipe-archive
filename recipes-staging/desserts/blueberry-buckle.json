  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Beat 0.75 cup sugar with the shortening, then mix in the egg."
    },
    {
      "step": 3,
      "text": "Stir together 2 cups flour, baking powder, and salt. Add the milk and mix until combined, then fold in the blueberries."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared dish."
    },
    {
      "step": 5,
      "text": "Combine the remaining sugar, 0.33333298563957 cup flour, softened butter, and cinnamon until crumbly. Sprinkle over the batter."
    },
    {
      "step": 6,
      "text": "Bake for 40 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    }
  ],
