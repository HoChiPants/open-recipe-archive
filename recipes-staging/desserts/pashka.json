  "id": "pashka",
  "name": "Pashka",
  "subtitle": "Chilled cottage cheese and cream cheese dessert",
  "description": "A rich, gently lemon-vanilla dessert with almonds and currants, finished by chilling until firm.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 480
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "8-ounce-container-cottage-cheese",
      "item": "(8 ounce) container cottage cheese",
      "quantity": 1
    },
    {
      "ingredient_id": "8-ounce-container-sour-cream",
      "item": "(8 ounce) container sour cream",
      "quantity": 1
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "finely-chopped-blanched-almonds",
      "item": "finely chopped blanched almonds",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "currants",
      "item": "currants",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lemon-extract",
      "item": "lemon extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened cream cheese, cottage cheese, sour cream, and melted butter until well combined."
    },
    {
      "step": 2,
      "text": "Fold in the sugar, almonds, currants, vanilla extract, and lemon extract."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a container."
    },
    {
      "step": 4,
      "text": "Cover and chill for 8 hours before serving.",
      "timer_minutes": 480
    }
