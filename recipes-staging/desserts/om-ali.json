  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "om-ali",
  "name": "Om Ali",
  "subtitle": "Crisp pastry layered with nuts, fruit, coconut, and warm milk",
  "description": "A baked pastry pudding finished with whipped cream and a golden top.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-puff-pastry-sheets",
      "item": "frozen puff pastry sheets",
      "quantity": 1,
      "unit": "package",
      "preparation": "17.5 ounce, thawed"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "hazelnuts",
      "item": "hazelnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Arrange the thawed puff pastry sheets on a baking sheet and bake until crisp and golden, about 20 minutes. Cool briefly, then break into pieces.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Combine the walnuts, pecans, hazelnuts, raisins, coconut, and 1 cup of the sugar."
    },
    {
      "step": 3,
      "text": "Layer the pastry pieces and nut mixture in a baking dish, finishing with a layer of the mixture."
    },
    {
      "step": 4,
      "text": "Warm the milk with the remaining sugar until steaming, then pour it evenly over the layered pastry."
    },
    {
      "step": 5,
      "text": "Whip the heavy cream to stiff peaks and spread it over the top."
    },
    {
      "step": 6,
      "text": "Bake until the surface is golden brown, about 10 minutes. Serve warm.",
      "timer_minutes": 10
    }
  ],
