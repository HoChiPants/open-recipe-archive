      "item": "crème fraîche to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Line a tart tin with the shortcrust pastry, trim the edges, and prepare the shell for baking."
    },
    {
      "step": 2,
      "text": "Bake the pastry shell until lightly set.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Melt the chopped chocolate and cubed butter together until smooth, then let the mixture cool slightly."
    },
    {
      "step": 4,
      "text": "Whisk the eggs with both sugars. Stir in the chocolate mixture, fold in the flour, and mix through the orange zest and juice."
    },
    {
      "step": 5,
      "text": "Pour the filling into the pastry shell and bake until the center is set and the surface is smooth.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Cool the tart, then serve with crème fraîche and additional orange zest.",
      "timer_minutes": 15
    }
  ],
