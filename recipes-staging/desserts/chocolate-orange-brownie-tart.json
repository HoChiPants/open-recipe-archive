  "id": "chocolate-orange-brownie-tart",
  "name": "Chocolate Orange Brownie Tart",
  "subtitle": "A crisp pastry tart with a fudgy chocolate-orange center.",
  "description": "A chocolate brownie filling scented with orange is baked in a shortcrust pastry shell and served with crème fraîche.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "pack-ready-made-shortcrust-pastry",
      "item": "pack ready-made shortcrust pastry",
      "quantity": 320,
      "unit": "g"
    },
    {
