  "id": "carrot-pie",
  "name": "Carrot Pie",
  "subtitle": "A smooth, warmly spiced carrot custard in a flaky crust.",
  "description": "Cooked carrots are blended with eggs, milk, sugar, cinnamon, and vanilla, then baked in a partially baked pie shell until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 55,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "9-inch-unbaked-pie-shell",
      "item": "(9 inch) unbaked pie shell",
      "quantity": 1
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 2,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.75,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Bake the unbaked pie shell for 5 minutes, until firm.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Simmer the chopped carrots for about 10 minutes, until tender.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Drain the carrots and process or mash them until smooth."
    },
    {
      "step": 5,
      "text": "Whisk the sugar and eggs together. Stir in the cinnamon, vanilla, milk, and carrot puree."
    },
    {
      "step": 6,
      "text": "Pour the filling into the pie shell. Reduce the oven temperature to 350°F and bake for about 45 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Cool the pie completely before serving."
    }
  ],
