  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine the blueberries, orange juice, 3 tablespoons sugar, and baking powder in a baking dish."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the flour, baking powder, and salt."
    },
    {
      "step": 4,
      "text": "Whisk the softened butter and ½ cup sugar until smooth. Whisk in the egg and vanilla extract."
    },
    {
      "step": 5,
      "text": "Add the dry ingredients to the butter mixture and stir until combined."
    },
    {
      "step": 6,
      "text": "Spread the topping over the blueberry mixture."
    },
    {
      "step": 7,
      "text": "Bake for 40 minutes, until golden brown and the center is fully set and reaches 160°F.",
      "timer_minutes": 40
    },
    {
      "step": 8,
      "text": "Let the cobbler rest briefly, then serve."
    }
  ],
