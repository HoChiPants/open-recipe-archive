  "id": "blueberry-cobbler",
  "name": "Blueberry Cobbler",
  "subtitle": "Juicy berries beneath a tender vanilla topping",
  "description": "Fresh blueberries are folded with citrus and sugar, then baked under a soft, lightly sweetened cobbler topping until golden and set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
