  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F (180°C). Combine the flour, salt, and 2 tablespoons icing sugar. Rub in the cold butter until crumbly, then mix in the beaten egg yolks to form a dough."
    },
    {
      "step": 2,
      "text": "Shape the dough into a disk, wrap, and chill for 30 minutes. Roll it out on a lightly floured surface and use it to line a tart pan.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Prepare the cranberry layer by cooking the cranberries, light brown sugar, and amaretto or orange liqueur until thickened, about 15 minutes. Set aside to cool.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Line the pastry with parchment and baking weights. Bake for 15 minutes, remove the weights, then bake for 10 minutes more. Trim the edge if needed.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "For the frangipane, whisk the softened salted butter with the caster sugar and 50 g icing sugar until combined. Mix in the orange zest and juice, ground almonds, crushed amaretti biscuits, almond extract, and beaten eggs."
    },
    {
      "step": 6,
      "text": "Spread the cranberry mixture over the pastry, then cover with the frangipane. Transfer to the oven and bake for about 40 minutes, until firm and the center reaches 160°F (71°C).",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Cool the tart. Whisk the remaining icing sugar with the amaretto or orange liqueur and enough orange juice to make a thick glaze, then drizzle it over the tart."
    },
    {
      "step": 8,
      "text": "Slice and serve with the flaked almonds scattered over the top."
    }
  ],
