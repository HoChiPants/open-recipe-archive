  "id": "banana-cheesecake-with-pineapple",
  "name": "Banana Cheesecake with Pineapple",
  "subtitle": "A chilled fruit cheesecake with chocolate and cherry toppings",
  "description": "A creamy no-bake dessert layered with a buttery graham cracker base, pineapple, bananas, whipped topping, chocolate syrup, cherries, and pecans.",
  "meal_type": "dessert",
  "cuisine": "American",
