  "instructions": [
    {
      "step": 1,
      "text": "Stir the graham cracker crumbs with the melted butter until evenly moistened."
    },
    {
      "step": 2,
      "text": "Press the crumb mixture into the bottom of a serving dish, reserving enough crumbs for a light layer over the base if desired."
    },
    {
      "step": 3,
      "text": "Beat the confectioners' sugar and cream cheese until smooth. Mix in the crushed pineapple and quartered bananas."
    },
    {
      "step": 4,
      "text": "Fold in the thawed whipped topping, then spread the filling over the crumb layer."
    },
    {
      "step": 5,
      "text": "Drizzle with the chocolate syrup and finish with the halved cherries and pecan halves."
    },
    {
      "step": 6,
      "text": "Cover and chill until firm, about 4 hours, before serving.",
      "timer_minutes": 240
    }
  ],
