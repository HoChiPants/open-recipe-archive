  "id": "almond-bars",
  "name": "Almond Bars",
  "subtitle": "Tender almond bars with a simple glaze",
  "description": "A buttery almond dessert baked in a pan, sliced into bars, and finished with a smooth confectioners’ sugar glaze.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
