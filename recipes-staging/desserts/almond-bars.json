  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Prepare a baking pan for the dough."
    },
    {
      "step": 2,
      "text": "Whisk the butter and white sugar until blended. Add the egg and 0.5 teaspoon almond extract, then mix until smooth."
    },
    {
      "step": 3,
      "text": "Stir together the flour, baking powder, and salt. Add the dry mixture to the butter mixture and combine into a dough."
    },
    {
      "step": 4,
      "text": "Shape the dough in the prepared pan, smooth the surface, and top with the sliced almonds. Sprinkle or brush with the 2 tablespoons milk."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until the center is fully set and reaches 160°F.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Cut into bars and let cool."
    },
    {
      "step": 7,
      "text": "Stir the confectioners' sugar, 0.25 teaspoon almond extract, and 0.25 cup milk until smooth. Spread or drizzle the glaze over the cooled bars."
    }
  ],
