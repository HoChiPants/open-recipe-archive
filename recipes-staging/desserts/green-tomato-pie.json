  "schema_version": "1.0.0",
  "id": "green-tomato-pie",
  "name": "Green Tomato Pie",
  "subtitle": "A warmly spiced double-crust pie with tart green tomatoes",
  "description": "Chopped green tomatoes are coated in vinegar and a cinnamon-spice filling, then enclosed in pastry and baked until golden.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "green-tomatoes",
      "item": "green tomatoes",
      "quantity": 5,
      "unit": "medium",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cider-vinegar",
      "item": "cider vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cloves",
      "item": "ground cloves",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "double-crust-pie-pastry",
      "item": "double-crust pie pastry",
      "quantity": 1,
      "unit": "package",
      "preparation": "14 ounce, thawed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Toss the chopped green tomatoes with the cider vinegar."
    },
    {
      "step": 3,
      "text": "Stir together the sugar, flour, cinnamon, nutmeg, salt, and cloves. Add this mixture to the tomatoes and coat evenly."
    },
    {
      "step": 4,
      "text": "Fit half of the thawed pastry into a pie dish and transfer the tomato filling into it."
    },
    {
      "step": 5,
      "text": "Cover with the remaining pastry, trim and seal the edges, and cut vents in the top crust."
    },
    {
      "step": 6,
      "text": "Bake for 35 minutes, until the crust is golden and the filling is bubbling.",
      "timer_minutes": 35
    }
  ],
