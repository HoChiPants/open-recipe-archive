      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine the chocolate cookie crumbs, 0.25 cup white sugar, and butter. Press the mixture evenly into a pie dish."
    },
    {
      "step": 3,
      "text": "Bake the crust for 10 minutes, then let it cool completely.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Whisk the cream cheese, creamy peanut butter, 1 cup white sugar, softened unsalted butter, and vanilla extract until smooth."
    },
    {
      "step": 5,
      "text": "Whisk in the heavy whipping cream until the filling is light and evenly blended. Spread it into the cooled crust."
    },
    {
      "step": 6,
      "text": "Chill the pie for 4 hours, garnish with chocolate cookie crumbs, and serve.",
      "timer_minutes": 240
    }
  ],
