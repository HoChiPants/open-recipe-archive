  "id": "peanut-butter-pie",
  "name": "Peanut Butter Pie",
  "subtitle": "A chilled pie with a crisp chocolate crust and creamy peanut-butter filling.",
  "description": "Bake a chocolate cookie crust, fill it with a smooth peanut-butter mixture, and chill until set for an easy dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 10,
    "inactive_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "chocolate-cookie-crumbs",
      "item": "chocolate cookie crumbs",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
