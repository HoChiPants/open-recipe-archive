  "id": "swedish-sticky-chocolate-cake",
  "name": "Swedish Sticky Chocolate Cake",
  "subtitle": "A rich, soft-centered chocolate cake with a fudgy finish.",
  "description": "This simple chocolate cake is baked until set at the edges while remaining pleasantly sticky in the center, then cooled and chilled before serving.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.3333333730698,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Combine the flour, cocoa powder, and salt in a bowl."
    },
    {
      "step": 3,
      "text": "Stir the sugar and eggs together until smooth."
    },
    {
      "step": 4,
      "text": "Add the dry mixture and stir until combined."
    },
    {
      "step": 5,
      "text": "Stir in the melted butter and vanilla until evenly combined."
    },
    {
      "step": 6,
      "text": "Transfer the batter to a prepared baking pan."
    },
    {
      "step": 7,
      "text": "Bake until the cake is set, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 8,
      "text": "Cool for 60 minutes, then chill before serving.",
      "timer_minutes": 60
    },
    {
      "step": 9,
      "text": "Serve chilled."
    }
  ],
