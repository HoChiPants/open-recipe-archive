  "id": "coconut-pecan-cookies",
  "name": "Coconut-Pecan Cookies",
  "subtitle": "Chewy cookies with toasted coconut and pecans",
  "description": "Browned coconut and pecans add rich, nutty flavor to these simple sugar cookies.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "coconut-flakes",
      "item": "coconut flakes",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "lightly-packed-brown-sugar",
      "item": "lightly packed brown sugar",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the coconut flakes, pecans, and brown sugar in a skillet over medium heat for 3 minutes, stirring, until lightly browned. Set aside to cool.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Whisk the softened butter, brown sugar, and white sugar until combined. Mix in the egg and vanilla extract."
    },
    {
      "step": 4,
      "text": "Stir in the flour and baking soda until a dough forms, then fold in the coconut-pecan mixture."
    },
    {
      "step": 5,
      "text": "Drop rounded portions of dough onto baking sheets, leaving space between them."
    },
    {
      "step": 6,
      "text": "Bake for about 10 minutes, until lightly browned and the centers are set.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Cool the cookies on the baking sheets for 5 minutes, then transfer them to a rack to cool completely.",
      "timer_minutes": 5
    }
  ],
