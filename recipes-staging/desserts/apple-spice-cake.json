  "id": "apple-spice-cake",
  "name": "Apple Spice Cake",
  "subtitle": "A tender apple cake with warm spices and raisins",
  "description": "A home-style American cake combining chopped apples, raisins, and aromatic spices, finished with a light dusting of confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
