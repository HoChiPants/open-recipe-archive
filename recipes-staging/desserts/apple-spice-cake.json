  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a cake pan for baking."
    },
    {
      "step": 2,
      "text": "Soak the raisins in the warm water for 10 minutes, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk together the flour, cinnamon, nutmeg, allspice, and salt."
    },
    {
      "step": 4,
      "text": "Beat the softened butter and white sugar until creamy. Add the eggs one at a time, then mix in the vanilla extract."
    },
    {
      "step": 5,
      "text": "Stir the baking soda with the warm water until smooth, then add it to the butter mixture."
    },
    {
      "step": 6,
      "text": "Fold in the dry ingredients, chopped apples, and drained raisins until combined."
    },
    {
      "step": 7,
      "text": "Transfer the batter to the prepared pan and bake for 60 minutes, until the center is fully set.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Cool the cake in the pan, then cool completely before serving."
    },
    {
      "step": 9,
      "text": "Dust with the confectioners' sugar before serving."
    }
  ],
