  "schema_version": "1.0.0",
  "id": "walnut-chocolate-toffee",
  "name": "Walnut Chocolate Toffee",
  "subtitle": "Buttery toffee layered with chocolate and walnuts",
  "description": "A crisp, buttery candy with brown sugar depth, semisweet chocolate, and chopped walnuts.",
  "meal_type": "dessert",
  "cuisine": "British",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Line a rimmed baking sheet with parchment. Set aside half of the chocolate chips for topping."
    },
    {
      "step": 2,
      "text": "Combine the butter, white sugar, and packed brown sugar in a heavy saucepan. Cook over medium heat, stirring, until the mixture reaches 300°F on a candy thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Stir in the chopped walnuts, then pour the hot toffee onto the prepared sheet and spread it into an even layer."
    },
    {
      "step": 4,
      "text": "Scatter the remaining chocolate chips over the surface. Let them soften, then spread the chocolate evenly."
    },
    {
      "step": 5,
      "text": "Cool completely until firm, then break or cut into pieces.",
      "timer_minutes": 30
    }
  ],
