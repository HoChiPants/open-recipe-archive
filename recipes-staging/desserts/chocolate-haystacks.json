  "id": "chocolate-haystacks",
  "name": "Chocolate Haystacks",
  "subtitle": "No-bake chocolate, oat, coconut, and almond clusters",
  "description": "A simple no-bake dessert made by coating oats, coconut, and almonds in a warm chocolate mixture, then chilling the clusters until firm.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 5,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 ounce"
    },
    {
      "ingredient_id": "coconut",
      "item": "coconut",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "almonds",
      "item": "almonds",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Line a tray or plate with parchment paper. Stir the rolled oats, coconut, and chopped almonds together in a bowl."
    },
    {
      "step": 2,
      "text": "Whisk the sugar, milk, butter, and salt in a saucepan over medium heat until the butter melts and the mixture comes to a brief boil."
    },
    {
      "step": 3,
      "text": "Remove the saucepan from the heat and stir in the chocolate chips and vanilla extract until smooth and combined."
    },
    {
      "step": 4,
      "text": "Pour the chocolate mixture over the oat mixture and stir until evenly coated."
    },
    {
      "step": 5,
      "text": "Drop spoonfuls onto the prepared tray and chill until set."
    }
  ],
