  "id": "easy-whipped-cream",
  "name": "Easy Whipped Cream",
  "subtitle": "A lightly tangy topping with vanilla sweetness",
  "description": "Whip chilled cream with sour cream, confectioners' sugar, and vanilla for a soft, creamy dessert topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
