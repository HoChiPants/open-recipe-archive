  "instructions": [
    {
      "step": 1,
      "text": "Combine the chilled heavy cream, sour cream, confectioners' sugar, and vanilla extract in a mixing bowl."
    },
    {
      "step": 2,
      "text": "Whip until the mixture is thick and holds its shape."
    },
    {
      "step": 3,
      "text": "Chill the whipped cream until ready to use."
    },
    {
      "step": 4,
      "text": "Spoon or pipe onto desserts before serving."
    }
