  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter, packed brown sugar, and white sugar until smooth."
    },
    {
      "step": 3,
      "text": "Whisk in the eggs, grated orange zest, vanilla extract, and orange extract."
    },
    {
      "step": 4,
      "text": "In a separate bowl, whisk together the all-purpose flour, baking soda, and ground cinnamon."
    },
    {
      "step": 5,
      "text": "Stir the dry mixture into the butter mixture until combined, then stir in the rolled oats and dried cranberries."
    },
    {
      "step": 6,
      "text": "Prepare portions of dough on baking sheets, leaving space between them."
    },
    {
      "step": 7,
      "text": "Bake for 12 minutes, until golden brown.",
      "timer_minutes": 12
    },
    {
      "step": 8,
      "text": "Cool the cookies for 2 minutes before serving.",
      "timer_minutes": 2
    }
  ],
