  "id": "cranberry-orange-oatmeal-cookies",
  "name": "Cranberry Orange Oatmeal Cookies",
  "subtitle": "Chewy oat cookies with citrus and dried cranberries",
  "description": "These oatmeal cookies combine orange zest and extracts with brown sugar, cinnamon, and dried cranberries for a warmly spiced, citrus-scented dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "grated-orange-zest",
      "item": "grated orange zest",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
