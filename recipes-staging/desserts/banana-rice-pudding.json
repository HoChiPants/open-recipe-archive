  "id": "banana-rice-pudding",
  "name": "Banana Rice Pudding",
  "subtitle": "Creamy rice pudding with caramelized banana",
  "description": "Cooked short-grain rice is folded into a custard-style pudding with banana and finished with whipped cream.",
  "meal_type": "dessert",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 24,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "banana",
      "item": "bananas",
      "quantity": 2
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "short-grain-white-rice",
      "item": "short-grain white rice",
      "quantity": 1,
      "unit": "cup",
      "preparation": "cooked"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 2
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "whipped-cream",
      "item": "whipped cream",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Slice the bananas and cook them with 1 tablespoon sugar over medium heat, stirring occasionally, until softened and lightly caramelized.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the milk, cooked rice, egg yolks, 3 tablespoons sugar, melted butter, and salt in a saucepan. Cook over medium-low heat, stirring constantly, until thickened and the mixture reaches 160°F or has a firm, fully set custard consistency.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir the cooked bananas into the rice pudding."
    },
    {
      "step": 4,
      "text": "Chill the pudding until set.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Whisk the whipped cream until smooth, then spoon it over the chilled pudding."
    },
    {
      "step": 6,
      "text": "Melt the remaining sugar in a small pan over medium heat until liquid, then drizzle it over the servings. Let the topping cool briefly before serving.",
      "timer_minutes": 4
    }
  ],
