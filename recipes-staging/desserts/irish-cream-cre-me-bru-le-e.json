  "id": "irish-cream-cre-me-bru-le-e",
  "name": "Irish Cream Crème Brûlée",
  "subtitle": "Silky baked custards with a crisp caramel topping",
  "description": "A make-ahead baked custard flavored with vanilla and Irish cream liqueur, finished with a thin layer of crackly sugar.",
  "meal_type": "dessert",
  "cuisine": "French Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 70,
    "inactive_minutes": 300
  },
  "ingredients": [
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 6,
      "unit": "large"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "irish-cream-liqueur",
      "item": "Irish cream liqueur",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "superfine-sugar-as-needed",
      "item": "superfine sugar as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 300°F. Arrange six ramekins in a deep baking pan."
    },
    {
      "step": 2,
      "text": "Warm the heavy cream, white sugar, and Irish cream liqueur until steaming and the sugar dissolves; do not boil."
    },
    {
      "step": 3,
      "text": "Whisk the egg yolks, vanilla extract, and Irish cream liqueur until combined. Gradually whisk in the warm cream mixture."
    },
    {
      "step": 4,
      "text": "Divide the custard among the ramekins. Add boiling water to the pan until it reaches about halfway up their sides."
    },
    {
      "step": 5,
      "text": "Bake until the centers are fully set and reach 160°F, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Transfer the ramekins from the water bath and cool, then chill until cold, about 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 7,
      "text": "Sprinkle each custard with superfine sugar as needed. Melt the sugar evenly with a kitchen torch until caramelized, then serve."
    }
  ],
