{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "marshmallow-cake",
  "name": "Marshmallow Cake",
  "subtitle": "A light, creamy chilled dessert",
  "description": "Melted marshmallows and cream cheese create a smooth filling enriched with lemon and folded with whipped cream in a graham cracker crust.",
  "meal_type": "dessert",
  "cuisine": "Japanese",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 5,
    "inactive_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "marshmallows",
      "item": "marshmallows",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "egg-yolk",
      "item": "egg yolk",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 0.5,
      "preparation": "juiced"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "9-inch-prepared-graham-cracker-crust",
      "item": "(9 inch) prepared graham cracker crust",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the marshmallows and milk in a saucepan over gentle heat, stirring until the marshmallows are melted."
    },
    {
      "step": 2,
      "text": "Beat the softened cream cheese with the heavy cream until smooth. Separately, whisk the heavy cream until soft peaks form."
    },
    {
      "step": 3,
      "text": "Stir the egg yolk into the warm marshmallow mixture and continue heating gently until it reaches 160°F, then remove from the heat."
    },
    {
      "step": 4,
      "text": "Fold the cream cheese mixture into the melted marshmallow mixture, then stir in the lemon juice."
    },
    {
      "step": 5,
      "text": "Fold in the whipped cream until evenly combined, transfer the filling to the prepared crust, and smooth the top."
    },
    {
      "step": 6,
      "text": "Refrigerate until set.",
      "timer_minutes": 180
    }
  ],
