  "id": "hazelnut-christmas-cookies",
  "name": "Hazelnut Christmas Cookies",
  "subtitle": "Buttery hazelnut cookies with colorful sprinkles",
  "description": "A crisp-edged, tender holiday cookie made with ground hazelnuts and a sprinkle topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15,
    "inactive_minutes": 480
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
