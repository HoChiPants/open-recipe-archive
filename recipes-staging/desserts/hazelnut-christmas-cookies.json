      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-hazelnuts",
      "item": "ground hazelnuts",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "multicolored-candy-sprinkles-jimmies",
      "item": "multicolored candy sprinkles (jimmies)",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "or amount needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Beat the softened butter, sugar, salt, and the unprepared egg until smooth."
    },
    {
      "step": 2,
      "text": "Mix the sifted flour with the baking soda, then stir in the ground hazelnuts. Add the dry mixture to the butter mixture and form a dough."
    },
    {
      "step": 3,
      "text": "Shape the dough into a log or disk, wrap it, and chill for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 4,
      "text": "Heat the oven to 375°F and prepare baking sheets."
    },
    {
      "step": 5,
      "text": "Cut the chilled dough into thick pieces and arrange them on the prepared sheets."
    },
    {
      "step": 6,
      "text": "Brush or coat the cookies with the beaten egg and add the candy sprinkles."
    },
    {
      "step": 7,
      "text": "Bake for 15 minutes, until lightly browned and the centers are firm and reach 160°F.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Cool the cookies on the baking sheets briefly, then transfer them to a rack."
    }
  ],
