{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "stabilized-whipped-cream",
  "name": "Stabilized Whipped Cream",
  "subtitle": "Light, firm cream for topping desserts",
  "description": "Gelatin helps this lightly sweetened whipped cream hold its shape for serving.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "unflavored-gelatin",
      "item": "unflavored gelatin",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour the cold water into a small microwave-safe bowl. Sprinkle the gelatin over it and let stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Microwave the bloomed gelatin for 10 seconds, then whisk until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the heavy whipping cream with the sugar and vanilla extract until it begins to thicken."
    },
    {
      "step": 4,
      "text": "Gradually whisk in the gelatin mixture, then continue whisking until stiff peaks form."
    },
    {
      "step": 5,
      "text": "Chill the finished whipped cream for 15 minutes before serving.",
      "timer_minutes": 15
    }
  ],
  "tags": [
    "dessert",
    "topping",
