  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "brown-sugar-butter-galettes",
  "name": "Brown Sugar Butter Galettes",
  "subtitle": "Thin, crisp cookies made in a preheated galette iron",
  "description": "A simple brown sugar, butter, and vanilla cookie dough shaped and cooked in a galette iron.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 144,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 1
  },
  "ingredients": [
    {
      "ingredient_id": "dark-brown-sugar",
      "item": "dark brown sugar",
      "quantity": 2,
      "unit": "pounds"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 7
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 6.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the dark brown sugar and butter together until smooth."
    },
    {
      "step": 2,
      "text": "Add the eggs and vanilla extract, then whisk until evenly combined."
    },
    {
      "step": 3,
      "text": "Stir in the flour to form a cohesive dough. Combine thoroughly, then chill until firm."
    },
    {
      "step": 4,
      "text": "Preheat the galette iron and prepare its cooking surface according to the appliance instructions."
    },
    {
      "step": 5,
      "text": "Preheat the iron for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 6,
      "text": "Shape the chilled dough into portions and transfer them to the iron."
    },
    {
      "step": 7,
      "text": "Cook until the galettes are set, about 1 minute, then remove and cool.",
      "timer_minutes": 1
    }
  ],
