{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cream-cheese-flan",
  "name": "Cream Cheese Flan",
  "subtitle": "Silky custard with a golden caramel coating",
  "description": "A smooth baked custard made with cream cheese, milk, eggs, and vanilla, finished with a crisp caramel layer.",
  "meal_type": "dessert",
  "cuisine": "Spanish",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 50,
    "inactive_minutes": 125
  },
  "ingredients": [
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "12 fluid ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6,
      "unit": "large"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "2-milk",
      "item": "2% milk",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Blend the sweetened condensed milk, evaporated milk, eggs, softened cream cheese, 2% milk, and vanilla extract until smooth."
    },
    {
      "step": 3,
      "text": "Cook the white sugar in a saucepan over medium heat for about 1 minute, then continue cooking until it becomes golden brown, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Carefully pour the boiling caramel into a baking mold and tilt the mold to coat the bottom."
    },
    {
      "step": 5,
      "text": "Pour the custard mixture over the caramel."
    },
    {
      "step": 6,
      "text": "Bake until the flan is set and the center reaches 160°F, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Let the flan cool for 5 minutes, then chill until firm, about 125 minutes.",
      "timer_minutes": 125
    },
    {
      "step": 8,
      "text": "Run a knife around the edge and invert the flan onto a serving plate."
    }
  ],
