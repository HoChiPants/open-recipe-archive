  "id": "sugar-cookie-bars",
  "name": "Sugar Cookie Bars",
  "subtitle": "Soft cookie bars with almond-vanilla frosting",
  "description": "A buttery sugar cookie base is baked in a pan, cooled, and finished with a smooth almond-vanilla frosting.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 35,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "at room temperature"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 5,
      "unit": "cups"
    },
    {
