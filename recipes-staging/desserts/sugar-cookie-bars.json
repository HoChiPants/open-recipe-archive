      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "at room temperature"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 5,
      "unit": "tablespoons",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the white sugar, 1 cup butter, and confectioners' sugar until combined. Add the eggs, almond extract, and vanilla extract, mixing after each addition."
    },
    {
      "step": 3,
      "text": "Whisk together the flour, 0.75 teaspoon salt, and baking soda. Stir the dry mixture into the sugar mixture until combined."
    },
    {
      "step": 4,
      "text": "Transfer the dough to a baking pan and spread it evenly. Bake for 15 minutes, or until the center is fully set.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Cool the bars completely for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Whisk 0.5 cup butter with the heavy whipping cream until smooth. Add the almond extract and 0.25 teaspoon salt, then add the confectioners' sugar and mix until combined. Whisk in additional heavy whipping cream as needed until smooth."
    },
    {
      "step": 7,
      "text": "Transfer the frosting onto the cooled bars and spread evenly before serving."
    }
  ],
