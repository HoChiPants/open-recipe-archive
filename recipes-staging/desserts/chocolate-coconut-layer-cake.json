  "id": "chocolate-coconut-layer-cake",
  "name": "Chocolate Coconut Layer Cake",
  "subtitle": "A fudgy chocolate cake with a sweet coconut layer and chocolate frosting",
  "description": "Bake a simple cocoa cake, top it with a thick coconut mixture, and finish with chocolate frosting before chilling until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
