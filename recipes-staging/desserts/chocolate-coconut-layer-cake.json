  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease and lightly flour a baking pan."
    },
    {
      "step": 2,
      "text": "Melt the butter over low heat. Remove from the heat and stir in the white sugar, beaten eggs, and vanilla extract."
    },
    {
      "step": 3,
      "text": "Whisk together the flour, cocoa powder, salt, and baking powder. Stir the dry mixture into the butter mixture until smooth."
    },
    {
      "step": 4,
      "text": "Spread the batter in the prepared pan and bake for 30 minutes, or until the center is fully set and reaches 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cool the cake completely in the pan."
    },
    {
      "step": 6,
      "text": "Whisk the flaked coconut, sweetened condensed milk, and confectioners' sugar until thick. Spread the mixture over the cooled cake."
    },
    {
      "step": 7,
      "text": "Spread the prepared milk chocolate frosting over the coconut layer."
    },
    {
      "step": 8,
      "text": "Chill for 15 minutes, or until the topping is set, then cut into servings.",
      "timer_minutes": 15
    }
  ],
