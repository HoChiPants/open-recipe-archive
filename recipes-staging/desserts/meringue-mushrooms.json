{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "meringue-mushrooms",
  "name": "Meringue Mushrooms",
  "subtitle": "Light, crisp meringues shaped like woodland mushrooms",
  "description": "Pipe crisp meringue caps and stems, dust them with cocoa, then join the pieces with melted chocolate for a playful French dessert.",
  "meal_type": "dessert",
  "cuisine": "French",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cream-of-tartar",
      "item": "cream of tartar",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "chocolate-confectioners-coating",
      "item": "chocolate confectioners' coating",
      "quantity": 4,
      "unit": "ounces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 225°F and line baking sheets with parchment."
    },
    {
      "step": 2,
      "text": "Whisk the egg whites with the vanilla extract, cream of tartar, and salt until foamy. Gradually add the white sugar and continue whisking to soft peaks."
    },
    {
      "step": 3,
      "text": "Transfer the meringue to a piping bag. Pipe rounded caps and narrow stems onto the prepared sheets, keeping the pieces separate."
    },
    {
      "step": 4,
      "text": "Dust the piped pieces lightly with unsweetened cocoa powder."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until the meringues are dry and set; verify that the egg-based meringue reaches 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool the meringues completely before assembling."
    },
    {
      "step": 7,
      "text": "Microwave the chocolate confectioners' coating in short intervals until melted and simmering. Transfer it to a small bowl and prepare it for dipping."
    },
    {
      "step": 8,
      "text": "Dip the base of each stem in the coating, attach it to a cap, and let the chocolate set."
    }
  ],
