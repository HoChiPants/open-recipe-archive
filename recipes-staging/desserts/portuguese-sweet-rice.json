  "id": "portuguese-sweet-rice",
  "name": "Portuguese Sweet Rice",
  "subtitle": "Creamy rice pudding with a lightly sweet custard finish",
  "description": "A simple stovetop rice pudding made with milk, sugar, rice, and beaten eggs.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.5,
      "unit": "quarts"
    },
    {
      "ingredient_id": "uncooked-white-rice",
      "item": "uncooked white rice",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk and sugar together in a large saucepan until steaming, then stir in the rice."
    },
    {
      "step": 2,
      "text": "Simmer gently, stirring occasionally, until the rice is tender and the mixture is thick and creamy.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Whisk a little of the hot rice mixture into the beaten eggs, then stir the egg mixture back into the saucepan. Continue cooking until the pudding reaches 160°F or has a firm, fully set consistency."
    },
    {
      "step": 4,
      "text": "Serve warm."
    }
  ],
