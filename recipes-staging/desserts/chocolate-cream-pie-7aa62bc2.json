  "name": "Chocolate Cream Pie",
  "subtitle": "Silky chocolate custard in a cookie crust",
  "description": "A chilled chocolate cream pie with a chocolate biscuit base, rich custard filling, and softly whipped cream topping.",
  "meal_type": "dessert",
