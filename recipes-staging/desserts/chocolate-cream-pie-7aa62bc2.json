  "instructions": [
    {
      "step": 1,
      "text": "Crush the chocolate crème-filled sandwich biscuits into fine crumbs and combine them with the butter melted. Press the mixture evenly into a pie dish and chill while preparing the filling."
    },
    {
      "step": 2,
      "text": "Whisk the egg yolks (freeze the whites for another recipe) with the cornflour until smooth."
    },
    {
      "step": 3,
      "text": "Heat the whole milk with the caster sugar until hot but not boiling. Gradually whisk it into the yolk mixture, then return everything to the pan."
    },
    {
      "step": 4,
      "text": "Cook over medium heat, whisking constantly, until the custard thickens and reaches 160°F, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Remove from the heat and stir in the salted butter chopped, dark chocolate (at least 70% cocoa solids), and vanilla extract until melted and smooth."
    },
    {
      "step": 6,
      "text": "Pour the filling into the crust and chill until set, at least 4 hours or overnight.",
      "timer_minutes": 240
    },
    {
      "step": 7,
      "text": "Whisk the whipping or double cream with the icing sugar and vanilla extract to soft peaks. Spread it over the chilled pie."
    },
    {
      "step": 8,
      "text": "Finish with chocolate shavings to decorate and serve chilled."
    }
  ],
