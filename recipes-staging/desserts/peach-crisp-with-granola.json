  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Toss the peaches with the cinnamon, nutmeg, allspice, 1 tablespoon of the flour, and the pecans. Transfer the mixture to a baking dish."
    },
    {
      "step": 3,
      "text": "Combine the oats, granola, brown sugar, and remaining flour. Cut in the butter until coarse crumbs form."
    },
    {
      "step": 4,
      "text": "Scatter the topping evenly over the peaches and bake until golden brown, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
