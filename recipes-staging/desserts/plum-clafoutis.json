  "id": "plum-clafoutis",
  "name": "Plum Clafoutis",
  "subtitle": "A baked French custard with ripe plums and lemon",
  "description": "Halved prune plums bake beneath a lightly spiced, lemon-scented custard until puffed and firmly set.",
  "meal_type": "dessert",
  "cuisine": "French",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 6,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "italian-prune-plums",
      "item": "Italian prune plums",
      "quantity": 14,
      "preparation": "halved and pitted"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.3333333730698,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-lemon-zest",
      "item": "grated lemon zest",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vanilla",
      "item": "vanilla",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Arrange the halved, pitted plums in a baking dish and sprinkle with part of the divided white sugar."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, milk, flour, remaining white sugar, lemon zest, vanilla, salt, and cinnamon until smooth, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Pour the batter over the plums."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until puffed and firm in the center; verify the egg mixture reaches 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Let the clafoutis stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Dust with the confectioners' sugar before serving."
    }
  ],
