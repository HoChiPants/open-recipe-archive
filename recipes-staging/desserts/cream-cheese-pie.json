  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cream-cheese-pie",
  "name": "Cream Cheese Pie",
  "subtitle": "Smooth custard filling with a tangy cream topping",
  "description": "A baked cream cheese dessert in a graham cracker crust, finished with a lightly sweetened sour cream layer.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "9-inch-prepared-graham-cracker-crust",
      "item": "(9 inch) prepared graham cracker crust",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Beat the softened cream cheese with the eggs, 1 cup white sugar, and 1 teaspoon vanilla extract until smooth."
    },
    {
      "step": 2,
      "text": "Pour the filling into the prepared graham cracker crust and bake for 35 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 35
    },
    {
      "step": 3,
      "text": "Whisk the sour cream with 2 tablespoons white sugar and 0.25 teaspoon vanilla extract until smooth."
    },
    {
      "step": 4,
      "text": "Raise the oven temperature to 450°F. Spread the sour cream mixture over the pie and bake until the topping is set."
    }
  ],
