  "id": "peanut-butter-fudge-cookies",
  "name": "Peanut Butter Fudge Cookies",
  "subtitle": "Soft peanut butter cookies with a chocolate fudge center",
  "description": "Peanut butter cookie cups are baked, filled with condensed-milk chocolate fudge, and finished with pecans.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
