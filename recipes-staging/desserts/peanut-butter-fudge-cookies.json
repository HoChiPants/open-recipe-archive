  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Combine the flour, baking soda, and salt in a bowl."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter, peanut butter, white sugar, and brown sugar until smooth. Mix in the egg and 0.5 teaspoon vanilla extract."
    },
    {
      "step": 3,
      "text": "Stir the dry mixture into the butter mixture just until a dough forms. Shape the dough into 24 portions and place them in a prepared baking pan, pressing each into a cup."
    },
    {
      "step": 4,
      "text": "Warm the milk chocolate chips and semi-sweet chocolate chips with the condensed milk over simmering water, stirring until smooth. Remove from the heat and blend in 1 teaspoon vanilla extract."
    },
    {
      "step": 5,
      "text": "Fill the dough cups with the chocolate mixture and bake until lightly browned and the centers are set, reaching at least 160°F.",
      "timer_minutes": 16
    },
    {
      "step": 6,
      "text": "Cool the cookies in the pan for 5 minutes, then top each with pecan halves and let the filling firm before serving.",
      "timer_minutes": 5
    }
  ],
