  "id": "irish-barmbrack",
  "name": "Irish Barmbrack",
  "subtitle": "Tea-soaked fruit cake with citrus and warm spice",
  "description": "A tender fruit-studded cake made with black tea, marmalade, orange zest, cinnamon, and nutmeg.",
  "meal_type": "dessert",
