  "instructions": [
    {
      "step": 1,
      "text": "Combine the chopped dried fruit with the hot black tea and let stand for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Heat the oven to 350°F and prepare a loaf pan."
    },
    {
      "step": 3,
      "text": "Stir together the flour, cinnamon, nutmeg, and baking soda."
    },
    {
      "step": 4,
      "text": "Whisk the egg, sugar, marmalade, and orange zest until smooth."
    },
    {
      "step": 5,
      "text": "Stir in the soaked fruit and tea, then fold in the dry mixture until just combined."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and bake for 60 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Cool in the pan for 120 minutes before serving.",
      "timer_minutes": 120
    }
  ],
