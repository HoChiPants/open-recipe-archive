  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a 16-cup fairy-cake or muffin tin with paper cases."
    },
    {
      "step": 2,
      "text": "Whisk the vegetable oil, low-fat natural yogurt, beaten egg, orange zest, and orange gel food colouring until combined."
    },
    {
      "step": 3,
      "text": "Mix the light brown soft sugar, self-raising flour, and cinnamon in a separate bowl. Add the wet mixture and stir until just combined."
    },
    {
      "step": 4,
      "text": "Fold in the coarsely grated carrot and divide the batter among the cases."
    },
    {
      "step": 5,
      "text": "Bake for 15–20 minutes, until risen and a skewer comes out clean. The centers should be firm and fully set, or register at least 160°F; cool completely.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Whisk the cream cheese, room-temperature low-fat Greek yogurt, and maple syrup until smooth. Tint with green gel food colouring."
    },
    {
      "step": 7,
      "text": "Spread or pipe the frosting over the cooled cakes. Add the quartered strawberries and place one bunny on each cake."
    },
    {
      "step": 8,
      "text": "If using the remaining yogurt mixture for decoration, tint it orange with orange gel food colouring and chill for 60 minutes before transferring or cutting as needed.",
      "timer_minutes": 60
    }
  ],
