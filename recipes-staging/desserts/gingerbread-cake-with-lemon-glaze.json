  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking pan for the cake."
    },
    {
      "step": 2,
      "text": "Whisk the flour, ground ginger, baking soda, cinnamon, salt, and five-spice powder together."
    },
    {
      "step": 3,
      "text": "Stir the white sugar, molasses, vegetable oil, beaten egg, and boiling water together until smooth, then gradually whisk in the dry mixture.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared pan and bake for 35 minutes, until the center is firm and a thermometer inserted in the center reads at least 160°F.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Whisk the powdered sugar, lemon juice, and lemon zest into a smooth glaze."
    },
    {
      "step": 6,
      "text": "Cool the cake, then spread or drizzle the glaze over it before serving."
    }
  ],
