  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the sugar, water, and cinnamon sticks in a saucepan. Bring to a simmer and cook for 15 minutes to make a syrup.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Slice the bread and spread the slices with butter. Arrange a layer in a baking dish."
    },
    {
      "step": 4,
      "text": "Scatter raisins, pineapple, chopped walnuts, and sliced cheese over the bread. Add another layer of bread and cheese."
    },
    {
      "step": 5,
      "text": "Remove the cinnamon sticks from the syrup and pour the syrup evenly over the assembled pudding."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until the bread is soaked and the cheese is melted.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Let cool for 15 minutes before serving.",
      "timer_minutes": 15
    }
  ],
