  "id": "capirotada",
  "name": "Capirotada",
  "subtitle": "Mexican bread pudding with cinnamon syrup, fruit, cheese, and walnuts",
  "description": "A layered bread pudding baked with cinnamon syrup, raisins, pineapple, cheese, and chopped walnuts.",
  "meal_type": "dessert",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
