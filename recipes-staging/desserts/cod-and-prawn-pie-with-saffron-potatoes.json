  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven for baking and prepare a medium baking dish."
    },
    {
      "step": 2,
      "text": "Warm 1 tbsp olive oil in a large pan. Add the peppers, chopped garlic, and bay leaves; cook until the peppers begin to soften.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the smoked paprika, stock, and passata. Simmer until slightly thickened, then remove the bay leaves.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the prawns, cod, olives, and parsley to the sauce. Transfer the mixture to the baking dish."
    },
    {
      "step": 5,
      "text": "Steep the saffron threads in a little hot water. Toss the sliced potatoes with the remaining olive oil, grated garlic, and saffron mixture, then arrange them over the seafood."
    },
    {
      "step": 6,
      "text": "Bake until the potatoes are tender and browned and the seafood is cooked through. Check that the fish reaches 145°F or is opaque and flakes easily, and that the prawns are opaque.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Meanwhile, simmer the broccoli or green beans until tender; drain and serve with the pie."
    }
  ],
