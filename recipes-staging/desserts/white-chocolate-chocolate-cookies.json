  "id": "white-chocolate-chocolate-cookies",
  "name": "White Chocolate Chocolate Cookies",
  "subtitle": "Fudgy cocoa cookies with white chocolate chips",
  "description": "Rich chocolate cookies with crisp edges, soft centers, and creamy white chocolate pieces.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "white-chocolate-chips",
      "item": "white chocolate chips",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cream the butter, white sugar, and brown sugar until smooth. Beat in the eggs one at a time."
    },
    {
      "step": 3,
      "text": "Whisk together the cocoa powder, flour, and baking soda. Add the dry mixture to the butter mixture and stir just until combined."
    },
    {
      "step": 4,
      "text": "Fold in the white chocolate chips. Portion the dough onto baking sheets, leaving space between portions."
    },
    {
      "step": 5,
      "text": "Bake until the cookies are set at the edges and still soft in the centers.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Cool the cookies on the baking sheets for 5 minutes, then transfer them to a rack to finish cooling.",
      "timer_minutes": 5
    }
  ],
