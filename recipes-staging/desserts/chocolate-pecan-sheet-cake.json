  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease and prepare a sheet pan."
    },
    {
      "step": 2,
      "text": "Whisk the white sugar, flour, and salt together in a large bowl."
    },
    {
      "step": 3,
      "text": "Bring the water, shortening, margarine, and 3 tablespoons cocoa powder to a boil. Pour the hot mixture over the flour mixture and stir until smooth."
    },
    {
      "step": 4,
      "text": "Mix in the baking soda, buttermilk, beaten eggs, and 1 teaspoon vanilla extract. Spread the batter in the prepared pan."
    },
    {
      "step": 5,
      "text": "Bake until the cake is set, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "For the icing, combine the confectioners' sugar, 3 tablespoons cocoa powder, butter, and milk in a saucepan. Bring to a boil, then remove from the heat and stir in the remaining vanilla extract and pecans."
    },
    {
      "step": 7,
      "text": "Spread the hot icing over the warm cake and let it cool before slicing."
    }
  ],
