  "ingredients": [
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 2
    },
    {
      "ingredient_id": "dark-brown-sugar",
      "item": "dark brown sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.33329999446869,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the egg whites, brown sugar, and water together in a heatproof bowl."
    },
    {
      "step": 2,
      "text": "Cook the mixture over simmering water, stirring constantly, until it reaches 160°F and begins to boil; continue cooking for 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Remove from the heat and stir in the vanilla extract while the mixture is still boiling hot."
    },
    {
      "step": 4,
      "text": "Beat until the frosting thickens and holds its shape, then use immediately."
    }
  ],
