  "id": "brown-sugar-frosting",
  "name": "Brown Sugar Frosting",
  "subtitle": "A light, glossy frosting with caramel notes",
  "description": "A simple cooked frosting made with egg whites, dark brown sugar, and vanilla.",
  "meal_type": "dessert",
  "cuisine": "French",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
