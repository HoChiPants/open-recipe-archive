  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Lightly oil two cake tins and line their bases with parchment."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, buttermilk, oil, and cooled coffee together until combined."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the flour, bicarbonate of soda, baking powder, caster sugar, and light brown sugar. Add the wet mixture and stir just until smooth."
    },
    {
      "step": 4,
      "text": "Divide the batter between the prepared tins and bake for about 25 minutes, until risen and a thermometer inserted in the center reads at least 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Cool the cakes in the tins for 10 minutes, then turn them out and cool completely.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Whisk the double cream, mascarpone, sifted icing sugar, cocoa powder, and Irish cream liqueur until thick and spreadable."
    },
    {
      "step": 7,
      "text": "Place one cooled cake on a serving plate, spread with some frosting, and top with the second cake. Cover the top and sides with the remaining frosting."
    },
    {
      "step": 8,
      "text": "Decorate with the optional chocolate shavings or chocolate-coated coffee beans."
    }
  ],
