  "id": "cookies-and-cream-fridge-cake",
  "name": "Cookies and Cream Fridge Cake",
  "subtitle": "A chilled chocolate cookie and cream dessert",
  "description": "Layer chocolate cream-filled cookies with vanilla mascarpone cream, then finish with melted dark chocolate and chill until set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "flavourless-oil-such-as-vegetable",
      "item": "flavourless oil (such as vegetable)",
      "preparation": "for the tin"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 600,
      "unit": "ml"
    },
    {
      "ingredient_id": "mascarpone-or-soft-cheese",
      "item": "mascarpone or soft cheese",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "x-154g-packets-chocolate-cream-filled-sandwich-cookies-plus-extra-to-serve",
      "item": "x 154g packets chocolate cream-filled sandwich cookies plus extra to serve",
      "quantity": 4
    },
    {
      "ingredient_id": "dark-chocolate-broken-into-small-pieces",
      "item": "dark chocolate broken into small pieces",
      "quantity": 200,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly oil a loaf tin or similarly sized cake tin."
    },
    {
      "step": 2,
      "text": "Whisk the double cream, mascarpone or soft cheese, vanilla extract, and icing sugar until smooth."
    },
    {
      "step": 3,
      "text": "Crush or break the chocolate cream-filled sandwich cookies and fold them into the cream mixture with the dark chocolate pieces."
    },
    {
      "step": 4,
      "text": "Spread the mixture evenly in the prepared tin and smooth the surface."
    },
    {
      "step": 5,
      "text": "Melt the remaining cookie pieces and dark chocolate in a microwave-safe bowl using short bursts, stirring between each, until smooth. Let cool for 10 minutes."
    },
    {
      "step": 6,
      "text": "Pour the cooled chocolate mixture over the cake and arrange extra cookies on top."
    },
    {
      "step": 7,
      "text": "Refrigerate until set, about 1 hour, then slice and serve."
    }
  ],
