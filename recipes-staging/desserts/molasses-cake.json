  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking soda, salt, cinnamon, cloves, and ginger together."
    },
    {
      "step": 3,
      "text": "Beat the shortening and brown sugar until smooth. Add the molasses and eggs, then whisk until combined."
    },
    {
      "step": 4,
      "text": "Stir the dry mixture into the molasses mixture, alternating with the hot brewed coffee. Mix just until smooth."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake until the cake is set and a tester comes out clean, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Cool before serving."
    }
  ],
