      "item": "golden caster sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract (optional)",
      "quantity": 1,
      "unit": "tsp",
      "optional": true
    },
    {
      "ingredient_id": "glace-cherries-patted-dry-if-in-syrup",
      "item": "glacé cherries patted dry if in syrup",
      "quantity": 75,
      "unit": "g",
      "preparation": "then quartered"
    },
