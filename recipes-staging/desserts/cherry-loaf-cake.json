  "id": "cherry-loaf-cake",
  "name": "Cherry Loaf Cake",
  "subtitle": "A buttery loaf with cherries, almonds, and a light icing",
  "description": "Bake a tender cherry-studded loaf with almond flavor, then finish it with a simple icing and toasted almond flakes.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 55
  },
  "ingredients": [
