      "preparation": "toasted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease a loaf tin with some of the butter."
    },
    {
      "step": 2,
      "text": "Whisk the remaining butter with the golden caster sugar until creamy. Beat in the eggs, vanilla extract, and optional almond extract."
    },
    {
      "step": 3,
      "text": "Stir together the self-raising flour, ground almonds, and baking powder. Fold this mixture into the butter mixture, then fold in the quartered cherries until the batter is smooth."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the tin and bake for 55 minutes, until the center is fully set and a thermometer reads 160°F.",
      "timer_minutes": 55
    },
    {
      "step": 5,
      "text": "Cool in the tin for 10 minutes, then transfer the loaf to a rack to cool further.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Whisk the icing sugar with the remaining flavorings and enough milk to make a thick icing. Spread it over the cooled loaf and finish with the toasted flaked almonds."
    }
  ],
