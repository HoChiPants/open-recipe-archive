  "id": "chocolate-ganache-drip-cake",
  "name": "Chocolate Ganache Drip Cake",
  "subtitle": "Layered chocolate cake with silky frosting and ganache",
  "description": "A celebratory layered sponge finished with smooth buttercream, dark chocolate ganache, and optional decorative toppings.",
  "meal_type": "dessert",
