  "instructions": [
    {
      "step": 1,
      "text": "Grease and line the cake tins. Preheat the oven to the required baking temperature."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter and 340 g caster sugar until smooth. Beat in the eggs and 1 tsp vanilla extract, then fold in the flour and baking powder. Stir in the milk."
    },
    {
      "step": 3,
      "text": "Divide the batter among the prepared tins and bake until risen and set.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Leave the cakes in the tins briefly, then transfer them to a rack and cool completely.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "For the frosting, whisk the softened unsalted butter with the double cream until smooth."
    },
    {
      "step": 6,
      "text": "Place the egg whites and 225 g caster sugar over a pan of gently simmering water, whisking until the mixture reaches 160°F.",
      "timer_minutes": 4
    },
    {
      "step": 7,
      "text": "Remove from the heat and whisk until thick and cooled.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Gradually whisk the butter mixture into the meringue, then add the remaining 1 tsp vanilla extract and beat until smooth.",
      "timer_minutes": 5
    },
    {
      "step": 9,
      "text": "Chill the frosting until firm enough to spread, then whisk it briefly until smooth.",
      "timer_minutes": 45
    },
    {
      "step": 10,
      "text": "Stack the cooled cakes with frosting between the layers and coat the outside. Chill until set.",
      "timer_minutes": 45
    },
    {
      "step": 11,
      "text": "Warm the double cream until steaming, pour it over the chopped chocolate, and leave to stand before stirring smooth.",
      "timer_minutes": 10
    },
    {
      "step": 12,
      "text": "Spread or pipe the remaining frosting as desired. Drizzle the ganache over the top edge to create drips, then leave it to set.",
      "timer_minutes": 10
    },
    {
      "step": 13,
      "text": "Finish with the optional edible flowers, glitter, or chocolate."
    }
  ],
