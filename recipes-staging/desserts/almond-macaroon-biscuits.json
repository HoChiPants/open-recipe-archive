{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "almond-macaroon-biscuits",
  "name": "Almond Macaroon Biscuits",
  "subtitle": "Chewy almond cookies with a cinnamon finish",
  "description": "Gluten-free almond biscuits with crisp edges and a tender, chewy center.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "ground-almonds",
      "item": "ground almonds",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 120,
      "unit": "g"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 2
    },
    {
      "ingredient_id": "blanched-almonds-optional",
      "item": "blanched almonds (optional)",
      "quantity": 20,
      "optional": true
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 4,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and line baking sheets with parchment."
    },
    {
      "step": 2,
      "text": "Combine the ground almonds, caster sugar, cinnamon, and icing sugar. Whisk the egg whites with the sugar mixture until a thick dough forms, then stir until evenly combined."
    },
    {
      "step": 3,
      "text": "Shape the dough into 20 portions and arrange them on the prepared sheets. Add a blanched almond to each biscuit if using."
    },
    {
      "step": 4,
      "text": "Bake for 20 minutes, until lightly golden and the centers are fully set, reaching 160°F for egg safety.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Cool briefly, then coat or dust the biscuits with the caster sugar and icing sugar."
    }
  ],
