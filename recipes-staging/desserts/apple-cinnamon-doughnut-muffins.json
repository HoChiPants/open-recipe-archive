  "id": "apple-cinnamon-doughnut-muffins",
  "name": "Apple Cinnamon Doughnut Muffins",
  "subtitle": "Soft apple muffins with a cinnamon-sugar finish",
  "description": "Tender apple muffins filled with blueberry jam and finished like doughnuts with cinnamon sugar.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter-melted",
      "item": "butter melted",
      "quantity": 110,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "caster-sugar-plus-30g-for-dusting",
      "item": "caster sugar plus 30g for dusting",
      "quantity": 70,
      "unit": "g"
    },
    {
      "ingredient_id": "plain-flour-sifted",
      "item": "plain flour sifted",
      "quantity": 110,
      "unit": "g"
    },
    {
      "ingredient_id": "bicarbonate-of-soda",
      "item": "bicarbonate of soda",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "cinnamon-plus-1-2-tsp-for-dusting",
      "item": "cinnamon plus 1/2 tsp for dusting",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "natural-yogurt",
      "item": "natural yogurt",
      "quantity": 50,
      "unit": "ml"
    },
    {
      "ingredient_id": "free-range-egg",
      "item": "free-range egg",
      "quantity": 1,
      "unit": "medium"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "smooth-apple-compote",
      "item": "smooth apple compote",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "blueberry-jam",
      "item": "blueberry jam",
      "quantity": 12,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease the muffin tin with some of the melted butter."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, bicarbonate of soda, cinnamon, and caster sugar."
    },
    {
      "step": 3,
      "text": "Stir the remaining melted butter with the yogurt, vanilla extract, and apple compote. Whisk the egg separately, then add it to the wet mixture."
    },
    {
      "step": 4,
      "text": "Fold the dry mixture into the wet mixture just until combined."
    },
    {
      "step": 5,
      "text": "Spoon batter into the prepared tin, add the blueberry jam, and cover with the remaining batter."
    },
    {
      "step": 6,
      "text": "Bake for 9 minutes, or until golden brown and the centers are fully set, reaching 160°F if checked with a food thermometer.",
      "timer_minutes": 9
    },
    {
      "step": 7,
      "text": "Combine the reserved caster sugar and cinnamon for dusting."
    },
    {
      "step": 8,
      "text": "While warm, brush the muffins with melted butter and roll them in the cinnamon sugar.",
      "timer_minutes": 5
    },
    {
      "step": 9,
      "text": "Cool before serving."
    }
  ],
