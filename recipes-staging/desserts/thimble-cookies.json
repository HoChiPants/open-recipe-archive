{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "thimble-cookies",
  "name": "Thimble Cookies",
  "subtitle": "Jam-filled walnut cookies with a tender crumb",
  "description": "Form buttery lemon-scented dough into small walnut-coated cookies, indent the centers, and fill them with raspberry jam before baking.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-yolk",
      "item": "egg yolk",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": 1
    },
    {
      "ingredient_id": "finely-chopped-walnuts",
      "item": "finely chopped walnuts",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "raspberry-jam",
      "item": "raspberry jam",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the butter and white sugar until blended. Mix in the beaten egg yolk and lemon juice, then stir in the flour to form a dough."
    },
    {
      "step": 3,
      "text": "Shape the dough into small portions. Dip each portion in the egg white, coat with the chopped walnuts, and press an indentation into the center."
    },
    {
      "step": 4,
      "text": "Transfer the cookies to a baking sheet and bake for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Fill the indentations with raspberry jam as needed, then continue baking until the cookies are set, the centers are firm, and they reach 160°F internally, about 10 minutes more.",
      "timer_minutes": 10
    }
  ],
