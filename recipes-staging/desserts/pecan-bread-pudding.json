  "id": "pecan-bread-pudding",
  "name": "Pecan Bread Pudding",
  "subtitle": "Custardy bread pudding with a buttery pecan topping.",
  "description": "Day-old baguette absorbs a sweet vanilla custard before baking beneath a crisp pecan and brown-sugar topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 45,
    "inactive_minutes": 80
  },
  "ingredients": [
    {
      "ingredient_id": "loaf-day-old-french-baguette",
      "item": "loaf day-old French baguette",
      "quantity": 1
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 5
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 3.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "shelled-pecan-halves",
      "item": "shelled pecan halves",
      "quantity": 1.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the baguette into bite-size cubes and place them in a baking dish. Let stand for 60 minutes so the bread dries slightly.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 3,
      "text": "Whisk the eggs in a bowl. Stir in the milk, sugar, vanilla extract, and 1 cup of the brown sugar until combined."
    },
    {
      "step": 4,
      "text": "Pour the custard over the bread and fold gently to coat. Let the mixture absorb the custard while preparing the topping."
    },
    {
      "step": 5,
      "text": "Transfer the butter to a microwave-safe bowl and microwave in short intervals until melted. Stir in the remaining brown sugar and pecan halves."
    },
    {
      "step": 6,
      "text": "Spread the pecan mixture over the soaked bread. Bake for 45 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Cool for 20 minutes before serving.",
      "timer_minutes": 20
    }
  ],
