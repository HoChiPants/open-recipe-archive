  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease and flour a sheet cake pan."
    },
    {
      "step": 2,
      "text": "Stir together the flour, 2 cups white sugar, baking soda, and salt."
    },
    {
      "step": 3,
      "text": "Combine the water, softened butter or margarine, peanut butter, vegetable oil, and chunky peanut butter in a saucepan. Bring to a simmer, stirring until smooth."
    },
    {
      "step": 4,
      "text": "Pour the hot mixture over the dry ingredients. Stir in the eggs, buttermilk, and 1 teaspoon vanilla extract until the batter is smooth."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 26 minutes, or until the center is set.",
      "timer_minutes": 26
    },
    {
      "step": 6,
      "text": "For the topping, combine the remaining white sugar, evaporated milk, 1 tablespoon butter or margarine, and chunky peanut butter in a saucepan. Bring to a simmer and cook for 2 minutes, stirring.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Add the miniature marshmallows and remaining vanilla extract. Stir until melted and smooth."
    },
    {
      "step": 8,
      "text": "Spread the warm topping over the warm cake. Let the cake cool before slicing."
    }
  ],
