  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a cake pan."
    },
    {
      "step": 2,
      "text": "Whisk together the white sugar, flour, salt, cinnamon, and baking soda."
    },
    {
      "step": 3,
      "text": "Whisk the eggs with the vegetable oil, then stir in the dry mixture until combined. Fold in the grated carrots and chopped walnuts."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared pan and bake at 350°F until the center is set, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Let the cake cool in the pan for 40 minutes, then transfer it to a rack and cool completely.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Whisk the cream cheese and heavy whipping cream until smooth. Add the vanilla extract and sifted confectioners' sugar, then whisk until spreadable."
    },
    {
      "step": 7,
      "text": "Transfer the cooled cake to a serving plate and spread with the frosting."
    }
  ],
