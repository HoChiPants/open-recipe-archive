  "id": "butter-tarts",
  "name": "Butter Tarts",
  "subtitle": "Sweet raisin-and-nut tarts with a soft brown sugar filling",
  "description": "Fill unbaked tart shells with raisins, chopped nuts, and a buttery brown sugar mixture, then bake until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "3-inch-unbaked-tart-shells",
      "item": "(3 inch) unbaked tart shells",
      "quantity": 12
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "walnuts-or-pecans",
      "item": "walnuts or pecans",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "corn-syrup",
      "item": "corn syrup",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.125,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Arrange the 12 unbaked tart shells on a baking sheet. Divide the raisins and chopped walnuts or pecans among the shells."
    },
    {
      "step": 3,
      "text": "Whisk together the brown sugar, corn syrup, softened butter, beaten egg, vanilla extract, and salt until blended."
    },
    {
      "step": 4,
      "text": "Divide the filling among the shells over the raisins and nuts."
    },
    {
      "step": 5,
      "text": "Bake for 35 minutes, until the centers are firm and reach 160°F.",
      "timer_minutes": 35
    }
  ],
