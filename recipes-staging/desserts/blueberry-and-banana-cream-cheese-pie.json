    },
    {
      "ingredient_id": "recipe-pastry-for-a-9-inch-single-crust-pie",
      "item": "recipe pastry for a 9 inch single crust pie",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare the pastry in a 9-inch pie dish and bake until set according to the crust recipe; cool completely."
    },
    {
      "step": 2,
      "text": "Toast the chopped pecans at 350°F until fragrant, then cool."
    },
    {
      "step": 3,
      "text": "Slice the bananas and arrange them in the cooled crust. Spoon the blueberry pie filling over the bananas."
    },
    {
      "step": 4,
      "text": "Whisk the cream cheese and white sugar until smooth. Fold in the thawed whipped topping until evenly combined."
    },
    {
      "step": 5,
      "text": "Spread the cream cheese mixture over the fruit layer and sprinkle with the cooled pecans."
    },
    {
      "step": 6,
      "text": "Cover and chill for 4 hours before serving.",
      "timer_minutes": 240
    }
  ],
