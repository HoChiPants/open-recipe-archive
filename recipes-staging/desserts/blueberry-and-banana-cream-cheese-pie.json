  "id": "blueberry-and-banana-cream-cheese-pie",
  "name": "Blueberry and Banana Cream Cheese Pie",
  "subtitle": "A chilled fruit pie with a creamy filling and toasted pecans.",
  "description": "Layer sliced bananas and blueberry filling in a pastry crust, then finish with a lightly sweetened cream cheese topping and pecans.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
