      "item": "pecans",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "ripe-bananas",
      "item": "ripe bananas",
      "quantity": 3
    },
    {
      "ingredient_id": "frozen-whipped-topping",
      "item": "frozen whipped topping",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce, thawed"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "blueberry-pie-filling",
      "item": "blueberry pie filling",
      "quantity": 1,
