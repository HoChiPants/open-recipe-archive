  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Grease and flour a tube or Bundt pan."
    },
    {
      "step": 2,
      "text": "Whisk the cake mix, pudding mix, sour cream, eggs, vegetable oil, and coffee flavored liqueur until smooth and thick."
    },
    {
      "step": 3,
      "text": "Fold in the chocolate chips, then spread the batter evenly in the prepared pan."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, until the center is firm and reaches at least 160°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Cool in the pan for 10 minutes, then turn the cake out onto a rack and cool further before serving.",
      "timer_minutes": 10
    }
  ],
