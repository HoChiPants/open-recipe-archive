  "id": "chocolate-chip-pudding-cake",
  "name": "Chocolate Chip Pudding Cake",
  "subtitle": "Rich chocolate cake with a soft pudding crumb and chocolate chips",
  "description": "A moist chocolate cake baked with pudding, sour cream, coffee liqueur, and semisweet chocolate chips.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
