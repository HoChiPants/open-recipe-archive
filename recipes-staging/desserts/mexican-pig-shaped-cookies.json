  "id": "mexican-pig-shaped-cookies",
  "name": "Mexican Pig-Shaped Cookies",
  "subtitle": "Molasses-spiced cutout cookies with a classic festive shape",
  "description": "Tender brown sugar and molasses cookies shaped with a pig cookie cutter and baked until lightly browned and fully set.",
  "meal_type": "dessert",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
