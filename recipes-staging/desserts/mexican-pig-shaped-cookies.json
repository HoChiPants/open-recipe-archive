  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare baking sheets."
    },
    {
      "step": 2,
      "text": "Whisk the brown sugar and shortening until smooth. Whisk in the egg, milk, and vanilla extract."
    },
    {
      "step": 3,
      "text": "Stir the molasses, baking soda, and cinnamon into the mixture, then gradually combine with the flour to form a dough."
    },
    {
      "step": 4,
      "text": "Roll or shape the dough on a lightly floured surface and cut out pig shapes."
    },
    {
      "step": 5,
      "text": "Transfer the cookies to the prepared baking sheets and brush with the beaten egg."
    },
    {
      "step": 6,
      "text": "Bake for 17 minutes, until lightly browned and the centers are fully set.",
      "timer_minutes": 17
    },
    {
      "step": 7,
      "text": "Cool the cookies on the baking sheets briefly, then transfer them to a rack to cool completely."
    }
  ],
