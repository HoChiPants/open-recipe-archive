  "id": "peanut-butter-bon-bons",
  "name": "Peanut Butter Bon-Bons",
  "subtitle": "Crisp peanut butter candies with a chocolate coating",
  "description": "No-bake candies made from a sweet, crisp peanut butter mixture and finished with semisweet chocolate.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 100,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 4.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "crispy-rice-cereal",
      "item": "crispy rice cereal",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "1-ounce-squares-semisweet-chocolate",
      "item": "(1 ounce) squares semisweet chocolate",
      "quantity": 6,
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the peanut butter and butter until smooth."
    },
    {
      "step": 2,
      "text": "Stir together the confectioners' sugar and crispy rice cereal, then blend into the peanut butter mixture."
    },
    {
      "step": 3,
      "text": "Shape the mixture into small bon-bons and place them on a lined tray."
    },
    {
      "step": 4,
      "text": "Microwave the chopped semisweet chocolate in short intervals until simmering, stirring between intervals."
    },
    {
      "step": 5,
      "text": "Prepare the bon-bons with the peanut butter, butter, and chocolate mixture, then transfer them to the tray."
    },
    {
      "step": 6,
      "text": "Chill until set, about 20 minutes.",
      "timer_minutes": 20
    }
  ],
