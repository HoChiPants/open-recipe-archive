{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "italian-style-cheesecake",
  "name": "Italian-Style Cheesecake",
  "subtitle": "A creamy baked cheesecake with ricotta and lemon",
  "description": "Blend ricotta, cream cheese, sour cream, and lemon into a smooth, lightly tangy cheesecake batter, then bake until fully set and chill before serving.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60,
    "inactive_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "pound",
      "preparation": "softened"
    },
    {
      "ingredient_id": "ricotta-cheese",
      "item": "ricotta cheese",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted and cooled"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Prepare a baking pan for the cheesecake."
    },
    {
      "step": 2,
      "text": "Whisk the cream cheese, ricotta cheese, white sugar, and sour cream until combined and smooth."
    },
    {
      "step": 3,
      "text": "Whisk in the eggs, then add the melted cooled butter, flour, cornstarch, vanilla extract, and lemon juice. Mix until the batter is uniform."
    },
    {
      "step": 4,
      "text": "Pour the batter into the prepared pan and smooth the surface."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, or until the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool the cheesecake, then chill it for at least 2 hours before serving.",
      "timer_minutes": 120
    },
    {
      "step": 7,
      "text": "Serve chilled."
    }
  ],
