  "id": "pineapple-upside-down-cake",
  "name": "Pineapple Upside-Down Cake",
  "subtitle": "A buttery cake layered with pineapple, brown sugar, and pecans.",
  "description": "Pineapple rings and pecans bake beneath a tender, lightly sweet cake, then become the topping when the cake is inverted.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "packed"
    },
