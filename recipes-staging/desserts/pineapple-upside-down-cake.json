      "item": "pineapple juice",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Melt the butter in the baking pan, then stir in the packed brown sugar."
    },
    {
      "step": 2,
      "text": "Arrange the pineapple rings and pecan halves over the butter-sugar mixture."
    },
    {
      "step": 3,
      "text": "Whisk the white sugar and eggs until blended. Stir in the pineapple juice."
    },
    {
      "step": 4,
      "text": "Prepare the flour, baking powder, and salt together, then combine with the egg mixture until just blended."
    },
    {
      "step": 5,
      "text": "Spread the batter over the pineapple layer and bake for 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Cool the cake in the pan for 5 minutes, then invert it onto a serving plate.",
      "timer_minutes": 5
    }
  ],
