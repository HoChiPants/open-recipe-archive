  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease a cake pan with the butter."
    },
    {
      "step": 2,
      "text": "Toss the blueberries with a spoonful of the flour."
    },
    {
      "step": 3,
      "text": "Whisk the sugar, eggs, oil, lemon zest, lemon juice, and yogurt until smooth."
    },
    {
      "step": 4,
      "text": "Combine the remaining flour with the baking powder, then fold the dry mixture into the wet mixture until just combined."
    },
    {
      "step": 5,
      "text": "Fold in the floured blueberries and transfer the batter to the prepared pan."
    },
    {
      "step": 6,
      "text": "Bake until the cake is set and a tester inserted in the center comes out clean, about 50 minutes.",
      "timer_minutes": 50
    },
    {
      "step": 7,
      "text": "Cool the cake in the pan until set before serving."
    }
  ],
