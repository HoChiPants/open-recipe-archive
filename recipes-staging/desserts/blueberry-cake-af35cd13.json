  "id": "blueberry-cake-af35cd13",
  "name": "Blueberry Cake",
  "subtitle": "A lemony yogurt cake studded with blueberries.",
  "description": "This tender blueberry cake combines lemon, yogurt, and frozen berries in a simple baked dessert.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
