  "instructions": [
    {
      "step": 1,
      "text": "Whisk the sugar, flour, and salt together in a saucepan. Gradually stir in the milk until smooth."
    },
    {
      "step": 2,
      "text": "Cook the mixture over medium heat, stirring constantly, until it simmers and thickens. Whisk the egg yolks in a bowl, then gradually whisk in some of the hot mixture. Return the yolk mixture to the saucepan."
    },
    {
      "step": 3,
      "text": "Continue cooking and stirring until the custard reaches 160°F and is thickened."
    },
    {
      "step": 4,
      "text": "Remove from the heat and stir in the butter, lemon juice, and lemon zest."
    },
    {
      "step": 5,
      "text": "Whisk the sour cream until smooth, then stir it into the warm custard."
    },
    {
      "step": 6,
      "text": "Pour the filling into the baked pie crust. Refrigerate until fully set, about 9 hours.",
      "timer_minutes": 540
    }
  ],
