  "id": "sour-cream-lemon-pie",
  "name": "Sour Cream Lemon Pie",
  "subtitle": "A chilled lemon custard pie with a tangy sour-cream finish.",
  "description": "Cook a lemon-scented custard, blend in sour cream, and chill it in a baked crust until firm.",
  "meal_type": "dessert",
  "cuisine": "American",
