  "id": "snowball-angel-food-cake",
  "name": "Snowball Angel Food Cake",
  "subtitle": "A chilled angel food cake layered with pineapple gelatin cream and coconut.",
  "description": "Angel food cake is layered with a pineapple-gelatin mixture, chilled until set, then covered with whipped topping and coconut.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "10-inch-tube-pan-angel-food-cake",
      "item": "(10 inch tube pan) angel food cake",
      "quantity": 1
    },
    {
      "ingredient_id": "pineapple-in-heavy-syrup",
      "item": "pineapple in heavy syrup",
      "quantity": 1,
      "unit": "can",
      "preparation": "20 ounce, crushed, drained with syrup reserved"
    },
    {
      "ingredient_id": "unflavored-gelatin",
      "item": "unflavored gelatin",
      "quantity": 2,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
