      "item": "flaked coconut",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Set aside a 10-inch tube pan. Drain the pineapple, reserving the syrup, and dissolve the gelatin in the 4 tablespoons water."
    },
    {
      "step": 2,
      "text": "Combine the reserved syrup, boiling water, sugar, lemon juice, and dissolved gelatin. Bring the mixture to a boil, stirring until the sugar dissolves."
    },
    {
      "step": 3,
      "text": "Let the pineapple mixture cool until it is no longer hot. Fold in the crushed pineapple and thawed whipped topping."
    },
    {
      "step": 4,
      "text": "Cut the angel food cake into layers. Arrange cake and pineapple mixture in alternating layers in the tube pan, finishing with the mixture."
    },
    {
      "step": 5,
      "text": "Cover and chill until set, about 12 hours.",
      "timer_minutes": 720
    },
    {
      "step": 6,
      "text": "Remove the cake from the pan. Cover the outside with the remaining thawed whipped topping and press flaked coconut over it."
    }
  ],
