  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the brown sugar, flour, melted margarine, evaporated milk, vanilla, and eggs. Blend until smooth, then stir in the chopped pecans."
    },
    {
      "step": 3,
      "text": "Pour the filling into the deep-dish pie crust and arrange the pecan halves over the top."
    },
    {
      "step": 4,
      "text": "Bake for 40 minutes, until golden brown and the center is fully set, reaching 160°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Let the pie rest for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
