      "item": "golden syrup",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "can-coconut-milk",
      "item": "can coconut milk",
      "quantity": 400,
      "unit": "ml"
    },
    {
      "ingredient_id": "mint-leaves",
      "item": "mint leaves",
      "preparation": "to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the pineapple into grilling pieces."
    },
    {
      "step": 2,
      "text": "Warm the dark chocolate, golden syrup, and coconut milk together gently, stirring until melted and smooth."
    },
    {
      "step": 3,
      "text": "Grill the pineapple over medium-high heat until lightly charred and tender, turning as needed.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Divide the pineapple among four servings and spoon over the warm sauce. Finish with the optional mint leaves."
    }
  ],
