  "id": "grilled-pineapple-with-chocolate-coconut-sauce",
  "name": "Grilled Pineapple with Chocolate Coconut Sauce",
  "subtitle": "Charred pineapple with a warm, glossy coconut-chocolate sauce",
  "description": "Grill pineapple until lightly marked, then serve it with a smooth sauce made from dark chocolate, golden syrup, and coconut milk.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "pineapple",
      "item": "pineapple",
      "quantity": 1
    },
    {
      "ingredient_id": "dark-chocolate",
      "item": "dark chocolate",
      "quantity": 200,
      "unit": "g"
    },
    {
