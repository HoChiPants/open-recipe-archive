  "id": "peanut-butter-cookies",
  "name": "Peanut Butter Cookies",
  "subtitle": "Tender, chewy cookies with a rich peanut butter flavor",
  "description": "A simple flourless cookie made by combining peanut butter, sugar, eggs, and vanilla, then baking until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 10,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare baking sheets for the cookies."
    },
    {
      "step": 2,
      "text": "Stir the peanut butter and white sugar together until smooth."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, baking soda, salt, and vanilla extract together, then incorporate them into the peanut butter mixture."
    },
    {
      "step": 4,
      "text": "Shape the dough into small portions and arrange them on the prepared baking sheets, leaving space between each cookie."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, until the cookies are set.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Let the cookies cool on the baking sheets for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
