  "id": "chocolate-cheesecake",
  "name": "Chocolate Cheesecake",
  "subtitle": "A chilled chocolate dessert with a buttery biscuit base",
  "description": "A rich no-bake cheesecake made with dark chocolate, cocoa, and cream cheese over a crisp biscuit crust.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "digestive-biscuits-about-10",
      "item": "digestive biscuits (about 10)",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "butter-melted",
      "item": "butter melted",
      "quantity": 45,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "dark-chocolate",
      "item": "dark chocolate",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 120,
      "unit": "ml"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "full-fat-cream-cheese",
      "item": "full-fat cream cheese",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 115,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grease the tin with some of the extra butter. Crush the digestive biscuits and combine them with 1 tablespoon caster sugar and the melted butter."
    },
    {
      "step": 2,
      "text": "Press the biscuit mixture firmly over the base of the tin, then chill until firm.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Melt the dark chocolate with the cream cheese in the microwave, using short intervals and stirring between each one. Set aside briefly to cool."
    },
    {
      "step": 4,
      "text": "Whisk the double cream, cocoa powder, and cream cheese until soft peaks form."
    },
    {
      "step": 5,
      "text": "Whisk in the remaining caster sugar and melted chocolate mixture until smooth and combined."
    },
    {
      "step": 6,
      "text": "Spoon the filling over the chilled biscuit base and smooth the surface."
    },
    {
      "step": 7,
      "text": "Transfer the cheesecake to the refrigerator and chill until set.",
      "timer_minutes": 120
    },
    {
      "step": 8,
      "text": "Let it stand briefly before slicing and serving.",
      "timer_minutes": 20
    }
  ],
