  "instructions": [
    {
      "step": 1,
      "text": "Combine the sugar, lemon juice to taste, and lemon zest with enough water to make a syrup, then simmer for 15 minutes. Set aside to cool.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Combine the walnuts, pecans, almonds, cinnamon, cardamom, and finely ground pistachios."
    },
    {
      "step": 3,
      "text": "Stir the ricotta with the lemon zest, orange or clementine zest, vanilla bean paste, and lemon juice to taste until smooth."
    },
    {
      "step": 4,
      "text": "Preheat the oven. Melt the butter and keep it ready for brushing.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Let the filo pastry rest briefly at room temperature, keeping it covered so it does not dry out."
    },
    {
      "step": 6,
      "text": "Brush a baking dish with melted butter. Layer the filo, brushing each sheet with butter, and add portions of the spiced nut mixture, ricotta mixture, and dark chocolate between the layers."
    },
    {
      "step": 7,
      "text": "Fold and shape the remaining filo over the filling, brush the surface with melted butter, and let the assembled baklava rest briefly."
    },
    {
      "step": 8,
      "text": "Cut the baklava into small or large portions before baking."
    },
    {
      "step": 9,
      "text": "Bake for 25 minutes, until the filo is crisp and deeply golden.",
      "timer_minutes": 25
    },
    {
      "step": 10,
      "text": "Transfer the baklava from the oven and pour the cooled syrup over it. Let it cool until set."
    },
    {
      "step": 11,
      "text": "Melt the dark chocolate gently in the microwave, stirring between short intervals, then drizzle or spread it over the cooled baklava."
    },
    {
      "step": 12,
      "text": "Finish with the remaining cinnamon, cardamom, and finely ground pistachios."
    }
  ],
