{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "coconut-panna-cotta-with-mango-and-ginger-nuts",
  "name": "Coconut Panna Cotta with Mango and Ginger Nuts",
  "subtitle": "Silky coconut custards with bright mango and crisp biscuit crumbs",
  "description": "A chilled coconut panna cotta finished with lime-scented mango and crushed ginger nut biscuits.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "x-400ml-cans-full-fat-coconut-milk",
      "item": "x 400ml cans full-fat coconut milk",
      "quantity": 2
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "leaves-of-gelatine",
      "item": "leaves of gelatine",
      "quantity": 4
    },
    {
      "ingredient_id": "ginger-nut-biscuits",
      "item": "ginger nut biscuits",
      "quantity": 10
    },
    {
      "ingredient_id": "can-mango-slices-or-sliced-fresh-mango",
      "item": "can mango slices or sliced fresh mango",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "lime-zested",
      "item": "lime zested",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the coconut milk gently in a saucepan for 20 minutes, keeping it below a boil.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Whisk the sugar and double cream together until evenly combined."
    },
    {
      "step": 3,
      "text": "Soak the gelatine leaves in cold water for 10 minutes, then squeeze out the excess water.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Remove the coconut milk from the heat and stir in the softened gelatine until dissolved. Combine with the cream mixture."
    },
    {
      "step": 5,
      "text": "Pour into eight serving glasses or molds and chill until set, about 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 6,
      "text": "Crush the ginger nut biscuits into coarse crumbs."
    },
    {
      "step": 7,
      "text": "Prepare the mango and toss it with the lime zest."
    },
    {
      "step": 8,
      "text": "Serve the set panna cotta topped with mango and biscuit crumbs."
    }
  ],
