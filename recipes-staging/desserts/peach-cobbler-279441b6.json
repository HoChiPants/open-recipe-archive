  "id": "peach-cobbler-279441b6",
  "name": "Peach Cobbler",
  "subtitle": "A warm, fruit-filled dessert with a tender self-rising flour topping.",
  "description": "Melted butter, sweet peaches, and a simple milk-based batter bake together into an easy American cobbler.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "peaches",
      "item": "peaches",
      "quantity": 1,
      "unit": "can",
      "preparation": "28 ounce, sliced"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Pour the melted butter into a baking dish."
    },
    {
      "step": 3,
      "text": "Whisk the self-rising flour, white sugar, and milk until smooth."
    },
    {
      "step": 4,
      "text": "Stir the peaches with the almond extract, then pour the batter over the butter and distribute the peaches over the top."
    },
    {
      "step": 5,
      "text": "Sprinkle with ground cinnamon and bake until set and lightly browned, about 45 minutes.",
      "timer_minutes": 45
    }
  ],
