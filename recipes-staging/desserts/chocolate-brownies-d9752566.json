  "id": "chocolate-brownies-d9752566",
  "name": "Chocolate Brownies",
  "subtitle": "Rich, chewy brownies with a mixed-chocolate center",
  "description": "A dense chocolate brownie made with melted butter, cocoa, and three kinds of chocolate.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "squares or 32 triangles"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 185,
      "unit": "g"
    },
    {
      "ingredient_id": "best-dark-chocolate",
      "item": "best dark chocolate",
      "quantity": 185,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 85,
      "unit": "g"
    },
    {
