    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 275,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Line a square baking pan with parchment."
    },
    {
      "step": 2,
      "text": "Cut the butter into pieces and chop the dark, white, and milk chocolates. Combine the butter and dark chocolate in a heatproof bowl and microwave for 2 minutes, stirring until smooth. Let the mixture cool slightly.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Whisk the eggs and sugar for about 8 minutes, until thick and pale.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Sift together the plain flour and cocoa powder. Fold them into the egg mixture, then fold in the melted chocolate mixture and the chopped white and milk chocolates until just combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 25 minutes, until the edges are set and the center is firm but still slightly soft. Cool completely before cutting into squares or triangles.",
      "timer_minutes": 25
    }
  ],
