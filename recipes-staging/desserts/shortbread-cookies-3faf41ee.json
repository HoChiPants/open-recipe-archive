  "id": "shortbread-cookies-3faf41ee",
  "name": "Shortbread Cookies",
  "subtitle": "Tender, buttery cookies with a delicate crumb",
  "description": "A simple British shortbread made by combining softened butter and superfine sugar with flour, shaping the dough, and baking until set.",
  "meal_type": "dessert",
  "cuisine": "British",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "superfine-sugar",
      "item": "superfine sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Prepare a baking pan for the dough."
    },
    {
      "step": 3,
      "text": "Beat the softened butter and superfine sugar together until smooth and creamy."
    },
    {
      "step": 4,
      "text": "Add the flour and mix until a dough forms."
    },
    {
      "step": 5,
      "text": "Knead the dough briefly until smooth."
    },
    {
      "step": 6,
      "text": "Press the dough evenly into the prepared pan."
    },
    {
      "step": 7,
      "text": "Prepare the surface for baking by smoothing it evenly."
    },
    {
      "step": 8,
      "text": "Bake for 45 minutes, until set.",
      "timer_minutes": 45
    },
    {
      "step": 9,
      "text": "Remove from the oven and let the shortbread cool."
    },
    {
      "step": 10,
      "text": "Cut into cookies and serve."
    }
  ],
