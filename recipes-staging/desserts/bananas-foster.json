  "id": "bananas-foster",
  "name": "Bananas Foster",
  "subtitle": "Warm caramelized bananas with rum sauce and ice cream",
  "description": "Bananas simmer briefly in a buttery brown-sugar rum sauce, then are served warm with walnuts and vanilla ice cream.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "dark-brown-sugar",
      "item": "dark brown sugar",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "rum",
      "item": "rum",
      "quantity": 3.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "banana",
      "item": "bananas",
      "quantity": 3,
      "preparation": "peeled and sliced lengthwise and crosswise"
    },
    {
      "ingredient_id": "coarsely-chopped-walnuts",
      "item": "coarsely chopped walnuts",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-ice-cream",
      "item": "vanilla ice cream",
      "quantity": 1,
      "unit": "pint"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a skillet over medium heat. Stir in the brown sugar, rum, vanilla extract, and cinnamon until combined."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a gentle simmer and cook until the sugar dissolves into a smooth sauce."
    },
    {
      "step": 3,
      "text": "Add the bananas and walnuts. Cook for 2 minutes, turning the bananas gently to coat them in the sauce.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Spoon the warm bananas and sauce over the vanilla ice cream and serve immediately."
    }
  ],
