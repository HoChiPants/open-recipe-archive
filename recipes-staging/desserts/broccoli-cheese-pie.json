  "id": "broccoli-cheese-pie",
  "name": "Broccoli Cheese Pie",
  "subtitle": "Savory broccoli pie with a crisp cheese crust",
  "description": "A baked savory pie layered with broccoli, mushrooms, onion, cream, cheese, and eggs.",
