  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Cook the chopped broccoli in boiling water for 5 minutes, then drain well.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir the Cheddar, 0.75 cup all-purpose flour, salt, and dry mustard together. Mix in the melted butter, then press the mixture evenly into a pie dish."
    },
    {
      "step": 3,
      "text": "Melt the remaining butter in a skillet. Cook the onion and mushrooms until tender. Stir in the 2 tablespoons flour, half-and-half cream, and nutmeg; simmer for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the broccoli to the sauce, then mix in the beaten eggs. Pour the filling into the prepared crust."
    },
    {
      "step": 5,
      "text": "Bake at 400°F for 15 minutes. Reduce the oven to 375°F and continue baking for 20 minutes, or until the center is fully set and reaches 160°F.",
      "timer_minutes": 20
    }
  ],
