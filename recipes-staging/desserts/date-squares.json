  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Cook the dates, 0.66666668653488 cup light brown sugar, orange juice, and orange zest together for 10 minutes, stirring until the dates soften and the mixture thickens. Stir in the vanilla extract.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Mix the regular rolled oats, all-purpose flour, 1 cup light brown sugar, baking soda, and salt. Cut in the cold unsalted butter until coarse crumbs form."
    },
    {
      "step": 3,
      "text": "Press half of the oat mixture into a prepared baking pan. Spread the date filling evenly over it, then cover with the remaining oat mixture."
    },
    {
      "step": 4,
      "text": "Bake until the top is lightly browned, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cool completely for 60 minutes before cutting into squares.",
      "timer_minutes": 60
    }
  ],
