  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Beat 12 ounces of softened cream cheese, 1 pound of softened butter, and the white sugar until smooth. Mix in the flour to form a soft dough."
    },
    {
      "step": 2,
      "text": "Press the dough into 48 small tart cavities or mini muffin cups, shaping an even crust in each. Chill the prepared shells for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "For the filling, beat 12 ounces of cream cheese with the brown sugar, pumpkin pie spice, cinnamon, salt, pumpkin, and confectioners' sugar until smooth. Beat in the eggs one at a time, then mix in the evaporated milk and vanilla."
    },
    {
      "step": 4,
      "text": "Fill the chilled crusts with the pumpkin mixture. Bake until the centers are firm and reach 160°F, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Cool the tarts completely. Beat the remaining cream cheese with the butter and shortening until combined, then blend in the confectioners' sugar and marshmallow creme until smooth."
    },
    {
      "step": 6,
      "text": "Transfer the topping to a piping bag or spoon it over the cooled tarts. Finish with the divided chopped pecans and chill before serving."
    }
  ],
