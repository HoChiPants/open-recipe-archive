  "id": "soft-persimmon-cookies",
  "name": "Soft Persimmon Cookies",
  "subtitle": "Tender spiced cookies with persimmon and walnuts",
  "description": "Soft drop cookies combining ripe persimmon purée, warm spices, and chopped walnuts.",
  "meal_type": "dessert",
  "cuisine": "American",
