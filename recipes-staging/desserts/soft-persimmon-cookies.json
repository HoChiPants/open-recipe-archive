  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Stir the baking soda into the persimmon purée. In a separate bowl, whisk the flour, cinnamon, cloves, nutmeg, and salt."
    },
    {
      "step": 3,
      "text": "Beat the butter and sugar until smooth, then mix in the egg and persimmon mixture."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the wet mixture and stir just until combined. Fold in the chopped walnuts."
    },
    {
      "step": 5,
      "text": "Scoop the dough onto baking sheets, leaving space between portions."
    },
    {
      "step": 6,
      "text": "Bake for 15 minutes, until the cookies are puffed and their centers are fully set.",
      "timer_minutes": 15
    }
  ],
