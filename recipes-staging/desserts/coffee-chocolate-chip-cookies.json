  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Arrange the almonds in a single layer and toast for 10 minutes; set aside to cool.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir the coffee granules into the hot water and set aside."
    },
    {
      "step": 4,
      "text": "Whisk together the flour, baking soda, and salt."
    },
    {
      "step": 5,
      "text": "Beat the sugar and softened butter until combined. Add the coffee mixture, eggs, and vanilla, then mix until smooth."
    },
    {
      "step": 6,
      "text": "Gradually add the flour mixture and combine just until a dough forms. Fold in the toasted almonds and chocolate chips."
    },
    {
      "step": 7,
      "text": "Portion the dough onto baking sheets and bake for 10 minutes, until the cookies are set at the edges.",
      "timer_minutes": 10
    }
  ],
