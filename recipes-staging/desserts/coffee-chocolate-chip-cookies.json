  "id": "coffee-chocolate-chip-cookies",
  "name": "Coffee Chocolate Chip Cookies",
  "subtitle": "Crisp-edged cookies with coffee and chocolate",
  "description": "Toasted almonds, coffee, and semisweet chocolate flavor these tender, aromatic cookies.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
