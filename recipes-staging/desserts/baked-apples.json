  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the brown sugar, cinnamon, and salt in a bowl."
    },
    {
      "step": 3,
      "text": "Prepare the apples and place them in a baking dish. Add the brown sugar mixture and top with the butter."
    },
    {
      "step": 4,
      "text": "Transfer the dish to the oven once the liquid is boiling, if applicable."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, then continue baking for 25 minutes, until the apples are tender.",
