  "id": "blueberry-crumb-bars",
  "name": "Blueberry Crumb Bars",
  "subtitle": "Jammy berries beneath a buttery crumb topping",
  "description": "A simple pan dessert layering cinnamon-scented crumb mixture with sweetened fresh blueberries and a crisp, golden topping.",
  "meal_type": "dessert",
