  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Stir together the flour, 1 cup white sugar, and baking powder. Combine the salt and cinnamon with the dry mixture."
    },
    {
      "step": 3,
      "text": "Blend in the shortening and egg until a crumbly dough forms."
    },
    {
      "step": 4,
      "text": "Stir together the remaining white sugar and cornstarch, then combine with the blueberries."
    },
    {
      "step": 5,
      "text": "Press half of the crumb mixture into the bottom of a baking pan. Add the blueberry mixture and cover with the remaining crumbs."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Cool before cutting into bars."
    }
  ],
