  "instructions": [
    {
      "step": 1,
      "text": "Melt the shortening and let it cool until warm but no longer hot."
    },
    {
      "step": 2,
      "text": "Whisk the sugar, molasses, and eggs into the cooled shortening until smooth."
    },
    {
      "step": 3,
      "text": "Add the flour, baking soda, cinnamon, cloves, ginger, and salt; mix just until a dough forms."
    },
    {
      "step": 4,
      "text": "Cover and chill the dough for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Heat the oven to 375°F. Shape the dough into small balls and roll them in white sugar."
    },
    {
      "step": 6,
      "text": "Arrange the cookies on prepared baking sheets with space between them."
    },
    {
      "step": 7,
      "text": "Bake until set and lightly browned, about 10 minutes. Cool briefly on the sheets, then transfer to a rack.",
      "timer_minutes": 10
    }
  ],
