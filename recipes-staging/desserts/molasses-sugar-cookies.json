    "inactive_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
