  "id": "molasses-sugar-cookies",
  "name": "Molasses Sugar Cookies",
  "subtitle": "Spiced cookies with crisp, sugary edges",
  "description": "A large batch of chewy molasses cookies warmly seasoned with cinnamon, cloves, and ginger, then rolled in sugar before baking.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 72,
    "unit": "servings"
  },
