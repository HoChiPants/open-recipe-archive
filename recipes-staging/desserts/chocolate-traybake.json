  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease a traybake tin with some of the vegetable oil."
    },
    {
      "step": 2,
      "text": "Whisk the flour, 80 g cocoa powder, baking powder, bicarbonate of soda, and brown sugar in a large bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the buttermilk, coffee, vanilla, eggs, and 185 ml oil until combined."
    },
    {
      "step": 4,
      "text": "Pour the wet mixture into the dry ingredients and stir just until smooth."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared tin and bake for 30 minutes, until set in the center.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Leave the cake in the tin for 5 minutes, then cool completely before frosting.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Beat the softened butter with the icing sugar, 4 tablespoons cocoa powder, and milk until smooth and spreadable."
    },
    {
      "step": 8,
      "text": "Spread the frosting over the cooled cake and decorate with the sprinkles, chocolate shavings, or nuts."
    },
    {
      "step": 9,
      "text": "Cut into 10 servings."
    }
  ],
