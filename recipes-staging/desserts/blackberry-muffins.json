      "item": "blackberries (fresh or frozen)",
      "quantity": 200,
      "unit": "g",
      "preparation": "halved if large"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a 10-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter with the caster sugar and 50 g of the light brown sugar for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk in the eggs until combined. In a separate bowl, combine the Greek yogurt, vanilla paste, and milk."
    },
    {
      "step": 4,
      "text": "Fold the self-raising flour and baking powder into the butter mixture, then fold in the blackberries until just incorporated."
    },
    {
      "step": 5,
      "text": "Add the remaining light brown sugar and blackberries as directed, then portion the batter among the muffin cups."
    },
    {
      "step": 6,
      "text": "Bake for 8 minutes, then continue baking until the muffins are cooked through, with a firm, fully set center; total cooking time is about 30 minutes.",
      "timer_minutes": 30
    }
  ],
