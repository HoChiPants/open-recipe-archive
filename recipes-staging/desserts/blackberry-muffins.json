  "id": "blackberry-muffins",
  "name": "Blackberry Muffins",
  "subtitle": "Tender muffins filled with juicy blackberries",
  "description": "A lightly sweet, yogurt-enriched muffin with fresh or frozen blackberries folded through the batter.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-softened",
      "item": "unsalted butter softened",
      "quantity": 100,
      "unit": "g"
    },
    {
