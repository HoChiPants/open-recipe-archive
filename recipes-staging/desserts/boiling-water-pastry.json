  "id": "boiling-water-pastry",
  "name": "Boiling Water Pastry",
  "subtitle": "A simple hot-water pastry dough",
  "description": "A tender pastry dough made by combining hot shortening and boiling water with seasoned cake flour, then chilling before use.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "boiling-water",
      "item": "boiling water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cake-flour",
      "item": "cake flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the shortening in a saucepan until hot and melted."
    },
    {
      "step": 2,
      "text": "Carefully transfer the boiling water to the hot shortening."
    },
    {
      "step": 3,
      "text": "Combine the cake flour and salt in a bowl."
    },
    {
      "step": 4,
      "text": "Add the flour mixture to the shortening mixture and stir until a cohesive dough forms."
    },
    {
      "step": 5,
      "text": "Chill the pastry dough before using."
    }
  ],
