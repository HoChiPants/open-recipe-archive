  "id": "strawberry-rhubarb-sauce",
  "name": "Strawberry Rhubarb Sauce",
  "subtitle": "A bright, gently thickened fruit topping",
  "description": "Sweet strawberries and tart rhubarb simmer with orange juice and vanilla for a smooth, colorful sauce.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "orange-juice",
      "item": "orange juice",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 4,
      "unit": "cups",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "rhubarb",
      "item": "rhubarb",
      "quantity": 1,
      "unit": "cup",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "red-food-coloring",
      "item": "red food coloring",
      "quantity": 5,
      "unit": "drops"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the sugar, orange juice, cornstarch, and vanilla extract together in a saucepan until smooth."
    },
    {
      "step": 2,
      "text": "Stir in the strawberries and rhubarb. Bring the mixture to a gentle simmer over medium heat."
    },
    {
      "step": 3,
      "text": "Cook, stirring occasionally, until the fruit is tender and the sauce has thickened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the red food coloring, then serve warm or cool as desired."
    }
  ],
