  "id": "coconut-layer-cake",
  "name": "Coconut Layer Cake",
  "subtitle": "A tender coconut cake with creamy soft-cheese frosting",
  "description": "Bake two coconut cake layers, cool them completely, then sandwich and frost them with a coconut-flavored soft-cheese icing. Finish with toasted coconut flakes.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
