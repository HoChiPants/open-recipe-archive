  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare two cake pans with parchment and a light coating of butter."
    },
    {
      "step": 2,
      "text": "Whisk the 225 g softened butter and caster sugar until pale and creamy, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk in the eggs, 1 tsp coconut extract, and 5 tbsp coconut cream until combined.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Fold in the self-raising flour, baking powder, and desiccated coconut until just incorporated."
    },
    {
      "step": 5,
      "text": "Divide the batter between the prepared pans and bake for 30 minutes, or until golden brown and the centers are set.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool the cakes completely before frosting."
    },
    {
      "step": 7,
      "text": "Whisk the 200 g softened butter and icing sugar until smooth and creamy, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Whisk in the soft cheese, 3 tbsp coconut cream, and 1 tsp coconut extract until thickened.",
      "timer_minutes": 1
    },
    {
      "step": 9,
      "text": "Place one cake layer on a serving plate, spread with frosting, and top with the second layer. Cover the top and sides with the remaining frosting."
    },
    {
      "step": 10,
      "text": "Add the toasted coconut flakes to finish."
    }
  ],
