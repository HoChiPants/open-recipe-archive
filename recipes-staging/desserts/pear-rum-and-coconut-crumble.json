  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and lightly grease a baking dish."
    },
    {
      "step": 2,
      "text": "Toss the pears with the lemon juice, cornflour, 100 g sugar, and rum, then arrange them in the dish. Dot with the 30 g unsalted butter."
    },
    {
      "step": 3,
      "text": "Combine the plain flour with the cold cubed butter and rub together until crumbly. Stir in the remaining sugar, desiccated coconut, shaved coconut, almonds, and cinnamon."
    },
    {
      "step": 4,
      "text": "Scatter the crumble mixture over the pears and bake until the fruit is tender and the topping is golden.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Let the crumble stand briefly, then serve warm with the clotted cream.",
      "timer_minutes": 15
    }
  ],
