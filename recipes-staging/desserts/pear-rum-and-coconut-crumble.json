  "id": "pear-rum-and-coconut-crumble",
  "name": "Pear, Rum and Coconut Crumble",
  "subtitle": "Warm spiced pears beneath a crisp coconut-almond topping",
  "description": "Tender pears are baked with rum and brown sugar, then finished with a buttery coconut, almond, and cinnamon crumble topping. Serve with clotted cream.",
  "meal_type": "dessert",
