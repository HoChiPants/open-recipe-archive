{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "flourless-chocolate-lava-cake",
  "name": "Flourless Chocolate Lava Cake",
  "subtitle": "Warm chocolate cakes with soft centers",
  "description": "Individual flourless chocolate cakes baked until set around the edges and tender in the center.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "70-bittersweet-chocolate",
      "item": "70% bittersweet chocolate",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "cold-unsalted-butter",
      "item": "cold unsalted butter",
      "quantity": 12,
      "unit": "tablespoons",
      "preparation": "cut into cubes"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "sugar",
      "item": "granulated sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.125,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Prepare six individual baking dishes with the cold unsalted butter."
    },
    {
      "step": 2,
      "text": "Place the 70% bittersweet chocolate and remaining cold unsalted butter in a heatproof bowl. Warm gently, stirring, until melted and smooth; let cool briefly.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the eggs, granulated sugar, and salt for 5 minutes, until thickened. Whisk in the melted chocolate mixture until combined.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Divide the batter among the prepared baking dishes and bake until the edges and tops are set. For food safety, verify that the center reaches 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Cool for 3 minutes before serving.",
      "timer_minutes": 3
    }
  ],
