  "id": "baklava",
  "name": "Baklava",
  "subtitle": "Crisp phyllo layered with spiced nuts and honey syrup",
  "description": "Layer buttery phyllo with cinnamon-seasoned nuts, bake until golden, and finish with a lemony honey syrup.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "nuts",
      "item": "nuts",
      "quantity": 1,
      "unit": "pound",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "phyllo-dough",
      "item": "phyllo dough",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
