      "item": "honey",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "grated-lemon-zest",
      "item": "grated lemon zest",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Combine the chopped nuts with the cinnamon."
    },
    {
      "step": 2,
      "text": "Cut the phyllo to fit the baking pan. Layer sheets in the pan, brushing each with melted butter, until about half the dough is used."
    },
    {
      "step": 3,
      "text": "Spread the seasoned nuts evenly over the phyllo, then cover with the remaining dough, brushing each sheet with butter."
    },
    {
      "step": 4,
      "text": "Cut the assembled baklava into portions before baking."
    },
    {
      "step": 5,
      "text": "Bake until deeply golden brown.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "While the baklava bakes, bring the sugar and water to a boil and cook for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Stir in the honey, vanilla extract, and lemon zest, then remove the syrup from the heat."
    },
    {
      "step": 8,
      "text": "Pour the syrup over the hot baklava. Let it cool completely before serving."
    }
  ],
