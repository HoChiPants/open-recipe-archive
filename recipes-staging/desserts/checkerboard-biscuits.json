{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "checkerboard-biscuits",
  "name": "Checkerboard Biscuits",
  "subtitle": "Crisp patterned biscuits with a sugared finish",
  "description": "Two-tone dough is chilled, assembled into a checkerboard pattern, sliced, coated with demerara sugar, and baked until set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 35,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "plain-flour-to-dust",
      "item": "plain flour to dust"
    },
    {
      "ingredient_id": "batch-of-universal-dough-see-below",
      "item": "batch of universal dough (see below)",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "red-food-colouring-paste",
      "item": "red food colouring paste"
    },
    {
      "ingredient_id": "demerara-sugar",
      "item": "demerara sugar",
      "quantity": 50,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly dust the work surface with plain flour. Work the dough with the red food colouring paste until evenly tinted, then chill for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Shape the tinted dough into a thick rectangular strip. Add the remaining dough in alternating sections to form a checkerboard pattern, then chill until firm, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Slice the assembled dough into thick biscuits and chill them for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Preheat the oven and prepare a baking tray."
    },
    {
      "step": 5,
      "text": "Arrange the chilled biscuits on the tray, sprinkle or press the demerara sugar over them, and bake for 10 minutes, until set.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Cool the biscuits on the tray for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
