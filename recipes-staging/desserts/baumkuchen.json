  "id": "baumkuchen",
  "name": "Baumkuchen",
  "subtitle": "A delicately layered marzipan cake with chocolate glaze",
  "description": "Build this German-style cake in thin layers under the grill, then finish it with a smooth chocolate glaze.",
  "meal_type": "dessert",
  "cuisine": "German",
  "yield": {
