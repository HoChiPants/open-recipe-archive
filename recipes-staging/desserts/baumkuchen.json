  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven grill or broiler to its high-heat setting. Grease a shallow cake tin with extra softened salted butter."
    },
    {
      "step": 2,
      "text": "Whisk the cubed marzipan with 200 ml double cream and the vanilla paste until smooth, then set aside.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Beat the softened salted butter and caster sugar until light and creamy. Beat in the egg yolks, then mix in the marzipan-cream mixture.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Whisk the egg whites until firm. Sift in the self-raising flour and cornflour, then fold them into the batter with the whites in batches."
    },
    {
      "step": 5,
      "text": "Spread a very thin layer of batter in the prepared tin. Grill or broil for about 3 minutes, until set and lightly colored. Add another thin layer and repeat until the batter is used.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Cool the cake briefly, then remove it from the tin."
    },
    {
      "step": 7,
      "text": "Melt the plain chocolate with 150 ml double cream, golden syrup, and butter until smooth. Pour over the cake and leave until set.",
      "timer_minutes": 60
    }
  ],
