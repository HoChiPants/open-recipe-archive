  "id": "pumpkin-spice-muffins",
  "name": "Pumpkin Spice Muffins",
  "subtitle": "Soft pumpkin muffins with cinnamon chips and pecans",
  "description": "A simple American-style muffin made with pumpkin puree, spice cake mix, cinnamon chips, and chopped pecans.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "spice-cake-mix",
      "item": "spice cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "pumpkin-puree",
      "item": "pumpkin puree",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce"
    },
    {
      "ingredient_id": "cinnamon-chips",
      "item": "cinnamon chips",
      "quantity": 9,
      "unit": "ounces"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Prepare muffin cups or a muffin pan for 18 portions."
    },
    {
      "step": 2,
      "text": "Stir together the spice cake mix and pumpkin puree until evenly combined. Fold in the cinnamon chips and chopped pecans."
    },
    {
      "step": 3,
      "text": "Divide the batter among the prepared muffin cups."
    },
    {
      "step": 4,
      "text": "Bake until the muffins are set and a tester inserted in the center comes out clean.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cool the muffins in the pan for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
