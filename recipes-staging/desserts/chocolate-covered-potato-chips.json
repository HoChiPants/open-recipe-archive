  "id": "chocolate-covered-potato-chips",
  "name": "Chocolate-Covered Potato Chips",
  "subtitle": "Crisp, salty chips finished with tempered milk chocolate",
  "description": "Dip ridged potato chips in tempered milk chocolate for a simple sweet-and-salty dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "high-quality-milk-chocolate",
      "item": "high quality milk chocolate",
      "quantity": 1,
      "unit": "pound",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "ridged-potato-chips",
      "item": "ridged potato chips",
      "quantity": 8,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Set a heatproof bowl over a saucepan of gently simmering water, keeping the bowl above the water. Add the chopped chocolate and heat, stirring, until it reaches 110°F and is fully melted."
    },
    {
      "step": 2,
      "text": "Remove the bowl from the heat and stir the chocolate as it cools to 90°F."
    },
    {
      "step": 3,
      "text": "Dip the ridged potato chips into the tempered chocolate, coating them partially or fully. Transfer them to a parchment-lined baking sheet."
    },
    {
      "step": 4,
      "text": "Let the chocolate-coated chips cool until set, then chill briefly before serving."
    }
  ],
