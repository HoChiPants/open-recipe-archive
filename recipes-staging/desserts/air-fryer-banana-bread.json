  "id": "air-fryer-banana-bread",
  "name": "Air Fryer Banana Bread",
  "subtitle": "Moist banana loaf with optional pecans or chocolate chips",
  "description": "A simple air-fryer banana bread made with overripe bananas and a tender, lightly sweet crumb.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "sunflower-or-vegetable-oil-plus-extra-for-the-tin",
      "item": "sunflower or vegetable oil plus extra for the tin",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "overripe-bananas",
      "item": "overripe bananas",
      "quantity": 2
    },
    {
      "ingredient_id": "pecans-chopped-optional",
      "item": "pecans chopped (optional)",
      "quantity": 50,
      "unit": "g",
      "optional": true
    },
    {
      "ingredient_id": "chocolate-chips",
      "item": "chocolate chips (optional)",
      "quantity": 50,
      "unit": "g",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grease a suitable loaf tin with some of the oil. Preheat the air fryer to 320°F."
    },
    {
      "step": 2,
      "text": "Combine the caster sugar, self-raising flour, and baking powder in a bowl. Add the eggs and oil, then mix until combined."
    },
    {
      "step": 3,
      "text": "Mash the bananas and stir them into the batter. Fold in the optional pecans and chocolate chips, if using."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared tin and smooth the top. Add the optional pecans over the surface if desired."
    },
    {
      "step": 5,
      "text": "Air-fry for 45 minutes, or until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Let the loaf cool in the tin briefly, then remove it and cool completely before slicing."
    }
  ],
