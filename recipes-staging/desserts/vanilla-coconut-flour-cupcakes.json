  "id": "vanilla-coconut-flour-cupcakes",
  "name": "Vanilla Coconut Flour Cupcakes",
  "subtitle": "Tender vanilla cupcakes made with coconut flour",
  "description": "Mix a lightly sweetened vanilla batter, portion it into a prepared muffin pan, and bake until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6,
      "unit": "large",
      "preparation": "cracked into a bowl and whisked to combine"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "gluten-free-vanilla-extract",
      "item": "gluten-free vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "king-arthur-coconut-flour",
      "item": "King Arthur Coconut Flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a 10-cup muffin pan for baking."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, sugar, vanilla extract, and salt until combined. Add the milk and whisk until smooth."
    },
    {
      "step": 3,
      "text": "Combine the coconut flour and baking powder, then add them to the egg mixture. Stir until evenly blended."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared muffin pan, dividing it evenly among the cups."
    },
    {
      "step": 5,
      "text": "Bake for 20 minutes, until the centers are firm and fully set, or reach 160°F on a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Cool the cupcakes in the pan for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
