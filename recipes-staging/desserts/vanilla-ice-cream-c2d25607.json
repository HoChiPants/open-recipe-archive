  "instructions": [
    {
      "step": 1,
      "text": "Whisk the heavy whipping cream and half-and-half cream together in a bowl."
    },
    {
      "step": 2,
      "text": "Whisk in the white sugar and vanilla extract until evenly combined."
    },
    {
      "step": 3,
      "text": "Cover and chill the mixture for 180 minutes.",
      "timer_minutes": 180
    },
    {
      "step": 4,
      "text": "Whisk the chilled mixture briefly, then churn it in an ice cream maker for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Transfer the churned ice cream to a freezer-safe container and freeze for 240 minutes, or until firm.",
      "timer_minutes": 240
    }
  ],
