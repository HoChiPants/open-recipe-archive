  "name": "Vanilla Ice Cream",
  "subtitle": "Classic churned ice cream with simple vanilla flavor",
  "description": "A creamy vanilla dessert made by chilling a sweetened dairy mixture, churning it, and freezing it until firm.",
  "meal_type": "dessert",
