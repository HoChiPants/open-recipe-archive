    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk together the rice flour, sugar, salt, and baking powder."
    },
    {
      "step": 2,
      "text": "Cut in the vegetable shortening until the mixture is evenly crumbly."
    },
    {
      "step": 3,
      "text": "Stir in the cold water and vanilla extract until a dough forms."
    },
    {
      "step": 4,
      "text": "Chill the dough for 60 minutes before using.",
      "timer_minutes": 60
    }
