  "id": "gluten-free-pastry",
  "name": "Gluten-Free Pastry",
  "subtitle": "A simple chilled pastry dough made with rice flour.",
  "description": "Mix a lightly sweetened rice-flour dough with vegetable shortening, cold water, and vanilla, then chill before using.",
  "meal_type": "dessert",
  "cuisine": "American",
