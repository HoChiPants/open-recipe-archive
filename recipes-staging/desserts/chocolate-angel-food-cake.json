{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-angel-food-cake",
  "name": "Chocolate Angel Food Cake",
  "subtitle": "Light cocoa cake with a delicate meringue crumb",
  "description": "A tall, airy chocolate cake made by folding cocoa-scented dry ingredients into whipped egg whites and baking until fully set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cream-of-tartar",
      "item": "cream of tartar",
      "quantity": 1.25,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "cake-flour",
      "item": "cake flour",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1.25,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Sift together the confectioners' sugar, cake flour, and unsweetened cocoa powder; set the dry mixture aside."
    },
    {
      "step": 3,
      "text": "Prepare an ungreased tube pan."
    },
    {
      "step": 4,
      "text": "Whisk the egg whites with the salt and cream of tartar until foamy. Gradually add the white sugar and continue whisking until stiff, glossy peaks form."
    },
    {
      "step": 5,
      "text": "Fold the dry mixture into the whipped whites in several additions, then gently stir in the vanilla extract."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and smooth the surface."
    },
    {
      "step": 7,
      "text": "Bake at 325°F for 60 minutes, until the center reaches 160°F or is firm and fully set.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Invert the pan and cool the cake completely before removing and serving."
    }
  ],
