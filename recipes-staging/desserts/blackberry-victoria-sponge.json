  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Grease two 20cm round loose-bottom cake tins with butter, dust lightly with flour, and line or prepare them for baking."
    },
    {
      "step": 2,
      "text": "Beat the softened butter, caster sugar, and vanilla extract in a large mixing bowl until light and smooth."
    },
    {
      "step": 3,
      "text": "Add the eggs gradually, whisking after each addition. Fold in the self-raising flour with a spatula until just combined."
    },
    {
      "step": 4,
      "text": "Divide the batter between the prepared tins and level the surfaces."
    },
    {
      "step": 5,
      "text": "Bake until the sponges are golden and set; a skewer inserted into the centers should come out clean.",
      "timer_minutes": 22
    },
    {
      "step": 6,
      "text": "Leave the cakes in their tins briefly, then turn them out onto a cooling rack and cool completely.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Whisk the double cream with the icing sugar until smooth and softly thickened.",
      "timer_minutes": 2
    },
    {
      "step": 8,
      "text": "Spread the cream over one cooled sponge, arrange the blackberries on top, and place the second sponge over the filling. Dust with icing sugar before serving."
    }
  ],
