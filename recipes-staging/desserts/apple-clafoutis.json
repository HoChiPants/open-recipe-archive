  "id": "apple-clafoutis",
  "name": "Apple Clafoutis",
  "subtitle": "Tender baked custard with cinnamon apples",
  "description": "A simple French-inspired dessert pairing a soft vanilla custard with caramelized apple wedges.",
  "meal_type": "dessert",
  "cuisine": "French Inspired",
