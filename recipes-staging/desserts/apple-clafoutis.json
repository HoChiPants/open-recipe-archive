  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Whisk the eggs and 0.75 cup brown sugar until smooth. Whisk in the flour and salt, then add the milk and vanilla extract; stir until combined and set aside."
    },
    {
      "step": 3,
      "text": "Melt the salted butter in an oven-safe skillet over medium heat. Add the 0.33333334326744 cup brown sugar and water, stirring until combined."
    },
    {
      "step": 4,
      "text": "Add the apples and cinnamon. Cook, stirring occasionally, until the apples are tender, about 18 minutes.",
      "timer_minutes": 18
    },
    {
      "step": 5,
      "text": "Pour the batter over the apples and transfer the skillet to the oven."
    },
    {
      "step": 6,
      "text": "Bake until golden brown and the center is fully set, about 35 minutes. Check that a thermometer inserted into the center reaches 160°F.",
      "timer_minutes": 35
    }
  ],
