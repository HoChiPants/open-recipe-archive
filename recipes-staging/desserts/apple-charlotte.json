  "id": "apple-charlotte",
  "name": "Apple Charlotte",
  "subtitle": "A crisp bread-lined apple dessert with warm spice",
  "description": "Butter-brushed bread surrounds cinnamon-orange apples for a golden baked dessert served with custard or vanilla ice cream.",
  "meal_type": "dessert",
