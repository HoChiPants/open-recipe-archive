  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and butter the basin. Dust it with caster sugar."
    },
    {
      "step": 2,
      "text": "Trim the bread to fit the basin, brushing the slices with melted butter. Line the base and sides, overlapping as needed."
    },
    {
      "step": 3,
      "text": "Combine the caster sugar, cubed butter, apples, orange, and cinnamon in a saucepan. Cook until the apples begin to soften, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Spoon the apple mixture into the bread-lined basin and cover the filling with the remaining bread."
    },
    {
      "step": 5,
      "text": "Bake until the bread is golden brown, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Cool for 5 minutes, then turn out and serve with custard or vanilla ice cream.",
      "timer_minutes": 5
    }
  ],
