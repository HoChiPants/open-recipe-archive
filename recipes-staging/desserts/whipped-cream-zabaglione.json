  "id": "whipped-cream-zabaglione",
  "name": "Whipped Cream Zabaglione",
  "subtitle": "A light Marsala custard folded with whipped cream",
  "description": "Cooked egg yolks, Marsala, and sugar form a warm, airy custard that is combined with stiffly whipped cream and chilled until set.",
  "meal_type": "dessert",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 7
    },
    {
      "ingredient_id": "marsala-wine",
      "item": "Marsala wine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup",
      "preparation": "whipped to stiff peaks"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Set up a double boiler with gently simmering water. Whisk the egg yolks, Marsala wine, and white sugar together in the upper bowl."
    },
    {
      "step": 2,
      "text": "Cook over the simmering water, whisking continuously, until the custard is thick, airy, and reaches 160°F; remove from the heat.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Fold the whipped heavy cream into the warm custard in batches until evenly combined."
    },
    {
      "step": 4,
      "text": "Divide among serving dishes and chill until set.",
      "timer_minutes": 10
    }
  ],
