  "id": "chocolate-orange-baked-cheesecake",
  "name": "Chocolate Orange Baked Cheesecake",
  "subtitle": "A creamy baked cheesecake with dark chocolate and fresh orange zest.",
  "description": "A chocolate cheesecake with a crisp biscuit base, dark chocolate filling, and bright orange flavor, finished with optional candied orange and chocolate.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 60,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "gingernuts-or-digestives",
      "item": "gingernuts or digestives",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "unsalted-butter-melted",
      "item": "unsalted butter melted",
      "quantity": 115,
      "unit": "g"
    },
    {
      "ingredient_id": "orange-zested",
      "item": "orange zested",
      "quantity": 1
    },
    {
      "ingredient_id": "candied-orange-slices-to-serve-optional",
      "item": "candied orange slices to serve (optional)",
      "optional": true
    },
    {
      "ingredient_id": "full-fat-soft-cheese",
      "item": "full-fat soft cheese",
      "quantity": 600,
      "unit": "g"
    },
    {
      "ingredient_id": "eggs-plus-2-egg-yolks-freeze-the-extra-white-for-another-recipe",
      "item": "eggs plus 2 egg yolks (freeze the extra white for another recipe)",
      "quantity": 3
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 175,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 175,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-chocolate-at-least-70-cocoa-solids",
      "item": "dark chocolate (at least 70% cocoa solids)",
      "quantity": 350,
      "unit": "g",
      "preparation": "roughly chopped, plus extra to serve"
    },
    {
      "ingredient_id": "oranges-zested",
      "item": "oranges zested",
      "quantity": 3
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line the base of a springform pan."
    },
    {
      "step": 2,
      "text": "Crush the gingernuts or digestives, then mix with the melted butter and the zest of one orange. Press firmly into the pan."
    },
    {
      "step": 3,
      "text": "Bake the base until set, about 15 minutes, then cool briefly.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Melt the chopped dark chocolate in short microwave bursts, stirring between each, then let it cool slightly."
    },
    {
      "step": 5,
      "text": "Beat the soft cheese and sugar until smooth. Whisk in the eggs and egg yolks, then the cream. Stir in the melted chocolate and the zest of three oranges."
    },
    {
      "step": 6,
      "text": "Pour the filling over the base and smooth the surface."
    },
    {
      "step": 7,
      "text": "Bake for about 60 minutes, until the center is fully set and reaches 160°F when checked with a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Cool completely, then chill until firm, preferably for about 6 hours.",
      "timer_minutes": 360
    },
    {
      "step": 9,
      "text": "Decorate with the optional candied orange slices and extra chocolate before serving."
    }
  ],
