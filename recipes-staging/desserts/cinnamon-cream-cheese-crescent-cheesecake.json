  "id": "cinnamon-cream-cheese-crescent-cheesecake",
  "name": "Cinnamon Cream Cheese Crescent Cheesecake",
  "subtitle": "A baked cream cheese dessert with cinnamon-sugar topping",
  "description": "Layer softened cream cheese between crescent-roll dough, finish with buttery cinnamon sugar, bake until set, and chill before serving.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "refrigerated-crescent-dinner-rolls",
      "item": "refrigerated crescent dinner rolls",
      "quantity": 2,
      "unit": "can",
      "preparation": "10 ounce"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Shape half of the crescent-roll dough into the bottom of a baking pan."
    },
    {
      "step": 2,
      "text": "Beat the softened cream cheese with 1 cup sugar and the vanilla until smooth, then spread the filling over the dough."
    },
    {
      "step": 3,
      "text": "Cover the filling with the remaining crescent-roll dough. Stir together the melted butter, 1/2 cup sugar, and cinnamon, then spread the mixture over the top."
    },
    {
      "step": 4,
      "text": "Bake for 30 minutes, until the center is set and the top is lightly browned.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Chill before cutting and serving."
    }
  ],
