  "id": "chocolate-rocky-road-cookies",
  "name": "Chocolate Rocky Road Cookies",
  "subtitle": "Chewy chocolate cookies with walnuts and marshmallows",
  "description": "Rich chocolate cookies combine semisweet chips, chopped walnuts, and miniature marshmallows for a soft, textured dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
