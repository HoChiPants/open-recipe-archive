  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Melt the butter with the semisweet chocolate chips, stirring until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the sugar, eggs, and vanilla extract."
    },
    {
      "step": 4,
      "text": "Add the flour, baking powder, and salt; mix until a dough forms, then fold in the chopped walnuts."
    },
    {
      "step": 5,
      "text": "Portion the dough onto prepared baking sheets and top each cookie with miniature marshmallows."
    },
    {
      "step": 6,
      "text": "Bake for 8 minutes, until the cookies are set and the centers reach at least 160°F.",
      "timer_minutes": 8
    },
    {
      "step": 7,
      "text": "Cool the cookies before serving."
    }
  ],
