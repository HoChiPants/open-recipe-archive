  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Line a 9-inch pie dish with half of the pastry, leaving the edge slightly overhanging."
    },
    {
      "step": 3,
      "text": "Combine the marionberries, white sugar, flour, lemon juice, and sugar. Spoon the filling into the pastry-lined dish."
    },
    {
      "step": 4,
      "text": "Cover with the remaining pastry, trim and crimp the edges, and cut vents in the top crust."
    },
    {
      "step": 5,
      "text": "Brush the crust with water and sprinkle with sugar."
    },
    {
      "step": 6,
      "text": "Bake at 450°F for 10 minutes, then reduce the oven temperature to 350°F and bake for 50 minutes, until the crust is golden and the filling is bubbling.",
      "timer_minutes": 50
    },
    {
      "step": 7,
      "text": "Cool the pie completely before serving.",
      "timer_minutes": 60
    }
  ],
