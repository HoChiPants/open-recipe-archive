  "id": "jelly-filled-vanilla-cake-roll",
  "name": "Jelly-Filled Vanilla Cake Roll",
  "subtitle": "A light vanilla sponge rolled with sweet jelly",
  "description": "Bake a tender vanilla cake, spread it with jelly, and roll it into a simple sliceable dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 10,
    "inactive_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "large",
      "preparation": "at room temperature"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "superfine-sugar",
      "item": "superfine sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "cake-flour",
      "item": "cake flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "powdered-sugar",
      "item": "powdered sugar",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "jelly",
      "item": "jelly",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Line a jelly-roll pan with parchment."
    },
    {
      "step": 2,
      "text": "Prepare the pan and jelly so the cake can be filled while still warm."
    },
    {
      "step": 3,
      "text": "Beat the eggs and salt until set and pale. Gradually whisk in the superfine sugar and baking powder until the mixture reaches soft peaks."
    },
    {
      "step": 4,
      "text": "Whisk in the vanilla extract. Combine the cake flour with the powdered sugar, then prepare the dry mixture for folding."
    },
    {
      "step": 5,
      "text": "Fold the dry mixture into the egg mixture until just combined, then transfer the batter to the prepared pan."
    },
    {
      "step": 6,
      "text": "Bake until the cake is lightly browned and the center is firm and fully set, about 13 minutes.",
      "timer_minutes": 13
    },
    {
      "step": 7,
      "text": "Turn the warm cake onto a surface dusted with powdered sugar, trim as needed, and cut or prepare the edges for rolling."
    },
    {
      "step": 8,
      "text": "Spread the jelly over the cake, then roll it up tightly. Shape the roll and let it cool for 45 minutes before slicing.",
      "timer_minutes": 45
    }
  ],
