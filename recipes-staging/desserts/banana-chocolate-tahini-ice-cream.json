      "item": "ripe bananas peeled and sliced",
      "quantity": 4,
      "unit": "large"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the tahini, maple syrup, and vanilla extract together until smooth."
    },
    {
      "step": 2,
      "text": "Stir the cocoa powder and optional espresso powder together."
    },
    {
      "step": 3,
      "text": "Blend the banana chunks with 80 ml milk until smooth, adding more milk as needed for a thick, creamy consistency."
    },
    {
      "step": 4,
      "text": "Add the tahini mixture and cocoa mixture, then blend or stir until smooth."
    },
    {
      "step": 5,
      "text": "Fold in the sliced bananas and transfer the mixture to a freezer-safe container."
    },
    {
      "step": 6,
      "text": "Freeze until firm and scoopable, about 60 minutes.",
      "timer_minutes": 60
    }
  ],
