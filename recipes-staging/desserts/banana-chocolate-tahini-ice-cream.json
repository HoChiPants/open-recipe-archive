  "id": "banana-chocolate-tahini-ice-cream",
  "name": "Banana Chocolate Tahini Ice Cream",
  "subtitle": "A creamy frozen banana dessert with cocoa and sesame richness.",
  "description": "Blend frozen banana with milk, cocoa, and a tahini-maple mixture, then fold in sliced banana and freeze until scoopable.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
