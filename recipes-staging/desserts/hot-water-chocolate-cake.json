  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Prepare the all-purpose flour as needed for mixing."
    },
    {
      "step": 2,
      "text": "Combine the sugar, flour, cocoa powder, baking soda, baking powder, and salt in a mixing bowl."
    },
    {
      "step": 3,
      "text": "Simmer the butter and water together, then stir the hot mixture into the dry ingredients until combined."
    },
    {
      "step": 4,
      "text": "Add the buttermilk, beaten eggs, and vanilla extract; mix until the batter is smooth. Stir in the baking soda and baking powder as directed by the mixture."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a prepared baking pan and bake for 25 minutes, until the center is fully set and reaches 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Cool before serving."
    }
  ],
