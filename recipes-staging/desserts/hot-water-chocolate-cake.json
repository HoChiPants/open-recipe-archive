  "id": "hot-water-chocolate-cake",
  "name": "Hot Water Chocolate Cake",
  "subtitle": "A tender chocolate cake with a simple hot-water batter",
  "description": "A straightforward American chocolate cake made with cocoa, buttermilk, beaten eggs, and hot water for a moist crumb.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
