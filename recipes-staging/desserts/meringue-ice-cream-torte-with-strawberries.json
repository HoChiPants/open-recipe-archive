{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "meringue-ice-cream-torte-with-strawberries",
  "name": "Meringue Ice Cream Torte with Strawberries",
  "subtitle": "A crisp baked meringue layered with ice cream and fruit",
  "description": "Bake a lightly sweetened meringue shell, cool it completely, and fill it with vanilla ice cream and thawed strawberries for a cold, creamy dessert.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 90,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vinegar",
      "item": "vinegar",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "vanilla-ice-cream",
      "item": "vanilla ice cream",
      "quantity": 0.5,
      "unit": "gallon"
    },
    {
      "ingredient_id": "frozen-sweetened-strawberries",
      "item": "frozen sweetened strawberries",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 250°F."
    },
    {
      "step": 2,
      "text": "Beat the egg whites with the white sugar, vinegar, and vanilla extract until the meringue forms stiff peaks."
    },
    {
      "step": 3,
      "text": "Spread the meringue into a prepared torte or cake pan, shaping the center as needed for filling."
    },
    {
      "step": 4,
      "text": "Bake for 120 minutes, until the center is firm and fully set or registers 160°F on a food thermometer.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Cool the baked shell completely before filling.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Combine the vanilla ice cream and thawed strawberries, then spoon the mixture into the cooled meringue shell."
    }
  ],
