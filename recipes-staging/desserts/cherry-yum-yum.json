  "id": "cherry-yum-yum",
  "name": "Cherry Yum Yum",
  "subtitle": "Creamy cherry dessert with a pecan crust",
  "description": "A chilled layered dessert made with a buttery pecan crust, sweet cream-cheese filling, and cherry topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
