      "item": "confectioners' sugar",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the butter, flour, white sugar, and chopped pecans to form a crumbly crust mixture. Press it into a baking dish."
    },
    {
      "step": 3,
      "text": "Bake at 350°F for 20 minutes, then cool completely.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Whisk the cream cheese and confectioners' sugar until smooth. Prepare the whipped topping mix according to its package directions, then fold it into the cream-cheese mixture."
    },
    {
      "step": 5,
      "text": "Spread the filling over the cooled crust and spoon the cherry pie filling evenly over the top."
    }
  ],
