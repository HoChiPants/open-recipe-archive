  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, baking powder, semolina, and ground cinnamon. Set aside."
    },
    {
      "step": 2,
      "text": "Whisk the egg whites until firm peaks form, about 5 minutes. In a separate bowl, whisk the egg yolks with 100 g caster sugar for 10 minutes, then fold in the dry mixture and melted butter.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Brush the filo sheets with melted butter, cut them to fit the cake pan, and layer them in the pan. Reserve enough filo to cover the top."
    },
    {
      "step": 4,
      "text": "Spread the cake batter over the filo, fold or arrange the remaining filo over the surface, and brush with the remaining butter."
    },
    {
      "step": 5,
      "text": "Bake until the filo is golden and the cake is set, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "While the cake bakes, combine 400 g caster sugar, honey, rosewater, and the cinnamon stick. Heat and stir until the sugar dissolves, then remove the cinnamon stick."
    },
    {
      "step": 7,
      "text": "Pour the warm syrup over the hot cake and let it cool until absorbed."
    },
    {
      "step": 8,
      "text": "Top with the chopped walnuts and pistachios, edible rose petals, and rosewater-flavoured whipped cream."
    }
  ],
