  "id": "brownie-cupcakes",
  "name": "Brownie Cupcakes",
  "subtitle": "Fudgy chocolate treats baked in individual portions",
  "description": "A simple chocolate-chip brownie batter baked as cupcake-sized desserts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 35,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "chocolate-chips",
      "item": "chocolate chips",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Prepare 18 cupcake wells for baking."
    },
    {
      "step": 2,
      "text": "Melt the butter and chocolate chips together for about 5 minutes, stirring until smooth. Let the mixture stand for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Whisk the sugar and eggs until combined. Stir in the flour and vanilla extract."
    },
    {
      "step": 4,
      "text": "Fold in the melted chocolate mixture until the batter is smooth."
    },
    {
      "step": 5,
      "text": "Divide the batter among the prepared wells and bake for 30 minutes, until the centers are fully set.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
