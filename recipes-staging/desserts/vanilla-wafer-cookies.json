  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "vanilla-wafer-cookies",
  "name": "Vanilla Wafer Cookies",
  "subtitle": "Crisp, buttery cookies with vanilla flavor",
  "description": "Small vanilla cookies made from a simple butter-based dough and baked until lightly golden.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.3333333730698,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter and white sugar until smooth. Whisk in the egg and vanilla extract."
    },
    {
      "step": 3,
      "text": "Mix the flour, baking powder, and salt together, then stir the dry ingredients into the butter mixture to form a dough."
    },
    {
      "step": 4,
      "text": "Portion the dough onto a baking sheet, leaving space between cookies."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until golden brown and fully set; the center should reach 160°F for egg safety.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Cool the cookies before serving."
    }
  ],
