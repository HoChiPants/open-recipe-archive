  "id": "chocolate-ribbon-pie",
  "name": "Chocolate Ribbon Pie",
  "subtitle": "A chilled pie with creamy cheesecake and chocolate pudding layers",
  "description": "A simple no-bake dessert combining sweetened cream cheese, whipped topping, and chocolate pudding in a chocolate crumb crust.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
