      "item": "(9 inch) prepared chocolate cookie crumb crust",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Beat the softened cream cheese, sugar, and 1 tablespoon milk until smooth, about 2 minutes. Fold in half of the whipped topping.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Spread the cream cheese mixture evenly in the prepared chocolate cookie crumb crust."
    },
    {
      "step": 3,
      "text": "Whisk the pudding mix and 2 cups milk until thick, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Spread the pudding over the cream cheese layer, then cover with the remaining whipped topping."
    },
    {
      "step": 5,
      "text": "Refrigerate until set, about 4 hours.",
      "timer_minutes": 240
    }
  ],
