    "inactive_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "8-ounce-container-frozen-whipped-topping",
      "item": "(8 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "instant-chocolate-pudding-mix",
      "item": "instant chocolate pudding mix",
      "quantity": 2,
      "unit": "package",
      "preparation": "3.9 ounce"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
