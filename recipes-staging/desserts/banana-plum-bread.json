  "id": "banana-plum-bread",
  "name": "Banana Plum Bread",
  "subtitle": "A tender fruit bread with ripe banana and chopped plums",
  "description": "A softly textured American quick bread combining mashed bananas with juicy chopped plums and a lightly sweet crumb.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "mashed-ripe-bananas",
      "item": "mashed ripe bananas",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "plums",
      "item": "plums",
      "quantity": 1,
      "unit": "cup",
      "preparation": "pitted and chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the flour, baking powder, and baking soda in a bowl."
    },
    {
      "step": 3,
      "text": "Beat the sugar and softened margarine until blended. Whisk in the eggs, then stir in the mashed bananas."
    },
    {
      "step": 4,
      "text": "Stir the dry ingredients into the banana mixture until smooth, then fold in the chopped plums."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a prepared loaf pan."
    },
    {
      "step": 6,
      "text": "Bake for 60 minutes, until golden brown and a tester inserted in the center comes out clean.",
      "timer_minutes": 60
    }
  ],
