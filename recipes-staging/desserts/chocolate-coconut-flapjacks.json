  "id": "chocolate-coconut-flapjacks",
  "name": "Chocolate Coconut Flapjacks",
  "subtitle": "Oaty bars with coconut and a chocolate topping",
  "description": "Chewy baked oat bars enriched with coconut, finished with dark and white chocolate.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "salted butter",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-syrup",
      "item": "golden syrup",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "porridge-oats",
      "item": "porridge oats",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "desiccated-coconut",
      "item": "desiccated coconut",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-chocolate",
      "item": "dark chocolate",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "coconut-oil-plus-1-tsp",
      "item": "coconut oil plus 1 tsp",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "white-chocolate",
      "item": "white chocolate",
      "quantity": 50,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a baking tin."
    },
    {
      "step": 2,
      "text": "Warm the salted butter, brown sugar, and golden syrup together until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the porridge oats, desiccated coconut, and coconut oil plus 1 tsp until evenly coated."
    },
    {
      "step": 4,
      "text": "Press the mixture firmly into the prepared tin and bake for 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Melt the dark chocolate, white chocolate, and coconut oil plus 1 tsp together in the microwave in short intervals, stirring between each, until smooth and simmering."
    },
    {
      "step": 6,
      "text": "Transfer the melted chocolate mixture as needed and spread or drizzle it over the baked flapjack."
    },
    {
      "step": 7,
      "text": "Chill for 45 minutes, or until set, then cut into 16 pieces.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Prepare to serve."
    }
  ],
