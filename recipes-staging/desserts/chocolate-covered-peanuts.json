    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "white-almond-bark",
      "item": "white almond bark",
      "quantity": 18,
      "unit": "ounces",
      "preparation": "broken into pieces"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 2,
      "unit": "cups",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "lightly-salted-peanuts",
      "item": "lightly salted peanuts",
      "quantity": 24,
      "unit": "ounces",
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Line baking sheets with parchment paper."
    },
    {
      "step": 2,
      "text": "Melt the white almond bark in a heatproof bowl over gently simmering water, stirring until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the semisweet chocolate chips until fully melted and combined.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Fold in the peanuts until evenly coated."
    },
    {
      "step": 5,
      "text": "Drop spoonfuls of the mixture onto the prepared sheets."
    },
    {
      "step": 6,
      "text": "Let the clusters stand at room temperature until firm.",
      "timer_minutes": 60
    }
  ],
