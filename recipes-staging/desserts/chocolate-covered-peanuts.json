  "id": "chocolate-covered-peanuts",
  "name": "Chocolate-Covered Peanuts",
  "subtitle": "Salted peanuts coated in a two-chocolate candy shell.",
  "description": "A simple chocolate-and-almond-bark peanut candy that sets into bite-size clusters.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 56,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
