      "item": "unsalted butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "cut into pieces"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter with part of the divided sugar until smooth."
    },
    {
      "step": 3,
      "text": "Add the flour, baking powder, and salt; mix until combined. Stir in the milk to make a thick batter."
    },
    {
      "step": 4,
      "text": "Transfer the batter to a baking dish and scatter the huckleberries over it."
    },
    {
      "step": 5,
      "text": "Combine the remaining sugar and boiling water, stirring until the mixture is boiling."
    },
    {
      "step": 6,
      "text": "Pour the boiling mixture over the batter, then dot the top with the butter pieces."
    },
    {
      "step": 7,
      "text": "Bake for 50 minutes, until the cake is set and the fruit sauce is bubbling.",
      "timer_minutes": 50
    }
  ],
