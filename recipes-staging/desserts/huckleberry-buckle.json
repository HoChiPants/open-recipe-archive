  "id": "huckleberry-buckle",
  "name": "Huckleberry Buckle",
  "subtitle": "Tender berry cake with a bubbling butter sauce",
  "description": "A simple baked dessert combining a soft butter cake, huckleberries, and a boiling sugar mixture that forms a rich sauce as it bakes.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
