  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the apples in a baking dish."
    },
    {
      "step": 3,
      "text": "Stir together the lemon juice and water, then add the honey and cinnamon. Pour the mixture over the apples and toss to coat."
    },
    {
      "step": 4,
      "text": "Combine the brown sugar, flour, rolled oats, and butter until a crumbly topping forms."
    },
    {
      "step": 5,
      "text": "Scatter the topping evenly over the apples."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until the apples are tender.",
      "timer_minutes": 25
    }
  ],
