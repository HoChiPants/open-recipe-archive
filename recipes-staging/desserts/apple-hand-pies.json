  "id": "apple-hand-pies",
  "name": "Apple Hand Pies",
  "subtitle": "Individual pastries with spiced apple filling",
  "description": "Tender shortcrust pastries filled with cinnamon-nutmeg apples and finished with a crisp sugar topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-apples-we-used-bramley",
      "item": "cooking apples (we used Bramley)",
      "quantity": 2,
      "preparation": "peeled, cored and cut into 3cm chunks"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "salted-butter-cubed",
      "item": "salted butter cubed",
      "quantity": 25,
      "unit": "g"
    },
    {
      "ingredient_id": "sheet-of-ready-rolled-shortcrust-pastry",
      "item": "sheet of ready-rolled shortcrust pastry",
      "quantity": 320,
      "unit": "g"
    },
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "egg-beaten",
      "item": "egg beaten",
      "quantity": 1
    },
    {
      "ingredient_id": "demerara-sugar",
      "item": "demerara sugar",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven according to the pastry package directions.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Cook the apples with the brown sugar, cinnamon, nutmeg, and butter until tender. Cool the filling completely."
    },
    {
      "step": 3,
      "text": "Roll or unfold the pastry and cut five matching pairs of rounds or shapes."
    },
    {
      "step": 4,
      "text": "Mix the cornflour with the cooled apple mixture, then place filling on five pastry pieces, leaving a border."
    },
    {
      "step": 5,
      "text": "Brush the pastry borders with beaten egg, cover with the remaining pastry pieces, and press the edges firmly to seal."
    },
    {
      "step": 6,
      "text": "Transfer the pies to a baking sheet, cut small vents in the tops, brush with beaten egg, and sprinkle with demerara sugar."
    },
    {
      "step": 7,
      "text": "Chill the assembled pies for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Bake until deeply golden and fully set; verify the egg wash reaches 160°F with a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 9,
      "text": "Cool briefly before serving."
    }
  ],
