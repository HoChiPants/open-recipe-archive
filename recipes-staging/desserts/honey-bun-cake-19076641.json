  "id": "honey-bun-cake-19076641",
  "name": "Honey Bun Cake",
  "subtitle": "A tender sour-cream cake with a cinnamon-sugar center",
  "description": "A simple American-style cake layered with cinnamon, brown sugar, and a buttery sour-cream batter.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
