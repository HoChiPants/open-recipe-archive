    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Prepare a baking pan with the softened butter."
    },
    {
      "step": 2,
      "text": "Combine the brown sugar, cinnamon, and part of the divided white sugar until evenly mixed."
    },
    {
      "step": 3,
      "text": "Whisk the remaining softened butter with the remaining white sugar until smooth. Add the eggs one at a time, then mix in the vanilla."
    },
    {
      "step": 4,
      "text": "Whisk together the flour, baking powder, and salt. Add the dry mixture to the butter mixture alternately with the sour cream, mixing just until combined."
    },
    {
      "step": 5,
      "text": "Transfer half the batter to the prepared pan and spread it evenly. Add the cinnamon-sugar mixture, then cover with the remaining batter."
    },
    {
      "step": 6,
      "text": "Bake until the center is firm and a tester comes out clean.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Let the cake cool in the pan for 5 minutes, then cool completely before serving.",
      "timer_minutes": 5
    }
  ],
