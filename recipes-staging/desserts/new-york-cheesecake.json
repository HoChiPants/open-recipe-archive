  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Combine 1.5 cups flour, 0.33333334326744 cup sugar, the beaten egg, and softened butter to form the crust mixture."
    },
    {
      "step": 2,
      "text": "Press the crust mixture into the bottom and sides of a cheesecake pan."
    },
    {
      "step": 3,
      "text": "Bake the crust at 400°F for 15 minutes, then cool it.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Raise the oven temperature to 475°F. Combine the softened cream cheese, 1.75 cups sugar, 3 tablespoons flour, eggs, egg yolks, and heavy cream until smooth."
    },
    {
      "step": 5,
      "text": "Pour the filling over the cooled crust and bake at 475°F for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Reduce the oven temperature to 200°F and continue baking until the center is firm and fully set, reaching 160°F when checked with a food thermometer."
    },
    {
      "step": 7,
      "text": "Cool the cheesecake, then chill it thoroughly before serving."
    }
  ],
