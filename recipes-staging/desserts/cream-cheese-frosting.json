  "id": "cream-cheese-frosting",
  "name": "Cream Cheese Frosting",
  "subtitle": "Smooth, tangy icing for cakes",
  "description": "A simple cream cheese frosting made with softened butter, icing sugar, and full-fat cream cheese, with optional orange juice for a citrus note.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 18,
    "unit": "cm cake (approx 8 people)"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "4oz-butter-softened",
      "item": "/4oz butter softened",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "orange-juice",
      "item": "orange juice (optional)",
      "quantity": 1,
      "unit": "tbsp",
      "optional": true
    },
    {
      "ingredient_id": "4oz-icing-sugar-sieved",
      "item": "/4oz icing sugar sieved",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "7oz-full-fat-cream-cheese",
      "item": "/7oz full fat cream cheese",
      "quantity": 200,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened butter until smooth and creamy."
    },
    {
      "step": 2,
      "text": "Add the icing sugar and optional orange juice, then whisk until combined."
    },
    {
      "step": 3,
      "text": "Add the full-fat cream cheese and whisk briefly until smooth."
    },
    {
      "step": 4,
      "text": "Use the frosting immediately, or chill for 10 minutes if a firmer texture is preferred.",
      "timer_minutes": 10
    }
  ],
