  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Divide the pudding mix between the batter and topping. Combine the cake mix, eggs, one package of pudding mix, oil, orange extract, and mandarin orange segments; mix for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Pour the batter into a baking pan and bake for 25 minutes, or until the cake is set.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Cool the cake completely. Combine the remaining pudding mix with the thawed whipped topping and drained crushed pineapple."
    },
    {
      "step": 4,
      "text": "Spread the topping over the cooled cake and serve."
    }
  ],
