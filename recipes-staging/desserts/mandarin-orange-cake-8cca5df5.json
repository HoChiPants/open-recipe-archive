  "name": "Mandarin Orange Cake",
  "subtitle": "A light citrus cake with pineapple cream topping",
  "description": "A tender mandarin orange cake finished with a cool pineapple-whipped topping.",
  "meal_type": "dessert",
  "cuisine": "American",
