      "quantity": 7,
      "preparation": "crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Stir the graham cracker crumbs with 0.5 cup white sugar, then mix in the melted butter. Press the mixture evenly into the bottom of a baking pan."
    },
    {
      "step": 2,
      "text": "Beat the softened cream cheese with 1 cup white sugar until smooth. Mix in the lemon juice and vanilla extract, then add the eggs and blend just until incorporated. Fold in the crushed toffee bars."
    },
    {
      "step": 3,
      "text": "Spread the filling over the crust and scatter the remaining crushed toffee bars over the top."
    },
    {
      "step": 4,
      "text": "Bake for 45 minutes, then continue baking as needed until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Turn off the oven and leave the cheesecake inside for 45 minutes. Remove it and let it cool for 60 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Chill the cheesecake for at least 4 hours before slicing and serving.",
      "timer_minutes": 240
    }
  ],
