  "id": "toffee-bar-cheesecake",
  "name": "Toffee Bar Cheesecake",
  "subtitle": "Creamy baked cheesecake with a crisp crumb crust and crushed toffee",
  "description": "A rich cheesecake layered over a buttery graham cracker crust and finished with chocolate-covered toffee pieces.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
