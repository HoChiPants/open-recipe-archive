  "id": "chocolate-puddle-cupcakes",
  "name": "Chocolate Puddle Cupcakes",
  "subtitle": "Cocoa cupcakes with chocolate centers and seasonal decorations",
  "description": "Bake light chocolate cupcakes, finish them with vanilla buttercream and melted chocolate, then decorate with mini chocolate eggs and bunnies.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 85,
      "unit": "g"
    },
    {
      "ingredient_id": "butter-melted",
      "item": "butter melted",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 70,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa",
      "item": "cocoa",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "milk-chocolate",
      "item": "milk chocolate",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "mini-chocolate-eggs-and-bunnies",
      "item": "mini chocolate eggs and bunnies",
      "quantity": 100,
      "unit": "g",
      "preparation": "to decorate"
    },
    {
      "ingredient_id": "soft-butter",
      "item": "soft butter",
      "quantity": 90,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 90,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": "1/2",
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a 12-cup muffin tin with paper cases."
    },
    {
      "step": 2,
      "text": "Whisk the eggs and golden caster sugar for 8 minutes, until thick and pale.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Fold in the melted butter, then sift in the plain flour, cocoa, and baking powder and fold until just combined."
    },
    {
      "step": 4,
      "text": "Divide the batter among the cases and bake for 20 minutes, until risen and set. Cool in the tin for 5 minutes, then transfer to a rack.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Beat the soft butter, icing sugar, and vanilla extract for 5 minutes, until smooth and light.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Melt the milk chocolate gently in a microwave-safe bowl in short intervals, stirring between each, until smooth."
    },
    {
      "step": 7,
      "text": "Top the cooled cupcakes with the buttercream and drizzle or spoon over the melted chocolate."
    },
    {
      "step": 8,
      "text": "Finish with the mini chocolate eggs and bunnies and let the topping set before serving."
    }
  ],
