{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cinnamon-balls",
  "name": "Cinnamon Balls",
  "subtitle": "Almond cookies with warm cinnamon flavor",
  "description": "Tender almond-and-cinnamon cookies shaped into small rounds, baked, cooled, and finished with icing sugar.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 2
    },
    {
      "ingredient_id": "ground-almonds",
      "item": "ground almonds",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": "1 1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "vanilla-bean-paste",
      "item": "vanilla bean paste",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "icing-sugar-for-dusting",
      "item": "icing sugar for dusting"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a baking sheet with parchment."
    },
    {
      "step": 2,
      "text": "Whisk the egg whites until stiff peaks form. Fold in the golden caster sugar, ground almonds, cinnamon, and vanilla bean paste to make a cohesive dough."
    },
    {
      "step": 3,
      "text": "Shape the dough into 20 small balls and arrange them on the prepared sheet."
    },
    {
      "step": 4,
      "text": "Bake for 30 minutes, until the centers are firm and fully set, reaching 160°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cool the cookies on the sheet, then dust with the icing sugar."
    }
  ],
