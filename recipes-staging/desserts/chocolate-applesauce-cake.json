  "id": "chocolate-applesauce-cake",
  "name": "Chocolate Applesauce Cake",
  "subtitle": "A moist chocolate cake with applesauce, chocolate chips, and walnuts.",
  "description": "This simple American dessert combines cocoa, applesauce, and chopped walnuts in a tender cake with chocolate chips throughout.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
