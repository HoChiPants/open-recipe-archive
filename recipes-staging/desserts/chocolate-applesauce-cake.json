    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "unbleached-all-purpose-flour",
      "item": "unbleached all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
