  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, cocoa powder, baking soda, and salt together in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the butter and sugar until blended. Add the eggs and vanilla, then mix until smooth."
    },
    {
      "step": 4,
      "text": "Add the dry mixture and applesauce to the butter mixture, alternating as needed, and stir just until combined."
    },
    {
      "step": 5,
      "text": "Fold in the chocolate chips and walnuts, then transfer the batter to the prepared baking pan."
    },
    {
      "step": 6,
      "text": "Bake until the cake is set in the center, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Cool before serving."
    }
  ],
