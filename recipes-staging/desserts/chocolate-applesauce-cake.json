      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "unsweetened-applesauce",
      "item": "unsweetened applesauce",
      "quantity": 2,
      "unit": "cups"
    },
    {
