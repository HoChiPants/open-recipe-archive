  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan. Stir in the onion, flour, salt, and pepper; cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk in the chicken broth and milk. Simmer for 1 minute, stirring, until thickened.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Stir in the cooked chicken, peas and carrots, and drained potatoes."
    },
    {
      "step": 5,
      "text": "Line a pie dish with half of the pastry. Fill with the chicken mixture, cover with the remaining pastry, and seal the edges. Cut vents in the top."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until golden brown and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Let the pie cool before serving.",
      "timer_minutes": 20
    }
  ],
