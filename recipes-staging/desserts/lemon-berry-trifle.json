  "id": "lemon-berry-trifle",
  "name": "Lemon Berry Trifle",
  "subtitle": "Layered lemon pudding, cake, berries, and whipped cream",
  "description": "A chilled dessert assembled in layers of lemon pudding, cubed angel food cake, fresh berries, and lightly sweetened whipped cream.",
  "meal_type": "dessert",
