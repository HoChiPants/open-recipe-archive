  "instructions": [
    {
      "step": 1,
      "text": "Whisk the milk, lemon pudding mix, lemon juice, and 1 cup of the heavy whipping cream until smooth. Chill for 60 minutes, or until set.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Whip the remaining heavy whipping cream with the confectioners' sugar and vanilla extract until stiff peaks form."
    },
    {
      "step": 3,
      "text": "Arrange some of the cake cubes in a large trifle dish. Add layers of lemon pudding, strawberries, blueberries, and whipped cream."
    },
    {
      "step": 4,
      "text": "Repeat the layers as needed, finishing with whipped cream and berries. Chill before serving."
    }
  ],
