{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "rosemary-shortbread-cookies",
  "name": "Rosemary Shortbread Cookies",
  "subtitle": "Buttery cookies with fresh rosemary",
  "description": "Tender, lightly sweet shortbread with a fragrant rosemary flavor and a sugared finish.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 80,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-rosemary",
      "item": "fresh rosemary",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "white-sugar-for-decoration",
      "item": "white sugar for decoration",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the butter and white sugar until smooth. Reserve the decoration sugar for topping."
    },
    {
      "step": 2,
      "text": "Stir together the chopped rosemary, flour, and salt, then add the dry mixture to the butter mixture and combine into a dough."
    },
    {
      "step": 3,
      "text": "Shape the dough into a compact log, wrap or cover it, and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 5,
      "text": "Lightly flour the work surface. Roll or press the chilled dough to an even thickness and cut into 36 cookies."
    },
    {
      "step": 6,
      "text": "Transfer the cookies to a baking sheet and sprinkle with the decoration sugar."
    },
    {
      "step": 7,
      "text": "Bake until the edges are lightly golden, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 8,
      "text": "Cool the cookies on the baking sheet until firm."
    }
  ],
  "tags": [
    "dessert",
    "cookies",
    "shortbread",
    "rosemary",
    "baking"
  ],
