{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "air-fryer-apple-pies",
  "name": "Air Fryer Apple Pies",
  "subtitle": "Hand pies with cinnamon apple filling and a simple sugar glaze",
  "description": "Flaky individual pastries filled with spiced apples, cooked until crisp in the air fryer, and finished with a light glaze.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "granny-smith-apples",
      "item": "Granny Smith apples",
      "quantity": 2,
      "unit": "medium",
      "preparation": "diced"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "pastry-for-a-9-inch-double-crust-pie",
      "item": "pastry for a 9-inch double crust pie",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "grapeseed-oil",
      "item": "grapeseed oil",
      "quantity": 0.5,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or more as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the apples, 4 tablespoons brown sugar, butter, and cinnamon in a small skillet over medium heat until the apples begin to soften. Mix cornstarch with cold water, stir it into the skillet, and cook until the filling thickens. Let cool slightly."
    },
    {
      "step": 2,
      "text": "Heat the air fryer to 385°F. Roll the pastry into a smooth sheet and cut into eight equal pieces. Divide the apple filling among four pieces, leaving a border around each portion."
    },
    {
      "step": 3,
      "text": "Top with the remaining pastry pieces. Moisten and press the edges closed, then cut small vents in the tops. Lightly coat the air-fryer basket with cooking spray and brush the pies with grapeseed oil."
    },
    {
      "step": 4,
      "text": "Arrange the pies in the basket without crowding and air-fry until browned and crisp. Cook in batches if needed.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Whisk the remaining 2 tablespoons brown sugar with confectioners' sugar and milk, adding more milk as needed for a drizzle. Spoon over the warm pies before serving."
    }
  ],
