  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the toasted almonds, graham cracker crumbs, sugar, salt, and melted butter. Press the mixture evenly into a pie dish."
    },
    {
      "step": 3,
      "text": "Bake the crust until golden brown, about 13 minutes. Let it cool briefly.",
      "timer_minutes": 13
    },
    {
      "step": 4,
      "text": "Whisk the condensed milk, cold heavy cream, egg yolks, lime zest, and lime juice until smooth and combined."
    },
    {
      "step": 5,
      "text": "Pour the filling into the crust and bake until set; the center should be firm or register 160°F.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Chill for at least 8 hours, then serve.",
      "timer_minutes": 480
    }
  ],
