{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "loukoumades",
  "name": "Loukoumades",
  "subtitle": "Greek honey-scented fried dough bites",
  "description": "Light fried dough bites are finished with warm honey and cinnamon for a simple Greek dessert.",
  "meal_type": "dessert",
  "cuisine": "Greek",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15,
    "inactive_minutes": 65
  },
  "ingredients": [
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 2,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "warm-water",
      "item": "warm water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "warm-milk",
      "item": "warm milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 4,
      "unit": "cups",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the yeast with the warm water and warm milk; let stand for 5 minutes. Stir in the sugar and salt.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk in the flour, eggs, and softened butter until the batter is smooth."
    },
    {
      "step": 3,
      "text": "Cover and let the batter rest until puffy, about 30 minutes. Stir briefly before frying.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Combine the honey with the 0.5 cup water in a small saucepan and warm gently."
    },
    {
      "step": 5,
      "text": "Heat the vegetable oil to 350°F in a deep, heavy pot."
    },
    {
      "step": 6,
      "text": "Drop small portions of batter into the hot oil and fry, turning as needed, until golden brown, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 7,
      "text": "Drain the fried dough on paper towels, transfer to a serving dish, and spoon the warm honey mixture over it. Sprinkle with cinnamon and serve warm."
    }
  ],
