  "id": "powdered-sugar-cookies",
  "name": "Powdered Sugar Cookies",
  "subtitle": "Tender sugar cookies with a delicate powdered finish",
  "description": "A simple American cookie made with butter, oil, vanilla, and two kinds of sugar, shaped before and after baking.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
