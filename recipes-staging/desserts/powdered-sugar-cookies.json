  "instructions": [
    {
      "step": 1,
      "text": "Whisk the confectioners' sugar, white sugar, butter, vegetable oil, and salt until smooth. Add the eggs and vanilla extract, then mix until combined."
    },
    {
      "step": 2,
      "text": "Mix in the baking soda, cream of tartar, and flour to form a soft dough."
    },
    {
      "step": 3,
      "text": "Shape the dough into cookies and coat or finish them with the confectioners' sugar and white sugar."
    },
    {
      "step": 4,
      "text": "Bake at 350°F for 8 minutes, until the cookies are set and the centers are fully baked.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Shape or finish the warm cookies again with the confectioners' sugar and white sugar."
    }
  ],
