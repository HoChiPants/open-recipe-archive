{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "texas-pie",
  "name": "Texas Pie",
  "subtitle": "A simple cherry, pineapple, coconut, and pecan bake",
  "description": "Layer fruit, cake mix, coconut, pecans, and melted margarine, then bake until golden brown.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "cherry-pie-filling",
      "item": "cherry pie filling",
      "quantity": 1,
      "unit": "can",
      "preparation": "21 ounce"
    },
    {
      "ingredient_id": "pineapple-with-juice",
      "item": "pineapple with juice",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, crushed"
    },
    {
      "ingredient_id": "butter-cake-mix",
      "item": "butter cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "pecan-halves",
      "item": "pecan halves",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 1,
      "unit": "cup",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Spread the cherry pie filling in a baking dish. Stir in the crushed pineapple with its juice."
    },
    {
      "step": 3,
      "text": "Add the butter cake mix and combine with the fruit. Spread the mixture evenly, then top with the flaked coconut and pecan halves."
    },
    {
      "step": 4,
      "text": "Pour the melted margarine over the top."
    },
    {
      "step": 5,
      "text": "Bake for 40 minutes, until golden brown.",
      "timer_minutes": 40
    }
  ],
