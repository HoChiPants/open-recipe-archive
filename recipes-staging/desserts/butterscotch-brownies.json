  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, and salt together."
    },
    {
      "step": 3,
      "text": "Beat the melted butter, brown sugar, and confectioners' sugar until blended. Add the eggs and vanilla, then mix in the dry ingredients. Fold in the walnuts."
    },
    {
      "step": 4,
      "text": "Transfer the batter to a baking pan and bake until golden brown, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Cool the brownies for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Stir the coffee granules into the water. Beat the softened butter, brown sugar, and confectioners' sugar until smooth, then whisk in the coffee mixture."
    },
    {
      "step": 7,
      "text": "Spread the frosting over the cooled brownies and let it set before serving."
    }
  ],
