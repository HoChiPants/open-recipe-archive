  "id": "butterscotch-brownies",
  "name": "Butterscotch Brownies",
  "subtitle": "Chewy brown-sugar bars with coffee frosting",
  "description": "Bake a walnut-studded brown-sugar batter, cool it, and finish the bars with a coffee-scented butter frosting.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
