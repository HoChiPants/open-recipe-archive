{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "caramelized-pineapple-with-rum-and-coconut-cream",
  "name": "Caramelized Pineapple with Rum and Coconut Cream",
  "subtitle": "Rum-glazed pineapple with softly whipped cream",
  "description": "Tender pineapple is cooked in a dark rum syrup, set with gelatine, and paired with lightly sweetened coconut and double cream.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 3,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "gelatine-leaves",
      "item": "gelatine leaves",
      "quantity": 3
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "pineapple-cut-into-1cm-cubes",
      "item": "pineapple cut into 1cm cubes",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-rum",
      "item": "dark rum",
      "quantity": 25,
      "unit": "ml"
    },
    {
      "ingredient_id": "coconut-whipping-cream-we-used-biona-organic",
      "item": "coconut whipping cream (we used Biona Organic)",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 160,
      "unit": "ml"
    },
    {
      "ingredient_id": "muscovado-sugar",
      "item": "muscovado sugar",
      "quantity": "1/2",
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Soak the gelatine leaves in cold water for 5 minutes, or until pliable.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Place the caster sugar, dark rum, and muscovado sugar in a saucepan and heat until the sugar dissolves."
    },
    {
      "step": 3,
      "text": "Add the pineapple and cook for 10 minutes, stirring occasionally, until the syrup thickens.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Remove from the heat. Squeeze out the gelatine, stir it into the hot pineapple mixture, and transfer the mixture to a dish."
    },
    {
      "step": 5,
      "text": "Chill for 30 minutes, until set.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Whisk the coconut whipping cream and double cream with the caster sugar and muscovado sugar until soft peaks form."
    },
    {
      "step": 7,
      "text": "Whisk the set pineapple mixture briefly to loosen it, then fold in the whipped cream and serve."
    }
  ],
  "tags": [
    "dessert",
    "pineapple",
