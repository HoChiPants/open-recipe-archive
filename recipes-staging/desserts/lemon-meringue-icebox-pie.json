{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "lemon-meringue-icebox-pie",
  "name": "Lemon Meringue Icebox Pie",
  "subtitle": "Bright lemon filling under a toasted meringue",
  "description": "A simple lemon pie with a creamy citrus filling and sweet, airy meringue topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "9-inch-prepared-graham-cracker-crust",
      "item": "(9 inch) prepared graham cracker crust",
      "quantity": 1
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 3
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 3
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 5,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 500°F."
    },
    {
      "step": 2,
      "text": "Whisk the sweetened condensed milk, egg yolks, and lemon juice until smooth. Pour the mixture into the prepared graham cracker crust."
    },
    {
      "step": 3,
      "text": "Whisk the egg whites and white sugar until stiff peaks form, then spread the meringue over the filling, sealing it to the crust edges."
    },
    {
      "step": 4,
      "text": "Bake until the meringue is lightly browned and the filling is fully set, reaching 160°F at the center when checked with a food thermometer.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Let the pie cool before serving."
    }
  ],
