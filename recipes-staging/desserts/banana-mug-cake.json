  "id": "banana-mug-cake",
  "name": "Banana Mug Cake",
  "subtitle": "A warm, single-serving banana cake",
  "description": "Mash, mix, and microwave this quick banana cake in one mug.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 1
  },
  "ingredients": [
    {
      "ingredient_id": "banana-peeled",
      "item": "banana peeled",
      "quantity": 1
    },
    {
      "ingredient_id": "egg-beaten",
      "item": "egg beaten",
      "quantity": 1
    },
    {
      "ingredient_id": "vegetable-or-sunflower-oil",
      "item": "vegetable or sunflower oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "maple-syrup-plus-extra-for-drizzling-optional",
      "item": "maple syrup plus extra for drizzling (optional)",
      "quantity": 3,
      "unit": "tbsp",
      "optional": true
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "pecans-or-chocolate-chips-optional",
      "item": "pecans or chocolate chips (optional)",
      "quantity": 1,
      "unit": "tbsp",
      "preparation": "chopped",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "In a microwave-safe mug, cut and mash the peeled banana until mostly smooth."
    },
    {
      "step": 2,
      "text": "Stir in the beaten egg, oil, vanilla extract, and maple syrup. Mix in the flour and baking powder, then fold in the pecans or chocolate chips if using."
    },
    {
      "step": 3,
      "text": "Microwave on high for 1 minute, or until the center is firm and fully set and the cake reaches 160°F on a food thermometer. Microwave briefly longer if needed.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Drizzle with extra maple syrup if desired."
    }
  ],
