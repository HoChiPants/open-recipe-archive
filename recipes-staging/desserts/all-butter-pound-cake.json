  "id": "all-butter-pound-cake",
  "name": "All-Butter Pound Cake",
  "subtitle": "A classic dense cake with a tender buttery crumb.",
  "description": "Creamed butter and sugar form the base for this simple vanilla pound cake.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60,
    "inactive_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 5
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease and flour the baking pan using portions of the listed flour and butter."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, baking powder, and salt."
    },
    {
      "step": 3,
      "text": "Beat the softened butter and sugar until light and well combined. Add the eggs one at a time, mixing after each addition."
    },
    {
      "step": 4,
      "text": "Add the flour mixture alternately with the milk, mixing just until incorporated. Stir in the vanilla extract."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 60 minutes, until the cake is set and a tester inserted in the center comes out clean.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool in the pan for 5 minutes, then transfer the cake to a rack and cool for 30 minutes before serving.",
      "timer_minutes": 35
    }
  ],
