  "id": "dairy-free-chocolate-pudding",
  "name": "Dairy-Free Chocolate Pudding",
  "subtitle": "Silky cocoa pudding made with soy milk",
  "description": "A simple chocolate pudding thickened with cornstarch and served chilled.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10,
    "inactive_minutes": 65
  },
  "ingredients": [
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "soy-milk",
      "item": "soy milk",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cornstarch and water into a smooth slurry. In a saucepan, combine the soy milk, sugar, cocoa powder, and vanilla extract."
    },
    {
      "step": 2,
      "text": "Whisk the slurry into the saucepan mixture until evenly incorporated."
    },
    {
      "step": 3,
      "text": "Heat over medium heat, stirring constantly, until the mixture reaches a boil and thickens.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Remove from the heat and let the pudding cool briefly.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Divide between two serving dishes and chill until set, about 2 hours.",
      "timer_minutes": 120
    }
  ],
