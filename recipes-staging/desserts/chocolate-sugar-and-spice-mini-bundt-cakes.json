  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Brush the 12-hole mini bundt tin with the oil, dust it evenly with cocoa powder, and tap out the excess."
    },
    {
      "step": 2,
      "text": "Put the butter, brown sugar, and golden syrup in a saucepan. Warm gently until melted, then add the coffee and milk and heat until set."
    },
    {
      "step": 3,
      "text": "Whisk the flour, cocoa powder, nutmeg, cinnamon, ground ginger, and bicarbonate of soda in a bowl. Pour in the warm butter mixture and beaten eggs, then whisk until thick and smooth."
    },
    {
      "step": 4,
      "text": "Divide the batter among the prepared tin wells and bake until risen and set.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Let the cakes cool briefly in the tin, then turn them out and cool completely."
    },
    {
      "step": 6,
      "text": "Melt the chopped dark chocolate with the double cream, whisk until smooth, and stir until set.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Spoon the chocolate topping over the cooled cakes and finish with the chopped crystallised ginger."
    }
  ],
