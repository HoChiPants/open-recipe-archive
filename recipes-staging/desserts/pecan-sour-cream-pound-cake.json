  "id": "pecan-sour-cream-pound-cake",
  "name": "Pecan Sour Cream Pound Cake",
  "subtitle": "A tender pecan cake finished with a citrus glaze",
  "description": "A rich sour cream pound cake with chopped pecans and a simple orange glaze.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 90,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cake-flour",
      "item": "cake flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "orange-juice",
      "item": "orange juice",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 300°F. Prepare a tube or Bundt pan with cake flour."
    },
    {
      "step": 2,
      "text": "Combine the cake flour, salt, and baking soda. Set the dry mixture aside, and toss the chopped pecans with a little of the prepared flour."
    },
    {
      "step": 3,
      "text": "Whisk the white sugar, butter, and confectioners' sugar until blended and creamy. Add the eggs one at a time, then whisk in the vanilla extract."
    },
    {
      "step": 4,
      "text": "Add the dry mixture and sour cream in alternating additions, mixing just until combined. Fold in the pecans."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and smooth the surface."
    },
    {
      "step": 6,
      "text": "Bake for 90 minutes, until the cake is fully set in the center.",
      "timer_minutes": 90
    },
    {
      "step": 7,
      "text": "Cool the cake in the pan for 20 minutes, then transfer it to a rack and let it cool completely.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "Combine the confectioners' sugar, white sugar, vanilla extract, and orange juice to make a glaze. Prepare the cooled cake for finishing, then transfer the glaze over the cake."
    }
  ],
