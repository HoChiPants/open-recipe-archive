  "id": "doughnut-bread-pudding",
  "name": "Doughnut Bread Pudding",
  "subtitle": "A warm baked custard dessert with cinnamon and dried fruit",
  "description": "Stale glazed doughnuts absorb a lightly spiced orange-vanilla custard before baking into a soft, fragrant pudding.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "stale-raised-glazed-donuts",
      "item": "stale raised glazed donuts",
      "quantity": 4
    },
    {
      "ingredient_id": "raisins-or-other-dried-fruit",
      "item": "raisins or other dried fruit",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "eggs-room-temperature",
      "item": "eggs (room temperature)",
      "quantity": 2
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "12 fluid ounce"
    },
    {
