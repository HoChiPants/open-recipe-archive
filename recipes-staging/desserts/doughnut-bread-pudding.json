      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "grated-orange-zest",
      "item": "grated orange zest",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking dish for the pudding."
    },
    {
      "step": 2,
      "text": "Cut the doughnuts into bite-size pieces and place them in the dish. Scatter the raisins or other dried fruit over them."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, evaporated milk, sugar, vanilla extract, almond extract, and orange zest until smooth. Stir in the cinnamon and nutmeg."
    },
    {
      "step": 4,
      "text": "Pour the custard over the doughnut pieces, pressing gently so they are moistened. Refrigerate for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Bake until puffed and the center is fully set, about 40–45 minutes. Confirm with a thermometer that the egg-based center reaches 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Rest briefly, then serve warm."
    }
  ],
