  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Lightly oil a baking dish."
    },
    {
      "step": 2,
      "text": "Boil the baby potatoes until tender, about 15 minutes. Drain and let them steam-dry briefly.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Meanwhile, warm the olive oil in a pan. Cook the onion or shallot and carrot for 10 minutes, then add the cherry tomatoes, garlic, and tomato purée and cook for 10 minutes more.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Stir in the passata and meatballs. Cook until the sauce thickens, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Transfer the ragu to the prepared dish. Arrange the potatoes over the top, gently flattening them, and brush with extra oil. Bake for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Scatter over the cheddar and parmesan. Bake for 40 minutes, until the potato crust is crisp and the meatballs reach 160°F internally.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Rest briefly, then finish with the basil leaves and serve."
    }
  ],
