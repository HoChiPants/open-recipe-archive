{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "coconut-cream-pecan-layer-dessert",
  "name": "Coconut Cream Pecan Layer Dessert",
  "subtitle": "A chilled dessert with a buttery pecan crust and creamy coconut layers",
  "description": "A baked pecan crust is topped with sweetened cream cheese, coconut pudding, and whipped topping, then chilled until set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "finely-chopped-pecans",
      "item": "finely chopped pecans",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter-or-margarine",
      "item": "butter or margarine",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, room temperature"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "frozen-whipped-topping",
      "item": "frozen whipped topping",
      "quantity": 1,
      "unit": "cup",
      "preparation": "thawed"
    },
    {
      "ingredient_id": "instant-coconut-cream-pudding-mix",
      "item": "instant coconut cream pudding mix",
      "quantity": 2,
      "unit": "package",
      "preparation": "3.5 ounce"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "frozen-whipped-topping",
      "item": "frozen whipped topping",
      "quantity": 3,
      "unit": "cups",
      "preparation": "thawed"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Stir the flour, finely chopped pecans, butter or margarine, and pecans together until evenly moistened."
    },
    {
      "step": 2,
      "text": "Press the crust mixture into a baking dish and bake for 15 minutes. Cool completely.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Beat the room-temperature cream cheese with the confectioners' sugar until smooth. Fold in 1 cup of thawed whipped topping and spread over the cooled crust."
    },
    {
      "step": 4,
      "text": "Whisk the pudding mix with the milk until thickened, then spread it evenly over the cream cheese layer."
    },
    {
      "step": 5,
      "text": "Finish with the remaining thawed whipped topping and chopped pecans. Chill until set."
    }
  ],
