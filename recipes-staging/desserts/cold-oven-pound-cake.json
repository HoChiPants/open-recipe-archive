  "id": "cold-oven-pound-cake",
  "name": "Cold Oven Pound Cake",
  "subtitle": "A simple, tender cake baked from a cold start",
  "description": "Creamed margarine and shortening give this classic pound cake a rich crumb, while a cold-oven start helps it bake evenly.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 90,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare the all-purpose flour for mixing. Whisk the white sugar, margarine, and shortening until blended and creamy."
    },
    {
      "step": 2,
      "text": "Whisk in the eggs, one addition at a time, then stir in the vanilla extract."
    },
    {
      "step": 3,
      "text": "Add the flour and milk, alternating between them, and stir just until the batter is smooth."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared baking pan. Place it in a cold oven, set the oven to 300°F, and bake for 120 minutes, until set.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Let the cake cool for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
