  "id": "lemon-blueberry-pound-cake",
  "name": "Lemon Blueberry Pound Cake",
  "subtitle": "A buttery citrus cake studded with fresh blueberries.",
  "description": "This tender pound cake combines lemon zest and extract with fresh blueberries for a bright, fruit-filled dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "cups",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6
    },
    {
      "ingredient_id": "lemon-extract",
      "item": "lemon extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "unbleached-all-purpose-flour",
      "item": "unbleached all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "grated-lemon-zest",
      "item": "grated lemon zest",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup",
      "preparation": "room temperature"
    },
    {
      "ingredient_id": "fresh-blueberries",
      "item": "fresh blueberries",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a cake pan for baking."
    },
    {
      "step": 2,
      "text": "Combine the flour and baking powder in a bowl."
    },
    {
      "step": 3,
      "text": "Whisk the sugar and softened butter until smooth and creamy.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Whisk in the eggs, lemon extract, and lemon zest."
    },
    {
      "step": 5,
      "text": "Add the flour mixture in portions, alternating with the milk, and stir just until combined."
    },
    {
      "step": 6,
      "text": "Fold in the blueberries gently."
    },
    {
      "step": 7,
      "text": "Transfer the batter to the prepared pan and smooth the surface."
    },
    {
      "step": 8,
      "text": "Bake at 350°F until the cake is set and a tester inserted in the center comes out clean.",
      "timer_minutes": 60
    },
    {
      "step": 9,
      "text": "Let the cake cool in the pan for 10 minutes before serving or transferring to a rack.",
      "timer_minutes": 10
    }
  ],
