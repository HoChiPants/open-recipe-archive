  "id": "air-fryer-blueberry-crisp",
  "name": "Air Fryer Blueberry Crisp",
  "subtitle": "A small-batch oat-topped berry dessert made in the air fryer.",
  "description": "Frozen blueberries bake beneath a buttery cinnamon-oat topping until bubbling and golden.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-blueberries",
      "item": "frozen blueberries",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "topping",
      "item": "Topping:"
    },
    {
      "ingredient_id": "quick-cooking-oats",
      "item": "quick-cooking oats",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "salted butter",
      "quantity": 1.5,
      "unit": "tablespoons",
      "preparation": "softened"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 360°F."
    },
    {
      "step": 2,
      "text": "Toss the frozen blueberries with 2 teaspoons flour, lemon juice, and a pinch of salt. Transfer to a small air-fryer-safe baking dish."
    },
    {
      "step": 3,
      "text": "For the topping, combine the oats, 1.5 tablespoons flour, brown sugar, and cinnamon. Work in the softened butter until the mixture forms clumps, then scatter it evenly over the berries."
    },
    {
      "step": 4,
      "text": "Air-fry until the filling is bubbling and the topping is golden brown.",
      "timer_minutes": 14
    }
  ],
