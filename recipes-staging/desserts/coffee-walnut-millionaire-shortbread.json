  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease a baking tin with some of the butter."
    },
    {
      "step": 2,
      "text": "Crush or finely chop 40 g walnut halves. Rub the cold unsalted butter into the flour, then mix in the golden caster sugar, 4 tbsp espresso powder, and chopped walnuts. Press the mixture evenly into the tin."
    },
    {
      "step": 3,
      "text": "Bake the shortbread base for 25 minutes, then let it cool in the tin.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Combine the light muscovado sugar, both cans of condensed milk, and 50 g butter in a saucepan. Heat gently, stirring until the sugar dissolves, then simmer until thickened. Stir in 1 tsp espresso powder and 300 g dark chocolate until smooth.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Spread the caramel mixture over the cooled shortbread and leave the layer to firm for about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Melt the remaining dark chocolate with the white chocolate and the remaining butter. Stir in the espresso powder, then spread the chocolate mixture over the caramel layer."
    },
    {
      "step": 7,
      "text": "Decorate with the chocolate-coated coffee beans and walnut halves, then chill until set.",
      "timer_minutes": 120
    }
  ],
