  "id": "coffee-walnut-millionaire-shortbread",
  "name": "Coffee Walnut Millionaire Shortbread",
  "subtitle": "A layered coffee, caramel, walnut, and chocolate traybake",
  "description": "Buttery coffee shortbread is topped with a condensed-milk caramel and finished with dark and white chocolate, walnuts, and chocolate-coated coffee beans.",
  "meal_type": "dessert",
