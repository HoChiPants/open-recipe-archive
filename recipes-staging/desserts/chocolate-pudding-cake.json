  "id": "chocolate-pudding-cake",
  "name": "Chocolate Pudding Cake",
  "subtitle": "Warm chocolate cake with a thick pudding layer",
  "description": "A simple chocolate dessert combining cake batter, cooked pudding, and chocolate chips in one pan.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "all-purpose-flour-for-dusting",
      "item": "all-purpose flour for dusting"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "non-instant-chocolate-pudding-mix",
      "item": "non-instant chocolate pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.4 ounce"
    },
    {
      "ingredient_id": "devil-s-food-cake-mix",
      "item": "devil's food cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "15.25 ounce"
    },
    {
      "ingredient_id": "semi-sweet-chocolate-chips",
      "item": "semi-sweet chocolate chips",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Coat a baking pan with cooking spray and dust it with flour."
    },
    {
      "step": 2,
      "text": "Combine the milk and pudding mix in a saucepan. Cook, stirring, until thickened."
    },
    {
      "step": 3,
      "text": "Prepare the cake mix according to its package directions until smooth."
    },
    {
      "step": 4,
      "text": "Transfer the cake batter to the prepared pan. Spoon the thickened pudding over it and scatter the chocolate chips on top."
    },
    {
      "step": 5,
      "text": "Bake until the cake is set, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
