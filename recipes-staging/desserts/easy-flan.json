{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "easy-flan",
  "name": "Easy Flan",
  "subtitle": "Silky custard with a caramel topping",
  "description": "A classic Mexican baked custard made with caramelized sugar, milk, eggs, and egg yolks.",
  "meal_type": "dessert",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 2,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.375,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Place the 0.5 cup sugar in a flan mold or round baking dish and heat until melted and amber; tilt to coat the bottom, then set aside."
    },
    {
      "step": 2,
      "text": "Heat the milk until boiling. Combine the beaten eggs and egg yolks, then stir in the 0.375 cup sugar."
    },
    {
      "step": 3,
      "text": "Gradually transfer the hot milk into the egg mixture, stirring continuously to combine."
    },
    {
      "step": 4,
      "text": "Pour the custard into the caramel-coated dish. Set the dish in a larger pan and add hot water around it to form a water bath."
    },
    {
      "step": 5,
      "text": "Bake for 40 minutes, until the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Remove the dish from the water bath and cool the flan before serving."
    }
  ],
  "tags": [
    "dessert",
    "mexican"
  ],
  "seasons": [
    "year-round"
  ],
