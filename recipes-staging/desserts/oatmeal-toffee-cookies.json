  "id": "oatmeal-toffee-cookies",
  "name": "Oatmeal Toffee Cookies",
  "subtitle": "Chewy oat cookies with pecans and toffee",
  "description": "Softened butter, oats, pecans, and toffee bits make these cookies rich, chewy, and crisp at the edges.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "packed-light-brown-sugar",
      "item": "packed light brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "toffee-baking-bits",
      "item": "toffee baking bits",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Beat the softened butter and brown sugar until combined. Add the egg and vanilla, mixing until smooth."
    },
    {
      "step": 3,
      "text": "Whisk together the flour, baking soda, and salt."
    },
    {
      "step": 4,
      "text": "Stir the dry ingredients into the butter mixture. Fold in the oats, pecans, and toffee bits."
    },
    {
      "step": 5,
      "text": "Portion the dough onto baking sheets, leaving space between portions."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, until the centers are fully set and reach 160°F on a food thermometer.",
      "timer_minutes": 10
    }
  ],
