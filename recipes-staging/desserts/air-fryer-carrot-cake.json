  "instructions": [
    {
      "step": 1,
      "text": "Grease a cake tin that fits your air fryer with some of the vegetable oil."
    },
    {
      "step": 2,
      "text": "Preheat the air fryer according to its cake-baking setting."
    },
    {
      "step": 3,
      "text": "Mix the self-raising flour, ground cinnamon, and a little freshly grated nutmeg in a bowl."
    },
    {
      "step": 4,
      "text": "Whisk the remaining vegetable oil with the light brown soft sugar, vanilla extract, and eggs until combined."
    },
    {
      "step": 5,
      "text": "Stir the wet mixture into the dry ingredients, then fold in the pecans roughly chopped, grated carrots, and raisins."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared tin and bake in the air fryer for 45 minutes, or until set in the center and a skewer comes out clean.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Cool the cake in the tin for 15 minutes, then transfer it to a rack to cool completely.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Beat the butter softened with the icing sugar sifted until smooth, then whisk in the soft cheese."
    },
    {
      "step": 9,
      "text": "Spread the icing over the cooled cake and finish with grated nutmeg and any remaining pecans roughly chopped or icing sugar sifted."
    }
  ],
