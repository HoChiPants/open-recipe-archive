  },
  "ingredients": [
    {
      "ingredient_id": "yellow-cake-mix",
      "item": "yellow cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "instant-vanilla-pudding-mix",
      "item": "instant vanilla pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.4 ounce"
    },
    {
      "ingredient_id": "poppy-seeds",
      "item": "poppy seeds",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "water",
