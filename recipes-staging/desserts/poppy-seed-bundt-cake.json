  "id": "poppy-seed-bundt-cake",
  "name": "Poppy Seed Bundt Cake",
  "subtitle": "A tender vanilla cake with almond flavor and poppy seeds",
  "description": "A simple Bundt cake made with vanilla pudding mix, poppy seeds, and almond extract.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
