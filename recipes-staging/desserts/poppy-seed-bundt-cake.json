      "quantity": 4
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a Bundt pan for baking."
    },
    {
      "step": 2,
      "text": "Combine the cake mix, pudding mix, and poppy seeds in a large bowl."
    },
    {
      "step": 3,
      "text": "Add the water, vegetable oil, eggs, and almond extract. Whisk until the batter is smooth, then continue whisking for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared Bundt pan and bake at 350°F for 50 minutes, until set and a tester comes out clean.",
      "timer_minutes": 50
    },
    {
      "step": 5,
      "text": "Cool the cake in the pan for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
