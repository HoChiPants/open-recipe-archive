{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "celeriac-hazelnut-muffins",
  "name": "Celeriac Hazelnut Muffins",
  "subtitle": "Spiced muffins with citrus cream topping",
  "description": "Tender grated-celeriac muffins with chopped hazelnuts, warm spice, and a cool citrus soft-cheese topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "mixed-spice",
      "item": "mixed spice",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "clementine-or-small-orange",
      "item": "clementine or small orange",
      "quantity": 1,
      "preparation": "zested and juiced"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "celeriac-peeled-and-grated",
      "item": "celeriac peeled and grated",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "hazelnuts-chopped",
      "item": "hazelnuts chopped",
      "quantity": 75,
      "unit": "g",
      "preparation": "plus 10-12 hazelnuts, bashed, to serve (optional)",
      "optional": true
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "soft-cheese",
      "item": "soft cheese",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "clementine-zested",
      "item": "clementine zested",
      "quantity": 1,
      "preparation": "1⁄2 juiced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a 12-cup muffin tin with paper liners."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, mixed spice, golden caster sugar, and icing sugar in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the eggs with the zested and juiced clementine or orange and the vegetable oil."
    },
    {
      "step": 4,
      "text": "Stir the wet mixture into the dry ingredients, then fold in the grated celeriac and chopped hazelnuts until just combined."
    },
    {
      "step": 5,
      "text": "Divide the batter among the muffin cups and bake until risen and set in the center.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Transfer the muffins to a rack and cool completely."
    },
    {
      "step": 7,
      "text": "Whisk the soft cheese with the remaining clementine zest and juice and the icing sugar until thick. Chill until ready to use.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Spread the chilled topping over the cooled muffins and finish with the optional bashed hazelnuts."
    }
  ],
