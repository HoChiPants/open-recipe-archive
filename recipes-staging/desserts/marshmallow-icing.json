  "id": "marshmallow-icing",
  "name": "Marshmallow Icing",
  "subtitle": "Fluffy icing with a soft marshmallow finish",
  "description": "Cooked egg-white icing sweetened with sugar and corn syrup, finished with vanilla and miniature marshmallows.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 2
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "light-corn-syrup",
      "item": "light corn syrup",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "miniature-marshmallows",
      "item": "miniature marshmallows",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the egg whites, white sugar, cold water, and light corn syrup in a heatproof bowl set over boiling water."
    },
    {
      "step": 2,
      "text": "Whisk continuously until the mixture reaches 160°F and is thick and glossy, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Remove from the heat and whisk in the vanilla extract and miniature marshmallows until smooth and fully incorporated."
    },
    {
      "step": 4,
      "text": "Use the icing while soft and spreadable."
    }
  ],
