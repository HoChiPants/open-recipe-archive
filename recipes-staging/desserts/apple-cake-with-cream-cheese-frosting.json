  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Lightly prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Combine the flour, baking soda, cinnamon, and salt in one bowl."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, oil, white sugar, and confectioners' sugar until blended. Whisk in the flour mixture, then stir in vanilla, apples, and walnuts."
    },
    {
      "step": 4,
      "text": "Spread the batter in the prepared pan and bake until the center is set, about 50 minutes.",
      "timer_minutes": 50
    },
    {
      "step": 5,
      "text": "Cool the cake completely."
    },
    {
      "step": 6,
      "text": "Beat the cream cheese, softened butter, confectioners' sugar, white sugar, and vanilla until smooth. Spread the frosting over the cooled cake."
    }
  ],
