  "id": "apple-cake-with-cream-cheese-frosting",
  "name": "Apple Cake with Cream Cheese Frosting",
  "subtitle": "Tender apple cake finished with a smooth vanilla frosting",
  "description": "A spiced apple and walnut cake baked until set, cooled, and topped with a simple cream cheese frosting.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
