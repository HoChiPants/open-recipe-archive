  "id": "skillet-apple-pie",
  "name": "Skillet Apple Pie",
  "subtitle": "Caramelized apples beneath a crisp pastry crust",
  "description": "A classic apple pie assembled in a skillet with buttery brown sugar, cinnamon apples, and two pastry crusts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "refrigerated-9-inch-pie-crusts",
      "item": "refrigerated 9-inch pie crusts",
      "quantity": 2,
      "preparation": "divided"
    },
    {
      "ingredient_id": "granny-smith-apples",
      "item": "Granny Smith apples",
      "quantity": 5,
      "preparation": "peeled and sliced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
