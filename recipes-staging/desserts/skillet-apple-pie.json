    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Melt the butter in an oven-safe skillet over medium heat, then stir in 1/2 cup brown sugar until smooth, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mix the apples with the white sugar, cinnamon, flour, and remaining brown sugar."
    },
    {
      "step": 3,
      "text": "Place one crust in the skillet over the butter mixture. Add the apples, cover with the second crust, and cut several vents in the top."
    },
    {
      "step": 4,
      "text": "Bake until the crust is lightly browned and the filling is bubbling, about 45 minutes. Cool briefly before serving.",
      "timer_minutes": 45
    }
  ],
