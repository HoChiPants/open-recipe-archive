  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter, dark chocolate, and chopped chocolate together in short microwave intervals, stirring between each, until smooth. Let the mixture cool slightly."
    },
    {
      "step": 2,
      "text": "Preheat the air fryer according to its instructions. Toast the halved hot cross bun for 4 minutes, then let it cool and cut it into bite-size pieces.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Whisk the eggs and caster sugar until thick and pale. Stir in the cooled chocolate mixture, then fold in the flour, cocoa powder, toasted bun pieces, and marzipan if using."
    },
    {
      "step": 4,
      "text": "Spread the batter in a lined baking tin that fits the air fryer. Cook for about 30 minutes, until the center is firm and fully set; if checked with a thermometer, it should reach 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cool completely before cutting into 12 portions."
    }
  ],
