  "id": "hot-cross-bun-brownie",
  "name": "Hot Cross Bun Brownie",
  "subtitle": "A rich chocolate brownie with toasted spiced bun",
  "description": "Melted chocolate, cocoa, and a hot cross bun create a dense brownie with optional marzipan pieces.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
