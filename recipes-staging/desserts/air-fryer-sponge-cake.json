  "id": "air-fryer-sponge-cake",
  "name": "Air-Fryer Sponge Cake",
  "subtitle": "A light sponge layered with honey cream and blackberries",
  "description": "Bake a simple lemon-vanilla sponge in the air fryer, then fill it with honeyed cream and fresh blackberries.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-softened",
      "item": "unsalted butter softened",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-zested",
      "item": "lemon zested",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "eggs-beaten",
      "item": "eggs beaten",
      "quantity": 3
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "a-little-icing-sugar-to-decorate",
      "item": "a little icing sugar to decorate"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "wildflower-honey",
      "item": "wildflower honey",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "blackberries",
      "item": "blackberries",
      "quantity": 200,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to its cake-baking setting. Grease and line a suitable cake tin with some of the unsalted butter softened."
    },
    {
      "step": 2,
      "text": "Whisk the remaining unsalted butter softened with the golden caster sugar, lemon zested, and vanilla extract until pale and creamy.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Gradually whisk in the eggs beaten. Fold in the self-raising flour and baking powder until just combined and smooth."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared tin and cook in the air fryer until risen, golden, and a skewer inserted in the center comes out clean.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cool the cake in the tin for 10 minutes, then remove it and let it cool enough to cut horizontally.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Whisk the double cream with the wildflower honey to soft peaks. Prepare the blackberries."
    },
    {
      "step": 7,
      "text": "Fill and top the cake with the honeyed cream and blackberries. Finish with a little icing sugar to decorate."
    }
  ],
