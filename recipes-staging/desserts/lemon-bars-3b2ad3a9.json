{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "lemon-bars-3b2ad3a9",
  "name": "Lemon Bars",
  "subtitle": "A bright, creamy dessert with a tender lemon base",
  "description": "Bake a lemon cake-mix crust, top it with a smooth cream cheese mixture, and finish baking until set before cooling and chilling.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "lemon-cake-mix-with-pudding",
      "item": "lemon cake mix with pudding",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33333298563957,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Combine the lemon cake mix with the egg and vegetable oil to form a thick dough."
    },
    {
      "step": 2,
      "text": "Press the dough evenly into a baking pan and let it rest briefly."
    },
    {
      "step": 3,
      "text": "Bake the base for 15 minutes, then remove it when set.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Whisk the cream cheese, white sugar, lemon juice, and the lemon cake mix until smooth."
    },
    {
      "step": 5,
      "text": "Spread the cream cheese mixture over the warm base."
    },
    {
      "step": 6,
      "text": "Bake for 15 minutes, until the topping is fully set and the center reaches 160°F on a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Cool completely, then chill before cutting into bars."
    }
  ],
