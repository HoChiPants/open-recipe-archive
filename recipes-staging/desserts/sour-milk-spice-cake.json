  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, baking soda, sugar, salt, cinnamon, and cloves."
    },
    {
      "step": 3,
      "text": "Stir in the oil and sour milk until the batter is combined, then fold in the chopped walnuts."
    },
    {
      "step": 4,
      "text": "Transfer the batter to a prepared cake pan and bake at 350°F for 45 minutes, or until the center is firm and a tester comes out clean.",
      "timer_minutes": 45
    }
  ],
