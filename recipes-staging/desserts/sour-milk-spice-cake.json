  "id": "sour-milk-spice-cake",
  "name": "Sour Milk Spice Cake",
  "subtitle": "A warmly spiced cake with chopped walnuts",
  "description": "A simple American cake combining sour milk, cinnamon, cloves, and walnuts in a tender crumb.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
