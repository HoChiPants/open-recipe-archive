  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Cook the bacon until rendered and lightly browned, then drain it.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Add the sliced onions to the bacon fat and cook until softened. Season with the salt and pepper."
    },
    {
      "step": 4,
      "text": "Combine the milk and heavy cream. Stir the flour into the onions, then gradually stir in the milk mixture."
    },
    {
      "step": 5,
      "text": "Whisk the eggs, then stir them into the onion mixture along with the bacon and nutmeg."
    },
    {
      "step": 6,
      "text": "Pour the filling into the unbaked pie crust and bake until lightly browned and the center is fully set, reaching 160°F on a food thermometer.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Let the pie cool briefly before serving.",
      "timer_minutes": 5
    }
  ],
