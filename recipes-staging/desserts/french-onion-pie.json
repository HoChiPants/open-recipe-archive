  "id": "french-onion-pie",
  "name": "French Onion Pie",
  "subtitle": "A savory onion custard pie with bacon",
  "description": "Sweet onions, bacon, and a lightly seasoned egg custard bake together in a crisp pie crust.",
  "meal_type": "dessert",
  "cuisine": "French",
