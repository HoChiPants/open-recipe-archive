  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Combine the vanilla wafer crumbs, walnuts, and melted butter. Press the mixture over the bottom of a springform pan and set aside."
    },
    {
      "step": 2,
      "text": "Beat the cream cheese, 1 1/8 cups sugar, and flour until smooth. Add the sour cream, mashed bananas, banana liqueur, and 1 1/2 teaspoons vanilla; mix until combined. Add the eggs one at a time, stirring just until incorporated."
    },
    {
      "step": 3,
      "text": "Pour the filling over the crust and bake for 45 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "Cool the cheesecake, then chill it for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "For the topping, soften the gelatin in the cold water. Heat the milk until boiling. Whisk the egg yolks and 1/3 cup sugar until smooth, then gradually whisk in the hot milk. Return the mixture to the heat and cook, stirring, until thickened and the egg mixture reaches 160°F."
    },
    {
      "step": 6,
      "text": "Remove the custard from the heat. Stir in the softened gelatin and 2 teaspoons vanilla, then cool for 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Whip the chilled heavy cream to soft peaks and fold it into the cooled custard. Spread the topping over the cheesecake and chill until set."
    },
    {
      "step": 8,
      "text": "Decorate with the vanilla wafer cookies, slice, and serve cold."
    }
  ],
