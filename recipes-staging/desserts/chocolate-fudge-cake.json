  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking pan for the cake."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking soda, and salt together."
    },
    {
      "step": 3,
      "text": "Beat 1/2 cup butter with 2 1/2 cups packed brown sugar until smooth. Add the eggs one at a time, then whisk in the vanilla and melted chocolate."
    },
    {
      "step": 4,
      "text": "Mix in the sour cream, then gradually stir in the boiling water. Add the dry ingredients and mix just until the batter is smooth."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake until set, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Let the cake cool in the pan for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "For the frosting, prepare the remaining 1/2 cup butter, then stir in 1 cup packed brown sugar and the confectioners' sugar. Stir in the milk and continue mixing until smooth.",
      "timer_minutes": 2
    },
    {
      "step": 8,
      "text": "Transfer the frosting to the cooled cake and spread it evenly."
    }
  ],
