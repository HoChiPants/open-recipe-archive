  "id": "chocolate-hot-cross-bun-bread-pudding",
  "name": "Chocolate Hot Cross Bun Bread Pudding",
  "subtitle": "A rich chocolate custard baked with spiced buns",
  "description": "Layer chocolate-spread hot cross buns with chopped chocolate, soak them in chocolate custard, and bake until set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "dark-chocolate-roughly-chopped",
      "item": "dark chocolate roughly chopped",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "hot-cross-buns",
      "item": "hot cross buns",
      "quantity": 6
    },
    {
      "ingredient_id": "chocolate-spread",
      "item": "chocolate spread",
      "quantity": 6,
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6
    },
    {
      "ingredient_id": "vanilla-ice-cream-to-serve",
      "item": "vanilla ice cream to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the double cream, whole milk, cocoa powder, caster sugar, and vanilla extract in a saucepan. Add the dark chocolate and stir until smooth. Remove from the heat and let cool slightly."
    },
    {
      "step": 2,
      "text": "Split the hot cross buns and spread the chocolate spread inside. Arrange them in a baking dish, scattering some dark chocolate between the layers."
    },
    {
      "step": 3,
      "text": "Whisk the eggs in a bowl. Gradually whisk in the warm chocolate mixture until combined, then pour it over the buns. Leave to soak for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 5,
      "text": "Bake for about 45 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Rest briefly, then serve warm with vanilla ice cream if desired."
    }
  ],
