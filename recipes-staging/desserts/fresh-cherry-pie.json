  "id": "fresh-cherry-pie",
  "name": "Fresh Cherry Pie",
  "subtitle": "A double-crust pie filled with vanilla-almond cherries",
  "description": "Pitted cherries are mixed with sugar, tapioca, and extracts, then baked between pastry crusts until golden and set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 50,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "recipe-pastry-for-a-9-inch-double-crust-pie",
      "item": "recipe pastry for a 9 inch double crust pie",
      "quantity": 1
    },
    {
      "ingredient_id": "quick-cooking-tapioca",
      "item": "quick-cooking tapioca",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cherries",
      "item": "cherries",
      "quantity": 4,
      "unit": "cups",
      "preparation": "pitted"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1.5,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Fit half of the pastry into a 9-inch pie dish and press it gently into place."
    },
    {
      "step": 3,
      "text": "Combine the tapioca, salt, sugar, pitted cherries, almond extract, and vanilla extract. Let the mixture stand for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Spoon the cherry mixture into the pastry shell and dot it with the butter."
    },
    {
      "step": 5,
      "text": "Cover with the remaining pastry, trim and seal the edges, and cut vents in the top crust."
    },
    {
      "step": 6,
      "text": "Bake for 50 minutes, until the crust is golden brown and the filling is bubbling.",
      "timer_minutes": 50
    },
    {
      "step": 7,
      "text": "Cool the pie completely before slicing."
    }
  ],
