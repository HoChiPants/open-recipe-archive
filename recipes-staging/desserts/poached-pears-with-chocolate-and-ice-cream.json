  "id": "poached-pears-with-chocolate-and-ice-cream",
  "name": "Poached Pears with Chocolate and Ice Cream",
  "subtitle": "Tender pears in citrus-vanilla syrup with chocolate and ice cream",
  "description": "Pears are gently poached in a lemon-vanilla sugar syrup, chilled, and served with hot fudge and vanilla ice cream.",
  "meal_type": "dessert",
  "cuisine": "French",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
