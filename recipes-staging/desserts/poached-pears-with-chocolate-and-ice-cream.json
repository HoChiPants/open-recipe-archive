    },
    {
      "ingredient_id": "vanilla-ice-cream",
      "item": "vanilla ice cream",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, lemon zest and juice, vanilla bean, and sugar in a saucepan. Bring the syrup to a simmer, stirring until the sugar dissolves."
    },
    {
      "step": 2,
      "text": "Add the pears and keep them partially submerged in the simmering syrup. Cook until tender when pierced, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Remove the pears and vanilla bean, then chill the pears in the syrup until cold."
    },
    {
      "step": 4,
      "text": "Warm the hot fudge topping. Serve each pear with vanilla ice cream and hot fudge."
    }
  ],
