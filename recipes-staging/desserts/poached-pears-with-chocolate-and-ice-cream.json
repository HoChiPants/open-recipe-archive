    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1,
      "preparation": "zested and juiced"
    },
    {
      "ingredient_id": "bosc-pears",
      "item": "Bosc pears",
      "quantity": 4,
      "preparation": "cored, peeled, stems left on"
    },
    {
