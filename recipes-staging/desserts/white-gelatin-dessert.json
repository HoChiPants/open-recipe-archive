  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "white-gelatin-dessert",
  "name": "White Gelatin Dessert",
  "subtitle": "A chilled, creamy gelatin dessert with lemon and vanilla.",
  "description": "Sweetened cream cheese, milk, and gelatin form a smooth chilled dessert folded with whipped topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "25-ounce-envelope-unflavored-gelatin",
      "item": "(.25 ounce) envelope unflavored gelatin",
      "quantity": 1
    },
    {
      "ingredient_id": "boiling-water",
      "item": "boiling water",
      "quantity": 0.33333331346512,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "frozen-whipped-topping",
      "item": "frozen whipped topping",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "thawed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened cream cheese and sugar until smooth."
    },
    {
      "step": 2,
      "text": "Whisk the gelatin into the boiling water until dissolved."
    },
    {
      "step": 3,
      "text": "Whisk the milk, lemon juice, and vanilla into the cream cheese mixture, then blend in the dissolved gelatin."
    },
    {
      "step": 4,
      "text": "Fold in the thawed whipped topping until evenly combined."
    },
    {
      "step": 5,
      "text": "Transfer to a serving dish and refrigerate until set, about 3 hours.",
      "timer_minutes": 180
    }
  ],
