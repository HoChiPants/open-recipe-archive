  "name": "Pie Crust",
  "subtitle": "Tender, lightly crisp pastry for sweet or savory fillings",
  "description": "Mix a simple flour-and-shortening dough with beaten egg, vinegar, and water, then shape and bake until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
