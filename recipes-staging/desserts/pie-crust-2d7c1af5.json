    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 4,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Stir the flour and salt together. Cut in the shortening until the mixture is crumbly."
    },
    {
      "step": 3,
      "text": "Combine the beaten egg, vinegar, and water, then add the mixture to the dry ingredients and form a dough."
    },
    {
      "step": 4,
      "text": "Shape the dough into pie crusts as needed."
    },
    {
      "step": 5,
      "text": "Bake until the crust is set and lightly golden, about 12 minutes. Because the dough contains egg, verify it reaches 160°F if measured.",
      "timer_minutes": 12
    }
  ],
