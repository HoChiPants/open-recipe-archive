  "id": "classic-rice-pudding",
  "name": "Classic Rice Pudding",
  "subtitle": "Creamy rice pudding with cherries and cinnamon",
  "description": "A gently cooked rice pudding finished with vanilla, cinnamon, dried cherries, and butter, then chilled until cold.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
