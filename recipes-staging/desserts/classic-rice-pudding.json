  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, rice, and salt in a saucepan. Bring to a simmer, cover, and cook until the rice is tender, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Stir in the milk and sugar. Cook gently, stirring often, until the mixture thickens, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Remove from the heat and stir in the vanilla and cinnamon."
    },
    {
      "step": 4,
      "text": "Whisk the egg yolk in a bowl. Gradually whisk in some of the hot pudding, then return the mixture to the saucepan and cook gently, stirring, until it reaches 160°F and the center is fully set.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Stir in the cherries and butter. Transfer the pudding to a serving dish, cool, and chill until cold.",
      "timer_minutes": 240
    }
  ],
