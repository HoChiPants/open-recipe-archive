  "id": "rice-pudding-e1405331",
  "name": "Rice Pudding",
  "subtitle": "Creamy cinnamon rice pudding with raisins",
  "description": "A gently spiced rice pudding enriched with sweetened condensed milk and finished with raisins.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "long-grain-rice",
      "item": "long-grain rice",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "2-milk",
      "item": "2% milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 8,
      "unit": "ounces"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 0.75,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the rice and water to an electric pressure cooker. Stir in the milk, vanilla, cinnamon, salt, and sweetened condensed milk."
    },
    {
      "step": 2,
      "text": "Secure the lid and cook under high pressure until the rice is tender and the pudding is set, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Let the pressure release naturally for 15 minutes, then carefully release any remaining pressure and open the cooker.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Stir until the rice and creamy mixture are combined, then fold in the raisins. Serve warm or chill before serving."
    }
  ],
