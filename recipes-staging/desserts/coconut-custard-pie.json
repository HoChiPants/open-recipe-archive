  "id": "coconut-custard-pie",
  "name": "Coconut Custard Pie",
  "subtitle": "A simple blended coconut pie with warm nutmeg",
  "description": "Blend the filling, pour it into a pie dish, and bake until the center is fully set for an easy custard-style dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Blend the milk, coconut, eggs, margarine, sugar, flour, and vanilla extract until evenly combined."
    },
    {
      "step": 3,
      "text": "Pour the mixture into a pie dish and sprinkle the ground nutmeg over the surface."
    },
    {
      "step": 4,
      "text": "Bake for 45 minutes, or until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 45
    }
  ],
