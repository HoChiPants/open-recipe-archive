  "id": "walnut-brownies-133d9ba3",
  "name": "Walnut Brownies",
  "subtitle": "Fudgy cocoa brownies with chopped walnuts",
  "description": "A simple pan of cocoa brownies with a tender center and crisp edges.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Lightly prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the sugar, vegetable oil, vanilla extract, and eggs until combined."
    },
    {
      "step": 3,
      "text": "In a separate bowl, stir together the flour, cocoa powder, baking powder, and salt."
    },
    {
      "step": 4,
      "text": "Add the dry ingredients to the sugar mixture and stir just until incorporated. Fold in the walnuts."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and spread it evenly."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until the center is firm and fully set, or reaches 160°F on a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Cool before cutting into 16 servings."
    }
  ],
