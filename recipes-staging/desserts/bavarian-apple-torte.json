  "id": "bavarian-apple-torte",
  "name": "Bavarian Apple Torte",
  "subtitle": "A crisp apple dessert with a creamy baked filling.",
  "description": "A buttery crust holds sweetened cream cheese, cinnamon-coated apples, and sliced almonds for a layered baked dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 35,
    "inactive_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 1,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "flour",
      "item": "flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "philadelphia-brick-cream-cheese",
      "item": "PHILADELPHIA Brick Cream Cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "250 g, softened"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla",
      "item": "vanilla",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "granny-smith-or-golden-delicious-apples",
      "item": "Granny Smith or Golden Delicious apples",
      "quantity": 4,
      "preparation": "peeled, sliced"
    },
    {
      "ingredient_id": "almonds",
      "item": "almonds",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Beat the butter with part of the sugar until combined. Mix in the flour to form a soft dough."
    },
    {
      "step": 3,
      "text": "Press the dough evenly over the bottom and slightly up the sides of a baking pan."
    },
    {
      "step": 4,
      "text": "Beat the cream cheese with the remaining sugar, then mix in the egg and vanilla until smooth."
    },
    {
      "step": 5,
      "text": "Spread the cream cheese mixture over the crust."
    },
    {
      "step": 6,
      "text": "Combine the cinnamon with the reserved sugar. Toss the sliced apples with this mixture and arrange them over the filling."
    },
    {
      "step": 7,
      "text": "Sprinkle the sliced almonds over the apples."
    },
    {
      "step": 8,
      "text": "Bake at 425°F for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 9,
      "text": "Reduce the oven to 375°F and bake for 25 minutes more, until the center is firm and reaches 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 10,
      "text": "Cool the torte, then cover and chill for 3 hours before slicing.",
      "timer_minutes": 180
    }
  ],
