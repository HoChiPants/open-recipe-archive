{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cherries-jubilee",
  "name": "Cherries Jubilee",
  "subtitle": "Warm citrus-cherry sauce over vanilla ice cream",
  "description": "A quick cherry dessert combines a glossy orange-scented sauce with vanilla ice cream and a touch of brandy.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "orange-juice",
      "item": "orange juice",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "bing-or-other-dark",
      "item": "Bing or other dark",
      "quantity": 1,
      "unit": "pound",
      "preparation": "sweet cherries, rinsed and pitted (or use frozen pitted cherries)"
    },
    {
      "ingredient_id": "finely-grated-orange-zest",
      "item": "finely grated orange zest",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-bean-ice-cream",
      "item": "vanilla bean ice cream",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "cherry-extract",
      "item": "cherry extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "brandy",
      "item": "brandy",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the sugar and cornstarch in a saucepan. Stir in the cold water, orange juice, and orange zest until smooth."
    },
    {
      "step": 2,
      "text": "Cook over medium heat, stirring, until the mixture thickens."
    },
    {
      "step": 3,
      "text": "Add the cherries, cherry extract, and remaining orange juice and zest mixture. Simmer until the cherries are tender and the sauce is glossy.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Remove the pan from the heat and stir in the brandy."
    },
    {
      "step": 5,
      "text": "Scoop the vanilla ice cream into six serving dishes and spoon the warm cherry sauce over it."
    }
  ],
