  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Line a pie plate with one pastry crust."
    },
    {
      "step": 2,
      "text": "Melt the 1/4 cup butter. Stir in the white sugar, 1/2 cup milk, and heavy cream. Whisk the cornstarch with 2 tablespoons milk and the 1 teaspoon vanilla extract, then stir it into the butter mixture. Cook until thickened."
    },
    {
      "step": 3,
      "text": "Toss the sliced apples with flour and cinnamon. Place them in the prepared crust and pour the thickened cream mixture over them."
    },
    {
      "step": 4,
      "text": "Cover with the remaining pastry. Seal and crimp the edge, then cut vents in the top."
    },
    {
      "step": 5,
      "text": "Bake until the crust is golden brown and the filling is set, about 40 minutes. Cool for 30 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Blend the confectioners' sugar, 1 tablespoon milk, softened butter, and 1/4 teaspoon vanilla extract until smooth. Spread the glaze over the cooled pie."
    },
    {
      "step": 7,
      "text": "Chill for 2 hours before serving.",
      "timer_minutes": 120
    }
  ],
