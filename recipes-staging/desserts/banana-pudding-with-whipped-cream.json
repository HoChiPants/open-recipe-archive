  "id": "banana-pudding-with-whipped-cream",
  "name": "Banana Pudding with Whipped Cream",
  "subtitle": "Creamy custard layered with bananas and vanilla wafers",
  "description": "A chilled American dessert of cooked vanilla custard, sliced bananas, crisp wafers, and lightly sweetened whipped cream.",
  "meal_type": "dessert",
