  "instructions": [
    {
      "step": 1,
      "text": "Whisk the milk, white sugar, flour, and salt in a saucepan until combined. In a bowl, whisk the egg yolks until smooth, then gradually whisk in some of the milk mixture."
    },
    {
      "step": 2,
      "text": "Return the yolk mixture to the saucepan and cook over medium heat, whisking constantly, until thick and the custard reaches 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Remove from the heat and stir in the butter and vanilla extract. Let the custard cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Cover the bottom of a serving dish with vanilla wafers, then add bananas and custard. Repeat the layers, finishing with custard, and chill until set.",
      "timer_minutes": 240
    },
    {
      "step": 5,
      "text": "Whisk the heavy cream with the powdered sugar until soft peaks form. Spread the whipped cream over the chilled pudding and serve."
    }
  ],
