{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "plum-cake",
  "name": "Plum Cake",
  "subtitle": "A tender butter cake layered with fresh plums and lemon zest.",
  "description": "A simple fruit cake with a buttery crumb, bright lemon zest, and quartered plums baked until set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "plums",
      "item": "plums",
      "quantity": 1.25,
      "unit": "cups",
      "preparation": "pitted and quartered"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Prepare the all-purpose flour with the baking powder."
    },
    {
      "step": 3,
      "text": "Separate the eggs. Beat the egg whites with the white sugar until stiff peaks form, then set aside."
    },
    {
      "step": 4,
      "text": "Beat the softened butter with the remaining white sugar and lemon zest until smooth. Stir in the flour mixture."
    },
    {
      "step": 5,
      "text": "Fold in the reserved egg whites until just combined, then transfer the batter to a prepared baking pan."
    },
    {
      "step": 6,
      "text": "Arrange the plums over the batter."
    },
    {
      "step": 7,
      "text": "Bake for 40 minutes, until the center is set.",
      "timer_minutes": 40
    },
    {
      "step": 8,
      "text": "Transfer the cake to a rack and let it cool before serving."
    }
  ],
