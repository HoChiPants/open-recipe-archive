  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Stir the all-purpose flour, softened butter, and 0.25 cup white sugar together, then press the mixture evenly into a baking pan."
    },
    {
      "step": 2,
      "text": "Bake the crust for 15 minutes. Remove it from the oven and let it cool.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Reduce the oven temperature to 350°F. Whisk the cream cheese, 0.25 cup white sugar, egg, and vanilla extract until smooth."
    },
    {
      "step": 4,
      "text": "In a separate bowl, whisk the pumpkin puree, evaporated milk, 0.75 cup white sugar, eggs, cinnamon, salt, ginger, and cloves until blended."
    },
    {
      "step": 5,
      "text": "Spread the pumpkin mixture over the cooled crust. Spoon the cheesecake mixture over it and gently swirl the layers together."
    },
    {
      "step": 6,
      "text": "Bake for 60 minutes, until the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Cool, then refrigerate for at least 8 hours before slicing into bars.",
      "timer_minutes": 480
    }
  ],
