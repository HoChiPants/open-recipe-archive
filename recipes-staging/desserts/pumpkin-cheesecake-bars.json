  "id": "pumpkin-cheesecake-bars",
  "name": "Pumpkin Cheesecake Bars",
  "subtitle": "Spiced pumpkin filling over a tender cheesecake crust",
  "description": "Bake a buttery flour crust, add layers of vanilla cheesecake and warmly spiced pumpkin, then chill until firm for clean-cut dessert bars.",
  "meal_type": "dessert",
