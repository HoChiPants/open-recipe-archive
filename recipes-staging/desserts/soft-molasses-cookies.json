  "id": "soft-molasses-cookies",
  "name": "Soft Molasses Cookies",
  "subtitle": "Tender spiced cookies with deep molasses flavor",
  "description": "A simple drop-cookie dough combining molasses, brown sugar, and warm spices for soft, chewy cookies.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "molasses",
      "item": "molasses",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Beat the softened butter and brown sugar until evenly blended. Mix in the egg, then stir in the molasses."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking soda, cinnamon, and ginger together. Add the dry mixture to the wet mixture and stir just until a dough forms."
    },
    {
      "step": 3,
      "text": "Chill the dough until firm. Heat the oven to 350°F and prepare a baking sheet."
    },
    {
      "step": 4,
      "text": "Shape the dough into portions and place them on the prepared sheet with space between each."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, until the cookies are set; for egg safety, confirm the centers reach 160°F or are firm and fully set.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Let the cookies cool on the baking sheet for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
