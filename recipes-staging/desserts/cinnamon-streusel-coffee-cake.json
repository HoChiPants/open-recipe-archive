  "id": "cinnamon-streusel-coffee-cake",
  "name": "Cinnamon Streusel Coffee Cake",
  "subtitle": "Tender cake with a buttery cinnamon crumb",
  "description": "A simple American coffee cake layered with cinnamon streusel and finished with a tender vanilla-scented crumb.",
