  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking pan for the cake."
    },
    {
      "step": 2,
      "text": "For the streusel, combine 0.66666668653488 cup white sugar, 0.25 cup all-purpose flour, and ground cinnamon. Cut in 0.25 cup cold butter until coarse crumbs form; set aside."
    },
    {
      "step": 3,
      "text": "Combine 2 cups all-purpose flour, 0.75 cup white sugar, baking powder, and salt. Cut in 0.5 cup cold butter until the mixture is crumbly."
    },
    {
      "step": 4,
      "text": "Whisk the egg with the milk, adding enough milk as needed for a smooth mixture, then stir in the vanilla extract."
    },
    {
      "step": 5,
      "text": "Transfer the liquid mixture to the dry mixture and stir just until combined. Spread the batter in the prepared pan and add the streusel on top."
    },
    {
      "step": 6,
      "text": "Bake until the cake is set in the center and reaches 160°F when checked with a food thermometer, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Cool before cutting into servings."
    }
  ],
