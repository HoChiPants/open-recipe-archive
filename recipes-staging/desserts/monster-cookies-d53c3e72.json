  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the eggs in a large mixing bowl."
    },
    {
      "step": 3,
      "text": "Add the sugars, vanilla, corn syrup, baking soda, butter, peanut butter, oats, chocolate chips, and candy-coated milk chocolate pieces. Stir until evenly combined."
    },
    {
      "step": 4,
      "text": "Portion the dough onto baking sheets, leaving space between portions."
    },
