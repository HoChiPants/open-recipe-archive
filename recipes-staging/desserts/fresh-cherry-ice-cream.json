  "instructions": [
    {
      "step": 1,
      "text": "Combine the heavy cream, milk, and white sugar. Stir until the sugar dissolves, then mix in the vanilla and almond extracts."
    },
    {
      "step": 2,
      "text": "Add the cherries and whisk the mixture in an ice cream maker for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Transfer the churned ice cream to a freezer-safe container and freeze until firm."
    },
    {
      "step": 4,
      "text": "Serve once firm."
    }
