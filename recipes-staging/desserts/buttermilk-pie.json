  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Shape the dough in a 9-inch pie pan, trim the edge, and fold it under to form a neat rim."
    },
    {
      "step": 2,
      "text": "Transfer the crust to the oven and bake for 15 minutes. Set it aside to cool.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Combine the lemon zest and juice."
    },
    {
      "step": 4,
      "text": "Beat the room-temperature butter and sugar until combined, about 5 minutes. Add the flour and salt, then mix well.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the eggs, one at a time, and whisk until smooth. Mix in the vanilla, nutmeg, lemon mixture, and buttermilk for about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Pour the filling into the cooled crust and bake at 350°F for 55 minutes, until golden brown and the center is fully set.",
      "timer_minutes": 55
    },
    {
      "step": 7,
      "text": "Cool the pie, then chill it for 120 minutes before slicing.",
      "timer_minutes": 120
    }
  ],
