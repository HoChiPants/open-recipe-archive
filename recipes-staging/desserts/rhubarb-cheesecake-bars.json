  "id": "rhubarb-cheesecake-bars",
  "name": "Rhubarb Cheesecake Bars",
  "subtitle": "A tangy rhubarb layer with a creamy cheesecake topping",
  "description": "A buttery baked crust is layered with sweetened rhubarb and cheesecake, then cooled and chilled for clean-cut dessert bars.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
