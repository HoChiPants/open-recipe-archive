  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and butter a suitable baking dish."
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan. Stir in the caster sugar, ground cardamom, pudding rice, milk, and granulated sugar. Bring gently to a simmer."
    },
    {
      "step": 3,
      "text": "Whisk together the double cream, orange zest, vanilla extract, orange juice, and the broad strips of orange zest. Stir this mixture into the rice."
    },
    {
      "step": 4,
      "text": "Simmer the rice mixture for 4 minutes, stirring occasionally.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Pour the mixture into the buttered dish and bake for 120 minutes, until the rice is tender and the pudding is creamy.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "For the syrup, combine the pomegranate juice, pomegranate molasses, honey, granulated sugar, and the reserved orange zest in a saucepan. Simmer for 8 minutes, then set aside.",
      "timer_minutes": 8
    },
    {
      "step": 7,
      "text": "Peel and segment the remaining oranges, removing excess pith. Chill the segments until serving."
    },
    {
      "step": 8,
      "text": "Serve the warm or cooled rice pudding with the orange segments and pomegranate syrup."
    }
  ],
