  "id": "raspberry-jam-sandwich-biscuits",
  "name": "Raspberry Jam Sandwich Biscuits",
  "subtitle": "Buttery cut-out biscuits with a bright raspberry center",
  "description": "Bake crisp shaped biscuits, fill them with seedless raspberry jam, and finish with a light dusting of icing sugar.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "batch-of-universal-dough-see-below",
      "item": "batch of universal dough (see below)",
      "quantity": 1
    },
    {
      "ingredient_id": "plain-flour-to-dust",
      "item": "plain flour to dust"
    },
    {
      "ingredient_id": "seedless-raspberry-jam",
      "item": "seedless raspberry jam",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar-to-dust",
      "item": "icing sugar to dust"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Chill the batch of universal dough for 15 minutes. Preheat the oven according to the dough recipe.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "On a lightly floured surface, roll out the dough. Cut an even number of biscuits, then cut a small opening in the center of half of them. Dust the tops lightly with icing sugar."
    },
    {
      "step": 3,
      "text": "Arrange the biscuits on baking trays and bake for 10 minutes, or until lightly colored.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Cool the biscuits on the trays for 5 minutes, then transfer them to a rack to cool completely.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Spread the raspberry jam over the whole biscuits. Place the cut-out biscuits on top to make sandwiches, then dust with icing sugar."
    }
  ],
