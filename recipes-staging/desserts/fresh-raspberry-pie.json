  "id": "fresh-raspberry-pie",
  "name": "Fresh Raspberry Pie",
  "subtitle": "A bright berry pie with a flaky double crust",
  "description": "Fresh raspberries bake into a lightly thickened, buttery filling beneath a golden pastry crust.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-raspberries",
      "item": "fresh raspberries",
      "quantity": 1,
      "unit": "quart"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 8,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "quick-cooking-tapioca",
      "item": "quick-cooking tapioca",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "recipe-pastry-for-a-9-inch-double-crust-pie",
      "item": "recipe pastry for a 9 inch double crust pie",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Line a 9-inch pie plate with the bottom pastry crust."
    },
    {
      "step": 3,
      "text": "Combine the raspberries, sugar, cornstarch, tapioca, and water, then spoon the mixture into the crust."
    },
    {
      "step": 4,
      "text": "Dot the filling with the butter and cover with the remaining pastry. Seal and crimp the edges, then cut vents in the top."
    },
    {
      "step": 5,
      "text": "Bake at 425°F for 15 minutes. Reduce the oven temperature to 350°F and continue baking for 45 minutes, until the crust is golden and the filling is bubbling.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Cool the pie until the filling is set, then slice and serve."
    }
  ],
