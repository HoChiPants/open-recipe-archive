      "ingredient_id": "chilled-double-cream",
      "item": "chilled double cream",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": "1/2",
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Keep the double cream chilled. Combine it with the sugar and vanilla extract in a mixing bowl."
    },
    {
      "step": 2,
      "text": "Whisk until the cream forms soft peaks; stop before it becomes stiff or grainy."
    },
    {
      "step": 3,
      "text": "Serve immediately, or use as a dessert topping or cake filling."
    }
