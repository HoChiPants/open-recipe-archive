  "id": "chantilly-cream",
  "name": "Chantilly Cream",
  "subtitle": "Light vanilla-sweetened whipped cream",
  "description": "A simple whipped cream flavored with vanilla and golden caster sugar, ready to spoon over desserts or use as a filling.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 300,
    "unit": "ml"
