  "id": "coconut-crunch-cookies",
  "name": "Coconut Crunch Cookies",
  "subtitle": "Chewy cookies with crisp cereal and coconut",
  "description": "A simple coconut cookie combining brown and white sugars with oats and crushed cornflakes for a chewy-crisp texture.",
  "meal_type": "dessert",
