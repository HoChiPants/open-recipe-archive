  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the butter, packed brown sugar, and white sugar until smooth. Add the egg and vanilla extract and mix until incorporated."
    },
    {
      "step": 3,
      "text": "Prepare the all-purpose flour, baking soda, salt, and baking powder together, then stir them into the butter mixture."
    },
    {
      "step": 4,
      "text": "Combine the crushed cornflakes cereal and flaked coconut, then stir them into the dough."
    },
    {
      "step": 5,
      "text": "Prepare portions of dough on baking sheets, leaving space between them."
    },
    {
      "step": 6,
      "text": "Bake for 12 minutes, until the cookies are set and the centers are no longer wet; if checked with a thermometer, the egg-containing centers should reach 160°F.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Cool the cookies before serving."
    }
  ],
