  "id": "italian-butterball-cookies",
  "name": "Italian Butterball Cookies",
  "subtitle": "Tender almond-vanilla cookies finished with confectioners' sugar",
  "description": "Shape a buttery almond-vanilla dough into small rounds, bake until firm and fully set, then coat the cooled cookies in confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "stick"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Whisk the flour, baking powder, and salt together in a bowl."
    },
    {
      "step": 2,
      "text": "Beat the butter and 0.75 cup confectioners' sugar until smooth. Add the egg, vanilla extract, and almond extract; whisk until combined."
    },
    {
      "step": 3,
      "text": "Add the dry ingredients to the butter mixture and stir until a dough forms. Shape the dough into small rounds and arrange them on a baking sheet."
    },
    {
      "step": 4,
      "text": "Bake for 10 minutes, until the cookies are firm and their centers are fully set; verify that the egg-containing centers reach 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Cool the cookies for 10 minutes, then transfer them to the remaining confectioners' sugar and turn to coat.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Let the coated cookies cool completely before serving or storing.",
      "timer_minutes": 30
    }
  ],
