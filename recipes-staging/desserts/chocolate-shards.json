  "id": "chocolate-shards",
  "name": "Chocolate Shards",
  "subtitle": "Three chocolates, melted and set into crisp pieces",
  "description": "A simple layered chocolate confection made by melting three chocolates, spreading them thin, and cutting the set slab into shards.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "dark-chocolate",
      "item": "dark chocolate",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "milk-chocolate",
      "item": "milk chocolate",
      "quantity": 25,
      "unit": "g"
    },
    {
      "ingredient_id": "white-chocolate",
      "item": "white chocolate",
      "quantity": 25,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the dark, milk, and white chocolates in a microwave-safe bowl. Microwave in short bursts, stirring between each, until melted and smooth; avoid overheating."
    },
    {
      "step": 2,
      "text": "Transfer the melted chocolate to a parchment-lined tray."
    },
    {
      "step": 3,
      "text": "Spread it into a thin, even layer and lightly swirl the surface if desired."
    },
    {
      "step": 4,
      "text": "Cool until completely set."
    },
    {
      "step": 5,
      "text": "Cut or break the firm chocolate into shards."
    }
  ],
