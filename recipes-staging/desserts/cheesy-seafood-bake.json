  "instructions": [
    {
      "step": 1,
      "text": "Soak the sliced potatoes in the milk for 10 minutes. Preheat the oven and prepare a grill or broiler.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in an ovenproof pan or baking dish. Cook the onion until softened, then stir in the red pepper and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the balsamic vinegar, bouillon powder, chopped tomatoes, basil, and garlic. Simmer the sauce for 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Nestle the cod, prawns, and broccoli into the sauce. Arrange the milk-coated potato slices over the top and cover with the cheddar."
    },
    {
      "step": 5,
      "text": "Bake until the broccoli is tender and the cod is opaque and flakes easily, reaching 145°F in the thickest part. If needed, finish under the grill or broiler until the cheese is golden."
    }
  ],
