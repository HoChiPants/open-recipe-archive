  "id": "cheesy-seafood-bake",
  "name": "Cheesy Seafood Bake",
  "subtitle": "Cod, prawns, and vegetables under golden cheddar potatoes",
  "description": "A two-serving seafood bake with tomato-pepper sauce, cod, prawns, broccoli, and a crisp cheesy potato topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
