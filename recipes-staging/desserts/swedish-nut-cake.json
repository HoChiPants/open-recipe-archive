  "id": "swedish-nut-cake",
  "name": "Swedish Nut Cake",
  "subtitle": "A pineapple-walnut cake with cream cheese frosting",
  "description": "A moist fruit-and-nut dessert finished with a rich cream cheese topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 24,
