  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the flour and baking soda together. Combine them with the white sugar and confectioners' sugar."
    },
    {
      "step": 3,
      "text": "Add the eggs, 2 teaspoons vanilla extract, and crushed pineapple with its juice. Whisk until smooth, then fold in 0.5 cup chopped walnuts."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared pan and bake at 350°F for 50 minutes, until the center is firm and set.",
      "timer_minutes": 50
    },
    {
      "step": 5,
      "text": "Transfer the cake to a rack and let it cool completely."
    },
    {
      "step": 6,
      "text": "Whisk the cream cheese, butter, confectioners' sugar, and 1 teaspoon vanilla extract until smooth. Fold in the remaining 0.5 cup chopped walnuts."
    },
    {
      "step": 7,
      "text": "Transfer the frosting to the cooled cake and spread it evenly before serving."
    }
  ],
