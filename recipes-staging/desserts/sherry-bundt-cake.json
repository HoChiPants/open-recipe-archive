      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a Bundt pan for baking."
    },
    {
      "step": 2,
      "text": "Mix the white sugar, ground cinnamon, and unsweetened cocoa powder until evenly combined."
    },
    {
      "step": 3,
      "text": "Combine the yellow cake mix, vegetable oil, cream sherry, eggs, instant vanilla pudding mix, and ground nutmeg. Beat until smooth."
    },
    {
      "step": 4,
      "text": "Pour about half the batter into the pan. Sprinkle with part of the cinnamon-cocoa sugar, add the remaining batter, and finish with the remaining cinnamon-cocoa sugar."
    },
    {
      "step": 5,
      "text": "Bake at 350°F for 45 minutes, until the cake is set and a tester comes out clean.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Cool in the pan for 10 minutes, then turn out and serve.",
      "timer_minutes": 10
    }
  ],
