  "id": "sherry-bundt-cake",
  "name": "Sherry Bundt Cake",
  "subtitle": "A tender spiced cake with a cinnamon-cocoa swirl",
  "description": "A simple Bundt cake combining sherry, vanilla pudding mix, and warm spices for a moist, aromatic dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
