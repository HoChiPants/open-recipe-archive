  "id": "bread-pudding-0c4053d1",
  "name": "Bread Pudding",
  "subtitle": "Cinnamon-raisin pudding with a softly set custard center",
  "description": "Cubed bread, raisins, and warm spiced custard bake into a tender, lightly crisp dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
