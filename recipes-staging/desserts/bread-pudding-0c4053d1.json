  },
  "ingredients": [
    {
      "ingredient_id": "slices-white-bread",
      "item": "slices white bread",
      "quantity": 10,
      "preparation": "cut into cubes"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 0.5,
