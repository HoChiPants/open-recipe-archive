  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Toss the bread cubes and raisins with the melted margarine and cinnamon, then transfer to a baking dish."
    },
    {
      "step": 3,
      "text": "Whisk the eggs with the sugar, vanilla, and salt. Gradually whisk in the hot milk."
    },
    {
      "step": 4,
      "text": "Pour the custard over the bread mixture, sprinkle with nutmeg, and let stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
