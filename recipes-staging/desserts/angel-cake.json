{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "angel-cake",
  "name": "Angel Cake",
  "subtitle": "A light, colorful sponge with vanilla buttercream",
  "description": "Bake a softly tinted sponge, fill it with vanilla buttercream, and finish with pink fondant decoration.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-plus-extra-for-the-tin",
      "item": "unsalted butter plus extra for the tin",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "plain-flour-sieved",
      "item": "plain flour sieved",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "a-drop-each-of-pink-and-yellow-food-colouring",
      "item": "a drop each of pink and yellow food colouring"
    },
    {
      "ingredient_id": "a-drop-each-of-lemon-and-raspberry-extract",
      "item": "a drop each of lemon and raspberry extract"
    },
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-paste",
      "item": "vanilla paste",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": "1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "fondant-icing-sugar",
      "item": "fondant icing sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "pink-food-colouring",
      "item": "pink food colouring"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease the cake tin with some of the unsalted butter."
    },
    {
      "step": 2,
      "text": "Melt the remaining 50 g unsalted butter and set it aside to cool slightly."
    },
    {
      "step": 3,
      "text": "Whisk the caster sugar and eggs until thick and pale.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Fold in the plain flour sieved, then gently fold in the melted butter."
    },
    {
      "step": 5,
      "text": "Divide the batter and flavor and tint the portions with the lemon and raspberry extract and the pink and yellow food colouring."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared tin and bake until cooked through and set in the center.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Cool the cake completely before cutting or decorating."
    },
    {
      "step": 8,
      "text": "Whisk the softened butter, icing sugar, vanilla paste, and milk until smooth and light.",
      "timer_minutes": 5
    },
    {
      "step": 9,
      "text": "Cut the cooled cake as needed and spread with the buttercream."
    },
    {
      "step": 10,
      "text": "Combine the fondant icing sugar with pink food colouring and work it into a thick icing."
    },
    {
      "step": 11,
      "text": "Transfer and shape the pink icing over the cake, then add the remaining decoration and leave it set before serving."
    }
  ],
