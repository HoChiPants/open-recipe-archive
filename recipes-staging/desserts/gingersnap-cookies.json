  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the sifted flour, ground ginger, baking soda, ground cinnamon, and salt in a bowl."
    },
    {
      "step": 3,
      "text": "Whisk the shortening and white sugar until smooth. Whisk in the egg and dark molasses."
    },
    {
      "step": 4,
      "text": "Stir the dry ingredients into the molasses mixture until a combined dough forms."
    },
    {
      "step": 5,
      "text": "Shape the dough into small balls and roll each in the cinnamon sugar."
    },
    {
      "step": 6,
      "text": "Arrange the coated dough balls on baking sheets and bake for 10 minutes, until the edges are set and the centers are no longer wet.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Cool the cookies before serving."
    }
  ],
