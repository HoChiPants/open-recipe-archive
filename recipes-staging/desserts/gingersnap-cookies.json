  "id": "gingersnap-cookies",
  "name": "Gingersnap Cookies",
  "subtitle": "Crisp, warmly spiced cookies with molasses flavor",
  "description": "Roll spiced molasses dough in cinnamon sugar and bake until set for crisp-edged gingersnap cookies.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 60,
    "unit": "cookies"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cinnamon-sugar",
      "item": "cinnamon sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
