  "id": "hurricane-cake",
  "name": "Hurricane Cake",
  "subtitle": "Layered chocolate cake with coconut, pecans, and cream cheese topping",
  "description": "A rich chocolate cake baked over a buttery coconut-pecan layer and finished with a smooth cream cheese topping.",
  "meal_type": "dessert",
  "cuisine": "American",
