  "id": "peach-crisp-with-canned-peaches",
  "name": "Peach Crisp with Canned Peaches",
  "subtitle": "A warm fruit dessert with a cinnamon-butter crumble topping.",
  "description": "Drained peaches are topped with a simple cinnamon crumble and baked until golden brown.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "peaches",
      "item": "peaches",
      "quantity": 1,
      "unit": "can",
      "preparation": "29 ounce, sliced, drained"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chilled"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Arrange the drained peaches in a baking dish."
    },
    {
      "step": 3,
      "text": "Combine the flour, sugar, cinnamon, and salt. Work in the chilled butter until the mixture forms a coarse crumble."
    },
    {
      "step": 4,
      "text": "Scatter the crumble evenly over the peaches."
    },
    {
      "step": 5,
      "text": "Bake for 40 minutes, until golden brown.",
      "timer_minutes": 40
    }
  ],
