      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "bicarbonate-of-soda",
      "item": "bicarbonate of soda",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "icing-to-decorate-optional",
      "item": "icing to decorate (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the salted butter, muscovado sugar, and golden syrup together, stirring until smooth. Remove from the heat and cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Mix the plain flour, bicarbonate of soda, ground ginger, and cinnamon in a bowl."
    },
    {
      "step": 3,
      "text": "Add the cooled butter mixture and milk to the dry ingredients. Knead briefly until a smooth dough forms."
    },
    {
      "step": 4,
      "text": "Chill the dough for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Preheat the air fryer according to its instructions. Roll out the dough and cut into 16 portions or shapes."
    },
    {
      "step": 6,
      "text": "Arrange the pieces in the air-fryer basket in a single layer, working in batches if needed."
    },
    {
      "step": 7,
      "text": "Air-fry for 8 minutes, or until set and lightly browned. Cool until firm.",
      "timer_minutes": 8
    },
    {
      "step": 8,
      "text": "Decorate with optional icing before serving."
    }
  ],
