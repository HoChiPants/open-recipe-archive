  "id": "air-fryer-gingerbread",
  "name": "Air Fryer Gingerbread",
  "subtitle": "Spiced gingerbread baked in small batches",
  "description": "A crisp-edged, warmly spiced gingerbread made with muscovado sugar and golden syrup, then finished with optional icing.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 8
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "salted butter",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-muscovado-sugar",
      "item": "dark muscovado sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
