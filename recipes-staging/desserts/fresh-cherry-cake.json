  "id": "fresh-cherry-cake",
  "name": "Fresh Cherry Cake",
  "subtitle": "A tender cake layered with halved cherries and cherry juice.",
  "description": "A simple American dessert combining a thick vanilla batter with juicy cherries and a sugared finish.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "and-pitted-cherries",
      "item": "and pitted cherries",
      "quantity": 4,
      "unit": "cups",
      "preparation": "halved"
    },
    {
      "ingredient_id": "cherry-juice",
      "item": "cherry juice",
      "quantity": 1.25,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, and salt together."
    },
    {
      "step": 3,
      "text": "Beat the butter with part of the divided sugar for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the milk and vanilla extract."
    },
    {
      "step": 5,
      "text": "Gradually combine the flour mixture with the wet mixture, stirring for 3 minutes until thick.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Transfer the batter to a baking pan. Add the halved cherries and cherry juice, then scatter the remaining sugar over the top."
    },
    {
      "step": 7,
      "text": "Bake at 375°F for 45 minutes, until the cake is set in the center.",
      "timer_minutes": 45
    }
  ],
