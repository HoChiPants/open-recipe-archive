      "item": "water",
      "quantity": 4,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking pan for the brownies."
    },
    {
      "step": 2,
      "text": "Combine the white sugar, flour, baking cocoa, salt, baking powder, and confectioners' sugar."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, light corn syrup, and vanilla extract together, then stir in the vegetable oil."
    },
    {
      "step": 4,
      "text": "Add the wet mixture to the dry ingredients and stir until combined. Fold in the chopped walnuts."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 30 minutes, until the center is set.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Combine the confectioners' sugar and water to make a glaze. Spread it over the brownies after baking."
    }
  ],
