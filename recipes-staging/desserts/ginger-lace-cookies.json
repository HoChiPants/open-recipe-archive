  "id": "ginger-lace-cookies",
  "name": "Ginger Lace Cookies",
  "subtitle": "Thin, crisp-spiced cookies with molasses",
  "description": "Sweet molasses cookies rolled in sugar before baking until set and lightly browned.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 60,
    "unit": "servings"
  },
