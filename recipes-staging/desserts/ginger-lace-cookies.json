  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk 2 cups sugar, shortening, and molasses until combined. Add the eggs and whisk until smooth."
    },
    {
      "step": 3,
      "text": "Whisk together the flour, baking soda, cinnamon, ginger, and salt, then gradually combine with the molasses mixture to form a dough."
    },
    {
      "step": 4,
      "text": "Transfer the 2 tablespoons sugar to a shallow dish. Shape the dough into small portions, roll each in the sugar, and place on a baking sheet."
    },
    {
      "step": 5,
      "text": "Bake until the cookies are set and lightly browned, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 6,
      "text": "Cool the cookies on the baking sheet for 5 minutes, then transfer them to a rack to cool completely.",
      "timer_minutes": 5
    }
  ],
