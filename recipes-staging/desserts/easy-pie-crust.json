  "id": "easy-pie-crust",
  "name": "Easy Pie Crust",
  "subtitle": "A simple oil-based crust for one pie",
  "description": "Mix a lightly sweetened dough, press it into a pie plate, and bake until golden brown.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly prepare a pie plate and preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Combine the flour, vegetable oil, milk, sugar, and salt in a bowl; stir until a cohesive dough forms."
    },
    {
      "step": 3,
      "text": "Press the dough evenly into the prepared pie plate."
    },
    {
      "step": 4,
      "text": "Bake for 15 minutes, or until golden brown.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Use the crust as directed in the pie recipe, or cool before filling."
    }
  ],
