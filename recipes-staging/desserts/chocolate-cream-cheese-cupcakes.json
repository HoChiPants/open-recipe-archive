  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare 24 cupcake wells for baking."
    },
    {
      "step": 2,
      "text": "Whisk the softened cream cheese with 0.33333334326744 cup white sugar and 0.125 teaspoon salt. Whisk in the egg, then stir in the miniature semisweet chocolate chips."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the all-purpose flour, 1 cup white sugar, unsweetened cocoa powder, baking soda, and 0.5 teaspoon salt."
    },
    {
      "step": 4,
      "text": "Add the water, vegetable oil, cider vinegar, and vanilla extract to the dry mixture. Stir just until the batter is evenly combined."
    },
    {
      "step": 5,
      "text": "Divide the cocoa batter among the prepared wells and portion the cream cheese mixture over each one."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until the centers are firm and the egg-containing filling reaches 160°F.",
      "timer_minutes": 30
    }
  ],
