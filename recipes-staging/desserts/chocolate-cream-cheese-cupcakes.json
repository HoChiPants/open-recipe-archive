  "id": "chocolate-cream-cheese-cupcakes",
  "name": "Chocolate-Cream Cheese Cupcakes",
  "subtitle": "Cocoa cupcakes with a chocolate-chip cream cheese center",
  "description": "Tender cocoa cupcakes are filled with a lightly sweetened cream cheese mixture and miniature semisweet chocolate chips, then baked until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
