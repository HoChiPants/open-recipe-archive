  "id": "rhubarb-crisp",
  "name": "Rhubarb Crisp",
  "subtitle": "Tender spiced rhubarb beneath a buttery oat topping",
  "description": "A simple baked fruit dessert with tart rhubarb, warm spices, and a crisp brown-sugar oat topping.",
  "meal_type": "dessert",
