  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the diced rhubarb with the white sugar, 1 tablespoon flour, water, cinnamon, allspice, and half of the packed brown sugar. Transfer the mixture to a baking dish."
    },
    {
      "step": 3,
      "text": "Mix the rolled oats, remaining packed brown sugar, and ½ cup flour. Work in the butter until coarse crumbs form, then scatter the topping over the rhubarb."
    },
    {
      "step": 4,
      "text": "Bake for 45 minutes, until the rhubarb is tender and the topping is browned and set.",
      "timer_minutes": 45
    }
  ],
