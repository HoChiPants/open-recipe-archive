  "instructions": [
    {
      "step": 1,
      "text": "Place the butter, cocoa powder, sugar, and evaporated milk in a saucepan and heat, stirring until combined."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a simmer and cook for 7 minutes, stirring frequently.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Remove from the heat and stir in the vanilla extract."
    },
    {
      "step": 4,
      "text": "Blend or beat until smooth and glossy.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
