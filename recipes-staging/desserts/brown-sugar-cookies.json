  "id": "brown-sugar-cookies",
  "name": "Brown Sugar Cookies",
  "subtitle": "Tender cookies with a rich brown-sugar flavor",
  "description": "A simple American cookie made with softened butter, brown sugar, and a light confectioners’ sugar finish.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 60,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the brown sugar, softened unsalted butter, eggs, vanilla extract, and confectioners' sugar until smooth."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk together the all-purpose flour, baking powder, and salt."
    },
    {
      "step": 4,
      "text": "Stir the dry mixture into the sugar mixture until combined. Chill the dough for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Shape the dough into cookies and arrange them for baking."
    },
    {
      "step": 6,
      "text": "Bake until lightly browned, about 14 minutes.",
      "timer_minutes": 14
    },
    {
      "step": 7,
      "text": "Cool the cookies for 2 minutes before serving.",
      "timer_minutes": 2
    }
  ],
