  "id": "five-ingredient-chocolate-chip-cookies",
  "name": "Five-Ingredient Chocolate Chip Cookies",
  "subtitle": "Simple drop cookies with a soft, chocolate-studded crumb.",
  "description": "An easy batch of classic chocolate chip cookies made from five pantry basics.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "semi-sweet-chocolate-chips",
      "item": "semi-sweet chocolate chips",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare baking sheets."
    },
    {
      "step": 2,
      "text": "Whisk the brown sugar and softened butter until smooth. Whisk in the eggs."
    },
    {
      "step": 3,
      "text": "Stir in the all-purpose flour just until combined, then fold in the semi-sweet chocolate chips."
    },
    {
      "step": 4,
      "text": "Portion the dough onto the prepared baking sheets."
    },
    {
      "step": 5,
      "text": "Bake until golden brown with firm, fully set centers.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Let the cookies cool before serving."
    }
  ],
