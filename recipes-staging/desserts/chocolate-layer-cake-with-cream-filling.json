  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Grease and flour a cake pan using the all-purpose flour."
    },
    {
      "step": 2,
      "text": "Combine the devil's food cake mix and instant chocolate pudding mix. Add 1.25 cups water, the eggs, and vegetable oil; mix until smooth."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and bake until set, about 50 minutes.",
      "timer_minutes": 50
    },
    {
      "step": 4,
      "text": "Cool the cake completely, then cut it horizontally into two thick layers."
    },
    {
      "step": 5,
      "text": "For the filling, heat the milk and remaining flour in a saucepan, stirring until thickened. Cool until set."
    },
    {
      "step": 6,
      "text": "Whisk the white sugar, shortening, butter, vanilla extract, and light corn syrup until smooth. Whisk in the cooled milk mixture."
    },
    {
      "step": 7,
      "text": "Spread the filling over one cake layer, place the second layer on top, and smooth the edges."
    },
    {
      "step": 8,
      "text": "Combine the chocolate chips, remaining shortening, light corn syrup, and 2.25 tablespoons water. Heat gently, stirring until melted and smooth."
    },
    {
      "step": 9,
      "text": "Transfer the glaze to the cake and spread it evenly over the top. Chill before slicing.",
      "timer_minutes": 60
    }
  ],
