  "id": "chocolate-layer-cake-with-cream-filling",
  "name": "Chocolate Layer Cake with Cream Filling",
  "subtitle": "A rich chocolate cake with a soft vanilla filling and glossy chocolate topping.",
  "description": "Bake a chocolate cake, split it for a creamy cooked filling, then finish it with a simple chocolate glaze.",
  "meal_type": "dessert",
