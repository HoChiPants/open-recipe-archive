  "id": "fresh-strawberry-pie",
  "name": "Fresh Strawberry Pie",
  "subtitle": "A buttery crust filled with sweet, lightly spiced strawberries.",
  "description": "Fresh strawberries bake in a thickened filling beneath a buttery nutmeg topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "recipe-pastry-for-a-9-inch-single-crust-pie",
      "item": "recipe pastry for a 9 inch single crust pie",
      "quantity": 1
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 4,
      "unit": "cups",
      "preparation": "hulled"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Fit the pastry into a 9-inch pie dish and prepare the crust for filling."
    },
    {
      "step": 2,
      "text": "Divide the sugar and flour between the filling and topping. Combine one portion with the cornstarch, then toss with the strawberries."
    },
    {
      "step": 3,
      "text": "Combine the remaining sugar and flour with the butter and nutmeg until crumbly."
    },
    {
      "step": 4,
      "text": "Fill the pastry with the strawberry mixture and scatter the topping over it. Add the butter mixture evenly across the surface."
    },
    {
      "step": 5,
      "text": "Bake at 400°F for 10 minutes, then reduce the oven to 375°F and bake for 50 minutes, until the filling is set and the crust is browned.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool the pie before slicing."
    }
  ],
