      "item": "milk chocolate chips",
      "quantity": 100,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and grease a suitable baking tin with some of the butter."
    },
    {
      "step": 2,
      "text": "Combine the cubed butter and dark chocolate in a microwave-safe bowl. Heat in short intervals, stirring between each, until melted and smooth."
    },
    {
      "step": 3,
      "text": "Let the melted chocolate mixture cool slightly."
    },
    {
      "step": 4,
      "text": "Whisk the eggs, caster sugar, and grated courgette until thick. Mix in the flour and cocoa powder, then fold in the cooled chocolate mixture and milk chocolate chips."
    },
    {
      "step": 5,
      "text": "Spread the batter evenly in the prepared tin and bake until set in the center.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Cool completely before cutting into squares.",
      "timer_minutes": 60
    }
  ],
