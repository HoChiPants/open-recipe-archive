      "item": "cocoa powder",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-chocolate-broken-into-pieces",
      "item": "dark chocolate broken into pieces",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "courgette-about-300g",
      "item": "courgette (about 300g)",
      "quantity": 1,
      "preparation": "grated"
    },
