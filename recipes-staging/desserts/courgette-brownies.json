  "id": "courgette-brownies",
  "name": "Courgette Brownies",
  "subtitle": "Fudgy chocolate brownies with grated courgette",
  "description": "Rich chocolate brownies studded with milk chocolate chips and moistened with grated courgette.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-cut-into-cubes",
      "item": "unsalted butter cut into cubes",
      "quantity": 200,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 120,
      "unit": "g"
    },
    {
