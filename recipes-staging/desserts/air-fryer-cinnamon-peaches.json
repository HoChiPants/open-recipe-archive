  "schema_version": "1.0.0",
  "id": "air-fryer-cinnamon-peaches",
  "name": "Air Fryer Cinnamon Peaches",
  "subtitle": "Warm caramelized peaches served with vanilla ice cream",
  "description": "Tender air-fried peach halves with a quick cinnamon-butter topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "firm-peach",
      "item": "firm peach",
      "quantity": 1,
      "unit": "medium",
      "preparation": "halved and pitted"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "light-brown-sugar",
      "item": "light brown sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "scoops-vanilla-ice-cream",
      "item": "scoops vanilla ice cream",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to 350°F."
    },
    {
      "step": 2,
      "text": "Arrange the peach halves cut-side up in the air-fryer basket. Cook until softened and lightly browned, about 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Melt the unsalted butter in a microwave-safe bowl. Stir in the light brown sugar and ground cinnamon, then microwave briefly until the sugar begins to dissolve."
    },
    {
      "step": 4,
      "text": "Brush the peach halves with the cinnamon butter and air-fry until tender and glazed, about 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Let the peaches cool for 5 minutes, then serve with the scoops vanilla ice cream.",
      "timer_minutes": 5
    }
  ],
