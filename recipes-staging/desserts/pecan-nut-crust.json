{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pecan-nut-crust",
  "name": "Pecan Nut Crust",
  "subtitle": "A crisp, buttery crust with toasted pecan flavor",
  "description": "A simple pecan-based crust for pies and other desserts, chilled before baking until lightly browned.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "ground-pecans",
      "item": "ground pecans",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33329999446869,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the ground pecans, cinnamon, and sugar together in a bowl."
    },
    {
      "step": 2,
      "text": "Add the melted butter and mix until the crumbs are evenly moistened."
    },
    {
      "step": 3,
      "text": "Press the mixture firmly and evenly into the intended pie dish or crust pan."
    },
    {
      "step": 4,
      "text": "Chill the formed crust for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Transfer the chilled crust to a 350°F oven and bake for 15 minutes, until lightly browned.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Let the crust cool before filling or serving."
    }
  ],
