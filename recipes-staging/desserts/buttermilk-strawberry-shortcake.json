  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, baking soda, white sugar, salt, and turbinado sugar together. Cut in the chilled butter until the mixture is crumbly."
    },
    {
      "step": 3,
      "text": "Stir in the buttermilk just until a dough forms. Portion the dough onto a baking sheet, brush with heavy cream, and sprinkle with turbinado sugar."
    },
    {
      "step": 4,
      "text": "Bake until golden brown, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Combine the sliced strawberries, white sugar, and lemon juice. Let stand for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Split the shortcakes and serve with the strawberries."
    }
  ],
