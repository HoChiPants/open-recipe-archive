  "id": "buttermilk-strawberry-shortcake",
  "name": "Buttermilk Strawberry Shortcake",
  "subtitle": "Tender biscuits layered with lemony strawberries",
  "description": "Bake simple buttermilk shortcakes, then fill them with sugared strawberries for a fresh fruit dessert.",
