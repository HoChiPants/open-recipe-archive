  "id": "oatmeal-date-cookies",
  "name": "Oatmeal Date Cookies",
  "subtitle": "Chewy oat cookies with dates and walnuts",
  "description": "A warmly spiced-by-nature oatmeal cookie filled with chopped dates and walnuts, with crisp edges and a tender center.",
  "meal_type": "dessert",
