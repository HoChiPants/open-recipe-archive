  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine the flour, baking powder, baking soda, and salt in a bowl; set aside."
    },
    {
      "step": 3,
      "text": "Whisk the brown sugar, shortening, and white sugar until smooth."
    },
    {
      "step": 4,
      "text": "Add the eggs one at a time, then blend in the vanilla extract."
    },
    {
      "step": 5,
      "text": "Add the dry mixture and stir until combined. Fold in the oats, dates, and walnuts."
    },
    {
      "step": 6,
      "text": "Prepare a baking sheet and portion the dough into 24 cookies."
    },
    {
      "step": 7,
      "text": "Bake for 8 minutes, until lightly browned.",
      "timer_minutes": 8
    },
    {
      "step": 8,
      "text": "Cool the cookies before serving."
    }
  ],
