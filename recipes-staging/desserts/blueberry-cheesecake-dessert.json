  "id": "blueberry-cheesecake-dessert",
  "name": "Blueberry Cheesecake Dessert",
  "subtitle": "A chilled cheesecake dessert with a graham cracker base and blueberry topping.",
  "description": "A baked cream cheese layer rests on a buttery graham cracker crust, then cools beneath blueberry filling and whipped topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 28,
    "unit": "servings"
  },
