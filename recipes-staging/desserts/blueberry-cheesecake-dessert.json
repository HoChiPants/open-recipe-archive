      "quantity": 4
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "blueberry-pie-filling",
      "item": "blueberry pie filling",
      "quantity": 2,
      "unit": "can",
      "preparation": "21 ounce"
    },
    {
      "ingredient_id": "frozen-whipped-topping",
      "item": "frozen whipped topping",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce, thawed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Prepare the butter, then combine it with the white sugar and crushed graham crackers. Press the mixture into a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the eggs. In a separate bowl, beat the cream cheese, white sugar, vanilla extract, and eggs until smooth."
    },
    {
      "step": 3,
      "text": "Transfer the cream cheese mixture to the crust and spread the blueberry pie filling over the top."
    },
    {
      "step": 4,
      "text": "Bake until the center is fully set, about 20 minutes. For food safety, verify the egg-containing center reaches 160°F.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Cool the dessert completely, then add the remaining blueberry pie filling and spread the thawed whipped topping over it."
    },
    {
      "step": 6,
      "text": "Chill for at least 60 minutes before slicing and serving.",
      "timer_minutes": 60
    }
  ],
