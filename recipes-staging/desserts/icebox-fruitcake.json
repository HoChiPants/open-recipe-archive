  "id": "icebox-fruitcake",
  "name": "Icebox Fruitcake",
  "subtitle": "A no-bake fruit-and-nut confection with a vanilla-wafer crumb",
  "description": "Chopped fruit and nuts combine with sweetened condensed milk and crushed vanilla wafers to make a compact, sliceable dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "4-ounce-jar-maraschino-cherries",
      "item": "(4 ounce) jar maraschino cherries",
      "quantity": 1,
      "preparation": "drained and chopped"
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "vanilla-wafers",
      "item": "vanilla wafers",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 ounce, crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the pecans, walnuts, raisins, cherries, and crushed vanilla wafers in a large bowl."
    },
    {
      "step": 2,
      "text": "Add the sweetened condensed milk and stir until the mixture is thick and evenly bound."
    },
    {
      "step": 3,
      "text": "Shape the mixture into a compact loaf or several small logs."
    },
    {
      "step": 4,
      "text": "Wrap or place the shaped fruitcake in a lined container and let it stand until firm enough to slice."
    },
    {
      "step": 5,
      "text": "Cut into portions and serve."
    }
  ],
