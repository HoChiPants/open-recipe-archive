  "id": "kourabiedes",
  "name": "Kourabiedes",
  "subtitle": "Greek almond butter cookies dusted with sugar",
  "description": "Tender butter cookies flavored with brandy, vanilla, almonds, and cloves, finished with confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "Greek",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-yolk",
      "item": "egg yolk",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "brandy",
      "item": "brandy",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "finely-chopped-blanched-almonds",
      "item": "finely chopped blanched almonds",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cloves",
      "item": "cloves",
      "quantity": 36,
      "unit": "whole"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sifted flour and baking powder in a bowl."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter until smooth, then whisk in 0.25 cup confectioners' sugar."
    },
    {
      "step": 3,
      "text": "Add the egg yolk, brandy, and vanilla; whisk until combined."
    },
    {
      "step": 4,
      "text": "Stir in the almonds, then blend in the flour mixture until a smooth dough forms."
    },
    {
      "step": 5,
      "text": "Chill the dough for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Preheat the oven to 325°F and prepare a baking sheet."
    },
    {
      "step": 7,
      "text": "Shape the dough into 36 portions, place them on the baking sheet, and press one clove into each."
    },
    {
      "step": 8,
      "text": "Bake for 30 minutes, until the cookies are set and the centers reach 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 9,
      "text": "Cool the cookies, then coat them with confectioners' sugar as needed."
    }
  ],
