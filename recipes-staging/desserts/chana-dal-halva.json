  "id": "chana-dal-halva",
  "name": "Chana Dal Halva",
  "subtitle": "A fragrant Indian sweet with cardamom, saffron, and nuts",
  "description": "Soaked chana dal is blended, cooked with spiced milk and sugar, then cooled and shaped into a rich, sliceable halva.",
  "meal_type": "dessert",
  "cuisine": "Indian",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "chana-daal-soaked-overnight",
      "item": "chana daal soaked overnight",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "whole-milk-or-use-soya-or-almond-milk",
      "item": "whole milk (or use soya or almond milk)",
      "quantity": 750,
      "unit": "ml"
    },
    {
      "ingredient_id": "ghee-or-1-tbsp-unsalted-butter-and-1-tbsp-sunflower-oil",
      "item": "ghee or 1 tbsp unsalted butter and 1 tbsp sunflower oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "green-cardamom-pods-lightly-crushed",
      "item": "green cardamom pods lightly crushed",
      "quantity": 6
    },
    {
      "ingredient_id": "6-cloves",
      "item": "6 cloves",
      "quantity": 6,
      "unit": "cloves"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 340,
      "unit": "g"
    },
    {
      "ingredient_id": "pinch-of-saffron",
      "item": "pinch of saffron",
      "unit": "small"
    },
    {
      "ingredient_id": "pistachios",
      "item": "pistachios",
      "quantity": 2,
      "unit": "tbsp",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "almonds",
      "item": "almonds",
      "quantity": 2,
      "unit": "tbsp",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Drain the soaked chana daal thoroughly and transfer it to a blender or food processor. Blend with enough of the milk to make a smooth paste."
    },
    {
      "step": 2,
      "text": "Warm the remaining milk with the sugar until hot and the sugar dissolves; keep it ready.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Heat the ghee, or the butter and sunflower oil, in a heavy saucepan. Add the crushed cardamom and cloves and cook until fragrant.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Stir in the dal paste and cook over medium heat, stirring frequently, until thickened and the raw aroma fades.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Add the hot sweetened milk and saffron. Cook, stirring often, until the mixture becomes smooth and pulls away from the sides of the pan."
    },
    {
      "step": 6,
      "text": "Fold in the chopped pistachios and almonds, then transfer the halva to a lightly greased dish or tray."
    },
    {
      "step": 7,
      "text": "Cool until set. Cut into portions or shape as desired before serving."
    }
  ],
