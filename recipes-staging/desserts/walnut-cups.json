  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "walnut-cups",
  "name": "Walnut Cups",
  "subtitle": "Tender pastry cups with a brown-sugar walnut filling",
  "description": "Small cream-cheese pastry shells hold a vanilla brown-sugar and walnut filling, then bake until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "3 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the cream cheese, 0.5 cup butter, and flour together until a dough forms. Chill for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Divide the dough into 24 portions and press each into a small cup shape in a prepared mini-muffin pan."
    },
    {
      "step": 4,
      "text": "Blend the egg, 1 tablespoon butter, vanilla extract, and brown sugar until smooth, then stir in the walnuts."
    },
    {
      "step": 5,
      "text": "Fill the pastry cups with the walnut mixture."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, until the centers are firm and reach 160°F on a food thermometer.",
      "timer_minutes": 20
    }
  ],
