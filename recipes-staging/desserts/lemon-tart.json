  "instructions": [
    {
      "step": 1,
      "text": "Beat the butter, 0.5 cup white sugar, vanilla, and salt until smooth. Mix in 1.75 cups flour, then press the dough evenly into a tart pan."
    },
    {
      "step": 2,
      "text": "Refrigerate the crust for 30 minutes while the oven heats to 350°F.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Bake the chilled crust until golden brown, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Whisk 1.5 cups white sugar, eggs, lemon juice, 0.5 cup flour, and lemon zest until smooth. Pour the filling over the baked crust."
    },
    {
      "step": 5,
      "text": "Return the tart to the oven and bake until the center is set, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Cool completely, then dust with confectioners' sugar before serving."
    }
  ],
