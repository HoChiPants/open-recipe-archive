  "id": "peach-blueberry-pie",
  "name": "Peach Blueberry Pie",
  "subtitle": "A double-crust pie filled with peaches and blueberries.",
  "description": "Juicy peaches and blueberries are combined with lemon, sugar, tapioca, and salt, then baked in a flaky pastry crust until golden.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
