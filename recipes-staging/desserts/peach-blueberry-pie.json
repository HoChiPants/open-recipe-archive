  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Fit half of the pastry into a 9-inch pie dish."
    },
    {
      "step": 3,
      "text": "Combine the peaches, blueberries, and lemon juice in a bowl."
    },
    {
      "step": 4,
      "text": "Mix the sugar, tapioca, and salt, then stir into the fruit."
    },
    {
      "step": 5,
      "text": "Let the filling stand for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Spoon the filling into the pastry and dot with the margarine pieces."
    },
    {
      "step": 7,
      "text": "Cover with the remaining pastry, seal and crimp the edges, and cut vents in the top."
    },
    {
      "step": 8,
      "text": "Bake at 425°F until the crust is golden brown, about 45 minutes.",
      "timer_minutes": 45
    }
  ],
