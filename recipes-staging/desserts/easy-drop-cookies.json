  "id": "easy-drop-cookies",
  "name": "Easy Drop Cookies",
  "subtitle": "Tender, lightly sweet cookies from a simple dough",
  "description": "Mix, portion, and bake this straightforward cookie dough for a generous batch of homemade treats.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the butter and white sugar until smooth. Add the egg, vanilla extract, and milk, then mix until combined."
    },
    {
      "step": 3,
      "text": "Stir together the all-purpose flour, baking soda, and salt. Add the dry mixture to the butter mixture and combine into a soft dough."
    },
    {
      "step": 4,
      "text": "Drop portions of dough onto baking sheets, using white sugar as directed for shaping if needed."
    },
    {
      "step": 5,
      "text": "Bake for 12 minutes, until the cookies are set and the centers reach 160°F on a food thermometer.",
      "timer_minutes": 12
    }
  ],
