  "id": "blueberry-cherry-pie",
  "name": "Blueberry Cherry Pie",
  "subtitle": "A double-crust pie filled with cinnamon-scented berries and cherries.",
  "description": "Juicy cherries and blueberries are folded into a lightly spiced filling, enclosed in pastry, and baked until golden and bubbling.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "cherries",
      "item": "cherries",
      "quantity": 2,
      "unit": "cups",
      "preparation": "pitted"
    },
    {
      "ingredient_id": "blueberries",
      "item": "blueberries",
      "quantity": 2,
      "unit": "cups",
      "preparation": "rinsed and drained"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "recipe-pastry-for-a-9-inch-double-crust-pie",
      "item": "recipe pastry for a 9 inch double crust pie",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sugar, flour, and cinnamon. Add the cherries and blueberries, then stir in the lemon juice."
    },
    {
      "step": 2,
      "text": "Fit half of the pastry into a 9-inch pie plate and fill with the fruit mixture."
    },
    {
      "step": 3,
      "text": "Dot the filling with butter. Cover with the remaining pastry, seal the edge, and cut vents in the top crust."
    },
    {
      "step": 4,
      "text": "Bake at 375°F for 60 minutes, until the crust is golden and the filling is bubbling.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Cool the pie before slicing and serving."
    }
  ],
