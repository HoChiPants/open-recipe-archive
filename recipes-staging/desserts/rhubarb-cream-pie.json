    "prep_minutes": 20,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "unit": "large",
      "preparation": "beaten"
    },
    {
      "ingredient_id": "rhubarb",
      "item": "rhubarb",
      "quantity": 4,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "9-inch-deep-dish-pie-crust",
      "item": "(9 inch) deep dish pie crust",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Combine the sugar, flour, and nutmeg in a bowl."
    },
    {
      "step": 3,
      "text": "Stir in the beaten eggs, then fold in the chopped rhubarb."
    },
    {
      "step": 4,
      "text": "Prepare the deep-dish pie crust and transfer the rhubarb mixture into it."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until the center is firm and fully set.",
      "timer_minutes": 60
    }
  ],
