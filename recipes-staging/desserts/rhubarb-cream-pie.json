  "id": "rhubarb-cream-pie",
  "name": "Rhubarb Cream Pie",
  "subtitle": "Tart rhubarb baked in a spiced custard filling",
  "description": "A simple rhubarb pie with a nutmeg-scented egg custard baked in a deep-dish crust.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
