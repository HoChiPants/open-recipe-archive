{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "rhubarb-meringue-pie",
  "name": "Rhubarb Meringue Pie",
  "subtitle": "Tart rhubarb beneath a soft, toasted meringue",
  "description": "A classic fruit pie with a creamy rhubarb filling and lightly browned meringue topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 60,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "9-inch-unbaked-single-pie-crust",
      "item": "(9 inch) unbaked single pie crust",
      "quantity": 1
    },
    {
      "ingredient_id": "fresh-rhubarb",
      "item": "fresh rhubarb",
      "quantity": 3,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "half-and-half",
      "item": "half-and-half",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "unit": "large",
      "preparation": "separated, divided"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "cream-of-tartar",
      "item": "cream of tartar",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Fit the unbaked crust into a 9-inch pie pan and fill it with the chopped rhubarb."
    },
    {
      "step": 3,
      "text": "Whisk the egg yolks with the half-and-half, flour, salt, and 1 cup of the sugar until smooth. Pour the mixture over the rhubarb."
    },
    {
      "step": 4,
      "text": "Bake the pie for 60 minutes, until the filling is set.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Beat the egg whites until foamy. Gradually add the remaining sugar and cream of tartar, then beat until stiff peaks form."
    },
    {
      "step": 6,
      "text": "Spread the meringue over the hot pie, covering the filling and sealing it to the crust edge."
    },
    {
      "step": 7,
      "text": "Bake for 10 minutes, until lightly browned and the center reaches 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Cool before serving.",
      "timer_minutes": 15
    }
  ],
