{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "crunchies",
  "name": "Crunchies",
  "subtitle": "Crisp oat and coconut bites",
  "description": "These simple oat-and-coconut squares combine a buttery syrup mixture with a lightly sweetened dry base, then bake until crisp.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "golden-syrup",
      "item": "golden syrup",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.875,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the golden syrup and butter in a saucepan and simmer until melted and smooth."
    },
    {
      "step": 2,
      "text": "Stir the baking soda into the warm syrup mixture."
    },
    {
      "step": 3,
      "text": "Mix the flaked coconut, all-purpose flour, white sugar, and rolled oats in a bowl."
    },
    {
      "step": 4,
      "text": "Pour the syrup mixture into the dry ingredients and stir until evenly combined."
    },
    {
      "step": 5,
      "text": "Spread the mixture in a baking pan and bake at 350°F until set and lightly browned, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Cool briefly, then cut into 30 pieces."
    }
  ],
