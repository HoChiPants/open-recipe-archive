  "id": "apple-and-custard-rose-tart",
  "name": "Apple and Custard Rose Tart",
  "subtitle": "A crisp pastry tart layered with set vanilla custard and apple slices.",
  "description": "Bake a sweet pastry shell, fill it with vanilla custard, and arrange thin apples in overlapping petals before finishing in the oven.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
