  "instructions": [
    {
      "step": 1,
      "text": "Rub the flour and cold cubed butter together until crumbly. Mix in the caster sugar, icing sugar, and egg yolk to form a dough."
    },
    {
      "step": 2,
      "text": "Press the dough into a buttered tart tin, shape the edges, and chill until firm.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Line the shell, chill it again, then preheat the oven. Bake for 15 minutes, remove the lining, and bake for another 15 minutes until golden brown. Cool and trim if needed.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "Warm the milk with the vanilla paste. Whisk the caster sugar, icing sugar, egg yolk, egg yolks, and custard powder until combined, then gradually whisk in the warm milk until smooth."
    },
    {
      "step": 5,
      "text": "Cook the custard over medium heat, stirring for about 3 minutes until thick. Whisk until smooth, transfer to a bowl, and cool until set. For egg safety, verify that the custard reaches 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Slice the apples thinly and toss them with the lemon juice, caster sugar, cold butter, and icing sugar.",
      "timer_minutes": 4
    },
    {
      "step": 7,
      "text": "Preheat the oven if needed. Spread the custard in the pastry shell and arrange the apple slices in overlapping rose-like layers. Bake until the apples are tender and lightly finished."
    },
    {
      "step": 8,
      "text": "Prepare the whole milk and custard powder as needed for the custard mixture."
    }
  ],
