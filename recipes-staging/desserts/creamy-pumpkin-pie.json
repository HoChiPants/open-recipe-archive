  "id": "creamy-pumpkin-pie",
  "name": "Creamy Pumpkin Pie",
  "subtitle": "A warmly spiced custard pie with a smooth pumpkin filling.",
  "description": "Combine mashed pumpkin, condensed milk, eggs, and spices in a deep-dish crust, then bake until the center is fully set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-pumpkin",
      "item": "fresh pumpkin",
      "quantity": 4,
      "unit": "cups",
      "preparation": "cooked and mashed"
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "9-inch-deep-dish-pie-crust",
      "item": "(9 inch) deep dish pie crust",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Whisk the pumpkin, condensed milk, and eggs together. Stir in the cinnamon, ginger, nutmeg, and salt until evenly combined."
    },
    {
      "step": 3,
      "text": "Pour the filling into the deep-dish pie crust."
    },
    {
      "step": 4,
      "text": "Bake at 425°F for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Reduce the oven temperature to 350°F and continue baking for 40 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    }
  ],
