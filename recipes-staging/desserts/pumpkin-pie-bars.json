  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Divide the cake mix between the base and topping. Combine the portion for the base with the melted butter, then press it evenly into the pan."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, pumpkin pie filling, and milk until smooth. Spread the mixture over the base."
    },
    {
      "step": 4,
      "text": "Mix the reserved cake mix with the sugar and cinnamon. Cut in the remaining butter until crumbly, then scatter the mixture over the pumpkin layer."
    },
    {
      "step": 5,
      "text": "Bake until the center is fully set and reaches 160°F, about 50 minutes.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Cool completely before cutting into bars."
    }
  ],
