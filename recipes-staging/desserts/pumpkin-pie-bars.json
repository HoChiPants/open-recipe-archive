  "id": "pumpkin-pie-bars",
  "name": "Pumpkin Pie Bars",
  "subtitle": "Layered pumpkin dessert with a cinnamon crumb topping",
  "description": "A simple baked pumpkin dessert with a buttery cake-mix base, smooth spiced filling, and crumbly topping.",
  "meal_type": "dessert",
