  "id": "banana-bread-drop-muffins",
  "name": "Banana Bread Drop Muffins",
  "subtitle": "Tender almond-flour muffins with ripe banana",
  "description": "Mash ripe bananas and combine them with eggs and cooled melted coconut oil, then fold into seasoned almond flour and bake until lightly browned.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "coconut-oil",
      "item": "coconut oil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "almond-flour",
      "item": "almond flour",
      "quantity": 3.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ripe-bananas",
      "item": "ripe bananas",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "coconut-oil",
      "item": "coconut oil",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted and cooled"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease 12 muffin cups with the 2 teaspoons coconut oil."
    },
    {
      "step": 2,
      "text": "Whisk the almond flour, salt, and baking soda in a bowl."
    },
    {
      "step": 3,
      "text": "Mash the bananas in a separate bowl. Stir in the melted, cooled coconut oil and eggs until combined."
    },
    {
      "step": 4,
      "text": "Add the banana mixture to the dry ingredients and stir just until evenly combined."
    },
    {
      "step": 5,
      "text": "Divide the batter among the prepared muffin cups."
    },
    {
      "step": 6,
      "text": "Bake until lightly browned, about 17 minutes.",
      "timer_minutes": 17
    },
    {
      "step": 7,
      "text": "Cool the muffins before serving."
    }
  ],
