  "id": "besan-ladoo",
  "name": "Besan Ladoo",
  "subtitle": "Cardamom-scented chickpea flour sweets with saffron and nuts",
  "description": "Roasted gram flour and ghee form these fragrant Indian sweets, finished with saffron, cardamom, cashews, and pistachios.",
  "meal_type": "dessert",
  "cuisine": "Indian",
  "yield": {
    "quantity": 20,
    "unit": "(serves 8)"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "green-cardamom-pods",
      "item": "green cardamom pods",
      "quantity": 6
    },
    {
      "ingredient_id": "icing-sugar-sieved",
      "item": "icing sugar sieved",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "unsalted-cashews",
      "item": "unsalted cashews",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "ghee-see-tip",
      "item": "ghee (see tip",
      "quantity": 125,
      "unit": "g",
      "preparation": "below)"
    },
    {
      "ingredient_id": "gram-flour-sieved",
      "item": "gram flour sieved",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "saffron-soaked-in-1-tbsp-warm-milk",
      "item": "saffron soaked in 1 tbsp warm milk",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "pistachios",
      "item": "pistachios",
      "quantity": 1,
      "unit": "tbsp",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Remove the cardamom seeds from the pods and crush them. Prepare the sieved sugar and soak the saffron in warm milk as specified."
    },
    {
      "step": 2,
      "text": "Toast the cashews in a dry pan until lightly golden, then chop them."
    },
    {
      "step": 3,
      "text": "Warm the ghee in a heavy pan, add the gram flour, and stir-roast over low heat for 20 minutes, until fragrant and evenly cooked.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Let the roasted flour mixture cool until warm but manageable. Stir in the cashews, sugar, crushed cardamom, and saffron mixture."
    },
    {
      "step": 5,
      "text": "Knead until the mixture is smooth and cohesive."
    },
    {
      "step": 6,
      "text": "Divide the mixture into 20 portions and roll each into a ladoo."
    },
    {
      "step": 7,
      "text": "Chill the ladoos for 10 minutes, then press the chopped pistachios onto them before serving.",
      "timer_minutes": 10
    }
  ],
