  "id": "apple-crisp-691447b2",
  "name": "Apple Crisp",
  "subtitle": "Warm apples beneath a cinnamon oat topping",
  "description": "A classic baked fruit dessert with tender apples, a thick vanilla syrup, and a crisp oat topping.",
  "meal_type": "dessert",
