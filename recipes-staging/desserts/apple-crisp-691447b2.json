  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the flour, 0.5 cup brown sugar, oats, melted butter, cinnamon, and white sugar to make the topping."
    },
    {
      "step": 3,
      "text": "Arrange the apples in a baking dish."
    },
    {
      "step": 4,
      "text": "Heat the remaining brown sugar with the water, cornstarch, and vanilla, stirring until thickened, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Pour the thickened mixture over the apples, then spread the topping evenly over them."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, until the apples are tender and the topping is crisp.",
      "timer_minutes": 45
    }
  ],
