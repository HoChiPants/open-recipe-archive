  "id": "pumpkin-swirl-cheesecake",
  "name": "Pumpkin Swirl Cheesecake",
  "subtitle": "A spiced pumpkin cheesecake with a crisp pecan crumb crust.",
  "description": "A creamy pumpkin cheesecake baked over a ginger-pecan crust and chilled until firm.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 55,
    "inactive_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "nabisco-ginger-snaps",
      "item": "NABISCO Ginger Snaps",
      "quantity": 25,
      "preparation": "finely crushed"
    },
    {
      "ingredient_id": "finely-chopped-planters-pecans",
      "item": "finely chopped PLANTERS Pecans",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "philadelphia-cream-cheese",
      "item": "PHILADELPHIA Cream Cheese",
      "quantity": 4,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 1,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "vanilla",
      "item": "vanilla",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "canned-pumpkin",
      "item": "canned pumpkin",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
