      "item": "of ground cloves",
      "unit": "dash"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Combine the finely crushed ginger snaps, chopped pecans, and melted butter. Press the mixture evenly into the bottom of a cheesecake pan."
    },
    {
      "step": 3,
      "text": "Beat the softened cream cheese with the vanilla and half of the sugar until smooth. Add the eggs and mix until combined."
    },
    {
      "step": 4,
      "text": "Stir the remaining sugar into the pumpkin with the cinnamon, nutmeg, and cloves."
    },
    {
      "step": 5,
      "text": "Spread the cream cheese mixture over the crust. Spoon the pumpkin mixture over it, then gently cut through the layers with a knife to create swirls."
    },
    {
      "step": 6,
      "text": "Bake for 55 minutes, until the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 55
    },
    {
      "step": 7,
      "text": "Cool the cheesecake, then refrigerate for 4 hours or until firm.",
      "timer_minutes": 240
    },
    {
      "step": 8,
      "text": "Cut into servings. Prepare the softened cream cheese as directed for serving, if applicable."
    }
  ],
