  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Halve the nectarines and arrange them in a baking dish."
    },
    {
      "step": 3,
      "text": "Drizzle with the honey and orange juice, add the thyme sprigs, and bake for 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Transfer the baked nectarines to serving plates."
    },
    {
      "step": 5,
      "text": "Fold the mascarpone until smooth, then spoon it over the nectarines."
    },
    {
      "step": 6,
      "text": "Add the thyme sprigs and chopped pistachios, then serve."
    }
