      "item": "ground nutmeg",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 2,
      "text": "Combine the blackberries, peaches, sugar, and cornstarch in a bowl."
    },
    {
      "step": 3,
      "text": "Fit one pie crust into a pie dish and transfer the fruit mixture into it."
    },
    {
      "step": 4,
      "text": "Cover with the remaining crust, seal the edges, and cut vents in the top."
    },
    {
      "step": 5,
      "text": "Brush the crust with melted butter and sprinkle with cinnamon and nutmeg."
    },
    {
      "step": 6,
      "text": "Bake at 450°F for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Reduce the oven temperature to 350°F and bake for 40 minutes, until the crust is golden brown.",
      "timer_minutes": 40
    }
  ],
