  "id": "blackberry-peach-pie",
  "name": "Blackberry Peach Pie",
  "subtitle": "Juicy summer fruit beneath a crisp double crust",
  "description": "Fresh blackberries and peaches bake into a warmly spiced, sliceable fruit pie.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-blackberries",
      "item": "fresh blackberries",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "fresh-peaches",
      "item": "fresh peaches",
      "quantity": 3,
      "preparation": "peeled, pitted, and sliced"
    },
    {
      "ingredient_id": "sugar",
