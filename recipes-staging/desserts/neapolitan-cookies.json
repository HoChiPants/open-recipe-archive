      "item": "red food coloring",
      "quantity": 5,
      "unit": "drops"
    },
    {
      "ingredient_id": "1-ounce-square-unsweetened-chocolate",
      "item": "(1 ounce) square unsweetened chocolate",
      "quantity": 1,
      "preparation": "melted"
    },
