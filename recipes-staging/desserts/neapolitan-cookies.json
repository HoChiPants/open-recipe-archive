  "instructions": [
    {
      "step": 1,
      "text": "Beat the softened butter and sugar until creamy. Beat in the egg and vanilla extract."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, baking powder, and salt, then gradually mix the dry ingredients into the butter mixture."
    },
    {
      "step": 3,
      "text": "Divide the dough into three portions. Flavor one with almond extract and red food coloring; mix the melted chocolate and walnuts into another, leaving the third plain."
    },
    {
      "step": 4,
      "text": "Layer or shape the portions into a compact rectangular log, wrap, and chill until firm.",
      "timer_minutes": 240
    },
    {
      "step": 5,
      "text": "Heat the oven to 350°F and prepare baking sheets."
    },
    {
      "step": 6,
      "text": "Slice the chilled log into thick rounds and arrange them on the prepared sheets."
    },
    {
      "step": 7,
      "text": "Bake for about 12 minutes, until lightly browned and the centers are fully set, reaching 160°F on a food thermometer.",
      "timer_minutes": 12
    },
    {
      "step": 8,
      "text": "Leave the cookies on the sheets for 3 minutes, then transfer them to a rack to cool.",
      "timer_minutes": 3
    }
  ],
