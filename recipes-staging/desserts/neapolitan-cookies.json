  "id": "neapolitan-cookies",
  "name": "Neapolitan Cookies",
  "subtitle": "Three-flavor slice-and-bake cookies",
  "description": "A batch of buttery cookies combining vanilla, almond, berry-colored, and chocolate-walnut flavors.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 72,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 15,
    "inactive_minutes": 270
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
