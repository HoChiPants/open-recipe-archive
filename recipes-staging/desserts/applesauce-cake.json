  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking pan for the batter."
    },
    {
      "step": 2,
      "text": "Stir together the cake mix, pudding mix, nutmeg, and cinnamon."
    },
    {
      "step": 3,
      "text": "Add the applesauce, vegetable oil, eggs, and water. Blend for 4 minutes until smooth.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Pour the batter into the prepared pan and bake at 350°F until set and a tester comes out clean.",
