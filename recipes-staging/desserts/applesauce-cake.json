  "id": "applesauce-cake",
  "name": "Applesauce Cake",
  "subtitle": "A warmly spiced cake with a tender applesauce crumb",
  "description": "A simple American dessert combining applesauce, cinnamon, and nutmeg in a moist cake baked from prepared mixes.",
  "meal_type": "dessert",
