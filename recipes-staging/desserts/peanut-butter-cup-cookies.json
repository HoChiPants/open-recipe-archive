  "id": "peanut-butter-cup-cookies",
  "name": "Peanut Butter Cup Cookies",
  "subtitle": "Soft peanut butter cookies with chocolate centers",
  "description": "Peanut butter cookie dough surrounds miniature chocolate-covered peanut butter cups for a simple batch of filled cookies.",
