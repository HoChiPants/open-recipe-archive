  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Line baking sheets with parchment."
    },
    {
      "step": 2,
      "text": "Beat the butter, white sugar, brown sugar, and peanut butter until smooth. Beat in the egg and vanilla."
    },
    {
      "step": 3,
      "text": "Stir in the flour, baking soda, and salt until a soft dough forms."
    },
    {
      "step": 4,
      "text": "Divide the dough into 18 portions. Enclose one miniature peanut butter cup in each portion and place the pieces on the prepared sheets."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, until the cookie centers are fully set; if checked with a thermometer, the egg-containing dough should reach 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Immediately press one miniature peanut butter cup into the top of each hot cookie. Cool on the sheets until firm."
    }
  ],
