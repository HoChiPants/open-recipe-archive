  "id": "chicken-biscuit-pot-pie",
  "name": "Chicken Biscuit Pot Pie",
  "subtitle": "A creamy chicken-and-vegetable filling under golden biscuits",
  "description": "A quick American-style pot pie made with canned chicken, mixed vegetables, creamy soup, and flaky biscuits.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "melted, divided"
    },
    {
      "ingredient_id": "frozen-mixed-vegetables",
      "item": "frozen mixed vegetables",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "chicken-chunks",
      "item": "chicken chunks",
      "quantity": 1,
      "unit": "can",
      "preparation": "5 ounce, drained"
    },
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 2,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "reduced-fat-milk",
      "item": "reduced-fat milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "refrigerated-flaky-layer-biscuits",
      "item": "refrigerated flaky layer biscuits",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Lightly grease a baking dish with some of the melted butter."
    },
    {
      "step": 2,
      "text": "Cook the frozen vegetables in a saucepan over medium heat for 7 minutes, or until tender.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Stir in the chicken and condensed soup. Add the milk, season with salt and pepper, and simmer until the mixture is smooth and hot."
    },
    {
      "step": 4,
      "text": "Pour the filling into the prepared baking dish and arrange the biscuits over the top. Brush the biscuits with the remaining melted butter."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until the biscuits are golden and the center of the filling reaches 165°F on a food thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Let the pot pie rest for 15 minutes before serving.",
      "timer_minutes": 15
    }
  ],
