  "schema_version": "1.0.0",
  "id": "daffodil-cake",
  "name": "Daffodil Cake",
  "subtitle": "A light citrus-and-vanilla sponge with a golden yolk layer",
  "description": "A tender two-tone sponge cake combining airy egg whites with a fragrant egg-yolk batter, orange extract, and vanilla.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 10
    },
    {
      "ingredient_id": "cream-of-tartar",
      "item": "cream of tartar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "cake-flour",
      "item": "cake flour",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 6
    },
    {
      "ingredient_id": "orange-extract",
      "item": "orange extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cake-flour",
      "item": "cake flour",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare an ungreased tube pan."
    },
    {
      "step": 2,
      "text": "Whisk the cream of tartar and salt into the egg whites. Gradually add part of the divided sugar and continue whisking to soft peaks."
    },
    {
      "step": 3,
      "text": "Beat the egg yolks with the remaining sugar until thick. Blend in the orange extract, vanilla extract, and the 0.5 cup sifted cake flour."
    },
    {
      "step": 4,
      "text": "Fold the yolk mixture gently into the whipped egg whites, then fold in the 0.75 cup sifted cake flour without deflating the batter."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 30 minutes. Reduce the oven to 325°F and bake for 20 minutes more, until the center is firm and fully set.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Cool the cake completely before removing it from the pan and serving."
    }
  ],
