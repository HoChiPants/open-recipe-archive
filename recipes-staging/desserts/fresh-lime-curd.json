{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "fresh-lime-curd",
  "name": "Fresh Lime Curd",
  "subtitle": "Bright, buttery lime spread",
  "description": "A smooth citrus curd made with fresh lime juice, zest, eggs, sugar, and butter.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-lime-juice",
      "item": "fresh lime juice",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "lime-zest",
      "item": "lime zest",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large",
      "preparation": "beaten"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the beaten eggs with the lime juice and zest until blended."
    },
    {
      "step": 2,
      "text": "Combine the sugar, butter, lime juice, and lime zest in a heatproof pan. Warm while stirring until the butter melts."
    },
    {
      "step": 3,
      "text": "Gradually whisk the warm lime mixture into the eggs, then return everything to the pan."
    },
    {
      "step": 4,
      "text": "Cook over gentle heat, stirring continuously, for 25 minutes, until thickened and the curd reaches 160°F or has a firm, fully set center.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Remove from the heat and let the curd cool, then chill before serving."
    }
  ],
