  "id": "poppy-seed-muffins",
  "name": "Poppy Seed Muffins",
  "subtitle": "Tender muffins with a citrus-almond glaze",
  "description": "Bake lightly sweetened poppy seed muffins and finish them with a smooth orange glaze.",
