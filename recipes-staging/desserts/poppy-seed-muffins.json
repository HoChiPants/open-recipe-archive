  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a 12-cup muffin pan."
    },
    {
      "step": 2,
      "text": "Whisk the eggs, 2.5 cups white sugar, and vegetable oil until blended."
    },
    {
      "step": 3,
      "text": "Add the milk, salt, baking powder, poppy seeds, 1.5 teaspoons vanilla extract, 1.5 teaspoons almond extract, and flour. Stir just until combined."
    },
    {
      "step": 4,
      "text": "Divide the batter among the muffin cups and bake for 20 minutes, until the centers are firm and a tester comes out clean.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Cool the muffins in the pan for 5 minutes, then transfer them to a rack.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Warm 0.75 cup white sugar, orange juice, 0.5 teaspoon vanilla extract, 0.5 teaspoon almond extract, and melted butter until the sugar is dissolved and the mixture is smooth."
    },
    {
      "step": 7,
      "text": "Drizzle the glaze over the cooled muffins and let it set before serving."
    }
  ],
