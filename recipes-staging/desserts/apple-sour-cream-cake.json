  "id": "apple-sour-cream-cake",
  "name": "Apple Sour Cream Cake",
  "subtitle": "A tender apple cake with a lightly tangy crumb",
  "description": "Apples, sour cream, and rum make this moist cake suitable for slicing and serving as a simple dessert.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "apples",
      "item": "apples",
      "quantity": 4
    },
    {
