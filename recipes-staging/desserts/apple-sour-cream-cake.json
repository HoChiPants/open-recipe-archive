      "item": "rum",
      "quantity": 50,
      "unit": "ml"
    },
    {
      "ingredient_id": "butter-melted",
      "item": "butter melted",
      "quantity": 20,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 10,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F (175°C). Butter the cake tin."
    },
    {
      "step": 2,
      "text": "Cut the apples into pieces. Toss them with the lemon juice, some of the caster sugar, and the icing sugar."
    },
    {
      "step": 3,
      "text": "Whisk the eggs with the remaining caster sugar and icing sugar until thick."
    },
    {
      "step": 4,
      "text": "Whisk in the flour, baking powder, soured cream, melted butter, and rum until combined."
    },
    {
      "step": 5,
      "text": "Arrange the apples in the prepared tin and spread the batter over them."
    },
    {
      "step": 6,
      "text": "Bake until the cake is set and a tester inserted in the center comes out clean.",
      "timer_minutes": 50
    },
    {
      "step": 7,
      "text": "Cool briefly, then dust with icing sugar before serving."
    }
  ],
