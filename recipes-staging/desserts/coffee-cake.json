  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Combine the cake mix, pudding mix, milk, oil, eggs, butter, and vanilla until evenly blended."
    },
    {
      "step": 3,
      "text": "Transfer half of the batter to the prepared pan."
    },
    {
      "step": 4,
      "text": "Stir together the brown sugar, walnuts, and cinnamon. Sprinkle half of the mixture over the batter."
    },
    {
      "step": 5,
      "text": "Add the remaining batter, then finish with the remaining walnut mixture."
    },
    {
      "step": 6,
      "text": "Bake for 40 minutes, until the center is firm and a tester comes out clean.",
      "timer_minutes": 40
    }
