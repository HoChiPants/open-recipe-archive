  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven and line a baking tray. Juice the lemon, reserving the other half."
    },
    {
      "step": 2,
      "text": "Whisk the egg whites for 2 minutes. Combine the caster sugar and icing sugar, then add them gradually while whisking until the mixture is thick.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Whisk in the lemon juice, vanilla extract, and cornflour. Transfer the meringue to the tray and smooth it into a pavlova shape."
    },
    {
      "step": 4,
      "text": "Bake until the meringue is dry and set; verify that the center reaches 160°F for egg safety.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Turn off the oven and let the pavlova cool completely before topping.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Whisk the double cream, tahini, caster sugar, and icing sugar to soft peaks. Spoon over the cooled meringue."
    },
    {
      "step": 7,
      "text": "Arrange the sliced bananas on top, drizzle with salted caramel, and finish with the sesame snaps. Serve immediately."
    }
  ],
