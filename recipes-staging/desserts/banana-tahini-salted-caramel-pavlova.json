  "id": "banana-tahini-salted-caramel-pavlova",
  "name": "Banana Tahini Salted Caramel Pavlova",
  "subtitle": "Crisp meringue with tahini cream, bananas, and caramel",
  "description": "A tall baked meringue topped with soft tahini cream, sliced bananas, salted caramel, and sesame snaps.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
