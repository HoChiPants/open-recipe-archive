  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the baking mix, brown sugar, eggs, oil, coconut, chopped pecans, and vanilla extract. Stir until evenly mixed."
