  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a cake pan for baking."
    },
    {
      "step": 2,
      "text": "Combine the cake mix, one package of vanilla pudding mix, eggs, food coloring, water, vinegar, and cocoa powder. Stir until evenly mixed."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and bake for 40 minutes, or until the center is set and a tester comes out clean.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "Cool the cake completely."
    },
    {
      "step": 5,
      "text": "Whisk the cold milk and cream cheese until smooth. Add the remaining vanilla pudding mix and whisk until combined."
    },
    {
      "step": 6,
      "text": "Fold in the thawed whipped topping. Spread the mixture over the cooled cake."
    },
    {
      "step": 7,
      "text": "Chill before serving."
    }
  ],
