  "id": "red-velvet-cake",
  "name": "Red Velvet Cake",
  "subtitle": "A tender red cake with a cool vanilla topping",
  "description": "A simple red velvet-style cake made from cake mix, cocoa, and vanilla pudding, finished with a creamy whipped topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
