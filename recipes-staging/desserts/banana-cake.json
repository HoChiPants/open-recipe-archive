      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Prepare the all-purpose flour for mixing."
    },
    {
      "step": 3,
      "text": "Whisk the white sugar and unsalted butter until combined."
    },
    {
      "step": 4,
      "text": "Add the mashed ripe bananas, prepared flour, chopped walnuts, eggs, baking soda, vanilla extract, and salt."
    },
    {
      "step": 5,
      "text": "Combine the mixture until evenly blended."
    },
    {
      "step": 6,
      "text": "Transfer the batter to a baking pan."
    },
    {
      "step": 7,
      "text": "Bake for 30 minutes, until the center is firm and fully set; for a thermometer check, it should reach 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Cool before serving."
    }
  ],
