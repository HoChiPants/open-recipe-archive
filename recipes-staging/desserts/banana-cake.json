  "id": "banana-cake",
  "name": "Banana Cake",
  "subtitle": "A tender cake made with ripe bananas and walnuts",
  "description": "This simple American dessert combines mashed bananas, butter, and walnuts in a lightly sweetened cake baked until fully set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
