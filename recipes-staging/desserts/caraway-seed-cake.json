  "id": "caraway-seed-cake",
  "name": "Caraway Seed Cake",
  "subtitle": "A tender almond cake with aromatic caraway",
  "description": "A lightly sweet loaf-style cake combining buttery batter, ground almonds, and caraway seeds, finished with a crisp sugary almond topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 170,
      "unit": "g"
    },
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 170,
      "unit": "g"
    },
    {
