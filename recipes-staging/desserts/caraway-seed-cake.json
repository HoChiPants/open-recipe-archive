      "item": "flaked almonds",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a cake or loaf tin."
    },
    {
      "step": 2,
      "text": "Whisk the golden caster sugar, softened butter, and demerara sugar until creamy."
    },
    {
      "step": 3,
      "text": "Whisk in the eggs and vanilla extract, then mix in the self-raising flour, ground almonds, milk, caraway seeds, and flaked almonds until combined."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared tin and scatter over the demerara sugar, ground almonds, and flaked almonds."
    },
    {
      "step": 5,
      "text": "Bake until risen, golden, and set in the center.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool the cake before slicing."
    }
  ],
