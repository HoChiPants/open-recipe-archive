{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chicken-bao-pie",
  "name": "Chicken Bao Pie",
  "subtitle": "Steamed buns with savory chicken filling",
  "description": "Soft steamed bao dough surrounds a richly seasoned chicken filling and is finished with spring onions and chilli oil.",
  "meal_type": "dessert",
  "cuisine": "Chinese",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 60,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1 1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "dried-fast-action-yeast",
      "item": "dried fast-action yeast",
      "quantity": "1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": "1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "onion-finely-chopped",
      "item": "onion finely chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "garlic-cloves-crushed",
      "item": "garlic cloves crushed",
      "quantity": 2
    },
    {
      "ingredient_id": "chicken-mince",
      "item": "chicken mince",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "yellow-bean-sauce",
      "item": "yellow bean sauce",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "hoisin-sauce",
      "item": "hoisin sauce",
      "quantity": 35,
      "unit": "g"
    },
    {
      "ingredient_id": "chilli-oil-plus-extra-to-serve",
      "item": "chilli oil plus extra to serve",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "dark-soy-sauce",
      "item": "dark soy sauce",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "finely-sliced-spring-onions-to-serve",
      "item": "finely sliced spring onions to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the plain flour, dried yeast, and vegetable oil into a dough. Knead for 20 minutes, until smooth, then cover and rest for 20 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 2,
      "text": "Heat a pan with the vegetable oil. Add the chopped onion and crushed garlic, and cook for 8 minutes until softened.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Stir in the chicken mince, yellow bean sauce, hoisin sauce, chilli oil, and dark soy sauce. Cook for 15 minutes, breaking up the mince, until the chicken reaches 165°F throughout. Cool the filling.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Knead the dough briefly for 5 minutes, then work in the baking powder. Divide it into six portions.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Flatten each portion, place filling in the center, and gather the dough around it. Seal and shape each piece into a thick bun."
    },
    {
      "step": 6,
      "text": "Prepare a steamer and bring the water to a boil. Arrange the buns with space between them, cover, and steam until puffed and cooked through.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Top with the sliced spring onions and serve with extra chilli oil."
    }
  ],
