  "id": "chicken-pot-pie-1e414196",
  "name": "Chicken Pot Pie",
  "subtitle": "Tender chicken, peas, and creamy mushroom filling beneath flaky pastry",
  "description": "A practical savory pie made with simmered chicken, green peas, and mushroom sauce in a deep-dish crust.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "2-to-3-pound-whole-chicken",
      "item": "(2 to 3 pound) whole chicken",
      "quantity": 1
    },
    {
      "ingredient_id": "9-inch-deep-dish-frozen-pie-crusts",
      "item": "(9 inch) deep dish frozen pie crusts",
      "quantity": 2,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "frozen-green-peas",
      "item": "frozen green peas",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "cups",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "chicken-bouillon-granules",
      "item": "chicken bouillon granules",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the whole chicken in a pot with the water and bouillon granules. Bring to a simmer and cook for 30 minutes, or until the chicken is tender and reaches 165°F in the thickest part.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Transfer the chicken to a board and reserve the cooking liquid. When cool enough to handle, remove the meat from the bones and cut it into bite-size pieces."
    },
    {
      "step": 3,
      "text": "Preheat the oven to 400°F. Whisk the condensed soup with enough reserved cooking liquid to make a smooth, spoonable sauce, then simmer until smooth."
    },
    {
      "step": 4,
      "text": "Combine the chicken, peas, and sauce. Spoon the filling into one thawed crust and cover with the second crust, sealing the edges."
    },
    {
      "step": 5,
      "text": "Bake for 35 minutes, until the crust is browned and the filling is bubbling. Let stand briefly before serving.",
      "timer_minutes": 35
    }
  ],
