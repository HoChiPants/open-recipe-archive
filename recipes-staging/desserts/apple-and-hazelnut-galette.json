  "instructions": [
    {
      "step": 1,
      "text": "Finely grind the 80 g hazelnuts with the icing sugar, then combine with the spelt flour and plain flour."
    },
    {
      "step": 2,
      "text": "Rub in the cold cubed butter until the mixture forms coarse crumbs. Knead briefly to make a dough, shape into a disk, wrap, and chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Mix the brown sugar, lemon zest and juice, cornflour, maple syrup, and icing sugar with the flours. Toss in the sliced apples and leave the mixture until the fruit is coated and the juices begin to thicken."
    },
    {
      "step": 4,
      "text": "Preheat the oven to 375°F. Roll the chilled dough on a floured surface into a rough round and place it on a baking sheet."
    },
    {
      "step": 5,
      "text": "Arrange the apples in the center, leaving a border. Fold the pastry edge over the fruit, scatter with the roughly chopped hazelnuts, and brush the pastry with beaten egg."
    },
    {
      "step": 6,
      "text": "Sprinkle with extra brown sugar and bake for 55 minutes, until golden brown and the center is fully set and reaches 160°F.",
      "timer_minutes": 55
    },
    {
      "step": 7,
      "text": "Transfer the galette to a serving plate, drizzle with maple syrup, and serve with the double cream."
    }
  ],
