  "id": "apple-and-hazelnut-galette",
  "name": "Apple and Hazelnut Galette",
  "subtitle": "Rustic apple pastry with a nutty crust",
  "description": "Thinly sliced apples bake over a hazelnut-spelt pastry base, finished with cream for serving.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
