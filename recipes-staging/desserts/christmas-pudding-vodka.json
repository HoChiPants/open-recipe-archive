  "instructions": [
    {
      "step": 1,
      "text": "Place the currants, sultanas, prunes, glacé cherries, pared citrus zest, brown sugar, mixed spice, cinnamon stick, and split vanilla pod in a clean 1-litre container."
    },
    {
      "step": 2,
      "text": "Pour in the vodka, brandy, and amaretto, then stir or seal and shake until the sugar is evenly distributed."
    },
    {
      "step": 3,
      "text": "Keep the mixture covered until ready to serve, then strain if a clear drink is preferred."
    }
