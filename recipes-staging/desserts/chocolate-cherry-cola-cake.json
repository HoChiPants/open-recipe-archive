      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 180°F. Lightly oil a baking tin."
    },
    {
      "step": 2,
      "text": "Combine the plain flour, cocoa powder, baking powder, bicarbonate of soda, and golden caster sugar in a large bowl."
    },
    {
      "step": 3,
      "text": "Whisk together the natural yogurt, cola, and eggs. Stir this mixture into the dry ingredients until evenly combined, then spread the batter in the prepared tin."
    },
    {
      "step": 4,
      "text": "Bake for about 30 minutes, or until the center is firm and a thermometer reads at least 160°F. Cool in the tin for 20 minutes, then transfer to a rack and cool completely.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Beat the butter and icing sugar together, adding the milk gradually until smooth. Mix in the pink food colouring."
    },
    {
      "step": 6,
      "text": "Spread the icing over the cooled cake and add the optional sprinkles, cocktail cherries, and cola bottle sweets. Cut into 24 servings once set."
    }
  ],
