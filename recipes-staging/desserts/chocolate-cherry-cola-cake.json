  "id": "chocolate-cherry-cola-cake",
  "name": "Chocolate Cherry Cola Cake",
  "subtitle": "A soft chocolate cake with cola flavor and pink frosting",
  "description": "This sheet cake combines cocoa, cola, and yogurt, then finishes with a simple pink icing and optional playful decorations.",
  "meal_type": "dessert",
  "cuisine": "British",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
