  "id": "pumpkin-sheet-cake",
  "name": "Pumpkin Sheet Cake",
  "subtitle": "Tender pumpkin cake with cream cheese frosting and walnuts",
  "description": "A warmly spiced pumpkin cake baked in a sheet pan, cooled, frosted, and finished with chopped walnuts.",
  "meal_type": "dessert",
  "cuisine": "American",
