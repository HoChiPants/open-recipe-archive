  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a sheet pan for baking."
    },
    {
      "step": 2,
      "text": "Whisk the pumpkin, white sugar, vegetable oil, and eggs until blended."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the flour, baking soda, cinnamon, and salt. Add the dry mixture to the pumpkin mixture and whisk just until combined."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared pan and bake for 30 minutes, until the center is fully set.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cool the cake completely before frosting."
    },
    {
      "step": 6,
      "text": "Beat the cream cheese, softened butter, and vanilla until smooth. Gradually whisk in the confectioners' sugar, then add the milk and mix until spreadable."
    },
    {
      "step": 7,
      "text": "Spread the frosting over the cooled cake and sprinkle with the chopped walnuts."
    }
  ],
