  "id": "white-chocolate-pistachio-cookies",
  "name": "White Chocolate Pistachio Cookies",
  "subtitle": "Buttery drop cookies with crushed pistachios and white chocolate chips.",
  "description": "Tender, sweet cookies with a crisp edge and nutty pistachio crunch.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
