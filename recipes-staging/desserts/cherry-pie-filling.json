  "id": "cherry-pie-filling",
  "name": "Cherry Pie Filling",
  "subtitle": "Bright, thickened cherry filling for pies and pastries",
  "description": "A simple sweet-tart filling made by simmering pitted cherries and finishing them with a cornstarch slurry.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "tart-red-cherries",
      "item": "tart red cherries",
      "quantity": 4,
      "unit": "cups",
      "preparation": "pitted"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the pitted cherries in a saucepan and bring them to a gentle simmer."
    },
    {
      "step": 2,
      "text": "Simmer the cherries for 15 minutes, stirring occasionally.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Whisk the sugar and cornstarch together until evenly combined."
    },
    {
      "step": 4,
      "text": "Stir the sugar mixture into the simmering cherries until incorporated."
    },
    {
      "step": 5,
      "text": "Cook for 2 minutes, stirring constantly, until the filling is thickened.",
      "timer_minutes": 2
    }
  ],
