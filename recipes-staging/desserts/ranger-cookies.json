  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F and prepare baking sheets."
    },
    {
      "step": 2,
      "text": "Beat the softened butter with both sugars until blended. Add the eggs and vanilla, then mix until smooth."
    },
    {
      "step": 3,
      "text": "Whisk the flour, salt, baking soda, and baking powder together. Add the dry mixture to the butter mixture and combine."
    },
    {
      "step": 4,
      "text": "Fold in the oats, corn flake cereal, and coconut until evenly distributed. Chill the dough for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Portion the dough onto the prepared sheets, leaving space between portions. Bake until golden brown, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Cool the cookies on the sheets for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
