  "id": "ranger-cookies",
  "name": "Ranger Cookies",
  "subtitle": "Crisp-edged oatmeal cookies with coconut and cereal crunch",
  "description": "A chewy, textured cookie combining oats, coconut, and corn flake cereal in a brown-sugar dough.",
  "meal_type": "dessert",
