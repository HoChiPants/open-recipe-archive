  "id": "caramel-pear-blondies",
  "name": "Caramel Pear Blondies",
  "subtitle": "Chewy brown-sugar blondies with pear, chocolate, and caramel",
  "description": "A rich traybake combining chopped dried pears and dark chocolate with brown sugar, finished with caramel for a soft, swirled center.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
