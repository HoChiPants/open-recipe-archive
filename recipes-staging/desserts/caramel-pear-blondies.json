  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and butter a baking tin, lining it if desired."
    },
    {
      "step": 2,
      "text": "Melt the butter, then whisk in the vanilla bean paste and salt. Let it cool slightly."
    },
    {
      "step": 3,
      "text": "Whisk the eggs with both sugars until smooth and well combined. Stir in the melted butter mixture."
    },
    {
      "step": 4,
      "text": "Fold in the flour and baking powder, followed by the dried pears and half of the chopped chocolate."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared tin and smooth the surface. Scatter over the remaining chocolate and spoon the caramel on top, swirling it lightly through the batter."
    },
    {
      "step": 6,
      "text": "Bake for 40 minutes, until the edges are set and the center is firm and fully set.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Cool completely in the tin before cutting into 12 pieces."
    }
  ],
