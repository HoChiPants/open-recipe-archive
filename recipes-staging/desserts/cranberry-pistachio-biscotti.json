  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 300°F. Prepare a baking sheet with the light olive oil."
    },
    {
      "step": 2,
      "text": "Mix the sugar and oil, then beat in the vanilla extract, almond extract, and eggs. Stir in the flour, baking powder, and salt until a dough forms, then fold in the pistachios and cranberries."
    },
    {
      "step": 3,
      "text": "Shape the dough into logs on the prepared sheet and bake until set, about 35 minutes. Let the logs cool for 10 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "Lower the oven to 275°F. Slice the logs thickly, then arrange the pieces on the sheet."
    },
    {
      "step": 5,
      "text": "Bake the slices for 10 minutes, until dry and crisp.",
      "timer_minutes": 10
    }
  ],
