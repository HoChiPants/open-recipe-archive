  "id": "cranberry-pistachio-biscotti",
  "name": "Cranberry Pistachio Biscotti",
  "subtitle": "Twice-baked cookies with tart fruit and crunchy pistachios",
  "description": "These crisp Italian-style cookies combine dried cranberries and pistachios in a lightly flavored dough, then bake twice for their characteristic texture.",
  "meal_type": "dessert",
  "cuisine": "Italian",
