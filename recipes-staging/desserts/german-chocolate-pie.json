  "id": "german-chocolate-pie",
  "name": "German Chocolate Pie",
  "subtitle": "Chocolate custard pie with coconut and pecans",
  "description": "A baked pie crust filled with smooth German sweet chocolate custard and finished with a cooked coconut-pecan topping.",
