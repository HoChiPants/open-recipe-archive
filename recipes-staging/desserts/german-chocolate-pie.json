  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk 0.33300000429153 cup sugar with the cornstarch in a saucepan. Gradually stir in the milk, then add the chopped chocolate and 1 tablespoon butter."
    },
    {
      "step": 3,
      "text": "Cook over medium heat, stirring constantly, until the mixture thickens. Remove from the heat."
    },
    {
      "step": 4,
      "text": "Whisk a small amount of the hot mixture into the beaten egg yolks, then return the yolk mixture to the saucepan. Cook gently, stirring, until smooth and steaming; do not boil.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Stir in the vanilla extract. Pour the chocolate filling into the baked pie crust."
    },
    {
      "step": 6,
      "text": "Combine the beaten egg, evaporated milk, 0.5 cup sugar, and 0.25 cup butter in a saucepan. Cook over medium heat, stirring, until thickened and the center reaches 160°F."
    },
    {
      "step": 7,
      "text": "Stir in the coconut and chopped pecans, then spread the topping over the pie."
    },
    {
      "step": 8,
      "text": "Cool the pie, then chill until set before slicing."
    }
  ],
