  "id": "double-chocolate-mint-cookies",
  "name": "Double Chocolate Mint Cookies",
  "subtitle": "Rich cocoa cookies with chocolate chips and peppermint",
  "description": "Soft chocolate cookies flavored with vanilla and peppermint, finished with semisweet chocolate chips.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 96,
    "unit": "servings"
  },
