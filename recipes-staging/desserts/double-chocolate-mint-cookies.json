  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and line baking sheets with parchment."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter, sugar, and eggs until smooth, then mix in the vanilla and peppermint extracts."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the flour, cocoa powder, baking soda, and salt."
    },
    {
      "step": 4,
      "text": "Gradually blend the dry ingredients into the butter mixture until a dough forms; fold in the chocolate chips."
    },
    {
      "step": 5,
      "text": "Portion the dough onto the prepared baking sheets, spacing the portions apart."
    },
    {
      "step": 6,
      "text": "Bake until the cookies are set, about 9 minutes.",
      "timer_minutes": 9
    },
    {
      "step": 7,
      "text": "Let the cookies cool on the baking sheets for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 8,
      "text": "Transfer the cookies to a rack and let them cool completely before serving."
    }
  ],
