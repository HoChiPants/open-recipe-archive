  "id": "fresh-pineapple-upside-down-cake",
  "name": "Fresh Pineapple Upside-Down Cake",
  "subtitle": "A buttery cake layered with caramelized pineapple",
  "description": "Fresh pineapple rings bake beneath a tender vanilla cake, then turn out as a glossy fruit-topped dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
