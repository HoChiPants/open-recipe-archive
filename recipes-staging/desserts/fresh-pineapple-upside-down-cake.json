  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Melt the butter and use some to coat a baking pan."
    },
    {
      "step": 2,
      "text": "Combine the remaining melted butter with the dark brown sugar and pineapple juice. Stir in the white sugar and arrange the pineapple rings in the prepared pan; pour the mixture over them and let the topping set briefly."
    },
    {
      "step": 3,
      "text": "Stir together the flour, baking powder, salt, and remaining white sugar."
    },
    {
      "step": 4,
      "text": "Whisk the eggs with the vanilla extract, then stir in the melted butter and pineapple juice. Add the flour mixture and fold just until combined."
    },
    {
      "step": 5,
      "text": "Spread the batter over the pineapple layer and bake until the center is firm and a tester comes out clean, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool the cake in the pan for 10 minutes, then invert it onto a serving plate.",
      "timer_minutes": 10
    }
  ],
