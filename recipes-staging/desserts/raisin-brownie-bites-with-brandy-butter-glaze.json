  "id": "raisin-brownie-bites-with-brandy-butter-glaze",
  "name": "Raisin Brownie Bites with Brandy Butter Glaze",
  "subtitle": "Rich chocolate squares with plump raisins and a smooth boozy glaze",
  "description": "Dense chocolate brownie bites studded with soaked raisins and finished with a simple brandy butter glaze.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "brandy-or-dark-or-golden-rum",
      "item": "brandy or dark or golden rum",
      "quantity": 50,
      "unit": "ml"
    },
    {
      "ingredient_id": "salted-butter-plus-extra-for-the-tin",
      "item": "salted butter plus extra for the tin",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-chocolate-chips-or-250g-dark-chocolate-bar-at-least-70-cocoa-solids",
      "item": "dark chocolate chips or 250g dark chocolate bar (at least 70% cocoa solids)",
      "preparation": "chopped into chunks"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "unit": "large"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "salted-butter-softened",
      "item": "salted butter softened",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "brandy-or-rum",
      "item": "brandy or rum",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the raisins with the brandy or dark or golden rum and set aside. Heat the oven and grease the baking tin with extra butter."
    },
    {
      "step": 2,
      "text": "Melt the 200 g salted butter with the chopped chocolate in short microwave bursts, stirring between each, until smooth."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, golden caster sugar, and light brown soft sugar for 3 minutes until thickened.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Fold in the melted chocolate mixture and soaked raisins. Add the plain flour and cocoa powder, folding just until combined."
    },
    {
      "step": 5,
      "text": "Spread the batter smoothly in the prepared tin and bake until set, about 40 minutes. The center should be firm and fully set; verify with a thermometer at 160°F if needed.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Cool in the tin for 15 minutes, then cool completely before cutting into 16 bites.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Stir the softened salted butter and icing sugar until smooth. Add the brandy or rum and mix into a spreadable glaze."
    },
    {
      "step": 8,
      "text": "Spread or pipe the glaze over the cooled brownies, allow it to set for about 20 minutes, then serve.",
      "timer_minutes": 20
    }
  ],
