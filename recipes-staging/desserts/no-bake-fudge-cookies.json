  "id": "no-bake-fudge-cookies",
  "name": "No-Bake Fudge Cookies",
  "subtitle": "Chewy cocoa-oat cookies set without an oven",
  "description": "A quick stovetop mixture of cocoa, oats, peanut butter, and raisins forms soft, chewy cookies as it cools.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 1
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "quick-cooking-oats",
      "item": "quick cooking oats",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Line a baking sheet or tray with parchment paper."
    },
    {
      "step": 2,
      "text": "Combine the sugar, milk, butter, and peanut butter in a saucepan over medium heat."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer, stirring until smooth, and simmer for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Remove from the heat and stir in the oats, cocoa powder, vanilla extract, and raisins until evenly coated."
    },
    {
      "step": 5,
      "text": "Drop rounded spoonfuls onto the prepared tray and let stand until firm."
    }
  ],
