  "id": "banana-cake-with-cream-cheese-frosting",
  "name": "Banana Cake with Cream Cheese Frosting",
  "subtitle": "A tender banana cake finished with creamy frosting",
  "description": "A simple American dessert combining mashed bananas with a lightly sweetened cake batter and a banana cream cheese frosting.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
