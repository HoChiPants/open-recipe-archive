  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare the all-purpose flour as needed for mixing."
    },
    {
      "step": 2,
      "text": "Whisk together the white sugar, softened unsalted butter, eggs, vanilla extract, cream cheese frosting, and confectioners' sugar until blended."
    },
    {
      "step": 3,
      "text": "In a separate bowl, prepare the all-purpose flour with the baking powder, baking soda, and salt."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the wet mixture, then stir in the mashed bananas and sour milk until combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared baking pan and bake for 40 minutes, or until the center is firm and fully set.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Cool the cake completely before frosting."
    },
    {
      "step": 7,
      "text": "Combine the cream cheese frosting with the mashed ripe banana, then spread it over the cooled cake."
    },
    {
      "step": 8,
      "text": "Finish with white sugar and confectioners' sugar to taste."
    }
  ],
