  "id": "rhubarb-cobbler",
  "name": "Rhubarb Cobbler",
  "subtitle": "A tender baked topping over sweet-tart rhubarb",
  "description": "Chopped rhubarb bakes beneath a soft vanilla batter and a sugared cornstarch topping that forms a light sauce as it cooks.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "rhubarb",
      "item": "rhubarb",
      "quantity": 3,
      "unit": "cups",
      "preparation": "chopped, or to taste"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "boiling-water",
      "item": "boiling water",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Spread the chopped rhubarb in a baking dish."
    },
    {
      "step": 2,
      "text": "Whisk 0.75 cup white sugar with the butter until smooth. Stir in the flour, milk, baking powder, vanilla extract, and 0.5 teaspoon salt to make a batter."
    },
    {
      "step": 3,
      "text": "Spoon the batter evenly over the rhubarb."
    },
    {
      "step": 4,
      "text": "Combine 1 cup white sugar, cornstarch, and 0.25 teaspoon salt. Sprinkle the mixture over the batter."
    },
    {
      "step": 5,
      "text": "Pour the boiling water evenly over the top without stirring."
    },
    {
      "step": 6,
      "text": "Bake for 60 minutes, until the top is lightly browned and the rhubarb is tender.",
      "timer_minutes": 60
    }
  ],
