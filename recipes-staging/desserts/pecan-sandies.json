  "id": "pecan-sandies",
  "name": "Pecan Sandies",
  "subtitle": "Buttery pecan cookies with crisp edges",
  "description": "A simple American cookie made with toasted pecans, butter, and vanilla, chilled before slicing and baking.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20,
    "inactive_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-yolk",
      "item": "egg yolk",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.75,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Transfer the pecans to a baking sheet and bake for 10 minutes; cool.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the softened butter until smooth. Add the sugar and whisk until creamy."
    },
    {
      "step": 3,
      "text": "Whisk in the egg yolk, vanilla extract, and salt until combined."
    },
    {
      "step": 4,
      "text": "Stir in the toasted pecans and flour until a dough forms."
    },
    {
      "step": 5,
      "text": "Shape the dough into a thick log, wrap, and chill for 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 6,
      "text": "Preheat the oven to 350°F and prepare a baking sheet."
    },
    {
      "step": 7,
      "text": "Cut the chilled dough into thick rounds and transfer them to the baking sheet."
    },
    {
      "step": 8,
      "text": "Bake for 15 minutes, until lightly golden and the centers are fully set.",
      "timer_minutes": 15
    },
    {
      "step": 9,
      "text": "Cool before serving."
    }
  ],
