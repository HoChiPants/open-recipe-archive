  "id": "wheat-germ-oat-cookies",
  "name": "Wheat Germ Oat Cookies",
  "subtitle": "Chewy oat cookies with wheat germ, pecans, coconut, and dates.",
  "description": "A generously sized batch of lightly browned cookies combining oats, wheat germ, nuts, coconut, and chopped dates.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 60,
    "unit": "servings"
  },
  "times": {
