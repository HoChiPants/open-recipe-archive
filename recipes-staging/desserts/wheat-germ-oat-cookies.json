  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Beat the softened butter, white sugar, and brown sugar until smooth. Whisk in the eggs and vanilla extract."
    },
    {
      "step": 3,
      "text": "Combine the rolled oats, wheat germ, all-purpose flour, baking powder, baking soda, and salt in a separate bowl."
    },
    {
      "step": 4,
      "text": "Stir the dry mixture into the butter mixture until combined, then fold in the pecans, flaked coconut, and dates."
    },
    {
      "step": 5,
      "text": "Prepare baking sheets and portion the dough onto them, leaving space between cookies."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, until lightly browned.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Cool the cookies on the baking sheets for 2 minutes before serving or transferring.",
      "timer_minutes": 2
    }
  ],
