  "instructions": [
    {
      "step": 1,
      "text": "Combine the raisins, sultanas, apricots, cherries, mixed peel, brandy or rum, orange zest and juice, golden syrup, and ground mixed spice in a bowl. Set aside while preparing the batter."
    },
    {
      "step": 2,
      "text": "Grease a suitable cake tin with some of the butter. Beat the remaining butter with the brown sugar until smooth, then whisk in the eggs one at a time. Fold in the flour and ground almonds, followed by the fruit mixture."
    },
    {
      "step": 3,
      "text": "Preheat the air fryer according to its cake-baking setting. Spoon the batter into the prepared tin and level the surface."
    },
    {
      "step": 4,
      "text": "Bake in the air fryer for 120 minutes, covering the top if it browns too quickly. The center should be firm and fully set; verify with a thermometer at 160°F if needed.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Leave the cake in the tin briefly, then transfer it to a rack and cool completely."
    },
    {
      "step": 6,
      "text": "Pierce the cooled cake lightly and brush or spoon over extra brandy or rum. Store airtight and repeat the feeding as desired."
    }
  ],
