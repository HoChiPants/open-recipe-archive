{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "sandies",
  "name": "Sandies",
  "subtitle": "Tender pecan cookies with a sugared finish",
  "description": "Rich butter cookies made with chopped pecans and finished with a coating of white and confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 255,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33300000429153,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the butter, white sugar, and confectioners' sugar until smooth."
    },
    {
      "step": 2,
      "text": "Whisk in the water and vanilla extract."
    },
    {
      "step": 3,
      "text": "Stir in the sifted flour and chopped pecans until a dough forms."
    },
    {
      "step": 4,
      "text": "Chill the dough until firm."
    },
    {
      "step": 5,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 6,
      "text": "Shape the dough into 24 portions and place them on a baking sheet."
    },
    {
      "step": 7,
      "text": "Bake for 20 minutes, until the cookies are set and lightly colored.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "While warm, roll the cookies in the white sugar and confectioners' sugar."
    }
  ],
