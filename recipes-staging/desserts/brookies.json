  "instructions": [
    {
      "step": 1,
      "text": "Grease the tin with the extra butter and preheat the oven."
    },
    {
      "step": 2,
      "text": "Beat the softened butter with the light brown and dark muscovado sugars. Mix in the egg and yolk, then stir in the flour and bicarbonate of soda. Fold through the first portion of milk chocolate chunks and chill the cookie dough for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Melt the 185 g butter and dark chocolate together over simmering water. Remove from the heat and cool for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Whisk the three eggs, vanilla, and golden caster sugar for about 3 minutes, until thickened. Fold in the cooled chocolate mixture, cocoa powder, and the second portion of plain flour.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Press the chilled cookie dough into the prepared tin and scatter over the remaining milk chocolate chunks. Spread the brownie batter over the top and add any remaining chocolate pieces."
    },
    {
      "step": 6,
      "text": "Bake for 50 minutes, until the center is fully set and reaches 160°F on a food thermometer. Cool before cutting.",
      "timer_minutes": 50
    }
  ],
