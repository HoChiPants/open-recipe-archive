      "item": "semisweet chocolate chips",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare the cake mix according to the package directions, then divide the batter into two portions."
    },
    {
      "step": 2,
      "text": "Spread one portion in a prepared baking pan and bake for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Meanwhile, melt the caramels, evaporated milk, and butter together, stirring until smooth.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Pour the melted caramel mixture over the partially baked cake. Sprinkle with the pecans and semisweet chocolate chips."
    },
    {
      "step": 5,
      "text": "Spread the remaining batter over the top and bake until the cake is set, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Cool before cutting into servings."
    }
  ],
