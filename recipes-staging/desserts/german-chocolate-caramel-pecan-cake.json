  "id": "german-chocolate-caramel-pecan-cake",
  "name": "German Chocolate Caramel Pecan Cake",
  "subtitle": "A layered chocolate cake with caramel, pecans, and chocolate chips",
  "description": "A rich, layered dessert combining chocolate cake, buttery caramel, chopped pecans, and semisweet chocolate chips.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "german-chocolate-cake-mix",
      "item": "German chocolate cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "individually-wrapped-caramels",
      "item": "individually wrapped caramels",
      "quantity": 14,
      "unit": "ounces"
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "5 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
