  "id": "german-chocolate-cake-icing",
  "name": "German Chocolate Cake Icing",
  "subtitle": "A warm coconut-pecan topping for cake",
  "description": "Butter, brown sugar, coconut, pecans, and milk are simmered into a thick, spoonable icing.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1.3333333730698,
      "unit": "cups"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the butter in a saucepan over medium heat until melted."
    },
    {
      "step": 2,
      "text": "Stir in the brown sugar, coconut, chopped pecans, and milk until evenly combined."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer, stirring frequently."
    },
    {
      "step": 4,
      "text": "Cook for 3 minutes, stirring, until thickened.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Use the warm icing to top the cake."
    }
  ],
