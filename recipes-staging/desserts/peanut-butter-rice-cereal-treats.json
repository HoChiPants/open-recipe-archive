  "id": "peanut-butter-rice-cereal-treats",
  "name": "Peanut Butter Rice Cereal Treats",
  "subtitle": "Chewy no-bake squares with peanut butter",
  "description": "A simple mixture of crisp rice cereal and a warm peanut butter syrup, cooled until firm and cut into servings.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "crisp-rice-cereal",
      "item": "crisp rice cereal",
      "quantity": 6,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "corn-syrup",
      "item": "corn syrup",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare a pan for the treats."
    },
    {
      "step": 2,
      "text": "Combine the sugar, peanut butter, corn syrup, and butter in a saucepan. Heat gently, stirring, until melted and smooth."
    },
    {
      "step": 3,
      "text": "Place the cereal in a large bowl and pour the warm mixture over it. Stir until evenly coated."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared pan and press it into an even layer."
    },
    {
      "step": 5,
      "text": "Cool until firm, then cut into 12 servings."
    }
  ],
