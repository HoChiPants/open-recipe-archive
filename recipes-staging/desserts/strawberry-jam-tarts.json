  "id": "strawberry-jam-tarts",
  "name": "Strawberry Jam Tarts",
  "subtitle": "Flaky pastry pockets with a sweet berry center",
  "description": "Make simple jam-filled pastry tarts from refrigerated pie crusts, then finish them with a vanilla glaze and colored sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "refrigerated-pie-crusts",
      "item": "refrigerated pie crusts",
      "quantity": 1,
      "unit": "package",
      "preparation": "15 ounce"
    },
    {
      "ingredient_id": "strawberry-jam",
      "item": "strawberry jam",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "colored-decorating-sugar",
      "item": "colored decorating sugar",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F and prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Unroll the pie crusts and cut them into equal rectangular pieces."
    },
    {
      "step": 3,
      "text": "Place some jam in the center of half the pastry pieces. Top with the remaining pieces, press the edges to seal, and cut small openings in the tops."
    },
    {
      "step": 4,
      "text": "Transfer the tarts to the baking sheet and bake until golden brown.",
      "timer_minutes": 7
    },
    {
      "step": 5,
      "text": "Cool the tarts completely."
    },
    {
      "step": 6,
      "text": "Whisk the confectioners' sugar, milk, and vanilla with enough water to make a spreadable glaze. Add the colored decorating sugar, then adjust with the remaining confectioners' sugar or water as needed."
    },
    {
      "step": 7,
      "text": "Spread the glaze over the cooled tarts, decorate with colored sugar, and serve."
    }
  ],
