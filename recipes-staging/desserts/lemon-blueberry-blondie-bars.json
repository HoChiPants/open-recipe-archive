  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking pan with a liner or light coating of butter."
    },
    {
      "step": 2,
      "text": "Melt the butter and chopped white chocolate together, stirring until smooth. Let cool slightly."
    },
    {
      "step": 3,
      "text": "Whisk the brown sugar with the 2 tablespoons lemon juice, lemon zest, and salt. Whisk in the egg, egg yolk, and vanilla."
    },
    {
      "step": 4,
      "text": "Stir in the melted butter mixture, then mix in the flour just until incorporated. Fold in the blueberries."
    },
    {
      "step": 5,
      "text": "Spread the thick batter in the prepared pan and smooth the surface."
    },
    {
      "step": 6,
      "text": "Bake for 40 minutes, until golden brown and the center is fully set; confirm the baked egg mixture reaches 160°F.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Cool in the pan for 15 minutes, then transfer to a rack and cool completely.",
      "timer_minutes": 15
    },
    {
      "step": 8,
      "text": "Whisk the sifted powdered sugar with the 4 teaspoons lemon juice until smooth. Spread or drizzle the glaze over the cooled bars."
    },
    {
      "step": 9,
      "text": "Cut into 9 bars and serve."
    }
  ],
