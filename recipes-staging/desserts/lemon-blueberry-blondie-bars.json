  "id": "lemon-blueberry-blondie-bars",
  "name": "Lemon-Blueberry Blondie Bars",
  "subtitle": "Soft lemon bars with white chocolate and fresh blueberries",
  "description": "A buttery blondie base is brightened with lemon, folded with blueberries, baked until set, and finished with a simple lemon glaze.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
