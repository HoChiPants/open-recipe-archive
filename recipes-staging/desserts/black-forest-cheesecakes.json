  "id": "black-forest-cheesecakes",
  "name": "Black Forest Cheesecakes",
  "subtitle": "Chocolate cheesecakes with cherry topping",
  "description": "Individual chocolate cheesecakes baked over cookie bases, chilled, and finished with cherries and whipped topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
