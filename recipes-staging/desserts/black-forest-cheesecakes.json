      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-cocoa",
      "item": "baking cocoa",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "cherry-pie-filling",
      "item": "cherry pie filling",
      "quantity": 1,
      "unit": "can",
      "preparation": "21 ounce"
    },
