    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "chocolate-sandwich-cookies-with-creme-filling",
      "item": "chocolate sandwich cookies with creme filling",
      "quantity": 12
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
