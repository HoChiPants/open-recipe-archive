      "ingredient_id": "whipped-topping",
      "item": "whipped topping",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Prepare a 12-well muffin pan and place one chocolate sandwich cookie in each well."
    },
    {
      "step": 2,
      "text": "Beat the softened cream cheese, sugar, cocoa, and vanilla until smooth. Add the eggs and mix just until combined."
    },
    {
      "step": 3,
      "text": "Divide the filling among the cookie bases and bake for 25 minutes, until the centers are firm and reach 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Cool the cheesecakes, then refrigerate for 120 minutes.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Top each cheesecake with cherry pie filling and whipped topping before serving."
    }
  ],
