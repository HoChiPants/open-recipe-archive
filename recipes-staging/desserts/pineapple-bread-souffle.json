  "id": "pineapple-bread-souffle",
  "name": "Pineapple Bread Soufflé",
  "subtitle": "A warm, custardy bread dessert with crushed pineapple",
  "description": "Cubed white bread and pineapple bake with a buttery egg mixture and brown-sugar topping until golden and set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "slices-white-bread",
      "item": "slices white bread",
      "quantity": 5,
      "preparation": "cut into 1 inch cubes"
    },
    {
      "ingredient_id": "pineapple",
      "item": "pineapple",
      "quantity": 1,
      "unit": "can",
      "preparation": "20 ounce, crushed, drained"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "packed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the butter, sugar, and brown sugar until combined. Whisk in the eggs."
    },
    {
      "step": 3,
      "text": "Stir the bread cubes and drained pineapple into the butter mixture."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish and add the remaining brown sugar over the top."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, until golden brown and the center is fully set and reaches 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Cool briefly before serving."
    }
  ],
