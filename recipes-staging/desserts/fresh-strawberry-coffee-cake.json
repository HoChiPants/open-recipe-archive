  "id": "fresh-strawberry-coffee-cake",
  "name": "Fresh Strawberry Coffee Cake",
  "subtitle": "A tender cake with berries and coconut crumb topping",
  "description": "A simple American baked dessert layering a soft butter cake with sliced strawberries and a lightly sweet coconut topping.",
