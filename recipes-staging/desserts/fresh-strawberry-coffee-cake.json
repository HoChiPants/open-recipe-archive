  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the butter and 0.75 cup sugar until smooth, then whisk in the egg."
    },
    {
      "step": 3,
      "text": "Combine 1.5 cups flour, baking powder, and salt. Stir the dry mixture into the butter mixture alternately with the milk until combined."
    },
    {
      "step": 4,
      "text": "Transfer the batter to the pan and spread the sliced strawberries over the surface."
    },
    {
      "step": 5,
      "text": "Mix the remaining flour and sugar with the softened butter and coconut until crumbly, then scatter it over the strawberries."
    },
    {
      "step": 6,
      "text": "Bake for 35 minutes, until the center is firm and fully set, or reads at least 160°F with a food thermometer.",
      "timer_minutes": 35
    }
  ],
