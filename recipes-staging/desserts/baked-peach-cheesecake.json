  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to the recipe's baking temperature and prepare a suitable baking tin."
    },
    {
      "step": 2,
      "text": "Whisk the plain flour, potato flour, baking powder, caster sugar, and cold butter into a crumbly mixture. Add the orange zest and orange extract, knead briefly, then press the pastry into the tin. Chill for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Bake the pastry base for 15 minutes, then set it aside while preparing the filling.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Separate the eggs. Beat the curd cheese with the icing sugar, vanilla sugar, seven yolks, vanilla pudding mixture, orange zest, and orange extract until smooth."
    },
    {
      "step": 5,
      "text": "Whisk the five egg whites until foamy and gradually beat in the remaining icing sugar and vanilla sugar. Fold the whites gently into the curd-cheese mixture."
    },
    {
      "step": 6,
      "text": "Drain and slice the peaches. Spread the filling over the baked base, arrange the peaches on top, and bake until the center is firm and reaches 160°F.",
      "timer_minutes": 50
    },
    {
      "step": 7,
      "text": "Cool the cheesecake in the tin for 40 minutes, then cool completely before slicing.",
      "timer_minutes": 40
    }
  ],
