  "id": "pie-crust",
  "name": "Pie Crust",
  "subtitle": "A simple flaky base for sweet or savory fillings",
  "description": "Combine flour and salt with vegetable shortening, add cold water, then shape and fold the dough into a crust-ready round.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-shortening",
      "item": "vegetable shortening",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "In a bowl, combine the flour and salt."
    },
    {
      "step": 2,
      "text": "Cut in the vegetable shortening until the mixture forms coarse crumbs."
    },
    {
      "step": 3,
      "text": "Add the cold water gradually, mixing just until a dough forms."
    },
    {
      "step": 4,
      "text": "Turn the dough onto a lightly floured surface and shape it into a round."
    },
    {
      "step": 5,
      "text": "Fold the dough over itself once or twice, then shape it into a smooth round suitable for rolling."
    }
  ],
