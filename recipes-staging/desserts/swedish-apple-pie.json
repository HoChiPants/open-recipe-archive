  "id": "swedish-apple-pie",
  "name": "Swedish Apple Pie",
  "subtitle": "A cinnamon apple dessert with a crisp pecan topping.",
  "description": "Sliced apples are seasoned with cinnamon and sugar, then baked beneath a simple pecan batter until golden and set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 65
  },
  "ingredients": [
    {
      "ingredient_id": "peeled",
      "item": "peeled",
      "quantity": 2.5,
      "unit": "cups",
      "preparation": "cored and sliced apples"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "lightly beaten"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Arrange the apples in a baking dish and sprinkle with the cinnamon and 1 teaspoon sugar."
    },
    {
      "step": 3,
      "text": "Stir the melted margarine and 1 cup sugar together, then mix in the beaten egg."
    },
    {
      "step": 4,
      "text": "Add the flour, pecans, and salt, stirring until combined."
    },
    {
      "step": 5,
      "text": "Spread the mixture over the apples."
    },
    {
      "step": 6,
      "text": "Bake for 65 minutes, until golden brown and the center is fully set or reaches 160°F on a food thermometer.",
      "timer_minutes": 65
    }
  ],
