  "id": "soft-gingersnaps",
  "name": "Soft Gingersnaps",
  "subtitle": "Tender spiced molasses cookies",
  "description": "Soft cookies with warm ginger, cinnamon, and clove flavor, finished with a light sugar coating.",
  "meal_type": "dessert",
