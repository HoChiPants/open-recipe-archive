  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk together the brown sugar, shortening, molasses, baking soda, ginger, cinnamon, cloves, and white sugar. Stir in the egg and half of the flour until combined."
    },
    {
      "step": 3,
      "text": "Stir in the remaining flour to form a soft dough."
    },
    {
      "step": 4,
      "text": "Shape the dough into small balls and roll them in the sugar mixture."
    },
    {
      "step": 5,
      "text": "Transfer the shaped cookies to a baking sheet and bake for 10 minutes, until the centers are firm and fully set or register at least 160°F.",
      "timer_minutes": 10
    }
  ],
