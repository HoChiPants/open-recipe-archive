  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Melt the butter in a saucepan, stir in the flour until smooth, then whisk in both sugars, water, and lemon juice. Simmer for 3 minutes, stirring occasionally.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Fit half of the thawed pastry into a pie dish. Arrange the apples and half of the blackberries inside, then pour the warm butter-sugar mixture over the fruit."
    },
    {
      "step": 3,
      "text": "Cut the remaining pastry into strips or shapes and arrange it over the filling. Seal the edges and leave openings for steam."
    },
    {
      "step": 4,
      "text": "Bake at 425°F for 15 minutes, then reduce the oven to 350°F and continue baking until the crust is golden and the filling is bubbling, about 40 minutes.",
      "timer_minutes": 55
    },
    {
      "step": 5,
      "text": "Let the pie cool before slicing."
    }
  ],
