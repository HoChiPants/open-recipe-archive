  "id": "chocolate-caramel-brownies",
  "name": "Chocolate Caramel Brownies",
  "subtitle": "Chewy brownies layered with caramel and chocolate",
  "description": "A simple pan of rich chocolate brownies with a soft caramel center and pecan crunch.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
