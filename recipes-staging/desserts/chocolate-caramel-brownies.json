  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Melt the caramels with 0.5 cup evaporated milk in a saucepan, stirring until smooth; set aside."
    },
    {
      "step": 2,
      "text": "Stir the cake mix, 0.33333334326744 cup evaporated milk, melted butter, pecans, and milk chocolate chips into a thick batter."
    },
    {
      "step": 3,
      "text": "Press half of the batter into a greased baking pan and bake for 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Remove the pan and spread the caramel mixture over the partially baked base. Add the remaining batter, spreading it as evenly as possible."
    },
    {
      "step": 5,
      "text": "Bake until the brownie center is set, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Cool completely in the pan before cutting into 15 servings."
    }
  ],
