  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Mix the graham cracker crumbs with the first melted butter, white sugar, and brown sugar. Press the mixture into the base of a suitable baking dish."
    },
    {
      "step": 2,
      "text": "Bake the crust for 6 minutes, until set, then cool completely.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Heat the oven to 400°F. Stir the remaining melted butter with the flour, oats, white sugar, brown sugar, and pecans to make a crumbly mixture."
    },
    {
      "step": 4,
      "text": "Spread the pecan-oat mixture in a baking dish and bake for 15 minutes. Cool, then break it into pieces.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Beat the cream cheese until smooth, then blend in the sweetened condensed milk. Fold in the thawed whipped topping and caramel topping."
    },
    {
      "step": 6,
      "text": "Layer the cooled crumb components with the filling in a suitable freezer-safe dish."
    },
    {
      "step": 7,
      "text": "Freeze for 4 hours, or until firm. Serve chilled.",
      "timer_minutes": 240
    }
  ],
