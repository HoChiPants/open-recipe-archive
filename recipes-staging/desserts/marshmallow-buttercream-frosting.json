  "id": "marshmallow-buttercream-frosting",
  "name": "Marshmallow Buttercream Frosting",
  "subtitle": "A fluffy frosting with marshmallow sweetness and almond flavor",
  "description": "Whipped butter, confectioners' sugar, almond extract, and marshmallow creme combine into a soft, spreadable frosting for cakes and cupcakes.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "cups",
      "preparation": "softened"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "13-ounce-jar-marshmallow-creme",
      "item": "(13 ounce) jar marshmallow creme",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened butter until smooth and creamy."
    },
    {
      "step": 2,
      "text": "Add the confectioners' sugar and whisk until fully blended."
    },
    {
      "step": 3,
      "text": "Whisk in the almond extract."
    },
    {
      "step": 4,
      "text": "Fold in the marshmallow creme until evenly incorporated and smooth."
    }
  ],
