  "id": "air-fryer-pavlova",
  "name": "Air Fryer Pavlova",
  "subtitle": "Crisp meringue with cream and seasonal fruit",
  "description": "A light meringue dessert with a crisp exterior, creamy topping, and fresh fruit.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 95
  },
  "ingredients": [
    {
      "ingredient_id": "egg-whites-freeze-the-yolks-for-another-recipe",
      "item": "egg whites (freeze the yolks for another recipe)",
      "quantity": 3
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 185,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "seasonal-fruit-chopped-into-bite-sized-pieces",
      "item": "seasonal fruit chopped into bite-sized pieces",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 250,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer to its pavlova or low-bake setting, following the appliance's temperature guidance."
    },
    {
      "step": 2,
      "text": "Whisk the egg whites to soft peaks. Gradually add the caster sugar, then whisk until the mixture is glossy and holds stiff peaks."
    },
    {
      "step": 3,
      "text": "Whisk in the vanilla extract, white wine vinegar, and cornflour until evenly incorporated.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Shape the meringue into a thick round on suitable air-fryer parchment or a lined tray."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until the outside is dry and the center is fully set; for egg safety, verify that the center reaches 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Turn off the air fryer and let the pavlova cool completely before removing it."
    },
    {
      "step": 7,
      "text": "Whisk the double cream with the icing sugar to soft peaks."
    },
    {
      "step": 8,
      "text": "Top the cooled pavlova with the cream and bite-sized seasonal fruit, then serve.",
      "timer_minutes": 20
    }
  ],
