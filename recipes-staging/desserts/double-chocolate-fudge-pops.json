{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "double-chocolate-fudge-pops",
  "name": "Double Chocolate Fudge Pops",
  "subtitle": "Creamy cocoa pops with chocolate-chip bites",
  "description": "A rich, pudding-like chocolate mixture is cooled, dotted with chocolate chips, and frozen into easy homemade pops.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5,
    "inactive_minutes": 260
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "miniature-semisweet-chocolate-chips",
      "item": "miniature semisweet chocolate chips",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "popsicle-molds",
      "item": "popsicle molds",
      "quantity": 8
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the sugar, cornstarch, cocoa powder, and milk together in a saucepan until smooth."
    },
    {
      "step": 2,
      "text": "Cook over medium heat, stirring constantly, until the mixture thickens, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Remove from the heat and stir in the vanilla extract and butter until blended. Let cool for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Mix in the chocolate chips, then divide the mixture among 8 popsicle molds."
    },
    {
      "step": 5,
      "text": "Freeze until firm, about 4 hours. Unmold and serve.",
      "timer_minutes": 240
    }
  ],
