{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "meringues",
  "name": "Meringues",
  "subtitle": "Crisp lemon-scented sweets",
  "description": "Light, crisp meringues flavored with lemon zest and baked until dry and set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 50,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 4
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "cream-of-tartar",
      "item": "cream of tartar",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 1.3333333730698,
      "unit": "cups"
    },
    {
      "ingredient_id": "grated-lemon-zest",
      "item": "grated lemon zest",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 275°F."
    },
    {
      "step": 2,
      "text": "Whisk the egg whites with the salt and cream of tartar until soft peaks form."
    },
    {
      "step": 3,
      "text": "Gradually add the sugar and whisk until stiff peaks form."
    },
    {
      "step": 4,
      "text": "Fold in the grated lemon zest."
    },
    {
      "step": 5,
      "text": "Prepare a baking surface and portion the meringue mixture into about 50 pieces."
    },
    {
      "step": 6,
      "text": "Bake for 35 minutes, until the meringues are dry and firm; for egg safety, confirm the centers are fully set.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Cool completely before serving."
    }
  ],
