  "id": "pumpkin-pie",
  "name": "Pumpkin Pie",
  "subtitle": "Roasted pumpkin filling in a deep-dish crust",
  "description": "Roast fresh pumpkins, blend them with a spiced cream-and-egg mixture, and bake the filling in two deep-dish crusts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
