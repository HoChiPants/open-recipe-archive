  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Arrange the halved, seeded pumpkins cut-side down on a baking sheet and roast until tender, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 2,
      "text": "Cool the pumpkins until set enough to handle, then scoop out the flesh.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Raise the oven temperature to 425°F. Combine the pumpkin flesh, demerara sugar, heavy whipping cream, sour cream, beaten eggs, flour, pumpkin pie spice, and salt; whisk until smooth."
    },
    {
      "step": 4,
      "text": "Divide the filling between the two unbaked deep-dish pie crusts and bake for about 45 minutes, until the centers are fully set and register 160°F on a food thermometer.",
      "timer_minutes": 45
    }
  ],
