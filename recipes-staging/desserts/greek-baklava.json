  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, 2 cups white sugar, cloves, cinnamon stick, and half of the lemon juice. Stir until the sugar dissolves, then stir in the remaining lemon juice. Chill the syrup for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Heat the oven to 350°F. Mix the walnuts with 1 cup white sugar, ground cinnamon, and nutmeg."
    },
    {
      "step": 3,
      "text": "Brush a baking pan with melted butter. Layer half of the phyllo sheets in the pan, brushing each sheet with butter as it is added."
    },
    {
      "step": 4,
      "text": "Spread the walnut mixture evenly over the phyllo. Cover with the remaining sheets, buttering each layer and the top surface."
    },
    {
      "step": 5,
      "text": "Cut the assembled baklava into portions before baking."
    },
    {
      "step": 6,
      "text": "Bake until golden brown, about 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Pour the chilled syrup evenly over the hot baklava. Let it stand until set, preferably overnight.",
      "timer_minutes": 480
    },
    {
      "step": 8,
      "text": "Freeze after the baklava has set."
    }
  ],
