  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
