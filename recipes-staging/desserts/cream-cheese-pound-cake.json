  "id": "cream-cheese-pound-cake",
  "name": "Cream Cheese Pound Cake",
  "subtitle": "A rich, vanilla-almond cake with a fine crumb.",
  "description": "Cream cheese and butter give this classic American pound cake a tender, rich texture and balanced flavor.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
