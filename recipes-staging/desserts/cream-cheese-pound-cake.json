      "item": "eggs",
      "quantity": 6
    },
    {
      "ingredient_id": "cake-flour",
      "item": "cake flour",
      "quantity": 3,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the butter, cream cheese, and white sugar until smooth and combined."
    },
    {
      "step": 3,
      "text": "Stir in the vanilla extract and almond extract."
    },
    {
      "step": 4,
      "text": "Add the eggs and cake flour, mixing until the batter is evenly combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan."
    },
    {
      "step": 6,
      "text": "Bake at 325°F for 60 minutes, until the center is firm and fully set or reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    }
  ],
