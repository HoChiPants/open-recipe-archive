  "id": "raspberry-oatmeal-bars",
  "name": "Raspberry Oatmeal Bars",
  "subtitle": "Oat-filled bars with a raspberry center",
  "description": "A simple baked dessert made with an oat crumble mixture and raspberry jam.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "yellow-cake-mix",
      "item": "yellow cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "quick-cooking-oats",
      "item": "quick cooking oats",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "raspberry-jam",
      "item": "raspberry jam",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Prepare a baking pan for the bars."
    },
    {
      "step": 2,
      "text": "Combine the cake mix, oats, and melted margarine to form a crumbly mixture. Reserve some of the mixture for the topping, then press the remainder into the pan."
    },
    {
      "step": 3,
      "text": "Stir the water into the raspberry jam and spread the mixture over the oat base."
    },
    {
      "step": 4,
      "text": "Scatter the reserved crumb mixture over the jam. Bake until lightly browned, about 23 minutes.",
      "timer_minutes": 23
    },
    {
      "step": 5,
      "text": "Cool completely before cutting into bars."
    }
  ],
