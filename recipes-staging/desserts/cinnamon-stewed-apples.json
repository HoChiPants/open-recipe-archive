  "id": "cinnamon-stewed-apples",
  "name": "Cinnamon-Stewed Apples",
  "subtitle": "Tender apples with cinnamon and raisins",
  "description": "Warm cinnamon-scented apples served with yogurt and optional maple syrup.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "sweet-eating-apples-about-600g",
      "item": "sweet eating apples (about 600g)",
      "quantity": 5,
      "preparation": "such as Gala or Fuji, peeled, cored and chopped"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "fat-free-greek-or-non-dairy-yogurt-to-serve",
      "item": "fat-free Greek or non-dairy yogurt to serve",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup (optional)",
      "quantity": 4,
      "unit": "tsp",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the chopped apples, cinnamon, and raisins in a saucepan."
    },
    {
      "step": 2,
      "text": "Cook over medium-low heat for 15 minutes, stirring occasionally, until the apples are tender and lightly stewed.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Divide among four servings and top with yogurt. Drizzle with maple syrup if using."
    }
  ],
