  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a cake pan."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, white sugar, salt, baking soda, and packed brown sugar."
    },
    {
      "step": 3,
      "text": "Stir the oil, beaten eggs, and vanilla extract together, then mix them into the dry ingredients."
    },
    {
      "step": 4,
      "text": "Fold in the chopped apples and walnuts, transfer the batter to the pan, and bake until the center is firm and reaches 160°F on a food thermometer."
    },
    {
      "step": 5,
      "text": "Combine the white sugar, packed brown sugar, butter, and milk in a saucepan. Simmer, stirring, until thickened.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Transfer the warm sauce over the baked cake and serve."
    }
  ],
