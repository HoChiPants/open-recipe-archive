  "id": "apple-walnut-cake",
  "name": "Apple Walnut Cake",
  "subtitle": "Tender apple cake with a buttery brown-sugar topping",
  "description": "A warmly spiced-style apple and walnut cake finished with a thickened butter-and-sugar sauce.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
