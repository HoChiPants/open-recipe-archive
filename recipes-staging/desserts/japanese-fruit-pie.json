  "id": "japanese-fruit-pie",
  "name": "Japanese Fruit Pie",
  "subtitle": "A sweet pecan, coconut, and raisin pie with a tender egg filling.",
  "description": "Fill an unbaked pie shell with a smooth mixture of eggs, butter, sugar, vinegar, vanilla, pecans, coconut, and raisins, then bake until set.",
  "meal_type": "dessert",
  "cuisine": "Japanese",
