    {
      "ingredient_id": "gold-lustre-to-decorate-optional",
      "item": "gold lustre to decorate (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the mixed dried fruit with the rum or brandy, clementine zest and juice, and cinnamon. Cool the mixture completely.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Lightly oil the pudding basin. Cut the Christmas pudding into small cubes if needed."
    },
    {
      "step": 3,
      "text": "Whisk the vanilla ice cream, Christmas pudding, and double cream until evenly combined. Fold in the cooled fruit mixture.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Spoon the mixture into the oiled basin and smooth the surface. Freeze until firm.",
      "timer_minutes": 360
    },
    {
      "step": 5,
      "text": "Warm the vanilla ice cream and double cream, then whisk in the chopped dark chocolate until melted. Cool the sauce.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Let the frozen bombe stand for 10 minutes, then unmold onto a serving plate.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Add the chocolate sauce and decorate with dried cranberries or glacé cherries, holly leaves or fresh bay leaves if using, and gold lustre if using. Serve."
    }
  ],
