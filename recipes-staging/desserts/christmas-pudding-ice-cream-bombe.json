  "id": "christmas-pudding-ice-cream-bombe",
  "name": "Christmas Pudding Ice Cream Bombe",
  "subtitle": "A frozen dessert with spiced fruit, pudding, and chocolate sauce",
  "description": "Vanilla ice cream, dried fruit, citrus, and Christmas pudding are molded, frozen, and served with warm chocolate sauce and festive garnish.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "vanilla-ice-cream",
      "item": "vanilla ice cream",
      "quantity": 750,
      "unit": "ml"
    },
    {
      "ingredient_id": "mixed-dried-fruit",
      "item": "mixed dried fruit",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "rum-or-brandy",
      "item": "rum or brandy",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "clementine-zested-and-juiced",
      "item": "clementine zested and juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "sunflower-oil-for-the-pudding-basin",
      "item": "sunflower oil for the pudding basin"
    },
    {
      "ingredient_id": "free-from-christmas-pudding-leftover",
      "item": "free from Christmas Pudding leftover",
      "quantity": 150,
      "unit": "g",
      "preparation": "or cooked and cooled, cut into small cubes"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 80,
      "unit": "ml"
    },
    {
      "ingredient_id": "dark-chocolate-finely-chopped",
      "item": "dark chocolate finely chopped",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "handful-of-dried-cranberries-or-glace-cherries",
      "item": "handful of dried cranberries or glacé cherries",
      "unit": "small"
    },
    {
      "ingredient_id": "few-holly-leaves-or-fresh-bay-leaves-optional",
      "item": "few holly leaves or fresh bay leaves (optional)",
      "optional": true
