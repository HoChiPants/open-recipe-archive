  "id": "gooey-butter-cake",
  "name": "Gooey Butter Cake",
  "subtitle": "A soft cake base with a rich, creamy topping",
  "description": "This American dessert combines a buttery cake layer with a smooth cream cheese topping and a light dusting of confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "yellow-cake-mix",
      "item": "yellow cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "15.25 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce, plus more for dusting"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Prepare a baking pan for the cake."
    },
    {
      "step": 3,
      "text": "Combine the yellow cake mix with 2 eggs. Add the melted butter and vanilla extract, then mix until smooth."
    },
    {
      "step": 4,
      "text": "Transfer the cake mixture to the prepared pan and spread it evenly."
    },
    {
      "step": 5,
      "text": "Whisk the remaining 2 eggs with the confectioners' sugar and softened cream cheese until smooth."
    },
    {
      "step": 6,
      "text": "Pour the cream cheese mixture over the cake layer."
    },
    {
      "step": 7,
      "text": "Bake for 35 minutes, until the center is fully set.",
      "timer_minutes": 35
    },
    {
      "step": 8,
      "text": "Cool completely before dusting with additional confectioners' sugar and cutting into servings."
    }
  ],
