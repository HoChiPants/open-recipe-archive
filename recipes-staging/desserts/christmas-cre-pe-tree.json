{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "christmas-cre-pe-tree",
  "name": "Christmas Crêpe Tree",
  "subtitle": "A festive stack of thin crêpes with fruit and sweet spread",
  "description": "Layer tender crêpes with fruit curd or chocolate spread, then arrange fruit on top for a simple holiday dessert.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "medium"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "butter-for-frying",
      "item": "butter for frying"
    },
    {
      "ingredient_id": "fruit-curd-or-chocolate-spread-to-serve",
      "item": "fruit curd or chocolate spread to serve",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "banana-slices-and-fresh-or-frozen-blueberries-and-raspberries-defrosted",
      "item": "banana slices and fresh or frozen blueberries and raspberries (defrosted",
      "preparation": "if frozen), to decorate"
    },
    {
      "ingredient_id": "icing-sugar-for-dusting",
      "item": "icing sugar for dusting"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, eggs, and milk until the batter is smooth."
    },
    {
      "step": 2,
      "text": "Heat a frying pan and melt a little butter in it."
    },
    {
      "step": 3,
      "text": "Cook thin crêpes in the pan, about 1 minute per side, until set and lightly colored. Repeat with the remaining batter, adding butter as needed.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Spread fruit curd or chocolate spread between the crêpes and stack them into a tree shape."
    },
    {
      "step": 5,
      "text": "Decorate with banana slices, blueberries, and raspberries, then dust with icing sugar."
    }
  ],
