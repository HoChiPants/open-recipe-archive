  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour and frozen butter, then mix in the caster sugar. Knead briefly to form a dough, cover, and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Stir the blueberries with the flour, caster sugar, cornflour, cinnamon, lemon zest, and lemon juice."
    },
    {
      "step": 3,
      "text": "Roll out the chilled dough on a floured surface. Line the pie dish, reserving enough dough for the top crust."
    },
    {
      "step": 4,
      "text": "Cut the remaining dough into strips or shapes and arrange them over the filling. Trim and seal the edges, then chill the assembled pie for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Preheat the oven. Whisk the egg with the milk and brush it over the pastry. Sprinkle with the reserved caster sugar."
    },
    {
      "step": 6,
      "text": "Bake for 60 minutes, or until the pastry is golden and the center is fully set and reaches 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Cool the pie before slicing and serve with ice cream or whipped cream."
    }
  ],
