  "id": "blueberry-pie",
  "name": "Blueberry Pie",
  "subtitle": "A flaky pastry pie filled with lemon-bright blueberries",
  "description": "Prepare a chilled butter pastry, fill it with seasoned blueberries, and bake until golden with a fully set center. Serve with ice cream or whipped cream.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
