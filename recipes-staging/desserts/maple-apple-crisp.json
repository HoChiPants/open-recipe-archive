{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "maple-apple-crisp",
  "name": "Maple Apple Crisp",
  "subtitle": "Tender apples beneath a crisp oat topping",
  "description": "Sliced apples are sweetened with maple syrup and covered with a buttery oat topping, then baked until golden.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "apples",
      "item": "apples",
      "quantity": 5,
      "preparation": "peeled, cored, and sliced"
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "softened"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Place the apples in a baking dish and toss them with the maple syrup."
    },
    {
      "step": 3,
      "text": "Combine the flour, rolled oats, brown sugar, and salt in a bowl."
    },
    {
      "step": 4,
      "text": "Work the softened butter into the dry mixture until coarse crumbs form."
    },
    {
      "step": 5,
      "text": "Scatter the topping evenly over the apples."
    },
    {
      "step": 6,
      "text": "Bake for 35 minutes, until the topping is golden brown.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Serve warm."
    }
  ],
