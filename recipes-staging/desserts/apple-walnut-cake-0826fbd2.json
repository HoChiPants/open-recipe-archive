  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a cake pan."
    },
    {
      "step": 2,
      "text": "Cut the peeled, cored apples into small pieces and sift the flour."
    },
    {
      "step": 3,
      "text": "Whisk the eggs and sugar until blended, then mix in the vegetable oil."
    },
    {
      "step": 4,
      "text": "Stir in the baking soda, cinnamon, and vanilla. Add the flour and mix just until combined."
    },
    {
      "step": 5,
      "text": "Fold in the apples and walnuts, then transfer the batter to the prepared pan."
    },
    {
      "step": 6,
      "text": "Bake for 55 minutes, or until the center is set and a tester comes out clean.",
      "timer_minutes": 55
    },
    {
      "step": 7,
      "text": "Cool the cake before cutting and serving."
    }
  ],
