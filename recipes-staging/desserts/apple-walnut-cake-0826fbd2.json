  "id": "apple-walnut-cake-0826fbd2",
  "name": "Apple Walnut Cake",
  "subtitle": "A tender spiced cake filled with fresh apples and chopped walnuts.",
  "description": "This simple baked cake combines cinnamon, vanilla, apples, and walnuts in a lightly sweet batter.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
