  "id": "pumpkin-cannoli",
  "name": "Pumpkin Cannoli",
  "subtitle": "Creamy pumpkin filling in crisp cannoli shells",
  "description": "Fill cannoli shells with a smooth pumpkin-cheese mixture folded with whipped cream, then finish with sprinkles and confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "canned-pumpkin",
      "item": "canned pumpkin",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "mascarpone-cheese",
      "item": "mascarpone cheese",
      "quantity": 4,
      "unit": "ounces"
    },
    {
      "ingredient_id": "ricotta-cheese",
      "item": "ricotta cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "instant-vanilla-pudding-mix",
      "item": "instant vanilla pudding mix",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "pumpkin-pie-spice",
      "item": "pumpkin pie spice",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cannoli-shells",
      "item": "cannoli shells",
      "quantity": 12,
      "unit": "large"
    },
    {
      "ingredient_id": "sprinkles",
      "item": "sprinkles",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or as desired"
    },
    {
      "ingredient_id": "confectioners-sugar-for-dusting",
      "item": "confectioners' sugar for dusting",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Beat the confectioners' sugar, pumpkin, mascarpone, ricotta, pudding mix, pumpkin pie spice, and confectioners' sugar for dusting until smooth."
    },
    {
      "step": 2,
      "text": "Whisk the heavy whipping cream to stiff peaks."
    },
    {
      "step": 3,
      "text": "Fold the whipped cream into the pumpkin mixture until evenly combined."
    },
    {
      "step": 4,
      "text": "Spoon or pipe the filling into the cannoli shells."
    },
    {
      "step": 5,
      "text": "Garnish with sprinkles and dust with confectioners' sugar."
    }
  ],
