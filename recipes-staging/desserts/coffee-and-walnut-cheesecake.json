  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "coffee-and-walnut-cheesecake",
  "name": "Coffee and Walnut Cheesecake",
  "subtitle": "A chilled, creamy dessert with espresso and walnut flavor.",
  "description": "A no-bake cheesecake with a biscuit-and-walnut base, smooth coffee filling, and softly whipped cream topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 0,
    "inactive_minutes": 360
  },
  "ingredients": [
    {
      "ingredient_id": "digestive-biscuits",
      "item": "digestive biscuits",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "instant-espresso-powder-use-decaffeinated-to-make-the-cheesecake-child-friendly",
      "item": "instant espresso powder (use decaffeinated to make the cheesecake child-friendly)",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "soft-cheese",
      "item": "soft cheese",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 90,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 40,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Crush the biscuits and 50 g walnuts into fine crumbs. Stir in half of the espresso powder."
    },
    {
      "step": 2,
      "text": "Melt the butter, mix it with the crumb mixture, and press firmly into the base of a lined 20 cm springform tin."
    },
    {
      "step": 3,
      "text": "Dissolve the remaining espresso powder in a small spoonful of the measured cream, then let it cool."
    },
    {
      "step": 4,
      "text": "Beat the soft cheese, 90 g icing sugar, and vanilla until smooth. Add the 300 ml cream and whisk until thickened, then mix in the cooled espresso mixture."
    },
    {
      "step": 5,
      "text": "Spread the filling over the crust and refrigerate for at least 6 hours, until set.",
      "timer_minutes": 360
    },
    {
      "step": 6,
      "text": "Whisk the 150 ml cream with 2 tbsp icing sugar to soft peaks. Spoon or pipe it over the cheesecake and finish with the remaining walnuts."
    },
    {
      "step": 7,
      "text": "Remove the cheesecake from the tin, slice, and serve chilled."
    }
  ],
