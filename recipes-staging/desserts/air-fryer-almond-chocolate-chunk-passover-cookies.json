  "id": "air-fryer-almond-chocolate-chunk-passover-cookies",
  "name": "Air-Fryer Almond Chocolate Chunk Passover Cookies",
  "subtitle": "Small-batch cookies with crisp edges and chocolate pieces",
  "description": "A gluten-free, dairy-free cookie dough made with almond flour, potato flour, and chocolate chunks, then baked in an air fryer until golden and firm.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-essence",
      "item": "vanilla essence",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg-beaten",
      "item": "egg beaten",
      "quantity": 1
    },
    {
      "ingredient_id": "almond-flour-or-ground-almonds-or-half-of-each",
      "item": "almond flour or ground almonds (or half of each)",
      "quantity": 180,
      "unit": "g"
    },
    {
      "ingredient_id": "potato-flour",
      "item": "potato flour",
      "quantity": 80,
      "unit": "g"
    },
    {
      "ingredient_id": "kosher-baking-powder",
      "item": "kosher baking powder",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "kosher-bicarbonate-of-soda",
      "item": "kosher bicarbonate of soda",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "dairy-free-dark-chocolate-chunks-or-chips",
      "item": "dairy-free dark chocolate chunks or chips",
      "quantity": "100-150",
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer using its baking setting."
    },
    {
      "step": 2,
      "text": "Stir the light brown soft sugar, caster sugar, vanilla essence, and egg beaten together. In a separate bowl, combine the almond flour or ground almonds (or half of each), potato flour, kosher baking powder, and kosher bicarbonate of soda."
    },
    {
      "step": 3,
      "text": "Add the dry mixture to the wet mixture and stir until combined. Fold in the dairy-free dark chocolate chunks or chips."
    },
    {
      "step": 4,
      "text": "Prepare the air-fryer basket or pan, then transfer portions of dough into it with space between them."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, or until golden brown and the centers are firm and fully set; verify an egg-containing center reaches 160°F if checking with a thermometer.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Cool the cookies for 10 minutes, until firm.",
      "timer_minutes": 10
    }
  ],
