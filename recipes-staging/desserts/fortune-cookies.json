  "id": "fortune-cookies",
  "name": "Fortune Cookies",
  "subtitle": "Crisp folded cookies with handwritten fortunes",
  "description": "Bake thin rounds of almond-vanilla batter, then quickly fold each around a paper fortune while warm.",
  "meal_type": "dessert",
  "cuisine": "Chinese",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "custom-or-prepared-paper-fortunes",
      "item": "Custom or prepared paper fortunes"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "melted"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "or more as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the paper fortunes into small strips. Preheat the oven to 350°F and prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Whisk the sugar, egg white, milk, melted butter, vanilla extract, almond extract, and salt until combined. Add the flour and whisk until smooth."
    },
    {
      "step": 3,
      "text": "Place small portions of batter on the baking sheet and spread each into a thin round, leaving space between them."
    },
    {
      "step": 4,
      "text": "Bake for about 10 minutes, until golden brown and the centers are fully set; verify with a food thermometer that the egg-containing cookies reach 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Working one at a time while the cookies are hot, place a paper fortune in the center, fold the round over it, and gently bend the folded cookie over the rim of a cup or bowl to form the characteristic curve."
    },
    {
      "step": 6,
      "text": "Set the shaped cookies aside to cool and crisp. Repeat with the remaining batter and fortunes."
    }
  ],
