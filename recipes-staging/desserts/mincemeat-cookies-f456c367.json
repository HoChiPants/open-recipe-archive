  "id": "mincemeat-cookies-f456c367",
  "name": "Mincemeat Cookies",
  "subtitle": "Tender cookies with spiced fruit filling",
  "description": "Brown sugar and shortening cookies folded with prepared mincemeat filling, then baked until golden and set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "prepared-mincemeat-pie-filling",
      "item": "prepared mincemeat pie filling",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 1.5,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Whisk the brown sugar and shortening until well combined, then mix in the egg."
    },
    {
      "step": 3,
      "text": "Stir in the prepared mincemeat pie filling."
    },
    {
      "step": 4,
      "text": "In a separate bowl, combine the flour, salt, and baking soda. Stir the dry mixture into the mincemeat mixture until a dough forms."
    },
    {
      "step": 5,
      "text": "Portion the dough onto baking sheets, leaving space between cookies."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, until golden brown and the centers are fully set.",
      "timer_minutes": 10
    }
  ],
