{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "brown-sugar-sauce",
  "name": "Brown Sugar Sauce",
  "subtitle": "Warm, buttery sauce for desserts",
  "description": "A quick stovetop sauce with caramelized brown sugar, vanilla, and a smooth buttery finish.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "boiling-water",
      "item": "boiling water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Whisk in the flour and salt until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the brown sugar and cook for 5 minutes, until lightly browned.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Gradually stir in the boiling water. Bring the mixture to a boil, then cook until smooth."
    },
    {
      "step": 5,
      "text": "Stir in the vanilla extract and serve warm."
    }
  ],
