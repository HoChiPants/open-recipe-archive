  "id": "soda-cracker-pie",
  "name": "Soda Cracker Pie",
  "subtitle": "A crisp, nutty baked dessert with a light meringue-like texture.",
  "description": "Whisked egg whites and sugar are folded with crushed crackers, pecans, vanilla, and baking powder, then baked until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 3
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "soda-crackers",
      "item": "soda crackers",
      "quantity": 20,
      "preparation": "finely crushed"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Whisk the egg whites and white sugar together until well combined."
    },
    {
      "step": 3,
      "text": "Fold in the white sugar, baking powder, finely crushed soda crackers, vanilla extract, and chopped pecans."
    },
    {
      "step": 4,
      "text": "Prepare a pie pan and transfer the mixture into it."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until the center is firm and fully set; for a safety check, it should reach 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool before serving."
    }
  ],
