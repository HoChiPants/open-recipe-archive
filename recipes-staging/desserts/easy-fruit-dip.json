  "id": "easy-fruit-dip",
  "name": "Easy Fruit Dip",
  "subtitle": "A creamy, cherry-scented dip for fresh fruit",
  "description": "Whisk together a fluffy marshmallow base, softened cream cheese, and cherry juice, then chill before serving with fruit.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "marshmallow-creme",
      "item": "marshmallow creme",
      "quantity": 16,
      "unit": "ounces"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "maraschino-cherry-juice",
      "item": "maraschino cherry juice",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the marshmallow creme and softened cream cheese together until smooth."
    },
    {
      "step": 2,
      "text": "Transfer the mixture to a serving bowl and whisk in the maraschino cherry juice."
    },
    {
      "step": 3,
      "text": "Chill until ready to serve."
    }
  ],
