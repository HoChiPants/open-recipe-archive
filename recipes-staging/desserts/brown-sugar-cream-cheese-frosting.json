{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "brown-sugar-cream-cheese-frosting",
  "name": "Brown Sugar Cream Cheese Frosting",
  "subtitle": "A smooth, lightly honeyed frosting for cakes and cupcakes",
  "description": "Cream cheese, brown sugar, butter, honey, and two extracts make a rich frosting with warm caramel notes.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "light-brown-sugar",
      "item": "light brown sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Let the butter cool until it is no longer warm."
    },
    {
      "step": 2,
      "text": "Combine the softened cream cheese, cooled butter, brown sugar, vanilla extract, and almond extract in a bowl. Whisk until smooth and evenly blended."
    },
    {
      "step": 3,
      "text": "Add the honey and whisk until fully incorporated and the frosting is smooth."
    },
    {
      "step": 4,
      "text": "Transfer the frosting to a serving or storage container."
    }
  ],
