  "id": "hot-fudge-pudding-cake",
  "name": "Hot Fudge Pudding Cake",
  "subtitle": "Warm chocolate cake with a self-made fudge sauce",
  "description": "A simple baked chocolate dessert that forms a rich pudding layer beneath a tender walnut-studded cake.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "hot-water",
      "item": "hot water",
      "quantity": 1.75,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Lightly grease a 9-inch square baking dish."
    },
    {
      "step": 2,
      "text": "Whisk the flour, white sugar, 2 tablespoons cocoa powder, baking powder, and salt in a bowl."
    },
    {
      "step": 3,
      "text": "Stir in the milk and melted butter until smooth, then fold in the walnuts. Spread the batter in the prepared dish."
    },
    {
      "step": 4,
      "text": "Mix the brown sugar with the remaining cocoa powder and sprinkle evenly over the batter."
    },
    {
      "step": 5,
      "text": "Pour the hot water gently over the surface without stirring."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, until the cake is set and a fudgy sauce remains underneath. Serve warm.",
      "timer_minutes": 45
    }
  ],
