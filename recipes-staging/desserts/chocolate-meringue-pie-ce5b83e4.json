  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Separate the eggs, keeping the whites for the meringue."
    },
    {
      "step": 2,
      "text": "Whisk 0.75 cup white sugar, cocoa powder, cornstarch, and salt in a saucepan. Gradually whisk in the milk and cook, stirring, until thickened.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Beat the egg yolks. Slowly whisk in some of the hot chocolate mixture, then return the yolk mixture to the saucepan. Cook and stir until the filling is set.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Remove from the heat, stir in the vanilla, and pour the filling into the baked pie crust."
    },
    {
      "step": 5,
      "text": "Whisk the egg whites with the cream of tartar until soft peaks form. Gradually add the 6 tablespoons white sugar and continue whisking to stiff peaks."
    },
    {
      "step": 6,
      "text": "Spread the meringue over the filling, sealing it to the crust edges. Bake at 350°F until the meringue is set and lightly browned.",
      "timer_minutes": 15
    }
  ],
