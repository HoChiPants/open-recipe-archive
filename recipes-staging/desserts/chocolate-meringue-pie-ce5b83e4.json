  "id": "chocolate-meringue-pie-ce5b83e4",
  "name": "Chocolate Meringue Pie",
  "subtitle": "Chocolate custard under a toasted meringue",
  "description": "A baked pie crust filled with chocolate custard and finished with a light meringue topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
