  "id": "brown-sugar-blondies",
  "name": "Brown Sugar Blondies",
  "subtitle": "Chewy blondies with walnuts and vanilla",
  "description": "A simple brown sugar dessert with a tender, chewy center and chopped walnuts throughout.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "packed-light-brown-sugar",
      "item": "packed light brown sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the flour, baking powder, and salt together."
    },
    {
      "step": 3,
      "text": "Mix the melted butter, brown sugar, eggs, and vanilla until smooth. Fold in the dry mixture and walnuts."
    },
    {
      "step": 4,
      "text": "Transfer the batter to a baking pan and spread it evenly."
    },
    {
      "step": 5,
      "text": "Bake until the edges are set, the center is fully set, and the center reaches 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Let the blondies cool before cutting into 16 servings.",
      "timer_minutes": 10
    }
  ],
