  "ingredients": [
    {
      "ingredient_id": "chocolate-sandwich-cookies",
      "item": "chocolate sandwich cookies",
      "quantity": 1,
      "unit": "pound",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "vanilla-flavored-candy-coating",
      "item": "vanilla-flavored candy coating",
      "quantity": 1,
      "unit": "pound",
      "preparation": "melted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the crushed chocolate sandwich cookies with the softened cream cheese until evenly combined."
    },
    {
      "step": 2,
      "text": "Shape the mixture into 36 equal balls, then coat each one with the melted vanilla-flavored candy coating."
    },
    {
      "step": 3,
      "text": "Arrange the coated balls on a lined tray and refrigerate until set.",
      "timer_minutes": 30
    }
