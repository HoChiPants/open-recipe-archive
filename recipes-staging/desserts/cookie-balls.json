  "id": "cookie-balls",
  "name": "Cookie Balls",
  "subtitle": "No-Bake Chocolate Cookie Truffles",
  "description": "Crushed chocolate cookies and softened cream cheese form bite-size balls finished with a vanilla coating.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
