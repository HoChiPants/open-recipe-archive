  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Combine 1.5 cups flour, baking powder, white sugar, and salt. Cut in the shortening until the mixture is crumbly."
    },
    {
      "step": 3,
      "text": "Whisk the milk, egg, and vanilla together, then stir them into the flour mixture just until combined."
    },
    {
      "step": 4,
      "text": "Transfer the batter to a baking pan."
    },
    {
      "step": 5,
      "text": "Mix the brown sugar, 2 tablespoons flour, and cinnamon. Stir in the melted butter, then scatter the topping over the batter."
    },
    {
      "step": 6,
      "text": "Bake for 20 minutes, or until the center is firm and a thermometer inserted into the center reads 160°F.",
      "timer_minutes": 20
    }
  ],
