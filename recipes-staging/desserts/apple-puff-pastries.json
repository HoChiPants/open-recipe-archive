  "id": "apple-puff-pastries",
  "name": "Apple Puff Pastries",
  "subtitle": "Flaky pastry parcels with warm cinnamon apples",
  "description": "Tender apples sweetened with honey and brown sugar are wrapped in puff pastry and baked until golden.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "apples",
      "item": "apples",
      "quantity": 2,
      "preparation": "peeled and diced"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sheet-puff-pastry",
      "item": "sheet puff pastry",
      "quantity": 1,
      "preparation": "cut into 8 squares"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the apples, honey, brown sugar, and cinnamon in a saucepan. Simmer until the apples are tender.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Divide the apple filling among the puff pastry squares. Fold the pastry over the filling and seal the edges, then arrange on a baking sheet."
    },
    {
      "step": 4,
      "text": "Bake until the pastries are golden brown.",
      "timer_minutes": 25
    }
