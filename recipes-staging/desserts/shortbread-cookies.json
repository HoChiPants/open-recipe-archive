  "id": "shortbread-cookies",
  "name": "Shortbread Cookies",
  "subtitle": "Butter, flour, and powdered sugar cookies with cherry toppings",
  "description": "Mix butter, flour, and confectioners' sugar into a dough, shape into small cookies, top with maraschino cherries, and bake until lightly browned.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "maraschino-cherries",
      "item": "maraschino cherries",
      "quantity": 12
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine butter, all-purpose flour, and confectioners' sugar in a mixing bowl."
    },
    {
      "step": 3,
      "text": "Whisk the mixture for 10 minutes until blended into a smooth dough.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Shape the dough into individual cookies and place them on a lined baking sheet."
    },
    {
      "step": 5,
      "text": "Top each cookie with a maraschino cherry."
    },
    {
      "step": 6,
      "text": "Bake at 350°F for 18 minutes until the edges are lightly browned.",
      "timer_minutes": 18
    }
  ],
