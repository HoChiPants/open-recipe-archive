  "id": "cherry-and-pistachio-no-churn-ice-cream",
  "name": "Cherry and Pistachio No-Churn Ice Cream",
  "subtitle": "Creamy cherry ice cream with pistachio butter and toasted nuts",
  "description": "A simple no-churn dessert combining thickened lemon cherries with a pistachio cream base and crunchy chopped pistachios.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-cherries-pitted",
      "item": "fresh cherries pitted",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-zested-and-juiced",
      "item": "lemon zested and juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 600,
      "unit": "ml"
    },
    {
      "ingredient_id": "pistachio-butter",
      "item": "pistachio butter",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "condensed-milk",
      "item": "condensed milk",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "pistachios-shelled",
      "item": "pistachios shelled",
      "quantity": 50,
      "unit": "g",
      "preparation": "toasted and finely chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the cherries, lemon zest and juice, sugar, and cornflour in a saucepan."
    },
    {
      "step": 2,
      "text": "Cook over medium heat for 15 minutes, stirring occasionally, until the fruit mixture thickens.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Let the cherry mixture cool completely."
    },
    {
      "step": 4,
      "text": "Whisk the double cream, pistachio butter, and condensed milk until soft peaks form."
    },
    {
      "step": 5,
      "text": "Fold the cooled cherry mixture into the cream base, then stir in the chopped pistachios."
    },
    {
      "step": 6,
      "text": "Transfer to a freezer-safe container and freeze until firm, about 6 hours.",
      "timer_minutes": 360
    },
    {
      "step": 7,
      "text": "Let the ice cream stand at room temperature for 5 minutes before scooping.",
      "timer_minutes": 5
    }
  ],
