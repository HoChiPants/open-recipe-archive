{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "greek-butter-cookies",
  "name": "Greek Butter Cookies",
  "subtitle": "Tender almond-scented cookies with a sugared finish",
  "description": "Rich butter cookies flavored with vanilla and almond, baked until set and finished with confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "Greek",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "confectioners-sugar-for-dusting",
      "item": "confectioners' sugar for dusting",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Beat the softened butter, white sugar, and confectioners' sugar until smooth."
    },
    {
      "step": 3,
      "text": "Mix in the egg, vanilla extract, and almond extract until combined."
    },
    {
      "step": 4,
      "text": "Blend in the flour just until a cohesive dough forms."
    },
    {
      "step": 5,
      "text": "Shape the dough into small cookies and transfer them to the prepared baking sheet."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, until the cookies are set and the center reaches 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Cool the cookies, then dust with confectioners' sugar."
    }
  ],
