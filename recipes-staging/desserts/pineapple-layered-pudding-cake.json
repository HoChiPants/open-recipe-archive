  "instructions": [
    {
      "step": 1,
      "text": "Prepare the yellow cake mix according to its package directions, then fold in the crushed pineapple with its juice and white sugar."
    },
    {
      "step": 2,
      "text": "Spread the batter in a prepared baking pan and bake in a preheated 350°F oven for about 20 minutes, until set. Cool completely.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Whisk the instant vanilla pudding mix with the milk until smooth. Spread the pudding over the cooled cake."
    },
    {
      "step": 4,
      "text": "Whisk the heavy whipping cream until thickened. Add the confectioners' sugar and vanilla extract, then continue whisking to soft peaks."
    },
    {
      "step": 5,
      "text": "Spread the whipped cream over the pudding layer. Cover and chill overnight.",
      "timer_minutes": 1440
    },
    {
      "step": 6,
      "text": "Top with the toasted coconut and chopped pecans before serving."
    }
  ],
