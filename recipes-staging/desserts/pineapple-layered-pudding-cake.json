  "id": "pineapple-layered-pudding-cake",
  "name": "Pineapple Layered Pudding Cake",
  "subtitle": "A chilled yellow cake with pineapple, vanilla pudding, and whipped cream",
  "description": "Bake a pineapple-studded cake, layer it with vanilla pudding and sweetened whipped cream, then chill overnight and finish with toasted coconut and pecans.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
