  "id": "strawberry-cupcakes",
  "name": "Strawberry Cupcakes",
  "subtitle": "Tender cupcakes with concentrated strawberry flavor",
  "description": "Light strawberry cupcakes made with freeze-dried berries, butter, milk, and vanilla.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "freeze-dried-strawberries",
      "item": "freeze-dried strawberries",
      "quantity": 1.25,
      "unit": "ounces"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "cake-flour",
      "item": "cake flour",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.3333333730698,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "room temperature"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "preparation": "room temperature"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 0.66666668653488,
      "unit": "cup",
      "preparation": "room temperature"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and line cupcake pans for 20 cupcakes."
    },
    {
      "step": 2,
      "text": "Crush the freeze-dried strawberries with the baking powder until finely powdered. Whisk with the all-purpose flour, cake flour, baking soda, and salt."
    },
    {
      "step": 3,
      "text": "Beat the sugar and room-temperature butter until combined and creamy. Add the eggs one at a time, then stir in the vanilla."
    },
    {
      "step": 4,
      "text": "Add the dry mixture and milk alternately, beginning and ending with the dry ingredients. Mix just until the batter is combined."
    },
    {
      "step": 5,
      "text": "Divide the batter among the liners, filling each about two-thirds full."
    },
    {
      "step": 6,
      "text": "Bake until the cupcakes are set and a tester inserted in the center comes out clean, about 18 to 20 minutes. Cool before serving.",
      "timer_minutes": 20
    }
  ],
