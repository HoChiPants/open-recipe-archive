  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Melt the butter and combine it with the graham cracker crumbs. Press the mixture into the bottom of a baking pan."
    },
    {
      "step": 3,
      "text": "Layer the coconut, walnuts, chocolate chips, miniature marshmallows, and semisweet chocolate squares over the crust."
    },
    {
      "step": 4,
      "text": "Pour the sweetened condensed milk evenly over the layers."
    },
    {
      "step": 5,
      "text": "Bake at 350°F until golden brown, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Melt the chocolate chips and semisweet chocolate squares, then spread the melted chocolate over the baked dessert."
    },
    {
      "step": 7,
      "text": "Cool until firm, then cut into squares."
    }
  ],
