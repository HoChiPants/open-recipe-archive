  "id": "rocky-road-squares",
  "name": "Rocky Road Squares",
  "subtitle": "A layered chocolate, coconut, walnut, and marshmallow dessert",
  "description": "A rich layered bar with a buttery graham base, chocolate, coconut, walnuts, and marshmallows.",
  "meal_type": "dessert",
