  "id": "butterscotch-budino",
  "name": "Butterscotch Budino",
  "subtitle": "Silky brown-sugar custards with a rum finish",
  "description": "A rich Italian-style butterscotch custard made with caramelized brown sugar, cream, milk, and eggs, then chilled until set.",
  "meal_type": "dessert",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
