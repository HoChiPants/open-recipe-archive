  "instructions": [
    {
      "step": 1,
      "text": "Combine the brown sugar, salt, and water in a saucepan. Bring to a simmer, then cook until the sugar mixture darkens slightly and thickens.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk in the butter, then gradually whisk in the heavy cream. Return the mixture to a gentle simmer."
    },
    {
      "step": 3,
      "text": "Whisk the milk, egg, egg yolks, and both portions of cornstarch in a bowl until smooth. Gradually whisk in some of the hot cream mixture, then return the tempered mixture to the saucepan."
    },
    {
      "step": 4,
      "text": "Cook over medium-low heat, whisking constantly, until thickened and the custard reaches 160°F with a firm, fully set consistency.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Remove from the heat, whisk in the rum, and transfer the custard to four serving dishes."
    },
    {
      "step": 6,
      "text": "Cool briefly, then cover and refrigerate until fully chilled and set.",
      "timer_minutes": 200
    }
  ],
