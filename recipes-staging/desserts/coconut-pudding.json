{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "coconut-pudding",
  "name": "Coconut Pudding",
  "subtitle": "Silky chilled pudding with a light cinnamon finish",
  "description": "A simple coconut pudding thickened with cornstarch, chilled until firm, and finished with cinnamon.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5,
    "inactive_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "coconut-milk",
      "item": "coconut milk",
      "quantity": 2,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cornstarch with enough coconut milk to form a smooth slurry."
    },
    {
      "step": 2,
      "text": "Stir the remaining coconut milk with the sugar and salt in a saucepan."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer, then whisk in the slurry."
    },
    {
      "step": 4,
      "text": "Cook, stirring constantly, until smooth and thickened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Pour into serving dishes and refrigerate until firm, about 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 6,
      "text": "Sprinkle with the ground cinnamon before serving."
    }
  ],
