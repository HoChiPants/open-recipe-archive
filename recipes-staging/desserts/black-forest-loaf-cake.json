  "id": "black-forest-loaf-cake",
  "name": "Black Forest Loaf Cake",
  "subtitle": "A chocolate loaf with cherries and cream",
  "description": "Bake a rich chocolate loaf, then finish it with cherry-streaked whipped cream for a simple Black Forest-style dessert.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 60
  },
  "ingredients": [
