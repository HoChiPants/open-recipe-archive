  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a loaf tin with the chopped butter."
    },
    {
      "step": 2,
      "text": "Microwave the butter and dark chocolate together in short intervals, stirring until smooth."
    },
    {
      "step": 3,
      "text": "Stir together the self-raising flour, golden caster sugar, and cocoa."
    },
    {
      "step": 4,
      "text": "Blend the melted chocolate mixture with the eggs, milk, and natural yogurt until smooth, then add it to the dry ingredients and mix until combined."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared tin and bake until risen and set.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Leave the loaf in the tin for 20 minutes, then transfer it to a rack to cool.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Whisk the double cream until thick, then whisk in the pitted cherries, reserving their syrup for serving or another use."
    },
    {
      "step": 8,
      "text": "Serve the cooled loaf with the cherry cream."
    }
  ],
