  "id": "chocolate-candy-bar-cake",
  "name": "Chocolate Candy Bar Cake",
  "subtitle": "A tender chocolate cake with creamy pecan topping and chopped milk chocolate.",
  "description": "Bake a pudding-enriched chocolate cake, cool it completely, and finish it with a cream cheese whipped topping, pecans, and candy pieces.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
