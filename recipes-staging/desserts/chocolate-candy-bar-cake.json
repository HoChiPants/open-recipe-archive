  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Prepare a baking pan for the cake."
    },
    {
      "step": 2,
      "text": "Whisk the cake mix, milk, vegetable oil, eggs, and pudding mix until combined. Stir in half of the chopped candy and whisk the batter for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and bake for 25 minutes, or until the center is set and a tester comes out clean.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Cool the cake in the pan for 5 minutes, then let it cool completely for about 30 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Whisk the cream cheese, confectioners' sugar, and white sugar until smooth."
    },
    {
      "step": 6,
      "text": "Fold in the thawed whipped topping, pecans, and remaining chopped candy."
    },
    {
      "step": 7,
      "text": "Spread the topping over the cooled cake and serve."
    }
  ],
