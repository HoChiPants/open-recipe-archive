  "id": "hedgehog-cookies",
  "name": "Hedgehog Cookies",
  "subtitle": "Decorated pecan-and-chocolate cookies",
  "description": "Tender shaped cookies are baked, cooled, and finished with melted chocolate and pecans for a hedgehog-inspired dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 60,
    "cook_minutes": 10,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter-flavored-shortening",
      "item": "butter-flavored shortening",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "corn-syrup",
      "item": "corn syrup",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "chocolate-chips",
      "item": "chocolate chips",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, baking powder, baking soda, and salt together in a bowl."
    },
    {
      "step": 2,
      "text": "In a separate bowl, whisk the sugar, shortening, corn syrup, eggs, and vanilla until smooth. Stir in the dry mixture until a dough forms, then chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Heat the oven to 350°F. Shape the dough into 24 small ovals, tapering one end slightly to suggest a snout, and place them on baking sheets."
    },
    {
      "step": 4,
      "text": "Bake until the cookies are set and lightly colored, about 12 minutes. Cool on the sheets for 10 minutes, then move them to a rack.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Prepare the pecans by finely chopping them. Melt the chocolate chips gently over simmering water, stirring until smooth."
    },
    {
      "step": 6,
      "text": "Coat the rounded portion of each cooled cookie with melted chocolate, then press or roll that area in the chopped pecans. Use the remaining chocolate to define the face as desired."
    },
    {
      "step": 7,
      "text": "Let the decorations stand until the chocolate is set, about 30 minutes.",
      "timer_minutes": 30
    }
  ],
