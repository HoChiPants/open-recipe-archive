  "id": "fresh-peach-pie",
  "name": "Fresh Peach Pie",
  "subtitle": "A chilled pie with ripe peaches and a light spiced glaze",
  "description": "Mashed peaches form a thick glaze for sliced fresh peaches in a baked crust, finished with a short chill.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "9-inch-pie-shell",
      "item": "(9 inch) pie shell",
      "quantity": 1,
      "preparation": "baked"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "fresh-peaches",
      "item": "fresh peaches",
      "quantity": 2,
      "unit": "cups",
      "preparation": "pitted and mashed"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fresh-peaches",
      "item": "fresh peaches",
      "quantity": 4,
      "unit": "cups",
      "preparation": "pitted, skinned, and sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the white sugar, water, cornstarch, butter, mashed peaches, and nutmeg in a saucepan."
    },
    {
      "step": 2,
      "text": "Heat the mixture, stirring often, until it thickens."
    },
    {
      "step": 3,
      "text": "Remove from the heat and stir in the vanilla extract."
    },
    {
      "step": 4,
      "text": "Arrange the sliced peaches in the baked pie shell, then spread the warm peach mixture over them."
    },
    {
      "step": 5,
      "text": "Chill the pie until the filling is set."
    }
  ],
