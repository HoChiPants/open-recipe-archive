  "id": "pineapple-angel-food-cake",
  "name": "Pineapple Angel Food Cake",
  "subtitle": "Pineapple Angel Food Cake from two pantry items",
  "description": "A straightforward baked cake made by folding crushed pineapple into angel food cake mix, baking until golden, then allowing it to rest and set before slicing.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "pineapple",
      "item": "pineapple",
      "quantity": 1,
      "unit": "can",
      "preparation": "20 ounce, crushed, in juice"
    },
    {
      "ingredient_id": "angel-food-cake-mix",
      "item": "angel food cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "In a bowl, combine the crushed pineapple and angel food cake mix until evenly distributed, about 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Transfer the batter to a prepared baking pan."
    },
    {
      "step": 4,
      "text": "Bake at 350°F until the top is golden brown, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Cool the cake on a rack, then allow it to stand for 120 minutes so it sets.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Prepare the cake for service, then cut into portions."
    },
    {
      "step": 7,
      "text": "Serve."
    }
  ],
