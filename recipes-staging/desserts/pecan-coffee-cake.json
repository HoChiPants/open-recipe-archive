  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the all-purpose flour, salt, and baking powder in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the softened butter and sour cream until smooth. Whisk in the white sugar, then the eggs and vanilla extract."
    },
    {
      "step": 4,
      "text": "Fold the flour mixture into the wet ingredients just until no dry streaks remain. Transfer the batter to the prepared pan."
    },
    {
      "step": 5,
      "text": "Combine the brown sugar, pecans, and ground cinnamon. Stir in the melted butter, then scatter the topping over the batter."
    },
    {
      "step": 6,
      "text": "Bake until the center is firm and fully set, about 30 to 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 7,
      "text": "Cool in the pan for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
