  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking dish and a larger pan for a water bath."
    },
    {
      "step": 2,
      "text": "Combine the bread cubes, 1 cup white sugar, salt, cinnamon, and nutmeg. Stir in the raisins."
    },
    {
      "step": 3,
      "text": "Blend the scalded milk, melted cooled butter, and beaten eggs, then pour over the bread mixture and combine."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared baking dish. Set it in the larger pan and add the hot water to the outer pan."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 6,
      "text": "Combine the remaining white sugar, cornstarch, hot water, butter, lemon juice, and lemon zest in a saucepan. Heat, stirring, until thickened."
    },
    {
      "step": 7,
      "text": "Serve the warm bread pudding with the lemon sauce."
    }
  ],
