  "instructions": [
    {
      "step": 1,
      "text": "Combine the unwrapped caramels and water in a heatproof saucepan or microwave-safe bowl. Heat, stirring often, until smooth and fully melted.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk the cream cheese and brown sugar together until smooth."
    },
    {
      "step": 3,
      "text": "Let the caramel cool briefly, then fold it into the cream cheese mixture until combined."
    },
    {
      "step": 4,
      "text": "Serve warm or at room temperature."
    }
