  "id": "caramel-apple-dip",
  "name": "Caramel Apple Dip",
  "subtitle": "Warm caramel blended with sweetened cream cheese",
  "description": "A quick dessert dip combining melted caramel with creamy brown-sugar cream cheese.",
  "meal_type": "dessert",
  "cuisine": "American",
