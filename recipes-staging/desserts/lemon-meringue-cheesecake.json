  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Combine the cookie crumbs and melted butter, then press the mixture evenly into the bottom of a cheesecake pan."
    },
    {
      "step": 2,
      "text": "Beat the softened cream cheese, sour cream, 1 cup sugar, lemon juice, zest, vanilla, and eggs until smooth. Pour the filling over the crust and bake for about 60 minutes, until the center is firm and reaches 160°F.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Cool the cheesecake, then chill it for at least 1 hour. Spread the lemon curd over the chilled surface.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Increase the oven temperature to 375°F. Beat the egg whites with the remaining sugar and cream of tartar until stiff, glossy peaks form."
    },
    {
      "step": 5,
      "text": "Spread the meringue over the lemon curd, covering the edges. Bake for about 10 minutes, until golden brown and set.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Chill the finished cheesecake for at least 1 hour before slicing.",
      "timer_minutes": 60
    }
  ],
