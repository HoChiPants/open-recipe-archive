  "id": "lemon-meringue-cheesecake",
  "name": "Lemon Meringue Cheesecake",
  "subtitle": "A chilled lemon cheesecake topped with toasted meringue",
  "description": "A buttery shortbread crust supports a smooth lemon cheesecake, bright lemon curd, and lightly browned meringue.",
  "meal_type": "dessert",
  "cuisine": "American",
