  "id": "caramelised-peaches-with-frozen-raspberries-and-mascarpone",
  "name": "Caramelised Peaches with Frozen Raspberries and Mascarpone",
  "subtitle": "Warm fruit, cool cream, and crisp amaretti",
  "description": "Caramelised peach is paired with lemon-thyme mascarpone, crushed frozen raspberries, and amaretti for a quick dessert.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 30,
      "unit": "g"
    },
    {
      "ingredient_id": "peach-or-nectarine",
      "item": "peach or nectarine",
      "quantity": 1,
      "preparation": "stoned and halved"
    },
    {
      "ingredient_id": "peach-schnapps",
      "item": "peach schnapps (optional)",
      "quantity": 2,
      "unit": "tbsp",
      "optional": true
    },
    {
