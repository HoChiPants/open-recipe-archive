      "item": "mascarpone",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 20,
      "unit": "g"
    },
    {
      "ingredient_id": "of-lemon-thyme-leaves",
      "item": "of lemon thyme leaves",
      "unit": "pinch"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 30,
      "unit": "ml"
    },
    {
      "ingredient_id": "amaretti-biscuits-crumbled",
      "item": "amaretti biscuits crumbled",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "frozen-raspberries-shop-bought",
      "item": "frozen raspberries (shop-bought",
      "quantity": 100,
      "unit": "g",
      "preparation": "or freeze fresh berries), roughly crushed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Spread the caster sugar in a wide frying pan and heat until it melts and turns golden."
    },
    {
      "step": 2,
      "text": "Place the peach or nectarine halves cut-side down in the caramel. Add the peach schnapps, if using, and cook until the fruit is warmed through and lightly caramelised, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the mascarpone, icing sugar, lemon thyme leaves, and double cream until smooth and softly thickened."
    },
    {
      "step": 4,
      "text": "Stir the crumbled amaretti and roughly crushed frozen raspberries through the mascarpone mixture."
    },
    {
      "step": 5,
      "text": "Serve the mascarpone mixture with the warm caramelised peach halves."
    }
  ],
