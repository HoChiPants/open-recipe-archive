  "id": "gluten-free-snickerdoodle-cookies",
  "name": "Gluten-Free Snickerdoodle Cookies",
  "subtitle": "Soft cinnamon-sugar cookies with crisp edges",
  "description": "Mix a simple butter-based dough, coat portions in cinnamon sugar, and bake until the centers are fully set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 12,
    "inactive_minutes": 3
  },
  "ingredients": [
    {
      "ingredient_id": "gluten-free-all-purpose-flour",
      "item": "gluten-free all-purpose flour",
      "quantity": 1.3333333730698,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter-at-room-temperature",
      "item": "butter at room temperature",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 1,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1.5,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, salt, and baking soda together in a bowl."
    },
    {
      "step": 3,
      "text": "Beat the butter with half of the sugar for about 2 minutes. Add the egg and whisk until combined.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the dry mixture and whisk for about 2 minutes, just until a dough forms.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Stir the remaining sugar and cinnamon together. Shape the dough into 24 portions and roll each in the cinnamon sugar."
    },
    {
      "step": 6,
      "text": "Bake until the edges are set and the centers are fully set, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Let the cookies cool briefly before serving.",
      "timer_minutes": 3
    }
  ],
