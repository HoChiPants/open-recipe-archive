  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Combine the flour, baking powder, and cinnamon in a bowl."
    },
    {
      "step": 3,
      "text": "Beat the softened butter, shortening, and sugar until smooth and creamy."
    },
    {
      "step": 4,
      "text": "Add the eggs one at a time, mixing well after each addition."
    },
    {
      "step": 5,
      "text": "Add the dry ingredients alternately with the milk, mixing just until combined. Stir in the vanilla and chopped black walnuts."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and bake for 60 minutes, until the center is firm and fully set.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Cool the cake in the pan for 15 minutes before serving.",
      "timer_minutes": 15
    }
  ],
