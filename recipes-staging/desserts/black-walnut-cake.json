  "id": "black-walnut-cake",
  "name": "Black Walnut Cake",
  "subtitle": "A tender cinnamon cake with chopped black walnuts",
  "description": "A classic butter-and-shortening cake flavored with cinnamon, vanilla, and black walnuts.",
  "meal_type": "dessert",
  "yield": {
