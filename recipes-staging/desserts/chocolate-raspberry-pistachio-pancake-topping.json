  "id": "chocolate-raspberry-pistachio-pancake-topping",
  "name": "Chocolate Raspberry Pistachio Pancake Topping",
  "subtitle": "A creamy chocolate-nut topping with fresh berries",
  "description": "Combine chocolate spread, nut butter, and milk for a quick topping, then fold in raspberries and chopped pistachios.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "chocolate-spread",
      "item": "chocolate spread",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "pistachio-butter-or-any-other-nut-butter-you-have-in-the-cupboard",
      "item": "pistachio butter or any other nut butter you have in the cupboard",
      "quantity": "1 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "a-splash-of-milk",
      "item": "a splash of milk"
    },
    {
      "ingredient_id": "a-handful-of-raspberries",
      "item": "a handful of raspberries"
    },
    {
      "ingredient_id": "pistachios",
      "item": "pistachios",
      "quantity": 2,
      "unit": "tsp",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the chocolate spread, pistachio butter, and milk together until smooth."
    },
    {
      "step": 2,
      "text": "Add the raspberries and chopped pistachios, then gently fold to combine."
    },
    {
      "step": 3,
      "text": "Spoon the topping over pancakes and serve immediately."
    }
  ],
