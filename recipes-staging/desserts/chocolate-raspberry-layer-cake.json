  "id": "chocolate-raspberry-layer-cake",
  "name": "Chocolate Raspberry Layer Cake",
  "subtitle": "A tender chocolate cake layered with raspberry cream.",
  "description": "Two chocolate sponge layers are filled with raspberry jam, raspberries, and softly whipped cream for a simple celebratory dessert.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "sunflower-oil-plus-extra-for-the-tins",
      "item": "sunflower oil plus extra for the tins",
      "quantity": 225,
      "unit": "ml"
    },
