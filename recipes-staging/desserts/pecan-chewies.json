  "id": "pecan-chewies",
  "name": "Pecan Chewies",
  "subtitle": "Tender brown-sugar pecan bars",
  "description": "A simple American dessert combining buttery brown sugar, pecans, and self-rising flour in a chewy baked treat.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "packed-light-brown-sugar",
      "item": "packed light brown sugar",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 3,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 3,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Warm the butter, then stir in the brown sugar until smooth."
    },
    {
      "step": 3,
      "text": "Mix in the beaten eggs and vanilla extract."
    },
    {
      "step": 4,
      "text": "Combine the chopped pecans with the self-rising flour, then stir them into the butter mixture."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a baking pan and shape it into an even layer."
    },
    {
      "step": 6,
      "text": "Bake for 25 minutes, until golden brown and fully set in the center; if checked with a thermometer, the center should reach 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Cool before cutting and serving."
    }
  ],
