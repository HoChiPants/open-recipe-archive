  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the walnuts, 0.25 cup white sugar, 0.25 cup brown sugar, and 0.5 teaspoon cinnamon together for the topping."
    },
    {
      "step": 3,
      "text": "Whisk the flour, 1 cup white sugar, 0.5 cup brown sugar, 2 teaspoons cinnamon, baking soda, and salt in a large bowl."
    },
    {
      "step": 4,
      "text": "Add the vegetable oil, beaten eggs, sour milk, and apples; stir just until the batter is evenly combined and smooth."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a prepared baking pan and scatter the walnut mixture over the top."
    },
    {
      "step": 6,
      "text": "Bake for 45 minutes, until the center is fully set and reaches 160°F.",
      "timer_minutes": 45
    }
  ],
