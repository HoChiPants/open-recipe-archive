    "inactive_minutes": 64
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "chunky-peanut-butter",
      "item": "chunky peanut butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "quick-cooking-oats",
      "item": "quick cooking oats",
      "quantity": 3,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Line a work surface or tray with parchment or lightly grease it."
    },
    {
      "step": 2,
      "text": "Combine the white sugar, cocoa powder, milk, and margarine in a saucepan. Bring to a simmer, stirring until smooth, and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Remove the pan from the heat. Quickly mix in the vanilla extract, salt, chunky peanut butter, and oats until evenly coated."
    },
    {
      "step": 4,
      "text": "Drop the mixture by spoonfuls onto the prepared surface and leave undisturbed until firm.",
      "timer_minutes": 60
    }
  ],
