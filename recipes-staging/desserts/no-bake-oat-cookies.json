  "id": "no-bake-oat-cookies",
  "name": "No-Bake Oat Cookies",
  "subtitle": "Chocolate-peanut butter cookies that set without an oven",
  "description": "A quick stovetop mixture of cocoa, peanut butter, and oats forms chewy cookies as it cools.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
