  "id": "cheesecake",
  "name": "Cheesecake",
  "subtitle": "Classic cheesecake with a walnut-graham crust",
  "description": "A creamy baked cheesecake layered over a buttery graham cracker and walnut crust, then chilled until firm.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35,
    "inactive_minutes": 315
  },
  "ingredients": [
    {
      "ingredient_id": "graham-cracker-crumbs",
      "item": "graham cracker crumbs",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "finely-ground-walnuts",
      "item": "finely ground walnuts",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "cinnamon-sugar",
      "item": "cinnamon sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 3,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "unit": "large",
      "preparation": "slightly beaten"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Mix the graham cracker crumbs, walnuts, cinnamon sugar, and white sugar. Stir in the melted butter until evenly moistened."
    },
    {
      "step": 3,
      "text": "Press the crust mixture into the prepared pan and freeze until firm.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Whisk the softened cream cheese, white sugar, vanilla extract, and heavy whipping cream until smooth."
    },
    {
      "step": 5,
      "text": "Whisk in the slightly beaten eggs until fully combined."
    },
    {
      "step": 6,
      "text": "Transfer the filling over the chilled crust."
    },
    {
      "step": 7,
      "text": "Bake until the center is set and reaches 160°F.",
      "timer_minutes": 45
    },
    {
      "step": 8,
      "text": "Cool for 15 minutes, then prepare the cheesecake for further cooling.",
      "timer_minutes": 15
    },
    {
      "step": 9,
      "text": "Cool for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 10,
      "text": "Prepare the cheesecake for chilling and cool for another 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 11,
      "text": "Chill for at least 4 hours before serving.",
      "timer_minutes": 240
    }
  ],
