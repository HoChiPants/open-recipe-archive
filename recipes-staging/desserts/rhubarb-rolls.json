  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Bring the water to a simmer, then add the sugar and 3 tablespoons butter. Stir until boiling, then set aside to cool."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, and salt together. Cut in the 1/2 cup butter until the mixture is crumbly, then stir in the milk to form a soft dough."
    },
    {
      "step": 3,
      "text": "Roll or pat the dough into a rectangle on a lightly floured surface."
    },
    {
      "step": 4,
      "text": "Combine the rhubarb, cinnamon, and some of the sugar mixture, then spread the filling over the dough."
    },
    {
      "step": 5,
      "text": "Roll the dough into a log and cut it into 12 pieces. Arrange the rolls in a prepared baking dish and pour the cooled syrup over them."
    },
    {
      "step": 6,
      "text": "Bake for 40 minutes, until lightly browned.",
      "timer_minutes": 40
    }
  ],
