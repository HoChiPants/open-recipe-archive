  "id": "rhubarb-rolls",
  "name": "Rhubarb Rolls",
  "subtitle": "Soft rolls with tart rhubarb and cinnamon",
  "description": "Tender rolled dough filled with cinnamon-sugared rhubarb and baked in a buttery syrup.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
