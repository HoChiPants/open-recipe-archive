  "id": "grilled-pineapple-upside-down-cake",
  "name": "Grilled Pineapple Upside-Down Cake",
  "subtitle": "A quick caramelized pineapple dessert for one",
  "description": "Brown sugar and butter form a warm topping for pineapple, cherry, and a shortcake shell, finished on the grill.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "pineapple-ring",
      "item": "pineapple ring",
      "quantity": 1
    },
    {
      "ingredient_id": "maraschino-cherry",
      "item": "maraschino cherry",
      "quantity": 1
    },
    {
      "ingredient_id": "shortcake-shell",
      "item": "shortcake shell",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Place the brown sugar and butter in a small heatproof grill-safe dish or foil packet."
    },
    {
      "step": 2,
      "text": "Arrange the pineapple ring and cherry over the sugar mixture, then add the shortcake shell."
    },
    {
      "step": 3,
      "text": "Fold the foil closed if using a packet, leaving room for heat to circulate."
    },
    {
      "step": 4,
      "text": "Grill until the topping is hot and caramelized and the shortcake is warmed through.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Transfer carefully and serve warm."
    }
  ],
