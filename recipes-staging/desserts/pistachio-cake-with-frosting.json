  "id": "pistachio-cake-with-frosting",
  "name": "Pistachio Cake with Frosting",
  "subtitle": "A tender pistachio-flavored cake with a chilled pudding topping",
  "description": "Combine a cake mix with pistachio pudding, citrus soda, oil, and eggs, then bake and finish with a milk-based pistachio frosting.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "white-cake-mix",
      "item": "white cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-lime-flavored-carbonated-beverage",
      "item": "lemon-lime flavored carbonated beverage",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "instant-pistachio-pudding-mix",
      "item": "instant pistachio pudding mix",
      "quantity": 2,
      "unit": "package",
      "preparation": "3 ounce"
    },
    {
      "ingredient_id": "1-3-ounce-envelopes-whipped-topping-mix",
      "item": "(1.3 ounce) envelopes whipped topping mix",
      "quantity": 2
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Combine the cake mix, vegetable oil, lemon-lime beverage, eggs, and pistachio pudding mix until smooth."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and bake for 45 minutes, until set.",
      "timer_minutes": 45
    },
    {
      "step": 4,
      "text": "Whisk the whipped topping mix, remaining pistachio pudding mix, and milk until smooth and thickened."
    },
    {
      "step": 5,
      "text": "Spread the frosting over the cooled cake and chill before serving."
    }
  ],
