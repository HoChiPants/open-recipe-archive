  },
  "ingredients": [
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the semisweet chocolate chips in a heatproof bowl."
    },
    {
      "step": 2,
      "text": "Heat the heavy whipping cream in a saucepan until hot and just beginning to steam; do not boil.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Pour the hot cream over the chocolate chips and whisk until smooth and fully combined.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Transfer the ganache to a suitable pan and chill until firm.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Cut into pieces to serve."
    }
  ],
