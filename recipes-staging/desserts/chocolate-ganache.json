  "id": "chocolate-ganache",
  "name": "Chocolate Ganache",
  "subtitle": "A smooth two-ingredient chocolate topping",
  "description": "Warm cream transforms semisweet chocolate chips into a rich ganache that sets firm enough to cut.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
