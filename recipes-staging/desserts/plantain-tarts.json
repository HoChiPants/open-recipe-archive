  "instructions": [
    {
      "step": 1,
      "text": "Mix the flour and salt. Cut in the cold butter and shortening until the mixture is crumbly. Stir in the beaten egg and ice-cold water just until a dough forms. Knead briefly, shape into a disk, cover, and chill for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 2,
      "text": "Peel and cut the plantains. Simmer them in water until tender, about 10 minutes. Drain, then mash with the white sugar, vanilla, nutmeg, and food coloring. Let the filling cool until set.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Heat the oven to 350°F. Roll the chilled dough on a lightly floured surface until thick enough to handle, then cut it into rounds. Fill each round with plantain mixture, fold over, and transfer the tarts to a baking sheet."
    },
    {
      "step": 4,
      "text": "Brush the tarts with beaten egg white and sprinkle with the decorating sugar. Bake for 25 minutes, until golden brown and the centers are fully set, reaching 160°F on a food thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Cool before serving."
    }
  ],
