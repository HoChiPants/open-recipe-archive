  "id": "plantain-tarts",
  "name": "Plantain Tarts",
  "subtitle": "Spiced ripe plantain pastries with a crisp finish",
  "description": "Tender pastry shells hold a sweet, nutmeg-scented plantain filling and bake until golden.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 40,
    "inactive_minutes": 360
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cold-butter",
      "item": "cold butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "cut into 1/2 inch pieces"
    },
    {
      "ingredient_id": "shortening",
      "item": "shortening",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "chilled and diced"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "ice-cold-water",
      "item": "ice-cold water",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
