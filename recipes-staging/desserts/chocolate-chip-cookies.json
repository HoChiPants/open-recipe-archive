  "id": "chocolate-chip-cookies",
  "name": "Chocolate Chip Cookies",
  "subtitle": "Soft cookies with brown sugar and semisweet chocolate",
  "description": "A simple batch of tender chocolate chip cookies with a vanilla pudding mix for added softness.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
