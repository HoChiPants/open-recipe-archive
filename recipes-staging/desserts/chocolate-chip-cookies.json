  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter, packed brown sugar, and white sugar until smooth."
    },
    {
      "step": 3,
      "text": "Mix in the pudding mix, eggs, and vanilla extract until evenly combined."
    },
    {
      "step": 4,
      "text": "Stir together the flour and baking soda, then add the dry mixture to the wet mixture and combine into a dough."
    },
    {
      "step": 5,
      "text": "Fold in the semisweet chocolate chips."
    },
    {
      "step": 6,
      "text": "Portion the dough onto baking sheets and bake at 375°F for 12 minutes, until lightly browned.",
      "timer_minutes": 12
    }
  ],
