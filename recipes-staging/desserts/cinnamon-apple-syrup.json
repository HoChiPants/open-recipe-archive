  "id": "cinnamon-apple-syrup",
  "name": "Cinnamon Apple Syrup",
  "subtitle": "A warm, fruit-forward topping with gentle spice",
  "description": "Tender tart apples simmer with cinnamon and sugar to make a thick syrup for desserts or breakfast dishes.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "tart-apples",
      "item": "tart apples",
      "quantity": 2,
      "preparation": "peeled, cored, and sliced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Add the apples, sugar, cinnamon, and water. Stir until the ingredients are evenly combined and the sugar is moistened."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a gentle simmer and cook until the apples are tender and the syrup has thickened.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Whisk the syrup briefly until smooth, then serve warm or let it cool slightly."
    }
  ],
