  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-chip-cookie-pie",
  "name": "Chocolate Chip Cookie Pie",
  "subtitle": "A warm, chewy pie with chocolate and pecans",
  "description": "A simple baked dessert combining a buttery brown-sugar filling, semisweet chocolate chips, and chopped pecans in a pie shell.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "9-inch-pie-shell",
      "item": "(9 inch) pie shell",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Whisk the eggs in a mixing bowl. Add the flour, white sugar, and brown sugar, then whisk until combined."
    },
    {
      "step": 3,
      "text": "Blend in the melted butter. Stir in the chocolate chips and chopped pecans."
    },
    {
      "step": 4,
      "text": "Pour the filling into the pie shell and place it on a baking sheet."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, until the center is firm and fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 60
    }
  ],
