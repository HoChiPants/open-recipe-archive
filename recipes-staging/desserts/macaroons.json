{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "macaroons",
  "name": "Macaroons",
  "subtitle": "Coconut macaroons with a crisp, lightly golden exterior",
  "description": "Whipped egg whites and sweetened coconut bake into simple chewy macaroons.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 2
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sweetened-flaked-coconut",
      "item": "sweetened flaked coconut",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Line a baking sheet with parchment."
    },
    {
      "step": 2,
      "text": "Whisk the egg whites, salt, and white sugar until soft peaks form, then continue whisking until stiff peaks develop."
    },
    {
      "step": 3,
      "text": "Fold in the sweetened flaked coconut until evenly combined. Divide the mixture into 12 mounds on the prepared sheet."
    },
    {
      "step": 4,
      "text": "Bake until lightly golden and the centers are fully set; the egg mixture should reach 160°F.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Cool the macaroons on the baking sheet before serving."
    }
  ],
