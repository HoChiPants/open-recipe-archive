  "id": "fudge-pie",
  "name": "Fudge Pie",
  "subtitle": "A rich chocolate pie with a tender, set center",
  "description": "A simple American chocolate pie combining cocoa, melted butter, and chocolate chips in a baked shell.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted and slightly cooled"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large",
      "preparation": "beaten"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "semi-sweet-chocolate-chips",
      "item": "semi-sweet chocolate chips",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "9-inch-pie-shell",
      "item": "(9 inch) pie shell",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Stir together the sugar, melted butter, beaten eggs, and vanilla until smooth."
    },
    {
      "step": 3,
      "text": "Combine the flour and cocoa powder, then stir them into the wet mixture until blended."
    },
    {
      "step": 4,
      "text": "Fold in the chocolate chips and transfer the filling to the pie shell."
    },
    {
      "step": 5,
      "text": "Bake for 40 minutes, or until the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Serve the pie."
    }
  ],
