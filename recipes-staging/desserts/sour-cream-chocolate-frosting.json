  "ingredients": [
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 2.75,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the chocolate chips and butter together gently, stirring until smooth. Let the mixture cool slightly."
    },
    {
      "step": 2,
      "text": "Whisk the sour cream, vanilla extract, and salt in a mixing bowl."
    },
    {
      "step": 3,
      "text": "Whisk in the confectioners' sugar gradually until smooth, then blend in the melted chocolate mixture until evenly combined."
    }
  ],
