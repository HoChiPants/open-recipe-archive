  "id": "sour-cream-chocolate-frosting",
  "name": "Sour Cream Chocolate Frosting",
  "subtitle": "Smooth chocolate frosting with a tangy finish",
  "description": "A rich, creamy frosting for cakes, cupcakes, and other baked goods.",
  "meal_type": "dessert",
  "cuisine": "American",
