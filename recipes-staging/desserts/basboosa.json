  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "basboosa",
  "name": "Basboosa",
  "subtitle": "A tender semolina cake finished with rose-scented syrup",
  "description": "Rested semolina batter is baked until set, marked into portions, and soaked with a fragrant sugar syrup.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "semolina-flour",
      "item": "semolina flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "plain-yogurt",
      "item": "plain yogurt",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "almonds",
      "item": "almonds",
      "quantity": 6,
      "unit": "whole",
      "preparation": "split in half"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "rose-water",
      "item": "rose water",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the semolina flour, 0.5 cup white sugar, yogurt, vegetable oil, coconut, and baking powder into a uniform batter. Let it rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Meanwhile, combine the water, 1.75 cups white sugar, and rose water in a saucepan. Bring to a simmer and cook for 4 minutes, then set aside.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Heat the oven to 350°F. Transfer the batter to a baking pan and smooth the surface. Score it into 12 portions and place the split almonds on top."
    },
    {
      "step": 4,
      "text": "Bake for 20 minutes, until set and lightly browned.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Pour the warm syrup over the hot cake and let it absorb for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Transfer portions to a serving dish and serve."
    }
  ],
