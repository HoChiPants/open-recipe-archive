  "id": "sugar-cookies-with-colored-glaze",
  "name": "Sugar Cookies with Colored Glaze",
  "subtitle": "Chilled cutout cookies finished with a simple lemon glaze",
  "description": "A buttery sugar-cookie dough is chilled, rolled, cut into thick shapes, baked until lightly browned, and decorated with tinted lemon glaze.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 12,
    "inactive_minutes": 210
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "assorted-food-coloring",
      "item": "assorted food coloring"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the white sugar, softened butter, and heavy cream until smooth. Whisk in the eggs and vanilla extract."
    },
    {
      "step": 2,
      "text": "Add the flour, baking powder, and salt, then mix until a dough forms. Cover and chill for 3 hours.",
      "timer_minutes": 180
    },
    {
      "step": 3,
      "text": "Preheat the oven to 350°F. Prepare the baking powder as needed for the baking surface, then roll the dough on a floured surface and cut thick shapes."
    },
    {
      "step": 4,
      "text": "Transfer the cut dough to the prepared baking surface and bake for 14 minutes, or until lightly browned.",
      "timer_minutes": 14
    },
    {
      "step": 5,
      "text": "Transfer the cookies to a cooling surface and let them cool completely."
    },
    {
      "step": 6,
      "text": "Combine the confectioners' sugar and lemon juice until thick. Divide and tint with assorted food coloring."
    },
    {
      "step": 7,
      "text": "Garnish the cooled cookies with the colored glaze, then let the glaze set."
    }
  ],
