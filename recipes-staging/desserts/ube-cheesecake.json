  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Coat a springform pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Stir the graham cracker crumbs, melted butter, 1 tablespoon sugar, and ⅛ teaspoon salt until evenly moistened. Press the mixture firmly over the pan bottom."
    },
    {
      "step": 3,
      "text": "Bake the crust until set, about 15 minutes. Transfer it to a rack and cool for 20 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Beat the softened cream cheese with the ½ cup cream until smooth. Add the ½ cup sugar and ube jam, then mix until combined.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Add the eggs one at a time, mixing just until incorporated. Blend in the ube extract, vanilla, and ¼ teaspoon salt."
    },
    {
      "step": 6,
      "text": "Pour the filling over the crust and smooth the surface. Bake until the center is firm or reaches 160°F, about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Turn off the oven and let the cheesecake rest inside for 1 hour. Transfer it to a rack and cool for 1 hour, then refrigerate until fully chilled, preferably overnight.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Melt the white chocolate chips with the ¼ cup cream, stirring until smooth. Mix in the ¼ teaspoon ube extract and cool the topping for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 9,
      "text": "Spread the topping over the chilled cheesecake and refrigerate until set, about 20 minutes, before slicing.",
      "timer_minutes": 20
    }
  ],
