  "id": "cookie-butter-cookies",
  "name": "Cookie Butter Cookies",
  "subtitle": "Soft, nutty cookies with crisp sugar edges",
  "description": "A simple drop cookie combining cookie butter and peanut butter in a tender, warmly sweet dough.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "cookie-butter",
      "item": "cookie butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the baking soda, baking powder, and salt into the flour."
    },
    {
      "step": 3,
      "text": "Beat the softened butter, brown sugar, and 0.75 cup white sugar until smooth. Add the cookie butter and peanut butter, then whisk in the egg until combined."
    },
    {
      "step": 4,
      "text": "Mix the dry ingredients into the butter mixture to form a dough."
    },
    {
      "step": 5,
      "text": "Shape the dough into 24 portions, roll each in the remaining white sugar, and arrange on baking sheets."
    },
    {
      "step": 6,
      "text": "Bake for 12 minutes, until golden brown and fully set in the center. For a thermometer check, the egg-containing cookies should reach 160°F.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Cool briefly on the baking sheets before serving."
    }
  ],
