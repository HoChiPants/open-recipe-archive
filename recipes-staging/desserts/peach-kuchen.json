  "id": "peach-kuchen",
  "name": "Peach Kuchen",
  "subtitle": "A tender peach dessert with a cinnamon-sugar finish",
  "description": "A simple fruit kuchen made with a lightly sweetened batter, sliced peaches, and a cinnamon-sugar topping.",
  "meal_type": "dessert",
