  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Grease a baking dish or pan."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, baking powder, and salt."
    },
    {
      "step": 3,
      "text": "Beat the margarine and 1/4 cup sugar until blended. Whisk in the egg and vanilla extract."
    },
    {
      "step": 4,
      "text": "Gradually mix in the dry ingredients to form a thick batter. Spread it evenly in the prepared pan."
    },
    {
      "step": 5,
      "text": "Arrange the drained peaches over the batter. Combine the remaining sugar with the cinnamon and sprinkle over the top."
    },
    {
      "step": 6,
      "text": "Bake for 40 minutes, until golden brown and the center is firm and fully set, reaching 160°F.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Let the kuchen rest for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
