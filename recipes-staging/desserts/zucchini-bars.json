      "item": "grated zucchini",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 2.5,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
