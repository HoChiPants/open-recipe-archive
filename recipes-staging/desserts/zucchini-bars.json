  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Whisk the white sugar, vegetable oil, eggs, and vanilla extract until combined."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the all-purpose flour, baking soda, salt, and baking powder."
    },
    {
      "step": 4,
      "text": "Stir the dry mixture into the wet mixture, then fold in the grated zucchini."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake until the center is firm and a thermometer reads 160°F, about 20–25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Whisk the sifted confectioners' sugar, margarine, and cream cheese until smooth."
    },
    {
      "step": 7,
      "text": "Spread the frosting over the cooled bars, then cut and serve."
    }
  ],
