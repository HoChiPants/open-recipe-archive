  "id": "zucchini-bars",
  "name": "Zucchini Bars",
  "subtitle": "Tender zucchini bars with cream cheese frosting",
  "description": "A simple pan-baked dessert made with grated zucchini and finished with a smooth cream cheese frosting.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
