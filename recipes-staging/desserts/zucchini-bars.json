      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2.3333332538605,
