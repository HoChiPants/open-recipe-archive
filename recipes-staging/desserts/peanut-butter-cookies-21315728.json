  "name": "Peanut Butter Cookies",
  "subtitle": "Three-ingredient cookies with crisp edges and tender centers",
  "description": "A simple American dessert made by combining peanut butter, sugar, and egg, then shaping and baking until lightly browned and set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
