  },
  "ingredients": [
    {
      "ingredient_id": "kraft-smooth-peanut-butter",
      "item": "KRAFT Smooth Peanut Butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the peanut butter and sugar. Prepare the egg, then mix it into the peanut butter mixture until evenly incorporated."
    },
    {
      "step": 3,
      "text": "Shape the mixture into 24 portions and transfer them to a baking sheet."
    },
    {
      "step": 4,
      "text": "Bake for 12 minutes, or until lightly browned and the centers are set and reach 160°F.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Transfer the cookies to a cooling surface and let them stand for 5 minutes before serving.",
      "timer_minutes": 5
    }
