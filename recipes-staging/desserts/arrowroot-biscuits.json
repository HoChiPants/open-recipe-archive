{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "arrowroot-biscuits",
  "name": "Arrowroot Biscuits",
  "subtitle": "Tender, lightly sweetened biscuits with a delicate crumb",
  "description": "These simple arrowroot biscuits combine butter, sugar, and vanilla with wheat and arrowroot flours for a crisp-edged baked treat.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 50,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "arrowroot-flour",
      "item": "arrowroot flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the all-purpose flour, arrowroot flour, baking powder, and salt together."
    },
    {
      "step": 3,
      "text": "Whisk the softened butter and sugar until smooth. Add the egg and vanilla, then whisk until combined."
    },
    {
      "step": 4,
      "text": "Add the dry ingredients to the butter mixture and combine into a dough."
    },
    {
      "step": 5,
      "text": "On a lightly floured surface, roll or press the dough to a thick, even layer. Cut into biscuits and transfer them to a baking sheet."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, until golden brown and the center is firm and fully set.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Let the biscuits cool briefly before serving."
    }
  ],
