  "schema_version": "1.0.0",
  "id": "chocolate-pecan-dessert-squares",
  "name": "Chocolate Pecan Dessert Squares",
  "subtitle": "A chilled dessert with a buttery pecan base and creamy chocolate-vanilla layers.",
  "description": "Bake a simple pecan crust, layer it with sweetened cream cheese, chocolate-vanilla pudding, and whipped topping, then finish with chopped pecans.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "finely-chopped-pecans",
      "item": "finely chopped pecans",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "frozen-whipped-topping",
      "item": "frozen whipped topping",
      "quantity": 3,
      "unit": "cups",
      "preparation": "thawed"
    },
    {
      "ingredient_id": "instant-chocolate-pudding-mix",
      "item": "instant chocolate pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.9 ounce"
    },
    {
      "ingredient_id": "instant-vanilla-pudding-mix",
      "item": "instant vanilla pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.4 ounce"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cut the butter into the flour until crumbly, then stir in the finely chopped pecans. Press the mixture into a baking dish."
    },
    {
      "step": 3,
      "text": "Bake the crust until set and lightly golden, about 15 minutes. Cool completely.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Beat the cream cheese and confectioners' sugar until smooth. Fold in 1 cup of the whipped topping, spread over the cooled crust, and transfer the dish to the refrigerator."
    },
    {
      "step": 5,
      "text": "Whisk the chocolate pudding mix and vanilla pudding mix with the milk until thickened and smooth. Spread over the cream cheese layer."
    },
    {
      "step": 6,
      "text": "Top with the remaining whipped topping and sprinkle with the chopped pecans."
    },
    {
      "step": 7,
      "text": "Chill until firm, then cut into squares."
    }
  ],
