  "id": "salted-caramel-chocolate-pecan-cookies",
  "name": "Salted Caramel Chocolate Pecan Cookies",
  "subtitle": "Buttery pecan cookies finished with caramel, chocolate, and sea salt.",
  "description": "Bake tender pecan cookies, fill them with creamy caramel, and finish with a chocolate drizzle and a light sprinkle of sea salt.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large",
      "preparation": "lightly beaten"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "chopped toasted"
    },
    {
      "ingredient_id": "caramel-candies",
      "item": "caramel candies",
      "quantity": 44
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "coarse-sea-salt",
      "item": "coarse sea salt"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1,
      "unit": "bag",
      "preparation": "6 ounce"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare baking sheets."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter and white sugar until smooth, then whisk in the vanilla extract."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk together the all-purpose flour, salt, and coarse sea salt. Mix the dry ingredients into the butter mixture."
    },
    {
      "step": 4,
      "text": "Fold in the lightly beaten eggs and pecans until a dough forms."
    },
    {
      "step": 5,
      "text": "Shape the dough into small portions, arrange them on the baking sheets, and make a shallow indentation in each."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, then continue baking for 10 minutes more, until the cookies are set. Cool on the sheets.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Warm the heavy whipping cream with the caramel candies, stirring until the candies melt completely, about 6 minutes. Stir in salt and coarse sea salt.",
      "timer_minutes": 6
    },
    {
      "step": 8,
      "text": "Fill the cookie indentations with the caramel mixture."
    },
    {
      "step": 9,
      "text": "Microwave the semisweet chocolate chips with the vegetable oil in short intervals, stirring between intervals, for up to 3 minutes until smooth.",
      "timer_minutes": 3
    },
    {
      "step": 10,
      "text": "Drizzle the chocolate over the cooled cookies and let the topping set."
    }
  ],
