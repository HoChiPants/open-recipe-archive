  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Combine the chopped dates and baking soda. Pour in the boiling water and let the mixture stand until softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk one portion of the butter with the white sugar and eggs until smooth. Add the self-rising flour and mix just until combined."
    },
    {
      "step": 4,
      "text": "Stir in the softened date mixture, transfer the batter to the prepared dish, and bake until the pudding is set in the center and reaches 160°F.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Let the pudding cool briefly. Meanwhile, combine the remaining butter, packed brown sugar, and evaporated milk in a saucepan."
    },
    {
      "step": 6,
      "text": "Bring the sauce to a boil, cook until smooth and slightly thickened, then stir in the vanilla extract.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Pour the warm sauce over the pudding and serve."
    }
  ],
