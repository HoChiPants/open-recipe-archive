  "id": "chocolate-churros-with-chocolate-salted-caramel-sauce",
  "name": "Chocolate Churros with Chocolate Salted Caramel Sauce",
  "subtitle": "Crisp cocoa churros with warm chocolate caramel",
  "description": "Make about 25 chocolate churros, coat them in cinnamon sugar, and serve with a rich chocolate caramel sauce and optional vanilla ice cream.",
  "meal_type": "dessert",
  "cuisine": "Spanish",
  "yield": {
    "quantity": 5,
    "unit": "(makes about 25 churros)"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
