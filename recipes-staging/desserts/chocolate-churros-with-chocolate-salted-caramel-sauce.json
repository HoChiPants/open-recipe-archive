  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, sifted cocoa powder, and baking powder. Stir in the melted butter and vanilla extract to form a thick chocolate dough; cool until easy to handle."
    },
    {
      "step": 2,
      "text": "Mix the golden caster sugar with the cinnamon in a shallow dish for coating."
    },
    {
      "step": 3,
      "text": "For the sauce, warm the muscovado sugar, 60 g butter, and double cream until smooth. Stir in the dark chocolate until melted, then let the sauce cool slightly.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Heat the sunflower oil in a deep, heavy pan until ready for frying. Pipe or shape the dough into short churros and fry in batches until crisp and cooked through.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Drain the churros, toss them in the cinnamon sugar, and rest briefly before serving."
    },
    {
      "step": 6,
      "text": "Serve the churros with the chocolate caramel sauce and optional vanilla ice cream."
    }
  ],
