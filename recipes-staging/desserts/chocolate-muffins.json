  "id": "chocolate-muffins",
  "name": "Chocolate Muffins",
  "subtitle": "Small, tender chocolate muffins with an optional chip topping",
  "description": "A simple batch of cocoa-rich muffins finished with icing sugar for a lightly sweet topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
