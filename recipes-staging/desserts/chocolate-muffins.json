      "item": "icing sugar",
      "quantity": 100,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a six-cup muffin tin."
    },
    {
      "step": 2,
      "text": "Whisk the plain flour, cocoa powder, and baking powder together in a bowl."
    },
    {
      "step": 3,
      "text": "Combine the egg, caster sugar, vegetable oil, and whole milk, then stir into the dry ingredients until just mixed. Fold in the chocolate chips if using."
    },
    {
      "step": 4,
      "text": "Divide the batter among the muffin cups and bake for 25 minutes, until the centers are firm and reach 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Cool the muffins before finishing with icing sugar."
    },
    {
      "step": 6,
      "text": "Combine the caster sugar and icing sugar as directed, then allow the icing sugar finish to cool before serving."
    }
  ],
