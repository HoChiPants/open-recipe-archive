  "id": "russian-tea-cakes",
  "name": "Russian Tea Cakes",
  "subtitle": "Tender walnut cookies finished with confectioners' sugar",
  "description": "Form buttery walnut dough into small cookies, bake until lightly golden, and coat them generously with confectioners' sugar while warm and again after cooling.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15,
    "inactive_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "room temperature"
    },
    {
      "ingredient_id": "finely-chopped-toasted-walnuts",
      "item": "finely chopped toasted walnuts",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1.3333333730698,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "confectioners-sugar-for-dusting",
      "item": "confectioners' sugar for dusting",
      "quantity": 1,
      "unit": "cup",
      "preparation": "or more as needed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Beat the room-temperature butter with the walnuts, divided confectioners' sugar, vanilla, and salt until smooth."
    },
    {
      "step": 3,
      "text": "Add the all-purpose flour and mix just until a soft dough forms."
    },
    {
      "step": 4,
      "text": "Shape the dough into small, even balls and arrange them on a baking sheet."
    },
    {
      "step": 5,
      "text": "Bake until the cookies are lightly golden, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "While warm, roll the cookies in confectioners' sugar for dusting.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Cool, then dust or roll the cookies in additional confectioners' sugar before serving."
    }
  ],
