  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Line a 9-inch pie dish with the bottom pastry crust, pressing it into place."
    },
    {
      "step": 3,
      "text": "Combine the chicken, mixed vegetables, condensed soup, and milk. Stir in the pepper, thyme, parsley, and salt to taste."
    },
    {
      "step": 4,
      "text": "Spoon the filling into the crust, cover with the remaining pastry, and seal the edges."
    },
    {
      "step": 5,
      "text": "Cut vents in the top crust."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until golden brown and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 30
    }
  ],
