  "id": "chocolate-tahini-traybake",
  "name": "Chocolate Tahini Traybake",
  "subtitle": "A chewy chocolate-and-fruit slice with toasted walnut crunch",
  "description": "A simple traybake combining chocolate, tahini, dried fruit, and walnuts in a soft, chewy square.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-softened",
      "item": "unsalted butter softened",
      "quantity": 125,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "dark-or-milk-chocolate-roughly-chopped",
      "item": "dark or milk chocolate roughly chopped",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "walnuts-roughly-chopped",
      "item": "walnuts roughly chopped",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "mixed-dried-fruit-use-any-that-you-have-to-hand",
      "item": "mixed dried fruit (use any that you have to hand",
      "quantity": 100,
      "unit": "g",
      "preparation": "such as sultanas, apricots or cranberries), larger pieces roughly chopped"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "heaped-tbsp-tahini",
      "item": "heaped tbsp tahini",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-ice-cream-to-serve",
      "item": "vanilla ice cream to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven and butter a suitable traybake tin. Line the base if desired."
    },
    {
      "step": 2,
      "text": "Melt the chopped chocolate gently in the microwave in short intervals, stirring between each, then set aside to cool slightly."
    },
    {
      "step": 3,
      "text": "Whisk the softened butter and brown sugar until smooth. Beat in the eggs, then mix in the tahini and melted chocolate."
    },
    {
      "step": 4,
      "text": "Stir together the flour, baking powder, walnuts, and dried fruit. Fold the dry mixture into the chocolate mixture until just combined."
    },
    {
      "step": 5,
      "text": "Spread the batter evenly in the prepared tin and bake until set in the center.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Cool in the tin for 20 minutes, then transfer to a rack and cool until firm before cutting.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Serve plain or with optional vanilla ice cream."
    }
  ],
