      "item": "fine vermicelli roughly crushed",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "jaggery-or-light-muscovado-sugar",
      "item": "jaggery or light muscovado sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "coconut-milk",
      "item": "coconut milk",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "raisins-soaked-in-hot-water-for-10-mins-then-drained",
      "item": "raisins soaked in hot water for 10 mins then drained",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "cashews-fried-until-golden-in-1-tsp-ghee",
      "item": "cashews fried until golden in 1 tsp ghee",
      "quantity": 50,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Crush the cardamom seeds with the caster sugar and jaggery or light muscovado sugar."
    },
    {
      "step": 2,
      "text": "Warm the whole milk and coconut milk together until hot but not boiling."
    },
    {
      "step": 3,
      "text": "Heat the ghee in a pan. Add the crushed vermicelli and cook, stirring, for 5 minutes. Add the drained raisins and fried cashews.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Pour in the hot milk mixture and bring to a boil. Cook for 5 minutes, stirring occasionally, until the vermicelli is tender.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the sugar mixture and cook for 3 minutes. Whisk briefly until smooth, then stir through the raisins and cashews.",
      "timer_minutes": 3
    }
  ],
