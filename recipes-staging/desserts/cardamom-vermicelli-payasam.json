  "id": "cardamom-vermicelli-payasam",
  "name": "Cardamom Vermicelli Payasam",
  "subtitle": "A creamy Indian vermicelli pudding with jaggery, raisins, and cashews",
  "description": "A gently spiced milk pudding made with toasted vermicelli, cardamom, jaggery, coconut milk, and fried cashews.",
  "meal_type": "dessert",
  "cuisine": "Indian",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
