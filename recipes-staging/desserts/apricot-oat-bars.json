{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "apricot-oat-bars",
  "name": "Apricot Oat Bars",
  "subtitle": "Buttery oat slices with spiced apricot filling",
  "description": "A crumbly oat base and topping sandwich a layer of apricot jam with warm cinnamon, nutmeg, and optional cardamom.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "salted-butter-cut-into-cubes",
      "item": "salted butter cut into cubes",
      "quantity": 250,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 220,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-cardamom",
      "item": "ground cardamom (optional)",
      "quantity": "1/4",
      "unit": "tsp",
      "optional": true
    },
    {
      "ingredient_id": "porridge-oats",
      "item": "porridge oats",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "apricot-jam",
      "item": "apricot jam",
      "quantity": 150,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grease a baking tin with some of the extra butter. Combine the flour, sugar, cinnamon, nutmeg, cardamom if using, and cubed butter until crumbly."
    },
    {
      "step": 2,
      "text": "Mix in the oats. Press about two-thirds of the mixture evenly into the prepared tin, reserving the rest for the topping."
    },
    {
      "step": 3,
      "text": "Spread the apricot jam over the base, then scatter the reserved oat mixture over the top and press lightly."
    },
    {
      "step": 4,
      "text": "Chill until firm.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Preheat the oven."
    },
    {
      "step": 6,
      "text": "Bake the chilled mixture until golden and set.",
      "timer_minutes": 45
    },
    {
      "step": 7,
      "text": "Cool completely in the tin, then cut into 12 bars."
    }
  ],
