  "id": "vanilla-filled-snack-cakes",
  "name": "Vanilla-Filled Snack Cakes",
  "subtitle": "Soft vanilla cakes with a creamy filling",
  "description": "Bake tender vanilla cakes, cool them, and finish with a smooth cream-cheese and whipped-topping filling.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted and cooled to lukewarm"
    },
    {
      "ingredient_id": "yellow-cake-mix",
      "item": "yellow cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "instant-vanilla-pudding-mix",
      "item": "instant vanilla pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "5.1 ounce"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 5,
      "unit": "cups",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, room temperature"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "room temperature"
    },
    {
      "ingredient_id": "8-ounce-container-frozen-whipped-topping",
      "item": "(8 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare molds or small cake wells for 25 portions."
    },
    {
      "step": 2,
      "text": "Whisk the eggs until combined, then stir in the lukewarm melted butter."
    },
    {
      "step": 3,
      "text": "Add the cake mix, water, and instant vanilla pudding mix; stir until the batter is thick and even."
    },
    {
      "step": 4,
      "text": "Portion the batter into the prepared molds and bake until set, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Cool the cakes completely before filling."
    },
    {
      "step": 6,
      "text": "Whisk the room-temperature butter, sifted confectioners' sugar, and cream cheese until smooth."
    },
    {
      "step": 7,
      "text": "Stir in the instant vanilla pudding mix, thawed whipped topping, and vanilla extract until combined."
    },
    {
      "step": 8,
      "text": "Layer or pipe the filling with the cooled cakes, then cut or portion them for serving."
    }
  ],
