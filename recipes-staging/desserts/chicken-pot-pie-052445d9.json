  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 425°F. Fit one crust into a 9-inch pie dish and chill it while preparing the filling."
    },
    {
      "step": 2,
      "text": "Combine the chicken, carrots, peas, celery, celery seed, and chicken broth in a saucepan. Simmer until the vegetables are tender and the chicken reaches 165°F internally, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet over medium heat. Add the onion and cook until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Stir in the flour, salt, pepper, and celery seed. Gradually whisk in the cooking broth and milk, then simmer until thickened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir in the parsley and combine the sauce with the chicken and vegetables."
    },
    {
      "step": 6,
      "text": "Pour the filling into the chilled bottom crust. Cover with the second crust, seal the edges, and cut vents in the top."
    },
    {
      "step": 7,
      "text": "Bake until the crust is golden brown and the filling is bubbling, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 8,
      "text": "Let the pie cool for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
