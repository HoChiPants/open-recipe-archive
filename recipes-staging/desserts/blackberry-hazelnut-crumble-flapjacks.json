  "id": "blackberry-hazelnut-crumble-flapjacks",
  "name": "Blackberry Hazelnut Crumble Flapjacks",
  "subtitle": "Oat bars layered with berries and a nutty crumble",
  "description": "Tender oat flapjacks combine blackberries, chopped hazelnuts, and a lightly tangy pomegranate-molasses filling beneath a crisp crumble topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 35
  },
  "ingredients": [
