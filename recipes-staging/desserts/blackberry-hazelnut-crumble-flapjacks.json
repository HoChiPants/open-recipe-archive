      "item": "spelt flour",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1 1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "pomegranate-molasses",
      "item": "pomegranate molasses",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "hazelnuts",
      "item": "hazelnuts",
      "quantity": 60,
      "unit": "g",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "blackberries",
      "item": "blackberries",
      "quantity": 200,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and butter a baking tin."
    },
    {
      "step": 2,
      "text": "Mix the spelt flour, baking powder, and rolled oats in a bowl."
    },
    {
      "step": 3,
      "text": "Melt the butter, brown sugar, and pomegranate molasses together until smooth, then stir into the dry mixture until combined."
    },
    {
      "step": 4,
      "text": "Press part of the mixture into the tin. Add the blackberries and chopped hazelnuts, then cover with the remaining mixture and lightly press the top."
    },
    {
      "step": 5,
      "text": "Bake until golden and set, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool briefly, then cut into 12 servings."
    }
  ],
