  "id": "bourbon-cream-cheese-frosting",
  "name": "Bourbon Cream Cheese Frosting",
  "subtitle": "Smooth cream cheese frosting with bourbon",
  "description": "A rich, tangy frosting blended with bourbon for spreading over cakes and cupcakes.",
