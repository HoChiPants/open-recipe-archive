  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour and salt together. Cut in the chilled shortening until the mixture forms coarse crumbs, then stir in the cold water to make a dough."
    },
    {
      "step": 2,
      "text": "Divide and shape the dough into two portions, then chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Roll one portion into a bottom crust, transfer it to a pie dish, and shape the second portion into a top crust."
    },
    {
      "step": 4,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 5,
      "text": "Combine the sour cherries, sugar, and cornstarch. Prepare the mixture for 10 minutes, stirring until thickened; incorporate the butter and almond extract, then cool.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Spoon the cooled filling into the bottom crust. Cover with the top crust, seal the edges, and cut vents."
    },
    {
      "step": 7,
      "text": "Bake until the crust is golden brown and the filling is bubbling.",
      "timer_minutes": 55
    },
    {
      "step": 8,
      "text": "Cool the pie before slicing. Whisk any remaining filling juices until smooth, if needed."
    }
  ],
