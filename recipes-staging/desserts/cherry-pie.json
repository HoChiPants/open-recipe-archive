  "id": "cherry-pie",
  "name": "Cherry Pie",
  "subtitle": "Tart cherry filling in a flaky crust",
  "description": "A classic American fruit pie combining sour cherries with a thickened almond-scented filling and tender shortening pastry.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
