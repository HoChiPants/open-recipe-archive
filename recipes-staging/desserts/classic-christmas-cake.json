  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 300°F. Prepare a deep cake pan with parchment paper."
    },
    {
      "step": 2,
      "text": "Combine the dried fruit, citrus zest and juice, brandy or other listed spirit, softened butter, brown sugar, and mixed spice in a saucepan. Warm gently until the butter melts and the mixture is combined.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Remove from the heat and cool the fruit mixture for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Stir together the flour, ground almond, baking powder, cinnamon, cloves, and flaked almonds."
    },
    {
      "step": 5,
      "text": "Beat the eggs and vanilla into the cooled fruit mixture, then fold in the dry ingredients until evenly mixed."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan and smooth the surface."
    },
    {
      "step": 7,
      "text": "Bake for 120 minutes, then continue baking for 10 minutes, until the center is firm and a skewer inserted in the middle comes out clean.",
      "timer_minutes": 130
    },
    {
      "step": 8,
      "text": "Cool the cake in the pan, then remove it and cool completely. Feed with additional listed spirit if desired before serving."
    }
  ],
