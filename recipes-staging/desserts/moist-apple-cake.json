      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, salt, 4 teaspoons cinnamon, and baking powder together."
    },
    {
      "step": 3,
      "text": "Whisk the eggs and 2 cups sugar for 3 minutes, then mix in the vegetable oil and vanilla until combined.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the dry ingredients and mix just until incorporated. Fold in the apples and walnuts."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a prepared baking pan."
    },
    {
      "step": 6,
      "text": "Combine 4 teaspoons sugar with 1 teaspoon cinnamon and sprinkle over the batter."
    },
    {
      "step": 7,
      "text": "Bake until the center is fully set, about 60 minutes; an egg-containing cake should reach 160°F if checked with a thermometer.",
      "timer_minutes": 60
    }
  ],
