      "item": "vegetable oil",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
