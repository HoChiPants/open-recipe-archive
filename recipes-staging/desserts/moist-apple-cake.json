  "id": "moist-apple-cake",
  "name": "Moist Apple Cake",
  "subtitle": "A cinnamon-scented cake with sliced apples and walnuts",
  "description": "This simple American apple cake combines a tender oil-based batter with apples, walnuts, and a cinnamon-sugar finish.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
