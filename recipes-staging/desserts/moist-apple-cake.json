    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "apple",
      "item": "apple",
      "quantity": 5,
      "preparation": "peeled, cored and sliced"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
