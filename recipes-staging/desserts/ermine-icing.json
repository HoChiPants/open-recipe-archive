{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "ermine-icing",
  "name": "Ermine Icing",
  "subtitle": "Light, smooth frosting with a cooked milk base",
  "description": "A fluffy American-style icing made by thickening milk with flour, chilling it, and whipping it with sweetened butter and vanilla.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 5,
    "inactive_minutes": 480
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the milk and flour together in a saucepan until smooth. Cook over medium heat, stirring constantly, until thickened; remove from the heat.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Transfer the thickened mixture to a bowl, cover, and chill until completely cold, about 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 3,
      "text": "Whisk the sugar, butter, and salt together until smooth and fluffy."
    },
    {
      "step": 4,
      "text": "Gradually stir the chilled milk mixture into the butter mixture until incorporated."
    },
    {
      "step": 5,
      "text": "Whisk until light and creamy, about 10 minutes, then blend in the vanilla extract.",
      "timer_minutes": 10
    }
  ],
