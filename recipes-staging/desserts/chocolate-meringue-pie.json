  "id": "chocolate-meringue-pie",
  "name": "Chocolate Meringue Pie",
  "subtitle": "Creamy cocoa filling beneath a lightly browned meringue",
  "description": "A baked pie with a smooth chocolate filling and fluffy meringue topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "9-inch-pie-shell",
      "item": "(9 inch) pie shell",
      "quantity": 1,
      "preparation": "baked"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 2
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Melt the butter and set it aside."
    },
    {
      "step": 2,
      "text": "Combine the sugar, cocoa powder, and flour. Whisk the egg yolks and milk together, then blend in the dry mixture."
    },
    {
      "step": 3,
      "text": "Cook the filling mixture with the melted butter until thickened and it reaches 160°F. Stir in the vanilla extract, then transfer the filling to the baked pie shell."
    },
    {
      "step": 4,
      "text": "Whisk the egg whites with the remaining sugar until soft peaks form, then continue until stiff peaks form. Spread the meringue over the filling, covering the edges."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until the meringue is golden brown and set.",
      "timer_minutes": 15
    }
  ],
