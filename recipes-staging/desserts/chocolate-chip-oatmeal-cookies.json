  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Blend the rolled oats with the baking powder, then set aside."
    },
    {
      "step": 3,
      "text": "Whisk the softened butter, white sugar, and packed brown sugar until combined. Whisk in the eggs and vanilla extract."
    },
    {
      "step": 4,
      "text": "Combine the flour, oat mixture, salt, and baking soda. Stir the dry ingredients into the butter mixture."
    },
    {
      "step": 5,
      "text": "Stir in the semisweet chocolate chips, grated milk chocolate, and walnuts."
    },
    {
      "step": 6,
      "text": "Prepare portions of dough on baking sheets, leaving space between them."
    },
    {
      "step": 7,
      "text": "Bake for 8 minutes, until the cookies are set and lightly browned at the edges.",
      "timer_minutes": 8
    }
  ],
