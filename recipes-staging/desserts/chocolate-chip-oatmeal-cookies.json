  "id": "chocolate-chip-oatmeal-cookies",
  "name": "Chocolate Chip Oatmeal Cookies",
  "subtitle": "Crisp-edged cookies with chocolate and walnuts",
  "description": "A generous batch of oatmeal cookies combining brown sugar, chocolate, and chopped walnuts.",
  "meal_type": "dessert",
