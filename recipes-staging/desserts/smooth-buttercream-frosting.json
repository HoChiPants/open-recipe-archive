  "id": "smooth-buttercream-frosting",
  "name": "Smooth Buttercream Frosting",
  "subtitle": "A simple, creamy frosting for cakes and cupcakes",
  "description": "Whip shortening and butter with vanilla, then gradually blend in confectioners' sugar and milk until smooth and spreadable.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-shortening",
      "item": "vegetable shortening",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 5,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 3,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the vegetable shortening and butter for 3 minutes, until smooth.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Stir in the vanilla extract."
    },
    {
      "step": 3,
      "text": "Gradually whisk in the confectioners' sugar, then whisk in the milk until the frosting is smooth and spreadable."
    },
    {
      "step": 4,
      "text": "Use the frosting to garnish or decorate the desired dessert."
    }
  ],
