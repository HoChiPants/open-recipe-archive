  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Stir the pecans, one portion of white sugar, packed light brown sugar, melted butter, cinnamon, and the first salt together until evenly coated; set aside.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Whisk the flour, baking powder, baking soda, and fine sea salt in a bowl."
    },
    {
      "step": 4,
      "text": "Beat the remaining white sugar with the softened unsalted butter until smooth. Whisk in the eggs one at a time, then mix in the sour cream or creme fraiche and vanilla extract."
    },
    {
      "step": 5,
      "text": "Fold the dry ingredients into the wet mixture just until combined."
    },
    {
      "step": 6,
      "text": "Spread the batter in the prepared pan and distribute the pecan mixture over the top."
    },
    {
      "step": 7,
      "text": "Bake until the cake is set and a tester inserted in the center comes out clean, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 8,
      "text": "Cool before serving."
    }
  ],
