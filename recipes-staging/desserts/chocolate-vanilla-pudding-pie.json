  "id": "chocolate-vanilla-pudding-pie",
  "name": "Chocolate-Vanilla Pudding Pie",
  "subtitle": "A chilled pie with creamy cheesecake and pudding layers",
  "description": "Layer smooth chocolate-vanilla pudding and sweetened cream cheese with whipped topping in a graham cracker crust, then chill until set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "instant-chocolate-pudding-mix",
      "item": "instant chocolate pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.9 ounce"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "9-inch-prepared-graham-cracker-crust",
      "item": "(9 inch) prepared graham cracker crust",
      "quantity": 1
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "8-ounce-tub-frozen-whipped-topping",
      "item": "(8 ounce) tub frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "instant-vanilla-pudding-mix",
      "item": "instant vanilla pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.4 ounce"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the instant chocolate pudding mix with 1.5 cups milk until smooth. Repeat with the instant vanilla pudding mix and the remaining 1.5 cups milk."
    },
    {
      "step": 2,
      "text": "Spoon the pudding mixture into the prepared graham cracker crust."
    },
    {
      "step": 3,
      "text": "Beat the softened cream cheese with the confectioners' sugar until smooth. Fold in the thawed frozen whipped topping."
    },
    {
      "step": 4,
      "text": "Spread the cream cheese mixture over the pudding layer and smooth the surface."
    },
    {
      "step": 5,
      "text": "Chill for 30 minutes, or until set, before serving.",
      "timer_minutes": 30
    }
  ],
