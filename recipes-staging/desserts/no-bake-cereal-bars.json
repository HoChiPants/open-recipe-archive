{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "no-bake-cereal-bars",
  "name": "No-Bake Cereal Bars",
  "subtitle": "Crunchy peanut cereal squares with chocolate pieces",
  "description": "A quick pressed bar made from toasted oat cereal, crispy rice cereal, peanuts, chocolate pieces, and a warm peanut butter syrup.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "oat-cereal",
      "item": "oat cereal",
      "quantity": 4,
      "unit": "cups",
      "preparation": "toasted"
    },
    {
      "ingredient_id": "crispy-rice-cereal",
      "item": "crispy rice cereal",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "dry-roasted-peanuts",
      "item": "dry-roasted peanuts",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "candy-coated-milk-chocolate-pieces",
      "item": "candy-coated milk chocolate pieces",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "light-corn-syrup",
      "item": "light corn syrup",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "creamy-peanut-butter",
      "item": "creamy peanut butter",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the oat cereal, crispy rice cereal, dry-roasted peanuts, and candy-coated milk chocolate pieces in a large bowl."
    },
    {
      "step": 2,
      "text": "Bring the light corn syrup and white sugar to a simmer in a saucepan, stirring until the sugar dissolves."
    },
    {
      "step": 3,
      "text": "Remove from the heat and stir in the creamy peanut butter and vanilla extract until smooth."
    },
    {
      "step": 4,
      "text": "Pour the warm mixture over the cereal mixture and stir until evenly coated."
    },
    {
      "step": 5,
      "text": "Press the mixture firmly into a prepared pan and let it set."
    },
    {
      "step": 6,
      "text": "Cut into 24 bars."
    }
  ],
  "tags": [
