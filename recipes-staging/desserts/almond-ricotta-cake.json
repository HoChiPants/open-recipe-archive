  "id": "almond-ricotta-cake",
  "name": "Almond Ricotta Cake",
  "subtitle": "A light almond cake with ricotta, lemon, and a crisp sliced-almond topping.",
  "description": "Whipped egg whites give this tender Italian-style cake an airy texture. Cool completely before dusting and slicing.",
  "meal_type": "dessert",
  "cuisine": "Italian",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
