  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Grease and line a cake pan."
    },
    {
      "step": 2,
      "text": "Beat 3/4 cup white sugar, the butter, lemon zest, and vanilla sugar until pale and creamy, about 3 minutes. Beat in the egg yolks one at a time, then stir in the lemon juice.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Fold in the almond flour and ricotta until evenly combined."
    },
    {
      "step": 4,
      "text": "In a clean bowl, whisk the egg whites until foamy. Gradually whisk in the remaining 1/3 cup white sugar and continue until stiff peaks form."
    },
    {
      "step": 5,
      "text": "Fold the whipped whites into the ricotta mixture in additions, keeping the batter as light as possible. Transfer to the prepared pan and scatter the sliced almonds over the top."
    },
    {
      "step": 6,
      "text": "Bake until lightly browned and the center is firm and fully set, about 50 minutes.",
      "timer_minutes": 50
    },
    {
      "step": 7,
      "text": "Cool the cake in the pan, then let it stand until completely cool, about 60 minutes. Dust with confectioners' sugar before serving.",
      "timer_minutes": 60
    }
  ],
