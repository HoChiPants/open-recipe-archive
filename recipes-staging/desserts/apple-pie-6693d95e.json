  "id": "apple-pie-6693d95e",
  "name": "Apple Pie",
  "subtitle": "A classic double-crust pie with cinnamon apples",
  "description": "Tart apples are layered with a simple cinnamon-sugar filling, dotted with butter, and baked in a flaky double crust.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 50
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "double-crust-pie-pastry",
      "item": "double-crust pie pastry",
      "quantity": 1,
      "unit": "package",
      "preparation": "14.1 ounce, thawed"
    },
    {
      "ingredient_id": "tart-apples",
      "item": "tart apples",
      "quantity": 6,
      "unit": "medium",
      "preparation": "peeled, cored and sliced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the sugar, flour, and cinnamon."
    },
    {
      "step": 3,
      "text": "Fit one pastry crust into a pie dish. Arrange the apples in the crust, then sprinkle evenly with the sugar mixture and dot with the butter."
    },
    {
      "step": 4,
      "text": "Cover with the remaining pastry, seal and crimp the edges, and cut vents in the top."
    },
    {
      "step": 5,
      "text": "Bake until the crust is golden brown and the filling is bubbling, about 50 minutes.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Let the pie set briefly before serving."
    }
  ],
