  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 250°F. Beat the egg whites with the cream of tartar until foamy, then gradually beat in 1 cup of white sugar until glossy, stiff peaks form."
    },
    {
      "step": 2,
      "text": "Spread the meringue in a pie dish, building it slightly higher around the sides. Bake until dry and firm, about 120 minutes. Turn off the oven and let the shell cool completely.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Whisk the egg yolks, 0.5 cup white sugar, 2 teaspoons lemon zest, and lemon juice in a heatproof bowl. Cook over gently simmering water, stirring, until thick and the mixture reaches 160°F."
    },
    {
      "step": 4,
      "text": "Remove the lemon filling from the heat and cool it to room temperature."
    },
    {
      "step": 5,
      "text": "Whip the heavy cream with the cream of tartar until it thickens. Add the remaining lemon zest and continue whipping until soft peaks form."
    },
    {
      "step": 6,
      "text": "Spoon the cooled lemon filling into the meringue shell and spread the whipped cream over it."
    },
    {
      "step": 7,
      "text": "Refrigerate the pie until thoroughly chilled before slicing.",
      "timer_minutes": 60
    }
  ],
