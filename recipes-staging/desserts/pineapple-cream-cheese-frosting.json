  "id": "pineapple-cream-cheese-frosting",
  "name": "Pineapple Cream Cheese Frosting",
  "subtitle": "A smooth, tangy frosting with pineapple flavor",
  "description": "This quick American-style frosting combines softened butter and cream cheese with pineapple juice and sifted confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 32,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "room temperature"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, room temperature"
    },
    {
      "ingredient_id": "pineapple-juice",
      "item": "pineapple juice",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 4,
      "unit": "cups",
      "preparation": "sifted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the room-temperature butter and cream cheese until smooth."
    },
    {
      "step": 2,
      "text": "Whisk in the pineapple juice until evenly blended."
    },
    {
      "step": 3,
      "text": "Gradually whisk in the sifted confectioners' sugar until the frosting is smooth and spreadable."
    }
  ],
