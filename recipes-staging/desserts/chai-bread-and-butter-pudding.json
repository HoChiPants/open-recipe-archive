  "id": "chai-bread-and-butter-pudding",
  "name": "Chai Bread and Butter Pudding",
  "subtitle": "Spiced custard, tea, and toasted almonds",
  "description": "Buttered white bread layered with sultanas and baked in a warmly spiced chai custard until set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
