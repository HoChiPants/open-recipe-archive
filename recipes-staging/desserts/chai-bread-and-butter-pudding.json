  "instructions": [
    {
      "step": 1,
      "text": "Cover the sultanas with boiling water and leave for 5 minutes. Drain well.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Butter the tin and both sides of the bread. Cut the bread into triangles and arrange it in the tin, scattering the drained sultanas between the layers."
    },
    {
      "step": 3,
      "text": "Heat the milk and double cream with the ginger, cardamom, cloves, cinnamon stick, and teabags. Bring just to a simmer, then remove from the heat and steep for 10 minutes. Remove the teabags and whole spices.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Whisk the eggs, yolks, and caster sugar. Gradually whisk in the warm infused milk mixture."
    },
    {
      "step": 5,
      "text": "Pour the custard over the bread and let it stand for 20 minutes so the bread absorbs it.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Heat the oven to 350°F. Sprinkle the demerara sugar and flaked almonds over the pudding."
    },
    {
      "step": 7,
      "text": "Bake for about 30 minutes, until puffed and the center is fully set and reaches 160°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Serve warm with ice cream or cream to serve."
    }
  ],
