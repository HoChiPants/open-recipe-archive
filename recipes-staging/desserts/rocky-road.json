  "id": "rocky-road",
  "name": "Rocky Road",
  "subtitle": "A chilled chocolate-peanut treat with marshmallows",
  "description": "Melt chocolate with peanut butter, fold in marshmallows, and chill until firm for an easy bar-style dessert.",
  "meal_type": "dessert",
  "cuisine": "British",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
