  "ingredients": [
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "miniature-marshmallows",
      "item": "miniature marshmallows",
      "quantity": 4,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the semisweet chocolate chips and peanut butter together, stirring until smooth."
    },
    {
      "step": 2,
      "text": "Stir in the miniature marshmallows until evenly coated."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a pan and spread it into an even layer."
    },
    {
      "step": 4,
      "text": "Chill for 60 minutes, or until set.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Cut into pieces and serve."
    }
  ],
