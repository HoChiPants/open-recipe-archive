  "id": "strawberry-rhubarb-crisp",
  "name": "Strawberry Rhubarb Crisp",
  "subtitle": "A bubbly fruit dessert with an oat topping",
  "description": "Strawberries and rhubarb bake beneath a buttery brown-sugar oat topping until lightly browned.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 3,
      "unit": "cups",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "rhubarb",
      "item": "rhubarb",
      "quantity": 3,
      "unit": "cups",
      "preparation": "diced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Lightly prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Combine the strawberries, rhubarb, white sugar, and 3 tablespoons flour, then transfer the fruit mixture to the prepared dish."
    },
    {
      "step": 3,
      "text": "Mix the remaining flour with the brown sugar and rolled oats. Work in the butter until the mixture forms coarse crumbs."
    },
    {
      "step": 4,
      "text": "Layer the oat mixture over the fruit."
    },
    {
      "step": 5,
      "text": "Bake for 45 minutes, or until the fruit is bubbling and the topping is lightly browned.",
      "timer_minutes": 45
    }
  ],
