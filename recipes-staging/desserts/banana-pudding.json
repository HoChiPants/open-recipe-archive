  "id": "banana-pudding",
  "name": "Banana Pudding",
  "subtitle": "Creamy layered pudding with bananas and wafers",
  "description": "A chilled American dessert layered with vanilla pudding, bananas, wafers, and a creamy topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "instant-vanilla-pudding-mix",
      "item": "instant vanilla pudding mix",
      "quantity": 2,
      "unit": "package",
      "preparation": "3.4 ounce"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "8-ounce-container-sour-cream",
      "item": "(8 ounce) container sour cream",
      "quantity": 1
    },
    {
      "ingredient_id": "8-ounce-container-frozen-whipped-topping",
      "item": "(8 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "banana",
      "item": "bananas",
      "quantity": 6,
      "preparation": "sliced"
    },
    {
      "ingredient_id": "vanilla-wafers",
      "item": "vanilla wafers",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "12 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the instant vanilla pudding mix, milk, and sweetened condensed milk until evenly moistened. Chill for 15 minutes to set.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Stir the chilled pudding mixture until smooth."
    },
    {
      "step": 3,
      "text": "Whisk the sour cream and thawed whipped topping together, then fold in the sliced bananas."
    },
    {
      "step": 4,
      "text": "Layer vanilla wafers and the pudding mixture in a serving dish, then transfer and arrange the remaining wafers on top."
    },
    {
      "step": 5,
      "text": "Chill until ready to serve."
    }
  ],
