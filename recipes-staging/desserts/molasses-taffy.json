{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "molasses-taffy",
  "name": "Molasses Taffy",
  "subtitle": "Chewy homemade candy with deep molasses flavor",
  "description": "A classic pulled taffy made by cooking molasses and sugar to the firm-ball stage, then aerating it as it cools for a chewy texture.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 30,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10,
    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "molasses",
      "item": "molasses",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-vinegar",
      "item": "white vinegar",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly butter a heatproof pan or tray and set out the baking soda."
    },
    {
      "step": 2,
      "text": "Combine the sugar, molasses, water, and vinegar in a heavy saucepan. Heat, stirring until the sugar dissolves, then cook without stirring to 265°F."
    },
    {
      "step": 3,
      "text": "Remove from the heat and quickly stir in the butter and baking soda until incorporated."
    },
    {
      "step": 4,
      "text": "Pour the hot mixture into the prepared pan and let it cool until safe to handle but still pliable, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Butter your hands lightly, then fold and pull the taffy repeatedly until it becomes lighter and golden brown."
    },
    {
      "step": 6,
      "text": "Cut the taffy into 30 pieces and wrap or store in an airtight container."
    }
  ],
