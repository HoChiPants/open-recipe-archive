  "id": "pineapple-banana-walnut-cake",
  "name": "Pineapple Banana Walnut Cake",
  "subtitle": "A moist fruit-and-nut cake for sharing",
  "description": "A warmly spiced cake combining crushed pineapple, mashed banana, and chopped walnuts in a simple batter.",
  "meal_type": "dessert",
