  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the flour, sugar, baking soda, salt, and cinnamon in a large bowl."
    },
    {
      "step": 3,
      "text": "Add the eggs, oil, vanilla, pineapple, banana, and walnuts. Stir until the ingredients are evenly combined and a thick batter forms."
    },
    {
      "step": 4,
      "text": "Transfer the batter to a prepared baking pan and spread it evenly."
    },
    {
      "step": 5,
      "text": "Bake for 75 minutes, until the center is firm and a tester inserted in the middle comes out clean.",
      "timer_minutes": 75
    },
    {
      "step": 6,
      "text": "Cool briefly, then slice and serve."
    }
  ],
