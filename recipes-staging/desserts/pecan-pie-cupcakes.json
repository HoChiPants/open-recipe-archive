{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pecan-pie-cupcakes",
  "name": "Pecan Pie Cupcakes",
  "subtitle": "Tender pecan-filled treats with a buttery vanilla batter",
  "description": "These small pecan desserts combine brown sugar, chopped nuts, and a simple egg-based batter in a cupcake pan.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "cooking-spray",
      "item": "cooking spray"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat nine cupcake wells with cooking spray."
    },
    {
      "step": 2,
      "text": "Stir together the brown sugar, pecans, and flour."
    },
    {
      "step": 3,
      "text": "Whisk the eggs until well blended and slightly thickened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Fold the melted butter and vanilla into the eggs, then stir in the brown sugar mixture until evenly combined."
    },
    {
      "step": 5,
      "text": "Divide the batter among the prepared wells."
    },
    {
      "step": 6,
      "text": "Bake until the centers are firm and fully set, about 25 minutes; if checked with a thermometer, they should reach 160°F.",
      "timer_minutes": 25
    }
  ],
  "tags": [
    "dessert",
    "baking",
