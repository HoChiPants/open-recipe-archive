{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "banket",
  "name": "Banket",
  "subtitle": "Almond-filled pastry rolls",
  "description": "A crisp pastry wrapped around a sweet almond filling and baked until golden and set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "almond-paste",
      "item": "almond paste",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "almond-extract",
      "item": "almond extract",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": 1,
      "preparation": "beaten"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the flour in a mixing bowl and cut in the butter until the mixture is crumbly."
    },
    {
      "step": 2,
      "text": "Add the water and combine to form a dough. Chill the dough while preparing the filling."
    },
    {
      "step": 3,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 4,
      "text": "Blend the almond paste, eggs, white sugar, almond extract, and salt until smooth."
    },
    {
      "step": 5,
      "text": "Divide the chilled dough into portions and shape each into a thin strip. Place filling along the strips, fold the dough over it, and seal the edges."
    },
    {
      "step": 6,
      "text": "Transfer the filled pastries to a baking sheet. Brush with the beaten egg white and sprinkle with the white sugar."
    },
    {
      "step": 7,
      "text": "Bake for 20 minutes, until golden and the filling is fully set and reaches 160°F.",
      "timer_minutes": 20
    }
  ],
