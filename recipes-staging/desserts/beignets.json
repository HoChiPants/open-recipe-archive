  "id": "beignets",
  "name": "Beignets",
  "subtitle": "Light fried dough dusted with sugar",
  "description": "Make a soft enriched dough, chill it, cut it into pieces, and deep-fry until golden before dusting with icing sugar.",
  "meal_type": "dessert",
  "cuisine": "French",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "fast-action-dried-yeast",
      "item": "fast-action dried yeast",
      "quantity": 4,
      "unit": "g"
    },
    {
      "ingredient_id": "strong-white-bread-flour-plus-extra-for-dusting",
      "item": "strong white bread flour plus extra for dusting",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 25,
      "unit": "g"
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "medium"
    },
    {
      "ingredient_id": "unsalted-butter-melted",
      "item": "unsalted butter melted",
      "quantity": 25,
      "unit": "g"
    },
    {
      "ingredient_id": "l-rapeseed-or-vegetable-oil-for-the-bowl-and-deep-frying",
      "item": "l rapeseed or vegetable oil for the bowl and deep-frying",
      "quantity": 1.5
    },
    {
      "ingredient_id": "icing-sugar-for-dusting",
      "item": "icing sugar for dusting"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the yeast, flour, caster sugar, and the oil intended for the bowl and frying."
    },
    {
      "step": 2,
      "text": "Whisk the evaporated milk, egg, and melted butter together, then add the mixture to the dry ingredients."
    },
    {
      "step": 3,
      "text": "Knead for 2 minutes, until the dough is smooth.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Oil a bowl, place the dough inside, cover, and chill for 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 5,
      "text": "Dust the work surface with flour and roll the dough out thick."
    },
    {
      "step": 6,
      "text": "Cut the dough into 20 pieces and transfer them to a prepared tray."
    },
    {
      "step": 7,
      "text": "Heat the remaining oil for deep-frying until ready for frying."
    },
    {
      "step": 8,
      "text": "Fry the pieces in batches for about 3 minutes, turning as needed, until golden brown and cooked through; the centers should reach 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 9,
      "text": "Drain well and dust with icing sugar before serving."
    }
  ],
