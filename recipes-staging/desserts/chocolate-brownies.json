  "id": "chocolate-brownies",
  "name": "Chocolate Brownies",
  "subtitle": "Fudgy brownies with a deep chocolate flavor",
  "description": "A simple batch of rich chocolate brownies baked until set and cooled before slicing.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30,
    "inactive_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "unsweetened-chocolate",
      "item": "unsweetened chocolate",
      "quantity": 3,
      "unit": "ounces",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.25,
      "unit": "cups"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "pure-vanilla-extract",
      "item": "pure vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a baking pan for the batter."
    },
    {
      "step": 2,
      "text": "Melt the butter with the chopped chocolate, stirring until smooth. Stir in the vanilla extract."
    },
    {
      "step": 3,
      "text": "Whisk the flour and kosher salt together in a separate bowl."
    },
    {
      "step": 4,
      "text": "Beat the sugar and eggs until thick, then mix in the melted chocolate mixture. Fold in the flour mixture just until combined.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake until the center is set.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool in the pan for 15 minutes, then prepare for serving and cool completely for about 30 minutes before cutting.",
      "timer_minutes": 30
    }
  ],
