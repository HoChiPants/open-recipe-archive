  "instructions": [
    {
      "step": 1,
      "text": "Combine the strong flour, brown sugar, orange zest, yeast, milk, mixed spice, cinnamon, cardamom, nutmeg, and one beaten egg in a large bowl. Add the chopped stem ginger and its syrup, then mix to form a dough."
    },
    {
      "step": 2,
      "text": "Transfer the dough to a lightly oiled surface and knead for 6 minutes. Work in the softened butter with the remaining sugar, then knead for 8 minutes until smooth and elastic.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Knead in the chopped chocolate and dried cherries. Cover the dough and leave it to rise until doubled in size, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Divide the dough into 12 pieces and shape each into a smooth bun. Arrange them in an oiled tin, cover, and leave to rise for 45 minutes.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Heat the oven and mix the plain flour with the strong flour to make a thick paste. Transfer the paste to a piping bag or paper cone."
    },
    {
      "step": 6,
      "text": "Brush the buns with the remaining beaten egg, then pipe crosses over the tops."
    },
    {
      "step": 7,
      "text": "Bake for 25 minutes, until risen and deeply golden. Cool slightly before serving.",
      "timer_minutes": 25
    },
    {
      "step": 8,
      "text": "Serve warm, with softened butter if desired."
    }
  ],
