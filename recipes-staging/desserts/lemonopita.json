  "id": "lemonopita",
  "name": "Lemonopita",
  "subtitle": "Greek lemon cake with crisp phyllo layers",
  "description": "A syrup-soaked Greek dessert combining tangy yogurt batter with folded phyllo for a crisp, tender texture.",
