  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Separate the phyllo sheets, cut them into pieces, and arrange them in a baking dish in loose layers. Bake for 10 minutes, then cool.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Combine 3 cups sugar, water, and the lemon in a saucepan. Bring to a simmer and cook for 8 minutes. Remove the lemon and let the syrup cool.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Whisk the yogurt, sunflower seed oil, 0.75 cup sugar, eggs, vanilla extract, and baking powder until combined. Add the cooled phyllo pieces and stir to coat evenly."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the baking dish and spread it into an even layer. Bake at 350°F for about 45 minutes, until set in the center.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Prepare the lemon as needed for serving, pour the cooled syrup over the hot cake, and let it cool completely. Refrigerate until fully set, about 4 hours, then cut into portions.",
      "timer_minutes": 240
    }
  ],
