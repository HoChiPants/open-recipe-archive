  "id": "walnut-cream-cheese-bars",
  "name": "Walnut Cream Cheese Bars",
  "subtitle": "Tender crust with a brown-sugar walnut topping",
  "description": "A simple layered dessert with a soft cream cheese crust and a rich walnut filling.",
  "meal_type": "dessert",
