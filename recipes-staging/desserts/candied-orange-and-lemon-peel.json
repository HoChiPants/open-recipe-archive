  "id": "candied-orange-and-lemon-peel",
  "name": "Candied Orange and Lemon Peel",
  "subtitle": "Tender citrus peel with a crisp sugar coating",
  "description": "Citrus peels are simmered until tender, cooked in sugar syrup, and finished with decorative sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30,
    "inactive_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "lemon-peels",
      "item": "lemon peels",
      "quantity": 6,
      "preparation": "cut into 1/4 inch strips"
    },
    {
      "ingredient_id": "orange-peels",
      "item": "orange peels",
      "quantity": 4,
      "preparation": "cut into 1/4 inch strips"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-sugar-for-decoration",
      "item": "white sugar for decoration",
      "quantity": 0.33333334326744,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the lemon peels, orange peels, and water in a saucepan. Bring to a simmer and cook for 20 minutes, until the peels are tender.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Combine the white sugar, water, and white sugar for decoration in the saucepan. Simmer until the syrup reaches 230°F on a food thermometer."
    },
    {
      "step": 3,
      "text": "Stir the cooked lemon and orange peels into the syrup until evenly coated."
    },
    {
      "step": 4,
      "text": "Preheat the oven for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Drain the peels, then separate and arrange them for drying."
    },
    {
      "step": 6,
      "text": "Shape or separate the peels as needed, then coat them with the white sugar and white sugar for decoration."
    },
    {
      "step": 7,
      "text": "Let the candied peels dry at room temperature for 4 hours before serving or storing.",
      "timer_minutes": 240
    }
  ],
