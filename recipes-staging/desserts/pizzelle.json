{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pizzelle",
  "name": "Pizzelle",
  "subtitle": "Thin, crisp Italian waffle cookies with lemon and vanilla",
  "description": "A simple pizzelle batter flavored with lemon zest and vanilla, cooked in a pizzelle iron until lightly golden and crisp.",
  "meal_type": "dessert",
  "cuisine": "Italian",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 6
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 4,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the eggs until blended. Stir in the sugar, melted butter, lemon zest, and vanilla."
    },
    {
      "step": 2,
      "text": "Mix the flour and baking powder separately, then stir them into the egg mixture just until a thick batter forms."
    },
    {
      "step": 3,
      "text": "Preheat the pizzelle iron according to the manufacturer's instructions and prepare it for cooking."
    },
    {
      "step": 4,
      "text": "Cook portions of batter in the iron until the pizzelle are lightly golden and set.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Transfer the pizzelle to a rack and let them cool completely before serving."
    }
  ],
