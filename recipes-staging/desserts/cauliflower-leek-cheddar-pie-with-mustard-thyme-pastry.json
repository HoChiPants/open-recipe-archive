  "instructions": [
    {
      "step": 1,
      "text": "Rub the cold butter into the flour until crumbly. Mix in the tablespoon of English mustard and thyme leaves, add enough cold water to form a dough, then chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Cut the cauliflower into medium pieces. Cook it in boiling water for about 10 minutes, until just tender; drain well.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Heat the olive oil in a pan and cook the sliced leeks until softened. Set aside to cool.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Heat the oven to 400°F. Roll out about two-thirds of the pastry on a floured surface and use it to line a pie dish. Trim the edge."
    },
    {
      "step": 5,
      "text": "Whisk the eggs with the teaspoon of English mustard. Fold in the cauliflower, leeks, and grated cheddar, then spoon the filling into the pastry case."
    },
    {
      "step": 6,
      "text": "Roll out the remaining pastry and place it over the filling. Seal and shape the edge, cut a small vent in the top, and brush with the beaten egg."
    },
    {
      "step": 7,
      "text": "Bake for 45 minutes, then reduce the oven to 350°F and bake for 10 minutes more. The center should be firm and reach 160°F; rest briefly before serving.",
      "timer_minutes": 10
    }
  ],
