  "id": "cauliflower-leek-cheddar-pie-with-mustard-thyme-pastry",
  "name": "Cauliflower, Leek & Cheddar Pie with Mustard-Thyme Pastry",
  "subtitle": "A savory vegetable pie with sharp cheddar and herb mustard pastry.",
  "description": "Tender cauliflower and leeks are folded with cheddar and eggs, enclosed in mustard-thyme pastry, and baked until golden and set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 60
  },
  "ingredients": [
