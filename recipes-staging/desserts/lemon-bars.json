  "id": "lemon-bars",
  "name": "Lemon Bars",
  "subtitle": "A buttery crust with a bright lemon filling",
  "description": "Bake a shortbread-style crust, top it with lemon filling, and finish the cooled bars with confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
