  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine 1.5 cups all-purpose flour, confectioners' sugar, and softened butter or margarine. Press the mixture evenly into a baking pan."
    },
    {
      "step": 3,
      "text": "Bake the crust until lightly set, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Whisk the eggs, white sugar, 3 tablespoons all-purpose flour, and lemon juice until smooth."
    },
    {
      "step": 5,
      "text": "Pour the filling over the hot crust and bake until golden brown and the center is fully set, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Cool completely, dust with confectioners' sugar for decoration, and cut into bars."
    }
  ],
