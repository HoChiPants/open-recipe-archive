  "instructions": [
    {
      "step": 1,
      "text": "Combine the carrots, potatoes, 1 cup sugar, raisins, flour, baking soda, cinnamon, allspice, and cloves until evenly mixed."
    },
    {
      "step": 2,
      "text": "Transfer the mixture to a heatproof pudding mold and cover securely."
    },
    {
      "step": 3,
      "text": "Place the mold in a pot with simmering water, keeping the water below the mold's rim."
    },
    {
      "step": 4,
      "text": "Cover the pot and cook the pudding for 120 minutes, maintaining a gentle simmer.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "For the sauce, combine the remaining 1 cup sugar, butter, cream, and vanilla in a saucepan."
    },
    {
      "step": 6,
      "text": "Warm the sauce over medium heat, stirring until the butter melts and the sugar dissolves."
    },
    {
      "step": 7,
      "text": "Serve the warm pudding with the vanilla cream sauce."
    }
  ],
