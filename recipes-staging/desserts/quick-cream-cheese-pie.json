  "id": "quick-cream-cheese-pie",
  "name": "Quick Cream Cheese Pie",
  "subtitle": "A chilled strawberry pie with a creamy vanilla filling",
  "description": "Layer glazed strawberries in a graham cracker crust, add a smooth cream cheese pudding filling, and chill until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0,
    "inactive_minutes": 800
  },
  "ingredients": [
    {
      "ingredient_id": "ready-to-use-strawberry-glaze",
      "item": "ready-to-use strawberry glaze",
      "quantity": 1,
      "unit": "can",
      "preparation": "18.75 ounce"
    },
    {
      "ingredient_id": "9-inch-prepared-graham-cracker-crust",
      "item": "(9 inch) prepared graham cracker crust",
      "quantity": 1
    },
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 4,
      "unit": "cups",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "cold-milk",
      "item": "cold milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "instant-vanilla-pudding-mix",
      "item": "instant vanilla pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.5 ounce"
    },
    {
      "ingredient_id": "8-ounce-container-frozen-whipped-topping",
      "item": "(8 ounce) container frozen whipped topping",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the prepared graham cracker crust on a work surface and spread in a layer of strawberry glaze. Arrange the sliced strawberries over the glaze."
    },
    {
      "step": 2,
      "text": "Whisk the softened cream cheese until smooth. Add the cold milk and instant vanilla pudding mix, then whisk until combined and thickened."
    },
    {
      "step": 3,
      "text": "Fold in the frozen whipped topping until the filling is evenly blended."
    },
    {
      "step": 4,
      "text": "Whisk the strawberry glaze with the cream cheese mixture, then spread the filling into the crust."
    },
    {
      "step": 5,
      "text": "Top with the remaining whipped topping and sliced strawberries."
    },
    {
      "step": 6,
      "text": "Cover and chill until firm, about 800 minutes.",
      "timer_minutes": 800
    }
  ],
