{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "four-layer-butterscotch-dessert",
  "name": "Four-Layer Butterscotch Dessert",
  "subtitle": "A chilled pecan, cream cheese, and butterscotch pudding dessert",
  "description": "Bake a pecan crust, layer it with a sweet cream cheese mixture and butterscotch pudding, then finish with whipped topping and pecans.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "nonstick-cooking-spray",
      "item": "nonstick cooking spray"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1.25,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1.125,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "8-ounce-container-frozen-whipped-topping",
      "item": "(8 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "instant-butterscotch-pudding-mix",
      "item": "instant butterscotch pudding mix",
      "quantity": 2,
      "unit": "package",
      "preparation": "3.4 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 300°F. Coat a baking dish with nonstick cooking spray."
    },
    {
      "step": 2,
      "text": "Combine the margarine, all-purpose flour, and part of the confectioners' sugar with half of the chopped pecans. Press the mixture evenly into the prepared dish."
    },
    {
      "step": 3,
      "text": "Bake until lightly browned, about 15 minutes. Cool completely.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Whisk the cream cheese with the remaining confectioners' sugar until smooth, then fold in half of the thawed whipped topping. Spread over the cooled crust."
    },
    {
      "step": 5,
      "text": "Whisk the milk and instant butterscotch pudding mix until combined and thickened. Spread over the cream cheese layer."
    },
    {
      "step": 6,
      "text": "Top with the remaining thawed whipped topping and the remaining chopped pecans."
    },
    {
      "step": 7,
      "text": "Chill until set before slicing and serving."
    }
  ],
