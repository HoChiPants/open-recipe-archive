      "item": "egg",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Prepare six wells of a muffin pan for the cheesecakes."
    },
    {
      "step": 2,
      "text": "Mix the graham cracker crumbs and 1 tablespoon white sugar with the melted margarine. Divide the mixture among the prepared wells and press it into the bottoms."
    },
    {
      "step": 3,
      "text": "Bake the crusts for 5 minutes, then remove the pan and let the crusts cool briefly.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Beat the cream cheese with 0.25 cup white sugar, lemon juice, lemon zest, and vanilla extract until smooth. Add the egg and whisk just until combined."
    },
    {
      "step": 5,
      "text": "Divide the filling over the crusts. Bake at 325°F for 25 minutes, until the centers are firm and fully set; verify an egg-dish temperature of 160°F if using a thermometer.",
      "timer_minutes": 25
    },
    {
      "step": 6,
      "text": "Cool the cheesecakes, then chill for at least 30 minutes before serving.",
      "timer_minutes": 30
    }
  ],
