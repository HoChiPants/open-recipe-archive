  "id": "chocolate-snowman-biscuits",
  "name": "Chocolate Snowman Biscuits",
  "subtitle": "Cocoa biscuits with simple festive decoration",
  "description": "Shape cocoa biscuit dough into snowmen, bake until set, and finish with a smooth icing coating and dried-fruit details.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 12
  },
  "ingredients": [
    {
      "ingredient_id": "plain-flour-plus-extra-for-dusting",
      "item": "plain flour plus extra for dusting",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 130,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "about-200g-icing-sugar",
      "item": "about 200g icing sugar"
    },
    {
      "ingredient_id": "about-3-tbsp-milk",
      "item": "about 3 tbsp milk"
    },
    {
      "ingredient_id": "about-5-cranberries",
      "item": "about 5 cranberries"
    },
    {
      "ingredient_id": "slices-of-dried-mango",
      "item": "slices of dried mango",
      "quantity": "2-3"
    },
    {
      "ingredient_id": "cm",
      "item": "cm",
      "quantity": 6,
      "preparation": "5cm and 3.5cm round cutters"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened butter with the caster sugar and light brown soft sugar until creamy. Beat in the egg and vanilla extract.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Combine the plain flour and cocoa powder, then stir into the butter mixture to form a dough."
    },
    {
      "step": 3,
      "text": "Wrap or cover the dough and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Heat the oven to 350°F (180°C). Lightly flour the work surface and cutters."
    },
    {
      "step": 5,
      "text": "Roll out the dough and cut matching larger and smaller rounds with the 5 cm and 3.5 cm cutters. Arrange the rounds together as snowmen on a baking sheet."
    },
    {
      "step": 6,
      "text": "Bake for 8–12 minutes, until the biscuits are set and the centers reach 160°F. Transfer to a rack and cool completely.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Mix the icing sugar with the milk until smooth. Coat the cooled biscuits with the icing."
    },
    {
      "step": 8,
      "text": "Cut the cranberries and dried mango into small pieces. Use them to decorate the iced snowmen, then let the coating set."
    }
  ],
