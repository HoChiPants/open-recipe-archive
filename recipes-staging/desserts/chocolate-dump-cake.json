  "id": "chocolate-dump-cake",
  "name": "Chocolate Dump Cake",
  "subtitle": "A simple chocolate cake with sour cream and chocolate chips",
  "description": "A moist, chocolate-forward cake made by combining boxed mixes with sour cream, beaten eggs, and chocolate chips, then baking until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
