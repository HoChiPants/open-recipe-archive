  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Prepare a baking pan for the batter."
    },
    {
      "step": 3,
      "text": "Combine the yellow cake mix, chocolate pudding mix, beaten eggs, vegetable oil, sugar, and water in a mixing bowl."
    },
    {
      "step": 4,
      "text": "Whisk in the sour cream and semisweet chocolate chips until evenly incorporated."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and spread it evenly."
    },
    {
      "step": 6,
      "text": "Bake for 55 minutes, until the cake is set in the center.",
      "timer_minutes": 55
    },
    {
      "step": 7,
      "text": "Cool for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
