  "id": "mississippi-mud-cookies",
  "name": "Mississippi Mud Cookies",
  "subtitle": "Chocolate-oat cookies with coconut and walnuts",
  "description": "A quick stovetop cookie mixture is portioned onto a prepared surface and cooled until set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "walnuts",
      "item": "walnuts",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare a baking sheet or tray with parchment paper. Preheat the oven briefly if needed for your equipment, though the cookies are set without baking.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Combine the sugar, butter, and milk in a saucepan. Bring to a simmer, stirring until the butter melts and the mixture is smooth."
    },
    {
      "step": 3,
      "text": "Remove from the heat and stir in the cocoa powder and vanilla extract."
    },
    {
      "step": 4,
      "text": "Fold in the rolled oats, chopped walnuts, and coconut until evenly coated."
    },
    {
      "step": 5,
      "text": "Drop the mixture by spoonfuls onto the prepared sheet and shape as needed."
    },
    {
      "step": 6,
      "text": "Let the cookies cool undisturbed until firm.",
      "timer_minutes": 30
    }
  ],
