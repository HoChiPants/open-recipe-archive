  "id": "strawberry-shortcake",
  "name": "Strawberry Shortcake",
  "subtitle": "Tender biscuits layered with berries and whipped cream",
  "description": "Bake a lightly sweet shortcake, macerate fresh strawberries, and assemble with vanilla whipped cream for a classic fruit dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "plus more for topping"
    },
    {
