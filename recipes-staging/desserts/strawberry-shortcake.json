      "item": "heavy whipping cream",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "plus more for brushing"
    },
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 4,
      "unit": "pints",
      "preparation": "hulled and quartered"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 3,
      "unit": "drops"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Melt the butter and stir it for 3 minutes as directed by the preparation method; let it cool slightly.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Whisk the flour and 0.25 cup sugar in a bowl. Stir in the melted butter, milk, and 0.25 cup cream until combined."
    },
    {
      "step": 3,
      "text": "Turn the dough onto a lightly floured surface, shape it into a thick round, and cut it into portions. Transfer to a baking sheet, brush with additional cream, and sprinkle with sugar."
    },
    {
      "step": 4,
      "text": "Bake until golden brown, about 18 minutes, then transfer the shortcakes to a rack to cool.",
      "timer_minutes": 18
    },
    {
      "step": 5,
      "text": "Toss the quartered strawberries with 0.5 cup sugar and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Whisk 0.75 cup cream with 1 tablespoon sugar and the vanilla until soft peaks form."
    },
    {
      "step": 7,
      "text": "Split the cooled shortcakes, fill with strawberries and their juices, and top with whipped cream and additional strawberries."
    }
  ],
