  "id": "air-fryer-stollen-bites",
  "name": "Air-Fryer Stollen Bites",
  "subtitle": "Small festive yeast cakes with marzipan and dried fruit",
  "description": "Tender, fruit-studded stollen bites with a marzipan center, finished with butter and icing sugar after air frying.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "bites"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "unsalted-butter-plus-extra-for-the-tin",
      "item": "unsalted butter plus extra for the tin",
      "quantity": 65,
      "unit": "g"
    },
    {
      "ingredient_id": "strong-white-flour",
      "item": "strong white flour",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "sachet-fast-action-dried-yeast",
      "item": "sachet fast-action dried yeast",
      "quantity": 7,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "of-ground-nutmeg",
      "item": "of ground nutmeg",
      "unit": "pinch"
    },
    {
      "ingredient_id": "of-ground-cloves",
      "item": "of ground cloves",
      "unit": "pinch"
    },
    {
