      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk and butter together until the butter melts. Set aside to cool until just warm."
    },
    {
      "step": 2,
      "text": "Mix the flour, yeast, sugar, nutmeg, cloves, and salt. Stir in the cooled milk mixture to form a dough."
    },
    {
      "step": 3,
      "text": "Knead the dough for 5 minutes, until smooth. Work in the raisins, sultanas, and mixed peel.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Cover the dough and leave it in a warm place until doubled in size.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Butter the tin and lightly oil the work surface. Turn out the dough and divide it into 16 pieces."
    },
    {
      "step": 6,
      "text": "Divide the marzipan into 16 pieces. Flatten each dough piece, place marzipan in the center, and seal the dough around it."
    },
    {
      "step": 7,
      "text": "Arrange the filled dough pieces in the tin, cover, and leave to rise until puffy.",
      "timer_minutes": 60
    },
    {
      "step": 8,
      "text": "Preheat the air fryer according to its baking setting. Cook the bites until golden brown.",
      "timer_minutes": 30
    },
    {
      "step": 9,
      "text": "Cool in the tin for 10 minutes, then brush with melted butter and dust with icing sugar.",
      "timer_minutes": 10
    }
  ],
