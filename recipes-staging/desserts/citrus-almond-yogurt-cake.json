      "preparation": "toasted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease and line a 9-inch round cake tin with the extra butter."
    },
    {
      "step": 2,
      "text": "Melt the butter and let it cool slightly. Zest and juice the lemon and orange, keeping the zest and juice separate."
    },
    {
      "step": 3,
      "text": "Mix the flour, ground almonds, and 200 g of the sugar in a bowl."
    },
    {
      "step": 4,
      "text": "Whisk the melted butter, eggs, and 75 g yogurt together, then stir in the citrus zest."
    },
    {
      "step": 5,
      "text": "Fold the wet mixture into the dry ingredients until just combined. Transfer the batter to the tin and smooth the surface."
    },
    {
      "step": 6,
      "text": "Bake until risen, golden, and a skewer inserted in the center comes out clean, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "While the cake bakes, simmer the citrus juices with the remaining 2 tbsp sugar for 10 minutes, then cool.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Cool the cake in the tin for 5 minutes, then transfer it to a rack and cool completely.",
      "timer_minutes": 5
    },
    {
      "step": 9,
      "text": "Stir the remaining 2 tbsp yogurt with the icing sugar until thick. Spread it over the cooled cake and finish with the toasted flaked almonds."
    }
  ],
