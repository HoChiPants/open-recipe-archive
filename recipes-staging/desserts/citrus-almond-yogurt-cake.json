  "id": "citrus-almond-yogurt-cake",
  "name": "Citrus Almond Yogurt Cake",
  "subtitle": "A tender almond cake with bright citrus and a light yogurt glaze.",
  "description": "A moist citrus-scented cake made with ground almonds and yogurt, finished with a thick glaze and toasted flaked almonds.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "butter-plus-extra-for-the-tin",
      "item": "butter plus extra for the tin",
      "quantity": 165,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar-plus-2-tbsp",
      "item": "golden caster sugar plus 2 tbsp",
      "quantity": 200,
      "unit": "g"
    },
    {
