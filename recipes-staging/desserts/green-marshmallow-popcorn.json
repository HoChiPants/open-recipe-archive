  "instructions": [
    {
      "step": 1,
      "text": "Place the popped popcorn in a large bowl."
    },
    {
      "step": 2,
      "text": "Warm the brown sugar and butter in a saucepan, then add the marshmallows and stir until melted."
    },
    {
      "step": 3,
      "text": "Mix in the green food coloring, pour the mixture over the popcorn, and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Stir in the candy eyeballs and serve."
    }
