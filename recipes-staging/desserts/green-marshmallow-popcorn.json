  "id": "green-marshmallow-popcorn",
  "name": "Green Marshmallow Popcorn",
  "subtitle": "Sweet, chewy popcorn with candy-eye decorations",
  "description": "A quick green marshmallow-coated popcorn treat finished with candy eyeballs.",
