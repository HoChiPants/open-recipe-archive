  "id": "butterscotch-bread-pudding",
  "name": "Butterscotch Bread Pudding",
  "subtitle": "A warm, custardy dessert with brown sugar and butterscotch",
  "description": "Day-old bread absorbs a sweet vanilla custard before baking with butterscotch chips until firm and set.",
  "meal_type": "dessert",
  "cuisine": "American",
