  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the bread, milk, brown sugar, melted butter, beaten eggs, vanilla, and butterscotch chips in a bowl; mix until evenly moistened."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a suitable baking dish."
    },
    {
      "step": 4,
      "text": "Bake for 60 minutes, until the center is fully set and reaches 160°F on a food thermometer.",
