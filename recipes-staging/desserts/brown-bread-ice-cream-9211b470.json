  "id": "brown-bread-ice-cream-9211b470",
  "name": "Brown Bread Ice Cream",
  "subtitle": "Creamy maple ice cream with toasted wholemeal bread",
  "description": "A rich no-churn ice cream combining toasted brown bread with maple, treacle, and condensed milk.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 8
  },
  "ingredients": [
    {
      "ingredient_id": "stale-sliced-brown-bread-or-any-wholemeal-bread",
      "item": "stale sliced brown bread or any wholemeal bread",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 600,
      "unit": "ml"
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "can-sweetened-condensed-milk",
      "item": "can sweetened condensed milk",
      "quantity": 397,
      "unit": "g"
    },
    {
      "ingredient_id": "treacle",
      "item": "treacle",
      "quantity": 2,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Tear or cut the bread into small pieces. Toast it in a dry skillet over medium heat until browned and crisp, stirring regularly.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Whisk the double cream and maple syrup until thickened and softly holding its shape."
    },
    {
      "step": 3,
      "text": "Stir the condensed milk and treacle together, then combine with the whipped cream."
    },
    {
      "step": 4,
      "text": "Whisk in the toasted bread until evenly distributed."
    },
    {
      "step": 5,
      "text": "Transfer to a freezer-safe container, cover, and freeze until firm.",
      "timer_minutes": 360
    },
    {
      "step": 6,
      "text": "Let the ice cream stand at room temperature briefly before scooping.",
      "timer_minutes": 10
    }
  ],
