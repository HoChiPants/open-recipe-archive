  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Grease and flour the cake pan or pans."
    },
    {
      "step": 2,
      "text": "Stir the milk and vinegar together; let stand until set."
    },
    {
      "step": 3,
      "text": "Whisk the flour, sugar, cocoa powder, baking powder, baking soda, and salt in a bowl."
    },
    {
      "step": 4,
      "text": "Whisk the eggs, cold coffee, and vanilla extract together. Stir in the milk mixture and oil."
    },
    {
      "step": 5,
      "text": "Gradually whisk the dry ingredients into the wet mixture until combined."
    },
    {
      "step": 6,
      "text": "Transfer the batter to the prepared pan or pans."
    },
    {
      "step": 7,
      "text": "Bake for 30 minutes, until the center is fully set and reaches 160°F.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Let the cake and cherry pie filling cool. Combine the filling with the cherry liqueur, then chill the mixture before serving with the cake."
    }
  ],
