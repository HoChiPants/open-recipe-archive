  "id": "jewish-apple-cake",
  "name": "Jewish Apple Cake",
  "subtitle": "Cinnamon apples layered through a tender orange-scented cake",
  "description": "A simple apple cake with cinnamon-sugar fruit and a moist citrus-vanilla crumb.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
