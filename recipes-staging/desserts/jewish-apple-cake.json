  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Grease and flour a tube pan."
    },
    {
      "step": 2,
      "text": "Mix the 5 tablespoons sugar with the cinnamon. Toss the sliced apples with the mixture until evenly coated."
    },
    {
      "step": 3,
      "text": "Whisk the 2 cups sugar, oil, eggs, orange juice, and vanilla until blended."
    },
    {
      "step": 4,
      "text": "Stir the flour, baking powder, and salt into the wet mixture until a thick, smooth batter forms."
    },
    {
      "step": 5,
      "text": "Spread part of the batter in the prepared pan, add a layer of apples, and repeat with the remaining batter and apples."
    },
    {
      "step": 6,
      "text": "Bake for 75 minutes, or until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 75
    },
    {
      "step": 7,
      "text": "Cool the cake in the pan for 60 minutes, then loosen the edges and turn it out onto a rack to cool completely.",
      "timer_minutes": 60
    }
  ],
