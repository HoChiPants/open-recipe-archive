      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
