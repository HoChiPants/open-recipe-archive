      "item": "flaked coconut",
      "quantity": 1.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking pan for the cake."
    },
    {
      "step": 2,
      "text": "Combine the all-purpose flour, 1.5 cups white sugar, baking soda, and salt. Add the pineapple with juice and eggs, then mix until evenly combined."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and bake for 35 minutes, or until the center is firm and fully set and registers 160°F.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "While the cake bakes, combine the remaining white sugar, baking soda, evaporated milk, and margarine in a saucepan. Simmer for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Stir the pecans and flaked coconut into the warm topping mixture. Transfer the topping to the baked cake and prepare it for serving."
    }
  ],
