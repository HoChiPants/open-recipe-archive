  "id": "cajun-cake",
  "name": "Cajun Cake",
  "subtitle": "Pineapple cake with coconut-pecan topping",
  "description": "A moist pineapple cake finished with a warm coconut and pecan topping.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
