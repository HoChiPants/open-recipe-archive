  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chanukah-cookies",
  "name": "Chanukah Cookies",
  "subtitle": "Tender orange-vanilla sugar cookies for holiday baking",
  "description": "A simple butter cookie flavored with vanilla and orange juice, shaped and baked until lightly golden and set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "orange-juice",
      "item": "orange juice",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking powder, and salt together in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the butter and sugar until smooth. Add the egg yolks, vanilla extract, and orange juice, and mix until combined."
    },
    {
      "step": 4,
      "text": "Stir the dry ingredients into the butter mixture to form a dough."
    },
    {
      "step": 5,
      "text": "Shape the dough and cut it into cookies. Transfer the pieces to a baking sheet."
    },
    {
      "step": 6,
      "text": "Bake for 12 minutes, until the cookies are lightly golden and the centers are firm and fully set.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Cool the cookies before serving."
    }
  ],
