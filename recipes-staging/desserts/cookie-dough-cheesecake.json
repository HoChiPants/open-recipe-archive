  "instructions": [
    {
      "step": 1,
      "text": "Grease a deep 23cm springform tin with sunflower or vegetable oil. Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Beat the softened butter with the light brown soft sugar and golden caster sugar for 5 minutes. Whisk in the egg yolks, 2 tbsp vanilla paste, and milk. Whisk in the plain and self-raising flours, then stir in the dark chocolate chips. Reserve some dough for decoration if desired.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Press the cookie dough into the base of the prepared tin and bake until golden brown, about 7 minutes. Cool briefly.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Beat the soft cheese until smooth. Add the golden caster sugar, soured cream, 3 tbsp plain flour, 1 tsp vanilla paste, and the remaining light brown soft sugar; whisk for 5 minutes. Add the eggs and fold in the chopped dark and milk chocolate.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Pour the cheesecake mixture over the cookie-dough base. Bake until the center is fully set and reaches 160°F on a food thermometer, about 40 minutes. Cool completely, then chill until firm.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Melt the chopped milk and dark chocolate with the double cream and caster sugar, stirring until smooth. Chill until thick enough to spread.",
      "timer_minutes": 60
    },
    {
      "step": 7,
      "text": "Spread the chocolate topping over the chilled cheesecake. Finish with the chocolate mini eggs, chocolate nests, white chocolate buttons, and any reserved cookie dough."
    }
  ],
