  "instructions": [
    {
      "step": 1,
      "text": "Combine the beaten eggs, raisins, and vanilla extract. Let stand for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 3,
      "text": "Whisk the butter, packed brown sugar, and white sugar until smooth and combined."
    },
    {
      "step": 4,
      "text": "In a separate bowl, prepare the all-purpose flour, ground cinnamon, and baking soda, then stir the mixture into the butter mixture."
    },
    {
      "step": 5,
      "text": "Stir in the egg mixture, followed by the rolled oats and pecans, until evenly combined."
    },
    {
      "step": 6,
      "text": "Portion the dough onto baking sheets and bake for 10 minutes, until lightly browned.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Cool the cookies on the baking sheets briefly, then transfer them to a rack to finish cooling."
    }
  ],
