  "id": "raisin-oatmeal-pecan-cookies",
  "name": "Raisin Oatmeal Pecan Cookies",
  "subtitle": "Chewy oat cookies with raisins and pecans",
  "description": "A classic American drop cookie combining cinnamon-scented oats, sweet raisins, and chopped pecans.",
  "meal_type": "dessert",
