  "id": "overnight-coffee-cake",
  "name": "Overnight Coffee Cake",
  "subtitle": "A cinnamon-walnut cake prepared ahead for easy morning baking.",
  "description": "Mix a tender buttermilk batter, layer it with a cinnamon-walnut topping, refrigerate overnight, and bake until fully set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
