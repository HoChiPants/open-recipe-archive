  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, baking powder, baking soda, and 0.5 teaspoon cinnamon in a bowl."
    },
    {
      "step": 2,
      "text": "Beat the softened butter with the white sugar and 0.25 cup packed brown sugar until smooth, then whisk in the egg."
    },
    {
      "step": 3,
      "text": "Add the dry mixture to the butter mixture in portions, alternating with the buttermilk; stir just until combined."
    },
    {
      "step": 4,
      "text": "Combine the remaining packed brown sugar, walnuts, and 0.25 teaspoon cinnamon for the topping."
    },
    {
      "step": 5,
      "text": "Transfer the batter to a prepared baking pan and scatter the topping evenly over it."
    },
    {
      "step": 6,
      "text": "Cover and refrigerate for 480 minutes or overnight.",
      "timer_minutes": 480
    },
    {
      "step": 7,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 8,
      "text": "Bake for 45 minutes, until the center is firm and fully set; if checked with a thermometer, it should reach 160°F.",
      "timer_minutes": 45
    }
  ],
