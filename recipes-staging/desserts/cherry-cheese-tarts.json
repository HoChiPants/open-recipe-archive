  "id": "cherry-cheese-tarts",
  "name": "Cherry Cheese Tarts",
  "subtitle": "Individual cheesecake tarts with a cinnamon crumb base and cherry topping",
  "description": "Bake creamy cheese-filled tarts over a buttery graham crumb crust, then finish them with cherry pie filling and chill before serving.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 26,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "graham-cracker-crumbs",
      "item": "graham cracker crumbs",
      "quantity": 1.125,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "cherry-pie-filling",
      "item": "cherry pie filling",
      "quantity": 1,
      "unit": "can",
      "preparation": "21 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare 26 tart wells or small baking cups."
    },
    {
      "step": 2,
      "text": "Mix the graham cracker crumbs, 2 tablespoons white sugar, and cinnamon. Cut in the butter until crumbly, then press the mixture into the prepared wells."
    },
    {
      "step": 3,
      "text": "Beat the cream cheese with 0.5 cup white sugar until smooth. Stir in the eggs, vanilla extract, and lemon juice until blended."
    },
    {
      "step": 4,
      "text": "Layer the cream cheese mixture and cherry pie filling in the prepared crusts, finishing with cherry pie filling."
    },
    {
      "step": 5,
      "text": "Bake until the centers are firm and reach 160°F, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Cool, then chill the tarts for at least 30 minutes before serving.",
      "timer_minutes": 30
    }
  ],
