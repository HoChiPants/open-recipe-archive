  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the flour, baking powder, and salt."
    },
    {
      "step": 3,
      "text": "Whisk the brown sugar, eggs, and vanilla extract until smooth."
    },
    {
      "step": 4,
      "text": "Add the dry ingredients and combine into a uniform batter."
    },
    {
      "step": 5,
      "text": "Fold in the chocolate chips, chopped walnuts, and shredded coconut."
    },
    {
      "step": 6,
      "text": "Transfer the batter to a prepared baking pan and spread evenly."
    },
    {
      "step": 7,
      "text": "Bake at 350°F for 25 minutes, until golden brown and the center is fully set.",
      "timer_minutes": 25
    },
    {
      "step": 8,
      "text": "Cool before cutting into bars."
    }
  ],
