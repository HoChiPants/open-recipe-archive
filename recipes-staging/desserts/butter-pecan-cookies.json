{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "butter-pecan-cookies",
  "name": "Butter Pecan Cookies",
  "subtitle": "Tender cookies with toasted pecan flavor",
  "description": "A simple American cookie made with brown sugar, butter, and pecans, chilled before baking for easy shaping and crisp edges.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 0.66666698455811,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups",
      "preparation": "plus more for dusting"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "pecan-halves",
      "item": "pecan halves",
      "quantity": 1.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Beat the softened butter, packed brown sugar, and egg until smooth and well combined."
    },
    {
      "step": 2,
      "text": "Add the flour and salt, then mix just until a dough forms. Stir in the pecan halves."
    },
    {
      "step": 3,
      "text": "Cover and chill the dough for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Heat the oven to 375°F. Lightly dust a work surface with flour, then shape the chilled dough into cookies."
    },
    {
      "step": 5,
      "text": "Bake until golden brown and the centers are set, about 12 minutes. Cool before serving.",
      "timer_minutes": 12
    }
  ],
