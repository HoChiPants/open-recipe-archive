  "id": "peach-cobbler-cff67a16",
  "name": "Peach Cobbler",
  "subtitle": "A warm fruit dessert with a tender, golden topping",
  "description": "Peaches are layered with a simple milk batter, melted butter, and a lightly spiced sugar syrup, then baked until browned and set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-peaches",
      "item": "fresh peaches",
      "quantity": 5,
      "unit": "cups",
      "preparation": "peeled, pitted, and sliced"
    },
    {
      "ingredient_id": "chinese-five-spice-powder",
      "item": "Chinese five-spice powder",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "grated-lemon-zest",
      "item": "grated lemon zest",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the peaches, five-spice powder, and lemon zest."
    },
    {
      "step": 3,
      "text": "Bring 1 cup of sugar and the water to a simmer; cook for 3 minutes, stirring, then continue stirring for 2 minutes until the syrup begins to set. Set aside.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Combine the remaining sugar and the self-rising flour. Add the milk and whisk until smooth."
    },
    {
      "step": 5,
      "text": "Pour the melted butter into a baking dish, then add the batter without stirring."
    },
    {
      "step": 6,
      "text": "Arrange the peaches over the batter and pour the prepared syrup over the top."
    },
    {
      "step": 7,
      "text": "Bake until golden brown and set in the center, about 50 minutes.",
      "timer_minutes": 50
    }
  ],
