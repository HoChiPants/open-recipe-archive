{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "creamy-chocolate-mousse-pie",
  "name": "Creamy Chocolate Mousse Pie",
  "subtitle": "A chilled chocolate filling in a crisp baked crust",
  "description": "A smooth chocolate-marshmallow mousse is folded with whipped cream, spooned into a baked pie shell, and chilled until set.",
  "meal_type": "dessert",
  "cuisine": "French",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10,
    "inactive_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "miniature-marshmallows",
      "item": "miniature marshmallows",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "7-ounce-bar-milk-chocolate-candy",
      "item": "(7 ounce) bar milk chocolate candy",
      "quantity": 1
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "9-inch-pie-shell",
      "item": "(9 inch) pie shell",
      "quantity": 1,
      "preparation": "baked"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the marshmallows, milk, and chocolate together gently, stirring until smooth and fully melted.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Let the chocolate mixture cool until no longer warm."
    },
    {
      "step": 3,
      "text": "Whisk the heavy cream to stiff peaks."
    },
    {
      "step": 4,
      "text": "Fold the whipped cream into the cooled chocolate mixture until evenly combined."
    },
    {
      "step": 5,
      "text": "Transfer the filling to the baked pie shell and smooth the top."
    },
    {
      "step": 6,
      "text": "Chill until firm and set.",
      "timer_minutes": 180
    }
  ],
