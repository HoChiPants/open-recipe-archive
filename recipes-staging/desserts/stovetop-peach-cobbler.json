  "id": "stovetop-peach-cobbler",
  "name": "Stovetop Peach Cobbler",
  "subtitle": "A warm peach dessert with a cinnamon cake topping",
  "description": "Canned peaches, cinnamon, and yellow cake mix come together in a covered skillet for an easy cobbler-style dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15,
    "inactive_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "peaches",
      "item": "peaches",
      "quantity": 1,
      "unit": "can",
      "preparation": "29 ounce, sliced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "yellow-cake-mix",
      "item": "yellow cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "9 ounce"
    },
    {
      "ingredient_id": "margarine",
      "item": "margarine",
      "quantity": 4,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the sliced peaches in a large covered skillet. Sprinkle with the sugar and cinnamon."
    },
    {
      "step": 2,
      "text": "Spread the dry cake mix evenly over the peaches, then dot the surface with the margarine."
    },
    {
      "step": 3,
      "text": "Cover the skillet and cook over medium heat until the topping is set and the peaches are hot.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Remove from the heat and let the cobbler stand, covered, before serving.",
      "timer_minutes": 15
    }
  ],
