  "id": "lemon-shortbread-cookies",
  "name": "Lemon Shortbread Cookies",
  "subtitle": "Buttery cookies with a bright lemon glaze",
  "description": "Tender lemon shortbread cookies finished with a simple lemon icing.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 45,
    "cook_minutes": 10,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "unsalted-butter-at-room-temperature",
      "item": "unsalted butter at room temperature",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 6,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.33333334326744,
      "unit": "cup",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemons",
      "preparation": "zested"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Whisk the flour, salt, and baking powder together."
    },
    {
      "step": 3,
      "text": "Beat the room-temperature butter and 1 cup confectioners' sugar until smooth. Mix in 2 tablespoons fresh lemon juice, then add the dry ingredients and combine into a dough."
    },
    {
      "step": 4,
      "text": "Shape the dough, cut it into 24 cookies, and arrange the pieces on a baking sheet."
    },
    {
      "step": 5,
      "text": "Bake until the cookies are set and lightly colored, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Cool the cookies on the baking sheet for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Whisk the melted butter and lemon juice together. Gradually whisk in 3 cups confectioners' sugar, adding more lemon juice to adjust the consistency, then stir in the lemon zest."
    },
    {
      "step": 8,
      "text": "Spread or drizzle the glaze over the cooled cookies and let it set for 120 minutes.",
      "timer_minutes": 120
    }
  ],
