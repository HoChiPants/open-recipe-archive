  "id": "chocolate-vinegar-cake",
  "name": "Chocolate Vinegar Cake",
  "subtitle": "A simple egg-free chocolate cake with pantry staples",
  "description": "A tender cocoa cake made without eggs or dairy, suitable for an easy dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 18,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "unsweetened-cocoa-powder",
      "item": "unsweetened cocoa powder",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "distilled-white-vinegar",
      "item": "distilled white vinegar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the flour, sugar, cocoa powder, baking soda, and salt in a baking pan or mixing bowl."
    },
    {
      "step": 3,
      "text": "Make wells in the dry mixture and pour the oil, vinegar, and vanilla into them."
    },
    {
      "step": 4,
      "text": "Add the cold water and stir just until the batter is evenly combined."
    },
    {
      "step": 5,
      "text": "Bake at 350°F until the cake is set and a tester inserted in the center comes out clean, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 6,
      "text": "Cool before serving."
    }
  ],
