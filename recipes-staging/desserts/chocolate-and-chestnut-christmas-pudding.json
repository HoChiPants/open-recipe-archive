  "instructions": [
    {
      "step": 1,
      "text": "Combine the sultanas, raisins, mixed peel, brandy or dark rum, and mixed spice. Set aside while preparing the batter."
    },
    {
      "step": 2,
      "text": "Grease a 1.5-litre heatproof pudding basin with some of the butter. Beat the remaining butter with the sugar until creamy, then whisk in the eggs one at a time."
    },
    {
      "step": 3,
      "text": "Fold in the flour, cocoa powder, breadcrumbs, soaked fruit mixture, clementine zest and juice, stem ginger with its syrup, dark chocolate, and chestnuts until evenly combined."
    },
    {
      "step": 4,
      "text": "Spoon the mixture into the basin and level the surface. Cover securely with a pleated layer of baking parchment and foil, tying or securing it so steam cannot enter."
    },
    {
      "step": 5,
      "text": "Place the basin in a steamer or deep saucepan with simmering water reaching partway up the basin. Cover and steam steadily until the pudding is firm and the center reaches 160°F.",
      "timer_minutes": 180
    },
    {
      "step": 6,
      "text": "Remove the covering carefully and let the pudding cool briefly. Turn it out onto a serving plate."
    },
    {
      "step": 7,
      "text": "Reheat individual portions in a microwave for about 30 seconds, if desired. Serve with clotted cream or ice cream and extra brandy or dark rum."
    }
  ],
