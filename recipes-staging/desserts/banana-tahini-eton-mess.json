  "id": "banana-tahini-eton-mess",
  "name": "Banana-Tahini Eton Mess",
  "subtitle": "Creamy banana dessert with sesame crunch",
  "description": "A quick layered-style dessert combining tahini cream, sliced banana, crisp meringue, and toasted sesame.",
  "meal_type": "dessert",
