  "id": "whole-wheat-oatmeal-cookies",
  "name": "Whole Wheat Oatmeal Cookies",
  "subtitle": "Crisp-edged cookies with rolled oats",
  "description": "Make a simple whole wheat oatmeal cookie dough with brown sugar, butter, and vanilla, then bake until lightly browned and fully set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 60,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "whole-wheat-flour",
      "item": "whole wheat flour",
      "quantity": 1,
      "unit": "cup",
      "preparation": "sifted"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 3,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir together the sifted whole wheat flour, baking soda, and salt."
    },
    {
      "step": 3,
      "text": "Whisk the brown sugar and softened butter until smooth, then mix in the egg until fully combined."
    },
    {
      "step": 4,
      "text": "Stir in the water and vanilla extract until combined."
    },
    {
      "step": 5,
      "text": "Add the flour mixture and rolled oats; mix until a cohesive dough forms."
    },
    {
      "step": 6,
      "text": "Portion the dough onto baking sheets and bake for 15 minutes, until lightly browned and the centers are fully set; if checking with a thermometer, the egg-containing cookies should reach 160°F.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Transfer the cookies from the baking sheets and let them cool before serving."
    }
  ],
