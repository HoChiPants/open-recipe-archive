  "id": "apple-pastry-bars",
  "name": "Apple Pastry Bars",
  "subtitle": "Layered pastry with warmly spiced apples",
  "description": "A tender pastry crust surrounds a cinnamon-nutmeg apple filling for sliceable dessert bars.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
