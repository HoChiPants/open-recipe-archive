  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Combine the flour and salt. Cut in the shortening until the mixture forms coarse crumbs."
    },
    {
      "step": 3,
      "text": "Whisk the egg yolk with the milk, then stir it into the flour mixture to form a dough."
    },
    {
      "step": 4,
      "text": "Divide the dough and shape one portion into the bottom crust of a baking pan."
    },
    {
      "step": 5,
      "text": "Combine the apples with the light brown sugar, white sugar, cinnamon, and nutmeg."
    },
    {
      "step": 6,
      "text": "Spread the apple mixture over the bottom crust and cover with the remaining dough, sealing the edges."
    },
    {
      "step": 7,
      "text": "Bake for about 50 minutes, until golden brown and the pastry is fully set; an egg-containing center should reach 160°F when checked with a food thermometer.",
      "timer_minutes": 50
    }
  ],
