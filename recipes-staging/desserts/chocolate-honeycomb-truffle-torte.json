{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-honeycomb-truffle-torte",
  "name": "Chocolate Honeycomb Truffle Torte",
  "subtitle": "A crisp cornflake base with a smooth chocolate cream topping",
  "description": "A no-bake chocolate torte combining crunchy honeycomb and cornflakes with a rich, set chocolate truffle layer.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 35,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "x-40g-chocolate-covered-honeycomb-bar",
      "item": "x 40g chocolate-covered honeycomb bar",
      "quantity": 3
    },
    {
      "ingredient_id": "cornflakes",
      "item": "cornflakes",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-chocolate-at-least-70-cocoa-solids",
      "item": "dark chocolate (at least 70% cocoa solids)",
      "quantity": 500,
      "unit": "g",
      "preparation": "broken into small pieces"
    },
    {
      "ingredient_id": "golden-syrup",
      "item": "golden syrup",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 400,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Line a torte tin or similar shallow cake tin. Crush the honeycomb bars into small pieces."
    },
    {
      "step": 2,
      "text": "Melt part of the broken chocolate until smooth, then stir in the honeycomb pieces and cornflakes."
    },
    {
      "step": 3,
      "text": "Press the mixture firmly into the tin and leave it to set while preparing the topping."
    },
    {
      "step": 4,
      "text": "Melt the remaining chocolate with the golden syrup and double cream, stirring until smooth."
    },
    {
      "step": 5,
      "text": "Whisk the chocolate mixture until thickened, then spread it evenly over the set base."
    },
    {
      "step": 6,
      "text": "Chill until firm, about 4 hours, then cut into 12 portions.",
      "timer_minutes": 240
    }
  ],
  "tags": [
    "dessert",
    "chocolate",
    "no-bake",
    "torte",
