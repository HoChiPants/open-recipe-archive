  "id": "air-fryer-lemon-drizzle-cake",
  "name": "Air Fryer Lemon Drizzle Cake",
  "subtitle": "A soft lemon cake with a smooth citrus finish",
  "description": "A simple air-fried lemon cake topped with a sweet lemon drizzle.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 70
  },
  "ingredients": [
    {
      "ingredient_id": "butter-at-room-temperature",
      "item": "butter at room temperature",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "lemons-zested-and-juiced",
      "item": "lemons zested and juiced",
      "quantity": 3
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 100,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Zest and juice the lemons. Set the zest and juice aside separately."
    },
    {
      "step": 2,
      "text": "Whisk the butter, caster sugar, eggs, self-raising flour, and icing sugar until smooth and well combined.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Preheat the air fryer according to its cake-baking instructions. Prepare a suitable cake tin and add the batter."
    },
    {
      "step": 4,
      "text": "Cook until the cake is risen and set in the center.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Cool the cake in the tin for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Combine the caster sugar and icing sugar with the reserved lemon juice until smooth."
    },
    {
      "step": 7,
      "text": "Add the lemon zest, spoon the drizzle over the warm cake, and leave it to set before serving."
    }
  ],
