{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "candy-apples",
  "name": "Candy Apples",
  "subtitle": "Glossy fruit treats with a crisp sugar shell",
  "description": "Coat whole apples in a hot lemon-sugar syrup, then let the shells set firm around the fruit.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "red-apples",
      "item": "red apples",
      "quantity": 8
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "golden-syrup",
      "item": "golden syrup",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "a-few-drops-red-food-colouring-optional",
      "item": "a few drops red food colouring (optional)",
      "optional": true
    },
    {
      "ingredient_id": "chopsticks-or-lolly-sticks",
      "item": "chopsticks or lolly sticks",
      "quantity": 8,
      "unit": "sticks"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a saucepan of water to the boil. Add the apples for 4 minutes, then remove, dry thoroughly, and insert a chopstick or lolly stick into each one.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Line a tray for setting. Combine the caster sugar and lemon juice in a clean saucepan, then add the golden syrup."
    },
    {
      "step": 3,
      "text": "Heat the mixture, stirring until the sugar dissolves, then simmer without stirring until it forms a thick coating syrup. Take care: the syrup is extremely hot."
    },
    {
      "step": 4,
      "text": "Stir in the optional red food colouring, if using."
    },
    {
      "step": 5,
      "text": "Dip each apple into the hot syrup, turning to coat it completely. Place the apples on the prepared tray and leave them undisturbed until the coating is firm."
    }
  ],
