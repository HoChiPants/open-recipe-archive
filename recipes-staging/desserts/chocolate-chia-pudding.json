  "id": "chocolate-chia-pudding",
  "name": "Chocolate Chia Pudding",
  "subtitle": "A rich, creamy pudding made with chia seeds and cacao.",
  "description": "Combine the ingredients, chill until thick, and finish with cacao nibs and berries for serving.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "chia-seeds",
      "item": "chia seeds",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "unsweetened-almond-milk-or-hazelnut-milk",
      "item": "unsweetened almond milk or hazelnut milk",
      "quantity": 400,
      "unit": "ml"
    },
    {
      "ingredient_id": "cacao-powder",
      "item": "cacao powder",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "cacao-nibs-mixed",
      "item": "cacao nibs mixed"
    },
    {
      "ingredient_id": "frozen-berries-to-serve",
      "item": "frozen berries to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the chia seeds, almond or hazelnut milk, cacao powder, maple syrup, and vanilla extract in a bowl until evenly combined."
    },
    {
      "step": 2,
      "text": "Cover and refrigerate for 4 hours, or until the mixture is thick and spoonable."
    },
    {
      "step": 3,
      "text": "Divide among four servings and top with the cacao nibs mixed and frozen berries to serve."
    }
  ],
