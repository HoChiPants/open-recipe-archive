  "id": "mango-cake",
  "name": "Mango Cake",
  "subtitle": "A bright, lime-scented cake with a simple mango glaze.",
  "description": "Mango, lime, and rum add tropical flavor to a tender yellow cake finished with confectioners’ sugar glaze.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "ripe-mango",
      "item": "ripe mango",
      "quantity": 1
    },
    {
      "ingredient_id": "yellow-cake-mix",
      "item": "yellow cake mix",
      "quantity": 1,
      "unit": "box",
      "preparation": "18.25 ounce"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "lime-zest",
      "item": "lime zest",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "melted"
    },
    {
