      "item": "lime",
      "quantity": 0.5,
      "preparation": "juiced"
    },
    {
      "ingredient_id": "golden-rum",
      "item": "golden rum",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking pan as needed for the cake mix."
    },
    {
      "step": 2,
      "text": "Peel and cut the mango. Blend or mash it with the vegetable oil until smooth; reserve some mango for the glaze if desired."
    },
    {
      "step": 3,
      "text": "Combine the cake mix, eggs, water, mango mixture, lime zest, lime juice, and rum. Stir for 2 minutes, until evenly combined.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Transfer the batter to the prepared pan and bake until set and a tester comes out clean, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Cool the cake in the pan for 5 minutes, then transfer it to a rack and cool completely.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "For the glaze, combine the remaining mango, lime zest, melted butter, and lime juice. Stir in the confectioners' sugar until smooth, then fold in the mango mixture."
    },
    {
      "step": 7,
      "text": "Spread the glaze over the cooled cake, cut into servings, and serve."
    }
  ],
