  "instructions": [
    {
      "step": 1,
      "text": "Whip the heavy cream until it begins to thicken. Add the confectioners' sugar and vanilla extract, then continue whipping to stiff peaks."
    },
    {
      "step": 2,
      "text": "Arrange a layer of chocolate wafer cookies in a serving dish. Spread with whipped cream and repeat the layers until the ingredients are used, finishing with whipped cream."
    },
    {
      "step": 3,
      "text": "Cover and chill for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 4,
      "text": "Top with grated chocolate, cut into portions, and serve cold."
    }
  ],
