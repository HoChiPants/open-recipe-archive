  "id": "zebra-cake",
  "name": "Zebra Cake",
  "subtitle": "A chilled, striped wafer-and-cream dessert",
  "description": "Layer chocolate wafer cookies with vanilla-sweetened whipped cream, then chill until the cookies soften and the cake slices cleanly.",
  "meal_type": "dessert",
  "cuisine": "American",
