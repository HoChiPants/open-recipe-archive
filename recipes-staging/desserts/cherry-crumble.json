      "item": "ice cream to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking dish."
    },
    {
      "step": 2,
      "text": "Combine the cherries, golden caster sugar, lemon juice, and vanilla extract in the dish."
    },
    {
      "step": 3,
      "text": "Rub the cold butter into the plain flour until the mixture is crumbly. Stir in the salt, soft brown sugar, rolled oats, and flaked almonds."
    },
    {
      "step": 4,
      "text": "Scatter the crumble mixture evenly over the cherries."
    },
    {
      "step": 5,
      "text": "Bake for 35 minutes, or until the topping is golden brown and the fruit is bubbling.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Serve warm with ice cream."
    }
  ],
