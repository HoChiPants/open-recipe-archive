  "id": "cherry-crumble",
  "name": "Cherry Crumble",
  "subtitle": "Juicy baked cherries beneath an oat-almond topping",
  "description": "A simple fruit crumble made with lemon-vanilla cherries and a crisp, buttery oat topping. Serve warm with ice cream.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
