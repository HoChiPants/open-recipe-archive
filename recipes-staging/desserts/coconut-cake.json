  "id": "coconut-cake",
  "name": "Coconut Cake",
  "subtitle": "Tender coconut cake with cream cheese frosting",
  "description": "A moist coconut cake with chopped walnuts, toasted coconut, and a simple cream cheese frosting.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
