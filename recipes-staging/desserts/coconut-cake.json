  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Grease a baking pan."
    },
    {
      "step": 2,
      "text": "Combine the cake mix, pudding mix, water, eggs, and vegetable oil. Whisk for 4 minutes, then stir in half of the coconut and the walnuts.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Transfer the batter to the prepared pan and bake until set, about 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 4,
      "text": "Cool the cake in the pan for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Melt half of the butter in a skillet. Add the remaining coconut and cook, stirring, until golden brown. Transfer to a plate to cool."
    },
    {
      "step": 6,
      "text": "Whisk the remaining butter with the cream cheese until smooth. Add the milk, confectioners' sugar, and vanilla extract, and mix until spreadable."
    },
    {
      "step": 7,
      "text": "Spread the frosting over the cooled cake and top with the toasted coconut."
    }
  ],
