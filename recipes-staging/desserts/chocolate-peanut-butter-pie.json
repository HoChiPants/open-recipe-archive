  },
  "ingredients": [
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "8-inch-prepared-graham-cracker-crusts",
      "item": "(8 inch) prepared graham cracker crusts",
      "quantity": 2
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "instant-chocolate-pudding-mix",
      "item": "instant chocolate pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.9 ounce"
    },
    {
      "ingredient_id": "8-ounce-container-frozen-whipped-topping",
      "item": "(8 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Beat the peanut butter and butter together until smooth. Gradually stir in the confectioners' sugar until evenly combined."
    },
    {
      "step": 2,
      "text": "Divide the peanut butter mixture between the prepared graham cracker crusts and spread it evenly."
    },
    {
      "step": 3,
      "text": "Whisk the milk and instant chocolate pudding mix until thickened, then divide the pudding between the crusts and smooth the tops."
    },
    {
      "step": 4,
      "text": "Chill the pies until firm, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Spread the thawed whipped topping over the chilled pies before serving."
    }
  ],
