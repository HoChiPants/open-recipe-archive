  "id": "chocolate-peanut-butter-pie",
  "name": "Chocolate Peanut Butter Pie",
  "subtitle": "A chilled pie with creamy chocolate and peanut butter layers",
  "description": "Two graham crusts are filled with peanut butter and chocolate pudding mixtures, chilled until firm, and finished with whipped topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
