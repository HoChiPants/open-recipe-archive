  "id": "cinnamon-roll-apple-crisp",
  "name": "Cinnamon Roll Apple Crisp",
  "subtitle": "Warm apples with a cinnamon-roll topping",
  "description": "Sliced tart apples bake beneath cinnamon-spiced oats and pieces of cinnamon roll dough, finished with the included icing.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
