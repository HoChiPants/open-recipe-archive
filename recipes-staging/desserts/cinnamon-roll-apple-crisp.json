      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Separate the cinnamon roll dough and cut or shape it into smaller pieces. Set the icing aside. Lightly coat the pieces with the tablespoon of ground cinnamon."
    },
    {
      "step": 3,
      "text": "Combine the rolled oats, brown sugar, flour, tablespoon of ground cinnamon, salt, and white sugar. Work in the softened margarine until coarse crumbs form."
    },
    {
      "step": 4,
      "text": "Toss the sliced apples with the white sugar and teaspoon of ground cinnamon, then arrange them in a baking dish."
    },
    {
      "step": 5,
      "text": "Scatter the oat mixture over the apples and arrange the cinnamon-roll pieces on top."
    },
    {
      "step": 6,
      "text": "Bake until the apples are tender and the topping is browned, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 7,
      "text": "Let the crisp rest briefly, then drizzle with the reserved icing before serving."
    }
  ],
