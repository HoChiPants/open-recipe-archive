  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Beat the shortening and white sugar until blended. Add the egg and vanilla extract, then mix until smooth."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the all-purpose flour, baking soda, baking powder, salt, ground cloves, ground cinnamon, and ground nutmeg."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the shortening mixture, alternating with the persimmon pulp, and stir just until combined. Fold in the raisins and chopped walnuts."
    },
    {
      "step": 5,
      "text": "Portion the dough onto baking sheets, leaving space between portions."
    },
    {
      "step": 6,
      "text": "Bake for 15 minutes, until the edges are set and the centers are fully set; if checked with a thermometer, the cookies should reach 160°F.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Transfer the cookies to a rack to cool."
    }
  ],
