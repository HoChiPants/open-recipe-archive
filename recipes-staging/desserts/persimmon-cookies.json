  "id": "persimmon-cookies",
  "name": "Persimmon Cookies",
  "subtitle": "Soft-spiced cookies with raisins and walnuts",
  "description": "Tender persimmon cookies flavored with warm spices and filled with raisins and chopped walnuts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
