{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "spiced-star-cookies",
  "name": "Spiced Star Cookies",
  "subtitle": "Cocoa cookies with cinnamon, ginger, and colored icing",
  "description": "Cut crisp spiced cocoa cookies into stars, then decorate them with set icing and optional sprinkles.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 35,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-softened",
      "item": "unsalted butter softened",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder-sifted",
      "item": "cocoa powder sifted",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "icing-sugar-sifted",
      "item": "icing sugar sifted",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "gel-food-colourings-we-used-blue",
      "item": "gel food colourings (we used blue",
      "preparation": "yellow and red)"
    },
    {
      "ingredient_id": "star-sprinkles-optional",
      "item": "star sprinkles (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Beat the softened butter and caster sugar for 5 minutes until light and combined. Whisk in the egg.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mix the plain flour, cocoa powder, cinnamon, and ginger, then work the dry mixture into the butter mixture to form a dough."
    },
    {
      "step": 3,
      "text": "Preheat the oven. Shape the dough, roll it out, and cut out star cookies."
    },
    {
      "step": 4,
      "text": "Transfer the cookies to a baking tray and bake for 10 minutes. Confirm the egg-containing centers reach 160°F and are set.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer the cookies to a rack and cool completely.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Whisk the egg white for 1 minute. Add the icing sugar and lemon juice, then whisk for 5 minutes until stiff peaks form.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Divide and tint the icing with the gel food colourings. Decorate the cooled cookies with icing and optional star sprinkles, then let the icing set firm before serving."
    }
  ],
