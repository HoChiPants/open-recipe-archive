  "id": "battenberg-blondies",
  "name": "Battenberg Blondies",
  "subtitle": "Marzipan and white chocolate blondies with a pink swirl",
  "description": "Soft blondies combining brown sugar, white chocolate, and marzipan, with part of the batter tinted pink for a Battenberg-inspired finish.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-cut-into-cubes",
      "item": "unsalted butter cut into cubes",
      "quantity": 200,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "light-brown-muscovado-sugar",
      "item": "light brown muscovado sugar",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "white-chocolate-roughly-chopped",
      "item": "white chocolate roughly chopped",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "eggs-beaten",
      "item": "eggs beaten",
      "quantity": 3
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "milk-powder-optional-see-tip",
      "item": "milk powder (optional; see tip",
      "quantity": 2,
      "unit": "tbsp",
      "preparation": "below)",
      "optional": true
    },
    {
      "ingredient_id": "golden-marzipan-cut-into-1-2cm-cubes",
      "item": "golden marzipan cut into 1⁄2cm cubes",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "a-few-drops-of-pink-food-colouring-gel",
      "item": "a few drops of pink food colouring gel"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and butter the baking tin. Line it with baking paper."
    },
    {
      "step": 2,
      "text": "Melt the cubed butter, muscovado sugar, and chopped white chocolate together gently, stirring until smooth. Let the mixture cool slightly."
    },
    {
      "step": 3,
      "text": "Whisk the vanilla extract into the beaten eggs for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Mix the flour, baking powder, and optional milk powder in a separate bowl."
    },
    {
      "step": 5,
      "text": "Stir the dry ingredients into the melted chocolate mixture, then fold in the marzipan cubes."
    },
    {
      "step": 6,
      "text": "Transfer half the batter to the prepared tin. Stir the pink colouring into the remaining batter, then add it to the tin and gently swirl or arrange the two batters together."
    },
    {
      "step": 7,
      "text": "Bake for 40 minutes, until the center is set. Cool completely before cutting into squares.",
      "timer_minutes": 40
    }
  ],
