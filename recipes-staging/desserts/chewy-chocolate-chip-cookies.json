{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chewy-chocolate-chip-cookies",
  "name": "Chewy Chocolate Chip Cookies",
  "subtitle": "Soft-centered cookies with crisp edges and plenty of chocolate.",
  "description": "A simple batch of buttery chocolate chip cookies, mixed, portioned, and baked until set.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "soft-brown-sugar-golden-caster-sugar",
      "item": "soft brown sugar golden caster sugar",
      "quantity": 150,
      "unit": "g",
      "preparation": "or ideally half of each"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "plain-flour-see-tip-below",
      "item": "plain flour (see tip below)",
      "quantity": "180-200",
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "chocolate-chips-or-chopped-chocolate",
      "item": "chocolate chips or chopped chocolate",
      "quantity": 200,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F and line a baking sheet with parchment."
    },
    {
      "step": 2,
      "text": "Beat the softened butter, sugar mixture, and vanilla until smooth, then mix in the egg."
    },
    {
      "step": 3,
      "text": "Fold in the flour and baking powder, followed by the chocolate chips or chopped chocolate, until a dough forms."
    },
    {
      "step": 4,
      "text": "Divide the dough into 12 portions and arrange them on the prepared sheet with space between each."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, until the edges are set, the centers reach 160°F on a food thermometer, and the cookies are lightly colored.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Transfer the cookies to a rack and cool until firm enough to handle."
    }
  ],
