  "id": "creamy-coconut-cake",
  "name": "Creamy Coconut Cake",
  "subtitle": "A chilled white cake layered with coconut cream and whipped topping.",
  "description": "Bake a white cake, soak it with a coconut-milk mixture, and finish it with whipped topping and flaked coconut.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
