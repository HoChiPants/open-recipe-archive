    "prep_minutes": 20,
    "cook_minutes": 35,
    "inactive_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "white-cake-mix",
      "item": "white cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "cream-of-coconut",
      "item": "cream of coconut",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "16-ounce-container-frozen-whipped-topping",
      "item": "(16 ounce) container frozen whipped topping",
      "quantity": 1,
      "preparation": "thawed"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare and bake the white cake mix according to the package directions. Cool the cake completely in its pan.",
      "timer_minutes": 35
    },
    {
      "step": 2,
      "text": "Stir together the cream of coconut, sweetened condensed milk, and flaked coconut."
    },
    {
      "step": 3,
      "text": "Pour the coconut mixture over the cooled cake, spreading it evenly so it can soak in."
    },
    {
      "step": 4,
      "text": "Spread the thawed whipped topping over the cake and chill before serving.",
      "timer_minutes": 90
    },
    {
      "step": 5,
      "text": "Cut into portions and serve cold."
    }
  ],
