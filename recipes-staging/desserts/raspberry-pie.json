  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Fit one pastry round into a pie dish and reserve the second for the top crust."
    },
    {
      "step": 2,
      "text": "Toss the raspberries with sugar, tapioca, lemon juice, cinnamon, and salt. Spoon the mixture into the pastry shell and dot with the butter."
    },
    {
      "step": 3,
      "text": "Cover with the remaining pastry, seal and crimp the edge, and cut a few vents in the top. Brush the surface with half-and-half cream."
    },
    {
      "step": 4,
      "text": "Bake at 425°F for 15 minutes, then reduce the oven to 375°F and continue baking for 35 minutes.",
      "timer_minutes": 35
    },
    {
      "step": 5,
      "text": "Cool the pie before slicing and serving."
    }
  ],
