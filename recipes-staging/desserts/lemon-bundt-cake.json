  "id": "lemon-bundt-cake",
  "name": "Lemon Bundt Cake",
  "subtitle": "A bright, tender cake with easy lemon flavor",
  "description": "A simple lemon Bundt cake made with pudding mix and citrus soda for a moist crumb.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "lemon-cake-mix",
      "item": "lemon cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "15.25 ounce"
    },
    {
      "ingredient_id": "instant-lemon-pudding-mix",
      "item": "instant lemon pudding mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "3.4 ounce"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 4
    },
    {
      "ingredient_id": "lemon-lime-flavored-carbonated-beverage",
      "item": "lemon-lime flavored carbonated beverage",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F. Prepare a Bundt pan for baking."
    },
    {
      "step": 2,
      "text": "Combine the lemon cake mix and instant lemon pudding mix in a large bowl."
    },
    {
      "step": 3,
      "text": "Whisk the eggs with the vegetable oil and lemon-lime flavored carbonated beverage until blended."
    },
    {
      "step": 4,
      "text": "Stir the wet mixture into the dry ingredients until the batter is smooth."
    },
    {
      "step": 5,
      "text": "Transfer the batter to the prepared pan and bake for 50 minutes, or until set.",
      "timer_minutes": 50
    },
    {
      "step": 6,
      "text": "Cool the cake in the pan, then transfer it to a rack and cool completely before serving."
    }
  ],
