  "id": "chocolate-peanut-butter-cookies",
  "name": "Chocolate Peanut Butter Cookies",
  "subtitle": "Rich cocoa cookies with a peanut butter swirl",
  "description": "Tender eggless cookies combining cocoa, peanut butter, and brown sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
