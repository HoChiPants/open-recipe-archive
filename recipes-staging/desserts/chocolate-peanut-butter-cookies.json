  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F and line baking sheets with parchment."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking soda, baking powder, salt, and cocoa powder in a bowl."
    },
    {
      "step": 3,
      "text": "In a separate bowl, whisk the softened butter, sugar, brown sugar, and peanut butter until smooth. Mix in the vanilla extract, then stir in the milk."
    },
    {
      "step": 4,
      "text": "Add the dry mixture to the butter mixture and stir just until combined."
    },
    {
      "step": 5,
      "text": "Portion the dough onto the prepared baking sheets, leaving space between cookies."
    },
    {
      "step": 6,
      "text": "Bake for 11 minutes, until lightly browned. Cool on the baking sheets before serving.",
      "timer_minutes": 11
    }
  ],
