  "instructions": [
    {
      "step": 1,
      "text": "Grease a 1.2-liter pudding basin. Sift the cocoa, flour, bicarbonate of soda, and baking powder together."
    },
    {
      "step": 2,
      "text": "Beat the butter, brown sugar, and orange zest until light. Gradually beat in the eggs, then mix in the dry ingredients until just combined."
    },
    {
      "step": 3,
      "text": "Stir in the 115 g marmalade and fold through the chopped chocolate. Spoon the batter into the basin and smooth the surface."
    },
    {
      "step": 4,
      "text": "Cover the basin with a pleated sheet of parchment and foil, securing it tightly. Place it in a large saucepan and add boiling water halfway up the sides of the basin."
    },
    {
      "step": 5,
      "text": "Cover the pan and simmer gently for 120 minutes, topping up with boiling water as needed. The pudding is ready when firm and a skewer inserted in the center comes out clean.",
      "timer_minutes": 120
    },
    {
      "step": 6,
      "text": "Remove the basin and let the pudding stand for 10 minutes before turning it out.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Whisk the cream with the icing sugar to soft peaks, then fold in the 125 g marmalade. Serve the pudding with the marmalade cream and extra marmalade."
    }
  ],
