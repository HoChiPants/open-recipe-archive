{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "lemon-meringue-pie",
  "name": "Lemon Meringue Pie",
  "subtitle": "Bright citrus filling beneath a light baked meringue",
  "description": "A classic pie with a thick lemon custard, baked crust, and softly sweet meringue topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemons",
      "quantity": 2,
      "preparation": "juiced and zested"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 4,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "9-inch-pie-crust",
      "item": "(9 inch) pie crust",
      "quantity": 1,
      "preparation": "baked"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 4
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 6,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Whisk the 1 cup sugar, flour, cornstarch, and salt in a saucepan. Stir in the water."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer, stirring, until thickened."
    },
    {
      "step": 4,
      "text": "Stir in the butter, lemon juice, and lemon zest."
    },
    {
      "step": 5,
      "text": "Whisk the beaten egg yolks with a small amount of the hot mixture, then return them to the saucepan and cook until the filling is thick and smooth."
    },
    {
      "step": 6,
      "text": "Pour the lemon filling into the baked pie crust."
    },
    {
      "step": 7,
      "text": "Whisk the egg whites until foamy. Gradually add the 6 tablespoons sugar and continue whisking to stiff peaks."
    },
    {
      "step": 8,
      "text": "Spread the meringue over the hot filling, covering it to the crust edge."
    },
    {
      "step": 9,
      "text": "Bake until the meringue is golden brown and the center is fully set and reaches 160°F.",
      "timer_minutes": 25
    },
    {
      "step": 10,
      "text": "Cool the pie at room temperature.",
      "timer_minutes": 45
    },
    {
      "step": 11,
      "text": "Refrigerate until chilled and set.",
      "timer_minutes": 120
    },
    {
      "step": 12,
      "text": "Slice and serve."
    }
  ],
