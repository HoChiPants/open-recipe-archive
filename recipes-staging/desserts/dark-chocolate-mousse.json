  "id": "dark-chocolate-mousse",
  "name": "Dark Chocolate Mousse",
  "subtitle": "Silky chocolate mousse with a subtle smoky chile note",
  "description": "A chilled, airy mousse made with dark chocolate, whipped cream, and gently heated egg yolks.",
  "meal_type": "dessert",
  "cuisine": "American",
