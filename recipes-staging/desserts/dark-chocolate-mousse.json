  "instructions": [
    {
      "step": 1,
      "text": "Set a heatproof bowl over a saucepan of barely simmering water. Add the chopped chocolate, butter, 2 tablespoons water, chipotle pepper, and salt. Whisk until smooth, then remove from the heat and let cool slightly."
    },
    {
      "step": 2,
      "text": "In a separate heatproof bowl over the simmering water, whisk the egg yolks, remaining 2 tablespoons water, and sugar for 3 minutes, until thickened and the mixture reaches 160°F.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Whisk the warm egg mixture into the chocolate until smooth. Stir in the 1 tablespoon chilled cream and let the mixture cool until just warm."
    },
    {
      "step": 4,
      "text": "Whip the 1/2 cup chilled cream to soft peaks. Fold about one-third into the chocolate mixture, then gently fold in the rest until evenly combined."
    },
    {
      "step": 5,
      "text": "Divide the mousse among four serving dishes. Chill until set, about 4 hours.",
      "timer_minutes": 240
    }
  ],
