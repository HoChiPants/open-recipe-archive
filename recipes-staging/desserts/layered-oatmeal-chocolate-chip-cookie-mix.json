  "instructions": [
    {
      "step": 1,
      "text": "Layer the oats, brown sugar, white sugar, pecans, and chocolate chips in a clean jar."
    },
    {
      "step": 2,
      "text": "Combine the flour, baking powder, baking soda, and salt; add this mixture as the final layer. Seal the jar."
    },
    {
      "step": 3,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 4,
      "text": "Prepare the wet mixture and combine it with the jar contents, using the melted component specified for the mix."
    },
    {
      "step": 5,
      "text": "Stir until the mixture forms a cohesive cookie dough."
    },
    {
      "step": 6,
      "text": "Shape the dough into cookies and transfer them to a baking sheet."
    },
    {
      "step": 7,
      "text": "Bake until set, about 13 minutes.",
      "timer_minutes": 13
    },
    {
      "step": 8,
      "text": "Transfer the cookies to a rack and cool before serving."
    }
  ],
