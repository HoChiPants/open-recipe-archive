  "id": "layered-oatmeal-chocolate-chip-cookie-mix",
  "name": "Layered Oatmeal Chocolate Chip Cookie Mix",
  "subtitle": "A jar-ready blend of oats, chocolate, pecans, and sugars",
  "description": "Layer the dry ingredients in a jar, then combine the mix with the prepared wet mixture and bake into cookies.",
  "meal_type": "dessert",
