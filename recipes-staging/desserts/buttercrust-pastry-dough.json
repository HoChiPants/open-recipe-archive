{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "buttercrust-pastry-dough",
  "name": "Buttercrust Pastry Dough",
  "subtitle": "Flaky dough for pies and tarts",
  "description": "A chilled, all-butter pastry dough with a tender crumb and crisp, flaky layers.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "cut into 12 cubes, frozen"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ice-water",
      "item": "ice water",
      "quantity": 6,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the flour, sugar, and salt in a large bowl."
    },
    {
      "step": 2,
      "text": "Cut in the frozen butter until the mixture has coarse crumbs with some pea-sized pieces remaining.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the ice water gradually, tossing until the dough just holds together."
    },
    {
      "step": 4,
      "text": "Gather the dough into a disk without kneading, wrap it, and chill before rolling.",
      "timer_minutes": 60
    }
  ],
