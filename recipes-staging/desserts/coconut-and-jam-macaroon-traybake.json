{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "coconut-and-jam-macaroon-traybake",
  "name": "Coconut and Jam Macaroon Traybake",
  "subtitle": "A chewy coconut bake layered with raspberry jam and finished with dark chocolate.",
  "description": "Bake a sweet coconut mixture with a raspberry jam center, then cool and drizzle with melted dark chocolate before cutting into servings.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "egg-whites-beaten",
      "item": "egg whites beaten",
      "quantity": 4
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "desiccated-coconut",
      "item": "desiccated coconut",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 25,
      "unit": "g"
    },
    {
      "ingredient_id": "raspberry-jam",
      "item": "raspberry jam",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-chocolate-chopped",
      "item": "dark chocolate chopped",
      "quantity": 100,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a traybake tin with baking paper."
    },
    {
      "step": 2,
      "text": "Mix the caster sugar, beaten egg whites, and vanilla extract until combined."
    },
    {
      "step": 3,
      "text": "Stir in the desiccated coconut and plain flour until evenly mixed."
    },
    {
      "step": 4,
      "text": "Transfer half the mixture to the prepared tin and spread it into an even layer. Spread the raspberry jam over it, then cover with the remaining mixture."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until golden and set. The center should be firm and reach 160°F for egg safety.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool completely in the tin."
    },
    {
      "step": 7,
      "text": "Microwave the chopped dark chocolate in short bursts, stirring between each, until smooth and set enough to drizzle."
    },
    {
      "step": 8,
      "text": "Drizzle the chocolate over the cooled bake, let it set, and cut into 16 pieces."
    }
  ],
