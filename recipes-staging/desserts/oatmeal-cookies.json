  "id": "oatmeal-cookies",
  "name": "Oatmeal Cookies",
  "subtitle": "Crisp-edged cookies with oats and walnuts",
  "description": "A straightforward American cookie combining creamed butter and sugars with cinnamon, quick oats, and chopped walnuts.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 42,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "cup",
      "preparation": "softened"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
