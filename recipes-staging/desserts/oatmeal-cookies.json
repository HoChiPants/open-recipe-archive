      "item": "walnuts",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter, packed brown sugar, and white sugar until smooth. Whisk in the eggs and vanilla extract."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the flour, cinnamon, salt, and baking soda. Stir the dry mixture into the butter mixture."
    },
    {
      "step": 4,
      "text": "Stir in the quick cooking oats and chopped walnuts until evenly distributed."
    },
    {
      "step": 5,
      "text": "Prepare baking sheets and portion the dough onto them, leaving space between portions."
    },
    {
      "step": 6,
      "text": "Bake until the cookies are set and lightly browned, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 7,
      "text": "Transfer the cookies to a rack or other cool surface to finish cooling."
    }
  ],
