  "id": "pistachio-nut-bundt-cake",
  "name": "Pistachio Nut Bundt Cake",
  "subtitle": "A tender pistachio cake with a cinnamon-walnut center",
  "description": "A simple Bundt cake made with pistachio pudding, sour cream, and a cinnamon-walnut filling, finished with confectioners' sugar.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "yellow-cake-mix",
      "item": "yellow cake mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "15.25 ounce"
    },
    {
