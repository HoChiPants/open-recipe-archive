      "item": "confectioners' sugar for dusting",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Prepare a Bundt pan for baking."
    },
    {
      "step": 2,
      "text": "Stir together the yellow cake mix and pistachio pudding mix. In a separate bowl, whisk the sour cream, vegetable oil, and eggs until smooth. Combine the wet and dry mixtures to make the batter."
    },
    {
      "step": 3,
      "text": "Mix the brown sugar, walnuts, and cinnamon for the filling."
    },
    {
      "step": 4,
      "text": "Pour half the batter into the prepared pan, distribute the filling over it, and cover with the remaining batter."
    },
    {
      "step": 5,
      "text": "Bake for 60 minutes, or until the cake is set and a tester comes out clean.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Cool the cake in the pan for 15 minutes, then turn it out onto a serving plate and dust with the confectioners' sugar.",
      "timer_minutes": 15
    }
  ],
