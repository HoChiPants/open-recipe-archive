    "inactive_minutes": 165
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 12,
      "unit": "ounces",
      "preparation": "hulled"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "tiny-pinch-salt",
      "item": "tiny pinch salt",
      "quantity": 1
    },
    {
      "ingredient_id": "red-food-coloring",
      "item": "red food coloring",
      "quantity": 2,
      "unit": "drops"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the hulled strawberries and sugar; let stand for 10 minutes, until the berries are softened and juicy.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk together the cream, milk, vanilla extract, and salt. Blend in the strawberry mixture until smooth."
    },
    {
      "step": 3,
      "text": "Whisk in the red food coloring, then continue whisking until the mixture is thick."
    },
    {
      "step": 4,
      "text": "Freeze the mixture, whisking periodically for 2 hours, until firm and scoopable.",
      "timer_minutes": 120
    }
  ],
