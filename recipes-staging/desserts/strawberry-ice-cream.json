  "id": "strawberry-ice-cream",
  "name": "Strawberry Ice Cream",
  "subtitle": "Creamy homemade ice cream with fresh berries",
  "description": "A simple strawberry ice cream made by macerating berries, blending them with a seasoned cream mixture, and chilling until thick and scoopable.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
