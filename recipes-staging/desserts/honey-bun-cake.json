  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 325°F and prepare a baking pan."
    },
    {
      "step": 2,
      "text": "Stir together the yellow cake mix, vegetable oil, eggs, and sour cream until evenly combined."
    },
    {
      "step": 3,
      "text": "Transfer half of the batter to the prepared pan. Combine the brown sugar and cinnamon, then scatter the mixture over the batter. Cover with the remaining batter."
    },
    {
      "step": 4,
      "text": "Bake until the center is fully set and a tester comes out clean.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Whisk the confectioners' sugar, milk, and vanilla extract until smooth."
    },
    {
      "step": 6,
      "text": "Cool the cake briefly, spread the glaze over the top, and serve.",
      "timer_minutes": 15
    }
  ],
