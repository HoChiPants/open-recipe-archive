  "id": "honey-bun-cake",
  "name": "Honey Bun Cake",
  "subtitle": "Soft yellow cake with cinnamon sugar and vanilla glaze",
  "description": "A tender sour-cream yellow cake layered with brown sugar and cinnamon, then finished with a smooth confectioners’ sugar glaze.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
