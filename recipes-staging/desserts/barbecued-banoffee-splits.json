  "id": "barbecued-banoffee-splits",
  "name": "Barbecued Banoffee Splits",
  "subtitle": "Warm bananas with buttery brown sugar and cool toppings",
  "description": "Grill ripe bananas in their skins with a quick vanilla brown-sugar butter, then finish with pecans, ice cream, whipped cream, or yogurt.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "ripe-bananas-unpeeled",
      "item": "ripe bananas unpeeled",
      "quantity": 6,
      "unit": "small"
    },
    {
      "ingredient_id": "pecans-ice-cream",
      "item": "pecans ice cream",
      "preparation": "chopped, whipped cream or yogurt, to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the softened butter, brown sugar, and vanilla extract into a smooth mixture."
    },
    {
      "step": 2,
      "text": "Cut a lengthwise slit in each unpeeled banana without cutting all the way through."
    },
    {
      "step": 3,
      "text": "Transfer the butter mixture into the banana slits and close the skins around the filling."
    },
    {
      "step": 4,
      "text": "Preheat a barbecue or grill to medium heat."
    },
    {
      "step": 5,
      "text": "Cook the bananas for 15 minutes, turning as needed, until tender and warmed through.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Prepare the toppings, then transfer the chopped pecans, ice cream, whipped cream, or yogurt to serve with the hot bananas."
    }
  ],
