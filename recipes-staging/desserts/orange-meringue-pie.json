  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Layer the pie crust in a 9-inch pie plate and bake for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk sugar, cornstarch, salt, and white sugar together in a saucepan. Combine orange juice, lemon juice, water, orange zest, and diced orange segments, then whisk the liquid into the dry mixture."
    },
    {
      "step": 3,
      "text": "Cook the filling, stirring frequently, until it is thick. Stir in the butter or margarine, then add the separated egg yolks and continue cooking until the filling is hot and set.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Transfer the filling to the baked crust and let it stand until set."
    },
    {
      "step": 5,
      "text": "Reduce the oven temperature to 350°F. Whisk the egg whites with cream of tartar, gradually adding white sugar, until stiff peaks form."
    },
    {
      "step": 6,
      "text": "Spread the meringue over the filling, sealing it to the crust edge. Bake for 15 minutes, until golden brown and the meringue is firm and fully set.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Cool the pie completely, then chill for 60 minutes before serving.",
      "timer_minutes": 60
    }
  ],
