  "id": "coffee-tiramisu",
  "name": "Coffee Tiramisu",
  "subtitle": "Creamy mascarpone layers with coffee-soaked sponge fingers",
  "description": "A chilled dessert layered with mascarpone cream, coffee-dipped sponge fingers, dark chocolate, and cocoa.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
