    },
    {
      "ingredient_id": "strong-coffee-made-with-2-tbsp-coffee-granules-and-300ml-boiling-water",
      "item": "strong coffee made with 2 tbsp coffee granules and 300ml boiling water",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "sponge-fingers",
      "item": "sponge fingers",
      "quantity": 175,
