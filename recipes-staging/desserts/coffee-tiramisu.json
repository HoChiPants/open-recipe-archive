      "item": "cocoa powder",
      "quantity": 2,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Use pasteurized eggs, and prepare the strong coffee; let the coffee cool completely."
    },
    {
      "step": 2,
      "text": "Separate the eggs. Whisk the yolks with the golden caster sugar for 5 minutes, until thick and pale.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk the mascarpone with the Baileys until smooth. Fold it into the yolk mixture, then gently fold in the beaten egg whites."
    },
    {
      "step": 4,
      "text": "Dip the sponge fingers briefly into the cooled coffee and arrange a layer in a serving dish."
    },
    {
      "step": 5,
      "text": "Spread over half the mascarpone mixture, add another layer of coffee-dipped sponge fingers, and finish with the remaining cream."
    },
    {
      "step": 6,
      "text": "Grate the dark chocolate over the top, cover, and chill until set."
    },
    {
      "step": 7,
      "text": "Dust with cocoa powder just before serving."
    }
  ],
