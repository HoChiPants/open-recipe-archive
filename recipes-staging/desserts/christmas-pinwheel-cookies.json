  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the all-purpose flour, baking powder, baking soda, and salt in a bowl."
    },
    {
      "step": 2,
      "text": "Whisk the butter, packed brown sugar, and white sugar until smooth. Whisk in the beaten eggs and vanilla extract until combined."
    },
    {
      "step": 3,
      "text": "Stir the dry mixture into the butter mixture just until a soft dough forms."
    },
    {
      "step": 4,
      "text": "Divide the dough into three portions. Leave one plain, tint one red with the red food coloring, and tint one green with the green food coloring, blending each portion evenly."
    },
    {
      "step": 5,
      "text": "Roll each portion into a thin rectangle. Stack the rectangles, then roll them tightly into a log and smooth the surface."
    },
    {
      "step": 6,
      "text": "Wrap the dough log and chill it for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 7,
      "text": "Preheat the oven to 400°F. Line baking sheets with parchment."
    },
    {
      "step": 8,
      "text": "Slice the chilled log into thick rounds and arrange them on the prepared sheets."
    },
    {
      "step": 9,
      "text": "Bake for 6 minutes, until the cookies are set.",
      "timer_minutes": 6
    },
    {
      "step": 10,
      "text": "Cool the cookies on the baking sheets briefly, then transfer them to a rack to cool completely."
    }
  ],
