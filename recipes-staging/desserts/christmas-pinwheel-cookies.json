  "id": "christmas-pinwheel-cookies",
  "name": "Christmas Pinwheel Cookies",
  "subtitle": "Colorful slice-and-bake sugar cookies",
  "description": "A buttery cookie dough is divided, tinted red and green, layered with plain dough, rolled into a log, chilled, sliced, and baked until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 72,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 5,
    "inactive_minutes": 480
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
