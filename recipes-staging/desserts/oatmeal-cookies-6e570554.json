  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk together the brown sugar, shortening, milk, egg, and vanilla until smooth."
    },
    {
      "step": 3,
      "text": "Stir the oats, flour, baking soda, and salt into the wet mixture, adding more flour if needed to form a scoopable dough."
    },
    {
      "step": 4,
      "text": "Prepare the baking soda as directed within the dry mixture before baking."
    },
    {
      "step": 5,
      "text": "Portion the dough onto baking sheets and bake for 10 minutes, until golden brown and the centers are fully set; if checked with a food thermometer, they should reach 160°F.",
      "timer_minutes": 10
    }
  ],
