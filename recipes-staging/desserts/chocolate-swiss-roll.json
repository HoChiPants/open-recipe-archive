{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-swiss-roll",
  "name": "Chocolate Swiss Roll",
  "subtitle": "A light chocolate sponge with vanilla cream",
  "description": "Bake a thin chocolate sponge, roll it while warm, then fill it with vanilla-scented cream and finish with icing sugar.",
  "meal_type": "dessert",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3
    },
    {
      "ingredient_id": "golden-caster-sugar-plus-extra-for-scattering",
      "item": "golden caster sugar plus extra for scattering",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "icing-sugar-sifted",
      "item": "icing sugar sifted",
      "quantity": 50,
      "unit": "g",
      "preparation": "plus extra to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a shallow Swiss-roll tin with baking paper."
    },
    {
      "step": 2,
      "text": "Sift the flour and cocoa powder together."
    },
    {
      "step": 3,
      "text": "Whisk the eggs, caster sugar, and sifted icing sugar for 5 minutes, until thick and pale.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Fold in the flour mixture gently until just combined."
    },
    {
      "step": 5,
      "text": "Spread the batter evenly in the prepared tin and bake for 10 minutes, until the sponge is fully set and springs back lightly.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Scatter extra caster sugar over a sheet of baking paper. Turn out the hot sponge onto it, remove the tin paper, and trim the edges if needed."
    },
    {
      "step": 7,
      "text": "Roll the sponge up in the sugared paper while warm, then leave it to cool completely."
    },
    {
      "step": 8,
      "text": "Whisk the cream with the vanilla extract until thick enough to spread."
    },
    {
      "step": 9,
      "text": "Unroll the cooled sponge, spread over the cream, and roll it up again."
    },
    {
      "step": 10,
      "text": "Dust with extra sifted icing sugar and chill before serving.",
      "timer_minutes": 1440
    },
    {
      "step": 11,
      "text": "Slice and serve."
    }
  ],
