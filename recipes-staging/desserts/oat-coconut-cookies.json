      "item": "eggs",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare baking sheets."
    },
    {
      "step": 2,
      "text": "Whisk the flour, baking soda, and salt in a bowl. Stir in both sugars, oats, and coconut."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the oil, eggs, and vanilla. Add this mixture to the dry ingredients and stir until evenly combined."
    },
    {
      "step": 4,
      "text": "Portion the dough onto the prepared sheets, spacing the portions apart."
    },
    {
      "step": 5,
      "text": "Bake until the cookies are set and lightly browned, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 6,
      "text": "Let the cookies cool on the baking sheets before serving."
    }
  ],
