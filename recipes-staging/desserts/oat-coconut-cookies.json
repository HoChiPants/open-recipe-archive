  "id": "oat-coconut-cookies",
  "name": "Oat Coconut Cookies",
  "subtitle": "Chewy cookies with oats and toasted coconut flavor",
  "description": "A simple drop cookie combining rolled oats, coconut, and brown sugar in a lightly crisp bake.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 36,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
