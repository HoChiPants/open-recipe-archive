  "id": "avocado-lime-cheesecake",
  "name": "Avocado-Lime Cheesecake",
  "subtitle": "A cool, creamy dessert with fresh lime flavor",
  "description": "Blend ripe avocado with softened cream cheese and lime, fold in the prepared cream mixture, then freeze in a graham cracker crust until firm.",
  "meal_type": "dessert",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 5,
    "inactive_minutes": 160
  },
  "ingredients": [
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "ripe-avocados",
      "item": "ripe avocados",
      "quantity": 1.5,
      "preparation": "peeled and pitted"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "3 ounce, softened"
    },
    {
      "ingredient_id": "fresh-lime-juice",
      "item": "fresh lime juice",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "8-inch-prepared-graham-cracker-crust",
      "item": "(8 inch) prepared graham cracker crust",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the heavy whipping cream, cream cheese, and white sugar separately as directed by the preparation, then transfer the warmed mixture and let it stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Whisk the heavy whipping cream and cream cheese until smooth. Add the fresh lime juice and whisk again until combined."
    },
    {
      "step": 3,
      "text": "Blend the ripe avocados with the cream cheese mixture until smooth, then chill the mixture in the freezer for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Spread the avocado mixture evenly into the prepared graham cracker crust."
    },
    {
      "step": 5,
      "text": "Freeze until firm, about 2 hours. Let stand for 15 minutes before cutting and serving.",
      "timer_minutes": 135
    }
  ],
