  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and oil the cake tins."
    },
    {
      "step": 2,
      "text": "Whisk the cocoa powder, olive oil, yogurt, milk, vinegar, eggs, soy sauce, baking powder, and optional salt until smooth."
    },
    {
      "step": 3,
      "text": "Combine the plain flour, bicarbonate of soda, and light brown soft sugar, then fold them into the wet mixture until evenly blended."
    },
    {
      "step": 4,
      "text": "Divide the batter between the prepared tins and bake for 25 minutes, then continue baking for 5 minutes, until risen and the centers are firm.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Cool the cakes in their tins, then turn them out and cool completely."
    },
    {
      "step": 6,
      "text": "Make the ganache by placing the chopped chocolate in a bowl. Heat the cream until hot, pour it over the chocolate, and whisk until smooth."
    },
    {
      "step": 7,
      "text": "Cool the ganache, then chill it until firm.",
      "timer_minutes": 40
    },
    {
      "step": 8,
      "text": "For the frosting, whisk the mascarpone, double cream, icing sugar, and vanilla extract to soft peaks."
    },
    {
      "step": 9,
      "text": "Stir the chilled ganache until spreadable. Layer the cakes with ganache and mascarpone cream, then finish with the remaining frosting."
    },
    {
      "step": 10,
      "text": "Chill the assembled cake before serving.",
      "timer_minutes": 60
    }
  ],
