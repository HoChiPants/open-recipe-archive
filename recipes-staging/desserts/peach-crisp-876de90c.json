  "id": "peach-crisp-876de90c",
  "name": "Peach Crisp",
  "subtitle": "Warm peaches beneath a cinnamon oat topping",
  "description": "A simple baked peach dessert with a buttery, cinnamon-scented oat crumble.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-peaches",
      "item": "fresh peaches",
      "quantity": 4,
      "unit": "cups",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cold-butter",
      "item": "cold butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "rolled-oats",
      "item": "rolled oats",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Place the sliced peaches in a baking dish."
    },
    {
      "step": 3,
      "text": "Combine the flour, brown sugar, cold butter, cinnamon, and salt until crumbly."
    },
    {
      "step": 4,
      "text": "Fold in the rolled oats to form the topping."
    },
    {
      "step": 5,
      "text": "Scatter the topping over the peaches and sprinkle with the remaining brown sugar."
    },
    {
      "step": 6,
      "text": "Bake for 30 minutes, until golden brown.",
      "timer_minutes": 30
    }
  ],
