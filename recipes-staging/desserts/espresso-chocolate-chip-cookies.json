  "id": "espresso-chocolate-chip-cookies",
  "name": "Espresso Chocolate Chip Cookies",
  "subtitle": "Soft-centered cookies with a hint of coffee",
  "description": "Classic chocolate chip cookies enriched with brown sugar and instant espresso powder.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "packed-brown-sugar",
      "item": "packed brown sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.75,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "instant-espresso-coffee-powder",
      "item": "instant espresso coffee powder",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "semisweet-chocolate-chips",
      "item": "semisweet chocolate chips",
      "quantity": 1.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Whisk the unsalted butter, packed brown sugar, and white sugar until smooth. Whisk in the egg and vanilla extract."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the all-purpose flour, baking soda, baking powder, salt, and instant espresso coffee powder."
    },
    {
      "step": 4,
      "text": "Stir the dry mixture into the butter mixture until combined, then stir in the semisweet chocolate chips."
    },
    {
      "step": 5,
      "text": "Portion the dough onto baking sheets, leaving space between portions."
    },
    {
      "step": 6,
      "text": "Bake until the cookies are set at the edges and the centers are no longer wet, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Leave the cookies on the baking sheets for 2 minutes, then transfer them to cool.",
      "timer_minutes": 2
    }
  ],
