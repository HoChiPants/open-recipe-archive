  "id": "no-bake-peanut-butter-oatmeal-cookies",
  "name": "No-Bake Peanut Butter Oatmeal Cookies",
  "subtitle": "Quick stovetop cookies with oats and peanut butter",
  "description": "A simple American dessert made by simmering a sweet peanut-butter mixture, combining it with oats, and cooling until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "creamy-peanut-butter",
      "item": "creamy peanut butter",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "quick-cooking-oats",
      "item": "quick-cooking oats",
      "quantity": 3,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the white sugar, milk, butter, and creamy peanut butter in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a simmer, stirring as needed."
    },
    {
      "step": 3,
      "text": "Simmer for 2 minutes, then remove from the heat.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the vanilla extract until the mixture is smooth."
    },
    {
      "step": 5,
      "text": "Fold in the quick-cooking oats until evenly coated."
    },
    {
      "step": 6,
      "text": "Drop the mixture by spoonfuls onto a prepared surface and let cool until set.",
      "timer_minutes": 20
    }
  ],
