      "item": "white chocolate chips",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "pecans",
      "item": "pecans",
      "quantity": 1,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 300°F."
    },
    {
      "step": 2,
      "text": "Whisk together the flour, pumpkin pie spice, and baking soda."
    },
    {
      "step": 3,
      "text": "Whisk the brown sugar and butter until smooth. Add the pumpkin puree, eggs, and vanilla, then whisk until combined."
    },
    {
      "step": 4,
      "text": "Add the dry mixture and stir just until combined. Fold in the white chocolate chips and pecans."
    },
    {
      "step": 5,
      "text": "Prepare the cookies on baking sheets, spacing them apart."
    },
    {
      "step": 6,
      "text": "Bake until set, about 22 minutes.",
      "timer_minutes": 22
    }
  ],
