    "inactive_minutes": 180
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "sliced, mashed"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-strawberries",
      "item": "fresh strawberries",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "9-inch-prepared-graham-cracker-crust",
      "item": "(9 inch) prepared graham cracker crust",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Beat the softened cream cheese, white sugar, and vanilla extract until smooth."
    },
    {
      "step": 2,
      "text": "Whisk the heavy whipping cream with the confectioners' sugar until stiff peaks form."
    },
    {
      "step": 3,
      "text": "Fold the whipped cream and sliced, mashed strawberries into the cream cheese mixture until combined."
    },
    {
      "step": 4,
      "text": "Spoon the filling into the prepared graham cracker crust and smooth the top. Arrange the sliced strawberries over it."
    },
    {
      "step": 5,
      "text": "Chill for 180 minutes, or until firm enough to slice.",
      "timer_minutes": 180
    }
  ],
