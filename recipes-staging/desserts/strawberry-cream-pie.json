  "id": "strawberry-cream-pie",
  "name": "Strawberry Cream Pie",
  "subtitle": "A chilled, creamy pie layered with fresh strawberries.",
  "description": "A simple no-bake dessert with a smooth cream cheese filling, strawberries, and a graham cracker crust.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
