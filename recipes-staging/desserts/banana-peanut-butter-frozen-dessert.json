  "id": "banana-peanut-butter-frozen-dessert",
  "name": "Banana-Peanut Butter Frozen Dessert",
  "subtitle": "A quick creamy treat from frozen bananas",
  "description": "Blend frozen banana with a few simple ingredients, then swirl in peanut butter for a smooth, scoopable dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
