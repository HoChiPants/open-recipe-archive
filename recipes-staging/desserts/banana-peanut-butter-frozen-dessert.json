    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "slightly-overripe-bananas",
      "item": "slightly overripe bananas",
      "quantity": 2,
      "preparation": "cut into chunks"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "drops"
    },
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Arrange the banana chunks in a freezer-safe container and freeze until firm, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Transfer the frozen bananas to a blender with the confectioners' sugar, milk, and vanilla extract."
    },
    {
      "step": 3,
      "text": "Blend until smooth."
    },
    {
      "step": 4,
      "text": "Add the peanut butter and blend again until smooth."
    }
  ],
