  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "bosc-pears",
      "item": "Bosc pears",
      "quantity": 2,
      "preparation": "halved and cored"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Grease a baking dish with half of the butter. Arrange the pear halves cut-side up, and dot with the remaining butter."
    },
    {
      "step": 3,
      "text": "Sprinkle the sugar evenly over the pears and butter."
    },
    {
      "step": 4,
      "text": "Bake for 10 minutes, then pour in the cream and continue baking until the pears are tender, about 20 minutes more.",
      "timer_minutes": 30
    }
  ],
