  "id": "baked-pears",
  "name": "Baked Pears",
  "subtitle": "Tender pears with a buttery cream finish",
  "description": "Bosc pear halves are baked with butter and sugar, then finished with heavy cream for a simple warm dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
