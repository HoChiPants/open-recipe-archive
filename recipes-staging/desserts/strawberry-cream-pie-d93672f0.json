  "id": "strawberry-cream-pie-d93672f0",
  "name": "Strawberry Cream Pie",
  "subtitle": "A chilled pie with glazed berries and vanilla cream filling.",
  "description": "Layer a cinnamon-vanilla cream cheese filling with glazed strawberries in a baked crust, then chill until set.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "strawberry",
      "item": "strawberries",
      "quantity": 1,
      "unit": "quart",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "strawberry-glaze",
      "item": "strawberry glaze",
      "quantity": 1,
      "unit": "package",
      "preparation": "13.5 ounce"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "4 ounce, softened"
    },
    {
      "ingredient_id": "confectioners-sugar",
      "item": "confectioners' sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "9-inch-baked-pie-crust",
      "item": "(9 inch) baked pie crust",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the sliced strawberries with the strawberry glaze until evenly coated."
    },
    {
      "step": 2,
      "text": "Whisk the softened cream cheese, confectioners' sugar, vanilla extract, cinnamon, and heavy whipping cream until combined and thick."
    },
    {
      "step": 3,
      "text": "Transfer the cream mixture to the baked pie crust and add the glazed strawberries with the strawberry glaze."
    },
    {
      "step": 4,
      "text": "Chill the pie until set.",
      "timer_minutes": 60
    }
  ],
