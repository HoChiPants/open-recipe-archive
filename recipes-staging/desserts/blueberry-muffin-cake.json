  "id": "blueberry-muffin-cake",
  "name": "Blueberry Muffin Cake",
  "subtitle": "A tender blueberry bake with a cinnamon crumb topping.",
  "description": "A simple American-style cake combining a blueberry-studded batter with a buttery brown-sugar cinnamon topping.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
