  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Coat a 9-inch square baking pan with cooking spray."
    },
    {
      "step": 2,
      "text": "Toss the blueberries with part of the divided flour. In a bowl, whisk the white sugar, vegetable oil, milk, egg, and vanilla until smooth."
    },
    {
      "step": 3,
      "text": "In a separate bowl, combine the remaining flour with the baking powder and salt. Add the dry mixture to the wet mixture and stir just until combined. Fold in the floured blueberries, then transfer the batter to the prepared pan."
    },
    {
      "step": 4,
      "text": "For the topping, combine the brown sugar, the remaining all-purpose flour, and cinnamon. Cut in the butter until coarse crumbs form, then scatter the mixture over the batter."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Cool before cutting into servings."
    }
  ],
