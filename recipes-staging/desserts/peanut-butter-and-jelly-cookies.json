  "id": "peanut-butter-and-jelly-cookies",
  "name": "Peanut Butter and Jelly Cookies",
  "subtitle": "Soft peanut butter cookies with a fruit-filled center",
  "description": "A simple American cookie combining peanut butter, sugar, and vanilla with a spoonful of fruit preserves.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "peanut-butter",
      "item": "peanut butter",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fruit-preserves",
      "item": "fruit preserves",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "any flavor"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and prepare a baking sheet."
    },
    {
      "step": 2,
      "text": "Stir the peanut butter, sugar, egg, and vanilla extract together until evenly combined."
    },
    {
      "step": 3,
      "text": "Divide the mixture into 12 portions, shape each into a ball, and arrange them on the baking sheet. Press an indentation into the center of each."
    },
    {
      "step": 4,
      "text": "Spoon the fruit preserves into the indentations."
    },
    {
      "step": 5,
      "text": "Bake for 10 minutes, or until the cookies are set and the centers reach 160°F.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Cool the cookies on the baking sheet until firm enough to serve."
    }
  ],
