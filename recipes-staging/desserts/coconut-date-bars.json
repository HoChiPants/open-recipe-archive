  "id": "coconut-date-bars",
  "name": "Coconut Date Bars",
  "subtitle": "A chilled blend of dates, coconut, and nuts",
  "description": "These no-bake bars combine naturally sweet dates with coconut, almonds, and cashews for a compact chilled dessert.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "slivered-almonds",
      "item": "slivered almonds",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "flaked-coconut",
      "item": "flaked coconut",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "dates",
      "item": "dates",
      "quantity": 10,
      "preparation": "pitted, or to taste"
    },
    {
      "ingredient_id": "cashews",
      "item": "cashews",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "coconut-oil",
      "item": "coconut oil",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Process the slivered almonds, flaked coconut, and coconut oil until finely blended."
    },
    {
      "step": 2,
      "text": "Add the dates and process until the mixture is combined."
    },
    {
      "step": 3,
      "text": "Add the cashews, then continue processing until the mixture becomes thick."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a suitable dish and press or shape it into bars."
    },
    {
      "step": 5,
      "text": "Chill until firm, about 30 minutes, then cut into four servings.",
      "timer_minutes": 30
    }
  ],
