  "id": "curried-egg-mayo-sandwiches",
  "name": "Curried Egg Mayo Sandwiches",
  "subtitle": "Creamy egg filling with mango chutney and curry",
  "description": "A simple sandwich filling combining chopped eggs, mayonnaise, yogurt, chutney, curry paste, onions, and coriander.",
  "meal_type": "drink",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 8
  },
  "ingredients": [
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 3,
      "unit": "medium"
    },
    {
      "ingredient_id": "mayo",
