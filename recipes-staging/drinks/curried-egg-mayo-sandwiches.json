      "item": "butter for spreading"
    },
    {
      "ingredient_id": "slices-soft-brown-bread",
      "item": "slices soft brown bread",
      "quantity": 4
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the eggs in boiling water for 8 minutes. Cool, peel, and chop them.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Mix the chopped eggs with the mayo, Greek yogurt, mango chutney, korma curry paste, spring onions sliced, and coriander."
    },
    {
      "step": 3,
      "text": "Spread butter over the bread slices."
    },
    {
      "step": 4,
      "text": "Divide the egg mixture between two bread slices, cover with the remaining slices, and serve."
    }
  ],
