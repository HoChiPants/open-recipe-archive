      "unit": "tbsp"
    },
    {
      "ingredient_id": "mango-chutney",
      "item": "mango chutney",
      "quantity": "1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "korma-curry-paste",
      "item": "korma curry paste",
      "quantity": "1/2",
      "unit": "tbsp"
    },
    {
