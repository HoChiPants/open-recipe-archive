  "id": "coconut-margarita",
  "name": "Coconut Margarita",
  "subtitle": "A chilled tequila cocktail with coconut, lime, and a lightly sweet-salty finish.",
  "description": "Shake tequila, coconut rum, lime, and ice with a coconut-lime seasoning mixture, then serve cold.",
  "meal_type": "drink",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "tequila-reposado",
      "item": "tequila reposado",
      "quantity": 50,
      "unit": "ml"
    },
    {
      "ingredient_id": "lime-juice",
      "item": "lime juice",
      "quantity": 25,
      "unit": "ml"
    },
    {
      "ingredient_id": "coconut-rum",
      "item": "coconut rum",
      "quantity": 25,
      "unit": "ml"
    },
    {
      "ingredient_id": "ice-cubes",
      "item": "ice cubes"
    },
    {
      "ingredient_id": "sea-salt-flakes",
      "item": "sea salt flakes",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "dessicated-coconut",
      "item": "dessicated coconut",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "lime-zested",
      "item": "lime zested",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Chill a serving glass. Combine the sea salt flakes, golden caster sugar, dessicated coconut, and lime zest in a small dish."
    },
    {
      "step": 2,
      "text": "Add the tequila reposado, lime juice, and coconut rum to a shaker with the coconut-lime mixture and ice cubes."
    },
    {
      "step": 3,
      "text": "Shake vigorously until thoroughly chilled, then strain into the chilled glass."
    }
  ],
