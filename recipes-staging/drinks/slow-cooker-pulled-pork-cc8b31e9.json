  "id": "slow-cooker-pulled-pork-cc8b31e9",
  "name": "Slow Cooker Pulled Pork",
  "subtitle": "Tender shredded pork with a savory spice rub",
  "description": "Pork shoulder cooks slowly with root beer and a warmly spiced rub until tender enough to shred.",
  "meal_type": "drink",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
