  "instructions": [
    {
      "step": 1,
      "text": "Place the pork shoulder in a slow cooker and pour the root beer around it."
    },
    {
      "step": 2,
      "text": "Combine the brown sugar, cumin, paprika, salt, pepper, garlic powder, onion powder, and oregano. Rub the mixture over the pork."
    },
    {
      "step": 3,
      "text": "Cook for 5 hours, then continue cooking for 3 hours, until the pork is tender and reaches at least 145°F internally.",
      "timer_minutes": 480
    },
    {
      "step": 4,
      "text": "Transfer the pork to a cutting board and let it rest for at least 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Shred the pork with two forks and return it to the cooking juices before serving."
    }
  ],
