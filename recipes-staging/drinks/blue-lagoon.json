  "id": "blue-lagoon",
  "name": "Blue Lagoon",
  "subtitle": "A bright, citrusy blue mixed drink",
  "description": "Chill four servings over ice, then finish with citrus juices, cherry syrup, cherries, and soda water.",
  "meal_type": "drink",
