  "instructions": [
    {
      "step": 1,
      "text": "Divide the ice cubes and crushed ice among four glasses."
    },
    {
      "step": 2,
      "text": "Add the blue curaçao, vodka, lemon juice, orange juice, lime juice, cherries, and 1 tsp of the cherry syrup. Stir to combine."
    },
    {
      "step": 3,
      "text": "Pour in the soda water and stir gently. Serve immediately."
    }
