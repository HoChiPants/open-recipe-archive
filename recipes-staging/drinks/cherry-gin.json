  "instructions": [
    {
      "step": 1,
      "text": "Put the cherries into the sterilised wide-necked jar."
    },
    {
      "step": 2,
      "text": "Add the caster sugar, pour in the bottle gin, and seal the jar."
    },
    {
      "step": 3,
      "text": "Shake the sealed jar until the sugar is distributed and the cherries are coated with gin."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a suitable storage container or bottle when ready to use."
    }
