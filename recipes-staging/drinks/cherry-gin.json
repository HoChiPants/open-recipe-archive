  "id": "cherry-gin",
  "name": "Cherry Gin",
  "subtitle": "A simple fruit-infused gin",
  "description": "Combine cherries, sugar, and gin in a sterilized jar to make a ruby-colored infusion.",
  "meal_type": "drink",
