  "id": "cranberry-whiskey-sour",
  "name": "Cranberry Whiskey Sour",
  "subtitle": "A tart, frothy bourbon cocktail",
  "description": "Cranberry and lemon juices balance bourbon in a lightly sweetened sour with a foamy egg-white finish.",
  "meal_type": "drink",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "ice",
      "item": "ice"
    },
    {
      "ingredient_id": "bourbon",
      "item": "bourbon",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "cranberry-juice",
      "item": "cranberry juice",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "agave-or-honey",
      "item": "agave or honey",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the bourbon, cranberry juice, agave or honey, lemon juice, and egg white in a shaker. For safety, use a food thermometer to verify that the egg-containing mixture reaches 160°F before serving."
    },
    {
      "step": 2,
      "text": "Shake vigorously without ice to aerate the egg white."
    },
    {
      "step": 3,
      "text": "Add ice, shake again until chilled, and strain into two glasses."
    }
  ],
