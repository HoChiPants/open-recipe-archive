  "instructions": [
    {
      "step": 1,
      "text": "Warm the milk in a small saucepan over medium heat until steaming and just beginning to simmer; do not boil.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Stir the espresso, vanilla extract, and half the caramel sauce together in a heatproof serving glass."
    },
    {
      "step": 3,
      "text": "Pour in the warm milk and finish with the remaining caramel sauce."
    }
