  "id": "caramel-macchiato",
  "name": "Caramel Macchiato",
  "subtitle": "Espresso layered with warm vanilla milk and caramel",
  "description": "A single-serving coffee drink made with espresso, gently heated milk, vanilla, and caramel sauce.",
  "meal_type": "drink",
  "yield": {
    "quantity": 1,
