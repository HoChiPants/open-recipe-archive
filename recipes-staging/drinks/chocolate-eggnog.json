  "schema_version": "1.0.0",
  "id": "chocolate-eggnog",
  "name": "Chocolate Eggnog",
  "subtitle": "Rich chocolate custard drink with bourbon",
  "description": "A creamy chocolate eggnog made by gently thickening sweetened egg yolks with spiced milk, chocolate, cream, and bourbon.",
  "meal_type": "drink",
  "yield": {
    "quantity": 1,
    "unit": "litre"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "egg-yolks-freeze-the-whites-to-use-in-another-recipe",
      "item": "egg yolks (freeze the whites to use in another recipe)",
      "quantity": 4
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 500,
      "unit": "ml"
    },
    {
      "ingredient_id": "nutmeg-grated",
      "item": "nutmeg grated",
      "quantity": "1/4",
      "preparation": "plus extra to serve"
    },
    {
      "ingredient_id": "dark-chocolate-chopped",
      "item": "dark chocolate chopped",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "bourbon",
      "item": "bourbon",
      "quantity": 100,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the egg yolks and caster sugar until thick and pale."
    },
    {
      "step": 2,
      "text": "Heat the whole milk and grated nutmeg in a saucepan until steaming and just simmering."
    },
    {
      "step": 3,
      "text": "Pour the hot milk gradually into the yolk mixture while whisking. Return the mixture to the saucepan."
    },
    {
      "step": 4,
      "text": "Add the chopped dark chocolate and stir over low heat until melted. Continue cooking, stirring constantly, until the egg mixture reaches 160°F and thickens enough to coat a spoon."
    },
    {
      "step": 5,
      "text": "Whisk in the double cream, then remove from the heat."
    },
    {
      "step": 6,
      "text": "Stir in the bourbon and additional grated nutmeg for serving."
    }
  ],
