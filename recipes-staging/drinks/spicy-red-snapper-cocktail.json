  "instructions": [
    {
      "step": 1,
      "text": "Fill a tall glass with the ice cubes. Add the tomato juice, dry gin, fresh lemon juice, hot pepper sauce, and Worcestershire sauce."
    },
    {
      "step": 2,
      "text": "Stir in the hot chili powder, garlic powder, ground cumin, celery salt, fresh-ground black pepper, prepared horseradish, and olive brine."
    },
    {
