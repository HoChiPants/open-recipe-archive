  "id": "rosemary-simple-syrup",
  "name": "Rosemary Simple Syrup",
  "subtitle": "Herbal sweetener for drinks and desserts",
  "description": "A lightly fragrant syrup made by steeping fresh rosemary in equal parts sugar and water.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "rosemary-leaves",
      "item": "rosemary leaves",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the water, white sugar, and rosemary leaves in a saucepan. Heat, stirring, until the sugar dissolves and the mixture reaches a gentle simmer."
    },
    {
      "step": 2,
      "text": "Simmer for 1 minute, then remove from the heat. Cover and let the syrup steep for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Strain out and discard the rosemary leaves. Cool the syrup before using."
    }
  ],
