  "instructions": [
    {
      "step": 1,
      "text": "In a pitcher, stir together the rosé wine, cranberry juice, brandy, cinnamon stick, golden caster sugar, and lemon sliced until combined."
    },
    {
      "step": 2,
      "text": "Cover and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Stir in the lemonade, frozen cranberries, and rosemary sprigs."
    },
    {
      "step": 4,
      "text": "Pour over ice and serve."
    }
