  "id": "cranberry-sangria",
  "name": "Cranberry Sangria",
  "subtitle": "A chilled rosé punch with cranberry and rosemary",
  "description": "Combine rosé, cranberry juice, brandy, cinnamon, sugar, and lemon, then chill before finishing with lemonade, frozen cranberries, rosemary, and ice.",
  "meal_type": "drink",
  "yield": {
    "quantity": 4,
