  "name": "Citrus-Cranberry Sparkling Punch",
  "subtitle": "A bright, lightly tart drink for four",
  "description": "Chill the juices with ice, add sparkling wine, and finish with fresh lemon zest for a colorful, citrusy punch.",
  "meal_type": "drink",
