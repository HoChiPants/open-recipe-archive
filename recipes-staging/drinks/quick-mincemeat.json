      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "allspice",
      "item": "allspice",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "mixed-dried-fruit",
      "item": "mixed dried fruit",
      "quantity": 500,
      "unit": "g"
    },
    {
