      "item": "brandy",
      "quantity": 50,
      "unit": "ml"
    },
    {
      "ingredient_id": "grated-unsalted-butter-or-shredded-suet",
      "item": "grated unsalted butter or shredded suet",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-almonds",
      "item": "ground almonds",
      "quantity": "1/2",
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine all ingredients in a large bowl."
    },
    {
      "step": 2,
      "text": "Stir until the apples, spices, fat, almonds, fruit, sugar, citrus, and brandy are evenly distributed."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to two 500ml jars."
    },
    {
      "step": 4,
      "text": "Use immediately or cover and refrigerate until needed."
    }
  ],
