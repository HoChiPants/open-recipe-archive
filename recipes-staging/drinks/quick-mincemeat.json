  "id": "quick-mincemeat",
  "name": "Quick Mincemeat",
  "subtitle": "A fragrant dried-fruit mixture ready in minutes",
  "description": "Combine apples, citrus, spices, dried fruit, brandy, fat, and almonds for a quick mincemeat mixture.",
  "meal_type": "drink",
  "yield": {
    "quantity": 1,
    "unit": "kg (2 x 500ml jars)"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "and-grated-bramley-apples",
      "item": "and grated Bramley apples",
      "quantity": 2,
      "preparation": "peeled"
    },
    {
      "ingredient_id": "light-muscovado-sugar",
      "item": "light muscovado sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
