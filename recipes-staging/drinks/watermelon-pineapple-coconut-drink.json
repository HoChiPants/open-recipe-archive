  "id": "watermelon-pineapple-coconut-drink",
  "name": "Watermelon-Pineapple Coconut Drink",
  "subtitle": "A cool, creamy fruit drink with citrus brightness",
  "description": "Combine watermelon, pineapple, coconut, and evaporated milk for a refreshing pitcher drink sweetened to taste and finished with lime.",
  "meal_type": "drink",
