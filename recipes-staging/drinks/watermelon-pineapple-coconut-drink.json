  "instructions": [
    {
      "step": 1,
      "text": "Place the sliced watermelon and water in a large pitcher or bowl."
    },
    {
      "step": 2,
      "text": "Add the crushed pineapple, evaporated milk, and shredded coconut; stir to combine."
    },
    {
      "step": 3,
      "text": "Add the sugar and stir until incorporated."
    },
    {
      "step": 4,
      "text": "Stir in the lime juice, then serve."
    }
