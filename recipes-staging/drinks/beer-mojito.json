      "quantity": 50,
      "unit": "ml"
    },
    {
      "ingredient_id": "golden-ale-for-topping-up",
      "item": "golden ale for topping up"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the lime wedges in a serving glass and let them rest briefly."
    },
    {
      "step": 2,
      "text": "Add the mint leaves and sugar syrup, then gently press and stir to release the mint and lime flavors."
    },
    {
      "step": 3,
      "text": "Add the crushed ice and pour in the white rum."
    },
    {
      "step": 4,
      "text": "Stir briefly and top up with golden ale."
    }
  ],
