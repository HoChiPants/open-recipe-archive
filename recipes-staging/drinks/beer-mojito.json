  "id": "beer-mojito",
  "name": "Beer Mojito",
  "subtitle": "A crisp rum, lime, mint, and ale cocktail",
  "description": "Muddle-free mojito-style drink combining fresh lime, mint, rum, crushed ice, and golden ale.",
  "meal_type": "drink",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
