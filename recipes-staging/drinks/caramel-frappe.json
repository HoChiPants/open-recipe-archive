  "instructions": [
    {
      "step": 1,
      "text": "Add the espresso, milk, ice, caramel sauce, and optional vanilla to a blender; blend until smooth and frothy."
    },
    {
      "step": 2,
      "text": "Whisk the optional whipped cream until smooth, then whisk in some caramel sauce if desired."
    },
    {
      "step": 3,
      "text": "Pour into a glass and top with the whipped cream and extra caramel sauce."
    }
