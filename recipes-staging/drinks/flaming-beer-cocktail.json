    {
      "ingredient_id": "fluid-ounce-amaretto-liqueur",
      "item": "fluid ounce amaretto liqueur",
      "quantity": 1
    },
    {
      "ingredient_id": "fluid-ounce-151-proof-rum",
      "item": "fluid ounce 151 proof rum",
      "quantity": 0.25
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour the beer into a heatproof glass, leaving space at the top."
    },
    {
      "step": 2,
      "text": "Add the amaretto liqueur, then carefully float the rum over the surface."
    },
    {
      "step": 3,
      "text": "If flaming, use a long lighter in a clear, heat-safe area and keep your face and hands away from the glass."
    },
    {
      "step": 4,
      "text": "Extinguish the flame completely before handling or drinking."
    }
