  "id": "flaming-beer-cocktail",
  "name": "Flaming Beer Cocktail",
  "subtitle": "A warm-looking beer cocktail with amaretto and high-proof rum",
  "description": "Combine beer, amaretto liqueur, and high-proof rum in a heatproof glass, then extinguish the flame completely before serving.",
  "meal_type": "drink",
