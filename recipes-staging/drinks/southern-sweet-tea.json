  "instructions": [
    {
      "step": 1,
      "text": "Place the sugar in a large heatproof pitcher."
    },
    {
      "step": 2,
      "text": "Bring the water and cold water to a simmer, then pour the hot water over the tea bags in the pitcher."
    },
    {
      "step": 3,
      "text": "Steep the tea for 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Remove the tea bags and stir until the sugar dissolves."
    },
    {
      "step": 5,
      "text": "Add the ice cubes and stir until the tea is chilled. Serve."
    }
