{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "bavarian-style-pretzels",
  "name": "Bavarian-Style Pretzels",
  "subtitle": "Soft, chewy pretzels with a crisp salted finish",
  "description": "Yeast-raised pretzels are shaped, dipped in a baking-soda bath, baked until golden, and finished with butter and coarse salt.",
  "meal_type": "drink",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 10,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3,
      "unit": "cups",
      "preparation": "divided, or more as needed"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.33,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "melted"
    },
    {
      "ingredient_id": "coarse-sea-salt",
      "item": "coarse sea salt",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk together 2 cups flour, the yeast, and sugar. Stir in the water and softened butter until combined."
    },
    {
      "step": 2,
      "text": "Add the salt and enough of the remaining flour to form a workable dough. Knead until smooth, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Cover the dough and let it rise until doubled, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Divide into 6 pieces and roll each into a rope. Shape the ropes into pretzels, allowing about 15 minutes for shaping.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Dissolve the baking soda in the water, bring the solution to a simmer, and dip each pretzel briefly."
    },
    {
      "step": 6,
      "text": "Arrange the pretzels on a prepared baking sheet. Bake at 450°F until golden brown, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Brush the hot pretzels with melted butter and sprinkle with coarse sea salt."
    }
  ],
