  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and line a baking sheet. Melt the butter and let it cool slightly."
    },
    {
      "step": 2,
      "text": "Whisk the melted butter with the brown sugar, caster sugar, egg, and vanilla until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the flour, oats, baking powder, and bicarbonate of soda until a dough forms, then fold in the chopped chocolate."
    },
    {
      "step": 4,
      "text": "Shape the dough into portions and place them on the prepared sheet, leaving space between each."
    },
    {
      "step": 5,
      "text": "Bake for about 10 minutes, until the edges are set and the center reaches 160°F on a food thermometer.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Leave the cookies on the sheet for 2 minutes, then transfer them to a rack to cool.",
      "timer_minutes": 2
    }
  ],
