  "id": "chocolate-chip-oat-cookies",
  "name": "Chocolate Chip Oat Cookies",
  "subtitle": "Chewy oat cookies with chopped chocolate",
  "description": "A simple batch of buttery oat cookies with brown sugar, vanilla, and chopped chocolate.",
  "meal_type": "drink",
