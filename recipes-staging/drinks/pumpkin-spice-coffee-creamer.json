      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 14,
      "unit": "ounces",
      "preparation": "divided"
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "pumpkin-puree",
      "item": "pumpkin puree",
      "quantity": 3,
