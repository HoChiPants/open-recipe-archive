  "id": "pumpkin-spice-coffee-creamer",
  "name": "Pumpkin Spice Coffee Creamer",
  "subtitle": "A maple-sweetened creamer with warm pumpkin spice flavor",
  "description": "Make a smooth homemade creamer for stirring into hot or iced coffee.",
  "meal_type": "drink",
  "cuisine": "American",
