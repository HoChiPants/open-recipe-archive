  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk maple syrup, pumpkin puree, pumpkin pie spice, vanilla, and half of the cream in a microwave-safe bowl until blended."
    },
    {
      "step": 2,
      "text": "Microwave the mixture for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir in the remaining cream and sweetened condensed milk until smooth and uniform."
    },
    {
      "step": 4,
      "text": "Pour into a container and use in coffee as desired."
    }
  ],
