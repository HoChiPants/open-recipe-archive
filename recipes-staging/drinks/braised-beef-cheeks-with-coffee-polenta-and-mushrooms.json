  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 325°F. Warm the beef stock separately. Heat the oil in a large ovenproof pot."
    },
    {
      "step": 2,
      "text": "Dust the beef cheeks with flour, then brown them in the hot oil on all sides. Transfer them to a plate."
    },
    {
      "step": 3,
      "text": "Add the carrots and onion to the pot and cook until softened. Return the beef to the pot, add the bay leaves, pour in the ale and stock, and bring to a simmer."
    },
    {
      "step": 4,
      "text": "Cover and braise for 3 hours, or until very tender. Check that the thickest part reaches at least 145°F; rest the beef for 3 minutes before serving.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Cool the beef briefly, then reheat it gently in the braising liquid while finishing the accompaniments."
    },
    {
      "step": 6,
      "text": "Bring the milk to a simmer, whisk in the polenta, and cook, stirring, for 5 minutes or until thick and smooth. Stir in the coffee and butter.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Melt some of the butter in a skillet. Add the mushrooms and garlic, and cook for 5 minutes. Stir in the parsley.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Slice or portion the beef cheeks and serve over the polenta with the mushrooms and braising liquid."
    }
  ],
