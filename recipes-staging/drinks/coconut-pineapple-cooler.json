  "id": "coconut-pineapple-cooler",
  "name": "Coconut Pineapple Cooler",
  "subtitle": "A chilled tropical drink with rum, gin, pineapple, watermelon, and coriander.",
  "description": "Combine the spirits and pineapple juice, then portion the mixture with watermelon and coriander into jars for serving over ice.",
  "meal_type": "drink",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "coconut-rum",
      "item": "coconut rum",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "pineapple-juice-not-from-concentrate",
      "item": "pineapple juice (not from concentrate)",
      "quantity": 600,
      "unit": "ml"
    },
    {
      "ingredient_id": "gin",
      "item": "gin",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "chunks-watermelon",
      "item": "chunks watermelon",
      "quantity": 6,
      "unit": "small"
    },
    {
      "ingredient_id": "coriander-sprigs",
      "item": "coriander sprigs",
      "quantity": 12
    },
    {
      "ingredient_id": "x-324ml-screw-top-jam-jars-with-lids",
      "item": "x 324ml screw-top jam jars with lids",
      "quantity": 6
    },
    {
      "ingredient_id": "ice-bucket-filled-with-ice",
      "item": "ice bucket filled with ice"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir together the coconut rum, pineapple juice, and gin."
    },
    {
      "step": 2,
      "text": "Divide the watermelon and coriander sprigs among the jars. Pour in the drink mixture, secure the lids, and place the jars in the ice-filled bucket."
    },
    {
      "step": 3,
      "text": "Chill until set and thoroughly cold, about 6 hours.",
      "timer_minutes": 360
    }
  ],
