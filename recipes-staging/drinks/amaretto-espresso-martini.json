  "id": "amaretto-espresso-martini",
  "name": "Amaretto Espresso Martini",
  "subtitle": "A chilled coffee cocktail with almond liqueur",
  "description": "Shake freshly brewed espresso with vodka, amaretto, sweetener, and ice, then strain for a cold, smooth drink.",
  "meal_type": "drink",
  "yield": {
    "quantity": 2,
