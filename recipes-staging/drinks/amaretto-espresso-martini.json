  "instructions": [
    {
      "step": 1,
      "text": "Add the espresso, vodka, amaretto, and sugar syrup or honey to a cocktail shaker."
    },
    {
      "step": 2,
      "text": "Fill the shaker with ice, seal it, and shake vigorously until well chilled."
    },
    {
      "step": 3,
      "text": "Strain into two chilled martini glasses and serve immediately."
    }
