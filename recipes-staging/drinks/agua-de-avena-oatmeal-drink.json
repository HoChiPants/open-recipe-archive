  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 8,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "quick-cooking-oats",
      "item": "quick-cooking oats",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "cinnamon-stick",
      "item": "cinnamon stick",
      "quantity": 1
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the oats, cinnamon stick, and half of the water in a blender."
    },
    {
      "step": 2,
      "text": "Blend for 1 minute, until combined.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Pour the blended mixture into a pitcher and stir in the remaining water, sugar, and vanilla extract."
    },
    {
      "step": 4,
      "text": "Cover and refrigerate until thoroughly chilled.",
      "timer_minutes": 60
    }
  ],
