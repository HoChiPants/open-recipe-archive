  "id": "agua-de-avena-oatmeal-drink",
  "name": "Agua de Avena (Oatmeal Drink)",
  "subtitle": "A chilled cinnamon-vanilla oat beverage",
  "description": "Blend oats with cinnamon, sweeten with sugar and vanilla, then chill for a refreshing Mexican drink.",
  "meal_type": "drink",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
