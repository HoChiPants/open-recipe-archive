      "item": "sparkling water to top up"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the clementine into pieces and place them in a serving glass with the chopped lemon wedge and demerara sugar."
    },
    {
      "step": 2,
      "text": "Stir gently to release the citrus juices and begin dissolving the sugar."
    },
    {
      "step": 3,
      "text": "Add the mint and orange blossom water, then fill the glass with ice."
    },
    {
      "step": 4,
      "text": "Top with sparkling water and stir briefly before serving."
    }
  ],
