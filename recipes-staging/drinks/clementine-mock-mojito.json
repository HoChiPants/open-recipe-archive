  "id": "clementine-mock-mojito",
  "name": "Clementine Mock Mojito",
  "subtitle": "A bright citrus spritz with mint and floral notes",
  "description": "Clementine, lemon, mint, and orange blossom water combine with sparkling water for a refreshing alcohol-free drink.",
  "meal_type": "drink",
