{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-sprinkle-crinkle-biscuits",
  "name": "Chocolate Sprinkle-Crinkle Biscuits",
  "subtitle": "Small chocolate biscuits with a crisp, colorful coating",
  "description": "Rich cocoa biscuits rolled in sprinkles and baked until firm at the edges.",
  "meal_type": "drink",
  "yield": {
    "quantity": 35,
    "unit": "mini biscuits"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cocoa-powder-sieved",
      "item": "cocoa powder sieved",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 60,
      "unit": "ml"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 180,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "tub-sprinkles",
      "item": "tub sprinkles",
      "quantity": 1,
      "unit": "small"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the sieved cocoa powder and caster sugar. Whisk in the vegetable oil and eggs until combined."
    },
    {
      "step": 2,
      "text": "Combine the plain flour and baking powder, then mix them into the cocoa mixture to form a dough."
    },
    {
      "step": 3,
      "text": "Transfer the dough to the refrigerator and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Preheat the oven and prepare baking trays. Place the sprinkles in a shallow dish."
    },
    {
      "step": 5,
      "text": "Shape the dough into small balls and roll each one in the sprinkles. Arrange them on the prepared trays with space between them."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, until the biscuits are firm.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Let the biscuits cool on the trays briefly, then transfer them to a rack to finish cooling."
    }
  ],
