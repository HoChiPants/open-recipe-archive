  "instructions": [
    {
      "step": 1,
      "text": "Combine smoked paprika, black pepper, white pepper, garlic powder, onion powder, oregano, thyme, and cayenne pepper in a bowl."
    },
    {
      "step": 2,
      "text": "Mix mayonnaise, tomato ketchup, capers, and gherkins with the buttermilk. If using the stated substitute, mix the same amount of yogurt with the juice of 1/2 lemon first, then use it in the sauce. Chill for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Whisk the plain flour, cornmeal or polenta, and baking powder together in a shallow dish."
    },
    {
      "step": 4,
      "text": "Coat the defrosted prawns with buttermilk, then dredge them in the flour mixture and Cajun seasoning."
    },
    {
      "step": 5,
      "text": "Heat vegetable oil for frying in a skillet over medium-high heat. Fry the prawns for about 5 minutes, turning as needed, until opaque and fully cooked.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Transfer the prawns to a plate. Divide the shredded lettuce and sliced avocado among four serving glasses or bowls."
    },
    {
      "step": 7,
      "text": "Top with the fried prawns and spoon over the chilled sauce. Garnish with chopped chives and serve."
    }
  ],
