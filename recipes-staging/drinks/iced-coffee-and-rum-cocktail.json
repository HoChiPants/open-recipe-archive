  "id": "iced-coffee-and-rum-cocktail",
  "name": "Iced Coffee and Rum Cocktail",
  "subtitle": "A creamy, lightly sweetened coffee drink with rum",
  "description": "Chill strong coffee with coffee liqueur, rum, and sugar over ice, then finish with lightly whipped cream and a coffee bean.",
  "meal_type": "drink",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "strong-black-coffee",
      "item": "strong black coffee",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "coffee-liqueur",
      "item": "coffee liqueur",
      "quantity": 25,
      "unit": "ml"
    },
    {
      "ingredient_id": "dark-rum",
      "item": "dark rum",
      "quantity": 25,
      "unit": "ml"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "ice",
      "item": "ice"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 25,
      "unit": "ml"
    },
    {
      "ingredient_id": "coffee-bean",
      "item": "coffee bean",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour the coffee, coffee liqueur, and dark rum into a glass or shaker. Add the sugar and stir until dissolved."
    },
    {
      "step": 2,
      "text": "Add ice and stir or shake briefly until the drink is well chilled."
    },
    {
      "step": 3,
      "text": "Whisk the double cream until lightly thickened but still pourable."
    },
    {
      "step": 4,
      "text": "Pour the chilled coffee mixture into a serving glass and float the cream over the top."
    },
    {
      "step": 5,
      "text": "Garnish with the coffee bean and serve immediately."
    }
  ],
