  "id": "brandy-sour",
  "name": "Brandy Sour",
  "subtitle": "A tart, bittersweet brandy cocktail with a silky finish",
  "description": "Shake brandy with lemon, cherry syrup, bitters, egg white, and ice, then strain and garnish for a balanced sour drink.",
  "meal_type": "drink",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
