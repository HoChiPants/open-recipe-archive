      "item": "ice"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the lemon juice, cherry and syrup, bitters, egg white, and brandy. For food safety, use a thermometer to bring the egg-containing mixture to 160°F, then cool it promptly before shaking."
    },
    {
      "step": 2,
      "text": "Shake the mixture without ice, then add ice and shake again until chilled."
    },
    {
      "step": 3,
      "text": "Strain into a serving glass and garnish with the lemon slice and cherry."
    }
  ],
