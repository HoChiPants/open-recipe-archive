    {
      "ingredient_id": "lemon-juice-plus-1-lemon-slice-to-serve",
      "item": "lemon juice plus 1 lemon slice to serve",
      "quantity": 25,
      "unit": "ml"
    },
    {
      "ingredient_id": "maraschino-cherry-plus-15ml-syrup-from-the-jar",
      "item": "maraschino cherry plus 15ml syrup from the jar",
      "quantity": 1
    },
    {
      "ingredient_id": "few-drops-of-bitters",
      "item": "few drops of bitters"
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": "1/2"
    },
    {
