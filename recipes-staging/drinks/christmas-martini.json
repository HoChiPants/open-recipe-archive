{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "christmas-martini",
  "name": "Christmas Martini",
  "subtitle": "A bourbon cocktail with cherry and spiced fruit syrup",
  "description": "Bourbon and cherry brandy are chilled with ice, then finished with a warm dried-fruit syrup flavored with cinnamon.",
  "meal_type": "drink",
  "yield": {
    "quantity": 1,
    "unit": "(with leftover syrup)"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 3
  },
  "ingredients": [
    {
      "ingredient_id": "bourbon",
      "item": "bourbon",
      "quantity": 50,
      "unit": "ml"
    },
    {
      "ingredient_id": "cherry-brandy",
      "item": "cherry brandy",
      "quantity": 25,
      "unit": "ml"
    },
    {
      "ingredient_id": "ice",
      "item": "ice"
    },
    {
      "ingredient_id": "dark-brown-soft-sugar",
      "item": "dark brown soft sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "mixed-dried-fruit",
      "item": "mixed dried fruit",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "cinnamon-stick",
      "item": "cinnamon stick",
      "quantity": "1/2"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the dark brown soft sugar and mixed dried fruit in a small saucepan over low heat, stirring until the sugar begins to soften.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Add the cinnamon stick and continue warming gently until the fruit mixture becomes syrupy. Remove from the heat."
    },
    {
      "step": 3,
      "text": "Fill a cocktail shaker with ice. Add the bourbon and cherry brandy, then shake until well chilled."
    },
    {
      "step": 4,
      "text": "Strain into a chilled martini glass and finish with a small spoonful of the fruit syrup."
    }
  ],
