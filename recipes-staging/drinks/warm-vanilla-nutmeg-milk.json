  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a small saucepan over low heat for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Stir the milk, vanilla extract, and white sugar together in the saucepan."
    },
    {
      "step": 3,
      "text": "Warm gently for 2 minutes, stirring occasionally; do not boil.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the ground nutmeg and serve warm."
    }
