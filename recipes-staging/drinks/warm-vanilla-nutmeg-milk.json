  "id": "warm-vanilla-nutmeg-milk",
  "name": "Warm Vanilla Nutmeg Milk",
  "subtitle": "A gently spiced warm milk drink",
  "description": "Milk sweetened with sugar, flavored with vanilla, and finished with nutmeg.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
