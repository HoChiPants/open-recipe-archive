  "id": "pumpkin-spice-latte",
  "name": "Pumpkin Spice Latte",
  "subtitle": "Warm espresso with spiced pumpkin milk",
  "description": "A single-serving latte combining brewed espresso with gently heated pumpkin-spiced milk.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "canned-pumpkin-puree",
      "item": "canned pumpkin puree",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "pumpkin-pie-spice",
      "item": "pumpkin pie spice",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "1-5-fluid-ounce-jigger-brewed-espresso",
      "item": "(1.5 fluid ounce) jigger brewed espresso",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the milk, pumpkin puree, sugar, vanilla extract, and pumpkin pie spice in a small saucepan until smooth."
    },
    {
      "step": 2,
      "text": "Warm the milk mixture over medium heat, whisking occasionally, until hot and lightly steaming; do not boil.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Pour the brewed espresso into a serving cup."
    },
    {
      "step": 4,
      "text": "Add the hot pumpkin milk mixture and stir to combine."
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
