      "quantity": 2,
      "unit": "pounds"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cola, soy sauce, mustard, horseradish, garlic, and black pepper together in a container large enough for the steak."
    },
    {
      "step": 2,
      "text": "Add the steak and turn to coat it thoroughly. Cover and refrigerate for 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 3,
      "text": "Heat the grill to 400°F. Remove the steak from the marinade and discard the marinade."
    },
    {
      "step": 4,
      "text": "Grill the steak for about 5 minutes per side, or until a thermometer inserted into the thickest part reads at least 145°F.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Transfer the steak to a plate and let it rest for 3 minutes before slicing.",
      "timer_minutes": 3
    }
  ],
