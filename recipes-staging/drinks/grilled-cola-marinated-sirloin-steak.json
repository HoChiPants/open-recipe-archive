  "id": "grilled-cola-marinated-sirloin-steak",
  "name": "Grilled Cola-Marinated Sirloin Steak",
  "subtitle": "Savory, tangy steak with a cola-based marinade",
  "description": "Sirloin steak marinates overnight in a sweet-savory mixture, then grills quickly for a flavorful finish.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
