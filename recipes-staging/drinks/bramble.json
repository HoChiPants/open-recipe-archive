  "instructions": [
    {
      "step": 1,
      "text": "Combine the gin, lemon juice, sugar syrup, and ice cubes in a shaker."
    },
    {
      "step": 2,
      "text": "Shake until chilled, then strain into a glass filled with the crushed ice."
    },
    {
      "step": 3,
      "text": "Pour the crème de mure over the drink and garnish with the lemon slice and a blackberry (if in season) to serve."
    }
  ],
