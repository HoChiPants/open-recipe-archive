  "id": "bramble",
  "name": "Bramble",
  "subtitle": "A bright gin cocktail with lemon and blackberry liqueur",
  "description": "Shake gin, lemon juice, and sugar syrup with ice, then pour over crushed ice and finish with crème de mure and a simple garnish.",
  "meal_type": "drink",
