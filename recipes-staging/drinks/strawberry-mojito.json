  "id": "strawberry-mojito",
  "name": "Strawberry Mojito",
  "subtitle": "A bright rum cocktail with fresh berries, mint, and lime",
  "description": "Rim glasses with sugar, then mix muddled strawberries, lime, mint, and sugar with rum and club soda. Serve over ice.",
  "meal_type": "drink",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "preparation": "for rimming"
    },
    {
      "ingredient_id": "limes",
      "item": "limes",
      "quantity": 2,
      "unit": "large",
      "preparation": "quartered"
    },
    {
      "ingredient_id": "bunch-mint-leaves",
      "item": "bunch mint leaves",
      "quantity": 0.5
    },
    {
      "ingredient_id": "strawberry",
      "item": "strawberries",
      "quantity": 7,
      "preparation": "quartered"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "club-soda",
      "item": "club soda",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "white-rum",
      "item": "white rum",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ice-cubes",
      "item": "ice cubes",
      "quantity": 8,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Spread the rimming sugar on a shallow plate. Moisten the glass rims with a lime wedge and coat them in the sugar."
    },
    {
      "step": 2,
      "text": "Divide the quartered limes, mint leaves, strawberries, and measured sugar among a pitcher or large bowl. Gently muddle until the fruit releases juice and the mint is fragrant."
    },
    {
      "step": 3,
      "text": "Stir in the white rum and club soda until the sugar is mostly dissolved."
    },
    {
      "step": 4,
      "text": "Fill the prepared glasses with ice, pour in the mojito mixture, and serve immediately."
    }
  ],
