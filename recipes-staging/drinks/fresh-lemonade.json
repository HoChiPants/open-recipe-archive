  "instructions": [
    {
      "step": 1,
      "text": "Juice the lemons and set the juice aside."
    },
    {
      "step": 2,
      "text": "Combine the sugar with enough of the cold water to dissolve it in a saucepan. Heat, stirring, for 5 minutes, then transfer the syrup to a heatproof container and cool for 30 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir the lemon juice, cooled syrup, and remaining cold water together."
    },
    {
      "step": 4,
      "text": "Chill the lemonade for 2 hours, then stir and serve.",
      "timer_minutes": 120
    }
