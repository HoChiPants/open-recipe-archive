  "instructions": [
    {
      "step": 1,
      "text": "Chill the prosecco and l cloudy apple juice until cold."
    },
    {
      "step": 2,
      "text": "Place the red grapes in the freezer for 12 hours.",
      "timer_minutes": 720
    },
    {
      "step": 3,
      "text": "Combine the gin, herbal liqueur, stem ginger and syrup, rosemary, sliced clementine, and ice in a large punch bowl."
    },
    {
      "step": 4,
      "text": "Add the chilled l cloudy apple juice and prosecco, then stir gently. Add the chilled grapes and serve."
    }
