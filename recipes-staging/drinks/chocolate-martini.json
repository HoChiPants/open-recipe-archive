  "id": "chocolate-martini",
  "name": "Chocolate Martini",
  "subtitle": "A chilled chocolate cocktail with creamy liqueur and vodka",
  "description": "Combine melted chocolate, chocolate syrup, liqueurs, vodka, and ice for two smooth, chocolate-forward martinis.",
  "meal_type": "drink",
