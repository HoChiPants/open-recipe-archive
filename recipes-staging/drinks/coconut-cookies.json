{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "coconut-cookies",
  "name": "Coconut Cookies",
  "subtitle": "Crisp coconut cookies finished with dark chocolate",
  "description": "Buttery coconut cookies with toasted coconut throughout and a simple dark chocolate finish.",
  "meal_type": "drink",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-softened",
      "item": "unsalted butter softened",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "light-brown-soft-sugar",
      "item": "light brown soft sugar",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "vanilla-bean-paste",
      "item": "vanilla bean paste",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 275,
      "unit": "g"
    },
    {
      "ingredient_id": "desiccated-coconut-toasted-and-cooled",
      "item": "desiccated coconut toasted and cooled",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-chocolate",
      "item": "dark chocolate",
      "quantity": 100,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and line a baking tray."
    },
    {
      "step": 2,
      "text": "Whisk the softened butter with both sugars and the vanilla bean paste until combined. Beat in the egg, then mix in the flour. Fold through the toasted, cooled coconut."
    },
    {
      "step": 3,
      "text": "Shape the dough into 16 portions and arrange them on the prepared tray, leaving space between each."
    },
    {
      "step": 4,
      "text": "Bake for 15 minutes, until golden brown and the centers are set; if checking with a thermometer, the center should reach 160°F.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Transfer the cookies to a rack and let them cool."
    },
    {
      "step": 6,
      "text": "Melt the dark chocolate in the microwave in short intervals, stirring between each, until smooth."
    },
    {
      "step": 7,
      "text": "Decorate the cooled cookies with the melted chocolate and additional toasted coconut, then leave until set.",
      "timer_minutes": 30
    }
  ],
