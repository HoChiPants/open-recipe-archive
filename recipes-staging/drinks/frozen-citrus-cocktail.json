  "instructions": [
    {
      "step": 1,
      "text": "In a large freezer-safe container, combine the vodka, brandy, orange juice concentrate, lemonade concentrate, maraschino cherries, and grapefruit flavored soda."
    },
    {
      "step": 2,
      "text": "Freeze until slushy and firm, stirring or whisking once or twice as it freezes.",
      "timer_minutes": 1440
    },
    {
      "step": 3,
      "text": "Let the frozen mixture stand briefly until scoopable, then whisk until evenly slushy."
    },
    {
      "step": 4,
      "text": "Stir in the lemon-lime flavored carbonated beverage just before serving."
    }
