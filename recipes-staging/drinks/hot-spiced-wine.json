  "instructions": [
    {
      "step": 1,
      "text": "Prepare the oranges and set them aside."
    },
    {
      "step": 2,
      "text": "Combine the red wine, white wine, ginger, cinnamon sticks, ground cloves, and brown sugar in a large pot. Stir to dissolve the sugar."
    },
    {
      "step": 3,
      "text": "Heat the mixture to boiling, then remove it from the heat."
    },
    {
      "step": 4,
      "text": "Add the prepared oranges and brandy, stir gently, and serve warm."
    }
