  "id": "old-fashioned-mix",
  "name": "Old Fashioned Mix",
  "subtitle": "A citrus-and-spice syrup for classic cocktails",
  "description": "A sweet citrus syrup infused with cherries, cinnamon, and bitters for mixing into Old Fashioned-style drinks.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "clementine-oranges",
      "item": "clementine oranges",
      "quantity": 3,
      "preparation": "quartered"
    },
    {
      "ingredient_id": "maraschino-cherries",
      "item": "maraschino cherries",
      "quantity": 5,
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "cinnamon-stick",
      "item": "cinnamon stick",
      "quantity": 1
    },
    {
      "ingredient_id": "bitters",
      "item": "bitters",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the water and sugar in a saucepan and simmer, stirring, until the sugar dissolves."
    },
    {
      "step": 2,
      "text": "Stir in the quartered clementines, cherries, and cinnamon stick. Remove from the heat and let the mixture steep for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Remove the cinnamon stick and stir in the bitters."
    },
    {
      "step": 4,
      "text": "Strain the mixture into a clean container and chill before using."
    }
  ],
