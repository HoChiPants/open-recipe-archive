  "id": "mint-simple-syrup",
  "name": "Mint Simple Syrup",
  "subtitle": "A cool, mint-infused sweetener for drinks and desserts",
  "description": "Steep fresh mint in a warm sugar syrup, then strain and chill for cocktails, iced tea, lemonade, or desserts.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
