    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-mint-leaves",
      "item": "fresh mint leaves",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the water, sugar, and mint leaves in a saucepan and warm over medium heat, stirring until the sugar dissolves."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a gentle simmer for 1 minute, then remove it from the heat.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Strain the syrup into a clean heatproof container, pressing the mint lightly before discarding it."
    },
    {
      "step": 4,
      "text": "Let the syrup cool, then cover and refrigerate for 30 minutes before using.",
      "timer_minutes": 30
    }
  ],
