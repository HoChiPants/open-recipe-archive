  "id": "cranberry-gin-fizz",
  "name": "Cranberry Gin Fizz",
  "subtitle": "Tart cranberry, gin, and sparkling citrus",
  "description": "A bright, lightly sweet sparkling drink made with cooked cranberries, gin, soda water, orange, and ice.",
  "meal_type": "drink",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "gin",
      "item": "gin",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "fresh-or-frozen-cranberries",
      "item": "fresh or frozen cranberries",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "litres-soda-water",
      "item": "litres soda water",
      "quantity": 1.5
    },
    {
      "ingredient_id": "orange-cut-into-slices",
      "item": "orange cut into slices",
      "quantity": 1
    },
    {
      "ingredient_id": "handful-of-ice-cubes-optional",
      "item": "handful of ice cubes"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the cranberries with the caster sugar in a saucepan over medium heat for 15 minutes, stirring occasionally, until softened.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Cool the cranberry mixture, then blend or mash until smooth."
    },
    {
      "step": 3,
      "text": "Fill a large serving vessel with the ice cubes and orange slices."
    },
    {
      "step": 4,
      "text": "Stir in the gin and soda water, then add the cranberry mixture and combine evenly."
    },
    {
      "step": 5,
      "text": "Serve immediately."
    }
  ],
