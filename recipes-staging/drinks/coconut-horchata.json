  "id": "coconut-horchata",
  "name": "Coconut Horchata",
  "subtitle": "A chilled rice drink with coconut and almond flavor",
  "description": "Soaked rice, almonds, coconut, and milk are blended and diluted into a creamy, refreshing drink served over ice.",
  "meal_type": "drink",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
