    "inactive_minutes": 360
  },
  "ingredients": [
    {
      "ingredient_id": "uncooked-white-rice",
      "item": "uncooked white rice",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "almonds",
      "item": "almonds",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sweetened-flaked-coconut",
      "item": "sweetened flaked coconut",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "boiling-water",
      "item": "boiling water",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "coconut-milk",
      "item": "coconut milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "sweetened-condensed-milk",
      "item": "sweetened condensed milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 5,
      "unit": "cups",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "ice",
      "item": "ice",
      "quantity": 5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the rice, almonds, coconut, and coconut milk in a blender or large container. Add the boiling water and cold water, then stir until combined and the water has cooled slightly."
    },
    {
      "step": 2,
      "text": "Cover and refrigerate for 6 hours.",
      "timer_minutes": 360
    },
    {
      "step": 3,
      "text": "Blend the soaked mixture until as smooth as possible, then stir in the condensed milk."
    },
    {
      "step": 4,
      "text": "Stir in the remaining boiling water and cold water until evenly combined. Serve over the ice, adding more cold water as needed for the desired consistency."
    }
  ],
