  "instructions": [
    {
      "step": 1,
      "text": "Combine the chillies, maple syrup, cider vinegar, ginger, and sesame oil in a saucepan. Bring to a simmer and cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Preheat the oven and arrange the meat-free cocktail sausages in a baking dish. Coat them with the glaze, then sprinkle over the sesame seeds."
    },
    {
      "step": 3,
      "text": "Bake for 25 minutes, turning or basting once if needed, until cooked through and hot.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Transfer to a serving dish and finish with the reserved chilli, coriander leaves, and lime wedges."
    }
  ],
