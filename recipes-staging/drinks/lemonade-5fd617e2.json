  "instructions": [
    {
      "step": 1,
      "text": "Cut the lemons and squeeze them to prepare the juice; set the juice aside."
    },
    {
      "step": 2,
      "text": "Combine the white sugar and water in a saucepan. Heat, stirring, until the sugar dissolves, then continue cooking for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "Remove the sugar mixture from the heat and let it cool for 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Add the lemon juice to the cooled sugar mixture and stir well."
    }
