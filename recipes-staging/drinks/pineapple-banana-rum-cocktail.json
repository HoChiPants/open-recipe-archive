  "id": "pineapple-banana-rum-cocktail",
  "name": "Pineapple-Banana Rum Cocktail",
  "subtitle": "A chilled tropical cocktail with a grenadine finish",
  "description": "Shake rum, banana liqueur, pineapple juice, and ice, then add grenadine for a lightly layered finish.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
