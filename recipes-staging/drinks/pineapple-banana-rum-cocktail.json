  "instructions": [
    {
      "step": 1,
      "text": "Fill a cocktail shaker with ice. Add the Malibu rum, banana liqueur, and pineapple juice; shake until well chilled."
    },
    {
      "step": 2,
      "text": "Strain into two serving glasses over fresh ice, if desired."
    },
    {
      "step": 3,
      "text": "Divide the grenadine between the glasses and serve."
    }
