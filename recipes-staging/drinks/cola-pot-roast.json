  "id": "cola-pot-roast",
  "name": "Cola Pot Roast",
  "subtitle": "Tender beef roast with cola-simmered gravy",
  "description": "A savory beef roast cooked with vegetables and a rich mushroom-onion gravy, finished with cola for a rounded sweetness.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 300
  },
  "ingredients": [
    {
      "ingredient_id": "beef-sirloin-roast",
      "item": "beef sirloin roast",
      "quantity": 4,
      "unit": "pounds"
    },
    {
      "ingredient_id": "carrots",
      "item": "carrots",
      "quantity": 3,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "stalks-celery",
      "item": "stalks celery",
      "quantity": 3,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "minced"
    },
    {
      "ingredient_id": "dry-brown-gravy-mix",
      "item": "dry brown gravy mix",
      "quantity": 0.5,
      "unit": "packet",
      "preparation": ".75 ounce"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dry-onion-soup-mix",
      "item": "dry onion soup mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1 ounce"
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.75 ounce"
    },
    {
      "ingredient_id": "fluid-ounces-cola-flavored-carbonated-beverage",
      "item": "fluid ounces cola-flavored carbonated beverage",
      "quantity": 10
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Place the beef sirloin roast in a covered roasting pan and arrange the carrots, celery, and garlic around it."
    },
    {
      "step": 2,
      "text": "Stir the dry brown gravy mix with the water until smooth. In a separate bowl, combine the dry onion soup mix and condensed cream of mushroom soup."
    },
    {
      "step": 3,
      "text": "Pour both mixtures and the cola-flavored carbonated beverage over the roast. Cover the pan."
    },
    {
      "step": 4,
      "text": "Bake at 350°F for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "Reduce the oven temperature to 225°F and continue roasting until the total cooking time reaches about 5 hours and the roast is tender.",
      "timer_minutes": 240
    },
    {
      "step": 6,
      "text": "Check the thickest part of the roast with a food thermometer; whole-cut beef should reach 145°F. Rest for at least 3 minutes, then rest 10 minutes before slicing.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Serve the sliced roast with the vegetables and gravy."
    }
  ],
