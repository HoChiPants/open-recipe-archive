  "id": "blackberry-lemonade",
  "name": "Blackberry Lemonade",
  "subtitle": "A bright berry drink with fresh lemon juice",
  "description": "Make a simple syrup, blend it with blackberries, then combine with lemon juice, water, and ice for a refreshing drink.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 4.5,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "blackberries",
      "item": "blackberries",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "freshly-squeezed-lemon-juice",
      "item": "freshly squeezed lemon juice",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ice-cubes",
      "item": "ice cubes"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the white sugar and 1.5 cups of the water in a saucepan, stirring for 2 minutes until the sugar dissolves.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Remove from the heat and let the syrup cool."
    },
    {
      "step": 3,
      "text": "Blend the cooled syrup with the blackberries and 2 tablespoons white sugar until smooth."
    },
    {
      "step": 4,
      "text": "Combine the blackberry mixture with the remaining water and freshly squeezed lemon juice."
    },
    {
      "step": 5,
      "text": "Pour over ice cubes and serve."
    }
  ],
