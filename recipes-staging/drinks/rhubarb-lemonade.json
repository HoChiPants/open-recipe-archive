{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "rhubarb-lemonade",
  "name": "Rhubarb Lemonade",
  "subtitle": "Tart rhubarb syrup with bright lemon flavor",
  "description": "Simmer rhubarb with sugar, lemon peel, and lemon juice, then strain the cooked mixture into a smooth, tangy lemonade base.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "rhubarb",
      "item": "rhubarb",
      "quantity": 8,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "grated-lemon-peel",
      "item": "grated lemon peel",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the rhubarb, sugar, grated lemon peel, and lemon juice in a large saucepan."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a simmer over medium heat, then cook for 10 minutes, stirring occasionally, until the rhubarb is very soft.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Pour the mixture through a fine-mesh strainer into a heatproof bowl, pressing the rhubarb gently to extract the liquid."
    },
    {
      "step": 4,
      "text": "Cool the strained lemonade before serving."
    }
  ],
