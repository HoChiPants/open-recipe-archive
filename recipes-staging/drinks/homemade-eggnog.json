  "id": "homemade-eggnog",
  "name": "Homemade Eggnog",
  "subtitle": "Chilled custard-style eggnog with bourbon and whipped whites",
  "description": "A creamy American holiday drink made from a gently cooked egg-and-dairy base, bourbon, and softly whipped egg whites.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10,
    "inactive_minutes": 90
  },
  "ingredients": [
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 4
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "freshly-grated-nutmeg",
      "item": "freshly grated nutmeg",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fluid-ounces-bourbon-whiskey",
      "item": "fluid ounces bourbon whiskey",
      "quantity": 2,
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "egg-whites",
      "item": "egg whites",
      "quantity": 4
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "freshly-grated-nutmeg",
      "item": "freshly grated nutmeg",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the egg yolks in a bowl and whisk in the 0.33333334326744 cup white sugar until smooth."
    },
    {
      "step": 2,
      "text": "Warm the whole milk and heavy cream in a saucepan until steaming, then gradually whisk the hot dairy into the yolks."
    },
    {
      "step": 3,
      "text": "Return the mixture to the saucepan and cook over medium-low heat, whisking constantly, until a thermometer registers 180°F; ensure the egg mixture reaches at least 160°F."
    },
    {
      "step": 4,
      "text": "Remove from the heat and stir in the freshly grated nutmeg and fluid ounces bourbon whiskey. Cool briefly, then refrigerate until chilled.",
      "timer_minutes": 90
    },
    {
      "step": 5,
      "text": "Whisk the egg whites with 1 tablespoon white sugar until soft peaks form, then continue whisking until smooth and glossy."
    },
    {
      "step": 6,
      "text": "Fold the whipped whites into the chilled custard and refrigerate briefly to blend the texture.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "Pour into serving glasses and finish with the pinch of freshly grated nutmeg."
    }
  ],
