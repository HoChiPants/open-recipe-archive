  "id": "red-wine-sangria-kit",
  "name": "Red Wine Sangria Kit",
  "subtitle": "A fruit-ready Spanish drink kit for easy festive serving",
  "description": "Assemble the wine, brandy, spiced sugar, fruit, and sparkling mixer so the sangria can be finished and served with minimal preparation.",
  "meal_type": "drink",
  "cuisine": "spanish",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "red-wine",
      "item": "red wine",
      "quantity": 750,
      "unit": "ml"
    },
    {
      "ingredient_id": "spanish-brandy",
      "item": "Spanish brandy",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "mixed-spice",
      "item": "mixed spice",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "sparkling-water-or-lemonade",
      "item": "sparkling water or lemonade",
      "quantity": "250-300",
      "unit": "ml"
    },
    {
      "ingredient_id": "litre-screwtop-or-flip-top-bottle",
      "item": "litre screwtop or flip-top bottle",
      "quantity": 1
    },
    {
      "ingredient_id": "spice-jar-or-tin",
      "item": "spice jar or tin",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "apple",
      "item": "apple",
      "quantity": 1
    },
    {
      "ingredient_id": "clementines",
      "item": "clementines",
      "quantity": 3
    },
    {
      "ingredient_id": "pomegranate-or-a-small-pack-of-prepared-pomegranate-seeds",
      "item": "pomegranate or a small pack of prepared pomegranate seeds",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour the red wine and Spanish brandy into the litre screwtop or flip-top bottle."
    },
    {
      "step": 2,
      "text": "Put the golden caster sugar and mixed spice into the small spice jar or tin, close it, and shake to combine."
    },
    {
      "step": 3,
      "text": "Pack the apple and clementines with the spice mixture, keeping the fruit whole for later preparation."
    },
    {
      "step": 4,
      "text": "Chill the sparkling water or lemonade separately for at least 1 hour.",
      "timer_minutes": 60
    },
    {
      "step": 5,
      "text": "To serve, prepare the fruit, add it and the spice mixture to the wine mixture, then stir in the pomegranate or prepared pomegranate seeds and the chilled sparkling water or lemonade."
    }
  ],
