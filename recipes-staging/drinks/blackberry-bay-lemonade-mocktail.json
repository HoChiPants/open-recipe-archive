  "id": "blackberry-bay-lemonade-mocktail",
  "name": "Blackberry Bay Lemonade Mocktail",
  "subtitle": "A sparkling blackberry drink with bay-leaf syrup and bright lemon.",
  "description": "Blend ripe blackberries until smooth, combine them with a lightly infused bay-leaf mixture, and finish with sparkling water, lemon, and playful fruit-and-olive garnishes.",
  "meal_type": "drink",
