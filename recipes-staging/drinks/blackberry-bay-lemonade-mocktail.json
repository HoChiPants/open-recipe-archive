  "instructions": [
    {
      "step": 1,
      "text": "Combine the bay leaves, sugar, and sparkling water in a saucepan. Heat gently for 7 minutes, stirring until the sugar dissolves and the bay flavor infuses.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Cut the lemon into wedges. Blend the blackberries until smooth."
    },
    {
      "step": 3,
      "text": "Divide the blackberry purée among four glasses, add the infused mixture, and stir. Garnish with lemon, lychees, and green olives."
    }
