  "instructions": [
    {
      "step": 1,
      "text": "Heat the milk until boiling, then remove from the heat. Add the cold butter cut into cubes and 2 tablespoons of light brown soft sugar; whisk until melted. Cool until warm, not hot.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Put the strong white bread flour plus extra for dusting in a large bowl. Stir in the sachet fast-action dried yeast and the remaining 2 tablespoons of light brown soft sugar."
    },
    {
      "step": 3,
      "text": "Pour in the warm milk mixture and combine to make a dough. Knead for 10 minutes, then place in an oiled bowl, cover, and leave to rise for 30 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "Cook the eating apples peeled with the knob of butter and 2 tablespoons of light brown soft sugar for 10 minutes, until tender. Cool completely.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Mix the butter softened with the light brown soft sugar, vanilla extract, and cinnamon to make the filling. Beat the soft cheese with the icing sugar and pinch of cinnamon for the topping; chill both mixtures if needed."
    },
    {
      "step": 6,
      "text": "Roll the dough on a floured surface into a rectangle. Spread with the cinnamon filling and distribute the cooled apples over it."
    },
    {
      "step": 7,
      "text": "Roll the dough up from one long side and cut it into 12 pieces. Arrange the buns in a greased baking dish, cover, and leave to rise for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 8,
      "text": "Heat the oven to 350°F. Bake the buns for about 40 minutes, until risen and golden. Cool in the dish for 25 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 9,
      "text": "Spread or drizzle with the soft-cheese topping, then finish with the canned caramel and an extra splash of milk if needed to loosen it."
    }
  ],
