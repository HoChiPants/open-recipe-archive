    "cook_minutes": 10,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "cloves",
      "item": "cloves",
      "quantity": 15,
      "unit": "whole"
    },
    {
      "ingredient_id": "cinnamon-sticks",
      "item": "cinnamon sticks",
      "quantity": 3
    },
    {
      "ingredient_id": "1-4-inch-thick-slices-unpeeled-fresh-ginger",
      "item": "(1/4 inch thick) slices unpeeled fresh ginger",
      "quantity": 8
    },
    {
      "ingredient_id": "cardamom-pods",
      "item": "cardamom pods",
      "quantity": 15,
      "preparation": "split"
    },
    {
      "ingredient_id": "black-peppercorns",
      "item": "black peppercorns",
      "quantity": 15,
      "unit": "whole"
    },
    {
