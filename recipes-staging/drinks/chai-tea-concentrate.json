  "id": "chai-tea-concentrate",
  "name": "Chai Tea Concentrate",
  "subtitle": "Spiced black tea syrup for warm or iced drinks",
  "description": "A fragrant concentrate of black tea, whole spices, ginger, vanilla, and brown sugar. Steep it ahead, then dilute to taste with hot or cold milk or water.",
  "meal_type": "drink",
  "cuisine": "Indian Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
