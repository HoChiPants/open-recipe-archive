      "item": "brown sugar",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 2,
      "unit": "teaspoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring the water to a simmer in a saucepan. Add the cloves and simmer for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Add the cinnamon, ginger, split cardamom pods, and peppercorns. Continue simmering for 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Remove the saucepan from the heat, add the tea bags, and steep until the tea is strong."
    },
    {
      "step": 4,
      "text": "Remove the tea bags and strain out the spices. Stir in the brown sugar and vanilla extract until dissolved."
    },
    {
      "step": 5,
      "text": "Cool, cover, and refrigerate for 60 minutes before using.",
      "timer_minutes": 60
    }
  ],
