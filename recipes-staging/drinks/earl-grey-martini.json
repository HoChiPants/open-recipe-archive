  "ingredients": [
    {
      "ingredient_id": "earl-grey-tea-leaves",
      "item": "Earl Grey tea leaves",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "1-5-fluid-ounce-jiggers-gin",
      "item": "(1.5 fluid ounce) jiggers gin",
      "quantity": 2
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "preparation": "for rimming"
    },
