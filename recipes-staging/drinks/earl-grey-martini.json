    {
      "ingredient_id": "fluid-ounces-simple-syrup",
      "item": "fluid ounces simple syrup",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the Earl Grey tea leaves with the gin and let the mixture infuse for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Spread the white sugar on a small plate. Moisten the rims of two glasses with the lemon wedge, then dip them in the sugar."
    },
    {
      "step": 3,
      "text": "Strain the infused gin into a shaker and add the fresh lemon juice and simple syrup. Shake with ice until chilled."
    },
    {
      "step": 4,
      "text": "Strain into the prepared glasses and serve."
    }
  ],
