  "id": "earl-grey-martini",
  "name": "Earl Grey Martini",
  "subtitle": "Gin cocktail with tea and lemon",
  "description": "Tea-infused gin combines with lemon juice and simple syrup in a sugar-rimmed glass.",
  "meal_type": "drink",
  "cuisine": "American",
