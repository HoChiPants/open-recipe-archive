  "instructions": [
    {
      "step": 1,
      "text": "Blend the ginger chunks with the first measure of water until thick. Strain the mixture, pressing the solids to extract the ginger juice."
    },
    {
      "step": 2,
      "text": "Stir the ginger juice with the lemon juice and sugar until the sugar dissolves."
    },
    {
      "step": 3,
      "text": "Add the remaining water and crushed mint, adjusting the water as needed for a pourable drink. Serve chilled or over ice."
    }
