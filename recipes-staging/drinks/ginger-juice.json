  "id": "ginger-juice",
  "name": "Ginger Juice",
  "subtitle": "A bright ginger drink with lemon and mint",
  "description": "Blend fresh ginger with water, strain it, and balance the concentrated juice with lemon, sugar, mint, and additional water.",
  "meal_type": "drink",
