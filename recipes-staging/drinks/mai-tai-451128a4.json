  "instructions": [
    {
      "step": 1,
      "text": "Combine the almond flavored syrup, simple syrup, and fresh orange juice in a large pitcher or beverage container."
    },
    {
      "step": 2,
      "text": "Stir in the orange curacao, light rum, dark rum, 151 proof rum, and juice from the limes."
    },
    {
      "step": 3,
      "text": "Mix thoroughly and serve chilled."
    }
