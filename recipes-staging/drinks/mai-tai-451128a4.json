  "name": "Mai Tai",
  "subtitle": "A bright, rum-based citrus cocktail for a crowd",
  "description": "This large-format Mai Tai combines three rums with orange liqueur, almond syrup, simple syrup, lime, and orange juice.",
  "meal_type": "drink",
