  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-crinkle-biscuits",
  "name": "Chocolate Crinkle Biscuits",
  "subtitle": "Soft-centered cocoa biscuits with a sugar-crackled finish",
  "description": "Rich cocoa biscuits rolled in sugar before baking for a fudgy center and crinkled exterior.",
  "meal_type": "drink",
  "yield": {
    "quantity": 35,
    "unit": "mini biscuits"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cocoa-powder-sieved",
      "item": "cocoa powder sieved",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 60,
      "unit": "ml"
    },
    {
      "ingredient_id": "egg",
      "item": "eggs",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 180,
      "unit": "g"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 70,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the cocoa powder, caster sugar, and icing sugar. Add the oil and eggs, then stir until combined."
    },
    {
      "step": 2,
      "text": "Sift together the flour and baking powder, and mix them into the cocoa mixture until a dough forms."
    },
    {
      "step": 3,
      "text": "Cover and chill the dough for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Heat the oven to 350°F (175°C) and prepare a baking tray."
    },
    {
      "step": 5,
      "text": "Place caster sugar and icing sugar in separate shallow dishes. Shape the dough into small balls and roll each first in caster sugar, then in icing sugar."
    },
    {
      "step": 6,
      "text": "Arrange the coated balls on the tray with space between them. Bake for 10 minutes, until firm at the edges and set in the center.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Transfer the biscuits to a rack and let them cool before serving."
    }
  ],
