  "instructions": [
    {
      "step": 1,
      "text": "Fill a cocktail shaker with ice. Add the cherry vodka or kirsch, cherry or pomegranate juice, lime juice, honey, and red food colouring gel."
    },
    {
      "step": 2,
      "text": "Shake vigorously until the honey is dissolved and the mixture is chilled."
    },
    {
      "step": 3,
      "text": "Strain into two serving glasses and serve immediately."
    }
