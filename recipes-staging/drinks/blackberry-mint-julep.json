  "id": "blackberry-mint-julep",
  "name": "Blackberry Mint Julep",
  "subtitle": "A berry-forward bourbon cocktail with fresh mint",
  "description": "Muddled blackberries and mint balance bourbon and honey, then meet plenty of ice for a cool, refreshing julep.",
  "meal_type": "drink",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "blackberries",
      "item": "blackberries",
      "quantity": 80,
      "unit": "g"
    },
    {
      "ingredient_id": "mint-leaves-plus-1-sprig-to-serve",
      "item": "mint leaves plus 1 sprig to serve",
      "quantity": 10
    },
    {
      "ingredient_id": "bourbon",
      "item": "bourbon",
      "quantity": 70,
      "unit": "ml"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "ice-cubes-and-crushed-ice",
      "item": "ice cubes and crushed ice"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the blackberries and mint leaves in a glass or cocktail shaker and muddle until the berries are broken down and the mint is fragrant."
    },
    {
      "step": 2,
      "text": "Add the bourbon, honey, and a handful of ice cubes. Stir or shake until the honey is incorporated and the mixture is chilled."
    },
    {
      "step": 3,
      "text": "Fill a serving glass with crushed ice and pour in the cocktail."
    },
    {
      "step": 4,
      "text": "Garnish with the reserved mint sprig and serve immediately."
    }
  ],
