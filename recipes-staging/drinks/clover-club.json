  "id": "clover-club",
  "name": "Clover Club",
  "subtitle": "A tart raspberry gin cocktail with a smooth foam",
  "description": "Shake gin, vermouth, raspberries, raspberry cordial, lemon, and egg white into a frothy cocktail, then garnish and serve cold.",
  "meal_type": "drink",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
