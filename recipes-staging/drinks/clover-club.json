    {
      "ingredient_id": "raspberries-and-a-mint-sprig-skewered-on-a-cocktail-stick",
      "item": "raspberries and a mint sprig skewered on a cocktail stick",
      "quantity": 3
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "For safety, use egg white pasteurized to 160°F, then cool it before mixing."
    },
    {
      "step": 2,
      "text": "Add the gin, dry vermouth, raspberries, raspberry cordial, lemon juice, and egg white to a shaker. Shake without ice for 2 minutes to build foam.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the ice and shake until the shaker is thoroughly chilled."
    },
    {
      "step": 4,
      "text": "Strain into a chilled glass and garnish with the raspberries and mint sprig on the cocktail stick."
    }
  ],
