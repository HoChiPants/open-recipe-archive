  "id": "strawberry-soda-syrup",
  "name": "Strawberry Soda Syrup",
  "subtitle": "A bright fruit syrup for sparkling drinks",
  "description": "Fresh strawberries simmer into a concentrated syrup that can be mixed with chilled soda or other drinks.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "very-ripe-strawberries",
      "item": "very ripe strawberries",
      "quantity": 2,
      "unit": "pounds",
      "preparation": "hulled and cut into chunks"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the strawberries and cold water in a saucepan. Let stand for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Crush the strawberries gently, then strain the mixture through a fine-mesh strainer into a clean saucepan, pressing lightly on the solids."
    },
    {
      "step": 3,
      "text": "Stir in the white sugar until dissolved."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a gentle simmer and cook until slightly thickened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Remove from the heat, cool for 20 minutes, and transfer the syrup to a clean container.",
      "timer_minutes": 20
    }
  ],
