      "item": "cocoa powder",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "dark-milk-or-milk-chocolate-chopped",
      "item": "dark milk or milk chocolate chopped",
      "quantity": 175,
      "unit": "g"
    },
    {
      "ingredient_id": "candied-orange-peel",
      "item": "candied orange peel",
      "quantity": 40,
      "unit": "g",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "strips-sugared-candied-orange-peel-each-cut-into-5-pieces",
      "item": "strips sugared candied orange peel each cut into 5 pieces",
      "quantity": 5
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": "1-2",
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened butter with the icing sugar, orange zest and juice, chopped candied orange peel, and the cut sugared peel pieces until combined."
    },
    {
      "step": 2,
      "text": "Mix in the flour, cocoa powder, chopped chocolate, and milk to make a cohesive dough."
    },
    {
      "step": 3,
      "text": "Shape the dough into a log, wrap or cover it, and chill until firm.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Preheat the oven to a moderate baking temperature and prepare a baking tray."
    },
    {
      "step": 5,
      "text": "Slice the chilled dough into thick rounds and arrange them on the prepared tray."
    },
    {
      "step": 6,
      "text": "Bake until the cookies are set and lightly firm at the edges.",
      "timer_minutes": 15
    },
    {
      "step": 7,
      "text": "Cool the cookies on the tray briefly, then transfer them to a rack to cool completely."
    }
  ],
