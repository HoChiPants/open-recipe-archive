  "id": "chocolate-orange-cookies",
  "name": "Chocolate Orange Cookies",
  "subtitle": "Cocoa cookies with chocolate and candied orange",
  "description": "Softened butter, citrus, cocoa, chocolate, and candied orange peel form a chilled slice-and-bake cookie dough.",
  "meal_type": "drink",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15,
    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "butter-softened",
      "item": "butter softened",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "icing-sugar",
      "item": "icing sugar",
      "quantity": 80,
      "unit": "g"
    },
    {
      "ingredient_id": "orange-zested-and-1-2-juiced",
      "item": "orange zested and 1/2 juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 300,
      "unit": "g"
    },
    {
