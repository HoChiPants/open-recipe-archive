  "instructions": [
    {
      "step": 1,
      "text": "Mix 2 tablespoons flour with the salt and pepper. Coat the short ribs evenly."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet. Brown the coated ribs on all sides, using the brown sugar as directed during the browning step."
    },
    {
      "step": 3,
      "text": "Combine the sliced onion, red wine, chile sauce, brown sugar, vinegar, Worcestershire sauce, dry mustard, and chili powder."
    },
    {
      "step": 4,
      "text": "Place the browned ribs in a slow cooker and pour the sauce mixture over them."
    },
    {
      "step": 5,
      "text": "Cover and cook on low until the ribs are tender, about 8 hours. Confirm the beef reaches at least 145°F, then rest for 3 minutes.",
      "timer_minutes": 480
    },
    {
      "step": 6,
      "text": "Mix the remaining flour with the chile sauce, Worcestershire sauce, and water. Stir the mixture into the cooking liquid and cook until thickened.",
      "timer_minutes": 10
    }
  ],
