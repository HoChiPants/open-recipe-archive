{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "rhubarb-slush",
  "name": "Rhubarb Slush",
  "subtitle": "A tart, sparkling frozen fruit drink",
  "description": "Cooked rhubarb, citrus concentrates, and gin are frozen into a slushy base, then combined with chilled lemon-lime soda before serving.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-rhubarb",
      "item": "fresh rhubarb",
      "quantity": 6,
      "unit": "cups",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "frozen-orange-juice-concentrate",
      "item": "frozen orange juice concentrate",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce, thawed"
    },
    {
      "ingredient_id": "frozen-lemonade-concentrate",
      "item": "frozen lemonade concentrate",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce, thawed"
    },
    {
      "ingredient_id": "gin",
      "item": "gin",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "lemon-lime-flavored-carbonated-beverage",
      "item": "lemon-lime flavored carbonated beverage",
      "quantity": 1,
      "unit": "bottle",
      "preparation": "2 liter, chilled"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the chopped rhubarb and water in a saucepan. Cook until the rhubarb is tender, then drain."
    },
    {
      "step": 2,
      "text": "Stir the cooked rhubarb with the sugar, thawed orange juice concentrate, thawed lemonade concentrate, gin, and water until combined."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a freezer-safe container and freeze until slushy and firm."
    },
    {
      "step": 4,
      "text": "Combine the frozen mixture with the chilled lemon-lime carbonated beverage and serve."
    }
  ],
