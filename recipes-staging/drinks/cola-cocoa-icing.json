      "preparation": "chopped"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the cola-flavored beverage, cocoa powder, and butter in a saucepan. Simmer until the butter melts and the mixture is smooth."
    },
    {
      "step": 2,
      "text": "Place the confectioners' sugar and vanilla extract in a mixing bowl."
    },
    {
      "step": 3,
      "text": "Pour the warm cocoa mixture over the sugar and vanilla, then stir until smooth. Fold in the chopped walnuts and use as icing."
    }
  ],
