  "id": "cola-cocoa-icing",
  "name": "Cola Cocoa Icing",
  "subtitle": "A glossy cocoa icing with chopped walnuts",
  "description": "A rich butter-and-cocoa icing flavored with cola, vanilla, and walnuts.",
  "meal_type": "drink",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
