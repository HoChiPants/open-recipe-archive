  "instructions": [
    {
      "step": 1,
      "text": "Fill two serving glasses with ice."
    },
    {
      "step": 2,
      "text": "Stir the amaretto, cherry cordial, and lemon juice together in a jug."
    },
    {
      "step": 3,
      "text": "Divide the mixture between the glasses and top with the lemonade."
    },
    {
      "step": 4,
      "text": "Garnish with maraschino cherries, if using."
    }
