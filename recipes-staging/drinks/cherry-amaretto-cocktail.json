  "id": "cherry-amaretto-cocktail",
  "name": "Cherry Amaretto Cocktail",
  "subtitle": "A bright cherry-and-lemon drink with a soft almond note",
  "description": "Combine amaretto, cherry cordial, and lemon juice over ice, then finish with lemonade for a refreshing two-serving cocktail.",
  "meal_type": "drink",
