  "id": "white-peach-sangria",
  "name": "White Peach Sangria",
  "subtitle": "A chilled white-wine punch with peaches and grapes",
  "description": "Combine white wine, peach vodka, lemonade, sugar, and fresh fruit, then chill before serving.",
  "meal_type": "drink",
  "cuisine": "Spanish",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
