    "inactive_minutes": 120
  },
  "ingredients": [
    {
      "ingredient_id": "dry-white-wine",
      "item": "dry white wine",
      "quantity": 1,
      "unit": "bottle",
      "preparation": "750 milliliter"
    },
    {
      "ingredient_id": "peach-flavored-vodka",
      "item": "peach flavored vodka",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "frozen-lemonade-concentrate",
      "item": "frozen lemonade concentrate",
      "quantity": 6,
      "unit": "tablespoons",
      "preparation": "thawed"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-peaches",
      "item": "white peaches",
      "quantity": 1,
      "unit": "pound",
      "preparation": "pitted and sliced"
    },
    {
      "ingredient_id": "seedless-red-grapes",
      "item": "seedless red grapes",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "halved"
    },
    {
      "ingredient_id": "seedless-green-grapes",
      "item": "seedless green grapes",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "halved"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour the dry white wine, peach flavored vodka, thawed lemonade concentrate, white sugar, and sliced white peaches into a large pitcher."
    },
    {
      "step": 2,
      "text": "Stir until the sugar is well incorporated, then add the halved red and green grapes."
    },
    {
      "step": 3,
      "text": "Cover and chill for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 4,
      "text": "Serve chilled, spooning some of the fruit into each glass."
    }
  ],
