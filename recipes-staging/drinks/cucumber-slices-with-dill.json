  "id": "cucumber-slices-with-dill",
  "name": "Cucumber Slices with Dill",
  "subtitle": "Crisp cucumbers in a sweet-tangy dill dressing",
  "description": "A chilled cucumber and onion side with dried dill and a lightly sweetened vinegar dressing.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
