      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sliced cucumbers, onion, and dill in a bowl."
    },
    {
      "step": 2,
      "text": "In a separate bowl, combine the sugar, vinegar, water, and salt. Stir until the sugar is dissolved."
    },
    {
      "step": 3,
      "text": "Pour the dressing over the cucumber mixture and toss gently to coat."
    },
    {
      "step": 4,
      "text": "Cover and chill for 2 hours before serving.",
      "timer_minutes": 120
    }
