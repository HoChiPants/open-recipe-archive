  },
  "ingredients": [
    {
      "ingredient_id": "cucumber",
      "item": "cucumbers",
      "quantity": 4,
      "unit": "large",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "dried-dill-weed",
      "item": "dried dill weed",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
