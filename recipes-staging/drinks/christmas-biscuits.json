      "item": "edible silver balls"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the dark muscovado sugar, golden syrup, butter, ground ginger, and ground cinnamon in a saucepan until melted and smooth. Remove from the heat."
    },
    {
      "step": 2,
      "text": "Mix the plain flour and bicarbonate of soda in a bowl. Pour in the warm sugar mixture and stir to form a dough, then mix in the lightly beaten egg."
    },
    {
      "step": 3,
      "text": "Knead briefly until firm. Cover and chill for 60 minutes, or until firm enough to roll.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Heat the oven to 350°F and line baking trays with parchment."
    },
    {
      "step": 5,
      "text": "Dust the work surface with some of the extra flour. Roll out the dough, cut out the desired shapes, and arrange them on the trays."
    },
    {
      "step": 6,
      "text": "Bake for 10 minutes, until set; the centers should reach 160°F. Transfer to a wire rack and cool completely.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Melt the white chocolate in the microwave in short bursts, stirring between bursts, for up to 2 minutes total or until smooth.",
      "timer_minutes": 2
    },
    {
      "step": 8,
      "text": "Drizzle or spread the chocolate over the cooled biscuits and decorate with edible silver balls. Let the chocolate set before serving."
    }
  ],
