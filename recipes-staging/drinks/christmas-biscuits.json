  "id": "christmas-biscuits",
  "name": "Christmas Biscuits",
  "subtitle": "Spiced biscuits with white chocolate and silver decorations",
  "description": "Shape and bake warmly spiced biscuits, then finish them with white chocolate and edible silver balls.",
  "meal_type": "drink",
  "cuisine": "British",
  "yield": {
    "quantity": 30,
    "unit": "depending on size"
  },
  "times": {
    "prep_minutes": 40,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "dark-muscovado-sugar",
      "item": "dark muscovado sugar",
      "quantity": 175,
      "unit": "g"
    },
    {
