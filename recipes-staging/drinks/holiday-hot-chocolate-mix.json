  "id": "holiday-hot-chocolate-mix",
  "name": "Holiday Hot Chocolate Mix",
  "subtitle": "A warming spiced cocoa blend for mugs of creamy hot chocolate.",
  "description": "Combine the dry ingredients ahead of time, then whisk each portion with hot milk or boiling water and finish with festive toppings.",
  "meal_type": "drink",
  "yield": {
    "quantity": 20,
    "unit": "hot chocolates"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "demerara-sugar",
      "item": "demerara sugar",
      "quantity": 110,
      "unit": "g"
    },
    {
      "ingredient_id": "skimmed-milk-powder",
      "item": "skimmed milk powder",
      "quantity": 90,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 60,
      "unit": "g"
    },
    {
      "ingredient_id": "ground-mixed-spice",
      "item": "ground mixed spice",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "hot-whole-milk-or-boiling-water-per-hot-chocolate",
      "item": "hot whole milk or boiling water (per hot chocolate)",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "whipped-cream",
      "item": "whipped cream"
    },
    {
      "ingredient_id": "marshmallows-ensure-vegetarian",
      "item": "marshmallows (ensure vegetarian)",
      "preparation": "sprinkles or chocolate shavings"
    },
    {
      "ingredient_id": "cinnamon-sticks",
      "item": "cinnamon sticks"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the demerara sugar, skimmed milk powder, cocoa powder, and mixed spice in a bowl until evenly combined."
    },
    {
      "step": 2,
      "text": "For each serving, place 1/20 of the dry mix in a mug. Add a small splash of the hot milk or boiling water and whisk to a smooth paste."
    },
    {
      "step": 3,
      "text": "Gradually whisk in the remaining hot milk or boiling water until smooth and hot.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Top with whipped cream, vegetarian marshmallows, sprinkles or chocolate shavings, and a cinnamon stick."
    }
  ],
