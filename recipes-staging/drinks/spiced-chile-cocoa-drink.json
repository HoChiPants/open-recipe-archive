  "instructions": [
    {
      "step": 1,
      "text": "Bring 1.5 cups water to a simmer. Add the sliced chile and boil for 10 minutes, then strain the chile infusion into a heatproof container.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Heat the remaining 4 cups water in a saucepan until hot. Whisk in the cocoa powder and bring the mixture to a boil."
    },
    {
      "step": 3,
      "text": "Stir in the vanilla and the chile infusion. Continue stirring over low heat for 10 minutes, then serve hot.",
