  "id": "watermelon-vodka-slush",
  "name": "Watermelon Vodka Slush",
  "subtitle": "A bright, icy watermelon cocktail",
  "description": "Freeze watermelon with melon liqueur, then blend it with syrup, lemon juice, and vodka for a smooth slush.",
  "meal_type": "drink",
