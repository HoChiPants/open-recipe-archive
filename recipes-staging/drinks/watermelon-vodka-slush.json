  "instructions": [
    {
      "step": 1,
      "text": "Combine the watermelon and melon liqueur in a freezer-safe container. Cover and freeze until solid, about 4 hours.",
      "timer_minutes": 240
    },
    {
      "step": 2,
      "text": "Transfer the frozen mixture to a blender. Add the simple syrup, lemon juice, and vodka, then blend until smooth."
    },
    {
      "step": 3,
      "text": "Pour into four glasses and garnish each with a twist of lemon zest."
    }
  ],
