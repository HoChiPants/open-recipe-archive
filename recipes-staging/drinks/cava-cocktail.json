  "id": "cava-cocktail",
  "name": "Cava Cocktail",
  "subtitle": "A bright sparkling cocktail with orange and cinnamon",
  "description": "Orange juice, vodka, and cinnamon syrup meet chilled cava for a crisp, citrusy drink.",
  "meal_type": "drink",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
