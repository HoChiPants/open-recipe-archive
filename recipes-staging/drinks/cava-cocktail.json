  ],
  "instructions": [
    {
      "step": 1,
      "text": "Chill two serving glasses for 120 minutes.",
      "timer_minutes": 120
    },
    {
      "step": 2,
      "text": "Juice half the orange and finely slice the small orange."
    },
    {
      "step": 3,
      "text": "Fill a shaker with ice. Add the orange juice, vodka, cinnamon syrup, and a few orange slices; shake briefly."
    },
    {
      "step": 4,
      "text": "Strain into the chilled glasses over ice, top with cava, and garnish with the remaining orange slices."
    }
  ],
