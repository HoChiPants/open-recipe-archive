  "id": "raspberry-syrup-for-drinks",
  "name": "Raspberry Syrup for Drinks",
  "subtitle": "A bright berry syrup for mixing and pouring",
  "description": "Raspberries steep in a simple sugar syrup, then are strained to make a smooth drink mixer.",
  "meal_type": "drink",
  "cuisine": "American",
