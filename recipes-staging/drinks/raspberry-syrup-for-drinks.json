  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.66666668653488,
      "unit": "cup"
    },
    {
      "ingredient_id": "raspberries",
      "item": "raspberries",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the water and sugar in a saucepan. Simmer for 10 minutes, stirring until the sugar dissolves.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Place the raspberries in a heatproof container and pour the hot syrup over them."
    },
    {
      "step": 3,
      "text": "Let the mixture stand for 60 minutes to infuse.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Drain through a fine-mesh strainer, pressing gently on the berries."
    },
    {
      "step": 5,
      "text": "Cool the strained syrup before using."
    }
  ],
