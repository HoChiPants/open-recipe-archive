  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the strawberries, amaretto, ice cream, vanilla extract, vodka, and whipped cream together briefly."
    },
    {
      "step": 2,
      "text": "Add the crushed ice and blend until smooth."
    },
    {
      "step": 3,
      "text": "Whisk the remaining ice cream, whipped cream, and fresh strawberry together, then finish the drink with the mixture."
    }
