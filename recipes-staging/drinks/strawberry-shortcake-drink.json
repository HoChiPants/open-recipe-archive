      "ingredient_id": "frozen-strawberries",
      "item": "frozen strawberries",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "thawed"
    },
    {
      "ingredient_id": "fluid-ounces-amaretto-liqueur",
      "item": "fluid ounces amaretto liqueur",
      "quantity": 1.25
    },
    {
      "ingredient_id": "1-2-cup-scoops-vanilla-ice-cream",
      "item": "(1/2 cup) scoops vanilla ice cream",
      "quantity": 2
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "dash"
    },
    {
