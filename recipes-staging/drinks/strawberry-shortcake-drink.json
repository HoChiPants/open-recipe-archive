  "id": "strawberry-shortcake-drink",
  "name": "Strawberry Shortcake Drink",
  "subtitle": "A creamy strawberry cocktail blended until smooth",
  "description": "A chilled strawberry-and-vanilla drink with amaretto, vodka, and a whipped cream finish.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
