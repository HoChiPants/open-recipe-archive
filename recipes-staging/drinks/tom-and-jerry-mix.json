  "id": "tom-and-jerry-mix",
  "name": "Tom and Jerry Mix",
  "subtitle": "A spiced egg-and-butter base for warm drinks",
  "description": "Whipped butter, sugar, eggs, and warming spices make a rich mix for preparing Tom and Jerry drinks.",
  "meal_type": "drink",
  "cuisine": "American",
