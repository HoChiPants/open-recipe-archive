      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the confectioners' sugar and butter until smooth."
    },
    {
      "step": 2,
      "text": "Whisk the egg yolks into the butter mixture until fully incorporated."
    },
    {
      "step": 3,
      "text": "Whisk the egg whites separately to soft peaks."
    },
    {
      "step": 4,
      "text": "Stir the salt, mace, allspice, cloves, nutmeg, and cardamom into the butter mixture."
    },
    {
      "step": 5,
      "text": "Fold in the whipped egg whites until evenly combined. If serving without cooking, use pasteurized eggs and keep the mix chilled."
    }
  ],
