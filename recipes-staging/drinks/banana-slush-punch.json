  "id": "banana-slush-punch",
  "name": "Banana Slush Punch",
  "subtitle": "A fruity frozen punch with ginger ale",
  "description": "Blend bananas with a sweet fruit-concentrate mixture, freeze until slushy, and finish with ginger ale for a large-batch drink.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 54,
    "unit": "servings"
  },
