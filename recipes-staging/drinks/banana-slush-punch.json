    "inactive_minutes": 240
  },
  "ingredients": [
    {
      "ingredient_id": "ripe-bananas",
      "item": "ripe bananas",
      "quantity": 4
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "pineapple-juice",
      "item": "pineapple juice",
      "quantity": 1,
      "unit": "can",
      "preparation": "46 fluid ounce"
    },
    {
      "ingredient_id": "frozen-orange-juice-concentrate",
      "item": "frozen orange juice concentrate",
      "quantity": 2,
      "unit": "can",
      "preparation": "12 fluid ounce"
    },
    {
      "ingredient_id": "frozen-lemonade-concentrate",
      "item": "frozen lemonade concentrate",
      "quantity": 1,
      "unit": "can",
      "preparation": "12 fluid ounce"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "ginger-ale",
      "item": "ginger ale",
      "quantity": 3,
      "unit": "liters"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the ripe bananas, white sugar, and 3 cups water in a blender; blend until smooth."
    },
    {
      "step": 2,
      "text": "Stir in the pineapple juice and frozen orange juice concentrate, then blend with the frozen lemonade concentrate and remaining 3 cups water until combined."
    },
    {
      "step": 3,
      "text": "Freeze the mixture for 4 hours, or until firm enough to scoop.",
      "timer_minutes": 240
    },
    {
      "step": 4,
      "text": "Let the frozen mixture stand briefly until scoopable, then transfer it to a large punch bowl."
    },
    {
      "step": 5,
      "text": "Pour in the ginger ale and stir gently to combine before serving."
    }
  ],
