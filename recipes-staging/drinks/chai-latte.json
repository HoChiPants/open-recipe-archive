  "id": "chai-latte",
  "name": "Chai Latte",
  "subtitle": "Warm milk tea with aromatic spices",
  "description": "A creamy chai latte infused with cinnamon, cardamom, ginger, and other warming spices, lightly sweetened with brown sugar.",
  "meal_type": "drink",
