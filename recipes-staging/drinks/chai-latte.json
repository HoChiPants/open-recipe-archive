  "instructions": [
    {
      "step": 1,
      "text": "Slice the ginger and gather the cinnamon, cardamom, cloves, peppercorns, star anise, and tea bags."
    },
    {
      "step": 2,
      "text": "Warm the milk or coconut milk with the brown sugar and all of the spices in a saucepan, whisking occasionally, until steaming."
    },
    {
      "step": 3,
      "text": "Maintain gentle heat and steep the spiced milk with the tea bags for 6 minutes; do not let it boil.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Remove the tea bags and whole spices, then pour the chai into serving cups."
    },
    {
      "step": 5,
      "text": "Finish each serving with a pinch of cinnamon."
    }
  ],
