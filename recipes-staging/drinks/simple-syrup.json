  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the white sugar and water in a saucepan."
    },
    {
      "step": 2,
      "text": "Heat over medium heat, stirring until the sugar dissolves."
    },
    {
      "step": 3,
      "text": "Bring to a gentle simmer and cook until the syrup is clear.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Remove from the heat and let the syrup cool completely."
    },
    {
      "step": 5,
      "text": "Transfer to a clean container and refrigerate until needed."
    }
