  "id": "gin-citrus-and-aperitif-cocktail",
  "name": "Gin, Citrus, and Aperitif Cocktail",
  "subtitle": "A bright, balanced shaken cocktail with a herbal finish",
  "description": "Shake gin, a white wine-based aperitif, triple sec, lemon juice, and absinthe with ice for a crisp citrus-forward drink. Add optional sugar syrup to adjust the sweetness, then garnish with orange peel.",
  "meal_type": "drink",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
