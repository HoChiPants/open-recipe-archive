      "item": "absinthe",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "sugar-syrup",
      "item": "sugar syrup (optional)",
      "quantity": "1-2",
      "unit": "tsp",
      "optional": true
    },
    {
      "ingredient_id": "ice",
      "item": "ice"
    },
    {
      "ingredient_id": "strip-of-orange-peel-to-serve",
      "item": "strip of orange peel to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the gin, white wine-based aperitif, triple sec, lemon juice, absinthe, and optional sugar syrup to a cocktail shaker."
    },
    {
      "step": 2,
      "text": "Fill the shaker with ice, shake until well chilled, and strain into a chilled glass."
    },
    {
      "step": 3,
      "text": "Garnish with the strip of orange peel and serve immediately."
    }
  ],
