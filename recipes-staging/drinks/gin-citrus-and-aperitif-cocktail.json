    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "london-dry-gin",
      "item": "London Dry gin",
      "quantity": 25,
      "unit": "ml"
    },
    {
      "ingredient_id": "white-wine-based-aperitif",
      "item": "white wine-based aperitif",
      "quantity": 25,
      "unit": "ml"
    },
    {
      "ingredient_id": "triple-sec",
      "item": "triple sec",
      "quantity": 25,
      "unit": "ml"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 25,
      "unit": "ml"
    },
    {
