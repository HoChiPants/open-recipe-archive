{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "chocolate-chip-shortbread",
  "name": "Chocolate Chip Shortbread",
  "subtitle": "Buttery slice-and-bake cookies with chocolate chips",
  "description": "A simple shortbread made with salted butter, sugar, and chocolate chips, baked until lightly firm.",
  "meal_type": "drink",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "cold-salted-butter-cubed",
      "item": "cold salted butter cubed",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "egg-yolk",
      "item": "egg yolk",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "caster-sugar-plus-extra-to-sprinkle",
      "item": "caster sugar plus extra to sprinkle",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "milk-or-dark-chocolate-chips",
      "item": "milk or dark chocolate chips",
      "quantity": 80,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Rub the flour and cold cubed butter together until the mixture resembles fine crumbs."
    },
    {
      "step": 2,
      "text": "Stir the egg yolk and sugar together, then mix into the flour mixture to form a dough."
    },
    {
      "step": 3,
      "text": "Fold in the chocolate chips. Shape the dough into a thick log and chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Preheat the oven and prepare a baking tray."
    },
    {
      "step": 5,
      "text": "Cut the chilled log into thick rounds and arrange them on the tray."
    },
    {
      "step": 6,
      "text": "Sprinkle with the extra sugar and bake for 20 minutes, until lightly colored and firm; the egg-containing dough should reach 160°F in the center.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Cool on the tray for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
