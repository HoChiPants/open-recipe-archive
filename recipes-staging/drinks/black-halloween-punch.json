  "instructions": [
    {
      "step": 1,
      "text": "Freeze some of the cold water in ice trays or a mold until solid."
    },
    {
      "step": 2,
      "text": "Combine the grape drink mix, orange drink mix, sugar, and remaining cold water in a large punch bowl or container; stir until evenly mixed."
    },
    {
      "step": 3,
      "text": "Stir in the ginger ale just before serving, then add the prepared ice."
    }
