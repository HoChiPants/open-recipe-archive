  "id": "hot-and-sweet-ginger-drink",
  "name": "Hot and Sweet Ginger Drink",
  "subtitle": "A warm ginger infusion sweetened with brown sugar and honey",
  "description": "Simmer sliced ginger in water, sweeten the infusion, and serve hot.",
