  "id": "crispy-roasted-chicken",
  "name": "Crispy Roasted Chicken",
  "subtitle": "Herb-spiced chicken with a crisp roasted coating",
  "description": "Halved chicken is coated with a paprika, herb, and seed seasoning, then roasted until crisp and safely cooked.",
  "meal_type": "drink",
