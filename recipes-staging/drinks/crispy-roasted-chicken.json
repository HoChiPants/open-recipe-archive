      "preparation": "cut in half lengthwise"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Combine the salt, caraway seeds, sage, fennel seeds, coriander seeds, and rosemary."
    },
    {
      "step": 3,
      "text": "In a separate bowl, stir together the paprika, garlic powder, flour, and onion powder. Add the vegetable oil and mix until smooth."
    },
    {
      "step": 4,
      "text": "Coat both chicken halves evenly with the seasoned mixture and place them in a roasting pan."
    },
    {
      "step": 5,
      "text": "Roast for 60 minutes, or until the thickest part of the chicken reaches 165°F on a food thermometer.",
      "timer_minutes": 60
    },
    {
      "step": 6,
      "text": "Let the chicken rest for 10 minutes before serving.",
      "timer_minutes": 10
    }
  ],
