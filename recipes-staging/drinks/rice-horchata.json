  "instructions": [
    {
      "step": 1,
      "text": "Combine the rice and cold water in a covered container. Refrigerate for 12 hours to soften the rice.",
      "timer_minutes": 720
    },
    {
      "step": 2,
      "text": "Blend the soaked rice and water with the evaporated milk, sugar, cinnamon, and vanilla until very smooth."
    },
    {
      "step": 3,
      "text": "Strain the mixture through a fine-mesh strainer, pressing gently on the solids. Chill until cold, then stir and serve."
    }
