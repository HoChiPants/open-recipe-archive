  "id": "sazerac",
  "name": "Sazerac",
  "subtitle": "A stirred rye and cognac cocktail with bitters, absinthe, and lemon aroma.",
  "description": "Prepare an absinthe-rinsed glass, stir the spirits with bitters and syrup over ice, then finish with lemon peel.",
  "meal_type": "drink",
  "yield": {
    "quantity": 1,
    "unit": "servings"
  },
