    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "of-absinthe-we-used-pernod",
      "item": "of absinthe (we used Pernod)",
      "quantity": 2,
      "unit": "drops"
    },
    {
      "ingredient_id": "rye-whiskey-we-used-michter-s",
      "item": "rye whiskey (we used Michter’s)",
      "quantity": 30,
      "unit": "ml"
    },
    {
      "ingredient_id": "cognac-we-used-re-my-martin-vsop",
      "item": "cognac (we used Rémy Martin VSOP)",
      "quantity": 30,
      "unit": "ml"
    },
    {
      "ingredient_id": "of-peychaud-s-bitters",
      "item": "of Peychaud’s bitters",
      "quantity": 2,
      "unit": "drops"
    },
    {
      "ingredient_id": "sugar-syrup",
      "item": "sugar syrup",
      "quantity": 5,
      "unit": "ml"
    },
    {
      "ingredient_id": "strip-of-lemon-peel-to-garnish",
      "item": "strip of lemon peel to garnish",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the absinthe to a chilled rocks glass and swirl to coat the inside."
    },
    {
      "step": 2,
      "text": "Stir the rye whiskey, cognac, bitters, and sugar syrup with ice until well chilled."
    },
    {
      "step": 3,
      "text": "Strain into the prepared glass. Express the lemon peel over the drink, rub it around the rim, and use it to garnish."
    }
  ],
