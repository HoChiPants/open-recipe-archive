  "id": "passion-fruit-mocktail-martini",
  "name": "Passion Fruit Mocktail Martini",
  "subtitle": "A tart, frothy passion fruit drink with a sparkling finish.",
  "description": "Shake passion fruit, citrus, egg white, alcohol-free spirit, and syrup with ice, then finish each glass with sparkling grape juice.",
  "meal_type": "drink",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "passion-fruits-halved",
      "item": "passion fruits halved",
      "quantity": 3
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": 1
    },
    {
      "ingredient_id": "alcohol-free-spirit",
      "item": "alcohol-free spirit",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "sugar-syrup",
      "item": "sugar syrup",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "handful-of-ice",
      "item": "handful of ice"
    },
    {
      "ingredient_id": "sparkling-grape-juice-to-serve",
      "item": "sparkling grape juice to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Scoop the passion fruit pulp into a shaker. Add the lemon juice, egg white, alcohol-free spirit, and sugar syrup."
    },
    {
      "step": 2,
      "text": "Shake without ice to aerate the egg white, then add the ice and shake again until chilled."
    },
    {
      "step": 3,
      "text": "Strain into two glasses. Top each with sparkling grape juice and serve immediately."
    },
    {
      "step": 4,
      "text": "For raw egg safety, verify the egg-containing mixture reaches 160°F with a food thermometer before serving; use the applicable safe handling method for the egg white."
    }
  ],
