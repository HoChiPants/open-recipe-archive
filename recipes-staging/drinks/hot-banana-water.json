  "id": "hot-banana-water",
  "name": "Hot Banana Water",
  "subtitle": "A warm banana-peel infusion",
  "description": "Simmer banana peels in water, then let the infusion rest before serving warm.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "quart"
    },
    {
      "ingredient_id": "banana-peels",
      "item": "banana peels",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the banana peels into smaller pieces."
    },
    {
      "step": 2,
      "text": "Bring the water to a simmer in a saucepan."
    },
    {
      "step": 3,
      "text": "Add the peels to the boiling water, reduce to a simmer, and cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Preheat a heatproof serving container for 10 minutes, then transfer in the hot infusion and peels.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Let the mixture steep for 20 minutes, then stir and remove the peels.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Serve warm."
    }
  ],
