  "id": "chai-tea-bags",
  "name": "Chai Tea Bags",
  "subtitle": "A warming blend of black tea and aromatic spices",
  "description": "Prepare homemade chai tea bags by combining Assam tea with fragrant spices, then portioning the blend for easy brewing.",
  "meal_type": "drink",
  "yield": {
    "quantity": 18,
    "unit": "teabags"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "cardamom-pods-cracked",
      "item": "cardamom pods cracked",
      "quantity": 18
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": "1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "nutmeg-grated",
      "item": "nutmeg grated",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "ground-cloves",
      "item": "ground cloves",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "black-assam-tea-leaves",
      "item": "black assam tea leaves",
      "quantity": 150,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the cardamom, ginger, cinnamon, black pepper, nutmeg, and cloves in a bowl.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Stir in the black Assam tea leaves until evenly distributed."
    },
    {
      "step": 3,
      "text": "Divide the blend evenly among 18 empty tea bags and seal.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "To brew, place one tea bag in a cup and cover with freshly boiled water."
    },
    {
      "step": 5,
      "text": "Steep for 5 minutes, then remove the tea bag.",
      "timer_minutes": 5
    }
  ],
