  "instructions": [
    {
      "step": 1,
      "text": "Combine the white sugar, water, and orange zest in a saucepan. Bring to a simmer, then cook for 3 minutes. Remove from the heat and let the syrup cool; discard the zest.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Blend the cubed, seeded watermelon until smooth."
    },
    {
      "step": 3,
      "text": "Stir the watermelon purée with the tequila, lime juice, and cooled syrup."
    },
    {
      "step": 4,
      "text": "Rub lime wedges around four glass rims, then dip the rims into the salt or sugar."
    },
    {
      "step": 5,
      "text": "Fill the glasses with crushed ice and divide the watermelon mixture among them. Garnish with the lime wedges."
    }
  ],
