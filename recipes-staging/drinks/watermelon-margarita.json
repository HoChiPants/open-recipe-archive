  "id": "watermelon-margarita",
  "name": "Watermelon Margarita",
  "subtitle": "A chilled watermelon cocktail with citrus and tequila",
  "description": "Infuse a quick orange-zest syrup, blend it with watermelon, then combine with tequila, lime, and ice for four refreshing drinks.",
  "meal_type": "drink",
  "cuisine": "Mexican",
