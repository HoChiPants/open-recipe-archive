  "id": "mock-champagne",
  "name": "Mock Champagne",
  "subtitle": "A chilled, sparkling fruit punch",
  "description": "Freeze part of the ginger ale, then combine it with pineapple juice, white grape juice, and the remaining ginger ale for a festive nonalcoholic punch.",
  "meal_type": "drink",
