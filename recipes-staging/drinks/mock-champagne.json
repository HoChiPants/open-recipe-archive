      "preparation": "64 fluid ounce, chilled"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour one bottle of the chilled ginger ale into ice cube trays and freeze until solid."
    },
    {
      "step": 2,
      "text": "Transfer the frozen ginger ale cubes to a large punch bowl."
    },
    {
      "step": 3,
      "text": "Add the pineapple juice, white grape juice, and remaining bottle of ginger ale. Stir gently and serve chilled."
    }
  ],
