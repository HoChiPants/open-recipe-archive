  "id": "mulled-red-wine",
  "name": "Mulled Red Wine",
  "subtitle": "A warm, spiced wine for cool evenings",
  "description": "Gently warm red wine with citrus peel and whole spices, sweeten to taste, and serve hot.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "dry-red-wine",
      "item": "dry red wine",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "2-inch-pieces-cinnamon-sticks",
      "item": "(2 inch) pieces cinnamon sticks",
      "quantity": 2
    },
    {
      "ingredient_id": "whole-cloves",
      "item": "whole cloves",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "whole-allspice-berries",
      "item": "whole allspice berries",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "strip-of-lemon-peel",
      "item": "strip of lemon peel",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "strip-of-orange-peel",
      "item": "strip of orange peel",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or more to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the wine, cinnamon sticks, cloves, allspice berries, lemon peel, and orange peel in a saucepan."
    },
    {
      "step": 2,
      "text": "Warm over low heat until steaming; do not boil."
    },
    {
      "step": 3,
      "text": "Stir in the sugar until dissolved, adjusting to taste."
    },
    {
      "step": 4,
      "text": "Continue warming gently for 20 minutes, then strain into heatproof glasses and serve.",
      "timer_minutes": 20
    }
  ],
