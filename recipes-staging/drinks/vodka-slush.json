  "id": "vodka-slush",
  "name": "Vodka Slush",
  "subtitle": "A make-ahead frozen citrus cocktail",
  "description": "Prepare this sweet citrus-and-tea mixture a day ahead, freeze it into a slush, and finish each serving with sparkling lemon-lime soda.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 1440
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 7,
      "unit": "cups"
    },
    {
      "ingredient_id": "instant-tea-powder",
      "item": "instant tea powder",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "frozen-orange-juice-concentrate",
      "item": "frozen orange juice concentrate",
      "quantity": 1,
      "unit": "can",
      "preparation": "12 fluid ounce"
    },
    {
      "ingredient_id": "frozen-lemonade-concentrate",
      "item": "frozen lemonade concentrate",
      "quantity": 1,
      "unit": "can",
      "preparation": "12 fluid ounce"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "vodka",
      "item": "vodka",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "lemon-lime-flavored-carbonated-beverage",
      "item": "lemon-lime flavored carbonated beverage",
      "quantity": 1,
      "unit": "liter"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sugar and 7 cups water in a large saucepan. Heat and stir until the sugar dissolves, then stir in the instant tea powder."
    },
    {
      "step": 2,
      "text": "Stir in the orange juice concentrate, lemonade concentrate, and cold water. Let the mixture cool, then mix in the vodka."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a freezer-safe container and freeze until firm and slushy, about 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 4,
      "text": "Stir the frozen mixture with the lemon-lime carbonated beverage just before serving."
    }
  ],
