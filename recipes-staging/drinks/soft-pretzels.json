{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "soft-pretzels",
  "name": "Soft Pretzels",
  "subtitle": "Quick baked pretzels with a salted finish",
  "description": "Shape a simple yeast dough, dip the pieces in a baking-soda bath, and bake until golden and cooked through.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "warm-water",
      "item": "warm water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 4,
      "unit": "cups"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "coarse-salt",
      "item": "coarse salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "baking-soda",
      "item": "baking soda",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "preparation": "beaten"
    },
    {
      "ingredient_id": "coarse-salt-to-taste",
      "item": "coarse salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F."
    },
    {
      "step": 2,
      "text": "Combine the warm water, sugar, and yeast. Let the mixture stand for 5 minutes, then stir until the yeast is incorporated.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Whisk together the flour, melted butter, and coarse salt. Stir in the yeast mixture, then knead until the dough is smooth."
    },
    {
      "step": 4,
      "text": "Cut the dough into 15 portions and shape each into a pretzel."
    },
    {
      "step": 5,
      "text": "Prepare a baking-soda bath by combining the water and baking soda. Dip each pretzel in the bath, then transfer them to a baking sheet."
    },
    {
      "step": 6,
      "text": "Brush the pretzels with the beaten egg and sprinkle with coarse salt to taste."
    },
    {
      "step": 7,
      "text": "Bake for 12 minutes, until cooked through. The egg-coated surface should reach 160°F when checked with a food thermometer.",
      "timer_minutes": 12
    }
  ],
