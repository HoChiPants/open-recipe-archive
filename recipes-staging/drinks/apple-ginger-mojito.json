  "id": "apple-ginger-mojito",
  "name": "Apple Ginger Mojito",
  "subtitle": "A crisp rum cocktail with apple, lime, mint, and ginger beer.",
  "description": "Build this refreshing single-serving cocktail over ice, then finish it with a mint and apple garnish.",
