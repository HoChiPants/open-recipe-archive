  "name": "Manhattan Cocktail",
  "subtitle": "A stirred whiskey cocktail with sweet vermouth and bitters",
  "description": "Combine whiskey and sweet vermouth over ice, stir until chilled, then finish with bitters and a cherry.",
  "meal_type": "drink",
