  "instructions": [
    {
      "step": 1,
      "text": "Fill a mixing glass with the ice cubes."
    },
    {
      "step": 2,
      "text": "Add the sweet vermouth and whiskey, then stir until well chilled."
    },
    {
      "step": 3,
      "text": "Add the bitters and stir briefly to combine."
    },
    {
      "step": 4,
      "text": "Strain into a serving glass and garnish with the maraschino cherry."
    }
