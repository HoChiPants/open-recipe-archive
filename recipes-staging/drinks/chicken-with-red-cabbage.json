  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Cook the bacon until crisp, reserving 1 tablespoon of the drippings. Cool the bacon, then crumble it.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the flour, salt, and smoked paprika together. Coat the chicken thighs in the mixture."
    },
    {
      "step": 4,
      "text": "Heat the reserved drippings in an oven-safe skillet. Brown the chicken for about 5 minutes, then transfer it to a plate.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Drain excess drippings from the skillet. Add the onion and apple; cook until beginning to soften.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir in the cabbage, crumbled bacon, and the remaining salt. Cook until the cabbage starts to wilt.",
      "timer_minutes": 8
    },
    {
      "step": 7,
      "text": "Add the vinegar and wine. Stir in the brown sugar and cinnamon, then bring the mixture to a simmer."
    },
    {
      "step": 8,
      "text": "Cook the cabbage mixture for 10 minutes, then return the chicken to the skillet.",
      "timer_minutes": 10
    },
    {
      "step": 9,
      "text": "Bake until the cabbage is tender and the chicken reaches 165°F in the thickest part.",
      "timer_minutes": 40
    }
  ],
