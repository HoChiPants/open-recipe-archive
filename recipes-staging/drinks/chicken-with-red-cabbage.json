  "id": "chicken-with-red-cabbage",
  "name": "Chicken with Red Cabbage",
  "subtitle": "Braised chicken thighs with sweet-tart cabbage",
  "description": "Chicken thighs are coated with seasoned flour, browned, and baked with red cabbage, apple, onion, bacon, wine, and vinegar until tender.",
  "meal_type": "drink",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
