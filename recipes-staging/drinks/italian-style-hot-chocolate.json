{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "italian-style-hot-chocolate",
  "name": "Italian-Style Hot Chocolate",
  "subtitle": "A thick, cocoa-rich warm drink for two",
  "description": "Cocoa and sugar are whisked with milk and thickened with cornstarch for a smooth, velvety hot chocolate.",
  "meal_type": "drink",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cocoa powder and white sugar together in a saucepan."
    },
    {
      "step": 2,
      "text": "Add the 1.5 cups milk and stir until the sugar dissolves."
    },
    {
      "step": 3,
      "text": "Warm the mixture over medium heat until it reaches a gentle simmer."
    },
    {
      "step": 4,
      "text": "Whisk the 2 tablespoons milk with the cornstarch in a small bowl until smooth."
    },
    {
      "step": 5,
      "text": "Whisk the cornstarch mixture into the simmering cocoa mixture and cook, stirring, until thickened and smooth."
    },
    {
      "step": 6,
      "text": "Prepare for 3 minutes, then divide between two cups and serve hot.",
      "timer_minutes": 3
    }
  ],
