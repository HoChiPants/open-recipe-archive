  "id": "clementine-margarita",
  "name": "Clementine Margarita",
  "subtitle": "A bright citrus cocktail with a salted, spiced rim",
  "description": "Combine tequila, triple sec, and fresh clementine and lime juices, then serve chilled with a citrus-salt-sugar rim.",
  "meal_type": "drink",
