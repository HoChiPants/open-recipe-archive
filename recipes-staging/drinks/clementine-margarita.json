  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pour the tequila and triple sec into the bottle, seal it, and shake briefly to combine."
    },
    {
      "step": 2,
      "text": "Chill the mixture until cold."
    },
    {
      "step": 3,
      "text": "Prepare the clementine and lime juices, using the listed bottles if needed."
    },
    {
      "step": 4,
      "text": "Mix the sea salt flakes, golden caster sugar, and dried clementine zest in the small jam jar or tin."
    },
    {
      "step": 5,
      "text": "Combine the salt mixture with the clementine juice and lime juice, then stir well."
    },
    {
      "step": 6,
      "text": "Pour into two glasses and serve chilled."
    }
  ],
