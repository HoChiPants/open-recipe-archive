  "id": "kummelweck-rolls",
  "name": "Kummelweck Rolls",
  "subtitle": "Soft rolls finished with caraway and coarse salt",
  "description": "Yeasted rolls with a tender crumb and a savory caraway-salt topping.",
  "meal_type": "drink",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 20,
    "inactive_minutes": 100
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 3.25,
      "unit": "cups",
      "preparation": "divided"
    },
    {
      "ingredient_id": "warm-water-105-degrees-f-41-degrees-c",
      "item": "warm water (105 degrees F/41 degrees C)",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "active-dry-yeast",
      "item": "active dry yeast",
      "quantity": 1,
      "unit": "package",
      "preparation": ".25 ounce"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2.5,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "caraway-seeds",
      "item": "caraway seeds",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "coarse-sea-salt-to-taste",
      "item": "coarse sea salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk warm water, active dry yeast, and part of the divided flour in a bowl. Let stand for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Stir in one egg white, sugar, salt, honey, and part of the vegetable oil. Whisk until smooth."
    },
    {
      "step": 3,
      "text": "Add the remaining flour and knead for 4 minutes, until a cohesive dough forms.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Coat the dough with the remaining vegetable oil, cover, and let rise for 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 5,
      "text": "Turn the dough onto a lightly floured surface, divide it into 12 pieces, and transfer them to a prepared baking sheet. Let rest for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Heat the oven to 425°F."
    },
    {
      "step": 7,
      "text": "Whisk the remaining egg white with 2 teaspoons water. Brush the rolls, cut the tops, and sprinkle with caraway seeds and coarse sea salt."
    },
    {
      "step": 8,
      "text": "Bake for 20 minutes, until golden brown and the centers are fully set; verify with a thermometer that they reach at least 160°F.",
      "timer_minutes": 20
    }
  ],
