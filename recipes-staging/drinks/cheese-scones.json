  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cheese-scones",
  "name": "Cheese Scones",
  "subtitle": "Tender savory scones with a golden cheese crust",
  "description": "Rich cheddar and a hint of cayenne flavor these quick-baked savory scones, suitable for snacks, suppers, or afternoon tea.",
  "meal_type": "drink",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "self-raising-flour-plus-extra-for-dusting",
      "item": "self-raising flour plus extra for dusting",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "of-salt",
      "item": "of salt",
      "unit": "pinch"
    },
    {
      "ingredient_id": "of-cayenne-pepper",
      "item": "of cayenne pepper",
      "unit": "pinch"
    },
    {
      "ingredient_id": "baking-powder",
      "item": "baking powder",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "chilled-butter-cut-into-cubes",
      "item": "chilled butter cut into cubes",
      "quantity": 55,
      "unit": "g"
    },
    {
      "ingredient_id": "mature-cheddar-grated",
      "item": "mature cheddar grated",
      "quantity": 120,
      "unit": "g"
    },
    {
      "ingredient_id": "milk-plus-1-tbsp-for-glazing",
      "item": "milk plus 1 tbsp for glazing",
      "quantity": "90-100",
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and prepare a baking tray."
    },
    {
      "step": 2,
      "text": "Mix the flour, salt, cayenne, and baking powder in a bowl. Rub in the chilled butter until the mixture resembles coarse crumbs, then stir in the cheddar."
    },
    {
      "step": 3,
      "text": "Pour in the milk and mix gently to form a firm dough."
    },
    {
      "step": 4,
      "text": "Turn the dough onto a lightly floured surface, shape it into a thick round, and cut it into five portions."
    },
    {
      "step": 5,
      "text": "Arrange the portions on the tray and brush the tops with the reserved tablespoon of milk."
    },
    {
      "step": 6,
      "text": "Bake until risen and golden brown.",
      "timer_minutes": 20
    }
  ],
