  "id": "alcohol-free-amaretto-sour",
  "name": "Alcohol-Free Amaretto Sour",
  "subtitle": "A bright pineapple-and-lemon mocktail with almond notes",
  "description": "Combine tropical juice, citrus, cherry syrup, almond extract, and egg white for a tart, lightly foamy drink.",
  "meal_type": "drink",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "pineapple-juice",
      "item": "pineapple juice",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 50,
      "unit": "ml"
    },
    {
      "ingredient_id": "egg-white",
      "item": "egg white",
      "quantity": "1/2"
    },
    {
      "ingredient_id": "syrup-from-cocktail-cherries-or-more-if-you-prefer",
      "item": "syrup from cocktail cherries (or more if you prefer)",
      "quantity": 10,
      "unit": "ml",
      "preparation": "plus cherries to serve"
    },
    {
      "ingredient_id": "a-few-drops-almond-extract",
      "item": "a few drops almond extract"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Use pasteurized egg white for this uncooked drink. Untreated raw egg mixtures must reach 160°F and have a firm, fully set center, so they are not suitable here."
    },
    {
      "step": 2,
      "text": "Stir the pineapple juice, lemon juice, egg white, and almond extract together until combined."
    },
    {
      "step": 3,
      "text": "Add the cherry syrup and stir to blend."
    },
    {
      "step": 4,
      "text": "Transfer to two serving glasses and garnish with the cocktail cherries."
    }
  ],
