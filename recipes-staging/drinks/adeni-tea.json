  "schema_version": "1.0.0",
  "id": "adeni-tea",
  "name": "Adeni Tea",
  "subtitle": "Spiced black tea with evaporated milk",
  "description": "A warm, sweet black tea infused with cardamom and ground spices, then finished with creamy evaporated milk.",
  "meal_type": "drink",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "orange-pekoe-tea-bags",
      "item": "orange pekoe tea bags",
      "quantity": 3
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "cardamom-seeds",
      "item": "cardamom seeds",
      "quantity": 10,
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "12 fluid ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Open the tea bags and place the tea leaves in a saucepan with the water. Bring to a simmer."
    },
    {
      "step": 2,
      "text": "Simmer for 5 minutes, then stir in the sugar, cardamom seeds, cinnamon, nutmeg, and ginger.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Continue simmering for 10 minutes to develop the spice flavor.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the evaporated milk and simmer gently for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Pour into cups and serve hot."
    }
  ],
