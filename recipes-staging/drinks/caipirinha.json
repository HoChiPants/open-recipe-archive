  "id": "caipirinha",
  "name": "Caipirinha",
  "subtitle": "A bright lime and cachaça cocktail",
  "description": "Muddled lime and sugar form the base of this refreshing Brazilian-style drink, finished with cachaça and plenty of ice.",
  "meal_type": "drink",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "limes-chopped-into-wedges",
      "item": "limes chopped into wedges",
      "quantity": 2,
      "preparation": "plus extra lime wedges to serve (optional)",
      "optional": true
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 5,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "cachac-a",
      "item": "cachaça",
      "quantity": 200,
      "unit": "ml"
    },
    {
      "ingredient_id": "ice",
      "item": "ice"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Divide the lime wedges and sugar among four glasses. Muddle until the lime releases its juice and the sugar begins to dissolve."
    },
    {
      "step": 2,
      "text": "Pour in the cachaça and stir to combine."
    },
    {
      "step": 3,
      "text": "Fill the glasses with ice, stir briefly, and serve with extra lime wedges if desired."
    }
  ],
