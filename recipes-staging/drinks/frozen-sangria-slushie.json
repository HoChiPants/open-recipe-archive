  "id": "frozen-sangria-slushie",
  "name": "Frozen Sangria Slushie",
  "subtitle": "A berry-filled frozen wine cocktail",
  "description": "Blend red wine with berries, citrus, liqueur, sugar, and ice, then freeze until slushy.",
  "meal_type": "drink",
