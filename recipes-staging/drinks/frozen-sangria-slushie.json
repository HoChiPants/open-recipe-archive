  "instructions": [
    {
      "step": 1,
      "text": "Add the wine, crushed ice, berries, orange-flavored liqueur, orange juice, and sugar to a blender."
    },
    {
      "step": 2,
      "text": "Blend until smooth, scraping down the sides if needed."
    },
    {
      "step": 3,
      "text": "Transfer to a freezer-safe container and freeze until the mixture reaches a slushy consistency. Stir briefly before serving."
    }
  ],
