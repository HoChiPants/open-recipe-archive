  "id": "chocolate-concrete",
  "name": "Chocolate Concrete",
  "subtitle": "A crisp-edged chocolate slice with a tender center",
  "description": "Mix a simple cocoa batter, bake it in a buttered tin, and finish with a light sugar topping for a firm chocolate traybake.",
  "meal_type": "drink",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "unsalted-butter-melted",
      "item": "unsalted butter melted",
      "quantity": 170,
      "unit": "g",
      "preparation": "plus extra for the tin"
    },
    {
      "ingredient_id": "vanilla-extract",
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 170,
      "unit": "g"
    },
    {
      "ingredient_id": "self-raising-flour",
      "item": "self-raising flour",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "cocoa-powder",
      "item": "cocoa powder",
      "quantity": 25,
      "unit": "g"
    },
    {
      "ingredient_id": "egg-beaten",
      "item": "egg beaten",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "sugar",
      "item": "granulated sugar",
      "quantity": 2,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven and butter a baking tin."
    },
    {
      "step": 2,
      "text": "Stir the melted butter with the vanilla extract, then mix in the caster sugar."
    },
    {
      "step": 3,
      "text": "Whisk together the self-raising flour and cocoa powder. Add the beaten egg and butter mixture, stirring until combined."
    },
    {
      "step": 4,
      "text": "Spread the mixture evenly in the prepared tin and sprinkle the granulated sugar over the surface."
    },
    {
      "step": 5,
      "text": "Bake for 35 minutes, until the center is firm and reaches 160°F on a food thermometer.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Cool in the tin for 5 minutes before serving.",
      "timer_minutes": 5
    }
  ],
