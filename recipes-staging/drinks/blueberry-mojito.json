  "instructions": [
    {
      "step": 1,
      "text": "Combine the blueberries, chopped lemons, and sugar in a large pitcher. Gently muddle until the berries release their juice."
    },
    {
      "step": 2,
      "text": "Add the picked mint leaves and white rum, stirring to combine."
    },
    {
      "step": 3,
      "text": "Pour in the sparkling water and stir gently. Serve immediately."
    }
