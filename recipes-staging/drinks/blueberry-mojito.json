  "id": "blueberry-mojito",
  "name": "Blueberry Mojito",
  "subtitle": "A bright, berry-filled rum drink with mint and bubbles",
  "description": "Muddle blueberries, chopped lemons, and sugar, then add mint, rum, and sparkling water for a refreshing six-serving cocktail.",
  "meal_type": "drink",
