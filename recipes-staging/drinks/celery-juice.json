  "id": "celery-juice",
  "name": "Celery Juice",
  "subtitle": "Fresh celery blended with apple, lemon, and ginger",
  "description": "A bright, crisp blended drink with fresh celery, tart lemon, apple, and a gentle ginger finish.",
  "meal_type": "drink",
  "yield": {
