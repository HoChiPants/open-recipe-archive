  "instructions": [
    {
      "step": 1,
      "text": "Trim and cut the celery into pieces small enough for blending."
    },
    {
      "step": 2,
      "text": "Add the celery, apple, lemon juice, and grated ginger to a blender. Blend until smooth."
    },
    {
      "step": 3,
      "text": "Stir the juice, chill if desired, and serve."
    }
