  "instructions": [
    {
      "step": 1,
      "text": "Combine the apple cider, cranberry juice, lemon juice, pineapple juice, sliced orange, cloves, honey, sugar, cinnamon sticks, and orange slices for garnish in a large pot."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a gentle simmer over medium heat, then stir in the nutmeg, allspice, and ginger."
    },
    {
      "step": 3,
      "text": "Simmer gently for 15 minutes, keeping the liquid below a boil.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Cut the mint leaves as desired. Serve the wassail warm with the orange slices and mint."
    }
