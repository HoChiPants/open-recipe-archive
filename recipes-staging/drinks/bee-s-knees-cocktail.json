  "instructions": [
    {
      "step": 1,
      "text": "Stir the honey until smooth and loosened."
    },
    {
      "step": 2,
      "text": "Add the gin and lemon juice, then stir until the honey is blended."
    },
    {
      "step": 3,
      "text": "Fill a glass with ice and pour in the cocktail."
    },
    {
      "step": 4,
      "text": "Garnish with the lemon zest strip and serve."
