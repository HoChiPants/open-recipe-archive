  "id": "bee-s-knees-cocktail",
  "name": "Bee's Knees Cocktail",
  "subtitle": "A bright gin drink balanced with honey and lemon",
  "description": "Combine gin, lemon, honey, and lemon juice over ice for a crisp, lightly floral cocktail finished with lemon zest.",
  "meal_type": "drink",
