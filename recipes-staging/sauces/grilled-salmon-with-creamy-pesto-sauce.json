  "id": "grilled-salmon-with-creamy-pesto-sauce",
  "name": "Grilled Salmon with Creamy Pesto Sauce",
  "subtitle": "Tender grilled salmon with a warm pesto cream sauce",
  "description": "Grill salmon fillets and serve them with a smooth cream cheese, milk, and pesto sauce finished with fresh parsley.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
