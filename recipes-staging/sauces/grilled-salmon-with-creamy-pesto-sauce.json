    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "4-ounce-salmon-fillets",
      "item": "(4 ounce) salmon fillets",
      "quantity": 4
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "philadelphia-cream-cheese",
      "item": "PHILADELPHIA Cream Cheese",
      "quantity": 4,
      "unit": "ounces",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "pesto",
      "item": "pesto",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "finely-chopped-fresh-parsley",
      "item": "finely chopped fresh parsley",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Prepare the salmon fillets and brush them with the olive oil."
    },
    {
      "step": 2,
      "text": "Grill the salmon for 10 minutes, or until it reaches 145°F and flakes easily with a fork.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the cubed cream cheese and milk together in a saucepan. Warm for 3 minutes, stirring, until melted and smooth.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Stir in the pesto. Serve the sauce with the grilled salmon and sprinkle with the parsley."
    }
  ],
