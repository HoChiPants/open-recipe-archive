  "id": "pork-chops-with-mushroom-sauce",
  "name": "Pork Chops with Mushroom Sauce",
  "subtitle": "Tender pork in a creamy mushroom topping",
  "description": "Pork chops are cooked briefly, then finished with a smooth mushroom-and-sour-cream sauce.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
