  "ingredients": [
    {
      "ingredient_id": "pork-chops",
      "item": "pork chops",
      "quantity": 6
    },
    {
      "ingredient_id": "condensed-cream-of-mushroom-soup",
      "item": "condensed cream of mushroom soup",
      "quantity": 2,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1,
      "unit": "pint"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the cooking equipment according to its settings."
    },
    {
      "step": 2,
      "text": "Cook the pork chops for 3 minutes, then drain them. Continue cooking as needed until a thermometer inserted into the thickest part reads 145°F; rest for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Place the pork chops in the cooking vessel. Whisk together the condensed cream of mushroom soup and sour cream, then pour the mixture over the chops."
    },
    {
      "step": 4,
      "text": "Cover and simmer gently for 60 minutes, until the sauce is hot and the pork reaches the safe endpoint.",
      "timer_minutes": 60
    }
  ],
