  "instructions": [
    {
      "step": 1,
      "text": "Drain the chickpeas and prepare the remaining ingredients."
    },
    {
      "step": 2,
      "text": "Blend the chickpeas, garlic, apricots, curry powder, lemon zest and juice, tahini or nut butter, and olive oil until smooth."
    },
    {
      "step": 3,
      "text": "Chill the hummus, if desired, while preparing the garnishes."
    },
    {
      "step": 4,
      "text": "Top with chopped red onion, pomegranate seeds, nigella seeds, herbs, and a drizzle of olive oil."
    },
    {
      "step": 5,
      "text": "Serve with toasted pittas and vegetable crudités."
    }
