  "instructions": [
    {
      "step": 1,
      "text": "Stir the sour cream with the garlic, jalapeno, cilantro, taco seasoning, hot pepper sauce, and half of the lemon juice."
    },
    {
      "step": 2,
      "text": "Stir the remaining lemon juice into the mashed avocados."
    },
    {
      "step": 3,
      "text": "Spread the shredded lettuce in the bottom of a large serving dish. Layer the black beans, corn, avocado mixture, sour cream mixture, and salsa over it."
    },
    {
      "step": 4,
      "text": "Top with the shredded cheese, sliced black olives, green onions, and chopped tomato. Serve immediately."
    }
