  "id": "honey-chipotle-wing-sauce-glaze",
  "name": "Honey Chipotle Wing Sauce Glaze",
  "subtitle": "A smoky, sweet, and tangy sauce for wings",
  "description": "Blend chipotle peppers, honey, lime, soy sauce, garlic, and flour into a smooth glaze for coating cooked wings or serving alongside them.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
