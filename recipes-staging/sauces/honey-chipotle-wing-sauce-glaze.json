      "unit": "teaspoon"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the chipotle peppers and soy sauce to a blender or food processor."
    },
    {
      "step": 2,
      "text": "Add the honey, lime juice, garlic powder, and flour. Blend until completely smooth, scraping down the sides if needed."
    },
    {
      "step": 3,
      "text": "Use immediately as a wing glaze or dipping sauce."
    }
  ],
