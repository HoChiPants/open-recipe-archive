  },
  "ingredients": [
    {
      "ingredient_id": "chipotle-peppers-in-adobo-sauce",
      "item": "chipotle peppers in adobo sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "7 ounce, or to taste"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "lime-juice",
      "item": "lime juice",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
