  "id": "hot-corn-dip",
  "name": "Hot Corn Dip",
  "subtitle": "A warm, creamy dip with corn, tomatoes, and green chiles",
  "description": "Combine two kinds of corn, tomatoes with green chiles, softened cream cheese, and simple seasonings, then bake until hot and creamy.",
  "meal_type": "sauce",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "white-corn",
      "item": "white corn",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, drained"
    },
    {
      "ingredient_id": "yellow-corn",
      "item": "yellow corn",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce, drained"
    },
    {
      "ingredient_id": "tomatoes-with-green-chile-peppers",
      "item": "tomatoes with green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce, diced, drained"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, diced and softened"
    },
    {
      "ingredient_id": "chili-powder",
      "item": "chili powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fresh-cilantro-to-taste",
      "item": "fresh cilantro to taste",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir together the drained white corn, yellow corn, and tomatoes with green chile peppers. Add the softened cream cheese, chili powder, garlic powder, and chopped cilantro, mixing until evenly combined."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a baking dish and bake for 30 minutes, until hot and creamy throughout.",
      "timer_minutes": 30
    }
  ],
