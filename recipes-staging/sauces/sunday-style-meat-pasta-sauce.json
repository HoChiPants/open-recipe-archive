  "id": "sunday-style-meat-pasta-sauce",
  "name": "Sunday-Style Meat Pasta Sauce",
  "subtitle": "A rich, slow-simmered sauce with beef, pork, and chicken",
  "description": "Roasted meats and aromatics deepen a tomato sauce that simmers until tender, then finishes with cheese, parsley, and gentle heat.",
  "meal_type": "sauce",
