  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Rub the meats with part of the olive oil and arrange them in a roasting pan."
    },
    {
      "step": 2,
      "text": "Roast until browned, about 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 3,
      "text": "Heat the remaining olive oil in a large oven-safe pot over medium heat. Add the beef shank, diced onion, and a pinch of salt; cook for 5 minutes. Add the garlic and stir for 1 minute.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Add the crushed tomatoes, divided water, and tomato paste. Return the beef, ribs, and chicken to the pot, adding the remaining tomato paste and water as needed to incorporate all the listed ingredients."
    },
    {
      "step": 5,
      "text": "Stir in the measured salt, black pepper, red pepper flakes, grated cheese, and parsley."
    },
    {
      "step": 6,
      "text": "Cover and cook at a gentle simmer for about 4 hours, until the meats are tender. Confirm the chicken reaches 165°F and the other meats reach a safe temperature; whole cuts of beef and pork should reach 145°F followed by a 3-minute rest.",
      "timer_minutes": 240
    },
    {
      "step": 7,
      "text": "Transfer the meats to a platter, let them rest briefly, and serve the sauce with the meat or over pasta."
    }
  ],
