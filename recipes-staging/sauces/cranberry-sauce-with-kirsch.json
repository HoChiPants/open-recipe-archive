  "instructions": [
    {
      "step": 1,
      "text": "Combine the light brown soft sugar, kirsch, and cherry juice in a saucepan. Heat gently, stirring until the sugar dissolves."
    },
    {
      "step": 2,
      "text": "Add the cranberries and cook for 3 minutes, stirring occasionally.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Simmer for 10 minutes, stirring occasionally, until the cranberries soften and the sauce thickens.",
      "timer_minutes": 10
    }
