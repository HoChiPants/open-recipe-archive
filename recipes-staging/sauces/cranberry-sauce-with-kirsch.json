  "id": "cranberry-sauce-with-kirsch",
  "name": "Cranberry Sauce with Kirsch",
  "subtitle": "A tart cranberry condiment with cherry notes",
  "description": "A quick cranberry sauce made by simmering cranberries with brown sugar, kirsch, and cherry juice until thickened.",
  "meal_type": "sauce",
