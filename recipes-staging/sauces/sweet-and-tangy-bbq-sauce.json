  "instructions": [
    {
      "step": 1,
      "text": "Warm the butter and Worcestershire sauce in a saucepan over medium heat. Add the minced onion and cook, stirring occasionally, until tender.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the ketchup, cider vinegar, water, apple juice, brown sugar, molasses, honey, dry mustard powder, chili powder, garlic powder, and ground cayenne pepper."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a gentle simmer, then cook uncovered, stirring occasionally, until thickened.",
      "timer_minutes": 30
    }
