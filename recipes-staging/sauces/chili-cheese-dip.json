  "id": "chili-cheese-dip",
  "name": "Chili Cheese Dip",
  "subtitle": "A warm, creamy dip for tortilla chips",
  "description": "Combine softened cream cheese, beanless chili, and shredded Cheddar, then microwave until hot and melted. Serve with tortilla chips.",
  "meal_type": "sauce",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "chili-without-beans",
      "item": "chili without beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "15 ounce"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 16,
      "unit": "ounces",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "nacho-flavor-tortilla-chips",
      "item": "nacho-flavor tortilla chips",
      "quantity": 1,
      "unit": "package",
      "preparation": "13.5 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened cream cheese until smooth, then whisk in the chili and half of the Cheddar."
    },
    {
      "step": 2,
      "text": "Spread the mixture in a microwave-safe dish and layer the remaining Cheddar over the top."
    },
    {
      "step": 3,
      "text": "Microwave for 5 minutes, or until heated through and the cheese is melted.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Serve warm with tortilla chips."
    }
  ],
