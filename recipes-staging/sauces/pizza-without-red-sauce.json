  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven according to the pizza crust instructions and place the unbaked crust on a pizza pan or baking sheet."
    },
    {
      "step": 2,
      "text": "Stir together the melted butter, olive oil, garlic, pesto, basil, oregano, Parmesan, and feta until combined."
    },
    {
      "step": 3,
      "text": "Spread the mixture over the crust, then arrange the tomato, spinach, onion, and jalapeno on top."
    },
    {
      "step": 4,
      "text": "Scatter the Parmesan and feta over the vegetables."
    },
    {
      "step": 5,
      "text": "Bake until the crust is cooked through and lightly browned, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Slice and serve warm."
    }
