  "id": "asparagus-dippers-with-pea-mint-dip",
  "name": "Asparagus Dippers with Pea-Mint Dip",
  "subtitle": "Tender asparagus with a bright, creamy green dip",
  "description": "Wrap asparagus with bacon if using, bake until tender, and serve with a smooth pea, mint, ricotta, and lemon dip.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "700g-asparagus-depending-on-size-thicker-spears-work-best",
      "item": "700g asparagus depending on size (thicker spears work best)",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "streaky-bacon-rashers-or-1-rasher-per-2-spears-of-asparagus-optional",
      "item": "streaky bacon rashers or 1 rasher per 2 spears of asparagus (optional)",
      "quantity": 8,
      "optional": true
    },
    {
      "ingredient_id": "fresh-or-frozen-peas-defrosted-if-frozen",
      "item": "fresh or frozen peas (defrosted if frozen)",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "handful-of-mint-leaves-from-about-2-3-sprigs",
      "item": "handful of mint leaves (from about 2-3 sprigs)"
    },
    {
      "ingredient_id": "ricotta",
      "item": "ricotta",
      "quantity": 150,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-1-2-zested",
      "item": "lemon 1/2 zested",
      "quantity": 1,
      "preparation": "juiced"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra virgin olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "smoked-paprika",
      "item": "smoked paprika",
      "quantity": "1/2",
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Trim the asparagus. If using bacon, cut the rashers as needed and wrap them around the spears."
    },
    {
      "step": 2,
      "text": "Preheat the oven and arrange the prepared asparagus on a baking tray."
    },
    {
      "step": 3,
      "text": "Bake for 20 minutes, until the asparagus is tender and the bacon is cooked through if used.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Cook the peas in boiling water for 2 minutes, then drain.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Blend the peas and mint with the ricotta, lemon juice and zest, olive oil, and smoked paprika until smooth. Adjust with the remaining lemon as needed."
    },
    {
      "step": 6,
      "text": "Serve the baked asparagus with the pea-mint dip."
    }
  ],
