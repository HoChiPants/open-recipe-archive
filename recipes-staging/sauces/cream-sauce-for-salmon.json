  "id": "cream-sauce-for-salmon",
  "name": "Cream Sauce for Salmon",
  "subtitle": "Tender salmon with a quick lemon-dill cream sauce",
  "description": "Pan-cooked salmon served with a silky cream sauce brightened with lemon and dill.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "4-ounce-salmon-fillets",
      "item": "(4 ounce) salmon fillets",
      "quantity": 2
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "meyer-lemon-juice",
      "item": "Meyer lemon juice",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "dried-dill-weed",
      "item": "dried dill weed",
      "quantity": 0.25,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the salmon with salt and ground black pepper."
    },
    {
      "step": 2,
      "text": "Melt half of the butter in a skillet over medium heat. Add the salmon and cook for 7 minutes, turning as needed, until the fish reaches 145°F or is opaque and flakes easily. Transfer to serving plates and rest for 5 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Melt the remaining butter in the skillet. Add the garlic and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Whisk in the heavy cream and cook for 2 minutes, then stir in the Meyer lemon juice and dried dill weed.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Spoon the sauce over the salmon and serve."
    }
  ],
