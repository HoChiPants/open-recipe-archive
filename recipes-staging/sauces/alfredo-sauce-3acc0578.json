  "id": "alfredo-sauce-3acc0578",
  "name": "Alfredo Sauce",
  "subtitle": "A creamy Parmesan sauce ready in minutes",
  "description": "Melt butter with cream cheese, milk, garlic, and Parmesan for a smooth, savory sauce with a light pepper finish.",
  "meal_type": "sauce",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 6,
      "unit": "ounces"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Whisk in the cream cheese, garlic powder, and Parmesan until smooth."
    },
    {
      "step": 3,
      "text": "Gradually add the milk, whisking until combined and smooth."
    },
    {
      "step": 4,
      "text": "Stir in the black pepper and continue heating until the sauce is smooth and warmed through."
    },
    {
      "step": 5,
      "text": "Serve immediately."
    }
  ],
