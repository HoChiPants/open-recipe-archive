  "id": "hollandaise-sauce",
  "name": "Hollandaise Sauce",
  "subtitle": "A quick, creamy sauce with lemon and butter",
  "description": "Whisk egg yolks with lemon juice, milk, and seasoning, then blend in melted butter and microwave until thick and safely heated.",
  "meal_type": "sauce",
