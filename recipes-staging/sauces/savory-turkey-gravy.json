  "id": "savory-turkey-gravy",
  "name": "Savory Turkey Gravy",
  "subtitle": "Smooth, seasoned gravy for a crowd",
  "description": "A simple turkey-stock gravy thickened with flour and finished with savory seasonings.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "turkey-stock",
      "item": "turkey stock",
      "quantity": 5,
      "unit": "cups"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "poultry-seasoning",
      "item": "poultry seasoning",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "celery-salt",
      "item": "celery salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring the turkey stock to a gentle simmer in a saucepan."
    },
    {
      "step": 2,
      "text": "Whisk the water and flour together until smooth."
    },
    {
      "step": 3,
      "text": "Gradually whisk the flour mixture into the simmering stock."
    },
    {
      "step": 4,
      "text": "Whisk in the poultry seasoning, salt, ground black pepper, and celery salt."
    },
    {
      "step": 5,
      "text": "Cook at a gentle simmer, whisking often, until thickened and the gravy reaches 165°F on a food thermometer.",
      "timer_minutes": 10
    }
  ],
