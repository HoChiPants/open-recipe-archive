  "id": "hearts-of-palm-dip",
  "name": "Hearts of Palm Dip",
  "subtitle": "A warm, creamy dip with tender hearts of palm and melted cheese.",
  "description": "Combine hearts of palm, cheeses, green onion, sour cream, and mayonnaise, then bake until hot and lightly browned. Serve warm.",
  "meal_type": "sauce",
  "cuisine": "American",
