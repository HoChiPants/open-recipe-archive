    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.75,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the hearts of palm, mozzarella, Parmesan, green onion, sour cream, and mayonnaise together until evenly combined."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a baking dish and spread it into an even layer."
    },
    {
      "step": 4,
      "text": "Bake for 20 minutes, until hot throughout and lightly browned on top.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
