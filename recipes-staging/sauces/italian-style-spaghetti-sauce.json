  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large pot over medium heat. Add the onion and garlic and cook until tender."
    },
    {
      "step": 2,
      "text": "Stir in the crushed tomatoes, tomato paste, and Merlot wine until evenly combined."
    },
    {
      "step": 3,
      "text": "Add the sliced Italian sausage. Bring the sauce to a gentle simmer, then cook for 45 minutes, stirring occasionally, until the sausage reaches 160°F internally and the sauce has thickened.",
      "timer_minutes": 45
    }
