  "id": "italian-style-spaghetti-sauce",
  "name": "Italian-Style Spaghetti Sauce",
  "subtitle": "Tomato sauce with sliced Italian sausage",
  "description": "A rich tomato sauce simmered with wine, garlic, onion, and Italian sausage.",
