  "id": "teriyaki-sauce",
  "name": "Teriyaki Sauce",
  "subtitle": "A sweet, tangy sauce with savory ginger and garlic notes",
  "description": "A quick stovetop sauce that thickens as it cooks and works well with rice, vegetables, or proteins.",
  "meal_type": "sauce",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
