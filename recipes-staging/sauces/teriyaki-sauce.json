    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "low-sodium-soy-sauce",
      "item": "low-sodium soy sauce",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cider-vinegar",
      "item": "cider vinegar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "onion-powder",
      "item": "onion powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-ginger",
      "item": "ground ginger",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the soy sauce, sugar, cider vinegar, water, garlic powder, onion powder, and ginger to a saucepan. Warm until the mixture begins to simmer."
    },
    {
      "step": 2,
      "text": "Whisk in the cornstarch until evenly dispersed, then cook the sauce while stirring.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Continue simmering until the sauce is thickened.",
      "timer_minutes": 10
    }
  ],
