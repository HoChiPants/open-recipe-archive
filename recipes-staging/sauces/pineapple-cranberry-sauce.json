      "item": "water as needed"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-cranberries",
      "item": "fresh cranberries",
      "quantity": 1,
      "unit": "bag",
      "preparation": "12 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Drain the pineapple, reserving the juice. Add enough water to the juice to make 1 cup liquid."
    },
    {
      "step": 2,
      "text": "In a saucepan, combine the pineapple, measured juice mixture, and sugar. Bring to a simmer over medium heat, stirring to dissolve the sugar."
    },
    {
      "step": 3,
      "text": "Stir in the cranberries and simmer until they begin to burst and the sauce thickens slightly.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Transfer to a serving bowl and cool before serving.",
      "timer_minutes": 30
    }
  ],
