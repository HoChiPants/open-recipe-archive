  "id": "pineapple-cranberry-sauce",
  "name": "Pineapple Cranberry Sauce",
  "subtitle": "A sweet-tart fruit sauce for holiday meals.",
  "description": "Cranberries are simmered with pineapple and sugar, then cooled until ready to serve.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
