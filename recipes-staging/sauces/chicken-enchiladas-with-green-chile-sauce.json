  "id": "chicken-enchiladas-with-green-chile-sauce",
  "name": "Chicken Enchiladas with Green Chile Sauce",
  "subtitle": "Corn tortillas filled with chicken, cheese, and a creamy chile sauce",
  "description": "Softened corn tortillas are filled with seasoned chicken, onion, and cheese, then covered with a creamy green chile sauce and baked until hot and melted.",
  "meal_type": "sauce",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "corn-tortillas",
      "item": "corn tortillas",
      "quantity": 12
    },
    {
      "ingredient_id": "boneless-skinless-chicken-breast-halves",
      "item": "boneless skinless chicken breast halves",
      "quantity": 3,
      "preparation": "cooked, shredded"
    },
    {
      "ingredient_id": "monterey-jack-cheese",
      "item": "Monterey Jack cheese",
      "quantity": 12,
      "unit": "ounces",
      "preparation": "shredded, divided"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.75,
      "unit": "cup",
      "preparation": "minced"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "green-chiles",
      "item": "green chiles",
      "quantity": 1,
      "unit": "can",
      "preparation": "4 ounce, chopped, drained"
    },
    {
