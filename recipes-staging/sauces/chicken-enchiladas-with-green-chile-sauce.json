      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F. Lightly oil a baking dish."
    },
    {
      "step": 2,
      "text": "Warm the vegetable oil in a skillet. Briefly sauté the tortillas one at a time until pliable, adding more oil as needed, then drain them."
    },
    {
      "step": 3,
      "text": "Combine the shredded chicken, minced onion, and part of the Monterey Jack cheese for the filling."
    },
    {
      "step": 4,
      "text": "Melt the butter in a saucepan. Whisk in the flour, then gradually whisk in the chicken broth. Cook, stirring, until the sauce thickens."
    },
    {
      "step": 5,
      "text": "Remove the sauce from the heat and stir in the sour cream, green chiles, and green onions."
    },
    {
      "step": 6,
      "text": "Fill each tortilla with the chicken mixture, roll it closed, and arrange the rolls seam-side down in the baking dish."
    },
    {
      "step": 7,
      "text": "Pour the sauce over the enchiladas and bake for 20 minutes, until hot throughout. For food safety, the center should reach 165°F if reheating cooked chicken.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "Top with the remaining Monterey Jack cheese and return to the oven briefly, until melted."
    },
    {
      "step": 9,
      "text": "Garnish with fresh cilantro, remaining green onions, onion, and green chiles."
    }
  ],
