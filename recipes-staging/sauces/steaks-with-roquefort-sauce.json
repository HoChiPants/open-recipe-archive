{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "steaks-with-roquefort-sauce",
  "name": "Steaks With Roquefort Sauce",
  "subtitle": "Seared sirloin with a creamy blue-cheese pan sauce",
  "description": "Sear sirloin steaks, then finish a brandy, cream, and Roquefort sauce in the same pan. Garnish with parsley and serve warm.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "5-ounce-beef-sirloin-steaks",
      "item": "(5 ounce) beef sirloin steaks",
      "quantity": 4
    },
    {
      "ingredient_id": "salt-and-coarsely-ground-black-pepper-to-taste",
      "item": "salt and coarsely ground black pepper to taste"
    },
    {
      "ingredient_id": "brandy",
      "item": "brandy",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "roquefort-cheese",
      "item": "Roquefort cheese",
      "quantity": 3,
      "unit": "ounces",
      "preparation": "crumbled"
    },
    {
      "ingredient_id": "italian-flat-leaf-parsley",
      "item": "Italian flat leaf parsley",
      "preparation": "for garnish"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter with the olive oil in a large skillet over medium-high heat."
    },
    {
      "step": 2,
      "text": "Season the steaks with salt and coarsely ground black pepper. Add them to the hot skillet and cook for about 5 minutes, turning as needed, until a thermometer registers 145°F for medium-rare. Transfer to a plate and rest for 3 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the brandy to the skillet and stir to loosen the browned bits."
    },
    {
      "step": 4,
      "text": "Whisk in the heavy cream and cook, stirring, until the sauce thickens."
    },
    {
      "step": 5,
      "text": "Stir in the Roquefort cheese until melted and smooth."
    },
    {
      "step": 6,
      "text": "Return the steaks to the skillet briefly to coat with sauce, then garnish with Italian flat leaf parsley."
    }
  ],
