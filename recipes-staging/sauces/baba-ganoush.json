  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "baba-ganoush",
  "name": "Baba ganoush",
  "subtitle": "Smoky aubergine dip with tahini and lemon",
  "description": "A creamy Middle Eastern aubergine dip finished with olive oil, warm spices, lemon, and parsley. Serve with flatbreads or pitta bread.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "aubergines",
      "item": "aubergines",
      "quantity": 2,
      "unit": "medium"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra virgin olive oil",
      "quantity": 40,
      "unit": "ml"
    },
    {
      "ingredient_id": "ground-coriander",
      "item": "ground coriander",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "tahini",
      "item": "tahini",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "bunch-parsley-finely-chopped",
      "item": "bunch parsley finely chopped",
      "quantity": "1/2",
      "unit": "small"
    },
    {
      "ingredient_id": "flatbreads-or-pitta-bread-to-serve",
      "item": "flatbreads or pitta bread to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill or broiler."
    },
    {
      "step": 2,
      "text": "Grill the aubergines for 40 minutes, turning as needed, until the skins are charred and the flesh is completely soft.",
      "timer_minutes": 40
    },
    {
      "step": 3,
      "text": "Set the aubergines aside until cool enough to handle, then scoop the flesh from the skins."
    },
    {
      "step": 4,
      "text": "Mash the aubergine flesh with the olive oil, coriander, cumin, tahini, lemon juice, and half of the parsley until combined."
    },
    {
      "step": 5,
      "text": "Transfer to a serving bowl and finish with the remaining parsley. Serve with flatbreads or pitta bread."
    }
  ],
