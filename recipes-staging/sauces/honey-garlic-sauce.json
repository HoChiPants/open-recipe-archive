  "id": "honey-garlic-sauce",
  "name": "Honey Garlic Sauce",
  "subtitle": "A quick sweet-savory sauce with fresh garlic",
  "description": "Warm garlic in oil, then simmer it with ketchup, honey, and soy sauce until blended and glossy.",
  "meal_type": "sauce",
  "cuisine": "Asian",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "ketchup",
      "item": "ketchup",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the canola oil in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Add the minced garlic and stir for 4 minutes, until fragrant and lightly softened.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Stir in the ketchup, honey, and soy sauce until evenly combined."
    },
    {
      "step": 4,
      "text": "Cook for 5 minutes, stirring occasionally, until the sauce is hot and slightly thickened.",
      "timer_minutes": 5
    }
  ],
