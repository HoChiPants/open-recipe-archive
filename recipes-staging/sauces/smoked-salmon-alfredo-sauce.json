{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "smoked-salmon-alfredo-sauce",
  "name": "Smoked Salmon Alfredo Sauce",
  "subtitle": "A creamy sauce with smoked salmon and fresh tomato",
  "description": "A rich, savory cream sauce finished with smoked salmon, tomato, parsley, and black pepper.",
  "meal_type": "sauce",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 0.25,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "smoked-salmon",
      "item": "smoked salmon",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "pint"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomato",
      "quantity": 1,
      "preparation": "diced"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "ground-black-pepper-to-taste",
      "item": "ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium heat. Add the onion and sauté until softened."
    },
    {
      "step": 2,
      "text": "Add the smoked salmon and heat until warmed through and opaque, reaching 145°F if using a thermometer."
    },
    {
      "step": 3,
      "text": "Whisk in the heavy whipping cream and cook gently, stirring often, until the sauce thickens."
    },
    {
      "step": 4,
      "text": "Add the remaining heavy whipping cream and whisk until smooth and thick."
    },
    {
      "step": 5,
      "text": "Stir in the diced tomato and chopped parsley. Season with black pepper to taste and serve warm."
    }
  ],
