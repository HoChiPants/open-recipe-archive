  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a saucepan over medium heat. Add the jalapeños and cook until tender, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the garlic and adobo sauce, then add the raspberries and cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Mix in the apple cider vinegar, salt, brown sugar, and white sugar."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a simmer and cook until thickened, about 15 minutes, stirring occasionally.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Transfer the sauce to a container and let it cool for 20 minutes before serving.",
      "timer_minutes": 20
    }
