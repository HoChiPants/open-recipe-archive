  "id": "basil-pesto-97f35a81",
  "name": "Basil Pesto",
  "subtitle": "A bright, savory sauce for pasta, vegetables, and more.",
  "description": "Fresh basil, garlic, pine nuts, cheese, and olive oil form a smooth, aromatic Italian sauce.",
  "meal_type": "sauce",
  "cuisine": "Italian",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "bunch-fresh-basil",
      "item": "bunch fresh basil",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "pine-nuts",
      "item": "pine nuts",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "finely-grated-parmigiano-reggiano-cheese",
      "item": "finely grated Parmigiano-Reggiano cheese",
      "quantity": 2,
      "unit": "ounces"
    },
    {
      "ingredient_id": "mild-extra-virgin-olive-oil",
      "item": "mild extra-virgin olive oil",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pound the garlic and kosher salt together until they form a rough paste.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Add the bunch fresh basil gradually, bruising and grinding the leaves until a coarse green paste forms.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Work in the pine nuts until evenly incorporated."
    },
    {
      "step": 4,
      "text": "Transfer the finely grated Parmigiano-Reggiano cheese to the mixture, then stir and work it in until blended.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Gradually stir in the mild extra-virgin olive oil, then transfer the pesto to a serving bowl."
    }
  ],
