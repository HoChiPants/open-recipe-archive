  },
  "ingredients": [
    {
      "ingredient_id": "fresh-cranberries",
      "item": "fresh cranberries",
      "quantity": 1,
      "unit": "package",
      "preparation": "12 ounce"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-cinnamon",
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-allspice",
      "item": "ground allspice",
      "quantity": 0.125,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fresh-blueberries",
      "item": "fresh blueberries",
      "quantity": 1,
      "unit": "pint"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Sort and rinse the cranberries, removing any stems or damaged berries."
    },
    {
      "step": 2,
      "text": "Combine the water and sugar in a saucepan and bring to a boil over medium heat."
    },
    {
      "step": 3,
      "text": "Add the cranberries and simmer until they burst and the mixture begins to thicken.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Stir in the cinnamon, nutmeg, and allspice."
    },
    {
      "step": 5,
      "text": "Add the blueberries and cook until the berries soften and the sauce is well combined."
    },
    {
      "step": 6,
      "text": "Cool, then refrigerate until chilled before serving."
    }
  ],
