  "id": "blueberry-cranberry-sauce",
  "name": "Blueberry Cranberry Sauce",
  "subtitle": "A spiced berry sauce for serving alongside savory dishes",
  "description": "Cranberries and blueberries simmer with warm spices for a colorful, lightly tart sauce.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
