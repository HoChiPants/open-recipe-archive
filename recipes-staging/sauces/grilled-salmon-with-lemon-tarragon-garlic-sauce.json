  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill. Lightly coat the salmon with olive oil and season with salt and pepper."
    },
    {
      "step": 2,
      "text": "Whisk the mayonnaise, Dijon mustard, tarragon, lemon zest, lemon juice, and garlic until smooth. Season with salt and pepper, then set aside."
    },
    {
      "step": 3,
      "text": "Grill the salmon for 10 minutes, or until it reaches 145°F internally and flakes easily with a fork.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Transfer the salmon to plates and spoon the sauce over the fillets."
    }
  ],
