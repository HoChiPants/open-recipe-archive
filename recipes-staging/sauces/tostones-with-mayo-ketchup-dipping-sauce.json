  "id": "tostones-with-mayo-ketchup-dipping-sauce",
  "name": "Tostones with Mayo Ketchup Dipping Sauce",
  "subtitle": "Crisp twice-fried green plantains with a garlicky dip",
  "description": "Green plantains are fried until tender, flattened, and fried again until crisp, then served with a chilled mayonnaise-ketchup sauce.",
  "meal_type": "sauce",
  "cuisine": "Mexican",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "ketchup",
      "item": "ketchup",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "clove-garlic",
      "item": "clove garlic",
      "quantity": 1,
      "unit": "large",
      "preparation": "pressed"
    },
    {
      "ingredient_id": "canola-oil-for-frying",
      "item": "canola oil for frying",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "green-plantains",
      "item": "green plantains",
      "quantity": 2,
      "preparation": "peeled and cut into 1 1/2-inch chunks"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir together the mayonnaise, ketchup, pressed garlic, and garlic salt. Cover and chill for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 2,
      "text": "Heat the canola oil to 350°F in a deep, heavy pan."
    },
    {
      "step": 3,
      "text": "Fry the plantain chunks for 7 minutes, turning as needed. Drain and let cool briefly.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Flatten each plantain chunk into a thick round."
    },
    {
      "step": 5,
      "text": "Fry the flattened plantains for 7 minutes, turning once, until crisp and golden. Drain well.",
      "timer_minutes": 7
    },
    {
      "step": 6,
      "text": "Serve the tostones with the chilled dipping sauce."
    }
  ],
