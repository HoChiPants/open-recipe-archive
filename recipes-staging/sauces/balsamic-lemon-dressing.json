  "instructions": [
    {
      "step": 1,
      "text": "Whisk the balsamic vinegar, lemon pepper, brown sugar, and lemon juice until the sugar is mostly dissolved."
    },
    {
      "step": 2,
      "text": "Transfer the mixture to a jar or cruet, add the olive oil, and cover securely."
    },
    {
      "step": 3,
      "text": "Shake until blended, then transfer to a serving container."
    }
