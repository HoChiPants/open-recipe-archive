  "id": "balsamic-lemon-dressing",
  "name": "Balsamic Lemon Dressing",
  "subtitle": "A sweet-tart vinaigrette for salads and vegetables",
  "description": "Combine balsamic vinegar, lemon pepper, brown sugar, and lemon juice, then blend with olive oil for a quick dressing.",
  "meal_type": "sauce",
