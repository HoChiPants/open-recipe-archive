  "id": "beer-cheese-pretzel-dip",
  "name": "Beer Cheese Pretzel Dip",
  "subtitle": "A chilled, creamy cheese dip with beer and mild spice.",
  "description": "Blend softened cream cheese with ranch seasoning and shredded Cheddar, then loosen with beer and season to taste. Chill before serving.",
  "meal_type": "sauce",
  "cuisine": "American",
