    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "dry-ranch-salad-dressing-mix",
      "item": "dry ranch salad dressing mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1 ounce"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "beer",
      "item": "beer",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "seasoned-salt-to-taste",
      "item": "seasoned salt to taste"
    },
    {
      "ingredient_id": "cayenne-pepper-to-taste",
      "item": "cayenne pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the softened cream cheese, ranch dressing mix, and shredded Cheddar until evenly blended."
    },
    {
      "step": 2,
      "text": "Stir in the beer gradually until the dip reaches the desired consistency."
    },
    {
      "step": 3,
      "text": "Season with seasoned salt and cayenne pepper to taste."
    },
    {
      "step": 4,
      "text": "Cover and chill for 60 minutes before serving.",
      "timer_minutes": 60
    }
