  "id": "mustard-sauce-for-ham",
  "name": "Mustard Sauce for Ham",
  "subtitle": "Tangy mustard sauce with tarragon vinegar",
  "description": "A creamy, sharp sauce suited to ham and other savory dishes.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "mustard-powder",
      "item": "mustard powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "egg-yolks",
      "item": "egg yolks",
      "quantity": 2
    },
    {
      "ingredient_id": "tarragon-vinegar",
      "item": "tarragon vinegar",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the flour, sugar, and mustard powder together in a saucepan."
    },
    {
      "step": 2,
      "text": "Gradually whisk in the milk and egg yolks until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the tarragon vinegar."
    },
    {
      "step": 4,
      "text": "Cook over medium heat, stirring constantly, until thickened and the sauce reaches 160°F.",
      "timer_minutes": 10
    }
  ],
