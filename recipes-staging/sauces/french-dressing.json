  "id": "french-dressing",
  "name": "French Dressing",
  "subtitle": "Sweet-tangy dressing with onion and garlic",
  "description": "A smooth, sweet-tart dressing made by whisking oil, ketchup, vinegar, and aromatics together.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "ketchup",
      "item": "ketchup",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "vinegar",
      "item": "vinegar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "small",
      "preparation": "finely chopped"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the white sugar, ketchup, vinegar, finely chopped onion, and Worcestershire sauce in a bowl until smooth."
    },
    {
      "step": 2,
      "text": "Mince or press the garlic and whisk it into the mixture."
    },
    {
      "step": 3,
      "text": "Gradually whisk in the vegetable oil until the dressing is evenly blended."
    },
    {
      "step": 4,
      "text": "Transfer to a covered container and chill before serving."
    }
  ],
