  "instructions": [
    {
      "step": 1,
      "text": "Place the brisket in a covered dish or resealable bag with 2 tablespoons liquid smoke. Refrigerate for 8 hours.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Combine the onion salt, garlic salt, celery salt, and salt and pepper. Rub the seasoning over the brisket and wrap it securely in foil."
    },
    {
      "step": 3,
      "text": "Heat the oven to 300°F. Place the wrapped brisket in a baking pan and bake for 6 hours, or until tender and the thickest part reaches at least 145°F. Rest for 3 minutes before slicing.",
      "timer_minutes": 360
    },
    {
      "step": 4,
      "text": "While the brisket rests, combine the brown sugar, ketchup, butter, water, 1 tablespoon liquid smoke, Worcestershire sauce, mustard powder, and salt and pepper in a saucepan. Stir until boiling, then remove from the heat."
    },
    {
      "step": 5,
      "text": "Slice the brisket across the grain, spoon the sauce over it, and return it to the oven briefly until heated through."
    }
  ],
