  "id": "brisket-with-bbq-sauce",
  "name": "Brisket with BBQ Sauce",
  "subtitle": "Slow-baked beef with a savory barbecue finish",
  "description": "Seasoned brisket is slow-baked until tender, sliced, and served with a tangy brown-sugar barbecue sauce.",
