  "instructions": [
    {
      "step": 1,
      "text": "Add the water, brown sugar, orange juice, cinnamon, ginger, zest, salt, cloves, and allspice to a saucepan."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a simmer and cook until the sugar dissolves and the spiced syrup is fragrant.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the cranberries, then simmer until many berries burst and the sauce thickens.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Remove the saucepan from the heat and transfer the sauce to a serving bowl."
    },
    {
      "step": 5,
      "text": "Discard the cinnamon stick and let the sauce cool before serving."
    }
  ],
