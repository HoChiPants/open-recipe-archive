  "id": "easy-enchilada-sauce",
  "name": "Easy Enchilada Sauce",
  "subtitle": "A smooth, warmly spiced sauce for enchiladas",
  "description": "Build a quick roux with chili powder and aromatics, then simmer it with tomato sauce until thickened.",
  "meal_type": "sauce",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "self-rising-flour",
      "item": "self-rising flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "medium-spice-indian-chili-powder",
      "item": "medium-spice Indian chili powder",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "tomato-sauce",
      "item": "tomato sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "onion-salt",
      "item": "onion salt",
      "quantity": 0.75,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the vegetable oil in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Whisk in the flour, chili powder, and garlic powder. Cook, stirring frequently, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Gradually whisk in the water and tomato sauce until smooth."
    },
    {
      "step": 4,
      "text": "Stir in the oregano, cumin, remaining garlic powder, onion salt, and salt."
    },
    {
      "step": 5,
      "text": "Simmer, stirring occasionally, until thickened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Taste and adjust with the onion salt and salt to taste before serving."
    }
  ],
