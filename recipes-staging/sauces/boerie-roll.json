  "instructions": [
    {
      "step": 1,
      "text": "Combine the sliced red onion, red wine vinegar, 100 g caster sugar, and bay leaf. Transfer to a container and chill for 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Heat the rapeseed oil in a pan. Add the chopped white onion, garlic purée, thyme, and two bay leaves; cook until softened, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Stir in 50 g caster sugar and 2 tbsp malt vinegar, then cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the lager, tomato ketchup, 50 ml malt vinegar, Worcestershire sauce, and smooth tomato chilli chutney. Simmer until thickened, about 15 minutes, then remove the bay leaves.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Cook the boerewors on a grill or in a pan until browned and cooked through, reaching 160°F internally.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Warm the brioche buns, place the sausage inside, and top with the sauce and pickled red onion. Serve with optional American mustard."
    }
  ],
