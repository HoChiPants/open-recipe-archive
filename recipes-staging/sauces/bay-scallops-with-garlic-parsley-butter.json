  "id": "bay-scallops-with-garlic-parsley-butter",
  "name": "Bay Scallops with Garlic-Parsley Butter",
  "subtitle": "Tender scallops in a bright, buttery pan sauce",
  "description": "Quickly seared bay scallops are finished with garlic, wine, lemon, parsley, and butter, then served over toasted Italian bread.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "softened"
    },
    {
      "ingredient_id": "thick-slices-italian-bread",
      "item": "thick slices Italian bread",
      "quantity": 4,
      "preparation": "toasted"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1.5,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fresh-or-frozen-bay-scallops",
      "item": "fresh or frozen bay scallops",
      "quantity": 1.5,
      "unit": "pounds",
      "preparation": "thawed, rinsed and patted dry"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fresh-flat-leaf-parsley",
      "item": "fresh flat-leaf parsley",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "cold-butter",
      "item": "cold butter",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "cut into cubes"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "salt-and-ground-black-pepper-to-taste",
      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Spread the softened butter over the toasted bread and set aside."
    },
    {
      "step": 2,
      "text": "Heat the olive oil in a large skillet over medium-high heat. Add the scallops in a single layer and cook, stirring occasionally, until opaque and just cooked through.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the garlic and cook briefly until fragrant."
    },
    {
      "step": 4,
      "text": "Stir in the white wine and lemon juice. Simmer until slightly reduced.",
      "timer_minutes": 1
    },
    {
      "step": 5,
      "text": "Remove the skillet from the heat. Stir in the parsley and cold butter cubes a few at a time until the sauce is smooth. Season with cayenne, salt, and black pepper.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Spoon the scallops and sauce over the toasted bread and serve immediately."
    }
  ],
