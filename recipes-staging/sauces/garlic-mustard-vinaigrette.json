  "id": "garlic-mustard-vinaigrette",
  "name": "Garlic Mustard Vinaigrette",
  "subtitle": "A bright, savory dressing with balanced tang",
  "description": "Whisk together the sweet, salty, tangy, and mustardy elements, then blend in olive oil and pressed garlic for a quick sauce.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "red-wine-vinegar",
      "item": "red wine vinegar",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "pressed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the sugar, salt, vinegar, and mustard together until the sugar and salt are dispersed."
    },
    {
      "step": 2,
      "text": "Whisk in the olive oil until the mixture is evenly blended."
    },
    {
      "step": 3,
      "text": "Stir in the pressed garlic and serve."
    }
  ],
