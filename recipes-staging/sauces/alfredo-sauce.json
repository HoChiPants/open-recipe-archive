  "id": "alfredo-sauce",
  "name": "Alfredo Sauce",
  "subtitle": "A creamy cheese sauce with a hint of nutmeg",
  "description": "Melt butter into cream, blend in Italian cheeses, and finish with egg yolk for a rich, smooth sauce.",
  "meal_type": "sauce",
  "cuisine": "Italian Inspired",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "fluid-ounces-heavy-whipping-cream",
      "item": "fluid ounces heavy whipping cream",
      "quantity": 8
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-romano-cheese",
      "item": "grated Romano cheese",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "egg-yolk",
      "item": "egg yolk",
      "quantity": 1
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the butter in a saucepan over medium-low heat until melted."
    },
    {
      "step": 2,
      "text": "Add the heavy cream, Parmesan, Romano, nutmeg, and salt. Stir gently over low heat until the cheeses melt and the sauce is smooth.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the egg yolk and continue heating gently until fully combined and the sauce reaches 160°F."
    },
    {
      "step": 4,
      "text": "Serve immediately, finishing with the remaining grated Parmesan."
    }
  ],
