  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Warm the olive oil in a skillet. Add the onion and cook for 5 minutes, then add the garlic and cook for 2 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Stir the cooked onion and garlic into the shredded chicken with 1 cup of the cheese, the olives, cilantro, jalapeños, and ¼ cup salsa verde."
    },
    {
      "step": 4,
      "text": "Melt the butter in a saucepan. Whisk in the flour, then gradually whisk in the chicken broth. Cook for 8 minutes, stirring, until thickened.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Whisk the softened cream cheese, sour cream, and ½ cup salsa verde into the sauce until smooth."
    },
    {
      "step": 6,
      "text": "Warm the tortillas briefly in the microwave until pliable."
    },
    {
      "step": 7,
      "text": "Fill each tortilla with the chicken mixture, roll it closed, and arrange the rolls seam-side down in a baking dish. Pour the sauce over them and sprinkle with the remaining cheese."
    },
    {
      "step": 8,
      "text": "Bake for 20 minutes, until bubbling and the center reaches 165°F on a food thermometer.",
      "timer_minutes": 20
    }
  ],
