  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a boil and add the cored tomatoes. Cook for 2 minutes, then cool them until safe to handle.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Prepare the cooled tomatoes for blending, then puree until smooth."
    },
    {
      "step": 3,
      "text": "Transfer the puree to a saucepan and stir in the onion, garlic, oregano, basil, salt, and black pepper."
    },
    {
      "step": 4,
      "text": "Preheat the oven or cooking appliance according to the pizza-making setup while the sauce cooks.",
      "timer_minutes": 90
    },
    {
      "step": 5,
      "text": "Cook the seasoned tomato mixture over low heat until thickened and smooth, about 70 minutes.",
      "timer_minutes": 70
    },
    {
      "step": 6,
      "text": "Use the sauce for pizza."
    }
  ],
