  "id": "fresh-tomato-pizza-sauce",
  "name": "Fresh Tomato Pizza Sauce",
  "subtitle": "A bright, herb-seasoned sauce for homemade pizza",
  "description": "Blanch ripe tomatoes, blend them with aromatics and herbs, then cook the mixture until smooth and concentrated.",
  "meal_type": "sauce",
