  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Season the racks of lamb with salt and ground black pepper. Let them stand for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Mix the Dijon mustard, minced rosemary, cinnamon, and cumin. Coat the meaty sides of the lamb with the mixture."
    },
    {
      "step": 4,
      "text": "Heat the vegetable oil in an ovenproof skillet over medium-high heat. Sear the lamb until browned, then transfer it to a plate."
    },
    {
      "step": 5,
      "text": "Add the sliced shallot and a pinch of salt to the skillet. Cook until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Add the blueberries and cook until they begin to burst, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Pour in the red wine and bring it to a simmer. Return the lamb to the skillet, meaty side up, and season with the ground black pepper."
    },
    {
      "step": 8,
      "text": "Roast until a thermometer inserted into the thickest part reaches 145°F. Transfer the lamb to a cutting board and rest for at least 3 minutes, up to 5 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 9,
      "text": "While the lamb rests, simmer the sauce for about 4 minutes. Stir in the balsamic vinegar, remaining salt and ground black pepper, and butter until melted and smooth.",
      "timer_minutes": 4
    },
    {
      "step": 10,
      "text": "Cut the racks into chops and serve with the blueberry sauce."
    }
  ],
