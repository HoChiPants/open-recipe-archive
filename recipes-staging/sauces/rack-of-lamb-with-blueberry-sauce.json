  "id": "rack-of-lamb-with-blueberry-sauce",
  "name": "Rack of Lamb with Blueberry Sauce",
  "subtitle": "Herb-crusted lamb with a tart berry pan sauce",
  "description": "Roasted racks of lamb are finished with a rosemary-spiced mustard crust and served with a reduced blueberry and red wine sauce.",
  "meal_type": "sauce",
