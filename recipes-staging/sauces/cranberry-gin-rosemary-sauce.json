  "id": "cranberry-gin-rosemary-sauce",
  "name": "Cranberry Gin-Rosemary Sauce",
  "subtitle": "A tart, herb-scented sauce with a bright finish",
  "description": "Fresh or frozen cranberries simmer with sugar, rosemary, and gin until thick and spoonable.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "cranberries-fresh-or-frozen",
      "item": "cranberries fresh or frozen",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "rosemary-sprig",
      "item": "rosemary sprig",
      "unit": "large"
    },
    {
      "ingredient_id": "gin",
      "item": "gin",
      "quantity": 4,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the cranberries, sugar, and rosemary sprig in a saucepan."
    },
    {
      "step": 2,
      "text": "Cook over medium heat for 15 minutes, stirring occasionally, until the cranberries break down and the sauce thickens.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Stir in the gin and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Remove the rosemary sprig and let the sauce cool before serving."
    }
  ],
