  "id": "make-ahead-turkey-gravy",
  "name": "Make-Ahead Turkey Gravy",
  "subtitle": "Rich pan-roasted turkey gravy for serving with a holiday meal",
  "description": "Roasted turkey wings and vegetables create a deeply flavored stock, which is strained and finished with a butter-flour roux.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
