  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Toss the onion, carrots, and celery with the oil, then arrange the vegetables and turkey wings in a roasting pan."
    },
    {
      "step": 2,
      "text": "Roast until the wings and vegetables are browned, about 60 minutes. Transfer them to a large pot.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Pour the 2 tablespoons cold water into the roasting pan and scrape up the browned bits. Add this liquid, the 10 cups cold water, thyme, and garlic to the pot."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a simmer, then cook gently until the stock is richly flavored, about 3 hours. Strain the stock and reserve it; discard the solids or remove the cooked turkey meat for another use.",
      "timer_minutes": 180
    },
    {
      "step": 5,
      "text": "Melt the butter in a saucepan over medium heat. Whisk in the flour and cook, stirring, until the roux is lightly colored, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Gradually whisk the strained stock into the roux. Simmer until the gravy thickens, about 5 minutes, then season with cayenne, salt, and black pepper.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "If serving the turkey meat with the gravy, verify that it reaches 165°F with a food thermometer. Serve hot."
    }
  ],
