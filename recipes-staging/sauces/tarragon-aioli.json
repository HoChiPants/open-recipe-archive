  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "tarragon-aioli",
  "name": "Tarragon Aioli",
  "subtitle": "A bright, herb-flecked garlic mayonnaise",
  "description": "A quick no-cook sauce combining garlic, tarragon, lemon, and a touch of cayenne.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "sliced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "fresh-tarragon",
      "item": "fresh tarragon",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-lemon-juice",
      "item": "fresh lemon juice",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mash the sliced garlic with the kosher salt until it forms a paste."
    },
    {
      "step": 2,
      "text": "Add the chopped tarragon and mix briefly."
    },
    {
      "step": 3,
      "text": "Stir in the mayonnaise and lemon juice until smooth."
    },
    {
      "step": 4,
      "text": "Season with cayenne pepper to taste."
    }
  ],
