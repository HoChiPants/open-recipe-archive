  "id": "chicken-wing-dip",
  "name": "Chicken Wing Dip",
  "subtitle": "A creamy, spicy baked dip with chicken and cheddar",
  "description": "This warm American-style dip combines softened cream cheese, hot pepper sauce, cooked chicken, ranch-style dressing, and cheddar for a rich, scoopable appetizer.",
  "meal_type": "sauce",
  "cuisine": "American",
