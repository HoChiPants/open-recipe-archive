  "instructions": [
    {
      "step": 1,
      "text": "Combine the grated garlic, grated ginger, chopped chilli, ground Sichuan peppercorns, and peanut butter in a bowl."
    },
    {
      "step": 2,
      "text": "Add the dark soy sauce, light soy sauce, black rice vinegar, toasted sesame oil, and golden syrup."
    },
    {
      "step": 3,
      "text": "Whisk until smooth and evenly blended. Serve immediately or refrigerate until needed."
    }
