  "id": "norwegian-butter-sauce-sandefjordsmor",
  "name": "Norwegian Butter Sauce (Sandefjordsmor)",
  "subtitle": "A bright, creamy sauce with lemon and herbs",
  "description": "Reduce lemon juice with cream, then whisk in cold butter for a smooth sauce finished with parsley and cayenne.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 17
  },
  "ingredients": [
    {
      "ingredient_id": "lemon",
      "item": "lemons",
      "quantity": 2,
      "preparation": "juiced"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cold",
      "item": "cold",
      "quantity": 5,
      "unit": "tablespoons",
      "preparation": "unsalted butter, cut into cubes"
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "preparation": "to taste"
    },
    {
      "ingredient_id": "fresh-italian-parsley",
      "item": "fresh Italian parsley",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the lemon juice in a saucepan and simmer for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Whisk in the heavy cream. Continue cooking and whisking until the mixture thickens, about 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Keep the sauce warm over low heat. Add the cold butter cubes gradually, whisking continuously until smooth and emulsified, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Season with salt and cayenne pepper, then whisk in the chopped parsley."
    },
    {
      "step": 5,
      "text": "Serve the sauce warm."
    }
  ],
