  "instructions": [
    {
      "step": 1,
      "text": "Place the onion, 10 cloves, milk, bay leaves, peppercorns, thyme, and garlic in a saucepan. Warm gently until fragrant, then strain, discarding the solids.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Return the infused milk to the pan and add the brioche and butter. Cook gently, stirring, until the bread softens and the mixture thickens.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the double cream and nutmeg, then whisk until smooth. Serve warm."
    }
