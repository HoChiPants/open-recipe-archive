  "instructions": [
    {
      "step": 1,
      "text": "Warm the oil in a saucepan over medium heat. Add the onion and garlic, and cook until the onion is tender.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the mushrooms, 0.5 cup water, wine, bouillon, basil, salt, and pepper. Bring to a simmer and cook gently.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Whisk the remaining 0.25 cup water with the cornstarch in a small bowl. Stir the mixture into the saucepan and continue cooking until the sauce thickens.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "If the bouillon contains poultry or other meat protein, check that the sauce reaches 165°F on a food thermometer before serving."
    }
  ],
