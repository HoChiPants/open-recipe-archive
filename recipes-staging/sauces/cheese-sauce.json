{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "cheese-sauce",
  "name": "Cheese Sauce",
  "subtitle": "Smooth cheddar sauce for dipping, drizzling, or topping",
  "description": "A quick American-style cheddar sauce built from a butter-flour base and finished with seasoned half-and-half.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "half-and-half",
      "item": "half-and-half",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "freshly-ground-black-pepper",
      "item": "freshly ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Whisk in the flour and cook, stirring, for 3 minutes, until the mixture is smooth.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Gradually stir in the half-and-half, then add the Cheddar, salt, black pepper, and cayenne."
    },
    {
      "step": 4,
      "text": "Cook, stirring frequently, for 5 minutes, until the cheese melts and the sauce is smooth.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Remove from the heat and serve."
    }
  ],
