  "instructions": [
    {
      "step": 1,
      "text": "Combine the mirin and soy sauce in a saucepan and bring the mixture to a gentle simmer over medium heat. Cook for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir in the rice vinegar, sesame oil, and sugar."
    },
    {
      "step": 3,
      "text": "Add the minced garlic, ginger, red pepper flakes, and black pepper."
    },
    {
      "step": 4,
      "text": "Reduce the heat and simmer for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Remove from the heat and prepare for use as a sauce or marinade."
    }
