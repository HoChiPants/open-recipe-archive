  "id": "asian-dipping-sauce",
  "name": "Asian Dipping Sauce",
  "subtitle": "Sweet, tangy sauce with savory heat",
  "description": "A quick dipping sauce that balances sweetness, acidity, umami, and gentle chile warmth.",
  "meal_type": "sauce",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 10,
