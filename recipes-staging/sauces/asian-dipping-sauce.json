  "instructions": [
    {
      "step": 1,
      "text": "Stir the water and sugar together until the sugar dissolves."
    },
    {
      "step": 2,
      "text": "Mix in the soy sauce, vinegar, ketchup, lemon juice, chile paste, and sesame oil."
    },
    {
      "step": 3,
      "text": "Stir until the sauce is smooth, then chill before serving."
    }
