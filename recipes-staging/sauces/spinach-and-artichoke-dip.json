  "id": "spinach-and-artichoke-dip",
  "name": "Spinach and Artichoke Dip",
  "subtitle": "A warm, cheesy dip for sharing",
  "description": "A creamy baked dip combining chopped artichokes and spinach with mayonnaise and two cheeses.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 24,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "artichoke-hearts",
      "item": "artichoke hearts",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce, drained and chopped"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed and drained"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "monterey-jack-cheese",
      "item": "Monterey Jack cheese",
      "quantity": 2.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F. Prepare a baking dish for the dip."
    },
    {
      "step": 2,
      "text": "Mix the artichoke hearts, spinach, and mayonnaise until evenly combined."
    },
    {
      "step": 3,
      "text": "Stir together the Monterey Jack and Parmesan cheeses, then fold the cheese mixture into the spinach mixture."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared dish and smooth the top."
    },
    {
      "step": 5,
      "text": "Bake for 15 minutes, until the cheese is melted and the dip is hot throughout.",
      "timer_minutes": 15
    }
  ],
