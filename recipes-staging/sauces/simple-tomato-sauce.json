  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large saucepan over medium heat. Cook the onion and garlic, stirring often, until tender.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Stir in the tomatoes, canned tomato sauce, tomato paste, and water until smooth."
    },
    {
      "step": 3,
      "text": "Add the white sugar, parsley, basil, salt, Italian seasoning, fennel seeds, and black pepper. Bring the sauce to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Reduce the heat as needed to maintain a low simmer. Cook, stirring occasionally, until thickened.",
      "timer_minutes": 58
