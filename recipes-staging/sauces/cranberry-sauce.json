  "id": "cranberry-sauce",
  "name": "Cranberry Sauce",
  "subtitle": "A bright, spiced accompaniment for festive meals",
  "description": "Fresh cranberries simmer with sugar and whole spices, then cool into a make-ahead sauce.",
