  "instructions": [
    {
      "step": 1,
      "text": "Place the cinnamon sticks, cloves, allspice berries, cranberries, and water in a saucepan."
    },
    {
      "step": 2,
      "text": "Bring to a simmer and cook until the cranberries burst and the mixture thickens slightly, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the sugar and cook until dissolved and the sauce is glossy, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Let the sauce cool at room temperature for 30 minutes, then refrigerate until thoroughly chilled, about 8 hours.",
      "timer_minutes": 510
    }
