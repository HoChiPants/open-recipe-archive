  "id": "creamy-corn-and-tomato-dip",
  "name": "Creamy Corn and Tomato Dip",
  "subtitle": "A cool, creamy dip with corn, tomatoes, and green onion.",
  "description": "Mix the ingredients until smooth and well combined, then chill before serving.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 32,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "tomatoes-with-green-chile-peppers",
      "item": "tomatoes with green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce, diced, drained"
    },
    {
      "ingredient_id": "mexican-style-corn",
      "item": "Mexican-style corn",
      "quantity": 1,
      "unit": "can",
      "preparation": "7 ounce, drained"
    },
    {
      "ingredient_id": "green-onion",
      "item": "green onion",
      "quantity": 1,
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened cream cheese and mayonnaise in a mixing bowl until smooth."
    },
    {
      "step": 2,
      "text": "Add the drained tomatoes and corn along with the chopped green onion. Whisk until evenly combined."
    },
    {
      "step": 3,
      "text": "Refrigerate until chilled, then serve."
    }
  ],
