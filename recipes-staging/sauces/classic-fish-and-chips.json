{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "classic-fish-and-chips",
  "name": "Classic Fish and Chips",
  "subtitle": "Crisp battered fish with golden chips and tangy tartare sauce",
  "description": "Prepare crisp potato chips, coat fish in a light batter, and serve with a simple cornichon-caper mayonnaise.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "about-1-litre-sunflower-oil-for-frying",
      "item": "about 1 litre sunflower oil for frying"
    },
    {
      "ingredient_id": "thick-skinless-fillets-of-whiting",
      "item": "thick skinless fillets of whiting",
      "quantity": 2,
      "preparation": "ling, pollock, haddock or cod (about 150g each)"
    },
    {
      "ingredient_id": "maris-piper-potatoes",
      "item": "Maris Piper potatoes",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "malt-vinegar-plus-extra-to-serve",
      "item": "malt vinegar plus extra to serve",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "self-raising-flour-plus-extra-for-dusting",
      "item": "self-raising flour plus extra for dusting",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": 25,
      "unit": "g"
    },
    {
      "ingredient_id": "pinch-of-ground-turmeric",
      "item": "pinch of ground turmeric",
      "unit": "small"
    },
    {
      "ingredient_id": "cold-lager-or-fizzy-water",
      "item": "cold lager or fizzy water",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "cornichons",
      "item": "cornichons",
      "quantity": 4
    },
    {
      "ingredient_id": "capers",
      "item": "capers",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "shallot",
      "item": "shallot",
      "quantity": 1
    },
    {
      "ingredient_id": "handful-of-parsley-leaves-chopped",
      "item": "handful of parsley leaves chopped"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 5,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cut the potatoes into thick chips and rinse or soak briefly in cold water. Drain and dry thoroughly.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mix the mayonnaise with chopped cornichons, capers, shallot, and parsley. Set aside."
    },
    {
      "step": 3,
      "text": "Combine the self-raising flour, cornflour, and turmeric. Whisk in the cold lager or fizzy water to make a smooth batter, then stir in the malt vinegar."
    },
    {
      "step": 4,
      "text": "Heat the sunflower oil in a deep, heavy pot to 350°F. Fry the potatoes in batches until tender and lightly colored, about 10 minutes. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Dust the fish with a little self-raising flour, then coat each fillet in the batter."
    },
    {
      "step": 6,
      "text": "Return the oil to 350°F and fry the battered fish until crisp, cooked through, and opaque, about 4 minutes. Check that the thickest part reaches 145°F and flakes easily.",
      "timer_minutes": 4
    },
    {
      "step": 7,
      "text": "Drain the fish and chips well. Serve immediately with the tartare sauce and extra malt vinegar."
    }
  ],
