  "id": "hot-spinach-artichoke-and-chile-dip",
  "name": "Hot Spinach, Artichoke, and Chile Dip",
  "subtitle": "A creamy baked dip with spinach, artichokes, and mild chile heat.",
  "description": "Combine the cheeses and mayonnaise with the vegetables, then bake until hot and lightly bubbling.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "green-chiles",
      "item": "green chiles",
      "quantity": 1,
      "unit": "can",
      "preparation": "4.5 ounce, chopped, drained"
    },
    {
      "ingredient_id": "freshly-grated-parmesan-cheese",
      "item": "freshly grated Parmesan cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "12-ounce-jar-marinated-artichoke-hearts",
      "item": "(12 ounce) jar marinated artichoke hearts",
      "quantity": 1,
      "preparation": "drained and chopped"
    },
    {
      "ingredient_id": "canned-chopped-jalapeno-peppers",
      "item": "canned chopped jalapeno peppers",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "drained"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "box",
      "preparation": "10 ounce, thawed and drained"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the softened cream cheese, mayonnaise, and Parmesan until smooth."
    },
    {
      "step": 3,
      "text": "Mix in the green chiles, artichokes, jalapeños, and spinach."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish and spread it evenly."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until hot and lightly bubbling.",
      "timer_minutes": 30
    }
  ],
