  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "hot-spinach-and-artichoke-dip",
  "name": "Hot Spinach and Artichoke Dip",
  "subtitle": "A warm, creamy dip with spinach, artichokes, bacon, and Parmesan",
  "description": "A rich baked dip suited to appetizer or snack service.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 8
    },
    {
      "ingredient_id": "marinated-artichoke-hearts",
      "item": "marinated artichoke hearts",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce, quartered, drained"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed and drained"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "8-ounce-container-sour-cream",
      "item": "(8 ounce) container sour cream",
      "quantity": 1
    },
    {
      "ingredient_id": "5-ounce-container-garlic-herb-flavored-cheese-spread",
      "item": "(5 ounce) container garlic-herb flavored cheese spread",
      "quantity": 1
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Cook the bacon for 7 minutes, then let it cool and crumble or chop it.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Stir together the artichoke hearts, spinach, Parmesan, sour cream, garlic-herb cheese spread, and mayonnaise. Fold in the bacon."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish and spread it evenly."
    },
    {
      "step": 5,
      "text": "Bake until lightly browned, about 20 minutes.",
      "timer_minutes": 20
    }
  ],
