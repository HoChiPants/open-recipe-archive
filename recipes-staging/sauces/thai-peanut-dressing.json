  "id": "thai-peanut-dressing",
  "name": "Thai Peanut Dressing",
  "subtitle": "A creamy, tangy sauce with toasted sesame notes",
  "description": "Simmered peanut dressing balanced with soy sauce, brown sugar, vinegar, and fresh mint.",
  "meal_type": "sauce",
  "cuisine": "Thai",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
