      "item": "fresh mint leaves",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cornstarch into the cold water until smooth, then stir in the warm water."
    },
    {
      "step": 2,
      "text": "Combine the peanut butter, soy sauce, brown sugar, white vinegar, and sesame oil in a saucepan and warm over medium heat."
    },
    {
      "step": 3,
      "text": "Simmer gently for 2 minutes, stirring occasionally.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the cornstarch mixture and cook, stirring constantly, until the dressing thickens, about 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Top with the chopped peanuts and mint, then serve warm."
    }
  ],
