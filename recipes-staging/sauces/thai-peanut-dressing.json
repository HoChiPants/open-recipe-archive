    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "cold-water",
      "item": "cold water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "warm-water",
      "item": "warm water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "smooth-peanut-butter",
      "item": "smooth peanut butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
