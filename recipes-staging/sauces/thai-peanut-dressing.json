      "item": "brown sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "white-vinegar",
      "item": "white vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "peanuts",
      "item": "peanuts",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    },
