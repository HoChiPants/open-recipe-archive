  "id": "barbecue-sauce",
  "name": "Barbecue Sauce",
  "subtitle": "Sweet, tangy tomato sauce for grilling and dipping",
  "description": "A smooth, glossy barbecue sauce made by simmering tomatoes, aromatics, brown sugar, vinegar, and Worcestershire sauce.",
  "meal_type": "sauce",
  "cuisine": "British",
  "yield": {
    "quantity": 450,
    "unit": "ml/16fl oz"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "onion-finely-chopped",
      "item": "onion finely chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "can-chopped-tomatoes",
      "item": "can chopped tomatoes",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "garlic-cloves-finely-chopped",
      "item": "garlic cloves finely chopped",
      "quantity": 3
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 85,
      "unit": "g"
    },
    {
      "ingredient_id": "malt-vinegar",
      "item": "malt vinegar",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "tomato-pure-e",
      "item": "tomato purée",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a saucepan over medium heat. Add the onion and garlic and cook until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the chopped tomatoes, brown sugar, malt vinegar, Worcestershire sauce, and tomato purée."
    },
    {
      "step": 3,
      "text": "Bring to a gentle simmer, then cook for 25 minutes, stirring occasionally, until thickened.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Blend until smooth. Cool before using or storing."
    }
  ],
