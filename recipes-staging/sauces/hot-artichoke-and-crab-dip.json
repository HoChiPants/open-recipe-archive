  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the softened cream cheese, mayonnaise, and Parmesan until smooth. Mix in the garlic, artichokes, crabmeat, green onion, red bell pepper, and cayenne."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a baking dish and sprinkle the breadcrumbs evenly over the surface."
    },
    {
      "step": 4,
      "text": "Bake until hot and golden brown, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Garnish with chopped green onion and red bell pepper, and add cayenne to taste."
    }
  ],
