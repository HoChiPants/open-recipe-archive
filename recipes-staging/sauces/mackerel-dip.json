  "id": "mackerel-dip",
  "name": "Mackerel Dip",
  "subtitle": "A creamy, peppery spread served chilled",
  "description": "Combine drained mackerel with onion, hot pepper sauce, seasonings, and mayonnaise for a cool, savory dip.",
