  "id": "crab-rangoon-dip-with-wonton-chips",
  "name": "Crab Rangoon Dip with Wonton Chips",
  "subtitle": "A warm, cheesy crab dip with crisp wonton wrappers",
  "description": "Bake a creamy crab-and-cheese dip, then serve it with crisp wonton chips and a tangy chili garnish.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "bunch-green-onions",
      "item": "bunch green onions",
      "quantity": 1,
      "preparation": "thinly sliced, divided"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "monterey-jack-cheese",
      "item": "Monterey Jack cheese",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "sriracha-sauce",
      "item": "Sriracha sauce",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "lemon-zest",
      "item": "lemon zest",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "imitation-crabmeat",
      "item": "imitation crabmeat",
      "quantity": 8,
      "unit": "ounces"
    },
    {
      "ingredient_id": "sweet-chili-sauce",
      "item": "sweet chili sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sesame-seeds",
      "item": "sesame seeds"
    },
    {
      "ingredient_id": "wonton-wrappers",
      "item": "wonton wrappers",
      "quantity": 1,
      "unit": "package"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Reserve some of the sliced green onions for garnish."
    },
    {
      "step": 2,
      "text": "Stir together the cream cheese, Monterey Jack, Sriracha, soy sauce, lemon zest, lemon juice, sweet chili sauce, and remaining green onions until combined. Fold in the imitation crabmeat."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a baking dish and bake until hot and lightly browned, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "While the dip bakes, combine the reserved green onions with Sriracha, soy sauce, sweet chili sauce, and sesame seeds."
    },
    {
      "step": 5,
      "text": "Heat a skillet or griddle to 350°F and sauté the wonton wrappers in batches until crisp, turning as needed.",
      "timer_minutes": 10
    },
    {
      "step": 6,
      "text": "Serve the hot dip with the crisp wonton chips and the green-onion mixture."
    }
  ],
