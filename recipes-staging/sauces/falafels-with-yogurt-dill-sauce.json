  "instructions": [
    {
      "step": 1,
      "text": "Combine the chickpeas, 0.75 cup panko, potato, onion, crushed garlic, egg, olive oil, cilantro, lemon juice, cumin, salt, and black pepper. Mix until evenly combined."
    },
    {
      "step": 2,
      "text": "Divide the mixture into portions and shape each into a compact patty."
    },
    {
      "step": 3,
      "text": "Place the remaining panko in a shallow dish. Coat each patty on all sides."
    },
    {
      "step": 4,
      "text": "Heat the canola oil in a skillet over medium heat. Fry the patties in batches until golden brown, about 2 minutes per side and 4 minutes total. Check that the centers reach 160°F.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Stir the yogurt, dill, juiced lemon, garlic salt, and white pepper together until smooth and fully set aside for serving."
    },
    {
      "step": 6,
      "text": "Serve the hot falafels with the yogurt-dill sauce."
    }
  ],
