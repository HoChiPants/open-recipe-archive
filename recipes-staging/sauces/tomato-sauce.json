  "id": "tomato-sauce",
  "name": "Tomato Sauce",
  "subtitle": "Slow-simmered sauce for pasta and more",
  "description": "A simple tomato sauce built by gently cooking garlic and tomato paste before a long simmer.",
  "meal_type": "sauce",
