  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large pot over medium heat. Add the garlic and stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Mix in the tomato paste and tomato puree, then cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the crushed tomatoes, black pepper, salt, basil, and sugar. Stir until evenly combined."
    },
    {
      "step": 4,
      "text": "Bring the sauce to a gentle simmer, then cook for 3 hours, stirring occasionally.",
      "timer_minutes": 180
    }
