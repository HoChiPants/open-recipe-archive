  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "zucchini",
      "item": "zucchini",
      "quantity": 4,
      "preparation": "peeled, sliced lengthwise, and sliced"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 2,
      "unit": "teaspoons"
