      "item": "Parmesan cheese",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Add the zucchini and cook for 10 minutes, stirring occasionally, until tender.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the dried oregano and dried basil."
    },
    {
      "step": 4,
      "text": "Add the tomato sauce and stir to combine."
    },
    {
      "step": 5,
      "text": "Simmer for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Stir in the Parmesan cheese and serve warm."
    }
  ],
