  "id": "zucchini-parmesan-with-tomato-sauce",
  "name": "Zucchini Parmesan with Tomato Sauce",
  "subtitle": "Tender zucchini simmered with herbs, tomato sauce, and Parmesan",
  "description": "A simple skillet dish combining sliced zucchini, dried herbs, tomato sauce, and Parmesan cheese.",
  "meal_type": "sauce",
  "cuisine": "American",
