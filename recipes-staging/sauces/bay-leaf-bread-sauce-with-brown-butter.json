  "id": "bay-leaf-bread-sauce-with-brown-butter",
  "name": "Bay Leaf Bread Sauce with Brown Butter",
  "subtitle": "A creamy breadcrumb sauce scented with bay and nutmeg.",
  "description": "Browned butter, aromatics, and infused milk give this smooth bread sauce a rich, savory finish.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
