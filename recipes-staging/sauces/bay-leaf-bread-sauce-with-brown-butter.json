      "item": "double cream (optional)",
      "quantity": 2,
      "unit": "tbsp",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan with the bay leaves. Cook until lightly browned and nutty, then add the onion and garlic."
    },
    {
      "step": 2,
      "text": "Cook the aromatics over moderate heat until softened, about 12 minutes.",
      "timer_minutes": 12
    },
    {
      "step": 3,
      "text": "Pour in the milk and add the nutmeg, cloves, and black pepper. Stir in the breadcrumbs."
    },
    {
      "step": 4,
      "text": "Simmer gently for 6 minutes, stirring occasionally, until thickened.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Whisk in the cream, if using. Remove the cloves and bay leaves before serving, reserving the extra bay leaf as a garnish."
    },
    {
      "step": 6,
      "text": "Serve warm, or cool and reheat gently before transferring to a serving dish."
    }
  ],
