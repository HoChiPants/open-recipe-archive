  "id": "cornmeal-sticks-with-dipping-sauce",
  "name": "Cornmeal Sticks with Dipping Sauce",
  "subtitle": "Crisp fried cornmeal sticks with a tangy dip",
  "description": "Shape a sweet, savory cornmeal mixture into sticks, fry until golden, and serve with a quick mayonnaise-ketchup sauce.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "cornmeal",
      "item": "cornmeal",
      "quantity": 1.5,
      "unit": "cups",
      "preparation": "or as needed"
    },
    {
      "ingredient_id": "vegetable-oil-for-frying",
      "item": "vegetable oil for frying",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "ketchup",
      "item": "ketchup",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic-salt",
      "item": "garlic salt",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring the water to a simmer in a saucepan. Stir in the sugar, butter, salt, and garlic salt, then cook until the sugar dissolves."
    },
    {
      "step": 2,
      "text": "Gradually whisk in the cornmeal until smooth. Stir over gentle heat until the mixture is thick enough to shape, adding cornmeal as needed. Let it cool enough to handle."
    },
    {
      "step": 3,
      "text": "Heat the frying oil to 350°F in a deep, heavy pot or fryer. Use enough oil to allow the sticks to move freely."
    },
    {
      "step": 4,
      "text": "Lightly coat your hands or work surface with the additional vegetable oil. Divide and shape the cornmeal mixture into sticks."
    },
    {
      "step": 5,
      "text": "Fry the sticks in batches until golden brown, turning as needed for even coloring. Avoid crowding the pot."
    },
    {
      "step": 6,
      "text": "Drain the sticks on paper towels or a rack."
    },
    {
      "step": 7,
      "text": "Whisk the mayonnaise, ketchup, and garlic salt together until combined. Serve the warm cornmeal sticks with the dipping sauce."
    }
  ],
