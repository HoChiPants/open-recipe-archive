  "id": "pork-chops-with-raspberry-sauce",
  "name": "Pork Chops with Raspberry Sauce",
  "subtitle": "Seared pork with a bright, tangy fruit glaze",
  "description": "Seasoned boneless pork chops are seared until safely cooked, then served with a quick raspberry, orange, and vinegar sauce.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
