  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 200°F."
    },
    {
      "step": 2,
      "text": "Combine the dried thyme, dried sage, salt, pepper, and fresh thyme sprigs. Season the pork chops with the mixture."
    },
    {
      "step": 3,
      "text": "Heat the butter and olive oil in a skillet over medium-high heat. Add the pork chops and cook for about 5 minutes, turning as needed, until a thermometer registers 145°F in the thickest part.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Transfer the pork chops to a dish and keep them warm in the oven. Let them rest for at least 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Stir the raspberry jam, orange juice, and white wine vinegar into the skillet. Simmer for 3 minutes, stirring, until thickened.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Return the pork chops to the skillet briefly to coat with the sauce, then garnish with the fresh thyme sprigs."
    }
  ],
