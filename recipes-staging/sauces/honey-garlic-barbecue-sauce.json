  "id": "honey-garlic-barbecue-sauce",
  "name": "Honey Garlic Barbecue Sauce",
  "subtitle": "A sweet, savory sauce with garlic and mild heat",
  "description": "Whisked together from pantry staples, this sauce balances honey, ketchup, mustard, lemon, and cayenne for brushing or serving with cooked foods.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
