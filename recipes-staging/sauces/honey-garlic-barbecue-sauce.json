  "instructions": [
    {
      "step": 1,
      "text": "In a saucepan, dissolve the vegetable bouillon cube in the boiling water. Whisk in the vegetable oil."
    },
    {
      "step": 2,
      "text": "Add the ketchup, vegetarian Worcestershire sauce, dry mustard, onion flakes, salt, sugar, cayenne pepper, lemon slice, honey, and garlic; stir until combined."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a gentle simmer over medium heat, stirring occasionally."
    },
    {
      "step": 4,
      "text": "Simmer for 10 minutes, then remove the lemon slice and use or cool as desired.",
      "timer_minutes": 10
    }
  ],
