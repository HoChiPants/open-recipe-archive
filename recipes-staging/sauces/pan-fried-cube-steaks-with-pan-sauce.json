{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "pan-fried-cube-steaks-with-pan-sauce",
  "name": "Pan-Fried Cube Steaks with Pan Sauce",
  "subtitle": "Quick-seared beef with a savory Worcestershire sauce",
  "description": "Cube steaks are pan-fried in butter, then served with a fast Worcestershire pan sauce.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cube-steak",
      "item": "cube steak",
      "quantity": 24,
      "unit": "ounces",
      "preparation": "cut into 4 portions"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "divided"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "worcestershire-sauce",
      "item": "Worcestershire sauce",
      "quantity": 0.33,
      "unit": "cup",
      "preparation": "divided"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the cube steaks with salt and freshly ground black pepper."
    },
    {
      "step": 2,
      "text": "Melt half of the butter in a large skillet over medium-high heat."
    },
    {
      "step": 3,
      "text": "Add the steaks and cook for 4 minutes. Add part of the Worcestershire sauce, then turn the steaks.",
      "timer_minutes": 4
    },
    {
      "step": 4,
      "text": "Cook for 3 minutes more, or until firm and the thickest portion reaches 145°F on a food thermometer.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Transfer the steaks to a plate and rest for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Add the remaining butter to the skillet. Stir in the remaining Worcestershire sauce and the water, scraping up any browned bits."
    },
    {
      "step": 7,
      "text": "Simmer the pan sauce for 2 minutes, then spoon it over the steaks and serve.",
      "timer_minutes": 2
    }
  ],
