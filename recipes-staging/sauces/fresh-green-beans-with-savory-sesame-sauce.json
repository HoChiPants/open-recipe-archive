    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-green-beans",
      "item": "fresh green beans",
      "quantity": 1,
      "unit": "pound",
      "preparation": "trimmed"
    },
    {
