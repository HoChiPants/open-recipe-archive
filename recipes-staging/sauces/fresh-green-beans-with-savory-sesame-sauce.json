  "id": "fresh-green-beans-with-savory-sesame-sauce",
  "name": "Fresh Green Beans with Savory Sesame Sauce",
  "subtitle": "Tender green beans with a creamy, spicy sesame coating",
  "description": "Green beans are simmered until tender, then coated with browned onion, garlic, sesame, and a lightly spicy sauce.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
