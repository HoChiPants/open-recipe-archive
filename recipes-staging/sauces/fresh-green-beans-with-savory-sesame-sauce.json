      "item": "salt and ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the soy sauce and sriracha hot sauce in a saucepan and bring to a simmer."
    },
    {
      "step": 2,
      "text": "Add the green beans and simmer until tender, about 6 minutes. Transfer the beans to a bowl and reserve the sauce.",
      "timer_minutes": 6
    },
    {
      "step": 3,
      "text": "Melt the butter in a skillet over medium heat. Add the onion and garlic, stirring for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Add the sesame seeds and cook, stirring, until golden brown, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Stir the reserved sauce with the mayonnaise and allspice, then return the green beans to the skillet and toss to coat."
    },
    {
      "step": 6,
      "text": "Season with salt and ground black pepper to taste, then serve."
    }
  ],
