{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "garlic-cream-sauce-with-grilled-chicken",
  "name": "Garlic Cream Sauce with Grilled Chicken",
  "subtitle": "Grilled chicken with a creamy garlic-Parmesan sauce",
  "description": "Seasoned chicken breasts are grilled and served with a rich garlic cream sauce finished with Parmesan and cream cheese.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 4,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-basil",
      "item": "dried basil",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 3,
      "unit": "cloves",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "freshly-grated-parmesan-cheese",
      "item": "freshly grated Parmesan cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "ounces",
      "preparation": "softened"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the oregano, basil, salt, and black pepper. Season the chicken breasts evenly."
    },
    {
      "step": 2,
      "text": "Preheat a grill and lightly oil the grates with the vegetable oil."
    },
    {
      "step": 3,
      "text": "Grill the chicken for about 6 minutes, turning as needed, until the thickest part reaches 165°F on a food thermometer. Set aside.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Melt the butter in a skillet over medium heat. Add the garlic and cook until fragrant.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Whisk in the flour and cook briefly to form a smooth base.",
      "timer_minutes": 1
    },
    {
      "step": 6,
      "text": "Gradually whisk in the heavy cream, chicken broth, and softened cream cheese. Cook until the sauce thickens.",
      "timer_minutes": 5
    },
    {
      "step": 7,
      "text": "Whisk in the Parmesan and continue cooking until melted. Spoon the sauce over the grilled chicken and serve.",
      "timer_minutes": 5
    }
  ],
