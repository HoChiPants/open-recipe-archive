  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large saucepan over medium heat. Add the garlic and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Add the onion, green bell pepper, basil, green onions, bay leaf, black pepper, and tomatoes with green chilies. Stir to combine."
    },
    {
      "step": 3,
      "text": "Pour in the tomato sauce, stewed tomatoes, water, and sugar. Add the salt and stir well."
    },
    {
      "step": 4,
      "text": "Simmer gently, stirring occasionally, until the vegetables are tender and the sauce has thickened, about 25 minutes. Remove the bay leaf before serving.",
      "timer_minutes": 25
    }
