  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 400°F. Combine the beets, onion, and garlic with the olive oil, chopped thyme, salt, and pepper, then toss to coat. Transfer to a roasting pan and roast until the vegetables are cooked through.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Let the roasted beets cool briefly, then blend them with the vegetable broth and lemon juice until smooth.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Transfer the puree to a saucepan and whisk in the heavy cream. Warm the sauce for 5 minutes, then stir in the measured Parmesan until melted and the sauce is set.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Bring salted water to a simmer and cook the fettuccine until tender. Drain, combine with the beet sauce, and finish with the remaining Parmesan and thyme.",
      "timer_minutes": 8
    }
  ],
