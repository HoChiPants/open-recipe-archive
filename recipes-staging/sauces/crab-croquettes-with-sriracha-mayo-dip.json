      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a pan over medium heat. Add the red onion and spring onions and cook until softened, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Whisk in the flour, then gradually whisk in the milk. Cook until the mixture is smooth and thickened, about 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Stir in the lemon zest, parsley, and crabmeat. Transfer the mixture to a dish and cool until firm enough to shape."
    },
    {
      "step": 4,
      "text": "Set the beaten eggs and panko breadcrumbs in separate shallow dishes. Shape the crab mixture into 8 croquettes."
    },
    {
      "step": 5,
      "text": "Dip each croquette in the beaten egg, then roll in the panko to coat evenly."
    },
    {
      "step": 6,
      "text": "Heat the vegetable oil in a frying pan. Fry the croquettes in batches until crisp and golden, turning as needed; the crab filling should reach 145°F.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Stir the sriracha into the mayonnaise. Serve the warm croquettes with the dip."
    }
  ],
