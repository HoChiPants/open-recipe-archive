  "id": "crab-croquettes-with-sriracha-mayo-dip",
  "name": "Crab Croquettes with Sriracha Mayo Dip",
  "subtitle": "Crisp crab cakes with a creamy, spicy dip",
  "description": "Form a seasoned crab mixture into croquettes, coat them in panko, fry until golden, and serve with sriracha mayonnaise.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 25,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "red-onion-finely-chopped",
      "item": "red onion finely chopped",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 200,
      "unit": "ml"
    },
    {
