  "id": "red-enchilada-sauce",
  "name": "Red Enchilada Sauce",
  "subtitle": "A smooth ancho chile sauce with warm Mexican spices",
  "description": "Toasted ancho chiles, tomato, garlic, and spices are blended with beef broth and corn oil, then simmered into a rich sauce.",
  "meal_type": "sauce",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 14,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15,
    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "dried-ancho-chiles",
      "item": "dried ancho chiles",
      "quantity": 6
    },
    {
      "ingredient_id": "beef-broth",
      "item": "beef broth",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "tomato-paste",
      "item": "tomato paste",
      "quantity": 1,
      "unit": "can",
      "preparation": "6 ounce"
    },
    {
      "ingredient_id": "corn-oil",
      "item": "corn oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 0.25,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Arrange the ancho chiles on a baking sheet and bake for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Transfer the toasted chiles to a heatproof bowl. Add the beef broth and tomato paste, and let stand for 60 minutes to soften.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Blend the softened chiles and broth with the corn oil, garlic, salt, oregano, and cumin until smooth."
    },
    {
      "step": 4,
      "text": "Transfer the sauce to a saucepan and bring it to a gentle simmer. Cook for 10 minutes, using a thermometer to verify at least 160°F if the broth contains ground beef, or 145°F if it contains whole-cut beef followed by a 3-minute rest.",
      "timer_minutes": 10
    }
  ],
