  "id": "smacked-cucumber-with-chilli-oil",
  "name": "Smacked Cucumber with Chilli Oil",
  "subtitle": "A crisp cucumber side with a tangy soy dressing",
  "description": "Smacked cucumber is rested, dressed with garlic, soy, vinegar, sugar, and chilli oil, then served chilled or at room temperature.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
