  "instructions": [
    {
      "step": 1,
      "text": "Smack the cucumber firmly to split it, then cut it into bite-size pieces. Let it stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Stir together the garlic, sugar, soy sauce, rice vinegar, and chilli oil."
    },
    {
      "step": 3,
      "text": "Add the cucumber, toss to coat, and let it stand for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Serve with extra chilli oil if desired."
    }
  ],
