  "id": "black-bean-sauce",
  "name": "Black Bean Sauce",
  "subtitle": "A savory fermented-bean condiment for stir-fries and noodles",
  "description": "Build a rich, aromatic sauce by soaking fermented black beans, frying them with ginger and garlic, then seasoning and thickening the mixture.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 280,
    "unit": "g"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "vegetable",
      "item": "vegetable",
      "quantity": 2,
      "unit": "tbsp",
      "preparation": "sunflower or rapeseed oil"
    },
    {
      "ingredient_id": "finely-chopped-or-minced-ginger",
      "item": "finely chopped or minced ginger",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "garlic-cloves-minced-or-finely-grated",
      "item": "garlic cloves minced or finely grated",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "dried-fermented-black-beans",
      "item": "dried fermented black beans",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "shaoxing-wine",
      "item": "Shaoxing wine",
      "quantity": "1 1/2",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "light-soy-sauce",
      "item": "light soy sauce",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "sesame-oil",
      "item": "sesame oil",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "white-ground-pepper",
      "item": "white ground pepper",
      "quantity": "1/4",
      "unit": "tsp"
    },
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": 1,
      "unit": "tbsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cover the dried fermented black beans with boiling water and soak for 15 minutes. Drain well.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a saucepan over medium heat. Add the ginger and garlic and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Stir in the drained black beans and Shaoxing wine; cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Add the light soy sauce, sugar, sesame oil, and white pepper. Stir until combined."
    },
    {
      "step": 5,
      "text": "Transfer the mixture to a blender or food processor and process to the desired texture."
    },
    {
      "step": 6,
      "text": "Return the sauce to the saucepan and cook gently for 10 minutes, stirring occasionally.",
      "timer_minutes": 10
    },
    {
      "step": 7,
      "text": "Stir in the cornflour until evenly incorporated and cook briefly until the sauce thickens."
    }
  ],
