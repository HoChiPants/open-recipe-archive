{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "slow-cooker-french-dip",
  "name": "Slow Cooker French Dip",
  "subtitle": "Tender beef sandwiches with warm au jus",
  "description": "Slow-cooked sirloin is sliced and served on hoagie rolls with melted provolone and savory au jus.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 360
  },
  "ingredients": [
    {
      "ingredient_id": "beef-sirloin-roast",
      "item": "beef sirloin roast",
      "quantity": 3,
      "unit": "pounds"
    },
    {
      "ingredient_id": "dry-au-jus-mix",
      "item": "dry au jus mix",
      "quantity": 1,
      "unit": "packet",
      "preparation": "1 ounce"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "1-ounce-slices-provolone-cheese",
      "item": "(1 ounce) slices provolone cheese",
      "quantity": 8
    },
    {
      "ingredient_id": "hoagie-rolls",
      "item": "hoagie rolls",
      "quantity": 8,
      "preparation": "split lengthwise"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the beef sirloin roast in a slow cooker."
    },
    {
      "step": 2,
      "text": "Whisk the water and dry au jus mix together, then pour the mixture over the roast."
    },
    {
      "step": 3,
      "text": "Cover and cook until the beef is tender and reaches at least 145°F in the thickest part. Remove it and let it rest for 3 minutes.",
      "timer_minutes": 360
    },
    {
      "step": 4,
      "text": "Slice the rested beef thinly against the grain."
    },
    {
      "step": 5,
      "text": "Fill the split hoagie rolls with beef and provolone cheese. Serve with the cooking liquid for dipping."
    }
  ],
