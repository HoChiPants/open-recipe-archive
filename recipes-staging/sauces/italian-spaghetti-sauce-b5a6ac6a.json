  "instructions": [
    {
      "step": 1,
      "text": "Set an electric pressure cooker to sauté. Add the olive oil, yellow onions, and garlic; cook until softened and fragrant.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the carrot, celery stalk, and plum tomatoes. Cook until the vegetables begin to soften.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Stir in the dried oregano, Italian seasoning, sea salt, dried basil, and ground black pepper."
    },
    {
      "step": 4,
      "text": "Secure the lid and pressure-cook the sauce until set.",
      "timer_minutes": 25
    },
    {
      "step": 5,
      "text": "Allow the pressure to release naturally, then let the sauce stand briefly before opening the cooker.",
      "timer_minutes": 15
    },
    {
      "step": 6,
      "text": "Blend the sauce until smooth, using an immersion blender or working carefully in batches with a countertop blender."
    }
  ],
