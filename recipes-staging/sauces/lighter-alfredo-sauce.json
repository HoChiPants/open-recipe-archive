      "item": "ground black pepper",
      "quantity": 0.125,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the butter in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Whisk in the cream cheese, garlic powder, milk, and Parmesan until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the black pepper and continue cooking until the sauce is smooth and thickened."
    },
    {
      "step": 4,
      "text": "Serve warm."
    }
  ],
