  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "fat-free-cream-cheese",
      "item": "fat-free cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "non-fat-milk",
      "item": "non-fat milk",
      "quantity": 2,
      "unit": "cups"
    },
    {
