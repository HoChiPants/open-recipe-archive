  "id": "lighter-alfredo-sauce",
  "name": "Lighter Alfredo Sauce",
  "subtitle": "A smooth, creamy sauce for pasta and vegetables",
  "description": "Butter, milk, cream cheese, Parmesan, and garlic powder combine into a quick, rich-tasting Alfredo-style sauce.",
  "meal_type": "sauce",
  "cuisine": "American",
