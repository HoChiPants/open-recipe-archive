  "id": "cranberry-orange-sauce",
  "name": "Cranberry Orange Sauce",
  "subtitle": "A bright, gently spiced cranberry condiment",
  "description": "Cranberries simmer with brown sugar, fresh orange, and cinnamon until thick, then cool before serving.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "cranberries",
      "item": "cranberries",
      "quantity": 2,
      "unit": "package",
      "preparation": "12 ounce"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.75,
      "unit": "cup"
    },
    {
      "ingredient_id": "orange",
      "item": "orange",
      "quantity": 1,
      "preparation": "zested and juiced"
    },
    {
      "ingredient_id": "cinnamon-stick",
      "item": "cinnamon stick",
      "quantity": 1,
      "preparation": "broken in half"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the cranberries, brown sugar, orange zest and juice, and broken cinnamon stick in a saucepan."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a simmer over medium heat, then cook until the cranberries break down and the sauce thickens.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Transfer the sauce to a serving container and let it cool for about 60 minutes.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Remove the cinnamon stick before serving."
    }
  ],
