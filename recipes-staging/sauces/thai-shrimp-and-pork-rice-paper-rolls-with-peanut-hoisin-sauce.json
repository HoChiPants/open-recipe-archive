  "instructions": [
    {
      "step": 1,
      "text": "Bring water to a simmer, add the shrimp, and cook for 3 minutes, until opaque. Remove and cool.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "In a separate pan, simmer the pork loin for about 10 minutes, checking with a thermometer for 145°F. Rest it for 3 minutes, then slice.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Cook the rice noodles in simmering water for 8 minutes, until tender. Drain and cool.",
      "timer_minutes": 8
    },
    {
      "step": 4,
      "text": "Slice the cooled shrimp and pork into thin pieces."
    },
    {
      "step": 5,
      "text": "Soften each rice wrapper sheet in water, then transfer it to a work surface."
    },
    {
      "step": 6,
      "text": "Arrange basil, shrimp, pork, noodles, cilantro, mint, and bean sprouts across the lower third of each wrapper."
    },
    {
      "step": 7,
      "text": "Fold in the sides, roll the wrapper over the filling, and continue rolling into a thick cylinder."
    },
    {
      "step": 8,
      "text": "Warm the hoisin sauce, peanut butter, and water together until smooth."
    },
    {
      "step": 9,
      "text": "Serve the rolls with the sauce and chopped roasted peanuts."
    }
  ],
