  "id": "thai-shrimp-and-pork-rice-paper-rolls-with-peanut-hoisin-sauce",
  "name": "Thai Shrimp and Pork Rice Paper Rolls with Peanut-Hoisin Sauce",
  "subtitle": "Fresh rice paper rolls with herbs, noodles, and a warm dipping sauce",
  "description": "Tender shrimp and pork are paired with rice noodles, herbs, and bean sprouts in rice paper wrappers, served with a peanut-hoisin sauce.",
  "meal_type": "sauce",
  "cuisine": "Thai",
  "yield": {
