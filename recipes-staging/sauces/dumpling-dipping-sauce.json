    "inactive_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "light-soy-sauce",
      "item": "light soy sauce",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "dark-soy-sauce",
      "item": "dark soy sauce",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "red-wine-vinegar",
      "item": "red wine vinegar",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "hot-chili-oil",
      "item": "hot chili oil",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fresh-ginger-root",
      "item": "fresh ginger root",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "minced"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "green-onion",
      "item": "green onion",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "minced, or to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk all ingredients together in a bowl until the sugar is dissolved and the mixture is evenly combined."
    },
    {
      "step": 2,
      "text": "Transfer to a covered container and let the sauce rest for 60 minutes before serving.",
