  "id": "dumpling-dipping-sauce",
  "name": "Dumpling Dipping Sauce",
  "subtitle": "Savory soy sauce with ginger, garlic, and chili",
  "description": "A tangy, lightly sweet dipping sauce that develops deeper flavor as it rests.",
  "meal_type": "sauce",
  "cuisine": "Asian Inspired",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
