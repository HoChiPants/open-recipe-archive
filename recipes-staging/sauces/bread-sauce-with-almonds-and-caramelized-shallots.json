  "id": "bread-sauce-with-almonds-and-caramelized-shallots",
  "name": "Bread Sauce with Almonds and Caramelized Shallots",
  "subtitle": "Creamy bread sauce finished with toasted almonds",
  "description": "An aromatic bread sauce enriched with cream, caramelized shallots, and toasted flaked almonds.",
  "meal_type": "sauce",
