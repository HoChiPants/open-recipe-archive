  "instructions": [
    {
      "step": 1,
      "text": "Place the milk, bay leaf, peppercorns, thyme, garlic, and shallots in a saucepan. Heat gently for 20 minutes without boiling, then remove the shallots and aromatics.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Let the shallots cool enough to handle, then cut them into thin slices."
    },
    {
      "step": 3,
      "text": "Melt the butter with the sunflower oil in a pan. Add the sliced shallots and cook gently for 25 minutes, stirring occasionally, until caramelized.",
      "timer_minutes": 25
    },
    {
      "step": 4,
      "text": "Return the infused milk to gentle heat, stir in the breadcrumbs, and cook for 4 minutes until thickened.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Whisk in the cream, then fold in the toasted almonds. Serve with optional nutmeg."
    }
  ],
