{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "middle-eastern-garlic-sauce",
  "name": "Middle Eastern Garlic Sauce",
  "subtitle": "A smooth potato-based garlic sauce with lemon",
  "description": "Blend tender potatoes with crushed garlic, lemon juice, salt, and oil for a creamy sauce served alongside savory dishes.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "russet-potatoes",
      "item": "russet potatoes",
      "quantity": 3,
      "unit": "small",
      "preparation": "peeled"
    },
    {
      "ingredient_id": "head-garlic",
      "item": "head garlic",
      "quantity": 1,
      "preparation": "peeled and crushed"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1.5,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "canola-oil",
      "item": "canola oil",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Place the potatoes and salt in a saucepan, cover with water, and simmer until the potatoes are tender, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Drain the potatoes and let them cool until set."
    },
    {
      "step": 3,
      "text": "Combine the crushed garlic, lemon juice, and some of the oil. Blend until smooth, then gradually add the remaining oil while blending until creamy."
    },
    {
      "step": 4,
      "text": "Add the potatoes and blend until the sauce is smooth and evenly combined."
    },
    {
      "step": 5,
      "text": "Transfer to a serving container and refrigerate for at least 1 hour before serving.",
      "timer_minutes": 60
    }
  ],
