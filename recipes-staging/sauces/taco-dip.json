  "id": "taco-dip",
  "name": "Taco Dip",
  "subtitle": "A cool, creamy dip with crisp vegetables and taco-seasoned cheese.",
  "description": "Blend the seasoned dairy base until smooth, then layer it with fresh vegetables, olives, and shredded lettuce for a simple chilled appetizer.",
  "meal_type": "sauce",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 25,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "16-ounce-container-nonfat-sour-cream",
      "item": "(16 ounce) container nonfat sour cream",
      "quantity": 1
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "taco-seasoning-mix",
      "item": "taco seasoning mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1.25 ounce"
    },
    {
      "ingredient_id": "head-iceberg-lettuce",
      "item": "head iceberg lettuce",
      "quantity": 0.25,
      "preparation": "rinsed, dried, and shredded"
    },
    {
      "ingredient_id": "cheddar-cheese",
      "item": "Cheddar cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 3,
      "unit": "medium",
      "preparation": "chopped"
    },
    {
