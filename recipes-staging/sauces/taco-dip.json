      "item": "black olives",
      "quantity": 1,
      "unit": "can",
      "preparation": "2.25 ounce, drained"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Stir the sour cream, softened cream cheese, taco seasoning mix, and shredded Cheddar until smooth."
    },
    {
      "step": 2,
      "text": "Transfer the mixture to a serving dish and spread it into an even layer."
    },
    {
      "step": 3,
      "text": "Top with the shredded lettuce, chopped tomatoes, green bell pepper, and drained black olives. Serve immediately."
    }
