  "instructions": [
    {
      "step": 1,
      "text": "Combine the olive oil, balsamic vinegar, mayonnaise, water, pressed garlic, Dijon mustard, and brown sugar in a blender or tall mixing container."
    },
    {
      "step": 2,
      "text": "Blend until smooth."
    },
    {
      "step": 3,
      "text": "Season with salt and ground black pepper to taste, and blend or whisk briefly to combine."
    }
