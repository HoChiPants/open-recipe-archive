{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "spicy-greek-feta-dip",
  "name": "Spicy Greek Feta Dip",
  "subtitle": "Creamy feta blended with peppers, garlic, and chili",
  "description": "A tangy, savory dip with roasted red peppers, briny olives, and adjustable heat from crushed red pepper.",
  "meal_type": "sauce",
  "cuisine": "Greek",
  "yield": {
    "quantity": 9,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "crumbled-feta-cheese",
      "item": "crumbled feta cheese",
      "quantity": 10,
      "unit": "ounces"
    },
    {
      "ingredient_id": "roasted-red-peppers",
      "item": "roasted red peppers",
      "quantity": 2,
      "unit": "medium",
      "preparation": "drained and chopped"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "red-wine-vinegar",
      "item": "red wine vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "small",
      "preparation": "minced"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 0.25,
      "unit": "teaspoon",
      "preparation": "crushed, or more to taste"
    },
    {
      "ingredient_id": "kalamata-olives",
      "item": "Kalamata olives",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the feta, roasted red peppers, red wine vinegar, garlic, and red pepper flakes to a food processor."
    },
    {
      "step": 2,
      "text": "Process until the mixture is smooth, scraping down the sides as needed."
    },
    {
      "step": 3,
      "text": "With the processor running, gradually add the olive oil and blend until incorporated."
    },
    {
      "step": 4,
      "text": "Transfer to a serving bowl and stir in the Kalamata olives."
    },
    {
      "step": 5,
      "text": "Chill briefly before serving."
    }
  ],
