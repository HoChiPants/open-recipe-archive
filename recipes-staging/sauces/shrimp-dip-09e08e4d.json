  },
  "ingredients": [
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "8-ounce-jar-cocktail-sauce",
      "item": "(8 ounce) jar cocktail sauce",
      "quantity": 1
    },
    {
      "ingredient_id": "small-shrimp",
      "item": "small shrimp",
      "quantity": 1,
      "unit": "can",
      "preparation": "4.5 ounce, drained"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the softened cream cheese until smooth."
    },
    {
      "step": 2,
      "text": "Stir the cocktail sauce and drained shrimp together."
    },
    {
      "step": 3,
      "text": "Whisk the shrimp mixture into the cream cheese until combined."
    },
    {
      "step": 4,
      "text": "Chill before serving. Confirm the shrimp is fully cooked and opaque."
    }
  ],
