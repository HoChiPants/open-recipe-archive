  "id": "shrimp-dip-09e08e4d",
  "name": "Shrimp Dip",
  "subtitle": "A creamy, chilled dip with cocktail sauce and shrimp",
  "description": "Blend softened cream cheese with cocktail sauce and drained shrimp for a quick appetizer served cold.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
