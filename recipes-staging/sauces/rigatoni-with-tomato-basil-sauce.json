  "id": "rigatoni-with-tomato-basil-sauce",
  "name": "Rigatoni with Tomato-Basil Sauce",
  "subtitle": "Slow-simmered tomato sauce finished with butter and cheese",
  "description": "A rich Italian-style rigatoni dish with smooth tomatoes, basil, butter, and Parmigiano-Reggiano.",
  "meal_type": "sauce",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 55
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 4,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "cup",
      "preparation": "diced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "plus more to taste"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "crushed (or more to taste)"
    },
    {
      "ingredient_id": "red-pepper-flakes",
      "item": "red pepper flakes",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "san-marzano-italian-tomatoes",
      "item": "San Marzano (Italian) tomatoes",
      "quantity": 1,
      "unit": "can",
      "preparation": "28 ounce, blended smooth"
    },
    {
      "ingredient_id": "water-to-rinse-out-can-of-tomatoes",
      "item": "water (to rinse out can of tomatoes)",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "uncooked-rigatoni-pasta",
      "item": "uncooked rigatoni pasta",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "fresh-basil-leaves",
      "item": "fresh basil leaves",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "cold-butter",
      "item": "cold butter",
      "quantity": 4,
      "unit": "tablespoons",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "grated-parmigiano-reggiano-cheese",
      "item": "grated Parmigiano-Reggiano cheese",
      "quantity": 1,
      "unit": "cup",
      "preparation": "plus more for serving"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large saucepan over medium heat. Add the onion and salt; cook for 5 minutes until softened.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Stir in the garlic and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Add the red pepper flakes, blended tomatoes, and water used to rinse the can. Bring to a simmer, then cook gently until the sauce is reduced and flavorful.",
      "timer_minutes": 60
    },
    {
      "step": 4,
      "text": "Bring salted water to a boil in a large pot. Cook the rigatoni for 8 minutes, or until al dente.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Stir the basil into the sauce. Add the cold butter and Parmigiano-Reggiano, stirring until incorporated."
    },
    {
      "step": 6,
      "text": "Drain the rigatoni and transfer it to the sauce. Toss until evenly coated."
    },
    {
      "step": 7,
      "text": "Serve with additional basil and Parmigiano-Reggiano."
    }
  ],
