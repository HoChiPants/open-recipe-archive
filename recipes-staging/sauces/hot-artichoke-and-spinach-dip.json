  "id": "hot-artichoke-and-spinach-dip",
  "name": "Hot Artichoke and Spinach Dip",
  "subtitle": "A warm, creamy cheese dip with tender greens",
  "description": "Combine artichokes, spinach, cream, sour cream, garlic, and cheeses, then bake until hot and bubbling around the edges.",
  "meal_type": "sauce",
  "cuisine": "American",
