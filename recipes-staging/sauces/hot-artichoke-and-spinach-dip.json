  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "In a bowl, combine the spinach, heavy cream, sour cream, Romano, Parmesan, mozzarella, and garlic."
    },
    {
      "step": 3,
      "text": "Stir in the drained artichoke hearts until evenly distributed."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish and spread it evenly."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, until the cheese is melted and the dip is hot.",
      "timer_minutes": 25
    }
  ],
