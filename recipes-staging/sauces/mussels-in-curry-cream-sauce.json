  "id": "mussels-in-curry-cream-sauce",
  "name": "Mussels in Curry Cream Sauce",
  "subtitle": "Tender mussels in a fragrant cream sauce",
  "description": "Mussels are simmered with wine, aromatics, curry, and cream, then finished with butter and fresh herbs.",
  "meal_type": "sauce",
  "cuisine": "French",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
