  "instructions": [
    {
      "step": 1,
      "text": "Combine the shallots, garlic, and wine in a large pot. Bring to a simmer and cook until the aromatics soften."
    },
    {
      "step": 2,
      "text": "Whisk the heavy cream and curry powder together, then add the mixture to the pot."
    },
    {
      "step": 3,
      "text": "Add the mussels, cover, and cook until the shells open and the mussels are opaque. Discard any mussels that remain closed."
    },
    {
      "step": 4,
      "text": "Transfer the opened mussels to serving bowls, leaving the cooking liquid in the pot."
    },
    {
      "step": 5,
      "text": "Whisk the butter into the hot cream sauce until smooth. Stir in the parsley and green onions and warm briefly."
    },
    {
      "step": 6,
      "text": "Spoon the sauce over the mussels and serve immediately."
    }
  ],
