  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large skillet. Add the cherry tomatoes, sliced garlic, salt, pepper, and red pepper flakes; cook, stirring the garlic, for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Add the chicken broth and bring the mixture to a simmer. Cook until the sauce reaches 165°F on a food thermometer, then continue simmering with the tomatoes for 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Cook the penne in the simmering sauce until tender, about 11 minutes, then drain.",
      "timer_minutes": 11
    },
    {
      "step": 4,
      "text": "Stir in the oregano, additional salt and pepper, and red pepper flakes. Blend or prepare the sauce until smooth."
    },
    {
      "step": 5,
      "text": "Add the pasta back to the sauce and toss to coat. Stir in the Parmigiano-Reggiano, then serve."
    }
  ],
