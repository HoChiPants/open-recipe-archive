  "id": "cherry-tomato-pasta-sauce",
  "name": "Cherry Tomato Pasta Sauce",
  "subtitle": "A bright tomato sauce with oregano and garlic",
  "description": "Cherry tomatoes, broth, herbs, and garlic create a quick sauce for tender penne, finished with Parmigiano-Reggiano.",
  "meal_type": "sauce",
