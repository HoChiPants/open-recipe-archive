      "item": "malt vinegar",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "star-anise",
      "item": "star anise",
      "quantity": 1
    },
    {
      "ingredient_id": "chicken-stock-or-vegetable-stock-for-vegetarians",
      "item": "chicken stock or vegetable stock for vegetarians",
      "quantity": 500,
      "unit": "ml"
    },
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": 2,
      "unit": "tbsp"
    },
