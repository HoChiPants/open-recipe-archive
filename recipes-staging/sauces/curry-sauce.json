  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium-low heat. Add the onions, garlic, and ginger, and cook until softened, about 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Stir in the curry powder, turmeric, raisins, malt vinegar, star anise, and stock. Bring to a gentle simmer. If using chicken stock, heat the sauce to at least 165°F; vegetable-stock sauce should be thoroughly hot.",
      "timer_minutes": 1
    },
    {
      "step": 3,
      "text": "Whisk the cornflour with a little hot sauce until smooth, then stir it back into the pan. Simmer for 5 minutes, continuing gently until the sauce reaches the stated 60-minute cook time and thickens.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Remove the star anise and transfer the sauce to a blender. Blend until smooth, taking care with the hot liquid."
    },
    {
      "step": 5,
      "text": "Stir in lemon juice to taste and serve hot."
    }
  ],
