  "id": "curry-sauce",
  "name": "Curry Sauce",
  "subtitle": "A smooth, warmly spiced sauce for chips and other savory dishes",
  "description": "Slow-cooked onions, aromatic spices, raisins, and stock make a rich curry sauce finished with vinegar and lemon.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "onions-sliced",
      "item": "onions sliced",
      "quantity": 2,
      "unit": "large"
    },
    {
      "ingredient_id": "garlic-cloves-sliced",
      "item": "garlic cloves sliced",
      "quantity": 4
    },
    {
      "ingredient_id": "thumb-sized-piece-ginger-peeled-and-sliced",
      "item": "thumb-sized piece ginger peeled and sliced"
    },
    {
      "ingredient_id": "mild-curry-powder",
      "item": "mild curry powder",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "turmeric",
      "item": "turmeric",
      "quantity": 1,
      "unit": "tsp"
    },
