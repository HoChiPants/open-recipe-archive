  "id": "butternut-squash-romesco-dip",
  "name": "Butternut Squash Romesco Dip",
  "subtitle": "A smoky, almond-flecked dip for sharing",
  "description": "Roasted butternut squash blended with almonds, garlic, vinegar, paprika, and olive oil makes a smooth savory dip served with salted crisps.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "butternut-squash",
      "item": "butternut squash",
      "quantity": 1,
      "unit": "whole"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "garlic-clove-peeled-and-roughly-chopped",
      "item": "garlic clove peeled and roughly chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "blanched-almonds-optional",
      "item": "blanched almonds",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "sherry-vinegar",
      "item": "sherry vinegar",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "sweet-smoked-paprika",
      "item": "sweet smoked paprika",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "salted-crisps-to-serve",
      "item": "salted crisps to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F. Halve the butternut squash and prepare it for roasting with the olive oil."
    },
    {
      "step": 2,
      "text": "Roast the squash for 60 minutes, until completely tender when pierced.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Scoop the squash flesh into a blender or food processor. Add the garlic, almonds, sherry vinegar, and smoked paprika, then blend until smooth while gradually incorporating the remaining olive oil."
    },
    {
      "step": 4,
      "text": "Transfer the dip to a serving bowl and serve with salted crisps."
    }
  ],
