  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium heat. Add the diced tomatoes and cook until softened, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Stir in the basil, olive oil, garlic salt, salt, pepper, and grated garlic."
    },
    {
      "step": 3,
      "text": "Add the flour and stir for 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 4,
      "text": "Stir in the water until the sauce is smooth, then cook for 5 minutes to combine the flavors.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Serve warm with pasta."
    }
  ],
