  "id": "tomato-basil-pasta-sauce",
  "name": "Tomato Basil Pasta Sauce",
  "subtitle": "A quick, savory sauce with fresh basil and tomato.",
  "description": "Diced tomatoes simmer with basil, garlic, and simple seasonings for a warm pasta sauce.",
  "meal_type": "sauce",
  "cuisine": "American",
