  "id": "compote-with-frozen-berries",
  "name": "Compote with Frozen Berries",
  "subtitle": "A warm berry sauce with a lightly thickened finish",
  "description": "Frozen mixed berries simmer with sugar, water, and butter, then are thickened with flour for serving.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
