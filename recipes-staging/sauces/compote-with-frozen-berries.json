      "item": "unsalted butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "unbleached-all-purpose-flour",
      "item": "unbleached all-purpose flour",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a saucepan over medium heat for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the blueberries, strawberries, raspberries, sugar, water, and butter to the saucepan."
    },
    {
      "step": 3,
      "text": "Bring the mixture to a simmer and cook for 5 minutes, stirring occasionally.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Whisk in the flour and continue heating until the compote thickens."
    },
    {
      "step": 5,
      "text": "Let stand for 10 minutes, then serve.",
      "timer_minutes": 10
    }
  ],
