    "inactive_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "frozen-blueberries",
      "item": "frozen blueberries",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "frozen-strawberries",
      "item": "frozen strawberries",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "frozen-raspberries",
      "item": "frozen raspberries",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "raw-sugar",
      "item": "raw sugar",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
