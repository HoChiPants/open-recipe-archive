{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "asparagus-tempura-with-chilli-oil-dressing",
  "name": "Asparagus Tempura with Chilli Oil Dressing",
  "subtitle": "Lightly battered asparagus with lime and chilli oil",
  "description": "Crisp, delicate asparagus served with a bright lime and chilli oil dressing.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "cornflour",
      "item": "cornflour",
      "quantity": 70,
      "unit": "g"
    },
    {
      "ingredient_id": "plain-flour-sifted",
      "item": "plain flour sifted",
      "quantity": 30,
      "unit": "g"
    },
    {
      "ingredient_id": "ice-cold-sparkling-water",
      "item": "ice cold sparkling water",
      "quantity": "80-90",
      "unit": "ml"
    },
    {
      "ingredient_id": "vegetable-oil-for-deep-frying",
      "item": "vegetable oil for deep-frying"
    },
    {
      "ingredient_id": "asparagus-trimmed",
      "item": "asparagus trimmed",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "crispy-chilli-oil",
      "item": "crispy chilli oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "lime-juiced",
      "item": "lime juiced",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cornflour and sifted plain flour together. Gradually whisk in most of the ice cold sparkling water, then add enough of the remainder to make a thin batter; a few small lumps are fine."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a deep, heavy saucepan suitable for frying."
    },
    {
      "step": 3,
      "text": "Dip the trimmed asparagus into the batter, letting excess drip off, and deep-fry in batches until tender and lightly crisp, about 1 minute per batch.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Drain the asparagus on a rack or paper towels."
    },
    {
      "step": 5,
      "text": "Combine the crispy chilli oil and lime juice, then spoon over the fried asparagus and serve immediately."
    }
  ],
