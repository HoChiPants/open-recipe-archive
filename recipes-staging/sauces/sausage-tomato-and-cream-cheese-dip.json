  "id": "sausage-tomato-and-cream-cheese-dip",
  "name": "Sausage, Tomato, and Cream Cheese Dip",
  "subtitle": "A warm, creamy dip with savory sausage and green chile heat",
  "description": "Cooked sausage combines with diced tomatoes, green chile peppers, and melted cream cheese for an easy hot dip.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 16,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 0,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "sausage",
      "item": "sausage",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "tomatoes-with-green-chile-peppers",
      "item": "tomatoes with green chile peppers",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce, diced"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the sausage in a skillet over medium heat, breaking it up, until no longer pink and it reaches 160°F. Drain excess fat."
    },
    {
      "step": 2,
      "text": "Add the diced tomatoes with green chile peppers and softened cream cheese to the skillet. Stir until combined."
    },
    {
      "step": 3,
      "text": "Continue heating and stirring until the cream cheese is fully melted and the dip is smooth. Serve warm."
    }
  ],
