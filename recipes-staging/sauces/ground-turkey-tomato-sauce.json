  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large skillet or saucepan over medium heat. Add the onion and cook until softened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Add the ground turkey and season with salt, pepper, Italian seasoning, and oregano. Cook, breaking it into small pieces, until no longer pink and it reaches 165°F, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Stir in the tomato, basil, garlic, tomato sauce, and tomato paste."
    },
    {
      "step": 4,
      "text": "Bring to a gentle simmer and cook, stirring occasionally, until the sauce thickens, about 25 minutes. Taste and adjust the salt and pepper.",
      "timer_minutes": 25
    }
  ],
