  "instructions": [
    {
      "step": 1,
      "text": "Season the steaks with salt and pepper. Heat 1 tablespoon olive oil in a skillet, add the steaks, and cook for about 4 minutes, turning as needed, until a thermometer reads 145°F in the center.",
      "timer_minutes": 4
    },
    {
      "step": 2,
      "text": "Transfer the steaks to a plate and let them rest for at least 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Warm the heavy cream separately while the steaks rest."
    },
    {
      "step": 4,
      "text": "Heat the remaining olive oil and 2 tablespoons butter in the skillet. Add the shallot and garlic, stirring for 2 minutes until tender.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Pour in the Chardonnay and cook for 3 minutes to reduce it.",
      "timer_minutes": 3
    },
    {
      "step": 6,
      "text": "Whisk in the shrimp, warmed cream, remaining butter, and salt and pepper. Stir for about 2 minutes, until the sauce thickens and the shrimp are opaque and cooked through.",
      "timer_minutes": 2
    },
    {
      "step": 7,
      "text": "Spoon the shrimp cream sauce over the rested steaks and serve."
    }
  ],
