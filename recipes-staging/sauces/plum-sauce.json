  "id": "plum-sauce",
  "name": "Plum Sauce",
  "subtitle": "Sweet-tart sauce with gentle heat",
  "description": "A quick plum-based sauce balanced with vinegar, ginger, garlic, and red pepper flakes.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
