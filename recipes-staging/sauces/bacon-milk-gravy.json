  "instructions": [
    {
      "step": 1,
      "text": "Warm the bacon drippings in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Whisk in the flour until the mixture is smooth, then continue cooking and stirring for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Stir in the salt and black pepper."
    },
    {
      "step": 4,
      "text": "Gradually add the milk while whisking, and cook until the gravy thickens."
