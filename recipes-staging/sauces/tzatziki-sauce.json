  "id": "tzatziki-sauce",
  "name": "Tzatziki Sauce",
  "subtitle": "Creamy yogurt dip with cucumber, dill, lemon, and garlic",
  "description": "A cool, tangy yogurt sauce with grated cucumber and fresh herbs, suited to dipping or serving alongside savory dishes.",
  "meal_type": "sauce",
