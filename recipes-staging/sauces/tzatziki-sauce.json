  "instructions": [
    {
      "step": 1,
      "text": "Line a strainer with cheesecloth or a clean kitchen towel. Add the yogurt, place it over a bowl, and refrigerate for 8 hours to drain.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Place the grated cucumber in a strainer and let it drain for 2 hours, pressing gently to remove excess liquid.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Combine the drained yogurt and cucumber with the dill, lemon juice, garlic, salt, and pepper. Stir until evenly mixed."
    },
    {
      "step": 4,
      "text": "Cover and refrigerate for 2 hours before serving.",
      "timer_minutes": 120
    }
  ],
