  "id": "cranberry-orange-rosemary-sauce",
  "name": "Cranberry Orange Rosemary Sauce",
  "subtitle": "A bright, tart sauce with citrus and herbs",
  "description": "Simmer cranberries with orange juice, muscovado sugar, and rosemary until tender, then cool before serving.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "muscovado-sugar",
      "item": "muscovado sugar",
      "quantity": 75,
      "unit": "g"
    },
    {
      "ingredient_id": "orange-juice",
      "item": "orange juice",
      "quantity": 75,
      "unit": "ml"
    },
    {
      "ingredient_id": "rosemary-sprig",
      "item": "rosemary sprig",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "frozen-cranberries",
      "item": "frozen cranberries",
      "quantity": 250,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the muscovado sugar and orange juice in a saucepan, stirring until the sugar dissolves."
    },
    {
      "step": 2,
      "text": "Add the rosemary sprig and frozen cranberries. Bring to a gentle simmer and cook until the cranberries are tender.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Remove the rosemary sprig and let the sauce cool before serving."
    }
