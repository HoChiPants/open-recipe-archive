  "id": "gnocchi-with-fontina-sauce",
  "name": "Gnocchi with Fontina Sauce",
  "subtitle": "Tender gnocchi in a creamy cheese sauce",
  "description": "Boiled gnocchi are folded into a smooth Fontina and Parmesan sauce with shallots, cream, and basil.",
  "meal_type": "sauce",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "refrigerated-gnocchi",
      "item": "refrigerated gnocchi",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 6,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "shallots",
      "item": "shallots",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "fontina-cheese",
      "item": "Fontina cheese",
      "quantity": 8,
      "unit": "ounces",
      "preparation": "cubed"
    },
    {
      "ingredient_id": "freshly-grated-parmesan-cheese",
      "item": "freshly grated Parmesan cheese",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "basil",
      "item": "fresh basil",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of water to a simmer, then cook the gnocchi for 5 minutes, or until boiling and tender. Drain.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Meanwhile, melt the butter in a pan over medium heat. Add the shallots and cook for 3 minutes, until tender.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Add the cream and warm it gently. Stir in the Fontina and Parmesan until the sauce is smooth."
    },
    {
      "step": 4,
      "text": "Add the drained gnocchi and toss to coat. Garnish with the basil and serve."
    }
  ],
