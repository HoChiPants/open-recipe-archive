  "instructions": [
    {
      "step": 1,
      "text": "Heat the olive oil in a large saucepan. Add the onion, garlic, and tomato sauce; cook for 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Add the mushrooms and basil, then cook for 10 minutes, until the mushrooms are cooked through.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the whole peeled tomatoes, tomato paste, and remaining tomato sauce. Stir until combined."
    },
    {
      "step": 4,
      "text": "Mix in the Merlot, salt, black pepper, oregano, and sugar."
    },
    {
      "step": 5,
      "text": "Simmer for 15 minutes, stirring occasionally, until thickened, then continue simmering briefly before serving.",
      "timer_minutes": 15
    }
