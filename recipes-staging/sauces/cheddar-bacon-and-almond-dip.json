  "id": "cheddar-bacon-and-almond-dip",
  "name": "Cheddar, Bacon, and Almond Dip",
  "subtitle": "A chilled savory dip with crisp bacon and green onion",
  "description": "Combine mayonnaise, shredded Cheddar, bacon, toasted almonds, green onions, and cayenne, then chill before serving.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
