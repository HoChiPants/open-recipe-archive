    {
      "ingredient_id": "slivered-almonds",
      "item": "slivered almonds",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 6,
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 1.5,
      "unit": "cups"
    },
