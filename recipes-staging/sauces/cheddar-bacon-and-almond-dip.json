      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Arrange the almonds and bacon for cooking, and cook the bacon for 10 minutes or until crisp.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Cool the almonds and bacon, then crumble the bacon."
    },
    {
      "step": 3,
      "text": "Stir the mayonnaise and shredded Cheddar together in a bowl."
    },
    {
      "step": 4,
      "text": "Add the almonds, bacon, green onions, and cayenne; mix until evenly combined."
    },
    {
      "step": 5,
      "text": "Cover and chill for 60 minutes before serving.",
      "timer_minutes": 60
    }
