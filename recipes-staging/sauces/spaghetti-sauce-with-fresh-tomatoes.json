  "id": "spaghetti-sauce-with-fresh-tomatoes",
  "name": "Spaghetti Sauce with Fresh Tomatoes",
  "subtitle": "A simple slow-simmered tomato sauce",
  "description": "Fresh peeled tomatoes cook with onion, herbs, and seasonings into a versatile Italian-style sauce.",
  "meal_type": "sauce",
  "cuisine": "Italian",
  "yield": {
    "quantity": 8,
