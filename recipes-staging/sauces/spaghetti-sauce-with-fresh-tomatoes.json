      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a large pot over medium heat."
    },
    {
      "step": 2,
      "text": "Add the onion and garlic powder. Cook, stirring occasionally, until the onion softens, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the tomatoes, sugar, basil, parsley, and salt."
    },
    {
      "step": 4,
      "text": "Bring the sauce to a gentle simmer, then cook until thickened, stirring occasionally."
    },
    {
      "step": 5,
      "text": "Serve warm."
    }
  ],
