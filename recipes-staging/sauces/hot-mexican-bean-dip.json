  "id": "hot-mexican-bean-dip",
  "name": "Hot Mexican Bean Dip",
  "subtitle": "Warm, creamy bean dip with jalapeño",
  "description": "A baked dip combining refried beans, creamy dairy, taco seasoning, jalapeño, and shredded Mexican cheese.",
  "meal_type": "sauce",
  "cuisine": "Mexican Inspired",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "refried-beans",
      "item": "refried beans",
      "quantity": 1,
      "unit": "can",
      "preparation": "30 ounce"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce"
    },
    {
      "ingredient_id": "8-ounce-carton-sour-cream",
      "item": "(8 ounce) carton sour cream",
      "quantity": 1
    },
    {
      "ingredient_id": "dry-taco-seasoning-mix",
      "item": "dry taco seasoning mix",
      "quantity": 1,
      "unit": "package",
      "preparation": "1.25 ounce"
    },
    {
      "ingredient_id": "jalapeno-pepper",
      "item": "jalapeno pepper",
      "quantity": 1,
      "preparation": "diced, or more to taste"
    },
    {
      "ingredient_id": "mexican-cheese-blend",
      "item": "Mexican cheese blend",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the refried beans, cream cheese, sour cream, taco seasoning mix, and shredded Mexican cheese until evenly mixed."
    },
    {
      "step": 3,
      "text": "Fold in the diced jalapeño."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish."
    },
    {
      "step": 5,
      "text": "Bake for 30 minutes, until hot and the cheeses are melted.",
      "timer_minutes": 30
    }
  ],
