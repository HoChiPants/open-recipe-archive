  "id": "chicken-in-white-wine-sauce",
  "name": "Chicken in White Wine Sauce",
  "subtitle": "Pan-cooked chicken with a creamy herb sauce",
  "description": "Chicken breasts simmer gently in a savory white wine, stock, and cream sauce until tender.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-breasts-skin-left-on",
      "item": "chicken breasts skin left on",
      "quantity": 4
    },
    {
      "ingredient_id": "olive-or-rapeseed-oil",
      "item": "olive or rapeseed oil",
      "quantity": "2-3",
      "unit": "tbsp"
    },
    {
      "ingredient_id": "onion-finely-chopped",
      "item": "onion finely chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "garlic-cloves-crushed-or-finely-grated",
      "item": "garlic cloves crushed or finely grated",
      "quantity": 3
    },
    {
      "ingredient_id": "dried-mixed-herbs",
      "item": "dried mixed herbs",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
