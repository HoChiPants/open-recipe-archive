      "item": "chicken stock",
      "quantity": 250,
      "unit": "ml"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 125,
      "unit": "ml"
    },
    {
      "ingredient_id": "parsley-to-serve-optional",
      "item": "parsley to serve (optional)",
      "preparation": "chopped",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pat the chicken dry. Warm the oil in a large deep skillet over medium heat, then cook the chicken skin-side down for about 8 minutes, turning as needed, until lightly browned. Transfer to a plate.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Cook the onion in the same skillet for about 10 minutes, stirring occasionally, until softened.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the garlic and dried herbs and stir for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Stir in the flour, then gradually add the white wine and cook for 3 minutes, stirring until smooth.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Return the chicken to the skillet and pour in the stock. Bring to a gentle simmer, cover, and cook for about 20 minutes, until the sauce has thickened and the chicken reaches 165°F in the thickest part.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Stir in the double cream and heat through. Serve with the chopped parsley, if using."
    }
  ],
