  "instructions": [
    {
      "step": 1,
      "text": "Combine the cranberries, orange zest, cinnamon sticks, orange juice, brown sugar, and water in a saucepan."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a simmer and cook, stirring occasionally, until the cranberries break down and the sauce is thickened.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Remove the cinnamon sticks, cool the sauce, and chill before serving."
    }
