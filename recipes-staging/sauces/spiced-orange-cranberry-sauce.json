  "id": "spiced-orange-cranberry-sauce",
  "name": "Spiced Orange Cranberry Sauce",
  "subtitle": "A bright, warmly spiced fruit sauce",
  "description": "Cranberries simmer with orange, cinnamon, brown sugar, and water until thick, then chill for serving.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 64,
    "unit": "servings"
