  "id": "pan-fried-salmon-in-curry-cream-sauce",
  "name": "Pan-Fried Salmon in Curry Cream Sauce",
  "subtitle": "Tender salmon with a gently spiced cream finish",
  "description": "Salmon fillets simmer in a quick curry cream sauce brightened with lemon and ginger.",
  "meal_type": "sauce",
  "cuisine": "American",
