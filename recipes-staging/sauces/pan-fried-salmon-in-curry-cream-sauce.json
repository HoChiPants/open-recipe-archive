    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the cream, curry powder, lemon juice, and ginger together in a skillet over medium heat."
    },
    {
      "step": 2,
      "text": "Season the salmon with salt and pepper, then place the fillets in the skillet."
    },
    {
      "step": 3,
      "text": "Reduce the heat and simmer gently for about 12 minutes, turning once if needed, until the salmon reaches 145°F or is opaque and flakes easily.",
