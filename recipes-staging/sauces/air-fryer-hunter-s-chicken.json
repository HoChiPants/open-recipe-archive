  "id": "air-fryer-hunter-s-chicken",
  "name": "Air-Fryer Hunter's Chicken",
  "subtitle": "Bacon-wrapped chicken with barbecue sauce and cheddar",
  "description": "Chicken breasts are wrapped in smoky bacon, cooked with barbecue sauce, and finished with melted cheddar. Serve with seasonal vegetables, potato wedges, and ketchup.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "skinless-chicken-breasts-or-1-large-cut-in-half-lengthways",
      "item": "skinless chicken breasts or 1 large cut in half lengthways",
      "quantity": 2,
      "unit": "small"
    },
    {
      "ingredient_id": "rashers-smoked-streaky-bacon",
      "item": "rashers smoked streaky bacon",
      "quantity": "4-6"
    },
    {
      "ingredient_id": "thick-barbecue-sauce",
      "item": "thick barbecue sauce",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "cheddar-grated",
      "item": "cheddar grated",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "seasonal-veg",
      "item": "seasonal veg",
      "preparation": "potato wedges and ketchup, to serve"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the air fryer according to the appliance instructions."
    },
    {
      "step": 2,
      "text": "Wrap the chicken breasts with the bacon, arranging the rashers to cover the meat."
    },
    {
      "step": 3,
      "text": "Air-fry the bacon-wrapped chicken for 10 minutes, then coat it with the barbecue sauce."
    },
    {
      "step": 4,
      "text": "Continue cooking for about 10 minutes, or until the chicken reaches 165°F at the thickest point. Top with the grated cheddar and cook until melted."
    },
    {
      "step": 5,
      "text": "Serve with the seasonal vegetables, potato wedges, and ketchup."
    }
  ],
