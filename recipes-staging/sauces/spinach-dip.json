    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "bunch-fresh-spinach",
      "item": "bunch fresh spinach",
      "quantity": 1,
      "preparation": "stems removed, torn into small pieces"
    },
    {
      "ingredient_id": "bunch-green-onions",
      "item": "bunch green onions",
      "quantity": 1
    },
    {
      "ingredient_id": "water-chestnuts",
      "item": "water chestnuts",
      "quantity": 1,
      "unit": "can",
      "preparation": "8 ounce, drained and sliced"
    },
    {
      "ingredient_id": "8-ounce-container-sour-cream",
      "item": "(8 ounce) container sour cream",
      "quantity": 1
    },
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 2.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "dry-vegetable-soup-mix",
      "item": "dry vegetable soup mix",
      "quantity": 1,
      "unit": "packet",
      "preparation": ".4 ounce"
    },
    {
      "ingredient_id": "dry-onion-soup-mix",
      "item": "dry onion soup mix",
      "quantity": 0.5,
      "unit": "package",
      "preparation": "1 ounce"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Tear the prepared spinach into small pieces. Slice the green onions and drained water chestnuts."
    },
    {
      "step": 2,
      "text": "Stir the sour cream, mayonnaise, vegetable soup mix, and onion soup mix together until evenly blended."
    },
    {
      "step": 3,
      "text": "Fold in the spinach, green onions, and water chestnuts until distributed throughout. Serve as a dip."
    }
  ],
