  "id": "spinach-dip",
  "name": "Spinach Dip",
  "subtitle": "A creamy, crunchy no-cook dip",
  "description": "Fresh spinach, green onions, water chestnuts, and seasoned creamy ingredients combine into an easy party dip.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 48,
    "unit": "servings"
  },
