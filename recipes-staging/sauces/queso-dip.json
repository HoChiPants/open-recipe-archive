{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "queso-dip",
  "name": "Queso Dip",
  "subtitle": "Creamy chile-and-tomato cheese dip",
  "description": "A warm, savory cheese dip with roasted green chiles, tomatoes, garlic, and smoky spices.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "sharp-white-cheddar-cheese",
      "item": "sharp white Cheddar cheese",
      "quantity": 0.5,
      "unit": "pound"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic cloves",
      "quantity": 2,
      "preparation": "minced"
    },
    {
      "ingredient_id": "bunch-scallions",
      "item": "bunch scallions",
      "quantity": 1,
      "preparation": "thinly sliced, dark green parts set aside"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "plus more to taste"
    },
    {
      "ingredient_id": "ground-dried-chipotle-pepper",
      "item": "ground dried chipotle pepper",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "fire-roasted-diced-green-chiles",
      "item": "fire-roasted diced green chiles",
      "quantity": 1,
      "unit": "can",
      "preparation": "4 ounce"
    },
    {
      "ingredient_id": "and-diced-roma-tomatoes",
      "item": "and diced Roma tomatoes",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "seeded"
    },
    {
      "ingredient_id": "evaporated-milk",
      "item": "evaporated milk",
      "quantity": 1,
      "unit": "can",
      "preparation": "12 ounce"
    },
    {
      "ingredient_id": "finely-chopped-cilantro",
      "item": "finely chopped cilantro",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "cayenne-pepper",
      "item": "cayenne pepper",
      "quantity": 1,
      "unit": "pinch",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "roma-tomato",
      "item": "Roma tomato",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "diced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Grate the Cheddar and toss it thoroughly with the cornstarch."
    },
    {
      "step": 2,
      "text": "Melt the butter in a saucepan over medium heat. Add the garlic and the light scallion slices, then stir in the salt, chipotle pepper, and cumin. Cook, stirring, for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 3,
      "text": "Add the green chiles, seeded diced tomatoes, and diced Roma tomato. Stir for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Pour in the evaporated milk and warm until steaming. Gradually add the cheese mixture, stirring until completely melted and smooth."
    },
    {
      "step": 5,
      "text": "Keep the dip warm over low heat, then stir in the cilantro and cayenne. Taste and adjust the salt if needed."
    },
    {
      "step": 6,
      "text": "Garnish with the reserved dark scallion greens and the chile-and-tomato mixture."
    }
  ],
