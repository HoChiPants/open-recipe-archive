      "item": "Dijon mustard",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "bunch-of-thyme-leaves-picked",
      "item": "bunch of thyme leaves picked",
      "unit": "small",
      "preparation": "plus a few sprigs to serve"
    },
    {
