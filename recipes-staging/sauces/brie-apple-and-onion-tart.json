  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven. Shape the puff pastry in a tart tin, trim the edges, and prick the base. Prepare it for baking and bake for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Meanwhile, heat the oil in a pan and cook the sliced onions for 15 minutes, stirring occasionally, until softened.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Stir in the white wine vinegar, Dijon mustard, and picked thyme leaves; cook for 1 minute, until combined.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Cut the apple into thin slices and toss with a splash of white wine vinegar."
    },
    {
      "step": 5,
      "text": "Transfer the onions to the pastry base. Arrange the apple, cranberry sauce, and sliced brie over the top."
    },
    {
      "step": 6,
      "text": "Drizzle with the remaining oil, add a few thyme sprigs, and bake for 25 minutes, until the pastry is golden and the cheese is softened.",
      "timer_minutes": 25
    },
    {
      "step": 7,
      "text": "Serve warm or at room temperature."
    }
  ],
