      "ingredient_id": "pack-ready-rolled-all-butter-puff-pastry-defrosted-at-room-temperature-if-frozen",
      "item": "pack ready-rolled all-butter puff pastry defrosted at room temperature if frozen",
      "quantity": 320,
      "unit": "g"
    },
    {
      "ingredient_id": "olive-or-rapeseed-oil-plus-a-drizzle",
      "item": "olive or rapeseed oil plus a drizzle",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
