  "id": "brie-apple-and-onion-tart",
  "name": "Brie, Apple and Onion Tart",
  "subtitle": "A savory-sweet pastry tart with thyme and cranberry",
  "description": "Caramelized onions, crisp apple, cranberry sauce, and creamy brie are layered over puff pastry for a festive savory tart.",
  "meal_type": "sauce",
  "cuisine": "British",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 40
  },
  "ingredients": [
