  "id": "raisin-sauce-for-ham",
  "name": "Raisin Sauce for Ham",
  "subtitle": "A tangy raisin sauce with lemon and mustard",
  "description": "A sweet-tart American sauce that pairs well with baked ham.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 3,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "cornstarch",
      "item": "cornstarch",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "mustard-powder",
      "item": "mustard powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "white-vinegar",
      "item": "white vinegar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "raisins",
      "item": "raisins",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-lemon-zest",
      "item": "grated lemon zest",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 1.5,
      "unit": "cups"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "In a saucepan, whisk together the brown sugar, cornstarch, and mustard powder."
    },
    {
      "step": 2,
      "text": "Stir in the vinegar, raisins, lemon zest, lemon juice, and water until smooth."
    },
    {
      "step": 3,
      "text": "Cook over medium heat, stirring frequently, until the sauce thickens and the raisins are tender, about 25 minutes.",
      "timer_minutes": 25
    }
  ],
