  "instructions": [
    {
      "step": 1,
      "text": "Bring the measured water to a boil. Add the linguini and cook for 7 minutes, or until tender. Drain.",
      "timer_minutes": 7
    },
    {
      "step": 2,
      "text": "Melt 2 tablespoons of butter in a skillet. Add the mushrooms and cook, stirring, until tender. Transfer them to a plate."
    },
    {
      "step": 3,
      "text": "Melt the remaining butter in the skillet. Add the garlic, then whisk in the cream cheese until smooth."
    },
    {
      "step": 4,
      "text": "Stir in the parsley and basil. Simmer the sauce for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Whisk in the measured boiling water and bring the sauce to a boil."
    },
    {
      "step": 6,
      "text": "Return the mushrooms to the skillet, add the cooked shrimp, and stir until heated through."
    },
    {
      "step": 7,
      "text": "Serve the sauce with the shrimp and mushrooms over the drained linguini."
    }
  ],
