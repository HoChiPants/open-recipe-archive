    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-dill",
      "item": "fresh dill",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped, or to taste"
    },
    {
      "ingredient_id": "dijon-mustard",
      "item": "Dijon mustard",
      "quantity": 2,
      "unit": "teaspoons"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 3,
      "unit": "pinches",
      "preparation": "or to taste"
    },
    {
