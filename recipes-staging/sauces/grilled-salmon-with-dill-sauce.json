      "item": "salmon fillet",
      "quantity": 0.5,
      "unit": "pound",
      "preparation": "skin on"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill."
    },
    {
      "step": 2,
      "text": "Stir together the mayonnaise, dill, Dijon mustard, and brown sugar until combined."
    },
    {
      "step": 3,
      "text": "Brush the grill surface with the vegetable oil and place the salmon fillet skin-side down."
    },
    {
      "step": 4,
      "text": "Grill the salmon until opaque, easily flaked, and 145°F in the thickest part.",
      "timer_minutes": 12
    },
    {
      "step": 5,
      "text": "Serve the grilled salmon with the dill sauce."
    }
  ],
