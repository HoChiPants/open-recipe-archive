  "id": "grilled-salmon-with-dill-sauce",
  "name": "Grilled Salmon with Dill Sauce",
  "subtitle": "Grilled salmon paired with a tangy dill mayonnaise sauce",
  "description": "A simple grilled salmon serving with a lightly sweetened mustard-dill sauce.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
