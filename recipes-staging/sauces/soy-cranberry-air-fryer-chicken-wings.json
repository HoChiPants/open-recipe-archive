  "id": "soy-cranberry-air-fryer-chicken-wings",
  "name": "Soy-Cranberry Air-Fryer Chicken Wings",
  "subtitle": "Tangy glazed wings with crisp edges",
  "description": "Chicken wings are coated in a soy-cranberry mixture with oregano, garlic, and ginger, then air-fried until browned and safely cooked through.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "chicken-wings",
      "item": "chicken wings",
      "quantity": 1,
      "unit": "kg"
    },
    {
      "ingredient_id": "soy-sauce",
      "item": "soy sauce",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "cranberry-sauce",
      "item": "cranberry sauce",
      "quantity": 6,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "garlic-cloves-crushed",
      "item": "garlic cloves crushed",
      "quantity": 2
    },
    {
      "ingredient_id": "ginger-paste-or-freshly-grated-ginger",
      "item": "ginger paste or freshly grated ginger",
      "quantity": 2,
      "unit": "tsp"
    },
    {
      "ingredient_id": "vegetable-oil",
      "item": "vegetable oil",
      "quantity": 2,
      "unit": "tsp"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Pat the chicken wings dry. Preheat the air fryer according to the appliance instructions."
    },
    {
      "step": 2,
      "text": "Stir together the soy sauce, cranberry sauce, oregano, crushed garlic, ginger, and vegetable oil."
    },
    {
      "step": 3,
      "text": "Add the wings to the sauce and toss until evenly coated."
    },
    {
      "step": 4,
      "text": "Arrange the wings in the air-fryer basket in a single layer. Cook for 20 minutes, then turn and coat with any remaining cranberry sauce.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Continue cooking until the wings are browned and the thickest pieces reach 165°F on a food thermometer, about 20 minutes more.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Serve hot."
    }
  ],
