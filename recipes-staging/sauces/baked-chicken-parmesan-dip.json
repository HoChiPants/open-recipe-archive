  "instructions": [
    {
      "step": 1,
      "text": "Drain the ricotta and grated cheeses in a fine-mesh sieve for 8 hours or overnight.",
      "timer_minutes": 480
    },
    {
      "step": 2,
      "text": "Preheat the oven to 450°F."
    },
    {
      "step": 3,
      "text": "Season the chicken with salt, black pepper, and cayenne pepper. Heat 4 tablespoons of the olive oil in an oven-safe skillet over medium-high heat, add the chicken, and cook until cooked through and the center reaches 165°F.",
      "timer_minutes": 6
    },
    {
      "step": 4,
      "text": "Transfer the chicken to a plate, pour the cold water into the skillet, and loosen the browned bits for 5 minutes. Cut the chicken into bite-size pieces.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Combine the drained ricotta, seasonings, grated mozzarella, grated Monterey Jack, and 1 ounce grated Parmigiano-Reggiano. Stir in the chicken and marinara sauce until combined."
    },
    {
      "step": 6,
      "text": "Transfer the mixture to a baking dish. Combine the panko with 2 tablespoons olive oil, then scatter it over the dip with the remaining cheeses."
    },
    {
      "step": 7,
      "text": "Bake until hot and bubbling and the topping is lightly browned.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "Rest for 10 minutes, then garnish with the chopped parsley.",
      "timer_minutes": 10
    }
  ],
