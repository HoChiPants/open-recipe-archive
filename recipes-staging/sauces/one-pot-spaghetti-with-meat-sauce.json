      "ingredient_id": "freshly-grated-parmesan-cheese-for-serving",
      "item": "freshly grated Parmesan cheese for serving",
      "quantity": 0.5,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the sausage, onion, and garlic to a large pot or deep skillet over medium heat. Cook for about 8 minutes, breaking up the sausage, until it reaches 160°F and is cooked through.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Drain excess grease. Stir in the pasta sauce, water, and Italian seasoning, then bring the mixture to a simmer."
    },
    {
      "step": 3,
      "text": "Stir in the broken spaghetti. Simmer, stirring occasionally, for about 20 minutes, until the noodles are tender and cooked through.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Serve topped with the Parmesan cheese."
    }
  ],
