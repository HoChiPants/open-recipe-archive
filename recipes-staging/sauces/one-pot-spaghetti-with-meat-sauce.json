  "id": "one-pot-spaghetti-with-meat-sauce",
  "name": "One-Pot Spaghetti with Meat Sauce",
  "subtitle": "A skillet supper with tomato sauce and Parmesan",
  "description": "Italian sausage, onion, garlic, and broken spaghetti simmer together in tomato-basil sauce for a simple one-pot meal.",
  "meal_type": "sauce",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
