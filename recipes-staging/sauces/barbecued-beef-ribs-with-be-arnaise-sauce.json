  "id": "barbecued-beef-ribs-with-be-arnaise-sauce",
  "name": "Barbecued Beef Ribs with Béarnaise Sauce",
  "subtitle": "Grilled bone-in beef with warm herb butter sauce",
  "description": "Grill the rib steaks, prepare a tarragon béarnaise, and serve with the optional vegetable accompaniments.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "separate-rib-steaks-on-the-bone-co-te-de-boeuf",
      "item": "separate rib steaks on the bone (côte de boeuf)",
      "quantity": 2,
      "preparation": "about 600g each"
    },
    {
      "ingredient_id": "roast-potatoes-glazed-carrots-with-tarragon-chives-and-warm-runner-beans",
      "item": "roast potatoes glazed carrots with tarragon & chives and warm runner beans",
      "preparation": "to serve (optional, see below)",
      "optional": true
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 225,
      "unit": "g"
    },
    {
      "ingredient_id": "tarragon",
      "item": "tarragon",
      "quantity": 1,
      "unit": "tbsp",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "shallots-finely-chopped",
      "item": "shallots finely chopped",
      "quantity": 2
    },
    {
      "ingredient_id": "white-wine-vinegar",
      "item": "white wine vinegar",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "egg-yolks-freeze-the-whites-for-another-recipe",
      "item": "egg yolks (freeze the whites for another recipe)",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Prepare the optional accompaniments as desired and keep them warm."
    },
    {
      "step": 2,
      "text": "Melt the butter gently, then transfer it to a heatproof jug. Simmer the vinegar with the shallots until reduced, then remove from the heat."
    },
    {
      "step": 3,
      "text": "Whisk the egg yolks with the vinegar reduction over gentle heat until thickened. Gradually whisk in the melted butter until the sauce is thick and smooth, then stir in the tarragon. Heat the egg mixture to 160°F and keep it warm without boiling."
    },
    {
      "step": 4,
      "text": "Preheat the barbecue or grill. Cook the rib steaks until the centers reach 145°F, then rest for at least 3 minutes."
    },
    {
      "step": 5,
      "text": "Cut the steaks from the bones and slice. Serve with the béarnaise and the optional warm accompaniments."
    }
  ],
