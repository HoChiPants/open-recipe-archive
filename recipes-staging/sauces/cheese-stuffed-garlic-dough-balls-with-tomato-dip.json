  "instructions": [
    {
      "step": 1,
      "text": "Combine the flour, yeast, tablespoon of sugar, cubed butter, and olive oil to form a dough. Knead until smooth, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Place the dough in an oiled bowl, cover, and leave to rise until doubled, about 2 hours.",
      "timer_minutes": 120
    },
    {
      "step": 3,
      "text": "Mix the mozzarella with the optional Gruyère. Divide the dough into 20 portions, enclose a cheese cube or portion of cheese in each, and seal well."
    },
    {
      "step": 4,
      "text": "Arrange the filled dough balls on an oiled baking sheet, cover, and leave to puff for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 5,
      "text": "Melt the butter with the crushed garlic and chopped rosemary. Brush or spoon the garlic butter over the dough balls."
    },
    {
      "step": 6,
      "text": "Heat the oven to 400°F and bake the dough balls for about 30 minutes, until golden and cooked through.",
      "timer_minutes": 30
    },
    {
      "step": 7,
      "text": "For the dip, warm the sliced garlic with the passata, vinegar, teaspoon of sugar, and chilli flakes. Simmer until thickened, about 10 minutes, then stir in the torn basil.",
      "timer_minutes": 10
    },
    {
      "step": 8,
      "text": "Serve the hot dough balls with the tomato dip and extra basil."
    }
  ],
