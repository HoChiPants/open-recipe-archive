      "item": "cornstarch",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "warm-water",
      "item": "warm water",
      "quantity": 2,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat a large skillet over medium heat and add the oil."
    },
    {
      "step": 2,
      "text": "Add the garlic and brown sugar; stir until lightly browned. Add the green onions and cook until tender."
    },
    {
      "step": 3,
      "text": "Stir in the oyster sauce and water. Place the salmon fillets in the sauce and bring to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Cook until the salmon is opaque, easily flaked, and reaches 145°F in the thickest part.",
      "timer_minutes": 15
    },
    {
      "step": 5,
      "text": "Transfer the salmon to a serving dish. Stir the cornstarch into the warm water, then add the mixture to the skillet sauce."
    },
    {
      "step": 6,
      "text": "Stir over medium heat until thickened, then spoon the sauce over the salmon."
    }
  ],
