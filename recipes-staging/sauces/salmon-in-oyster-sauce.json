  "id": "salmon-in-oyster-sauce",
  "name": "Salmon in Oyster Sauce",
  "subtitle": "Tender salmon with a glossy savory sauce",
  "description": "Salmon fillets are cooked until flaky, then finished with a thick oyster sauce, garlic, brown sugar, and green onions.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
