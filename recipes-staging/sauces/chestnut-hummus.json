  "instructions": [
    {
      "step": 1,
      "text": "Add the chestnuts, lemon juice, and garlic to a food processor and let them stand briefly to combine."
    },
    {
      "step": 2,
      "text": "Add the olive oil and blend until smooth, scraping down the sides as needed."
    },
    {
      "step": 3,
      "text": "Transfer to a serving bowl and serve with pitta crisps and vegetable crudités."
    }
