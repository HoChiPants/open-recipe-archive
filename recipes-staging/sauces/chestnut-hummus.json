  "id": "chestnut-hummus",
  "name": "Chestnut Hummus",
  "subtitle": "A smooth chestnut dip with bright lemon and garlic",
  "description": "Blend cooked chestnuts with lemon, garlic, and olive oil until creamy, then serve with crisp pitta and fresh vegetables.",
  "meal_type": "sauce",
