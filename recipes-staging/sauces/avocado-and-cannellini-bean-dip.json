  "id": "avocado-and-cannellini-bean-dip",
  "name": "Avocado and Cannellini Bean Dip",
  "subtitle": "A creamy lemon-garlic dip with gentle chili heat",
  "description": "Blend cannellini beans with garlic and lemon, then add avocado, chili flakes, cumin, and avocado oil for a smooth dip. Serve with an optional accompaniment of seeds, crackers, or crudités.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "avocado",
      "item": "avocado",
      "quantity": 1,
      "unit": "small"
    },
    {
      "ingredient_id": "can-cannellini-beans-drained",
      "item": "can cannellini beans drained",
      "quantity": 400,
      "unit": "g"
    },
    {
      "ingredient_id": "garlic-clove-finely-grated",
      "item": "garlic clove finely grated",
      "quantity": 1
    },
    {
      "ingredient_id": "chilli-flakes-plus-extra-to-serve",
      "item": "chilli flakes plus extra to serve",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "ground-cumin",
      "item": "ground cumin",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "lemon-zested-and-juiced",
      "item": "lemon zested and juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "avocado-oil-plus-extra-for-drizzling",
      "item": "avocado oil plus extra for drizzling",
      "quantity": 3,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "mixed-seeds-crackers-or-crudite-s",
      "item": "mixed seeds crackers or crudités",
      "preparation": "to serve (optional)",
      "optional": true
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the drained cannellini beans, grated garlic, lemon zest and juice, and cumin to a food processor. Blend until smooth."
    },
    {
      "step": 2,
      "text": "Add the avocado, chili flakes, and avocado oil. Blend until creamy and evenly combined."
    },
    {
      "step": 3,
      "text": "Transfer to a serving bowl. Drizzle with additional avocado oil and sprinkle with extra chili flakes, if desired. Serve with mixed seeds, crackers, or crudités."
    }
  ],
