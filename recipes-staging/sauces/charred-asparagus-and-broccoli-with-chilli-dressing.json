  "id": "charred-asparagus-and-broccoli-with-chilli-dressing",
  "name": "Charred Asparagus and Broccoli with Chilli Dressing",
  "subtitle": "Blistered vegetables with bright maple-lemon dressing",
  "description": "Briefly blanch asparagus and broccoli, then grill until charred and serve with a warm chilli dressing.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "asparagus-woody-ends-trimmed",
      "item": "asparagus woody ends trimmed",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "long-stem-broccoli",
      "item": "long-stem broccoli",
      "quantity": 300,
      "unit": "g"
    },
    {
      "ingredient_id": "olive-oil-plus-a-drizzle",
      "item": "olive oil plus a drizzle",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "red-chilli",
      "item": "red chilli",
      "quantity": 1
    },
    {
      "ingredient_id": "maple-syrup",
      "item": "maple syrup",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra virgin olive oil",
      "quantity": 4,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "lemon-zested-and-juiced",
      "item": "lemon zested and juiced",
      "quantity": "1/2"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a pan of water to a simmer. Add the asparagus and broccoli and simmer for 1 minute, then drain well.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Heat the olive oil plus a drizzle in a pan. Add the red chilli and cook for 3 minutes until blistered; set aside.",
      "timer_minutes": 3
    },
    {
      "step": 3,
      "text": "Stir together the maple syrup, extra virgin olive oil, and lemon zested and juiced to make the dressing."
    },
    {
      "step": 4,
      "text": "Toss the blanched vegetables with the dressing and grill for 4 minutes, turning as needed, until lightly charred.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Transfer the vegetables to a serving dish and spoon over the blistered red chilli before serving."
    }
  ],
