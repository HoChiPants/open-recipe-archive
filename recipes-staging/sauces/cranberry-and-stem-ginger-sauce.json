  "id": "cranberry-and-stem-ginger-sauce",
  "name": "Cranberry and Stem Ginger Sauce",
  "subtitle": "A bright, gently spiced fruit sauce",
  "description": "Simmer cranberries with orange juice, muscovado sugar, and stem ginger until tender and saucy.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "light-muscovado-sugar",
      "item": "light muscovado sugar",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "orange-juice-fresh-or-carton",
      "item": "orange juice fresh or carton",
      "quantity": 100,
      "unit": "ml"
    },
    {
      "ingredient_id": "fresh-or-frozen-cranberries",
      "item": "fresh or frozen cranberries",
      "quantity": 250,
      "unit": "g"
    },
    {
      "ingredient_id": "balls-of-stem-ginger-chopped",
      "item": "balls of stem ginger chopped",
      "quantity": 2,
      "preparation": "plus 1 tbsp syrup from the jar"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the sugar and orange juice in a saucepan and heat until the sugar dissolves and the mixture begins to simmer."
    },
    {
      "step": 2,
      "text": "Stir in the cranberries, chopped stem ginger, and jar syrup. Simmer for about 15 minutes, stirring occasionally, until the cranberries are tender and the sauce thickens.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Remove from the heat and serve warm or allow the sauce to cool."
    }
  ],
