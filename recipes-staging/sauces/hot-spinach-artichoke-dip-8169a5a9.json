      "item": "salt and pepper to taste"
    },
    {
      "ingredient_id": "artichoke-hearts",
      "item": "artichoke hearts",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce, drained and chopped"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "thawed and drained"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Stir the softened cream cheese, mayonnaise, Parmesan, Romano, garlic, basil, garlic salt, salt, pepper, and mozzarella until evenly combined."
    },
    {
      "step": 3,
      "text": "Fold in the chopped artichoke hearts and drained spinach."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to a baking dish and smooth the surface."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, until lightly browned.",
      "timer_minutes": 25
    }
  ],
