  "id": "hot-spinach-artichoke-dip-8169a5a9",
  "name": "Hot Spinach Artichoke Dip",
  "subtitle": "A warm, creamy dip with spinach, artichokes, and melted cheese.",
  "description": "Combine a savory cheese base with spinach and artichokes, then bake until lightly browned.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
