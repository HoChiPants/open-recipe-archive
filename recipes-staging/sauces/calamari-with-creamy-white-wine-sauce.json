  "instructions": [
    {
      "step": 1,
      "text": "Season simmering water with salt and pepper. Add the linguine and cook for 10 minutes, or until tender, then drain.",
      "timer_minutes": 10
    },
    {
      "step": 2,
      "text": "Preheat the olive oil in a skillet over medium heat. Stir in the crushed garlic and cook until golden brown."
    },
    {
      "step": 3,
      "text": "Add the squid and cook briefly, then pour in the white wine. Stir in the cherry peppers, red pepper flakes, and additional salt and pepper."
    },
    {
      "step": 4,
      "text": "Simmer the wine mixture for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Whisk the cornstarch into the cream, then add the mixture to the skillet. Stir in the basil, red pepper flakes, and salt and pepper."
    },
    {
      "step": 6,
      "text": "Stir until the sauce thickens, then add the drained linguine and toss until evenly coated."
    },
    {
      "step": 7,
      "text": "Finish with the freshly grated Parmesan cheese."
    }
  ],
