  "id": "sour-cream-dressing",
  "name": "Sour Cream Dressing",
  "subtitle": "Tangy herb dressing with a creamy finish",
  "description": "A sharp, creamy dressing balanced with garlic, parsley, mustard, and a touch of sweetness.",
  "meal_type": "sauce",
