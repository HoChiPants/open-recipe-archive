  "id": "simple-artichoke-dip",
  "name": "Simple Artichoke Dip",
  "subtitle": "A warm, creamy dip with Parmesan and chopped artichokes",
  "description": "Combine three ingredients, bake until golden, and serve warm as an appetizer or snack.",
