  "instructions": [
    {
      "step": 1,
      "text": "Bring a pot of salted water to a boil. Add the penne and cook until tender, about 11 minutes; drain.",
      "timer_minutes": 11
    },
    {
      "step": 2,
      "text": "While the pasta cooks, combine the tuna with half the olive oil, basil, lemon juice and zest, and salt and pepper."
    },
    {
      "step": 3,
      "text": "Heat the remaining olive oil in a skillet for 3 minutes. Add the anchovies, capers, and garlic, then cook for 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Add the tuna and tomatoes. Simmer for 5 minutes, until the tuna is opaque and flakes easily or reaches 145°F on a food thermometer.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Add the drained pasta and toss with the sauce. Stir in the parsley and serve."
    }
  ],
