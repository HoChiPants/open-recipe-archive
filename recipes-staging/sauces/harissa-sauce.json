  "instructions": [
    {
      "step": 1,
      "text": "Preheat the broiler. Arrange the bell peppers, Fresno chiles, and habanero cut-side down on a baking sheet."
    },
    {
      "step": 2,
      "text": "Broil the peppers until blistered and charred, about 8 minutes. Transfer them to a bowl, cover, and let stand for 10 minutes, then peel if desired.",
      "timer_minutes": 8
    },
    {
      "step": 3,
      "text": "Warm the vegetable oil in a skillet. Add the Fresno chiles and habanero and cook for 3 minutes. Transfer to a plate and cool.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Toast the caraway and coriander seeds in a dry skillet for 2 minutes. Grind them, then stir in the cumin, mint, and salt.",
      "timer_minutes": 2
    },
    {
      "step": 5,
      "text": "Blend the roasted peppers, fried chiles, vegetable oil, garlic, lemon juice, and spice mixture until smooth."
    },
    {
      "step": 6,
      "text": "Stir in the extra-virgin olive oil and adjust the seasoning to taste."
    }
  ],
