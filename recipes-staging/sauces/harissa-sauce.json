  "id": "harissa-sauce",
  "name": "Harissa Sauce",
  "subtitle": "Smoky roasted pepper sauce with warm spices",
  "description": "A vivid, spicy pepper sauce blended with toasted seeds, garlic, lemon, and olive oil.",
  "meal_type": "sauce",
  "cuisine": "North African",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
