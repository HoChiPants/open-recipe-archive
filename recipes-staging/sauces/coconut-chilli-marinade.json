  "id": "coconut-chilli-marinade",
  "name": "Coconut-Chilli Marinade",
  "subtitle": "A savory coconut marinade with ginger and fresh chilli",
  "description": "Blend the ingredients into a fragrant marinade for poultry, fish, or other proteins.",
  "meal_type": "sauce",
