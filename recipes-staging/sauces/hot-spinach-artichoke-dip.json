  "id": "hot-spinach-artichoke-dip",
  "name": "Hot Spinach Artichoke Dip",
  "subtitle": "A warm, cheesy dip with spinach, artichokes, and gentle heat.",
  "description": "Combine sautéed aromatics with spinach, artichokes, cream cheese, and shredded cheeses, then bake until browned and bubbling.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "green-onions",
      "item": "green onions",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "white and light green parts only, thinly sliced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt"
    },
    {
      "ingredient_id": "artichoke-hearts",
      "item": "artichoke hearts",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce, drained and chopped"
    },
    {
      "ingredient_id": "frozen-chopped-spinach",
      "item": "frozen chopped spinach",
      "quantity": 1,
      "unit": "package",
      "preparation": "10 ounce, thawed, drained and squeezed dry"
    },
    {
