      "item": "finely grated Parmigiano-Reggiano cheese",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "hot-sauce",
      "item": "hot sauce",
      "quantity": 0.25,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "ground-nutmeg",
      "item": "ground nutmeg",
      "quantity": 1,
      "unit": "pinch"
    },
    {
