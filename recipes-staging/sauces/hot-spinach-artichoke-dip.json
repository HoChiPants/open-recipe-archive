      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "mozzarella-cheese",
      "item": "mozzarella cheese",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "shredded"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Melt the butter with the hot sauce in a skillet over medium heat. Add the green onions and a little salt and pepper; cook for 5 minutes. Stir in the garlic and cook briefly until fragrant.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Transfer the onion mixture to a bowl. Stir in the artichokes, spinach, cream cheese, Gruyere, Parmigiano-Reggiano, nutmeg, and remaining hot sauce, salt, and pepper until evenly combined."
    },
    {
      "step": 4,
      "text": "Spread the mixture in a baking dish and top with the mozzarella."
    },
    {
      "step": 5,
      "text": "Bake for 25 minutes, until hot and golden brown.",
      "timer_minutes": 25
    }
  ],
