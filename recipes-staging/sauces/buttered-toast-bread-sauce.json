  "id": "buttered-toast-bread-sauce",
  "name": "Buttered Toast Bread Sauce",
  "subtitle": "A smooth, warmly spiced sauce for a traditional roast dinner",
  "description": "Toasted white bread thickens a gently simmered milk sauce flavored with onion, herbs, cloves, nutmeg, butter, and cream.",
  "meal_type": "sauce",
  "cuisine": "British",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "crustless-sliced-white-bread",
      "item": "crustless sliced white bread",
      "quantity": 140,
      "unit": "g"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 85,
      "unit": "g"
    },
    {
      "ingredient_id": "onion-finely-chopped",
      "item": "onion finely chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "bay-leaf",
      "item": "bay leaf",
      "quantity": 1
    },
    {
      "ingredient_id": "thyme-sprig",
      "item": "thyme sprig",
      "quantity": 1
    },
    {
      "ingredient_id": "milk",
      "item": "milk",
      "quantity": 600,
      "unit": "ml"
    },
    {
      "ingredient_id": "of-ground-cloves",
      "item": "of ground cloves",
      "unit": "pinch"
    },
    {
      "ingredient_id": "of-ground-nutmeg",
      "item": "of ground nutmeg",
      "unit": "pinch"
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 100,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Lightly butter the bread, grill until golden, and cool. Tear or pulse it into small crumbs.",
      "timer_minutes": 3
    },
    {
      "step": 2,
      "text": "Melt the remaining butter in a saucepan over medium-low heat. Add the onion and cook until soft, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Add the bay leaf, thyme sprig, and milk. Bring the mixture to a gentle simmer."
    },
    {
      "step": 4,
      "text": "Stir in the toasted bread crumbs, ground cloves, and ground nutmeg. Simmer until thickened, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Remove the herbs and blend or stir the sauce until smooth. Warm the double cream, stir it in, and serve hot."
    }
  ],
