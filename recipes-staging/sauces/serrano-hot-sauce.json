  "instructions": [
    {
      "step": 1,
      "text": "Place the serrano peppers, garlic, and kosher salt in a blender. Process until coarsely combined."
    },
    {
      "step": 2,
      "text": "Add the vinegar and blend until completely smooth, about 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a saucepan and cook for 1 minute.",
      "timer_minutes": 1
    },
    {
      "step": 4,
      "text": "Transfer the sauce to a clean container and refrigerate for 24 hours.",
      "timer_minutes": 1440
    },
    {
      "step": 5,
      "text": "Stir before serving."
    }
