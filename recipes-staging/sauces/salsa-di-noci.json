  "instructions": [
    {
      "step": 1,
      "text": "Bring the water to a simmer. Add the walnuts and cook for 5 minutes, then drain.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Mash the garlic with the pinch of sea salt until thick. Add the drained walnuts and chopped marjoram, thyme, and oregano, then work them into a coarse mixture."
    },
    {
      "step": 3,
      "text": "Transfer the walnut mixture to a bowl. Whisk in the olive oil until thick, then whisk in the heavy cream and Pecorino until combined. Season with sea salt to taste and black pepper."
    },
    {
      "step": 4,
      "text": "Bring salted water to a boil and cook the fettuccine for about 8 minutes, or until cooked through. Drain and combine with the walnut sauce.",
      "timer_minutes": 8
    },
    {
      "step": 5,
      "text": "Serve garnished with the chopped chives and the fresh herbs."
    }
  ],
