  "id": "salsa-di-noci",
  "name": "Salsa di Noci",
  "subtitle": "Creamy Walnut and Herb Sauce for Fettuccine",
  "description": "A rich Italian walnut sauce blended with garlic, fresh herbs, olive oil, cream, and Pecorino, served with fettuccine and chives.",
  "meal_type": "sauce",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
