  "instructions": [
    {
      "step": 1,
      "text": "Stir the kimchi, reserved juice, flour, eggs, and green onion into a batter. Season with salt to taste."
    },
    {
      "step": 2,
      "text": "Heat the vegetable oil in a skillet over medium heat."
    },
    {
      "step": 3,
      "text": "Transfer the batter to the hot skillet and spread it into an even pancake."
    },
    {
      "step": 4,
      "text": "Cook for 5 minutes, until the pancake is browned at the edges and fully set in the center.",
      "timer_minutes": 5
    },
    {
      "step": 5,
      "text": "Whisk the rice vinegar, soy sauce, sesame oil, Korean chili pepper flakes, and toasted sesame seeds together for the dipping sauce."
    },
    {
      "step": 6,
      "text": "Serve the pancake with the dipping sauce."
    }
  ],
