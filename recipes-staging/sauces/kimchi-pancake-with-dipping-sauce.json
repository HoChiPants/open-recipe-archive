  "id": "kimchi-pancake-with-dipping-sauce",
  "name": "Kimchi Pancake with Dipping Sauce",
  "subtitle": "Crisp-edged kimchi pancake served with a tangy sesame dip",
  "description": "A savory Korean-style pancake made with chopped kimchi and green onion, paired with a simple soy-vinegar dipping sauce.",
  "meal_type": "sauce",
  "cuisine": "Korean",
  "yield": {
    "quantity": 4,
