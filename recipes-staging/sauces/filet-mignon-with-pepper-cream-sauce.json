  "id": "filet-mignon-with-pepper-cream-sauce",
  "name": "Filet Mignon with Pepper Cream Sauce",
  "subtitle": "Pepper-crusted steaks with a rich pan sauce",
  "description": "Coarsely crushed peppercorns form a savory crust on tender filet mignon, finished with a smooth beef-and-cream sauce.",
  "meal_type": "sauce",
  "cuisine": "French Inspired",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "coarsely-crushed-black-peppercorns",
      "item": "coarsely crushed black peppercorns",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "6-ounce-1-1-2-inch-thick-filet-mignon-steaks",
      "item": "(6 ounce) 1 1/2 inch thick filet mignon steaks",
      "quantity": 4
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "beef-broth",
      "item": "beef broth",
      "quantity": 0.33333334326744,
      "unit": "cup"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Spread the crushed peppercorns in a shallow dish. Season the steaks with salt, then press them into the peppercorns to coat."
    },
    {
      "step": 2,
      "text": "Heat the butter and olive oil in a large skillet over medium-high heat."
    },
    {
      "step": 3,
      "text": "Sear the steaks in the hot skillet, turning as needed, until a thermometer inserted into the thickest part reads 145°F. Transfer to a plate and rest for 3 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Whisk the beef broth into the skillet, scraping up any browned bits."
    },
    {
      "step": 5,
      "text": "Add the heavy cream and whisk until the sauce thickens, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 6,
      "text": "Return the steaks to the skillet and turn them in the pepper cream sauce before serving."
    }
  ],
