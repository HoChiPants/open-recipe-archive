  "id": "scallops-with-pesto-cream-sauce",
  "name": "Scallops with Pesto Cream Sauce",
  "subtitle": "Tender scallops in a quick herbed cream sauce",
  "description": "Flour-coated scallops are cooked in butter, then finished with pesto, capers, and cream for a rich Italian-style sauce.",
  "meal_type": "sauce",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "scallops",
      "item": "scallops",
      "quantity": 1,
      "unit": "pound"
    },
    {
      "ingredient_id": "salt-and-freshly-ground-black-pepper-to-taste",
      "item": "salt and freshly ground black pepper to taste"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "pesto",
      "item": "pesto",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "capers",
      "item": "capers",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "heavy-whipping-cream",
      "item": "heavy whipping cream",
      "quantity": 1,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Season the scallops with salt and pepper, then coat them lightly with flour."
    },
    {
      "step": 2,
      "text": "Heat the butter in a skillet over medium-high heat until melted and hot."
    },
    {
      "step": 3,
      "text": "Cook the scallops in the butter for 2 minutes, turning as needed, until opaque and easily flaked.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Stir in the pesto and capers."
    },
    {
      "step": 5,
      "text": "Whisk in the cream and cook briefly until the sauce is smooth and heated through."
    }
  ],
