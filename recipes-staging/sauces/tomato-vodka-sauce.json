  "id": "tomato-vodka-sauce",
  "name": "Tomato Vodka Sauce",
  "subtitle": "Creamy tomato sauce with penne and Parmesan",
  "description": "A rich tomato sauce with cream, vodka, and a gentle chile heat, tossed with penne and finished with Parmesan.",
  "meal_type": "sauce",
