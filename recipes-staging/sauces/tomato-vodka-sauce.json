  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter with the olive oil in a saucepan over medium heat. Add the onion and cook until softened, about 8 minutes.",
      "timer_minutes": 8
    },
    {
      "step": 2,
      "text": "Stir in the tomatoes and cook until the sauce begins to thicken, about 25 minutes.",
      "timer_minutes": 25
    },
    {
      "step": 3,
      "text": "Warm the heavy cream, vodka, crushed red pepper flakes, and salt and pepper in the saucepan. Simmer for 2 minutes, until thickened.",
      "timer_minutes": 2
    },
    {
      "step": 4,
      "text": "Meanwhile, cook the penne in boiling salted water until tender, about 10 minutes. Drain.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Transfer the pasta to the sauce and toss to coat. Stir in the Parmesan and serve."
    }
  ],
