  "instructions": [
    {
      "step": 1,
      "text": "Put the sliced red onion in a heatproof bowl. Heat the vinegar, coriander seeds, peppercorns, and sugar until hot, then pour over the onion. Leave to cool, then chill for 15 minutes.",
      "timer_minutes": 15
    },
    {
      "step": 2,
      "text": "Mix the mayonnaise, dill, basil, mustard, and capers to make the herb sauce. Stir in hot sauce if desired."
    },
    {
      "step": 3,
      "text": "Stir the flour, cornflour, and salt together. Whisk in the cold beer until smooth, then chill the batter for 30 minutes.",
      "timer_minutes": 30
    },
    {
      "step": 4,
      "text": "Heat the deep-frying oil to 350°F. Pat the cod dry, dip the pieces in the batter, and fry in batches for about 4 minutes, turning as needed, until crisp and the fish reaches 145°F or is opaque and flakes easily.",
      "timer_minutes": 4
    },
    {
      "step": 5,
      "text": "Warm the corn tortillas. Fill them with shredded lettuce and fried cod, then top with pickled onion, herb sauce, and optional hot sauce."
    }
  ],
