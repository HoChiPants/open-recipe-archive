{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "brown-butter-bread-and-onion-sauce",
  "name": "Brown Butter Bread and Onion Sauce",
  "subtitle": "A smooth, savory sauce for using stale bread",
  "description": "Browned butter, softened onion, seasoned milk, and bread combine into a thick, velvety sauce.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": 40,
      "unit": "g"
    },
    {
      "ingredient_id": "onion-finely-chopped",
      "item": "onion finely chopped",
      "quantity": "1/2",
      "unit": "large"
    },
    {
      "ingredient_id": "bay-leaf",
      "item": "bay leaf (optional)",
      "quantity": 1,
      "optional": true
    },
    {
      "ingredient_id": "milk",
      "item": "whole milk",
      "quantity": 500,
      "unit": "ml"
    },
    {
      "ingredient_id": "of-ground-nutmeg",
      "item": "of ground nutmeg",
      "unit": "pinch"
    },
    {
      "ingredient_id": "of-ground-cloves",
      "item": "of ground cloves",
      "unit": "pinch"
    },
    {
      "ingredient_id": "stale-bread-cut-into-chunks",
      "item": "stale bread cut into chunks"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Melt the butter in a saucepan over medium heat and cook until lightly browned and nutty."
    },
    {
      "step": 2,
      "text": "Add the onion and optional bay leaf. Cook for 15 minutes, stirring occasionally, until the onion is soft.",
      "timer_minutes": 15
    },
    {
      "step": 3,
      "text": "Pour in the milk and add the nutmeg and cloves. Heat gently for 5 minutes, then remove the bay leaf.",
      "timer_minutes": 5
    },
    {
      "step": 4,
      "text": "Add the bread chunks and blend or process until smooth."
    },
    {
      "step": 5,
      "text": "Return the sauce to the saucepan and simmer for 2 minutes, stirring, until thickened.",
      "timer_minutes": 2
    }
  ],
