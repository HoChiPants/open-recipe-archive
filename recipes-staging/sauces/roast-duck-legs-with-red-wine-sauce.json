  "id": "roast-duck-legs-with-red-wine-sauce",
  "name": "Roast Duck Legs With Red Wine Sauce",
  "subtitle": "Rosemary duck legs with a spiced currant glaze",
  "description": "Duck legs roast with rosemary, garlic, and five-spice, then pair with a quick red wine and currant sauce.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 75
  },
  "ingredients": [
    {
      "ingredient_id": "bunch-chopped-fresh-rosemary",
      "item": "bunch chopped fresh rosemary",
      "quantity": 1
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic cloves",
      "quantity": 4,
      "unit": "large"
    },
    {
      "ingredient_id": "duck-legs",
      "item": "duck legs",
      "quantity": 4
    },
    {
      "ingredient_id": "salt-to-taste",
      "item": "salt to taste"
    },
    {
      "ingredient_id": "chinese-five-spice-powder",
      "item": "Chinese five-spice powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "red-wine",
      "item": "red wine",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "red-currant-jelly",
      "item": "red currant jelly",
      "quantity": 1.5,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 375°F. Place the rosemary and garlic in a roasting pan, then add the duck legs. Season with salt and five-spice powder."
    },
    {
      "step": 2,
      "text": "Roast for 60 minutes, until the duck reaches at least 165°F in the thickest part.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "While the duck roasts, heat the red wine and stir in the red currant jelly. Cook the sauce for 5 minutes, then continue cooking until slightly reduced and the duck is tender, about 15 minutes total.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Spoon the red wine sauce over the duck legs and serve."
    }
  ],
