  "instructions": [
    {
      "step": 1,
      "text": "Stir the mayonnaise and dried oregano together in a bowl."
    },
    {
      "step": 2,
      "text": "Prepare the sliced processed American cheese and thinly sliced Genoa salami for assembly."
    },
    {
      "step": 3,
      "text": "Transfer the mayonnaise mixture to a serving dish and stir in the sliced cheese."
    },
    {
      "step": 4,
      "text": "Add the diced onion, shredded lettuce, and diced tomatoes, stirring until combined."
    },
    {
      "step": 5,
      "text": "Serve with the torn hoagie roll pieces for dipping."
    }
  ],
