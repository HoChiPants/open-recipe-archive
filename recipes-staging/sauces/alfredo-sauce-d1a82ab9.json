  "id": "alfredo-sauce-d1a82ab9",
  "name": "Alfredo Sauce",
  "subtitle": "A creamy parmesan sauce for pasta",
  "description": "Make a quick cream-and-parmesan sauce with garlic, herbs, and parsley, then fold in cooked pasta for serving.",
  "meal_type": "sauce",
  "cuisine": "Italian",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 25,
      "unit": "g"
    },
    {
      "ingredient_id": "garlic-cloves-crushed-or-finely-grated",
      "item": "garlic cloves crushed or finely grated",
      "quantity": 2
    },
    {
      "ingredient_id": "double-cream",
      "item": "double cream",
      "quantity": 300,
      "unit": "ml"
    },
    {
      "ingredient_id": "italian-dried-herbs",
      "item": "Italian dried herbs",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "parmesan-grated",
      "item": "parmesan grated",
      "quantity": 100,
      "unit": "g"
    },
    {
      "ingredient_id": "bunch-parsley-finely-chopped",
      "item": "bunch parsley finely chopped",
      "quantity": "1/2",
      "unit": "small"
    },
    {
      "ingredient_id": "pasta-cooked",
      "item": "pasta cooked",
      "quantity": 400,
      "unit": "g"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm a saucepan over medium heat. Add the butter and garlic, and cook for 1 minute, stirring frequently.",
      "timer_minutes": 1
    },
    {
      "step": 2,
      "text": "Whisk in the double cream and Italian dried herbs. Bring the mixture to a gentle simmer."
    },
    {
      "step": 3,
      "text": "Stir in the parmesan until melted and smooth, then mix in the parsley."
    },
    {
      "step": 4,
      "text": "Fold in the cooked pasta until evenly coated and serve hot."
    }
  ],
