  "id": "baked-lemon-dill-salmon-with-garlic-wine-butter",
  "name": "Baked Lemon-Dill Salmon with Garlic Wine Butter",
  "subtitle": "Salmon baked over fresh dill with a bright butter sauce",
  "description": "A simple baked salmon dish layered with dill and finished with lemon, garlic, white wine, butter, and toasted almonds.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 5,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "white-wine",
      "item": "white wine",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1,
      "preparation": "juiced"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 5,
      "unit": "cloves",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "bunch-fresh-dill",
      "item": "bunch fresh dill",
      "quantity": 1,
      "preparation": "stems trimmed"
    },
    {
      "ingredient_id": "1-pound-salmon-fillet",
      "item": "(1 pound) salmon fillet",
      "quantity": 1
    },
    {
      "ingredient_id": "almonds",
      "item": "almonds",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "toasted"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 375°F."
    },
    {
      "step": 2,
      "text": "Stir together the melted butter, white wine, lemon juice, and garlic."
    },
    {
      "step": 3,
      "text": "Coat a baking dish evenly with some of the butter mixture, then arrange the trimmed dill across the bottom."
    },
    {
      "step": 4,
      "text": "Set the salmon fillet over the dill, add the remaining dill, and pour the remaining butter mixture over the fish."
    },
    {
      "step": 5,
      "text": "Bake until the salmon reaches 145°F internally and flakes easily.",
      "timer_minutes": 35
    },
    {
      "step": 6,
      "text": "Scatter the toasted almonds over the salmon before serving."
    }
  ],
