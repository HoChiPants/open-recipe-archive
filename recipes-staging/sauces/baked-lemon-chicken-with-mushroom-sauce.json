  "id": "baked-lemon-chicken-with-mushroom-sauce",
  "name": "Baked Lemon Chicken with Mushroom Sauce",
  "subtitle": "Tender baked chicken with a bright mushroom pan sauce",
  "description": "Chicken breasts bake with lemon and broth, then pair with a thick mushroom sauce finished with parsley.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 40
  },
  "ingredients": [
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 6,
      "preparation": "boneless chicken breast halves"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon",
      "quantity": 1
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "fresh-sliced-mushrooms",
      "item": "fresh sliced mushrooms",
      "quantity": 3,
      "unit": "cups"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "chicken-broth",
      "item": "chicken broth",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "or more as needed"
    },
    {
      "ingredient_id": "fresh-parsley",
      "item": "fresh parsley",
      "quantity": 1,
      "unit": "tablespoon",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Arrange the chicken in a baking dish, drizzle with the olive oil, and pour in the chicken broth. Slice the lemon and place it over the chicken."
    },
    {
      "step": 3,
      "text": "Bake for 40 minutes, or until the thickest part of the chicken reaches 165°F on a food thermometer.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "While the chicken bakes, melt the butter in a saucepan over medium heat. Add the mushrooms and stir for 6 minutes.",
      "timer_minutes": 6
    },
    {
      "step": 5,
      "text": "Stir the flour into the mushrooms. Add chicken broth as needed and cook, stirring, until the sauce thickens."
    },
    {
      "step": 6,
      "text": "Stir in the parsley and serve the sauce with the baked chicken."
    }
  ],
