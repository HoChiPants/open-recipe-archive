  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "beer-marinated-sirloin-steaks",
  "name": "Beer-Marinated Sirloin Steaks",
  "subtitle": "Grilled beef with a sweet, savory marinade",
  "description": "Sirloin steaks soak briefly in beer, teriyaki sauce, and brown sugar, then are seasoned and grilled until safely cooked.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 30,
    "cook_minutes": 15,
    "inactive_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "16-ounce-beef-sirloin-steaks",
      "item": "(16 ounce) beef sirloin steaks",
      "quantity": 2
    },
    {
      "ingredient_id": "dark-beer",
      "item": "dark beer",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "teriyaki-sauce",
      "item": "teriyaki sauce",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "seasoned-salt",
      "item": "seasoned salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "black pepper",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 0.5,
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the grill."
    },
    {
      "step": 2,
      "text": "Place the steaks in a shallow dish. Stir together the beer, teriyaki sauce, and brown sugar, then pour the mixture over the steaks. Marinate for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Mix the seasoned salt, black pepper, and garlic powder. Remove the steaks from the marinade, coat them with the seasoning, and let them stand until the seasoning sets, about 10 minutes.",
      "timer_minutes": 10
    },
    {
      "step": 4,
      "text": "Grill the steaks for 7 minutes per side, or until a thermometer inserted into the thickest part reads at least 145°F. Transfer to a clean plate and rest for 3 minutes before serving."
    }
  ],
