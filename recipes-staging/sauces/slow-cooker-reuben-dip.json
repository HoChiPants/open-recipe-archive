  "id": "slow-cooker-reuben-dip",
  "name": "Slow Cooker Reuben Dip",
  "subtitle": "A warm, creamy dip with sauerkraut, corned beef, and Swiss cheese",
  "description": "Combine classic Reuben-inspired ingredients in a slow cooker for a hot, melty dip suitable for serving as an appetizer or snack.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 12,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "16-ounce-jar-sauerkraut",
      "item": "(16 ounce) jar sauerkraut",
      "quantity": 1,
      "preparation": "drained"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "swiss-cheese",
      "item": "Swiss cheese",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded"
    },
    {
      "ingredient_id": "corned-beef",
      "item": "corned beef",
      "quantity": 2,
      "unit": "cups",
      "preparation": "shredded cooked"
    },
    {
      "ingredient_id": "thousand-island-dressing",
      "item": "thousand island dressing",
      "quantity": 0.25,
      "unit": "cup"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Add the drained sauerkraut, softened cream cheese, Swiss cheese, cooked corned beef, and dressing to a slow cooker; stir until evenly combined."
    },
    {
      "step": 2,
      "text": "Cover and cook for 45 minutes, stirring occasionally, until the cheese is melted and the dip reaches 165°F throughout.",
      "timer_minutes": 45
    },
    {
      "step": 3,
      "text": "Stir well and serve hot."
    }
  ],
