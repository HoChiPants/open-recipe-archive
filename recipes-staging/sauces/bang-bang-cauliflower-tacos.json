  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven."
    },
    {
      "step": 2,
      "text": "Whisk the flour, smoked paprika, and milk together until smooth."
    },
    {
      "step": 3,
      "text": "Spread the panko breadcrumbs in a shallow dish. Coat the cauliflower florets in the batter, then turn them in the breadcrumbs."
    },
    {
      "step": 4,
      "text": "Arrange the coated cauliflower on a baking tray and bake until crisp and cooked through.",
      "timer_minutes": 40
    },
    {
      "step": 5,
      "text": "Stir together the sweet chilli sauce, sriracha, and soy sauce."
    },
    {
      "step": 6,
      "text": "Let the baked cauliflower cool briefly, then toss it with the sauce and lime juice."
    },
    {
      "step": 7,
      "text": "Fill the warmed tortilla wraps with lettuce, sauced cauliflower, spring onions, tomatoes, coriander, and optional chopped chilli. Serve with lime wedges."
    }
  ],
