  "ingredients": [
    {
      "ingredient_id": "crabmeat",
      "item": "crabmeat",
      "quantity": 1,
      "unit": "can",
      "preparation": "4.5 ounce, drained"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 1,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 1.5,
      "unit": "cups"
    },
