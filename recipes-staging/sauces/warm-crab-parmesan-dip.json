  "id": "warm-crab-parmesan-dip",
  "name": "Warm Crab Parmesan Dip",
  "subtitle": "A creamy baked seafood dip with garlic and Parmesan",
  "description": "Combine crab, dairy, mayonnaise, and garlic, then bake until hot and lightly browned for a rich dip.",
  "meal_type": "sauce",
  "cuisine": "American",
