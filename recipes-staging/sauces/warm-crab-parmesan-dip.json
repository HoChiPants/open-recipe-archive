      "item": "garlic",
      "quantity": 4,
      "unit": "cloves",
      "preparation": "peeled and crushed (or to taste)"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "In a bowl, combine the drained crabmeat, softened cream cheese, Parmesan, mayonnaise, sour cream, and crushed garlic until evenly mixed."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a baking dish and bake for 45 minutes, until lightly browned and hot throughout.",
      "timer_minutes": 45
    }
  ],
