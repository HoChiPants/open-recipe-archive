  "instructions": [
    {
      "step": 1,
      "text": "Heat the oil and butter in a large heavy pot. Add the onions and cook gently for 20 minutes until softened.",
      "timer_minutes": 20
    },
    {
      "step": 2,
      "text": "Stir in the tikka masala paste and peppers; cook for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Add the chicken, chopped tomatoes, and tomato purée. Bring to a gentle simmer and cook for 15 minutes, stirring occasionally, until the chicken reaches 165°F in the thickest pieces.",
      "timer_minutes": 15
    },
    {
      "step": 4,
      "text": "Whisk together the mango chutney, cream, and yogurt, then stir the mixture into the curry over low heat until smooth and heated through."
    },
    {
      "step": 5,
      "text": "Serve with the chopped coriander. To freeze, cool the curry promptly, portion it into suitable containers, and freeze once chilled; thaw in the refrigerator and reheat thoroughly before serving."
    }
  ],
