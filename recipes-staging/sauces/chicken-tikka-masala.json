  "id": "chicken-tikka-masala",
  "name": "Chicken Tikka Masala",
  "subtitle": "Creamy tomato chicken curry",
  "description": "A rich tomato-based curry with peppers, warm spice paste, cream, yogurt, and fresh coriander.",
  "meal_type": "sauce",
  "cuisine": "Indian",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
