  "id": "artichoke-dip",
  "name": "Artichoke Dip",
  "subtitle": "A warm, creamy dip with Parmesan and tender artichokes",
  "description": "Combine a creamy cheese mixture with artichokes, onion, and lemon, then bake until hot and lightly set.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 7,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "mayonnaise",
      "item": "mayonnaise",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "sour-cream",
      "item": "sour cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "grated-parmesan-cheese",
      "item": "grated Parmesan cheese",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "ingredient_id": "artichoke-hearts",
      "item": "artichoke hearts",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce, drained"
    },
    {
      "ingredient_id": "red-onion",
      "item": "red onion",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "minced"
    },
    {
      "ingredient_id": "lemon-juice",
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 400°F."
    },
    {
      "step": 2,
      "text": "Whisk together the mayonnaise, sour cream, Parmesan, and minced red onion. Stir in the drained artichoke hearts, lemon juice, salt, and pepper until combined."
    },
    {
      "step": 3,
      "text": "Transfer the mixture to a baking dish."
    },
    {
      "step": 4,
      "text": "Bake at 400°F for 20 minutes, until hot and lightly set.",
      "timer_minutes": 20
    }
  ],
