{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "tomato-bacon-gravy",
  "name": "Tomato-Bacon Gravy",
  "subtitle": "A savory skillet sauce with bacon and diced tomatoes",
  "description": "Bacon, onion, and canned tomatoes simmer together into a rich, lightly sweet gravy for serving over savory dishes.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 10,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
  "ingredients": [
    {
      "ingredient_id": "slices-bacon",
      "item": "slices bacon",
      "quantity": 8,
      "preparation": "cut into 1/2 inch pieces"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "unit": "large",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 2,
      "unit": "can",
      "preparation": "28 ounce, diced"
    },
    {
      "ingredient_id": "tomato-sauce",
      "item": "tomato sauce",
      "quantity": 1,
      "unit": "can",
      "preparation": "14 ounce"
    },
    {
      "ingredient_id": "sugar",
      "item": "white sugar",
      "quantity": 1,
      "unit": "teaspoon",
      "preparation": "or more to taste"
    },
    {
      "ingredient_id": "ground-black-pepper",
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon",
      "preparation": "or to taste"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 1,
      "unit": "tablespoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat a large skillet over medium heat. Add the bacon and cook for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Add the chopped onion and cook, stirring, for 5 minutes.",
      "timer_minutes": 5
    },
    {
      "step": 3,
      "text": "Stir in the diced tomatoes, tomato sauce, sugar, and black pepper."
    },
    {
      "step": 4,
      "text": "Bring the mixture to a gentle simmer and cook for 45 minutes, stirring occasionally.",
      "timer_minutes": 45
    },
    {
      "step": 5,
      "text": "Stir in the butter until melted, then serve."
    }
  ],
  "tags": [
    "sauce",
    "tomato",
    "bacon"
  ],
