  "instructions": [
    {
      "step": 1,
      "text": "Heat the heavy cream in a saucepan over low heat for 60 minutes, keeping it below a boil.",
      "timer_minutes": 60
    },
    {
      "step": 2,
      "text": "Whisk in the Gorgonzola, Parmesan, salt, ground black pepper, and nutmeg. Continue until the cheeses melt and the sauce thickens; keep warm."
    },
    {
      "step": 3,
      "text": "Season the beef tenderloin with lemon pepper, garlic powder, onion powder, and salt and ground black pepper to taste."
    },
    {
      "step": 4,
      "text": "Cook the chopped bacon in a skillet until crisp, then drain it.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Preheat the grill and coat the grates with cooking spray. Grill the steaks for about 5 minutes per side, or until a thermometer registers at least 145°F in the thickest part.",
      "timer_minutes": 5
    },
    {
      "step": 6,
      "text": "Transfer the steaks to a plate and rest for at least 3 minutes. Stir the bacon and green onions into the warm sauce, then spoon it over the steaks.",
      "timer_minutes": 3
    }
  ],
