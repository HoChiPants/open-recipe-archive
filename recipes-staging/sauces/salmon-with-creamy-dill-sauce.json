  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Place the salmon fillet in a baking dish and season it with lemon-pepper seasoning, onion salt, garlic salt, and black pepper."
    },
    {
      "step": 2,
      "text": "Arrange the sliced onion and lemon slices over the salmon. Scatter the butter chunks around the top and cover the dish loosely with foil."
    },
    {
      "step": 3,
      "text": "Bake for 20 minutes, then uncover and continue cooking until the thickest part reaches 145°F or the fish is opaque and flakes easily.",
      "timer_minutes": 12
    },
    {
      "step": 4,
      "text": "While the salmon cooks, whisk sour cream, mayonnaise, wine, capers, finely chopped onion, caper brine, lemon juice, horseradish, and dill until combined."
    },
    {
      "step": 5,
      "text": "Let the salmon stand briefly, then serve it with the creamy dill sauce."
    }
  ],
