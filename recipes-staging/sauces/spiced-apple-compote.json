  "id": "spiced-apple-compote",
  "name": "Spiced Apple Compote",
  "subtitle": "Two apple varieties with warm spice and thyme",
  "description": "A gently cooked apple compote combining soft Bramley apples with diced Granny Smith apples, cider, citrus, and aromatic spices.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "bramley-apples-peeled-and-sliced",
      "item": "bramley apples peeled and sliced",
      "quantity": 5
    },
    {
      "ingredient_id": "caster-sugar",
      "item": "caster sugar",
      "quantity": 50,
      "unit": "g"
    },
    {
      "ingredient_id": "lemon-juiced",
      "item": "lemon juiced",
      "quantity": 1
    },
    {
      "ingredient_id": "apple-cider",
      "item": "apple cider",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "of-ground-nutmeg",
      "item": "of ground nutmeg",
      "unit": "pinch"
    },
    {
      "ingredient_id": "of-allspice",
      "item": "of allspice",
      "unit": "pinch"
    },
    {
      "ingredient_id": "star-anise",
      "item": "star anise",
      "quantity": 1
    },
    {
      "ingredient_id": "granny-smith-apples-peeled-and-diced",
      "item": "Granny Smith apples peeled and diced",
      "quantity": 7
    },
    {
      "ingredient_id": "thyme-sprigs-leaves-picked",
      "item": "thyme sprigs leaves picked",
      "quantity": 2
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the Bramley apples, sugar, lemon juice, cider, nutmeg, allspice, and star anise in a saucepan."
    },
    {
      "step": 2,
      "text": "Cook over medium heat until the Bramley apples soften and begin to break down.",
      "timer_minutes": 10
    },
    {
      "step": 3,
      "text": "Remove the star anise, then blend the softened mixture until smooth."
    },
    {
      "step": 4,
      "text": "Stir in the diced Granny Smith apples and thyme leaves. Cook until the pieces are tender but retain some shape.",
      "timer_minutes": 10
    },
    {
      "step": 5,
      "text": "Serve warm or allow the compote to cool before using."
    }
  ],
