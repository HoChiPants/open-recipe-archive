  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the soured cream with the onion granules, the pinch of onion granules, and chopped chives. Cover and chill until serving."
    },
    {
      "step": 2,
      "text": "Cut the cauliflower into evenly sized florets."
    },
    {
      "step": 3,
      "text": "Mix the flour, grated parmesan or vegetarian alternative, onion granules, oregano, and paprika. Whisk in the egg and milk to make a thick batter."
    },
    {
      "step": 4,
      "text": "Coat each cauliflower floret in the batter, then press it into the panko breadcrumbs until covered."
    },
    {
      "step": 5,
      "text": "Transfer the coated florets to the air fryer basket in a single layer. Drizzle with the optional olive oil."
    },
    {
      "step": 6,
      "text": "Air-fry at the appliance's appropriate cauliflower setting, or until browned and crisp, the cauliflower is tender, and the egg-containing coating reaches 160°F.",
      "timer_minutes": 20
    },
    {
      "step": 7,
      "text": "Serve hot with the chilled soured-cream and herb dressing."
    }
  ],
