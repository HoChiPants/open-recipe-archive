  "id": "air-fryer-cauliflower-popcorn",
  "name": "Air-Fryer Cauliflower Popcorn",
  "subtitle": "Crisp cauliflower bites with herb dressing",
  "description": "Tender cauliflower is coated in a seasoned batter and panko, air-fried until crisp, and served with a chilled soured-cream and chive dressing.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "cauliflower-about-1kg",
      "item": "cauliflower (about 1kg)",
      "quantity": 1,
      "unit": "medium"
    },
    {
      "ingredient_id": "flour",
      "item": "plain flour",
      "quantity": 125,
      "unit": "g"
    },
    {
      "ingredient_id": "parmesan-or-vegetarian-alternative",
      "item": "parmesan or vegetarian alternative",
      "quantity": 25,
      "unit": "g",
      "preparation": "grated"
    },
    {
      "ingredient_id": "onion-granules",
      "item": "onion granules",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "dried-oregano",
      "item": "dried oregano",
      "quantity": "1/2",
      "unit": "tsp"
    },
    {
      "ingredient_id": "paprika",
      "item": "paprika",
      "quantity": 1,
      "unit": "tsp"
    },
    {
