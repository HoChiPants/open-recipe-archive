      "item": "milk",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "panko-breadcrumbs",
      "item": "panko breadcrumbs",
      "quantity": 80,
      "unit": "g"
    },
    {
      "ingredient_id": "olive-oil-for-drizzling-optional",
      "item": "olive oil for drizzling (optional)",
      "optional": true
    },
    {
      "ingredient_id": "soured-cream",
      "item": "soured cream",
      "quantity": 150,
      "unit": "ml"
    },
    {
      "ingredient_id": "of-onion-granules",
      "item": "of onion granules",
      "unit": "pinch"
