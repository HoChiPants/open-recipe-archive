  "id": "pork-tenderloin-with-marsala-mustard-sauce",
  "name": "Pork Tenderloin with Marsala Mustard Sauce",
  "subtitle": "Roasted pork with a creamy wine pan sauce",
  "description": "Mustard-coated pork tenderloins are baked, sliced, and served with a shallot, Marsala, and cream sauce.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
