  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F. Coat the pork tenderloins with 4 tablespoons Dijon mustard and place them in a lightly oiled baking dish."
    },
    {
      "step": 2,
      "text": "Bake for 20 minutes, or until the thickest part reaches 145°F. Transfer the pork to a cutting board and rest for 3 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 3,
      "text": "While the pork rests, melt the butter in a saucepan over medium heat. Add the minced shallots and cook until softened."
    },
    {
      "step": 4,
      "text": "Whisk in the remaining Dijon mustard, Marsala wine, and heavy cream. Simmer until the sauce thickens, about 20 minutes.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Slice the rested pork and transfer it to a serving dish. Spoon the sauce over or alongside the slices."
    }
  ],
