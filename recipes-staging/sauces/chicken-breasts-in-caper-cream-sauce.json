  "id": "chicken-breasts-in-caper-cream-sauce",
  "name": "Chicken Breasts in Caper Cream Sauce",
  "subtitle": "Tender chicken with a bright, creamy pan sauce",
  "description": "Seasoned chicken breasts are cooked in butter, then served with a quick cream-and-caper sauce.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 15
  },
  "ingredients": [
    {
      "ingredient_id": "boneless",
      "item": "boneless",
      "quantity": 4,
      "preparation": "skinless chicken breast halves"
    },
    {
      "ingredient_id": "lemon-pepper",
      "item": "lemon pepper",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "dried-dill-weed",
      "item": "dried dill weed",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "garlic-powder",
      "item": "garlic powder",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "whipping-cream",
      "item": "whipping cream",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "capers",
      "item": "capers",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "drained and rinsed"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Mix the lemon pepper, salt, dill, and garlic powder. Coat the chicken evenly with the seasoning mixture.",
      "timer_minutes": 5
    },
    {
      "step": 2,
      "text": "Melt the butter in a skillet over medium heat. Add the chicken and cook until browned and the thickest part reaches 165°F, about 7 minutes.",
      "timer_minutes": 7
    },
    {
      "step": 3,
      "text": "Transfer the chicken to a serving platter. Whisk the cream into the skillet and cook until slightly thickened, about 3 minutes.",
      "timer_minutes": 3
    },
    {
      "step": 4,
      "text": "Stir in the capers, warm the sauce briefly, and spoon it over the chicken."
    }
  ],
