  "id": "jalapen-o-chicken-dip",
  "name": "Jalapeño Chicken Dip",
  "subtitle": "A warm, creamy dip with chopped jalapeño and chicken.",
  "description": "Combine the ingredients and microwave until hot throughout for an easy savory dip.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 15,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 5
  },
  "ingredients": [
    {
      "ingredient_id": "chunk-white-chicken-in-water",
      "item": "chunk white chicken in water",
      "quantity": 1,
      "unit": "can",
      "preparation": "10 ounce, thoroughly drained"
    },
    {
      "ingredient_id": "seasoned-salt",
      "item": "seasoned salt",
      "quantity": 1,
      "unit": "pinch"
    },
    {
      "ingredient_id": "cream-cheese",
      "item": "cream cheese",
      "quantity": 2,
      "unit": "package",
      "preparation": "8 ounce, softened"
    },
    {
      "ingredient_id": "condensed-cream-of-chicken-soup",
      "item": "condensed cream of chicken soup",
      "quantity": 1,
      "unit": "can",
      "preparation": "10.5 ounce"
    },
    {
      "ingredient_id": "jalapeno",
      "item": "jalapeno",
      "quantity": 3,
      "unit": "tablespoons",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "In a microwave-safe bowl, combine the softened cream cheese and condensed soup until mostly smooth."
    },
    {
      "step": 2,
      "text": "Stir in the drained chicken, chopped jalapeño, and seasoned salt."
    },
    {
      "step": 3,
      "text": "Microwave for 1 minute, stir, and continue heating in 1-minute intervals until the dip is steaming and reaches 165°F throughout.",
      "timer_minutes": 5
    }
  ],
