  "id": "clam-sauce-with-linguine",
  "name": "Clam Sauce with Linguine",
  "subtitle": "A savory clam sauce for pasta",
  "description": "Tender linguine is paired with clams, garlic, onion, butter, and white wine in a simple savory sauce.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 35
  },
  "ingredients": [
    {
      "ingredient_id": "dried-linguine",
      "item": "dried linguine",
      "quantity": 1,
      "unit": "package",
      "preparation": "16 ounce"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "onion",
      "item": "onion",
      "quantity": 1,
      "preparation": "chopped"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 6,
      "unit": "cloves",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "clams",
      "item": "clams",
      "quantity": 4,
      "unit": "can",
      "preparation": "6.5 ounce, minced"
    },
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "dry-white-wine",
      "item": "dry white wine",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "salt-and-pepper-to-taste",
      "item": "salt and pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Bring a large pot of salted water to a boil. Cook the linguine for about 11 minutes, until tender, then drain.",
      "timer_minutes": 11
    },
    {
      "step": 2,
      "text": "Warm the olive oil in a saucepan over medium heat. Add the onion and garlic and cook for 4 minutes.",
      "timer_minutes": 4
    },
    {
      "step": 3,
      "text": "Drain the clams. Stir them into the saucepan with the butter, white wine, and salt and pepper."
    },
    {
      "step": 4,
      "text": "Simmer the sauce for about 20 minutes, until thickened.",
      "timer_minutes": 20
    },
    {
      "step": 5,
      "text": "Serve the clam sauce over the drained linguine."
    }
  ],
