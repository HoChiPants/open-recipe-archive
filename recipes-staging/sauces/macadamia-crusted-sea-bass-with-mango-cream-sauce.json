  "id": "macadamia-crusted-sea-bass-with-mango-cream-sauce",
  "name": "Macadamia-Crusted Sea Bass with Mango Cream Sauce",
  "subtitle": "Baked sea bass with a crisp nut crust and smooth mango sauce",
  "description": "Sea bass is coated with seasoned macadamias, briefly seared with garlic, and baked until flaky. Serve with a warm mango cream sauce.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "macadamia-nuts",
      "item": "macadamia nuts",
      "quantity": 0.5,
      "unit": "cup",
      "preparation": "chopped"
    },
    {
      "ingredient_id": "seasoned-bread-crumbs",
      "item": "seasoned bread crumbs",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra virgin olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "black-pepper",
