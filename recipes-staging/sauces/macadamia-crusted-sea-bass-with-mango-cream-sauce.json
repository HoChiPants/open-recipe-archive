      "item": "garlic",
      "quantity": 2,
      "unit": "cloves",
      "preparation": "minced"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 350°F."
    },
    {
      "step": 2,
      "text": "Combine the macadamia nuts, bread crumbs, black pepper, red pepper flakes, and salt and ground black pepper to taste."
    },
    {
      "step": 3,
      "text": "Blend the mango, heavy cream, and lemon juice until smooth, then warm gently until set and thickened."
    },
    {
      "step": 4,
      "text": "Season the sea bass with salt and ground black pepper to taste."
    },
    {
      "step": 5,
      "text": "Heat the olive oil in an ovenproof skillet and cook the garlic briefly until fragrant."
    },
    {
      "step": 6,
      "text": "Add the sea bass and cook briefly, then transfer the skillet to the oven."
    },
    {
      "step": 7,
      "text": "Press the macadamia mixture over the fish and bake until the fish is opaque, easily flaked, and reaches 145°F internally.",
      "timer_minutes": 20
    },
    {
      "step": 8,
      "text": "Whisk the mango cream sauce and serve it with the baked sea bass."
    }
  ],
