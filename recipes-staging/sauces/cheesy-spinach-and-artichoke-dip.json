  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 200°C/400°F. Lightly oil a suitable baking dish."
    },
    {
      "step": 2,
      "text": "Squeeze excess moisture from the defrosted spinach. Whisk the soft cheese, soured cream, mayonnaise, and vegetarian hard cheese until smooth."
    },
    {
      "step": 3,
      "text": "Stir in the spinach, garlic, and chopped artichokes until evenly combined."
    },
    {
      "step": 4,
      "text": "Transfer the mixture to the prepared dish and scatter the mozzarella and vegetarian cheddar over the top."
    },
    {
      "step": 5,
      "text": "Bake until hot, bubbling, and lightly browned on top.",
      "timer_minutes": 30
    },
    {
      "step": 6,
      "text": "Serve warm with tortilla chips and crudités.",
      "timer_minutes": 5
    }
  ],
