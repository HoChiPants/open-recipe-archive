  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to the temperature required for baking and roasting. Line a baking tray."
    },
    {
      "step": 2,
      "text": "Pulse the chickpeas, cumin, ground coriander, cayenne, chopped red onion, garlic, sesame seeds, baking powder, parsley stalks, and coriander until combined but still slightly coarse."
    },
    {
      "step": 3,
      "text": "Shape the mixture into small falafel portions and arrange them on the lined tray."
    },
    {
      "step": 4,
      "text": "Toss the cauliflower with the cumin, ground coriander, and 1 teaspoon of the olive oil. Arrange it on the tray beside the falafel."
    },
    {
      "step": 5,
      "text": "Bake the falafel for 20 minutes, turning once if needed, until firm and browned. Roast the cauliflower for 12 minutes, until tender and browned at the edges.",
      "timer_minutes": 20
    },
    {
      "step": 6,
      "text": "Combine the roasted cauliflower with the chopped parsley leaves, mint, lemon juice, and rocket to make the tabbouleh."
    },
    {
      "step": 7,
      "text": "Preheat the grill. Grill the spring onions for about 5 minutes, turning as they char and soften.",
      "timer_minutes": 5
    },
    {
      "step": 8,
      "text": "Blend or whisk the tahini with the lemon juice, garlic, coriander, and enough water to make a pourable green sauce."
    },
    {
      "step": 9,
      "text": "Serve the falafel with the cauliflower tabbouleh, green tahini sauce, and charred spring onions."
    }
  ],
