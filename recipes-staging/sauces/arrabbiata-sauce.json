  "id": "arrabbiata-sauce",
  "name": "Arrabbiata Sauce",
  "subtitle": "A bright, garlicky tomato sauce with gentle chili heat",
  "description": "Simmer tomatoes with garlic, olive oil, and fresh chili, then blend for a smooth pasta sauce.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 2,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 25
  },
  "ingredients": [
    {
      "ingredient_id": "garlic-cloves-peeled-and-crushed",
      "item": "garlic cloves peeled and crushed",
      "quantity": 2,
      "unit": "small"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra virgin olive oil",
      "quantity": 2,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "red-chilli-deseeded-and-finely-chopped",
      "item": "red chilli deseeded and finely chopped",
      "quantity": 1
    },
    {
      "ingredient_id": "x-400g-can-chopped-tomatoes",
      "item": "x 400g can chopped tomatoes",
      "quantity": 1
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the olive oil in a saucepan over medium heat. Add the crushed garlic and cook gently for 2 minutes.",
      "timer_minutes": 2
    },
    {
      "step": 2,
      "text": "Stir in the chopped chili and canned tomatoes."
    },
    {
      "step": 3,
      "text": "Simmer gently for 20 minutes, stirring occasionally, until slightly thickened.",
      "timer_minutes": 20
    },
    {
      "step": 4,
      "text": "Blend the sauce until smooth, then use it with pasta or another dish."
    }
  ],
