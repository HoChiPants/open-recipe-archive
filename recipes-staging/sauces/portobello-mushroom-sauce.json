  "id": "portobello-mushroom-sauce",
  "name": "Portobello Mushroom Sauce",
  "subtitle": "A creamy mushroom sauce with port wine and basil",
  "description": "Tender diced portobello mushrooms simmer with port wine and cream, then finish with fresh basil for a rich, spoonable sauce.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 20
  },
  "ingredients": [
    {
      "ingredient_id": "butter",
      "item": "butter",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "ingredient_id": "portobello-mushrooms",
      "item": "portobello mushrooms",
      "quantity": 1,
      "unit": "pound",
      "preparation": "diced"
    },
    {
      "ingredient_id": "port-wine",
      "item": "port wine",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "ingredient_id": "heavy-cream",
      "item": "heavy cream",
      "quantity": 2,
      "unit": "cups"
    },
    {
      "ingredient_id": "basil",
      "item": "fresh basil",
      "quantity": 0.25,
      "unit": "cup",
      "preparation": "chopped"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Warm the butter in a saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Add the diced portobello mushrooms and stir until tender."
    },
    {
      "step": 3,
      "text": "Stir in the port wine and bring the mixture to a simmer."
    },
    {
      "step": 4,
      "text": "Whisk in the heavy cream, then simmer until the sauce thickens. Stir in the chopped fresh basil and serve."
    }
  ],
