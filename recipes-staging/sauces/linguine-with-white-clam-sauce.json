      "item": "ground black pepper to taste"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Cook the linguine in boiling salted water according to the package directions; drain and set aside."
    },
    {
      "step": 2,
      "text": "Warm the olive oil in a large skillet over medium heat. Add the garlic and cook briefly until fragrant."
    },
    {
      "step": 3,
      "text": "Stir in the clams with their juice, the clam juice, and parsley. Season with salt and pepper."
    },
    {
      "step": 4,
      "text": "Simmer the sauce for 3 minutes, until the clams are opaque and the sauce is steaming hot.",
      "timer_minutes": 3
    },
    {
      "step": 5,
      "text": "Add the linguine and toss until evenly coated. Serve immediately."
    }
  ],
