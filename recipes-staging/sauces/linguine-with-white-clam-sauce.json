  "id": "linguine-with-white-clam-sauce",
  "name": "Linguine with White Clam Sauce",
  "subtitle": "A quick pasta dish with garlic, parsley, and tender minced clams.",
  "description": "Toss linguine with a savory clam sauce for an easy seafood dinner.",
  "meal_type": "sauce",
  "cuisine": "American",
