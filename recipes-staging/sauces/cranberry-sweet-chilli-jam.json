  "id": "cranberry-sweet-chilli-jam",
  "name": "Cranberry Sweet Chilli Jam",
  "subtitle": "Tart cranberry preserve with gentle heat",
  "description": "A bright, tangy jam made by simmering cranberries with ginger, chilli, sugar, and vinegar.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 2,
    "unit": "x 500ml jars"
  },
  "times": {
    "prep_minutes": 20,
    "cook_minutes": 60
  },
  "ingredients": [
    {
      "ingredient_id": "fresh-or-frozen-cranberries",
      "item": "fresh or frozen cranberries",
      "quantity": 500,
      "unit": "g"
    },
    {
      "ingredient_id": "finger-sized-piece-ginger-peeled-and-roughly-chopped",
      "item": "finger-sized piece ginger peeled and roughly chopped"
    },
    {
      "ingredient_id": "red-chillies-roughly-chopped-deseeded-if-you-don-t-like-it-too-hot",
      "item": "red chillies roughly chopped (deseeded if you don’t like it too hot)",
      "quantity": "3-4"
    },
    {
      "ingredient_id": "golden-caster-sugar",
      "item": "golden caster sugar",
      "quantity": 200,
      "unit": "g"
    },
    {
      "ingredient_id": "red-wine-vinegar",
      "item": "red wine vinegar",
      "quantity": 100,
      "unit": "ml"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Put the cranberries, ginger, chillies, sugar, and vinegar in a large saucepan."
    },
    {
      "step": 2,
      "text": "Bring the mixture to a boil, then reduce the heat and simmer, stirring occasionally, until the cranberries break down and the mixture is thick and jam-like.",
      "timer_minutes": 60
    },
    {
      "step": 3,
      "text": "Let the jam cool briefly, then spoon it into two clean 500ml jars and leave to cool completely."
    }
  ],
