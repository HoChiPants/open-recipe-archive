  "instructions": [
    {
      "step": 1,
      "text": "Preheat the oven to 425°F. Mix the cumin, smoked paprika, oregano, and thyme."
    },
    {
      "step": 2,
      "text": "Coat the chicken and chopped peppers with the spice mixture. Arrange them with the onions and celery in a roasting pan, using the rapeseed oil as needed."
    },
    {
      "step": 3,
      "text": "Toss the sweet potato wedges with the remaining oil and place them on a baking tray. Roast the chicken mixture and wedges until the vegetables are tender and the chicken reaches 165°F at the thickest point, about 40 minutes.",
      "timer_minutes": 40
    },
    {
      "step": 4,
      "text": "Stir the kefir or yogurt with the chives. Let the cooked chicken rest for 5 minutes, then serve with the roasted wedges, vegetables, and dip.",
      "timer_minutes": 5
    }
  ],
