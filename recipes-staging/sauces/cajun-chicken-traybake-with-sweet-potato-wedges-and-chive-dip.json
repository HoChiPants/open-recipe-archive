  "id": "cajun-chicken-traybake-with-sweet-potato-wedges-and-chive-dip",
  "name": "Cajun Chicken Traybake with Sweet Potato Wedges and Chive Dip",
  "subtitle": "Spiced chicken and vegetables with roasted wedges",
  "description": "Roast seasoned chicken, peppers, onions, celery, and sweet potato wedges together, then serve with a cool chive yogurt dip.",
  "meal_type": "sauce",
  "yield": {
    "quantity": 4,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 45
  },
