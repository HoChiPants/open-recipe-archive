      "item": "dried oregano",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "ingredient_id": "fresh-thyme-leaves-or-1-tsp-dried",
      "item": "fresh thyme leaves or 1 tsp dried",
      "quantity": 1,
      "unit": "tbsp"
    },
    {
      "ingredient_id": "skinless",
      "item": "skinless",
      "quantity": 8,
      "preparation": "boneless chicken thighs (900g)"
    },
    {
