  "id": "vegan-browning-sauce",
  "name": "Vegan Browning Sauce",
  "subtitle": "A savory-sweet sauce for enriching gravies and pan sauces",
  "description": "A quick stovetop sauce combining caramelized sugar, vegetable broth seasoning, and yeast extract for deep color and savory flavor.",
  "meal_type": "sauce",
  "cuisine": "American",
  "yield": {
    "quantity": 20,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 5,
    "cook_minutes": 10
  },
  "ingredients": [
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "brown-sugar",
      "item": "brown sugar",
      "quantity": 0.5,
      "unit": "cup"
    },
    {
      "ingredient_id": "reduced-sodium-vegetable-broth-powder",
      "item": "reduced-sodium vegetable broth powder",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "yeast-extract-spread",
      "item": "yeast extract spread",
      "quantity": 1,
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "water",
      "item": "water",
      "quantity": 10,
      "unit": "tablespoons"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat 0.5 cup water in a small saucepan over medium heat."
    },
    {
      "step": 2,
      "text": "Stir in the brown sugar until dissolved and blended."
    },
    {
      "step": 3,
      "text": "Add the vegetable broth powder and yeast extract spread, stirring until fully combined."
    },
    {
      "step": 4,
      "text": "Gradually stir in the remaining water and cook until the sauce thickens."
    },
    {
      "step": 5,
      "text": "Simmer briefly, stirring occasionally, then remove from the heat.",
      "timer_minutes": 10
    }
  ],
