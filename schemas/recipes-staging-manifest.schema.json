{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-recipe-archive.example/schemas/recipes-staging-manifest.schema.json",
  "title": "Rights-pending recipe staging manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "publication_status",
    "generated_at",
    "total_recipes",
    "total_ingredients",
    "source_counts",
    "recipes",
    "ingredients"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "publication_status": { "const": "rights-pending" },
    "generated_at": { "type": "string", "format": "date-time" },
    "total_recipes": { "type": "integer", "minimum": 0 },
    "total_ingredients": { "type": "integer", "minimum": 0 },
    "source_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recipe_id",
          "file",
          "source_name",
          "source_url",
          "source_text_hash",
          "normalized_text_hash",
          "model",
          "prompt_version",
          "transformed_at"
        ],
        "properties": {
          "recipe_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "file": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+\\.json$" },
          "source_name": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "pattern": "^https?://" },
          "source_text_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "normalized_text_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "model": { "type": "string", "minLength": 1 },
          "prompt_version": { "type": "string", "minLength": 1 },
          "transformed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
        }
      }
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ingredient_id", "file"],
        "properties": {
          "ingredient_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "file": { "type": "string", "pattern": "^_ingredients/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$" }
        }
      }
    }
  }
}
