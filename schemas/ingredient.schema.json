{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-recipe-archive.example/schemas/ingredient.schema.json",
  "title": "Open Recipe Archive ingredient",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "categories", "seasons"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 100
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "produce",
          "dairy",
          "protein",
          "grain",
          "legume",
          "herb",
          "spice",
          "oil",
          "sweetener",
          "condiment",
          "baking",
          "beverage",
          "other"
        ]
      }
    },
    "seasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["spring", "summer", "fall", "winter", "year-round"] }
    },
    "default_unit": { "type": "string", "maxLength": 40 },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "maxLength": 160 },
        "typical_days": { "type": "integer", "minimum": 0 }
      }
    },
    "allergens": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["milk", "eggs", "fish", "shellfish", "tree-nuts", "peanuts", "wheat", "soy", "sesame"]
      }
    },
    "notes": { "type": "string", "maxLength": 500 }
  }
}
