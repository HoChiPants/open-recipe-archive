{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated recipe decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "reason", "confidence", "variation_changes", "recipe"],
  "properties": {
    "status": { "enum": ["promote", "skip"] },
    "reason": { "type": "string" },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
    "variation_changes": { "type": "array", "items": { "type": "string" }, "maxItems": 2 },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "subtitle", "description", "meal_type", "cuisine", "yield", "times", "ingredients", "instructions", "tags", "seasons", "dietary", "allergens", "equipment"],
      "properties": {
        "name": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "meal_type": {
          "enum": ["breakfast", "main", "side", "salad", "soup", "sandwich", "dessert", "snack", "drink", "sauce", "baked-good", "other"]
        },
        "cuisine": { "type": "string" },
        "yield": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quantity", "unit"],
          "properties": {
            "quantity": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "type": "string" }
          }
        },
        "times": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prep_minutes", "cook_minutes", "inactive_minutes"],
          "properties": {
            "prep_minutes": { "type": "integer", "minimum": 0 },
            "cook_minutes": { "type": "integer", "minimum": 0 },
            "inactive_minutes": { "type": "integer", "minimum": 0 }
          }
        },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "quantity", "unit", "preparation", "optional"],
            "properties": {
              "item": { "type": "string" },
              "quantity": { "type": "string" },
              "unit": { "type": "string" },
              "preparation": { "type": "string" },
              "optional": { "type": "boolean" }
            }
          }
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "timer_minutes"],
            "properties": {
              "text": { "type": "string" },
              "timer_minutes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "seasons": {
          "type": "array",
          "items": { "enum": ["spring", "summer", "fall", "winter", "year-round"] }
        },
        "dietary": {
          "type": "array",
          "items": { "enum": ["vegetarian", "vegan", "gluten-free", "dairy-free", "nut-free", "egg-free", "low-sodium"] }
        },
        "allergens": {
          "type": "array",
          "items": { "enum": ["milk", "eggs", "fish", "shellfish", "tree-nuts", "peanuts", "wheat", "soy", "sesame"] }
        },
        "equipment": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
