{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-recipe-archive.example/schemas/dailydine-feed.schema.json",
  "title": "Daily Dine archive feed",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "retrieved_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
      }
    },
    "yield": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity", "unit"],
      "properties": {
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "times": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prep_minutes", "cook_minutes", "inactive_minutes"],
      "properties": {
        "prep_minutes": { "type": "integer", "minimum": 0 },
        "cook_minutes": { "type": "integer", "minimum": 0 },
        "inactive_minutes": { "type": "integer", "minimum": 0 }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_text_hash", "normalized_text_hash", "model", "model_version", "prompt_version", "transformed_at", "semantic_similarity", "structural_similarity", "requires_review", "source_review_status"],
      "properties": {
        "source_text_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "normalized_text_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "model": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "transformed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "semantic_similarity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "structural_similarity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "requires_review": { "const": false },
        "source_review_status": { "const": "passed" }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_id",
        "content_hash",
        "slug",
        "review_status",
        "source",
        "name",
        "description",
        "yield",
        "times",
        "ingredient_lines",
        "instruction_lines",
        "categories",
        "nutrition",
        "normalization"
      ],
      "properties": {
        "archive_id": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "slug": { "type": "string", "minLength": 1 },
        "review_status": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "yield": { "$ref": "#/$defs/yield" },
        "times": { "$ref": "#/$defs/times" },
        "ingredient_lines": { "type": "array", "items": { "type": "string" } },
        "instruction_lines": { "type": "array", "items": { "type": "string" } },
        "categories": { "type": "array", "items": { "type": "string" } },
        "nutrition": { "type": ["object", "null"] },
        "normalization": { "$ref": "#/$defs/normalization" }
      }
    },
    "page_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "file", "record_count", "sha256", "archive_id_start", "archive_id_end"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "file": { "type": "string", "pattern": "^page-\\d{5}\\.json$" },
        "record_count": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "archive_id_start": { "type": "string", "minLength": 1 },
        "archive_id_end": { "type": "string", "minLength": 1 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "release_id", "page", "recipes"],
      "properties": {
        "schema_version": { "const": "1.1.0" },
        "release_id": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "recipes": { "type": "array", "items": { "$ref": "#/$defs/recipe" } }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "release_id", "generated_at", "total_records", "total_pages", "pages", "manifest_hash"],
      "properties": {
        "schema_version": { "const": "1.1.0" },
        "release_id": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "total_records": { "type": "integer", "minimum": 0 },
        "total_pages": { "type": "integer", "minimum": 0 },
        "pages": { "type": "array", "items": { "$ref": "#/$defs/page_descriptor" } },
        "manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
