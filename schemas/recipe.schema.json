{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-recipe-archive.example/schemas/recipe.schema.json",
  "title": "Open Recipe Archive recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "meal_type",
    "yield",
    "times",
    "ingredients",
    "instructions",
    "tags"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 100
    },
    "name": { "type": "string", "minLength": 2, "maxLength": 140 },
    "subtitle": { "type": "string", "maxLength": 180 },
    "description": { "type": "string", "maxLength": 1000 },
    "meal_type": {
      "enum": [
        "breakfast",
        "main",
        "side",
        "salad",
        "soup",
        "sandwich",
        "dessert",
        "snack",
        "drink",
        "sauce",
        "baked-good",
        "other"
      ]
    },
    "cuisine": { "type": "string", "maxLength": 80 },
    "yield": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity", "unit"],
      "properties": {
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "times": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prep_minutes", "cook_minutes"],
      "properties": {
        "prep_minutes": { "type": "integer", "minimum": 0 },
        "cook_minutes": { "type": "integer", "minimum": 0 },
        "inactive_minutes": { "type": "integer", "minimum": 0 }
      }
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item"],
        "properties": {
          "ingredient_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "item": { "type": "string", "minLength": 1, "maxLength": 120 },
          "quantity": { "type": ["number", "string"], "minLength": 1 },
          "unit": { "type": "string", "maxLength": 40 },
          "preparation": { "type": "string", "maxLength": 160 },
          "optional": { "type": "boolean" },
          "group": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "text"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 3, "maxLength": 1200 },
          "timer_minutes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "nutrition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serving_size": { "type": "string", "maxLength": 80 },
        "calories": { "type": "number", "minimum": 0 },
        "protein_g": { "type": "number", "minimum": 0 },
        "carbohydrates_g": { "type": "number", "minimum": 0 },
        "fat_g": { "type": "number", "minimum": 0 },
        "fiber_g": { "type": "number", "minimum": 0 },
        "sugar_g": { "type": "number", "minimum": 0 },
        "sodium_mg": { "type": "number", "minimum": 0 },
        "source": { "type": "string", "maxLength": 160 }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "seasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["spring", "summer", "fall", "winter", "year-round"] }
    },
    "dietary": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "vegetarian",
          "vegan",
          "gluten-free",
          "dairy-free",
          "nut-free",
          "egg-free",
          "low-sodium"
        ]
      }
    },
    "allergens": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["milk", "eggs", "fish", "shellfish", "tree-nuts", "peanuts", "wheat", "soy", "sesame"]
      }
    },
    "equipment": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "url": { "type": "string", "pattern": "^https?://" },
        "adapted": { "type": "boolean" },
        "license": { "type": "string", "maxLength": 80 }
      }
    },
    "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
