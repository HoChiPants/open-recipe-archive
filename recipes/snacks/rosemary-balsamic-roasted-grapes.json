{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "rosemary-balsamic-roasted-grapes",
  "name": "Rosemary-balsamic roasted grapes",
  "subtitle": "A sweet-savory topping for toast or a cheese board",
  "description": "High heat concentrates the grapes while rosemary, balsamic vinegar, and black pepper keep the flavor savory.",
  "meal_type": "snack",
  "yield": { "quantity": 6, "unit": "servings" },
  "times": { "prep_minutes": 5, "cook_minutes": 18 },
  "ingredients": [
    { "item": "seedless grapes", "quantity": 3, "unit": "cups", "preparation": "removed from the stems" },
    { "ingredient_id": "olive-oil", "item": "olive oil", "quantity": 1, "unit": "tablespoon" },
    { "item": "fresh rosemary", "quantity": 1, "unit": "teaspoon", "preparation": "finely chopped" },
    { "item": "balsamic vinegar", "quantity": 1, "unit": "tablespoon" },
    { "ingredient_id": "kosher-salt", "item": "kosher salt", "quantity": "1/4", "unit": "teaspoon" },
    { "ingredient_id": "black-pepper", "item": "black pepper", "quantity": "1/4", "unit": "teaspoon" }
  ],
  "instructions": [
    { "step": 1, "text": "Heat the oven to 400°F and line a rimmed sheet pan." },
    { "step": 2, "text": "Coat the grapes with olive oil, rosemary, salt, and black pepper, then spread them across the pan." },
    { "step": 3, "text": "Roast until some grapes split and their juices begin to thicken.", "timer_minutes": 18 },
    { "step": 4, "text": "Drizzle the hot grapes with balsamic vinegar and serve warm or at room temperature." }
  ],
  "tags": ["appetizer", "oven-roasted", "quick"],
  "seasons": ["summer", "fall"],
  "dietary": ["vegetarian", "vegan", "gluten-free", "dairy-free", "nut-free", "egg-free"],
  "equipment": ["rimmed sheet pan", "oven"],
  "source": {
    "name": "Allrecipes",
    "url": "https://www.allrecipes.com/recipe/244980/balsamic-roasted-grapes/",
    "adapted": true
  },
  "created_at": "2026-08-18",
  "updated_at": "2026-08-18"
}
