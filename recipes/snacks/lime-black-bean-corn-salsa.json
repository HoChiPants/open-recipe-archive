{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "lime-black-bean-corn-salsa",
  "name": "Lime black bean and corn salsa",
  "subtitle": "A scoopable bean salsa with fresh tomato and cilantro",
  "description": "Black beans and corn make this fresh salsa substantial enough for snacking or spooning over a grain bowl.",
  "meal_type": "snack",
  "cuisine": "Mexican-inspired",
  "yield": {
    "quantity": 8,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 20
  },
  "ingredients": [
    {
      "item": "black beans",
      "quantity": 2,
      "unit": "15-ounce cans",
      "preparation": "drained and rinsed",
      "ingredient_id": "black-beans"
    },
    {
      "item": "corn kernels",
      "quantity": 1,
      "unit": "cup",
      "preparation": "thawed if frozen",
      "ingredient_id": "corn-kernels"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 2,
      "unit": "",
      "preparation": "diced"
    },
    {
      "ingredient_id": "onion",
      "item": "red onion",
      "quantity": "1/2",
      "unit": "cup",
      "preparation": "finely chopped"
    },
    {
      "item": "jalapeño",
      "quantity": 1,
      "unit": "",
      "preparation": "seeded and minced",
      "ingredient_id": "jalapen-o"
    },
    {
      "item": "fresh cilantro",
      "quantity": "1/2",
      "unit": "cup",
      "preparation": "chopped",
      "ingredient_id": "fresh-cilantro"
    },
    {
      "item": "lime juice",
      "quantity": 3,
      "unit": "tablespoons",
      "ingredient_id": "lime-juice"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": "1/2",
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Combine the beans, corn, tomatoes, red onion, jalapeño, and cilantro in a large bowl."
    },
    {
      "step": 2,
      "text": "Stir the lime juice, olive oil, and salt together, then pour the dressing over the bean mixture."
    },
    {
      "step": 3,
      "text": "Fold everything together and let the salsa stand briefly before serving.",
      "timer_minutes": 20
    }
  ],
  "tags": [
    "dip",
