{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "one-bowl-banana-cake",
  "name": "One-bowl banana cake",
  "subtitle": "A small, tender cake for ripe bananas",
  "description": "An unfussy snack cake mixed by hand in a single bowl.",
  "meal_type": "dessert",
  "cuisine": "American",
  "yield": {
    "quantity": 9,
    "unit": "pieces"
  },
  "times": {
    "prep_minutes": 12,
    "cook_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "banana",
      "item": "very ripe bananas",
      "quantity": 2,
      "unit": "medium",
      "preparation": "mashed"
    },
    {
      "ingredient_id": "butter",
      "item": "unsalted butter",
      "quantity": "1/2",
      "unit": "cup",
      "preparation": "melted"
    },
    {
      "ingredient_id": "sugar",
      "item": "granulated sugar",
      "quantity": "3/4",
      "unit": "cup"
    },
    {
      "ingredient_id": "egg",
      "item": "egg",
      "quantity": 1,
      "unit": "large"
    },
    {
      "ingredient_id": "flour",
      "item": "all-purpose flour",
      "quantity": 1.5,
      "unit": "cups"
    },
    {
      "item": "baking soda",
      "quantity": 1,
      "unit": "teaspoon",
      "ingredient_id": "baking-soda"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": "1/2",
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Heat the oven to 350°F and line an 8-inch square pan."
    },
    {
      "step": 2,
      "text": "Whisk the bananas, butter, sugar, and egg in a large bowl."
    },
    {
      "step": 3,
      "text": "Fold in the flour, baking soda, and salt just until no dry streaks remain."
    },
    {
      "step": 4,
      "text": "Spread into the pan and bake until the center springs back and a tester has a few moist crumbs.",
      "timer_minutes": 30
    }
  ],
  "tags": [
    "baking",
    "one-bowl",
    "snack-cake"
  ],
  "seasons": [
    "year-round"
  ],
  "dietary": [
    "vegetarian",
    "nut-free"
  ],
  "allergens": [
    "milk",
    "eggs",
    "wheat"
  ],
  "equipment": [
    "8-inch square baking pan",
    "mixing bowl"
  ],
  "notes": [
    "Nutrition values are intentionally omitted until they can be verified."
  ],
  "created_at": "2026-07-14",
  "updated_at": "2026-07-14"
}
