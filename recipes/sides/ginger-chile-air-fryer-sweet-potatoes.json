  "id": "ginger-chile-air-fryer-sweet-potatoes",
  "name": "Ginger-chile air-fryer sweet potatoes",
  "subtitle": "Savory sweet potato cubes with a warm, peppery edge",
  "description": "A light coating of oil helps these seasoned sweet potatoes brown quickly in the air fryer.",
  "meal_type": "side",
  "cuisine": "American",
  "yield": { "quantity": 4, "unit": "servings" },
  "times": { "prep_minutes": 10, "cook_minutes": 14 },
  "ingredients": [
    { "item": "sweet potatoes", "quantity": 1, "unit": "pound", "preparation": "peeled and cut into 1-inch cubes" },
    { "ingredient_id": "olive-oil", "item": "olive oil", "quantity": 1, "unit": "tablespoon" },
    { "ingredient_id": "kosher-salt", "item": "kosher salt", "quantity": "1/2", "unit": "teaspoon" },
    { "item": "ground ginger", "quantity": "1/4", "unit": "teaspoon" },
    { "item": "cayenne pepper", "quantity": "1/8", "unit": "teaspoon" }
  ],
  "instructions": [
    { "step": 1, "text": "Heat the air fryer to 400°F." },
    { "step": 2, "text": "Toss the sweet potato cubes with the oil, salt, ginger, and cayenne until evenly coated." },
    { "step": 3, "text": "Arrange the cubes in an even layer in the basket. Cook until browned at the edges and tender in the center, shaking the basket once or twice.", "timer_minutes": 14 }
  ],
  "tags": ["air-fryer", "quick", "vegetable"],
  "seasons": ["fall", "winter"],
  "dietary": ["vegetarian", "vegan", "gluten-free", "dairy-free", "nut-free", "egg-free"],
  "equipment": ["air fryer", "mixing bowl"],
