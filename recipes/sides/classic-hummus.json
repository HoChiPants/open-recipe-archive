{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "classic-hummus",
  "name": "Classic hummus",
  "subtitle": "Creamy chickpea and tahini dip",
  "description": "A smooth, lemony hummus for vegetables, flatbread, and sandwiches.",
  "meal_type": "side",
  "cuisine": "Middle Eastern",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 12,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "chickpea",
      "item": "cooked chickpeas",
      "quantity": 2,
      "unit": "cups",
      "preparation": "drained and rinsed"
    },
    {
      "ingredient_id": "tahini",
      "item": "tahini",
      "quantity": "1/3",
      "unit": "cup"
    },
    {
      "ingredient_id": "lemon",
      "item": "lemon juice",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "garlic",
      "item": "garlic",
      "quantity": 1,
      "unit": "clove",
      "preparation": "crushed"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "extra-virgin olive oil",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": "1/2",
      "unit": "teaspoon"
    },
    {
      "item": "ice water",
      "quantity": 3,
      "unit": "tablespoons",
      "ingredient_id": "ice-water"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Blend the tahini, lemon juice, garlic, and salt until pale and thick."
    },
    {
      "step": 2,
      "text": "Add the chickpeas and blend, scraping the bowl as needed."
    },
    {
      "step": 3,
      "text": "Stream in the ice water until very smooth, then blend in the olive oil."
    }
  ],
  "tags": [
    "dip",
    "make-ahead",
    "no-cook"
  ],
  "seasons": [
    "year-round"
  ],
  "dietary": [
    "vegetarian",
    "vegan",
    "gluten-free",
    "dairy-free",
    "nut-free",
    "egg-free"
  ],
  "allergens": [
    "sesame"
  ],
  "equipment": [
    "food processor or blender"
  ],
  "created_at": "2026-07-14",
  "updated_at": "2026-07-14"
}
