{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "tomato-avocado-feta-salad",
  "name": "Tomato, avocado, and feta salad",
  "subtitle": "A bright chopped salad with lime and fresh herbs",
  "description": "Juicy tomatoes and creamy avocado are balanced by salty feta and a simple lime dressing.",
  "meal_type": "salad",
  "yield": { "quantity": 6, "unit": "servings" },
  "times": { "prep_minutes": 15, "cook_minutes": 0 },
  "ingredients": [
    { "ingredient_id": "tomato", "item": "plum tomatoes", "quantity": 3, "unit": "", "preparation": "chopped" },
    { "item": "ripe avocado", "quantity": 1, "unit": "", "preparation": "pitted, peeled, and chopped" },
    { "ingredient_id": "onion", "item": "red onion", "quantity": "1/4", "unit": "cup", "preparation": "finely chopped" },
    { "item": "crumbled feta", "quantity": 4, "unit": "ounces" },
    { "item": "fresh cilantro", "quantity": 2, "unit": "tablespoons", "preparation": "chopped" },
    { "item": "lime juice", "quantity": 1, "unit": "tablespoon" },
    { "ingredient_id": "olive-oil", "item": "olive oil", "quantity": 1, "unit": "tablespoon" },
    { "ingredient_id": "black-pepper", "item": "black pepper", "quantity": "1/4", "unit": "teaspoon" }
  ],
  "instructions": [
    { "step": 1, "text": "Whisk the lime juice, olive oil, and black pepper in a serving bowl." },
    { "step": 2, "text": "Add the tomatoes, avocado, onion, feta, and cilantro. Fold gently until the dressing lightly coats the salad." },
    { "step": 3, "text": "Serve promptly, while the avocado is fresh and the vegetables retain their texture." }
  ],
  "tags": ["fresh", "no-cook", "quick"],
  "seasons": ["summer"],
  "dietary": ["vegetarian", "gluten-free", "nut-free", "egg-free"],
  "allergens": ["milk"],
  "source": {
    "name": "Allrecipes",
    "url": "https://www.allrecipes.com/recipe/87678/avocado-feta-salsa/",
    "adapted": true
  },
  "created_at": "2026-08-18",
  "updated_at": "2026-08-18"
}
