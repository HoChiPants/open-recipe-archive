{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "crisp-arugula-and-orange-fennel-salad",
  "name": "Crisp Arugula and Orange Fennel Salad",
  "subtitle": "Citrus-honey arugula salad with thin fennel and olives.",
  "description": "Whisk a simple honey-lemon dressing, then combine it with arugula, segmented orange, sliced fennel, and black olives for immediate service.",
  "meal_type": "salad",
  "cuisine": "American",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "item": "lemon juice",
      "quantity": 1,
      "unit": "tablespoon",
      "ingredient_id": "lemon"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "salt",
      "quantity": 0.5,
      "unit": "teaspoon"
    },
    {
      "item": "ground black pepper",
      "quantity": 0.5,
      "unit": "teaspoon",
      "ingredient_id": "black-pepper"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 0.25,
      "unit": "cup"
    },
    {
      "item": "arugula",
      "quantity": 1,
      "unit": "bunch",
      "ingredient_id": "arugula"
    },
    {
      "item": "orange",
      "quantity": 2,
      "unit": "oranges",
      "preparation": "peeled and segmented",
      "ingredient_id": "orange"
    },
    {
      "item": "fennel bulb",
      "quantity": 1,
      "unit": "bulb",
      "preparation": "thinly sliced",
      "ingredient_id": "fennel-bulb"
    },
    {
      "item": "black olives",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "sliced",
      "ingredient_id": "black-olives"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk honey, lemon juice, salt, and ground black pepper until evenly blended."
    },
    {
      "step": 2,
      "text": "While whisking, stream in olive oil until the dressing is emulsified."
    },
    {
      "step": 3,
      "text": "Toss arugula with sliced fennel, segmented orange, and sliced black olives, coat with dressing, and serve immediately."
    }
  ],
