{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "tomato-cucumber-salad",
  "name": "Tomato cucumber salad",
  "subtitle": "Peak-summer produce with a sharp lemon dressing",
  "description": "A crisp, simple salad built for ripe tomatoes and cucumbers.",
  "meal_type": "salad",
  "cuisine": "Mediterranean",
  "yield": { "quantity": 4, "unit": "servings" },
  "times": { "prep_minutes": 15, "cook_minutes": 0 },
  "ingredients": [
    { "ingredient_id": "tomato", "item": "ripe tomatoes", "quantity": 3, "unit": "medium", "preparation": "cut into wedges" },
    { "ingredient_id": "cucumber", "item": "cucumber", "quantity": 1, "unit": "large", "preparation": "sliced" },
    { "ingredient_id": "onion", "item": "red onion", "quantity": "1/4", "unit": "whole", "preparation": "thinly sliced" },
    { "ingredient_id": "lemon", "item": "lemon juice", "quantity": 2, "unit": "tablespoons" },
    { "ingredient_id": "olive-oil", "item": "extra-virgin olive oil", "quantity": 2, "unit": "tablespoons" },
    { "ingredient_id": "kosher-salt", "item": "kosher salt", "quantity": "1/2", "unit": "teaspoon" },
    { "ingredient_id": "black-pepper", "item": "black pepper", "quantity": "1/4", "unit": "teaspoon" }
  ],
  "instructions": [
    { "step": 1, "text": "Combine the tomatoes, cucumber, and onion in a wide bowl." },
    { "step": 2, "text": "Whisk the lemon juice, olive oil, salt, and pepper until blended." },
    { "step": 3, "text": "Pour the dressing over the vegetables, toss gently, and serve right away." }
  ],
  "tags": ["fresh", "no-cook", "quick"],
  "seasons": ["summer"],
  "dietary": ["vegetarian", "vegan", "gluten-free", "dairy-free", "nut-free", "egg-free"],
  "allergens": [],
  "created_at": "2026-07-14",
  "updated_at": "2026-07-14"
}
