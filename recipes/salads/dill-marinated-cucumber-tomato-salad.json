{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "dill-marinated-cucumber-tomato-salad",
  "name": "Dill-marinated cucumber and tomato salad",
  "subtitle": "A crisp summer salad in a lightly sweet vinegar dressing",
  "description": "Cucumber, tomato, and red onion rest in a dill vinaigrette long enough for the flavors to mingle without losing all their crunch.",
  "meal_type": "salad",
  "yield": {
    "quantity": 6,
    "unit": "servings"
  },
  "times": {
    "prep_minutes": 15,
    "cook_minutes": 0,
    "inactive_minutes": 30
  },
  "ingredients": [
    {
      "ingredient_id": "cucumber",
      "item": "cucumbers",
      "quantity": 2,
      "unit": "",
      "preparation": "thinly sliced"
    },
    {
      "ingredient_id": "tomato",
      "item": "tomatoes",
      "quantity": 3,
      "unit": "",
      "preparation": "cut into wedges"
    },
    {
      "ingredient_id": "onion",
      "item": "red onion",
      "quantity": "1/2",
      "unit": "",
      "preparation": "thinly sliced"
    },
    {
      "item": "apple cider vinegar",
      "quantity": "1/3",
      "unit": "cup",
      "ingredient_id": "apple-cider-vinegar"
    },
    {
      "ingredient_id": "olive-oil",
      "item": "olive oil",
      "quantity": 3,
      "unit": "tablespoons"
    },
    {
      "ingredient_id": "sugar",
      "item": "sugar",
      "quantity": 1,
      "unit": "tablespoon"
    },
    {
      "item": "fresh dill",
      "quantity": 2,
      "unit": "tablespoons",
      "preparation": "chopped",
      "ingredient_id": "fresh-dill"
    },
    {
      "ingredient_id": "kosher-salt",
      "item": "kosher salt",
      "quantity": "3/4",
      "unit": "teaspoon"
    },
    {
      "ingredient_id": "black-pepper",
      "item": "black pepper",
      "quantity": "1/4",
      "unit": "teaspoon"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Whisk the vinegar, olive oil, sugar, dill, salt, and black pepper in a large bowl until the sugar dissolves."
    },
    {
      "step": 2,
      "text": "Add the cucumbers, tomatoes, and red onion and turn them gently through the dressing."
    },
    {
      "step": 3,
      "text": "Refrigerate the salad briefly, then toss once more before serving.",
      "timer_minutes": 30
    }
  ],
