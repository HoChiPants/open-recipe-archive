{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": "1.0.0",
  "id": "strawberry-lemon-spritz",
  "name": "Strawberry lemon spritz",
  "subtitle": "A bright, nonalcoholic summer drink",
  "description": "Crushed berries and lemon make a quick base for sparkling water.",
  "meal_type": "drink",
  "yield": {
    "quantity": 4,
    "unit": "glasses"
  },
  "times": {
    "prep_minutes": 10,
    "cook_minutes": 0
  },
  "ingredients": [
    {
      "ingredient_id": "strawberry",
      "item": "strawberries",
      "quantity": 1,
      "unit": "cup",
      "preparation": "hulled"
    },
    {
      "ingredient_id": "lemon",
      "item": "fresh lemon juice",
      "quantity": "1/3",
      "unit": "cup"
    },
    {
      "ingredient_id": "honey",
      "item": "honey",
      "quantity": 2,
      "unit": "tablespoons"
    },
    {
      "item": "sparkling water",
      "quantity": 3,
      "unit": "cups",
      "preparation": "chilled",
      "ingredient_id": "sparkling-water"
    },
    {
      "item": "ice",
      "quantity": 2,
      "unit": "cups",
      "ingredient_id": "ice"
    }
  ],
  "instructions": [
    {
      "step": 1,
      "text": "Crush the strawberries with the lemon juice and honey until juicy."
    },
    {
      "step": 2,
      "text": "Divide the berry mixture and ice among four glasses."
    },
    {
      "step": 3,
      "text": "Top with sparkling water, stir once, and serve."
    }
  ],
  "tags": [
    "alcohol-free",
    "no-cook",
    "quick"
  ],
  "seasons": [
    "spring",
    "summer"
  ],
  "dietary": [
    "vegetarian",
    "gluten-free",
    "dairy-free",
    "nut-free",
    "egg-free"
  ],
  "allergens": [],
